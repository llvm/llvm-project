# REQUIRES: zstd
# RUN: yaml2obj %p/Inputs/empty.yaml -o %t.obj
# RUN: lld-link /entry:main %t.obj /out:%t.exe /debug /pdb:%t.pdb /pdbmsfz:1
# RUN: cp %t.pdb %t.first.pdb
# RUN: lld-link /entry:main %t.obj /out:%t.exe /debug /pdb:%t.pdb /pdbmsfz:1
# RUN: cmp %t.first.pdb %t.pdb
# RUN: FileCheck --check-prefix=MSFZ %s < %t.pdb
# RUN: llvm-pdbutil dump -summary %t.pdb | FileCheck --check-prefix=SUMMARY %s
# RUN: lld-link /entry:main %t.obj /out:%t.fast.exe /debug /pdb:%t.fast.pdb /pdbmsfz:-1
# RUN: FileCheck --check-prefix=MSFZ %s < %t.fast.pdb
# RUN: not lld-link /entry:main %t.obj /out:%t.bad.exe /debug /pdb:%t.bad.pdb /pdbmsfz:none 2>&1 | FileCheck --check-prefix=INVALID %s
# RUN: not lld-link /entry:main %t.obj /out:%t.bad.exe /debug /pdb:%t.bad.pdb /pdbmsfz:2147483647 2>&1 | FileCheck --check-prefix=RANGE %s
# RUN: %python -c "open(r'%t.stream', 'wb').write(b'x' * 16385)"
# RUN: lld-link /entry:main %t.obj /out:%t.small.exe /debug /pdb:%t.small.pdb /pdbmsfz:1 /pdbmsfzchunksize:4096 /pdbstream:large=%t.stream
# RUN: llvm-pdbutil dump -summary %t.small.pdb | FileCheck --check-prefix=SUMMARY %s
# RUN: %python -c "import struct; f=open(r'%t.small.pdb','rb').read(); t=struct.unpack_from('<Q',f,48)[0]; n=struct.unpack_from('<I',f,72)[0]; sizes=[struct.unpack_from('<I',f,t+i*20+16)[0] for i in range(n)]; assert n>4 and max(sizes)==4096 and min(sizes)>0, sizes"
# RUN: not lld-link /entry:main %t.obj /debug /pdbmsfz:1 /pdbmsfzchunksize:4095 2>&1 | FileCheck --check-prefix=CHUNKSIZE %s
# RUN: not lld-link /entry:main %t.obj /debug /pdbmsfz:1 /pdbmsfzchunksize:1073741825 2>&1 | FileCheck --check-prefix=CHUNKSIZE %s
# RUN: not lld-link /entry:main %t.obj /debug /pdbmsfz:1 /pdbmsfzchunksize:abc 2>&1 | FileCheck --check-prefix=CHUNKSIZE %s
# RUN: not lld-link /entry:main %t.obj /debug /pdbmsfzchunksize:4096 2>&1 | FileCheck --check-prefix=REQUIRES-MSFZ %s
#
# MSFZ: Microsoft MSFZ Container
# SUMMARY: Container: MSFZ
# INVALID: compression level expected, but got none
# RANGE: compression level must be between
# CHUNKSIZE: chunk size must be between 4096 and 1073741824 bytes
# REQUIRES-MSFZ: /pdbmsfzchunksize requires /pdbmsfz
