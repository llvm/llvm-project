# UNSUPPORTED: zstd
# RUN: yaml2obj %p/Inputs/empty.yaml -o %t.obj
# RUN: not lld-link /entry:main %t.obj /out:%t.exe /debug /pdb:%t.pdb /pdbmsfz:1 2>&1 | FileCheck %s
# RUN: not lld-link /entry:main %t.obj /debug /pdbmsfzchunksize:4096 2>&1 | FileCheck --check-prefix=CHUNK %s
#
# CHECK: error: /pdbmsfz requires lld to be built with zstd support
# CHUNK: error: /pdbmsfzchunksize requires lld to be built with zstd support
