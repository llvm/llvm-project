REQUIRES: aarch64, x86
RUN: split-file %s %t.dir && cd %t.dir
RUN: llvm-mc -filetype=obj -triple=x86_64-windows caller.s -o caller.obj
RUN: llvm-mc -filetype=obj -triple=x86_64-windows only-caller.s -o only-caller.obj
RUN: llvm-mc -filetype=obj -triple=arm64ec-windows alias.s -o alias.obj
RUN: llvm-mc -filetype=obj -triple=arm64ec-windows helper.s -o helper.obj
RUN: llvm-mc -filetype=obj -triple=arm64ec-windows outer.s -o outer.obj
RUN: llvm-mc -filetype=obj -triple=arm64ec-windows %S/Inputs/loadconfig-arm64ec.s -o loadconfig.obj
RUN: llvm-mc -filetype=obj -triple=aarch64-windows %S/Inputs/loadconfig-arm64.s -o native-loadconfig.obj
RUN: llvm-lib -machine:arm64ec -def:import.def -out:import.lib
RUN: llvm-lib -machine:arm64ec -out:alias.lib alias.obj

An x64 reference gets an implicit anti-dependency alias to the EC spelling.
If that spelling is itself a weak alias to an import, the original reference
must use the import's x64 thunk, not its native ARM64EC thunk.

RUN: lld-link -machine:arm64ec -dll -noentry -nodefaultlib -out:out.dll caller.obj alias.lib import.lib helper.obj loadconfig.obj outer.obj
RUN: llvm-readobj --hex-dump=.test out.dll | FileCheck %s
RUN: lld-link -machine:arm64ec -dll -noentry -nodefaultlib -out:out-reverse.dll import.lib alias.lib caller.obj helper.obj loadconfig.obj outer.obj
RUN: llvm-readobj --hex-dump=.test out-reverse.dll | FileCheck %s
RUN: lld-link -machine:arm64ec -dll -noentry -nodefaultlib -out:out-object.dll caller.obj alias.obj import.lib helper.obj loadconfig.obj outer.obj
RUN: llvm-readobj --hex-dump=.test out-object.dll | FileCheck %s
RUN: lld-link -machine:arm64x -dll -noentry -nodefaultlib -out:out-x.dll caller.obj alias.lib import.lib helper.obj loadconfig.obj native-loadconfig.obj outer.obj
RUN: llvm-readobj --hex-dump=.test out-x.dll | FileCheck %s

The aliases alone must keep the guest thunks live, without direct references
to either spelling of the imported functions.
RUN: lld-link -machine:arm64ec -dll -noentry -nodefaultlib -include:only_caller -map:only.map -out:only.dll only-caller.obj alias.lib import.lib helper.obj loadconfig.obj
RUN: FileCheck --check-prefix=ONLY %s < only.map

CHECK: 0x{{[0-9A-Fa-f]+}} [[X64:[0-9A-Fa-f]{8}]] [[X64]] [[EC:[0-9A-Fa-f]{8}]] [[EC]]
CHECK-NEXT: 0x{{[0-9A-Fa-f]+}} [[CPPX64:[0-9A-Fa-f]{8}]] [[CPPX64]] [[CPPEC:[0-9A-Fa-f]{8}]] [[CPPEC]]
CHECK-NEXT: 0x{{[0-9A-Fa-f]+}} [[X64]] [[X64]] [[X64]] [[X64]]
CHECK-NEXT: 0x{{[0-9A-Fa-f]+}} [[EC]]

ONLY-DAG: {{[[:space:]]}}_setjmp [[C:[0-9A-Fa-f]{16}]]
ONLY-DAG: {{[[:space:]]}}__intrinsic_setjmp [[C]]
ONLY-DAG: {{[[:space:]]}}?alias@@YAHXZ [[CPP:[0-9A-Fa-f]{16}]]
ONLY-DAG: {{[[:space:]]}}?target@@YAHXZ [[CPP]]

#--- caller.s
    .text
    .globl caller
caller:
    callq _setjmp
    retq

    .section .test,"dr"
    .rva _setjmp, __intrinsic_setjmp, "#_setjmp", "#__intrinsic_setjmp"
    .rva "?alias@@YAHXZ", "?target@@YAHXZ", "?alias@@$$hYAHXZ", "?target@@$$hYAHXZ"

#--- only-caller.s
    .text
    .globl only_caller
only_caller:
    callq _setjmp
    callq "?alias@@YAHXZ"
    retq

#--- alias.s
    .weak "#_setjmp"
    .set "#_setjmp", "#__intrinsic_setjmp"
    .weak "?alias@@$$hYAHXZ"
    .set "?alias@@$$hYAHXZ", "?target@@$$hYAHXZ"

#--- helper.s
    .text
    .globl __icall_helper_arm64ec
__icall_helper_arm64ec:
    ret

#--- outer.s
    # Preserve the name-pair context inside a longer weak chain.
    .weak outer
    .set outer, _setjmp
    .weak outer1
    .set outer1, _setjmp
    .weak outer2
    .set outer2, _setjmp
    .weak outer3
    .set outer3, _setjmp
    .weak direct
    .set direct, "#__intrinsic_setjmp"
    .section .test,"dr"
    .rva outer, outer1, outer2, outer3
    .rva direct

#--- import.def
LIBRARY test.dll
EXPORTS
    __intrinsic_setjmp
    "?target@@YAHXZ"
