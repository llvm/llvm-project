# REQUIRES: xtensa
## DIFF/PDIFF/NDIFF and PDIFF_ULEB128 are relaxation markers in allocatable
## text. LLD does not relax Xtensa, so each reloc is ignored and the
## assembler-written bytes stay.
# RUN: yaml2obj %s -o %t.o
# RUN: llvm-readobj -r %t.o | FileCheck %s --check-prefix=RELOC
# RUN: ld.lld %t.o -o %t
# RUN: llvm-objdump -s -j .text %t | FileCheck %s

# RELOC:      0x0 R_XTENSA_DIFF8 foo
# RELOC-NEXT: 0x1 R_XTENSA_DIFF16 foo
# RELOC-NEXT: 0x3 R_XTENSA_DIFF32 foo
# RELOC-NEXT: 0x7 R_XTENSA_PDIFF8 foo
# RELOC-NEXT: 0x8 R_XTENSA_PDIFF16 foo
# RELOC-NEXT: 0xA R_XTENSA_PDIFF32 foo
# RELOC-NEXT: 0xE R_XTENSA_NDIFF8 foo
# RELOC-NEXT: 0xF R_XTENSA_NDIFF16 foo
# RELOC-NEXT: 0x11 R_XTENSA_NDIFF32 foo
# RELOC-NEXT: 0x15 R_XTENSA_PDIFF_ULEB128 foo

# CHECK:      Contents of section .text:
# CHECK-NEXT: {{.*}}11223344 55667788 99aabbcc ddeeff12
# CHECK-NEXT: {{.*}}3456789a bc808100

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_XTENSA
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    # DIFF8, DIFF16, DIFF32, PDIFF8, PDIFF16, PDIFF32,
    # NDIFF8, NDIFF16, NDIFF32, then a padded uleb128 (0x80 0x81 0x00).
    Content: '112233445566778899AABBCCDDEEFF123456789ABC808100'
  - Name:    .rela.text
    Type:    SHT_RELA
    Link:    .symtab
    Info:    .text
    Relocations:
      - Offset: 0x0
        Symbol: foo
        Type:   R_XTENSA_DIFF8
      - Offset: 0x1
        Symbol: foo
        Type:   R_XTENSA_DIFF16
      - Offset: 0x3
        Symbol: foo
        Type:   R_XTENSA_DIFF32
      - Offset: 0x7
        Symbol: foo
        Type:   R_XTENSA_PDIFF8
      - Offset: 0x8
        Symbol: foo
        Type:   R_XTENSA_PDIFF16
      - Offset: 0xA
        Symbol: foo
        Type:   R_XTENSA_PDIFF32
      - Offset: 0xE
        Symbol: foo
        Type:   R_XTENSA_NDIFF8
      - Offset: 0xF
        Symbol: foo
        Type:   R_XTENSA_NDIFF16
      - Offset: 0x11
        Symbol: foo
        Type:   R_XTENSA_NDIFF32
      - Offset: 0x15
        Symbol: foo
        Type:   R_XTENSA_PDIFF_ULEB128
Symbols:
  - Name:    foo
    Section: .text
  - Name:    _start
    Type:    STT_FUNC
    Section: .text
    Binding: STB_GLOBAL
