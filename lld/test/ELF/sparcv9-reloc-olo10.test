# REQUIRES: sparc
## GNU as emits R_SPARC_OLO10 for an address such as %lo(a)+4: the low 10 bits
## of S + A, plus a second addend, which the upper 24 bits of the type field of
## the relocation hold.
# RUN: yaml2obj --docnum=1 %s -o %t.o
# RUN: ld.lld %t.o -o %t
# RUN: llvm-objdump -d --no-show-raw-insn %t | FileCheck %s

## (0x12345 + 16) & 0x3ff is 0x355, and 0x12345 & 0x3ff is 0x345.
# CHECK:      ldsw [%g1+0x359], %o0
# CHECK-NEXT: st %o0, [%g1+0x33d]

## The sum must fit in the signed 13-bit immediate.
# RUN: yaml2obj --docnum=2 %s -o %t2.o
# RUN: not ld.lld %t2.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=ERR
# ERR: error: {{.*}}:(.text+0x0): relocation R_SPARC_OLO10 out of range: 4933 is not in [-4096, 4095]; references 'a'

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2MSB
  Type:    ET_REL
  Machine: EM_SPARCV9
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 4
    ## ldsw [%g1+0], %o0; st %o0, [%g1+0]
    Content:      D0406000D0206000
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    Relocations:
      ## R_SPARC_OLO10 (33) with second addends 4 and -8.
      - Offset: 0
        Symbol: a
        Type:   0x421
        Addend: 16
      - Offset: 4
        Symbol: a
        Type:   0xFFFFF821
Symbols:
  - Name:    _start
    Section: .text
    Binding: STB_GLOBAL
  - Name:    a
    Index:   SHN_ABS
    Binding: STB_GLOBAL
    Value:   0x12345

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2MSB
  Type:    ET_REL
  Machine: EM_SPARCV9
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 4
    Content:      D0406000
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    Relocations:
      ## A second addend of 4096.
      - Offset: 0
        Symbol: a
        Type:   0x100021
Symbols:
  - Name:    _start
    Section: .text
    Binding: STB_GLOBAL
  - Name:    a
    Index:   SHN_ABS
    Binding: STB_GLOBAL
    Value:   0x12345
