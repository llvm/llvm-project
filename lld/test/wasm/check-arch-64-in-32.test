RUN: llvm-mc -filetype=obj -triple=wasm64-unknown-unknown %p/Inputs/start.s -o %t.o
RUN: not wasm-ld %t.o -o %t.wasm 2>&1 | FileCheck %s
RUN: not wasm-ld -mwasm32 %t.o -o %t.wasm 2>&1 | FileCheck %s --check-prefix=CHECK-32

RUN: wasm-ld -mwasm64 -shared --no-entry %t.o -o %t.so
RUN: not wasm-ld %t.so -o %t2.wasm 2>&1 | FileCheck %s
RUN: not wasm-ld -mwasm32 %t.so -o %t2.wasm 2>&1 | FileCheck %s --check-prefix=CHECK-32

CHECK: error: {{.*}}.{{s?}}o: must specify -mwasm64 to process wasm64 object files
CHECK-32: error: {{.*}}.{{s?}}o: wasm64 object file can't be linked in wasm32 mode
