# REQUIRES: python
# Check that the diagnostics bundle lists the live scripted extensions, so a
# triager can see which scripts were loaded and from where.

# RUN: rm -rf %t
# RUN: %lldb --no-lldbinit -b -o 'command script import %S/Inputs/scripted_command.py' \
# RUN:   -o 'diagnostics dump -d %t'
# RUN: FileCheck %s --input-file=%t/commands.txt

