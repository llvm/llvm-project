# A register in a corefile with no executable module has no type system.  Check
# that DIL reports that for a binary operator instead of dereferencing it.

# RUN: yaml2obj %s -o %t
# RUN: echo 'frame variable $x0' > %t.cmds
# RUN: echo 'frame variable "$x0+$x1"' >> %t.cmds
# RUN: %lldb -c %t -o "command source -e false %t.cmds" -o exit 2>&1 | FileCheck %s

# CHECK: x0 = 0x1111111111111111 <invalid type>
# CHECK:      {{^                      (\^|˄)}}
# CHECK-NEXT: {{^                      (╰─ )?}}error: operand has no type system

--- !minidump
Streams:
  - Type:            SystemInfo
    Processor Arch:  ARM64
    Platform ID:     MacOSX
    CSD Version:     'macOS'
    CPU:
      CPUID:           0x00000000
  - Type:            ThreadList
    Threads:
      - Thread Id:       0x000003E8
        # MinidumpContext_ARM64: context_flags, x[32], pc, cpsr, fpsr, fpcr,
        # v[32*16].  x0 is 0x1111111111111111 and x1 is 0x2222222222222222.
        Context:         
        Stack:
          Start of Memory Range: 0x00007FFCEB34A000
          Content:         DEAD
...
