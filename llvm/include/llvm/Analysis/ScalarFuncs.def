// This .def file creates mapping from standard IEEE math functions
// their corresponding entries in the IBM MASS (scalar) library.
// LLVM intrinsic math functions will be handled in PPCISelLowing to
// allow existing optimizations like pow(x,0.5) --> sqrt(x).

#if defined(TLI_DEFINE_SCALAR_MASS_FUNCS)
#define TLI_DEFINE_SCALAR_MASS_FUNC(SCAL, MASSENTRY, NUM_ARGS) {SCAL, {MASSENTRY, NUM_ARGS}},
#endif

TLI_DEFINE_SCALAR_MASS_FUNC("acosf", "__xl_acosf", 1)
TLI_DEFINE_SCALAR_MASS_FUNC("__acosf_finite", "__xl_acosf", 1)
TLI_DEFINE_SCALAR_MASS_FUNC("acos", "__xl_acos", 1)
TLI_DEFINE_SCALAR_MASS_FUNC("__acos_finite", "__xl_acos", 1)

TLI_DEFINE_SCALAR_MASS_FUNC("acoshf", "__xl_acoshf", 1)
