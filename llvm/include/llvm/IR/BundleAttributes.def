ATTR(Align, align, true)
ATTR(Cold, cold, false)
ATTR(Dereferenceable, dereferenceable, false)
ATTR(DereferenceableOrNull, dereferenceable_or_null, false)
ATTR(Ignore, ignore, false)
ATTR(NonNull, nonnull, true)

// FIXME: Is this actually useful?
// It's currently exclusively emitted through tests.
ATTR(NoUndef, noundef, false)

ATTR(SeparateStorage, separate_storage, true)

#undef ATTR
