#ifdef ELF_MACHINE
// ELF_MACHINE(EM_name, number, arch name, GNU name)
// At the time of writing, the list of registered machine architectures is
// at https://gabi.xinuos.com/elf/a-emachine.html and in the v4.3 development
// branch at https://github.com/xinuos/gabi.
// Also refer to https://groups.google.com/g/generic-abi for further updates.
