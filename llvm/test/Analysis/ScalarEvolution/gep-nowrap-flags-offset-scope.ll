; Ensure GEP offset no-wrap flags are not inferred from the base pointer defining scope.
; In the example below, the flags might not hold for the offset expression in general;
; and, as SCEV expressions are interned, they would incorrectly apply to the addition in
; the exit block, which may overflow.

@g = external global ptr
@h = external global ptr

define void @gep_offset_different_scope(i1 %c) {
; CHECK-LABEL: 'gep_offset_different_scope'
; CHECK-NEXT:  Classifying expressions for: @gep_offset_different_scope
; CHECK-NEXT:    %i = call i64 @opaque()
; CHECK-NEXT:    --> %i U: full-set S: full-set
; CHECK-NEXT:    %base = load ptr, ptr @g, align 8
; CHECK-NEXT:    --> %base U: full-set S: full-set
; CHECK-NEXT:    %gep = getelementptr inbounds nuw i16, ptr %base, i64 %i
; CHECK-NEXT:    --> ((2 * %i)<nuw><nsw> + %base)<nuw> U: full-set S: full-set
; CHECK-NEXT:    %val = load i16, ptr %gep, align 2
; CHECK-NEXT:    --> %val U: full-set S: full-set
; CHECK-NEXT:    %res = add i64 %i, %i
; CHECK-NEXT:    --> (2 * %i)<nuw><nsw> U: [0,-1) S: [-9223372036854775808,9223372036854775807)
;
entry:
  %i = call i64 @opaque()
  br i1 %c, label %if, label %exit

if:
  %base = load ptr, ptr @g, align 8
  %gep = getelementptr inbounds nuw i16, ptr %base, i64 %i
  %val = load i16, ptr %gep, align 2
  br label %exit

exit:
  %res = add i64 %i, %i
  ret void
}

