; Ensure GEP offset no-wrap flags are not inferred from the base pointer defining scope.
; In the example below, the flags might not hold for the offset expression in general;
; and, as SCEV expressions are interned, they would incorrectly apply to the addition in
; the exit block, which may overflow.

@g = external global ptr

define void @gep_offset_nowrap_flags(i1 %c) {
; CHECK-LABEL: 'gep_offset_nowrap_flags'
; CHECK-NEXT:  Classifying expressions for: @gep_offset_nowrap_flags
; CHECK-NEXT:    %idx = call i64 @opaque()
; CHECK-NEXT:    --> %idx U: full-set S: full-set
; CHECK-NEXT:    %base = load ptr, ptr @g, align 8
; CHECK-NEXT:    --> %base U: full-set S: full-set
; CHECK-NEXT:    %gep = getelementptr inbounds nuw i16, ptr %base, i64 %idx
; CHECK-NEXT:    --> ((2 * %idx) + %base)<nuw> U: full-set S: full-set
; CHECK-NEXT:    %val = load i16, ptr %gep, align 2
; CHECK-NEXT:    --> %val U: full-set S: full-set
; CHECK-NEXT:    %res = add i64 %idx, %idx
; CHECK-NEXT:    --> (2 * %idx) U: [0,-1) S: [-9223372036854775808,9223372036854775807)
;
entry:
  %idx = call i64 @opaque()
  br i1 %c, label %if, label %exit

if:
  %base = load ptr, ptr @g, align 8
  %gep = getelementptr inbounds nuw i16, ptr %base, i64 %idx
  %val = load i16, ptr %gep, align 2
  br label %exit

exit:
  %res = add i64 %idx, %idx
  ret void
}

declare i64 @opaque()
