; The two shifts differ by a constant factor, so their difference folds to
; (2 ^ %v) instead of staying an opaque ((-1 * %a) + %b).
define i32 @shl_difference(i32 %v) {
; CHECK-LABEL: 'shl_difference'
; CHECK-NEXT:  Classifying expressions for: @shl_difference
; CHECK-NEXT:    %a = shl i32 3, %v
; CHECK-NEXT:    --> (3 * (2 ^ %v)) U: full-set S: full-set
; CHECK-NEXT:    %b = shl i32 4, %v
; CHECK-NEXT:    --> (4 * (2 ^ %v)) U: [0,-3) S: [-2147483648,2147483645)
; CHECK-NEXT:    %sub = sub i32 %b, %a
; CHECK-NEXT:    --> (2 ^ %v) U: [1,-2147483647) S: [1,-2147483647)
; CHECK-NEXT:  Determining loop execution counts for: @shl_difference
;
  %a = shl i32 3, %v
  %b = shl i32 4, %v
  %sub = sub i32 %b, %a
  ret i32 %sub
}

; Branching on the result makes poison immediate UB, which is what lets the
; no-wrap flags reach the SCEV at all.

; A nuw shift is a nuw multiply.
define void @shl_nuw(i32 %x, i32 %v) {
; CHECK-LABEL: 'shl_nuw'
; CHECK-NEXT:  Classifying expressions for: @shl_nuw
; CHECK-NEXT:    %shl = shl nuw i32 %x, %v
; CHECK-NEXT:    --> ((2 ^ %v) * %x)<nuw> U: full-set S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @shl_nuw
;
  %shl = shl nuw i32 %x, %v
  %c = icmp eq i32 %shl, 0
  br i1 %c, label %t, label %f
t:
  ret void
f:
  ret void
}

; `nsw` on its own cannot be preserved for an unknown amount, because that
