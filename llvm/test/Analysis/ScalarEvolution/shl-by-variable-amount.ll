; A shift left by a variable amount is modelled as a multiply by a power of
; two, so that expressions differing only by a constant factor stay
; comparable. Previously such a shift produced an opaque SCEVUnknown.

define void @shl_by_variable(i32 %x, i32 %v) {
; CHECK-LABEL: 'shl_by_variable'
; CHECK-NEXT:  Classifying expressions for: @shl_by_variable
; CHECK-NEXT:    %shl = shl i32 %x, %v
; CHECK-NEXT:    --> ((2 ^ %v) * %x) U: full-set S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @shl_by_variable
;
  %shl = shl i32 %x, %v
  ret void
}

; `C << V` and `C * (1 << V)` must produce the same expression. Instcombine
; canonicalizes the latter into the former, so without modelling the shift the
; two forms are opaque and unrelated.
define void @shl_and_mul_agree(i32 %v) {
; CHECK-LABEL: 'shl_and_mul_agree'
; CHECK-NEXT:  Classifying expressions for: @shl_and_mul_agree
; CHECK-NEXT:    %one.shl = shl i32 1, %v
; CHECK-NEXT:    --> (2 ^ %v) U: [1,-2147483647) S: [1,-2147483647)
; CHECK-NEXT:    %mul = mul i32 5, %one.shl
; CHECK-NEXT:    --> (5 * (2 ^ %v)) U: full-set S: full-set
; CHECK-NEXT:    %shl = shl i32 5, %v
; CHECK-NEXT:    --> (5 * (2 ^ %v)) U: full-set S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @shl_and_mul_agree
;
  %one.shl = shl i32 1, %v
  %mul = mul i32 5, %one.shl
  %shl = shl i32 5, %v
  ret void
}

