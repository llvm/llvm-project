; SCEVURem_match recognizes the subtract form A + (-C)*(A u/ C) as (A u% C) for
; a power-of-two C, so range analysis surfaces [0, C).

; positive test: X - 4*(X u/4).
define i32 @pow2_4(i32 %x) {
; CHECK-LABEL: 'pow2_4'
; CHECK-NEXT:  Classifying expressions for: @pow2_4
; CHECK-NEXT:    %d = udiv i32 %x, 4
; CHECK-NEXT:    --> (%x /u 4) U: [0,1073741824) S: [0,1073741824)
; CHECK-NEXT:    %m = mul i32 %d, 4
; CHECK-NEXT:    --> (4 * (%x /u 4))<nuw> U: [0,-3) S: [-2147483648,2147483645)
; CHECK-NEXT:    %r = sub i32 %x, %m
; CHECK-NEXT:    --> ((-4 * (%x /u 4)) + %x) U: [0,4) S: full-set
; CHECK-NEXT:  Determining loop execution counts for: @pow2_4
;
  %d = udiv i32 %x, 4
  %m = mul i32 %d, 4
  %r = sub i32 %x, %m
  ret i32 %r
}

