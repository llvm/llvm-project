declare void @abort()

; The switch exit only reaches unreachable, so it is ignored.
define void @switch_exit_unreachable(i32 %op, ptr %p, i32 %n) {
; CHECK-LABEL: 'switch_exit_unreachable'
; CHECK-NEXT:  Determining loop execution counts for: @switch_exit_unreachable
; CHECK-NEXT:  Loop %loop: <multiple exits> backedge-taken count is (-1 + (1 umax %n))
; CHECK-NEXT:    exit count for loop: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    exit count for latch: (-1 + (1 umax %n))
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 umax %n))
; CHECK-NEXT:    symbolic max exit count for loop: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    symbolic max exit count for latch: (-1 + (1 umax %n))
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  switch i32 %op, label %dead [
    i32 0, label %add
    i32 1, label %sub
  ]

add:
  store i32 1, ptr %p
  br label %latch

sub:
  store i32 2, ptr %p
  br label %latch

latch:
  %iv.next = add nuw i32 %iv, 1
  %cmp = icmp ult i32 %iv.next, %n
  br i1 %cmp, label %loop, label %exit

dead:
  unreachable

exit:
  ret void
}

