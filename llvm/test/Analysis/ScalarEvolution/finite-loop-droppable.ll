; Droppable intrinsics do not count as side effects, so they do not prevent
; assuming that a mustprogress loop is finite.

define void @assume_in_loop(i64 %n, i64 %s, i1 %c) mustprogress {
; CHECK-LABEL: 'assume_in_loop'
; CHECK-NEXT:  Determining loop execution counts for: @assume_in_loop
; CHECK-NEXT:  Loop %for.body: backedge-taken count is ((((-1 * (1 umin ((-1 * %s) + (%n smax %s))))<nuw><nsw> + (-1 * %s) + (%n smax %s)) /u (1 umax %s)) + (1 umin ((-1 * %s) + (%n smax %s))))
; CHECK-NEXT:  Loop %for.body: constant max backedge-taken count is i64 -1
; CHECK-NEXT:  Loop %for.body: symbolic max backedge-taken count is ((((-1 * (1 umin ((-1 * %s) + (%n smax %s))))<nuw><nsw> + (-1 * %s) + (%n smax %s)) /u (1 umax %s)) + (1 umin ((-1 * %s) + (%n smax %s))))
; CHECK-NEXT:  Loop %for.body: Trip multiple is 1
;
entry:
  br label %for.body

for.body:
  %i.05 = phi i64 [ %add, %for.body ], [ 0, %entry ]
  call void @llvm.assume(i1 %c)
  %add = add nsw i64 %i.05, %s
  %cmp = icmp slt i64 %add, %n
  br i1 %cmp, label %for.body, label %for.end

for.end:
  ret void
}

