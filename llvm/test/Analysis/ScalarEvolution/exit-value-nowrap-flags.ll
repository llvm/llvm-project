;
entry:
  br label %loop.1

loop.1:
  %iv.1 = phi i32 [ %start, %entry ], [ %iv.1.next, %loop.1 ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop.1 ]
  %iv.1.next = add nuw i32 %iv.1, 1
  %i.next = add i32 %i, 1
  %ec.1 = icmp ult i32 %i.next, 5
