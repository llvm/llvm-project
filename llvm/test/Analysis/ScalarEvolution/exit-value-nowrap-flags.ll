; CHECK-NEXT:    %i = phi i32 [ 0, %entry ], [ %i.next, %loop.1 ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop.1> U: [0,5) S: [0,5) Exits: 4 LoopDispositions: { %loop.1: Computable }
