; CHECK-NEXT:  Loop %loop: backedge-taken count is ((1016 + (-1 * %x)) /u 8)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 2305843009213693951
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((1016 + (-1 * %x)) /u 8)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ %x, %entry ], [ %iv.next, %loop ]
