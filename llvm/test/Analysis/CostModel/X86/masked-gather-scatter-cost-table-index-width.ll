; Zen gather/scatter costs when the index comes from a GEP whose operands are
; narrower than a pointer.
;
; A GEP indexed by i32 needs only a dword of index per lane, so twelve i32 lanes
; and their indices both fit one zmm and CodeGen emits a single VPGATHERDD. The
; generic path only looks for that narrowing at VF 16 and above, where it is
; needed to avoid a split, and so counts two parts for a v12 shape; the table
; path takes the real index width at every VF, because it has to name the
; matching instruction class to price it.
;
; Enabling the feature therefore moves the part count here, and with it the cost
; kinds derived from that count. The FEATURE numbers are the ones that agree
; with the single instruction llc emits; the difference is deliberate rather
; than the feature leaking, and this test pins it so that it cannot change
; silently.

; RUN: opt < %s -S -mtriple=x86_64-unknown-linux-gnu -passes="print<cost-model>" 2>&1 -disable-output -cost-kind=all -mcpu=znver4 | FileCheck %s --check-prefix=FEATURE
; RUN: opt < %s -S -mtriple=x86_64-unknown-linux-gnu -passes="print<cost-model>" 2>&1 -disable-output -cost-kind=all -mcpu=znver4 -mattr=-prefer-gs-cost-table | FileCheck %s --check-prefix=GENERIC

; llc emits one vpgatherdd: the dword index leaves data and index each within a
; zmm, so there is nothing to split.
define <12 x i32> @gather_v12i32_dword_index(ptr %base, <12 x i32> %idx, <12 x i1> %mask) {
; FEATURE-LABEL: 'gather_v12i32_dword_index'
; FEATURE-NEXT:  Cost Model: Found costs of 0 for: %ptrs = getelementptr inbounds i32, ptr %base, <12 x i32> %idx
; FEATURE-NEXT:  Cost Model: Found costs of RThru:35 CodeSize:1 Lat:50 SizeLat:14 for: %v = call <12 x i32> @llvm.masked.gather.v12i32.v12p0(<12 x ptr> align 4 %ptrs, <12 x i1> %mask, <12 x i32> poison)
; FEATURE-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret <12 x i32> %v
;
; GENERIC-LABEL: 'gather_v12i32_dword_index'
; GENERIC-NEXT:  Cost Model: Found costs of 0 for: %ptrs = getelementptr inbounds i32, ptr %base, <12 x i32> %idx
; GENERIC-NEXT:  Cost Model: Found costs of RThru:16 CodeSize:2 Lat:52 SizeLat:16 for: %v = call <12 x i32> @llvm.masked.gather.v12i32.v12p0(<12 x ptr> align 4 %ptrs, <12 x i1> %mask, <12 x i32> poison)
; GENERIC-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret <12 x i32> %v
;
  %ptrs = getelementptr inbounds i32, ptr %base, <12 x i32> %idx
  %v = call <12 x i32> @llvm.masked.gather.v12i32.v12p0(<12 x ptr> %ptrs, i32 4, <12 x i1> %mask, <12 x i32> poison)
  ret <12 x i32> %v
}

