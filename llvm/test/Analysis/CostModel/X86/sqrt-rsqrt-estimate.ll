; The square root, divided into with the reciprocal allowed, is folded with the
; division into the estimate, the division carries the cost of the pair.

define float @folded(float %x, float %y) {
; CHECK-LABEL: 'folded'
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:0 SizeLat:1 for: %s = call float @llvm.sqrt.f32(float %x)
; CHECK-NEXT:  Cost Model: Found costs of RThru:7 CodeSize:1 Lat:13 SizeLat:1 for: %d = fdiv arcp float %y, %s
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret float %d
;
  %s = call float @llvm.sqrt.f32(float %x)
  %d = fdiv arcp float %y, %s
  ret float %d
}

