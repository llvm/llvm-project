; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py
; RUN: opt < %s -mtriple=x86_64-- -passes="print<cost-model>" 2>&1 -disable-output -cost-kind=all | FileCheck %s
;
; A scalar icmp that CodeGenPrepare will fold into a u{add,sub}.with.overflow
; intrinsic together with a same-block sibling add/sub is free: its result is
; read from the carry/borrow flag of the arithmetic op (#223995). Compares
; that CGP will not fold keep their normal cost.

; Canonical same-block uaddo: add then icmp using the add's result.
define i1 @uaddo_same_block(i64 %a, i64 %b) {
; CHECK-LABEL: 'uaddo_same_block'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %add = add i64 %b, %a
; CHECK-NEXT:  Cost Model: Found costs of 0 for: %cmp = icmp ult i64 %add, %a
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i1 %cmp
;
  %add = add i64 %b, %a
  %cmp = icmp ult i64 %add, %a
  ret i1 %cmp
}

; Canonical same-block usubo: A - B, A u< B.
define i1 @usubo_same_block(i64 %a, i64 %b) {
; CHECK-LABEL: 'usubo_same_block'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %sub = sub i64 %a, %b
; CHECK-NEXT:  Cost Model: Found costs of 0 for: %cmp = icmp ult i64 %a, %b
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i1 %cmp
;
  %sub = sub i64 %a, %b
  %cmp = icmp ult i64 %a, %b
  ret i1 %cmp
}

; Edge case: add X, 1 / icmp eq X, -1 (overflow when X is all-ones).
define i1 @uaddo_edge_eq_allones(i64 %x) {
; CHECK-LABEL: 'uaddo_edge_eq_allones'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %add = add i64 %x, 1
; CHECK-NEXT:  Cost Model: Found costs of 0 for: %cmp = icmp eq i64 %x, -1
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i1 %cmp
;
  %add = add i64 %x, 1
  %cmp = icmp eq i64 %x, -1
  ret i1 %cmp
}

; Edge case: add X, -1 / icmp ne X, 0 (overflow when X is zero).
define i1 @uaddo_edge_ne_zero(i64 %x) {
; CHECK-LABEL: 'uaddo_edge_ne_zero'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %add = add i64 %x, -1
; CHECK-NEXT:  Cost Model: Found costs of 0 for: %cmp = icmp ne i64 %x, 0
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i1 %cmp
;
  %add = add i64 %x, -1
  %cmp = icmp ne i64 %x, 0
  ret i1 %cmp
}

; Negative: PR41129-style cross-block usubo candidate (add is in a different
; block from the icmp). CodeGenPrepare rejects this because the increment is
; not a qualifying loop-IV increment, so this must stay at full cost.
define void @usubo_cross_block(ptr %p64) {
; CHECK-LABEL: 'usubo_cross_block'
; CHECK-NEXT:  Cost Model: Found costs of RThru:1 CodeSize:1 Lat:4 SizeLat:1 for: %key = load i64, ptr %p64, align 8
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %cond17 = icmp eq i64 %key, 0
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: br i1 %cond17, label %true, label %false
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %andval = and i64 %key, 7
; CHECK-NEXT:  Cost Model: Found costs of 1 for: store i64 %andval, ptr %p64, align 8
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: br label %exit
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %svalue = add i64 %key, -1
; CHECK-NEXT:  Cost Model: Found costs of 1 for: store i64 %svalue, ptr %p64, align 8
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: br label %exit
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret void
;
entry:
  %key = load i64, ptr %p64, align 8
  %cond17 = icmp eq i64 %key, 0
  br i1 %cond17, label %true, label %false

false:
  %andval = and i64 %key, 7
  store i64 %andval, ptr %p64
  br label %exit

true:
  %svalue = add i64 %key, -1
  store i64 %svalue, ptr %p64
  br label %exit

exit:
  ret void
}

; Negative: uaddo4-style compare used outside its own block. CodeGenPrepare's
; sinkCmpExpression clones the compare into "next" before any fold is
; attempted, so this icmp also stays at full cost.
define i64 @uaddo_sunk_cmp(i64 %a, i64 %b, i1 %c) {
; CHECK-LABEL: 'uaddo_sunk_cmp'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %add = add i64 %b, %a
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %cmp = icmp ugt i64 %b, %add
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: br i1 %c, label %next, label %exit
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %q = select i1 %cmp, i64 %b, i64 42
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i64 %q
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i64 0
;
entry:
  %add = add i64 %b, %a
  %cmp = icmp ugt i64 %b, %add
  br i1 %c, label %next, label %exit

next:
  %q = select i1 %cmp, i64 %b, i64 42
  ret i64 %q

exit:
  ret i64 0
}

; Negative: signed compare is never folded by CodeGenPrepare (only
; combineToU{Add,Sub}WithOverflow exist, no signed counterpart).
define i1 @signed_cmp_not_folded(i64 %a, i64 %b) {
; CHECK-LABEL: 'signed_cmp_not_folded'
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %add = add i64 %b, %a
; CHECK-NEXT:  Cost Model: Found costs of 1 for: %cmp = icmp slt i64 %add, %a
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret i1 %cmp
;
  %add = add i64 %b, %a
  %cmp = icmp slt i64 %add, %a
  ret i1 %cmp
}

; Negative: vector compares are excluded by the ValTy->isVectorTy() check.
define <2 x i1> @vector_cmp_not_folded(<2 x i64> %a, <2 x i64> %b) {
; CHECK-LABEL: 'vector_cmp_not_folded'
; CHECK-NEXT:  Cost Model: Found costs of RThru:1 CodeSize:1 Lat:2 SizeLat:2 for: %add = add <2 x i64> %b, %a
; CHECK-NEXT:  Cost Model: Found costs of RThru:7 CodeSize:7 Lat:6 SizeLat:7 for: %cmp = icmp ult <2 x i64> %add, %a
; CHECK-NEXT:  Cost Model: Found costs of RThru:0 CodeSize:1 Lat:1 SizeLat:1 for: ret <2 x i1> %cmp
;
  %add = add <2 x i64> %b, %a
  %cmp = icmp ult <2 x i64> %add, %a
  ret <2 x i1> %cmp
}
