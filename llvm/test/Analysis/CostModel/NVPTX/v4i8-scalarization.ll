; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py
; RUN: opt -passes="print<cost-model>" -disable-output < %s 2>&1 | FileCheck %s

target triple = "nvptx64-nvidia-cuda"

; ADD is expanded for v4i8, so BasicTTI includes getScalarizationOverhead() in
; its cost. The total is four scalar adds, four extracts, and seven to construct
; the result (three PRMTs and four extensions). The construction was previously
; miscosted as one, resulting in a total cost of nine.
define <4 x i8> @scalarized_add_v4i8(<4 x i8> %x, <4 x i8> %y) {
; CHECK-LABEL: 'scalarized_add_v4i8'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 15 for instruction: %add = add <4 x i8> %x, %y
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: ret <4 x i8> %add
;
  %add = add <4 x i8> %x, %y
  ret <4 x i8> %add
}
