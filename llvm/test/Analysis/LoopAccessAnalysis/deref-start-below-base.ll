; RUN: opt -passes='print<access-info>' -disable-output %s 2>&1 | FileCheck %s

; Accesses that start below the dereferenceable base pointer. Start - A wraps,
; so the deref-based no-wrap reasoning must not apply and the bounds must stay
; conservative.

target datalayout = "p1:32:32"

; Reverse loop from a symbolic start one element below the usual one; the last
; iteration accesses A[-1], and for n == 0 so does the first.
;
; Pseudocode:
;   // A, B: at least 8 i32s dereferenceable each, n in [0, 7]
;   for (i64 i = n; i >= 0; --i) {
;     i32 l = A[i - 1];
;     B[i] = 0;
;     if (l == 0) break;
;   }

define void @reverse_symbolic_start_below_base(ptr dereferenceable(32) %A, ptr dereferenceable(32) %B, i3 %n) {
; CHECK-LABEL: 'reverse_symbolic_start_below_base'
; CHECK-NEXT:    loop.header:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.B = getelementptr inbounds i32, ptr %B, i64 %iv
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.A = getelementptr inbounds i32, ptr %A.m1, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %B High: (4 + (4 * (zext i3 %n to i64))<nuw><nsw> + %B))
; CHECK-NEXT:            Member: {((4 * (zext i3 %n to i64))<nuw><nsw> + %B),+,-4}<nw><%loop.header>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: null High: ((4 * (zext i3 %n to i64))<nuw><nsw> + %A))
; CHECK-NEXT:            Member: {(-4 + (4 * (zext i3 %n to i64))<nuw><nsw> + %A),+,-4}<nw><%loop.header>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %n.ext = zext i3 %n to i64
  %A.m1 = getelementptr i8, ptr %A, i64 -4
  br label %loop.header

loop.header:
  %iv = phi i64 [ %n.ext, %entry ], [ %iv.dec, %loop.latch ]
  %gep.A = getelementptr inbounds i32, ptr %A.m1, i64 %iv
  %gep.B = getelementptr inbounds i32, ptr %B, i64 %iv
  %l = load i32, ptr %gep.A, align 4
  store i32 0, ptr %gep.B, align 4
  %uncntable = icmp eq i32 %l, 0
  br i1 %uncntable, label %exit.early, label %loop.latch

loop.latch:
  %iv.dec = add nsw i64 %iv, -1
  %ec = icmp eq i64 %iv, 0
  br i1 %ec, label %exit.done, label %loop.header

exit.early:
  ret void

exit.done:
  ret void
}

; Forward loop starting one element below A, with 32-bit pointers and a 64-bit
; induction variable; it reads A[-1] .. A[2]. The offset computation is wider
; than the index type, so the wrapped 32-bit Start - A zero-extends to
; 0xFFFFFFFC rather than to -4 in 64 bits.
;
; Pseudocode:
;   // A, B: at least 4 i32s dereferenceable each
;   for (i64 i = 0; i < 4; ++i) {
;     i32 l = A[i - 1];
;     B[i] = 0;
;     if (l == 0) break;
;   }

define void @forward_start_below_base_ptr32(ptr addrspace(1) dereferenceable(16) %A, ptr addrspace(1) dereferenceable(16) %B) {
; CHECK-LABEL: 'forward_start_below_base_ptr32'
; CHECK-NEXT:    loop.header:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.B = getelementptr inbounds i32, ptr addrspace(1) %B, i64 %iv
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.A = getelementptr inbounds i32, ptr addrspace(1) %A.m1, i64 %iv
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %B High: (16 + %B)<nuw>)
; CHECK-NEXT:            Member: {%B,+,4}<nuw><%loop.header>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: (-4 + %A) High: inttoptr (i32 -1 to ptr addrspace(1)))
; CHECK-NEXT:            Member: {(-4 + %A),+,4}<nw><%loop.header>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %A.m1 = getelementptr i8, ptr addrspace(1) %A, i32 -4
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i32, ptr addrspace(1) %A.m1, i64 %iv
  %gep.B = getelementptr inbounds i32, ptr addrspace(1) %B, i64 %iv
  %l = load i32, ptr addrspace(1) %gep.A, align 4
  store i32 0, ptr addrspace(1) %gep.B, align 4
  %uncntable = icmp eq i32 %l, 0
  br i1 %uncntable, label %exit.early, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 4
  br i1 %ec, label %exit.done, label %loop.header

exit.early:
  ret void

exit.done:
  ret void
}
