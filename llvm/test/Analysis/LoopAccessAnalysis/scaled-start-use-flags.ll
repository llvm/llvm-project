loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.iv = getelementptr i64, ptr %A, i64 %iv
  %l = load i64, ptr %gep.iv, align 8
  %iv.n = add nuw nsw i64 %iv, %n
  %gep.iv.n = getelementptr inbounds i64, ptr %A, i64 %iv.n
