; RUN: opt -disable-output -passes='print<access-info>' %s 2>&1 | FileCheck %s

; Each iteration promises that %a and %b point to different objects, but the two
; swap between %x and %y, so an iteration loads what the previous one stored.
; The promise does not make the loop's dependences safe.

define i64 @swap(ptr %x, ptr %y, i64 %n) {
; CHECK-LABEL: 'swap'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Unsafe indirect dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        IndirectUnsafe:
; CHECK-NEXT:            store i64 %i, ptr %b, align 8 ->
; CHECK-NEXT:            %v = load i64, ptr %a, align 8
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %odd = trunc i64 %i to i1
  %a = select i1 %odd, ptr %y, ptr %x
  %b = select i1 %odd, ptr %x, ptr %y
  call void @llvm.assume(i1 true) [ "separate_storage"(ptr %a, ptr %b) ]
  store i64 %i, ptr %b, align 8
  %v = load i64, ptr %a, align 8
  %sum.next = add i64 %sum, %v
  %i.next = add i64 %i, 1
  %cond = icmp ult i64 %i.next, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret i64 %sum.next
}

; A promise about loop-invariant pointers holds in every iteration, so the loop
; needs no run-time checks.

define void @invariant(ptr %x, ptr %y, i64 %n) {
; CHECK-LABEL: 'invariant'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Grouped accesses:
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  call void @llvm.assume(i1 true) [ "separate_storage"(ptr %x, ptr %y) ]
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %src = getelementptr inbounds i64, ptr %x, i64 %i
  %v = load i64, ptr %src, align 8
  %dst = getelementptr inbounds i64, ptr %y, i64 %i
  store i64 %v, ptr %dst, align 8
