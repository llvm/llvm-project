loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %s8 = mul i64 %iv, 8
  %b0 = getelementptr inbounds i8, ptr %a, i64 %s8
  %p0 = getelementptr inbounds i8, ptr %b0, i64 %cdj
  %v0 = load i64, ptr %p0
  %s16 = mul i64 %iv, 16
  %p1 = getelementptr inbounds i8, ptr %a, i64 %s16
