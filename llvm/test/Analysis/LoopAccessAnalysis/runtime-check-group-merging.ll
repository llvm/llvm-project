;; ranges are equal even though the steps differ (8 vs 16).
define void @equal_range_different_step_no_merge(ptr %a, ptr %out, i64 %cdj) {
; CHECK-LABEL: 'equal_range_different_step_no_merge'
; CHECK-NEXT:    loop:
