target datalayout = "p270:32:32-ni:2"

; The 3 stencil loads from %b in addrspace(1) merge into one group (GRP2),
; checked against the store to %a in addrspace(0). The load through the
; addrspacecast of %b is a separate group (GRP1): it uses a different pointer
; base, so it is not merged. Both groups get a run-time check against %a.
define void @stencil_merged_group_addrspace_0_and_1(ptr %a, ptr addrspace(1) %b, i64 %s, i64 %n) {
; CHECK-LABEL: 'stencil_merged_group_addrspace_0_and_1'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
; CHECK-NEXT:        Against group GRP1:
; CHECK-NEXT:          %gep.b.cast.plus.s = getelementptr inbounds i32, ptr %gep.b.cast, i64 %s
; CHECK-NEXT:      Check 1:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %gep.b.plus.s = getelementptr inbounds i32, ptr addrspace(1) %gep.b, i64 %s
; CHECK-NEXT:          %gep.b = getelementptr inbounds i32, ptr addrspace(1) %b, i64 %iv
; CHECK-NEXT:          %gep.b.minus.s = getelementptr inbounds i32, ptr addrspace(1) %gep.b, i64 %neg.s
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: %a High: ((4 * %n) + %a))
; CHECK-NEXT:            Member: {%a,+,4}<nuw><%loop>
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: ((4 * %s)<nsw> + %b.cast) High: ((4 * %s)<nsw> + (4 * %n) + %b.cast))
; CHECK-NEXT:            Member: {((4 * %s)<nsw> + %b.cast),+,4}<nw><%loop>
; CHECK-NEXT:        Group GRP2:
; CHECK-NEXT:          (Low: ((-4 * %s) + %b) High: ((4 * %s)<nsw> + (4 * %n) + %b))
; CHECK-NEXT:            Member: {((4 * %s)<nsw> + %b),+,4}<nw><%loop>
; CHECK-NEXT:            Member: {%b,+,4}<nuw><%loop>
; CHECK-NEXT:            Member: {((-4 * %s) + %b),+,4}<nw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-NEXT:      Compare predicate: %s sgt) 0
; CHECK-NEXT:      Compare predicate: %s sle) 1152921504606846975
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %neg.s = sub i64 0, %s
  %b.cast = addrspacecast ptr addrspace(1) %b to ptr
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.b = getelementptr inbounds i32, ptr addrspace(1) %b, i64 %iv
  %gep.b.minus.s = getelementptr inbounds i32, ptr addrspace(1) %gep.b, i64 %neg.s
  %gep.b.plus.s = getelementptr inbounds i32, ptr addrspace(1) %gep.b, i64 %s
  %gep.b.cast = getelementptr inbounds i32, ptr %b.cast, i64 %iv
  %gep.b.cast.plus.s = getelementptr inbounds i32, ptr %gep.b.cast, i64 %s
  %l.b.minus.s = load i32, ptr addrspace(1) %gep.b.minus.s, align 4
  %l.b = load i32, ptr addrspace(1) %gep.b, align 4
  %l.b.plus.s = load i32, ptr addrspace(1) %gep.b.plus.s, align 4
  %l.b.cast.plus.s = load i32, ptr %gep.b.cast.plus.s, align 4
  %add.0 = add i32 %l.b.minus.s, %l.b
  %add.1 = add i32 %add.0, %l.b.plus.s
  %add.2 = add i32 %add.1, %l.b.cast.plus.s
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  store i32 %add.2, ptr %gep.a, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

