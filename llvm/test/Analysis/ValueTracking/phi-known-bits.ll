; p8: 128-bit pointer, 48 active address bits. icmp compares only address bits,
; so the guard does not constrain bits 64..127 of the ptrtoint.
;=================================================================================

define i128 @phi_fat_pointer_ult_18_no_fold(ptr addrspace(8) %p, ptr addrspace(8) %q) {
; CHECK-LABEL: @phi_fat_pointer_ult_18_no_fold(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[C1:%.*]] = icmp ult ptr addrspace(8) [[P:%.*]], inttoptr (i128 16 to ptr addrspace(8))
; CHECK-NEXT:    br i1 [[C1]], label [[JOIN:%.*]], label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[C2:%.*]] = icmp ult ptr addrspace(8) [[Q:%.*]], inttoptr (i128 16 to ptr addrspace(8))
; CHECK-NEXT:    br i1 [[C2]], label [[JOIN]], label [[EXIT:%.*]]
; CHECK:       join:
; CHECK-NEXT:    [[PHI:%.*]] = phi ptr addrspace(8) [ [[P]], [[ENTRY:%.*]] ], [ [[Q]], [[NEXT]] ]
; CHECK-NEXT:    [[I:%.*]] = ptrtoint ptr addrspace(8) [[PHI]] to i128
; CHECK-NEXT:    [[HI:%.*]] = lshr i128 [[I]], 64
; CHECK-NEXT:    ret i128 [[HI]]
; CHECK:       exit:
; CHECK-NEXT:    ret i128 1
;
entry:
  %c1 = icmp ult ptr addrspace(8) %p, inttoptr (i128 16 to ptr addrspace(8))
  br i1 %c1, label %join, label %next

next:
  %c2 = icmp ult ptr addrspace(8) %q, inttoptr (i128 16 to ptr addrspace(8))
  br i1 %c2, label %join, label %exit

join:
  %phi = phi ptr addrspace(8) [ %p, %entry ], [ %q, %next ]
  %i = ptrtoint ptr addrspace(8) %phi to i128
  %hi = lshr i128 %i, 64
  ret i128 %hi

exit:
  ret i128 1
}

define i128 @phi_fat_pointer_eq_null_no_fold(ptr addrspace(8) %p, ptr addrspace(8) %q) {
; CHECK-LABEL: @phi_fat_pointer_eq_null_no_fold(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[C1:%.*]] = icmp eq ptr addrspace(8) [[P:%.*]], null
; CHECK-NEXT:    br i1 [[C1]], label [[JOIN:%.*]], label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[C2:%.*]] = icmp eq ptr addrspace(8) [[Q:%.*]], null
; CHECK-NEXT:    br i1 [[C2]], label [[JOIN]], label [[EXIT:%.*]]
; CHECK:       join:
; CHECK-NEXT:    [[PHI:%.*]] = phi ptr addrspace(8) [ [[P]], [[ENTRY:%.*]] ], [ [[Q]], [[NEXT]] ]
; CHECK-NEXT:    [[I:%.*]] = ptrtoint ptr addrspace(8) [[PHI]] to i128
; CHECK-NEXT:    [[HI:%.*]] = lshr i128 [[I]], 64
; CHECK-NEXT:    ret i128 [[HI]]
; CHECK:       exit:
; CHECK-NEXT:    ret i128 1
;
entry:
  %c1 = icmp eq ptr addrspace(8) %p, null
  br i1 %c1, label %join, label %next
next:
  %c2 = icmp eq ptr addrspace(8) %q, null
  br i1 %c2, label %join, label %exit
join:
  %phi = phi ptr addrspace(8) [ %p, %entry ], [ %q, %next ]
  %i = ptrtoint ptr addrspace(8) %phi to i128
  %hi = lshr i128 %i, 64
  ret i128 %hi
exit:
  ret i128 1
}
