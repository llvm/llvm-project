; CHECK-NEXT:    br i1 [[CMP]], label [[T:%.*]], label [[F:%.*]]
; CHECK:       T:
; CHECK-NEXT:    ret i32 1073741824
; CHECK:       F:
; CHECK-NEXT:    br label [[T]]
