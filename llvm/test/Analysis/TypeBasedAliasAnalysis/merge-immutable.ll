; memory if both access tags do.

define i32 @same_access_path(i1 %c, ptr %p) {
; CHECK-LABEL: define i32 @same_access_path(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[END:.*:]]
; CHECK-NEXT:    [[A:%.*]] = load i32, ptr [[P]], align 4, !tbaa [[TBAA0:![0-9]+]]
; CHECK-NEXT:    ret i32 [[A]]
;
  br i1 %c, label %if, label %else

if:
  %a = load i32, ptr %p, align 4, !tbaa !5
  br label %end

else:
  %b = load i32, ptr %p, align 4, !tbaa !6
  br label %end

end:
  %r = phi i32 [ %a, %if ], [ %b, %else ]
  ret i32 %r
}

