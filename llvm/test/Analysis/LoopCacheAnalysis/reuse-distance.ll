; A[i] and A[i+1024] are 4096 bytes apart: two groups.
define void @far_fwd(ptr %A) {
; CHECK-LABEL: 'far_fwd'
; CHECK-NEXT:  Loop 'loop' has cost = 16
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %p0 = getelementptr inbounds i32, ptr %A, i64 %i
  %i.off = add nuw nsw i64 %i, 1024
  %p1 = getelementptr inbounds i32, ptr %A, i64 %i.off
  %a = load i32, ptr %p0, align 1
  %b = load i32, ptr %p1, align 1
  %i.next = add nuw nsw i64 %i, 1
  %cond = icmp ult i64 %i.next, 128
  br i1 %cond, label %loop, label %exit

exit:
  ret void
}

