# RUN: split-file %s %t
# RUN: not llc -mtriple=spirv64-unknown-unknown -run-pass=none -filetype=null %t/not-a-type.mir 2>&1 | FileCheck %t/not-a-type.mir
# RUN: not llc -mtriple=spirv64-unknown-unknown -run-pass=none -filetype=null %t/undef-reg.mir 2>&1 | FileCheck %t/undef-reg.mir

;--- not-a-type.mir
---
name: not_a_type
machineFunctionInfo:
  vregTypes:
    - { reg: '%1', type: '%1' }
# CHECK: :[[@LINE-1]]:{{[0-9]+}}: expected a SPIR-V type register
body:             |
  bb.0:
    %0:type(s64) = OpTypeInt 32, 0
    %1:iid(i32) = OpConstantNull %0(s64)
...

;--- undef-reg.mir
---
name: undef_vreg
machineFunctionInfo:
  vregTypes:
    - { reg: '%1', type: '%0' }
# CHECK: :[[@LINE-1]]:{{[0-9]+}}: use of undefined virtual register
body:             |
  bb.0:
    %0:type(s64) = OpTypeInt 32, 0
...
