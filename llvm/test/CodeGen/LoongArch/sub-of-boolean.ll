; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc --mtriple=loongarch64 < %s | FileCheck %s

; LoongArch's SUB has no immediate form, so (sub C, boolean) with C - 1 fitting
; a 12-bit signed immediate is rewritten as (add (setcc inv), C - 1), letting
; the immediate fold into an ADDI. The boolean setcc is produced with one of
; the 1-instruction sltu/sltui forms.

define i64 @sub_bool_even(i64 %x, i64 %y) {
; CHECK-LABEL: sub_bool_even:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    sltu $a0, $zero, $a0
; CHECK-NEXT:    addi.d $a0, $a0, 5
; CHECK-NEXT:    ret
  %c = icmp eq i64 %x, %y
  %z = zext i1 %c to i64
  %r = sub i64 6, %z
  ret i64 %r
}

; For odd constants, (sub C, boolean) is already folded to (xor C, boolean) by
; the generic combiner, which is equally good; keep it as a regression guard.

define i64 @sub_bool_odd(i64 %x, i64 %y) {
; CHECK-LABEL: sub_bool_odd:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    sltui $a0, $a0, 1
; CHECK-NEXT:    xori $a0, $a0, 5
; CHECK-NEXT:    ret
  %c = icmp eq i64 %x, %y
  %z = zext i1 %c to i64
  %r = sub i64 5, %z
  ret i64 %r
}

; When C - 1 doesn't fit the ADDI immediate, keep the original form.

define i64 @sub_bool_big(i64 %x, i64 %y) {
; CHECK-LABEL: sub_bool_big:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    sltui $a0, $a0, 1
; CHECK-NEXT:    lu12i.w $a1, 24
; CHECK-NEXT:    ori $a1, $a1, 1696
; CHECK-NEXT:    sub.d $a0, $a1, $a0
; CHECK-NEXT:    ret
  %c = icmp eq i64 %x, %y
  %z = zext i1 %c to i64
  %r = sub i64 100000, %z
  ret i64 %r
}
