;; A narrower store in a predecessor block writes into the copied bytes:
;; break the copy around it.
define void @conditional_store(ptr noalias %s1, ptr noalias %s2, i32 %x, ptr noalias %s3, ptr noalias %s4) {
; LSX-LABEL: conditional_store:
; LSX:       # %bb.0: # %entry
; LSX-NEXT:    addi.w $a5, $a2, 0
; LSX-NEXT:    ori $a6, $zero, 18
; LSX-NEXT:    blt $a5, $a6, .LBB7_2
; LSX-NEXT:  # %bb.1: # %if.then
; LSX-NEXT:    st.w $a2, $a0, 4
; LSX-NEXT:  .LBB7_2: # %if.end
; LSX-NEXT:    vld $vr0, $a0, 0
; LSX-NEXT:    vld $vr1, $a4, 0
; LSX-NEXT:    vst $vr0, $a3, 0
; LSX-NEXT:    vst $vr1, $a1, 0
; LSX-NEXT:    ret
; LASX-LABEL: conditional_store:
; LASX:       # %bb.0: # %entry
; LASX-NEXT:    addi.w $a5, $a2, 0
; LASX-NEXT:    ori $a6, $zero, 18
; LASX-NEXT:    blt $a5, $a6, .LBB7_2
; LASX-NEXT:  # %bb.1: # %if.then
; LASX-NEXT:    st.w $a2, $a0, 4
; LASX-NEXT:  .LBB7_2: # %if.end
; LASX-NEXT:    vld $vr0, $a0, 0
; LASX-NEXT:    vld $vr1, $a4, 0
; LASX-NEXT:    vst $vr0, $a3, 0
; LASX-NEXT:    vst $vr1, $a1, 0
; LASX-NEXT:    ret
entry:
  %cmp = icmp sgt i32 %x, 17
  br i1 %cmp, label %if.then, label %if.end

if.then:
  %b = getelementptr inbounds i8, ptr %s1, i64 4
  store i32 %x, ptr %b, align 4
  br label %if.end

if.end:
  tail call void @llvm.memcpy.p0.p0.i64(ptr align 4 %s3, ptr align 4 %s1, i64 16, i1 false)
  tail call void @llvm.memcpy.p0.p0.i64(ptr align 4 %s2, ptr align 4 %s4, i64 16, i1 false)
  ret void
}

