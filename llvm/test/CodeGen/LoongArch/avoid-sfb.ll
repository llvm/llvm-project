;; Small memcpy/memmove are lowered to ld.d/st.d, fld.d/fst.d, vld/vst or
;; xvld/xvst copies. A copy whose load reads data from in-flight narrower
;; stores is broken into smaller copies when:
;; - a narrower store writes into the loaded bytes;
;; - in a loop, a store of the previous iteration writes the same buffer, as in
;;   LZ77 back-reference copies (reduced from snap::decompress::Decoder).

;; Pattern extension: dst - src grows until it reaches 16.
define ptr @pattern_extend(ptr %dst, i64 %diff0) {
; LSX-LABEL: pattern_extend:
; LSX:       # %bb.0: # %entry
; LSX-NEXT:    sub.d $a2, $a0, $a1
; LSX-NEXT:    ori $a3, $zero, 16
; LSX-NEXT:    .p2align 4, , 16
; LSX-NEXT:  .LBB0_1: # %loop
; LSX-NEXT:    # =>This Inner Loop Header: Depth=1
; LSX-NEXT:    vld $vr0, $a2, 0
; LSX-NEXT:    vst $vr0, $a0, 0
; LSX-NEXT:    add.d $a0, $a0, $a1
; LSX-NEXT:    sub.d $a1, $a0, $a2
; LSX-NEXT:    bltu $a1, $a3, .LBB0_1
; LSX-NEXT:  # %bb.2: # %exit
; LSX-NEXT:    ret
; LASX-LABEL: pattern_extend:
; LASX:       # %bb.0: # %entry
; LASX-NEXT:    sub.d $a2, $a0, $a1
; LASX-NEXT:    ori $a3, $zero, 16
; LASX-NEXT:    .p2align 4, , 16
; LASX-NEXT:  .LBB0_1: # %loop
; LASX-NEXT:    # =>This Inner Loop Header: Depth=1
; LASX-NEXT:    vld $vr0, $a2, 0
; LASX-NEXT:    vst $vr0, $a0, 0
; LASX-NEXT:    add.d $a0, $a0, $a1
; LASX-NEXT:    sub.d $a1, $a0, $a2
; LASX-NEXT:    bltu $a1, $a3, .LBB0_1
; LASX-NEXT:  # %bb.2: # %exit
; LASX-NEXT:    ret
entry:
  %neg = sub i64 0, %diff0
  %src = getelementptr inbounds i8, ptr %dst, i64 %neg
  br label %loop

loop:
  %diff = phi i64 [ %diff0, %entry ], [ %diff.next, %loop ]
  %d = phi ptr [ %dst, %entry ], [ %d.next, %loop ]
  tail call void @llvm.memmove.p0.p0.i64(ptr align 1 %d, ptr align 1 %src, i64 16, i1 false)
  %d.next = getelementptr inbounds nuw i8, ptr %d, i64 %diff
  %di = ptrtoint ptr %d.next to i64
  %si = ptrtoint ptr %src to i64
  %diff.next = sub i64 %di, %si
  %done = icmp ugt i64 %diff.next, 15
  br i1 %done, label %exit, label %loop

exit:
  ret ptr %d.next
}

