; RUN: llc -mtriple=loongarch64 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,OPT
; RUN: llc -mtriple=loongarch64 -loongarch-enable-sink-fold=false -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,NOFOLD

; Exercise loop-invariant and load-produced indices, shared address arithmetic,
; and the machine sink-and-fold option.

; The reviewer pointer chase: an invariant index and a load-produced base.
define ptr @invariant_chase(ptr %n, i64 %level) nounwind {
; CHECK-LABEL: invariant_chase:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    slli.d $a2, $a1, 3
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    move $a1, $a0
; CHECK-NEXT:    ldx.d $a0, $a0, $a2
; CHECK-NEXT:    bnez $a0, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %p = phi ptr [ %n, %entry ], [ %next, %loop ]
  %slot = getelementptr inbounds ptr, ptr %p, i64 %level
  %next = load ptr, ptr %slot, align 8
  %done = icmp eq ptr %next, null
  br i1 %done, label %exit, label %loop

exit:
  ret ptr %p
}

; A counted pointer recurrence with an invariant index and a zero-trip path.
define ptr @invariant_counted_chase(ptr %first, i64 %level, i64 %steps) nounwind {
; CHECK-LABEL: invariant_counted_chase:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    beqz $a2, .LBB1_3
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB1_2: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    addi.d $a2, $a2, -1
; CHECK-NEXT:    bnez $a2, .LBB1_2
; CHECK-NEXT:  .LBB1_3: # %exit
; CHECK-NEXT:    ret
entry:
  %empty = icmp eq i64 %steps, 0
  br i1 %empty, label %exit, label %loop

loop:
  %base = phi ptr [ %first, %entry ], [ %next, %loop ]
  %left = phi i64 [ %steps, %entry ], [ %remaining, %loop ]
  %offset = shl i64 %level, 3
  %addr = getelementptr i8, ptr %base, i64 %offset
  %next = load ptr, ptr %addr, align 8
  %remaining = add i64 %left, -1
  %done = icmp eq i64 %remaining, 0
  br i1 %done, label %exit, label %loop

exit:
  %result = phi ptr [ %first, %entry ], [ %next, %loop ]
  ret ptr %result
}

; The reviewer sum4: four typed GEPs use the same index with distinct bases.
define i64 @sum4_gep(ptr %a, ptr %b, ptr %c, ptr %d, i64 %i) nounwind {
; CHECK-LABEL: sum4_gep:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a4, $a4, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a4
; CHECK-NEXT:    ldx.d $a1, $a1, $a4
; CHECK-NEXT:    ldx.d $a2, $a2, $a4
; CHECK-NEXT:    ldx.d $a3, $a3, $a4
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    add.d $a1, $a2, $a3
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    ret
  %pa = getelementptr inbounds i64, ptr %a, i64 %i
  %pb = getelementptr inbounds i64, ptr %b, i64 %i
  %pc = getelementptr inbounds i64, ptr %c, i64 %i
  %pd = getelementptr inbounds i64, ptr %d, i64 %i
  %va = load i64, ptr %pa, align 8
  %vb = load i64, ptr %pb, align 8
  %vc = load i64, ptr %pc, align 8
  %vd = load i64, ptr %pd, align 8
  %s0 = add i64 %va, %vb
  %s1 = add i64 %s0, %vc
  %s2 = add i64 %s1, %vd
  ret i64 %s2
}

; Two stores share one explicitly shifted index.
define void @shared_two_stores(ptr %a, ptr %b, i64 %i, i64 %value) nounwind {
; CHECK-LABEL: shared_two_stores:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a2, $a2, 3
; CHECK-NEXT:    stx.d $a3, $a0, $a2
; CHECK-NEXT:    stx.d $a3, $a1, $a2
; CHECK-NEXT:    ret
  %offset = shl i64 %i, 3
  %pa = getelementptr i8, ptr %a, i64 %offset
  %pb = getelementptr i8, ptr %b, i64 %offset
  store i64 %value, ptr %pa, align 8
  store i64 %value, ptr %pb, align 8
  ret void
}

; A load and a store share one explicitly shifted index.
define i64 @shared_load_store(ptr %src, ptr %dst, i64 %i) nounwind {
; CHECK-LABEL: shared_load_store:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a2, $a2, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a2
; CHECK-NEXT:    stx.d $a0, $a1, $a2
; CHECK-NEXT:    ret
  %offset = shl i64 %i, 3
  %from = getelementptr i8, ptr %src, i64 %offset
  %to = getelementptr i8, ptr %dst, i64 %offset
  %value = load i64, ptr %from, align 8
  store i64 %value, ptr %to, align 8
  ret i64 %value
}

; The shifted index also feeds an observable scalar computation.
define i64 @shared_scalar_use(ptr %base, i64 %i) nounwind {
; CHECK-LABEL: shared_scalar_use:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    ret
  %offset = shl i64 %i, 3
  %addr = getelementptr i8, ptr %base, i64 %offset
  %value = load i64, ptr %addr, align 8
  %result = xor i64 %value, %offset
  ret i64 %result
}

; The index is produced by the preceding load; the table base is invariant.
define i64 @late_index_chain(ptr %table, i64 %first) nounwind {
; OPT-LABEL: late_index_chain:
; OPT:       # %bb.0: # %entry
; OPT-NEXT:    .p2align 4, , 16
; OPT-NEXT:  .LBB6_1: # %loop
; OPT-NEXT:    # =>This Inner Loop Header: Depth=1
; OPT-NEXT:    move $a2, $a1
; OPT-NEXT:    alsl.d $a1, $a1, $a0, 3
; OPT-NEXT:    ld.d $a1, $a1, 0
; OPT-NEXT:    bnez $a1, .LBB6_1
; OPT-NEXT:  # %bb.2: # %exit
; OPT-NEXT:    move $a0, $a2
; OPT-NEXT:    ret
;
; NOFOLD-LABEL: late_index_chain:
; NOFOLD:       # %bb.0: # %entry
; NOFOLD-NEXT:    .p2align 4, , 16
; NOFOLD-NEXT:  .LBB6_1: # %loop
; NOFOLD-NEXT:    # =>This Inner Loop Header: Depth=1
; NOFOLD-NEXT:    move $a2, $a1
; NOFOLD-NEXT:    slli.d $a1, $a1, 3
; NOFOLD-NEXT:    ldx.d $a1, $a0, $a1
; NOFOLD-NEXT:    bnez $a1, .LBB6_1
; NOFOLD-NEXT:  # %bb.2: # %exit
; NOFOLD-NEXT:    move $a0, $a2
; NOFOLD-NEXT:    ret
entry:
  br label %loop

loop:
  %index = phi i64 [ %first, %entry ], [ %next, %loop ]
  %offset = shl i64 %index, 3
  %addr = getelementptr i8, ptr %table, i64 %offset
  %next = load i64, ptr %addr, align 8
  %done = icmp eq i64 %next, 0
  br i1 %done, label %exit, label %loop

exit:
  ret i64 %index
}
