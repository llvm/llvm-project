# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=loongarch32 -run-pass=greedy,virt-reg-rewriter %s -o - | FileCheck %s
# RUN: llc -mtriple=loongarch64 -run-pass=greedy,virt-reg-rewriter %s -o - | FileCheck %s

# Omit maxCallFrameSize so mirFileLoaded() must compute it before register allocation.
# Check that $r22 is reserved as FP for a large call frame, but available for a small one.

---
name: large_call_frame
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, preferred-register: '$r22' }
frameInfo:
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    ; CHECK-LABEL: name: large_call_frame
    ; CHECK: renamable $r23 = ADDI_W $r0, 42
    ; CHECK-NEXT: ADJCALLSTACKDOWN 16384, 0, implicit-def dead $r3, implicit $r3
    ; CHECK-NEXT: BL &callee, csr_ilp32d_lp64d, implicit-def dead $r1, implicit-def $r3
    ; CHECK-NEXT: ADJCALLSTACKUP 16384, 0, implicit-def dead $r3, implicit $r3
    ; CHECK-NEXT: $r4 = ADDI_W killed renamable $r23, 1
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = ADDI_W $r0, 42
    ADJCALLSTACKDOWN 16384, 0, implicit-def dead $r3, implicit $r3
    BL &callee, csr_ilp32d_lp64d, implicit-def dead $r1, implicit-def $r3
    ADJCALLSTACKUP 16384, 0, implicit-def dead $r3, implicit $r3
    $r4 = ADDI_W %0, 1
    PseudoRET implicit $r4
...

---
name: small_call_frame
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr, preferred-register: '$r22' }
frameInfo:
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    ; CHECK-LABEL: name: small_call_frame
    ; CHECK: renamable $r22 = ADDI_W $r0, 42
    ; CHECK-NEXT: ADJCALLSTACKDOWN 16, 0, implicit-def dead $r3, implicit $r3
    ; CHECK-NEXT: BL &callee, csr_ilp32d_lp64d, implicit-def dead $r1, implicit-def $r3
    ; CHECK-NEXT: ADJCALLSTACKUP 16, 0, implicit-def dead $r3, implicit $r3
    ; CHECK-NEXT: $r4 = ADDI_W killed renamable $r22, 1
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = ADDI_W $r0, 42
    ADJCALLSTACKDOWN 16, 0, implicit-def dead $r3, implicit $r3
    BL &callee, csr_ilp32d_lp64d, implicit-def dead $r1, implicit-def $r3
    ADJCALLSTACKUP 16, 0, implicit-def dead $r3, implicit $r3
    $r4 = ADDI_W %0, 1
    PseudoRET implicit $r4
...
