; LA32-NEXT:    ld.hu $a1, $a0, 6
; LA32-NEXT:    ld.hu $a2, $a0, 4
; LA32-NEXT:    ld.hu $a3, $a0, 2
; LA32-NEXT:    ld.hu $a0, $a0, 0
; LA32-NEXT:    slli.w $a1, $a1, 16
; LA32-NEXT:    or $a1, $a1, $a2
; LA32-NEXT:    slli.w $a2, $a3, 16
; LA32-NEXT:    or $a0, $a2, $a0
; LA32-NEXT:    vinsgr2vr.w $vr0, $a0, 0
; LA32-NEXT:    vinsgr2vr.w $vr0, $a1, 1
; LA32-NEXT:    vslti.h $vr1, $vr0, 0
; LA32-NEXT:    vilvl.h $vr0, $vr1, $vr0
; LA32-NEXT:    vslti.w $vr1, $vr0, 0
; LA32-NEXT:    vilvl.w $vr0, $vr1, $vr0
; LA32-NEXT:    ret
;
; LA64-LABEL: load_4xi16_sext:
; LA64:       # %bb.0:
; LA64-NEXT:    ld.d $a0, $a0, 0
; LA64-NEXT:    vinsgr2vr.d $vr0, $a0, 0
; LA64-NEXT:    vslti.h $vr1, $vr0, 0
; LA64-NEXT:    vilvl.h $vr0, $vr1, $vr0
; LA64-NEXT:    vslti.w $vr1, $vr0, 0
; LA64-NEXT:    vilvl.w $vr0, $vr1, $vr0
; LA64-NEXT:    ret
  %v = load <4 x i16>, ptr %p, align 2
  %s = sext <4 x i16> %v to <4 x i64>
  %ret = shufflevector <4 x i64> %s, <4 x i64> poison, <2 x i32> <i32 0, i32 1>
  ret <2 x i64> %ret
}

