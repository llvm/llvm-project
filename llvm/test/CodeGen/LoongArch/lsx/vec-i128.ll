;; Converting the load of %a to a <2 x i64> load CSEs it with %w, which in turn
;; CSEs the add of %a with the add of %wc while the add is being combined.
define void @add_v1i128_cse_load(ptr %res0, ptr %res1, ptr %res2, ptr %a0, ptr %a1) nounwind {
; CHECK-LABEL: add_v1i128_cse_load:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vld $vr0, $a3, 0
; CHECK-NEXT:    vld $vr1, $a4, 0
; CHECK-NEXT:    vadd.q $vr1, $vr0, $vr1
; CHECK-NEXT:    vst $vr1, $a0, 0
; CHECK-NEXT:    vst $vr1, $a1, 0
; CHECK-NEXT:    vst $vr0, $a2, 0
; CHECK-NEXT:    ret
entry:
  %a = load <1 x i128>, ptr %a0
  %w = load <2 x i64>, ptr %a0
  %b = load <1 x i128>, ptr %a1
  %wc = bitcast <2 x i64> %w to <1 x i128>
  %x = add <1 x i128> %wc, %b
  %y = add <1 x i128> %a, %b
  store <1 x i128> %x, ptr %res0
  store <1 x i128> %y, ptr %res1
  store <2 x i64> %w, ptr %res2
  ret void
}
