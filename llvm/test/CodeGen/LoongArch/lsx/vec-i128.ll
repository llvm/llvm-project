; LA32-NEXT:    add.w $a2, $a2, $a7
; LA32-NEXT:    st.w $a5, $a0, 0
; LA32-NEXT:    st.w $a6, $a0, 4
; LA32-NEXT:    st.w $a1, $a0, 8
; LA32-NEXT:    st.w $a2, $a0, 12
; LA32-NEXT:    ret
;
; LA64-LABEL: add_v1i128_insertelt:
; LA64:       # %bb.0: # %entry
; LA64-NEXT:    add.d $a1, $a1, $a3
; LA64-NEXT:    add.d $a2, $a0, $a2
; LA64-NEXT:    sltu $a0, $a2, $a0
; LA64-NEXT:    add.d $a1, $a1, $a0
; LA64-NEXT:    move $a0, $a2
; LA64-NEXT:    ret
entry:
  %x0 = insertelement <2 x i64> poison, i64 %a, i32 0
  %x1 = insertelement <2 x i64> %x0, i64 %b, i32 1
  %y0 = insertelement <2 x i64> poison, i64 %c, i32 0
