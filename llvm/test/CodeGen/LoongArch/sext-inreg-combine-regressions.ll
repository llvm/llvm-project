}

; R5: one fcmp result used by both a zext and a sext_inreg.
; Before: one fcmp + movcf2gr + sub.d + srl.d.
; Now the XOR branch inverts the compare, duplicating the fcmp.
define i64 @sext_zext_not_fcmp(double %a) {
; CHECK-LABEL: sext_zext_not_fcmp:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fcmp.cun.d $fcc0, $fa0, $fa0
; CHECK-NEXT:    fcmp.cor.d $fcc1, $fa0, $fa0
; CHECK-NEXT:    movcf2gr $a0, $fcc0
; CHECK-NEXT:    addi.d $a0, $a0, -1
; CHECK-NEXT:    movcf2gr $a1, $fcc1
; CHECK-NEXT:    srl.d $a0, $a1, $a0
; CHECK-NEXT:    ret
  %u = fcmp une double %a, %a
  %z = zext i1 %u to i64
  %n = xor i64 %z, -1
  %s = shl i64 %n, 63
  %m = ashr i64 %s, 63
  %neg = sub i64 0, %m
  %r = lshr i64 %neg, %m
  ret i64 %r
}

