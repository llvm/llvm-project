; Before: the negation folded into addi.d 5. Now the internal
; sub 0, setcc is rewritten by combineSubOfBoolean (C == 0), so the
; subtraction is materialized separately.
define i64 @sub_c_sext_eq_store(i64 %a, i64 %b, ptr %p) {
; CHECK-LABEL: sub_c_sext_eq_store:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    sltu $a0, $zero, $a0
; CHECK-NEXT:    addi.d $a1, $a0, -1
; CHECK-NEXT:    ori $a3, $zero, 6
; CHECK-NEXT:    sub.d $a0, $a3, $a0
; CHECK-NEXT:    st.d $a1, $a2, 0
; CHECK-NEXT:    ret
  %c = icmp eq i64 %a, %b
  %s = sext i1 %c to i64
  store i64 %s, ptr %p
  %t = sub i64 5, %s
