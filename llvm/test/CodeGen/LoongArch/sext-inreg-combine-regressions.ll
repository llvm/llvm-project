; Regression tests for the boolean/sign-extension combines. The guards in
; performSIGN_EXTEND_INREGCombine and combineSubOfBoolean keep these cases on
; the pre-combine paths; the checks below are the expected codegen.

; R1: xor of complementary sign-extended booleans folds to -1.
; The shared xor-of-sexts guard leaves both sext_inregs for the generic
; combiner, so this is a single addi.w -1.

define i64 @xor_sext_not(i64 %a) {
; CHECK-LABEL: xor_sext_not:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi.w $a0, $zero, -1
; CHECK-NEXT:    ret
  %c = icmp eq i64 %a, 0
  %z = zext i1 %c to i64
  %n = xor i64 %z, 1
  %s = shl i64 %n, 63
  %m = ashr i64 %s, 63
  %e = sext i1 %c to i64
  %r = xor i64 %e, %m
  ret i64 %r
}

