; CHECK-NEXT:    sub.d $a0, $zero, $a0
; CHECK-NEXT:    srli.d $a0, $a0, 63
; CHECK-NEXT:    ori $a1, $zero, 2
; CHECK-NEXT:    sub.d $a1, $a1, $a0
; CHECK-NEXT:    xor $a0, $a1, $a0
; CHECK-NEXT:    ret
