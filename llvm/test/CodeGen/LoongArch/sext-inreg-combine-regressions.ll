; Regression tests for the boolean/sign-extension combines. The comments
; below record the codegen before the combine series; the checks are the
; current (regressed) codegen and will be updated by the fix.

; R1: xor of two sign-extended booleans that are complements.
; Before the patch series the xor folded to a constant:
;   addi.w $a0, $zero, -1
; Now the XOR branch rewrites one sext_inreg before the generic
; xor-of-sexts fold, so 4 instructions are emitted instead.
define i64 @xor_sext_not(i64 %a) {
; CHECK-LABEL: xor_sext_not:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sltui $a0, $a0, 1
; CHECK-NEXT:    addi.d $a1, $a0, -1
; CHECK-NEXT:    sub.d $a0, $zero, $a0
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    ret
  %c = icmp eq i64 %a, 0
  %z = zext i1 %c to i64
  %n = xor i64 %z, 1
  %s = shl i64 %n, 63
  %m = ashr i64 %s, 63
  %e = sext i1 %c to i64
  %r = xor i64 %e, %m
  ret i64 %r
}

