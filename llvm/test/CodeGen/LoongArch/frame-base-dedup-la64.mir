# RUN: llc -mtriple=loongarch64 \
# RUN:   -run-pass=prolog-epilog -run-pass=machine-latecleanup -o - %s \
# RUN:   | FileCheck -check-prefix=LA64 %s
# RUN: llc -mtriple=loongarch64 \
# RUN:   -run-pass=prolog-epilog -run-pass=machine-latecleanup \
# RUN:   -run-pass=loongarch-expand-pseudo -o - %s \
# RUN:   | FileCheck -check-prefix=LA64-EXPAND %s
#
# Test that identical large stack-frame base address materializations are
# deduplicated by MachineLateInstrsCleanup via PseudoAddUpperImm.

--- |
  define void @test_same_region() nounwind { ret void }
  define void @test_different_regions() nounwind { ret void }
  define void @test_negative_lo12() nounwind { ret void }
  define void @test_small_offset_no_pseudo() nounwind { ret void }
...
---
# Multiple accesses to stack slots in the same 4096-aligned region.
# PEI emits 4 PseudoAddUpperImm, MachineLateInstrsCleanup CSEs to 2.
# After expansion, only 2 LU12I_W + ADD_D pairs remain instead of 4.
#
# Frame: 8 + 8 + 16384 + 8 (emergency spill slot) = 16408, rounded up to the
# 16-byte stack alignment -> 16416.
#   %stack.0 -> 16416 -  8 = 16408 = (4 << 12) + 24
#   %stack.1 -> 16416 - 16 = 16400 = (4 << 12) + 16
name: test_same_region
alignment: 4
tracksRegLiveness: true
frameInfo:
  maxAlignment: 8
  hasCalls: false
  maxCallFrameSize: 0
stack:
  - { id: 0, size: 8, alignment: 8 }
  - { id: 1, size: 8, alignment: 8 }
  - { id: 2, size: 16384, alignment: 8 }
body: |
  bb.0:
    liveins: $r4, $r5
    ; LA64-LABEL: name: test_same_region
    ; LA64: liveins: $r4, $r5
    ; LA64-NEXT: {{  $}}
    ; LA64-NEXT: $r6 = frame-setup LU12I_W 4
    ; LA64-NEXT: $r6 = frame-setup ORI killed $r6, 32
    ; LA64-NEXT: $r3 = frame-setup SUB_D $r3, killed $r6
    ; LA64-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 16416
    ; LA64-NEXT: $r6 = LU12I_W 4
    ; LA64-NEXT: $r6 = ORI killed $r6, 24
    ; LA64-NEXT: $r6 = ADD_D $r3, killed $r6
    ; LA64-NEXT: ST_B $r4, killed $r6, 0 :: (store (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 16
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: ST_B $r5, killed $r4, 0 :: (store (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 24
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: $r6 = LD_B killed $r4, 0 :: (load (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 16
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: $r7 = LD_B killed $r4, 0 :: (load (s8))
    ; LA64-NEXT: $r4 = frame-destroy LU12I_W 4
    ; LA64-NEXT: $r4 = frame-destroy ORI killed $r4, 32
    ; LA64-NEXT: $r3 = frame-destroy ADD_D $r3, killed $r4
    ; LA64-NEXT: PseudoRET
    ;
    ; LA64-EXPAND-LABEL: name: test_same_region
    ; LA64-EXPAND: liveins: $r4, $r5
    ; LA64-EXPAND-NEXT: {{  $}}
    ; LA64-EXPAND-NEXT: $r6 = frame-setup LU12I_W 4
    ; LA64-EXPAND-NEXT: $r6 = frame-setup ORI killed $r6, 32
    ; LA64-EXPAND-NEXT: $r3 = frame-setup SUB_D $r3, killed $r6
    ; LA64-EXPAND-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 16416
    ; LA64-EXPAND-NEXT: $r6 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r6 = ORI killed $r6, 24
    ; LA64-EXPAND-NEXT: $r6 = ADD_D $r3, killed $r6
    ; LA64-EXPAND-NEXT: ST_B $r4, killed $r6, 0 :: (store (s8))
    ; LA64-EXPAND-NEXT: $r4 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = ORI killed $r4, 16
    ; LA64-EXPAND-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: ST_B $r5, killed $r4, 0 :: (store (s8))
    ; LA64-EXPAND-NEXT: $r4 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = ORI killed $r4, 24
    ; LA64-EXPAND-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: $r6 = LD_B killed $r4, 0 :: (load (s8))
    ; LA64-EXPAND-NEXT: $r4 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = ORI killed $r4, 16
    ; LA64-EXPAND-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: $r7 = LD_B killed $r4, 0 :: (load (s8))
    ; LA64-EXPAND-NEXT: $r4 = frame-destroy LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = frame-destroy ORI killed $r4, 32
    ; LA64-EXPAND-NEXT: $r3 = frame-destroy ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: PseudoRET
    ST_B $r4, %stack.0, 0 :: (store (s8))
    ST_B $r5, %stack.1, 0 :: (store (s8))
    $r6 = LD_B %stack.0, 0 :: (load (s8))
    $r7 = LD_B %stack.1, 0 :: (load (s8))
    PseudoRET
...
---
# Accesses to stack slots in different 4096-aligned regions.
# Different base anchors cannot be CSE'd with each other.
#
# Frame: 8 + 4096 + 8 + 16384 + 8 (spill slot) = 20504 -> 20512.
#   %stack.0 -> 20512 -    8 = 20504 = (5 << 12) + 24
#   %stack.2 -> 20512 - 4112 = 16400 = (4 << 12) + 16
name: test_different_regions
alignment: 4
tracksRegLiveness: true
frameInfo:
  maxAlignment: 8
  hasCalls: false
  maxCallFrameSize: 0
stack:
  - { id: 0, size: 8, alignment: 8 }
  - { id: 1, size: 4096, alignment: 8 }
  - { id: 2, size: 8, alignment: 8 }
  - { id: 3, size: 16384, alignment: 8 }
body: |
  bb.0:
    liveins: $r4, $r5
    ; LA64-LABEL: name: test_different_regions
    ; LA64: liveins: $r4, $r5
    ; LA64-NEXT: {{  $}}
    ; LA64-NEXT: $r6 = frame-setup LU12I_W 5
    ; LA64-NEXT: $r6 = frame-setup ORI killed $r6, 32
    ; LA64-NEXT: $r3 = frame-setup SUB_D $r3, killed $r6
    ; LA64-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 20512
    ; LA64-NEXT: $r6 = LU12I_W 5
    ; LA64-NEXT: $r6 = ORI killed $r6, 24
    ; LA64-NEXT: $r6 = ADD_D $r3, killed $r6
    ; LA64-NEXT: ST_B $r4, killed $r6, 0 :: (store (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 16
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: ST_B $r5, killed $r4, 0 :: (store (s8))
    ; LA64-NEXT: $r4 = frame-destroy LU12I_W 5
    ; LA64-NEXT: $r4 = frame-destroy ORI killed $r4, 32
    ; LA64-NEXT: $r3 = frame-destroy ADD_D $r3, killed $r4
    ; LA64-NEXT: PseudoRET
    ;
    ; LA64-EXPAND-LABEL: name: test_different_regions
    ; LA64-EXPAND: liveins: $r4, $r5
    ; LA64-EXPAND-NEXT: {{  $}}
    ; LA64-EXPAND-NEXT: $r6 = frame-setup LU12I_W 5
    ; LA64-EXPAND-NEXT: $r6 = frame-setup ORI killed $r6, 32
    ; LA64-EXPAND-NEXT: $r3 = frame-setup SUB_D $r3, killed $r6
    ; LA64-EXPAND-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 20512
    ; LA64-EXPAND-NEXT: $r6 = LU12I_W 5
    ; LA64-EXPAND-NEXT: $r6 = ORI killed $r6, 24
    ; LA64-EXPAND-NEXT: $r6 = ADD_D $r3, killed $r6
    ; LA64-EXPAND-NEXT: ST_B $r4, killed $r6, 0 :: (store (s8))
    ; LA64-EXPAND-NEXT: $r4 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = ORI killed $r4, 16
    ; LA64-EXPAND-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: ST_B $r5, killed $r4, 0 :: (store (s8))
    ; LA64-EXPAND-NEXT: $r4 = frame-destroy LU12I_W 5
    ; LA64-EXPAND-NEXT: $r4 = frame-destroy ORI killed $r4, 32
    ; LA64-EXPAND-NEXT: $r3 = frame-destroy ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: PseudoRET
    ST_B $r4, %stack.0, 0 :: (store (s8))
    ST_B $r5, %stack.2, 0 :: (store (s8))
    PseudoRET
...
---
# The lower 12 bits are folded into the ld/st with a negative si12, so the
# upper immediate must carry a +1 with respect to a plain arithmetic shift
# of the full offset. This is the case that a `Val >> 12` (instead of
# `(Val - Lo12) >> 12`) gets wrong by exactly 4096 bytes.
#
# Frame: 8 + 8 + 18432 + 8 (spill slot) = 18456 -> 18464.
#   %stack.0 -> 18464 -  8 = 18456 = (5 << 12) - 2024
#   %stack.1 -> 18464 - 16 = 18448 = (5 << 12) - 2032
name: test_negative_lo12
alignment: 4
tracksRegLiveness: true
frameInfo:
  maxAlignment: 8
  hasCalls: false
  maxCallFrameSize: 0
stack:
  - { id: 0, size: 8, alignment: 8 }
  - { id: 1, size: 8, alignment: 8 }
  - { id: 2, size: 18432, alignment: 8 }
body: |
  bb.0:
    liveins: $r4, $r5
    ; LA64-LABEL: name: test_negative_lo12
    ; LA64: liveins: $r4, $r5
    ; LA64-NEXT: {{  $}}
    ; LA64-NEXT: $r6 = frame-setup LU12I_W 4
    ; LA64-NEXT: $r6 = frame-setup ORI killed $r6, 2080
    ; LA64-NEXT: $r3 = frame-setup SUB_D $r3, killed $r6
    ; LA64-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 18464
    ; LA64-NEXT: $r6 = LU12I_W 4
    ; LA64-NEXT: $r6 = ORI killed $r6, 2072
    ; LA64-NEXT: $r6 = ADD_D $r3, killed $r6
    ; LA64-NEXT: ST_B $r4, killed $r6, 0 :: (store (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 2064
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: ST_B $r5, killed $r4, 0 :: (store (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 2072
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: $r6 = LD_B killed $r4, 0 :: (load (s8))
    ; LA64-NEXT: $r4 = LU12I_W 4
    ; LA64-NEXT: $r4 = ORI killed $r4, 2064
    ; LA64-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-NEXT: $r7 = LD_B killed $r4, 0 :: (load (s8))
    ; LA64-NEXT: $r4 = frame-destroy LU12I_W 4
    ; LA64-NEXT: $r4 = frame-destroy ORI killed $r4, 2080
    ; LA64-NEXT: $r3 = frame-destroy ADD_D $r3, killed $r4
    ; LA64-NEXT: PseudoRET
    ;
    ; LA64-EXPAND-LABEL: name: test_negative_lo12
    ; LA64-EXPAND: liveins: $r4, $r5
    ; LA64-EXPAND-NEXT: {{  $}}
    ; LA64-EXPAND-NEXT: $r6 = frame-setup LU12I_W 4
    ; LA64-EXPAND-NEXT: $r6 = frame-setup ORI killed $r6, 2080
    ; LA64-EXPAND-NEXT: $r3 = frame-setup SUB_D $r3, killed $r6
    ; LA64-EXPAND-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 18464
    ; LA64-EXPAND-NEXT: $r6 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r6 = ORI killed $r6, 2072
    ; LA64-EXPAND-NEXT: $r6 = ADD_D $r3, killed $r6
    ; LA64-EXPAND-NEXT: ST_B $r4, killed $r6, 0 :: (store (s8))
    ; LA64-EXPAND-NEXT: $r4 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = ORI killed $r4, 2064
    ; LA64-EXPAND-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: ST_B $r5, killed $r4, 0 :: (store (s8))
    ; LA64-EXPAND-NEXT: $r4 = LU12I_W 4
    ; LA64-EXPAND-NEXT: $r4 = ORI killed $r4, 2072
    ; LA64-EXPAND-NEXT: $r4 = ADD_D $r3, killed $r4
    ; LA64-EXPAND-NEXT: $r6 = LD_B killed $r4, 0 :: (load (s8))
