; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=loongarch64 < %s | FileCheck %s

; Stackmaps are lowered to a label for the stack map record followed by a NOP
; sled.  NOPs that are covered by the instructions that follow the stackmap are
; trimmed.

define void @test_shadow_optimization() {
; CHECK-LABEL: test_shadow_optimization:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
entry:
  tail call void (i64, i32, ...) @llvm.experimental.stackmap(i64 0, i32 16)
  ret void
}

; A stackmap in the middle of a function must not be overwritten by the
; instructions that follow it.
define i64 @test_shadow_followed_by_code(i64 %a, i64 %b) {
; CHECK-LABEL: test_shadow_followed_by_code:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:  .Ltmp1:
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    mul.d $a0, $a0, $a1
; CHECK-NEXT:    ret
entry:
  %r = add i64 %a, %b
  tail call void (i64, i32, ...) @llvm.experimental.stackmap(i64 1, i32 16, i64 %r)
  %r2 = mul i64 %r, %b
  ret i64 %r2
}

; Live values are recorded in the .llvm_stackmaps section.
define void @test_live_values(i64 %a, i64 %b) {
; CHECK-LABEL: test_live_values:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $sp, $sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    st.d $a0, $sp, 8
; CHECK-NEXT:  .Ltmp2:
; CHECK-NEXT:    addi.d $sp, $sp, 16
; CHECK-NEXT:    ret
entry:
  %slot = alloca i64
  store i64 %a, ptr %slot
  call void (i64, i32, ...) @llvm.experimental.stackmap(i64 2, i32 0, i64 %b, ptr %slot)
  ret void
}

; A stackmap immediately followed by another stackmap: the NOP sled of the
; first one is trimmed at the second one.
define void @test_shadow_trimmed_by_stackmap() {
; CHECK-LABEL: test_shadow_trimmed_by_stackmap:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:  .Ltmp3:
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:  .Ltmp4:
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    ret
entry:
  tail call void (i64, i32, ...) @llvm.experimental.stackmap(i64 3, i32 28)
  tail call void (i64, i32, ...) @llvm.experimental.stackmap(i64 4, i32 28)
  ret void
}

declare void @llvm.experimental.stackmap(i64, i32, ...)
