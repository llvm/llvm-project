; fmin/fmax follow IEEE 754-2008 minNum/maxNum: an sNaN operand yields a qNaN,
; which is not associative. Reassociation therefore requires nnan.
define float @test_fmin_nnan_f32(float %a0, float %a1, float %a2, float %a3) {
; CHECK-LABEL: test_fmin_nnan_f32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmin.s $fa0, $fa0, $fa1
; CHECK-NEXT:    fmin.s $fa1, $fa2, $fa3
; CHECK-NEXT:    fmin.s $fa0, $fa0, $fa1
; CHECK-NEXT:    ret
  %t0 = call nnan float @llvm.minnum.f32(float %a0, float %a1)
  %t1 = call nnan float @llvm.minnum.f32(float %t0, float %a2)
  %t2 = call nnan float @llvm.minnum.f32(float %t1, float %a3)
  ret float %t2
}

