declare void @sink()

define void @any_lane_set(ptr %src, ptr %dst) {
; CHECK-LABEL: any_lane_set:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xvld $xr0, $a0, 0
; CHECK-NEXT:    xvld $xr1, $a1, 0
; CHECK-NEXT:    xvseq.d $xr0, $xr0, $xr1
; CHECK-NEXT:    xvsetnez.v $fcc0, $xr0
; CHECK-NEXT:    movcf2gr $a0, $fcc0
; CHECK-NEXT:    st.b $a0, $a1, 0
; CHECK-NEXT:    ret
  %a = load <4 x i64>, ptr %src
  %b = load <4 x i64>, ptr %dst
  %cmp = icmp eq <4 x i64> %a, %b
  %bc = bitcast <4 x i1> %cmp to i4
  %any = icmp ne i4 %bc, 0
  store i1 %any, ptr %dst
  ret void
}

