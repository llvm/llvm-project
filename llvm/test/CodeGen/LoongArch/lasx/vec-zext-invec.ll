;; This test covers 128-bit zero_extend_vector_inreg to 256-bit.
;;
;; Fix https://github.com/llvm/llvm-project/issues/219224

define void @zext_invec_v16i8_to_v4i64(ptr %ptr, ptr %dst) {
; CHECK-LABEL: zext_invec_v16i8_to_v4i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vld $vr0, $a0, 0
; CHECK-NEXT:    vext2xv.du.bu $xr0, $xr0
; CHECK-NEXT:    xvst $xr0, $a1, 0
; CHECK-NEXT:    ret
  %a = load <16 x i8>, ptr %ptr
  %s = shufflevector <16 x i8> %a, <16 x i8> zeroinitializer,
       <16 x i32> <i32 0, i32 16, i32 16, i32 16, i32 1, i32 16, i32 16, i32 16,
                   i32 2, i32 16, i32 16, i32 16, i32 3, i32 16, i32 16, i32 16>
  %b = bitcast <16 x i8> %s to <4 x i32>
  %r = zext <4 x i32> %b to <4 x i64>
  store <4 x i64> %r, ptr %dst
  ret void
}

