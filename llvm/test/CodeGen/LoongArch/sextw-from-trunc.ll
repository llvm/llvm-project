; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc --mtriple=loongarch64 < %s | FileCheck %s

; On LA64, a 64-bit shift whose result is truncated to i32 and then sign
; extended back to i64 can be selected with the 32-bit shift instructions
; sll.w, which sign-extend their 32-bit result. This avoids the sll.d + addi.w sequence.

define i64 @shl_trunc_sext(i64 %x, i64 %y0) {
; CHECK-LABEL: shl_trunc_sext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll.w $a0, $a0, $a1
; CHECK-NEXT:    ret
  %y = and i64 %y0, 31
  %s = shl i64 %x, %y
  %t = trunc i64 %s to i32
  %r = sext i32 %t to i64
  ret i64 %r
}

; Constant shift amounts already select slli.w/srai.w/srli.w directly.

define i64 @shl_trunc_sext_const(i64 %x) {
; CHECK-LABEL: shl_trunc_sext_const:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.w $a0, $a0, 3
; CHECK-NEXT:    ret
  %s = shl i64 %x, 3
  %t = trunc i64 %s to i32
  %r = sext i32 %t to i64
  ret i64 %r
}

; The shift amount is folded to a constant after the SHL is formed; make
; sure this still selects slli.w instead of materializing the amount for sll.w.
define i64 @r1(i64 %x, i64 %y) {
; CHECK-LABEL: r1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.w $a0, $a0, 1
; CHECK-NEXT:    ret
  %o = or i64 %y, 1
  %m = and i64 %o, 1
  %s = shl i64 %x, %m
  %tr = trunc i64 %s to i32
  %r = sext i32 %tr to i64
  ret i64 %r
}
; The shift amount is known to be zero: use addi.w instead of
; sll.w $a0, $a0, $zero.
define i64 @r1_zero(i64 %x, i64 %y) {
; CHECK-LABEL: r1_zero:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi.w $a0, $a0, 0
; CHECK-NEXT:    ret
  %y1 = lshr i64 %y, 63
  %n = icmp slt i64 %y1, 0
  %e = zext i1 %n to i64
  %s = shl i64 %x, %e
  %tr = trunc i64 %s to i32
  %r = sext i32 %tr to i64
  ret i64 %r
}

; A boolean xor with 1 in a sign-extension should reuse the inverted
; compare, yielding slt + sub.d.
define i64 @r2(i64 %a, i64 %b) {
; CHECK-LABEL: r2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slt $a0, $a0, $a1
; CHECK-NEXT:    sub.d $a0, $zero, $a0
; CHECK-NEXT:    ret
  %ge = icmp sge i64 %a, %b
  %z = zext i1 %ge to i64
  %x = xor i64 %z, 1
  %s = shl i64 %x, 63
  %r = ashr i64 %s, 63
  ret i64 %r
}

; Subtracting a sign-extended boolean should fold to a single compare and
; an add.
define signext i32 @r3(i64 %a, i64 %b, i32 signext %c) {
; CHECK-LABEL: r3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    sltui $a0, $a0, 1
; CHECK-NEXT:    add.w $a0, $a2, $a0
; CHECK-NEXT:    ret
  %ne = icmp ne i64 %a, %b
  %z = zext i1 %ne to i32
  %x = xor i32 %z, -1
  %s = shl i32 %x, 31
  %m = ashr i32 %s, 31
  %r = sub i32 %c, %m
  ret i32 %r
}

; The inverted compare should reuse the existing eq compare, so only one
; compare is needed.
define i64 @r4(i64 %a, i64 %b) {
; CHECK-LABEL: r4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    sltui $a0, $a0, 1
; CHECK-NEXT:    sub.d $a1, $zero, $a0
; CHECK-NEXT:    xor $a0, $a1, $a0
; CHECK-NEXT:    ret
  %eq = icmp eq i64 %a, %b
  %ze = zext i1 %eq to i64
  %ne = xor i1 %eq, true
  %zn = zext i1 %ne to i64
  %x = xor i64 %zn, -1
  %s = shl i64 %x, 63
  %m = ashr i64 %s, 63
  %r = xor i64 %m, %ze
  ret i64 %r
}

; xor of two sign-extended booleans should fold into a single sign
; extension.
define i64 @r6(i64 %a, i64 %b, i64 %c) {
; CHECK-LABEL: r6:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $a0, $a0, $a2
; CHECK-NEXT:    sltu $a0, $zero, $a0
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    andi $a0, $a0, 1
; CHECK-NEXT:    sub.d $a0, $zero, $a0
; CHECK-NEXT:    ret
  %ne = icmp ne i64 %a, %c
  %s1 = sext i1 %ne to i64
  %t = shl i64 %b, 63
  %s2 = ashr i64 %t, 63
  %r = xor i64 %s1, %s2
  ret i64 %r
}
