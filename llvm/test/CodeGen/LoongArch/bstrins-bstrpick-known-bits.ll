; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc --mtriple=loongarch64 -mattr=+d < %s | FileCheck %s

;; Decode a 2-byte UTF-8 sequence backwards and stop at '\n'. The decoded value
;; is formed by BSTRINS and merged with an ASCII byte through a PHI. Known bits
;; of BSTRINS prove the PHI is sign-extended, so no sext.w is needed before the
;; compare.
define i32 @utf8_rev_col(ptr %begin, ptr %end) nounwind {
; CHECK-LABEL: utf8_rev_col:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a2, $a0
; CHECK-NEXT:    ori $a0, $zero, 1
; CHECK-NEXT:    ori $a3, $zero, 10
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ld.b $a4, $a1, -1
; CHECK-NEXT:    bltz $a4, .LBB0_3
; CHECK-NEXT:  # %bb.2: # %one
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    addi.d $a1, $a1, -1
; CHECK-NEXT:    addi.w $a4, $a4, 0
; CHECK-NEXT:    bne $a4, $a3, .LBB0_4
; CHECK-NEXT:    b .LBB0_5
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB0_3: # %two
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    ld.bu $a5, $a1, -2
; CHECK-NEXT:    addi.d $a1, $a1, -2
; CHECK-NEXT:    andi $a5, $a5, 31
; CHECK-NEXT:    bstrins.d $a4, $a5, 63, 6
; CHECK-NEXT:    addi.w $a4, $a4, 0
; CHECK-NEXT:    beq $a4, $a3, .LBB0_5
; CHECK-NEXT:  .LBB0_4: # %latch
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    addi.w $a0, $a0, 1
; CHECK-NEXT:    bne $a2, $a1, .LBB0_1
; CHECK-NEXT:  .LBB0_5: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %col = phi i32 [ 1, %entry ], [ %col.next, %latch ]
  %p = phi ptr [ %end, %entry ], [ %np, %latch ]
  %p1 = getelementptr inbounds i8, ptr %p, i64 -1
  %b = load i8, ptr %p1, align 1
  %ascii = icmp sgt i8 %b, -1
  br i1 %ascii, label %one, label %two

one:
  %c1 = zext nneg i8 %b to i32
  br label %merge

two:
  %p2 = getelementptr inbounds i8, ptr %p, i64 -2
  %b2 = load i8, ptr %p2, align 1
  %lo = and i8 %b2, 31
  %lo.z = zext nneg i8 %lo to i32
  %hi = shl nuw nsw i32 %lo.z, 6
  %b.m = and i8 %b, 63
  %b.z = zext nneg i8 %b.m to i32
  %c2 = or disjoint i32 %hi, %b.z
  br label %merge

merge:
  %np = phi ptr [ %p1, %one ], [ %p2, %two ]
  %c = phi i32 [ %c1, %one ], [ %c2, %two ]
  %nl = icmp eq i32 %c, 10
  br i1 %nl, label %exit, label %latch

latch:
  %col.next = add i32 %col, 1
  %done = icmp eq ptr %begin, %np
  br i1 %done, label %exit, label %loop

exit:
  %r = phi i32 [ %col, %merge ], [ %col.next, %latch ]
  ret i32 %r
}

;; The bits above msb come from the sign-extended operand.
define i32 @bstrins_low_sext(i1 %c, i32 signext %x, i64 %y, i32 signext %z) nounwind {
; CHECK-LABEL: bstrins_low_sext:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andi $a0, $a0, 1
; CHECK-NEXT:    beqz $a0, .LBB1_2
; CHECK-NEXT:  # %bb.1: # %a
; CHECK-NEXT:    andi $a0, $a2, 255
; CHECK-NEXT:    bstrins.d $a1, $a0, 7, 0
; CHECK-NEXT:    move $a3, $a1
; CHECK-NEXT:  .LBB1_2: # %b
; CHECK-NEXT:    addi.w $a0, $a3, 0
; CHECK-NEXT:    addi.d $a0, $a0, -10
; CHECK-NEXT:    sltui $a0, $a0, 1
; CHECK-NEXT:    ret
entry:
  br i1 %c, label %a, label %b

a:
  %xe = sext i32 %x to i64
  %xm = and i64 %xe, -256
  %ym = and i64 %y, 255
  %o = or disjoint i64 %xm, %ym
  %t = trunc i64 %o to i32
  br label %b

b:
  %p = phi i32 [ %t, %a ], [ %z, %entry ]
  %cmp = icmp eq i32 %p, 10
  %r = zext i1 %cmp to i32
  ret i32 %r
}

;; The bits above msb of BSTRPICK are zero.
define i64 @bstrpick_zext(i1 %c, i64 %x, i64 %y) nounwind {
; CHECK-LABEL: bstrpick_zext:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andi $a2, $a0, 1
; CHECK-NEXT:    ori $a0, $zero, 7
; CHECK-NEXT:    beqz $a2, .LBB2_2
; CHECK-NEXT:  # %bb.1: # %a
; CHECK-NEXT:    bstrpick.d $a0, $a1, 23, 8
; CHECK-NEXT:  .LBB2_2: # %b
; CHECK-NEXT:    bstrpick.d $a0, $a0, 31, 0
; CHECK-NEXT:    ret
entry:
  br i1 %c, label %a, label %b

a:
  %s = lshr i64 %x, 8
  %m = and i64 %s, 65535
  %t = trunc i64 %m to i32
  br label %b

b:
  %p = phi i32 [ %t, %a ], [ 7, %entry ]
  %r = zext i32 %p to i64
  ret i64 %r
}
