# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=loongarch64 -run-pass=machine-sink \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Exercise base/offset operand positions, local and cross-block definitions,
# shared shifts, immediate bounds, and memory annotations.

---
name: rk_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: rk_load
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[ALSL_D:%[0-9]+]]:gpr = ALSL_D [[COPY1]], [[COPY]], 3
    ; CHECK-NEXT: [[LD_D:%[0-9]+]]:gpr = LD_D [[ALSL_D]], 0 :: (volatile load (s64), align 16)
    ; CHECK-NEXT: $r4 = COPY [[LD_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = SLLI_D %1, 3
    %3:gpr = LDX_D %0, %2 :: (volatile load (s64), align 16)
    $r4 = COPY %3
    PseudoRET implicit $r4
...

---
name: rk_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r5, $r6
    ; CHECK-LABEL: name: rk_store
    ; CHECK: liveins: $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY $r6
    ; CHECK-NEXT: [[ALSL_D:%[0-9]+]]:gpr = ALSL_D [[COPY1]], [[COPY]], 2
    ; CHECK-NEXT: ST_W [[COPY2]], [[ALSL_D]], 0 :: (volatile store (s32), align 16)
    ; CHECK-NEXT: PseudoRET
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = COPY $r6
    %3:gpr = SLLI_D %1, 2
    STX_W %2, %0, %3 :: (volatile store (s32), align 16)
    PseudoRET
...

---
name: rk_shift_limits
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: rk_shift_limits
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[ALSL_D:%[0-9]+]]:gpr = ALSL_D [[COPY1]], [[COPY]], 1
    ; CHECK-NEXT: ST_B [[COPY1]], [[ALSL_D]], 0 :: (store (s8))
    ; CHECK-NEXT: [[ALSL_D1:%[0-9]+]]:gpr = ALSL_D [[COPY1]], [[COPY]], 4
    ; CHECK-NEXT: ST_B [[COPY1]], [[ALSL_D1]], 0 :: (store (s8))
    ; CHECK-NEXT: PseudoRET
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = SLLI_D %1, 1
    STX_B %1, %0, %2 :: (store (s8))
    %3:gpr = SLLI_D %1, 4
    STX_B %1, %0, %3 :: (store (s8))
    PseudoRET
...

---
name: rj_not_folded
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: rj_not_folded
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[SLLI_D:%[0-9]+]]:gpr = SLLI_D [[COPY1]], 3
    ; CHECK-NEXT: [[LDX_D:%[0-9]+]]:gpr = LDX_D [[SLLI_D]], [[COPY]] :: (load (s64))
    ; CHECK-NEXT: $r4 = COPY [[LDX_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = SLLI_D %1, 3
    %3:gpr = LDX_D %2, %0 :: (load (s64))
    $r4 = COPY %3
    PseudoRET implicit $r4
...

---
name: shared_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r4, $r5, $r6
    ; CHECK-LABEL: name: shared_shift
    ; CHECK: liveins: $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY $r6
    ; CHECK-NEXT: [[SLLI_D:%[0-9]+]]:gpr = SLLI_D [[COPY1]], 3
    ; CHECK-NEXT: [[LDX_D:%[0-9]+]]:gpr = LDX_D [[COPY]], [[SLLI_D]] :: (load (s64))
    ; CHECK-NEXT: [[LDX_D1:%[0-9]+]]:gpr = LDX_D [[COPY2]], [[SLLI_D]] :: (load (s64))
    ; CHECK-NEXT: [[ADD_D:%[0-9]+]]:gpr = ADD_D [[LDX_D]], [[LDX_D1]]
    ; CHECK-NEXT: $r4 = COPY [[ADD_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = COPY $r6
    %3:gpr = SLLI_D %1, 3
    %4:gpr = LDX_D %0, %3 :: (load (s64))
    %5:gpr = LDX_D %2, %3 :: (load (s64))
    %6:gpr = ADD_D %4, %5
    $r4 = COPY %6
    PseudoRET implicit $r4
...

---
name: cross_block_shift
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cross_block_shift
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $r4
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $r5
  ; CHECK-NEXT:   [[SLLI_D:%[0-9]+]]:gpr = SLLI_D [[COPY1]], 3
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[LDX_D:%[0-9]+]]:gpr = LDX_D [[COPY]], [[SLLI_D]] :: (load (s64))
  ; CHECK-NEXT:   $r4 = COPY [[LDX_D]]
  ; CHECK-NEXT:   PseudoRET implicit $r4
  bb.0:
    successors: %bb.1
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = SLLI_D %1, 3
    PseudoBR %bb.1

  bb.1:
    %3:gpr = LDX_D %0, %2 :: (load (s64))
    $r4 = COPY %3
    PseudoRET implicit $r4
...

