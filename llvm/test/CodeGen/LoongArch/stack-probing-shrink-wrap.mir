# RUN: llc -mtriple=loongarch64 -x mir -run-pass=shrink-wrap,prolog-epilog -verify-machineinstrs < %s | FileCheck %s --check-prefix=LA64
# RUN: llc -mtriple=loongarch32 -x mir -run-pass=shrink-wrap,prolog-epilog -verify-machineinstrs < %s | FileCheck %s --check-prefix=LA32

# shrink_wrap_live_regs: the prologue is shrink-wrapped into bb.1, where $r13
# and $r14 are live: the probe loop must use other registers.
# shrink_wrap_no_free_regs: bb.1 has no two free registers for the probe loop,
# so the prologue stays in the entry block.

--- |
  define void @shrink_wrap_live_regs(i64 %c) #0 {
  entry:
    %buf = alloca [40000 x i8], align 8
    ret void
  }

  define void @shrink_wrap_no_free_regs(i64 %c) #0 {
  entry:
    %buf = alloca [40000 x i8], align 8
    ret void
  }

  attributes #0 = { "probe-stack"="inline-asm" }
...
