# RUN: llc -mtriple=loongarch64 -relocation-model=pic -run-pass=loongarch-prera-expand-pseudo -o - %s | FileCheck %s

# The $r1 result of PseudoDESC_CALL is dead.

--- |
  @tls = external thread_local global i32

  define void @tlsdesc() {
    ret void
  }
...
---
name:            tlsdesc
isSSA:           true
body:             |
  bb.0:
    ; CHECK-LABEL: name: tlsdesc
    ; CHECK: [[PCALAU12I:%[0-9]+]]:gpr = PCALAU12I target-flags(loongarch-desc-pc-hi) @tls
    ; CHECK-NEXT: $r4 = ADDI_D [[PCALAU12I]], target-flags(loongarch-desc-pc-lo) @tls
    ; CHECK-NEXT: $r1 = LD_D $r4, target-flags(loongarch-desc-ld) @tls
    ; CHECK-NEXT: dead $r1 = PseudoDESC_CALL $r1, target-flags(loongarch-desc-call) @tls, implicit-def $r4, implicit $r4
    ; CHECK-NEXT: [[ADD_D:%[0-9]+]]:gpr = ADD_D $r4, $r2
    ; CHECK-NEXT: $r4 = COPY [[ADD_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = PseudoLA_TLS_DESC @tls, implicit-def dead $r1
    $r4 = COPY %0
    PseudoRET implicit $r4
...
