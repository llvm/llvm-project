# Test that identical large stack-frame base address materializations are
# deduplicated by MachineLateInstrsCleanup via PseudoAddUpperImm.

--- |
  define void @test_la32() nounwind { ret void }
...
---
# LA32 -- verify with 32-bit loads/stores, and that the pseudo expands to
# LU12I_W + ADD_W rather than ADD_D.
#
# Frame: 4 + 4 + 16384 + 4 (spill slot) = 16396 -> 16400.
#   %stack.0 -> 16400 - 4 = 16396 = (4 << 12) + 12
#   %stack.1 -> 16400 - 8 = 16392 = (4 << 12) +  8
name: test_la32
alignment: 4
tracksRegLiveness: true
frameInfo:
  maxAlignment: 4
  hasCalls: false
  maxCallFrameSize: 0
stack:
  - { id: 0, size: 4, alignment: 4 }
  - { id: 1, size: 4, alignment: 4 }
  - { id: 2, size: 16384, alignment: 4 }
body: |
  bb.0:
    liveins: $r4, $r5
