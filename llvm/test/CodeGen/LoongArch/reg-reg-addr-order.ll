; CHECK-NEXT:    slli.d $a1, $a2, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
  %base = getelementptr i8, ptr %a, i64 %x
  %base2 = ptrtoint ptr %base to i64
  %base3 = xor i64 %base2, 7
  %base4 = inttoptr i64 %base3 to ptr
  %p = getelementptr i64, ptr %base4, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

