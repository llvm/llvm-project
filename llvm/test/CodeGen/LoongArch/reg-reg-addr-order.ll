;; On LA664 and older micro-architectures the rk operand of RegReg loads and stores
;; receives a value that was just computed (by an ALU instruction or a RegImm load)
;; one cycle later than rj. When only the second operand of the address add is
;; computed in the block, place it in rj.

define i64 @ldx_d(ptr %a, i64 %i) nounwind {
;
; CHECK-LABEL: ldx_d:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a1, $a0
; CHECK-NEXT:    ret
  %p = getelementptr i64, ptr %a, i64 %i
  %v = load i64, ptr %p
  ret i64 %v
}

