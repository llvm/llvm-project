;; One scaled index shared by several bases: every load gets it in rj.
define i64 @shared_index(ptr %a, ptr %b, ptr %c, i64 %i) nounwind {
;
; CHECK-LABEL: shared_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a3, $a3, 3
; CHECK-NEXT:    ldx.d $a0, $a3, $a0
; CHECK-NEXT:    ldx.d $a1, $a3, $a1
; CHECK-NEXT:    ldx.d $a2, $a3, $a2
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    add.d $a0, $a0, $a2
; CHECK-NEXT:    ret
  %pa = getelementptr i64, ptr %a, i64 %i
  %pb = getelementptr i64, ptr %b, i64 %i
  %pc = getelementptr i64, ptr %c, i64 %i
  %va = load i64, ptr %pa
  %vb = load i64, ptr %pb
  %vc = load i64, ptr %pc
  %s0 = add i64 %va, %vb
  %s1 = add i64 %s0, %vc
  ret i64 %s1
}

;; Loop-carried index chase: i = t[i].x with 32-byte elements, which ALSL
;; cannot scale, so the chain goes through SLLI and LDX every iteration.
define i64 @chase32(ptr %t, i64 %i0, i64 %n) nounwind {
;
; CHECK-LABEL: chase32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    move $a3, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB12_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    slli.d $a1, $a1, 5
; CHECK-NEXT:    ldx.d $a1, $a1, $a0
; CHECK-NEXT:    addi.d $a3, $a3, 1
; CHECK-NEXT:    blt $a3, $a2, .LBB12_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %k = phi i64 [ 0, %entry ], [ %k.next, %loop ]
  %i = phi i64 [ %i0, %entry ], [ %i.next, %loop ]
  %p = getelementptr [4 x i64], ptr %t, i64 %i
  %i.next = load i64, ptr %p
  %k.next = add i64 %k, 1
  %c = icmp slt i64 %k.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret i64 %i.next
}

