; NOHOIST-NEXT:    st.d $a0, $a2, 0
; NOHOIST-NEXT:    ld.w $a0, $a1, 0
; NOHOIST-NEXT:    addi.w $a5, $a5, 1
; NOHOIST-NEXT:    blt $a5, $a3, .LBB3_1
; NOHOIST-NEXT:  # %bb.2: # %exit
; NOHOIST-NEXT:    move $a0, $a4
; NOHOIST-NEXT:    ret
entry:
  br label %loop

loop:
  %p = phi i64 [ %x, %entry ], [ %v, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %t = trunc i64 %p to i32
