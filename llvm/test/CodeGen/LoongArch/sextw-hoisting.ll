; NOHOIST-LABEL: no_hoist_i64_phi:
; NOHOIST:       # %bb.0: # %entry
; NOHOIST-NEXT:    move $a5, $zero
; NOHOIST-NEXT:    .p2align 4, , 16
; NOHOIST-NEXT:  .LBB3_1: # %loop
; NOHOIST-NEXT:    # =>This Inner Loop Header: Depth=1
; NOHOIST-NEXT:    move $a4, $a0
