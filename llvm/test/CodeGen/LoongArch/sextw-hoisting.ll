; The sext.w in the inner loop is moved into the outer loop (depth 1), where
; the value flowing into the inner loop is defined by an outer loop PHI.
define void @hoist_nested(i32 %x, i32 signext %n, i32 signext %m) nounwind {
; CHECK-LABEL: hoist_nested:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $sp, $sp, -48
; CHECK-NEXT:    st.d $ra, $sp, 40 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 32 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s0, $sp, 24 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s1, $sp, 16 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s2, $sp, 8 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s3, $sp, 0 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a2
; CHECK-NEXT:    move $s0, $a1
; CHECK-NEXT:    move $s1, $a0
; CHECK-NEXT:    move $s2, $zero
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB2_1: # %outer
; CHECK-NEXT:    # =>This Loop Header: Depth=1
; CHECK-NEXT:    # Child Loop BB2_2 Depth 2
; CHECK-NEXT:    move $s3, $zero
; CHECK-NEXT:    addi.w $s1, $s1, 0
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB2_2: # %inner
; CHECK-NEXT:    # Parent Loop BB2_1 Depth=1
; CHECK-NEXT:    # => This Inner Loop Header: Depth=2
; CHECK-NEXT:    move $a0, $s1
; CHECK-NEXT:    pcaddu18i $ra, %call36(use)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    add.w $s1, $s1, $s3
; CHECK-NEXT:    addi.w $s3, $s3, 1
; CHECK-NEXT:    blt $s3, $s0, .LBB2_2
; CHECK-NEXT:  # %bb.3: # %outer.latch
; CHECK-NEXT:    # in Loop: Header=BB2_1 Depth=1
; CHECK-NEXT:    addi.w $s2, $s2, 1
; CHECK-NEXT:    blt $s2, $fp, .LBB2_1
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    ld.d $s3, $sp, 0 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $s2, $sp, 8 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $s1, $sp, 16 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $s0, $sp, 24 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $fp, $sp, 32 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 40 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 48
; CHECK-NEXT:    ret
;
; NOHOIST-LABEL: hoist_nested:
; NOHOIST:       # %bb.0: # %entry
; NOHOIST-NEXT:    addi.d $sp, $sp, -48
; NOHOIST-NEXT:    st.d $ra, $sp, 40 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $fp, $sp, 32 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $s0, $sp, 24 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $s1, $sp, 16 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $s2, $sp, 8 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $s3, $sp, 0 # 8-byte Folded Spill
; NOHOIST-NEXT:    move $fp, $a2
; NOHOIST-NEXT:    move $s0, $a1
; NOHOIST-NEXT:    move $s1, $a0
; NOHOIST-NEXT:    move $s2, $zero
; NOHOIST-NEXT:    .p2align 4, , 16
; NOHOIST-NEXT:  .LBB2_1: # %outer
; NOHOIST-NEXT:    # =>This Loop Header: Depth=1
; NOHOIST-NEXT:    # Child Loop BB2_2 Depth 2
; NOHOIST-NEXT:    move $s3, $zero
; NOHOIST-NEXT:    .p2align 4, , 16
; NOHOIST-NEXT:  .LBB2_2: # %inner
; NOHOIST-NEXT:    # Parent Loop BB2_1 Depth=1
; NOHOIST-NEXT:    # => This Inner Loop Header: Depth=2
; NOHOIST-NEXT:    addi.w $a0, $s1, 0
; NOHOIST-NEXT:    pcaddu18i $ra, %call36(use)
; NOHOIST-NEXT:    jirl $ra, $ra, 0
; NOHOIST-NEXT:    add.d $s1, $s1, $s3
; NOHOIST-NEXT:    addi.w $s3, $s3, 1
; NOHOIST-NEXT:    blt $s3, $s0, .LBB2_2
; NOHOIST-NEXT:  # %bb.3: # %outer.latch
; NOHOIST-NEXT:    # in Loop: Header=BB2_1 Depth=1
; NOHOIST-NEXT:    addi.w $s2, $s2, 1
; NOHOIST-NEXT:    blt $s2, $fp, .LBB2_1
; NOHOIST-NEXT:  # %bb.4: # %exit
; NOHOIST-NEXT:    ld.d $s3, $sp, 0 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $s2, $sp, 8 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $s1, $sp, 16 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $s0, $sp, 24 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $fp, $sp, 32 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $ra, $sp, 40 # 8-byte Folded Reload
; NOHOIST-NEXT:    addi.d $sp, $sp, 48
; NOHOIST-NEXT:    ret
entry:
  br label %outer

outer:
  %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
  %q = phi i32 [ %x, %entry ], [ %next, %outer.latch ]
  br label %inner

inner:
  %p = phi i32 [ %q, %outer ], [ %next, %inner ]
  %i = phi i32 [ 0, %outer ], [ %i.next, %inner ]
  call void @use(i32 signext %p)
  %next = add i32 %p, %i
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %inner, label %outer.latch

outer.latch:
  %j.next = add i32 %j, 1
  %c2 = icmp slt i32 %j.next, %m
  br i1 %c2, label %outer, label %exit

exit:
  ret void
}

