declare void @use(i32 signext)

; The sext.w of the loop-carried value can be moved into the preheader.
define void @hoist_simple(i32 %x, i32 signext %n) nounwind {
; CHECK-LABEL: hoist_simple:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $sp, $sp, -32
; CHECK-NEXT:    st.d $ra, $sp, 24 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 16 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s0, $sp, 8 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $s1, $sp, 0 # 8-byte Folded Spill
; CHECK-NEXT:    move $fp, $a1
; CHECK-NEXT:    move $s1, $zero
; CHECK-NEXT:    addi.w $s0, $a0, 0
; CHECK-NEXT:    .p2align 4, , 16
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    move $a0, $s0
; CHECK-NEXT:    pcaddu18i $ra, %call36(use)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    add.w $s0, $s0, $s1
; CHECK-NEXT:    addi.w $s1, $s1, 1
; CHECK-NEXT:    blt $s1, $fp, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ld.d $s1, $sp, 0 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $s0, $sp, 8 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $fp, $sp, 16 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 24 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 32
; CHECK-NEXT:    ret
;
; NOHOIST-LABEL: hoist_simple:
; NOHOIST:       # %bb.0: # %entry
; NOHOIST-NEXT:    addi.d $sp, $sp, -32
; NOHOIST-NEXT:    st.d $ra, $sp, 24 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $fp, $sp, 16 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $s0, $sp, 8 # 8-byte Folded Spill
; NOHOIST-NEXT:    st.d $s1, $sp, 0 # 8-byte Folded Spill
; NOHOIST-NEXT:    move $fp, $a1
; NOHOIST-NEXT:    move $s0, $a0
; NOHOIST-NEXT:    move $s1, $zero
; NOHOIST-NEXT:    .p2align 4, , 16
; NOHOIST-NEXT:  .LBB0_1: # %loop
; NOHOIST-NEXT:    # =>This Inner Loop Header: Depth=1
; NOHOIST-NEXT:    addi.w $a0, $s0, 0
; NOHOIST-NEXT:    pcaddu18i $ra, %call36(use)
; NOHOIST-NEXT:    jirl $ra, $ra, 0
; NOHOIST-NEXT:    add.d $s0, $s0, $s1
; NOHOIST-NEXT:    addi.w $s1, $s1, 1
; NOHOIST-NEXT:    blt $s1, $fp, .LBB0_1
; NOHOIST-NEXT:  # %bb.2: # %exit
; NOHOIST-NEXT:    ld.d $s1, $sp, 0 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $s0, $sp, 8 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $fp, $sp, 16 # 8-byte Folded Reload
; NOHOIST-NEXT:    ld.d $ra, $sp, 24 # 8-byte Folded Reload
; NOHOIST-NEXT:    addi.d $sp, $sp, 32
; NOHOIST-NEXT:    ret
entry:
  br label %loop

loop:
  %p = phi i32 [ %x, %entry ], [ %next, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  call void @use(i32 signext %p)
  %next = add i32 %p, %i
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

