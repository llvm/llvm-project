# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=loongarch32 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

# The 2048-byte call frame puts the emergency spill slot out of st.w range.
# Without FP, spilling a scavenged register needs another scratch register.

---
name:            test
alignment:       4
tracksRegLiveness: true
frameInfo:
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 2048
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body:             |
  bb.0:
    liveins: $r1, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r13, $r14, $r15, $r16, $r17, $r18, $r19, $r20, $r23, $r24, $r25, $r26, $r27, $r28, $r29, $r30, $r31
    ; CHECK-LABEL: name: test
    ; CHECK: liveins: $r1, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r13, $r14, $r15, $r16, $r17, $r18, $r19, $r20, $r23, $r24, $r25, $r26, $r27, $r28, $r29, $r30, $r31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = frame-setup ADDI_W $r3, -2032
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 2032
    ; CHECK-NEXT: ST_W killed $r1, $r3, 2028 :: (store (s32) into %stack.1)
    ; CHECK-NEXT: ST_W killed $r22, $r3, 2024 :: (store (s32) into %stack.2)
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION offset $r1, -4
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION offset $r22, -8
    ; CHECK-NEXT: $r22 = frame-setup ADDI_W $r3, 2032
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa $r22, 0
    ; CHECK-NEXT: $r3 = frame-setup ADDI_W $r3, -32
    ; CHECK-NEXT: ST_W undef $r23, $r22, -16
    ; CHECK-NEXT: $r3 = frame-destroy ADDI_W $r3, 32
    ; CHECK-NEXT: $r22 = LD_W $r3, 2024 :: (load (s32) from %stack.2)
    ; CHECK-NEXT: $r1 = LD_W $r3, 2028 :: (load (s32) from %stack.1)
    ; CHECK-NEXT: $r3 = frame-destroy ADDI_W $r3, 2032
    ; CHECK-NEXT: PseudoRET implicit $r1, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $r13, implicit $r14, implicit $r15, implicit $r16, implicit $r17, implicit $r18, implicit $r19, implicit $r20, implicit $r23, implicit $r24, implicit $r25, implicit $r26, implicit $r27, implicit $r28, implicit $r29, implicit $r30, implicit $r31
    ST_W undef $r23, %stack.0, 0
    ADJCALLSTACKDOWN 2048, 0, implicit-def dead $r3, implicit $r3
    ADJCALLSTACKUP 2048, 0, implicit-def dead $r3, implicit $r3
    ; Keep the registers live across the store.
    PseudoRET implicit $r1, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $r13, implicit $r14, implicit $r15, implicit $r16, implicit $r17, implicit $r18, implicit $r19, implicit $r20, implicit $r23, implicit $r24, implicit $r25, implicit $r26, implicit $r27, implicit $r28, implicit $r29, implicit $r30, implicit $r31
...
