;; The zero-extended constant is needed anyway.
define i64 @mul_zext_const_multi_use(i32 signext %x, ptr %p) {
; CHECK-LABEL: mul_zext_const_multi_use:
; CHECK:       # %bb.0:
; CHECK-NEXT:    bstrpick.d $a0, $a0, 31, 0
; CHECK-NEXT:    lu12i.w $a2, -400521
; CHECK-NEXT:    ori $a2, $a2, 2489
; CHECK-NEXT:    lu32i.d $a2, 0
; CHECK-NEXT:    mul.d $a0, $a0, $a2
; CHECK-NEXT:    st.d $a2, $a1, 0
; CHECK-NEXT:    ret
