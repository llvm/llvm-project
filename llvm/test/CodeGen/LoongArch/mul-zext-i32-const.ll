; CHECK-NEXT:    ori $a1, $a1, 1607
; CHECK-NEXT:    mulw.d.wu $a0, $a0, $a1
; CHECK-NEXT:    ret
  %z = zext i32 %x to i64
  %r = mul i64 %z, 1640531527
  ret i64 %r
}

