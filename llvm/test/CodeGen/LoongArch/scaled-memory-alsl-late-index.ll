; The table base is invariant, but each load produces the next access's index.
; The single-use shift stays on the loop-carried dependency chain. Folding it
; changes SLLI.D + LDX.D to ALSL.D + LD.D, moving the dependent address input
; from LDX's rk to LD's rj. This is the bounded recurrence used by the native
; dependent-index microbenchmark; instruction count is unchanged by the fold.
define i64 @late_index_counted_chase(ptr %table, i64 %index, i64 %steps) {
; OPT-LABEL: late_index_counted_chase:
; OPT:       # %bb.0: # %entry
; OPT-NEXT:    beqz $a2, .LBB0_2
; OPT-NEXT:    .p2align 4, , 16
; OPT-NEXT:  .LBB0_1: # %loop
; OPT-NEXT:    # =>This Inner Loop Header: Depth=1
; OPT-NEXT:    alsl.d $a1, $a1, $a0, 3
; OPT-NEXT:    ld.d $a1, $a1, 0
; OPT-NEXT:    addi.d $a2, $a2, -1
; OPT-NEXT:    bnez $a2, .LBB0_1
; OPT-NEXT:  .LBB0_2: # %exit
; OPT-NEXT:    move $a0, $a1
; OPT-NEXT:    ret
;
; NOFOLD-LABEL: late_index_counted_chase:
; NOFOLD:       # %bb.0: # %entry
; NOFOLD-NEXT:    beqz $a2, .LBB0_2
; NOFOLD-NEXT:    .p2align 4, , 16
; NOFOLD-NEXT:  .LBB0_1: # %loop
; NOFOLD-NEXT:    # =>This Inner Loop Header: Depth=1
; NOFOLD-NEXT:    slli.d $a1, $a1, 3
; NOFOLD-NEXT:    ldx.d $a1, $a0, $a1
; NOFOLD-NEXT:    addi.d $a2, $a2, -1
; NOFOLD-NEXT:    bnez $a2, .LBB0_1
; NOFOLD-NEXT:  .LBB0_2: # %exit
; NOFOLD-NEXT:    move $a0, $a1
; NOFOLD-NEXT:    ret
entry:
  %empty = icmp eq i64 %steps, 0
  br i1 %empty, label %exit, label %loop

loop:
  %current = phi i64 [ %index, %entry ], [ %next, %loop ]
  %iteration = phi i64 [ 0, %entry ], [ %iteration.next, %loop ]
  %offset = shl i64 %current, 3
  %slot = getelementptr i8, ptr %table, i64 %offset
  %next = load i64, ptr %slot, align 8
  %iteration.next = add i64 %iteration, 1
  %done = icmp eq i64 %iteration.next, %steps
  br i1 %done, label %exit, label %loop

exit:
  %result = phi i64 [ %index, %entry ], [ %next, %loop ]
  ret i64 %result
}
