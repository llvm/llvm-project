;; The address is also used by a non-memory instruction.
define ptr @load_and_return_addr(ptr %p, i64 %i, ptr %q) nounwind {
; CHECK-LABEL: load_and_return_addr:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a3, $a1, 3
; CHECK-NEXT:    ldx.d $a3, $a0, $a3
; CHECK-NEXT:    alsl.d $a0, $a1, $a0, 3
; CHECK-NEXT:    st.d $a3, $a2, 0
; CHECK-NEXT:    ret
  %a = getelementptr inbounds i64, ptr %p, i64 %i
  %x = load i64, ptr %a
  store i64 %x, ptr %q
  ret ptr %a
}

;; The address is only used by memory accesses without an offset.
define i64 @load_one_field(ptr %p, i64 %i) nounwind {
; CHECK-LABEL: load_one_field:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a1, $a1, 4
; CHECK-NEXT:    ldx.d $a0, $a0, $a1
; CHECK-NEXT:    ret
  %a = getelementptr inbounds { i64, i64 }, ptr %p, i64 %i, i32 0
  %x = load i64, ptr %a
  ret i64 %x
}

;; The shift is used by other accesses as well.
define i64 @load_shared_index(ptr %p, ptr %q, i64 %i) nounwind {
; CHECK-LABEL: load_shared_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    slli.d $a3, $a2, 3
; CHECK-NEXT:    alsl.d $a2, $a2, $a1, 3
; CHECK-NEXT:    ldx.d $a0, $a0, $a3
; CHECK-NEXT:    ldx.d $a1, $a1, $a3
; CHECK-NEXT:    ld.d $a2, $a2, 8
; CHECK-NEXT:    add.d $a0, $a0, $a1
; CHECK-NEXT:    add.d $a0, $a0, $a2
; CHECK-NEXT:    ret
  %a = getelementptr inbounds i64, ptr %p, i64 %i
  %b = getelementptr inbounds i64, ptr %q, i64 %i
  %b1 = getelementptr inbounds i8, ptr %b, i64 8
  %x = load i64, ptr %a
  %y = load i64, ptr %b
  %z = load i64, ptr %b1
  %r0 = add i64 %x, %y
  %r = add i64 %r0, %z
  ret i64 %r
}

