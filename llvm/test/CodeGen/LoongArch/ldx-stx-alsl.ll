; CHECK-NEXT:    ret
  %a = getelementptr inbounds [4 x i64], ptr %p, i64 %i, i64 0
  %b = getelementptr inbounds [4 x i64], ptr %p, i64 %i, i64 1
  %x = load i64, ptr %a
  %y = load i64, ptr %b
