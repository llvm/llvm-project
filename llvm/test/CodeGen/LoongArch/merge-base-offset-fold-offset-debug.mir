# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=loongarch64 -run-pass=loongarch-merge-base-offset %s -o - | FileCheck %s

# Check that debug uses of the base address do not prevent folding an offset
# into the address materialization, and that they are salvaged by subtracting
# the folded offset again.

--- |
  @a = external hidden global [100 x i8]
  @b = external hidden global [1048576 x i8]

  define ptr @addi() !dbg !4 {
    ret ptr null
  }

  define ptr @addi_addi() !dbg !12 {
    ret ptr null
  }

  define ptr @large_offset() !dbg !13 {
    ret ptr null
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "merge-base-offset-fold-offset-debug.c", directory: "")
  !2 = !{i32 7, !"Dwarf Version", i32 5}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "addi", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !7)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !{!8}
  !8 = !DILocalVariable(name: "p", scope: !4, file: !1, line: 2, type: !9)
  !9 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !10, size: 64)
  !10 = !DIBasicType(name: "char", size: 8, encoding: DW_ATE_signed_char)
  !11 = !DILocation(line: 0, scope: !4)
  !12 = distinct !DISubprogram(name: "addi_addi", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !15)
  !13 = distinct !DISubprogram(name: "large_offset", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !18)
  !14 = !DILocalVariable(name: "p", scope: !12, file: !1, line: 2, type: !9)
  !15 = !{!14, !16}
  !16 = !DILocalVariable(name: "q", scope: !12, file: !1, line: 2, type: !9)
  !17 = !DILocation(line: 0, scope: !12)
  !18 = !{!19}
  !19 = !DILocalVariable(name: "p", scope: !13, file: !1, line: 2, type: !9)
  !20 = !DILocation(line: 0, scope: !13)
...
---
name:            addi
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: addi
    ; CHECK: [[PCALAU12I:%[0-9]+]]:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @a + 5
    ; CHECK-NEXT: [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PCALAU12I]], target-flags(loongarch-pcrel-lo) @a + 5
    ; CHECK-NEXT: DBG_VALUE [[ADDI_D]], $noreg, !8, !DIExpression(DW_OP_constu, 5, DW_OP_minus), debug-location !DILocation(line: 0, scope: !4)
    ; CHECK-NEXT: $r4 = COPY [[ADDI_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @a
    %1:gpr = ADDI_D %0, target-flags(loongarch-pcrel-lo) @a
    DBG_VALUE %1, $noreg, !8, !DIExpression(), debug-location !11
    %2:gpr = ADDI_D %1, 5
    $r4 = COPY %2
    PseudoRET implicit $r4
...
---
name:            addi_addi
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: addi_addi
    ; CHECK: [[PCALAU12I:%[0-9]+]]:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @a + 12
    ; CHECK-NEXT: [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PCALAU12I]], target-flags(loongarch-pcrel-lo) @a + 12
    ; CHECK-NEXT: DBG_VALUE [[ADDI_D]], $noreg, !13, !DIExpression(DW_OP_constu, 12, DW_OP_minus), debug-location !DILocation(line: 0, scope: !11)
    ; CHECK-NEXT: DBG_VALUE [[ADDI_D]], $noreg, !14, !DIExpression(DW_OP_constu, 7, DW_OP_minus), debug-location !DILocation(line: 0, scope: !11)
    ; CHECK-NEXT: $r4 = COPY [[ADDI_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @a
    %1:gpr = ADDI_D %0, target-flags(loongarch-pcrel-lo) @a
    DBG_VALUE %1, $noreg, !14, !DIExpression(), debug-location !17
    %2:gpr = ADDI_D %1, 5
    DBG_VALUE %2, $noreg, !16, !DIExpression(), debug-location !17
    %3:gpr = ADDI_D %2, 7
    $r4 = COPY %3
    PseudoRET implicit $r4
...
---
name:            large_offset
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: large_offset
    ; CHECK: [[PCALAU12I:%[0-9]+]]:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @b + 524288
    ; CHECK-NEXT: [[ADDI_D:%[0-9]+]]:gpr = ADDI_D [[PCALAU12I]], target-flags(loongarch-pcrel-lo) @b + 524288
    ; CHECK-NEXT: DBG_VALUE [[ADDI_D]], $noreg, !17, !DIExpression(DW_OP_constu, 524288, DW_OP_minus), debug-location !DILocation(line: 0, scope: !15)
    ; CHECK-NEXT: $r4 = COPY [[ADDI_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @b
    %1:gpr = ADDI_D %0, target-flags(loongarch-pcrel-lo) @b
    DBG_VALUE %1, $noreg, !19, !DIExpression(), debug-location !20
    %2:gpr = LU12I_W 128
    %3:gpr = ADD_D %1, %2
    $r4 = COPY %3
    PseudoRET implicit $r4
...
