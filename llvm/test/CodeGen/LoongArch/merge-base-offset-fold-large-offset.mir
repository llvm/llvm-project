# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=loongarch64 -code-model=large \
# RUN:   -run-pass=loongarch-merge-base-offset %s -o - | FileCheck %s

## Check that foldLargeOffset() computes the exact value of offset chains that
## are not in the canonical form produced by LoongArchMatInt.

--- |
  @g = dso_local global [1 x i64] zeroinitializer

  define ptr @ori_ori() { ret ptr null }
  define ptr @ori_ori_overlap() { ret ptr null }
  define ptr @ori_slli_ori() { ret ptr null }
  define ptr @lu12i_slli_lu32i() { ret ptr null }
  define ptr @lu12i_lu52i_ori() { ret ptr null }
...
---
name:            ori_ori
body:             |
  bb.0:
    ; CHECK-LABEL: name: ori_ori
    ; CHECK: [[PCALAU12I:%[0-9]+]]:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @g + 257
    ; CHECK-NEXT: [[ADDI_D:%[0-9]+]]:gpr = ADDI_D $r0, target-flags(loongarch-pcrel-lo) @g + 257
    ; CHECK-NEXT: [[LU32I_D:%[0-9]+]]:gpr = LU32I_D [[ADDI_D]], target-flags(loongarch-pcrel64-lo) @g + 257
    ; CHECK-NEXT: [[LU52I_D:%[0-9]+]]:gpr = LU52I_D [[LU32I_D]], target-flags(loongarch-pcrel64-hi) @g + 257
    ; CHECK-NEXT: [[ADD_D:%[0-9]+]]:gpr = ADD_D [[LU52I_D]], [[PCALAU12I]]
    ; CHECK-NEXT: $r4 = COPY [[ADD_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @g
    %1:gpr = ADDI_D $r0, target-flags(loongarch-pcrel-lo) @g
    %2:gpr = LU32I_D %1, target-flags(loongarch-pcrel64-lo) @g
    %3:gpr = LU52I_D %2, target-flags(loongarch-pcrel64-hi) @g
    %4:gpr = ADD_D %3, %0
    %5:gpr = ORI $r0, 256
    %6:gpr = ORI %5, 1
    %7:gpr = ADD_D %4, %6
    $r4 = COPY %7
    PseudoRET implicit $r4
...
---
name:            ori_ori_overlap
body:             |
  bb.0:
