    ; CHECK-NEXT: [[LU52I_D:%[0-9]+]]:gpr = LU52I_D [[LU32I_D]], target-flags(loongarch-pcrel64-hi) @g + 305419903
    ; CHECK-NEXT: [[ADD_D:%[0-9]+]]:gpr = ADD_D [[LU52I_D]], [[PCALAU12I]]
    ; CHECK-NEXT: $r4 = COPY [[ADD_D]]
    ; CHECK-NEXT: PseudoRET implicit $r4
    %0:gpr = PCALAU12I target-flags(loongarch-pcrel-hi) @g
    %1:gpr = ADDI_D $r0, target-flags(loongarch-pcrel-lo) @g
    %2:gpr = LU32I_D %1, target-flags(loongarch-pcrel64-lo) @g
    %3:gpr = LU52I_D %2, target-flags(loongarch-pcrel64-hi) @g
    %4:gpr = ADD_D %3, %0
