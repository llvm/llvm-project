;
; The displacement 2048 fits si14 << 2 during instruction selection. The
; byte-aligned stack object makes the final FP-relative displacement -977,
; which is not a multiple of four. Frame index elimination must fall back
; to the corresponding unscaled load/store without changing the address.
;
; Keep the assembly round-trip: MachineVerifier alone does not diagnose
; every target-specific immediate constraint, and an MC encoder must not
; silently discard the low two offset bits.

; Reviewer reproducer: the i32 load is promoted to an any-extending load.
define i32 @anyext_frame_offset() "frame-pointer"="all" nounwind {
; CHECK-LABEL: anyext_frame_offset:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi.d $sp, $sp, -2032
; CHECK-NEXT:    st.d $ra, $sp, 2024 # 8-byte Folded Spill
; CHECK-NEXT:    st.d $fp, $sp, 2016 # 8-byte Folded Spill
; CHECK-NEXT:    addi.d $fp, $sp, 2032
; CHECK-NEXT:    addi.d $sp, $sp, -1008
; CHECK-NEXT:    lu12i.w $a0, -1
; CHECK-NEXT:    ori $a0, $a0, 1071
; CHECK-NEXT:    add.d $a0, $fp, $a0
; CHECK-NEXT:    pcaddu18i $ra, %call36(use)
; CHECK-NEXT:    jirl $ra, $ra, 0
; CHECK-NEXT:    ld.w $a0, $fp, -977
; CHECK-NEXT:    addi.d $sp, $sp, 1008
; CHECK-NEXT:    ld.d $fp, $sp, 2016 # 8-byte Folded Reload
; CHECK-NEXT:    ld.d $ra, $sp, 2024 # 8-byte Folded Reload
; CHECK-NEXT:    addi.d $sp, $sp, 2032
; CHECK-NEXT:    ret
entry:
  %a = alloca [3001 x i8], align 1
  call void @use(ptr %a)
  %p = getelementptr i8, ptr %a, i64 2048
  %v = load i32, ptr %p, align 1
  ret i32 %v
}

