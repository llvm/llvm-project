; NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
; REQUIRES: asserts, aarch64-registered-target
; RUN: llc -global-isel -stop-after=irtranslator < %s 2>&1 | FileCheck %s

; Check that vector.deinterleave2 with <1 x float> results does not crash in GlobalISel.
; We used to try to build G_SHUFFLE_VECTOR with a scalar result type, which is not valid.

target triple = "aarch64-unknown-linux-gnu"

define float @test(<2 x float> %w) {
  ; CHECK-LABEL: name: test
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $d0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(<2 x i32>) = COPY $d0
  ; CHECK-NEXT:   [[BITCAST:%[0-9]+]]:_(<2 x f32>) = G_BITCAST [[COPY]](<2 x i32>)
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(<2 x f32>) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
  ; CHECK-NEXT:   [[EVEC:%[0-9]+]]:_(f32) = G_EXTRACT_VECTOR_ELT [[BITCAST]](<2 x f32>), [[C]](i64)
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
  ; CHECK-NEXT:   [[EVEC1:%[0-9]+]]:_(f32) = G_EXTRACT_VECTOR_ELT [[BITCAST]](<2 x f32>), [[C1]](i64)
  ; CHECK-NEXT:   [[FADD:%[0-9]+]]:_(f32) = G_FADD [[EVEC]], [[EVEC1]]
  ; CHECK-NEXT:   $s0 = COPY [[FADD]](f32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $s0
  %1 = call { <1 x float>, <1 x float> } @llvm.vector.deinterleave2.v2f32(<2 x float> %w)
  %2 = extractvalue { <1 x float>, <1 x float> } %1, 0
  %3 = extractvalue { <1 x float>, <1 x float> } %1, 1
  %4 = extractelement <1 x float> %2, i32 0
  %5 = extractelement <1 x float> %3, i32 0
  %6 = fadd float %4, %5
  ret float %6
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare { <1 x float>, <1 x float> } @llvm.vector.deinterleave2.v2f32(<2 x float>) #1
