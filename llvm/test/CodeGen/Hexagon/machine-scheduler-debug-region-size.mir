# RUN: llc -mtriple=hexagon -mcpu=hexagonv68 -mattr=+hvxv68,+hvx-length128b \
# RUN:   -run-pass=machine-scheduler -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=DEBUG
# RUN: llc -mtriple=hexagon -mcpu=hexagonv68 -mattr=+hvxv68,+hvx-length128b \
# RUN:   -run-pass=mir-strip-debug,machine-scheduler -mir-strip-debugify-only=0 \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=STRIPPED

# The VLIW scheduler's block-size heuristic must not count the DBG_VALUE.
# There are 22 schedulable instructions before the terminator; including the
# debug instruction changes an integer threshold based on the issue width.

--- |
  target triple = "hexagon-unknown-linux-musl"

  define void @test(ptr %kernel) !dbg !3 {
    %cgep = getelementptr i8, ptr %kernel, i32 3456
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "test", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !6)
  !4 = !DISubroutineType(types: !5)
  !5 = !{null}
  !6 = !{!7}
  !7 = !DILocalVariable(name: "value", scope: !3, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !3)
...
