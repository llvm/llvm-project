# RUN: llc -mtriple=hexagon -run-pass global-schedV2 %s -o - | FileCheck %s

# Test that the Global Scheduler V2 does not assert due to a pull up of a
# DBG_LABEL instruction.

# CHECK: DBG_LABEL

--- |
  target triple = "hexagon"

  %struct.iq = type { %struct.pt, %struct.it, %union.ma8 }
  %struct.pt = type { %struct.QL }
  %struct.QL = type { %struct.QN}
  %struct.QN = type { ptr, ptr }
  %struct.it = type { %struct.QL }
  %union.ma8 = type { i64, [8 x i8] }

  declare void @llvm.dbg.label(metadata)

  declare void @llvm.lifetime.end.p0i8(i64 immarg, ptr nocapture)

  declare dso_local fastcc void @invoke_qfp() unnamed_addr

  define dso_local void @bufs2() local_unnamed_addr {
  entry:
    %me.i = alloca ptr, align 4
    br i1 poison, label %do.end, label %invoke_qn.exit

  invoke_qn.exit:
    %0 = bitcast ptr %me.i to ptr
    call void @llvm.dbg.label(metadata !11), !dbg !10
    call void @llvm.lifetime.end.p0i8(i64 4, ptr nonnull %0)
    unreachable

  do.end:
    call fastcc void @invoke_qfp()
    unreachable
  }

  declare void @llvm.stackprotector(ptr, ptr)

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "Clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2, retainedTypes: !2, globals: !2, debugInfoForProfiling: true, nameTableKind: None)
  !1 = !DIFile(filename: "test.c", directory: "/tmp")
  !2 = !{}
  !3 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "tmp", scope: !1, file: !1, line: 144, type: !7, scopeLine: 144, flags: DIFlagPrototyped, spFlags: DISPFlagLocalToUnit | DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !6 = !DIFile(filename: "/tmp/tmp.c", directory: "")
  !7 = !DISubroutineType(types: !8)
  !8 = !{!5, null}
  !9 = distinct !DILocation(line: 370, column: 4, scope: !5)
  !10 = !DILocation(line: 149, column: 1, scope: !9, inlinedAt: !9)
  !11 = !DILabel(scope: !5, name: "bail", file: !1, line: 149)

...
---
name:            bufs2
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
hasWinCFI:       false
registers:       []
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       8
  offsetAdjustment: 0
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  localFrameSize:  0
  savePoint:       []
  restorePoint:    []
fixedStack:      []
stack:
  - { id: 0, name: me.i, type: default, offset: -4, size: 4, alignment: 4,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $p0

    J2_jumpf killed undef $p0, %bb.2, implicit-def $pc, debug-location !10

  bb.1.do.end:
    successors:

    frame-setup BUNDLE implicit-def $r29, implicit-def $r30, implicit killed $r29, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31, debug-location !10 {
      $r29 = frame-setup S2_allocframe killed $r29, 8, implicit-def $r30, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31, debug-location !10 :: (store 4 into stack)
      PS_call_nr @invoke_qfp, hexagoncsr, implicit-def $r29, debug-location !10
    }

  bb.2.invoke_qn.exit:
    DBG_LABEL !11, debug-location !10

...
