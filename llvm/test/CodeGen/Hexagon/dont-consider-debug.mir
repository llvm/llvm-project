---
name:            EdgeFilterLum
alignment:       16
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
hasWinCFI:       false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: true
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r5', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  localFrameSize:  0
  savePoint:       []
  restorePoint:    []
fixedStack:      []
stack:           []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r0:0x0000000000000001, $r1:0x0000000000000001, $r5:0x0000000000000001

    DBG_VALUE $r0, $noreg, !16, !DIExpression(), debug-location !33
    DBG_VALUE $r1, $noreg, !17, !DIExpression(), debug-location !33
    DBG_VALUE $r2, $noreg, !18, !DIExpression(), debug-location !33
    DBG_VALUE $r3, $noreg, !19, !DIExpression(), debug-location !33
    DBG_VALUE $r4, $noreg, !20, !DIExpression(), debug-location !33
    DBG_VALUE $r5, $noreg, !21, !DIExpression(), debug-location !33
    DBG_VALUE $r5, $noreg, !23, !DIExpression(), debug-location !33
    DBG_VALUE 1, $noreg, !22, !DIExpression(), debug-location !33
    DBG_VALUE $noreg, $noreg, !24, !DIExpression(DW_OP_LLVM_convert, 8, DW_ATE_unsigned, DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_stack_value), debug-location !34
    DBG_VALUE $noreg, $noreg, !26, !DIExpression(DW_OP_LLVM_convert, 8, DW_ATE_unsigned, DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_stack_value), debug-location !34
    DBG_VALUE $noreg, $noreg, !27, !DIExpression(DW_OP_LLVM_convert, 8, DW_ATE_unsigned, DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_stack_value), debug-location !34
    DBG_VALUE $noreg, $noreg, !28, !DIExpression(DW_OP_LLVM_convert, 8, DW_ATE_unsigned, DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_stack_value), debug-location !34
    BUNDLE implicit-def dead $p0, implicit-def dead $pc, implicit killed $r0, debug-location !35 {
      renamable $p0 = C2_cmpgtui killed renamable $r0, 2, debug-location !35
      J2_jumptnewpt internal killed renamable $p0, %bb.2, implicit-def dead $pc, debug-location !36
    }

  bb.1.if.then:
    successors: %bb.2(0x80000000)
    liveins: $r1, $r5

    DBG_VALUE $r4, $noreg, !27, !DIExpression(), debug-location !34
    BUNDLE implicit-def $r3, implicit-def $r2, implicit-def $r4, implicit $r5, implicit $r1, debug-location !37 {
      renamable $r3 = nsw M2_mpysmi renamable $r5, -3, debug-location !37
      renamable $r2 = A2_sub renamable $r1, renamable $r5, debug-location !44
      renamable $r4 = L2_loadrub_io renamable $r1, 0, debug-location !42 :: (load (s8) from %ir.q, !tbaa !39)
    }
    DBG_VALUE $r6, $noreg, !26, !DIExpression(), debug-location !34
    BUNDLE implicit-def $r6, implicit-def $r2, implicit killed $r2, implicit $r5, debug-location !44 {
      renamable $r6 = L2_loadrub_io renamable $r2, 0, debug-location !44 :: (load (s8) from %ir.cgep1, !tbaa !39)
      renamable $r2 = A2_sub killed renamable $r2, renamable $r5, debug-location !54
    }
    DBG_VALUE $r3, $noreg, !28, !DIExpression(), debug-location !34
    BUNDLE implicit-def $r3, implicit-def $r1, implicit killed $r1, implicit killed $r3, implicit killed $r5, debug-location !38 {
      renamable $r3 = L4_loadrub_rr renamable $r1, killed renamable $r3, 0, debug-location !38 :: (load (s8) from %ir.cgep, !tbaa !39)
      renamable $r1 = S2_asl_i_r_nac killed renamable $r1, killed renamable $r5, 1
    }
    renamable $r4 = nuw S4_addaddi killed renamable $r4, killed renamable $r6, 1, debug-location !48
    DBG_VALUE $noreg, $noreg, !29, !DIExpression(), debug-location !49
    $r0 = L2_loadrub_io killed renamable $r1, 0, debug-location !46 :: (load (s8) from %ir.cgep2, !tbaa !39)
    DBG_VALUE $r0, $noreg, !24, !DIExpression(), debug-location !34
    renamable $r3 = nuw nsw S2_lsr_i_r_acc killed renamable $r3, killed renamable $r4, 1, debug-location !50
    renamable $r3 = S2_asl_i_r_nac killed renamable $r3, $r0, 1, debug-location !51
    DBG_VALUE $r3, $noreg, !32, !DIExpression(DW_OP_constu, 1, DW_OP_shra, DW_OP_stack_value), debug-location !49
    BUNDLE implicit-def dead $r0, implicit killed $r0, implicit killed $r3, implicit killed $r2, debug-location !53 {
      $r0 = S2_lsr_i_r_acc killed $r0, killed renamable $r3, 1, debug-location !53
      S2_storerbnew_io killed renamable $r2, 0, internal killed $r0, debug-location !55 :: (store (s8) into %ir.add.ptr16, !tbaa !39)
    }

  bb.2.do.end:
    DBG_VALUE 0, $noreg, !22, !DIExpression(), debug-location !33
    PS_jmpret killed $r31, implicit-def $pc, debug-location !57

...
