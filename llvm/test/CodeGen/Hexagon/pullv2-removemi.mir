# RUN: llc -march=hexagon -run-pass global-schedV2 %s -o - | FileCheck %s

# Check that this doesn't crash.
# CHECK: f0

--- |
  target datalayout = "e-m:e-p:32:32:32-a:0-n16:32-i64:64:64-i32:32:32-i16:16:16-i1:8:8-f32:32:32-f64:64:64-v32:32:32-v64:64:64-v512:512:512-v1024:1024:1024-v2048:2048:2048"
  target triple = "hexagon"

  @g0 = external hidden unnamed_addr constant [5 x i8], align 1
  @g1 = external global i32, align 4

  define dso_local i32 @f0(i32 %a0) local_unnamed_addr {
  b0:
    %v0 = tail call i32 @f1(i32 %a0)
    %v1 = icmp eq i32 %v0, 0
    br i1 %v1, label %b1, label %b6

  b1:                                               ; preds = %b0
    %v2 = call i32 @f3(ptr nonnull @g1, i32 3, ptr poison, i32 -1, ptr nonnull poison)
    br i1 poison, label %b2, label %b5

  b2:                                               ; preds = %b1
    %v3 = call i32 asm sideeffect "{P0 = tstbit($1,$2); if (P0.new) $0 =; if (!P0.new) $0 =;}\0A", "=&r,r,r,~{p0}"(i32 poison, i32 poison)
    %v4 = icmp eq i32 %v3, 0
    br i1 %v4, label %b3, label %b4

  b3:                                               ; preds = %b2
    call void (ptr, ...) @f2(ptr getelementptr inbounds ([5 x i8], [5 x i8]* @g0, i32 0, i32 0))
    unreachable

  b4:                                               ; preds = %b2
    %v5 = call i32 @f3(ptr nonnull @g1, i32 2, ptr poison, i32 -1, ptr null)
    call void @llvm.dbg.label(metadata !9), !dbg !10
    br label %b6

  b5:                                               ; preds = %b1
    %v6 = call i32 @f3(ptr nonnull @g1, i32 4, ptr poison, i32 poison, ptr null)
    unreachable

  b6:                                               ; preds = %b4, %b0
    %v7 = phi i32 [ %v0, %b0 ], [ 0, %b4 ]
    ret i32 %v7
  }

  ; Function Attrs: nounwind readnone speculatable
  declare void @llvm.dbg.label(metadata)

  declare dso_local i32 @f1(i32) local_unnamed_addr
  declare dso_local void @f2(ptr, ...) local_unnamed_addr
  declare dso_local i32 @f3(ptr, i32, ptr, i32, ptr) local_unnamed_addr

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4, !5}

  !0 = distinct !DICompileUnit(language: DW_LANG_C89, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2, retainedTypes: !2, globals: !2, debugInfoForProfiling: true)
  !1 = !DIFile(filename: "test.c", directory: "/tmp")
  !2 = !{}
  !3 = !DIBasicType(name: "unsigned int", size: 32, encoding: DW_ATE_unsigned)
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = !{i32 1, !"wchar_size", i32 4}
  !6 = distinct !DISubprogram(name: "_cpu_up", scope: !1, file: !1, line: 498, type: !7, isLocal: false, isDefinition: true, scopeLine: 499, flags: DIFlagPrototyped, isOptimized: false, unit: !0)
  !7 = !DISubroutineType(types: !8)
  !8 = !{!3}
  !9 = !DILabel(scope: !6, name: "out_notify", file: !1, line: 540)
  !10 = !DILocation(line: 1, column: 1, scope: !6)
...

name: f0
fixedStack:
  - { id: 0, offset: 0, size: 8, alignment: 8 }
body: |
  bb.0.b0:
    successors: %bb.1(0x30000000), %bb.4(0x50000000)
    liveins: $r0, $d8, $d8, $r16, $r17
    frame-setup BUNDLE implicit-def $r29, implicit-def $r30, implicit-def $pc, implicit-def $r31, implicit-def $r0, implicit killed $r29, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31, implicit killed $d8, implicit $r0 {
      $r29 = frame-setup S2_allocframe killed $r29, 8, implicit-def $r30, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31 :: (store 4 into stack)
      S2_storerd_io internal $r29, -16, killed $d8 :: (store 8 into %fixed-stack.0)
      J2_call @f1, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit internal $r29, implicit $r0, implicit-def $r29, implicit-def $r0
    }
    BUNDLE implicit-def $r16, implicit-def dead $p0, implicit-def dead $pc, implicit killed $r0 {
      $r16 = A2_tfr $r0
      renamable $p0 = C2_cmpeqi killed $r0, 0
      J2_jumpfnewpt internal killed renamable $p0, %bb.4, implicit-def dead $pc
    }

  bb.1.b1:
    successors: %bb.2(0x7fffffff), %bb.5(0x00000001)
    liveins: $r2, $r4
    BUNDLE implicit-def $r16, implicit-def $r1, implicit-def $r3 {
      renamable $r16 = A2_tfrsi @g1 + 32767
      $r1 = A2_tfrsi 3
      $r3 = A2_tfrsi -1
    }
    BUNDLE implicit-def $r0, implicit-def $pc, implicit-def $r31, implicit-def $r29, implicit $r16, implicit $r29, implicit $r1, implicit undef $r2, implicit $r3, implicit undef $r4 {
      renamable $r0 = A2_addi renamable $r16, -32767
      J2_call @f3, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit $r29, implicit internal $r0, implicit $r1, implicit undef $r2, implicit $r3, implicit undef $r4, implicit-def $r29, implicit-def $r0
    }
    J2_jumpt killed undef renamable $p0, %bb.5, implicit-def dead $pc

  bb.2.b2:
    successors: %bb.6(0x00000001), %bb.3(0x7fffffff)
    liveins: $r2, $r16
    BUNDLE implicit-def dead $p0, implicit-def $pc, implicit $r2 {
      renamable $p0 = C2_cmpeqi renamable $r2, 0
      J2_jumptnew internal killed $p0, %bb.6, implicit-def $pc
    }

  bb.3.b4:
    successors: %bb.4(0x80000000)
    liveins: $r2, $r16
    BUNDLE implicit-def $r0, implicit-def $r1, implicit-def $r3, implicit-def $r4, implicit killed $r16 {
      renamable $r0 = A2_addi killed renamable $r16, -32767
      $r1 = A2_tfrsi 2
      $r3 = A2_tfrsi -1
      $r4 = A2_tfrsi 0
    }
    BUNDLE implicit-def $r16, implicit-def $pc, implicit-def $r31, implicit-def $r29, implicit-def $r0, implicit $r29, implicit $r0, implicit $r1, implicit undef $r2, implicit $r3, implicit $r4, debug-location !10 {
      renamable $r16 = A2_tfrsi 0
      J2_call @f3, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit $r29, implicit $r0, implicit $r1, implicit undef $r2, implicit $r3, implicit $r4, implicit-def $r29, implicit-def $r0
      DBG_LABEL !9, debug-location !10
    }

  bb.4.b6:
    liveins: $r16
    BUNDLE implicit-def dead $r0, implicit-def dead $d8, implicit-def $r16, implicit-def $r17, implicit-def $d15, implicit-def $r30, implicit-def $r31, implicit-def $pc, implicit-def $r29, implicit killed $r16, implicit killed $r29, implicit killed $r30, implicit killed $framekey {
      $r0 = A2_tfr killed $r16
      $d8 = L2_loadrd_io killed $r29, 0 :: (load 8 from %fixed-stack.0)
      $d15 = L4_return killed $r30, implicit-def $pc, implicit-def $r29, implicit killed $framekey, implicit-def $pc, implicit internal killed $r0, implicit internal killed $d8
    }

  bb.5.b5:
    liveins: $r2, $r3, $r16
    BUNDLE implicit-def $r0, implicit-def $r1, implicit-def $r4, implicit-def $r29, implicit killed $r16, implicit undef $r2, implicit undef $r3 {
      renamable $r0 = A2_addi killed renamable $r16, -32767
      $r1 = A2_tfrsi 4
      $r4 = A2_tfrsi 0
      PS_call_nr @f3, hexagoncsr, implicit internal $r0, implicit internal $r1, implicit undef $r2, implicit undef $r3, implicit internal $r4, implicit-def $r29, implicit-def $r0
    }

  bb.6.b3:
    BUNDLE implicit-def $r0, implicit-def $r29 {
      $r0 = A2_tfrsi @g0
      PS_call_nr @f2, hexagoncsr, implicit internal $r0, implicit-def $r29
    }
...
