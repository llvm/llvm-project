# RUN: llc -mtriple=hexagon -run-pass=hexagon-cfg -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# A debug instruction in a jump-only layout successor must not block branch
# inversion. Move its location to the original target when unambiguous;
# otherwise make the location unavailable.

# CHECK-LABEL: name: test
# CHECK-LABEL: bb.0:
# CHECK: J2_jumpf killed $p0, %bb.3
# CHECK-NEXT: J2_jump %bb.1
# CHECK-LABEL: bb.1:
# CHECK-NOT: DBG_
# CHECK-NOT: J2_jump
# CHECK-LABEL: bb.2:
# CHECK-NOT: DBG_
# CHECK-LABEL: bb.3:
# CHECK: DBG_VALUE $noreg, $noreg, ![[TEST_VAR:[0-9]+]]
# CHECK-NEXT: DBG_VALUE $noreg, $noreg, ![[TEST_VAR]]
# CHECK-NEXT: DBG_VALUE_LIST ![[TEST_VAR]], {{.*}}, $noreg, $noreg
# CHECK-NEXT: DBG_VALUE_LIST ![[TEST_VAR]], !DIExpression(DW_OP_LLVM_arg, 0), $noreg
# CHECK-NOT: DBG_PHI
# CHECK-NOT: DBG_LABEL

# CHECK-LABEL: name: move_debug
# CHECK-LABEL: bb.1:
# CHECK-NOT: DBG_
# CHECK-NOT: J2_jump
# CHECK-LABEL: bb.2:
# CHECK-NOT: DBG_
# CHECK: PS_jmpret
# CHECK-LABEL: bb.3:
# CHECK: DBG_VALUE 0, $noreg
# CHECK-NEXT: DBG_PHI $r0, 2
# CHECK-NEXT: DBG_LABEL
# CHECK-NEXT: PS_jmpret

# CHECK-LABEL: name: entry_loop
# CHECK-LABEL: bb.0:
# CHECK: DBG_VALUE $noreg, $noreg
# CHECK: J2_jumpf killed $p0, %bb.0
# CHECK-NEXT: J2_jump %bb.1
# CHECK-LABEL: bb.1:
# CHECK-NOT: DBG_VALUE
# CHECK-NOT: J2_jump

--- |
  define void @test() !dbg !3 {
    ret void
  }

  define void @move_debug() !dbg !9 {
    ret void
  }

  define void @entry_loop() !dbg !13 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!6}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !DISubroutineType(types: !{})
  !3 = distinct !DISubprogram(name: "test", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !4)
  !4 = !{!5}
  !5 = !DILocalVariable(name: "x", scope: !3, file: !1, line: 1, type: !7)
  !6 = !{i32 2, !"Debug Info Version", i32 3}
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
  !9 = distinct !DISubprogram(name: "move_debug", scope: !1, file: !1, line: 2, type: !2, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !10)
  !10 = !{!11}
  !11 = !DILocalVariable(name: "x", scope: !9, file: !1, line: 2, type: !7)
  !12 = !DILocation(line: 2, column: 1, scope: !9)
  !13 = distinct !DISubprogram(name: "entry_loop", scope: !1, file: !1, line: 3, type: !2, scopeLine: 3, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !14)
  !14 = !{!15}
  !15 = !DILocalVariable(name: "x", scope: !13, file: !1, line: 3, type: !7)
  !16 = !DILocation(line: 3, column: 1, scope: !13)
  !17 = !DILabel(scope: !3, name: "test_label", file: !1, line: 1)
  !18 = !DILabel(scope: !9, name: "move_label", file: !1, line: 2)
...
---
name:            test
debugInstrRef:   true
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $p0, $r31

    $r0 = A2_tfrsi 1, debug-instr-number 1
    J2_jumpt killed $p0, %bb.2, implicit-def dead $pc
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.3

    DBG_VALUE 0, $noreg, !5, !DIExpression(), debug-location !8
    DBG_VALUE $r0, $noreg, !5, !DIExpression(), debug-location !8
    DBG_VALUE_LIST !5, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus), 0, $r1, debug-location !8
    DBG_INSTR_REF !5, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !8
    DBG_PHI $r0, 1
    DBG_LABEL !17
    J2_jump %bb.3, implicit-def dead $pc

  bb.2:
    successors: %bb.3

    J2_jump %bb.3, implicit-def dead $pc

  bb.3:
    liveins: $r31

    PS_jmpret killed $r31, implicit-def dead $pc
...
---
name:            move_debug
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $p0, $r31

    J2_jumpt killed $p0, %bb.2, implicit-def dead $pc
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.3

    DBG_VALUE 0, $noreg, !11, !DIExpression(), debug-location !12
    DBG_PHI $r0, 2
    DBG_LABEL !18
    J2_jump %bb.3, implicit-def dead $pc

  bb.2:
    liveins: $r31

    PS_jmpret killed $r31, implicit-def dead $pc

  bb.3:
    liveins: $r31

    PS_jmpret killed $r31, implicit-def dead $pc
...
---
name:            entry_loop
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $p0, $r31

    J2_jumpt killed $p0, %bb.2, implicit-def dead $pc
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.0

    DBG_VALUE 0, $noreg, !15, !DIExpression(), debug-location !16
    J2_jump %bb.0, implicit-def dead $pc

  bb.2:
    liveins: $r31

    PS_jmpret killed $r31, implicit-def dead $pc

...
