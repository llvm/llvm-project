name: branch_jumpt
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: branch_jumpt
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   J2_jumpt undef %0:predregs, %bb.2, implicit-def $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   J2_jumpr $r31, implicit-def $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   J2_jumpr $r31, implicit-def $pc
  bb.0:
    successors: %bb.2, %bb.1
    J2_jumpt undef %0:predregs, %bb.2, implicit-def $pc

  bb.1:
    J2_jumpr $r31, implicit-def $pc

  bb.2:
    J2_jumpr $r31, implicit-def $pc
...

