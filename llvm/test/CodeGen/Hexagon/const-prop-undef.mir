# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=hexagon -run-pass=hexagon-constp -o - %s | FileCheck %s

# Constant propagation must not crash on a use with no reaching
# definition. Each function feeds an undef register into a different
# evaluator path.

---
name: cmp_rr
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: cmp_rr
    ; CHECK: [[C2_cmpeq:%[0-9]+]]:predregs = C2_cmpeq undef %1:intregs, undef %2:intregs
    ; CHECK-NEXT: [[C2_tfrpr:%[0-9]+]]:intregs = C2_tfrpr [[C2_cmpeq]]
    ; CHECK-NEXT: $r0 = COPY [[C2_tfrpr]]
    ; CHECK-NEXT: J2_jumpr $r31, implicit-def $pc, implicit $r0
    %0:predregs = C2_cmpeq undef %1:intregs, undef %2:intregs
    %3:intregs = C2_tfrpr %0
    $r0 = COPY %3
    J2_jumpr $r31, implicit-def $pc, implicit $r0
...

