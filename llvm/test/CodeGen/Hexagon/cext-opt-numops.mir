# RUN: llc -mtriple=hexagon -run-pass hexagon-cext-opt %s -o - | FileCheck %s
# RUN: llc -mtriple=hexagon -mir-strip-debugify-only=0 -run-pass mir-strip-debug,hexagon-cext-opt,mir-strip-debug %s -o %t.nodbg
# RUN: llc -mtriple=hexagon -mir-strip-debugify-only=0 -run-pass hexagon-cext-opt,mir-strip-debug %s -o %t.withdbg
# RUN: diff %t.nodbg %t.withdbg

# An incorrect assertion was triggered on this code, while attempting to
# perform a valid transformation.

# CHECK: [[BASE:%[0-9]+]]:intregs = A2_tfrsi @array + 32911
# CHECK: [[ADDR:%[0-9]+]]:intregs = A2_addi [[BASE]], -32768
# CHECK: {{%[0-9]+}}:intregs = A2_addi [[BASE]], -32487
# CHECK: {{%[0-9]+}}:intregs = A2_addi [[ADDR]], 561
# CHECK: {{%[0-9]+}}:intregs = A2_addi [[BASE]], -32767
# CHECK: PS_jmpret

--- |
  define void @fred() !dbg !5 { ret void, !dbg !11 }

  @array = global [1024 x i8] zeroinitializer, align 8

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1,
      producer: "debugify", isOptimized: true, runtimeVersion: 0,
      emissionKind: FullDebug)
  !1 = !DIFile(filename: "cext-opt-numops.mir", directory: "/")
  !5 = distinct !DISubprogram(name: "fred", linkageName: "fred", scope: null,
      file: !1, line: 1, type: !3, scopeLine: 1,
      spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0,
      retainedNodes: !6)
  !3 = !DISubroutineType(types: !7)
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !6 = !{!8}
  !7 = !{}
  !8 = !DILocalVariable(name: "x", scope: !5, file: !1, line: 1, type: !9)
  !9 = !DIBasicType(name: "ty32", size: 32, encoding: DW_ATE_unsigned)
  !11 = !DILocation(line: 1, column: 1, scope: !5)
...

---
name: fred
tracksRegLiveness: true
registers:
  - { id: 0, class: intregs }
  - { id: 1, class: intregs }
  - { id: 2, class: intregs }
  - { id: 3, class: predregs }
  - { id: 4, class: intregs }
  - { id: 5, class: intregs }
  - { id: 6, class: intregs }
  - { id: 7, class: intregs }
  - { id: 8, class: intregs }
  - { id: 9, class: intregs }

body: |
  bb.0:
    liveins: $r0, $r1
      %0 = COPY $r1
      %1 = COPY $r0
      %2 = A2_tfrsi @array
      DBG_VALUE %2, $noreg, !8, !DIExpression(), debug-location !11
      %3 = IMPLICIT_DEF
      %4 = A2_tfrsi @array+424
      %5 = M2_macsip %0, %1, 5
      %6 = A2_addi %2, 704
      %7 = A2_tfrsi 0
      S4_pstorerif_rr %3, %6, %5, 2, %7
      %8 = A2_tfrsi @array+144
      %9 = C2_mux %3, %4, %8
      S4_storeiri_io %9, 0, 0
      PS_jmpret $r31, implicit-def $pc
...
