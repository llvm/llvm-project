# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=hexagon -run-pass pipeliner -pipeliner-experimental-cg=true -verify-machineinstrs %s -o - | FileCheck %s

# Check that an in-loop PHI (%2) whose backedge value (%1) is defined outside
# the loop has its initial value (%0) preserved across stages when consumed in
# stage > 0.

---
name:            test
tracksRegLiveness: true

body:             |
  ; CHECK-LABEL: name: test
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_tfrsi1:%[0-9]+]]:intregs = A2_tfrsi 42
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:intregs = IMPLICIT_DEF
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_addi:%[0-9]+]]:intregs = A2_addi [[A2_tfrsi]], 1
  ; CHECK-NEXT:   J2_loop0i %bb.1, 9, implicit-def $lc0, implicit-def $sa0, implicit-def $usr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.5(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:intregs = PHI [[A2_addi]], %bb.3, %3, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:intregs = PHI [[A2_tfrsi1]], %bb.3, [[A2_tfrsi1]], %bb.1
  ; CHECK-NEXT:   [[A2_add:%[0-9]+]]:intregs = A2_add [[PHI]], [[PHI1]]
  ; CHECK-NEXT:   [[A2_addi1:%[0-9]+]]:intregs = A2_addi [[A2_tfrsi]], 1
  ; CHECK-NEXT:   ENDLOOP0 %bb.1, implicit-def $pc, implicit-def $lc0, implicit $sa0, implicit $lc0
  ; CHECK-NEXT:   J2_jump %bb.5, implicit-def $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:intregs = PHI [[A2_addi1]], %bb.1
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:intregs = PHI [[A2_tfrsi1]], %bb.1
  ; CHECK-NEXT:   [[A2_add1:%[0-9]+]]:intregs = A2_add [[PHI2]], [[PHI3]]
  ; CHECK-NEXT:   J2_jump %bb.4, implicit-def $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   J2_jump %bb.2, implicit-def $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r0 = COPY [[A2_add1]]
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc, implicit $r0
  bb.0:
    successors: %bb.1

    %0:intregs = A2_tfrsi 0
    %1:intregs = A2_tfrsi 42
    J2_loop0i %bb.1, 10, implicit-def $lc0, implicit-def $sa0, implicit-def $usr
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.2, %bb.1

    %2:intregs = PHI %0, %bb.0, %1, %bb.1
    %3:intregs = A2_addi %0, 1
    %4:intregs = A2_add %3, %2
    ENDLOOP0 %bb.1, implicit-def $pc, implicit-def $lc0, implicit $sa0, implicit $lc0
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    $r0 = COPY %4
    PS_jmpret $r31, implicit-def dead $pc, implicit $r0
...
