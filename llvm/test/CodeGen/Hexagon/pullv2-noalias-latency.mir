# Check that localPullup does not pull up S2_asr_i_p past a store when doing
# so would violate the 2-cycle latency of M2_dpmpyss_acc_s0 in the previous
# packet. Without the fix, shouldNotBeCrossed(store, asr) returns false (asr
# is not a memory op), allowing the pullup and causing a latency stall.

# RUN: llc -march=hexagon -mcpu=hexagonv73 \
# RUN: -run-pass=global-schedV2 -verify-machineinstrs %s -o - | FileCheck %s

# CHECK: bb.1.loop
# CHECK: M2_dpmpyss_acc_s0
# CHECK: S2_storeri_io
# CHECK-NOT: S2_asr_i_p
# CHECK: BUNDLE
# CHECK: S2_asr_i_p

--- |
  target triple = "hexagon"

  define void @test_latency_pullup() {
  entry:
    br label %loop
  loop:
    br label %exit
  exit:
    ret void
  }
...
---
name:            test_latency_pullup
alignment:       16
liveins:
  - { reg: '$r7',  virtual-reg: '' }
  - { reg: '$r8',  virtual-reg: '' }
  - { reg: '$r9',  virtual-reg: '' }
  - { reg: '$r10', virtual-reg: '' }
  - { reg: '$d7',  virtual-reg: '' }
  - { reg: '$r31', virtual-reg: '' }
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $r7, $r8, $r9, $r10, $d7, $r31

    BUNDLE implicit-def $lc0, implicit-def $sa0, implicit-def $usr {
      J2_loop0i %bb.1, 10, implicit-def $lc0, implicit-def $sa0, implicit-def $usr
    }

  bb.1.loop (align 16):
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r7, $r8, $r9, $r10, $d7, $r31, $sa0, $lc0

    ; P1: mpy-accumulate - produces $d7 (r15:14) with 2-cycle output latency
    BUNDLE implicit-def $d7, implicit $d7, implicit $r8, implicit $r9 {
      renamable $d7 = M2_dpmpyss_acc_s0 renamable $d7, renamable $r8, renamable $r9
    }

    ; P2: store - shouldNotBePulledUp(store)=true so it stays here;
    ;     shouldNotBeCrossed(store, asr)=false so asr is a pullup candidate
    BUNDLE implicit $r7, implicit $r10 {
      S2_storeri_io renamable $r7, 0, renamable $r10
    }

    ; P3: asr reads $d7 produced by P1 (2 packets back, 2-cycle latency).
    ;     Without fix: pulled up to P2 -> violates 2-cycle latency from P1.
    ;     With fix: canCauseInterlockStall rejects the pullup -> stays here.
    BUNDLE implicit-def $d7, implicit-def $pc, implicit-def $lc0, implicit $d7, implicit killed $sa0, implicit $lc0 {
      renamable $d7 = S2_asr_i_p renamable $d7, 28
      ENDLOOP0 %bb.1, implicit-def $pc, implicit-def $lc0, implicit killed $sa0, implicit $lc0
    }

  bb.2.exit:
    liveins: $d7, $r31

    BUNDLE implicit-def $pc, implicit $r31 {
      J2_jumpr killed $r31, implicit-def $pc
    }
...
