# Verify fusion with shared physical inputs and rejection after an input clobber.
# RUN: llc -mtriple=hexagon -run-pass hexagon-peephole \
# RUN:   -hexagon-fuse-intrinsic-vminub=true -o - %s | FileCheck %s

# CHECK-LABEL: name: fuse_phys_input
# CHECK:       %{{[0-9]+}}:doubleregs, %{{[0-9]+}}:predregs = A6_vminub_RdP $d0, $d1
# CHECK-NOT:   A2_vminub
# CHECK-NOT:   C2_cmpgtup

name: fuse_phys_input
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d0, $d1, $r31

    %0:doubleregs = A2_vminub $d0, $d1
    %1:predregs = C2_cmpgtup $d0, $d1
    PS_jmpret $r31, implicit-def $pc

---

# CHECK-LABEL: name: no_fuse_after_phys_clobber
# CHECK:       %0:doubleregs = A2_vminub $d0, $d1
# CHECK:       $d0 = A2_combinew $r0, $r1
# CHECK:       %1:predregs = C2_cmpgtup $d0, $d1
# CHECK-NOT:   A6_vminub_RdP

name: no_fuse_after_phys_clobber
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d0, $d1, $r0, $r1, $r31

    %0:doubleregs = A2_vminub $d0, $d1
    $d0 = A2_combinew $r0, $r1
    %1:predregs = C2_cmpgtup $d0, $d1
    PS_jmpret $r31, implicit-def $pc
