# RUN: llc -mtriple=hexagon -mcpu=hexagonv85 -mattr=+hlx \
# RUN:   -run-pass=hexagon-packetizer -verify-machineinstrs %s -o - | FileCheck %s

# Check that a store and a possibly aliasing load are not packetized together
# when either of them is an HLX access.

# CHECK-LABEL: name: scalar_store_hlx_load
# CHECK: {{^    }}S2_storerh_io
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: $l0 = LX_L16b_pseudo

# CHECK-LABEL: name: hlx_store_scalar_load
# CHECK: {{^    }}LX_S16b_pseudo
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: $r2 = L2_loadrh_io

# CHECK-LABEL: name: hlx_store_hlx_load
# CHECK: {{^    }}LX_S16b_pseudo
# CHECK-NEXT: BUNDLE
# CHECK-NEXT: $l1 = LX_L16b_pseudo
---
name: scalar_store_hlx_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2, $r3, $r4

    S2_storerh_io $r2, 0, $r4 :: (store (s16))
    $l0 = LX_L16b_pseudo $r3 :: (load (s16384))
    PS_jmpret $r31, implicit-def dead $pc, implicit $l0
...
---
name: hlx_store_scalar_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $l0, $r2, $r3

    LX_S16b_pseudo $r3, $l0 :: (store (s16384))
    $r2 = L2_loadrh_io $r2, 0 :: (load (s16))
    PS_jmpret $r31, implicit-def dead $pc, implicit $r2
...
---
name: hlx_store_hlx_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $l0, $r2, $r3

    LX_S16b_pseudo $r3, $l0 :: (store (s16384))
    $l1 = LX_L16b_pseudo $r2 :: (load (s16384))
    PS_jmpret $r31, implicit-def dead $pc, implicit $l1
...
