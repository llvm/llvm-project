# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "C2_cmove|C2_mux" --version 6
# RUN: llc -mtriple=hexagon -run-pass=hexagon-gen-mux -hexagon-gen-mux-threshold=4 -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define i32 @genmux_near(i32 %a, i32 %b) {
    ret i32 0
  }

  define i32 @genmux_near_debug(i32 %a, i32 %b) !dbg !5 {
    ret i32 0
  }

  define i32 @genmux_far(i32 %a, i32 %b) {
    ret i32 0
  }

  define i32 @genmux_far_debug(i32 %a, i32 %b) !dbg !11 {
    ret i32 0
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "genmux-debug-distance.mir", directory: "/")
  !2 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !3 = !{i32 2, !"Dwarf Version", i32 4}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "genmux_near_debug", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !6 = !DISubroutineType(types: !7)
  !7 = !{!2, !2, !2}
  !9 = !DILocalVariable(name: "cond", scope: !5, file: !1, line: 1, type: !2)
  !10 = !DILocation(line: 1, column: 1, scope: !5)
  !11 = distinct !DISubprogram(name: "genmux_far_debug", scope: !1, file: !1, line: 2, type: !6, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !12 = !DILocation(line: 2, column: 1, scope: !11)
  !14 = !DILocalVariable(name: "cond", scope: !11, file: !1, line: 2, type: !2)
...
---
name:            genmux_near
tracksRegLiveness: true
noVRegs:         true
liveins:
  - { reg: '$r0' }
  - { reg: '$r1' }
body:             |
  bb.0:
    liveins: $r0, $r1

    ; CHECK-LABEL: name: genmux_near
    ; CHECK: renamable $r0 = C2_cmoveit renamable $p0, 1
    ; CHECK-NEXT: renamable $r0 = C2_cmoveif killed renamable $p0, 0, implicit renamable $r0(tied-def 0)
    renamable $p0 = C2_cmpgtu renamable $r0, killed renamable $r1
    A2_nop
    A2_nop
    renamable $r0 = C2_cmoveit renamable $p0, 1
    renamable $r0 = C2_cmoveif killed renamable $p0, 0, implicit renamable $r0(tied-def 0)
    PS_jmpret killed $r31, implicit-def $pc, implicit killed $r0
...
---
name:            genmux_near_debug
tracksRegLiveness: true
noVRegs:         true
liveins:
  - { reg: '$r0' }
  - { reg: '$r1' }
body:             |
  bb.0:
    liveins: $r0, $r1

    ; CHECK-LABEL: name: genmux_near_debug
    ; CHECK: renamable $r0 = C2_cmoveit renamable $p0, 1
    ; CHECK-NEXT: renamable $r0 = C2_cmoveif killed renamable $p0, 0, implicit renamable $r0(tied-def 0)
    renamable $p0 = C2_cmpgtu renamable $r0, killed renamable $r1
    DBG_VALUE $noreg, $noreg, !9, !DIExpression(), debug-location !10
    DBG_VALUE $noreg, $noreg, !9, !DIExpression(), debug-location !10
    DBG_VALUE $noreg, $noreg, !9, !DIExpression(), debug-location !10
    A2_nop
    A2_nop
    renamable $r0 = C2_cmoveit renamable $p0, 1
    renamable $r0 = C2_cmoveif killed renamable $p0, 0, implicit renamable $r0(tied-def 0)
    PS_jmpret killed $r31, implicit-def $pc, implicit killed $r0
...
