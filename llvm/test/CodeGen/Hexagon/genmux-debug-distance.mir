tracksRegLiveness: true
noVRegs:         true
liveins:
  - { reg: '$r0' }
  - { reg: '$r1' }
body:             |
  bb.0:
    liveins: $r0, $r1

    ; CHECK-LABEL: name: genmux_far_debug
    ; CHECK: $r0 = C2_muxii killed $p0, 1, 0
    renamable $p0 = C2_cmpgtu renamable $r0, killed renamable $r1
    DBG_VALUE $noreg, $noreg, !14, !DIExpression(), debug-location !12
    DBG_VALUE $noreg, $noreg, !14, !DIExpression(), debug-location !12
    DBG_VALUE $noreg, $noreg, !14, !DIExpression(), debug-location !12
    A2_nop
    A2_nop
    A2_nop
    renamable $r0 = C2_cmoveit renamable $p0, 1
    renamable $r0 = C2_cmoveif killed renamable $p0, 0, implicit renamable $r0(tied-def 0)
