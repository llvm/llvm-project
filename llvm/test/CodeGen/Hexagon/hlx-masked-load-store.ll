; RUN: llc -mtriple=hexagon -mcpu=hexagonv85 -mattr=+hlx -verify-machineinstrs \
; RUN:   < %s | FileCheck %s

; Check that masked loads and stores of HLX vector types are not scalarized.

define void @masked_load(ptr %p, ptr %q, ptr %m) {
; CHECK-LABEL: masked_load:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    {
; CHECK-NEXT:     L0.h = #0
; CHECK-NEXT:     L1.h = L1.h
; CHECK-NEXT:     L1.tmp = mem(r2)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L1.h = cmp.gt(L0.h,L1.h)
; CHECK-NEXT:     L2.h = L2.h
; CHECK-NEXT:     L2.tmp = mem(r0)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L0.h = mux(L0.h,L2.h,L1.h)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L0.h = L0.h
; CHECK-NEXT:     jumpr r31
; CHECK-NEXT:     mem(r1) = L0.new
; CHECK-NEXT:    }
  %v = load <1024 x i16>, ptr %m, align 2048
  %c = icmp slt <1024 x i16> %v, zeroinitializer
  %l = call <1024 x i16> @llvm.masked.load.v1024i16.p0(ptr align 2048 %p, <1024 x i1> %c, <1024 x i16> zeroinitializer)
  store <1024 x i16> %l, ptr %q, align 2048
  ret void
}

define void @masked_store(ptr %p, ptr %q, ptr %m) {
; CHECK-LABEL: masked_store:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    {
; CHECK-NEXT:     L0.h = #0
; CHECK-NEXT:     L1.h = L1.h
; CHECK-NEXT:     L1.tmp = mem(r2)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L0.h = cmp.gt(L0.h,L1.h)
; CHECK-NEXT:     L2.h = L2.h
; CHECK-NEXT:     L2.tmp = mem(r0)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L15.h = L15.h
; CHECK-NEXT:     L15.tmp = mem(r1)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L2.h = mux(L2.h,L15.h,L0.h)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     L2.h = L2.h
; CHECK-NEXT:     jumpr r31
; CHECK-NEXT:     mem(r0) = L2.new
; CHECK-NEXT:    }
  %v = load <1024 x i16>, ptr %m, align 2048
  %c = icmp slt <1024 x i16> %v, zeroinitializer
  %s = load <1024 x i16>, ptr %q, align 2048
  call void @llvm.masked.store.v1024i16.p0(<1024 x i16> %s, ptr align 2048 %p, <1024 x i1> %c)
  ret void
}
