# RUN: llc -mtriple=hexagon -run-pass hexagon-cext-opt %s -o - | FileCheck %s

# Check that this testcase does not crash.
# CHECK: L4_and_memopw_io

---
name: fred
body: |
  bb.0:
    successors: %bb.1
        %0:intregs = A2_tfrsi -360184608
        %1:intregs = L2_loadri_io %0, -1024

  bb.1:
    successors: %bb.2
        %2:intregs = A2_tfrsi -234944641
        %3:intregs = A2_tfrsi -360185632
        L4_and_memopw_io %3, 0, %2

  bb.2:
    successors: %bb.3, %bb.4
        %4:predregs = IMPLICIT_DEF
        J2_jumpt %4, %bb.4, implicit-def $pc
        J2_jump %bb.3, implicit-def $pc

  bb.3:
    successors: %bb.4

  bb.4:
        %5:intregs = A2_tfrsi -234944521
        %6:intregs = A2_tfrsi -360185632
        L4_and_memopw_io %6, 0, %5
...
