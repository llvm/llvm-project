# RUN: llc -mtriple=hexagon -run-pass=hexagon-nvj -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=hexagon -run-pass=mir-strip-debug,hexagon-nvj -mir-strip-debugify-only=0 -verify-machineinstrs %s -o - | FileCheck %s
# CHECK: J4_cmpgtu_t_jumpnv_t killed $r3, killed $r1, %bb.1, implicit-def $pc

--- |
  define void @fred() !dbg !5 {
  entry:
    ret void, !dbg !11
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "debugify", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "newvaluejump-kill2.mir", directory: "/")
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "fred", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !8)
  !6 = !DISubroutineType(types: !7)
  !7 = !{}
  !8 = !{!9}
  !9 = !DILocalVariable(name: "value", scope: !5, file: !1, line: 1, type: !10)
  !10 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !11 = !DILocation(line: 1, column: 1, scope: !5)
...
---
name: fred
tracksRegLiveness: true

body: |
  bb.0:
    liveins: $r0
        $r1 = A2_addi $r0, -1
        $r2 = A2_tfrsi -1431655765
        $r3 = A2_tfrsi 2
        DBG_VALUE $r3, $noreg, !9, !DIExpression(), debug-location !11
        $p0 = C2_cmpgtu killed $r3, $r1
        $r2 = S4_subaddi killed $r1, 1, killed $r2
        J2_jumpt killed $p0, %bb.1, implicit-def $pc
  bb.1:
...
