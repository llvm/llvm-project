# RUN: llc -mtriple=hexagon -run-pass expand-condsets -o - %s | FileCheck %s

# CHECK-LABEL: name: fred

--- |
  define void @fred() { ret void }

...
---

name: fred
liveins:
  - { reg: '$r0', virtual-reg: '%99' }

body: |
  bb.0:
    liveins: $r0
    successors: %bb.298, %bb.301
        %99:intregs = COPY $r0
        J2_jumpr %99, implicit-def $pc

  bb.298:
    liveins: $r0
    successors: %bb.299, %bb.301, %bb.309
        %0:intregs = A2_tfrsi 123
        %1:intregs = A2_tfrsi -1
        %3:intregs = L2_loadri_io %99, 8
        %4:predregs = C2_cmpeqi %3, 33
        %5:intregs = A2_tfrsi -2
        %6:intregs = C2_mux %4, %5, %1
        J2_jumpr %6, implicit-def $pc

  bb.299:
    successors: %bb.300, %bb.309
        %7:intregs = L2_loadrb_io %99, 12
        %8:predregs = C2_cmpeqi %7, 9
        %9:intregs = A2_tfrsi -999
        ; CHECK: %10:intregs = C2_cmoveit %8, -999, implicit %10
        %10:intregs = C2_mux %8, %9, %1
        J2_jumpr %10, implicit-def $pc

  bb.300:
    successors: %bb.309
        S2_storeri_io %99, 0, %0
        J2_jump %bb.309, implicit-def $pc

  bb.301:
    successors: %bb.299, %bb.309
        %0 = A2_tfrsi 124
        %1 = A2_tfrsi -4
        %11:intregs = L2_loadri_io %99, 8
        %12:predregs = C2_cmpeqi %11, 33
        %13:intregs = A2_tfrsi -2
        %14:intregs = C2_mux %12, %13, %1
        J2_jumpr %14, implicit-def $pc

  bb.309:

...

