# RUN: llc -mtriple=hexagon -mcpu=hexagonv85 -mattr=+hlx \
# RUN:   -run-pass=hexagon-copy-combine -verify-machineinstrs %s -o - | FileCheck %s

# Check that two HLX copies into the halves of a register pair are combined
# into LX_combine_w.

# CHECK-LABEL: name: hlx_copies
# CHECK: $l4 = LX_assign $l0
# CHECK-NEXT: $ll1 = LX_combine_w $l5, $l6
# CHECK-NEXT: $l1 = LX_assign $l0
---
name: hlx_copies
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $l0, $l5, $l6

    $l4 = LX_assign $l0
    $l3 = LX_assign $l5
    $l2 = LX_assign $l6
    $l1 = LX_assign $l0
    PS_jmpret $r31, implicit-def dead $pc, implicit $l1, implicit $l2, implicit $l3, implicit $l4
...
