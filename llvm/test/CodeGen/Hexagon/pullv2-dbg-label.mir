# RUN: llc -march=hexagon -run-pass global-schedV2 %s -o - | FileCheck %s

# Check for a lack of crashing.
# CHECK: PS_call_nr @f1, hexagoncsr, implicit-def $r29

--- |
  target triple = "hexagon"

  @g0 = external dso_local local_unnamed_addr global i32, align 4
  @g1 = external hidden unnamed_addr constant [6 x i8], align 1

  declare void @llvm.dbg.label(metadata)

  define dso_local void @f0(ptr %a0, i32 %a1) local_unnamed_addr {
  b0:
    br i1 poison, label %b1, label %b2

  b1:                                               ; preds = %b0
    %v0 = tail call i32 @f2(ptr getelementptr inbounds ([6 x i8], [6 x i8]* @g1, i32 0, i32 0))
    store i32 poison, ptr @g0, align 4
    call void @llvm.dbg.label(metadata !9), !dbg !10
    ret void

  b2:                                               ; preds = %b0
    call void @f1()
    unreachable
  }

  declare dso_local void @f1() local_unnamed_addr
  declare dso_local i32 @f2(ptr) local_unnamed_addr

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4, !5}

  !0 = distinct !DICompileUnit(language: DW_LANG_C89, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2, retainedTypes: !2, globals: !2, debugInfoForProfiling: true)
  !1 = !DIFile(filename: "file.c", directory: "/test")
  !2 = !{}
  !3 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = !{i32 1, !"wchar_size", i32 4}
  !6 = distinct !DISubprogram(name: "f0", scope: !1, file: !1, line: 381, type: !7, isLocal: false, isDefinition: true, scopeLine: 382, flags: DIFlagPrototyped, isOptimized: false, unit: !0, retainedNodes: !2)
  !7 = !DISubroutineType(types: !8)
  !8 = !{null, !3}
  !9 = !DILabel(scope: !6, name: "out", file: !1, line: 4)
  !10 = !DILocation(line: 4, column: 1, scope: !6)
...

---
name: f0
body: |
  bb.0.b0:
    successors: %bb.1(0x7fffffff), %bb.2(0x00000001); %bb.1(100.00%), %bb.2(0.00%)
    liveins: $p0
    frame-setup BUNDLE implicit-def $r29, implicit-def $r30, implicit-def dead $pc, implicit killed $r29, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31, implicit killed undef $p0 {
      $r29 = frame-setup S2_allocframe killed $r29, 0, implicit-def $r30, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31 :: (store 4 into stack)
      J2_jumpt killed undef renamable $p0, %bb.2, implicit-def dead $pc
    }

  bb.1.b1:
    BUNDLE implicit-def $r0, implicit-def $pc, implicit-def $r31, implicit-def $r29, implicit $r29 {
      $r0 = A2_tfrsi @g1
      J2_call @f2, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit $r29, implicit internal $r0, implicit-def $r29, implicit-def $r0
      DBG_LABEL !9, debug-location !10
    }
    $d15 = L4_return killed $r30, implicit-def $pc, implicit-def $r29, implicit killed $framekey, implicit-def $pc

  bb.2.b2:
    PS_call_nr @f1, hexagoncsr, implicit-def $r29
...
