# RUN: llc -mtriple=hexagon -run-pass=global-sched -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s

# When the pull-up leaves a single instruction of a bundle, its reads of
# registers defined in the former bundle are no longer internal, except the
# predicate that a compound compare-and-jump defines and reads itself.
# The IR must have multiple blocks: the scheduler skips single-block IR functions.
# Fill the destination packet so the survivor cannot simply join it afterward.
# The scheduler separates the call argument producer and removes the independent
# move from the compound jump's packet.

# CHECK-LABEL: name: call_collapse
# CHECK: $r0 = A2_tfrt $p0, $r18
# CHECK: bb.1:
# CHECK-NOT: BUNDLE
# CHECK: J2_call @callee, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit $r29, implicit $r0, implicit-def $r29, implicit-def $r0
# CHECK-NOT: BUNDLE
# CHECK: bb.2:

# CHECK-LABEL: name: compound_collapse
# CHECK: BUNDLE {{.*}}implicit-def $r8
# CHECK: $r26 = A2_tfrsi 15
# CHECK-NEXT: $r8 = A2_tfrsi 42
# CHECK-NEXT: }
# CHECK-NEXT: J4_cmpeqi_tp0_jump_nt {{(killed )?}}$r2, 0, %bb.2, implicit-def $p0, implicit-def $pc, implicit internal {{(killed )?}}$p0

# CHECK-LABEL: name: debug_collapse
# CHECK: BUNDLE {{.*}}implicit-def $r8
# CHECK: $r26 = A2_tfrsi 15
# CHECK-NEXT: $r8 = A2_tfrsi 42
# CHECK-NEXT: }
# CHECK-NEXT: DBG_VALUE $r2, $noreg,
# CHECK-NEXT: J4_cmpeqi_tp0_jump_nt {{(killed )?}}$r2, 0, %bb.2, implicit-def $p0, implicit-def $pc, implicit internal {{(killed )?}}$p0

--- |
  declare void @callee(i32)
  define void @call_collapse(i1 %p) {
  entry:
    br i1 %p, label %call, label %exit
  call:
    br label %exit
  exit:
    ret void
  }
  define void @compound_collapse(i1 %p) {
  entry:
    br i1 %p, label %next, label %exit
  next:
    br label %exit
  exit:
    ret void
  }
  define void @debug_collapse(i1 %p) !dbg !5 {
  entry:
    br i1 %p, label %next, label %exit
  next:
    br label %exit
  exit:
    ret void
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "collapse.c", directory: "/")
  !2 = !DISubroutineType(types: !3)
  !3 = !{}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "debug_collapse", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
  !6 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !7 = !DILocalVariable(name: "value", scope: !5, file: !1, line: 1, type: !6)
  !8 = !DILocation(line: 1, scope: !5)
...
---
name: call_collapse
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r29, $r31, $r18, $p0
    BUNDLE implicit-def $r24, implicit-def $r25, implicit-def $r26 {
      $r24 = A2_tfrsi 13
      $r25 = A2_tfrsi 14
      $r26 = A2_tfrsi 15
    }
    J2_jumpf $p0, %bb.2, implicit-def $pc
  bb.1:
    successors: %bb.2
    liveins: $r29, $r31, $r18
    BUNDLE implicit-def $r0, implicit-def $pc, implicit-def $r31, implicit-def $r29, implicit $r18, implicit $r29 {
      $r0 = A2_tfr $r18
      J2_call @callee, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit $r29, implicit internal $r0, implicit-def $r29, implicit-def $r0
    }
    J2_jump %bb.2, implicit-def $pc
  bb.2:
    liveins: $r31
    PS_jmpret $r31, implicit-def $pc
...
---
name: compound_collapse
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r31
    BUNDLE implicit-def $r24, implicit-def $r25, implicit-def $r26 {
      $r24 = A2_tfrsi 13
      $r25 = A2_tfrsi 14
      $r26 = A2_tfrsi 15
    }
    BUNDLE implicit-def $r8, implicit-def $p0, implicit-def $pc, implicit $r2 {
      $r8 = A2_tfrsi 42
      J4_cmpeqi_tp0_jump_nt $r2, 0, %bb.2, implicit-def $p0, implicit-def $pc, implicit internal $p0
    }
  bb.1:
    successors: %bb.2
    J2_jump %bb.2, implicit-def $pc
  bb.2:
    liveins: $r31
    PS_jmpret $r31, implicit-def $pc
...
---
name: debug_collapse
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r2, $r31
    BUNDLE implicit-def $r24, implicit-def $r25, implicit-def $r26 {
      $r24 = A2_tfrsi 13
      $r25 = A2_tfrsi 14
      $r26 = A2_tfrsi 15
    }
    BUNDLE implicit-def $r8, implicit-def $p0, implicit-def $pc, implicit $r2 {
      $r8 = A2_tfrsi 42
      DBG_VALUE $r2, $noreg, !7, !DIExpression(), debug-location !8
      J4_cmpeqi_tp0_jump_nt $r2, 0, %bb.2, implicit-def $p0, implicit-def $pc, implicit internal $p0
    }
  bb.1:
    successors: %bb.2
    J2_jump %bb.2, implicit-def $pc
  bb.2:
    liveins: $r31
    PS_jmpret $r31, implicit-def $pc
...
