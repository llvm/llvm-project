# RUN: llc -run-pass global-schedV2 %s -o /dev/null
# REQUIRES: asserts

# Test that the global scheduler V2 doesn't assert because the DBG_LABEL
# instruction isn't handled properly.

--- |
  target datalayout = "e-m:e-p:32:32:32-a:0-n16:32-i64:64:64-i32:32:32-i16:16:16-i1:8:8-f32:32:32-f64:64:64-v32:32:32-v64:64:64-v512:512:512-v1024:1024:1024-v2048:2048:2048"
  target triple = "hexagon"

  @.str = external dso_local unnamed_addr constant [51 x i8], align 1

  ; Function Attrs: nounwind readnone speculatable
  declare void @llvm.dbg.label(metadata)

  define dso_local void @test() local_unnamed_addr {
  entry:
    call void @f1()
    call void @llvm.dbg.label(metadata !5), !dbg !10
    br i1 poison, label %if.end.i49, label %sw.epilog

  if.end.i49:
    %0 = call i32 asm sideeffect "1:$0 = sub($0,$2);", "=&r,r,r,~{memory},~{p3}"(ptr nonnull poison, i32 1)
    ret void

  sw.epilog:
    call void (ptr, ...) @f2(ptr getelementptr inbounds ([51 x i8], [51 x i8]* @.str, i32 0, i32 0), ptr poison, ptr nonnull poison, i32 poison)
    unreachable
  }

  declare dso_local void @f2(ptr, ...) local_unnamed_addr
  declare dso_local void @f1() local_unnamed_addr
  declare void @llvm.stackprotector(ptr, ptr)

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C89, file: !1, producer: "Clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2, retainedTypes: !2, globals: !2, debugInfoForProfiling: true, nameTableKind: None)
  !1 = !DIFile(filename: "file.c", directory: "/tmp")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = !{i32 1, !"wchar_size", i32 4}
  !5 = !DILabel(scope: !6, name: "label", file: !1, line: 1)
  !6 = distinct !DISubprogram(name: "mount_block_root", scope: !1, file: !1, line: 381, type: !7, scopeLine: 382, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !7 = !DISubroutineType(types: !8)
  !8 = !{null, !9}
  !9 = !DIBasicType(name: "unsigned int", size: 32, encoding: DW_ATE_unsigned)
  !10 = !DILocation(line: 1, column: 1, scope: !6)

...
---
name:            test
body:             |
  bb.0.entry:
    successors: %bb.1(0x7fffffff), %bb.2(0x00000001)

    frame-setup BUNDLE implicit-def $r29, implicit-def $r30, implicit-def $pc, implicit-def $r31, implicit killed $r29, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31, debug-location !10 {
      $r29 = frame-setup S2_allocframe killed $r29, 16, implicit-def $r30, implicit killed $framekey, implicit killed $framelimit, implicit $r30, implicit killed $r31 :: (store 4 into stack)
      J2_call @f1, hexagoncsr, implicit-def $pc, implicit-def $r31, implicit internal $r29, implicit-def $r29
      DBG_LABEL !5, debug-location !10
    }
    J2_jumpt killed undef renamable $p0, %bb.2, implicit-def dead $pc

  bb.1.if.end.i49:
    renamable $r2 = A2_tfrsi 1
    INLINEASM &"1:$0 = sub($0,$2);", 25, 327691, def early-clobber renamable $r3, 327689, undef renamable $r2, 327689, killed renamable $r2, 12, implicit-def early-clobber $p3
    $d15 = L4_return killed $r30, implicit-def $pc, implicit-def $r29, implicit killed $framekey, implicit-def $pc

  bb.2.sw.epilog:
    BUNDLE implicit-def $r0, implicit-def $r29 {
      $r0 = A2_tfrsi @.str
      PS_call_nr @f2, hexagoncsr, implicit internal $r0, implicit-def $r29
    }

...
