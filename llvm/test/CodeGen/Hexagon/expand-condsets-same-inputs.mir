# RUN: llc -mtriple=hexagon -run-pass expand-condsets -expand-condsets-coa-limit=0 -o - %s | FileCheck %s

# CHECK-LABEL: name: fred

--- |
  define void @fred() { ret void }

...
---

name: fred

body: |
  bb.0:
    liveins: $r0, $r1, $r2, $p0
        %0:predregs = COPY $p0
        %0 = COPY $p0   ; Cheat: convince MIR parser that this is not SSA.
        %1:intregs = COPY $r1
        ; Make sure we do not expand/predicate a mux with identical inputs.
        ; CHECK-NOT: A2_paddit
        %2:intregs = A2_addi %1, 1
        %3:intregs = C2_mux %0, %2, %2
        $r0 = COPY %3

...

