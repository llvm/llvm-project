# RUN: llc -march=hexagon -mcpu=hexagonv79 -mattr=+hvx-length128b,+hvxv79 -run-pass global-schedV2 \
# RUN: -disable-hvx-sched-superblock=false %s -o - | FileCheck %s \
# RUN: --check-prefix=CHECK0
# RUN: llc -march=hexagon -mcpu=hexagonv79 -mattr=+hvx-length128b,+hvxv79 -run-pass global-schedV2 \
# RUN: -disable-hvx-sched-superblock=true %s -o - | FileCheck %s \
# RUN: --check-prefix=CHECK1
# RUN: llc -march=hexagon -mcpu=hexagonv79 -mattr=+hvx-length128b,+hvxv79 -run-pass global-schedV2 %s -o - | FileCheck %s \
# RUN: --check-prefix=CHECK-DEFAULT
#
# With HVX scheduling for superblocks enabled (default), "$v0 = V6_vassign $v1"
# is pulled up into the preceding .cur load packet, verifying the plain HVX
# load is rewritten to its .cur form. With it explicitly disabled, HVX local
# pullup does not run and the vassign stays in its own packet. CHECK-DEFAULT
# runs with no flag to guard the on-by-default behaviour: it must match the
# enabled case.
#
# CHECK0: V6_vL32b_cur_pi
# CHECK0: $v0 = V6_vassign $v1
# CHECK0-NEXT: }
#
# CHECK1: BUNDLE
# CHECK1: $v6 = V6_vassign $v4
# CHECK1-NEXT: $v0 = V6_vassign $v1
# CHECK1-NEXT: }
#
# CHECK-DEFAULT: V6_vL32b_cur_pi
# CHECK-DEFAULT: $v0 = V6_vassign $v1
# CHECK-DEFAULT-NEXT: }

--- |
  ; ModuleID = 'test.cpp'
  source_filename = "test.cpp"
  target datalayout = "e-m:e-p:32:32:32-a:0-n16:32-i64:64:64-i32:32:32-i16:16:16-i1:8:8-f32:32:32-f64:64:64-v32:32:32-v64:64:64-v512:512:512-v1024:1024:1024-v2048:2048:2048"
  target triple = "hexagon-unknown-unknown-elf"

  $f1 = comdat any

  $f3 = comdat any

  ; Function Attrs: mustprogress
  define dso_local noundef ptr @f0(ptr noundef %params) local_unnamed_addr {
  entry:
    %call = tail call noundef ptr @f1(ptr noundef %params)
    ret ptr %call
  }

  ; Function Attrs: mustprogress
  define linkonce_odr dso_local noundef ptr @f1(ptr noundef %params) local_unnamed_addr comdat {
  entry:
    %0 = load ptr, ptr %params, align 4, !tbaa !7
    %1 = load i32, ptr %0, align 4, !tbaa !12
    %cgep = getelementptr inbounds i8, ptr %0, i32 8
    %2 = load i32, ptr %cgep, align 4, !tbaa !16
    %mul.i = mul nsw i32 %2, %1
    %cmp = icmp eq i32 %mul.i, 1
    br i1 %cmp, label %if.then, label %cleanup

  if.then:                                          ; preds = %entry
    %cgep3 = getelementptr inbounds i8, ptr %params, i32 4
    %3 = load ptr, ptr %cgep3, align 4, !tbaa !17
    %cgep4 = getelementptr inbounds i8, ptr %3, i32 12
    %4 = load i32, ptr %cgep4, align 4, !tbaa !18
    %cmp.i.i = icmp eq i32 %4, 8
    %spec.select.i = select i1 %cmp.i.i, ptr @f3, ptr null
    br label %cleanup

  cleanup:                                          ; preds = %entry, %if.then
    %retval.0 = phi ptr [ %spec.select.i, %if.then ], [ null, %entry ]
    ret ptr %retval.0
  }

  ; Function Attrs: mustprogress
  define dso_local noundef i32 @f2(ptr noundef %params, i32 noundef %start, i32 noundef %end) local_unnamed_addr {
  entry:
    %call = tail call noundef ptr @f1(ptr noundef %params)
    ret i32 0
  }

  ; Function Attrs: mustprogress
  define linkonce_odr dso_local void @f3(ptr noundef %plane_desc_in, ptr noundef %layout_in_ptr, ptr noundef %filt_x, i32 noundef %comp_stride) comdat {
  entry:
    %0 = load i32, ptr %plane_desc_in, align 4, !tbaa !12
    %sub = add i32 %0, 127
    %div17 = lshr i32 %sub, 7
    %sub5 = add nsw i32 %div17, -1
    %cmp647 = icmp ugt i32 %sub, 255
    br i1 %cmp647, label %for.body8.lr.ph, label %for.cond.cleanup7

  for.body8.lr.ph:                                  ; preds = %entry
    %layout_in.sroa.0.0.copyload = load ptr, ptr %layout_in_ptr, align 4
    %1 = ptrtoint ptr %layout_in.sroa.0.0.copyload to i32
    %and.i = and i32 %1, -128
    %2 = inttoptr i32 %and.i to ptr
    %3 = load <32 x i32>, ptr %2, align 128, !tbaa !20
    %4 = add i32 %comp_stride, 128
    %cgep = getelementptr i8, ptr %filt_x, i32 %4
    %cgep63 = getelementptr i8, ptr %filt_x, i32 128
    %cgep64 = getelementptr i8, ptr %2, i32 256
    br label %for.body8

  for.cond.cleanup7:                                ; preds = %for.body8, %entry
    ret void

  for.body8:                                        ; preds = %for.body8.lr.ph, %for.body8
    %lsr.iv60 = phi ptr [ %cgep64, %for.body8.lr.ph ], [ %cgep70, %for.body8 ]
    %lsr.iv58 = phi i32 [ %sub5, %for.body8.lr.ph ], [ %lsr.iv.next, %for.body8 ]
    %lsr.iv55 = phi ptr [ %cgep63, %for.body8.lr.ph ], [ %cgep69, %for.body8 ]
    %lsr.iv = phi ptr [ %cgep, %for.body8.lr.ph ], [ %cgep68, %for.body8 ]
    %.lcssa4449 = phi <32 x i32> [ %3, %for.body8.lr.ph ], [ %6, %for.body8 ]
    %cgep67 = getelementptr i8, ptr %lsr.iv60, i32 -128
    %5 = load <32 x i32>, ptr %cgep67, align 128, !tbaa !20
    %6 = load <32 x i32>, ptr %lsr.iv60, align 128, !tbaa !20
    %7 = tail call <64 x i32> @llvm.hexagon.V6.vdealvdd.128B(<32 x i32> %5, <32 x i32> %.lcssa4449, i32 -1)
    %8 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %7)
    %9 = tail call <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32> %7)
    %10 = tail call <64 x i32> @llvm.hexagon.V6.vdealvdd.128B(<32 x i32> %5, <32 x i32> %6, i32 -1)
    %11 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %10)
    %12 = tail call <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32> %10)
    %13 = tail call <64 x i32> @llvm.hexagon.V6.vmpyub.128B(<32 x i32> %8, i32 0)
    %14 = tail call <64 x i32> @llvm.hexagon.V6.vcombine.128B(<32 x i32> %11, <32 x i32> %8)
    %15 = tail call <64 x i32> @llvm.hexagon.V6.vdmpybus.dv.128B(<64 x i32> %14, i32 0)
    %16 = tail call <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32> %13)
    %17 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %13)
    %18 = tail call <64 x i32> @llvm.hexagon.V6.vshuffvdd.128B(<32 x i32> %16, <32 x i32> %17, i32 -2)
    %19 = tail call <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32> %15)
    %20 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %15)
    %21 = tail call <64 x i32> @llvm.hexagon.V6.vshuffvdd.128B(<32 x i32> %19, <32 x i32> %20, i32 -2)
    %22 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %18)
    %cgep66 = getelementptr i8, ptr %lsr.iv55, i32 -128
    store <32 x i32> %22, ptr %cgep66, align 128, !tbaa !20
    %23 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %21)
    store <32 x i32> %23, ptr %lsr.iv55, align 128, !tbaa !20
    %24 = tail call <64 x i32> @llvm.hexagon.V6.vmpyub.128B(<32 x i32> %9, i32 0)
    %25 = tail call <64 x i32> @llvm.hexagon.V6.vcombine.128B(<32 x i32> %12, <32 x i32> %9)
    %26 = tail call <64 x i32> @llvm.hexagon.V6.vdmpybus.dv.128B(<64 x i32> %25, i32 0)
    %27 = tail call <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32> %24)
    %28 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %24)
    %29 = tail call <64 x i32> @llvm.hexagon.V6.vshuffvdd.128B(<32 x i32> %27, <32 x i32> %28, i32 -2)
    %30 = tail call <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32> %26)
    %31 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %26)
    %32 = tail call <64 x i32> @llvm.hexagon.V6.vshuffvdd.128B(<32 x i32> %30, <32 x i32> %31, i32 -2)
    %33 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %29)
    %cgep65 = getelementptr i8, ptr %lsr.iv, i32 -128
    store <32 x i32> %33, ptr %cgep65, align 128, !tbaa !20
    %34 = tail call <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32> %32)
    store <32 x i32> %34, ptr %lsr.iv, align 128, !tbaa !20
    %lsr.iv.next = add nsw i32 %lsr.iv58, -1
    %exitcond.not = icmp eq i32 %lsr.iv.next, 0
    %cgep68 = getelementptr i8, ptr %lsr.iv, i32 256
    %cgep69 = getelementptr i8, ptr %lsr.iv55, i32 256
    %cgep70 = getelementptr i8, ptr %lsr.iv60, i32 256
    br i1 %exitcond.not, label %for.cond.cleanup7, label %for.body8, !llvm.loop !21
  }

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.hexagon.V6.vdealvdd.128B(<32 x i32>, <32 x i32>, i32)

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <32 x i32> @llvm.hexagon.V6.lo.128B(<64 x i32>)

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <32 x i32> @llvm.hexagon.V6.hi.128B(<64 x i32>)

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.hexagon.V6.vmpyub.128B(<32 x i32>, i32)

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.hexagon.V6.vcombine.128B(<32 x i32>, <32 x i32>)

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.hexagon.V6.vdmpybus.dv.128B(<64 x i32>, i32)

  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(none)
  declare <64 x i32> @llvm.hexagon.V6.vshuffvdd.128B(<32 x i32>, <32 x i32>, i32)

  !llvm.module.flags = !{!0, !1, !2}
  !llvm.ident = !{!6}

  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 7, !"frame-pointer", i32 2}
  !2 = !{i32 5, !"CG MDInfo", !3}
  !3 = !{!4, !5}
  !4 = !{!"F", !"no_filename_available", !"", !"", i1 false, !""}
  !5 = !{!"C", !"f3", !"(void)", !"(ptr, ptr, i32)", i1 true, !""}
  !6 = !{!"clang"}
  !7 = !{!8, !9, i64 0}
  !8 = !{!"s0", !9, i64 0, !9, i64 4, !9, i64 8, !9, i64 12}
  !9 = !{!"any pointer", !10, i64 0}
  !10 = !{!"omnipotent char", !11, i64 0}
  !11 = !{!"Simple C++ TBAA"}
  !12 = !{!13, !14, i64 0}
  !13 = !{!"s1", !14, i64 0, !14, i64 4, !15, i64 8, !14, i64 16, !14, i64 20}
  !14 = !{!"long", !10, i64 0}
  !15 = !{!"s2", !14, i64 0, !14, i64 4}
  !16 = !{!13, !14, i64 8}
  !17 = !{!8, !9, i64 4}
  !18 = !{!19, !14, i64 12}
  !19 = !{!"s3", !10, i64 0, !14, i64 8, !14, i64 12, !14, i64 16}
  !20 = !{!10, !10, i64 0}
  !21 = distinct !{!21, !22}
  !22 = !{!"llvm.loop.mustprogress"}

...
---
name:            f0
alignment:       16
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
hasWinCFI:       false
callsEHReturn:   false
callsUnwindInit: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: true
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     true
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $r0

    J2_jump @f1, hexagoncsr, implicit $r0, implicit-def $pc

...
---
name:            f1
alignment:       16
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
hasWinCFI:       false
callsEHReturn:   false
callsUnwindInit: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: true
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$r0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r0

    BUNDLE implicit-def $r3, implicit-def $r2, implicit-def $r0, implicit killed $r0 {
      renamable $r3 = L2_loadri_io $r0, 0 :: (load (s32) from %ir.params, !tbaa !7)
      $r2 = A2_tfr killed $r0
      renamable $r0 = A2_tfrsi 0
    }
    BUNDLE implicit-def $r4, implicit-def $r3, implicit killed $r3 {
      renamable $r4 = L2_loadri_io renamable $r3, 0 :: (load (s32) from %ir.0, !tbaa !12)
      renamable $r3 = L2_loadri_io killed renamable $r3, 8 :: (load (s32) from %ir.cgep, !tbaa !16)
    }
    BUNDLE implicit-def dead $r3, implicit-def $pc, implicit killed $r3, implicit killed $r4 {
      renamable $r3 = nsw M2_mpyi killed renamable $r3, killed renamable $r4
      J4_cmpeqi_f_jumpnv_t internal killed $r3, 1, %bb.2, implicit-def $pc
    }

  bb.1.if.then:
    successors: %bb.2(0x80000000)
    liveins: $r2

    renamable $r2 = L2_loadri_io killed renamable $r2, 4 :: (load (s32) from %ir.cgep3, !tbaa !17)
    renamable $r2 = L2_loadri_io killed renamable $r2, 12 :: (load (s32) from %ir.cgep4, !tbaa !18)
    renamable $p0 = C2_cmpeqi killed renamable $r2, 8
    $r0 = C2_muxii killed $p0, @f3, 0

  bb.2.cleanup:
    liveins: $r0

    PS_jmpret killed $r31, implicit-def $pc, implicit killed $r0

...
