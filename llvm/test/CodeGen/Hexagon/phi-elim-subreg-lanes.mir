  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:intregs = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:intregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:doubleregs = REG_SEQUENCE [[COPY3]], %subreg.isub_lo, [[COPY2]], %subreg.isub_hi
  ; CHECK-NEXT:   [[A2_vaddw:%[0-9]+]]:doubleregs = A2_vaddw [[REG_SEQUENCE]], [[A2_combineii]]
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_hi
  ; CHECK-NEXT:   J4_cmpeqi_t_jumpnv_t [[A2_vaddw]].isub_hi, 0, %bb.1, implicit-def $pc
  ; CHECK-NEXT:   J2_jump %bb.2, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc
  bb.0:
    successors: %bb.1

    %0:intregs = A2_tfrsi 0
    %1:intregs = A2_tfrsi 1
    %2:doubleregs = A2_combineii 4, 4
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.1, %bb.2

    %3:intregs = PHI %0, %bb.0, %6.isub_lo, %bb.1
    %4:intregs = PHI %1, %bb.0, %6.isub_hi, %bb.1
    %5:doubleregs = REG_SEQUENCE %3, %subreg.isub_lo, %4, %subreg.isub_hi
    %6:doubleregs = A2_vaddw %5, %2
    J4_cmpeqi_t_jumpnv_t %6.isub_hi, 0, %bb.1, implicit-def $pc
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    PS_jmpret $r31, implicit-def dead $pc
...

# A PHI reads the whole register before another reads one subregister, so
# the lane not read by the last copy dies at the whole register copy.
---
name:            whole_reg_phi_lowered_before_subreg_phi
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: whole_reg_phi_lowered_before_subreg_phi
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_combineii:%[0-9]+]]:doubleregs = A2_combineii 4, 4
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:doubleregs = COPY [[A2_combineii]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_tfrsi]]
  ; CHECK-NEXT:   J2_jump %bb.1, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:intregs = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:doubleregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:doubleregs = REG_SEQUENCE [[COPY2]], %subreg.isub_lo, [[COPY2]], %subreg.isub_hi
  ; CHECK-NEXT:   [[A2_vaddw:%[0-9]+]]:doubleregs = A2_vaddw [[COPY3]], [[REG_SEQUENCE]]
  ; CHECK-NEXT:   [[C2_cmpeqi:%[0-9]+]]:predregs = C2_cmpeqi [[COPY2]], 0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:doubleregs = COPY [[A2_vaddw]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   J2_jumpt [[C2_cmpeqi]], %bb.1, implicit-def dead $pc
  ; CHECK-NEXT:   J2_jump %bb.2, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc
  bb.0:
    successors: %bb.1

    %0:intregs = A2_tfrsi 0
    %2:doubleregs = A2_combineii 4, 4
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.1, %bb.2

    %4:doubleregs = PHI %2, %bb.0, %6, %bb.1
    %3:intregs = PHI %0, %bb.0, %6.isub_lo, %bb.1
    %5:doubleregs = REG_SEQUENCE %3, %subreg.isub_lo, %3, %subreg.isub_hi
    %6:doubleregs = A2_vaddw %4, %5
    %7:predregs = C2_cmpeqi %3, 0
    J2_jumpt %7, %bb.1, implicit-def dead $pc
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    PS_jmpret $r31, implicit-def dead $pc
...

# Two PHIs read the same lane, which dies at the later of the two copies.
---
name:            two_phis_read_same_subreg
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: two_phis_read_same_subreg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_tfrsi1:%[0-9]+]]:intregs = A2_tfrsi 1
  ; CHECK-NEXT:   [[A2_combineii:%[0-9]+]]:doubleregs = A2_combineii 4, 4
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_tfrsi]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_tfrsi]]
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:intregs = COPY [[A2_tfrsi1]]
  ; CHECK-NEXT:   J2_jump %bb.1, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:intregs = COPY [[COPY2]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:intregs = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:intregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:doubleregs = REG_SEQUENCE [[COPY5]], %subreg.isub_lo, [[COPY3]], %subreg.isub_hi
  ; CHECK-NEXT:   [[A2_vaddw:%[0-9]+]]:doubleregs = A2_vaddw [[REG_SEQUENCE]], [[A2_combineii]]
  ; CHECK-NEXT:   [[C2_cmpeqi:%[0-9]+]]:predregs = C2_cmpeqi [[COPY4]], 0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_hi
  ; CHECK-NEXT:   J2_jumpt [[C2_cmpeqi]], %bb.1, implicit-def dead $pc
  ; CHECK-NEXT:   J2_jump %bb.2, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc
  bb.0:
    successors: %bb.1

    %0:intregs = A2_tfrsi 0
    %1:intregs = A2_tfrsi 1
    %2:doubleregs = A2_combineii 4, 4
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.1, %bb.2

    %3:intregs = PHI %0, %bb.0, %6.isub_lo, %bb.1
    %4:intregs = PHI %0, %bb.0, %6.isub_lo, %bb.1
    %8:intregs = PHI %1, %bb.0, %6.isub_hi, %bb.1
    %5:doubleregs = REG_SEQUENCE %3, %subreg.isub_lo, %8, %subreg.isub_hi
    %6:doubleregs = A2_vaddw %5, %2
    %7:predregs = C2_cmpeqi %4, 0
    J2_jumpt %7, %bb.1, implicit-def dead $pc
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    PS_jmpret $r31, implicit-def dead $pc
...

# The second of two identical PHIs reuses the first copy, so it does not
# add a later read of the lane.
---
name:            identical_phis_reuse_one_copy
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: identical_phis_reuse_one_copy
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_combineii:%[0-9]+]]:doubleregs = A2_combineii 4, 4
  ; CHECK-NEXT:   [[A2_vaddw:%[0-9]+]]:doubleregs = A2_vaddw [[A2_combineii]], [[A2_combineii]]
  ; CHECK-NEXT:   [[C2_cmpeqi:%[0-9]+]]:predregs = C2_cmpeqi [[A2_tfrsi]], 0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_hi
  ; CHECK-NEXT:   J2_jumpt [[C2_cmpeqi]], %bb.2, implicit-def dead $pc
  ; CHECK-NEXT:   J2_jump %bb.1, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi1:%[0-9]+]]:intregs = A2_tfrsi 7
  ; CHECK-NEXT:   [[C2_cmpeqi1:%[0-9]+]]:predregs = C2_cmpeqi [[A2_tfrsi1]], 0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_tfrsi1]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_tfrsi1]]
  ; CHECK-NEXT:   J2_jumpt [[C2_cmpeqi1]], %bb.2, implicit-def dead $pc
  ; CHECK-NEXT:   J2_jump %bb.3, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:intregs = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:intregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:intregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[A2_add:%[0-9]+]]:intregs = A2_add [[COPY4]], [[COPY3]]
  ; CHECK-NEXT:   dead [[A2_add1:%[0-9]+]]:intregs = A2_add [[A2_add]], [[COPY2]]
  ; CHECK-NEXT:   J2_jump %bb.3, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc
  bb.0:
    successors: %bb.1, %bb.3

    %0:intregs = A2_tfrsi 0
    %2:doubleregs = A2_combineii 4, 4
    %6:doubleregs = A2_vaddw %2, %2
    %7:predregs = C2_cmpeqi %0, 0
    J2_jumpt %7, %bb.1, implicit-def dead $pc
    J2_jump %bb.3, implicit-def dead $pc

  bb.3:
    successors: %bb.1, %bb.2

    %10:intregs = A2_tfrsi 7
    %11:predregs = C2_cmpeqi %10, 0
    J2_jumpt %11, %bb.1, implicit-def dead $pc
    J2_jump %bb.2, implicit-def dead $pc

  bb.1:
    successors: %bb.2

    %3:intregs = PHI %6.isub_lo, %bb.0, %10, %bb.3
    %4:intregs = PHI %6.isub_lo, %bb.0, %10, %bb.3
    %5:intregs = PHI %6.isub_hi, %bb.0, %10, %bb.3
    %12:intregs = A2_add %3, %4
    %13:intregs = A2_add %12, %5
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    PS_jmpret $r31, implicit-def dead $pc
...
