  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_tfrsi1:%[0-9]+]]:intregs = A2_tfrsi 1
  ; CHECK-NEXT:   [[A2_combineii:%[0-9]+]]:doubleregs = A2_combineii 4, 4
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_tfrsi]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_tfrsi1]]
  ; CHECK-NEXT:   J2_jump %bb.1, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
