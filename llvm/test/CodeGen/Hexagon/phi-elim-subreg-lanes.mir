# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=hexagon -passes='require<live-intervals>,phi-node-elimination' -o - %s | FileCheck %s

# Two PHIs read different subregisters of a value defined in the same
# block, so each lane dies at its own last read.
---
name:            two_phis_read_different_subregs
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: two_phis_read_different_subregs
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_tfrsi1:%[0-9]+]]:intregs = A2_tfrsi 1
  ; CHECK-NEXT:   [[A2_combineii:%[0-9]+]]:doubleregs = A2_combineii 4, 4
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_tfrsi]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_tfrsi1]]
  ; CHECK-NEXT:   J2_jump %bb.1, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:intregs = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:intregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:doubleregs = REG_SEQUENCE [[COPY3]], %subreg.isub_lo, [[COPY2]], %subreg.isub_hi
  ; CHECK-NEXT:   [[A2_vaddw:%[0-9]+]]:doubleregs = A2_vaddw [[REG_SEQUENCE]], [[A2_combineii]]
  ; CHECK-NEXT:   [[C2_cmpeqi:%[0-9]+]]:predregs = C2_cmpeqi [[COPY3]], 0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_hi
  ; CHECK-NEXT:   J2_jumpt [[C2_cmpeqi]], %bb.1, implicit-def dead $pc
  ; CHECK-NEXT:   J2_jump %bb.2, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc
  bb.0:
    successors: %bb.1

    %0:intregs = A2_tfrsi 0
    %1:intregs = A2_tfrsi 1
    %2:doubleregs = A2_combineii 4, 4
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.1, %bb.2

    %3:intregs = PHI %0, %bb.0, %6.isub_lo, %bb.1
    %4:intregs = PHI %1, %bb.0, %6.isub_hi, %bb.1
    %5:doubleregs = REG_SEQUENCE %3, %subreg.isub_lo, %4, %subreg.isub_hi
    %6:doubleregs = A2_vaddw %5, %2
    %7:predregs = C2_cmpeqi %3, 0
    J2_jumpt %7, %bb.1, implicit-def dead $pc
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    PS_jmpret $r31, implicit-def dead $pc
...

# The terminator reads a lane no PHI reads, so that lane already dies
# there and must not be trimmed again.
---
name:            terminator_reads_lane_no_phi_reads
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: terminator_reads_lane_no_phi_reads
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[A2_tfrsi:%[0-9]+]]:intregs = A2_tfrsi 0
  ; CHECK-NEXT:   [[A2_combineii:%[0-9]+]]:doubleregs = A2_combineii 4, 4
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_tfrsi]]
  ; CHECK-NEXT:   J2_jump %bb.1, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:intregs = COPY [[COPY]]
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:doubleregs = REG_SEQUENCE [[COPY1]], %subreg.isub_lo, [[COPY1]], %subreg.isub_hi
  ; CHECK-NEXT:   [[A2_vaddw:%[0-9]+]]:doubleregs = A2_vaddw [[REG_SEQUENCE]], [[A2_combineii]]
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:intregs = COPY [[A2_vaddw]].isub_lo
  ; CHECK-NEXT:   J4_cmpeqi_t_jumpnv_t [[A2_vaddw]].isub_hi, 0, %bb.1, implicit-def $pc
  ; CHECK-NEXT:   J2_jump %bb.2, implicit-def dead $pc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PS_jmpret $r31, implicit-def dead $pc
  bb.0:
    successors: %bb.1

    %0:intregs = A2_tfrsi 0
    %2:doubleregs = A2_combineii 4, 4
    J2_jump %bb.1, implicit-def dead $pc

  bb.1:
    successors: %bb.1, %bb.2

    %3:intregs = PHI %0, %bb.0, %6.isub_lo, %bb.1
    %5:doubleregs = REG_SEQUENCE %3, %subreg.isub_lo, %3, %subreg.isub_hi
    %6:doubleregs = A2_vaddw %5, %2
    J4_cmpeqi_t_jumpnv_t %6.isub_hi, 0, %bb.1, implicit-def $pc
    J2_jump %bb.2, implicit-def dead $pc

  bb.2:
    PS_jmpret $r31, implicit-def dead $pc
...

# The terminator reads a lane a PHI also reads, so that lane dies at the
# terminator and the other at its copy.
---
name:            terminator_reads_phi_read_lane
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: terminator_reads_phi_read_lane
  ; CHECK: bb.0:
