# RUN: llc -mtriple=hexagon -mcpu=hexagonv79 -run-pass=global-sched \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# The combine in bb.2 is predicated on the branch in bb.1, whose predicate is
# defined in bb.1. It must not be pulled further into bb.0, where it would
# read p0 before the S2_tstbit_i that defines it.

# CHECK-LABEL: name: pred_def_in_prev
# CHECK:     bb.0.entry:
# CHECK-NOT: C2_ccombinew
# CHECK:     $p0 = S2_tstbit_i $r17, 0
# CHECK:     bb.1.test:
# CHECK:     $d4 = C2_ccombinewf $p0, $r7, $r6

--- |
  define void @pred_def_in_prev(i32 %a, i1 %c) {
  entry:
    br label %test
  test:
    br i1 %c, label %other, label %fall
  fall:
    br label %exit
  other:
    br label %exit
  exit:
    ret void
  }
...
---
name: pred_def_in_prev
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    liveins: $r0, $r6, $r7, $r17, $r31
    $r0 = A2_addi $r0, 1
  bb.1.test:
    successors: %bb.3, %bb.2
    liveins: $r0, $r6, $r7, $r17, $r31
    BUNDLE implicit-def dead $p0, implicit-def $pc, implicit $r17 {
      $p0 = S2_tstbit_i $r17, 0
      J2_jumptnewpt internal killed $p0, %bb.3, implicit-def $pc
    }
  bb.2.fall:
    successors: %bb.4
    liveins: $r0, $r6, $r7, $r31
    $d4 = A2_combinew $r7, $r6
    J2_jump %bb.4, implicit-def $pc
  bb.3.other:
    successors: %bb.4
    liveins: $r0, $r31
    $r1 = A2_tfrsi 0
  bb.4.exit:
    liveins: $r31
    PS_jmpret $r31, implicit-def $pc
...
