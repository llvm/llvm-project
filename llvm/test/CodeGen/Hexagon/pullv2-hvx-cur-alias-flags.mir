# CHECK-LABEL: name: companion_live_low
# CHECK: BUNDLE implicit-def $v0, implicit-def $r0, implicit-def $w4, implicit killed $r0, implicit $w0, implicit killed $w1 :: (load (s1024)) {
# CHECK-NEXT: $v0, $r0 = V6_vL32b_cur_pi killed $r0, 128
# CHECK-NEXT: $w4 = V6_vaddw_dv internal $w0, killed $w1
# CHECK-NEXT: }
# CHECK: PS_jmpret killed $r31, implicit-def $pc, implicit killed $w4, implicit killed $v1
---
name: companion_live_low
body: |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r31, $v1, $w1
    $v0, $r0 = V6_vL32b_pi $r0, 128 :: (load (s1024))
    $w4 = V6_vaddw_dv $w0, $w1
    J2_jump %bb.1, implicit-def $pc
  bb.1:
    liveins: $r31, $w4, $v1
    PS_jmpret $r31, implicit-def $pc, implicit $w4, implicit $v1
...

# CHECK-LABEL: name: companion_live_high
