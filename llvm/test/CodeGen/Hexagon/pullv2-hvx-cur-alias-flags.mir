body: |
  bb.0:
    successors: %bb.1
    liveins: $r0, $r31, $v0, $w1
    $v1, $r0 = V6_vL32b_pi $r0, 128 :: (load (s1024))
    $w4 = V6_vaddw_dv $w0, $w1
    J2_jump %bb.1, implicit-def $pc
  bb.1:
    liveins: $r31, $w4, $v0
    PS_jmpret $r31, implicit-def $pc, implicit $w4, implicit $v0
...
