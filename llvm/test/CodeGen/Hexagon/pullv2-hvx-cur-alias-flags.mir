# CHECK-NEXT: $v1, $r0 = V6_vL32b_cur_pi killed $r0, 128
# CHECK-NEXT: $w4 = V6_vaddw_dv internal $w0, killed $w1
# CHECK-NEXT: }
# CHECK: PS_jmpret killed $r31, implicit-def $pc, implicit killed $w4, implicit killed $v0
---
