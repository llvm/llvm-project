# RUN: llc -mtriple=hexagon-unknown-elf \
# RUN:   -mattr=+hvxv79,+hvx-length128b,+hvx-qfloat \
# RUN:   -run-pass=hexagon-xqfloat-generator \
# RUN:   -hexagon-qfloat-mode=strict-ieee -enable-xqf-gen=true \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @dbg_value_list_use() !dbg !3 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "xqf-debug-use.mir", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "dbg_value_list_use", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !6)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !{!7}
  !7 = !DILocalVariable(name: "x", scope: !3, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !3)
...
---
name:            dbg_value_list_use
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $v0, $v1, $v2

    ; A debug use must not cause a V6_vconv_sf_qf32 to be inserted.
    ; CHECK-LABEL: name: dbg_value_list_use
    ; CHECK: [[ADD:%[0-9]+]]:hvxvr = V6_vadd_qf32_mix
    ; CHECK-NEXT: DBG_VALUE_LIST !{{[0-9]+}}, !DIExpression(DW_OP_LLVM_arg, 0), [[ADD]]
    %0:hvxvr = COPY $v0
    %1:hvxvr = COPY $v1
    %2:hvxvr = COPY $v2
    %3:hvxvr = V6_vadd_qf32 %0, %2
    DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0), %3, debug-location !9
    %4:hvxvr = V6_vmpy_qf32 %1, %3
    $v0 = COPY %4
    PS_jmpret $r31, implicit-def dead $pc, implicit $v0
...
