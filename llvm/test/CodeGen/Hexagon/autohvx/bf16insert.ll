; RUN: llc -mtriple=hexagon < %s | FileCheck %s

; bf16 is soft promoted while v64bf16 is a legal HVX type on v81, so
; INSERT_VECTOR_ELT is legalized with a soft promoted element operand. Pass the
; vector by value: a load feeding a store to the same address is rewritten to a
; scalar store before the insert is legalized.

define <64 x bfloat> @insert_bf16_var(<64 x bfloat> %v, bfloat %a, i32 %i) #0 {
; CHECK-LABEL: insert_bf16_var:
; CHECK:       // %bb.0:
; CHECK-NEXT:    {
; CHECK-NEXT:     r1 = and(##-4,asl(r1,#1))
; CHECK-NEXT:     r3 = #16
; CHECK-NEXT:     r2 = and(r1,#1)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     r2 = asl(r2,#4)
; CHECK-NEXT:     v31 = vror(v0,r1)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     r4 = vextract(v0,r1)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     r4 = insert(r0,r3:2)
; CHECK-NEXT:     r2 = sub(#128,r1)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     v31.w = vinsert(r4)
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:     v0 = vror(v31,r2)
; CHECK-NEXT:     jumpr r31
; CHECK-NEXT:    }
  %r = insertelement <64 x bfloat> %v, bfloat %a, i32 %i
  ret <64 x bfloat> %r
}

