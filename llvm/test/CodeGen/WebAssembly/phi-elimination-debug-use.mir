# RUN: llc -exception-model=wasm -run-pass=liveintervals,phi-node-elimination \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -exception-model=wasm -passes='require<live-intervals>,phi-node-elimination' \
# RUN:   -verify-each %s -o - | FileCheck %s

# The copy for an EH successor is inserted before the debug instructions.
# Debug uses must not be treated as the last read when trimming the source
# interval. Two adjacent debug instructions used to assert in SlotIndexes;
# one caused the following branch to be used as the interval endpoint.

--- |
  target triple = "wasm32-unknown-unknown"
  declare i32 @__gxx_wasm_personality_v0()
  define i32 @two_debug() personality ptr @__gxx_wasm_personality_v0 !dbg !3 {
    ret i32 0
  }
  define i32 @single_debug() personality ptr @__gxx_wasm_personality_v0 !dbg !8 {
    ret i32 0
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "two_debug", scope: !1, file: !1, line: 1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !DILocalVariable(name: "v", scope: !3, file: !1, line: 1)
  !7 = !DILocation(line: 1, column: 1, scope: !3)
  !8 = distinct !DISubprogram(name: "single_debug", scope: !1, file: !1, line: 1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
  !9 = !DILocalVariable(name: "v", scope: !8, file: !1, line: 1)
  !10 = !DILocation(line: 1, column: 1, scope: !8)
...
---
name: two_debug
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: two_debug
  ; CHECK: bb.1:
  ; CHECK: [[INCOMING:%[0-9]+]]:i32 = COPY [[SRC:%[0-9]+]]
  ; CHECK-NEXT: DBG_VALUE [[SRC]], $noreg,
  ; CHECK-NEXT: DBG_VALUE $noreg, $noreg,
  ; CHECK-NEXT: BR %bb.2,
  ; CHECK: bb.2 (landing-pad):
  ; CHECK-NEXT: [[DEST:%[0-9]+]]:i32 = COPY [[INCOMING]]
  ; CHECK-NEXT: RETURN [[DEST]],
  bb.0:
    successors: %bb.1, %bb.2
    %0:i32 = CONST_I32 0, implicit-def dead $arguments
    %1:i32 = CONST_I32 1, implicit-def dead $arguments
    BR_UNLESS %bb.2, %0, implicit-def dead $arguments
    BR %bb.1, implicit-def dead $arguments

  bb.1:
    successors: %bb.2
    DBG_VALUE %0, $noreg, !6, !DIExpression(), debug-location !7
    DBG_VALUE $noreg, $noreg, !6, !DIExpression(), debug-location !7
    BR %bb.2, implicit-def dead $arguments

  bb.2 (landing-pad):
    %2:i32 = PHI %0, %bb.1, %1, %bb.0
    RETURN %2, implicit-def dead $arguments
...
---
name: single_debug
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: single_debug
  ; CHECK: bb.1:
  ; CHECK: [[INCOMING:%[0-9]+]]:i32 = COPY [[SRC:%[0-9]+]]
  ; CHECK-NEXT: DBG_VALUE [[SRC]], $noreg,
  ; CHECK-NEXT: BR %bb.2,
  ; CHECK: bb.2 (landing-pad):
  ; CHECK-NEXT: [[DEST:%[0-9]+]]:i32 = COPY [[INCOMING]]
  ; CHECK-NEXT: RETURN [[DEST]],
  bb.0:
    successors: %bb.1, %bb.2
    %0:i32 = CONST_I32 0, implicit-def dead $arguments
    %1:i32 = CONST_I32 1, implicit-def dead $arguments
    BR_UNLESS %bb.2, %0, implicit-def dead $arguments
    BR %bb.1, implicit-def dead $arguments

  bb.1:
    successors: %bb.2
    DBG_VALUE %0, $noreg, !9, !DIExpression(), debug-location !10
    BR %bb.2, implicit-def dead $arguments

  bb.2 (landing-pad):
    %2:i32 = PHI %0, %bb.1, %1, %bb.0
    RETURN %2, implicit-def dead $arguments
...
