define i64 @select_i32_sgt(ptr %p) {
; CHECK-LABEL: select_i32_sgt:
; CHECK:         .functype select_i32_sgt (i32) -> (i64)
; CHECK-NEXT:    .local i64
; CHECK-NEXT:  # %bb.0:
; CHECK-NEXT:    local.get 0
; CHECK-NEXT:    i64.load32_s 0
; CHECK-NEXT:    local.tee 1
; CHECK-NEXT:    i64.const 7
; CHECK-NEXT:    local.get 1
; CHECK-NEXT:    i64.const 95
; CHECK-NEXT:    i64.gt_s
; CHECK-NEXT:    i64.select
; CHECK-NEXT:    # fallthrough-return
  %op = load i32, ptr %p, align 4
  %cmp = icmp sgt i32 %op, 95
