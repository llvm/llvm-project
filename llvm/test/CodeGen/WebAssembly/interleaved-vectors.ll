  %arrayidx = getelementptr inbounds nuw [4 x i8], ptr %b, i32 %i.010
  %11 = load float, ptr %arrayidx, align 4
  %arrayidx1 = getelementptr inbounds nuw [4 x i8], ptr %c, i32 %i.010
