  %wide.load12 = load <4 x float>, ptr %2, align 4
  %wide.load13 = load <4 x float>, ptr %3, align 4
  %4 = getelementptr inbounds nuw [4 x i8], ptr %d, i32 %index
  %5 = getelementptr inbounds nuw i8, ptr %4, i32 16
  %wide.load14 = load <4 x float>, ptr %4, align 4
  %wide.load15 = load <4 x float>, ptr %5, align 4
  %6 = tail call <4 x float> @llvm.fmuladd.v4f32(<4 x float> %wide.load, <4 x float> %wide.load12, <4 x float> %wide.load14)
  %7 = tail call <4 x float> @llvm.fmuladd.v4f32(<4 x float> %wide.load11, <4 x float> %wide.load13, <4 x float> %wide.load15)
