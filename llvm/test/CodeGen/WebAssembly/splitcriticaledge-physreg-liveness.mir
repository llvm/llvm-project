# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=wasm32-unknown-unknown \
# RUN:     -run-pass=liveintervals,phi-node-elimination \
# RUN:     -precompute-phys-liveness -verify-machineinstrs %s -o - | FileCheck %s

# Splitting the critical edge bb.0 -> bb.2 rewrites terminators that
# def the ARGUMENTS physreg. Its regunit ranges must be recomputed.

---
name:            split_physreg_terminator
tracksRegLiveness: true
liveins:
  - { reg: '$arguments' }
body: |
  ; CHECK-LABEL: name: split_physreg_terminator
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $arguments
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ARGUMENT_i32_:%[0-9]+]]:i32 = ARGUMENT_i32 0, implicit $arguments
  ; CHECK-NEXT:   [[CONST_I32_:%[0-9]+]]:i32 = CONST_I32 -1, implicit-def dead $arguments
  ; CHECK-NEXT:   [[GT_S_I32_:%[0-9]+]]:i32 = GT_S_I32 [[ARGUMENT_i32_]], [[CONST_I32_]], implicit-def dead $arguments
  ; CHECK-NEXT:   BR_UNLESS %bb.1, [[GT_S_I32_]], implicit-def $arguments
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:i32 = COPY [[ARGUMENT_i32_]]
  ; CHECK-NEXT:   BR %bb.2, implicit-def $arguments
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[CONST_I32_1:%[0-9]+]]:i32 = CONST_I32 3, implicit-def dead $arguments
  ; CHECK-NEXT:   [[DIV_S_I32_:%[0-9]+]]:i32 = DIV_S_I32 [[ARGUMENT_i32_]], [[CONST_I32_1]], implicit-def dead $arguments
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:i32 = COPY [[DIV_S_I32_]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:i32 = COPY [[COPY]]
  ; CHECK-NEXT:   RETURN [[COPY1]], implicit-def dead $arguments
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $arguments

    %0:i32 = ARGUMENT_i32 0, implicit killed $arguments
    %1:i32 = CONST_I32 -1, implicit-def dead $arguments
    %2:i32 = GT_S_I32 %0, killed %1, implicit-def dead $arguments
    BR_IF %bb.2, killed %2, implicit-def dead $arguments
    BR %bb.1, implicit-def dead $arguments

  bb.1:
    successors: %bb.2

    %3:i32 = CONST_I32 3, implicit-def dead $arguments
    %4:i32 = DIV_S_I32 killed %0, killed %3, implicit-def dead $arguments

  bb.2:
    %5:i32 = PHI %0, %bb.0, %4, %bb.1
    RETURN killed %5, implicit-def dead $arguments
...
