; Test that a select of reference types is the typed select instruction, as
; the untyped one only takes numeric and vector types.

target triple = "wasm32-unknown-unknown"

; OBJ: 1c 01 6f select externref
; OBJ: 1c 01 70 select funcref

define target("wasm.externref") @select_externref(i1 zeroext %a, target("wasm.externref") %b, target("wasm.externref") %c) {
; CHECK-LABEL: select_externref:
; CHECK:         .functype select_externref (i32, externref, externref) -> (externref)
; CHECK-NEXT:  # %bb.0:
; CHECK-NEXT:    local.get 1
; CHECK-NEXT:    local.get 2
; CHECK-NEXT:    local.get 0
; CHECK-NEXT:    select externref
; CHECK-NEXT:    # fallthrough-return
  %cond = select i1 %a, target("wasm.externref") %b, target("wasm.externref") %c
  ret target("wasm.externref") %cond
}

define target("wasm.externref") @select_externref_eq(i32 %a, target("wasm.externref") %b, target("wasm.externref") %c) {
; CHECK-LABEL: select_externref_eq:
; CHECK:         .functype select_externref_eq (i32, externref, externref) -> (externref)
; CHECK-NEXT:  # %bb.0:
; CHECK-NEXT:    local.get 2
; CHECK-NEXT:    local.get 1
; CHECK-NEXT:    local.get 0
; CHECK-NEXT:    select externref
; CHECK-NEXT:    # fallthrough-return
  %cmp = icmp eq i32 %a, 0
  %cond = select i1 %cmp, target("wasm.externref") %b, target("wasm.externref") %c
  ret target("wasm.externref") %cond
}

