; RUN: llc < %s -O0 --global-isel -disable-wasm-fallthrough-return-opt -wasm-keep-registers | FileCheck %s

target triple = "wasm32-unknown-unknown"

define i8 @brcond(i1 %cond) {
; CHECK-LABEL: brcond:
; CHECK:         .functype brcond (i32) -> (i32)
; CHECK-NEXT:    .local i32, i32
; CHECK-NEXT:  # %bb.0: # %entry
; CHECK-NEXT:    i32.const $push2=, 0
; CHECK-NEXT:    local.set 1, $pop2
; CHECK-NEXT:    i32.const $push3=, -1
; CHECK-NEXT:    local.set 2, $pop3
; CHECK-NEXT:    block
; CHECK-NEXT:    local.get $push4=, 0
; CHECK-NEXT:    i32.const $push1=, 1
; CHECK-NEXT:    i32.and $push0=, $pop4, $pop1
; CHECK-NEXT:    i32.eqz $push7=, $pop0
; CHECK-NEXT:    br_if 0, $pop7 # 0: down to label0
; CHECK-NEXT:  # %bb.1: # %truePath
; CHECK-NEXT:    local.get $push5=, 2
; CHECK-NEXT:    return $pop5
; CHECK-NEXT:  .LBB0_2: # %falsePath
; CHECK-NEXT:    end_block # label0:
; CHECK-NEXT:    local.get $push6=, 1
; CHECK-NEXT:    return $pop6
entry:
  br i1 %cond, label %truePath, label %falsePath

truePath:
  ret i8 255

falsePath:
  ret i8 0
}
