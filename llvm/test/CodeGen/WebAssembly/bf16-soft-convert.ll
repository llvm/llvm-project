define float @load_bf16_ext(ptr %p) {
; WASM32-LABEL: load_bf16_ext:
; WASM32:         .functype load_bf16_ext (i32) -> (f32)
; WASM32-NEXT:  # %bb.0:
; WASM32-NEXT:    local.get 0
; WASM32-NEXT:    i32.load16_u 0
; WASM32-NEXT:    i32.const 16
; WASM32-NEXT:    i32.shl
; WASM32-NEXT:    f32.reinterpret_i32
; WASM32-NEXT:    # fallthrough-return
;
; WASM64-LABEL: load_bf16_ext:
; WASM64:         .functype load_bf16_ext (i64) -> (f32)
; WASM64-NEXT:  # %bb.0:
; WASM64-NEXT:    local.get 0
