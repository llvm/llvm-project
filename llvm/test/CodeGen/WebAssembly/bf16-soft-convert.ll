; WASM64-NEXT:    i32.const 16
; WASM64-NEXT:    i32.shl
; WASM64-NEXT:    f32.reinterpret_i32
; WASM64-NEXT:    # fallthrough-return
  %v = load bfloat, ptr %p
  %r = fpext bfloat %v to float
