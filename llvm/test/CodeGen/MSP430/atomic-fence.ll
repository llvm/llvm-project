; There is only one core, so a fence of any kind has no instruction, and only
; keeps the memory accesses around it in place.

define void @fences(ptr %p) {
; CHECK-LABEL: fences:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    mov #1, 0(r12)
; CHECK-NEXT:    mov #2, 0(r12)
; CHECK-NEXT:    mov #3, 0(r12)
; CHECK-NEXT:    mov #4, 0(r12)
; CHECK-NEXT:    mov #5, 0(r12)
; CHECK-NEXT:    mov #6, 0(r12)
; CHECK-NEXT:    ret
  store volatile i16 1, ptr %p
  fence acquire
  store volatile i16 2, ptr %p
  fence release
  store volatile i16 3, ptr %p
  fence acq_rel
  store volatile i16 4, ptr %p
  fence seq_cst
  store volatile i16 5, ptr %p
  fence syncscope("singlethread") seq_cst
  store volatile i16 6, ptr %p
  ret void
}
