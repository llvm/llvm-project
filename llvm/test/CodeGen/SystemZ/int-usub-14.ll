define i128 @sube_1(i128 %a, i128 %b, i128 %c) {
; CHECK-LABEL: sube_1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vl %v0, 0(%r5), 3
; CHECK-NEXT:    vl %v1, 0(%r4), 3
