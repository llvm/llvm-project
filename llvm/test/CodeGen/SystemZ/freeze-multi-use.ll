; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=s390x-linux-gnu < %s | FileCheck %s

; Every use of a frozen value must observe the same value.

; The stored value and the branch must agree, so the compare can't reuse the
; condition code of the add, which may overflow.
define i32 @nsw_other_block(ptr %px, ptr %py, ptr %out, i1 %p) nounwind {
; CHECK-LABEL: nsw_other_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    tmll %r5, 1
; CHECK-NEXT:    je .LBB0_2
; CHECK-NEXT:  # %bb.1: # %use
; CHECK-NEXT:    l %r0, 0(%r2)
; CHECK-NEXT:    a %r0, 0(%r3)
; CHECK-NEXT:    st %r0, 0(%r4)
; CHECK-NEXT:    jl .LBB0_3
; CHECK-NEXT:  .LBB0_2: # %other
; CHECK-NEXT:    lhi %r2, 0
; CHECK-NEXT:    br %r14
; CHECK-NEXT:  .LBB0_3: # %neg
; CHECK-NEXT:    lhi %r2, 1
; CHECK-NEXT:    br %r14
entry:
  %x = load i32, ptr %px
  %y = load i32, ptr %py
  %a = add nsw i32 %x, %y
  br i1 %p, label %use, label %other

use:
  %f = freeze i32 %a
  store i32 %f, ptr %out
  %c = icmp slt i32 %f, 0
  br i1 %c, label %neg, label %other

neg:
  ret i32 1

other:
  ret i32 0
}
