; Test that llvm.is.fpclass on vector and f128 types uses VFTCI*/WFTCIXB.
;
; RUN: llc < %s -mtriple=s390x-linux-gnu -mcpu=z13 | FileCheck %s --check-prefix=Z13
; RUN: llc < %s -mtriple=s390x-linux-gnu -mcpu=z14 | FileCheck %s --check-prefix=Z14

declare <2 x i1> @llvm.is.fpclass.v2f64(<2 x double>, i32)
declare <4 x i1> @llvm.is.fpclass.v4f32(<4 x float>, i32)
declare i1 @llvm.is.fpclass.f128(fp128, i32)

; <2 x double> isnan -- z13 and z14 both use vftcidb (available since z13).
define <2 x i1> @isnan_v2f64(<2 x double> %x) {
; Z13-LABEL: isnan_v2f64:
; Z13:       # %bb.0:
; Z13-NEXT:    vftcidb %v24, %v24, 15
; Z13-NEXT:    br %r14
;
; Z14-LABEL: isnan_v2f64:
; Z14:       # %bb.0:
; Z14-NEXT:    vftcidb %v24, %v24, 15
; Z14-NEXT:    br %r14
  %r = call <2 x i1> @llvm.is.fpclass.v2f64(<2 x double> %x, i32 3)  ; nan
  ret <2 x i1> %r
}

; <2 x double> isinf.
define <2 x i1> @isinf_v2f64(<2 x double> %x) {
; Z13-LABEL: isinf_v2f64:
; Z13:       # %bb.0:
; Z13-NEXT:    vftcidb %v24, %v24, 48
; Z13-NEXT:    br %r14
;
; Z14-LABEL: isinf_v2f64:
; Z14:       # %bb.0:
; Z14-NEXT:    vftcidb %v24, %v24, 48
; Z14-NEXT:    br %r14
  %r = call <2 x i1> @llvm.is.fpclass.v2f64(<2 x double> %x, i32 516)  ; inf
  ret <2 x i1> %r
}

; <4 x float> isnan -- requires VectorEnhancements1 (z14).
; On z13 the expansion falls back to multi-instruction sequences.
define <4 x i1> @isnan_v4f32(<4 x float> %x) {
; Z14-LABEL: isnan_v4f32:
; Z14:       # %bb.0:
; Z14-NEXT:    vftcisb %v24, %v24, 15
; Z14-NEXT:    br %r14
  %r = call <4 x i1> @llvm.is.fpclass.v4f32(<4 x float> %x, i32 3)  ; nan
  ret <4 x i1> %r
}

; <4 x float> isnormal.
define <4 x i1> @isnormal_v4f32(<4 x float> %x) {
; Z14-LABEL: isnormal_v4f32:
; Z14:       # %bb.0:
; Z14-NEXT:    vftcisb %v24, %v24, 768
; Z14-NEXT:    br %r14
  %r = call <4 x i1> @llvm.is.fpclass.v4f32(<4 x float> %x, i32 264)  ; normal
  ret <4 x i1> %r
}

; fp128 isnan -- z14 uses wftcixb (avoids vrepg + tcxb GroupAlone).
define i1 @isnan_f128(fp128 %x) {
; Z14-LABEL: isnan_f128:
; Z14:       # %bb.0:
; Z14-NEXT:    vl %v0, 0(%r2), 3
; Z14-NEXT:    wftcixb %v0, %v0, 15
; Z14-NEXT:    vlgvg %r0, %v0, 0
; Z14-NEXT:    srlg %r2, %r0, 63
; Z14-NEXT:    # kill: def $r2l killed $r2l killed $r2d
; Z14-NEXT:    br %r14
  %r = call i1 @llvm.is.fpclass.f128(fp128 %x, i32 3)  ; nan
  ret i1 %r
}

; fp128 isinf.
define i1 @isinf_f128(fp128 %x) {
; Z14-LABEL: isinf_f128:
; Z14:       # %bb.0:
; Z14-NEXT:    vl %v0, 0(%r2), 3
; Z14-NEXT:    wftcixb %v0, %v0, 48
