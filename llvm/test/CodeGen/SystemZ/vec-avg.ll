  %a.zext = zext <16 x i8> %a to <16 x i16>
  %b.zext = zext <16 x i8> %b to <16 x i16>
  %sum = add <16 x i16> %a.zext, %b.zext
  %sum1 = add <16 x i16> %sum, splat (i16 1)
  %avg = lshr <16 x i16> %sum1, splat (i16 1)
  %res = trunc <16 x i16> %avg to <16 x i8>
  ret <16 x i8> %res
}

