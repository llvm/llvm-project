; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=s390x-linux-gnu -verify-machineinstrs < %s | FileCheck %s

; An i128 output in an explicit register pair. Its value type is Untyped, which
; has no register class, so the indirect target has to read the pair in the
; pair's own class. Both paths store both halves.
define void @test_reg_pair_output(ptr %p, ptr %q) {
; CHECK-LABEL: test_reg_pair_output:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:  # %bb.1: # %ft
; CHECK-NEXT:    stg %r0, 0(%r2)
; CHECK-NEXT:    stg %r1, 8(%r2)
; CHECK-NEXT:    br %r14
; CHECK-NEXT:  .LBB0_2: # Inline asm indirect target
; CHECK-NEXT:    # %ind
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    stg %r1, 8(%r3)
; CHECK-NEXT:    stg %r0, 0(%r3)
; CHECK-NEXT:    br %r14
entry:
  %r = callbr i128 asm "", "={r0},!i"()
          to label %ft [label %ind]

ft:
  store i128 %r, ptr %p
  ret void

ind:
  store i128 %r, ptr %q
  ret void
}
