    ; Z196-NEXT: [[COPY5:%[0-9]+]]:grx32bit = COPY [[COPY1]]
    ; Z196-NEXT: [[COPY5:%[0-9]+]]:grx32bit = NIFMux [[COPY5]], 1, implicit-def $cc
    ; Z196-NEXT: [[COPY6:%[0-9]+]]:gr32bit = COPY [[COPY2]]
    ; Z196-NEXT: [[COPY6:%[0-9]+]]:gr32bit = LOCR [[COPY6]], [[COPY3]], 15, 8, implicit $cc
    ; Z196-NEXT: $r2l = COPY [[COPY5]]
    ; Z196-NEXT: $r3l = COPY [[COPY1]]
    ; Z196-NEXT: $r4l = COPY [[COPY6]]
