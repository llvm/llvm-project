    ; Z196-NEXT: [[COPY1:%[0-9]+]]:grx32bit = COPY $r3l
    ; Z196-NEXT: [[COPY2:%[0-9]+]]:gr32bit = COPY $r4l
    ; Z196-NEXT: [[COPY3:%[0-9]+]]:gr32bit = COPY $r5l
    ; Z196-NEXT: dead [[LOCGR:%[0-9]+]]:gr64bit = LOCGR undef [[LOCGR]], [[COPY]], 15, 8, implicit undef $cc
    ; Z196-NEXT: [[COPY4:%[0-9]+]]:gr64bit = COPY [[COPY]]
