    ; ZEC12-NEXT: [[COPY:%[0-9]+]]:gr64bit = COPY $r2d
    ; ZEC12-NEXT: [[COPY1:%[0-9]+]]:grx32bit = COPY $r3l
    ; ZEC12-NEXT: [[COPY2:%[0-9]+]]:gr32bit = COPY $r4l
    ; ZEC12-NEXT: [[COPY3:%[0-9]+]]:gr32bit = COPY $r5l
    ; ZEC12-NEXT: dead [[LOCGR:%[0-9]+]]:gr64bit = LOCGR undef [[LOCGR]], [[COPY]], 15, 8, implicit undef $cc
    ; ZEC12-NEXT: [[COPY4:%[0-9]+]]:gr64bit = COPY [[COPY]]
    ; ZEC12-NEXT: dead [[COPY4:%[0-9]+]]:gr64bit = LOCGR [[COPY4]], undef %5:gr64bit, 15, 8, implicit undef $cc
    ; ZEC12-NEXT: [[COPY5:%[0-9]+]]:grx32bit = COPY [[COPY1]]
    ; ZEC12-NEXT: [[COPY5:%[0-9]+]]:grx32bit = NIFMux [[COPY5]], 1, implicit-def $cc
    ; ZEC12-NEXT: [[COPY6:%[0-9]+]]:gr32bit = COPY [[COPY2]]
    ; ZEC12-NEXT: [[COPY6:%[0-9]+]]:gr32bit = LOCR [[COPY6]], [[COPY3]], 15, 8, implicit $cc
    ; ZEC12-NEXT: $r2l = COPY [[COPY5]]
    ; ZEC12-NEXT: $r3l = COPY [[COPY1]]
    ; ZEC12-NEXT: $r4l = COPY [[COPY6]]
    ; ZEC12-NEXT: Return implicit $r2l, implicit $r3l, implicit $r4l
    %0:gr64bit = COPY $r2d
    %1:grx32bit = COPY $r3l
    %2:gr32bit = COPY $r4l
    %3:gr32bit = COPY $r5l
    %4:gr64bit = LOCGR %0, undef %5:gr64bit, 15, 8, implicit undef $cc
    %6:gr64bit = LOCGR undef %5, %0, 15, 8, implicit undef $cc
    %7:grx32bit = NIFMux %1, 1, implicit-def $cc
    %8:gr32bit = LOCR %2, %3, 15, 8, implicit killed $cc
    $r2l = COPY %7
    $r3l = COPY %1
    $r4l = COPY %8
    Return implicit $r2l, implicit $r3l, implicit $r4l
