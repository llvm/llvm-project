# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=s390x-linux-gnu -mcpu=z196 -run-pass=liveintervals,twoaddressinstruction -o - %s | FileCheck -check-prefix=Z196 %s
# RUN: llc -mtriple=s390x-linux-gnu -mcpu=zEC12 -run-pass=liveintervals,twoaddressinstruction -o - %s | FileCheck -check-prefix=ZEC12 %s

# Converting an AND to RISBMux or RISBGN drops the dead CC def, so the CC
# live range must be updated.

---
name:            and_32
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r2d, $r3l

    ; Z196-LABEL: name: and_32
    ; Z196: liveins: $r2d, $r3l
    ; Z196-NEXT: {{  $}}
    ; Z196-NEXT: [[COPY:%[0-9]+]]:gr64bit = COPY $r2d
    ; Z196-NEXT: [[COPY1:%[0-9]+]]:grx32bit = COPY $r3l
    ; Z196-NEXT: dead [[LOCGR:%[0-9]+]]:gr64bit = LOCGR undef [[LOCGR]], [[COPY]], 15, 8, implicit undef $cc
    ; Z196-NEXT: [[COPY2:%[0-9]+]]:gr64bit = COPY [[COPY]]
    ; Z196-NEXT: dead [[COPY2:%[0-9]+]]:gr64bit = LOCGR [[COPY2]], undef %3:gr64bit, 15, 8, implicit undef $cc
    ; Z196-NEXT: [[RISBMux:%[0-9]+]]:grx32bit = RISBMux $noreg, [[COPY1]], 31, 159, 0
    ; Z196-NEXT: $r2l = COPY [[RISBMux]]
    ; Z196-NEXT: $r3l = COPY [[COPY1]]
    ; Z196-NEXT: Return implicit $r2l, implicit $r3l
    ;
    ; ZEC12-LABEL: name: and_32
    ; ZEC12: liveins: $r2d, $r3l
    ; ZEC12-NEXT: {{  $}}
    ; ZEC12-NEXT: [[COPY:%[0-9]+]]:gr64bit = COPY $r2d
    ; ZEC12-NEXT: [[COPY1:%[0-9]+]]:grx32bit = COPY $r3l
    ; ZEC12-NEXT: dead [[LOCGR:%[0-9]+]]:gr64bit = LOCGR undef [[LOCGR]], [[COPY]], 15, 8, implicit undef $cc
    ; ZEC12-NEXT: [[COPY2:%[0-9]+]]:gr64bit = COPY [[COPY]]
    ; ZEC12-NEXT: dead [[COPY2:%[0-9]+]]:gr64bit = LOCGR [[COPY2]], undef %3:gr64bit, 15, 8, implicit undef $cc
    ; ZEC12-NEXT: [[RISBMux:%[0-9]+]]:grx32bit = RISBMux $noreg, [[COPY1]], 31, 159, 0
    ; ZEC12-NEXT: $r2l = COPY [[RISBMux]]
    ; ZEC12-NEXT: $r3l = COPY [[COPY1]]
    ; ZEC12-NEXT: Return implicit $r2l, implicit $r3l
    %0:gr64bit = COPY $r2d
    %1:grx32bit = COPY $r3l
    %2:gr64bit = LOCGR %0, undef %3:gr64bit, 15, 8, implicit undef $cc
    %4:gr64bit = LOCGR undef %3, %0, 15, 8, implicit undef $cc
    %5:grx32bit = NIFMux %1, 1, implicit-def dead $cc
    $r2l = COPY %5
    $r3l = COPY %1
    Return implicit $r2l, implicit $r3l
...

---
name:            and_64
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r2d, $r3d

    ; Z196-LABEL: name: and_64
