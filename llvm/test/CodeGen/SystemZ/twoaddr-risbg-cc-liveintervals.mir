    ; Z196-NEXT: [[RISBG:%[0-9]+]]:gr64bit = RISBG $noreg, [[COPY1]], 63, 175, 0, implicit-def dead $cc
    ; Z196-NEXT: $r2d = COPY [[RISBG]]
