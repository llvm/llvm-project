    %4:gr64bit = LOCGR undef %3, %0, 15, 8, implicit undef $cc
    %5:gr64bit = NILL64 %1, 1, implicit-def dead $cc
    $r2d = COPY %5
    $r3d = COPY %1
    Return implicit $r2d, implicit $r3d
...

# Don't convert if CC is live out of the AND.
