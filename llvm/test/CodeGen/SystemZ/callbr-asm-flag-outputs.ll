; A condition code output that both paths out of an asm goto read. CC is live
; into the indirect target, which reads it again: the read after the asm
; doesn't run when the asm branches there.
define i32 @test_flag_output_on_both_paths() {
; CHECK-LABEL: test_flag_output_on_both_paths:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ipm %r2
; CHECK-NEXT:  # %bb.1: # %ft
; CHECK-NEXT:    srl %r2, 28
; CHECK-NEXT:    br %r14
; CHECK-NEXT:  .LBB0_2: # Inline asm indirect target
; CHECK-NEXT:    # %ind
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    ipm %r2
; CHECK-NEXT:    srl %r2, 28
; CHECK-NEXT:    ahi %r2, 7
; CHECK-NEXT:    br %r14
entry:
  %r = callbr i32 asm "", "={@cc},!i"()
          to label %ft [label %ind]

ft:
  ret i32 %r

ind:
  %s = add i32 %r, 7
  ret i32 %s
}
