; CHECK-NEXT:    rxsbg %r2, %r2, 32, 59, 4
; CHECK-NEXT:    # kill: def $r2l killed $r2l killed $r2d
; CHECK-NEXT:    br %r14
  %res = call i8 @llvm.clmul.i8(i8 %a, i8 -1)
  ret i8 %res
}

