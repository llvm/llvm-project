# RUN: not llc -mtriple=mipsel -mattr=mips16 -relocation-model=pic -run-pass none -o /dev/null %s 2>&1 | FileCheck %s
--- |
  define i32 @test(i32 %a) {
  entry:
    %call = call i32 @foo(i32 %a)
    ret i32 0
  }

  declare i32 @foo(i32)
...
---
name:            test
tracksRegLiveness: true
liveins:
  - { reg: '$r4' }
frameInfo:
  stackSize:       24
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 16
stack:
  - { id: 0, type: spill-slot, offset: -4, size: 4, alignment: 4,
      callee-saved-register: '$r31' }
body: |
  bb.0.entry:
    liveins: $r4, $r31

    Save16 $r31, 24, implicit-def $r29, implicit $r29
    $r2, $r3 = GotPrologue16 &_gp_disp, &_gp_disp
    $r2 = SllX16 killed $r2, 16
    $r2 = AdduRxRyRz16 killed $r3, killed $r2
  ; CHECK: [[@LINE+1]]:71: expected a global value or an external symbol after 'call-entry'
    $r3 = LwRxRyOffMemX16 $r2, @foo, 0 :: (load (s32) from call-entry foo)
    $r25 = COPY $r3
    $r28 = COPY killed $r2
    JumpLinkReg16 killed $r3, csr_o32, implicit-def $r31, implicit killed $r25, implicit $r4, implicit killed $r28, implicit-def $r29, implicit-def dead $r2
    $r2 = LiRxImmX16 0
    $r31 = Restore16 24, implicit-def $r29, implicit $r29
    RetRA16 implicit $r2
...
