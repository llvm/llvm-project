# RUN: llc -mtriple=mipsel -mattr=mips16 -relocation-model=pic -run-pass none -o - %s | FileCheck %s
# This test ensures that the MIR parser parses the call entry pseudo source
# values in memory operands correctly.

--- |
  define i32 @test(i32 %a) {
  entry:
    %call = call i32 @foo(i32 %a)
    ret i32 0
  }

  declare i32 @foo(i32)

  define float @test2() #0 {
  entry:
    %call = tail call float @g()
    call void @__mips16_ret_sf(float %call)
    ret float %call
  }

  declare float @g(...)

  declare void @__mips16_ret_sf(float) #1

  attributes #0 = { "saveS2" }
  attributes #1 = { noinline readnone "__Mips16RetHelper" }
...
---
name:            test
tracksRegLiveness: true
liveins:
  - { reg: '$r4' }
frameInfo:
  stackSize:       24
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 16
stack:
  - { id: 0, type: spill-slot, offset: -4, size: 4, alignment: 4,
      callee-saved-register: '$r31' }
body:             |
  bb.0.entry:
    liveins: $r4, $r31

    Save16 $r31, 24, implicit-def $r29, implicit $r29
    CFI_INSTRUCTION def_cfa_offset 24
    CFI_INSTRUCTION offset $r31_64, -4
    $r2, $r3 = GotPrologue16 &_gp_disp, &_gp_disp
    $r2 = SllX16 killed $r2, 16
    $r2 = AdduRxRyRz16 killed $r3, killed $r2
  ; CHECK-LABEL: name: test
  ; CHECK: $r3 = LwRxRyOffMemX16 $r2, @foo :: (load (s32) from call-entry @foo)
    $r3 = LwRxRyOffMemX16 $r2, @foo :: (load (s32) from call-entry @foo)
    $r25 = COPY $r3
    $r28 = COPY killed $r2
    JumpLinkReg16 killed $r3, csr_o32, implicit-def $r31, implicit killed $r25, implicit $r4, implicit killed $r28, implicit-def $r29, implicit-def dead $r2
    $r2 = LiRxImmX16 0
    $r31 = Restore16 24, implicit-def $r29, implicit $r29
    RetRA16 implicit $r2
...
---
name:            test2
tracksRegLiveness: true
frameInfo:
  stackSize:       32
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 16
stack:
  - { id: 0, type: spill-slot, offset: -4, size: 4, alignment: 4,
      callee-saved-register: '$r31' }
  - { id: 1, type: spill-slot, offset: -8, size: 4, alignment: 4,
      callee-saved-register: '$r18' }
  - { id: 2, type: spill-slot, offset: -12, size: 4, alignment: 4,
      callee-saved-register: '$r16' }
body:             |
  bb.0.entry:
    liveins: $r31, $r18, $r16, $r31, $r18, $r16

    SaveX16 $r16, $r31, $r18, 32, implicit-def $r29, implicit $r29
    CFI_INSTRUCTION def_cfa_offset 32
    CFI_INSTRUCTION offset $r31_64, -4
    CFI_INSTRUCTION offset $r18_64, -8
    CFI_INSTRUCTION offset $r16_64, -12
    $r2, $r3 = GotPrologue16 &_gp_disp, &_gp_disp
    $r2 = SllX16 killed $r2, 16
    $r16 = AdduRxRyRz16 killed $r3, killed $r2
    $r2 = LwRxRyOffMemX16 $r16, @g :: (load (s32) from call-entry @g)
  ; CHECK-LABEL: test2
  ; CHECK: $r3 = LwRxRyOffMemX16 $r16, &__mips16_call_stub_sf_0 :: (load (s32) from call-entry &__mips16_call_stub_sf_0)
    $r3 = LwRxRyOffMemX16 $r16, &__mips16_call_stub_sf_0 :: (load (s32) from call-entry &__mips16_call_stub_sf_0)
    $r28 = COPY $r16
    JumpLinkReg16 killed $r3, csr_o32, implicit-def $r31, implicit $r2, implicit killed $r28, implicit-def $r29, implicit-def $r2
    $r3 = LwRxRyOffMemX16 $r16, @__mips16_ret_sf :: (load (s32) from call-entry @__mips16_ret_sf)
    $r25 = COPY $r3
    $r28 = COPY killed $r16
    JumpLinkReg16 killed $r3, csr_mips16rethelper, implicit-def $r31, implicit killed $r25, implicit $r2, implicit killed $r28, implicit-def $r29
    $r16, $r31, $r18 = RestoreX16 32, implicit-def $r29, implicit $r29
    RetRA16 implicit $r2
...
