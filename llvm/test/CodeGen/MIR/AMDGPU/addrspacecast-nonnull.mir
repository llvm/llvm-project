# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu7.00-amd-amdhsa -run-pass=none -o - %s | FileCheck %s

# Check that the nonnull MIFlag on G_ADDRSPACE_CAST round-trips through the MIR
# printer and parser.

---
name: nonnull_addrspacecast
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nonnull_addrspacecast
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[INTTOPTR:%[0-9]+]]:_(p3) = G_INTTOPTR [[COPY]](s32)
    ; CHECK-NEXT: [[ADDRSPACE_CAST:%[0-9]+]]:_(p0) = nonnull G_ADDRSPACE_CAST [[INTTOPTR]](p3)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[ADDRSPACE_CAST]](p0)
    %0:_(s32) = COPY $vgpr0
    %1:_(p3) = G_INTTOPTR %0
    %2:_(p0) = nonnull G_ADDRSPACE_CAST %1
    $vgpr0_vgpr1 = COPY %2
...
