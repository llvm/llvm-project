# RUN: llc -mtriple=amdgpu9.00 -run-pass=none -verify-machineinstrs -o - %s | FileCheck %s
#
# Round-trip test for the 'bb-prolog' MIR text spelling of
# MachineInstr::BBProlog. PHIs, debug instructions and pseudo probes may precede
# or sit between block prolog instructions.

---
name: bb_prolog_roundtrip
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 $sgpr0_sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    S_ENDPGM 0, implicit %0
...

---
name: bb_prolog_prefix
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = COPY $sgpr0_sgpr1
    S_BRANCH %bb.1

  bb.1:
    %1:sreg_64 = PHI %0, %bb.0
    DBG_VALUE
    PSEUDO_PROBE 1, 1, 0, 0
    %2:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 %1, implicit-def $exec, implicit-def $scc, implicit $exec
    DBG_VALUE
    $exec = bb-prolog S_OR_B64 $exec, %2, implicit-def $scc
    S_ENDPGM 0
...

# CHECK-LABEL: name: bb_prolog_roundtrip
# CHECK: %0:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 $sgpr0_sgpr1

# CHECK-LABEL: name: bb_prolog_prefix
# CHECK: PSEUDO_PROBE 1, 1, 0, 0
# CHECK-NEXT: %2:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 %1
# CHECK-NEXT: DBG_VALUE
# CHECK-NEXT: $exec = bb-prolog S_OR_B64 $exec, %2
