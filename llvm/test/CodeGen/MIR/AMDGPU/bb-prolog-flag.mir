# RUN: llc -mtriple=amdgpu9.00 -run-pass=none -o - %s | FileCheck %s
#
# Round-trip test for the 'bb-prolog' MIR text spelling of
# MachineInstr::BBProlog.

---
name: bb_prolog_roundtrip
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 $sgpr0_sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    S_ENDPGM 0, implicit %0
...

# CHECK-LABEL: name: bb_prolog_roundtrip
# CHECK: %0:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 $sgpr0_sgpr1
