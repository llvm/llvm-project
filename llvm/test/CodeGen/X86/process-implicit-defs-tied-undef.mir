# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -run-pass=processimpdefs -verify-machineinstrs -o - %s | FileCheck %s

## The reads of %1 share a tied use, so they are not marked undef and %1 keeps
## a definition: the COPY, turned into an IMPLICIT_DEF and stripped of its
## operand.

---
name: tied_read_keeps_def
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_read_keeps_def
    ; CHECK: [[DEF:%[0-9]+]]:gr32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[IMUL32rr:%[0-9]+]]:gr32 = IMUL32rr [[DEF]], [[DEF]], implicit-def dead $eflags
    ; CHECK-NEXT: $eax = COPY [[IMUL32rr]]
    ; CHECK-NEXT: RET 0, $eax
    %0:gr64 = IMPLICIT_DEF
    %1:gr32 = COPY %0.sub_32bit
    %2:gr32 = IMUL32rr %1, %1, implicit-def dead $eflags
    $eax = COPY %2
    RET 0, $eax
...

## The PHI turned into a kept IMPLICIT_DEF moves out of the PHI block.
---
name: phi_keeps_def
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_keeps_def
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   TEST32rr $edi, $edi, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr32 = PHI [[MOV32ri]], %bb.0, [[MOV32ri1]], %bb.1
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[IMUL32rr:%[0-9]+]]:gr32 = IMUL32rr [[DEF]], [[DEF]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[IMUL32rr]], [[PHI]], implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[ADD32rr]]
  ; CHECK-NEXT:   RET 0, $eax
  bb.0:
    liveins: $edi
    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = MOV32ri 1
    TEST32rr $edi, $edi, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    %2:gr32 = IMPLICIT_DEF
    %3:gr32 = MOV32ri 2

  bb.2:
    %4:gr32 = PHI %0, %bb.0, %2, %bb.1
    %5:gr32 = PHI %1, %bb.0, %3, %bb.1
    %6:gr32 = IMUL32rr %4, %4, implicit-def dead $eflags
    %7:gr32 = ADD32rr %6, %5, implicit-def dead $eflags
    $eax = COPY %7
    RET 0, $eax
...
