; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs | FileCheck %s

; Tail-call arguments must not prevent register clearing at the ordinary return.
declare i64 @sink(i64, i64, i64, i64, i64, i64)

define i64 @return_and_tail(i1 %cond, i64 %a, i64 %b) "zero-call-used-regs"="used-gpr" {
; CHECK-LABEL: return_and_tail:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB0_1
; CHECK-NEXT:  # %bb.2: # %tail
; CHECK-NEXT:    movq %rdx, %rcx
; CHECK-NEXT:    movq %rsi, %rdx
; CHECK-NEXT:    movq %rsi, %rdi
; CHECK-NEXT:    movq %rcx, %rsi
; CHECK-NEXT:    movq %rdx, %r8
; CHECK-NEXT:    movq %rcx, %r9
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    jmp sink@PLT # TAILCALL
; CHECK-NEXT:  .LBB0_1: # %return
; CHECK-NEXT:    movl $42, %eax
; CHECK-NEXT:    xorl %ecx, %ecx
; CHECK-NEXT:    xorl %edi, %edi
; CHECK-NEXT:    xorl %edx, %edx
; CHECK-NEXT:    xorl %esi, %esi
; CHECK-NEXT:    xorl %r8d, %r8d
; CHECK-NEXT:    xorl %r9d, %r9d
; CHECK-NEXT:    retq
entry:
  br i1 %cond, label %tail, label %return

tail:
  %result = tail call i64 @sink(i64 %a, i64 %b, i64 %a, i64 %b, i64 %a, i64 %b)
  ret i64 %result

return:
  ret i64 42
}
