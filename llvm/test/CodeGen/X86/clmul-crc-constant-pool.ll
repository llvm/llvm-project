; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu -mcpu=westmere | FileCheck %s

; Regression test for https://github.com/llvm/llvm-project/issues/236085
;
; SCALAR_TO_VECTOR of a 64-bit constant used by llvm.clmul should fold into a
; vector constant, letting the constant-pool load fold directly into the
; pclmulqdq instruction. Before the fix, the backend emitted
;   movabsq $C, %rax
;   movq    %rax, %xmm1
; (GPR -> XMM round-trip) for each constant.

; CHECK-LABEL: crc64:
; CHECK-NOT:    movabsq
; CHECK:        pclmulqdq $0, .LCPI
; CHECK:        pclmulqdq $0, .LCPI

define i64 @crc64(i64 %data, i64 %crc) {
  %xor = xor i64 %data, %crc
  %clmul1 = call i64 @llvm.clmul.i64(i64 %xor, i64 -7188230525177732139)
  %zext = zext i64 %clmul1 to i128
  %clmul2 = call i128 @llvm.clmul.i128(i128 %zext, i128 29028144000371924613)
  %shr = lshr i128 %clmul2, 64
  %trunc = trunc i128 %shr to i64
  ret i64 %trunc
}

declare i64  @llvm.clmul.i64(i64, i64)
declare i128 @llvm.clmul.i128(i128, i128)