# RUN: llc -mtriple=x86_64-- -passes='require<live-intervals>,phi-node-elimination,print<live-intervals>' -filetype=null %s 2>&1 | FileCheck %s

# %bb.3 is the last block, and the edge to %bb.1 is split because %3 is
# also live out to %bb.2. %5 is live out of %bb.3 only to %bb.2, so it
# must not be live through the new block.

# CHECK: ********** INTERVALS **********
# CHECK: %5 [{{[0-9]+}}B,{{[0-9]+}}r:0)[{{[0-9]+}}r,[[SPLIT:[0-9]+]]B:0)
# CHECK: [[SPLIT]]B{{[[:space:]]+}}bb.4:

---
name: split_critical_edge_last_block
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32r0 implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    %2:gr32 = PHI %1, %bb.0, %3, %bb.3
    JMP_1 %bb.3

  bb.2:
    %4:gr32 = ADD32rr %3, %5, implicit-def dead $eflags
    $eax = COPY %4
    RET 0, $eax

  bb.3:
    %3:gr32 = ADD32ri %2, 1, implicit-def dead $eflags
    %5:gr32 = ADD32rr %3, %0, implicit-def dead $eflags
    CMP32rr %3, %0, implicit-def $eflags
    JCC_1 %bb.1, 2, implicit $eflags
    JMP_1 %bb.2
...
