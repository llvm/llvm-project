# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -passes=regallocfast -o - %s | FileCheck %s

# An implicit_def is never spilled, so a live out value with no use in
# the defining block has no reader at all.

---
name:            implicit_def_live_out_no_use
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: implicit_def_live_out_no_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead renamable $eax = IMPLICIT_DEF
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $eax = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %stack.0)
  ; CHECK-NEXT:   RET64 implicit killed $eax
  bb.0:
    %0:gr32 = IMPLICIT_DEF
    JMP_1 %bb.1

  bb.1:
    $eax = COPY %0
    RET64 implicit $eax
...

---
name:            implicit_def_live_out_with_use
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: implicit_def_live_out_with_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $eax = IMPLICIT_DEF
  ; CHECK-NEXT:   MOV32mr $rsp, 1, $noreg, 0, $noreg, renamable $eax
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $ecx = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %stack.0)
  ; CHECK-NEXT:   RET64 implicit killed $ecx
  bb.0:
    %0:gr32 = IMPLICIT_DEF
    MOV32mr $rsp, 1, $noreg, 0, $noreg, %0
    JMP_1 %bb.1

  bb.1:
    $ecx = COPY %0
    RET64 implicit $ecx
...
