; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=x86_64 < %s | FileCheck %s

; Reusing the extending load's register avoids a redundant 32-bit copy before
; the indexed memory operand, even when the value survives a call.
declare void @consume(i32)

define i64 @zext_i8(ptr %p, ptr %table, i1 %cold) nounwind {
; CHECK-LABEL: zext_i8:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movq %rsi, %rbx
; CHECK-NEXT:    movzbl (%rdi), %r14d
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB0_2
; CHECK-NEXT:  # %bb.1: # %call
; CHECK-NEXT:    movl %r14d, %edi
; CHECK-NEXT:    callq consume@PLT
; CHECK-NEXT:  .LBB0_2: # %join
; CHECK-NEXT:    addl (%rbx,%r14,4), %r14d
; CHECK-NEXT:    movq %r14, %rax
; CHECK-NEXT:    addq $8, %rsp
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    popq %r14
; CHECK-NEXT:    retq
entry:
  %v = load i8, ptr %p
  %v32 = zext i8 %v to i32
  br i1 %cold, label %call, label %join
call:
  call void @consume(i32 %v32)
  br label %join
join:
  %v64 = zext i8 %v to i64
  %ptr = getelementptr i32, ptr %table, i64 %v64
  %mask = load i32, ptr %ptr
  %sum = add i32 %mask, %v32
  %result = zext i32 %sum to i64
  ret i64 %result
}

; A non-extension use of the load prevents hoisting all its extensions.
; Reusing the existing extension must still avoid a copy for the index.
define i64 @zext_i8_with_nonext_use(ptr %p, ptr %table, i1 %cold) nounwind {
; CHECK-LABEL: zext_i8_with_nonext_use:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movq %rsi, %rbx
; CHECK-NEXT:    notb %dl
; CHECK-NEXT:    movzbl (%rdi), %r14d
; CHECK-NEXT:    testl %r14d, %r14d
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    orb %dl, %al
; CHECK-NEXT:    testb $1, %al
; CHECK-NEXT:    jne .LBB1_2
; CHECK-NEXT:  # %bb.1: # %call
; CHECK-NEXT:    movl %r14d, %edi
; CHECK-NEXT:    callq consume@PLT
; CHECK-NEXT:  .LBB1_2: # %join
; CHECK-NEXT:    addl (%rbx,%r14,4), %r14d
; CHECK-NEXT:    movq %r14, %rax
; CHECK-NEXT:    addq $8, %rsp
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    popq %r14
; CHECK-NEXT:    retq
entry:
  %v = load i8, ptr %p
  %nonzero = icmp ne i8 %v, 0
  %takecall = and i1 %cold, %nonzero
  %v32 = zext i8 %v to i32
  br i1 %takecall, label %call, label %join
call:
  call void @consume(i32 %v32)
  br label %join
join:
  %v64 = zext i8 %v to i64
  %ptr = getelementptr i32, ptr %table, i64 %v64
  %mask = load i32, ptr %ptr
  %sum = add i32 %mask, %v32
  %result = zext i32 %sum to i64
  ret i64 %result
}
