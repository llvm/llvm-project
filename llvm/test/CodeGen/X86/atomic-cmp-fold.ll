; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; Compares of atomic loads should fold the load into the compare's memory
; operand, like compares of regular loads do: the folded form still performs
; a single full-width load, and on x86 an ordinary load already provides
; every ordering up to seq_cst.

define i1 @cmp8_eq0_monotonic(ptr %p) {
; CHECK-LABEL: cmp8_eq0_monotonic:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movzbl (%rdi), %eax
; CHECK-NEXT:    testb %al, %al
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i8, ptr %p monotonic, align 1
  %c = icmp eq i8 %v, 0
  ret i1 %c
}

define i1 @cmp16_eq0_acquire(ptr %p) {
; CHECK-LABEL: cmp16_eq0_acquire:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movzwl (%rdi), %eax
; CHECK-NEXT:    testw %ax, %ax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i16, ptr %p acquire, align 2
  %c = icmp eq i16 %v, 0
  ret i1 %c
}

define i1 @cmp32_eq0_seq_cst(ptr %p) {
; CHECK-LABEL: cmp32_eq0_seq_cst:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    testl %eax, %eax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p seq_cst, align 4
  %c = icmp eq i32 %v, 0
  ret i1 %c
}

define i1 @cmp64_eq0_unordered(ptr %p) {
; CHECK-LABEL: cmp64_eq0_unordered:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cmpq $0, (%rdi)
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i64, ptr %p unordered, align 8
  %c = icmp eq i64 %v, 0
  ret i1 %c
}

define i1 @cmp32_imm_acquire(ptr %p) {
; CHECK-LABEL: cmp32_imm_acquire:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    cmpl $42, %eax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p acquire, align 4
  %c = icmp eq i32 %v, 42
  ret i1 %c
}

define i1 @cmp32_imm_large(ptr %p) {
; CHECK-LABEL: cmp32_imm_large:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    cmpl $305419896, %eax # imm = 0x12345678
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p monotonic, align 4
  %c = icmp eq i32 %v, 305419896 ; 0x12345678
  ret i1 %c
}

define i1 @cmp64_imm_sext32(ptr %p) {
; CHECK-LABEL: cmp64_imm_sext32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq (%rdi), %rax
; CHECK-NEXT:    cmpq $-100, %rax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i64, ptr %p monotonic, align 8
  %c = icmp eq i64 %v, -100
  ret i1 %c
}

; The immediate does not fit CMP64mi32, so the load stays in a register.
define i1 @cmp64_imm_too_wide(ptr %p) {
; CHECK-LABEL: cmp64_imm_too_wide:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq (%rdi), %rax
; CHECK-NEXT:    movabsq $4886718345, %rcx # imm = 0x123456789
; CHECK-NEXT:    cmpq %rcx, %rax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i64, ptr %p monotonic, align 8
  %c = icmp eq i64 %v, 4886718345 ; 0x123456789
  ret i1 %c
}

define i1 @cmp32_reg(ptr %p, i32 %x) {
; CHECK-LABEL: cmp32_reg:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    cmpl %esi, %eax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p acquire, align 4
  %c = icmp eq i32 %v, %x
  ret i1 %c
}

; The loaded value sits on the compare's RHS.
define i1 @cmp32_reg_rhs(ptr %p, i32 %x) {
; CHECK-LABEL: cmp32_reg_rhs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    cmpl %eax, %esi
; CHECK-NEXT:    setl %al
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p acquire, align 4
  %c = icmp slt i32 %x, %v
  ret i1 %c
}

; Relaxed load of a level, compare, branch (the log-level-check shape).
define i32 @cmp32_sge_branch(ptr %p, i32 %lvl) {
; CHECK-LABEL: cmp32_sge_branch:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    cmpl %esi, %eax
; CHECK-NEXT:    jl .LBB10_2
; CHECK-NEXT:  # %bb.1: # %log
; CHECK-NEXT:    movl $1, %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB10_2: # %skip
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p monotonic, align 4
  %c = icmp sge i32 %v, %lvl
  br i1 %c, label %log, label %skip
log:
  ret i32 1
skip:
  ret i32 0
}

define i1 @test32_mask_bit(ptr %p) {
; CHECK-LABEL: test32_mask_bit:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    andl $8, %eax
; CHECK-NEXT:    shrl $3, %eax
; CHECK-NEXT:    # kill: def $al killed $al killed $eax
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p monotonic, align 4
  %a = and i32 %v, 8
  %c = icmp ne i32 %a, 0
  ret i1 %c
}

; The mask fits neither i8 nor i16 and is not a shifted mask, so the
; masked compare cannot be narrowed and keeps its full width.
define i1 @test32_mask_wide(ptr %p) {
; CHECK-LABEL: test32_mask_wide:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    testl $65792, %eax # imm = 0x10100
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p monotonic, align 4
  %a = and i32 %v, 65792 ; 0x10100
  %c = icmp eq i32 %a, 0
  ret i1 %c
}

; The loaded value has a second use: the load must stay.
define i32 @no_fold_multiuse(ptr %p) {
; CHECK-LABEL: no_fold_multiuse:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %ecx
; CHECK-NEXT:    cmpl $7, %ecx
; CHECK-NEXT:    movl $100, %eax
; CHECK-NEXT:    cmovnel %ecx, %eax
; CHECK-NEXT:    retq
  %v = load atomic i32, ptr %p acquire, align 4
  %c = icmp eq i32 %v, 7
  %r = select i1 %c, i32 100, i32 %v
  ret i32 %r
}

; Two atomic loads: at most one side can fold.
define i1 @cmp_two_loads(ptr %p, ptr %q) {
; CHECK-LABEL: cmp_two_loads:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    movl (%rsi), %ecx
; CHECK-NEXT:    cmpl %ecx, %eax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %a = load atomic i32, ptr %p acquire, align 4
  %b = load atomic i32, ptr %q acquire, align 4
  %c = icmp eq i32 %a, %b
  ret i1 %c
}

; Volatile atomic load: folding keeps the single access, matching how
; compares of volatile non-atomic loads are handled.
define i1 @cmp32_volatile(ptr %p) {
; CHECK-LABEL: cmp32_volatile:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    testl %eax, %eax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %v = load atomic volatile i32, ptr %p acquire, align 4
  %c = icmp eq i32 %v, 0
  ret i1 %c
}
