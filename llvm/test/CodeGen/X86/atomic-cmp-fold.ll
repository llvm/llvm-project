; X64-LABEL: cmp8_eq0_monotonic:
; X64:       # %bb.0:
; X64-NEXT:    cmpb $0, (%rdi)
; X64-NEXT:    sete %al
; X64-NEXT:    retq
;
; X86-LABEL: cmp8_eq0_monotonic:
; X86:       # %bb.0:
; X86-NEXT:    movl {{[0-9]+}}(%esp), %eax
; X86-NEXT:    cmpb $0, (%eax)
; X86-NEXT:    sete %al
; X86-NEXT:    retl
