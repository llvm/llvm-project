# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=postra-machine-sink -o - %s | FileCheck %s

# PostRA MachineSink must place the sunk copy after the EH label. A DBG_PHI and
# DBG_VALUE that read the destination (including through a physical-register
# alias) must remain after the copy, while debug value updates keep their
# original order.

# CHECK-LABEL: name: postra_eh_label
# CHECK: bb.1:
# CHECK: EH_LABEL
# CHECK-NEXT: renamable $rax = COPY $rdi
# CHECK-NEXT: DBG_PHI $rax, 1
# CHECK-NEXT: DBG_VALUE $eax
# CHECK-NEXT: DBG_VALUE 1

--- |
  define i64 @postra_eh_label(i64 %x) !dbg !5 {
  entry:
      #dbg_value(i64 %x, !9, !DIExpression(), !11)
    ret i64 %x, !dbg !11
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "debugify", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "postra-machine-sink-eh-label-debug.mir", directory: "/")
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "postra_eh_label", scope: null, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !8)
  !6 = !DISubroutineType(types: !7)
  !7 = !{!10, !10}
  !8 = !{!9}
  !9 = !DILocalVariable(name: "x", arg: 1, scope: !5, file: !1, line: 1, type: !10)
  !10 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !11 = !DILocation(line: 1, column: 1, scope: !5)
...
---
name: postra_eh_label
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $rdi
    renamable $rax = COPY $rdi
    JMP_1 %bb.1

  bb.1:
    liveins: $rax
    DBG_PHI $rax, 1
    DBG_VALUE $eax, $noreg, !9, !DIExpression(), debug-location !11
    DBG_VALUE 1, $noreg, !9, !DIExpression(), debug-location !11
    EH_LABEL <mcsymbol .Ltmp0>
    RET64 killed $rax
...
