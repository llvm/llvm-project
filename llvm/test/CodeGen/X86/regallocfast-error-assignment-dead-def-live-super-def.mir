# RUN: not llc -mtriple=x86_64-- -run-pass=regallocfast -o - %s 2>%t.err | FileCheck %s
# RUN: FileCheck -check-prefix=ERR %s < %t.err

# Every register in the class is defined by the instruction, so the
# dead virtual register def is assigned an overlapping register after
# running out of registers. Make sure the dead flags do not violate
# consistent dead flag rules.

# ERR: error: <unknown>:0:0: ran out of registers during register allocation in function 'dead_vreg_def_live_super_def'
# ERR: error: <unknown>:0:0: ran out of registers during register allocation in function 'dead_vreg_super_def_live_sub_def'

# The live $rax def keeps the $eax def alive.
---
name: dead_vreg_def_live_super_def
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_vreg_def_live_super_def
    ; CHECK: {{^}}    $eax = MOV32ri 1, implicit-def $rax, implicit-def $rdx{{$}}
    ; CHECK-NEXT: RET 0, killed $rax, killed $rdx
    dead %0:gr32_ad = MOV32ri 1, implicit-def $rax, implicit-def $rdx
    RET 0, $rax, $rdx
...

# The live $eax def does not keep the $rax def alive, even though both have the
# same register units.
---
name: dead_vreg_super_def_live_sub_def
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_vreg_super_def_live_sub_def
    ; CHECK: {{^}}    dead $rax = MOV64ri 1, implicit-def $eax, implicit-def $edx{{$}}
    ; CHECK-NEXT: RET 0, killed $eax, killed $edx
    dead %0:gr64_ad = MOV64ri 1, implicit-def $eax, implicit-def $edx
    RET 0, $eax, $edx
...
