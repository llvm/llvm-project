; RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+reserve-r15 < %s | FileCheck %s

; Verify that dynamically disabled CSRs (via disableCalleeSavedRegister) and
; user-reserved registers (+reserve-r15) are removed from
; MachineRegisterInfo::getCalleeSavedRegs() and honored by
; insertZeroCallUsedRegs and setRestoreBasePointer.

@buf = internal global [5 x ptr] zeroinitializer, align 16

declare i32 @llvm.eh.sjlj.setjmp(ptr)

define i64 @no_caller_saved_regs_zero_used_args(i64 %a, i64 %b) nounwind "no_caller_saved_registers" "zero-call-used-regs"="used-arg" {
; CHECK-LABEL: no_caller_saved_regs_zero_used_args:
; CHECK:       # %bb.0:
; CHECK-NEXT:    leaq (%rdi,%rsi), %rax
; CHECK-NEXT:    xorl %edi, %edi
; CHECK-NEXT:    xorl %esi, %esi
; CHECK-NEXT:    retq
  %sum = add i64 %a, %b
  ret i64 %sum
}

define x86_regcallcc i64 @regcall_zero_used_args(i64 %a, i64 %b) nounwind "zero-call-used-regs"="used-arg" {
; CHECK-LABEL: regcall_zero_used_args:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addq %rcx, %rax
; CHECK-NEXT:    xorl %ecx, %ecx
; CHECK-NEXT:    retq
  %sum = add i64 %a, %b
  ret i64 %sum
}

define preserve_mostcc i64 @pm_reserved_r15_not_saved(i64 %x) nounwind {
; CHECK-LABEL: pm_reserved_r15_not_saved:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{r15}"()
  ret i64 %x
}

define i32 @setjmp_baseptr_reserved_r15(i64 %n) nounwind {
; CHECK-LABEL: setjmp_baseptr_reserved_r15:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rbp
; CHECK-NEXT:    movq %rsp, %rbp
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    pushq %r13
; CHECK-NEXT:    pushq %r12
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    andq $-64, %rsp
; CHECK-NEXT:    subq $64, %rsp
; CHECK-NEXT:    movq %rsp, %rbx
; CHECK-NEXT:    movq %rsp, -40(%rbp)
; CHECK-NEXT:    movq %rsp, %rax
; CHECK-NEXT:    addq $15, %rdi
; CHECK-NEXT:    andq $-16, %rdi
; CHECK-NEXT:    subq %rdi, %rax
; CHECK-NEXT:    movq %rax, %rsp
; CHECK-NEXT:    movq $.LBB3_3, buf+8(%rip)
; CHECK-NEXT:    #EH_SjLj_Setup .LBB3_3
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    jmp .LBB3_2
; CHECK-NEXT:  .LBB3_3: # Block address taken
; CHECK-NEXT:    movq -40(%rbp), %rbx
; CHECK-NEXT:    movl $1, %eax
; CHECK-NEXT:  .LBB3_2:
; CHECK-NEXT:    leaq -40(%rbp), %rsp
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    popq %r12
; CHECK-NEXT:    popq %r13
; CHECK-NEXT:    popq %r14
; CHECK-NEXT:    popq %rbp
; CHECK-NEXT:    retq
  %q = alloca i8, align 64
  %s = alloca i8, i64 %n, align 1
