# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -passes=post-ra-pseudos -o - %s | FileCheck %s

---
name: freeze_reg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi

    ; CHECK-LABEL: name: freeze_reg
    ; CHECK: liveins: $edi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOV32rr $edi
    ; CHECK-NEXT: RET 0, implicit $eax
    $eax = FREEZE $edi
    RET 0, implicit $eax
...
---
name: freeze_undef_reg
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: freeze_undef_reg
    ; CHECK: $eax = FREEZE undef $ecx
    ; CHECK-NEXT: RET 0, implicit $eax
    $eax = FREEZE undef $ecx
    RET 0, implicit $eax
...
