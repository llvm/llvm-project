entry:
  %r = callbr i64 asm sideeffect "# $0 $1 $2 $3 $4 $5 $6 ${7:l}",
      "=&rm,r,r,r,r,r,r,!i,~{rax},~{rbx},~{rbp},~{r10},~{r11},~{r12},~{r13},~{r14},~{r15}"
      (i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f)
      to label %fallthrough [label %indirect]

fallthrough:
  ret i64 0

indirect:
  %sum = add i64 %r, %a
  ret i64 %sum
}
