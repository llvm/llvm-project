; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=i686-unknown-linux | FileCheck %s

; Softening widens x86_fp80 to i96, but a bit-cast to the integer image only
; yields i80. All producers of a softened value have to agree on i96, or
; consumers such as a select assert with "Cannot use select on differing
; types".

define x86_fp80 @select_arg_extract(i1 %c, ptr %p, x86_fp80 %x) #0 {
; CHECK-LABEL: select_arg_extract:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    testb $1, {{[0-9]+}}(%esp)
; CHECK-NEXT:    jne .LBB0_1
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    movl %ecx, %edx
; CHECK-NEXT:    jmp .LBB0_3
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    leal {{[0-9]+}}(%esp), %edx
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    movl (%edx), %eax
; CHECK-NEXT:    movl 4(%edx), %edx
; CHECK-NEXT:    jne .LBB0_4
; CHECK-NEXT:  # %bb.5:
; CHECK-NEXT:    movl 8(%ecx), %ecx
; CHECK-NEXT:    movzwl %cx, %ecx
; CHECK-NEXT:    retl
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    movzwl %cx, %ecx
; CHECK-NEXT:    retl
  %v = load <2 x x86_fp80>, ptr %p, align 16
  %e = extractelement <2 x x86_fp80> %v, i32 0
  %s = select i1 %c, x86_fp80 %x, x86_fp80 %e
  ret x86_fp80 %s
}

define x86_fp80 @select_two_extracts_fabs(i1 %c, ptr %p) #0 {
; CHECK-LABEL: select_two_extracts_fabs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushl %esi
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %esi
; CHECK-NEXT:    testb $1, %cl
; CHECK-NEXT:    movl %esi, %eax
; CHECK-NEXT:    jne .LBB1_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    leal 10(%esi), %eax
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    movl (%eax), %eax
; CHECK-NEXT:    andl $1, %ecx
; CHECK-NEXT:    negl %ecx
; CHECK-NEXT:    movl %ecx, %edx
; CHECK-NEXT:    andl $10, %edx
; CHECK-NEXT:    xorl $14, %edx
; CHECK-NEXT:    movl (%esi,%edx), %edx
; CHECK-NEXT:    andl $26, %ecx
; CHECK-NEXT:    xorl $18, %ecx
; CHECK-NEXT:    movzwl (%esi,%ecx), %ecx
; CHECK-NEXT:    andl $32767, %ecx # imm = 0x7FFF
; CHECK-NEXT:    popl %esi
; CHECK-NEXT:    retl
  %v = load <2 x x86_fp80>, ptr %p, align 16
  %e0 = extractelement <2 x x86_fp80> %v, i32 0
  %e1 = extractelement <2 x x86_fp80> %v, i32 1
  %s = select i1 %c, x86_fp80 %e0, x86_fp80 %e1
  %r = call x86_fp80 @llvm.fabs.f80(x86_fp80 %s)
  ret x86_fp80 %r
}

declare x86_fp80 @llvm.fabs.f80(x86_fp80)

attributes #0 = { nounwind "target-features"="-x87" }
