; RUN: llc -mtriple=x86_64-- < %s | FileCheck %s

; The coalescer rematerializes the MOV32ri64 as a dead $rdi def with a
; live implicit-def of $edi. The post-RA expansion must not leave a
; dead def of $edi.

declare dso_local i32 @callee(i32)

define i32 @call_with_truncated_callee_address() nounwind {
; CHECK-LABEL: call_with_truncated_callee_address:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movl $callee, %edi
; CHECK-NEXT:    callq callee
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %call = call i32 @callee(i32 ptrtoint (ptr @callee to i32))
  ret i32 %call
}
