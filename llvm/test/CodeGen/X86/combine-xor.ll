; Lowering the reduction creates (xor (xor x, C), x) after legalization, which
; should fold to C.
define i64 @xor_v4i64(<4 x i64> %x) {
; CHECK-LABEL: xor_v4i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl $7, %eax
; CHECK-NEXT:    retq
  %s = shufflevector <4 x i64> %x, <4 x i64> poison, <4 x i32> zeroinitializer
  %a = xor <4 x i64> %s, <i64 7, i64 0, i64 0, i64 0>
  %r = call i64 @llvm.vector.reduce.xor.v4i64(<4 x i64> %a)
  ret i64 %r
}

