define <2 x i32> @pclmul_repeated_selected_lanes_11(<4 x i64> %a, <4 x i64> %b) #1 {
; CHECK-LABEL: pclmul_repeated_selected_lanes_11:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpclmulqdq $17, %ymm1, %ymm0, %ymm0
; CHECK-NEXT:    vextracti128 $1, %ymm0, %xmm1
; CHECK-NEXT:    vpunpckldq {{.*#+}} xmm0 = xmm0[0],xmm1[0],xmm0[1],xmm1[1]
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %a.i32 = bitcast <4 x i64> %a to <8 x i32>
  %a.lane0 = extractelement <8 x i32> %a.i32, i32 2
  %a.lane1 = extractelement <8 x i32> %a.i32, i32 6
  %a.insert0 = insertelement <8 x i32> poison, i32 %a.lane0, i32 2
  %a.insert1 = insertelement <8 x i32> %a.insert0, i32 %a.lane1, i32 6
  %a.vector = bitcast <8 x i32> %a.insert1 to <4 x i64>
  %b.i32 = bitcast <4 x i64> %b to <8 x i32>
  %b.lane0 = extractelement <8 x i32> %b.i32, i32 2
  %b.lane1 = extractelement <8 x i32> %b.i32, i32 6
  %b.insert0 = insertelement <8 x i32> poison, i32 %b.lane0, i32 2
  %b.insert1 = insertelement <8 x i32> %b.insert0, i32 %b.lane1, i32 6
  %b.vector = bitcast <8 x i32> %b.insert1 to <4 x i64>
  %product = call <4 x i64> @llvm.x86.pclmulqdq.256(<4 x i64> %a.vector, <4 x i64> %b.vector, i8 17)
  %product.i32 = bitcast <4 x i64> %product to <8 x i32>
  %result = shufflevector <8 x i32> %product.i32, <8 x i32> poison, <2 x i32> <i32 0, i32 4>
  ret <2 x i32> %result
}

