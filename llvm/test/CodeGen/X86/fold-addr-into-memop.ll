; negative: the address has a second use after the load, so the base stays
; live and the lea must remain.
define i64 @no_fold_multiuse(ptr %a, ptr %b, i64 %i, i1 %c) {
; CHECK-LABEL: no_fold_multiuse:
; CHECK:       # %bb.0:
; CHECK-NEXT:    testb $1, %cl
; CHECK-NEXT:    je .LBB8_2
; CHECK-NEXT:  # %bb.1: # %la
; CHECK-NEXT:    leaq (%rdi,%rdx,8), %rcx
; CHECK-NEXT:    jmp .LBB8_3
; CHECK-NEXT:  .LBB8_2: # %lb
; CHECK-NEXT:    leaq (%rsi,%rdx,8), %rcx
; CHECK-NEXT:  .LBB8_3: # %join
; CHECK-NEXT:    movq (%rcx), %rax
; CHECK-NEXT:    addq 8(%rcx), %rax
; CHECK-NEXT:    retq
  br i1 %c, label %la, label %lb
la:
  %qa = getelementptr i64, ptr %a, i64 %i
  br label %join
lb:
  %qb = getelementptr i64, ptr %b, i64 %i
  br label %join
join:
  %q = phi ptr [ %qa, %la ], [ %qb, %lb ]
  %v = load i64, ptr %q
  %q2 = getelementptr i64, ptr %q, i64 1
  %w = load i64, ptr %q2
  %s = add i64 %v, %w
  ret i64 %s
}
