; CHECK-LABEL: fold_rmw_idx4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    testb $1, %r8b
; CHECK-NEXT:    je .LBB4_2
; CHECK-NEXT:  # %bb.1: # %la
; CHECK-NEXT:    addl %ecx, (%rdi,%rdx,4)
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB4_2: # %lb
; CHECK-NEXT:    addl %ecx, (%rsi,%rdx,4)
; CHECK-NEXT:    retq
  br i1 %c, label %la, label %lb
la:
  %qa = getelementptr i32, ptr %a, i64 %i
  br label %join
lb:
  %qb = getelementptr i32, ptr %b, i64 %i
