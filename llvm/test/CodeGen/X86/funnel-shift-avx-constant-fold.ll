; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc < %s -mtriple=x86_64-- -mattr=+avx | FileCheck %s

; Regression test for https://github.com/llvm/llvm-project/issues/233063
; LowerFunnelShift's pre-AVX2 256-bit split path called splitVectorOp on a
; node that constant-folded into a BUILD_VECTOR, producing a malformed
; v4i32 BUILD_VECTOR with 8 scalar operands (assert, or heap corruption in
; Release builds).

define <8 x i32> @fshr_constant_fold(<8 x i32> %x) {
; CHECK-LABEL: fshr_constant_fold:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovaps {{.*#+}} ymm0 = [8,8,24,16,40,24,56,32]
; CHECK-NEXT:    retq
  %v0 = call <8 x i32> @llvm.ucmp.v8i32.v8i32(<8 x i32> %x, <8 x i32> %x)
  %v1 = call <8 x i32> @llvm.fshr.v8i32(<8 x i32> %v0, <8 x i32> <i32 16, i32 32, i32 48, i32 64, i32 80, i32 96, i32 112, i32 128>,
                                        <8 x i32> <i32 1, i32 2, i32 1, i32 2, i32 1, i32 2, i32 1, i32 2>)
  ret <8 x i32> %v1
}

declare <8 x i32> @llvm.ucmp.v8i32.v8i32(<8 x i32>, <8 x i32>)
declare <8 x i32> @llvm.fshr.v8i32(<8 x i32>, <8 x i32>, <8 x i32>)
