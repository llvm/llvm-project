; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=x86_64 < %s | FileCheck %s

; A function that contains a stackmap or patchpoint only needs a frame pointer
; if it would need one without them: stackmap locations are recorded as
; (register, offset) pairs, and the base register that the backend actually
; uses is the one that is recorded.

; A stackmap with no frame references does not force a frame pointer.
define void @no_frame_pointer_needed() {
; CHECK-LABEL: no_frame_pointer_needed:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
  tail call void (i64, i32, ...) @llvm.experimental.stackmap(i64 0, i32 0)
  ret void
}

; A spilled value is addressed relative to the stack pointer when there is no
; frame pointer, and the stack pointer is recorded as its frame register.
define void @stackmap_sp_relative(i64 %a, i64 %b) {
; CHECK-LABEL: stackmap_sp_relative:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movq %rdi, (%rsp)
; CHECK-NEXT:  .Ltmp1:
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
entry:
  %slot = alloca i64
  store i64 %a, ptr %slot
  call void (i64, i32, ...) @llvm.experimental.stackmap(i64 1, i32 0, i64 %b, ptr %slot)
  ret void
}

; Everything that required a frame pointer before still does: functions with
; variable sized objects, stack realignment, ...
define void @var_sized_object(i64 %n) {
; CHECK-LABEL: var_sized_object:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rbp
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset %rbp, -16
; CHECK-NEXT:    movq %rsp, %rbp
; CHECK-NEXT:    .cfi_def_cfa_register %rbp
; CHECK-NEXT:    movq %rsp, %rax
; CHECK-NEXT:    leaq 15(,%rdi,8), %rcx
; CHECK-NEXT:    andq $-16, %rcx
; CHECK-NEXT:    movq %rax, %rdx
; CHECK-NEXT:    subq %rcx, %rdx
; CHECK-NEXT:    movq %rdx, %rsp
; CHECK-NEXT:    negq %rcx
; CHECK-NEXT:    movq $0, (%rax,%rcx)
; CHECK-NEXT:  .Ltmp2:
; CHECK-NEXT:    movq %rbp, %rsp
; CHECK-NEXT:    popq %rbp
; CHECK-NEXT:    .cfi_def_cfa %rsp, 8
; CHECK-NEXT:    retq
entry:
  %dyn = alloca i64, i64 %n
  store volatile i64 0, ptr %dyn
  call void (i64, i32, ...) @llvm.experimental.stackmap(i64 2, i32 0)
  ret void
}

declare void @llvm.experimental.stackmap(i64, i32, ...)
