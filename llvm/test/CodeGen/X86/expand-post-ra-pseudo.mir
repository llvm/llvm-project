# RUN: llc -o - %s -mtriple=x86_64-- -run-pass=post-ra-pseudos | FileCheck %s
---
# CHECK-LABEL: name: func
name: func
body: |
  bb.0:
    liveins: $eax
    ; CHECK-NOT: dead $rax = KILL {{[0-9]+}}
    ; CHECK: dead $rax = KILL killed $eax
    dead $rax = SUBREG_TO_REG killed $eax, %subreg.sub_32bit
...
---
# CHECK-LABEL: name: mov32ri64_dead_def_live_subreg
# CHECK: {{^ +}}$edi = MOV32ri 1, implicit-def $edi{{$}}
name: mov32ri64_dead_def_live_subreg
tracksRegLiveness: true
body: |
  bb.0:
    dead $rdi = MOV32ri64 1, implicit-def $edi
    RET 0, implicit $edi
...

---
# CHECK-LABEL: name: mov32ri64_dead_def_live_subreg_really_dead
# CHECK: {{^ +}}$edi = MOV32ri 1, implicit-def $edi{{$}}
name: mov32ri64_dead_def_live_subreg_really_dead
tracksRegLiveness: true
body: |
  bb.0:
    dead $rdi = MOV32ri64 1, implicit-def $edi
    RET 0
...

---
# CHECK-LABEL: name: mov32ri64_dead_def
# CHECK: {{^ +}}dead $edi = MOV32ri 1{{$}}
name: mov32ri64_dead_def
tracksRegLiveness: true
body: |
  bb.0:
    dead $rdi = MOV32ri64 1
    RET 0
...
---
# CHECK-LABEL: name: mov32ri64_live_def
# CHECK: {{^ +}}$edi = MOV32ri 1{{$}}
name: mov32ri64_live_def
tracksRegLiveness: true
body: |
  bb.0:
    $rdi = MOV32ri64 1
    RET 0, implicit $rdi
...
---
# CHECK-LABEL: name: mov32ri64_dead_def_live_subreg16
# CHECK: {{^ +}}dead $edi = MOV32ri 1, implicit-def $di{{$}}
name: mov32ri64_dead_def_live_subreg16
tracksRegLiveness: true
body: |
  bb.0:
    dead $rdi = MOV32ri64 1, implicit-def $di
    RET 0, implicit $di
...
