  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_PHI $k0, 400000
  ; CHECK-NEXT:   RET64 $eax
  bb.0:
    successors: %bb.1
