# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=x86-compress-evex \
# RUN:   -verify-machineinstrs -mcpu=skx -o - %s | FileCheck %s

# Debug-only mask uses must not prevent VPMOV*2M + KMOV or masked blends from
# being compressed.

--- |
  declare void @foo()

  define void @same_block_debug_use() !dbg !3 { ret void }
  define void @same_block_blend_debug_use() !dbg !10 { ret void }
  define void @cross_block_debug_use() { ret void }
  define void @cross_block_redefinition() { ret void }
  define void @same_block_redefinition() { ret void }
  define void @call_clobber() { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "compress-evex-debug-use.c", directory: "")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "same_block_debug_use", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !6)
  !4 = !DISubroutineType(types: !5)
  !5 = !{null}
  !6 = !{!7}
  !7 = !DILocalVariable(name: "mask", scope: !3, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !3)
  !10 = distinct !DISubprogram(name: "same_block_blend_debug_use", scope: !1, file: !1, line: 2, type: !4, scopeLine: 2, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !12)
  !11 = !DILocalVariable(name: "mask", scope: !10, file: !1, line: 2, type: !8)
  !12 = !{!11}
  !13 = !DILocation(line: 2, column: 1, scope: !10)
...
---
name:            same_block_debug_use
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $xmm0

    ; CHECK-LABEL: name: same_block_debug_use
    ; CHECK: liveins: $xmm0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
    ; CHECK-NEXT: $eax = VMOVMSKPSrr $xmm0
    ; CHECK-NEXT: RET64 $eax
    $k0 = VPMOVD2MZ128kr $xmm0
    DBG_VALUE $k0, $noreg, !7, !DIExpression(), debug-location !9
    $eax = KMOVDrk killed $k0
    RET64 $eax
...
---
name:            same_block_blend_debug_use
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $xmm0, $xmm1, $xmm2

    ; CHECK-LABEL: name: same_block_blend_debug_use
    ; CHECK: liveins: $xmm0, $xmm1, $xmm2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !11, !DIExpression(), debug-location !DILocation(line: 2, column: 1, scope: !9)
    ; CHECK-NEXT: $xmm1 = VBLENDVPSrrr killed $xmm1, killed $xmm2, $xmm0
    ; CHECK-NEXT: RET64 implicit killed $xmm1
    $k1 = VPMOVD2MZ128kr $xmm0
    DBG_VALUE $k1, $noreg, !11, !DIExpression(), debug-location !13
    $xmm1 = VMOVAPSZ128rrk killed $xmm1, killed $k1, killed $xmm2
    RET64 implicit killed $xmm1
...
---
name:            cross_block_debug_use
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cross_block_debug_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $xmm0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = VMOVMSKPSrr $xmm0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET64 $eax
  bb.0:
    successors: %bb.1
    liveins: $xmm0

    $k0 = VPMOVD2MZ128kr $xmm0
    $eax = KMOVDrk killed $k0

  bb.1:
    liveins: $eax

    DBG_PHI $k0, 100000
    RET64 $eax
...
---
name:            cross_block_redefinition
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cross_block_redefinition
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $xmm0
