  ; CHECK-NEXT:   liveins: $eax, $xmm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $k0 = VPMOVD2MZ128kr $xmm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_PHI $k0, 200000
  ; CHECK-NEXT:   RET64 $eax
  bb.0:
    successors: %bb.1
    liveins: $xmm0

    $k0 = VPMOVD2MZ128kr $xmm0
    $eax = KMOVDrk killed $k0

  bb.1:
    successors: %bb.2
    liveins: $eax, $xmm1

    $k0 = VPMOVD2MZ128kr $xmm1

  bb.2:
    liveins: $eax

    DBG_PHI $k0, 200000
    RET64 $eax
...
---
name:            same_block_redefinition
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: same_block_redefinition
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $xmm0, $xmm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = VMOVMSKPSrr $xmm0
  ; CHECK-NEXT:   $k0 = VPMOVD2MZ128kr $xmm1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_PHI $k0, 300000
  ; CHECK-NEXT:   RET64 $eax
  bb.0:
    successors: %bb.1
    liveins: $xmm0, $xmm1

    $k0 = VPMOVD2MZ128kr $xmm0
    $eax = KMOVDrk killed $k0
    $k0 = VPMOVD2MZ128kr $xmm1

  bb.1:
    liveins: $eax

    DBG_PHI $k0, 300000
    RET64 $eax
...
