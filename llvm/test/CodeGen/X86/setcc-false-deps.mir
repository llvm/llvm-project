# Only the SETcc itself writes rdx in the loop: the dependency on its previous
# result is a single cycle and not worth an extra instruction.
name:            only_setcc_defines
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: only_setcc_defines
  ; CHECK: bb.0:
