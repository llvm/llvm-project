  ; BREAK-NEXT:   $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
  ; BREAK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; BREAK-NEXT:   DBG_VALUE $noreg, 0, 0, 0, 0
  ; BREAK-NEXT:   $al = SETCCr 12, implicit $eflags, implicit killed $eax
  ; BREAK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; BREAK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; BREAK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; BREAK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT: bb.2:
  ; BREAK-NEXT:   liveins: $rax
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   RET64 $rax
  ;
  ; NOBREAK-LABEL: name: debug_value
  ; NOBREAK: bb.0:
  ; NOBREAK-NEXT:   successors: %bb.1(0x80000000)
  ; NOBREAK-NEXT:   liveins: $rdi, $rsi
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   $eax = MOV32r0 implicit-def dead $eflags
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT: bb.1:
  ; NOBREAK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NOBREAK-NEXT:   liveins: $rax, $rdi, $rsi
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   $rcx = MOV64rr $rax
  ; NOBREAK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; NOBREAK-NEXT:   DBG_VALUE $rax, 0, 0, 0, 0
  ; NOBREAK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; NOBREAK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; NOBREAK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; NOBREAK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; NOBREAK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT: bb.2:
  ; NOBREAK-NEXT:   liveins: $rax
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   RET64 $rax
  bb.0:
    liveins: $rdi, $rsi
    $eax = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $rax, $rdi, $rsi
    $rcx = MOV64rr $rax
    CMP64rr $rdi, $rsi, implicit-def $eflags
    DBG_VALUE $rax, 0, 0, 0, 0
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
    $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rax
    RET64 $rax
...
---
# Not in a loop: rax was written shortly before, but nothing is broken.
name:            not_a_loop
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi, $rsi, $rdx
    ; CHECK-LABEL: name: not_a_loop
    ; CHECK: liveins: $rdi, $rsi, $rdx
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $rax = MOV64rm $rdx, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: MOV64mr $rdx, 1, $noreg, 8, $noreg, killed $rax
    ; CHECK-NEXT: CMP64rr killed $rdi, killed $rsi, implicit-def $eflags
    ; CHECK-NEXT: $al = SETCCr 12, implicit killed $eflags
    ; CHECK-NEXT: RET64 $al
    $rax = MOV64rm $rdx, 1, $noreg, 0, $noreg
    MOV64mr $rdx, 1, $noreg, 8, $noreg, killed $rax
    CMP64rr killed $rdi, killed $rsi, implicit-def $eflags
    $al = SETCCr 12, implicit killed $eflags
    RET64 $al
...
