# SETcc writes only the low byte of its destination, so it depends on the last
# write of the full register. A zero idiom cannot go right before the SETcc,
# which reads EFLAGS.

--- |
  define void @loop_carried() { ret void }
  define void @read_after_flags_def() { ret void }
  define void @same_iteration_write() { ret void }
  define void @write_after_flags_def() { ret void }
  define void @shared_flags_def() { ret void }
  define void @flags_live_in() { ret void }
  define void @flags_def_reads_flags() { ret void }
  define void @flags_def_reads_dest() { ret void }
  define void @flags_def_writes_dest() { ret void }
  define void @call_in_loop() { ret void }
  define void @merges_into_upper_bits() { ret void }
  define void @only_setcc_writes() { ret void }
  define void @high_byte_live() { ret void }
  define void @high_byte_dest() { ret void }
  define void @debug_value() { ret void }
  define void @not_a_loop() { ret void }
  define void @optsize() optsize { ret void }
  define void @minsize() minsize { ret void }
  declare void @f()
...
---
# rax holds the previous iteration's sum and is dead between the CMP and the
# SETcc: zero it before the CMP.
name:            loop_carried
tracksRegLiveness: true
body:             |
  ; BREAK-LABEL: name: loop_carried
  ; BREAK: bb.0:
  ; BREAK-NEXT:   successors: %bb.1(0x80000000)
  ; BREAK-NEXT:   liveins: $rdi, $rsi
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   $eax = MOV32r0 implicit-def dead $eflags
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT: bb.1:
  ; BREAK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; BREAK-NEXT:   liveins: $rax, $rdi, $rsi
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   $rcx = MOV64rr $rax
  ; BREAK-NEXT:   $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
  ; BREAK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; BREAK-NEXT:   $al = SETCCr 12, implicit $eflags, implicit killed $eax
  ; BREAK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; BREAK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; BREAK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; BREAK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT: bb.2:
  ; BREAK-NEXT:   liveins: $rax
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   RET64 $rax
  ;
  ; NOBREAK-LABEL: name: loop_carried
  ; NOBREAK: bb.0:
  ; NOBREAK-NEXT:   successors: %bb.1(0x80000000)
  ; NOBREAK-NEXT:   liveins: $rdi, $rsi
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   $eax = MOV32r0 implicit-def dead $eflags
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT: bb.1:
  ; NOBREAK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NOBREAK-NEXT:   liveins: $rax, $rdi, $rsi
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   $rcx = MOV64rr $rax
  ; NOBREAK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; NOBREAK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; NOBREAK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; NOBREAK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; NOBREAK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; NOBREAK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT: bb.2:
  ; NOBREAK-NEXT:   liveins: $rax
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   RET64 $rax
  bb.0:
    liveins: $rdi, $rsi
    $eax = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $rax, $rdi, $rsi
    $rcx = MOV64rr $rax
    CMP64rr $rdi, $rsi, implicit-def $eflags
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
    $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rax
    RET64 $rax
...
