    CMP64rr $rdi, $rsi, implicit-def $eflags

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $eflags, $rax, $rdi, $rsi
    $rcx = MOV64rr $rax
    $al = SETCCr 5, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
    $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rax
    RET64 $rax
...
