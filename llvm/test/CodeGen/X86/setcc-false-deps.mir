# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mcpu=sapphirerapids -run-pass x86-fixup-bw-insts %s -o - | FileCheck %s --check-prefixes=CHECK,BREAK
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mcpu=diamondrapids -run-pass x86-fixup-bw-insts %s -o - | FileCheck %s --check-prefixes=CHECK,NOBREAK

# Dependency breaking for SETcc whose destination's super-register carries a
# value from the previous iteration of a single-block loop. Diamond Rapids
# prefers legacy SETcc without dependency breaking (prefer-legacy-setcc).

--- |
  define void @xor_before_cmp() { ret void }
  define void @mov_before_setcc() { ret void }
  define void @shared_flags_def() { ret void }
  define void @flags_from_other_block() { ret void }
  define void @call_in_iteration() { ret void }
  declare void @f()
  define void @flags_def_reads_flags() { ret void }
  define void @cmp_reads_dest() { ret void }
  define void @defined_in_iteration() { ret void }
  define void @upper_bits_live() { ret void }
  define void @high_byte() { ret void }
  define void @only_setcc_defines() { ret void }
  define void @not_a_loop() { ret void }
  define void @optsize() optsize { ret void }
...
---
# rax holds the previous iteration's sum and is dead between the CMP and the
# SETcc, so it can be zeroed before the CMP.
name:            xor_before_cmp
tracksRegLiveness: true
body:             |
  ; BREAK-LABEL: name: xor_before_cmp
  ; BREAK: bb.0:
  ; BREAK-NEXT:   successors: %bb.1(0x80000000)
  ; BREAK-NEXT:   liveins: $rdi, $rsi
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT: bb.1:
  ; BREAK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; BREAK-NEXT:   liveins: $rax, $rdi, $rsi
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   $rcx = MOV64rr $rax
  ; BREAK-NEXT:   $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
  ; BREAK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; BREAK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; BREAK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; BREAK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; BREAK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; BREAK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT: bb.2:
  ; BREAK-NEXT:   liveins: $rax
  ; BREAK-NEXT: {{  $}}
  ; BREAK-NEXT:   RET64 $rax
  ;
  ; NOBREAK-LABEL: name: xor_before_cmp
  ; NOBREAK: bb.0:
  ; NOBREAK-NEXT:   successors: %bb.1(0x80000000)
  ; NOBREAK-NEXT:   liveins: $rdi, $rsi
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT: bb.1:
  ; NOBREAK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NOBREAK-NEXT:   liveins: $rax, $rdi, $rsi
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   $rcx = MOV64rr $rax
  ; NOBREAK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; NOBREAK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; NOBREAK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; NOBREAK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; NOBREAK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; NOBREAK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT: bb.2:
  ; NOBREAK-NEXT:   liveins: $rax
  ; NOBREAK-NEXT: {{  $}}
  ; NOBREAK-NEXT:   RET64 $rax
  bb.0:
    liveins: $rdi, $rsi
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $rax, $rdi, $rsi
    $rcx = MOV64rr $rax
    CMP64rr $rdi, $rsi, implicit-def $eflags
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
    $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rax
    RET64 $rax
...
---
# rax is still read between the CMP and the SETcc, so it can only be zeroed
# right before the SETcc, with a MOV that preserves EFLAGS.
