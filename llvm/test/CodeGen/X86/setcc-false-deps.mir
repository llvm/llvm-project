---
# The call clobbers rax earlier in the iteration.
name:            call_in_iteration
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  ; CHECK-LABEL: name: call_in_iteration
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rbx, $r14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rbx, $r14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   CALL64pcrel32 @f, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
  ; CHECK-NEXT:   CMP64rr $rbx, $r14, implicit-def $eflags
  ; CHECK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; CHECK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; CHECK-NEXT:   $rbx = ADD64rr killed $rbx, killed $rax, implicit-def dead $eflags
  ; CHECK-NEXT:   CMP64rr $rbx, $r14, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $rbx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $rax = MOV64rr killed $rbx
  ; CHECK-NEXT:   RET64 $rax
  bb.0:
    liveins: $rbx, $r14

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $rbx, $r14
    CALL64pcrel32 @f, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
    CMP64rr $rbx, $r14, implicit-def $eflags
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rbx = ADD64rr killed $rbx, killed $rax, implicit-def dead $eflags
    CMP64rr $rbx, $r14, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rbx
    $rax = MOV64rr killed $rbx
    RET64 $rax
...
---
