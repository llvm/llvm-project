    $rdi = ADC64rr killed $rdi, $rsi, implicit-def $eflags, implicit $eflags
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rax = ADD64rr killed $rax, killed $rcx, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rax
    RET64 $rax
...
---
# The CMP already reads rax, so the flags depend on it anyway.
name:            cmp_reads_dest
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cmp_reads_dest
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
