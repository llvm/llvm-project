  ; CHECK-NEXT:   liveins: $rax, $rdi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $rcx = MOV64rr $rax
  ; CHECK-NEXT:   CMP64rr $rax, $rsi, implicit-def $eflags
  ; CHECK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; CHECK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; CHECK-NEXT:   $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
  ; CHECK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET64 $rax
  bb.0:
    liveins: $rdi, $rsi
    $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $rax, $rdi, $rsi
    $rcx = MOV64rr $rax
    CMP64rr $rax, $rsi, implicit-def $eflags
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rax = ADD64rr killed $rax, killed $rcx, implicit-def dead $eflags
    $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rax
    RET64 $rax
...
---
# rax is written earlier in the iteration (here by a load), so the SETcc
# does not depend on the previous iteration.
name:            defined_in_iteration
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: defined_in_iteration
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $ecx = XOR32rr undef $ecx, undef $ecx, implicit-def dead $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rcx, $rdi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $rax = MOV64rm $rdi, 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   CMP64rr $rdi, $rsi, implicit-def $eflags
  ; CHECK-NEXT:   $al = SETCCr 12, implicit $eflags
  ; CHECK-NEXT:   $eax = MOVZX32rr8 killed $al
  ; CHECK-NEXT:   $rcx = ADD64rr killed $rcx, killed $rax, implicit-def dead $eflags
  ; CHECK-NEXT:   $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $rcx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET64 $rcx
  bb.0:
    liveins: $rdi, $rsi
    $ecx = XOR32rr undef $ecx, undef $ecx, implicit-def dead $eflags

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $rcx, $rdi, $rsi
    $rax = MOV64rm $rdi, 1, $noreg, 0, $noreg
    CMP64rr $rdi, $rsi, implicit-def $eflags
    $al = SETCCr 12, implicit $eflags
    $eax = MOVZX32rr8 killed $al
    $rcx = ADD64rr killed $rcx, killed $rax, implicit-def dead $eflags
    $rdi = ADD64ri32 killed $rdi, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    liveins: $rcx
    RET64 $rcx
...
