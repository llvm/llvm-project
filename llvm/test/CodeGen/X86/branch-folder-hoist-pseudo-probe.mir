# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -run-pass=branch-folder -verify-machineinstrs %s -o - | FileCheck %s

# Common instructions are hoisted past probes at the start of and within
# each successor. The probes remain in their original blocks.

---
name:            hoist_past_probes
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: hoist_past_probes
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = MOV32ri 7
  ; CHECK-NEXT:   $eax = ADD32ri $eax, 1, implicit-def dead $eflags
  ; CHECK-NEXT:   TEST8ri $dil, 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PSEUDO_PROBE 123, 1, 0, 0
  ; CHECK-NEXT:   PSEUDO_PROBE 123, 3, 0, 0
  ; CHECK-NEXT:   $eax = ADD32ri $eax, 2, implicit-def dead $eflags
  ; CHECK-NEXT:   RET 0, $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PSEUDO_PROBE 123, 2, 0, 0
  ; CHECK-NEXT:   PSEUDO_PROBE 123, 4, 0, 0
  ; CHECK-NEXT:   $eax = SUB32ri $eax, 2, implicit-def dead $eflags
  ; CHECK-NEXT:   RET 0, $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi

    TEST8ri $dil, 1, implicit-def $eflags
    JCC_1 %bb.2, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    PSEUDO_PROBE 123, 1, 0, 0
    $eax = MOV32ri 7
    PSEUDO_PROBE 123, 3, 0, 0
    $eax = ADD32ri $eax, 1, implicit-def dead $eflags
    $eax = ADD32ri $eax, 2, implicit-def dead $eflags
    RET 0, $eax

  bb.2:
    PSEUDO_PROBE 123, 2, 0, 0
    PSEUDO_PROBE 123, 4, 0, 0
    $eax = MOV32ri 7
    $eax = ADD32ri $eax, 1, implicit-def dead $eflags
    $eax = SUB32ri $eax, 2, implicit-def dead $eflags
    RET 0, $eax
...
