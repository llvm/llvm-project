# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -run-pass=liveintervals,twoaddressinstruction -o - %s | FileCheck %s

# Two operands are tied to the same source register, but only one of the
# defs is early clobber. The copy inserted for the plain def must be live
# until the register slot, not the earlier early clobber slot.

---
name:            mixed_early_clobber_tied_defs
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: mixed_early_clobber_tied_defs
    ; CHECK: [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:gr64_norex2 = SUBREG_TO_REG [[MOV32r0_]], %subreg.sub_32bit
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64_norex2 = COPY [[SUBREG_TO_REG]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64_norex2 = COPY [[COPY]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr64_norex2 = COPY [[COPY]]
    ; CHECK-NEXT: INLINEASM &"", attdialect, regdef-ec:GR64_NOREX2, def early-clobber [[COPY1]], regdef:GR64_NOREX2, def dead [[COPY2]], reguse tiedto:$0, [[COPY1]](tied-def 3), reguse tiedto:$1, [[COPY2]](tied-def 5)
    ; CHECK-NEXT: $rax = COPY [[COPY1]]
    ; CHECK-NEXT: RET 0, killed $rax
    %0:gr32 = MOV32r0 implicit-def dead $eflags
    %1:gr64_norex2 = SUBREG_TO_REG %0, %subreg.sub_32bit
    %2:gr64_norex2 = COPY %1
    INLINEASM &"", attdialect, regdef-ec:GR64_NOREX2, def early-clobber %3:gr64_norex2, regdef:GR64_NOREX2, def %4:gr64_norex2, reguse tiedto:$0, %2(tied-def 3), reguse tiedto:$1, %2(tied-def 5)
    $rax = COPY %3
    RET 0, killed $rax
...
