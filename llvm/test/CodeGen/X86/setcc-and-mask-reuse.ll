; Negative: no existing wider mask.
define i1 @ne_no_wide_mask(i64 %x) {
; CHECK-LABEL: ne_no_wide_mask:
; CHECK:       # %bb.0:
; CHECK-NEXT:    notl %edi
; CHECK-NEXT:    testb $62, %dil
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    retq
  %narrow = and i64 %x, 62
  %cmp = icmp ne i64 %narrow, 62
  ret i1 %cmp
}

