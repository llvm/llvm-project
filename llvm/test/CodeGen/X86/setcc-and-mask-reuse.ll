; CHECK-NEXT:    notl %edi
; CHECK-NEXT:    andl $63, %esi
; CHECK-NEXT:    movq %rsi, (%rdx)
; CHECK-NEXT:    testb $62, %dil
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    retq
  %wide = and i64 %y, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  %cmp = icmp ne i64 %narrow, 62
  ret i1 %cmp
}

; Negative: the compared constant differs from the mask.
define i1 @ne_constant_mismatch(i64 %x, ptr %p) {
; CHECK-LABEL: ne_constant_mismatch:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    andl $63, %eax
; CHECK-NEXT:    movq %rax, (%rsi)
; CHECK-NEXT:    andl $62, %edi
; CHECK-NEXT:    cmpl $60, %edi
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    retq
  %wide = and i64 %x, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  %cmp = icmp ne i64 %narrow, 60
  ret i1 %cmp
}

; Negative: the narrow mask has another use, so it stays live.
define i1 @ne_narrow_multi_use(i64 %x, ptr %p, ptr %q) {
; CHECK-LABEL: ne_narrow_multi_use:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    andl $63, %eax
; CHECK-NEXT:    movq %rax, (%rsi)
; CHECK-NEXT:    andl $62, %edi
; CHECK-NEXT:    movq %rdi, (%rdx)
; CHECK-NEXT:    cmpq $62, %rdi
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    retq
  %wide = and i64 %x, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  store i64 %narrow, ptr %q
  %cmp = icmp ne i64 %narrow, 62
  ret i1 %cmp
}

; Negative: vectors are left alone.
define <4 x i1> @ne_reuse_splat(<4 x i32> %x, ptr %p) {
; CHECK-LABEL: ne_reuse_splat:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movdqa {{.*#+}} xmm1 = [63,63,63,63]
; CHECK-NEXT:    pand %xmm0, %xmm1
; CHECK-NEXT:    movdqa %xmm1, (%rdi)
; CHECK-NEXT:    movdqa {{.*#+}} xmm1 = [62,62,62,62]
; CHECK-NEXT:    pand %xmm1, %xmm0
; CHECK-NEXT:    pcmpeqd %xmm1, %xmm0
; CHECK-NEXT:    pcmpeqd %xmm1, %xmm1
; CHECK-NEXT:    pxor %xmm1, %xmm0
; CHECK-NEXT:    retq
  %wide = and <4 x i32> %x, splat (i32 63)
  store <4 x i32> %wide, ptr %p
  %narrow = and <4 x i32> %x, splat (i32 62)
  %cmp = icmp ne <4 x i32> %narrow, splat (i32 62)
  ret <4 x i1> %cmp
}
