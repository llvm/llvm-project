; CHECK-NEXT:    movl %edi, (%rsi)
; CHECK-NEXT:    testb $60, %al
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %wide = and i32 %x, 61
  store i32 %wide, ptr %p
  %narrow = and i32 %x, 60
  %cmp = icmp eq i32 %narrow, 60
  ret i1 %cmp
