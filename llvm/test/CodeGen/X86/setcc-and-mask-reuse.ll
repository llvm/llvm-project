; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-- | FileCheck %s

; (X & C) == C is equivalent to (X & M) u>= C, and (X & C) != C to
; (X & M) u< C, when C is a subset of M and M - C is a low-bit mask.
; If X & M is already computed, comparing it saves an instruction.

define i1 @ne_reuse_i64(i64 %x, ptr %p) {
; CHECK-LABEL: ne_reuse_i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    notl %eax
; CHECK-NEXT:    andl $63, %edi
; CHECK-NEXT:    movq %rdi, (%rsi)
; CHECK-NEXT:    testb $62, %al
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    retq
  %wide = and i64 %x, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  %cmp = icmp ne i64 %narrow, 62
  ret i1 %cmp
}

define i1 @eq_reuse_i64(i64 %x, ptr %p) {
; CHECK-LABEL: eq_reuse_i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    notl %eax
; CHECK-NEXT:    andl $63, %edi
; CHECK-NEXT:    movq %rdi, (%rsi)
; CHECK-NEXT:    testb $62, %al
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %wide = and i64 %x, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  %cmp = icmp eq i64 %narrow, 62
  ret i1 %cmp
}

