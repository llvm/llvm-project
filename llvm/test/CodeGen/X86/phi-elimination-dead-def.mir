# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=liveintervals,phi-node-elimination -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-- --passes='require<live-intervals>,phi-node-elimination' -verify-each -o - %s | FileCheck %s

# A PHI whose result is unused is lowered to a dead
# copy. PHIElimination records a dead def for it in LiveIntervals, so
# it must also mark the copy's def operand dead so they are
# consistent.

---
name:            dead_phi
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: dead_phi
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit undef $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   dead [[COPY1:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1, %bb.2

    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3

    %0:gr32 = MOV32ri 1
    JMP_1 %bb.3

  bb.2:
    successors: %bb.3

    %1:gr32 = MOV32ri 2

  bb.3:
    %2:gr32 = PHI %0, %bb.1, %1, %bb.2
    RET64
...
