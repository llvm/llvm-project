define float @compare_flip(float %A) {
; AVX-LABEL: compare_flip:
; AVX:       # %bb.0:
; AVX-NEXT:    vmovss {{.*#+}} xmm1 = [1.00999999E+0,0.0E+0,0.0E+0,0.0E+0]
; AVX-NEXT:    vcmpless %xmm0, %xmm1, %xmm0
; AVX-NEXT:    vmovss {{.*#+}} xmm1 = [1.0E+0,0.0E+0,0.0E+0,0.0E+0]
; AVX-NEXT:    vandps %xmm1, %xmm0, %xmm0
; AVX-NEXT:    retq
;
; SSE-LABEL: compare_flip:
; SSE:       # %bb.0:
; SSE-NEXT:    movss {{.*#+}} xmm1 = [1.00999999E+0,0.0E+0,0.0E+0,0.0E+0]
; SSE-NEXT:    cmpless %xmm0, %xmm1
; SSE-NEXT:    movss {{.*#+}} xmm0 = [1.0E+0,0.0E+0,0.0E+0,0.0E+0]
; SSE-NEXT:    andps %xmm1, %xmm0
; SSE-NEXT:    retq
  %cmp = fcmp nnan oge float %A, 1.01
  %sel = select i1 %cmp, float 1.0, float 0.0
  ret float %sel
}

