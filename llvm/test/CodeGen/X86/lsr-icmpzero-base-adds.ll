; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; These are llc tests rather than opt -loop-reduce tests: the exit-value uses in
; inner_exit_values are only Special (outside the loop) uses in the non-LCSSA
; form the codegen pipeline hands to LSR.

declare void @throw(i64)

; Three exits compare the IV against loop-invariant bounds, and the incremented
; IV is live into the cold exits. Each compare should test the IV against its
; bound directly, rather than add up an offset IV and the negated bound first.
define float @three_eq_exits(ptr %p, i64 %start, i64 %a, i64 %b, i64 %n) {
; CHECK-LABEL: three_eq_exits:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    incq %r8
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cmpq %rsi, %rdx
; CHECK-NEXT:    je .LBB0_5
; CHECK-NEXT:  # %bb.2: # %bb2
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    cmpq %rsi, %rcx
; CHECK-NEXT:    je .LBB0_5
; CHECK-NEXT:  # %bb.3: # %latch
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    addss (%rdi,%rsi,4), %xmm0
; CHECK-NEXT:    incq %rsi
; CHECK-NEXT:    cmpq %rsi, %r8
; CHECK-NEXT:    jne .LBB0_1
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_5: # %exit2
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    incq %rsi
; CHECK-NEXT:    movq %rsi, %rdi
; CHECK-NEXT:    callq throw@PLT
entry:
  br label %loop

loop:
  %iv = phi i64 [ %start, %entry ], [ %iv.next, %latch ]
  %acc = phi float [ 0.0, %entry ], [ %acc.next, %latch ]
  %iv.next = add i64 %iv, 1
  %c1 = icmp eq i64 %iv, %a
  br i1 %c1, label %exit1, label %bb2

bb2:
  %c2 = icmp eq i64 %iv, %b
  br i1 %c2, label %exit2, label %latch

latch:
  %gep = getelementptr float, ptr %p, i64 %iv
  %v = load float, ptr %gep, align 4
  %acc.next = fadd float %acc, %v
  %c3 = icmp eq i64 %iv, %n
  br i1 %c3, label %exit, label %loop

exit1:
  call void @throw(i64 %iv.next)
  unreachable

exit2:
  call void @throw(i64 %iv.next)
  unreachable

exit:
  ret float %acc.next
}

; The inner loop scans for the next non-zero tag; its exit values feed the outer
; loop's phis, so whatever LSR leaves to compute at the inner exit runs on every
; outer iteration. Rewriting them as a negated down-counting IV subtracted from
; a base is not free there.
define i64 @inner_exit_values(ptr %tags, ptr %data, i64 %off, i64 %n) {
; CHECK-LABEL: inner_exit_values:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testq %rcx, %rcx
; CHECK-NEXT:    jle .LBB1_1
; CHECK-NEXT:  # %bb.3: # %first.ph
; CHECK-NEXT:    addq %rdx, %rdi
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    xorl %r9d, %r9d
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_4: # %first
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cmpb $0, (%rdi,%r9)
; CHECK-NEXT:    jne .LBB1_6
; CHECK-NEXT:  # %bb.5: # %first.skip
; CHECK-NEXT:    # in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    incq %r9
; CHECK-NEXT:    cmpq %r9, %rcx
; CHECK-NEXT:    jne .LBB1_4
; CHECK-NEXT:  .LBB1_2: # %done
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB1_1:
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB1_6: # %found
; CHECK-NEXT:    leaq 1(%r9), %r8
; CHECK-NEXT:    cmpb $0, (%rdi,%r9)
; CHECK-NEXT:    je .LBB1_10
; CHECK-NEXT:  # %bb.7: # %outer.preheader
; CHECK-NEXT:    addq %rdx, %r9
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:  .LBB1_8: # %outer
; CHECK-NEXT:    # =>This Loop Header: Depth=1
; CHECK-NEXT:    # Child Loop BB1_12 Depth 2
; CHECK-NEXT:    addq (%rsi,%r9,8), %rax
; CHECK-NEXT:    cmpq %rcx, %r8
; CHECK-NEXT:    movq %r8, %r10
; CHECK-NEXT:    je .LBB1_2
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_12: # %inner
; CHECK-NEXT:    # Parent Loop BB1_8 Depth=1
; CHECK-NEXT:    # => This Inner Loop Header: Depth=2
; CHECK-NEXT:    cmpb $0, (%rdi,%r10)
; CHECK-NEXT:    jne .LBB1_13
; CHECK-NEXT:  # %bb.11: # %inner.latch
; CHECK-NEXT:    # in Loop: Header=BB1_12 Depth=2
; CHECK-NEXT:    incq %r10
; CHECK-NEXT:    cmpq %r10, %rcx
; CHECK-NEXT:    jne .LBB1_12
; CHECK-NEXT:    jmp .LBB1_2
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_13: # %inner.exit
; CHECK-NEXT:    # in Loop: Header=BB1_8 Depth=1
; CHECK-NEXT:    leaq (%rdx,%r10), %r9
; CHECK-NEXT:    leaq 1(%r10), %r8
; CHECK-NEXT:    cmpb $0, (%rdi,%r10)
; CHECK-NEXT:    jne .LBB1_8
; CHECK-NEXT:  # %bb.9: # %fail.loopexit
; CHECK-NEXT:    incq %r10
; CHECK-NEXT:    movq %r10, %r8
; CHECK-NEXT:  .LBB1_10: # %fail
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movq %r8, %rdi
; CHECK-NEXT:    callq throw@PLT
entry:
  %empty = icmp slt i64 %n, 1
  br i1 %empty, label %done, label %first.ph

first.ph:
  %tagbase = getelementptr i8, ptr %tags, i64 %off
  br label %first

first:
  %i0 = phi i64 [ 1, %first.ph ], [ %i0.next, %first.skip ]
  %p0 = getelementptr i8, ptr %tagbase, i64 %i0
  %p0m = getelementptr i8, ptr %p0, i64 -1
  %t0 = load i8, ptr %p0m, align 1
  %miss0 = icmp eq i8 %t0, 0
  br i1 %miss0, label %first.skip, label %found

first.skip:
  %end0 = icmp eq i64 %i0, %n
  %i0.next = add nuw i64 %i0, 1
  br i1 %end0, label %done, label %first

found:
  %offm1 = add i64 %off, -1
  %k0 = add i64 %i0, %offm1
  %pk0 = getelementptr inbounds i8, ptr %tags, i64 %k0
  %tk0 = load i8, ptr %pk0, align 1
  %bad0 = icmp eq i8 %tk0, 0
  br i1 %bad0, label %fail, label %outer

fail:
  %iexc = phi i64 [ %i0, %found ], [ %j.next, %inner.exit ]
  call void @throw(i64 %iexc)
  unreachable

outer:
  %k = phi i64 [ %k1, %inner.exit ], [ %k0, %found ]
  %s = phi i64 [ %s.next, %inner.exit ], [ 0, %found ]
  %i = phi i64 [ %j.next, %inner.exit ], [ %i0, %found ]
  %pd = getelementptr inbounds [8 x i8], ptr %data, i64 %k
  %v = load i64, ptr %pd, align 8
  %s.next = add i64 %v, %s
  %last = icmp eq i64 %i, %n
  br i1 %last, label %done, label %inner

inner.latch:
  %end = icmp eq i64 %j.next, %n
  br i1 %end, label %done, label %inner

inner:
  %j = phi i64 [ %j.next, %inner.latch ], [ %i, %outer ]
  %j.next = add i64 %j, 1
  %pt = getelementptr i8, ptr %tagbase, i64 %j
  %t = load i8, ptr %pt, align 1
  %miss = icmp eq i8 %t, 0
  br i1 %miss, label %inner.latch, label %inner.exit

inner.exit:
  %k1 = add i64 %j, %off
  %pk1 = getelementptr inbounds i8, ptr %tags, i64 %k1
  %tk1 = load i8, ptr %pk1, align 1
  %bad1 = icmp eq i8 %tk1, 0
  br i1 %bad1, label %fail, label %outer

done:
  %r = phi i64 [ 0, %entry ], [ %s.next, %outer ], [ %s.next, %inner.latch ], [ 0, %first.skip ]
  ret i64 %r
}

; Too many formulae for a full search, so LSR narrows the search space by
; committing to the register used by the most uses. {%start,+,1} and
; {(1 + %start),+,1} tie; the latter makes each equality exit add up the IV and
; a negated bound before the compare.
define float @winner_reg_tie(ptr %p, i64 %start, i64 %stop, i64 %a, i64 %b, i64 %stride, i64 %off) {
; CHECK-LABEL: winner_reg_tie:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    movq {{[0-9]+}}(%rsp), %rax
; CHECK-NEXT:    cmpq %rsi, %rcx
; CHECK-NEXT:    cmovbeq %rsi, %rcx
; CHECK-NEXT:    incq %rdx
; CHECK-NEXT:    leaq (%rdi,%rax,4), %rax
; CHECK-NEXT:    movq %r9, %rdi
; CHECK-NEXT:    imulq %rsi, %rdi
; CHECK-NEXT:    decq %rdi
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB2_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cmpq %rsi, %rcx
; CHECK-NEXT:    je .LBB2_5
; CHECK-NEXT:  # %bb.2: # %bb2
; CHECK-NEXT:    # in Loop: Header=BB2_1 Depth=1
; CHECK-NEXT:    cmpq %rsi, %r8
; CHECK-NEXT:    je .LBB2_5
; CHECK-NEXT:  # %bb.3: # %latch
; CHECK-NEXT:    # in Loop: Header=BB2_1 Depth=1
; CHECK-NEXT:    movss {{.*#+}} xmm1 = mem[0],zero,zero,zero
; CHECK-NEXT:    mulss (%rax,%rsi,4), %xmm1
; CHECK-NEXT:    incq %rsi
; CHECK-NEXT:    addss %xmm1, %xmm0
; CHECK-NEXT:    addq %r9, %rdi
; CHECK-NEXT:    cmpq %rsi, %rdx
; CHECK-NEXT:    jne .LBB2_1
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB2_5: # %exit2
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    incq %rsi
; CHECK-NEXT:    movq %rsi, %rdi
; CHECK-NEXT:    callq throw@PLT
entry:
  %ub = call i64 @llvm.umax.i64(i64 %a, i64 %start)
  br label %loop

loop:
  %iv = phi i64 [ %start, %entry ], [ %iv.next, %latch ]
  %acc = phi float [ 0.0, %entry ], [ %acc.next, %latch ]
  %iv.next = add i64 %iv, 1
  %c1 = icmp eq i64 %iv, %ub
  br i1 %c1, label %exit1, label %bb2

bb2:
  %c2 = icmp eq i64 %iv, %b
  br i1 %c2, label %exit2, label %latch

latch:
  %m = mul i64 %iv, %stride
  %i1 = add i64 %m, %off
  %gep1 = getelementptr float, ptr %p, i64 %i1
  %gep1m = getelementptr i8, ptr %gep1, i64 -4
  %x = load float, ptr %gep1m, align 4
  %i2 = add i64 %iv, %off
  %gep2 = getelementptr float, ptr %p, i64 %i2
  %y = load float, ptr %gep2, align 4
  %xy = fmul float %x, %y
  %acc.next = fadd float %acc, %xy
  %c3 = icmp eq i64 %iv, %stop
  br i1 %c3, label %exit, label %loop

exit1:
  call void @throw(i64 %iv.next)
  unreachable

exit2:
  call void @throw(i64 %iv.next)
  unreachable

exit:
  ret float %acc.next
}

; The inner loop skips a run of zero bytes, and most iterations of the outer
; loop bypass it. Its exit value meets the bypass path's index in %i.next. The
; inner loop should count with the outer loop's index register, rather than
; with an IV offset from it, which needs a copy on the bypass path and an
; adjustment after the inner loop.
define i64 @skip_runs(ptr %p, i64 %n, ptr %out) {
; CHECK-LABEL: skip_runs:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testq %rsi, %rsi
; CHECK-NEXT:    je .LBB3_1
; CHECK-NEXT:  # %bb.3: # %outer.preheader
; CHECK-NEXT:    movl $2, %ecx
; CHECK-NEXT:    subq %rsi, %rcx
; CHECK-NEXT:    xorl %r8d, %r8d
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:  .LBB3_4: # %outer
; CHECK-NEXT:    # =>This Loop Header: Depth=1
; CHECK-NEXT:    # Child Loop BB3_6 Depth 2
; CHECK-NEXT:    movzbl (%rdi,%r8), %r9d
; CHECK-NEXT:    movb %r9b, (%rdx,%rax)
; CHECK-NEXT:    incq %rax
; CHECK-NEXT:    incq %r8
; CHECK-NEXT:    cmpq %rsi, %r8
; CHECK-NEXT:    je .LBB3_2
; CHECK-NEXT:  # %bb.5: # %check
; CHECK-NEXT:    # in Loop: Header=BB3_4 Depth=1
; CHECK-NEXT:    cmpb $0, (%rdi,%r8)
; CHECK-NEXT:    jne .LBB3_4
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB3_6: # %inner
; CHECK-NEXT:    # Parent Loop BB3_4 Depth=1
; CHECK-NEXT:    # => This Inner Loop Header: Depth=2
; CHECK-NEXT:    leaq (%rcx,%r8), %r9
; CHECK-NEXT:    cmpq $1, %r9
; CHECK-NEXT:    je .LBB3_2
; CHECK-NEXT:  # %bb.7: # %inner.cont
; CHECK-NEXT:    # in Loop: Header=BB3_6 Depth=2
; CHECK-NEXT:    leaq 1(%r8), %r9
; CHECK-NEXT:    cmpb $0, 1(%rdi,%r8)
; CHECK-NEXT:    movq %r9, %r8
; CHECK-NEXT:    je .LBB3_6
; CHECK-NEXT:  # %bb.8: # in Loop: Header=BB3_4 Depth=1
; CHECK-NEXT:    movq %r9, %r8
; CHECK-NEXT:    jmp .LBB3_4
; CHECK-NEXT:  .LBB3_1:
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:  .LBB3_2: # %done
; CHECK-NEXT:    retq
entry:
  %e = icmp eq i64 %n, 0
  br i1 %e, label %done, label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %k = phi i64 [ 0, %entry ], [ %k.next, %latch ]
  %pi = getelementptr inbounds i8, ptr %p, i64 %i
  %x = load i8, ptr %pi, align 1
  %po = getelementptr inbounds i8, ptr %out, i64 %k
  store i8 %x, ptr %po, align 1
  %k.next = add nuw i64 %k, 1
  %i1 = add nuw i64 %i, 1
  %ex = icmp eq i64 %i1, %n
  br i1 %ex, label %done, label %check

check:
  %pj0 = getelementptr inbounds i8, ptr %p, i64 %i1
  %y0 = load i8, ptr %pj0, align 1
  %z0 = icmp eq i8 %y0, 0
  br i1 %z0, label %inner, label %latch

inner:
  %j = phi i64 [ %i1, %check ], [ %j1, %inner.cont ]
  %j1 = add nuw i64 %j, 1
  %ej = icmp eq i64 %j1, %n
  br i1 %ej, label %done, label %inner.cont

inner.cont:
  %pj = getelementptr inbounds i8, ptr %p, i64 %j1
  %y = load i8, ptr %pj, align 1
  %z = icmp eq i8 %y, 0
  br i1 %z, label %inner, label %latch

latch:
  %i.next = phi i64 [ %i1, %check ], [ %j1, %inner.cont ]
  br label %outer

done:
  %r = phi i64 [ 0, %entry ], [ %k.next, %outer ], [ %k.next, %inner ]
  ret i64 %r
}
; The same in LCSSA form, with both exits of the inner loop leaving through a
; phi in a dedicated exit block before the inner exit value reaches the merge.
define i64 @skip_runs_lcssa(ptr %p, i64 %n, ptr %out) {
; CHECK-LABEL: skip_runs_lcssa:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testq %rsi, %rsi
; CHECK-NEXT:    je .LBB4_1
; CHECK-NEXT:  # %bb.3: # %outer.preheader
; CHECK-NEXT:    movl $2, %ecx
; CHECK-NEXT:    subq %rsi, %rcx
; CHECK-NEXT:    xorl %r8d, %r8d
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB4_4: # %outer
; CHECK-NEXT:    # =>This Loop Header: Depth=1
; CHECK-NEXT:    # Child Loop BB4_6 Depth 2
; CHECK-NEXT:    movzbl (%rdi,%r8), %r9d
; CHECK-NEXT:    movb %r9b, (%rdx,%rax)
; CHECK-NEXT:    incq %rax
; CHECK-NEXT:    incq %r8
; CHECK-NEXT:    cmpq %rsi, %r8
; CHECK-NEXT:    je .LBB4_2
; CHECK-NEXT:  # %bb.5: # %check
; CHECK-NEXT:    # in Loop: Header=BB4_4 Depth=1
; CHECK-NEXT:    cmpb $0, (%rdi,%r8)
; CHECK-NEXT:    jne .LBB4_4
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB4_6: # %inner
; CHECK-NEXT:    # Parent Loop BB4_4 Depth=1
; CHECK-NEXT:    # => This Inner Loop Header: Depth=2
; CHECK-NEXT:    leaq (%rcx,%r8), %r9
; CHECK-NEXT:    cmpq $1, %r9
; CHECK-NEXT:    je .LBB4_4
; CHECK-NEXT:  # %bb.7: # %inner.cont
; CHECK-NEXT:    # in Loop: Header=BB4_6 Depth=2
; CHECK-NEXT:    leaq 1(%r8), %r9
; CHECK-NEXT:    cmpb $0, 1(%rdi,%r8)
; CHECK-NEXT:    movq %r9, %r8
; CHECK-NEXT:    je .LBB4_6
; CHECK-NEXT:  # %bb.8: # in Loop: Header=BB4_4 Depth=1
; CHECK-NEXT:    movq %r9, %r8
; CHECK-NEXT:    jmp .LBB4_4
; CHECK-NEXT:  .LBB4_1:
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:  .LBB4_2: # %done
; CHECK-NEXT:    retq
entry:
  %e = icmp eq i64 %n, 0
  br i1 %e, label %done, label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %k = phi i64 [ 0, %entry ], [ %k.next, %latch ]
  %pi = getelementptr inbounds i8, ptr %p, i64 %i
  %x = load i8, ptr %pi, align 1
  %po = getelementptr inbounds i8, ptr %out, i64 %k
  store i8 %x, ptr %po, align 1
  %k.next = add nuw i64 %k, 1
  %i1 = add nuw i64 %i, 1
  %ex = icmp eq i64 %i1, %n
  br i1 %ex, label %done, label %check

check:
  %pj0 = getelementptr inbounds i8, ptr %p, i64 %i1
  %y0 = load i8, ptr %pj0, align 1
  %z0 = icmp eq i8 %y0, 0
  br i1 %z0, label %inner, label %latch

inner:
  %j = phi i64 [ %i1, %check ], [ %j1, %inner.cont ]
  %j1 = add nuw i64 %j, 1
  %ej = icmp eq i64 %j1, %n
  br i1 %ej, label %inner.exit, label %inner.cont

inner.cont:
  %pj = getelementptr inbounds i8, ptr %p, i64 %j1
  %y = load i8, ptr %pj, align 1
  %z = icmp eq i8 %y, 0
  br i1 %z, label %inner, label %inner.exit

inner.exit:
  %j1.lcssa = phi i64 [ %j, %inner ], [ %j1, %inner.cont ]
  br label %latch

latch:
  %i.next = phi i64 [ %i1, %check ], [ %j1.lcssa, %inner.exit ]
  br label %outer

done:
  %r = phi i64 [ 0, %entry ], [ %k.next, %outer ]
  ret i64 %r
}
