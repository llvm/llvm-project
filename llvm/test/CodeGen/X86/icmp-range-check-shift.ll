; CHECK-NEXT:    movabsq $432345564227567616, %rax # imm = 0x600000000000000
; CHECK-NEXT:    addq %rdi, %rax
; CHECK-NEXT:    shrq $58, %rax
; CHECK-NEXT:    cmpl $5, %eax
; CHECK-NEXT:    setb %al
; CHECK-NEXT:    retq
  %offset = add i64 %x, 432345564227567616
