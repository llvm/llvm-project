# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -passes=dead-mi-elimination -o - %s | FileCheck %s

# Physreg defs left unread after deleting their readers are marked dead.
# Reserved registers are not marked.

--- |
  declare i32 @g()

  define void @unread() { ret void }
  define void @read() { ret void }
  define void @succ_livein() { ret void }
  define void @reserved() { ret void }
...
---
name:            unread
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: unread
    ; CHECK: ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def dead $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    ; CHECK-NEXT: CALL64pcrel32 @g, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def dead $eax
    ; CHECK-NEXT: ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def dead $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    ; CHECK-NEXT: RET 0
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    CALL64pcrel32 @g, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = COPY $eax
    RET 0
...
---
name:            read
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: read
    ; CHECK: ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def dead $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    ; CHECK-NEXT: CALL64pcrel32 @g, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    ; CHECK-NEXT: ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def dead $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $eax
    ; CHECK-NEXT: $eax = COPY [[COPY]]
    ; CHECK-NEXT: RET 0, $eax
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    CALL64pcrel32 @g, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = COPY $eax
    $eax = COPY %0
    RET 0, $eax
...
---
name:            succ_livein
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: succ_livein
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def dead $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   CALL64pcrel32 @g, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
  ; CHECK-NEXT:   ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def dead $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET 0, $eax
  bb.0:
    successors: %bb.1

    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    CALL64pcrel32 @g, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = COPY $eax

  bb.1:
    liveins: $eax

    RET 0, $eax
...
---
name:            reserved
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: reserved
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $rsp = COPY $rdi
    ; CHECK-NEXT: RET 0
    $rsp = COPY $rdi
    RET 0
...
