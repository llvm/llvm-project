# RUN: llc -run-pass=prolog-epilog -o - %s | FileCheck %s

# An indirect DBG_VALUE of a frame index with an implicit expression is
# rewritten to load the object with DW_OP_deref_size. That is only valid for an
# object no larger than an address; for a larger one the location is dropped.
--- |
  ; ModuleID = 'dbg.opt.ll'
  source_filename = "dbg.c"
  target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"

  ; Function Attrs: noinline nounwind uwtable
  define dso_local zeroext i16 @foo(i16 zeroext %d0, i16 zeroext %d1, i16 zeroext %d2, i16 zeroext %d3, i16 zeroext %d4, i16 zeroext %d5, i16 zeroext %d6, i16 zeroext %d7, i16 zeroext %d8, i16 signext %x) #0 !dbg !7 {
  entry:
    call void @llvm.dbg.value(metadata i16 %x, metadata !32, metadata !DIExpression(DW_OP_LLVM_convert, 16, DW_ATE_signed, DW_OP_LLVM_convert, 32, DW_ATE_signed, DW_OP_stack_value)), !dbg !34
    ret i16 %x
  }

  define dso_local void @ptrsize() #0 !dbg !40 {
  entry:
    ret void
  }

  define dso_local void @toobig() #0 !dbg !50 {
  entry:
    ret void
  }

  ; Function Attrs: nounwind readnone speculatable
  declare void @llvm.dbg.value(metadata, metadata, metadata) #1

  attributes #0 = { noinline nounwind uwtable }
  attributes #1 = { nounwind readnone speculatable }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4, !5}
  !llvm.ident = !{!6}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang version 9.0.0", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, enums: !2, nameTableKind: None)
  !1 = !DIFile(filename: "dbg.c", directory: "/tmp")
  !2 = !{}
  !3 = !{i32 2, !"Dwarf Version", i32 4}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = !{i32 1, !"wchar_size", i32 4}
  !6 = !{!"clang version 9.0.0"}
  !7 = distinct !DISubprogram(name: "foo", scope: !1, file: !1, line: 2, type: !8, scopeLine: 2, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !2)
  !8 = !DISubroutineType(types: !9)
  !9 = !{!10, !10, !10, !10, !10, !10, !10, !10, !10, !10, !10}
  !10 = !DIDerivedType(tag: DW_TAG_typedef, name: "T", file: !1, line: 1, baseType: !11)
  !11 = !DIBasicType(name: "signed short", size: 16, encoding: DW_ATE_signed)
  !32 = !DILocalVariable(name: "y", scope: !7, file: !1, line: 3, type: !33)
  !33 = !DIBasicType(name: "signed int", size: 32, encoding: DW_ATE_signed)
  !34 = !DILocation(line: 3, column: 20, scope: !7)
  !40 = distinct !DISubprogram(name: "ptrsize", scope: !1, file: !1, line: 5, type: !41, scopeLine: 5, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !2)
  !41 = !DISubroutineType(types: !42)
  !42 = !{null}
  !43 = !DILocalVariable(name: "p", scope: !40, file: !1, line: 6, type: !44)
  !44 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !45 = !DILocation(line: 6, column: 1, scope: !40)
  !50 = distinct !DISubprogram(name: "toobig", scope: !1, file: !1, line: 8, type: !41, scopeLine: 8, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !2)
  !51 = !DILocalVariable(name: "b", scope: !50, file: !1, line: 9, type: !44)
  !52 = !DILocation(line: 9, column: 1, scope: !50)

...
---
name:            foo
tracksRegLiveness: true
fixedStack:
  - { id: 0, type: default, offset: 24, size: 2, alignment: 8, stack-id: default,
      isImmutable: true, isAliased: false, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
stack:           []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    renamable $ax = MOV16rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s16) from %fixed-stack.0, align 8)
    DBG_VALUE %fixed-stack.0, 0, !32, !DIExpression(DW_OP_LLVM_convert, 16, DW_ATE_signed, DW_OP_LLVM_convert, 32, DW_ATE_signed, DW_OP_stack_value), debug-location !34
    RET 0, $ax
...
# CHECK-LABEL: name: foo
# CHECK: machineFunctionInfo
# CHECK: DBG_VALUE $rsp, $noreg, !12, !DIExpression(DW_OP_plus_uconst, {{[0-9]+}}, DW_OP_deref_size, 2, DW_OP_LLVM_convert, 16, DW_ATE_signed, DW_OP_LLVM_convert, 32, DW_ATE_signed, DW_OP_stack_value), debug-location !14

# An 8-byte object is exactly the size of an address, so it is still loaded.
---
name:            ptrsize
tracksRegLiveness: true
stack:
  - { id: 0, type: default, offset: 0, size: 8, alignment: 8, stack-id: default }
body:             |
  bb.0.entry:
    DBG_VALUE %stack.0, 0, !43, !DIExpression(DW_OP_stack_value), debug-location !45
    RET 0
...
# CHECK-LABEL: name: ptrsize
# CHECK: DBG_VALUE $rsp, $noreg, !{{[0-9]+}}, !DIExpression({{.*}}DW_OP_deref_size, 8, DW_OP_stack_value)

# A 16-byte object has no correct implicit value, so its location is dropped.
---
name:            toobig
tracksRegLiveness: true
stack:
  - { id: 0, type: default, offset: 0, size: 16, alignment: 8, stack-id: default }
body:             |
  bb.0.entry:
    DBG_VALUE %stack.0, 0, !51, !DIExpression(DW_OP_stack_value), debug-location !52
    RET 0
...
# CHECK-LABEL: name: toobig
# CHECK: DBG_VALUE $noreg, 0, !{{[0-9]+}}, !DIExpression(DW_OP_stack_value)
