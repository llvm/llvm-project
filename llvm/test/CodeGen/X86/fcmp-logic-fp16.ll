; RUN: llc < %s -mtriple=x86_64-- -mattr=avx512fp16 | FileCheck %s
; RUN: llc < %s -mtriple=x86_64-- -mattr=avx512fp16,avx512vl | FileCheck %s

define i1 @olt_ole_and_f16(half %w, half %x, half %y, half %z) {
; CHECK-LABEL: olt_ole_and_f16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vcmplesh %xmm3, %xmm2, %k0
; CHECK-NEXT:    vcmpltsh %xmm1, %xmm0, %k1
; CHECK-NEXT:    kandw %k0, %k1, %k0
; CHECK-NEXT:    kmovd %k0, %eax
; CHECK-NEXT:    # kill: def $al killed $al killed $eax
; CHECK-NEXT:    retq
  %f1 = fcmp olt half %w, %x
  %f2 = fcmp ole half %y, %z
  %and = and i1 %f1, %f2
  ret i1 %and
}

define i1 @mixed_and5_f16(half %a, half %b, half %c, half %d, half %e, half %f) {
; CHECK-LABEL: mixed_and5_f16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vcmplesh %xmm0, %xmm5, %k0
; CHECK-NEXT:    vcmpneqsh %xmm4, %xmm0, %k1
; CHECK-NEXT:    kandw %k0, %k1, %k0
; CHECK-NEXT:    vcmpeqsh %xmm3, %xmm0, %k1
; CHECK-NEXT:    kandw %k0, %k1, %k0
; CHECK-NEXT:    vcmpltsh %xmm0, %xmm1, %k1
; CHECK-NEXT:    kandw %k0, %k1, %k0
; CHECK-NEXT:    vcmpltsh %xmm2, %xmm0, %k1
; CHECK-NEXT:    kandw %k1, %k0, %k0
; CHECK-NEXT:    kmovd %k0, %eax
; CHECK-NEXT:    # kill: def $al killed $al killed $eax
; CHECK-NEXT:    retq
  %c1 = fcmp ogt half %a, %b
  %c2 = fcmp olt half %a, %c
  %c3 = fcmp oeq half %a, %d
  %c4 = fcmp une half %a, %e
  %c5 = fcmp oge half %a, %f
  %and1 = and i1 %c1, %c2
  %and2 = and i1 %and1, %c3
  %and3 = and i1 %and2, %c4
  %and4 = and i1 %and3, %c5
  ret i1 %and4
}
