# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=regallocfast %s -o - \
# RUN:   | FileCheck %s

# The fast register allocator folds a foldable ("rm") inline asm operand to a
# stack slot when the asm's register operands wouldn't fit otherwise. The
# clobbers below leave six GPRs. The checks are written by hand, since
# update_mir_test_checks.py doesn't check debugValueSubstitutions.

---
# Folding replaces the asm. The values it defines before the folded operand
# keep their operand numbers, so debug values that refer to them by
# instruction number are substituted to the new asm.
# CHECK-LABEL: name: debug_instr_number
# CHECK: debugValueSubstitutions:
# CHECK-NEXT: - { srcinst: 1, srcop: 3, dstinst: 2, dstop: 3, subreg: 0 }
# CHECK: INLINEASM &"", sideeffect mayload attdialect, regdef-ec:GR64, def early-clobber renamable $rcx, {{.*}}, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, {{.*}}, debug-instr-number 2
name: debug_instr_number
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr64 = COPY $rdx
    %3:gr64 = COPY $rcx
    %4:gr64 = COPY $r8
    %5:gr64 = COPY $r9
    INLINEASM &"", sideeffect attdialect, regdef-ec:GR64, def early-clobber %6:gr64, reguse:GR64, %1, reguse:GR64, %2, reguse:GR64, %3, reguse:GR64, %4, reguse:GR64, %5, reguse:GR64 foldable, %0, clobber, implicit-def early-clobber $rax, clobber, implicit-def early-clobber $rbx, clobber, implicit-def early-clobber $rbp, clobber, implicit-def early-clobber $r10, clobber, implicit-def early-clobber $r11, clobber, implicit-def early-clobber $r12, clobber, implicit-def early-clobber $r13, clobber, implicit-def early-clobber $r14, clobber, implicit-def early-clobber $r15, debug-instr-number 1
    $rax = COPY %6
    RET 0, $rax
...
