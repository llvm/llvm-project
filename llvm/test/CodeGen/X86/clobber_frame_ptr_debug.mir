# RUN: llc -mtriple=x86_64 -run-pass=prolog-epilog -o - %s | FileCheck %s

# When inline asm clobbers the frame pointer, the 8-byte stack adjustment can
# be undone with a pop into a dead register. A debug instruction before the
# return must not prevent that size optimization. Keep the DBG_VALUE before the
# inserted pop so the pop ends its $rax location.

--- |
  define void @f() #0 !dbg !3 {
    ret void
  }

  define void @failed_lookup() #0 !dbg !9 {
    ret void
  }

  attributes #0 = { nounwind "frame-pointer"="all" }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !4 = !DISubroutineType(types: !5)
  !5 = !{null}
  !6 = !DILocalVariable(name: "x", scope: !3, file: !1, line: 2, type: !7)
  !7 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 0, scope: !3)
  !9 = distinct !DISubprogram(name: "failed_lookup", scope: !1, file: !1, line: 3, type: !4, scopeLine: 3, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !10 = !DILocalVariable(name: "y", scope: !9, file: !1, line: 4, type: !7)
  !11 = !DILocation(line: 0, scope: !9)
...
---
name:            f
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: f
    ; CHECK: INLINEASM
    ; CHECK-NEXT: DBG_VALUE $rax, $noreg
    ; CHECK-NEXT: $rax = frame-destroy POP64r
    ; CHECK: $rbp = POP64r
    ; CHECK-NOT: ADD64ri32 $rsp, 8
    ; CHECK: RET 0
    INLINEASM &"movq %rax, $0", sideeffect attdialect, regdef:GR64, def renamable $rax, clobber, implicit-def dead early-clobber $rbp
    DBG_VALUE $rax, $noreg, !6, !DIExpression(), debug-location !8
    RET 0
...
---
name:            failed_lookup
tracksRegLiveness: true
body:             |
  bb.0:
    ; A failed search must not move the stack-adjustment insertion point past
    ; the debug instruction.
    ; CHECK-LABEL: name: failed_lookup
    ; CHECK: INLINEASM
    ; CHECK-NEXT: $rsp = frame-destroy ADD64ri32 $rsp, 8
    ; CHECK: DBG_VALUE
    ; CHECK-NEXT: NOOP
    ; CHECK: RET 0
    INLINEASM &"movq %rax, $0", sideeffect attdialect, regdef:GR64, def renamable $rax, clobber, implicit-def dead early-clobber $rbp
    DBG_VALUE 3, $noreg, !10, !DIExpression(), debug-location !11
    NOOP
    RET 0
...
