# An undef push operand has no defining instruction and must not crash

--- |
  target triple = "i686-unknown-linux-gnu"
  declare void @g(i32, i32)
  define void @undef_push(i32 %x) { ret void }
...
---
name:            undef_push
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edi

    ; CHECK-LABEL: name: undef_push
    ; CHECK: liveins: $edi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
    ; CHECK-NEXT: ADJCALLSTACKDOWN32 8, 0, 8, implicit-def dead $esp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $esp, implicit $ssp
    ; CHECK-NEXT: PUSH32r [[COPY]], implicit-def $esp, implicit $esp :: (store (s32) into stack + 4)
    ; CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset 4
    ; CHECK-NEXT: PUSH32r undef %2:gr32, implicit-def $esp, implicit $esp :: (store (s32) into stack)
    ; CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset 4
    ; CHECK-NEXT: CALLpcrel32 target-flags(x86-plt) @g, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
    ; CHECK-NEXT: ADJCALLSTACKUP32 8, 0, implicit-def dead $esp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $esp, implicit $ssp
    ; CHECK-NEXT: RET32
    %0:gr32 = COPY $edi
    ADJCALLSTACKDOWN32 8, 0, 0, implicit-def dead $esp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $esp, implicit $ssp
    %1:gr32 = COPY $esp
    MOV32mr %1, 1, $noreg, 4, $noreg, %0 :: (store (s32) into stack + 4)
    MOV32mr %1, 1, $noreg, 0, $noreg, undef %2:gr32 :: (store (s32) into stack)
    CALLpcrel32 target-flags(x86-plt) @g, csr_32, implicit $esp, implicit $ssp, implicit-def $esp, implicit-def $ssp
    ADJCALLSTACKUP32 8, 0, implicit-def dead $esp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $esp, implicit $ssp
    RET32
...
