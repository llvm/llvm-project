# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-- -mcpu=sapphirerapids -passes=machine-combiner %s -o - | FileCheck %s

--- |

  ; The vpshufb replacing the rotate keeps its debug instruction number.
  define <8 x i32> @rotate(ptr %p, i1 %c) !dbg !4 {
  entry:
    %v = load <8 x i32>, ptr %p, align 32
    %e = call <8 x i32> @llvm.fshl.v8i32(<8 x i32> %v, <8 x i32> %v, <8 x i32> splat (i32 3))
    %m = mul <8 x i32> %v, %e
    br i1 %c, label %then, label %exit

  then:                                             ; preds = %entry
    %r = call <8 x i32> @llvm.fshl.v8i32(<8 x i32> %m, <8 x i32> %m, <8 x i32> splat (i32 24))
      #dbg_value(<8 x i32> %r, !7, !DIExpression(), !12)
    br label %exit

  exit:                                             ; preds = %then, %entry
    %s = phi <8 x i32> [ %r, %then ], [ %m, %entry ]
    ret <8 x i32> %s
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 7, !"Dwarf Version", i32 5}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "rotate", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !5 = !DISubroutineType(types: !6)
  !6 = !{null}
  !7 = !DILocalVariable(name: "r", scope: !4, file: !1, line: 2, type: !8)
  !8 = !DICompositeType(tag: DW_TAG_array_type, baseType: !9, size: 256, flags: DIFlagVector, elements: !10)
  !9 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !10 = !{!11}
  !11 = !DISubrange(count: 8)
  !12 = !DILocation(line: 2, scope: !4)
...
---
name:            rotate
debugInstrRef:   true
liveins:
  - { reg: '$rdi', virtual-reg: '%3' }
  - { reg: '$esi', virtual-reg: '%4' }
body:             |
  ; CHECK-LABEL: name: rotate
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr8 = COPY [[COPY]].sub_8bit
  ; CHECK-NEXT:   [[VMOVDQA64Z256rm:%[0-9]+]]:vr256x = VMOVDQA64Z256rm [[COPY1]], 1, $noreg, 0, $noreg :: (load (s256) from %ir.p)
  ; CHECK-NEXT:   [[VPROLDZ256ri:%[0-9]+]]:vr256x = VPROLDZ256ri [[VMOVDQA64Z256rm]], 3
  ; CHECK-NEXT:   [[VPMULLDZ256rr:%[0-9]+]]:vr256x = VPMULLDZ256rr [[VMOVDQA64Z256rm]], [[VPROLDZ256ri]]
  ; CHECK-NEXT:   TEST8ri [[COPY2]], 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.then:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[VBROADCASTI32X4Z256rm:%[0-9]+]]:vr256x = VBROADCASTI32X4Z256rm $rip, 1, $noreg, %const.0, $noreg :: (dereferenceable invariant load (s128) from constant-pool)
  ; CHECK-NEXT:   [[VPSHUFBZ256rr:%[0-9]+]]:vr256x = VPSHUFBZ256rr [[VPMULLDZ256rr]], [[VBROADCASTI32X4Z256rm]], debug-instr-number 1
  ; CHECK-NEXT:   DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.exit:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vr256x = PHI [[VPMULLDZ256rr]], %bb.0, [[VPSHUFBZ256rr]], %bb.1
  ; CHECK-NEXT:   $ymm0 = COPY [[PHI]]
  ; CHECK-NEXT:   RET 0, $ymm0
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $rdi, $esi

    %4:gr32 = COPY $esi
    %3:gr64 = COPY $rdi
    %5:gr8 = COPY %4.sub_8bit
    %6:vr256x = VMOVDQA64Z256rm %3, 1, $noreg, 0, $noreg :: (load (s256) from %ir.p)
    %7:vr256x = VPROLDZ256ri %6, 3
    %0:vr256x = VPMULLDZ256rr %6, %7
    TEST8ri %5, 1, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1.then:
    %1:vr256x = VPROLDZ256ri %0, 24, debug-instr-number 1
    DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !12

  bb.2.exit:
    %2:vr256x = PHI %0, %bb.0, %1, %bb.1
    $ymm0 = COPY %2
    RET 0, $ymm0
...
