; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

; %join has the same PHI as %lpad and %indirect. Check that the PHI copies for
; %lpad are emitted before the call to may_throw, and the ones for %indirect
; before the inline asm. The uses of %x and %y keep the copies from being
; coalesced.

declare void @may_throw()
declare void @use(i64, i64, i64)
declare i32 @__gxx_personality_v0(...)

define void @landing_pad(i64 %x, i64 %y, i1 %c) personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: landing_pad:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %r15
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    .cfi_def_cfa_offset 24
; CHECK-NEXT:    pushq %r12
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    .cfi_def_cfa_offset 40
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 48
; CHECK-NEXT:    .cfi_offset %rbx, -40
; CHECK-NEXT:    .cfi_offset %r12, -32
; CHECK-NEXT:    .cfi_offset %r14, -24
; CHECK-NEXT:    .cfi_offset %r15, -16
; CHECK-NEXT:    movq %rsi, %rbx
; CHECK-NEXT:    movq %rdi, %r14
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB0_2
; CHECK-NEXT:  # %bb.1: # %a
; CHECK-NEXT:  .Ltmp2: # EH_LABEL
; CHECK-NEXT:    movq %r14, %r15
; CHECK-NEXT:    callq may_throw@PLT
; CHECK-NEXT:  .Ltmp3: # EH_LABEL
; CHECK-NEXT:    movq %r14, %rdx
; CHECK-NEXT:    jmp .LBB0_3
; CHECK-NEXT:  .LBB0_2: # %b
; CHECK-NEXT:  .Ltmp0: # EH_LABEL
; CHECK-NEXT:    movq %rbx, %r15
; CHECK-NEXT:    callq may_throw@PLT
; CHECK-NEXT:  .Ltmp1: # EH_LABEL
; CHECK-NEXT:    movq %rbx, %rdx
; CHECK-NEXT:  .LBB0_3: # %join
; CHECK-NEXT:    movq %r14, %rdi
; CHECK-NEXT:    movq %rbx, %rsi
; CHECK-NEXT:    callq use@PLT
; CHECK-NEXT:    addq $8, %rsp
; CHECK-NEXT:    .cfi_def_cfa_offset 40
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    popq %r12
; CHECK-NEXT:    .cfi_def_cfa_offset 24
; CHECK-NEXT:    popq %r14
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    popq %r15
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_4: # %lpad
; CHECK-NEXT:    .cfi_def_cfa_offset 48
; CHECK-NEXT:  .Ltmp4: # EH_LABEL
; CHECK-NEXT:    movq %rax, %r12
; CHECK-NEXT:    movq %r14, %rdi
; CHECK-NEXT:    movq %rbx, %rsi
; CHECK-NEXT:    movq %r15, %rdx
; CHECK-NEXT:    callq use@PLT
; CHECK-NEXT:    movq %r12, %rdi
; CHECK-NEXT:    callq _Unwind_Resume@PLT
entry:
  br i1 %c, label %a, label %b

a:
  invoke void @may_throw()
          to label %join unwind label %lpad

b:
  invoke void @may_throw()
          to label %join unwind label %lpad

join:
  %pj = phi i64 [ %x, %a ], [ %y, %b ]
  call void @use(i64 %x, i64 %y, i64 %pj)
  ret void

lpad:
  %pl = phi i64 [ %x, %a ], [ %y, %b ]
  %lp = landingpad { ptr, i32 }
          cleanup
  call void @use(i64 %x, i64 %y, i64 %pl)
  resume { ptr, i32 } %lp
}

define i1 @callbr(i64 %x, i64 %y, i1 %c) nounwind {
; CHECK-LABEL: callbr:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB1_2
; CHECK-NEXT:  # %bb.1: # %a
; CHECK-NEXT:    movq %rdi, %rdx
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    jmp .LBB1_3
; CHECK-NEXT:  .LBB1_4: # Inline asm indirect target
; CHECK-NEXT:    # %indirect
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    callq use@PLT
; CHECK-NEXT:    movb $1, %al
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB1_2: # %b
; CHECK-NEXT:    movq %rsi, %rdx
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    movq %rsi, %rax
; CHECK-NEXT:  .LBB1_3: # %join
; CHECK-NEXT:    movq %rax, %rdx
; CHECK-NEXT:    callq use@PLT
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %a, label %b

a:
  callbr void asm "", "!i"()
          to label %join [label %indirect]

b:
  callbr void asm "", "!i"()
          to label %join [label %indirect]

join:
  %pj = phi i64 [ %x, %a ], [ %y, %b ]
  call void @use(i64 %x, i64 %y, i64 %pj)
  ret i1 false

indirect:
  %pi = phi i64 [ %x, %a ], [ %y, %b ]
  call void @use(i64 %x, i64 %y, i64 %pi)
  ret i1 true
}
