# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=i686-unknown-linux-gnu -run-pass=regallocfast \
# RUN:   -verify-regalloc %s -o - | FileCheck %s

---
# On i686, only EAX, EBX, ECX, and EDX have byte registers. The asm's clobbers
# and fixed inputs take all four, and ESI and EBP, leaving EDI. So both "rm"
# inputs are folded, and the 16-bit "r" input takes DI, which has no byte
# register.
name:            word_r_without_byte_regs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $eax, $ebx, $ecx, $edx, $esi

    ; CHECK-LABEL: name: word_r_without_byte_regs
    ; CHECK: liveins: $eax, $ebx, $ecx, $edx, $esi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: MOV8mr %stack.0, 1, $noreg, 0, $noreg, killed renamable $bl :: (store (s8) into %stack.0)
    ; CHECK-NEXT: renamable $di = COPY killed $dx
    ; CHECK-NEXT: MOV32mr %stack.1, 1, $noreg, 0, $noreg, killed renamable $eax :: (store (s32) into %stack.1)
    ; CHECK-NEXT: INLINEASM &"", sideeffect mayload attdialect, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, reguse:GR16, killed renamable $di, mem:m ops:5, %stack.1, 1, $noreg, 0, $noreg, reguse, killed $ecx, reguse, killed $esi, clobber, implicit-def dead early-clobber $eax, clobber, implicit-def dead early-clobber $ebx, clobber, implicit-def dead early-clobber $edx, clobber, implicit-def dead early-clobber $ebp :: (load (s8) from %stack.0), (load (s32) from %stack.1)
    ; CHECK-NEXT: RET 0
    %0:gr8 = COPY $bl
    %1:gr16 = COPY $dx
    %2:gr32 = COPY $eax
    %3:gr32 = COPY $ecx
    %4:gr32 = COPY $esi
    $ecx = COPY %3
    $esi = COPY %4
    INLINEASM &"", sideeffect attdialect, reguse:GR8 foldable, %0, reguse:GR16, %1, reguse:GR32 foldable, %2, reguse, $ecx, reguse, $esi, clobber, implicit-def early-clobber $eax, clobber, implicit-def early-clobber $ebx, clobber, implicit-def early-clobber $edx, clobber, implicit-def early-clobber $ebp
    RET 0
...
---
# The asm's clobbers leave ECX and EDI, and its byte inputs need ECX's byte
# registers. Counting each register as the most registers of a class it can
# take, folding can't make the operands fit, so only what they need at the
# fewest is folded: the byte "rm" input. Folding the "rm" output too would let
# the tied output take ECX, which this allocator assigns before the inputs,
# leaving no register for the byte "r" input.
name:            fewest_folds
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $eax, $ecx

    ; CHECK-LABEL: name: fewest_folds
    ; CHECK: liveins: $eax, $ecx
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $edi = COPY killed $eax
    ; CHECK-NEXT: renamable $al = MOV8ri 60
    ; CHECK-NEXT: MOV8mr %stack.0, 1, $noreg, 0, $noreg, killed renamable $al :: (store (s8) into %stack.0)
    ; CHECK-NEXT: INLINEASM &"", sideeffect mayload attdialect, regdef:GR16 foldable, def renamable $cx, regdef:GR32, def renamable $edi, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, reguse:GR8, killed renamable $cl, reguse tiedto:$1, killed renamable $edi(tied-def 5), clobber, implicit-def early-clobber $eax, clobber, implicit-def dead early-clobber $ebx, clobber, implicit-def dead early-clobber $ebp, clobber, implicit-def dead early-clobber $esi, clobber, implicit-def dead early-clobber $edx :: (load (s8) from %stack.0)
    ; CHECK-NEXT: MOV32mr %stack.1, 1, $noreg, 0, $noreg, $edi :: (store (s32) into %stack.1)
    ; CHECK-NEXT: $eax = MOV32rm %stack.1, 1, $noreg, 0, $noreg :: (load (s32) from %stack.1)
    ; CHECK-NEXT: MOV16mr $noreg, 1, $noreg, 0, $noreg, killed renamable $cx :: (store (s16))
    ; CHECK-NEXT: MOV32mr $noreg, 1, $noreg, 4, $noreg, killed renamable $eax :: (store (s32))
    ; CHECK-NEXT: RET 0
    %0:gr32 = COPY $eax
    %1:gr8 = COPY $cl
    %2:gr8 = MOV8ri 60
    %3:gr32 = COPY %0
    INLINEASM &"", sideeffect attdialect, regdef:GR16 foldable, def %4:gr16, regdef:GR32, def %5:gr32, reguse:GR8 foldable, %2, reguse:GR8, %1, reguse tiedto:$1, %3(tied-def 5), clobber, implicit-def early-clobber $eax, clobber, implicit-def early-clobber $ebx, clobber, implicit-def early-clobber $ebp, clobber, implicit-def early-clobber $esi, clobber, implicit-def early-clobber $edx
    MOV16mr $noreg, 1, $noreg, 0, $noreg, %4 :: (store (s16))
    MOV32mr $noreg, 1, $noreg, 4, $noreg, %5 :: (store (s32))
    RET 0
...
