# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "bb\.(0|3|6):" --filter "LFENCE" --filter "MOV64rm" --filter "DBG_VALUE" --filter "ADD32rm" --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -x86-lvi-load-no-cbranch \
# RUN:   -run-pass=x86-lvi-load -verify-machineinstrs -o - %s | FileCheck %s

# A debug instruction at the start of the join block must not become its LVI
# gadget-graph representative or move the fence away from the pointer load.

--- |
  target triple = "x86_64-unknown-linux-gnu"

  define i32 @debug_leader(ptr %pointer_slot, ptr %control, i32 %limit) #0 !dbg !3 {
  entry:
    %loaded.pointer = load ptr, ptr %pointer_slot
    ret i32 0
  }

  attributes #0 = { "target-features"="+lvi-load-hardening" }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "debug_leader", scope: !1, file: !1, line: 1, type: !4, unit: !0, retainedNodes: !6)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !{!7}
  !7 = !DILocalVariable(name: "pointer", scope: !3, file: !1, line: 1)
  !8 = !DILocation(line: 1, scope: !3)
...
---
name:            debug_leader
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: debug_leader
  ; CHECK: bb.0:
  ; CHECK:   LFENCE
  ; CHECK: bb.1:
  ; CHECK: bb.2:
  ; CHECK: bb.3:
  ; CHECK:   renamable $r8 = MOV64rm renamable $rdi, 1, $noreg, 0, $noreg :: (load (s64) from %ir.pointer_slot)
  ; CHECK-NEXT:   LFENCE
  ; CHECK: bb.4:
  ; CHECK: bb.5:
  ; CHECK: bb.6:
  ; CHECK:   DBG_VALUE $r8, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   renamable $eax = ADD32rm killed renamable $eax, killed renamable $r8, 1, $noreg, 0, $noreg, implicit-def dead $eflags :: (load (s32) from %ir.loaded.pointer)
  ; CHECK: bb.7:
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $edx, $rdi, $rsi

    renamable $eax = MOV32r0 implicit-def dead $eflags
    renamable $ecx = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2(0x7c000000), %bb.7(0x04000000)
    liveins: $eax, $ecx, $edx, $rdi, $rsi

    CMP32rr renamable $ecx, renamable $edx, implicit-def $eflags
    JCC_1 %bb.7, 13, implicit killed $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.3(0x80000000)
    liveins: $eax, $ecx, $edx, $rdi, $rsi

  bb.3:
    successors: %bb.6(0x04000000), %bb.4(0x7c000000)
    liveins: $eax, $ecx, $edx, $rdi, $rsi

    renamable $r8 = MOV64rm renamable $rdi, 1, $noreg, 0, $noreg :: (load (s64) from %ir.pointer_slot)
    renamable $r9d = MOV32rm renamable $rsi, 1, $noreg, 0, $noreg :: (volatile load (s32) from %ir.control)
    CMP32ri killed renamable $r9d, 1, implicit-def $eflags
    JCC_1 %bb.6, 4, implicit killed $eflags
    JMP_1 %bb.4

  bb.4:
    successors: %bb.6(0x04000000), %bb.5(0x7c000000)
    liveins: $eax, $ecx, $edx, $rdi, $rsi, $r8

    renamable $r9d = MOV32rm renamable $rsi, 1, $noreg, 0, $noreg :: (volatile load (s32) from %ir.control)
    CMP32ri killed renamable $r9d, 2, implicit-def $eflags
    JCC_1 %bb.6, 4, implicit killed $eflags
    JMP_1 %bb.5

  bb.5:
    successors: %bb.3(0x80000000)
    liveins: $eax, $ecx, $edx, $rdi, $rsi

    INLINEASM &"", sideeffect mayload maystore attdialect
    JMP_1 %bb.3

  bb.6:
    successors: %bb.1(0x80000000)
    liveins: $eax, $ecx, $edx, $rdi, $rsi, $r8

    DBG_VALUE $r8, $noreg, !7, !DIExpression(), debug-location !8
    renamable $eax = ADD32rm killed renamable $eax, killed renamable $r8, 1, $noreg, 0, $noreg, implicit-def dead $eflags :: (load (s32) from %ir.loaded.pointer)
    renamable $ecx = nuw nsw INC32r killed renamable $ecx, implicit-def dead $eflags
    JMP_1 %bb.1

  bb.7:
    liveins: $eax

    RET 0, $eax
...
