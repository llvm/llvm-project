; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=x86_64-unknown-linux -pre-RA-sched=fast < %s | FileCheck %s

; Test that the fast scheduler correctly handles the case where a node being
; scheduled is itself the live physical register definition (EFLAGS). Previously,
; DelayForLiveRegsBottomUp would incorrectly delay such a node, leading to an
; infinite loop of register copy insertion and a scheduling failure assertion.

define i1 @PR130730(i32 %0) {
; CHECK-LABEL: PR130730:
; CHECK:       # %bb.0:
; CHECK-NEXT:    btl $1, %edi
; CHECK-NEXT:    sbbl $0, %edi
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %and176 = lshr i32 %0, 1
  %and176.lobit = and i32 %and176, 1
  %cmp179 = icmp eq i32 %0, %and176.lobit
  ret i1 %cmp179
}

; Same edge case, this time reached through inline asm that clobbers EFLAGS
; and feeds the bit-test idiom.
define i1 @PR130730_inline_asm(i32 %0) {
; CHECK-LABEL: PR130730_inline_asm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    #APP
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    btl $1, %eax
; CHECK-NEXT:    sbbl $0, %eax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    retq
  %a = call i32 asm sideeffect "movl $1, $0", "=r,r,~{flags}"(i32 %0)
  %and = lshr i32 %a, 1
  %lobit = and i32 %and, 1
  %cmp = icmp eq i32 %a, %lobit
  ret i1 %cmp
}
