; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64-- -relocation-model=pic < %s | FileCheck %s

; Regression test for the LEA already-materialized-value reuse (issue #51707):
; when one addend is a RIP-relative global and the other is a materialized
; multi-use value, the reuse path must not fold both into a single LEA. A
; %rip-relative address ([%rip + disp32]) takes no register beyond RIP itself -
; no additional base and no index - so folding the value in formed an invalid
; address that asserted "Invalid rip-relative address" in the MC encoder. The
; materialized value must stay separate from the RIP base.

@table = dso_local global [1024 x i32] zeroinitializer
@sink = dso_local global i64 0

define ptr @rip_plus_materialized(i64 %x, i64 %y, i64 %z) {
; CHECK-LABEL: rip_plus_materialized:
; CHECK:       # %bb.0:
; CHECK-NEXT:    leaq (%rdi,%rsi), %rcx
; CHECK-NEXT:    addq %rdx, %rcx
; CHECK-NEXT:    movq %rcx, .Lsink$local(%rip)
; CHECK-NEXT:    leaq .Ltable$local(%rip), %rax
; CHECK-NEXT:    addq %rcx, %rax
; CHECK-NEXT:    retq
  %b0 = add i64 %x, %y
  %b = add i64 %b0, %z
  store i64 %b, ptr @sink
  %base = ptrtoint ptr @table to i64
  %addr = add i64 %base, %b
  %p = inttoptr i64 %addr to ptr
  ret ptr %p
}
