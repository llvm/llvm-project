; BW-NEXT:    kmovd %k0, %eax
; BW-NEXT:    andl $3, %eax
; BW-NEXT:    vzeroupper
; BW-NEXT:    retq
;
; DQ-LABEL: mask_and_zext_i8_i32:
; DQ:       # %bb.0:
; DQ-NEXT:    vpmovq2m %zmm0, %k0
; DQ-NEXT:    kmovd %k0, %eax
; DQ-NEXT:    andl $3, %eax
; DQ-NEXT:    vzeroupper
; DQ-NEXT:    retq
  %cmp = icmp slt <8 x i64> %0, zeroinitializer
  %bc = bitcast <8 x i1> %cmp to i8
  %and = and i8 %bc, 3
  %ext = zext i8 %and to i32
  ret i32 %ext
}

