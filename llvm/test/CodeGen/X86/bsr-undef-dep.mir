# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -run-pass=break-false-deps -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64 -passes=break-false-deps -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64 -run-pass=break-false-deps -undef-reg-clearance=0 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=NOBREAK --implicit-check-not=XOR32rr
# NOBREAK: name: undef64
# BSR's tied fallback is a true dependency when defined. Undef fallbacks may
# be cleared only if the register is otherwise dead before the instruction.
--- |
  define void @undef64() { ret void }
  define void @undef32() { ret void }
  define void @memory64() { ret void }
  define void @memory32() { ret void }
  define void @fallback64() { ret void }
  define void @fallback32() { ret void }
  define void @same_source() { ret void }
  define void @address_uses_dest() { ret void }
  define void @partial16() { ret void }
  define void @zero_flag() { ret void }
  define void @min_size() minsize { ret void }
...
---
name: undef64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi

    ; CHECK-LABEL: name: undef64
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $rax = COPY $rsi
    ; CHECK-NEXT: $eax = XOR32rr undef $eax, undef $eax, implicit-def $eflags, implicit-def $rax
    ; CHECK-NEXT: $rax = BSR64rr undef $rax, $rdi, implicit-def dead $eflags, implicit killed $rax
    ; CHECK-NEXT: RET64 $rax
    $rax = COPY $rsi
    $rax = BSR64rr undef $rax, $rdi, implicit-def dead $eflags
    RET64 $rax
...
