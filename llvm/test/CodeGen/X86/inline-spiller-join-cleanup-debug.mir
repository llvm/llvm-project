# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=greedy,virt-reg-rewriter -stress-regalloc=4 -verify-machineinstrs -verify-regalloc -enable-spill-join-cleanup=false %s -o - | FileCheck %s --check-prefixes=CHECK,OFF
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=greedy,virt-reg-rewriter -stress-regalloc=4 -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s --check-prefixes=CHECK,ON
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -passes=greedy,virt-reg-rewriter -stress-regalloc=4 -verify-machineinstrs -verify-regalloc -enable-spill-join-cleanup=false %s -o - | FileCheck %s --check-prefixes=CHECK,OFF
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -passes=greedy,virt-reg-rewriter -stress-regalloc=4 -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s --check-prefixes=CHECK,ON

# This uses the initialized accumulator pattern in inline-spiller-join-cleanup.mir.
# bb.2 replaces one accumulator with a load; bb.3 keeps the first loop's value.
# Greedy reloads the spilled value in bb.3 and stores the merged value in bb.4.
# Cleanup moves the store to bb.2 and deletes the bb.3 reload. The split register
# survives in bb.2, so deleting it entirely cannot repair its debug locations.
# Check that the deleted path no longer names that physical register, while
# the valid register location in bb.2 and the spill-slot location are retained.

# CHECK-LABEL: name: partial_join
# CHECK: bb.2:
# CHECK: [[REG:renamable \$xmm[0-9]+]] = MOVDQUrm
# CHECK-NEXT: DBG_VALUE [[PHYS:\$xmm[0-9]+]], $noreg,
# ON-NEXT: MOVAPSmr [[SLOT:%stack.[0-9]+]], 1, $noreg, 0, $noreg, killed [[REG]]
# ON-NEXT: DBG_VALUE $noreg, $noreg,
# CHECK-NEXT: JMP_1 %bb.4
# CHECK: bb.3:
# OFF: DBG_VALUE [[SLOT:%stack.[0-9]+]], 0,
# ON: DBG_VALUE [[SLOT]], 0,
# OFF: [[REG]] = MOVAPSrm [[SLOT]],
# OFF-NEXT: DBG_VALUE [[PHYS]], $noreg,
# ON-NOT: [[REG]] = MOVAPSrm [[SLOT]]
# ON-NOT: DBG_VALUE [[PHYS]],
# ON: DBG_VALUE $noreg, $noreg,
# CHECK-NEXT: JMP_1 %bb.4
# CHECK: bb.4:
# OFF: DBG_VALUE [[PHYS]], $noreg,
# OFF-NEXT: MOVAPSmr [[SLOT]], 1, $noreg, 0, $noreg, killed [[REG]]
# ON-NOT: MOVAPSmr [[SLOT]]
# ON-NOT: DBG_VALUE [[PHYS]],
# CHECK: DBG_VALUE [[SLOT]], 0,
# CHECK: JMP_1 %bb.5

--- |
  define void @partial_join() !dbg !4 { ret void }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!9}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !DISubroutineType(types: !3)
  !3 = !{}
  !4 = distinct !DISubprogram(name: "partial_join", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !3)
  !5 = !DIBasicType(name: "vector", size: 128, encoding: DW_ATE_signed)
  !6 = !DILocalVariable(name: "acc", scope: !4, file: !1, line: 2, type: !5)
  !8 = !DILocation(line: 2, column: 1, scope: !4)
  !9 = !{i32 2, !"Debug Info Version", i32 3}
...
---
name: partial_join
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi, $edx, $ecx, $xmm0, $xmm1
    %0:gr64 = COPY $rdi
    %1:gr32 = COPY $edx
    %2:gr32 = COPY $ecx
    %3:vr128 = COPY $xmm0
    %4:vr128 = COPY $xmm1
    %5:vr128 = COPY %3
    %5:vr128 = PADDDrr %5, %4
    %6:vr128 = COPY %5
    %6:vr128 = PADDDrr %6, %4
    %7:vr128 = COPY %6
    %7:vr128 = PADDDrr %7, %4
    %8:vr128 = COPY %7
    %8:vr128 = PADDDrr %8, %4
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.1(0x78000000), %bb.3(0x08000000)
    %5:vr128 = PADDDrr %5, %4
    %6:vr128 = PADDDrr %6, %4
    %7:vr128 = PADDDrr %7, %4
    %8:vr128 = PADDDrr %8, %4
    %1:gr32 = SUB32ri8 %1, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.3
  bb.2:
    successors: %bb.4
    %5:vr128 = MOVDQUrm %0, 1, $noreg, 0, $noreg :: (load (s128))
    DBG_VALUE %5, $noreg, !6, !DIExpression(), debug-location !8
    JMP_1 %bb.4
  bb.3:
    successors: %bb.4
    DBG_VALUE %5, $noreg, !6, !DIExpression(), debug-location !8
    JMP_1 %bb.4
  bb.4:
    successors: %bb.5
    DBG_VALUE %5, $noreg, !6, !DIExpression(), debug-location !8
    JMP_1 %bb.5
  bb.5:
    successors: %bb.5(0x78000000), %bb.6(0x08000000)
    %9:vr128 = MOVDQUrm %0, 1, $noreg, 0, $noreg :: (load (s128))
    %10:vr128 = COPY %9
    %10:vr128 = PADDDrr %10, %5
    MOVDQUmr %0, 1, $noreg, 0, $noreg, %10 :: (store (s128))
    %11:vr128 = MOVDQUrm %0, 1, $noreg, 16, $noreg :: (load (s128))
    %12:vr128 = COPY %11
    %12:vr128 = PADDDrr %12, %6
    MOVDQUmr %0, 1, $noreg, 16, $noreg, %12 :: (store (s128))
    %13:vr128 = MOVDQUrm %0, 1, $noreg, 32, $noreg :: (load (s128))
    %14:vr128 = COPY %13
    %14:vr128 = PADDDrr %14, %7
    MOVDQUmr %0, 1, $noreg, 32, $noreg, %14 :: (store (s128))
    %15:vr128 = MOVDQUrm %0, 1, $noreg, 48, $noreg :: (load (s128))
    %16:vr128 = COPY %15
    %16:vr128 = PADDDrr %16, %8
    MOVDQUmr %0, 1, $noreg, 48, $noreg, %16 :: (store (s128))
    %2:gr32 = SUB32ri8 %2, 1, implicit-def $eflags
    JCC_1 %bb.5, 5, implicit $eflags
    JMP_1 %bb.6
  bb.6:
    RET 0
...
