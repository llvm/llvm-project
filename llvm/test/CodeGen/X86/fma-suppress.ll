; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+fma -fp-contract=fast | FileCheck %s --check-prefixes=FMA
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+fma,+suppress-fma-fusion -fp-contract=fast | FileCheck %s --check-prefixes=SUPPRESS

; With -fp-contract=fast the FMUL/FADD pair is contracted into an FMA by
; default. The +suppress-fma-fusion X86 tuning feature only allows the
; contraction when the FMUL itself carries a local 'contract' flag.

define float @fmul_fadd(float %a, float %b, float %c) {
; FMA-LABEL: fmul_fadd:
; FMA:       # %bb.0:
; FMA-NEXT:    vfmadd213ss {{.*#+}} xmm0 = (xmm1 * xmm0) + xmm2
; FMA-NEXT:    retq
;
; SUPPRESS-LABEL: fmul_fadd:
; SUPPRESS:       # %bb.0:
; SUPPRESS-NEXT:    vmulss %xmm1, %xmm0, %xmm0
; SUPPRESS-NEXT:    vaddss %xmm2, %xmm0, %xmm0
; SUPPRESS-NEXT:    retq
  %m = fmul float %a, %b
  %r = fadd float %m, %c
  ret float %r
}

; The local 'contract' flag on the FMUL is honoured even with suppression on.
define float @fmul_fadd_contract(float %a, float %b, float %c) {
; FMA-LABEL: fmul_fadd_contract:
; FMA:       # %bb.0:
; FMA-NEXT:    vfmadd213ss {{.*#+}} xmm0 = (xmm1 * xmm0) + xmm2
; FMA-NEXT:    retq
;
; SUPPRESS-LABEL: fmul_fadd_contract:
; SUPPRESS:       # %bb.0:
; SUPPRESS-NEXT:    vfmadd213ss {{.*#+}} xmm0 = (xmm1 * xmm0) + xmm2
; SUPPRESS-NEXT:    retq
  %m = fmul contract float %a, %b
  %r = fadd contract float %m, %c
  ret float %r
}

define float @fmul_fsub(float %a, float %b, float %c) {
; FMA-LABEL: fmul_fsub:
; FMA:       # %bb.0:
; FMA-NEXT:    vfmsub213ss {{.*#+}} xmm0 = (xmm1 * xmm0) - xmm2
; FMA-NEXT:    retq
;
; SUPPRESS-LABEL: fmul_fsub:
; SUPPRESS:       # %bb.0:
; SUPPRESS-NEXT:    vmulss %xmm1, %xmm0, %xmm0
; SUPPRESS-NEXT:    vsubss %xmm2, %xmm0, %xmm0
; SUPPRESS-NEXT:    retq
  %m = fmul float %a, %b
  %r = fsub float %m, %c
  ret float %r
}

define float @fmul_fsub_contract(float %a, float %b, float %c) {
; FMA-LABEL: fmul_fsub_contract:
; FMA:       # %bb.0:
; FMA-NEXT:    vfmsub213ss {{.*#+}} xmm0 = (xmm1 * xmm0) - xmm2
; FMA-NEXT:    retq
;
; SUPPRESS-LABEL: fmul_fsub_contract:
; SUPPRESS:       # %bb.0:
; SUPPRESS-NEXT:    vfmsub213ss {{.*#+}} xmm0 = (xmm1 * xmm0) - xmm2
; SUPPRESS-NEXT:    retq
  %m = fmul contract float %a, %b
  %r = fsub contract float %m, %c
  ret float %r
}
