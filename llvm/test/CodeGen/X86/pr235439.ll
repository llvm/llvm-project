; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu -mcpu=znver4 | FileCheck %s

; Index 0 is the only in-range index of a single-element vector, so a
; variable-index insert into one uses index 0.

define void @insert_v1i1(ptr %ptr, i64 %index) {
; CHECK-LABEL: insert_v1i1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movb $1, (%rdi)
; CHECK-NEXT:    retq
  %loaded = load <1 x i1>, ptr %ptr, align 1
  %modified = insertelement <1 x i1> %loaded, i1 1, i64 %index
  store <1 x i1> %modified, ptr %ptr, align 1
  ret void
}
