; NOTE: Generated by Inputs/gen-win64-unwind-tests.py. Do not edit by hand.

; Unwinding when the argument stored over the return address is in a
; callee-saved XMM register.
;
; Run under Windows. The harness (Inputs/win64-unwind-harness.c) runs each
; case to completion, then single-steps it: at each instruction of the
; function under test, and of the function it tail calls, the unwinder must
; recover the caller and its nonvolatile registers, and the system exception
; dispatcher must be able to unwind to a handler in the harness.

declare void @RtlCaptureContext(ptr)

@unwind_expected_context = global [1232 x i8] zeroinitializer, align 16
@unwind_actual_context = global [1232 x i8] zeroinitializer, align 16
@args_ok = global i32 0
@dval = global double 1.001000e+03

define void @noop() noinline {
  ret void
}

define void @use(ptr %p) noinline {
  ret void
}

define tailcc void @target_i4(i64 %a1, i64 %a2, i64 %a3, i64 %a4) {
  %c1 = icmp eq i64 %a1, 1001
  %c2 = icmp eq i64 %a2, 1002
  %t2 = and i1 %c1, %c2
  %c3 = icmp eq i64 %a3, 1003
  %t3 = and i1 %t2, %c3
  %c4 = icmp eq i64 %a4, 1004
  %t4 = and i1 %t3, %c4
  %ok = zext i1 %t4 to i32
  store volatile i32 %ok, ptr @args_ok, align 4
  ret void
}

