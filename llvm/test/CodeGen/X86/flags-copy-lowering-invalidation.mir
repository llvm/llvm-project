# RUN: llc -mtriple=x86_64-- -debug-pass-manager -o /dev/null %s \
# RUN:   -passes='machine-function(require<machine-dom-tree>,x86-flags-copy-lowering,require<machine-dom-tree>)' 2>&1 \
# RUN:   | FileCheck %s

# X86FlagsCopyLowering rewrites EFLAGS copies (and may split blocks), so when
# it changes the function it must invalidate MachineDominatorTree. When there is
# nothing to lower it must preserve everything.

# CHECK-LABEL: Running pass: X86FlagsCopyLoweringPass on copy
# CHECK-NEXT:  Invalidating analysis: MachineDominatorTreeAnalysis on copy
# CHECK-NEXT:  Running pass: RequireAnalysisPass<MachineDominatorTreeAnalysis, MachineFunction> on copy
# CHECK-NEXT:  Running analysis: MachineDominatorTreeAnalysis on copy

# CHECK-LABEL: Running pass: X86FlagsCopyLoweringPass on nocopy
# CHECK-NEXT:  Running pass: RequireAnalysisPass<MachineDominatorTreeAnalysis, MachineFunction> on nocopy
# CHECK-NOT:   Running analysis: MachineDominatorTreeAnalysis on nocopy
# CHECK:       Running pass: MachineVerifierPass on nocopy

--- |
  define i32 @copy(i64 %a, i64 %b) { ret i32 0 }
  define i32 @nocopy(i64 %a, i64 %b) { ret i32 0 }
...
---
name:            copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi, $rsi

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    CMP64rr %0, %1, implicit-def $eflags
    %2:gr64 = COPY $eflags
    INLINEASM &nop, 1, 12, implicit-def dead $eflags
    $eflags = COPY %2
    %3:gr8 = SETCCr 7, implicit $eflags
    $al = COPY %3
    RET 0, $al
...
---
name:            nocopy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi, $rsi

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    CMP64rr %0, %1, implicit-def $eflags
    %3:gr8 = SETCCr 7, implicit $eflags
    $al = COPY %3
    RET 0, $al
...
