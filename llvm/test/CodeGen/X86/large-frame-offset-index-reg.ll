; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu -O1 | FileCheck %s

; This test verifies that we don't accidentally clobber the index register
; when scavenging a register to hold a large frame offset during frame index
; elimination.

define i1 @large_frame_index(i64 %idx) "frame-pointer"="all" {
; CHECK-LABEL: large_frame_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rbp
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset %rbp, -16
; CHECK-NEXT:    movq %rsp, %rbp
; CHECK-NEXT:    .cfi_def_cfa_register %rbp
; CHECK-NEXT:    movl $2999999888, %eax # imm = 0xB2D05D90
; CHECK-NEXT:    subq %rax, %rsp
; CHECK-NEXT:    movabsq $-3000000008, %rax # imm = 0xFFFFFFFF4D2FA1F8
; CHECK-NEXT:    addq %rbp, %rax
; CHECK-NEXT:    movb $0, (%rax,%rdi)
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    addq $2147483647, %rsp # imm = 0x7FFFFFFF
; CHECK-NEXT:    addq $852516241, %rsp # imm = 0x32D05D91
; CHECK-NEXT:    popq %rbp
; CHECK-NEXT:    .cfi_def_cfa %rsp, 8
; CHECK-NEXT:    retq
  %d = alloca i8
  %x = alloca [3000000000 x i8]
  %gep = getelementptr inbounds [3000000000 x i8], ptr %x, i64 0, i64 %idx
  store i8 0, ptr %gep
  ret i1 false
}
