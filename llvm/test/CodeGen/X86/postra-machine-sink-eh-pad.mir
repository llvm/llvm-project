# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=postra-machine-sink -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -passes=postra-machine-sink -o - %s | FileCheck %s

# Regression test for llvm/llvm-project#224802.

---
name:            no_sink_into_landing_pad
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: no_sink_into_landing_pad
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rbx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $rax = COPY killed renamable $rbx
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (landing-pad):
  ; CHECK-NEXT:   liveins: $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET 0, $rax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rbx

    renamable $rax = COPY killed renamable $rbx
    JMP_1 %bb.1

  bb.1:
    RET 0

  bb.2 (landing-pad):
    liveins: $rax

    RET 0, $rax
...
