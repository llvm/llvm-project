; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-linux -mcpu=skylake-avx512 | FileCheck %s

; Test that IS_FPCLASS on vector types lowers to VFPCLASS on AVX512DQ.
; See https://github.com/llvm/llvm-project/issues/229671

; 512-bit vector tests

define i16 @isinf_v16f32(<16 x float> %x) nounwind {
; CHECK-LABEL: isinf_v16f32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vfpclassps $24, %zmm0, %k0
; CHECK-NEXT:    kmovd %k0, %eax
; CHECK-NEXT:    # kill: def $ax killed $ax killed $eax
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %1 = call <16 x i1> @llvm.is.fpclass.v16f32(<16 x float> %x, i32 516) ; fcInf = 0x204
  %2 = bitcast <16 x i1> %1 to i16
  ret i16 %2
}

