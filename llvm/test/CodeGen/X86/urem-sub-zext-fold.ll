define <2 x i32> @urem_v2i16_and_mask(<2 x i32> %x) {
; CHECK-LABEL: urem_v2i16_and_mask:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pshuflw {{.*#+}} xmm1 = xmm0[0,2,2,3,4,5,6,7]
; CHECK-NEXT:    pand {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm0
; CHECK-NEXT:    movdqa {{.*#+}} xmm2 = [43691,43691,u,u,u,u,u,u]
; CHECK-NEXT:    pmulhuw %xmm1, %xmm2
; CHECK-NEXT:    psrlw $1, %xmm2
; CHECK-NEXT:    movdqa %xmm2, %xmm3
; CHECK-NEXT:    paddw %xmm3, %xmm3
; CHECK-NEXT:    paddw %xmm2, %xmm3
; CHECK-NEXT:    psubw %xmm3, %xmm1
; CHECK-NEXT:    pxor %xmm2, %xmm2
; CHECK-NEXT:    punpcklwd {{.*#+}} xmm1 = xmm1[0],xmm2[0],xmm1[1],xmm2[1],xmm1[2],xmm2[2],xmm1[3],xmm2[3]
; CHECK-NEXT:    psubd %xmm1, %xmm0
; CHECK-NEXT:    retq
  %and = and <2 x i32> %x, splat (i32 65535)
  %t = trunc <2 x i32> %x to <2 x i16>
  %r = urem <2 x i16> %t, splat (i16 3)
  %z = zext nneg <2 x i16> %r to <2 x i32>
  %res = sub nuw nsw <2 x i32> %and, %z
  ret <2 x i32> %res
}

