; RUN: llc -mtriple=x86_64-unknown-unknown < %s | FileCheck %s

; (x & 0xffff) - zext((trunc x) urem 3) is (x & 0xffff) udiv 3 * 3.
; Expanding the urem must not leave two subtractions behind.

define i32 @urem_i16_and_mask(i32 %x) {
; CHECK-LABEL: urem_i16_and_mask:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movzwl %di, %eax
; CHECK-NEXT:    imull $43691, %eax, %eax # imm = 0xAAAB
; CHECK-NEXT:    shrl $17, %eax
; CHECK-NEXT:    leal (%rax,%rax,2), %eax
; CHECK-NEXT:    movzwl %ax, %eax
; CHECK-NEXT:    retq
  %and = and i32 %x, 65535
  %t = trunc i32 %x to i16
  %r = urem i16 %t, 3
  %z = zext nneg i16 %r to i32
  %res = sub nuw nsw i32 %and, %z
  ret i32 %res
}

