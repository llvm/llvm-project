# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=peephole-opt -verify-machineinstrs -o - %s | FileCheck %s

# A pair of cross register bank bitcasts feeding a loop carried PHI makes the
# rewrite map built by findNextSource() cyclic. Check that this is detected
# instead of sending getNewSource() into infinite recursion (issue #36621).

---
name:            phi_cycle
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_cycle
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $xmm0, $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:fr64 = COPY $xmm0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr8 = COPY [[COPY]].sub_8bit
  ; CHECK-NEXT:   [[MOVSDto64rr:%[0-9]+]]:gr64 = MOVSDto64rr [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x00000000), %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr64 = PHI [[MOVSDto64rr]], %bb.0, %7, %bb.3
  ; CHECK-NEXT:   TEST8ri [[COPY2]], 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors:
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV64toSDrr:%[0-9]+]]:fr64 = MOV64toSDrr [[PHI]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[PHI]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $xmm0, $edi

    %0:gr32 = COPY $edi
    %1:fr64 = COPY $xmm0
    %2:gr8 = COPY %0.sub_8bit
    %3:gr64 = MOVSDto64rr %1

  bb.1:
    successors: %bb.2(0x00000000), %bb.3(0x80000000)

    %4:gr64 = PHI %3, %bb.0, %5, %bb.3
    TEST8ri %2, 1, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    successors:

  bb.3:
    successors: %bb.1(0x80000000)

    ; The value tracked from %6 leads back to the PHI, so this one is left
    ; alone, but %5 is still rewritten into a copy of the PHI.
    %6:fr64 = MOV64toSDrr %4
    %5:gr64 = MOVSDto64rr %6
    JMP_1 %bb.1
...

# Same, but the chain back from the PHI re-enters the traversal at an entry
# that is not a suitable source: %5 -> %6 is followed to the existing %6 -> %4
# entry instead of ending on %6.

---
name:            phi_cycle_join
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_cycle_join
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $xmm0, $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:fr64 = COPY $xmm0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr8 = COPY [[COPY]].sub_8bit
  ; CHECK-NEXT:   [[MOVSDto64rr:%[0-9]+]]:gr64 = MOVSDto64rr [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x00000000), %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr64 = PHI [[MOVSDto64rr]], %bb.0, %5, %bb.3
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[PHI]]
  ; CHECK-NEXT:   TEST8ri [[COPY2]], 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors:
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV64toSDrr:%[0-9]+]]:fr64 = MOV64toSDrr [[COPY3]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gr64 = COPY [[PHI]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $xmm0, $edi

    %0:gr32 = COPY $edi
    %1:fr64 = COPY $xmm0
    %2:gr8 = COPY %0.sub_8bit
    %3:gr64 = MOVSDto64rr %1

  bb.1:
    successors: %bb.2(0x00000000), %bb.3(0x80000000)

    %4:gr64 = PHI %3, %bb.0, %5, %bb.3
    %6:gr64 = COPY %4
    TEST8ri %2, 1, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    successors:

  bb.3:
    successors: %bb.1(0x80000000)

    %7:fr64 = MOV64toSDrr %6
    %5:gr64 = COPY %6
    JMP_1 %bb.1
...
