# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -passes=peephole-opt %s -o - | FileCheck %s
--- |
  define void @func() { ret void }
  define void @fold_imm_copy_kill_bug() { ret void }
  define void @test_fold_load() { ret void }
  define void @test_asm_may_store() { %x = alloca i64, align 8
    ret void }
  define void @test_invariant_load() { ret void }
  define void @test_narrow_load() { ret void }
  define void @test_undef_uses() { ret void }
...
---
# Check that instructions with MI.isBitcast() are only replaced by COPY if there
# are no SUBREG_TO_REG users.
name: func

body: |
  bb.0:
    ; CHECK-LABEL: name: func
    ; CHECK: [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 42
    ; CHECK-NEXT: [[VMOVDI2SSrr:%[0-9]+]]:fr32 = VMOVDI2SSrr [[MOV32ri]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
    ; CHECK-NEXT: NOOP implicit [[COPY]]
    ; CHECK-NEXT: [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 42
    ; CHECK-NEXT: [[VMOVDI2SSrr1:%[0-9]+]]:fr32 = VMOVDI2SSrr [[MOV32ri1]]
    ; CHECK-NEXT: [[MOVSS2DIrr:%[0-9]+]]:gr32 = MOVSS2DIrr [[VMOVDI2SSrr1]]
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:gr64 = SUBREG_TO_REG [[MOVSS2DIrr]], %subreg.sub_32bit
    ; CHECK-NEXT: NOOP implicit [[SUBREG_TO_REG]]
    %0:gr32 = MOV32ri 42
    %1:fr32 = VMOVDI2SSrr %0
    %2:gr32 = MOVSS2DIrr %1
    NOOP implicit %2

    %3:gr32 = MOV32ri 42
    %4:fr32 = VMOVDI2SSrr %3
    %5:gr32 = MOVSS2DIrr %4
    %6:gr64 = SUBREG_TO_REG %5, %subreg.sub_32bit
    NOOP implicit %6
...

---
# Test that foldImmediate folds an immediate into an ADD whose other operand
# is a COPY, replacing the COPY with its source.
name: fold_imm_copy_kill_bug
body: |
  bb.0:
    ; CHECK-LABEL: name: fold_imm_copy_kill_bug
    ; CHECK: [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD32ri:%[0-9]+]]:gr32 = ADD32ri [[MOV32r0_]], 42, implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD32ri1:%[0-9]+]]:gr32 = ADD32ri [[MOV32r0_]], 42, implicit-def dead $eflags
    ; CHECK-NEXT: RET 0
    %0:gr32 = MOV32r0 implicit-def dead $eflags
    %1:gr32 = MOV32ri 42

    %2:gr32 = COPY %0:gr32

    %3:gr32 = ADD32rr %1:gr32, %2:gr32, implicit-def dead $eflags
    %4:gr32 = ADD32ri %0:gr32, 42, implicit-def dead $eflags

    RET 0

...

---
# The peephole optimizer folds a load from a stack slot into a foldable ("rm")
# inline asm operand that reads the loaded value, so that the asm reads the
# slot itself.
name: test_fold_load
tracksRegLiveness: true
stack:
  - { id: 0, size: 8, alignment: 8 }
body: |
  bb.0:
    ; CHECK-LABEL: name: test_fold_load
    ; CHECK: INLINEASM &"", sideeffect mayload attdialect, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    ; CHECK-NEXT: RET 0
    %0:gr64 = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    INLINEASM &"", sideeffect attdialect, reguse:GR64 foldable, %0, reguse:GR64 foldable, %0
    RET 0
...

---
# The asm writes x through an early-clobber output before it reads v, so v
# can't be read from x.
#
#   long x;
#   long v = x;
#   asm volatile("movq $0, %0; movq %1, %%rax" : "=&m"(x) : "rm"(v) : "rax");
#
name: test_asm_may_store
tracksRegLiveness: true
stack:
  - { id: 0, name: x, size: 8, alignment: 8 }
body: |
  bb.0:
    ; CHECK-LABEL: name: test_asm_may_store
    ; CHECK: [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm %stack.0.x, 1, $noreg, 0, $noreg :: (dereferenceable load (s64) from %ir.x)
    ; CHECK-NEXT: INLINEASM &"movq $$0, $0\0A\09movq $1, %rax", sideeffect maystore attdialect, mem:m ops:5, %stack.0.x, 1, $noreg, 0, $noreg, reguse:GR64 foldable, [[MOV64rm]], clobber, implicit-def early-clobber $rax
    ; CHECK-NEXT: RET 0
    %0:gr64 = MOV64rm %stack.0.x, 1, $noreg, 0, $noreg :: (dereferenceable load (s64) from %ir.x)
    INLINEASM &"movq $$0, $0\0A\09movq $1, %rax", sideeffect maystore attdialect, mem:m ops:5, %stack.0.x, 1, $noreg, 0, $noreg, reguse:GR64 foldable, %0, clobber, implicit-def early-clobber $rax
    RET 0
...

---
# An asm that stores can't write an invariant slot, such as an incoming
# argument's.
#
name: test_invariant_load
tracksRegLiveness: true
fixedStack:
  - { id: 0, size: 8, alignment: 16, isImmutable: true }
stack:
  - { id: 0, size: 8, alignment: 8 }
body: |
  bb.0:
    ; CHECK-LABEL: name: test_invariant_load
    ; CHECK: INLINEASM &"", sideeffect mayload maystore attdialect, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, mem:m ops:5, %fixed-stack.0, 1, $noreg, 0, $noreg :: (store unknown-size, align 1), (load (s64) from %fixed-stack.0, align 16)
    ; CHECK-NEXT: RET 0
    %0:gr64 = MOV64rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.0, align 16)
    INLINEASM &"", sideeffect maystore attdialect, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, reguse:GR64 foldable, %0
    RET 0
...

---
# A load that fills only part of the register (here the low 4 bytes of an
# XMM register, with the rest zeroed) isn't folded, since the asm would read
# the whole register's width from the slot.
#
name: test_narrow_load
tracksRegLiveness: true
fixedStack:
  - { id: 0, size: 4, alignment: 16, isImmutable: true }
body: |
  bb.0:
    ; CHECK-LABEL: name: test_narrow_load
    ; CHECK: [[MOVSSrm:%[0-9]+]]:vr128 = MOVSSrm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %fixed-stack.0, align 16)
    ; CHECK-NEXT: INLINEASM &"movaps $0, %xmm1", sideeffect attdialect, reguse:VR128 foldable, [[MOVSSrm]]
    ; CHECK-NEXT: RET 0
    %0:vr128 = MOVSSrm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %fixed-stack.0, align 16)
    INLINEASM &"movaps $0, %xmm1", sideeffect attdialect, reguse:VR128 foldable, %0
    RET 0
...

---
# An undef use doesn't read the loaded value, so an asm whose only uses of it
# are undef has nothing to fold. (There is no C source: instruction selection
# doesn't emit undef inline asm operands.)
name: test_undef_uses
tracksRegLiveness: true
stack:
  - { id: 0, size: 8, alignment: 8 }
body: |
  bb.0:
    ; CHECK-LABEL: name: test_undef_uses
    ; CHECK: [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, reguse:GR64 foldable, undef [[MOV64rm]], reguse:GR64 foldable, undef [[MOV64rm]]
    ; CHECK-NEXT: RET 0
    %0:gr64 = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    INLINEASM &"", sideeffect attdialect, reguse:GR64 foldable, undef %0, reguse:GR64 foldable, undef %0
    RET 0
...
