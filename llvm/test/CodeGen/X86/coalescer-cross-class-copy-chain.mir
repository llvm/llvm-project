# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=register-coalescer -verify-coalescing -o - %s | FileCheck %s

# Regression test for https://github.com/llvm/llvm-project/issues/240874.
#
# The coalescer joins %3 (vr128, holding the full <2 x double> across the
# call) with %2 (fr64). At %3's second definition, "%3:vr128 = COPY %0:vr128",
# %2's value defined by "%2:fr64 = COPY %1:fr64" is live, and
# JoinVals::valuesIdentical() traced both values back to the same definition
# of %0 through the copy chain %2 <- %1 <- %0, treating them as identical. The
# chain passes through fr64 registers that only hold 64 bits, so erasing
# "%3:vr128 = COPY %0:vr128" routed the vector value through an fr64 register
# across the call, where it is spilled with an 8-byte movsd and the upper
# half is lost.
#
# The full-width copy "%3:vr128 = COPY %0:vr128" must survive, and no copy
# routing %3's value through %1 may be introduced.

--- |
  target triple = "x86_64-unknown-linux-gnu"
  declare void @clobber()
  define <2 x double> @coalescer_cross_class_copy_chain(<2 x double>, double, double, i32, ptr) {
    ret <2 x double> poison
  }

...
---
name:            coalescer_cross_class_copy_chain
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $xmm0, $xmm1, $xmm2, $edi, $rsi

    ; CHECK-LABEL: name: coalescer_cross_class_copy_chain
    ; CHECK: bb.0:
    ; CHECK: liveins: $xmm0, $xmm1, $xmm2, $edi, $rsi
    ; CHECK: %0:vr128 = COPY $xmm0
    ; CHECK: %1:fr64 = COPY $xmm1
    ; CHECK: %2:fr64 = COPY $xmm2
    ; CHECK: %3:vr128 = COPY %2{{[:a-z0-9]*}}

    %0:vr128 = COPY $xmm0
    %1:fr64 = COPY $xmm1
    %2:fr64 = COPY $xmm2
    %3:vr128 = COPY %2
    %4:gr32 = COPY $edi
    %5:gr64 = COPY $rsi
    TEST32rr %4, %4, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags

  bb.1:
    successors: %bb.2

    ; CHECK: bb.1:
    ; CHECK: %1:fr64 = COPY %0{{[:a-z0-9]*}}
    ; CHECK: %2:fr64 = COPY %1{{[:a-z0-9]*}}
    ; CHECK-NOT: %3:vr128 = COPY %1
    ; CHECK: %3:vr128 = COPY %0{{[:a-z0-9]*}}

    %1:fr64 = COPY %0
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    CALL64pcrel32 @clobber, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %2:fr64 = COPY %1
    %3:vr128 = COPY %0

  bb.2:
    ; CHECK: bb.2:
    ; CHECK: MOVSDmr %5{{[:a-z0-9]*}}, 1, $noreg, 0, $noreg, %1{{[:a-z0-9]*}}
    ; CHECK: MOVSDmr %5{{[:a-z0-9]*}}, 1, $noreg, 8, $noreg, %2{{[:a-z0-9]*}}
    ; CHECK: $xmm0 = COPY %3{{[:a-z0-9]*}}
    ; CHECK: RET 0, $xmm0

    MOVSDmr %5, 1, $noreg, 0, $noreg, %1
    MOVSDmr %5, 1, $noreg, 8, $noreg, %2
    $xmm0 = COPY %3
    RET 0, $xmm0

...
