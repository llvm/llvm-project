; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; A 32-bit def zeroes the upper 32 bits of the 64-bit register. Check that this
; is used when the def and the zext to i64 are in different blocks, so no MOV32rr
; is emitted for the zext.

; CodeGenPrepare rewrites the zext to i64 into zext(trunc(%z32)) because %z32 is
; also used in another block.
define i32 @xor_byte_index_cross_block(ptr %tab, i32 %len, i8 %a, i8 %b) {
; CHECK-LABEL: xor_byte_index_cross_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    xorl %ecx, %edx
; CHECK-NEXT:    movzbl %dl, %eax
; CHECK-NEXT:    cmpl %esi, %eax
; CHECK-NEXT:    jae .LBB0_2
; CHECK-NEXT:  # %bb.1: # %in
; CHECK-NEXT:    movl (%rdi,%rax,4), %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_2: # %out
; CHECK-NEXT:    # kill: def $eax killed $eax killed $rax
; CHECK-NEXT:    retq
entry:
  %x = xor i8 %a, %b
  %z32 = zext i8 %x to i32
  %c = icmp ult i32 %z32, %len
  br i1 %c, label %in, label %out

in:
  %z64 = zext i8 %x to i64
  %p = getelementptr inbounds i32, ptr %tab, i64 %z64
  %v = load i32, ptr %p
  ret i32 %v

out:
  ret i32 %z32
}

; Table driven checksum loop with a bounds check whose failure path uses the
; index.
define i32 @xor_byte_index_loop(ptr %data, ptr %tab, i32 %len, i64 %n, ptr %bad) {
; CHECK-LABEL: xor_byte_index_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movl $65535, %eax # imm = 0xFFFF
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movzbl (%rdi), %r9d
; CHECK-NEXT:    xorb %al, %r9b
; CHECK-NEXT:    movzbl %r9b, %r9d
; CHECK-NEXT:    cmpl %edx, %r9d
; CHECK-NEXT:    jae .LBB1_3
; CHECK-NEXT:  # %bb.2: # %cont
; CHECK-NEXT:    # in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    movl %eax, %r10d
; CHECK-NEXT:    shrl $8, %r10d
; CHECK-NEXT:    movzwl (%rsi,%r9,4), %eax
; CHECK-NEXT:    xorl %r10d, %eax
; CHECK-NEXT:    incq %rdi
; CHECK-NEXT:    decq %rcx
; CHECK-NEXT:    jne .LBB1_1
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB1_3: # %oob
; CHECK-NEXT:    movl %r9d, (%r8)
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %cont ]
  %v = phi i32 [ 65535, %entry ], [ %nv, %cont ]
  %pd = getelementptr inbounds i8, ptr %data, i64 %i
  %b = load i8, ptr %pd
  %sh = lshr i32 %v, 8
  %tr = trunc i32 %v to i8
  %x = xor i8 %b, %tr
  %z32 = zext i8 %x to i32
  %c = icmp ult i32 %z32, %len
  br i1 %c, label %cont, label %oob

cont:
  %z64 = zext i8 %x to i64
  %pt = getelementptr inbounds i32, ptr %tab, i64 %z64
  %t = load i32, ptr %pt
  %m = and i32 %t, 65535
  %nv = xor i32 %m, %sh
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

oob:
  store i32 %z32, ptr %bad
  ret i32 0

exit:
  ret i32 %nv
}

; The upper 32 bits of an argument register are undefined, keep the zext.
define i32 @arg_index_cross_block(ptr %tab, i32 %i, i1 %c) {
; CHECK-LABEL: arg_index_cross_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB2_2
; CHECK-NEXT:  # %bb.1: # %in
; CHECK-NEXT:    movl %esi, %eax
; CHECK-NEXT:    movl (%rdi,%rax,4), %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB2_2: # %out
; CHECK-NEXT:    movl %esi, %eax
; CHECK-NEXT:    retq
entry:
  br i1 %c, label %in, label %out

in:
  %z64 = zext i32 %i to i64
  %p = getelementptr inbounds i32, ptr %tab, i64 %z64
  %v = load i32, ptr %p
  ret i32 %v

out:
  ret i32 %i
}

; A truncate does not clear the upper 32 bits, keep the zext.
define i32 @trunc_index_cross_block(ptr %tab, i64 %w, i1 %c) {
; CHECK-LABEL: trunc_index_cross_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movl %esi, %eax
; CHECK-NEXT:    imull %esi, %eax
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB3_2
; CHECK-NEXT:  # %bb.1: # %in
; CHECK-NEXT:    movl %esi, %ecx
; CHECK-NEXT:    addl (%rdi,%rcx,4), %eax
; CHECK-NEXT:  .LBB3_2: # %out
; CHECK-NEXT:    retq
entry:
  %t = trunc i64 %w to i32
  %m = mul i32 %t, %t
  br i1 %c, label %in, label %out

in:
  %z64 = zext i32 %t to i64
  %p = getelementptr inbounds i32, ptr %tab, i64 %z64
  %v = load i32, ptr %p
  %r = add i32 %v, %m
  ret i32 %r

out:
  ret i32 %m
}
