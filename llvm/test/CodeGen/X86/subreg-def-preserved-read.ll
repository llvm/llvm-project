; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; A partial def that preserves the bits it does not write also reads them.  If
; that read is not recorded as an implicit use of the super-register, copy
; propagation takes away the only operand keeping the incoming value alive and
; X86FixupBWInsts widens the byte load, zero-extending and dropping bits 8..63.
;
; CHECK pins the plain byte load that keeps bits 8..63.

define i64 @f(i64 %x) {
; CHECK-LABEL: f:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    movb 8(%rax), %al
; CHECK-NEXT:    retq
  %a = add i64 %x, 8
  %p = inttoptr i64 %a to ptr
  %m = and i64 %x, -256
  %b = load i8, ptr %p, align 1
  %z = zext i8 %b to i64
  %r = or i64 %m, %z
  ret i64 %r
}
