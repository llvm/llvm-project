; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64 -frame-pointer=all -verify-machineinstrs | FileCheck %s

; The frame offset does not fit in disp32 and the address mode already uses
; an index register; the scavenged register holding the offset must be
; combined with the base register, not overwrite the index register.

define ptr @huge_frame_index() {
; CHECK-LABEL: huge_frame_index:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rbp
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset %rbp, -16
; CHECK-NEXT:    movq %rsp, %rbp
; CHECK-NEXT:    .cfi_def_cfa_register %rbp
; CHECK-NEXT:    movl $3221225352, %eax # imm = 0xBFFFFF88
; CHECK-NEXT:    subq %rax, %rsp
; CHECK-NEXT:    movl $3221225471, %eax # imm = 0xBFFFFFFF
; CHECK-NEXT:    movabsq $-3221225480, %rcx # imm = 0xFFFFFFFF3FFFFFF8
; CHECK-NEXT:    addq %rbp, %rcx
; CHECK-NEXT:    addq %rcx, %rax
; CHECK-NEXT:    addq $2147483647, %rsp # imm = 0x7FFFFFFF
; CHECK-NEXT:    addq $1073741705, %rsp # imm = 0x3FFFFF89
; CHECK-NEXT:    popq %rbp
; CHECK-NEXT:    .cfi_def_cfa %rsp, 8
; CHECK-NEXT:    retq
  %x = alloca [3221225472 x i8], align 1
  %p = getelementptr i8, ptr %x, i64 3221225471
  ret ptr %p
}

