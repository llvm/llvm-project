; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -O0 -fast-isel-abort=1 -mtriple=x86_64-linux-gnu | FileCheck %s

; FastISel skips instructions that have no uses and no side effects. A call
; that only reads memory still has side effects if it may not return or may
; throw, so it must be kept, as SelectionDAG and GlobalISel do.

declare void @readonly_may_not_return() nounwind memory(read)
declare void @readonly_may_throw() willreturn memory(read)
declare void @readonly_returns() nounwind willreturn memory(read)

define void @call_may_not_return() {
; CHECK-LABEL: call_may_not_return:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    callq readonly_may_not_return@PLT
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
  call void @readonly_may_not_return()
  ret void
}

define void @call_may_throw() {
; CHECK-LABEL: call_may_throw:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    callq readonly_may_throw@PLT
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    retq
  call void @readonly_may_throw()
  ret void
}

; This call has no side effects, so it can still be dropped.
define void @call_returns() {
; CHECK-LABEL: call_returns:
; CHECK:       # %bb.0:
; CHECK-NEXT:    retq
  call void @readonly_returns()
  ret void
}
