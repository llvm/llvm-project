# RUN: llc -mtriple=x86_64-- -passes='require<slot-indexes>,early-machinelicm' -o - %s | FileCheck %s

# Hoisting erases the duplicate load in bb.2. Splitting bb.3->bb.5 for a
# preheader then creates a JMP that recycles the erased load's MachineInstr,
# which still has an entry in the stale cached SlotIndexes.

--- |
  @g = external global i64

  define void @f() { ret void }
...
---
name: f
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: f
  ; CHECK: bb.0:
