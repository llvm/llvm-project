  ; CHECK-NEXT:   successors: %bb.6(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gr64 = IMPLICIT_DEF
  ; CHECK-NEXT:   TEST64rr [[DEF]], [[DEF]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV64rm1:%[0-9]+]]:gr64 = MOV64rm $rip, 1, $noreg, @g, $noreg :: (load (s64) from got)
  ; CHECK-NEXT:   JMP_1 %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.5(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JCC_1 %bb.5, 5, implicit undef $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  bb.0:
    successors: %bb.1, %bb.3

    JCC_1 %bb.3, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2

  bb.2:
    successors: %bb.2, %bb.3

    %0:gr64 = MOV64rm $rip, 1, $noreg, @g, $noreg :: (load (s64) from got)
    %1:gr64 = MOV64rm $rip, 1, $noreg, @g, $noreg :: (load (s64) from got)
    JCC_1 %bb.2, 5, implicit undef $eflags
    JMP_1 %bb.3

  bb.3:
    successors: %bb.5, %bb.4

    %3:gr64 = IMPLICIT_DEF
    TEST64rr %3, %3, implicit-def $eflags
    JCC_1 %bb.5, 5, implicit $eflags

  bb.4:
    RET 0

  bb.5:
    successors: %bb.5, %bb.4

    %2:gr64 = MOV64rm $rip, 1, $noreg, @g, $noreg :: (load (s64) from got)
    JCC_1 %bb.5, 5, implicit undef $eflags
    JMP_1 %bb.4
