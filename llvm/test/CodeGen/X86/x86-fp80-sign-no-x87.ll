; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=i686-unknown-linux | FileCheck %s

; Verify that fneg, fabs and copysign of a softened x86_fp80 value use the
; correct sign bit (bit 79, which is the top bit of the exponent word) and
; operate on the softened image type (i96, i.e. three dwords) rather than on
; the 80-bit value, so that the padding in the third register is never
; cleared explicitly.
define x86_fp80 @test_fneg_f80(x86_fp80 %a) #0 {
; CHECK-LABEL: test_fneg_f80:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %eax
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %edx
; CHECK-NEXT:    movzwl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    xorl $32768, %ecx # imm = 0x8000
; CHECK-NEXT:    retl
  %r = fneg x86_fp80 %a
  ret x86_fp80 %r
}

define x86_fp80 @test_fabs_f80(x86_fp80 %a) #0 {
; CHECK-LABEL: test_fabs_f80:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %eax
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %edx
; CHECK-NEXT:    movl $32767, %ecx # imm = 0x7FFF
; CHECK-NEXT:    andl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    retl
  %r = tail call x86_fp80 @llvm.fabs.f80(x86_fp80 %a)
  ret x86_fp80 %r
}

define x86_fp80 @test_copysign_f80(x86_fp80 %a, x86_fp80 %b) #0 {
; CHECK-LABEL: test_copysign_f80:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushl %esi
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %eax
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %edx
; CHECK-NEXT:    movzwl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    movzwl {{[0-9]+}}(%esp), %esi
; CHECK-NEXT:    andl $32768, %esi # imm = 0x8000
; CHECK-NEXT:    andl $32767, %ecx # imm = 0x7FFF
; CHECK-NEXT:    orl %esi, %ecx
; CHECK-NEXT:    popl %esi
; CHECK-NEXT:    retl
  %r = tail call x86_fp80 @llvm.copysign.f80(x86_fp80 %a, x86_fp80 %b)
  ret x86_fp80 %r
}

define void @test_copysign_f80_mem(ptr %p, ptr %q) #0 {
; CHECK-LABEL: test_copysign_f80_mem:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %eax
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    movzwl 8(%ecx), %edx
; CHECK-NEXT:    movzwl 8(%eax), %eax
; CHECK-NEXT:    andl $32768, %eax # imm = 0x8000
; CHECK-NEXT:    andl $32767, %edx # imm = 0x7FFF
; CHECK-NEXT:    orl %eax, %edx
; CHECK-NEXT:    movw %dx, 8(%ecx)
; CHECK-NEXT:    retl
  %a = load x86_fp80, ptr %p, align 4
  %b = load x86_fp80, ptr %q, align 4
  %r = tail call x86_fp80 @llvm.copysign.f80(x86_fp80 %a, x86_fp80 %b)
  store x86_fp80 %r, ptr %p, align 4
  ret void
}

define x86_fp80 @test_const_f80() #0 {
; CHECK-LABEL: test_const_f80:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl $560513589, %eax # imm = 0x2168C235
; CHECK-NEXT:    movl $-921707870, %edx # imm = 0xC90FDAA2
; CHECK-NEXT:    movl $49152, %ecx # imm = 0xC000
; CHECK-NEXT:    retl
  ret x86_fp80 0xKC000C90FDAA22168C235
}

; The sign operand need not be softened: with SSE2 available, the DAG combine
; folds copysign(x, fpext(y)) into copysign(x, y) and leaves an f32 sign
; operand behind, whose sign bit is at bit 31 rather than at bit 79.
define x86_fp80 @test_copysign_f80_f32_sign(x86_fp80 %a, float %b) #1 {
; CHECK-LABEL: test_copysign_f80_f32_sign:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushl %esi
; CHECK-NEXT:    movss {{.*#+}} xmm0 = mem[0],zero,zero,zero
; CHECK-NEXT:    movmskps %xmm0, %ecx
; CHECK-NEXT:    andl $1, %ecx
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %eax
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %edx
; CHECK-NEXT:    movzwl {{[0-9]+}}(%esp), %esi
; CHECK-NEXT:    andl $32767, %esi # imm = 0x7FFF
; CHECK-NEXT:    shll $15, %ecx
; CHECK-NEXT:    orl %esi, %ecx
; CHECK-NEXT:    popl %esi
; CHECK-NEXT:    retl
  %e = fpext float %b to x86_fp80
  %r = tail call x86_fp80 @llvm.copysign.f80(x86_fp80 %a, x86_fp80 %e)
  ret x86_fp80 %r
}

define void @test_copysign_f32_f80_sign(ptr %p, ptr %q) #1 {
; CHECK-LABEL: test_copysign_f32_f80_sign:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %eax
; CHECK-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; CHECK-NEXT:    movl 8(%ecx), %ecx
; CHECK-NEXT:    movd {{.*#+}} xmm0 = mem[0],zero,zero,zero
; CHECK-NEXT:    pand {{\.?LCPI[0-9]+_[0-9]+}}, %xmm0
; CHECK-NEXT:    shll $16, %ecx
; CHECK-NEXT:    movd %ecx, %xmm1
; CHECK-NEXT:    pand {{\.?LCPI[0-9]+_[0-9]+}}, %xmm1
; CHECK-NEXT:    por %xmm0, %xmm1
; CHECK-NEXT:    movd %xmm1, (%eax)
; CHECK-NEXT:    retl
  %a = load float, ptr %p, align 4
  %b = load x86_fp80, ptr %q, align 4
  %e = fptrunc x86_fp80 %b to float
  %r = tail call float @llvm.copysign.f32(float %a, float %e)
  store float %r, ptr %p, align 4
  ret void
}

declare x86_fp80 @llvm.fabs.f80(x86_fp80)
declare x86_fp80 @llvm.copysign.f80(x86_fp80, x86_fp80)
declare float @llvm.copysign.f32(float, float)

attributes #0 = { nounwind "target-features"="-x87" }
attributes #1 = { nounwind "target-features"="-x87,+sse2" }
