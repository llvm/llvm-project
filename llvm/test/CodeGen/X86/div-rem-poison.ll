; PreISelIntrinsicLowering expands each call into a plain instruction with a
; guarded divisor. On X86 the guard (a test and a cmov) has to precede the
; idiv, which traps for the operands the intrinsic gives a poison result.

define i32 @sdiv_i32(i32 %a, i32 %b) {
; CHECK-LABEL: sdiv_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    leal -2147483648(%rax), %ecx
; CHECK-NEXT:    movl %esi, %edx
; CHECK-NEXT:    notl %edx
; CHECK-NEXT:    orl %ecx, %edx
; CHECK-NEXT:    movl $1, %ecx
; CHECK-NEXT:    movl %esi, %edi
; CHECK-NEXT:    cmovel %ecx, %edi
; CHECK-NEXT:    testl %esi, %esi
; CHECK-NEXT:    cmovel %ecx, %edi
; CHECK-NEXT:    # kill: def $eax killed $eax killed $rax
; CHECK-NEXT:    cltd
; CHECK-NEXT:    idivl %edi
; CHECK-NEXT:    retq
;
; GISel-LABEL: sdiv_i32:
; GISel:       # %bb.0:
; GISel-NEXT:    movl %edi, %eax
; GISel-NEXT:    movl $1, %ecx
; GISel-NEXT:    cmpl $0, %esi
; GISel-NEXT:    sete %dl
; GISel-NEXT:    cmpl $-2147483648, %edi # imm = 0x80000000
; GISel-NEXT:    sete %dil
; GISel-NEXT:    cmpl $-1, %esi
; GISel-NEXT:    sete %r8b
; GISel-NEXT:    andb %dil, %r8b
; GISel-NEXT:    orb %dl, %r8b
; GISel-NEXT:    movzbl %r8b, %edx
; GISel-NEXT:    andl $1, %edx
; GISel-NEXT:    cmovel %esi, %ecx
; GISel-NEXT:    cltd
; GISel-NEXT:    idivl %ecx
; GISel-NEXT:    retq
  %r = call i32 @llvm.sdiv.poison.i32(i32 %a, i32 %b)
  ret i32 %r
}

