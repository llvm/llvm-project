!5 = !DISubroutineType(types: !6)
!6 = !{null}
!8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
!9 = !DILocalVariable(name: "x", scope: !4, file: !3, line: 1, type: !8)
!10 = !DILocation(line: 0, scope: !4)
!11 = distinct !DISubprogram(name: "debug_frame_index_between_frame_pointer_clobbers", scope: null, file: !3, spFlags: DISPFlagDefinition, unit: !1, type: !5)
!12 = !DILocalVariable(name: "x", scope: !11, file: !3, line: 1, type: !8)
