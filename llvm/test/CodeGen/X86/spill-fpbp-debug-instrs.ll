; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --filter "pushq|popq|#APP|#NO_APP|#DEBUG_VALUE"
; RUN: llc -mtriple=x86_64-pc-linux -stackrealign < %s | FileCheck %s \
; RUN:   --implicit-check-not='pushq %rbp' --implicit-check-not='popq %rbp'

declare void @use(i32)
declare void @usep(ptr)

; A register debug value does not split the frame-pointer save range.
define i32 @debug_between_frame_pointer_clobbers(i32 %a, i32 %b) #0 !dbg !4 {
; CHECK-LABEL: debug_between_frame_pointer_clobbers:
; CHECK:    pushq %rbp
; CHECK:    pushq %rbx
; CHECK:    pushq %rbp
; CHECK:    pushq %rax
; CHECK:    #APP
; CHECK:    #NO_APP
; CHECK:    #APP
; CHECK:    #NO_APP
; CHECK:    popq %rbp
; CHECK:    popq %rbx
; CHECK:    popq %rbp
entry:
  tail call void asm sideeffect "", "~{rbp}"()
  #dbg_value(i32 %b, !9, !DIExpression(), !10)
  tail call void asm sideeffect "", "~{rbp}"()
  call void @use(i32 %b)
  ret i32 %a
}

; A frame-index debug value must continue to split the save ranges because its
; stack-relative location is not adjusted for the temporary pushes.
define i32 @debug_frame_index_between_frame_pointer_clobbers(i32 %a) #0 !dbg !11 {
; CHECK-LABEL: debug_frame_index_between_frame_pointer_clobbers:
; CHECK:    pushq %rbp
; CHECK:    pushq %rbx
; CHECK:    pushq %rbp
; CHECK:    pushq %rax
; CHECK:    #APP
; CHECK:    #NO_APP
; CHECK:    popq %rbp
; CHECK:    #DEBUG_VALUE: debug_frame_index_between_frame_pointer_clobbers:x <- [DW_OP_plus_uconst 4, DW_OP_stack_value] $rsp
; CHECK:    pushq %rbp
; CHECK:    pushq %rax
; CHECK:    #APP
; CHECK:    #NO_APP
; CHECK:    popq %rbp
; CHECK:    popq %rbx
; CHECK:    popq %rbp
entry:
  %x = alloca i32, align 4
  store i32 %a, ptr %x, align 4
  tail call void asm sideeffect "", "~{rbp}"()
  #dbg_value(ptr %x, !12, !DIExpression(), !13)
  tail call void asm sideeffect "", "~{rbp}"()
  call void @usep(ptr %x)
  ret i32 %a
}

attributes #0 = { "frame-pointer"="all" }

