# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=early-machinelicm -verify-machineinstrs -o - %s | FileCheck %s

# bb.0 ends in an indirect branch whose only recorded successor is the loop
# header bb.1. The indirect branch reads only a virtual register, so hoisting
# before it cannot clobber any physical register. bb.0 is therefore a valid
# loop preheader and the loop-invariant ADD64ri32 is hoisted into it.

--- |
  define void @f(i64 %p, ptr %t) { entry: unreachable }
...
---
name: f
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: f
  ; CHECK:       bb.0:
  ; CHECK:         ADD64ri32
  ; CHECK-NEXT:    JMP64r
  ; CHECK:       bb.1:
  ; CHECK-NOT:     ADD64ri32
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $rdi, $rsi

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    JMP64r killed %1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)

    %2:gr64 = ADD64ri32 %0, 42, implicit-def dead $eflags
    MOV64mr $rip, 1, $noreg, 0, $noreg, %2 :: (store (s64))
    CMP64ri32 %2, 100, implicit-def $eflags
    JCC_1 %bb.1, 4, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET64
...
