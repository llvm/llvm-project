## Verify bb-path-cloning preserves MachineBlockHashInfo while invalidating
## Machine-CFG analyses (MBFI, MDT, MLI).
# RUN: echo 'v1' > %t
# RUN: llc -mtriple=x86_64-pc-linux -basic-block-sections=%t \
# RUN:     -run-pass=machine-loops,machine-block-freq,machine-block-hash,bb-path-cloning,machine-block-match-infer,block-placement \
# RUN:     -verify-machineinstrs=0 -debug-pass=Structure %s -o /dev/null 2>&1 \
# RUN:   | FileCheck %s

---
name: foo
body: |
  bb.0:
    RET 0
...

