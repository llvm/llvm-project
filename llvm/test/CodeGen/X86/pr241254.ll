; fdiv/frem of two +0.0 elements is NaN, so it must not be treated as a known
; zero element by SimplifyDemandedVectorElts.

@c = global [8 x double] zeroinitializer

; All of %y is +0.0 once the memset is forwarded, so %s must be all zero and
; the function must return 0.0.
define double @pr241254() nounwind {
; SSE-LABEL: pr241254:
; SSE:       # %bb.0:
; SSE-NEXT:    pushq %rbp
; SSE-NEXT:    movq %rsp, %rbp
; SSE-NEXT:    andq $-32, %rsp
; SSE-NEXT:    subq $32, %rsp
; SSE-NEXT:    movq c@GOTPCREL(%rip), %rax
; SSE-NEXT:    xorps %xmm0, %xmm0
; SSE-NEXT:    movaps %xmm0, (%rax)
; SSE-NEXT:    movaps %xmm0, 16(%rax)
; SSE-NEXT:    movaps %xmm0, (%rsp)
; SSE-NEXT:    movaps %xmm0, {{[0-9]+}}(%rsp)
; SSE-NEXT:    movaps %xmm0, 32(%rax)
; SSE-NEXT:    movaps %xmm0, 48(%rax)
; SSE-NEXT:    movsd {{.*#+}} xmm0 = mem[0],zero
; SSE-NEXT:    movq %rbp, %rsp
; SSE-NEXT:    popq %rbp
; SSE-NEXT:    retq
;
; AVX-LABEL: pr241254:
; AVX:       # %bb.0:
; AVX-NEXT:    pushq %rbp
; AVX-NEXT:    movq %rsp, %rbp
; AVX-NEXT:    andq $-32, %rsp
; AVX-NEXT:    subq $32, %rsp
; AVX-NEXT:    movq c@GOTPCREL(%rip), %rax
; AVX-NEXT:    vxorps %xmm0, %xmm0, %xmm0
; AVX-NEXT:    vmovaps %ymm0, (%rax)
; AVX-NEXT:    vbroadcastsd {{.*#+}} ymm1 = [NaN,NaN,NaN,NaN]
; AVX-NEXT:    vmovaps %ymm1, (%rsp)
; AVX-NEXT:    vmovaps %ymm0, 32(%rax)
; AVX-NEXT:    vmovsd {{.*#+}} xmm0 = mem[0],zero
; AVX-NEXT:    movq %rbp, %rsp
; AVX-NEXT:    popq %rbp
; AVX-NEXT:    vzeroupper
; AVX-NEXT:    retq
  %g = alloca [4 x double], align 32
  call void @llvm.memset.p0.i64(ptr align 32 %g, i8 0, i64 32, i1 false)
  call void @llvm.memset.p0.i64(ptr align 32 @c, i8 0, i64 64, i1 false)
  %x = load <4 x double>, ptr @c, align 32
  store <4 x double> zeroinitializer, ptr @c, align 32
  %y = load <4 x double>, ptr %g, align 32
  %ne = fcmp une <4 x double> %y, zeroinitializer
  %q = fdiv <4 x double> zeroinitializer, %y
  %s = select <4 x i1> %ne, <4 x double> %q, <4 x double> %x
  store <4 x double> %s, ptr %g, align 32
  %z = load <4 x double>, ptr %g, align 32
  %ne2 = fcmp une <4 x double> %z, zeroinitializer
  %s2 = select <4 x i1> %ne2, <4 x double> %z, <4 x double> zeroinitializer
  store <4 x double> %s2, ptr getelementptr (i8, ptr @c, i64 32), align 32
  %r = load double, ptr %g, align 32
  ret double %r
}

; Element 0 of %x and %y is +0.0, so element 0 of %q is NaN and the result
; is (NaN bits & %z[0]), not 0.
define i64 @and_fdiv_zero_elt(<2 x double> %a, <2 x double> %b, <2 x i64> %z) {
; SSE-LABEL: and_fdiv_zero_elt:
; SSE:       # %bb.0:
; SSE-NEXT:    xorl %eax, %eax
; SSE-NEXT:    retq
;
; AVX-LABEL: and_fdiv_zero_elt:
; AVX:       # %bb.0:
; AVX-NEXT:    xorl %eax, %eax
; AVX-NEXT:    retq
  %x = shufflevector <2 x double> %a, <2 x double> zeroinitializer, <2 x i32> <i32 2, i32 1>
  %y = shufflevector <2 x double> %b, <2 x double> zeroinitializer, <2 x i32> <i32 2, i32 1>
  %q = fdiv <2 x double> %x, %y
  %i = bitcast <2 x double> %q to <2 x i64>
  %m = and <2 x i64> %i, %z
  %e = extractelement <2 x i64> %m, i32 0
  ret i64 %e
}

