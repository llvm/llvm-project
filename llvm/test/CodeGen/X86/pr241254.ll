; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-- | FileCheck %s

; Element 0 of %vx and %vy is +0.0, so element 0 of the fdiv/frem is NaN and
; must not be treated as a known zero. Element 1 is a variable so that the
; fdiv/frem is not constant folded when the DAG is built.

define double @fdiv_select(double %x, double %y, <2 x i1> %c) {
; CHECK-LABEL: fdiv_select:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pshufd {{.*#+}} xmm0 = xmm2[0,0,2,2]
; CHECK-NEXT:    pslld $31, %xmm0
; CHECK-NEXT:    psrad $31, %xmm0
; CHECK-NEXT:    pand {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm0
; CHECK-NEXT:    retq
  %vx = insertelement <2 x double> zeroinitializer, double %x, i32 1
  %vy = insertelement <2 x double> zeroinitializer, double %y, i32 1
  %d = fdiv <2 x double> %vx, %vy
  %s = select <2 x i1> %c, <2 x double> %d, <2 x double> zeroinitializer
  %r = extractelement <2 x double> %s, i32 0
  ret double %r
}

define double @frem_select(double %x, double %y, <2 x i1> %c) {
; CHECK-LABEL: frem_select:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pshufd {{.*#+}} xmm0 = xmm2[0,0,2,2]
; CHECK-NEXT:    pslld $31, %xmm0
; CHECK-NEXT:    psrad $31, %xmm0
; CHECK-NEXT:    pand {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm0
; CHECK-NEXT:    retq
  %vx = insertelement <2 x double> zeroinitializer, double %x, i32 1
  %vy = insertelement <2 x double> zeroinitializer, double %y, i32 1
  %d = frem <2 x double> %vx, %vy
  %s = select <2 x i1> %c, <2 x double> %d, <2 x double> zeroinitializer
  %r = extractelement <2 x double> %s, i32 0
  ret double %r
}

define i64 @fdiv_and(double %x, double %y, <2 x i64> %z) {
; CHECK-LABEL: fdiv_and:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %xmm2, %rcx
; CHECK-NEXT:    movabsq $9221120237041090560, %rax # imm = 0x7FF8000000000000
; CHECK-NEXT:    andq %rcx, %rax
; CHECK-NEXT:    retq
  %vx = insertelement <2 x double> zeroinitializer, double %x, i32 1
  %vy = insertelement <2 x double> zeroinitializer, double %y, i32 1
  %d = fdiv <2 x double> %vx, %vy
  %b = bitcast <2 x double> %d to <2 x i64>
  %a = and <2 x i64> %b, %z
  %r = extractelement <2 x i64> %a, i32 0
  ret i64 %r
}

define i64 @frem_and(double %x, double %y, <2 x i64> %z) {
; CHECK-LABEL: frem_and:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %xmm2, %rcx
; CHECK-NEXT:    movabsq $9221120237041090560, %rax # imm = 0x7FF8000000000000
; CHECK-NEXT:    andq %rcx, %rax
; CHECK-NEXT:    retq
  %vx = insertelement <2 x double> zeroinitializer, double %x, i32 1
  %vy = insertelement <2 x double> zeroinitializer, double %y, i32 1
  %d = frem <2 x double> %vx, %vy
  %b = bitcast <2 x double> %d to <2 x i64>
  %a = and <2 x i64> %b, %z
  %r = extractelement <2 x i64> %a, i32 0
  ret i64 %r
}
