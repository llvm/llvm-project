; Three defined lanes: the second INSERTPS takes the first as its base, so only
; the first one has poison lanes to zero.
define <4 x float> @insert_three(i64 %a, i64 %b, i64 %c) nounwind {
; SSE41-LABEL: insert_three:
; SSE41:       # %bb.0:
; SSE41-NEXT:    cvtsi2ss %rdi, %xmm0
; SSE41-NEXT:    cvtsi2ss %rsi, %xmm1
; SSE41-NEXT:    insertps {{.*#+}} xmm0 = xmm0[0],xmm1[0],xmm0[2,3]
; SSE41-NEXT:    xorps %xmm1, %xmm1
; SSE41-NEXT:    cvtsi2ss %rdx, %xmm1
; SSE41-NEXT:    insertps {{.*#+}} xmm0 = xmm0[0,1],xmm1[0],xmm0[3]
; SSE41-NEXT:    retq
;
; AVX-LABEL: insert_three:
; AVX:       # %bb.0:
; AVX-NEXT:    vcvtsi2ss %rdi, %xmm15, %xmm0
; AVX-NEXT:    vcvtsi2ss %rsi, %xmm15, %xmm1
; AVX-NEXT:    vinsertps {{.*#+}} xmm0 = xmm0[0],xmm1[0],xmm0[2,3]
; AVX-NEXT:    vcvtsi2ss %rdx, %xmm15, %xmm1
; AVX-NEXT:    vinsertps {{.*#+}} xmm0 = xmm0[0,1],xmm1[0],xmm0[3]
; AVX-NEXT:    retq
  %x = sitofp i64 %a to float
  %y = sitofp i64 %b to float
  %z = sitofp i64 %c to float
  %v0 = insertelement <4 x float> poison, float %x, i64 0
  %v1 = insertelement <4 x float> %v0, float %y, i64 1
  %v2 = insertelement <4 x float> %v1, float %z, i64 2
  ret <4 x float> %v2
}

