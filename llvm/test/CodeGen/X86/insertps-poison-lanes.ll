; When the base of an INSERTPS is a SCALAR_TO_VECTOR, its lanes other than lane 0
; are poison. Without a zero mask, the INSERTPS passes through whatever the
; register held (here, the merge source of the (V)CVTSI2SS).

; A <2 x float> division built from two scalars is widened to v4f32, so the
; poison lanes feed the packed divide.
define <2 x float> @div_two_scalars(ptr %p, float %y) nounwind {
; SSE41-LABEL: div_two_scalars:
; SSE41:       # %bb.0:
; SSE41-NEXT:    cvtsi2ssq 8(%rdi), %xmm2
; SSE41-NEXT:    cvtsi2ssq (%rdi), %xmm1
; SSE41-NEXT:    insertps {{.*#+}} xmm1 = xmm1[0],xmm2[0],xmm1[2,3]
; SSE41-NEXT:    movsldup {{.*#+}} xmm0 = xmm0[0,0,2,2]
; SSE41-NEXT:    divps %xmm0, %xmm1
; SSE41-NEXT:    movaps %xmm1, %xmm0
; SSE41-NEXT:    retq
;
; AVX1-LABEL: div_two_scalars:
; AVX1:       # %bb.0:
; AVX1-NEXT:    vcvtsi2ssq 8(%rdi), %xmm15, %xmm1
; AVX1-NEXT:    vcvtsi2ssq (%rdi), %xmm15, %xmm2
; AVX1-NEXT:    vinsertps {{.*#+}} xmm1 = xmm2[0],xmm1[0],xmm2[2,3]
; AVX1-NEXT:    vmovsldup {{.*#+}} xmm0 = xmm0[0,0,2,2]
; AVX1-NEXT:    vdivps %xmm0, %xmm1, %xmm0
; AVX1-NEXT:    retq
;
; AVX512-LABEL: div_two_scalars:
; AVX512:       # %bb.0:
; AVX512-NEXT:    vcvtsi2ssq 8(%rdi), %xmm15, %xmm1
; AVX512-NEXT:    vcvtsi2ssq (%rdi), %xmm15, %xmm2
; AVX512-NEXT:    vinsertps {{.*#+}} xmm1 = xmm2[0],xmm1[0],xmm2[2,3]
; AVX512-NEXT:    vbroadcastss %xmm0, %xmm0
; AVX512-NEXT:    vdivps %xmm0, %xmm1, %xmm0
; AVX512-NEXT:    retq
  %ip = getelementptr inbounds i8, ptr %p, i64 8
  %i = load i64, ptr %ip, align 8
  %r = load i64, ptr %p, align 8
  %fi = sitofp i64 %i to float
  %fr = sitofp i64 %r to float
  %v0 = insertelement <2 x float> poison, float %fr, i64 0
  %v1 = insertelement <2 x float> %v0, float %fi, i64 1
  %y0 = insertelement <2 x float> poison, float %y, i64 0
  %ys = shufflevector <2 x float> %y0, <2 x float> poison, <2 x i32> zeroinitializer
  %q = fdiv <2 x float> %v1, %ys
  ret <2 x float> %q
}

