; LZCNT:       # %bb.0:
; LZCNT-NEXT:    movq (%rsi), %rax
; LZCNT-NEXT:    movq %rax, (%rdi)
; LZCNT-NEXT:    lzcntq %rdx, %rax
; LZCNT-NEXT:    retq
