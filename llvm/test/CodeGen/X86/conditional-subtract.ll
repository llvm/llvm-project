; Test coverage adapted from llvm/test/CodeGen/AArch64/conditional-subtract.ll.
; Unsigned comparisons.

define i64 @conditional_subtract(i64 %x, i64 %q) {
; CHECK-LABEL: conditional_subtract:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    subq %rsi, %rax
; CHECK-NEXT:    cmovbq %rdi, %rax
; CHECK-NEXT:    retq
  %c = icmp uge i64 %x, %q
  %s = select i1 %c, i64 %q, i64 0
  %r = sub i64 %x, %s
  ret i64 %r
}

