; Reusing SUB must preserve other arithmetic-result and flag consumers.

define i64 @shared_flags(i64 %x, i64 %q, ptr %out) {
; CHECK-LABEL: shared_flags:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xorl %ecx, %ecx
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    subq %rsi, %rax
; CHECK-NEXT:    setae %cl
; CHECK-NEXT:    movq %rcx, (%rdx)
; CHECK-NEXT:    cmovbq %rdi, %rax
; CHECK-NEXT:    retq
  %c = icmp uge i64 %x, %q
  %s = select i1 %c, i64 %q, i64 0
  %flag = zext i1 %c to i64
  store i64 %flag, ptr %out
  %r = sub i64 %x, %s
  ret i64 %r
}

define i64 @shared_difference(i64 %x, i64 %q, ptr %out) {
; CHECK-LABEL: shared_difference:
