; Narrow comparisons have different DAG operands from the outer subtraction.

define i64 @narrow_compare(i64 %x, i64 %q) {
; CHECK-LABEL: narrow_compare:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    xorl %ecx, %ecx
; CHECK-NEXT:    cmpl %esi, %eax
; CHECK-NEXT:    cmovaeq %rsi, %rcx
; CHECK-NEXT:    subq %rcx, %rax
; CHECK-NEXT:    retq
  %xx = trunc i64 %x to i32
  %qq = trunc i64 %q to i32
  %c = icmp uge i32 %xx, %qq
  %s = select i1 %c, i64 %q, i64 0
  %r = sub i64 %x, %s
  ret i64 %r
}

