; SSE2-NEXT:    testb $1, %dil
; SSE2-NEXT:    jne .LBB0_1
; SSE2-NEXT:  # %bb.2:
; SSE2-NEXT:    xorps %xmm0, %xmm0
; SSE2-NEXT:    movaps %xmm0, (%rdx)
; SSE2-NEXT:    retq
; SSE2-NEXT:  .LBB0_1:
; SSE2-NEXT:    movaps (%rsi), %xmm0
; SSE2-NEXT:    movaps %xmm0, (%rdx)
; SSE2-NEXT:    retq
;
; AVX2-LABEL: select_v32i4:
; AVX2:       # %bb.0:
; AVX2-NEXT:    testb $1, %dil
; AVX2-NEXT:    jne .LBB0_1
; AVX2-NEXT:  # %bb.2:
; AVX2-NEXT:    vxorps %xmm0, %xmm0, %xmm0
; AVX2-NEXT:    vmovaps %xmm0, (%rdx)
; AVX2-NEXT:    retq
; AVX2-NEXT:  .LBB0_1:
; AVX2-NEXT:    vmovaps (%rsi), %xmm0
; AVX2-NEXT:    vmovaps %xmm0, (%rdx)
; AVX2-NEXT:    retq
  %v = load <32 x i4>, ptr %p
  %s = select i1 %cond, <32 x i4> %v, <32 x i4> zeroinitializer
  store <32 x i4> %s, ptr %out
  ret void
}

