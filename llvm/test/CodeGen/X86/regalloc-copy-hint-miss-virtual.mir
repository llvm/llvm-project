# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=greedy,virt-reg-rewriter -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=RECOLOR
# RUN: llc -mtriple=x86_64-- -run-pass=greedy,virt-reg-rewriter -verify-machineinstrs -greedy-record-copy-hint-misses=false -greedy-hint-recolor-swap=false -greedy-hint-recolor-queue-partners=false -o - %s | FileCheck %s --check-prefixes=DISABLED
# RUN: llc -mtriple=x86_64-- -run-pass=greedy,virt-reg-rewriter -verify-machineinstrs -greedy-hint-recolor-swap=false -greedy-hint-recolor-queue-partners=false -o - %s | FileCheck %s --check-prefixes=RECOLOR

# Check the enabled defaults, the old behavior with all options disabled,
# and the feature in isolation.

# With the options disabled (reduced from compiler-rt's __multi3), %3 is
# assigned $rax and its copy partner %4 is assigned $rdi, leaving "$rdi = COPY
# killed $rax", although $rdi is free over all of %3. %3's copy partners (%2,
# %4) are virtual registers, and greedy only records a missed hint for late
# hint recoloring when the first hint is a physical register or the register
# was found by eviction.
---
name:            copy_hint_miss_virtual
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdx

    ; RECOLOR-LABEL: name: copy_hint_miss_virtual
    ; RECOLOR: liveins: $rdx
    ; RECOLOR-NEXT: {{  $}}
    ; RECOLOR-NEXT: renamable $ecx = MOV32rr renamable $edx, implicit-def $rcx
    ; RECOLOR-NEXT: renamable $esi = MOV32rr renamable $edx, implicit-def $rsi
    ; RECOLOR-NEXT: renamable $rdi = COPY renamable $rsi
    ; RECOLOR-NEXT: renamable $rsi = IMUL64rr killed renamable $rsi, renamable $rdi, implicit-def dead $eflags
    ; RECOLOR-NEXT: renamable $rax = COPY renamable $rdx
    ; RECOLOR-NEXT: renamable $rcx = IMUL64rr killed renamable $rcx, renamable $rax, implicit-def dead $eflags
    ; RECOLOR-NEXT: renamable $rcx = ADD64rr killed renamable $rcx, killed renamable $rsi, implicit-def dead $eflags
    ; RECOLOR-NEXT: renamable $rdx = IMUL64rr killed renamable $rdx, killed renamable $rdi, implicit-def dead $eflags
    ; RECOLOR-NEXT: renamable $rdx = ADD64rr killed renamable $rdx, killed renamable $rcx, implicit-def dead $eflags
    ; RECOLOR-NEXT: RET 0, $rax, $rdx
    ;
    ; DISABLED-LABEL: name: copy_hint_miss_virtual
    ; DISABLED: liveins: $rdx
    ; DISABLED-NEXT: {{  $}}
    ; DISABLED-NEXT: renamable $ecx = MOV32rr renamable $edx, implicit-def $rcx
    ; DISABLED-NEXT: renamable $esi = MOV32rr renamable $edx, implicit-def $rsi
    ; DISABLED-NEXT: renamable $rax = COPY renamable $rsi
    ; DISABLED-NEXT: renamable $rdi = COPY killed renamable $rax
    ; DISABLED-NEXT: renamable $rsi = IMUL64rr killed renamable $rsi, renamable $rdi, implicit-def dead $eflags
    ; DISABLED-NEXT: renamable $rax = COPY renamable $rdx
    ; DISABLED-NEXT: renamable $rcx = IMUL64rr killed renamable $rcx, renamable $rax, implicit-def dead $eflags
    ; DISABLED-NEXT: renamable $rcx = ADD64rr killed renamable $rcx, killed renamable $rsi, implicit-def dead $eflags
    ; DISABLED-NEXT: renamable $rdx = IMUL64rr killed renamable $rdx, killed renamable $rdi, implicit-def dead $eflags
    ; DISABLED-NEXT: renamable $rdx = ADD64rr killed renamable $rdx, killed renamable $rcx, implicit-def dead $eflags
    ; DISABLED-NEXT: RET 0, $rax, $rdx
    %0:gr64_with_sub_8bit = COPY $rdx
    undef %1.sub_32bit:gr64_with_sub_8bit = MOV32rr %0.sub_32bit
    undef %2.sub_32bit:gr64_with_sub_8bit = MOV32rr %0.sub_32bit
    %3:gr64_with_sub_8bit = COPY %2
    %4:gr64 = COPY %3
    %2:gr64_with_sub_8bit = IMUL64rr %2, %4, implicit-def dead $eflags
    %5:gr64 = COPY %0
    %1:gr64_with_sub_8bit = IMUL64rr %1, %5, implicit-def dead $eflags
    %1:gr64_with_sub_8bit = ADD64rr %1, %2, implicit-def dead $eflags
    %0:gr64_with_sub_8bit = IMUL64rr %0, %4, implicit-def dead $eflags
    %0:gr64_with_sub_8bit = ADD64rr %0, %1, implicit-def dead $eflags
    $rax = COPY %5
    $rdx = COPY %0
    RET 0, $rax, $rdx
...
