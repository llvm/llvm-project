; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -O0 -mtriple=x86_64-linux -verify-machineinstrs | FileCheck %s

; At -O0 the branch is folded during ISel, leaving %bb1 unreachable. Unreachable
; blocks are not removed before register allocation, so the EFLAGS copies in it
; must still be lowered.
define i128 @sadd_sat_i128_unreachable(i128 %arg) {
; CHECK-LABEL: sadd_sat_i128_unreachable:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %rsi, {{[-0-9]+}}(%r{{[sb]}}p) # 8-byte Spill
; CHECK-NEXT:    movq %rdi, {{[-0-9]+}}(%r{{[sb]}}p) # 8-byte Spill
; CHECK-NEXT:    jmp .LBB0_2
; CHECK-NEXT:  # %bb.1: # %bb1
; CHECK-NEXT:    movq {{[-0-9]+}}(%r{{[sb]}}p), %rdx # 8-byte Reload
; CHECK-NEXT:    movq {{[-0-9]+}}(%r{{[sb]}}p), %rax # 8-byte Reload
; CHECK-NEXT:    addq %rax, %rax
; CHECK-NEXT:    adcq %rdx, %rdx
; CHECK-NEXT:    seto %sil
; CHECK-NEXT:    movq %rdx, %rcx
; CHECK-NEXT:    sarq $63, %rcx
; CHECK-NEXT:    testb %sil, %sil
; CHECK-NEXT:    cmovneq %rcx, %rax
; CHECK-NEXT:    movabsq $-9223372036854775808, %rdi # imm = 0x8000000000000000
; CHECK-NEXT:    xorq %rdi, %rcx
; CHECK-NEXT:    testb %sil, %sil
; CHECK-NEXT:    cmovneq %rcx, %rdx
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_2: # %bb2
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    movl %eax, %edx
; CHECK-NEXT:    movq %rdx, %rax
; CHECK-NEXT:    retq
  %cmp = icmp ugt i32 0, 0
  br i1 %cmp, label %bb1, label %bb2

bb1:
  %res = call i128 @llvm.sadd.sat.i128(i128 %arg, i128 %arg)
  ret i128 %res

bb2:
  ret i128 0
}
