# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=x86-flags-copy-lowering -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-- -passes=x86-flags-copy-lowering -verify-machineinstrs -o - %s | FileCheck %s

# An INLINEASM_BR branches to its indirect targets from the middle of its
# block, so EFLAGS that live into an indirect target are the ones at the asm,
# not the ones at the end of the block.

# The EFLAGS copy is after the asm, so its value doesn't reach the indirect
# target, which reads the asm's EFLAGS.
---
name: copy_after_inlineasm_br
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: copy_after_inlineasm_br
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.2, clobber, implicit-def early-clobber $eflags
  ; CHECK-NEXT:   [[SETCCr:%[0-9]+]]:gr8 = SETCCr 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $al = COPY [[SETCCr]]
  ; CHECK-NEXT:   RET 0, $al
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   liveins: $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SETCCr1:%[0-9]+]]:gr8 = SETCCr 2, implicit $eflags
  ; CHECK-NEXT:   $al = COPY [[SETCCr1]]
  ; CHECK-NEXT:   RET 0, $al
  bb.0:
    successors: %bb.1, %bb.2

    INLINEASM_BR &"", attdialect, imm, %bb.2, clobber, implicit-def early-clobber $eflags
    %0:gr32 = COPY $eflags
    $eflags = COPY %0
    %1:gr8 = SETCCr 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    $al = COPY %1
    RET 0, $al

  bb.2 (inlineasm-br-indirect-target):
    liveins: $eflags

    %2:gr8 = SETCCr 2, implicit $eflags
    $al = COPY %2
    RET 0, $al
...

# The EFLAGS copy is before an asm that leaves EFLAGS alone, so its value
# reaches the indirect target too.
---
name: copy_before_inlineasm_br
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: copy_before_inlineasm_br
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   [[SETCCr:%[0-9]+]]:gr8 = SETCCr 4, implicit $eflags
  ; CHECK-NEXT:   [[SETCCr1:%[0-9]+]]:gr8 = SETCCr 2, implicit $eflags
  ; CHECK-NEXT:   [[ADD32ri:%[0-9]+]]:gr32 = ADD32ri [[COPY]], 1, implicit-def dead $eflags
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.2
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $al = COPY [[SETCCr]]
  ; CHECK-NEXT:   RET 0, $al
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   $al = COPY [[SETCCr1]]
  ; CHECK-NEXT:   RET 0, $al
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi

    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    %1:gr32 = COPY $eflags
    %2:gr32 = ADD32ri %0, 1, implicit-def dead $eflags
    $eflags = COPY %1
    INLINEASM_BR &"", attdialect, imm, %bb.2
    %3:gr8 = SETCCr 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    $al = COPY %3
    RET 0, $al

  bb.2 (inlineasm-br-indirect-target):
    liveins: $eflags

    %4:gr8 = SETCCr 2, implicit $eflags
    $al = COPY %4
    RET 0, $al
...

# The EFLAGS copy is in the indirect target, which only the asm reaches, so
# the copy's test can't be hoisted into the asm's block: the end of that block
# only runs when the asm doesn't branch here.
---
name: copy_in_indirect_target
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: copy_in_indirect_target
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.2, clobber, implicit-def early-clobber $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   liveins: $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SETCCr:%[0-9]+]]:gr8 = SETCCr 4, implicit $eflags
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   $al = COPY [[SETCCr]]
  ; CHECK-NEXT:   RET 0, $al
  bb.0:
    successors: %bb.1, %bb.2

    INLINEASM_BR &"", attdialect, imm, %bb.2, clobber, implicit-def early-clobber $eflags
    JMP_1 %bb.1

  bb.1:
    RET 0

  bb.2 (inlineasm-br-indirect-target):
    liveins: $eflags

    %0:gr32 = COPY $eflags
    %1:gr32 = MOV32r0 implicit-def dead $eflags
    $eflags = COPY %0
    %2:gr8 = SETCCr 4, implicit $eflags
    $al = COPY %2
    RET 0, $al
...
