; GREEDY_RA-NEXT:    .cfi_offset %r14, -32
; GREEDY_RA-NEXT:    .cfi_offset %r15, -24
; GREEDY_RA-NEXT:    .cfi_offset %rbp, -16
; GREEDY_RA-NEXT:    movq %r9, {{[-0-9]+}}(%r{{[sb]}}p) # 8-byte Spill
; GREEDY_RA-NEXT:    movq %r8, {{[-0-9]+}}(%r{{[sb]}}p) # 8-byte Spill
