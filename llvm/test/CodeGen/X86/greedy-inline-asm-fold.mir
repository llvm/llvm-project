# An undef use of a folded register is folded along with its other operands,
# so that none is left referring to the register. The second asm clobbers
# every GPR, so its operands must be folded. The third asm's undef use can't
# be folded, so nothing is, and it gets a reload. (There is no C source:
# instruction selection doesn't emit undef inline asm operands.)
name: rm_undef_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi
    ; CHECK-LABEL: name: rm_undef_use
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: MOV64mr %stack.0, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.0)
