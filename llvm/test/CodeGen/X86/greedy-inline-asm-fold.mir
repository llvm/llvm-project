# A value loaded from an immutable stack slot is rematerialized rather than
# spilled, by folding the load into its users. When it's passed to two "rm"
# operands, both fold to the load's stack slot.
#
#   void rm_load_twice(long a, long b, long c, long d, long e, long f,
#                      long g) {
#     asm volatile("" : : "rm"(g), "rm"(g), "r"(a), "r"(b), "r"(c), "r"(d),
#                         "r"(e), "r"(f) : CLOBBERS);
#   }
name: rm_load_twice
tracksRegLiveness: true
fixedStack:
  - { id: 0, size: 8, alignment: 16, isImmutable: true }
body: |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-LABEL: name: rm_load_twice
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr64 = COPY $rdx
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gr64 = COPY $rcx
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:gr64 = COPY $r8
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:gr64 = COPY $r9
    ; CHECK-NEXT: INLINEASM &"", sideeffect mayload attdialect, mem:m ops:5, %fixed-stack.0, 1, $noreg, 0, $noreg, mem:m ops:5, %fixed-stack.0, 1, $noreg, 0, $noreg, reguse:GR64, [[COPY]], reguse:GR64, [[COPY1]], reguse:GR64, [[COPY2]], reguse:GR64, [[COPY3]], reguse:GR64, [[COPY4]], reguse:GR64, [[COPY5]], clobber, implicit-def dead early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15 :: (load (s64) from %fixed-stack.0, align 16)
    ; CHECK-NEXT: RET 0
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr64 = COPY $rdx
    %3:gr64 = COPY $rcx
    %4:gr64 = COPY $r8
    %5:gr64 = COPY $r9
    %6:gr64 = MOV64rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.0, align 16)
    INLINEASM &"", sideeffect attdialect, reguse:GR64 foldable, %6, reguse:GR64 foldable, %6, reguse:GR64, %0, reguse:GR64, %1, reguse:GR64, %2, reguse:GR64, %3, reguse:GR64, %4, reguse:GR64, %5, clobber, implicit-def dead early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15
    RET 0
...
---
# One value passed to an "rm" and an "r" operand isn't folded, since the "r"
# operand needs it in a register anyway, so the allocator must not count on
# spilling it: %h, which only lives across the asm, is spilled instead.
