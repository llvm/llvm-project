# A read-write "+rm" operand on an uninitialized value: the tied input is
# undef, so folding the pair writes the stack slot but doesn't read it. The
# folded asm is "maystore" without "mayload" and has only a store memoperand.
# The output is early-clobber so that it can't share a register with one of
# the inputs; otherwise six GPRs would be enough and nothing would be folded.
#
#   long tied_rm_undef(long b, long c, long d, long e, long f, long g) {
#     long a;
#     asm volatile("" : "+&rm"(a) : "r"(b), "r"(c), "r"(d), "r"(e), "r"(f),
#                                   "r"(g) : CLOBBERS);
#     return a;
#   }
name: tied_rm_undef
tracksRegLiveness: true
registers:
  - { id: 0, class: gr64 }
body: |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-LABEL: name: tied_rm_undef
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr64 = COPY $rdx
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gr64 = COPY $rcx
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:gr64 = COPY $r8
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:gr64 = COPY $r9
    ; CHECK-NEXT: INLINEASM &"", sideeffect maystore attdialect, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, reguse:GR64, [[COPY]], reguse:GR64, [[COPY1]], reguse:GR64, [[COPY2]], reguse:GR64, [[COPY3]], reguse:GR64, [[COPY4]], reguse:GR64, [[COPY5]], mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, clobber, implicit-def dead early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    ; CHECK-NEXT: RET 0, $rax
    %1:gr64 = COPY $rdi
    %2:gr64 = COPY $rsi
    %3:gr64 = COPY $rdx
    %4:gr64 = COPY $rcx
    %5:gr64 = COPY $r8
    %6:gr64 = COPY $r9
    INLINEASM &"", sideeffect attdialect, regdef-ec:GR64 foldable, def early-clobber %0, reguse:GR64, %1, reguse:GR64, %2, reguse:GR64, %3, reguse:GR64, %4, reguse:GR64, %5, reguse:GR64, %6, reguse tiedto:$0, undef %0(tied-def 3), clobber, implicit-def dead early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15
    $rax = COPY %0
