# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -mattr=+fma,+avx512f,+avx512vl -run-pass=register-coalescer -verify-coalescing -o - %s | FileCheck %s

# Removing the copy of the FMA result into the accumulator needs the tied
# operand commuted with operand 2, which reads the accumulator. The target's
# preferred partner is operand 3.

---
name: fma_partner_op2
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: fma_partner_op2
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[MOVAPSrm:%[0-9]+]]:vr128 = MOVAPSrm [[COPY]], 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   [[MOVAPSrm1:%[0-9]+]]:vr128 = MOVAPSrm [[COPY]], 1, $noreg, 16, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOVAPSrm2:%[0-9]+]]:vr128 = MOVAPSrm [[COPY]], 1, $noreg, 32, $noreg
  ; CHECK-NEXT:   [[MOVAPSrm:%[0-9]+]]:vr128 = VFMADD213PSr [[MOVAPSrm]], [[MOVAPSrm2]], [[MOVAPSrm1]], implicit $mxcsr
  ; CHECK-NEXT:   TEST64rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   MOVAPSmr [[COPY]], 1, $noreg, 48, $noreg, [[MOVAPSrm]]
  ; CHECK-NEXT:   RET 0
  bb.0:
    liveins: $rdi

    %0:gr64 = COPY $rdi
    %1:vr128 = MOVAPSrm %0, 1, $noreg, 0, $noreg
    %2:vr128 = MOVAPSrm %0, 1, $noreg, 16, $noreg

  bb.1:
    %3:vr128 = MOVAPSrm %0, 1, $noreg, 32, $noreg
    %3:vr128 = VFMADD213PSr %3, killed %1, %2, implicit $mxcsr
    %1:vr128 = COPY %3
    TEST64rr %0, %0, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    MOVAPSmr %0, 1, $noreg, 48, $noreg, %1
    RET 0
...

# With merge masking, operand 1 cannot be commuted, so the copy stays.
---
name: masked_fma_partner_op2
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: masked_fma_partner_op2
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $k1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vk4wm = COPY $k1
  ; CHECK-NEXT:   [[VMOVAPSZ128rm:%[0-9]+]]:vr128x = VMOVAPSZ128rm [[COPY]], 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   [[VMOVAPSZ128rm1:%[0-9]+]]:vr128x = VMOVAPSZ128rm [[COPY]], 1, $noreg, 16, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[VMOVAPSZ128rm2:%[0-9]+]]:vr128x = VMOVAPSZ128rm [[COPY]], 1, $noreg, 32, $noreg
  ; CHECK-NEXT:   [[VMOVAPSZ128rm2:%[0-9]+]]:vr128x = VFMADD213PSZ128rk [[VMOVAPSZ128rm2]], [[COPY1]], [[VMOVAPSZ128rm]], [[VMOVAPSZ128rm1]], implicit $mxcsr
  ; CHECK-NEXT:   [[VMOVAPSZ128rm:%[0-9]+]]:vr128x = COPY [[VMOVAPSZ128rm2]]
  ; CHECK-NEXT:   TEST64rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   VMOVAPSZ128mr [[COPY]], 1, $noreg, 48, $noreg, [[VMOVAPSZ128rm]]
  ; CHECK-NEXT:   RET 0
  bb.0:
    liveins: $rdi, $k1

    %0:gr64 = COPY $rdi
    %1:vk4wm = COPY $k1
    %2:vr128x = VMOVAPSZ128rm %0, 1, $noreg, 0, $noreg
    %3:vr128x = VMOVAPSZ128rm %0, 1, $noreg, 16, $noreg

  bb.1:
    %4:vr128x = VMOVAPSZ128rm %0, 1, $noreg, 32, $noreg
    %4:vr128x = VFMADD213PSZ128rk %4, %1, killed %2, %3, implicit $mxcsr
    %2:vr128x = COPY %4
    TEST64rr %0, %0, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    VMOVAPSZ128mr %0, 1, $noreg, 48, $noreg, %2
    RET 0
...
