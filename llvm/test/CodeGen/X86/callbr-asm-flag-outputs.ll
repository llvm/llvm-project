; An asm goto's indirect target reads the asm's flag outputs from the EFLAGS
; that live into it from the asm. Nothing after the asm in its block runs on
; the way there, so the indirect target can't use a flag read or an EFLAGS
; copy from there, and it has to read EFLAGS before anything clobbers it.
;
; Each opt level hits problems that the other doesn't. At -O0, the fallthrough
; path copies EFLAGS after the asm, and every output is exported. At -O2,
; MachineCSE runs, and the scheduler can move a clobber ahead of a flag read.

; A flag output that both paths out of an asm goto read (#60827). EFLAGS is
; live into the indirect target, which computes its own sete: the one after
; the asm doesn't run when the asm branches there.
define i8 @test_flag_output_on_both_paths() {
; O0-LABEL: test_flag_output_on_both_paths:
; O0:       # %bb.0: # %entry
; O0-NEXT:    #APP
; O0-NEXT:    #NO_APP
; O0-NEXT:    sete %al
; O0-NEXT:    movb %al, {{[-0-9]+}}(%r{{[sb]}}p) # 1-byte Spill
; O0-NEXT:    jmp .LBB0_1
; O0-NEXT:  .LBB0_1: # %ft
; O0-NEXT:    movb {{[-0-9]+}}(%r{{[sb]}}p), %al # 1-byte Reload
; O0-NEXT:    retq
; O0-NEXT:  .LBB0_2: # Inline asm indirect target
; O0-NEXT:    # %ind
; O0-NEXT:    # Label of block must be emitted
; O0-NEXT:    sete %al
; O0-NEXT:    addb $7, %al
; O0-NEXT:    retq
;
; O2-LABEL: test_flag_output_on_both_paths:
; O2:       # %bb.0: # %entry
; O2-NEXT:    #APP
; O2-NEXT:    #NO_APP
; O2-NEXT:    sete %al
; O2-NEXT:  # %bb.1: # %ft
; O2-NEXT:    retq
; O2-NEXT:  .LBB0_2: # Inline asm indirect target
; O2-NEXT:    # %ind
; O2-NEXT:    # Label of block must be emitted
; O2-NEXT:    sete %al
; O2-NEXT:    addb $7, %al
; O2-NEXT:    retq
entry:
  %r = callbr i8 asm "", "={@ccz},!i,~{dirflag},~{fpsr},~{flags}"()
          to label %ft [label %ind]

ft:
  ret i8 %r

ind:
  %s = add i8 %r, 7
  ret i8 %s
}

