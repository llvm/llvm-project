# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 3
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -passes=x86-fixup-inst-tuning -o - %s | FileCheck %s

# `mov reg, 0` is emitted instead of the XOR zero idiom when EFLAGS could not
# be proven dead during register allocation (see X86InstrInfo::reMaterialize).
# When the final instruction order leaves EFLAGS dead, rewrite it to XOR,
# three bytes shorter. EFLAGS readers in the same block or live-in to a
# successor must keep the MOV.

--- |
  define void @flags_dead_by_def() nounwind { ret void }
  define void @flags_dead_at_ret() nounwind { ret void }
  define void @flags_live_setcc() nounwind { ret void }
  define void @flags_livein_succ() nounwind { ret void }
  define void @nonzero_imm() nounwind { ret void }
  define void @superreg_def() nounwind { ret void }

---
name:            flags_dead_by_def
body:             |
  bb.0:
    liveins: $rdi, $rsi
    ; CHECK-LABEL: name: flags_dead_by_def
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    ; CHECK-NEXT: CMP64rr renamable $rdi, renamable $rsi, implicit-def $eflags
    ; CHECK-NEXT: renamable $cl = SETCCr 4, implicit $eflags
    ; CHECK-NEXT: RET64 implicit $eax, implicit $cl
    renamable $eax = MOV32ri 0
    CMP64rr renamable $rdi, renamable $rsi, implicit-def $eflags
    renamable $cl = SETCCr 4, implicit $eflags
    RET64 implicit $eax, implicit $cl
...
---
name:            flags_dead_at_ret
body:             |
  bb.0:
    ; CHECK-LABEL: name: flags_dead_at_ret
    ; CHECK: $eax = XOR32rr undef $eax, undef $eax, implicit-def dead $eflags
    ; CHECK-NEXT: RET64 implicit $eax
    renamable $eax = MOV32ri 0
    RET64 implicit $eax
...
---
name:            flags_live_setcc
body:             |
  bb.0:
    liveins: $rdi, $rsi
    ; CHECK-LABEL: name: flags_live_setcc
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: CMP64rr renamable $rdi, renamable $rsi, implicit-def $eflags
    ; CHECK-NEXT: renamable $eax = MOV32ri 0
    ; CHECK-NEXT: renamable $cl = SETCCr 4, implicit killed $eflags
    ; CHECK-NEXT: RET64 implicit $eax, implicit $cl
    CMP64rr renamable $rdi, renamable $rsi, implicit-def $eflags
    renamable $eax = MOV32ri 0
    renamable $cl = SETCCr 4, implicit killed $eflags
    RET64 implicit $eax, implicit $cl
...
---
name:            flags_livein_succ
body:             |
  ; CHECK-LABEL: name: flags_livein_succ
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   CMP64rr renamable $rdi, renamable $rsi, implicit-def $eflags
  ; CHECK-NEXT:   renamable $eax = MOV32ri 0
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eflags, $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $cl = SETCCr 4, implicit killed $eflags
  ; CHECK-NEXT:   RET64 implicit $eax, implicit $cl
  bb.0:
    successors: %bb.1
    liveins: $rdi, $rsi
    CMP64rr renamable $rdi, renamable $rsi, implicit-def $eflags
    renamable $eax = MOV32ri 0
    JMP_1 %bb.1
  bb.1:
    liveins: $eflags, $eax
    renamable $cl = SETCCr 4, implicit killed $eflags
    RET64 implicit $eax, implicit $cl
...
---
name:            nonzero_imm
body:             |
  bb.0:
    ; CHECK-LABEL: name: nonzero_imm
    ; CHECK: renamable $eax = MOV32ri 1
    ; CHECK-NEXT: RET64 implicit $eax
    renamable $eax = MOV32ri 1
    RET64 implicit $eax
...
---
name:            superreg_def
body:             |
  bb.0:
    ; CHECK-LABEL: name: superreg_def
    ; CHECK: $eax = XOR32rr undef $eax, undef $eax, implicit-def $rax, implicit-def dead $eflags
    ; CHECK-NEXT: RET64 implicit $rax
    renamable $eax = MOV32ri 0, implicit-def $rax
    RET64 implicit $rax
...
