; PR105223: a tailcc callee pops its stack arguments. When one of them needs a
; 16-byte aligned slot, the caller must expect the amount the callee pops,
; around a normal call and when it moves the return address for a musttail
; call.

; %x takes the 16-byte aligned slot at offset 0 and %p the one at offset 16,
; so the callee pops 24 bytes.
define internal tailcc void @callee_i128(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f, i128 %x, ptr %p) noinline {
; CHECK-LABEL: callee_i128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    retq $24
  ret void
}

define void @call_i128() nounwind {
; CHECK-LABEL: call_i128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    subq $24, %rsp
; CHECK-NEXT:    movq $0, 16(%rsp)
; CHECK-NEXT:    movq $0, 8(%rsp)
; CHECK-NEXT:    movq $6, (%rsp)
; CHECK-NEXT:    movl $1, %esi
; CHECK-NEXT:    movl $2, %edx
; CHECK-NEXT:    movl $3, %ecx
; CHECK-NEXT:    movl $4, %r8d
; CHECK-NEXT:    movl $5, %r9d
; CHECK-NEXT:    xorl %edi, %edi
; CHECK-NEXT:    callq callee_i128
; CHECK-NEXT:    retq
  call tailcc void @callee_i128(i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i128 6, ptr null)
  ret void
}

