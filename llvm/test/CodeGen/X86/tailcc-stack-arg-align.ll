; @musttail_i128 pops 8 bytes and its callee 24, so the return address moves
; down by 16 bytes.
declare tailcc ptr @callee_i128_ptr(ptr, ptr, ptr, ptr, ptr, ptr, i128, ptr)

define tailcc ptr @musttail_i128(ptr %p) nounwind {
; CHECK-LABEL: musttail_i128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    subq $16, %rsp
; CHECK-NEXT:    movq %rdi, 24(%rsp)
; CHECK-NEXT:    movq 16(%rsp), %rax
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    movaps %xmm0, 8(%rsp)
; CHECK-NEXT:    movq %rax, (%rsp)
; CHECK-NEXT:    movq %rdi, %rsi
; CHECK-NEXT:    movq %rdi, %rdx
; CHECK-NEXT:    movq %rdi, %rcx
; CHECK-NEXT:    movq %rdi, %r8
; CHECK-NEXT:    movq %rdi, %r9
; CHECK-NEXT:    jmp callee_i128_ptr@PLT # TAILCALL
  %r = musttail call tailcc ptr @callee_i128_ptr(ptr %p, ptr %p, ptr %p, ptr %p, ptr %p, ptr %p, i128 0, ptr %p)
  ret ptr %r
}

