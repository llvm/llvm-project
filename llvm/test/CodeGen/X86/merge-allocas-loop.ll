; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; Four fixed-size allocas live in a loop body (not the entry block), so each
; one used to lower as its own independent dynamic stack allocation: four
; separate read-adjust-write sequences on the stack pointer every
; iteration, instead of one combined adjustment with four constant offsets.
; See https://github.com/llvm/llvm-project/issues/1334.
;
; MergeAllocas coalesces the four into one before instruction selection, so
; the loop body below should show exactly one "movq %rsp" / write back to
; %rsp per iteration, not four.

define void @patatino(i1 %c) {
; CHECK-LABEL: patatino:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %rbp
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset %rbp, -16
; CHECK-NEXT:    movq %rsp, %rbp
; CHECK-NEXT:    .cfi_def_cfa_register %rbp
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    .cfi_offset %rbx, -32
; CHECK-NEXT:    .cfi_offset %r14, -24
; CHECK-NEXT:    movl %edi, %ebx
; CHECK-NEXT:    movabsq $4294967297, %r14 # imm = 0x100000001
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %next
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movq %rsp, %rax
; CHECK-NEXT:    leaq -16(%rax), %rdi
; CHECK-NEXT:    movq %rdi, %rsp
; CHECK-NEXT:    leaq -12(%rax), %rsi
; CHECK-NEXT:    leaq -8(%rax), %rdx
; CHECK-NEXT:    leaq -4(%rax), %rcx
; CHECK-NEXT:    movq %r14, -16(%rax)
; CHECK-NEXT:    movq %r14, -8(%rax)
; CHECK-NEXT:    callq test@PLT
; CHECK-NEXT:    testb $1, %bl
; CHECK-NEXT:    jne .LBB0_1
; CHECK-NEXT:  # %bb.2: # %out
; CHECK-NEXT:    leaq -16(%rbp), %rsp
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    popq %r14
; CHECK-NEXT:    popq %rbp
; CHECK-NEXT:    .cfi_def_cfa %rsp, 8
; CHECK-NEXT:    retq
entry:
  br label %next

next:
  %a = alloca i32
  %b = alloca i32
  %c1 = alloca i32
  %d = alloca i32
  store i32 1, ptr %a
  store i32 1, ptr %b
  store i32 1, ptr %c1
  store i32 1, ptr %d
  call void @test(ptr %a, ptr %b, ptr %c1, ptr %d)
  br i1 %c, label %next, label %out

out:
  ret void
}

declare void @test(ptr, ptr, ptr, ptr)
