# RUN: llc -mtriple=x86_64-- -mattr=+avx512vl,+avx512dq -run-pass=greedy,virt-reg-rewriter -verify-machineinstrs -greedy-record-copy-hint-misses -greedy-hint-recolor-swap -o - %s | FileCheck %s --check-prefixes=RECOLOR

# The inline asm result %2 must be defined in $ymm0, the only vector register
# it doesn't clobber, and %1 is spilled across it. After splitting, the reload
# of %1 is in $ymm0 and the rest of %2 is in $ymm2, joined by
# "$ymm2 = COPY killed $ymm0". Putting the reload in $ymm2 instead would let %2
# stay in $ymm0 and remove the copy, but late hint recoloring only moves a
# live range to a register that is free, and here $ymm0 is held by the reload.
---
name:            copy_hint_swap_interference
tracksRegLiveness: true
registers:
  - { id: 2, class: vr256 }
body:             |
  bb.0:
    liveins: $ymm1

    ; DEFAULT-LABEL: name: copy_hint_swap_interference
    ; DEFAULT: liveins: $ymm1
    ; DEFAULT-NEXT: {{  $}}
    ; DEFAULT-NEXT: VMOVUPSZ256mr %stack.0, 1, $noreg, 0, $noreg, $ymm1 :: (store (s256) into %stack.0, align 16)
