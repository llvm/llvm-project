    ; RECOLOR-NEXT: renamable $ymm2 = nofpexcept VCVTQQ2PDZ256rr killed renamable $ymm2, implicit $mxcsr
    ; RECOLOR-NEXT: renamable $ymm0 = nofpexcept VADDPDZ256rr killed renamable $ymm0, killed renamable $ymm2, implicit $mxcsr
