    ; RECOLOR-NEXT: RET 0, $ymm0
    %1:vr256x = COPY $ymm1
    INLINEASM &nop, sideeffect attdialect, regdef:VR256, def %2, clobber, implicit-def dead early-clobber $xmm1, clobber, implicit-def dead early-clobber $xmm2, clobber, implicit-def dead early-clobber $xmm3, clobber, implicit-def dead early-clobber $xmm4, clobber, implicit-def dead early-clobber $xmm5, clobber, implicit-def dead early-clobber $xmm6, clobber, implicit-def dead early-clobber $xmm7, clobber, implicit-def dead early-clobber $xmm8, clobber, implicit-def dead early-clobber $xmm9, clobber, implicit-def dead early-clobber $xmm10, clobber, implicit-def dead early-clobber $xmm11, clobber, implicit-def dead early-clobber $xmm12, clobber, implicit-def dead early-clobber $xmm13, clobber, implicit-def dead early-clobber $xmm14, clobber, implicit-def dead early-clobber $xmm15, clobber, implicit-def dead early-clobber $xmm16, clobber, implicit-def dead early-clobber $xmm17, clobber, implicit-def dead early-clobber $xmm18, clobber, implicit-def dead early-clobber $xmm19, clobber, implicit-def dead early-clobber $xmm20, clobber, implicit-def dead early-clobber $xmm21, clobber, implicit-def dead early-clobber $xmm22, clobber, implicit-def dead early-clobber $xmm23, clobber, implicit-def dead early-clobber $xmm24, clobber, implicit-def dead early-clobber $xmm25, clobber, implicit-def dead early-clobber $xmm26, clobber, implicit-def dead early-clobber $xmm27, clobber, implicit-def dead early-clobber $xmm28, clobber, implicit-def dead early-clobber $xmm29, clobber, implicit-def dead early-clobber $xmm30, clobber, implicit-def dead early-clobber $xmm31, clobber, implicit-def dead early-clobber $eflags
    %3:vr256x = VPERMPDZ256rr %1, %2
    %4:vr256x = nofpexcept VCVTQQ2PDZ256rr %1, implicit $mxcsr
    %5:vr256x = nofpexcept VADDPDZ256rr %2, %4, implicit $mxcsr
    %6:vr256x = nofpexcept VADDPDZ256rr %3, %5, implicit $mxcsr
    $ymm0 = COPY %6
