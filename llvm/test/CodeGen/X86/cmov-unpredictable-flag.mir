# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64 -start-before=x86-isel -stop-after=finalize-isel -verify-machineinstrs %s -o - | FileCheck %s

# The unpredictable flag of a select through the CMOV rewrites in combineCMov.
# The machine functions have no body: instruction selection runs on the
# embedded IR and the checks are its output.

--- |
  ; Simplified EFLAGS: the compare of the atomic result is folded into the
  ; flags of the lock add.
  define i32 @simplified_eflags(ptr %p, i32 %x, i32 %y) {
    %old = atomicrmw add ptr %p, i32 1 seq_cst
    %c = icmp slt i32 %old, 0
    %r = select i1 %c, i32 %x, i32 %y, !unpredictable !0
    ret i32 %r
  }

  ; and/or of two setcc sharing EFLAGS (oeq is ZF and not PF), folded into two
  ; CMOVs.
  define i32 @double_cmov(float %a, float %b, i32 %x, i32 %y) {
    %c = fcmp oeq float %a, %b
    %r = select i1 %c, i32 %x, i32 %y, !unpredictable !0
    ret i32 %r
  }

  ; select (x == 0), 0, y -> select (x == 0), x, y.
  define i32 @constant_to_register(i32 %a, i32 %y) {
    %c = icmp eq i32 %a, 0
    %r = select i1 %c, i32 0, i32 %y, !unpredictable !0
    ret i32 %r
  }

  ; select (x == 0), C, (cttz x) + C2 -> (cmov (C - C2), (cttz x)) + C2.
  define i32 @cttz_add(i32 %a) {
    %t = call i32 @llvm.cttz.i32(i32 %a, i1 true)
    %add = add i32 %t, 1
    %c = icmp eq i32 %a, 0
    %r = select i1 %c, i32 33, i32 %add, !unpredictable !0
    ret i32 %r
  }

  declare i32 @llvm.cttz.i32(i32, i1)

  !0 = !{}
...
---
name: simplified_eflags
tracksRegLiveness: true
noVRegs: false
body: |
  ; CHECK-LABEL: name: simplified_eflags
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $rdi, $esi, $edx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edx
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   LOCK_INC32m [[COPY2]], 1, $noreg, 0, $noreg, implicit-def $eflags :: (load store seq_cst (s32) on %ir.p)
  ; CHECK-NEXT:   [[CMOV32rr:%[0-9]+]]:gr32 = unpredictable CMOV32rr [[COPY]], [[COPY1]], 14, implicit $eflags
  ; CHECK-NEXT:   $eax = COPY [[CMOV32rr]]
  ; CHECK-NEXT:   RET 0, $eax
...
---
name: double_cmov
tracksRegLiveness: true
noVRegs: false
body: |
  ; CHECK-LABEL: name: double_cmov
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $xmm0, $xmm1, $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:fr32 = COPY $xmm1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:fr32 = COPY $xmm0
  ; CHECK-NEXT:   nofpexcept UCOMISSrr [[COPY3]], [[COPY2]], implicit-def $eflags, implicit $mxcsr
  ; CHECK-NEXT:   [[CMOV32rr:%[0-9]+]]:gr32 = unpredictable CMOV32rr [[COPY1]], [[COPY]], 5, implicit $eflags
  ; CHECK-NEXT:   [[CMOV32rr1:%[0-9]+]]:gr32 = unpredictable CMOV32rr [[CMOV32rr]], [[COPY]], 10, implicit $eflags
  ; CHECK-NEXT:   $eax = COPY [[CMOV32rr1]]
  ; CHECK-NEXT:   RET 0, $eax
...
---
name: constant_to_register
tracksRegLiveness: true
noVRegs: false
body: |
  ; CHECK-LABEL: name: constant_to_register
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   TEST32rr [[COPY1]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   [[CMOV32rr:%[0-9]+]]:gr32 = unpredictable CMOV32rr [[COPY]], [[COPY1]], 4, implicit $eflags
  ; CHECK-NEXT:   $eax = COPY [[CMOV32rr]]
  ; CHECK-NEXT:   RET 0, $eax
...
---
name: cttz_add
tracksRegLiveness: true
noVRegs: false
body: |
  ; CHECK-LABEL: name: cttz_add
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[BSF32rr:%[0-9]+]]:gr32 = BSF32rr [[DEF]], [[COPY]], implicit-def dead $eflags
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 32
  ; CHECK-NEXT:   [[CMOV32rr:%[0-9]+]]:gr32 = unpredictable CMOV32rr [[MOV32ri]], killed [[BSF32rr]], 5, implicit $eflags
  ; CHECK-NEXT:   [[INC32r:%[0-9]+]]:gr32 = INC32r [[CMOV32rr]], implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[INC32r]]
  ; CHECK-NEXT:   RET 0, $eax
...
