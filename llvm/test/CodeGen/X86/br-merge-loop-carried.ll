; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-- | FileCheck %s

; The second compare only depends on a phi, so the cost of the loop-carried
; mul/add feeding it shouldn't decide whether the conditions are merged.

declare i64 @next(i64)
declare void @g()

define void @loop_mul(i64 %lo, i64 %hi, i64 %d0, i64 %d1) nounwind {
; CHECK-LABEL: loop_mul:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %r15
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    pushq %r12
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movq %rcx, %rbx
; CHECK-NEXT:    movq %rdx, %r14
; CHECK-NEXT:    movq %rsi, %r15
; CHECK-NEXT:    movq %rdi, %r12
; CHECK-NEXT:    jmp .LBB0_1
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_3: # %latch
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    movq %r12, %rdi
; CHECK-NEXT:    callq next@PLT
; CHECK-NEXT:    movq %rax, %r12
; CHECK-NEXT:    leaq (%r15,%r15,2), %r15
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movq %r12, %rax
; CHECK-NEXT:    xorq %r14, %rax
; CHECK-NEXT:    movq %r15, %rcx
; CHECK-NEXT:    xorq %rbx, %rcx
; CHECK-NEXT:    orq %rax, %rcx
; CHECK-NEXT:    jne .LBB0_3
; CHECK-NEXT:  # %bb.2: # %then
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    callq g@PLT
; CHECK-NEXT:    jmp .LBB0_3
entry:
  br label %loop

loop:
  %lo.p = phi i64 [ %lo, %entry ], [ %lo.next, %latch ]
  %hi.p = phi i64 [ %hi, %entry ], [ %hi.next, %latch ]
  %c0 = icmp eq i64 %lo.p, %d0
  %c1 = icmp eq i64 %hi.p, %d1
  %c = select i1 %c0, i1 %c1, i1 false
  br i1 %c, label %then, label %latch

then:
  call void @g()
  br label %latch

latch:
  %lo.next = call i64 @next(i64 %lo.p)
  %hi.next = mul i64 %hi.p, 3
  br label %loop
}

define void @loop_add(i64 %lo, i64 %hi, i64 %d0, i64 %d1) nounwind {
; CHECK-LABEL: loop_add:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushq %r15
; CHECK-NEXT:    pushq %r14
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    movq %rcx, %rbx
; CHECK-NEXT:    movq %rdx, %r14
; CHECK-NEXT:    movq %rdi, %r15
; CHECK-NEXT:    subq %rsi, %rbx
; CHECK-NEXT:    jmp .LBB1_1
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB1_3: # %latch
; CHECK-NEXT:    # in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    movq %r15, %rdi
; CHECK-NEXT:    callq next@PLT
; CHECK-NEXT:    movq %rax, %r15
; CHECK-NEXT:    addq $-3, %rbx
; CHECK-NEXT:  .LBB1_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movq %r15, %rax
; CHECK-NEXT:    xorq %r14, %rax
; CHECK-NEXT:    orq %rbx, %rax
; CHECK-NEXT:    jne .LBB1_3
; CHECK-NEXT:  # %bb.2: # %then
; CHECK-NEXT:    # in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    callq g@PLT
; CHECK-NEXT:    jmp .LBB1_3
entry:
  br label %loop

loop:
  %lo.p = phi i64 [ %lo, %entry ], [ %lo.next, %latch ]
  %hi.p = phi i64 [ %hi, %entry ], [ %hi.next, %latch ]
  %c0 = icmp eq i64 %lo.p, %d0
  %c1 = icmp eq i64 %hi.p, %d1
  %c = select i1 %c0, i1 %c1, i1 false
  br i1 %c, label %then, label %latch

then:
  call void @g()
  br label %latch

latch:
  %lo.next = call i64 @next(i64 %lo.p)
  %hi.next = add i64 %hi.p, 3
  br label %loop
}
