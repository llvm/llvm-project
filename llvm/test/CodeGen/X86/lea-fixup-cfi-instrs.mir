# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "ADD64ri32|LEA64r" --version 6
# Check that CFI instructions do not count towards the neighborhood of the
# EFLAGS liveness query. Without unwind tables, CFI is only emitted with debug
# information, so counting it made the LEA-to-ADD conversion depend on -g.
# The NOOP counts exercise computeRegisterLiveness's default neighborhood of 10.
# RUN: llc -mtriple=x86_64 -run-pass=x86-fixup-leas -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64 -passes="require<profile-summary>,function(machine-function(x86-fixup-leas))" -verify-machineinstrs -o - %s | FileCheck %s

--- |
  define i64 @cfi_before(i64 %a) {
  entry:
    ret i64 0
  }

  define i64 @cfi_after(i64 %a) {
  entry:
    ret i64 0
  }
...
---
name:            cfi_before
tracksRegLiveness: true
liveins:
  - { reg: '$rdi' }
body:             |
  bb.0.entry:
    liveins: $rdi

    ; The forward scan exhausts its neighborhood before reaching the end of the
    ; block. The backward scan must skip CFI both inside and before its window.
    ; CHECK-LABEL: name: cfi_before
    ; CHECK: $rdi = ADD64ri32 $rdi, 216, implicit-def $eflags
    CFI_INSTRUCTION def_cfa_register $rbp
    NOOP
    CFI_INSTRUCTION def_cfa_offset 16
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    $rdi = LEA64r $rdi, 1, $noreg, 216, $noreg
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    RET64 $rdi
...
---
name:            cfi_after
tracksRegLiveness: true
liveins:
  - { reg: '$rdi' }
body:             |
  bb.0.entry:
    liveins: $rdi, $eflags

    ; EFLAGS is live in, so only the forward scan can prove it dead. It reaches
    ; the end of the block only if CFI is skipped.
    ; CHECK-LABEL: name: cfi_after
    ; CHECK: $rdi = ADD64ri32 $rdi, 216, implicit-def $eflags
    $rdi = LEA64r $rdi, 1, $noreg, 216, $noreg
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    NOOP
    CFI_INSTRUCTION def_cfa_register $rbp
    RET64 $rdi
...
