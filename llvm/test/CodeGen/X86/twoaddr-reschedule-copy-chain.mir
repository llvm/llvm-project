# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=i386-unknown-linux -mattr=+sse2 -run-pass=liveintervals,twoaddressinstruction -o - %s | FileCheck %s

# Rescheduling %2 below its kill also moves the copies following
# it. They have to move in reverse order, or %3 ends up below the copy
# reading it.

---
name:            reschedule_copy_chain
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: reschedule_copy_chain
    ; CHECK: [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
    ; CHECK-NEXT: [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
    ; CHECK-NEXT: [[MOVDI2PDIrr:%[0-9]+]]:vr128 = MOVDI2PDIrr [[MOV32ri]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = SUB32rr [[COPY]], [[MOV32ri1]], implicit-def dead $eflags
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr32_abcd = COPY [[COPY]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr8 = COPY [[COPY1]].sub_8bit
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vr128 = COPY [[MOVDI2PDIrr]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vr128 = PSRLDri [[COPY3]], 3
    ; CHECK-NEXT: $al = COPY [[COPY2]]
    ; CHECK-NEXT: $xmm0 = COPY [[COPY3]]
    ; CHECK-NEXT: RET 0, implicit killed $al, implicit killed $xmm0
    %0:gr32 = MOV32ri 1
    %1:gr32 = MOV32ri 2
    %2:gr32 = SUB32rr %0, %1, implicit-def dead $eflags
    %3:gr32_abcd = COPY %2
    %4:gr8 = COPY %3.sub_8bit
    %5:vr128 = MOVDI2PDIrr %0
    %6:vr128 = PSRLDri %5, 3
    $al = COPY %4
    $xmm0 = COPY %6
    RET 0, implicit killed $al, implicit killed $xmm0
...
