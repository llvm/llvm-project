; AVX-LABEL: div_sqrt_reassoc_eq_zero_vec:
; AVX:       # %bb.0:
; AVX-NEXT:    vsqrtpd %xmm0, %xmm1
; AVX-NEXT:    vdivpd %xmm1, %xmm0, %xmm0
; AVX-NEXT:    vxorpd %xmm1, %xmm1, %xmm1
; AVX-NEXT:    vcmpeqpd %xmm1, %xmm0, %xmm0
; AVX-NEXT:    retq
  %sqrt = call reassoc <2 x double> @llvm.sqrt.v2f64(<2 x double> %x)
  %div = fdiv reassoc <2 x double> %x, %sqrt
  %cmp = fcmp oeq <2 x double> %div, zeroinitializer
  %result = sext <2 x i1> %cmp to <2 x i64>
  ret <2 x i64> %result
}

