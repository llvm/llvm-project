}

define <2 x i64> @div_sqrt_reassoc_eq_zero_vec(<2 x double> %x) {
; SSE-LABEL: div_sqrt_reassoc_eq_zero_vec:
; SSE:       # %bb.0:
; SSE-NEXT:    sqrtpd %xmm0, %xmm1
; SSE-NEXT:    divpd %xmm1, %xmm0
; SSE-NEXT:    xorpd %xmm1, %xmm1
; SSE-NEXT:    cmpeqpd %xmm1, %xmm0
; SSE-NEXT:    retq
