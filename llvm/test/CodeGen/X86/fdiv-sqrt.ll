; RUN: llc < %s -mtriple=x86_64 | FileCheck %s --check-prefix=SSE
; RUN: llc < %s -mtriple=x86_64 -mattr=+avx | FileCheck %s --check-prefix=AVX

; Comparing against zero ignores its sign, but distinguishes zero from NaN.
; For x = +/-0, the division must produce NaN and the comparison must be false.
define i32 @div_sqrt_reassoc_eq_zero(double %x) {
; SSE-LABEL: div_sqrt_reassoc_eq_zero:
; SSE:       # %bb.0:
; SSE-NEXT:    sqrtsd %xmm0, %xmm1
; SSE-NEXT:    divsd %xmm1, %xmm0
; SSE-NEXT:    xorpd %xmm1, %xmm1
; SSE-NEXT:    cmpeqsd %xmm0, %xmm1
; SSE-NEXT:    movq %xmm1, %rax
; SSE-NEXT:    andl $1, %eax
; SSE-NEXT:    # kill: def $eax killed $eax killed $rax
; SSE-NEXT:    retq
;
; AVX-LABEL: div_sqrt_reassoc_eq_zero:
; AVX:       # %bb.0:
; AVX-NEXT:    vsqrtsd %xmm0, %xmm0, %xmm1
; AVX-NEXT:    vdivsd %xmm1, %xmm0, %xmm0
; AVX-NEXT:    vxorpd %xmm1, %xmm1, %xmm1
; AVX-NEXT:    vcmpeqsd %xmm1, %xmm0, %xmm0
; AVX-NEXT:    vmovq %xmm0, %rax
; AVX-NEXT:    andl $1, %eax
; AVX-NEXT:    # kill: def $eax killed $eax killed $rax
; AVX-NEXT:    retq
  %sqrt = call reassoc double @llvm.sqrt.f64(double %x)
  %div = fdiv reassoc double %x, %sqrt
  %cmp = fcmp oeq double %div, 0.0
  %result = zext i1 %cmp to i32
  ret i32 %result
}

