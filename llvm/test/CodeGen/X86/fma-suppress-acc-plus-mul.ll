; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+fma -fp-contract=fast | FileCheck %s --check-prefixes=FMA
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+fma,+suppress-fma-fusion -fp-contract=fast | FileCheck %s --check-prefixes=SUPPRESS

; Microbenchmark pattern from acc_plus_mul_chain (run_acc_plus_mul_bench.sh):
;   acc = acc + x * c[i]
; Non-contract IR: addend (acc) is independent of the multiply operands, so
; +suppress-fma-fusion keeps separate mul+add instead of vfmadd231ss.

define float @acc_plus_mul_chain(ptr nocapture readonly %c, float %x, i32 %n) {
; FMA-LABEL: acc_plus_mul_chain:
; FMA:       # %bb.0: # %entry
; FMA-NEXT:    testl %esi, %esi
; FMA-NEXT:    jle .LBB0_1
; FMA-NEXT:  # %bb.3: # %for.body.preheader
; FMA-NEXT:    movl %esi, %eax
; FMA-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; FMA-NEXT:    .p2align 4
; FMA-NEXT:  .LBB0_4: # %for.body
; FMA-NEXT:    # =>This Inner Loop Header: Depth=1
; FMA-NEXT:    vfmadd231ss {{.*#+}} xmm1 = (xmm0 * mem) + xmm1
; FMA-NEXT:    addq $4, %rdi
; FMA-NEXT:    decq %rax
; FMA-NEXT:    jne .LBB0_4
; FMA-NEXT:  # %bb.2: # %for.cond.cleanup
; FMA-NEXT:    vmovaps %xmm1, %xmm0
; FMA-NEXT:    retq
; FMA-NEXT:  .LBB0_1:
; FMA-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; FMA-NEXT:    vmovaps %xmm1, %xmm0
; FMA-NEXT:    retq
;
; SUPPRESS-LABEL: acc_plus_mul_chain:
; SUPPRESS:       # %bb.0: # %entry
; SUPPRESS-NEXT:    testl %esi, %esi
; SUPPRESS-NEXT:    jle .LBB0_1
; SUPPRESS-NEXT:  # %bb.3: # %for.body.preheader
; SUPPRESS-NEXT:    movl %esi, %eax
; SUPPRESS-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; SUPPRESS-NEXT:    .p2align 4
; SUPPRESS-NEXT:  .LBB0_4: # %for.body
; SUPPRESS-NEXT:    # =>This Inner Loop Header: Depth=1
; SUPPRESS-NEXT:    vmulss (%rdi), %xmm0, %xmm2
; SUPPRESS-NEXT:    vaddss %xmm2, %xmm1, %xmm1
; SUPPRESS-NEXT:    addq $4, %rdi
; SUPPRESS-NEXT:    decq %rax
; SUPPRESS-NEXT:    jne .LBB0_4
; SUPPRESS-NEXT:  # %bb.2: # %for.cond.cleanup
; SUPPRESS-NEXT:    vmovaps %xmm1, %xmm0
; SUPPRESS-NEXT:    retq
; SUPPRESS-NEXT:  .LBB0_1:
; SUPPRESS-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; SUPPRESS-NEXT:    vmovaps %xmm1, %xmm0
; SUPPRESS-NEXT:    retq
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

for.body.preheader:
  %wide.trip.count = zext i32 %n to i64
  br label %for.body

for.cond.cleanup:
  %acc.lcssa = phi float [ 0.0, %entry ], [ %add, %for.body ]
  ret float %acc.lcssa

for.body:
  %iv = phi i64 [ 0, %for.body.preheader ], [ %iv.next, %for.body ]
  %acc = phi float [ 0.0, %for.body.preheader ], [ %add, %for.body ]
  %ptr = getelementptr float, ptr %c, i64 %iv
  %coeff = load float, ptr %ptr, align 4
  %mul = fmul float %x, %coeff
  %add = fadd float %acc, %mul
  %iv.next = add i64 %iv, 1
  %done = icmp eq i64 %iv.next, %wide.trip.count
  br i1 %done, label %for.cond.cleanup, label %for.body
}

; Local contract on the multiply still fuses when suppression is on.
define float @acc_plus_mul_chain_contract(ptr nocapture readonly %c, float %x, i32 %n) {
; FMA-LABEL: acc_plus_mul_chain_contract:
; FMA:       # %bb.0: # %entry
; FMA-NEXT:    testl %esi, %esi
; FMA-NEXT:    jle .LBB1_1
; FMA-NEXT:  # %bb.3: # %for.body.preheader
; FMA-NEXT:    movl %esi, %eax
; FMA-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; FMA-NEXT:    .p2align 4
; FMA-NEXT:  .LBB1_4: # %for.body
; FMA-NEXT:    # =>This Inner Loop Header: Depth=1
; FMA-NEXT:    vfmadd231ss {{.*#+}} xmm1 = (xmm0 * mem) + xmm1
; FMA-NEXT:    addq $4, %rdi
; FMA-NEXT:    decq %rax
; FMA-NEXT:    jne .LBB1_4
; FMA-NEXT:  # %bb.2: # %for.cond.cleanup
; FMA-NEXT:    vmovaps %xmm1, %xmm0
; FMA-NEXT:    retq
; FMA-NEXT:  .LBB1_1:
; FMA-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; FMA-NEXT:    vmovaps %xmm1, %xmm0
; FMA-NEXT:    retq
;
; SUPPRESS-LABEL: acc_plus_mul_chain_contract:
; SUPPRESS:       # %bb.0: # %entry
; SUPPRESS-NEXT:    testl %esi, %esi
; SUPPRESS-NEXT:    jle .LBB1_1
; SUPPRESS-NEXT:  # %bb.3: # %for.body.preheader
; SUPPRESS-NEXT:    movl %esi, %eax
; SUPPRESS-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; SUPPRESS-NEXT:    .p2align 4
; SUPPRESS-NEXT:  .LBB1_4: # %for.body
; SUPPRESS-NEXT:    # =>This Inner Loop Header: Depth=1
; SUPPRESS-NEXT:    vfmadd231ss {{.*#+}} xmm1 = (xmm0 * mem) + xmm1
; SUPPRESS-NEXT:    addq $4, %rdi
; SUPPRESS-NEXT:    decq %rax
; SUPPRESS-NEXT:    jne .LBB1_4
; SUPPRESS-NEXT:  # %bb.2: # %for.cond.cleanup
; SUPPRESS-NEXT:    vmovaps %xmm1, %xmm0
; SUPPRESS-NEXT:    retq
; SUPPRESS-NEXT:  .LBB1_1:
; SUPPRESS-NEXT:    vxorps %xmm1, %xmm1, %xmm1
; SUPPRESS-NEXT:    vmovaps %xmm1, %xmm0
; SUPPRESS-NEXT:    retq
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %for.body.preheader, label %for.cond.cleanup

for.body.preheader:
  %wide.trip.count = zext i32 %n to i64
  br label %for.body

for.cond.cleanup:
  %acc.lcssa = phi float [ 0.0, %entry ], [ %add, %for.body ]
  ret float %acc.lcssa

for.body:
  %iv = phi i64 [ 0, %for.body.preheader ], [ %iv.next, %for.body ]
  %acc = phi float [ 0.0, %for.body.preheader ], [ %add, %for.body ]
  %ptr = getelementptr float, ptr %c, i64 %iv
  %coeff = load float, ptr %ptr, align 4
  %mul = fmul contract float %x, %coeff
  %add = fadd contract float %acc, %mul
  %iv.next = add i64 %iv, 1
  %done = icmp eq i64 %iv.next, %wide.trip.count
  br i1 %done, label %for.cond.cleanup, label %for.body
}
