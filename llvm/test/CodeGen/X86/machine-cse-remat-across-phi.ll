; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=i686--   | FileCheck %s --check-prefix=X86
; RUN: llc < %s -mtriple=x86_64-- | FileCheck %s --check-prefix=X64

; MachineCSE's "Heuristic #3" declines to reuse a common subexpression whose
; value is used by a PHI, to avoid extending a live range across the merge.
; MOV32r0 is trivially rematerializable, so X86 opts out of that restriction
; via TargetInstrInfo::isProfitableToCSEAcrossPHI(): if the reuse ever raised
; register pressure the allocator can re-emit the xorl instead of spilling.
;
; Here both the entry edge of %v and the select's zero operand materialize 0.
; Without the hook each gets its own `xorl`; with it a single one suffices.

define i32 @cse_zero_across_phi(i32 %base, i1 %c1, i1 %c2) nounwind {
; X86-LABEL: cse_zero_across_phi:
; X86:       # %bb.0: # %entry
; X86-NEXT:    xorl %eax, %eax
; X86-NEXT:    testb $1, {{[0-9]+}}(%esp)
; X86-NEXT:    je .LBB0_3
; X86-NEXT:  # %bb.1: # %mid
; X86-NEXT:    testb $1, {{[0-9]+}}(%esp)
; X86-NEXT:    jne .LBB0_3
; X86-NEXT:  # %bb.2: # %mid
; X86-NEXT:    movl {{[0-9]+}}(%esp), %eax
; X86-NEXT:  .LBB0_3: # %exit
; X86-NEXT:    retl
;
; X64-LABEL: cse_zero_across_phi:
; X64:       # %bb.0: # %entry
; X64-NEXT:    xorl %eax, %eax
; X64-NEXT:    testb $1, %sil
; X64-NEXT:    je .LBB0_2
; X64-NEXT:  # %bb.1: # %mid
; X64-NEXT:    testb $1, %dl
; X64-NEXT:    cmovel %edi, %eax
; X64-NEXT:  .LBB0_2: # %exit
; X64-NEXT:    retq
entry:
  br i1 %c1, label %mid, label %exit

mid:
  %sel = select i1 %c2, i32 0, i32 %base
  br label %exit

exit:
  %v = phi i32 [ %sel, %mid ], [ 0, %entry ]
  ret i32 %v
}
