body:             |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9

    ; CHECK-LABEL: name: test_two_tied_rm_pressure
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: MOV64mr %stack.1, 1, $noreg, 0, $noreg, $rcx :: (store (s64) into %stack.1)
