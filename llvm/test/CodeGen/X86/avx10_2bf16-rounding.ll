; Masked forms, exercising the AVX512_maskable patterns.
define <8 x bfloat> @floor_v8bf16_mask(<8 x bfloat> %a, <8 x bfloat> %src, i8 %msk) {
; CHECK-LABEL: floor_v8bf16_mask:
; CHECK:       # %bb.0:
; CHECK-NEXT:    kmovd %edi, %k1
; CHECK-NEXT:    vpmovzxwd {{.*#+}} ymm0 = xmm0[0],zero,xmm0[1],zero,xmm0[2],zero,xmm0[3],zero,xmm0[4],zero,xmm0[5],zero,xmm0[6],zero,xmm0[7],zero
; CHECK-NEXT:    vpslld $16, %ymm0, %ymm0
; CHECK-NEXT:    vroundps $9, %ymm0, %ymm0
; CHECK-NEXT:    vcvtneps2bf16 %ymm0, %xmm0
; CHECK-NEXT:    vpblendmw %xmm0, %xmm1, %xmm0 {%k1}
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %mask = bitcast i8 %msk to <8 x i1>
  %r = call <8 x bfloat> @llvm.floor.v8bf16(<8 x bfloat> %a)
  %res = select <8 x i1> %mask, <8 x bfloat> %r, <8 x bfloat> %src
  ret <8 x bfloat> %res
}

