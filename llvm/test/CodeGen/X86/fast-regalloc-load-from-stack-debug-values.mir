# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -O0 -mtriple=x86_64-unknown-linux-gnu -stop-after=live-debug-values -verify-machineinstrs -o - %s -experimental-debug-variable-locations=true | FileCheck %s

# Regression test for https://github.com/llvm/llvm-project/issues/106419
# When regallocfast replaces a reference to an unspilled value with a spilled one,
#  the load instruction it creates should have the same debug info as the original instruction.

--- |
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"

  ; Function Attrs: uwtable
  define dso_local void @foobar(i32 %n) unnamed_addr #0 !dbg !8 !guid !19 {
  start:
    %n.dbg.spill = alloca [4 x i8], align 4
    store i32 %n, ptr %n.dbg.spill, align 4
      #dbg_declare(ptr %n.dbg.spill, !17, !DIExpression(), !20)
    call void asm "# $0", "~{eax},~{ebx},~{ecx},~{edx},~{esi},~{edi},~{ebp}"()
    %_5 = icmp eq i32 %n, 6, !dbg !21
    br i1 %_5, label %bb1, label %bb1, !dbg !22

  bb1:
    ret void, !dbg !23
  }

  attributes #0 = { uwtable "target-cpu"="x86-64" "target-features"="+cx16,+sse,+sse2,+sse3,+sahf" }

  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  !llvm.dbg.cu = !{!6}

  !0 = !{i32 8, !"PIC Level", i32 2}
  !1 = !{i32 7, !"PIE Level", i32 2}
  !2 = !{i32 7, !"uwtable", i32 2}
  !3 = !{i32 2, !"CodeView", i32 1}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = !{!""}
  !6 = distinct !DICompileUnit(language: DW_LANG_Rust, file: !7, producer: "clang LLVM (rustc version 1.101.0-nightly (48f4b0553 2026-10-23))", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false)
  !7 = !DIFile(filename: "main.rs\\@\\main.9897e8b2d6fda66f-cgu.0", directory: "")
  !8 = distinct !DISubprogram(name: "foobar", scope: !10, file: !9, line: 213, type: !11, scopeLine: 213, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition, unit: !6, templateParams: !18, retainedNodes: !16)
  !9 = !DIFile(filename: "main.rs", directory: "", checksumkind: CSK_SHA256, checksum: "edd7325d810181bb190cd043659138b71561ad22119ca9187b98dce3af9628bb")
  !10 = !DINamespace(name: "main", scope: null)
  !11 = !DISubroutineType(types: !12)
  !12 = !{null, !13}
  !13 = !DIDerivedType(tag: DW_TAG_typedef, name: "i32", file: !14, baseType: !15)
  !14 = !DIFile(filename: "<unknown>", directory: "")
  !15 = !DIBasicType(name: "__int32", size: 32, encoding: DW_ATE_signed)
  !16 = !{!17}
  !17 = !DILocalVariable(name: "n", arg: 1, scope: !8, file: !9, line: 213, type: !13)
  !18 = !{}
  !19 = !{i64 -7981315116862384072}
  !20 = !DILocation(line: 213, scope: !8)
  !21 = !DILocation(line: 222, scope: !8)
  !22 = !DILocation(line: 215, scope: !8)
  !23 = !DILocation(line: 227, scope: !8)
...
---
name:            foobar
noVRegs:         false
liveins:
  - { reg: '$edi', virtual-reg: '' }
stack:
  - { id: 0, name: n.dbg.spill, type: default, offset: 0, size: 4, alignment: 4,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '!17', debug-info-expression: '!DIExpression()',
      debug-info-location: '!20' }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 4, alignment: 4,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  ; CHECK-LABEL: name: foobar
  ; CHECK: liveins
  ; CHECK-NEXT:  - { reg: '$[[INREG:[[:alnum:]]+]]'

  ; CHECK: MOV32mr $rsp, [[SPILLINDEX:[0-9]+]], $noreg, {{-?[0-9]+}}, $noreg, {{(killed )?}}renamable $[[INREG]]
  ; CHECK: clobber $[[INREG]]
  ; CHECK: $[[REG:[[:alnum:]]+]] = MOV32rm $rsp, [[SPILLINDEX]], $noreg, {{-?[0-9]+}}, $noreg, debug-location ![[LOC:[0-9]+]]
  ; CHECK-NEXT: CMP32ri {{(killed )?}}renamable $[[REG]], 6, implicit-def $eflags, debug-location ![[LOC]]

  bb.0.start:
    successors: %bb.1(0x80000000)
    liveins: $edi

    MOV32mr %stack.1, 1, $noreg, 0, $noreg, $edi :: (store (s32) into %stack.1)
    MOV32mr %stack.0.n.dbg.spill, 1, $noreg, 0, $noreg, renamable $edi :: (store (s32) into %ir.n.dbg.spill)
    INLINEASM &"# $0", attdialect, clobber, implicit-def dead early-clobber $eax, clobber, implicit-def dead early-clobber $ebx, clobber, implicit-def dead early-clobber $ecx, clobber, implicit-def dead early-clobber $edx, clobber, implicit-def dead early-clobber $esi, clobber, implicit-def dead early-clobber $edi, clobber, implicit-def dead early-clobber $ebp
    $edi = MOV32rm %stack.1, 1, $noreg, 0, $noreg, debug-location !21 :: (load (s32) from %stack.1)
    CMP32ri killed renamable $edi, 6, implicit-def $eflags, debug-location !21
    JCC_1 %bb.1, 5, implicit killed $eflags, debug-location !22

  bb.1.bb1:
    RET64 debug-location !23
...