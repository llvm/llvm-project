; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

; A direct inline asm input of aggregate type is stored to a stack slot one
; member at a time: for a memory constraint the asm gets the slot, and for a
; register constraint the integer that the members fill.

define void @mem_struct(i32 %a, i32 %b) {
; CHECK-LABEL: mem_struct:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %esi, -{{[0-9]+}}(%rsp)
; CHECK-NEXT:    movl %edi, -{{[0-9]+}}(%rsp)
; CHECK-NEXT:    #APP
; CHECK-NEXT:    # -{{[0-9]+}}(%rsp)
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    retq
  %s0 = insertvalue { i32, i32 } poison, i32 %a, 0
  %s = insertvalue { i32, i32 } %s0, i32 %b, 1
  call void asm sideeffect "# $0", "m"({ i32, i32 } %s)
  ret void
}

