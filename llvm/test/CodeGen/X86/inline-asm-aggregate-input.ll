; The two members of a 128-bit array fill two registers.
define i128 @reg_array_two_regs(i64 %a, i64 %b) {
; CHECK-LABEL: reg_array_two_regs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %rsi, %rdx
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    movq %rsi, -{{[0-9]+}}(%rsp)
; CHECK-NEXT:    movq %rdi, -{{[0-9]+}}(%rsp)
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    retq
  %s0 = insertvalue [2 x i64] poison, i64 %a, 0
  %s = insertvalue [2 x i64] %s0, i64 %b, 1
  %r = call i128 asm sideeffect "", "=r,0"([2 x i64] %s)
  ret i128 %r
}
