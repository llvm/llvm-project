; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu -mattr=+avx512fp16,+avx512vl | FileCheck %s

; These source formats and half share a minimum normal exponent of -14.
; Subnormal inputs must therefore remain subnormal in half. Return the half
; encodings as integers so their sign, exponent and mantissa are visible.
; Enable AVX512-FP16 to exercise vector expansion without scalarizing half.

declare half @llvm.convert.from.arbitrary.fp.f16.i8(i8, metadata)
declare <8 x half> @llvm.convert.from.arbitrary.fp.v8f16.v8i8(<8 x i8>, metadata)

; All signed E5M2 subnormals and both signed zeros.
define <8 x i16> @e5m2_subnormals() {
; CHECK-LABEL: e5m2_subnormals:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovaps {{.*#+}} xmm0 = [0,256,512,768,32768,33024,33280,33536]
; CHECK-NEXT:    retq
  %fp = call <8 x half> @llvm.convert.from.arbitrary.fp.v8f16.v8i8(
      <8 x i8> <i8 0, i8 1, i8 2, i8 3, i8 128, i8 129, i8 130, i8 131>,
      metadata !"Float8E5M2")
  %bits = bitcast <8 x half> %fp to <8 x i16>
  ret <8 x i16> %bits
}

; All seven unsigned E5M3FNU subnormals and zero.
define <8 x i16> @e5m3fnu_subnormals() {
; CHECK-LABEL: e5m3fnu_subnormals:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovaps {{.*#+}} xmm0 = [0,128,256,384,512,640,768,896]
; CHECK-NEXT:    retq
  %fp = call <8 x half> @llvm.convert.from.arbitrary.fp.v8f16.v8i8(
      <8 x i8> <i8 0, i8 1, i8 2, i8 3, i8 4, i8 5, i8 6, i8 7>,
      metadata !"Float8E5M3FNU")
  %bits = bitcast <8 x half> %fp to <8 x i16>
  ret <8 x i16> %bits
}

; Largest subnormal, smallest normal, largest finite, and infinity, both signs.
define <8 x i16> @e5m2_boundaries() {
; CHECK-LABEL: e5m2_boundaries:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovaps {{.*#+}} xmm0 = [768,1024,31488,31744,33536,33792,64256,64512]
; CHECK-NEXT:    retq
  %fp = call <8 x half> @llvm.convert.from.arbitrary.fp.v8f16.v8i8(
      <8 x i8> <i8 3, i8 4, i8 123, i8 124, i8 131, i8 132, i8 251, i8 252>,
      metadata !"Float8E5M2")
  %bits = bitcast <8 x half> %fp to <8 x i16>
  ret <8 x i16> %bits
}

; 61440 is representable in half. The next seven finite encodings, 65536
; through 114688, overflow to infinity rather than producing NaNs.
define <8 x i16> @e5m3fnu_overflow() {
; CHECK-LABEL: e5m3fnu_overflow:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovaps {{.*#+}} xmm0 = [31616,31744,31744,31744,31744,31744,31744,31744]
; CHECK-NEXT:    retq
  %fp = call <8 x half> @llvm.convert.from.arbitrary.fp.v8f16.v8i8(
      <8 x i8> <i8 247, i8 248, i8 249, i8 250, i8 251, i8 252, i8 253, i8 254>,
      metadata !"Float8E5M3FNU")
  %bits = bitcast <8 x half> %fp to <8 x i16>
  ret <8 x i16> %bits
}

; Include the normal/subnormal boundary, the unsigned exponent's top bit, and
; the NaN encoding, which must take precedence over the overflow check.
define <8 x i16> @e5m3fnu_boundaries() {
; CHECK-LABEL: e5m3fnu_boundaries:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovaps {{.*#+}} xmm0 = [896,1024,1152,16256,16384,31616,31744,32256]
; CHECK-NEXT:    retq
  %fp = call <8 x half> @llvm.convert.from.arbitrary.fp.v8f16.v8i8(
      <8 x i8> <i8 7, i8 8, i8 9, i8 127, i8 128, i8 247, i8 248, i8 255>,
      metadata !"Float8E5M3FNU")
  %bits = bitcast <8 x half> %fp to <8 x i16>
  ret <8 x i16> %bits
}

define i16 @e5m2_scalar(i8 %src) {
; CHECK-LABEL: e5m2_scalar:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edi, %ecx
; CHECK-NEXT:    shll $8, %ecx
; CHECK-NEXT:    andl $32768, %ecx # imm = 0x8000
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    shrl $2, %eax
; CHECK-NEXT:    andl $31, %eax
; CHECK-NEXT:    movl %eax, %edx
; CHECK-NEXT:    shll $10, %edx
; CHECK-NEXT:    orl %ecx, %edx
; CHECK-NEXT:    andl $3, %edi
; CHECK-NEXT:    movl %edi, %esi
; CHECK-NEXT:    shll $8, %esi
; CHECK-NEXT:    orl %edx, %esi
; CHECK-NEXT:    testl %edi, %edi
; CHECK-NEXT:    setne %dl
; CHECK-NEXT:    sete %dil
; CHECK-NEXT:    testl %eax, %eax
; CHECK-NEXT:    sete %r8b
; CHECK-NEXT:    testb %dil, %r8b
; CHECK-NEXT:    cmovnel %ecx, %esi
; CHECK-NEXT:    orl $31744, %ecx # imm = 0x7C00
; CHECK-NEXT:    cmpw $31, %ax
; CHECK-NEXT:    sete %al
; CHECK-NEXT:    testb %dil, %al
; CHECK-NEXT:    cmovel %esi, %ecx
; CHECK-NEXT:    testb %dl, %al
; CHECK-NEXT:    movl $32256, %eax # imm = 0x7E00
; CHECK-NEXT:    cmovel %ecx, %eax
; CHECK-NEXT:    # kill: def $ax killed $ax killed $eax
; CHECK-NEXT:    retq
  %fp = call half @llvm.convert.from.arbitrary.fp.f16.i8(i8 %src, metadata !"Float8E5M2")
  %bits = bitcast half %fp to i16
  ret i16 %bits
}

