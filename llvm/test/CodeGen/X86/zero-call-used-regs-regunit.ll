; Returning i128 uses RAX and RDX. RegUnit(DL) must not clear X86::CX from
; RegsToZero and leave %ecx unzeroed.
define i128 @ret_i128_uses_cx(i64 %a, i64 %b, i64 %c, i16 %d, ptr %p) nounwind "zero-call-used-regs"="used-gpr" {
; X86-64-LABEL: ret_i128_uses_cx:
; X86-64:       # %bb.0: # %entry
; X86-64-NEXT:    movq %rsi, %rdx
; X86-64-NEXT:    movq %rdi, %rax
; X86-64-NEXT:    movw %cx, (%r8)
; X86-64-NEXT:    xorl %ecx, %ecx
; X86-64-NEXT:    xorl %edi, %edi
; X86-64-NEXT:    xorl %esi, %esi
; X86-64-NEXT:    xorl %r8d, %r8d
; X86-64-NEXT:    retq
;
; I386-LABEL: ret_i128_uses_cx:
; I386:       # %bb.0: # %entry
; I386-NEXT:    pushl %edi
; I386-NEXT:    pushl %esi
; I386-NEXT:    movl {{[0-9]+}}(%esp), %eax
; I386-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; I386-NEXT:    movl {{[0-9]+}}(%esp), %edx
; I386-NEXT:    movzwl {{[0-9]+}}(%esp), %esi
; I386-NEXT:    movl {{[0-9]+}}(%esp), %edi
; I386-NEXT:    movw %si, (%edi)
; I386-NEXT:    movl {{[0-9]+}}(%esp), %esi
; I386-NEXT:    movl {{[0-9]+}}(%esp), %edi
; I386-NEXT:    movl %edi, 12(%eax)
; I386-NEXT:    movl %esi, 8(%eax)
; I386-NEXT:    movl %edx, 4(%eax)
; I386-NEXT:    movl %ecx, (%eax)
; I386-NEXT:    popl %esi
; I386-NEXT:    popl %edi
; I386-NEXT:    xorl %ecx, %ecx
; I386-NEXT:    xorl %edx, %edx
; I386-NEXT:    retl $4
entry:
  store volatile i16 %d, ptr %p
  %r1 = zext i64 %a to i128
  %r2 = zext i64 %b to i128
  %s = shl i128 %r2, 64
  %r = or i128 %r1, %s
  ret i128 %r
}

; Returning {i8, i8} via fastcc uses %al and %dl. Widening sibling high-byte
; registers (%ah -> %eax, %dh -> %edx) must not zero live return registers.
define fastcc {i8, i8} @ret_al_dl_all_gpr() nounwind "zero-call-used-regs"="all-gpr" {
; X86-64-LABEL: ret_al_dl_all_gpr:
; X86-64:       # %bb.0: # %entry
; X86-64-NEXT:    movb $1, %al
; X86-64-NEXT:    movb $2, %dl
; X86-64-NEXT:    xorl %ecx, %ecx
; X86-64-NEXT:    xorl %edi, %edi
; X86-64-NEXT:    xorl %esi, %esi
; X86-64-NEXT:    xorl %r8d, %r8d
; X86-64-NEXT:    xorl %r9d, %r9d
; X86-64-NEXT:    xorl %r10d, %r10d
; X86-64-NEXT:    xorl %r11d, %r11d
; X86-64-NEXT:    retq
;
; I386-LABEL: ret_al_dl_all_gpr:
; I386:       # %bb.0: # %entry
