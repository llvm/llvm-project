# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=x86_64-unknown -mattr=+avx512bf16,+avx512vl -start-before=twoaddressinstruction -stop-after=postrapseudos -verify-machineinstrs -o - %s | FileCheck %s

# Counterpart to fp16-reload.mir, exercising spill/reload of the 16-bit FP
# register classes directly at the MIR level. This branch changed FR16X to
# RegisterClass<"X86", [f16, bf16], ...> and hands bf16 to FR16RegClass when
# AVX512 is absent, so both classes are now reachable by bf16 values.

...
---
name:            test
alignment:       16
tracksRegLiveness: true
debugInstrRef:   true
registers:
liveins:
  - { reg: '$xmm0', virtual-reg: '%0' }
frameInfo:
  maxAlignment:    1
  hasCalls:        true
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $xmm0

    ; CHECK-LABEL: name: test
    ; CHECK: liveins: $xmm0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: VMOVSSmr $rsp, 1, $noreg, -4, $noreg, $xmm0 :: (store (s32) into %stack.0, align 2)
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, clobber, implicit-def dead early-clobber $xmm0, clobber, implicit-def dead early-clobber $xmm1, clobber, implicit-def dead early-clobber $xmm2, clobber, implicit-def dead early-clobber $xmm3, clobber, implicit-def dead early-clobber $xmm4, clobber, implicit-def dead early-clobber $xmm5, clobber, implicit-def dead early-clobber $xmm6, clobber, implicit-def dead early-clobber $xmm7, clobber, implicit-def dead early-clobber $xmm8, clobber, implicit-def dead early-clobber $xmm9, clobber, implicit-def dead early-clobber $xmm10, clobber, implicit-def dead early-clobber $xmm11, clobber, implicit-def dead early-clobber $xmm12, clobber, implicit-def dead early-clobber $xmm13, clobber, implicit-def dead early-clobber $xmm14, clobber, implicit-def dead early-clobber $xmm15, clobber, implicit-def dead early-clobber $xmm16, clobber, implicit-def dead early-clobber $xmm17, clobber, implicit-def dead early-clobber $xmm18, clobber, implicit-def dead early-clobber $xmm19, clobber, implicit-def dead early-clobber $xmm20, clobber, implicit-def dead early-clobber $xmm21, clobber, implicit-def dead early-clobber $xmm22, clobber, implicit-def dead early-clobber $xmm23, clobber, implicit-def dead early-clobber $xmm24, clobber, implicit-def dead early-clobber $xmm25, clobber, implicit-def dead early-clobber $xmm26, clobber, implicit-def dead early-clobber $xmm27, clobber, implicit-def dead early-clobber $xmm28, clobber, implicit-def dead early-clobber $xmm29, clobber, implicit-def dead early-clobber $xmm30, clobber, implicit-def dead early-clobber $xmm31, clobber, implicit-def dead early-clobber $df, clobber, implicit-def early-clobber $fpsw, clobber, implicit-def dead early-clobber $eflags
    ; CHECK-NEXT: renamable $xmm0 = VMOVSSrm $rsp, 1, $noreg, -4, $noreg :: (load (s32) from %stack.0, align 2)
    ; CHECK-NEXT: FNOP implicit-def $fpsw, implicit killed renamable $xmm0
    ; CHECK-NEXT: RET 0
    %0:fr16x = COPY killed $xmm0
    INLINEASM &"", sideeffect attdialect, clobber, implicit-def dead early-clobber $xmm0, clobber, implicit-def dead early-clobber $xmm1, clobber, implicit-def dead early-clobber $xmm2, clobber, implicit-def dead early-clobber $xmm3, clobber, implicit-def dead early-clobber $xmm4, clobber, implicit-def dead early-clobber $xmm5, clobber, implicit-def dead early-clobber $xmm6, clobber, implicit-def dead early-clobber $xmm7, clobber, implicit-def dead early-clobber $xmm8, clobber, implicit-def dead early-clobber $xmm9, clobber, implicit-def dead early-clobber $xmm10, clobber, implicit-def dead early-clobber $xmm11, clobber, implicit-def dead early-clobber $xmm12, clobber, implicit-def dead early-clobber $xmm13, clobber, implicit-def dead early-clobber $xmm14, clobber, implicit-def dead early-clobber $xmm15, clobber, implicit-def dead early-clobber $xmm16, clobber, implicit-def dead early-clobber $xmm17, clobber, implicit-def dead early-clobber $xmm18, clobber, implicit-def dead early-clobber $xmm19, clobber, implicit-def dead early-clobber $xmm20, clobber, implicit-def dead early-clobber $xmm21, clobber, implicit-def dead early-clobber $xmm22, clobber, implicit-def dead early-clobber $xmm23, clobber, implicit-def dead early-clobber $xmm24, clobber, implicit-def dead early-clobber $xmm25, clobber, implicit-def dead early-clobber $xmm26, clobber, implicit-def dead early-clobber $xmm27, clobber, implicit-def dead early-clobber $xmm28, clobber, implicit-def dead early-clobber $xmm29, clobber, implicit-def dead early-clobber $xmm30, clobber, implicit-def dead early-clobber $xmm31, clobber, implicit-def dead early-clobber $df, clobber, implicit-def early-clobber $fpsw, clobber, implicit-def dead early-clobber $eflags
    FNOP implicit-def $fpsw, implicit %0:fr16x
    RET 0

