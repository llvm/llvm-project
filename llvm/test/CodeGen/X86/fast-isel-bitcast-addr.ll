; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64-linux-gnu -fast-isel -verify-machineinstrs < %s | FileCheck %s

; FastISel must not look through a bitcast that changes the register class: the
; address has to live in a general purpose register, while the double below is
; in an XMM register. See https://github.com/llvm/llvm-project/issues/242844.

define i32 @load_through_f64_bitcast(double %x) nounwind {
; CHECK-LABEL: load_through_f64_bitcast:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %xmm0, %rax
; CHECK-NEXT:    movl (%rax), %eax
; CHECK-NEXT:    retq
  %i = bitcast double %x to i64
  %p = inttoptr i64 %i to ptr
  %v = load i32, ptr %p, align 4
  ret i32 %v
}

define void @store_through_f64_bitcast(double %x, i32 %v) nounwind {
; CHECK-LABEL: store_through_f64_bitcast:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq %xmm0, %rax
; CHECK-NEXT:    movl %edi, (%rax)
; CHECK-NEXT:    retq
  %i = bitcast double %x to i64
  %p = inttoptr i64 %i to ptr
  store i32 %v, ptr %p, align 4
  ret void
}

define void @call_through_f64_bitcast(double %x) nounwind {
; CHECK-LABEL: call_through_f64_bitcast:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movq %xmm0, %rax
; CHECK-NEXT:    callq *%rax
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    retq
  %i = bitcast double %x to i64
  %f = inttoptr i64 %i to ptr
  call void %f()
  ret void
}

; A no-op pointer bitcast still folds into the address.
define i32 @load_through_noop_ptr_bitcast(ptr %p) nounwind {
; CHECK-LABEL: load_through_noop_ptr_bitcast:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl (%rdi), %eax
; CHECK-NEXT:    retq
  %q = bitcast ptr %p to ptr
  %v = load i32, ptr %q, align 4
  ret i32 %v
}

; Casting between a pointer and an integer of the same size is still folded
; into the address.
define i32 @load_through_ptrtoint(ptr %p) nounwind {
; CHECK-LABEL: load_through_ptrtoint:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl 8(%rdi), %eax
; CHECK-NEXT:    retq
  %i = ptrtoint ptr %p to i64
  %a = add i64 %i, 8
  %q = inttoptr i64 %a to ptr
  %v = load i32, ptr %q, align 4
  ret i32 %v
}
