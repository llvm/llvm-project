# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass x86-fixup-bw-insts -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define i32 @same_block(ptr %p) { ret i32 0 }
  define i32 @across_blocks(ptr %p) { ret i32 0 }
  define i32 @into_copy(ptr %p) { ret i32 0 }
  define i32 @clobbered_super_reg(ptr %p) { ret i32 0 }
  define i32 @high_byte_source(ptr %p) { ret i32 0 }
  define i32 @word_from_byte(ptr %p) { ret i32 0 }
  define i32 @byte_from_word(ptr %p) { ret i32 0 }
  define i32 @sext_same_block(ptr %p) { ret i32 0 }
  define i32 @sext_word_from_byte(ptr %p) { ret i32 0 }
  define i32 @sext_byte_from_word(ptr %p) { ret i32 0 }
  define i32 @sext_word_from_zext_byte(ptr %p) { ret i32 0 }
  define i32 @sext_byte_from_zext_byte(ptr %p) { ret i32 0 }
  define i32 @zext_word_from_sext_byte(ptr %p) { ret i32 0 }
  define i32 @sext_into_copy(ptr %p) { ret i32 0 }
...

---
# The load already zero extends $r12d, so the extend below it is a no-op.
name:            same_block
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: same_block
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r12d = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: CMP32ri renamable $r12d, 13, implicit-def $eflags
    ; CHECK-NEXT: RET64 $r12d
    $r12d = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $r12d = MOVZX32rr8 killed renamable $r12b
    CMP32ri renamable $r12d, 13, implicit-def $eflags
    RET64 $r12d
...

---
# The analysis is block local, so an extend in a successor is left alone even
# though the only predecessor zero extends the value.  Removing it would mean
# making $r9d live in to bb.1, which so far only needed $r9b.
name:            across_blocks
body:             |
  ; CHECK-LABEL: name: across_blocks
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r9d = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   CMP8ri renamable $r9b, 10, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r9b
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $r9d = MOVZX32rr8 killed renamable $r9b
  ; CHECK-NEXT:   CMP32ri renamable $r9d, 13, implicit-def $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $r9d
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET64 $r9d
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi

    $r9d = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    CMP8ri renamable $r9b, 10, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags

  bb.1:
    successors: %bb.2
    liveins: $r9b

    renamable $r9d = MOVZX32rr8 killed renamable $r9b
    CMP32ri renamable $r9d, 13, implicit-def $eflags

  bb.2:
    liveins: $r9d

    RET64 $r9d
...

---
# When the extend moves the value to a different register the move is still
# needed, but it can be done 32 bits at a time.
name:            into_copy
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: into_copy
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: $ecx = MOV32rr $eax
    ; CHECK-NEXT: RET64 $eax, $ecx
    $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $ecx = MOVZX32rr8 renamable $al
    RET64 $eax, $ecx
...

---
# The add writes bits that the load had zeroed, so the extend is needed.
name:            clobbered_super_reg
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: clobbered_super_reg
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r12d = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: renamable $r12d = ADD32ri killed renamable $r12d, 65536, implicit-def $eflags
    ; CHECK-NEXT: renamable $r12d = MOVZX32rr8 killed renamable $r12b
    ; CHECK-NEXT: RET64 $r12d
    $r12d = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $r12d = ADD32ri killed renamable $r12d, 65536, implicit-def $eflags
    renamable $r12d = MOVZX32rr8 killed renamable $r12b
    RET64 $r12d
...

---
# Knowing that $eax is in [0, 0xFF] says that $ah is zero, not that the extend
# leaves $eax alone, so this one has to stay.
name:            high_byte_source
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: high_byte_source
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: renamable $eax = MOVZX32rr8 killed renamable $ah
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVZX32rr8 killed renamable $ah
    RET64 $eax
...

---
# A value in [0, 0xFF] is also in [0, 0xFFFF], so extending it from its low
# word does nothing either.
name:            word_from_byte
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: word_from_byte
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: CMP32ri renamable $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVZX32rr16 killed renamable $ax
    CMP32ri renamable $eax, 13, implicit-def $eflags
    RET64 $eax
...

---
# The other way round does not hold: 0x1234 is in [0, 0xFFFF] but extending
# it from its low byte gives 0x34, so this extend has to stay.
name:            byte_from_word
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: byte_from_word
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVZX32rm16 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: renamable $eax = MOVZX32rr8 killed renamable $al
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVZX32rm16 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVZX32rr8 killed renamable $al
    RET64 $eax
...

---
# The load already sign extends $eax, so the extend below it is a no-op.
name:            sext_same_block
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: sext_same_block
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: CMP32ri renamable $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVSX32rr8 killed renamable $al
    CMP32ri renamable $eax, 13, implicit-def $eflags
    RET64 $eax
...

---
# A value in [-0x80, 0x7F] is also in [-0x8000, 0x7FFF], so sign extending it
# from its low word does nothing either.
name:            sext_word_from_byte
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: sext_word_from_byte
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: CMP32ri renamable $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVSX32rr16 killed renamable $ax
    CMP32ri renamable $eax, 13, implicit-def $eflags
    RET64 $eax
...

---
# The other way round does not hold: 0x1234 is in [-0x8000, 0x7FFF] but
# extending it from its low byte gives 0x34, so this extend has to stay.
name:            sext_byte_from_word
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: sext_byte_from_word
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVSX32rm16 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: renamable $eax = MOVSX32rr8 killed renamable $al
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVSX32rm16 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVSX32rr8 killed renamable $al
    RET64 $eax
...

---
# A value in [0, 0xFF] has a clear sign bit when read as a word, so sign
# extending its low word does nothing.
name:            sext_word_from_zext_byte
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: sext_word_from_zext_byte
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: CMP32ri renamable $eax, 13, implicit-def $eflags
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVSX32rr16 killed renamable $ax
    CMP32ri renamable $eax, 13, implicit-def $eflags
    RET64 $eax
...

---
# The sign bit of a byte that was zero extended can be set: 0xFF is in
# [0, 0xFF] but sign extending it from its low byte gives 0xFFFFFFFF, so this
# extend has to stay.
name:            sext_byte_from_zext_byte
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: sext_byte_from_zext_byte
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: renamable $eax = MOVSX32rr8 killed renamable $al
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVZX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVSX32rr8 killed renamable $al
    RET64 $eax
...

---
# A sign extended value can be negative: -1 is in [-0x80, 0x7F] but zero
# extending it from its low word gives 0xFFFF, so this extend has to stay.
name:            zext_word_from_sext_byte
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: zext_word_from_sext_byte
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: renamable $eax = MOVZX32rr16 killed renamable $ax
    ; CHECK-NEXT: RET64 $eax
    $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $eax = MOVZX32rr16 killed renamable $ax
    RET64 $eax
...

---
# The copy keeps being sign extended, so a second extend of it is a no-op too.
name:            sext_into_copy
body:             |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: sext_into_copy
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    ; CHECK-NEXT: $ecx = MOV32rr $eax
    ; CHECK-NEXT: RET64 $eax, $ecx
    $eax = MOVSX32rm8 killed renamable $rdi, 1, $noreg, 0, $noreg
    renamable $ecx = MOVSX32rr8 renamable $al
    renamable $ecx = MOVSX32rr8 killed renamable $cl
    RET64 $eax, $ecx
...
