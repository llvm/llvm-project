# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -enable-subreg-liveness -verify-coalescing -passes=register-coalescer -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -enable-subreg-liveness -verify-coalescing -passes='register-coalescer,print<live-intervals>' -o /dev/null %s 2>&1 | FileCheck -check-prefix=INTERVALS %s

# Erasing the high-byte IMPLICIT_DEF in bb.3 makes the high-byte value from
# bb.1 reach the use in bb.5, so the high-byte subrange is live through bb.3.

# INTERVALS-LABEL: Live intervals for machine function: recompute_after_subreg_implicit_def:
# INTERVALS: %1 [48r,240B:0)[256r,288B:1)[288B,320r:2) 0@48r 1@256r 2@288B-phi  L0000000000000001 [48r,96B:0)[176B,208r:0) 0@48r  L0000000000000002 [48r,240B:0)[256r,288B:1)[288B,320r:3) 0@48r 1@256r 2@x 3@288B-phi  weight:

---
name: recompute_after_subreg_implicit_def
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: recompute_after_subreg_implicit_def
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV16ri:%[0-9]+]]:gr16_abcd = MOV16ri 1
  ; CHECK-NEXT:   TEST8rr [[MOV16ri]].sub_8bit, [[MOV16ri]].sub_8bit, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.5(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST8rr [[MOV16ri]].sub_8bit, [[MOV16ri]].sub_8bit, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.5, 5, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[MOV16ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST8rr [[MOV16ri]].sub_8bit_hi, [[MOV16ri]].sub_8bit_hi, implicit-def dead $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  bb.0:
    JMP_1 %bb.1

  bb.1:
    %0:gr16_abcd = MOV16ri 1
    TEST8rr %0.sub_8bit, %0.sub_8bit, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit killed $eflags

  bb.2:
    undef %1.sub_8bit_hi:gr16_abcd = COPY %0.sub_8bit_hi
    %2:gr8_abcd_h = COPY %1.sub_8bit_hi
    %3:gr8_abcd_h = COPY %2
    JMP_1 %bb.5

  bb.3:
    %3:gr8_abcd_h = IMPLICIT_DEF
    TEST8rr %0.sub_8bit, %0.sub_8bit, implicit-def $eflags
    JCC_1 %bb.5, 5, implicit killed $eflags

  bb.4:
    %4:gr8_abcd_h = MOV8ri 2
    %3:gr8_abcd_h = COPY %4

  bb.5:
    %5:gr8_abcd_h = COPY %3
    TEST8rr %5, %5, implicit-def dead $eflags
    JMP_1 %bb.1
...

# The high-byte IMPLICIT_DEF in the loop latch is erased by coalescing. The
# high byte must stay live around the backedge.

# INTERVALS-LABEL: Live intervals for machine function: loop_backedge:
# INTERVALS: %0 [16r,48B:0)[48B,192r:1) 0@16r 1@48B-phi  L0000000000000002 [16r,48B:0)[48B,176B:2) 0@16r 1@x 2@48B-phi  L0000000000000001 [16r,192r:0) 0@16r  weight:

---
name: loop_backedge
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: loop_backedge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV16ri:%[0-9]+]]:gr16_abcd = MOV16ri 1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST8rr [[MOV16ri]].sub_8bit_hi, [[MOV16ri]].sub_8bit_hi, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST8rr [[MOV16ri]].sub_8bit, [[MOV16ri]].sub_8bit, implicit-def dead $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET 0, implicit [[MOV16ri]].sub_8bit
  bb.0:
    %0:gr16_abcd = MOV16ri 1
    %3:gr8_abcd_h = COPY %0.sub_8bit_hi

  bb.1:
    %5:gr8_abcd_h = COPY %3
    TEST8rr %5, %5, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit killed $eflags

  bb.2:
    %3:gr8_abcd_h = IMPLICIT_DEF
    TEST8rr %0.sub_8bit, %0.sub_8bit, implicit-def dead $eflags
    JMP_1 %bb.1

  bb.3:
    RET 0, implicit %0.sub_8bit

...
