    %lo = load i32, ptr %p
    %hi = load i32, ptr %p.hi
    %conv = zext i32 %lo to i64
    %shl = shl nuw i64 %conv, 32
    %conv2 = zext i32 %hi to i64
    %or = or disjoint i64 %shl, %conv2
    ret i64 %or
}

