# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=regallocfast -o - %s | FileCheck %s

# A live def of the sub-register $eax does not keep the dead $rax def alive,
# even though both have the same register units.

---
name: dead_super_def_live_sub_def
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: dead_super_def_live_sub_def
    ; CHECK: dead $rax = MOV64ri 1, implicit-def $eax
    ; CHECK-NEXT: RET 0
    $rax = MOV64ri 1, implicit-def $eax
    RET 0
...
