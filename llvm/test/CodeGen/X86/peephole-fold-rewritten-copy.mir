# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=peephole-opt %s -o - | FileCheck %s

# A COPY whose source is rewritten by the value tracker can become identical
# to an earlier COPY. It should then be folded like any other redundant copy.

---
name: subreg_of_subreg_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi
    ; CHECK-LABEL: name: subreg_of_subreg_copy
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64))
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr16 = COPY [[MOV64rm]].sub_16bit
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32 = COPY [[MOV64rm]].sub_32bit
    ; CHECK-NEXT: [[ADD16rr:%[0-9]+]]:gr16 = ADD16rr [[COPY1]], [[COPY1]], implicit-def dead $eflags
    ; CHECK-NEXT: $ax = COPY [[ADD16rr]]
    ; CHECK-NEXT: RET 0, $ax
    %0:gr64 = COPY $rdi
    %1:gr64 = MOV64rm %0, 1, $noreg, 0, $noreg :: (load (s64))
    %2:gr16 = COPY %1.sub_16bit
    %3:gr32 = COPY %1.sub_32bit
    %4:gr16 = COPY %3.sub_16bit
    %5:gr16 = ADD16rr %2, %4, implicit-def dead $eflags
    $ax = COPY %5
    RET 0, $ax
...

---
name: subreg_of_full_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi
    ; CHECK-LABEL: name: subreg_of_full_copy
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64))
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY [[MOV64rm]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32 = COPY [[MOV64rm]].sub_32bit
    ; CHECK-NEXT: [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY2]], [[COPY2]], implicit-def dead $eflags
    ; CHECK-NEXT: $eax = COPY [[ADD32rr]]
    ; CHECK-NEXT: RET 0, $eax
    %0:gr64 = COPY $rdi
    %1:gr64 = MOV64rm %0, 1, $noreg, 0, $noreg :: (load (s64))
    %2:gr64 = COPY %1
    %3:gr32 = COPY %2.sub_32bit
    %4:gr64 = COPY %1
    %5:gr32 = COPY %4.sub_32bit
    %6:gr32 = ADD32rr %3, %5, implicit-def dead $eflags
    $eax = COPY %6
    RET 0, $eax
...

# Different subregisters are different values: nothing to fold.
---
name: different_subregs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi
    ; CHECK-LABEL: name: different_subregs
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[MOV64rm:%[0-9]+]]:gr64_abcd = MOV64rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s64))
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr8 = COPY [[MOV64rm]].sub_8bit
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32_abcd = COPY [[MOV64rm]].sub_32bit
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gr8 = COPY [[MOV64rm]].sub_8bit_hi
    ; CHECK-NEXT: [[ADD8rr:%[0-9]+]]:gr8 = ADD8rr [[COPY1]], [[COPY3]], implicit-def dead $eflags
    ; CHECK-NEXT: $al = COPY [[ADD8rr]]
    ; CHECK-NEXT: RET 0, $al
    %0:gr64 = COPY $rdi
    %1:gr64_abcd = MOV64rm %0, 1, $noreg, 0, $noreg :: (load (s64))
    %2:gr8 = COPY %1.sub_8bit
    %3:gr32_abcd = COPY %1.sub_32bit
    %4:gr8 = COPY %3.sub_8bit_hi
    %5:gr8 = ADD8rr %2, %4, implicit-def dead $eflags
    $al = COPY %5
    RET 0, $al
...
