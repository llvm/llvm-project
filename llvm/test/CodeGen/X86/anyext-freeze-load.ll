define i64 @anyext_freeze_load_i8(ptr %p) {
; CHECK-LABEL: anyext_freeze_load_i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movzbl (%rdi), %eax
; CHECK-NEXT:    andl $1, %eax
; CHECK-NEXT:    retq
