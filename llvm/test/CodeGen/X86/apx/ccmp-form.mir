# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -o - %s -mtriple=x86_64 -mattr=+ccmp,+ndd -x86-enable-ccmp -run-pass=machine-ccmp -machine-stress-ccmp | FileCheck %s
# RUN: llc -o - %s -mtriple=x86_64 -mattr=+ccmp,+ndd -x86-enable-ccmp -passes=machine-ccmp -machine-stress-ccmp | FileCheck %s
#
# Exhaustive opcode matrix for X86 CCMP/CTEST formation: one positive case
# per findConvertibleCompare()/getCCMPOpcode() arm across all operand widths.
# -machine-stress-ccmp bypasses the cost model so only recognition + emission
# decide the fold. +ndd is required so the SUB*_ND opcodes are legal; the pass
# runs before the ND->non-ND transform, so the _ND arms are a distinct path.
# The CFG mirrors the proven triangle in ccmp-reject.mir's positive_control.

---
name:            ccmp8rr_from_cmp
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ccmp8rr_from_cmp
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x60000000), %bb.2(0x20000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %h:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   TEST32rr %h, %h, implicit-def $eflags
  ; CHECK-NEXT:   %a:gr8 = IMPLICIT_DEF
  ; CHECK-NEXT:   %b:gr8 = IMPLICIT_DEF
  ; CHECK-NEXT:   CCMP8rr %a, %b, 0, 4, implicit-def $eflags, implicit $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1, %bb.3
    %h:gr32 = IMPLICIT_DEF
    TEST32rr %h, %h, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    %a:gr8 = IMPLICIT_DEF
    %b:gr8 = IMPLICIT_DEF
    CMP8rr %a, %b, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

