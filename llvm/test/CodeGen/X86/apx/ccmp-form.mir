# A debug instruction between the compare and the branch must not hide the
# compare from findConvertibleCompare(), nor block speculation.
---
name:            ccmp_with_dbg_value
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ccmp_with_dbg_value
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x60000000), %bb.2(0x20000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %h:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   TEST32rr %h, %h, implicit-def $eflags
  ; CHECK-NEXT:   %a:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   CTEST32rr %a, %a, 0, 4, implicit-def $eflags, implicit $eflags
  ; CHECK-NEXT:   DBG_VALUE %a, $noreg
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1, %bb.3

    %h:gr32 = IMPLICIT_DEF
    TEST32rr %h, %h, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %a:gr32 = IMPLICIT_DEF
    TEST32rr %a, %a, implicit-def $eflags
    DBG_VALUE %a, $noreg
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# A Head that consists only of terminators, consuming flags set by its own
# predecessor. Exercises the Jcc count walking to the start of the block.
---
name:            ccmp_head_all_terminators
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: ccmp_head_all_terminators
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %h:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %a:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   TEST32rr %h, %h, implicit-def $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.4(0x60000000), %bb.3(0x20000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   CTEST32rr %a, %a, 0, 4, implicit-def $eflags, implicit $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1

    %h:gr32 = IMPLICIT_DEF
    %a:gr32 = IMPLICIT_DEF
    TEST32rr %h, %h, implicit-def $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.4

    JCC_1 %bb.4, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.3, %bb.4

    TEST32rr %a, %a, implicit-def $eflags
    JCC_1 %bb.4, 5, implicit $eflags
    JMP_1 %bb.3

  bb.3:
    RET 0

  bb.4:
    RET 0
...

# Three-deep chain: once CmpBB is merged, the new Head is reconsidered and the
# next compare folds into the same block, so one Head yields two ccmps.
---
name:            ccmp_chain_three_deep
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ccmp_chain_three_deep
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x70000000), %bb.4(0x10000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %h:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %a:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %b:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   TEST32rr %h, %h, implicit-def $eflags
  ; CHECK-NEXT:   CTEST32rr %a, %a, 0, 4, implicit-def $eflags, implicit $eflags
  ; CHECK-NEXT:   CTEST32rr %b, %b, 0, 4, implicit-def $eflags, implicit $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1, %bb.3

    %h:gr32 = IMPLICIT_DEF
    %a:gr32 = IMPLICIT_DEF
    %b:gr32 = IMPLICIT_DEF
    TEST32rr %h, %h, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %a, %a, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.3, %bb.4

    TEST32rr %b, %b, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.4

  bb.3:
    RET 0

  bb.4:
    RET 0
...
