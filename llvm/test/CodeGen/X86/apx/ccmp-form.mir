# Condition-inversion coverage for canConvertToCCMP(): exercise all four
# combinations of HeadTBBIsCmpBB and CmpBBTBBIsTail by flipping each block's
# Jcc target vs. fall-through, hitting both GetOppositeBranchCondition() calls
# and both skip paths. Head=bb.0, CmpBB=bb.1, Tail=bb.3 in every case.

# HeadTBBIsCmpBB=true (Head Jcc -> CmpBB), CmpBBTBBIsTail=true (CmpBB Jcc -> Tail).
---
name:            invert_head_t_cmpbb_t
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: invert_head_t_cmpbb_t
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x60000000), %bb.2(0x20000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %h:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   TEST32rr %h, %h, implicit-def $eflags
  ; CHECK-NEXT:   %a:gr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   CTEST32rr %a, %a, 0, 5, implicit-def $eflags, implicit $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1, %bb.3
    %h:gr32 = IMPLICIT_DEF
    TEST32rr %h, %h, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.3

  bb.1:
    successors: %bb.2, %bb.3
    %a:gr32 = IMPLICIT_DEF
    TEST32rr %a, %a, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

