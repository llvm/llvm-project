# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -mattr=+nf -run-pass=two-address-instruction %s -o - | FileCheck %s

# When the first source stays live and the second is killed, two-address
# commutes SHLD/SHRD to tie the second source to the destination. The commute
# must also switch SHLD <-> SHRD and use BitWidth - imm, not just swap the
# sources:
#   SHLD B, C, I <-> SHRD C, B, (BitWidth - I)
---
name: shld16_legacy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $di, $si
    ; CHECK-LABEL: name: shld16_legacy
    ; CHECK: liveins: $di, $si
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr16 = COPY $di
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr16 = COPY $si
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr16 = COPY [[COPY1]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr16 = SHRD16rri8 [[COPY2]], [[COPY]], 13, implicit-def dead $eflags
    ; CHECK-NEXT: $ax = COPY [[COPY2]]
    ; CHECK-NEXT: $cx = COPY [[COPY]]
    ; CHECK-NEXT: RET64 $ax, $cx
    %0:gr16 = COPY $di
    %1:gr16 = COPY $si
    %2:gr16 = SHLD16rri8 %0, killed %1, 3, implicit-def dead $eflags
    $ax = COPY %2
    $cx = COPY %0
    RET64 $ax, $cx
...
---
