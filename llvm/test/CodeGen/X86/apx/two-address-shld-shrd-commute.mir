    ; CHECK-LABEL: name: shld32_legacy
    ; CHECK: liveins: $edi, $esi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr32 = COPY $esi
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32 = COPY [[COPY1]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32 = SHRD32rri8 [[COPY2]], [[COPY]], 29, implicit-def dead $eflags
    ; CHECK-NEXT: $eax = COPY [[COPY2]]
    ; CHECK-NEXT: $ecx = COPY [[COPY]]
    ; CHECK-NEXT: RET64 $eax, $ecx
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = SHLD32rri8 %0, killed %1, 3, implicit-def dead $eflags
    $eax = COPY %2
    $ecx = COPY %0
    RET64 $eax, $ecx
...
