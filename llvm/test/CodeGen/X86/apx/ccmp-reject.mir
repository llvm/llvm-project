# RUN: llc -o - %s -mtriple=x86_64 -mattr=+ccmp -x86-enable-ccmp -run-pass=machine-ccmp -machine-stress-ccmp | FileCheck %s
# RUN: llc -o - %s -mtriple=x86_64 -mattr=+ccmp -x86-enable-ccmp -passes=machine-ccmp -machine-stress-ccmp | FileCheck %s
# RUN: %if asserts %{ llc -o /dev/null %s -mtriple=x86_64 -mattr=+ccmp -x86-enable-ccmp -run-pass=machine-ccmp -machine-stress-ccmp -stats 2>&1 | FileCheck %s --check-prefix=STATS %}
# RUN: llc -o - %s -mtriple=x86_64 -mattr=+ccmp -x86-enable-ccmp=false -passes=machine-ccmp -machine-stress-ccmp | FileCheck %s --check-prefix=OFF

# This test exercises the structural/recognition reject paths of the
# target-independent CCMP formation pass (machine-ccmp) and its X86 hook.
# -machine-stress-ccmp bypasses the profitability cost model, so only the
# canConvert() and X86 canConvertToCCMP()/findConvertibleCompare() checks
# decide whether a CCMP/CTEST forms. Each reject function keeps its original
# two compares/branches; the positive controls fold to a CTEST (from TEST) and
# a CCMP (from a dead-def SUB).
#
# A reject is invisible in the output (nothing changes), so the STATS run pins
# the rejection counters. Without it, a function could start rejecting for the
# wrong reason -- or stop being recognized at all -- and still pass the CHECK
# runs.
#
# The OFF run disables the pass through the subtarget hook, so not even the
# positive controls fold.
# OFF-NOT: CCMP
# OFF-NOT: CTEST
# STATS-DAG: 2 machine-ccmp {{ *}}- Number of ccmp instructions created
# STATS-DAG: 1 machine-ccmp {{ *}}- Number of ccmps rejected (PHI){{$}}
# STATS-DAG: 1 machine-ccmp {{ *}}- Number of ccmps rejected (PHI2){{$}}
# STATS-DAG: 2 machine-ccmp {{ *}}- Number of ccmps rejected (Physregs)
# STATS-DAG: 3 machine-ccmp {{ *}}- Number of ccmps rejected (Can't speculate)
# STATS-DAG: 1 machine-ccmp {{ *}}- Number of ccmps rejected (Head branch)
# STATS-DAG: 1 machine-ccmp {{ *}}- Number of ccmps rejected (CmpBB branch)
# STATS-DAG: 1 x86-instr-info {{ *}}- Number of ccmps rejected (multiple Jcc in Head)
# STATS-DAG: 2 x86-instr-info {{ *}}- Number of ccmps rejected (Head condition code)
# STATS-DAG: 2 x86-instr-info {{ *}}- Number of ccmps rejected (CmpBB condition code)
# STATS-DAG: 2 x86-instr-info {{ *}}- Number of ccmps rejected (live dest)
# STATS-DAG: 1 x86-instr-info {{ *}}- Number of ccmps rejected (EFLAGS used)
# STATS-DAG: 1 x86-instr-info {{ *}}- Number of ccmps rejected (EFLAGS def unknown)

--- |
  define void @nontrivial_tail_phi(i32 %a, i32 %b) { ret void }
  define void @phi_in_cmpbb(i32 %a, i32 %b) { ret void }
  define void @load_in_cmpbb(i32 %b, ptr %p) { ret void }
  define void @eflags_read_in_cmpbb(i32 %a, i32 %b) { ret void }
  define void @eflags_def_in_cmpbb(i32 %a, i32 %b) { ret void }
  define void @head_two_jcc(i32 %a, i32 %b) { ret void }
  define void @head_cond_parity(i32 %a, i32 %b) { ret void }
  define void @cmpbb_cond_compound(i32 %a, i32 %b) { ret void }
  define void @positive_control(i32 %a, i32 %b) { ret void }
  define void @sub_live_def(i32 %a, i32 %b) { ret void }
  define void @sub_dead_def(i32 %a, i32 %b) { ret void }
  define void @head_cond_np(i32 %a, i32 %b) { ret void }
  define void @cmpbb_cond_e_and_np(i32 %a, i32 %b) { ret void }
  define void @sub_physreg_def(i32 %a, i32 %b) { ret void }
  define void @flags_not_defined_in_cmpbb(i32 %a, i32 %b) { ret void }
  define void @cmpbb_livein(i32 %a, i32 %b) { ret void }
  define void @tail_livein(i32 %a, i32 %b) { ret void }
  define void @store_in_cmpbb(i32 %a, i32 %b, ptr %p) { ret void }
  define void @flags_clobber_before_cmp(i32 %a, i32 %b) { ret void }
  define void @diamond_not_triangle(i32 %a, i32 %b) { ret void }
  define void @head_branch_unanalyzable(i32 %a, i32 %b) { ret void }
  define void @cmpbb_branch_unanalyzable(i32 %a, i32 %b) { ret void }
  define void @optnone_skipped(i32 %a, i32 %b) #0 { ret void }

  attributes #0 = { noinline optnone }
...

# 1. Non-trivial Tail PHI: the Tail PHI selects different values from Head vs
#    CmpBB, so trivialTailPHIs() rejects (stat NumPhiRejs).
---
name:            nontrivial_tail_phi
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: nontrivial_tail_phi
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = MOV32ri 7
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %3:gr32 = MOV32ri 9
    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %4:gr32 = MOV32ri 1
    $eax = COPY %4
    RET 0, $eax

  bb.3:
    %5:gr32 = PHI %2, %bb.0, %3, %bb.1
    $eax = COPY %5
    RET 0, $eax
...

# 2. PHI in CmpBB: a PHI at the front of CmpBB triggers the generic reject
#    (stat NumPhi2Rejs).
---
name:            phi_in_cmpbb
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_in_cmpbb
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       PHI
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %2:gr32 = PHI %0, %bb.0
    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 3. Load in CmpBB: a load before the compare cannot be speculated
#    (canSpeculateInstrs, stat NumSpeculateRejs).
---
name:            load_in_cmpbb
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: load_in_cmpbb
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       MOV32rm
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $rsi

    %0:gr32 = COPY $edi
    %1:gr64 = COPY $rsi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %2:gr32 = MOV32rm %1, 1, $noreg, 0, $noreg
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 4. An instruction that READS EFLAGS between the compare and the terminator
#    (X86 findConvertibleCompare PRI.Read, stat NumMultEFLAGSUses).
---
name:            eflags_read_in_cmpbb
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: eflags_read_in_cmpbb
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       SETCCr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    %2:gr8 = SETCCr 4, implicit $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $al = COPY %2
    RET 0, $al

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 5. An instruction that DEFINES/CLOBBERS EFLAGS between the flag-setting
#    compare and the terminator (X86 findConvertibleCompare PRI.Defined,
#    stat NumUnknEFLAGSDefs).
---
name:            eflags_def_in_cmpbb
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: eflags_def_in_cmpbb
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       ADD32ri
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def dead $eflags
    %2:gr32 = ADD32ri %1, 1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 6. Head has more than one JCC_1 terminator (a compound COND_NE_OR_P head):
#    X86 canConvertToCCMP getNumOfJcc(Head) > 1 reject.
---
name:            head_two_jcc
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: head_two_jcc
  ; CHECK:       bb.0:
  ; CHECK:       JCC_1 %bb.3, 10
  ; CHECK:       JCC_1 %bb.3, 5
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.3, %bb.1
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 10, implicit $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %2:gr32 = MOV32ri 1
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 7. Head branch condition is COND_P (parity): X86 parseCCMPCond reject-list
#    on Head ({COND_P, COND_NP}).
---
name:            head_cond_parity
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: head_cond_parity
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1 %bb.3, 10
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 10, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %2:gr32 = MOV32ri 1
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 8. CmpBB branch condition is a compound COND_NE_OR_P: X86 parseCCMPCond
#    reject-list on CmpBB ({COND_NE_OR_P, COND_E_AND_NP}).
---
name:            cmpbb_cond_compound
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cmpbb_cond_compound
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       JCC_1 %bb.3, 10
  ; CHECK:       JCC_1 %bb.3, 5
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3, %bb.2

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 10, implicit $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %2:gr32 = MOV32ri 1
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 9. Positive control: a plain cmp/jcc -> cmp/jcc triangle DOES fold to a
#    conditional test (CTEST).
---
name:            positive_control
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: positive_control
  ; CHECK:       bb.0:
  ; CHECK:       CTEST32rr
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %3:gr32 = MOV32ri 1
    $eax = COPY %3
    RET 0, $eax

  bb.3:
    %2:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %2
    RET 0, $eax
...

# 9. SUB with a live destination: the compare feeding CmpBB's branch is a SUB
#    whose result is used, so findConvertibleCompare()'s isDeadDef() check fails
#    (CCMP/CTEST produce no GP result). Rejected; both compares are kept.
---
name:            sub_live_def
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: sub_live_def
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       SUB32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %10:gr32 = SUB32rr %1, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %10
    RET 0, $eax

  bb.3:
    %2:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %2
    RET 0, $eax
...

# 10. Positive control (SUB): this pass runs before the SUB is shrunk to CMP, so
#     a SUB with a dead (unused) destination is recognized like CMP and folds to
#     a CCMP.
---
name:            sub_dead_def
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: sub_dead_def
  ; CHECK:       bb.0:
  ; CHECK:       CCMP32rr
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %10:gr32 = SUB32rr %1, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %3:gr32 = MOV32ri 1
    $eax = COPY %3
    RET 0, $eax

  bb.3:
    %2:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %2
    RET 0, $eax
...

# 11. Head branch condition is COND_NP (the second entry in the Head reject-list
#     {COND_P, COND_NP}): X86 parseCCMPCond rejects it.
---
name:            head_cond_np
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: head_cond_np
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1 %bb.3, 11
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 11, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    %2:gr32 = MOV32ri 1
    $eax = COPY %2
    RET 0, $eax

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...

# 12. CmpBB branch condition is the compound COND_E_AND_NP (the second entry in
#     the CmpBB reject-list {COND_NE_OR_P, COND_E_AND_NP}): X86 parseCCMPCond
#     rejects it. analyzeBranch folds the "JP B1 / JE Tail / JMP B1" idiom into
#     COND_E_AND_NP; block layout puts B1 (bb.2) after Tail (bb.3) so the JMP is
#     not a fall-through and survives. Tail=bb.3 is the common successor.
---
name:            cmpbb_cond_e_and_np
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cmpbb_cond_e_and_np
  ; CHECK:       bb.1:
  ; CHECK:       JCC_1 %bb.3, 10
  ; CHECK:       JCC_1 %bb.2, 4
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3, %bb.2

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.2, 10, implicit $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.2

  bb.3:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax

  bb.2:
    %2:gr32 = MOV32ri 1
    $eax = COPY %2
    RET 0, $eax
...

# 14. SUB with a physical-register destination: isDeadDef() rejects on the
#     !isVirtual() arm rather than on the use_nodbg_empty() arm covered by
#     sub_live_def (stat NumLiveDstRejs).
---
name:            sub_physreg_def
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: sub_physreg_def
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       SUB32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    $ecx = SUB32rr %1, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 15. No flag definition in CmpBB: its branch consumes the flags Head set, so
#     findConvertibleCompare() walks the whole block without finding a
#     convertible compare and falls off the end.
---
name:            flags_not_defined_in_cmpbb
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: flags_not_defined_in_cmpbb
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       MOV32ri
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3

    %0:gr32 = IMPLICIT_DEF
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %1:gr32 = MOV32ri 3
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 16. Live-in physreg in CmpBB: speculating the block would need the live-in to
#     be available in Head too, so canConvert() rejects (stat NumPhysRejs).
---
name:            cmpbb_livein
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cmpbb_livein
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $ecx

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 17. Live-in physreg in Tail: same rejection, on the Tail arm (NumPhysRejs).
---
name:            tail_livein
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: tail_livein
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    liveins: $ecx
    RET 0
...

# 18. Store in CmpBB: not safe to speculate, so canSpeculateInstrs() rejects on
#     the isSafeToMove() arm rather than the mayLoad() arm covered by
#     load_in_cmpbb (stat NumSpeculateRejs).
---
name:            store_in_cmpbb
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: store_in_cmpbb
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       MOV32mi
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi, $rdx

    %2:gr64 = COPY $rdx
    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    MOV32mi %2, 1, $noreg, 0, $noreg, 7 :: (store (s32))
    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 19. Flag clobber before the compare in CmpBB: the ADD would be speculated into
#     Head ahead of the ccmp and overwrite the flags Head's compare set, so
#     canSpeculateInstrs() rejects (stat NumSpeculateRejs). Note this is a
#     different path from eflags_def_in_cmpbb, where the extra flag definition
#     sits after the compare and is caught by findConvertibleCompare() instead.
---
name:            flags_clobber_before_cmp
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: flags_clobber_before_cmp
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       ADD32ri
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %2:gr32 = ADD32ri %1, 3, implicit-def $eflags
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 20. Diamond rather than triangle: CmpBB's successors do not include Head's
#     other successor, so there is no common Tail and canConvert() rejects on
#     the topology check, before the candidate is even counted.
---
name:            diamond_not_triangle
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: diamond_not_triangle
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.4, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0

  bb.4:
    RET 0
...

# 21. Unanalyzable Head terminator: analyzeBranch() cannot describe the indirect
#     branch, so the generic pass rejects (stat NumHeadBranchRejs).
---
name:            head_branch_unanalyzable
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: head_branch_unanalyzable
  ; CHECK:       bb.0:
  ; CHECK:       JMP64r
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi, $rdx

    %2:gr64 = COPY $rdx
    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    JMP64r %2

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 22. Unanalyzable CmpBB terminator: same rejection on the CmpBB arm (stat
#     NumCmpBranchRejs).
---
name:            cmpbb_branch_unanalyzable
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cmpbb_branch_unanalyzable
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JMP64r
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi, $rdx

    %2:gr64 = COPY $rdx
    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JMP64r %2

  bb.2:
    RET 0

  bb.3:
    RET 0
...

# 23. optnone: the pass skips the function entirely, so an otherwise convertible
#     triangle is left alone. This candidate is not counted at all.
---
name:            optnone_skipped
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: optnone_skipped
  ; CHECK:       bb.0:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK:       bb.1:
  ; CHECK:       TEST32rr
  ; CHECK:       JCC_1
  ; CHECK-NOT:   CCMP
  ; CHECK-NOT:   CTEST
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi

    %1:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    RET 0

  bb.3:
    RET 0
...
