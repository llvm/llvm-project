;; +cf emits register-form CFCMOV. Memory forms (conditional faulting
;; load/store) need +prefer-cf-mem-operand. DMR and NVL enable CF by default.

define i64 @reg_form(i64 %a, i64 %x) {
; CHECK-LABEL: reg_form:
; CHECK:       # %bb.0:
; CHECK-NEXT:    testq %rdi, %rdi
; CHECK-NEXT:    cfcmoveq %rsi, %rax
; CHECK-NEXT:    retq
  %c = icmp eq i64 %a, 0
  %r = select i1 %c, i64 %x, i64 0
  ret i64 %r
}

