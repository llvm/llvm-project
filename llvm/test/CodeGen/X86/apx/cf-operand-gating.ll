;; +cf emits register-form CFCMOV only; memory forms need -x86-cf-mem-operand.
;; DMR and NVL enable CF by default. -x86-cf-reg-operand=false uses XOR + CMOV.

define i64 @reg_form(i64 %a, i64 %x) {
; CHECK-LABEL: reg_form:
; CHECK:       # %bb.0:
; CHECK-NEXT:    testq %rdi, %rdi
; CHECK-NEXT:    cfcmoveq %rsi, %rax
; CHECK-NEXT:    retq
;
; CPU-REG-LABEL: reg_form:
; CPU-REG:       # %bb.0:
; CPU-REG-NEXT:    testq %rdi, %rdi
; CPU-REG-NEXT:    cfcmoveq %rsi, %rax
; CPU-REG-NEXT:    retq
;
; CPU-NOREG-LABEL: reg_form:
; CPU-NOREG:       # %bb.0:
; CPU-NOREG-NEXT:    xorl %eax, %eax
; CPU-NOREG-NEXT:    testq %rdi, %rdi
; CPU-NOREG-NEXT:    cmoveq %rsi, %rax
; CPU-NOREG-NEXT:    retq
  %c = icmp eq i64 %a, 0
  %r = select i1 %c, i64 %x, i64 0
  ret i64 %r
}

