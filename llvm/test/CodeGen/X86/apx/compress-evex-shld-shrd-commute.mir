    ; CHECK: liveins: $ecx, $r8d
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r8d = SHRD32rri8_NF $r8d, $ecx, 27
    ; CHECK-NEXT: RET64 $r8d
    $r8d = SHLD32rri8_NF_ND $ecx, $r8d, 5
    RET64 $r8d
...
