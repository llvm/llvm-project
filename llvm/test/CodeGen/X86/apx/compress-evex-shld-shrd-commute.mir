# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -mattr=+ndd,+nf -run-pass=x86-compress-evex %s -o - | FileCheck %s

# When the destination of an NDD SHLD/SHRD matches its second source,
# x86-compress-evex commutes it to drop the NDD form. The commute must also
# switch SHLD <-> SHRD and use BitWidth - imm, not just swap the sources:
#   SHLD B, C, I <-> SHRD C, B, (BitWidth - I)
---
name: shld16_nf_nd
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $cx, $r8w
    ; CHECK-LABEL: name: shld16_nf_nd
    ; CHECK: liveins: $cx, $r8w
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r8w = SHRD16rri8_NF $r8w, $cx, 8
    ; CHECK-NEXT: RET64 $r8w
    $r8w = SHLD16rri8_NF_ND $cx, $r8w, 8
    RET64 $r8w
...
---
name: shld32_nf_nd
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ecx, $r8d
