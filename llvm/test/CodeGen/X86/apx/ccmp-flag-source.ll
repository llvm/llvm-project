; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-unknown -mattr=+ccmp | FileCheck %s

; When a SETCC leaf of a conjunction/disjunction tree compares an OR/ADD/XOR
; against zero (possibly after canonicalization of "sge X, 0" to "sgt X, -1"
; etc.), EmitCmp folds the leaf's flag source onto the OR/ADD/XOR node
; itself. That flag source has different SF/ZF semantics from a subtract, so
; the leaf cannot be emitted as a CCMP (a subtract) in a non-root slot of the
; chain -- doing so silently changes the predicate.
;
; This test locks in that such a leaf is forced to the root of the chain,
; where the OR/ADD/XOR is materialized as a real flag-setting instruction and
; its EFLAGS feed the next CCMP via the chain, preserving the original
; semantics.

define i32 @sign_of_or_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: sign_of_or_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    orl %esi, %edi
; CHECK-NEXT:    ccmpnsl {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %or   = or i32 %x, %y
  %sign = icmp sge i32 %or, 0
  %le   = icmp sle i32 %a, %b
  %cond = and i1 %sign, %le
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

define i32 @sign_of_xor_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: sign_of_xor_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xorl %esi, %edi
; CHECK-NEXT:    ccmpnsl {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %xor  = xor i32 %x, %y
  %sign = icmp sge i32 %xor, 0
  %le   = icmp sle i32 %a, %b
  %cond = and i1 %sign, %le
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

define i32 @sign_of_add_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: sign_of_add_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addl %esi, %edi
; CHECK-NEXT:    ccmpnsl {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %add  = add i32 %x, %y
  %sign = icmp sge i32 %add, 0
  %le   = icmp sle i32 %a, %b
  %cond = and i1 %sign, %le
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

; Same shape but via "%or slt 1" canonicalization -- TranslateX86CC rewrites
; "slt X, 1" to "sle X, 0" (COND_LE with RHS=0). We still need to detect the
; folded flag source.
define i32 @sle_zero_or_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: sle_zero_or_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    orl %esi, %edi
; CHECK-NEXT:    ccmplel {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %or   = or i32 %x, %y
  %sign = icmp slt i32 %or, 1
  %le   = icmp sle i32 %a, %b
  %cond = and i1 %sign, %le
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

; If two OR-leaves both need to be at the root, CCMP formation must bail
; back to the plain-CMOV chain rather than mis-emit. Here InstCombine
; collapses the two OR/sign gates into (x|y|a|b) >= 0 before we get to
; codegen, so no CCMP is produced -- the important thing is that no
; incorrect CCMP chain is emitted.
define i32 @two_or_leaves(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: two_or_leaves:
; CHECK:       # %bb.0:
; CHECK-NEXT:    orl %esi, %edi
; CHECK-NEXT:    orl %ecx, %edx
; CHECK-NEXT:    orl %edi, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovnsl %r8d, %eax
; CHECK-NEXT:    retq
  %o1 = or i32 %x, %y
  %o2 = or i32 %a, %b
  %s1 = icmp sge i32 %o1, 0
  %s2 = icmp sge i32 %o2, 0
  %c  = and i1 %s1, %s2
  %r  = select i1 %c, i32 %v, i32 -1
  ret i32 %r
}

; When the AND result is dead (only its flags are used), EmitTest picks a
; plain X86ISD::CMP r,0 as the flag source, so the leaf is emitted as a
; regular CCMP r,0 -- correct because SF/ZF of "%and - 0" equal SF/ZF of
; "%and". Just verify no mis-typed CCMP on the AND's *operands* is emitted.
define i32 @sign_of_and_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: sign_of_and_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    andl %esi, %edi
; CHECK-NEXT:    cmpl %ecx, %edx
; CHECK-NEXT:    ccmplel {dfv=sf} $0, %edi
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovnsl %r8d, %eax
; CHECK-NEXT:    retq
  %and  = and i32 %x, %y
  %sign = icmp sge i32 %and, 0
  %le   = icmp sle i32 %a, %b
  %cond = and i1 %sign, %le
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

; Two used ANDs joined by an AND -- both AND-flag-source leaves in a chain.
; One AND-leaf becomes the root (its "andl" also serves as the flag-setter);
; the other AND-leaf must be lowered as CTEST in the non-root slot. Before
; this fix that non-root leaf was miscompiled as CCMP (a conditional SUB)
; instead of CTEST (a conditional AND), producing the wrong flags.
define i32 @two_used_ands_ctest(i32 %x, i32 %y, i32 %p, i32 %q, i32 %v,
; CHECK-LABEL: two_used_ands_ctest:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq {{[0-9]+}}(%rsp), %rax
; CHECK-NEXT:    movl %edi, %r10d
; CHECK-NEXT:    andl %esi, %r10d
; CHECK-NEXT:    movl %r10d, (%r9)
; CHECK-NEXT:    andl %ecx, %edx
; CHECK-NEXT:    movl %edx, (%rax)
; CHECK-NEXT:    ctestnel {dfv=zf} %esi, %edi
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovnel %r8d, %eax
; CHECK-NEXT:    retq
                                ptr %s1, ptr %s2) {
  %a1 = and i32 %x, %y
  store i32 %a1, ptr %s1
  %a2 = and i32 %p, %q
  store i32 %a2, ptr %s2
  %c1 = icmp ne i32 %a1, 0
  %c2 = icmp ne i32 %a2, 0
  %c  = and i1 %c1, %c2
  %r  = select i1 %c, i32 %v, i32 -1
  ret i32 %r
}

; An interior XOR combines two SETCC results (c1 XOR c2). canEmitConjunction
; only recurses through AND/OR, so the whole tree is rejected and we fall
; back to the plain setcc/xor/test chain -- no CCMP is emitted.
define i32 @and_with_interior_xor(i32 %a, i32 %b, i32 %c, i32 %d,
; CHECK-LABEL: and_with_interior_xor:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cmpl %esi, %edi
; CHECK-NEXT:    setl %al
; CHECK-NEXT:    cmpl %ecx, %edx
; CHECK-NEXT:    setl %cl
; CHECK-NEXT:    cmpl %r9d, %r8d
; CHECK-NEXT:    setl %dl
; CHECK-NEXT:    xorb %cl, %dl
; CHECK-NEXT:    testb %dl, %al
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    je .LBB7_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    movl {{[0-9]+}}(%rsp), %eax
; CHECK-NEXT:  .LBB7_2:
; CHECK-NEXT:    retq
                                  i32 %e, i32 %f, i32 %v) {
  %c1 = icmp slt i32 %a, %b
  %c2 = icmp slt i32 %c, %d
  %c3 = icmp slt i32 %e, %f
  %x  = xor i1 %c2, %c3
  %r  = and i1 %c1, %x
  %s  = select i1 %r, i32 %v, i32 -1
  ret i32 %s
}

; Direct "icmp ne (or X, Y), 0" -- exercises the C->isZero() form of the
; folded-flag-source detection (not the "sge X, 0" -> "sgt X, -1"
; canonicalization the sign_of_* tests above rely on). The OR-vs-0 leaf must
; still be forced to the root.
define i32 @ne_zero_or_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: ne_zero_or_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    orl %esi, %edi
; CHECK-NEXT:    ccmpnel {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %or   = or i32 %x, %y
  %c1   = icmp ne i32 %or, 0
  %c2   = icmp sle i32 %a, %b
  %cond = and i1 %c1, %c2
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

; Same C->isZero() form via "icmp eq (add X, Y), 0".
define i32 @eq_zero_add_gate(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: eq_zero_add_gate:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addl %esi, %edi
; CHECK-NEXT:    ccmpel {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %add  = add i32 %x, %y
  %c1   = icmp eq i32 %add, 0
  %c2   = icmp sle i32 %a, %b
  %cond = and i1 %c1, %c2
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

; A disjunction (OR-rooted tree) that contains a must-be-first (or-vs-0)
; flag-source leaf. This exercises the interaction of the forced-root leaf
; with the OR branch's negation/swap bookkeeping (which the AND-rooted
; sign_of_* tests do not reach). Verified equivalent to the branch lowering.
define i32 @or_disjunction_forced_leaf(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v) {
; CHECK-LABEL: or_disjunction_forced_leaf:
; CHECK:       # %bb.0:
; CHECK-NEXT:    orl %esi, %edi
; CHECK-NEXT:    cmpl $-1, %edi
; CHECK-NEXT:    ccmplel {dfv=zf} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovlel %r8d, %eax
; CHECK-NEXT:    retq
  %or   = or i32 %x, %y
  %c1   = icmp sge i32 %or, 0
  %c2   = icmp sle i32 %a, %b
  %cond = or i1 %c1, %c2
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}

; A non-root leaf whose flag source is a *used* subtract, so EmitCmp reuses
; the X86ISD::SUB node (not a fresh CMP). This exercises the SUB -> CCMP arm
; of the flag-source opcode switch. The or-vs-0 leaf is forced to the root,
; pushing the SUB-flagged "slt %a, %b" leaf into the non-root CCMP slot.
define i32 @used_sub_ccmp(i32 %x, i32 %y, i32 %a, i32 %b, i32 %v, ptr %p) {
; CHECK-LABEL: used_sub_ccmp:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl %edx, %eax
; CHECK-NEXT:    subl %ecx, %eax
; CHECK-NEXT:    movl %eax, (%r9)
; CHECK-NEXT:    orl %esi, %edi
; CHECK-NEXT:    ccmpnsl {dfv=} %ecx, %edx
; CHECK-NEXT:    movl $-1, %eax
; CHECK-NEXT:    cmovll %r8d, %eax
; CHECK-NEXT:    retq
  %sub  = sub i32 %a, %b
  store i32 %sub, ptr %p
  %c1   = icmp slt i32 %a, %b
  %or   = or i32 %x, %y
  %c2   = icmp sge i32 %or, 0
  %cond = and i1 %c1, %c2
  %sel  = select i1 %cond, i32 %v, i32 -1
  ret i32 %sel
}
