# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+ndd -run-pass=x86-cmov-conversion -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+ndd,+prefer-ndd-mem -run-pass=x86-cmov-conversion -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FOLDED
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+ndd -x86-cmov-converter-ndd-load=false -run-pass=x86-cmov-conversion -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FOLDED

# The CMOVs are unpredictable, so the pass keeps them. Without prefer-ndd-mem
# it unfolds each non-RIP-relative load into MOVrm + CMOVrr_ND, keeping the MI
# flags and debug-instr-number (CHECK). With prefer-ndd-mem or
# -x86-cmov-converter-ndd-load=false the loads stay folded (FOLDED).
---
# CHECK-LABEL: name: unfold
# CHECK:         [[L16:%[0-9]+]]:gr16 = MOV16rm [[P:%[0-9]+]], 1, $noreg, 0, $noreg :: (load (s16))
# CHECK-NEXT:    unpredictable CMOV16rr_ND {{%[0-9]+}}, [[L16]], 3, implicit $eflags
# CHECK-NEXT:    [[L32:%[0-9]+]]:gr32 = MOV32rm [[P]], 1, $noreg, 4, $noreg :: (load (s32))
# CHECK-NEXT:    unpredictable CMOV32rr_ND {{%[0-9]+}}, [[L32]], 3, implicit $eflags, debug-instr-number 1
# CHECK-NEXT:    [[L64:%[0-9]+]]:gr64 = MOV64rm [[P]], 1, $noreg, 8, $noreg :: (load (s64))
# CHECK-NEXT:    unpredictable CMOV64rr_ND {{%[0-9]+}}, [[L64]], 3, implicit $eflags
# CHECK-NEXT:    [[LFI:%[0-9]+]]:gr32 = MOV32rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s32))
# CHECK-NEXT:    unpredictable CMOV32rr_ND {{%[0-9]+}}, [[LFI]], 3, implicit $eflags
# CHECK-NEXT:    unpredictable CMOV32rm_ND {{%[0-9]+}}, $rip, 1, $noreg, 0, $noreg, 3, implicit $eflags
# FOLDED-LABEL: name: unfold
# FOLDED:          CMOV16rm_ND
# FOLDED-NEXT:     CMOV32rm_ND
# FOLDED-NEXT:     CMOV64rm_ND
name:            unfold
tracksRegLiveness: true
fixedStack:
  - { id: 0, offset: 8, size: 4, alignment: 8, isImmutable: true }
body:             |
  bb.0:
    liveins: $rdi, $rsi

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr32 = COPY %1.sub_32bit
    %3:gr16 = COPY %1.sub_16bit
    %4:gr64 = SUB64ri32_ND %1, 8, implicit-def $eflags
    %5:gr16 = unpredictable CMOV16rm_ND %3, %0, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s16))
    %6:gr32 = unpredictable CMOV32rm_ND %2, %0, 1, $noreg, 4, $noreg, 3, implicit $eflags, debug-instr-number 1 :: (load (s32))
    %7:gr64 = unpredictable CMOV64rm_ND %1, %0, 1, $noreg, 8, $noreg, 3, implicit $eflags :: (load (s64))
    %8:gr32 = unpredictable CMOV32rm_ND %2, %fixed-stack.0, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    %9:gr32 = unpredictable CMOV32rm_ND %2, $rip, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    RET 0
...
