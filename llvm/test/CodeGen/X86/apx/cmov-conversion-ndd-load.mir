# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+ndd -run-pass=x86-cmov-conversion -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+ndd,+prefer-ndd-mem -run-pass=x86-cmov-conversion -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FOLDED
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -mattr=+ndd -x86-cmov-converter-ndd-load=false -run-pass=x86-cmov-conversion -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FOLDED

# The CMOVs are unpredictable, so the pass keeps them. Without prefer-ndd-mem
# it unfolds each non-RIP-relative load into MOVrm + CMOVrr_ND, keeping the MI
# flags and debug-instr-number (CHECK). With prefer-ndd-mem or
# -x86-cmov-converter-ndd-load=false the loads stay folded (FOLDED).
---
name:            unfold
tracksRegLiveness: true
fixedStack:
  - { id: 0, offset: 8, size: 4, alignment: 8, isImmutable: true }
body:             |
  bb.0:
    liveins: $rdi, $rsi

    ; CHECK-LABEL: name: unfold
    ; CHECK: liveins: $rdi, $rsi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32 = COPY [[COPY1]].sub_32bit
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gr16 = COPY [[COPY1]].sub_16bit
    ; CHECK-NEXT: [[SUB64ri32_ND:%[0-9]+]]:gr64 = SUB64ri32_ND [[COPY1]], 8, implicit-def $eflags
    ; CHECK-NEXT: [[MOV16rm:%[0-9]+]]:gr16 = MOV16rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s16))
    ; CHECK-NEXT: [[CMOV16rr_ND:%[0-9]+]]:gr16 = unpredictable CMOV16rr_ND [[COPY3]], [[MOV16rm]], 3, implicit $eflags
    ; CHECK-NEXT: [[MOV32rm:%[0-9]+]]:gr32 = MOV32rm [[COPY]], 1, $noreg, 4, $noreg :: (load (s32))
    ; CHECK-NEXT: [[CMOV32rr_ND:%[0-9]+]]:gr32 = unpredictable CMOV32rr_ND [[COPY2]], [[MOV32rm]], 3, implicit $eflags, debug-instr-number 1
    ; CHECK-NEXT: [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY]], 1, $noreg, 8, $noreg :: (load (s64))
    ; CHECK-NEXT: [[CMOV64rr_ND:%[0-9]+]]:gr64 = unpredictable CMOV64rr_ND [[COPY1]], [[MOV64rm]], 3, implicit $eflags
    ; CHECK-NEXT: [[MOV32rm1:%[0-9]+]]:gr32 = MOV32rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s32))
    ; CHECK-NEXT: [[CMOV32rr_ND1:%[0-9]+]]:gr32 = unpredictable CMOV32rr_ND [[COPY2]], [[MOV32rm1]], 3, implicit $eflags
    ; CHECK-NEXT: [[CMOV32rm_ND:%[0-9]+]]:gr32 = unpredictable CMOV32rm_ND [[COPY2]], $rip, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    ; CHECK-NEXT: RET 0
    ;
    ; FOLDED-LABEL: name: unfold
    ; FOLDED: liveins: $rdi, $rsi
    ; FOLDED-NEXT: {{  $}}
    ; FOLDED-NEXT: [[COPY:%[0-9]+]]:gr64 = COPY $rdi
    ; FOLDED-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; FOLDED-NEXT: [[COPY2:%[0-9]+]]:gr32 = COPY [[COPY1]].sub_32bit
    ; FOLDED-NEXT: [[COPY3:%[0-9]+]]:gr16 = COPY [[COPY1]].sub_16bit
    ; FOLDED-NEXT: [[SUB64ri32_ND:%[0-9]+]]:gr64 = SUB64ri32_ND [[COPY1]], 8, implicit-def $eflags
    ; FOLDED-NEXT: [[CMOV16rm_ND:%[0-9]+]]:gr16 = unpredictable CMOV16rm_ND [[COPY3]], [[COPY]], 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s16))
    ; FOLDED-NEXT: [[CMOV32rm_ND:%[0-9]+]]:gr32 = unpredictable CMOV32rm_ND [[COPY2]], [[COPY]], 1, $noreg, 4, $noreg, 3, implicit $eflags, debug-instr-number 1 :: (load (s32))
    ; FOLDED-NEXT: [[CMOV64rm_ND:%[0-9]+]]:gr64 = unpredictable CMOV64rm_ND [[COPY1]], [[COPY]], 1, $noreg, 8, $noreg, 3, implicit $eflags :: (load (s64))
    ; FOLDED-NEXT: [[CMOV32rm_ND1:%[0-9]+]]:gr32 = unpredictable CMOV32rm_ND [[COPY2]], %fixed-stack.0, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    ; FOLDED-NEXT: [[CMOV32rm_ND2:%[0-9]+]]:gr32 = unpredictable CMOV32rm_ND [[COPY2]], $rip, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    ; FOLDED-NEXT: RET 0
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr32 = COPY %1.sub_32bit
    %3:gr16 = COPY %1.sub_16bit
    %4:gr64 = SUB64ri32_ND %1, 8, implicit-def $eflags
    %5:gr16 = unpredictable CMOV16rm_ND %3, %0, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s16))
    %6:gr32 = unpredictable CMOV32rm_ND %2, %0, 1, $noreg, 4, $noreg, 3, implicit $eflags, debug-instr-number 1 :: (load (s32))
    %7:gr64 = unpredictable CMOV64rm_ND %1, %0, 1, $noreg, 8, $noreg, 3, implicit $eflags :: (load (s64))
    %8:gr32 = unpredictable CMOV32rm_ND %2, %fixed-stack.0, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    %9:gr32 = unpredictable CMOV32rm_ND %2, $rip, 1, $noreg, 0, $noreg, 3, implicit $eflags :: (load (s32))
    RET 0
...
