# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-pc-windows-msvc -mattr=+avx512f -run-pass=machinelicm -o - %s | FileCheck %s

# Win64 preserves XMM6-15 but not their YMM/ZMM super-registers, which share
# the same register units. Only the XMM reload can be hoisted across the call.
---
name: win64_preserved_xmm
stack:
  - { id: 0, type: spill-slot, size: 64, alignment: 64 }
body: |
  ; CHECK-LABEL: name: win64_preserved_xmm
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rbx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $xmm6 = MOVUPSrm %stack.0, 1, $noreg, 0, $noreg :: (load (s128) from %stack.0)
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rbx, $xmm6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   CALL64pcrel32 &callee, csr_win64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
  ; CHECK-NEXT:   $ymm7 = VMOVUPSYrm %stack.0, 1, $noreg, 0, $noreg :: (load (s256) from %stack.0)
  ; CHECK-NEXT:   $zmm8 = VMOVDQU64Zrm %stack.0, 1, $noreg, 0, $noreg :: (load (s512) from %stack.0)
  ; CHECK-NEXT:   TEST64rr $rbx, $rbx, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $xmm6, $ymm7, $zmm8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET64 implicit $xmm6, implicit $ymm7, implicit $zmm8
  bb.0:
    liveins: $rbx
    JMP_1 %bb.1

  bb.1:
    liveins: $rbx
    $xmm6 = MOVUPSrm %stack.0, 1, $noreg, 0, $noreg :: (load (s128) from %stack.0)
    CALL64pcrel32 &callee, csr_win64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
    $ymm7 = VMOVUPSYrm %stack.0, 1, $noreg, 0, $noreg :: (load (s256) from %stack.0)
    $zmm8 = VMOVDQU64Zrm %stack.0, 1, $noreg, 0, $noreg :: (load (s512) from %stack.0)
    TEST64rr $rbx, $rbx, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    liveins: $xmm6, $ymm7, $zmm8
    RET64 implicit $xmm6, implicit $ymm7, implicit $zmm8
...
