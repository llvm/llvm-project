  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr8 = COPY [[COPY]].sub_8bit
  ; CHECK-NEXT:   MOV32mi %stack.0.a, 4, [[COPY1]], 0, $noreg, 1 :: (store (s32) into %ir.pa)
  ; CHECK-NEXT:   MOV32mi %stack.0.a, 4, [[COPY1]], 0, $noreg, 2 :: (store (s32) into %ir.pb)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.2(0x30000000), %bb.3(0x50000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr64 = PHI [[COPY2]], %bb.0, %5, %bb.3
  ; CHECK-NEXT:   [[MOVZX32rm16_:%[0-9]+]]:gr32 = MOVZX32rm16 [[PHI]], 1, $noreg, 0, $noreg :: (load (s16) from %ir.cur, !tbaa !8)
  ; CHECK-NEXT:   TEST32rr [[MOVZX32rm16_]], [[MOVZX32rm16_]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.skip:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD64ri32_:%[0-9]+]]:gr64 = ADD64ri32 [[PHI]], 2, implicit-def dead $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.latch:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.4(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr64 = PHI [[PHI]], %bb.1, [[ADD64ri32_]], %bb.2
  ; CHECK-NEXT:   TEST8ri [[COPY3]], 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.exit:
  ; CHECK-NEXT:   $eax = COPY [[MOVZX32rm16_]]
  ; CHECK-NEXT:   RET 0, $eax
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $rdi, $rsi, $edx

    %6:gr32 = COPY $edx
    %5:gr64_nosp = COPY $rsi
    %4:gr64 = COPY $rdi
    %7:gr8 = COPY %6.sub_8bit
    LIFETIME_START %stack.0.a
    MOV32mi %stack.0.a, 4, %5, 0, $noreg, 1 :: (store (s32) into %ir.pa, !tbaa !5)
    LIFETIME_END %stack.0.a
    LIFETIME_START %stack.1.b
    MOV32mi %stack.1.b, 4, %5, 0, $noreg, 2 :: (store (s32) into %ir.pb, !tbaa !5)
    LIFETIME_END %stack.1.b

  bb.1.loop:
    successors: %bb.2(0x30000000), %bb.3(0x50000000)

    %0:gr64 = PHI %4, %bb.0, %3, %bb.3
    %1:gr32 = MOVZX32rm16 %0, 1, $noreg, 0, $noreg :: (load (s16) from %ir.cur, !tbaa !8)
    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2.skip:
    successors: %bb.3(0x80000000)

    %2:gr64 = ADD64ri32 %0, 2, implicit-def dead $eflags

  bb.3.latch:
    successors: %bb.1(0x7c000000), %bb.4(0x04000000)

    %3:gr64 = PHI %0, %bb.1, %2, %bb.2
    TEST8ri %7, 1, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.4

  bb.4.exit:
    $eax = COPY %1
    RET 0, $eax
...
---
name:            deep
tracksRegLiveness: true
stack:
  - { id: 0, name: a, size: 64, alignment: 4 }
  - { id: 1, name: b, size: 64, alignment: 4 }
body:             |
  bb.0 (%ir-block.0):
    liveins: $rdi

    ; CHECK-LABEL: name: deep
    ; CHECK: liveins: $rdi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64_nosp = COPY $rdi
    ; CHECK-NEXT: MOV32mi %stack.0.a, 4, [[COPY]], 0, $noreg, 1 :: (store (s32) into %ir.pa)
    ; CHECK-NEXT: MOV32mi %stack.0.a, 4, [[COPY]], 0, $noreg, 2 :: (store (s32) into %ir.pb)
    ; CHECK-NEXT: [[LEA64r:%[0-9]+]]:gr64 = LEA64r %stack.0.a, 1, [[COPY]], 0, $noreg
    ; CHECK-NEXT: [[ADD64rr:%[0-9]+]]:gr64 = ADD64rr [[LEA64r]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr1:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr2:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr1]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr3:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr2]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr4:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr3]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr5:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr4]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr6:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr5]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr7:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr6]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr8:%[0-9]+]]:gr64 = ADD64rr [[ADD64rr7]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[ADD64rr9:%[0-9]+]]:gr64_nosp = ADD64rr [[ADD64rr8]], [[COPY]], implicit-def dead $eflags
    ; CHECK-NEXT: [[MOVZX32rm16_:%[0-9]+]]:gr32 = MOVZX32rm16 [[COPY]], 1, [[ADD64rr9]], 0, $noreg :: (load (s16) from %ir.g12)
    ; CHECK-NEXT: $eax = COPY [[MOVZX32rm16_]]
    ; CHECK-NEXT: RET 0, $eax
    %0:gr64_nosp = COPY $rdi
    LIFETIME_START %stack.0.a
    MOV32mi %stack.0.a, 4, %0, 0, $noreg, 1 :: (store (s32) into %ir.pa, !tbaa !5)
    LIFETIME_END %stack.0.a
    LIFETIME_START %stack.1.b
    MOV32mi %stack.1.b, 4, %0, 0, $noreg, 2 :: (store (s32) into %ir.pb, !tbaa !5)
    %1:gr64 = LEA64r %stack.1.b, 1, %0, 0, $noreg
    %2:gr64 = ADD64rr %1, %0, implicit-def dead $eflags
    %3:gr64 = ADD64rr %2, %0, implicit-def dead $eflags
    %4:gr64 = ADD64rr %3, %0, implicit-def dead $eflags
    %5:gr64 = ADD64rr %4, %0, implicit-def dead $eflags
    %6:gr64 = ADD64rr %5, %0, implicit-def dead $eflags
    %7:gr64 = ADD64rr %6, %0, implicit-def dead $eflags
    %8:gr64 = ADD64rr %7, %0, implicit-def dead $eflags
    %9:gr64 = ADD64rr %8, %0, implicit-def dead $eflags
    %10:gr64 = ADD64rr %9, %0, implicit-def dead $eflags
    %11:gr64_nosp = ADD64rr %10, %0, implicit-def dead $eflags
    %12:gr32 = MOVZX32rm16 %0, 1, %11, 0, $noreg :: (load (s16) from %ir.g12, !tbaa !8)
    LIFETIME_END %stack.1.b
    $eax = COPY %12
    RET 0, $eax
...
