# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 3
# RUN: llc -run-pass=stack-coloring %s -o - | FileCheck %s

# There are no stack coloring remappings in @main, so there is no reason to
# drop the tbaa metadata on the MOV8rm instruction.

--- |
  source_filename = "test_case.cc"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"

  %struct.Agg = type { [3 x i8], [3 x i8] }

  define i8 @main() {
    %padding = alloca %struct.Agg, align 8
    %agg = alloca %struct.Agg, align 8
    %a2 = getelementptr inbounds %struct.Agg, ptr %agg, i64 0, i32 1
    %a22 = getelementptr inbounds [3 x i8], ptr %a2, i64 0, i32 1
    %t0 = load i8, ptr %a22, align 1, !tbaa !2
    %tobool = icmp slt i8 %t0, 0
    %t1 = load ptr, ptr %a2, align 8
    %cond = select i1 %tobool, ptr %t1, ptr %a2
    %add.ptr.i = getelementptr inbounds i8, ptr %cond, i64 16
    %t2 = load i8, ptr %add.ptr.i, align 1, !tbaa !2
    ret i8 %t2
  }

  ; In the functions below, %a and %b share a slot, so accesses to it lose
  ; their TBAA tags. Here %p and %q cannot point into it and keep theirs.
  define i32 @uncaptured(ptr %p, ptr %pp, i64 %i) {
    %a = alloca [16 x i32], align 4
    %b = alloca [16 x i32], align 4
    call void @llvm.lifetime.start.p0(ptr %a)
    %pa = getelementptr [4 x i8], ptr %a, i64 %i
    store i32 1, ptr %pa, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %a)
    call void @llvm.lifetime.start.p0(ptr %b)
    %pb = getelementptr [4 x i8], ptr %b, i64 %i
    store i32 2, ptr %pb, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %b)
    %x = load i16, ptr %p, align 2, !tbaa !8
    %q = load ptr, ptr %pp, align 8, !tbaa !10
    %y = load i16, ptr %q, align 2, !tbaa !8
    %s = add i16 %x, %y
    %r = zext i16 %s to i32
    ret i32 %r
  }

  ; Only the address of %a escapes, which does not let %q access it.
  define i32 @address_only(ptr %pp, ptr %out, i64 %i) {
    %a = alloca [16 x i32], align 4
    %b = alloca [16 x i32], align 4
    call void @llvm.lifetime.start.p0(ptr %a)
    %addr = ptrtoaddr ptr %a to i64
    store i64 %addr, ptr %out, align 8
    %pa = getelementptr [4 x i8], ptr %a, i64 %i
    store i32 1, ptr %pa, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %a)
    call void @llvm.lifetime.start.p0(ptr %b)
    %pb = getelementptr [4 x i8], ptr %b, i64 %i
    store i32 2, ptr %pb, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %b)
    %q = load ptr, ptr %pp, align 8, !tbaa !10
    %y = load i16, ptr %q, align 2, !tbaa !8
    %r = zext i16 %y to i32
    ret i32 %r
  }

  ; %a escapes, so %q may point into the shared slot. %p still cannot.
  define i32 @captured(ptr %p, ptr %pp, ptr %out, i64 %i) {
    %a = alloca [16 x i32], align 4
    %b = alloca [16 x i32], align 4
    call void @llvm.lifetime.start.p0(ptr %a)
    store ptr %a, ptr %out, align 8
    %pa = getelementptr [4 x i8], ptr %a, i64 %i
    store i32 1, ptr %pa, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %a)
    call void @llvm.lifetime.start.p0(ptr %b)
    %pb = getelementptr [4 x i8], ptr %b, i64 %i
    store i32 2, ptr %pb, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %b)
    %x = load i16, ptr %p, align 2, !tbaa !8
    %q = load ptr, ptr %pp, align 8, !tbaa !10
    %y = load i16, ptr %q, align 2, !tbaa !8
    %s = add i16 %x, %y
    %r = zext i16 %s to i32
    ret i32 %r
  }

  ; A pointer returned by a call cannot point to an alloca that does not escape.
  define i32 @call_result(i64 %i) {
    %a = alloca [16 x i32], align 4
    %b = alloca [16 x i32], align 4
    call void @llvm.lifetime.start.p0(ptr %a)
    %pa = getelementptr [4 x i8], ptr %a, i64 %i
    store i32 1, ptr %pa, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %a)
    call void @llvm.lifetime.start.p0(ptr %b)
    %pb = getelementptr [4 x i8], ptr %b, i64 %i
    store i32 2, ptr %pb, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %b)
    %q = call ptr @get()
    %y = load i16, ptr %q, align 2, !tbaa !8
    %r = zext i16 %y to i32
    ret i32 %r
  }

  ; %cur is based only on %p, through phis that AA does not look through.
  define i32 @phi(ptr %p, i64 %i, i1 %c) {
  entry:
    %a = alloca [16 x i32], align 4
    %b = alloca [16 x i32], align 4
    call void @llvm.lifetime.start.p0(ptr %a)
    %pa = getelementptr [4 x i8], ptr %a, i64 %i
    store i32 1, ptr %pa, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %a)
    call void @llvm.lifetime.start.p0(ptr %b)
    %pb = getelementptr [4 x i8], ptr %b, i64 %i
    store i32 2, ptr %pb, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %b)
    br label %loop

  loop:
    %cur = phi ptr [ %p, %entry ], [ %next, %latch ]
    %x = load i16, ptr %cur, align 2, !tbaa !8
    %r = zext i16 %x to i32
    %z = icmp eq i16 %x, 0
    br i1 %z, label %skip, label %latch

  skip:
    %g = getelementptr i8, ptr %cur, i64 2
    br label %latch

  latch:
    %next = phi ptr [ %cur, %loop ], [ %g, %skip ]
    br i1 %c, label %loop, label %exit

  exit:
    ret i32 %r
  }

  ; The lookup of underlying objects gives up within this chain of GEPs, which
  ; still points into the shared slot.
  define i32 @deep(i64 %i) {
    %a = alloca [16 x i32], align 4
    %b = alloca [16 x i32], align 4
    call void @llvm.lifetime.start.p0(ptr %a)
    %pa = getelementptr [4 x i8], ptr %a, i64 %i
    store i32 1, ptr %pa, align 4, !tbaa !5
    call void @llvm.lifetime.end.p0(ptr %a)
    call void @llvm.lifetime.start.p0(ptr %b)
    %pb = getelementptr [4 x i8], ptr %b, i64 %i
    store i32 2, ptr %pb, align 4, !tbaa !5
    %g1 = getelementptr i8, ptr %b, i64 %i
    %g2 = getelementptr i8, ptr %g1, i64 %i
    %g3 = getelementptr i8, ptr %g2, i64 %i
    %g4 = getelementptr i8, ptr %g3, i64 %i
    %g5 = getelementptr i8, ptr %g4, i64 %i
    %g6 = getelementptr i8, ptr %g5, i64 %i
    %g7 = getelementptr i8, ptr %g6, i64 %i
    %g8 = getelementptr i8, ptr %g7, i64 %i
    %g9 = getelementptr i8, ptr %g8, i64 %i
    %g10 = getelementptr i8, ptr %g9, i64 %i
    %g11 = getelementptr i8, ptr %g10, i64 %i
    %g12 = getelementptr i8, ptr %g11, i64 %i
    %x = load i16, ptr %g12, align 2, !tbaa !8
    call void @llvm.lifetime.end.p0(ptr %b)
    %r = zext i16 %x to i32
    ret i32 %r
  }

  declare ptr @get()
  declare void @llvm.lifetime.start.p0(ptr captures(none))
  declare void @llvm.lifetime.end.p0(ptr captures(none))

  !llvm.module.flags = !{!0}
  !llvm.ident = !{!1}

  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{!"clang version 9.0.0"}
  !2 = !{!3, !3, i64 0}
  !3 = !{!"omnipotent char", !4, i64 0}
  !4 = !{!"Simple C++ TBAA"}
  !5 = !{!6, !6, i64 0}
  !6 = !{!"int", !7, i64 0}
  !7 = !{!"Simple C TBAA"}
  !8 = !{!9, !9, i64 0}
  !9 = !{!"short", !7, i64 0}
  !10 = !{!11, !11, i64 0}
  !11 = !{!"any pointer", !7, i64 0}

...
---
name:            main
alignment:       16
tracksRegLiveness: true
stack:
  - { id: 0, name: padding, type: default, offset: 0, size: 24, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: agg, type: default, offset: 0, size: 48, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0:
    ; CHECK-LABEL: name: main
    ; CHECK: [[LEA64r:%[0-9]+]]:gr64 = nuw LEA64r %stack.1.agg, 1, $noreg, 24, $noreg
    ; CHECK-NEXT: CMP8mi %stack.1.agg, 1, $noreg, 47, $noreg, 0, implicit-def $eflags :: (dereferenceable load (s8) from %ir.a22, !tbaa !2)
    ; CHECK-NEXT: [[CMOV64rm:%[0-9]+]]:gr64 = CMOV64rm [[LEA64r]], %stack.1.agg, 1, $noreg, 24, $noreg, 8, implicit $eflags :: (dereferenceable load (s64) from %ir.a2)
    ; CHECK-NEXT: [[MOV8rm:%[0-9]+]]:gr8 = MOV8rm killed [[CMOV64rm]], 1, $noreg, 16, $noreg :: (load (s8) from %ir.add.ptr.i, !tbaa !2)
    ; CHECK-NEXT: $al = COPY [[MOV8rm]]
    ; CHECK-NEXT: RET 0, $al
    LIFETIME_START %stack.0.padding
    LIFETIME_START %stack.1.agg
    %8:gr64 = nuw LEA64r %stack.1.agg, 1, $noreg, 24, $noreg
    CMP8mi %stack.1.agg, 1, $noreg, 47, $noreg, 0, implicit-def $eflags :: (dereferenceable load (s8) from %ir.a22, !tbaa !2)
    %13:gr64 = CMOV64rm %8, %stack.1.agg, 1, $noreg, 24, $noreg, 8, implicit $eflags :: (dereferenceable load (s64) from %ir.a2)
    %14:gr8 = MOV8rm killed %13, 1, $noreg, 16, $noreg :: (load (s8) from %ir.add.ptr.i, !tbaa !2)
    $al = COPY %14
    RET 0, $al

...
