# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -run-pass=register-coalescer -verify-coalescing -o - %s | FileCheck %s

# A sub-register def without the undef flag implicitly reads the full
# register to preserve the remaining lanes.  When removeCopyByCommutingDef
# commutes the OR to remove a COPY, it must not erase the value that such an
# implicit read depends on; doing so used to crash in JoinVals::analyzeValue.
# https://github.com/llvm/llvm-project/issues/220302
---
name:            f6
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 4294967295
body:             |
  ; CHECK-LABEL: name: f6
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $rdi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   undef [[MOV32r0_:%[0-9]+]].sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   [[MOV64ri:%[0-9]+]]:gr64 = MOV64ri 204983918657971834
  ; CHECK-NEXT:   undef [[MOV32r0_1:%[0-9]+]].sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[MOV32r0_2:%[0-9]+]].sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.6(0x3efbefbf), %bb.3(0x41041041)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   dead $edi = MOV32r0 implicit-def dead $eflags, implicit-def $rdi
  ; CHECK-NEXT:   $rsi = COPY [[MOV32r0_1]]
  ; CHECK-NEXT:   CALL64r [[MOV32r0_]], csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit-def $rsp, implicit-def $ssp, implicit-def dead $rax
  ; CHECK-NEXT:   ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   CMP64ri32 [[COPY1]], 3, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.6, 4, implicit killed $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.5(0x04000000), %bb.2(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32r0_1:%[0-9]+]]:gr64_with_sub_8bit = MOV32ri64 1
  ; CHECK-NEXT:   CMP64rr [[COPY1]], [[MOV64ri]], implicit-def $eflags
  ; CHECK-NEXT:   undef [[MOV32r0_2:%[0-9]+]].sub_32bit:gr64_with_sub_8bit = MOV32ri 0
  ; CHECK-NEXT:   JCC_1 %bb.5, 4, implicit killed $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32r0_2:%[0-9]+]].sub_8bit:gr64_with_sub_8bit = MOV8rm $noreg, 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   [[MOV32r0_1:%[0-9]+]]:gr64_with_sub_8bit = COPY [[MOV32r0_2]]
  ; CHECK-NEXT:   [[MOV32r0_2:%[0-9]+]]:gr64_with_sub_8bit = MOV32ri64 1
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   $rax = COPY [[MOV32r0_1]]
  ; CHECK-NEXT:   RET 0, killed $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.8(0x7c000000), %bb.7(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32r0_1:%[0-9]+]]:gr64_with_sub_8bit = MOV64rm $noreg, 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   TEST8ri [[COPY]].sub_8bit, 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.8, 5, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.8:
  ; CHECK-NEXT:   successors: %bb.4(0x7c000000), %bb.9(0x04000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32r0_2:%[0-9]+]]:gr64_with_sub_8bit = OR64rr [[MOV32r0_2]], [[MOV32r0_1]], implicit-def dead $eflags
  ; CHECK-NEXT:   TEST8ri [[COPY]].sub_8bit, 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 5, implicit killed $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.9:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32r0_1:%[0-9]+]]:gr64_with_sub_8bit = COPY [[MOV32r0_2]]
  ; CHECK-NEXT:   JMP_1 %bb.5
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $rdi, $esi

    %0:gr32 = COPY killed $esi
    %1:gr64 = COPY killed $rdi
    %2:gr8 = COPY killed %0.sub_8bit
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    %4:gr64 = SUBREG_TO_REG %3, %subreg.sub_32bit
    %5:gr64 = MOV64ri 204983918657971834
    %6:gr64 = COPY killed %4

  bb.1:
    successors: %bb.2(0x80000000)

    %7:gr64 = COPY killed %6
    %8:gr64 = SUBREG_TO_REG %3, %subreg.sub_32bit
    %9:gr64 = COPY killed %7
    %10:gr64 = COPY killed %8

  bb.2:
    successors: %bb.6(0x3efbefbf), %bb.3(0x41041041)

    %11:gr64 = COPY killed %10
    %12:gr64 = COPY killed %9
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %13:gr64 = SUBREG_TO_REG %3, %subreg.sub_32bit
    $rdi = COPY %13
    $rsi = COPY killed %12
    CALL64r %13, csr_64, implicit $rsp, implicit $ssp, implicit killed $rdi, implicit killed $rsi, implicit-def $rsp, implicit-def $ssp, implicit-def dead $rax
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    CMP64ri32 %1, 3, implicit-def $eflags
    JCC_1 %bb.6, 4, implicit killed $eflags
    JMP_1 %bb.3

  bb.3:
    successors: %bb.5(0x04000000), %bb.2(0x7c000000)

    %14:gr64 = MOV32ri64 1
    CMP64rr %1, %5, implicit-def $eflags
    %9:gr64 = COPY %14
    %10:gr64 = COPY killed %13
    %15:gr64 = COPY killed %14
    JCC_1 %bb.5, 4, implicit killed $eflags
    JMP_1 %bb.2

  bb.4:
    successors: %bb.2(0x80000000)

    %16:gr8 = MOV8rm $noreg, 1, $noreg, 0, $noreg
    %17:gr64_with_sub_8bit = COPY killed %18
    %17.sub_8bit:gr64_with_sub_8bit = COPY killed %16
    %19:gr64 = MOV32ri64 1
    %20:gr64 = COPY killed %17
    %9:gr64 = COPY killed %20
    %10:gr64 = COPY killed %19
    JMP_1 %bb.2

  bb.5:
    %21:gr64 = COPY killed %15
    $rax = COPY killed %21
    RET 0, killed $rax

  bb.6:
    successors: %bb.7(0x7c000000), %bb.8(0x04000000)

    %22:gr64 = MOV64rm $noreg, 1, $noreg, 0, $noreg
    TEST8ri %2, 1, implicit-def $eflags
    JCC_1 %bb.7, 5, implicit killed $eflags

  bb.8:
    successors: %bb.1(0x80000000)

    %6:gr64 = COPY killed %22
    JMP_1 %bb.1

  bb.7:
    successors: %bb.4(0x7c000000), %bb.9(0x04000000)

    %18:gr64 = COPY killed %11
    %18:gr64 = OR64rr %18, killed %22, implicit-def dead $eflags
    TEST8ri %2, 1, implicit-def $eflags
    JCC_1 %bb.4, 5, implicit killed $eflags

  bb.9:
    successors: %bb.5(0x80000000)

    %15:gr64 = COPY killed %18
    JMP_1 %bb.5
...
