# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "DBG_PHI|COPY \$rdi|COPY \$rbp| = LEA64r | = XOR64rr " --version 6
# RUN: llc -mtriple=x86_64 -run-pass=liveintervals,two-address-instruction -o - %s | FileCheck %s

# A DBG_PHI on the physical register copied into %1 must not change which
# operand of the XOR is selected for the tied two-address use.
---
name: without_debug
tracksRegLiveness: true
debugInstrRef: true
frameInfo:
  isFrameAddressTaken: true
  framePointerPolicy: all
body: |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: without_debug
    ; CHECK: [[COPY:%[0-9]+]]:gr64_nosp = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rbp
    ; CHECK-NEXT: [[LEA64r:%[0-9]+]]:gr64 = LEA64r [[COPY]], 2, [[COPY]], 0, $noreg
    ; CHECK: [[COPY2:%[0-9]+]]:gr64 = XOR64rr [[COPY2]], [[LEA64r]], implicit-def dead $eflags
    %0:gr64_nosp = COPY $rdi
    %1:gr64 = COPY $rbp
    %2:gr64 = LEA64r %0, 2, %0, 0, $noreg
    %3:gr64 = XOR64rr %2, %1, implicit-def dead $eflags
    %4:gr64 = nsw IMUL64rr %3, %2, implicit-def dead $eflags
    $rax = COPY %4
    RET 0, $rax
...
---
name: with_debug
tracksRegLiveness: true
debugInstrRef: true
frameInfo:
  isFrameAddressTaken: true
  framePointerPolicy: all
body: |
  bb.0:
    liveins: $rdi

    ; CHECK-LABEL: name: with_debug
    ; CHECK: DBG_PHI $rbp, 2
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64_nosp = COPY $rdi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rbp
    ; CHECK-NEXT: [[LEA64r:%[0-9]+]]:gr64 = LEA64r [[COPY]], 2, [[COPY]], 0, $noreg
    ; CHECK: [[COPY2:%[0-9]+]]:gr64 = XOR64rr [[COPY2]], [[LEA64r]], implicit-def dead $eflags
    DBG_PHI $rbp, 2
    %0:gr64_nosp = COPY $rdi
    %1:gr64 = COPY $rbp
    %2:gr64 = LEA64r %0, 2, %0, 0, $noreg
    %3:gr64 = XOR64rr %2, %1, implicit-def dead $eflags
    %4:gr64 = nsw IMUL64rr %3, %2, implicit-def dead $eflags
    $rax = COPY %4
    RET 0, $rax
...
