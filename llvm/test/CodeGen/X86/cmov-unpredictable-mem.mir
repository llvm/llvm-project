# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64 -start-before=x86-isel -stop-after=x86-cmov-conversion %s -o - | FileCheck %s

# A select marked !unpredictable should stay a CMOV even when the CMOV folds a
# load: X86CmovConversion leaves CMOVs carrying the unpredictable flag alone.
# The machine functions have no body: instruction selection runs on the
# embedded IR and the checks are the MIR after X86CmovConversion.

--- |
  define i32 @load_or_zero(i32 %a, ptr %p) {
    %v = load i32, ptr %p, align 4
    %c = icmp eq i32 %a, 0
    %r = select i1 %c, i32 0, i32 %v, !unpredictable !0
    ret i32 %r
  }

  ; Without the hint the memory-operand CMOV is turned into a branch.
  define i32 @load_or_zero_nohint(i32 %a, ptr %p) {
    %v = load i32, ptr %p, align 4
    %c = icmp eq i32 %a, 0
    %r = select i1 %c, i32 0, i32 %v
    ret i32 %r
  }

  !0 = !{}
...
---
name: load_or_zero
body: |
  ; CHECK-LABEL: name: load_or_zero
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $edi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rsi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   TEST32rr [[COPY1]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   [[CMOV32rm:%[0-9]+]]:gr32 = unpredictable CMOV32rm [[COPY1]], [[COPY]], 1, $noreg, 0, $noreg, 5, implicit $eflags :: (load (s32) from %ir.p)
  ; CHECK-NEXT:   $eax = COPY [[CMOV32rm]]
  ; CHECK-NEXT:   RET 0, $eax
...
---
name: load_or_zero_nohint
body: |
  ; CHECK-LABEL: name: load_or_zero_nohint
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rsi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   TEST32rr [[COPY1]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32rm:%[0-9]+]]:gr32 = MOV32rm [[COPY]], 1, $noreg, 0, $noreg :: (load (s32) from %ir.p)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (%ir-block.0):
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr32 = PHI [[MOV32rm]], %bb.1, [[COPY1]], %bb.0
  ; CHECK-NEXT:   $eax = COPY [[PHI]]
  ; CHECK-NEXT:   RET 0, $eax
...
