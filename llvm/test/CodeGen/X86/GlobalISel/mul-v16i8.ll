; CHECK-NEXT:    movsbl -{{[0-9]+}}(%rsp), %eax
; CHECK-NEXT:    imulb -{{[0-9]+}}(%rsp)
; CHECK-NEXT:    leaq -{{[0-9]+}}(%rsp), %rcx
