; CHECK-NEXT:    movsbl 1(%rcx), %eax
; CHECK-NEXT:    imulb 1(%rdx)
; CHECK-NEXT:    leaq -{{[0-9]+}}(%rsp), %rsi
; CHECK-NEXT:    movb %al, 1(%rsi)
; CHECK-NEXT:    movsbl 2(%rcx), %eax
; CHECK-NEXT:    imulb 2(%rdx)
