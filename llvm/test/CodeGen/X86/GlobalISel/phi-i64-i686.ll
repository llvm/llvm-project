; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=i686-unknown-linux-gnu -global-isel -O0 < %s | FileCheck %s

; Multi-block i64 PHI must be narrowed to a pair of i32 PHIs on i386 GlobalISel.
; Previously this failed selection of G_UNMERGE_VALUES from an s64 GPR (#216648).

define i64 @plain_phi_i64(i64 %x, i64 %y, i1 %c) {
; CHECK-LABEL: plain_phi_i64:
; CHECK:       # %bb.1:
; CHECK:         testb
; CHECK:       # %bb.4:
; CHECK:         movl
; CHECK:         movl
; CHECK:         retl
entry:
  br i1 %c, label %a, label %b
a:
  br label %tail
b:
  br label %tail
tail:
  %r = phi i64 [ %x, %a ], [ %y, %b ]
  ret i64 %r
}

define i64 @or_xor_loop(i64 %x, i64 %y, i32 %n) {
; CHECK-LABEL: or_xor_loop:
; CHECK:       # %bb.
; CHECK:         retl
entry:
  br label %loop
loop:
  %acc = phi i64 [ 0, %entry ], [ %next, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %o = or i64 %acc, %x
  %next = xor i64 %o, %y
  %i.next = add i32 %i, 1
  %cond = icmp slt i32 %i.next, %n
  br i1 %cond, label %loop, label %exit
exit:
  ret i64 %next
}
