# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 2
# RUN: llc -mtriple=x86_64-linux-gnu -mattr=+popcnt -run-pass=legalizer -global-isel-abort=2 -pass-remarks-missed='gisel*' %s 2>%t -o - | FileCheck %s
# RUN: FileCheck -check-prefix=ERR %s < %t
# RUN: llc -mtriple=x86_64-linux-gnu -mattr=+popcnt,+avx512f,+avx512vl,+avx512vpopcntdq -run-pass=legalizer %s -o - | FileCheck %s
