# ERR-NEXT: remark: <unknown>:0:0: unable to legalize instruction: %1:_(<8 x s32>) = G_CTPOP %0:_(<8 x s32>) (in function: test_ctpop_v8i32)
# ERR-NEXT: remark: <unknown>:0:0: unable to legalize instruction: %1:_(<4 x s64>) = G_CTPOP %0:_(<4 x s64>) (in function: test_ctpop_v4i64)

# test popcount for s16, s32, and s64

---
name:            test_ctpop35
alignment:       16
legalized:       false
regBankSelected: false
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_ctpop35
    ; CHECK: [[DEF:%[0-9]+]]:_(s35) = IMPLICIT_DEF
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(s64) = G_ZEXT [[DEF]](s35)
    ; CHECK-NEXT: [[CTPOP:%[0-9]+]]:_(s64) = G_CTPOP [[ZEXT]](s64)
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s64) = COPY [[CTPOP]](s64)
    ; CHECK-NEXT: RET 0, implicit [[COPY]](s64)
    %0:_(s35) = IMPLICIT_DEF
    %1:_(s35) = G_CTPOP %0
    %2:_(s64) = G_ZEXT %1
    %3:_(s64) = COPY %2(s64)
    RET 0, implicit %3

...
