# Vector popcount has no generic lowering on X86, so it must be diagnosed as
# unsupported (see the ERR checks) instead of crashing the legalizer.  With
# AVX512VPOPCNTDQ and AVX512VL the 128-bit and 256-bit forms are legal, and the
# last RUN line above must complete without an error.
---
name:            test_ctpop_v4i32
alignment:       16
legalized:       false
regBankSelected: false
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_ctpop_v4i32
    ; CHECK: [[DEF:%[0-9]+]]:_(<4 x s32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[CTPOP:%[0-9]+]]:_(<4 x s32>) = G_CTPOP [[DEF]](<4 x s32>)
    ; CHECK-NEXT: $xmm0 = COPY [[CTPOP]](<4 x s32>)
    ; CHECK-NEXT: RET 0, implicit $xmm0
    %0:_(<4 x s32>) = G_IMPLICIT_DEF
    %1:_(<4 x s32>) = G_CTPOP %0
    $xmm0 = COPY %1(<4 x s32>)
    RET 0, implicit $xmm0

...
