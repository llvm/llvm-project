# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -debugify-and-strip-all-safe -run-pass=x86-slh %s -o - | FileCheck %s

# A debug use of the loaded value must not stop the hardening from being sunk
# to the single user of the load.

--- |
  define i32 @slh_sink_debug_use() speculative_load_hardening {
    ret i32 0
  }
...
---
name:            slh_sink_debug_use
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi, $ecx

    ; CHECK-LABEL: name: slh_sink_debug_use
    ; CHECK: liveins: $rdi, $ecx
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[MOV64ri32_:%[0-9]+]]:gr64_nosp = MOV64ri32 -1
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr64_nosp = COPY $rsp
    ; CHECK-NEXT: [[SAR64ri:%[0-9]+]]:gr64_nosp = SAR64ri [[COPY]], 63, implicit-def dead $eflags
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rdi
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr32 = COPY $ecx
    ; CHECK-NEXT: [[MOV32rm:%[0-9]+]]:gr32 = MOV32rm [[COPY1]], 1, $noreg, 0, $noreg :: (load (s32))
    ; CHECK-NEXT: $ecx = COPY [[COPY2]]
    ; CHECK-NEXT: [[SHL32rCL:%[0-9]+]]:gr32 = SHL32rCL [[MOV32rm]], implicit-def dead $eflags, implicit $cl
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gr32 = COPY [[SAR64ri]].sub_32bit
    ; CHECK-NEXT: [[OR32rr:%[0-9]+]]:gr32 = OR32rr [[COPY3]], [[SHL32rCL]], implicit-def dead $eflags
    ; CHECK-NEXT: $eax = COPY [[OR32rr]]
    ; CHECK-NEXT: [[SHL64ri:%[0-9]+]]:gr64_nosp = SHL64ri [[SAR64ri]], 47, implicit-def dead $eflags
    ; CHECK-NEXT: $rsp = OR64rr $rsp, [[SHL64ri]], implicit-def dead $eflags
    ; CHECK-NEXT: RET 0, $eax
    %0:gr64 = COPY $rdi
    %1:gr32 = COPY $ecx
    %2:gr32 = MOV32rm %0, 1, $noreg, 0, $noreg :: (load (s32))
    $ecx = COPY %1
    %3:gr32 = SHL32rCL %2, implicit-def dead $eflags, implicit $cl
    $eax = COPY %3
    RET 0, $eax
...
