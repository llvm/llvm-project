  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8
    ; CHECK-LABEL: name: tied_and_untied_live_after
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8
    ; CHECK-NEXT: {{  $}}
