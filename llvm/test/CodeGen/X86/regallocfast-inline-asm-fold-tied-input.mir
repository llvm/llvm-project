# Six other inputs leave no register for the shared one. Folding only the def
# or only the untied read frees nothing, since the other then needs the value
# in a register, so both are folded.
#
#   long tied_and_untied_pressure(long v, long a, long b, long c, long d,
#                                 long e, long f) {
#     long r;
#     asm volatile("" : "=rm"(r) : "rm"(v), "r"(a), "r"(b), "r"(c), "r"(d),
#                                  "r"(e), "r"(f), "0"(v) : CLOBBERS);
#     return r;
#   }
name: tied_and_untied_pressure
tracksRegLiveness: true
fixedStack:
  - { id: 0, size: 8, alignment: 16, isImmutable: true }
body: |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-LABEL: name: tied_and_untied_pressure
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $rax = COPY killed $rdi
    ; CHECK-NEXT: MOV64mr %stack.1, 1, $noreg, 0, $noreg, renamable $rax :: (store (s64) into %stack.1)
    ; CHECK-NEXT: renamable $rdi = MOV64rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.0, align 16)
    ; CHECK-NEXT: MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed renamable $rax :: (store (s64) into %stack.0)
    ; CHECK-NEXT: INLINEASM &"", sideeffect mayload maystore attdialect, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, mem:m ops:5, %stack.1, 1, $noreg, 0, $noreg, reguse:GR64, killed renamable $rsi, reguse:GR64, killed renamable $rdx, reguse:GR64, killed renamable $rcx, reguse:GR64, killed renamable $r8, reguse:GR64, killed renamable $r9, reguse:GR64, killed renamable $rdi, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, clobber, implicit-def dead early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15 :: (load store (s64) on %stack.0), (load (s64) from %stack.1)
    ; CHECK-NEXT: renamable $rax = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
