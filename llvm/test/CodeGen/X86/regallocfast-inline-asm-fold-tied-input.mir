#   long tied_and_untied_live_after(long v, long a, long b, long c, long d) {
#     long r;
#     asm volatile("" : "=rm"(r) : "r"(v), "r"(a), "r"(b), "r"(c), "r"(d),
#                                  "0"(v) : CLOBBERS);
#     return r + v;
#   }
