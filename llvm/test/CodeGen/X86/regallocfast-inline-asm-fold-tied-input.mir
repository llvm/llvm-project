    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, regdef:GR64 foldable, def renamable $rdi, regdef:GR64 foldable, def renamable $rdx, reguse:GR64, killed renamable $rsi, reguse:GR64, killed renamable $rcx, reguse:GR64, killed renamable $r8, reguse:GR64, killed renamable $r9, reguse tiedto:$0, killed renamable $rdi(tied-def 3), reguse tiedto:$1, renamable $rdx(tied-def 5), clobber, implicit-def early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15
