# A foldable def whose tied input is read through a subregister: the slot
# would need the whole input, so the def stays in a register, and "rm"
# inputs are folded instead. ISel copies a tied input to a register of the
# def's class, so only MIR reads one through a subregister.
#
#   asm volatile("" : "=rm"(i) : "r"(a), "r"(b), "r"(c), "rm"(d), "rm"(e),
#                     "rm"(f), "0"((int)l) : CLOBBERS);
name: tied_subreg_input
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-LABEL: name: tied_subreg_input
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: MOV64mr %stack.3, 1, $noreg, 0, $noreg, $rcx :: (store (s64) into %stack.3)
