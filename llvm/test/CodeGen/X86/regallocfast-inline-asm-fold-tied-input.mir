# A foldable def that is also the tied input of another def: folding it
# would need its slot to hold both its old value, for the "1" input, and the
# "0" input's value. So it stays in a register and gets the "0" input, the
# "=r" def gets its old value, and "rm" inputs are folded instead. ISel never
# emits this, since a def is a new SSA value, so the MIR redefines %0 by hand.
#
#   asm volatile("" : "=rm"(a), "=r"(b) : "r"(c), "r"(d), "rm"(e), "rm"(f),
#                     "rm"(g), "0"(y), "1"(a) : CLOBBERS);
name: tied_def_also_tied_input
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-LABEL: name: tied_def_also_tied_input
    ; CHECK: liveins: $rdi, $rsi, $rdx, $rcx, $r8, $r9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: MOV64mr %stack.1, 1, $noreg, 0, $noreg, $rdi :: (store (s64) into %stack.1)
    ; CHECK-NEXT: renamable $rdi = COPY $rcx
    ; CHECK-NEXT: $rcx = MOV64rm %stack.1, 1, $noreg, 0, $noreg :: (load (s64) from %stack.1)
    ; CHECK-NEXT: MOV64mr %stack.0, 1, $noreg, 0, $noreg, killed renamable $r8 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: renamable $r8 = MOV64ri 42
    ; CHECK-NEXT: INLINEASM &"", sideeffect mayload attdialect, regdef:GR64 foldable, def renamable $rsi, regdef:GR64, def renamable $rcx, reguse:GR64, killed renamable $rdx, reguse:GR64, killed renamable $rdi, mem:m ops:5, %stack.0, 1, $noreg, 0, $noreg, reguse:GR64 foldable, killed renamable $r9, reguse:GR64 foldable, killed renamable $r8, reguse tiedto:$0, killed renamable $rsi(tied-def 3), reguse tiedto:$1, renamable $rcx(tied-def 5), clobber, implicit-def early-clobber $rax, clobber, implicit-def dead early-clobber $rbx, clobber, implicit-def dead early-clobber $rbp, clobber, implicit-def dead early-clobber $r10, clobber, implicit-def dead early-clobber $r11, clobber, implicit-def dead early-clobber $r12, clobber, implicit-def dead early-clobber $r13, clobber, implicit-def dead early-clobber $r14, clobber, implicit-def dead early-clobber $r15 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: MOV64mr %stack.1, 1, $noreg, 0, $noreg, $rsi :: (store (s64) into %stack.1)
    ; CHECK-NEXT: $rax = MOV64rm %stack.1, 1, $noreg, 0, $noreg :: (load (s64) from %stack.1)
    ; CHECK-NEXT: renamable $rax = ADD64rr killed renamable $rax, killed renamable $rcx, implicit-def dead $eflags
    ; CHECK-NEXT: RET 0, killed $rax
    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr64 = COPY $rdx
    %3:gr64 = COPY $rcx
    %4:gr64 = COPY $r8
    %5:gr64 = COPY $r9
    %6:gr64 = MOV64ri 42
    INLINEASM &"", sideeffect attdialect, regdef:GR64 foldable, def %0:gr64, regdef:GR64, def %7:gr64, reguse:GR64, %2, reguse:GR64, %3, reguse:GR64 foldable, %4, reguse:GR64 foldable, %5, reguse:GR64 foldable, %6, reguse tiedto:$0, %1(tied-def 3), reguse tiedto:$1, %0(tied-def 5), clobber, implicit-def early-clobber $rax, clobber, implicit-def early-clobber $rbx, clobber, implicit-def early-clobber $rbp, clobber, implicit-def early-clobber $r10, clobber, implicit-def early-clobber $r11, clobber, implicit-def early-clobber $r12, clobber, implicit-def early-clobber $r13, clobber, implicit-def early-clobber $r14, clobber, implicit-def early-clobber $r15
    %8:gr64 = ADD64rr %0, %7, implicit-def dead $eflags
    $rax = COPY %8
    RET 0, $rax
...
