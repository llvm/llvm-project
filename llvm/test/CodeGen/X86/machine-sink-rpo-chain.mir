  ; CHECK-NEXT:   JCC_1 %bb.10, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.10(0x40000000), %bb.2(0x40000000)
