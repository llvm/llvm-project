# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-- -run-pass=machine-sink -verify-machineinstrs -o - %s | FileCheck %s

# Test that MachineSinking traverses blocks in reverse post-order (sinking down
# out-of-layout-order forward chains in a single sweep) and fast-forwards
# side-effect-free single-def instructions down deep acyclic dominator chains
# while respecting physical-register live-ins on dead defs.

---
name:            sink_out_of_layout_order
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: sink_out_of_layout_order
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[ADD32ri:%[0-9]+]]:gr32 = ADD32ri [[COPY]], 7, implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[ADD32ri]]
  ; CHECK-NEXT:   RET 0, $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32rr [[COPY1]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY]], 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[MOV32r0_]]
  ; CHECK-NEXT:   RET 0, $eax
  bb.0:
    successors: %bb.4, %bb.3
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %2:gr32 = COPY $esi
    %1:gr32 = ADD32ri %0, 7, implicit-def dead $eflags
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.3

  bb.1:
    $eax = COPY %1
    RET 0, $eax

  bb.2:
    successors: %bb.4, %bb.1
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.1

  bb.3:
    successors: %bb.4, %bb.2
    TEST32ri %0, 1, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.2

  bb.4:
    %3:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %3
    RET 0, $eax
...
---
name:            sink_deep_dominator_chain
alignment:       16
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: sink_deep_dominator_chain
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.6(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 1, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.7(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 4, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.8(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 16, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.9(0x40000000)
  ; CHECK-NEXT:   liveins: $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.10(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 128, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   [[LEA64r:%[0-9]+]]:gr64 = LEA64r [[COPY]], 1, $noreg, 64, $noreg
  ; CHECK-NEXT:   [[SUBREG_TO_REG:%[0-9]+]]:gr64_nosp = SUBREG_TO_REG %3, %subreg.sub_32bit
  ; CHECK-NEXT:   [[LEA64r1:%[0-9]+]]:gr64 = LEA64r [[LEA64r]], 1, [[SUBREG_TO_REG]], 0, $noreg
  ; CHECK-NEXT:   $rax = COPY [[LEA64r1]]
  ; CHECK-NEXT:   RET 0, $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 2, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 8, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.8:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32ri:%[0-9]+]]:gr32 = ADD32ri [[COPY1]], 42, implicit-def dead $eflags
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 32, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.9:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 64, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.10:
  ; CHECK-NEXT:   successors: %bb.11(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY1]], 256, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.11, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.11:
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[MOV32r0_]]
  ; CHECK-NEXT:   RET 0, $eax
  bb.0:
    successors: %bb.11, %bb.6
    liveins: $rdi, $esi
    %0:gr64 = COPY $rdi
    %1:gr32 = COPY $esi
    %2:gr64 = LEA64r %0, 1, $noreg, 64, $noreg
    %3:gr32 = ADD32ri %1, 42, implicit-def dead $eflags
    TEST32ri %1, 1, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.6

  bb.1:
    successors: %bb.11, %bb.7
    TEST32ri %1, 4, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.7

  bb.2:
    successors: %bb.11, %bb.8
    TEST32ri %1, 16, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.8

  bb.3:
    successors: %bb.11, %bb.9
    liveins: $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.9

  bb.4:
    successors: %bb.11, %bb.10
    TEST32ri %1, 128, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.10

  bb.5:
    %4:gr64_nosp = SUBREG_TO_REG %3, %subreg.sub_32bit
    %5:gr64 = LEA64r %2, 1, %4, 0, $noreg
    $rax = COPY %5
    RET 0, $rax

  bb.6:
    successors: %bb.11, %bb.1
    TEST32ri %1, 2, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.1

  bb.7:
    successors: %bb.11, %bb.2
    TEST32ri %1, 8, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.2

  bb.8:
    successors: %bb.11, %bb.3
    TEST32ri %1, 32, implicit-def $eflags
    JCC_1 %bb.11, 5, implicit $eflags
    JMP_1 %bb.3

  bb.9:
    successors: %bb.11, %bb.4
    TEST32ri %1, 64, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.4

  bb.10:
    successors: %bb.11, %bb.5
    TEST32ri %1, 256, implicit-def $eflags
    JCC_1 %bb.11, 4, implicit $eflags
    JMP_1 %bb.5

  bb.11:
    %6:gr32 = MOV32r0 implicit-def dead $eflags
    $eax = COPY %6
    RET 0, $eax
...
