  ; CHECK-NEXT:   TEST32ri [[COPY]], 256, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.10, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.9
