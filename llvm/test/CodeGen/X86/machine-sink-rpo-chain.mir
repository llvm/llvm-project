  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY]], 8, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.10, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.10(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY]], 16, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.10, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.10(0x40000000), %bb.6(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32ri [[COPY]], 32, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.10, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.10(0x40000000), %bb.7(0x40000000)
