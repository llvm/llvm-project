;; We're just confirming that we don't crash when scalarizing the <1 x ty>
;; result vectors.

define bfloat @test_prdx_fmla(<1 x bfloat> %acc, <1 x bfloat> %in) {
; SSE-LABEL: test_prdx_fmla:
; SSE:       # %bb.0:
; SSE-NEXT:    pslld $16, %xmm1
; SSE-NEXT:    pslld $16, %xmm0
; SSE-NEXT:    addss %xmm1, %xmm0
; SSE-NEXT:    movd %xmm0, %eax
; SSE-NEXT:    btl $16, %eax
; SSE-NEXT:    movl %eax, %ecx
; SSE-NEXT:    adcl $32767, %ecx # imm = 0x7FFF
; SSE-NEXT:    orl $4194304, %eax # imm = 0x400000
; SSE-NEXT:    ucomiss %xmm0, %xmm0
; SSE-NEXT:    cmovnpl %ecx, %eax
; SSE-NEXT:    shrl $16, %eax
; SSE-NEXT:    movd %eax, %xmm0
; SSE-NEXT:    retq
;
; AVX-LABEL: test_prdx_fmla:
; AVX:       # %bb.0:
; AVX-NEXT:    vpslld $16, %xmm1, %xmm1
; AVX-NEXT:    vpslld $16, %xmm0, %xmm0
; AVX-NEXT:    vaddss %xmm1, %xmm0, %xmm0
; AVX-NEXT:    vmovd %xmm0, %eax
; AVX-NEXT:    btl $16, %eax
; AVX-NEXT:    movl %eax, %ecx
; AVX-NEXT:    adcl $32767, %ecx # imm = 0x7FFF
; AVX-NEXT:    orl $4194304, %eax # imm = 0x400000
; AVX-NEXT:    vucomiss %xmm0, %xmm0
; AVX-NEXT:    cmovnpl %ecx, %eax
; AVX-NEXT:    shrl $16, %eax
; AVX-NEXT:    vmovd %eax, %xmm0
; AVX-NEXT:    retq
  %prdx = call <1 x bfloat> @llvm.vector.partial.reduce.fadd(<1 x bfloat> %acc, <1 x bfloat> %in)
  %res = extractelement <1 x bfloat> %prdx, i32 0
  ret bfloat %res
}

define i32 @test_prdx_mla(<1 x i32> %acc, <1 x i32> %in) {
; CHECK-LABEL: test_prdx_mla:
