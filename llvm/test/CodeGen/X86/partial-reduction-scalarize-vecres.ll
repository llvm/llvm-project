; AVX-NEXT:    shrl $16, %eax
; AVX-NEXT:    vmovd %eax, %xmm0
; AVX-NEXT:    retq
  %prdx = call <1 x bfloat> @llvm.vector.partial.reduce.fadd(<1 x bfloat> %acc, <1 x bfloat> %in)
  %res = extractelement <1 x bfloat> %prdx, i32 0
  ret bfloat %res
}

