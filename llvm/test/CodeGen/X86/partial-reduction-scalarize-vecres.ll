; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s | FileCheck %s

target triple = "x86_64-unknown-linux-gnu"

;; We're just confirming that we don't crash when scalarizing the <1 x ty>
;; result vectors.

define bfloat @test_prdx_fmla(<1 x bfloat> %acc, <1 x bfloat> %in) {
; CHECK-LABEL: test_prdx_fmla:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pslld $16, %xmm1
; CHECK-NEXT:    pslld $16, %xmm0
; CHECK-NEXT:    addss %xmm1, %xmm0
; CHECK-NEXT:    movd %xmm0, %eax
; CHECK-NEXT:    btl $16, %eax
; CHECK-NEXT:    movl %eax, %ecx
; CHECK-NEXT:    adcl $32767, %ecx # imm = 0x7FFF
; CHECK-NEXT:    orl $4194304, %eax # imm = 0x400000
; CHECK-NEXT:    ucomiss %xmm0, %xmm0
; CHECK-NEXT:    cmovnpl %ecx, %eax
; CHECK-NEXT:    shrl $16, %eax
; CHECK-NEXT:    pinsrw $0, %eax, %xmm0
; CHECK-NEXT:    retq
  %prdx = call <1 x bfloat> @llvm.vector.partial.reduce.fadd(<1 x bfloat> %acc, <1 x bfloat> %in)
  %res = extractelement <1 x bfloat> %prdx, i32 0
  ret bfloat %res
}

define i32 @test_prdx_mla(<1 x i32> %acc, <1 x i32> %in) {
; CHECK-LABEL: test_prdx_mla:
; CHECK:       # %bb.0:
; CHECK-NEXT:    # kill: def $esi killed $esi def $rsi
; CHECK-NEXT:    # kill: def $edi killed $edi def $rdi
; CHECK-NEXT:    leal (%rdi,%rsi), %eax
; CHECK-NEXT:    retq
  %prdx = call <1 x i32> @llvm.vector.partial.reduce.add(<1 x i32> %acc, <1 x i32> %in)
  %res = extractelement <1 x i32> %prdx, i32 0
  ret i32 %res
}

