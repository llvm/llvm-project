define bfloat @test_prdx_fmla(<1 x bfloat> %acc, <1 x bfloat> %in) {
; SSE-LABEL: test_prdx_fmla:
; SSE:       # %bb.0:
; SSE-NEXT:    pslld $16, %xmm1
