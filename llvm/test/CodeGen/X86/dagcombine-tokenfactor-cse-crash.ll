; RUN: llc < %s | FileCheck %s
;
; Verify that CSE-reusing a TokenFactor during broadcast-load combining does not
; introduce a self-reference while replacing the old chain.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@g28 = dso_local local_unnamed_addr global <16 x i64> zeroinitializer, align 128

define i32 @f18() #0 {
; CHECK-LABEL: f18:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vmovaps g28+32(%rip), %ymm0
; CHECK-NEXT:    vmovaps g28+64(%rip), %xmm1
; CHECK-NEXT:    vunpckhpd {{.*#+}} xmm1 = xmm1[1],mem[1]
; CHECK-NEXT:    vpermpd {{.*#+}} ymm2 = ymm1[0,1,2,1]
; CHECK-NEXT:    vbroadcastsd g28+24(%rip), %ymm3
; CHECK-NEXT:    vblendps {{.*#+}} ymm2 = ymm2[0,1,2,3],ymm3[4,5],ymm2[6,7]
; CHECK-NEXT:    vmovddup {{.*#+}} xmm3 = mem[0,0]
; CHECK-NEXT:    vpermpd {{.*#+}} ymm4 = ymm0[3,2,0,3]
; CHECK-NEXT:    vbroadcastsd g28+96(%rip), %ymm5
; CHECK-NEXT:    vblendps {{.*#+}} ymm6 = ymm4[0,1,2,3,4,5],ymm5[6,7]
; CHECK-NEXT:    vperm2f128 {{.*#+}} ymm7 = ymm5[0,1],mem[0,1]
; CHECK-NEXT:    vblendps {{.*#+}} ymm0 = ymm0[0,1,2,3],ymm6[4,5,6,7]
; CHECK-NEXT:    vshufps {{.*#+}} ymm0 = ymm0[2,3,0,1,6,7,4,5]
; CHECK-NEXT:    vblendps {{.*#+}} ymm0 = ymm0[0,1],ymm3[2,3],ymm0[4,5,6,7]
; CHECK-NEXT:    vpermpd {{.*#+}} ymm3 = ymm1[0,1,0,1]
; CHECK-NEXT:    vshufps {{.*#+}} ymm6 = ymm6[2,3,0,1,6,7,4,5]
; CHECK-NEXT:    vblendps {{.*#+}} ymm3 = ymm6[0,1],ymm3[2,3,4,5],ymm6[6,7]
; CHECK-NEXT:    vshufps {{.*#+}} ymm2 = ymm2[2,3,0,1,6,7,4,5]
; CHECK-NEXT:    vblendps {{.*#+}} ymm2 = ymm4[0,1,2,3],ymm2[4,5,6,7]
; CHECK-NEXT:    vblendps {{.*#+}} ymm2 = ymm2[0,1],ymm5[2,3],ymm2[4,5,6,7]
; CHECK-NEXT:    vpermpd {{.*#+}} ymm1 = ymm1[1,1,2,0]
; CHECK-NEXT:    vpermpd {{.*#+}} ymm4 = ymm7[0,2,0,3]
; CHECK-NEXT:    vblendps {{.*#+}} ymm1 = ymm1[0,1],ymm4[2,3,4,5],ymm1[6,7]
; CHECK-NEXT:    vmovaps %ymm1, 64
; CHECK-NEXT:    vmovaps %ymm3, 0
; CHECK-NEXT:    vmovaps %ymm0, 32
; CHECK-NEXT:    vmovaps %ymm2, 96
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
entry:
  %0 = load <15 x i64>, ptr @g28, align 128
  %shuffle = shufflevector <15 x i64> %0, <15 x i64> zeroinitializer, <16 x i32> <i32 7, i32 6, i32 4, i32 12, i32 9, i32 5, i32 3, i32 5, i32 12, i32 13, i32 0, i32 14, i32 7, i32 8, i32 4, i32 2>
  %shuffle1 = shufflevector <16 x i64> %shuffle, <16 x i64> zeroinitializer, <16 x i32> <i32 1, i32 5, i32 4, i32 2, i32 7, i32 13, i32 3, i32 2, i32 5, i32 10, i32 8, i32 4, i32 0, i32 8, i32 7, i32 6>
  store <16 x i64> %shuffle1, ptr null, align 128
  ret i32 0
}

attributes #0 = { "target-features"="+avx2" }
