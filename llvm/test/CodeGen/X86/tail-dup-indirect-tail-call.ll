; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64 -O2 < %s | FileCheck %s
; RUN: llc -mtriple=x86_64 -O2 -tail-dup-indirect-tail-call-size=0 < %s | FileCheck %s --check-prefix=NODUP

; Interpreter-style dispatch through a table of musttail-called handlers. The two
; paths of a condition join just before the indirect tail call, and the call
; target depends on the path. Like a computed goto, the indirect tail call is
; duplicated into both paths after register allocation, so each path ends in its
; own indirect branch. With the limit set to 0 the paths share one indirect
; branch, and the paths are not duplicated in a function optimized for size.

@ram = external global [1024 x i64]
@table = external constant [8 x ptr]

define void @dispatch_after_branch(i64 %pc) {
; CHECK-LABEL: dispatch_after_branch:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movq ram@GOTPCREL(%rip), %rax
; CHECK-NEXT:    movq 8(%rax,%rdi,8), %rcx
; CHECK-NEXT:    testb $1, (%rax,%rcx,8)
; CHECK-NEXT:    jne .LBB0_1
; CHECK-NEXT:  # %bb.2: # %jump
; CHECK-NEXT:    movq 16(%rax,%rdi,8), %rdi
; CHECK-NEXT:    movq (%rax,%rdi,8), %rax
; CHECK-NEXT:    movq table@GOTPCREL(%rip), %rcx
; CHECK-NEXT:    jmpq *(%rcx,%rax,8) # TAILCALL
; CHECK-NEXT:  .LBB0_1: # %next
; CHECK-NEXT:    addq $3, %rdi
; CHECK-NEXT:    movq (%rax,%rdi,8), %rax
; CHECK-NEXT:    movq table@GOTPCREL(%rip), %rcx
; CHECK-NEXT:    jmpq *(%rcx,%rax,8) # TAILCALL
;
; NODUP-LABEL: dispatch_after_branch:
; NODUP:       # %bb.0: # %entry
; NODUP-NEXT:    movq ram@GOTPCREL(%rip), %rax
; NODUP-NEXT:    movq 8(%rax,%rdi,8), %rcx
; NODUP-NEXT:    testb $1, (%rax,%rcx,8)
; NODUP-NEXT:    jne .LBB0_1
; NODUP-NEXT:  # %bb.2: # %jump
; NODUP-NEXT:    movq 16(%rax,%rdi,8), %rdi
; NODUP-NEXT:    jmp .LBB0_3
; NODUP-NEXT:  .LBB0_1: # %next
; NODUP-NEXT:    addq $3, %rdi
; NODUP-NEXT:  .LBB0_3: # %dispatch
; NODUP-NEXT:    movq (%rax,%rdi,8), %rax
; NODUP-NEXT:    movq table@GOTPCREL(%rip), %rcx
; NODUP-NEXT:    jmpq *(%rcx,%rax,8) # TAILCALL
entry:
  %base = getelementptr [8 x i8], ptr @ram, i64 %pc
  %p1 = getelementptr i8, ptr %base, i64 8
  %reg = load i64, ptr %p1, align 8
  %pv = getelementptr inbounds [8 x i8], ptr @ram, i64 %reg
  %v = load i64, ptr %pv, align 8
  %bit = and i64 %v, 1
  %even = icmp eq i64 %bit, 0
  br i1 %even, label %jump, label %next

next:
  %pc.next = add i64 %pc, 3
  br label %dispatch

jump:
  %p2 = getelementptr i8, ptr %base, i64 16
  %pc.jump = load i64, ptr %p2, align 8
  br label %dispatch

dispatch:
  %npc = phi i64 [ %pc.next, %next ], [ %pc.jump, %jump ]
  %pop = getelementptr inbounds [8 x i8], ptr @ram, i64 %npc
  %op = load i64, ptr %pop, align 8
  %pf = getelementptr inbounds [8 x ptr], ptr @table, i64 0, i64 %op
  %f = load ptr, ptr %pf, align 8
  musttail call void %f(i64 %npc)
  ret void
}

