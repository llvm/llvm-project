define i32 @step_65537(ptr %p) {
; CHECK-LABEL: step_65537:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movl 131068(%rdi), %eax
; CHECK-NEXT:    movl 131072(%rdi), %edx
; CHECK-NEXT:    addl $32767, %eax # imm = 0x7FFF
; CHECK-NEXT:    addl $32768, %edx # imm = 0x8000
; CHECK-NEXT:    movl 262144(%rdi), %ecx
; CHECK-NEXT:    addl $65536, %ecx # imm = 0x10000
; CHECK-NEXT:    xorl %edx, %eax
; CHECK-NEXT:    xorl %ecx, %eax
; CHECK-NEXT:    retq
  %w = load <131072 x i32>, ptr %p, align 16
  %v = call <65537 x i32> @llvm.vector.extract.v65537i32.v131072i32(<131072 x i32> %w, i64 0)
  %s = call <65537 x i32> @llvm.stepvector.v65537i32()
  %a = add <65537 x i32> %v, %s
  %x = extractelement <65537 x i32> %a, i32 32767
  %y = extractelement <65537 x i32> %a, i32 32768
  %z = extractelement <65537 x i32> %a, i32 65536
  %r1 = xor i32 %x, %y
  %r = xor i32 %r1, %z
  ret i32 %r
}

