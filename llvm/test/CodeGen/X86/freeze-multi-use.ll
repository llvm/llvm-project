; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64-- < %s | FileCheck %s

; Every use of a frozen value must observe the same value.

; The result must have the same parity as %n.
define i32 @add_twice(i32 %n) {
; CHECK-LABEL: add_twice:
; CHECK:       # %bb.0:
; CHECK-NEXT:    # kill: def $edi killed $edi def $rdi
; CHECK-NEXT:    # freeze: $ecx
; CHECK-NEXT:    leal (%rdi,%rcx), %eax
; CHECK-NEXT:    addl %ecx, %eax
; CHECK-NEXT:    retq
  %w = freeze i32 poison
  %a = add i32 %n, %w
  %r = add i32 %a, %w
  ret i32 %r
}

; The multiply and the shift must read the same value.
define i32 @ashr_mul(i32 %x) {
; CHECK-LABEL: ashr_mul:
; CHECK:       # %bb.0:
; CHECK-NEXT:    # freeze: $ecx
; CHECK-NEXT:    movl %ecx, %eax
; CHECK-NEXT:    sarl $3, %eax
; CHECK-NEXT:    imull %ecx, %eax
; CHECK-NEXT:    retq
  %p = ashr i32 %x, 32
  %w = freeze i32 %p
  %s = ashr i32 %w, 3
  %r = mul i32 %w, %s
  ret i32 %r
}

; The result must be %x.
define i32 @cross_block(i1 %c, i32 %x) {
; CHECK-LABEL: cross_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movl %esi, %eax
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    je .LBB2_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    # freeze: $ecx
; CHECK-NEXT:    addl %ecx, %eax
; CHECK-NEXT:    subl %ecx, %eax
; CHECK-NEXT:  .LBB2_2: # %e
; CHECK-NEXT:    retq
entry:
  %w = freeze i32 poison
  %a = add i32 %w, %x
  br i1 %c, label %t, label %e
t:
  %s = sub i32 %a, %w
  ret i32 %s
e:
  ret i32 %x
}

; The returned value must be the one passed to @use.
define i32 @across_call() nounwind {
; CHECK-LABEL: across_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rbx
; CHECK-NEXT:    # freeze: $ebx
; CHECK-NEXT:    movl %ebx, %edi
; CHECK-NEXT:    callq use@PLT
; CHECK-NEXT:    movl %ebx, %eax
; CHECK-NEXT:    popq %rbx
; CHECK-NEXT:    retq
  %w = freeze i32 poison
  call void @use(i32 %w)
  ret i32 %w
}

; The returned value must be the one passed to @usev.
define <4 x i32> @vec_across_call() nounwind {
; CHECK-LABEL: vec_across_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    subq $24, %rsp
; CHECK-NEXT:    # freeze: $xmm0
; CHECK-NEXT:    movaps %xmm0, (%rsp) # 16-byte Spill
; CHECK-NEXT:    callq usev@PLT
; CHECK-NEXT:    movaps (%rsp), %xmm0 # 16-byte Reload
; CHECK-NEXT:    addq $24, %rsp
; CHECK-NEXT:    retq
  %w = freeze <4 x i32> poison
  call void @usev(<4 x i32> %w)
  ret <4 x i32> %w
}

declare void @use(i32)
declare void @usev(<4 x i32>)
