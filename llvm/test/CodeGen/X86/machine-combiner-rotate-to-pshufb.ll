  %e.w = bitcast <2 x i64> %e to <4 x i32>
  %m.w = mul <4 x i32> %v.w, %e.w
  %m = bitcast <4 x i32> %m.w to <2 x i64>
  br i1 %c, label %then, label %exit
then:
  %r = call <2 x i64> @llvm.fshl.v2i64(<2 x i64> %m, <2 x i64> %m, <2 x i64> splat (i64 48))
  br label %exit
exit:
  %s = phi <2 x i64> [ %r, %then ], [ %m, %entry ]
  ret <2 x i64> %s
}

; xmm rotate right of i64 by 8 after a block that is bound by p0/p1.
define <2 x i64> @rotr_q_xmm(ptr %p, i1 %c) {
