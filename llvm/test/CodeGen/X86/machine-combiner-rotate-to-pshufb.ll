entry:
  %v = load <2 x i64>, ptr %p
  %e = call <2 x i64> @llvm.fshl.v2i64(<2 x i64> %v, <2 x i64> %v, <2 x i64> splat (i64 3))
  %v.w = bitcast <2 x i64> %v to <4 x i32>
  %e.w = bitcast <2 x i64> %e to <4 x i32>
  %m.w = mul <4 x i32> %v.w, %e.w
  %m = bitcast <4 x i32> %m.w to <2 x i64>
