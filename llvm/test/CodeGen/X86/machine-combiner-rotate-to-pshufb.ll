; NOTAPPLIED:       # %bb.0: # %entry
; NOTAPPLIED-NEXT:    vmovdqa (%rdi), %xmm0
; NOTAPPLIED-NEXT:    vprolq $3, %xmm0, %xmm1
; NOTAPPLIED-NEXT:    vpmulld %xmm1, %xmm0, %xmm0
; NOTAPPLIED-NEXT:    testb $1, %sil
; NOTAPPLIED-NEXT:    je .LBB14_2
