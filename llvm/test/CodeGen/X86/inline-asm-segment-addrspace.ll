; Inline asm memory operands that refer to the segment relative address spaces
; 256 (%gs), 257 (%fs) and 258 (%ss) must be emitted with a segment override.

@gs_var = external addrspace(256) global i32
@fs_arr = external addrspace(257) global [4 x i32]

define void @output_gs(ptr addrspace(256) %p, i32 %x) nounwind {
; X64-LABEL: output_gs:
; X64:       # %bb.0:
; X64-NEXT:    #APP
; X64-NEXT:    addl %esi, %gs:(%rdi)
; X64-NEXT:    #NO_APP
; X64-NEXT:    retq
;
; X64-O0-LABEL: output_gs:
; X64-O0:       # %bb.0:
; X64-O0-NEXT:    #APP
; X64-O0-NEXT:    addl %esi, %gs:(%rdi)
; X64-O0-NEXT:    #NO_APP
; X64-O0-NEXT:    retq
;
; X86-LABEL: output_gs:
; X86:       # %bb.0:
; X86-NEXT:    movl {{[0-9]+}}(%esp), %eax
; X86-NEXT:    movl {{[0-9]+}}(%esp), %ecx
; X86-NEXT:    #APP
; X86-NEXT:    addl %eax, %gs:(%ecx)
; X86-NEXT:    #NO_APP
; X86-NEXT:    retl
  call void asm "addl $1, $0", "=*m,r,*m,~{dirflag},~{fpsr},~{flags}"(ptr addrspace(256) elementtype(i32) %p, i32 %x, ptr addrspace(256) elementtype(i32) %p)
  ret void
}

