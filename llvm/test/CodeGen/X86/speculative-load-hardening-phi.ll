; CHECK-NEXT:    cmovneq %rcx, %rax
entry:
  switch i32 %op, label %exit [
    i32 3, label %then.pre
    i32 4, label %inner
  ]

then.pre:
  br label %then

inner:
  switch i8 %c, label %join [
    i8 120, label %inner.then
    i8 88, label %inner.then
  ]

inner.then:
  br label %join

join:
  %v = phi double [ 1.000000e+00, %inner ], [ 0.000000e+00, %inner.then ]
  br i1 %cond, label %then, label %exit

then:
  %w = phi double [ 0.000000e+00, %then.pre ], [ %v, %join ]
  switch i32 %op, label %unreachable [
    i32 5, label %ret5
    i32 6, label %ret6
    i32 7, label %ret7
    i32 10, label %call
  ]

ret5:
  ret double 0.000000e+00

ret6:
  ret double 0.000000e+00

ret7:
  ret double 0.000000e+00

call:
  %r = tail call double @callee(double 0.000000e+00, double %w)
  ret double %r

unreachable:
  unreachable

exit:
  ret double 0.000000e+00
}
