; CHECK-NEXT:    cmovneq %rcx, %rax
; CHECK-NEXT:    xorps %xmm1, %xmm1
; CHECK-NEXT:    addl $-5, %edi
; CHECK-NEXT:    movq .LJTI0_0(,%rdi,8), %rdx
; CHECK-NEXT:    orq %rax, %rdx
; CHECK-NEXT:    jmpq *%rdx
; CHECK-NEXT:  .LBB0_3: # %inner
; CHECK-NEXT:    cmovneq %rcx, %rax
; CHECK-NEXT:    movzbl %sil, %esi
; CHECK-NEXT:    orl $32, %esi
; CHECK-NEXT:    cmpl $120, %esi
; CHECK-NEXT:    jne .LBB0_11
; CHECK-NEXT:  # %bb.4: # %inner.then
; CHECK-NEXT:    cmovneq %rcx, %rax
; CHECK-NEXT:    xorps %xmm1, %xmm1
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB0_12
; CHECK-NEXT:    jmp .LBB0_5
; CHECK-NEXT:  .LBB0_7:
; CHECK-NEXT:    cmoveq %rcx, %rax
; CHECK-NEXT:    jmp .LBB0_13
; CHECK-NEXT:  .LBB0_11:
; CHECK-NEXT:    cmoveq %rcx, %rax
; CHECK-NEXT:    movsd {{.*#+}} xmm1 = [1.0E+0,0.0E+0]
; CHECK-NEXT:    testb $1, %dl
; CHECK-NEXT:    je .LBB0_12
; CHECK-NEXT:  .LBB0_5: # %then
; CHECK-NEXT:    cmoveq %rcx, %rax
; CHECK-NEXT:    addl $-5, %edi
; CHECK-NEXT:    movq .LJTI0_0(,%rdi,8), %rdx
; CHECK-NEXT:    orq %rax, %rdx
; CHECK-NEXT:    jmpq *%rdx
; CHECK-NEXT:  .LBB0_6: # Block address taken
; CHECK-NEXT:    # %ret5
; CHECK-NEXT:    cmpq $.LBB0_6, %rdx
; CHECK-NEXT:    jmp .LBB0_12
; CHECK-NEXT:  .LBB0_8: # Block address taken
; CHECK-NEXT:    # %ret7
; CHECK-NEXT:    cmpq $.LBB0_8, %rdx
; CHECK-NEXT:    jmp .LBB0_12
; CHECK-NEXT:  .LBB0_9: # Block address taken
; CHECK-NEXT:    # %call
; CHECK-NEXT:    cmpq $.LBB0_9, %rdx
; CHECK-NEXT:    cmovneq %rcx, %rax
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    shlq $47, %rax
; CHECK-NEXT:    orq %rax, %rsp
; CHECK-NEXT:    jmp callee@PLT # TAILCALL
; CHECK-NEXT:  .LBB0_10: # Block address taken
