# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=unreachable-mbb-elimination %s -o - | FileCheck %s

# Deleting a block that owns block arguments must drop those arguments
# from the MachineRegisterInfo reverse map, so the map does not retain
# a dangling pointer to the freed block.
---
name: delete_unreachable_blockarg
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: delete_unreachable_blockarg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   RET64

  ; CHECK-NOT: bb.1:
  bb.0:
    RET64

  bb.1:
    successors: %bb.2
    %0:gr32 = MOV32ri 7
    SUCC_ARGS %bb.2, %0
    JMP_1 %bb.2

  bb.2:
    arguments: %1:gr32
    RET64 %1
...
