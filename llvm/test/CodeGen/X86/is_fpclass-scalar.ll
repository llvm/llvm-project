;; Test select pattern (result used in FPU)
define float @select_isinf_f32(float %x, float %y, float %z) {
; AVX512DQ-LABEL: select_isinf_f32:
; AVX512DQ:       # %bb.0:
; AVX512DQ-NEXT:    vfpclassss $24, %xmm0, %k0 # k0 = isPositiveInfinity(xmm0) | isNegativeInfinity(xmm0)
; AVX512DQ-NEXT:    kmovw %k0, %k1
; AVX512DQ-NEXT:    vmovss %xmm1, %xmm2, %xmm2 {%k1}
; AVX512DQ-NEXT:    vmovaps %xmm2, %xmm0
; AVX512DQ-NEXT:    retq
;
; AVX512FP16-LABEL: select_isinf_f32:
; AVX512FP16:       # %bb.0:
; AVX512FP16-NEXT:    vmovd %xmm0, %eax
; AVX512FP16-NEXT:    andl $2147483647, %eax # imm = 0x7FFFFFFF
; AVX512FP16-NEXT:    cmpl $2139095040, %eax # imm = 0x7F800000
; AVX512FP16-NEXT:    sete %al
; AVX512FP16-NEXT:    kmovd %eax, %k1
; AVX512FP16-NEXT:    vmovss %xmm1, %xmm2, %xmm2 {%k1}
; AVX512FP16-NEXT:    vmovaps %xmm2, %xmm0
; AVX512FP16-NEXT:    retq
  %cmp = call i1 @llvm.is.fpclass.f32(float %x, i32 516)
  %r = select i1 %cmp, float %y, float %z
  ret float %r
}

