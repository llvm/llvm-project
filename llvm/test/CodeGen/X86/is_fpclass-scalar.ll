;; Test scalar IS_FPCLASS lowering to VFPCLASSS/SD/SH instructions.

define i1 @isinf_f32(float %x) {
; AVX512DQ-LABEL: isinf_f32:
; AVX512DQ:       # %bb.0:
; AVX512DQ-NEXT:    vfpclassss $24, %xmm0, %k0 # k0 = isPositiveInfinity(xmm0) | isNegativeInfinity(xmm0)
; AVX512DQ-NEXT:    kmovw %k0, %eax
; AVX512DQ-NEXT:    # kill: def $al killed $al killed $eax
; AVX512DQ-NEXT:    retq
;
; AVX512FP16-LABEL: isinf_f32:
; AVX512FP16:       # %bb.0:
; AVX512FP16-NEXT:    vmovd %xmm0, %eax
; AVX512FP16-NEXT:    andl $2147483647, %eax # imm = 0x7FFFFFFF
; AVX512FP16-NEXT:    cmpl $2139095040, %eax # imm = 0x7F800000
; AVX512FP16-NEXT:    sete %al
; AVX512FP16-NEXT:    retq
  %r = call i1 @llvm.is.fpclass.f32(float %x, i32 516)  ; fcInf = 0x204
  ret i1 %r
}

