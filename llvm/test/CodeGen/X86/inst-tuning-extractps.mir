# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc %s -mtriple=x86_64-- -mcpu=x86-64-v4 -run-pass=x86-fixup-inst-tuning -o - | FileCheck %s
# RUN: llc %s -mtriple=x86_64-- -mcpu=znver4 -run-pass=x86-fixup-inst-tuning -o - | FileCheck %s

# Check that EXTRACTPS of element 0 is replaced with MOVD (register) or
# MOVSS (memory), and that other indices are kept.

---
name:            extractps_rr_idx0
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $xmm0
    ; CHECK-LABEL: name: extractps_rr_idx0
    ; CHECK: liveins: $xmm0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $eax = MOVPDI2DIrr killed renamable $xmm0
    ; CHECK-NEXT: RET64 implicit $eax
    renamable $eax = EXTRACTPSrri killed renamable $xmm0, 0
    RET64 implicit $eax
...
---
name:            vextractps_rr_idx0
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $xmm0
    ; CHECK-LABEL: name: vextractps_rr_idx0
    ; CHECK: liveins: $xmm0
    ; CHECK-NEXT: {{  $}}
