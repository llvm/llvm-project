# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -mattr=+avx512bw,+nf -precompute-phys-liveness -passes='require<live-intervals>,two-address-instruction' -o - %s | FileCheck %s

# Don't remove a live-through EFLAGS value when converting an instruction
# that does not define EFLAGS.

---
name: masked_move_to_blend
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $zmm0, $zmm1, $k1, $xmm2, $xmm3

    ; CHECK-LABEL: name: masked_move_to_blend
    ; CHECK: liveins: $zmm0, $zmm1, $k1, $xmm2, $xmm3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vr512 = COPY $zmm0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vr512 = COPY $zmm1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vk32wm = COPY $k1
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fr32x = COPY $xmm2
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:fr32x = COPY $xmm3
    ; CHECK-NEXT: VUCOMISSZrr [[COPY3]], [[COPY4]], implicit-def $eflags, implicit $mxcsr
    ; CHECK-NEXT: [[VPBLENDMWZrrk:%[0-9]+]]:vr512 = VPBLENDMWZrrk [[COPY2]], [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[SETCCr:%[0-9]+]]:gr8 = SETCCr 10, implicit $eflags
    ; CHECK-NEXT: $zmm0 = COPY [[VPBLENDMWZrrk]]
    ; CHECK-NEXT: $zmm1 = COPY [[COPY]]
    ; CHECK-NEXT: $al = COPY [[SETCCr]]
    ; CHECK-NEXT: RET 0, implicit $zmm0, implicit $zmm1, implicit $al
    %0:vr512 = COPY $zmm0
    %1:vr512 = COPY $zmm1
    %2:vk32wm = COPY $k1
    %3:fr32x = COPY $xmm2
    %4:fr32x = COPY $xmm3
    VUCOMISSZrr %3, %4, implicit-def $eflags, implicit $mxcsr
    %5:vr512 = VMOVDQU16Zrrk %0, %2, %1
    %6:gr8 = SETCCr 10, implicit $eflags
    $zmm0 = COPY %5
    $zmm1 = COPY %0
    $al = COPY %6
    RET 0, implicit $zmm0, implicit $zmm1, implicit $al
...

---
name: add_nf_to_lea
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi, $esi

    ; CHECK-LABEL: name: add_nf_to_lea
    ; CHECK: liveins: $edi, $esi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr32 = COPY $esi
    ; CHECK-NEXT: CMP32rr [[COPY]], [[COPY1]], implicit-def $eflags
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gr16 = COPY [[COPY]].sub_16bit
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:gr64_nosp = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF:%[0-9]+]].sub_16bit:gr64_nosp = COPY [[COPY2]]
    ; CHECK-NEXT: [[LEA64_32r:%[0-9]+]]:gr32 = LEA64_32r [[DEF]], 1, $noreg, 7, $noreg
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gr16 = COPY [[LEA64_32r]].sub_16bit
    ; CHECK-NEXT: [[SETCCr:%[0-9]+]]:gr8 = SETCCr 4, implicit $eflags
    ; CHECK-NEXT: $ax = COPY [[COPY3]]
    ; CHECK-NEXT: $cx = COPY [[COPY2]]
    ; CHECK-NEXT: $dl = COPY [[SETCCr]]
    ; CHECK-NEXT: RET 0, implicit $ax, implicit $cx, implicit $dl
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    CMP32rr %0, %1, implicit-def $eflags
    %2:gr16 = COPY %0.sub_16bit
    %3:gr16 = ADD16ri_NF %2, 7
    %4:gr8 = SETCCr 4, implicit $eflags
    $ax = COPY %3
    $cx = COPY %2
    $dl = COPY %4
    RET 0, implicit $ax, implicit $cx, implicit $dl
...
