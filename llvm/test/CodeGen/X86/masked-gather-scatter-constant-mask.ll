; A constant mask that empties a legalized part leaves no instruction for it, so
; a cost charged per emitted part must drop it too. These counts are what the
; gather/scatter costs are read against: one instruction for eight live lanes
; inside a part, three for eight spread over three parts, and none at all for an
; empty mask.

; The first part only.
define <24 x i32> @gather_contiguous(ptr %base, <24 x i64> %idx) {
; CHECK-LABEL: gather_contiguous:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmovq %r9, %xmm0
; CHECK-NEXT:    vmovq %r8, %xmm1
; CHECK-NEXT:    vmovq %rdx, %xmm2
; CHECK-NEXT:    kxnorb %k0, %k0, %k1
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    vpunpcklqdq {{.*#+}} xmm0 = xmm1[0],xmm0[0]
; CHECK-NEXT:    vmovq %rcx, %xmm1
; CHECK-NEXT:    vpunpcklqdq {{.*#+}} xmm1 = xmm2[0],xmm1[0]
; CHECK-NEXT:    vinserti128 $1, %xmm0, %ymm1, %ymm0
; CHECK-NEXT:    vinserti64x4 $1, {{[0-9]+}}(%rsp), %zmm0, %zmm0
; CHECK-NEXT:    vpxor %xmm1, %xmm1, %xmm1
; CHECK-NEXT:    vpgatherqd (%rsi,%zmm0,4), %ymm1 {%k1}
; CHECK-NEXT:    vmovdqa64 %zmm1, (%rdi)
; CHECK-NEXT:    vzeroupper
; CHECK-NEXT:    retq
  %ptrs = getelementptr inbounds i32, ptr %base, <24 x i64> %idx
  %v = call <24 x i32> @llvm.masked.gather.v24i32.v24p0(<24 x ptr> %ptrs, i32 4, <24 x i1> <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false>, <24 x i32> poison)
  ret <24 x i32> %v
}

