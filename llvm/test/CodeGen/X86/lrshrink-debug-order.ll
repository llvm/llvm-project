; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --filter-out "DEBUG_VALUE|\.loc|\.Ltmp|\.file" --version 6
; RUN: llc -mtriple=x86_64-- < %s | FileCheck %s
; RUN: opt -passes=debugify < %s | llc -mtriple=x86_64-- | FileCheck %s

; The two RUN lines intentionally share a check prefix. With debugify, the
; dbg.value of the no-op %t becomes a debug instruction at the start of %if.end,
; before the SETCC that uses the live-in EFLAGS. It must not stop Live Range
; Shrink from hoisting the XOR above the IMUL.

define i8 @f(i32 %a, i32 %b, ptr %p) {
; CHECK-LABEL: f:
; CHECK:  # %bb.0: # %entry
; CHECK:    movzbl (%rdx), %eax
; CHECK:    cmpl %esi, %edi
; CHECK:    jne .LBB0_2
; CHECK:  # %bb.1:
; CHECK:    xorl %eax, %eax
; CHECK:    # kill: def $al killed $al killed $eax
; CHECK:    retq
; CHECK:  .LBB0_2: # %if.end
; CHECK:    setl %cl
; CHECK:    xorb %cl, %al
; CHECK:    imull %edi, %esi
; CHECK:    subb %sil, %al
; CHECK:    # kill: def $al killed $al killed $eax
; CHECK:    retq
entry:
  %o = load volatile i8, ptr %p, align 1
  %cmp = icmp eq i32 %a, %b
  br i1 %cmp, label %exit, label %if.end

if.end:
  %t = bitcast i32 %a to i32
  %lt = icmp slt i32 %a, %b
  %mul = mul nsw i32 %b, %a
  %z = zext i1 %lt to i8
  %x = xor i8 %o, %z
  %m = trunc i32 %mul to i8
  %r = sub i8 %x, %m
  br label %exit

exit:
  %ret = phi i8 [ %r, %if.end ], [ 0, %entry ]
  ret i8 %ret
}
