# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=register-coalescer -verify-coalescing -o - %s \
# RUN:   | FileCheck %s --implicit-check-not="undef {{.*}}.sub_8bit:"

---
# The IMPLICIT_DEF only redefines sub_8bit, so sub_8bit_hi still holds 7.
# After the IMPLICIT_DEF is erased, that value must stay live up to the
# sub_8bit redef of %3, which reads it and must not become <read-undef>.
name:            real_lane
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: real_lane
    ; CHECK: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 7
    ; CHECK-NEXT: [[MOV8ri:%[0-9]+]].sub_8bit:gr16_abcd = MOV8ri 1
    ; CHECK-NEXT: [[ADD16rr:%[0-9]+]]:gr16 = ADD16rr [[MOV8ri]], [[MOV8ri]], implicit-def dead $eflags
    ; CHECK-NEXT: $ax = COPY [[ADD16rr]]
    ; CHECK-NEXT: RET 0, implicit $ax
    undef %1.sub_8bit_hi:gr16_abcd = MOV8ri 7
    %1.sub_8bit:gr16_abcd = IMPLICIT_DEF
    %3:gr16_abcd = COPY %1
    %3.sub_8bit:gr16_abcd = MOV8ri 1
    %4:gr16_abcd = COPY killed %3
    %5:gr16 = ADD16rr %1, %4, implicit-def dead $eflags
    $ax = COPY %5
    RET 0, implicit $ax
...
