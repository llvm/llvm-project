# RUN: llc -mtriple=x86_64-unknown-linux-gnu -passes=register-coalescer -verify-coalescing -o - %s | FileCheck %s

---
# The IMPLICIT_DEF only redefines sub_8bit, so sub_8bit_hi still holds 7.
# After the IMPLICIT_DEF is erased, that value must stay live up to the
# sub_8bit redef of %3, which reads it and must not become <read-undef>.
name:            real_lane
body:             |
  bb.0:
    ; CHECK-LABEL: name: real_lane
    ; CHECK: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 7
    ; CHECK-NEXT: {{^ *}}[[MOV8ri]].sub_8bit:gr16_abcd = MOV8ri 1
    ; CHECK-NEXT: [[ADD16rr:%[0-9]+]]:gr16 = ADD16rr [[MOV8ri]], [[MOV8ri]], implicit-def dead $eflags
    ; CHECK-NEXT: $ax = COPY [[ADD16rr]]
    ; CHECK-NEXT: RET 0, implicit $ax
    undef %1.sub_8bit_hi:gr16_abcd = MOV8ri 7
    %1.sub_8bit:gr16_abcd = IMPLICIT_DEF
    %3:gr16_abcd = COPY %1
    %3.sub_8bit:gr16_abcd = MOV8ri 1
    %4:gr16_abcd = COPY %3
    %5:gr16 = ADD16rr %1, %4, implicit-def dead $eflags
    $ax = COPY %5
    RET 0, implicit $ax
...
---
# The IMPLICIT_DEF only redefines sub_8bit, so sub_8bit_hi still holds 7 when
# the read-undef MOV8rr replaces it. The ADD reads that 7 through %1, so the
# merged MOV8rr must not keep <read-undef>.
name:            replace_read_undef
body:             |
  bb.0:
    ; CHECK-LABEL: name: replace_read_undef
    ; CHECK: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 7
    ; CHECK-NEXT: {{^ *}}[[MOV8ri]].sub_8bit:gr16_abcd = MOV8rr [[MOV8ri]].sub_8bit_hi
    ; CHECK-NEXT: [[ADD16rr:%[0-9]+]]:gr16 = ADD16rr [[MOV8ri]], [[MOV8ri]], implicit-def dead $eflags
    ; CHECK-NEXT: $ax = COPY [[ADD16rr]]
    ; CHECK-NEXT: RET 0, implicit $ax
    undef %1.sub_8bit_hi:gr16_abcd = MOV8ri 7
    %1.sub_8bit:gr16_abcd = IMPLICIT_DEF
    %3:gr16_abcd = COPY %1
    undef %3.sub_8bit:gr16_abcd = MOV8rr %3.sub_8bit_hi
    %5:gr16 = ADD16rr %1, %3, implicit-def dead $eflags
    $ax = COPY %5
    RET 0, implicit $ax
...
---
# The read-undef MOV8ri 5 replaces the IMPLICIT_DEF before the COPY, so its own
# endpoint does not reach the $ax read. That read sees the COPY's value, which
# still holds 7 in sub_8bit_hi.
name:            replace_before_copy
body:             |
  bb.0:
    ; CHECK-LABEL: name: replace_before_copy
    ; CHECK: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 7
    ; CHECK-NEXT: {{^ *}}[[MOV8ri]].sub_8bit:gr16_abcd = MOV8ri 5
    ; CHECK-NEXT: $ax = COPY [[MOV8ri]]
    ; CHECK-NEXT: RET 0, implicit $ax
    undef %1.sub_8bit_hi:gr16_abcd = MOV8ri 7
    %1.sub_8bit:gr16_abcd = IMPLICIT_DEF
    undef %3.sub_8bit:gr16_abcd = MOV8ri 5
    %3.sub_8bit_hi:gr16_abcd = COPY %1.sub_8bit_hi
    $ax = COPY %3
    RET 0, implicit $ax
...
---
# %0 is live across the sub_8bit_hi redef, so joining %0 into %1 erases the
# IMPLICIT_DEF. The redef must end up <read-undef>.
name:            impdef_live_across_partial_def
body:             |
  bb.0:
    ; CHECK-LABEL: name: impdef_live_across_partial_def
    ; CHECK: bb.0:
    ; CHECK-NEXT: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 1
    ; CHECK-NEXT: RET 0, implicit [[MOV8ri]], implicit [[MOV8ri]]
    %0:gr16_abcd = IMPLICIT_DEF
    %1:gr16_abcd = COPY %0
    %1.sub_8bit_hi:gr16_abcd = MOV8ri 1
    RET 0, implicit %0, implicit %1
...
---
# %0 is live into bb.1, across the bb.0 ADD, so the coalescer erases its
# IMPLICIT_DEF. The tied and the other read of the bb.0 ADD then have nothing
# live into them and must become undef.
name:            tied_and_other_read_of_impdef
body:             |
  bb.0:
    ; CHECK-LABEL: name: tied_and_other_read_of_impdef
    ; CHECK: undef [[ADD:%[0-9]+]].sub_32bit:gr64_with_sub_8bit = ADD32rr undef [[ADD]].sub_32bit, undef [[ADD]].sub_32bit, implicit-def dead $eflags
    ; CHECK-NEXT: undef [[COPY:%[0-9]+]].sub_32bit:gr64 = COPY [[ADD]].sub_32bit
    ; CHECK: bb.1:
    ; CHECK: {{^ *}}[[ADD]].sub_32bit:gr64_with_sub_8bit = ADD32rr [[ADD]].sub_32bit, [[ADD]].sub_32bit, implicit-def dead $eflags
    ; CHECK: bb.2:
    ; CHECK-NEXT: RET 0, implicit [[COPY]], implicit [[ADD]]
    successors: %bb.1

    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = COPY %0
    %1:gr32 = ADD32rr %1, %1, implicit-def dead $eflags
    undef %2.sub_32bit:gr64 = COPY %1

  bb.1:
    successors: %bb.2

    %3:gr32 = COPY %0
    %3:gr32 = ADD32rr %3, %3, implicit-def dead $eflags
    undef %4.sub_32bit:gr64 = COPY %3

  bb.2:
    RET 0, implicit %2, implicit %4
...
---
# The MOV16ri partially redefines %1, the source of the join into
# %4.sub_32bit, and reads the erased IMPLICIT_DEF, so it must become
# <read-undef>.
name:            srcreg_partial_def
body:             |
  bb.0:
    ; CHECK-LABEL: name: srcreg_partial_def
    ; CHECK: undef [[MOV:%[0-9]+]].sub_16bit:gr64_with_sub_8bit = MOV16ri 5
    ; CHECK-NEXT: undef [[MOV1:%[0-9]+]].sub_16bit:gr64_with_sub_8bit = MOV16ri 5
    ; CHECK: bb.1:
    ; CHECK: {{^ *}}[[MOV]].sub_32bit:gr64_with_sub_8bit = ADD32rr [[MOV]].sub_32bit, [[MOV]].sub_32bit, implicit-def dead $eflags
    ; CHECK: bb.2:
    ; CHECK-NEXT: RET 0, implicit [[MOV1]], implicit [[MOV]]
    successors: %bb.1

    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = COPY %0
    %1.sub_16bit:gr32 = MOV16ri 5
    undef %2.sub_32bit:gr64 = COPY %1

  bb.1:
    successors: %bb.2

    %3:gr32 = COPY %0
    %3:gr32 = ADD32rr %3, %3, implicit-def dead $eflags
    undef %4.sub_32bit:gr64 = COPY %3

  bb.2:
    RET 0, implicit %2, implicit %4
...
---
# The COPY reads %0 inside the bundle, so nothing is live into the bundle for
# it. The join keeps %0 (it has more segments than %2), so the internal read is
# an original DstReg operand. It must not become undef.
name:            dstreg_internal_read_in_bundle
body:             |
  bb.0:
    ; CHECK-LABEL: name: dstreg_internal_read_in_bundle
    ; CHECK: BUNDLE implicit-def [[MOV32ri:%[0-9]+]], implicit-def [[COPY:%[0-9]+]] {
    ; CHECK-NEXT: {{^ *}}[[MOV32ri]]:gr32 = MOV32ri 1
    ; CHECK-NEXT: {{^ *}}[[COPY]]:gr32 = COPY internal [[MOV32ri]]
    ; CHECK-NEXT: }
    ; CHECK: bb.2:
    ; CHECK-NEXT: $eax = COPY [[MOV32ri]]
    successors: %bb.1, %bb.2

    BUNDLE implicit-def %0, implicit-def %1 {
      %0:gr32 = MOV32ri 1
      %1:gr32 = COPY internal %0
    }
    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags

  bb.1:
    RET 0

  bb.2:
    %2:gr32 = COPY %0
    $eax = COPY %2
    $ecx = COPY %1
    RET 0, implicit $eax, implicit $ecx
...
---
# The partial COPY of the erasable IMPLICIT_DEF still carries the 7 in
# sub_8bit_hi, so the $al read of that lane must stay live, not become undef.
name:            partial_copy_of_impdef_keeps_lane
body:             |
  bb.0:
    ; CHECK-LABEL: name: partial_copy_of_impdef_keeps_lane
    ; CHECK: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 7
    ; CHECK-NEXT: TEST8rr [[MOV8ri]].sub_8bit, [[MOV8ri]].sub_8bit, implicit-def $eflags
    ; CHECK-NEXT: $al = COPY [[MOV8ri]].sub_8bit_hi
    ; CHECK-NEXT: RET 0, implicit $al
    %0:gr8 = IMPLICIT_DEF
    undef %1.sub_8bit_hi:gr16_abcd = MOV8ri 7
    %1.sub_8bit:gr16_abcd = COPY %0
    TEST8rr %0, %0, implicit-def $eflags
    $al = COPY %1.sub_8bit_hi
    RET 0, implicit $al
...
---
# The erased partial IMPLICIT_DEF of %1 carries no defined lane of its own, so
# the MOV8ri reads nothing live and must become <read-undef>.
name:            partial_impdef_of_dstreg
body:             |
  bb.0:
    ; CHECK-LABEL: name: partial_impdef_of_dstreg
    ; CHECK: bb.0:
    ; CHECK-NEXT: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 1
    ; CHECK-NEXT: RET 0, implicit [[MOV8ri]], implicit [[MOV8ri]]
    %0:gr16_abcd = IMPLICIT_DEF
    %1:gr16_abcd = COPY %0
    %1.sub_8bit:gr16_abcd = IMPLICIT_DEF
    %1.sub_8bit_hi:gr16_abcd = MOV8ri 1
    RET 0, implicit %0, implicit %1
...
---
# The partial IMPLICIT_DEF of %1 still carries the 7 in sub_8bit_hi from the
# value it redefines, so the $al read of that lane must stay live.
name:            partial_impdef_carries_lane
body:             |
  bb.0:
    ; CHECK-LABEL: name: partial_impdef_carries_lane
    ; CHECK: undef [[MOV8ri:%[0-9]+]].sub_8bit_hi:gr16_abcd = MOV8ri 7
    ; CHECK-NEXT: TEST8rr [[MOV8ri]].sub_8bit, [[MOV8ri]].sub_8bit, implicit-def $eflags
    ; CHECK-NEXT: $al = COPY [[MOV8ri]].sub_8bit_hi
    ; CHECK-NEXT: RET 0, implicit $al
    %0:gr8 = IMPLICIT_DEF
    undef %1.sub_8bit_hi:gr16_abcd = MOV8ri 7
    %1.sub_8bit:gr16_abcd = COPY %0
    %1.sub_8bit:gr16_abcd = IMPLICIT_DEF
    TEST8rr %0, %0, implicit-def $eflags
    $al = COPY %1.sub_8bit_hi
    RET 0, implicit $al
...
