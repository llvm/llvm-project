# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64 -run-pass=liveintervals,twoaddressinstruction -o - %s | FileCheck %s

# An undef use does not extend the live range, so %1 is not live at
# the PMAXUDrr commute candidate and must not be reported as killed
# there.

---
name:            undef_use_not_killed
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $xmm0
    ; CHECK-LABEL: name: undef_use_not_killed
    ; CHECK: liveins: $xmm0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vr128 = COPY $xmm0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:vr128 = IMPLICIT_DEF
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vr128 = COPY [[DEF]]
    ; CHECK-NEXT: dead [[COPY1:%[0-9]+]]:vr128 = PADDDrr [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vr128 = COPY [[COPY]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vr128 = PMAXUDrr [[COPY2]], undef [[DEF]]
    ; CHECK-NEXT: $xmm0 = COPY [[COPY2]]
    ; CHECK-NEXT: RET 0, implicit $xmm0
    %0:vr128 = COPY $xmm0
    %1:vr128 = IMPLICIT_DEF
    %2:vr128 = PADDDrr %1, %1
    %3:vr128 = PMAXUDrr %0, undef %1
    $xmm0 = COPY %3
    RET 0, implicit killed $xmm0
...
