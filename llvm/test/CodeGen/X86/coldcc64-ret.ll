; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; On x86-64, coldcc preserves most registers (CSR_64_MostRegs), including RCX,
; RDX and XMM0-XMM15. A coldcc function must not save and restore the registers
; that hold its return value, otherwise the epilogue overwrites the return value
; with the caller's original register contents. All other registers in that
; list must still be preserved.
; https://github.com/llvm/llvm-project/issues/72321

; Each callee clobbers a few registers that are callee-saved under coldcc. Only
; the ones that are not used for the return value must be saved and restored.

define coldcc double @ret_double(double %x) nounwind {
; CHECK-LABEL: ret_double:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rdx
; CHECK-NEXT:    pushq %rcx
; CHECK-NEXT:    movaps %xmm1, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    addsd {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm0
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm1 # 16-byte Reload
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    popq %rdx
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{rcx},~{rdx},~{xmm1}"()
  %r = fadd double %x, 1.0
  ret double %r
}

define coldcc { double, double } @ret_double_pair(double %x, double %y) nounwind {
; CHECK-LABEL: ret_double_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rdx
; CHECK-NEXT:    pushq %rcx
; CHECK-NEXT:    movaps %xmm2, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    addsd {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm0
; CHECK-NEXT:    addsd {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm1
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm2 # 16-byte Reload
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    popq %rdx
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{rcx},~{rdx},~{xmm2}"()
  %a = fadd double %x, 1.0
  %b = fadd double %y, 2.0
  %r0 = insertvalue { double, double } poison, double %a, 0
  %r1 = insertvalue { double, double } %r0, double %b, 1
  ret { double, double } %r1
}

define coldcc { i64, i64 } @ret_i64_pair(i64 %a, i64 %b) nounwind {
; CHECK-LABEL: ret_i64_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rcx
; CHECK-NEXT:    movaps %xmm0, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    leaq 1(%rdi), %rax
; CHECK-NEXT:    leaq 2(%rsi), %rdx
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm0 # 16-byte Reload
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{rcx},~{rdx},~{xmm0}"()
  %a1 = add i64 %a, 1
  %b1 = add i64 %b, 2
  %r0 = insertvalue { i64, i64 } poison, i64 %a1, 0
  %r1 = insertvalue { i64, i64 } %r0, i64 %b1, 1
  ret { i64, i64 } %r1
}

define coldcc i128 @ret_i128(i128 %x) nounwind {
; CHECK-LABEL: ret_i128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rsi
; CHECK-NEXT:    pushq %rcx
; CHECK-NEXT:    movaps %xmm0, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    addq $1, %rax
; CHECK-NEXT:    adcq $0, %rsi
; CHECK-NEXT:    movq %rsi, %rdx
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm0 # 16-byte Reload
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    popq %rsi
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{rcx},~{rdx},~{xmm0}"()
  %r = add i128 %x, 1
  ret i128 %r
}

; A third integer return value is returned in RCX.
define coldcc { i64, i64, i64 } @ret_i64_triple(i64 %a, i64 %b, i64 %c) nounwind {
; CHECK-LABEL: ret_i64_triple:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %r8
; CHECK-NEXT:    movaps %xmm0, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    movq %rdx, %r8
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    leaq 1(%rdi), %rax
; CHECK-NEXT:    leaq 2(%rsi), %rdx
; CHECK-NEXT:    addq $3, %r8
; CHECK-NEXT:    movq %r8, %rcx
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm0 # 16-byte Reload
; CHECK-NEXT:    popq %r8
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{rcx},~{rdx},~{xmm0}"()
  %a1 = add i64 %a, 1
  %b1 = add i64 %b, 2
  %c1 = add i64 %c, 3
  %r0 = insertvalue { i64, i64, i64 } poison, i64 %a1, 0
  %r1 = insertvalue { i64, i64, i64 } %r0, i64 %b1, 1
  %r2 = insertvalue { i64, i64, i64 } %r1, i64 %c1, 2
  ret { i64, i64, i64 } %r2
}

; Without a return value, all clobbered registers must be preserved.
define coldcc void @ret_void() nounwind {
; CHECK-LABEL: ret_void:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rdx
; CHECK-NEXT:    pushq %rcx
; CHECK-NEXT:    movaps %xmm1, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    movaps %xmm0, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm0 # 16-byte Reload
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm1 # 16-byte Reload
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    popq %rdx
; CHECK-NEXT:    retq
  call void asm sideeffect "", "~{rcx},~{rdx},~{xmm0},~{xmm1}"()
  ret void
}

; Callers can still keep values across a coldcc call in callee-saved registers
; that are not used for the return value.
define double @call_ret_double(double %x, double %y) nounwind {
; CHECK-LABEL: call_ret_double:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    callq ret_double@PLT
; CHECK-NEXT:    addsd %xmm1, %xmm0
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    retq
  %r = call coldcc double @ret_double(double %x)
  %s = fadd double %r, %y
  ret double %s
}

define i64 @call_ret_i64_pair(i64 %a, i64 %b, i64 %c) nounwind {
; CHECK-LABEL: call_ret_i64_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    movq %rdx, %rcx
; CHECK-NEXT:    callq ret_i64_pair@PLT
; CHECK-NEXT:    addq %rdx, %rcx
; CHECK-NEXT:    movq %rcx, %rax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %p = call coldcc { i64, i64 } @ret_i64_pair(i64 %a, i64 %b)
  %hi = extractvalue { i64, i64 } %p, 1
  %s = add i64 %hi, %c
  ret i64 %s
}
