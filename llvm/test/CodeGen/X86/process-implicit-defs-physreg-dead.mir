tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: succ_livein_super
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $edi = IMPLICIT_DEF
  ; CHECK-NEXT:   $eax = COPY undef $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eax, $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET 0, $eax, $rdi
  bb.0:
    successors: %bb.1

    $edi = IMPLICIT_DEF
    $eax = COPY $edi

  bb.1:
    liveins: $eax, $rdi

    RET 0, $eax, $rdi
...
---
name:            succ_livein_sub
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: succ_livein_sub
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $edi = IMPLICIT_DEF
  ; CHECK-NEXT:   $eax = COPY undef $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $eax, $di
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET 0, $eax, $di
  bb.0:
    successors: %bb.1

    $edi = IMPLICIT_DEF
    $eax = COPY $edi

  bb.1:
    liveins: $eax, $di

    RET 0, $eax, $di
