# RUN: llc -mtriple=x86_64-unknown-linux-gnu -debug-pass-manager -o /dev/null %s \
# RUN:   -passes='machine-function(require<machine-cycles>,dead-mi-elimination,require<machine-cycles>)' 2>&1 \
# RUN:   | FileCheck %s

# DeadMachineInstructionElim preserves the CFG, so MachineCycleAnalysis should
# not be recomputed.
# CHECK: Running analysis: MachineCycleAnalysis on f
# CHECK: Running pass: DeadMachineInstructionElimPass on f
# CHECK-NOT: Invalidating analysis: MachineCycleAnalysis on f
# CHECK-NOT: Running analysis: MachineCycleAnalysis on f

---
name:            f
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32ri 1

  bb.1:
    successors: %bb.1, %bb.2
    JCC_1 %bb.1, 4, implicit undef $eflags

  bb.2:
    RET64
...
