# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=machine-cse -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-- -passes=machine-cse -verify-machineinstrs -o - %s | FileCheck %s

# An INLINEASM_BR can branch to its indirect target before the instructions
# after it run, so the indirect target can't reuse one of them.
---
name: after_inlineasm_br
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: after_inlineasm_br
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, regdef:GR32, def %0, imm, %bb.2
  ; CHECK-NEXT:   [[MOVSX64rr32_:%[0-9]+]]:gr64 = MOVSX64rr32 %0
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $rax = COPY [[MOVSX64rr32_]]
  ; CHECK-NEXT:   RET 0, $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   [[MOVSX64rr32_1:%[0-9]+]]:gr64 = MOVSX64rr32 %0
  ; CHECK-NEXT:   $rax = COPY [[MOVSX64rr32_1]]
  ; CHECK-NEXT:   RET 0, $rax
  bb.0:
    successors: %bb.1, %bb.2

    INLINEASM_BR &"", attdialect, regdef:GR32, def %0:gr32, imm, %bb.2
    %1:gr64 = MOVSX64rr32 %0
    JMP_1 %bb.1

  bb.1:
    $rax = COPY %1
    RET 0, $rax

  bb.2 (inlineasm-br-indirect-target):
    %2:gr64 = MOVSX64rr32 %0
    $rax = COPY %2
    RET 0, $rax
...

# An instruction before the INLINEASM_BR runs on every path.
---
name: before_inlineasm_br
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: before_inlineasm_br
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[MOVSX64rr32_:%[0-9]+]]:gr64 = MOVSX64rr32 [[COPY]]
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.2
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $rax = COPY [[MOVSX64rr32_]]
  ; CHECK-NEXT:   RET 0, $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   $rax = COPY [[MOVSX64rr32_]]
  ; CHECK-NEXT:   RET 0, $rax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi

    %0:gr32 = COPY $edi
    %1:gr64 = MOVSX64rr32 %0
    INLINEASM_BR &"", attdialect, imm, %bb.2
    JMP_1 %bb.1

  bb.1:
    $rax = COPY %1
    RET 0, $rax

  bb.2 (inlineasm-br-indirect-target):
    %2:gr64 = MOVSX64rr32 %0
    $rax = COPY %2
    RET 0, $rax
...
