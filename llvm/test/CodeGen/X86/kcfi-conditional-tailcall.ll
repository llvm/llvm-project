; CHECK-LABEL: f1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq (%rdi), %r11
; CHECK-NEXT:    testq %r11, %r11
; CHECK-NEXT:    je .LBB0_1
; CHECK-NEXT:  # %bb.2: # %if.then
; CHECK-NEXT:    movl $4282621618, %r10d # imm = 0xFF439EB2
; CHECK-NEXT:    addl -4(%r11), %r10d
; CHECK-NEXT:    je .Ltmp0
; CHECK-NEXT:  .Ltmp1:
; CHECK-NEXT:    ud2
  %fp = load ptr, ptr %x, align 8
  %tobool.not = icmp eq ptr %fp, null
  br i1 %tobool.not, label %if.end, label %if.then

if.then:
  tail call void %fp() [ "kcfi"(i32 12345678) ]
  br label %if.end

if.end:
  ret void
}

