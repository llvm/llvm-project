; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; Branching on the borrow out of a two-word subtraction should use a single
; sub/sbb/branch sequence instead of splitting the OR of the two borrow flags
; into two branches.

declare { i64, i1 } @llvm.usub.with.overflow.i64(i64, i64)
declare void @g()

define void @sub_branch(ptr %x, i64 %y0, i64 %y1) {
; CHECK-LABEL: sub_branch:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    subq %rsi, (%rdi)
; CHECK-NEXT:    sbbq %rdx, 8(%rdi)
; CHECK-NEXT:    jae .LBB0_2
; CHECK-NEXT:  # %bb.1: # %call
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    callq g@PLT
; CHECK-NEXT:    popq %rax
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:  .LBB0_2: # %ret
; CHECK-NEXT:    retq
entry:
  %x0 = load i64, ptr %x, align 8
  %t0 = call { i64, i1 } @llvm.usub.with.overflow.i64(i64 %x0, i64 %y0)
  %b0 = extractvalue { i64, i1 } %t0, 1
  %s0 = extractvalue { i64, i1 } %t0, 0
  %b0z = zext i1 %b0 to i64
  store i64 %s0, ptr %x, align 8
  %x1p = getelementptr inbounds i8, ptr %x, i64 8
  %x1 = load i64, ptr %x1p, align 8
  %t1 = call { i64, i1 } @llvm.usub.with.overflow.i64(i64 %x1, i64 %y1)
  %b1 = extractvalue { i64, i1 } %t1, 1
  %s1 = extractvalue { i64, i1 } %t1, 0
  %t2 = call { i64, i1 } @llvm.usub.with.overflow.i64(i64 %s1, i64 %b0z)
  %b2 = extractvalue { i64, i1 } %t2, 1
  %s2 = extractvalue { i64, i1 } %t2, 0
  %borrow = or i1 %b1, %b2
  store i64 %s2, ptr %x1p, align 8
  br i1 %borrow, label %call, label %ret

call:
  call void @g()
  ret void

ret:
  ret void
}
