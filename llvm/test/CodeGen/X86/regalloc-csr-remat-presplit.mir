# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -x mir -mtriple=x86_64-unknown-linux-gnu \
# RUN:   -passes=greedy,virt-reg-rewriter -verify-machineinstrs %s -o - | FileCheck %s

# The LEA result is live through hot blocks and used only by calls in cold
# blocks. Rematerializing it before each call is cheaper than pre-splitting it
# around the calls, so no LEA should stay on the hot path.

--- |
  target triple = "x86_64-unknown-linux-gnu"
  @g = external global i8
  define void @lea_presplit(i32 %c) { ret void }
  define void @lea_csr(i32 %c) { ret void }
  declare void @callee()
  declare void @handler(ptr)
...
---
name: lea_presplit
tracksRegLiveness: true
frameInfo:
  adjustsStack: true
body: |
  ; CHECK-LABEL: name: lea_presplit
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x00800000), %bb.2(0x7f800000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32rr renamable $edi, renamable $edi, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   MOV32mr %stack.0, 1, $noreg, 0, $noreg, killed renamable $edi :: (store (s32) into %stack.0)
  ; CHECK-NEXT:   renamable $rdi = LEA64r $rip, 1, $noreg, @g, $noreg
  ; CHECK-NEXT:   CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  ; CHECK-NEXT:   renamable $edi = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %stack.0)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x00800000), %bb.4(0x7f800000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $eax = ADD32ri renamable $edi, 1, implicit-def dead $eflags
  ; CHECK-NEXT:   TEST32rr killed renamable $eax, renamable $eax, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   MOV32mr %stack.0, 1, $noreg, 0, $noreg, killed renamable $edi :: (store (s32) into %stack.0)
  ; CHECK-NEXT:   renamable $rdi = LEA64r $rip, 1, $noreg, @g, $noreg
  ; CHECK-NEXT:   CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  ; CHECK-NEXT:   renamable $edi = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %stack.0)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x00800000), %bb.6(0x7f800000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $eax = ADD32ri killed renamable $edi, 2, implicit-def dead $eflags
  ; CHECK-NEXT:   TEST32rr killed renamable $eax, renamable $eax, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.6, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.6(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $rdi = LEA64r $rip, 1, $noreg, @g, $noreg
  ; CHECK-NEXT:   CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1(0x00800000), %bb.2(0x7f800000)
    liveins: $edi
    %1:gr32 = COPY $edi
    %0:gr64 = LEA64r $rip, 1, $noreg, @g, $noreg
    TEST32rr %1, %1, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.2(0x80000000)
    $rdi = COPY %0
    CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  bb.2:
    successors: %bb.3(0x00800000), %bb.4(0x7f800000)
    %2:gr32 = ADD32ri %1, 1, implicit-def dead $eflags
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.3
  bb.3:
    successors: %bb.4(0x80000000)
    $rdi = COPY %0
    CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  bb.4:
    successors: %bb.5(0x00800000), %bb.6(0x7f800000)
    %3:gr32 = ADD32ri %1, 2, implicit-def dead $eflags
    TEST32rr %3, %3, implicit-def $eflags
    JCC_1 %bb.6, 4, implicit $eflags
    JMP_1 %bb.5
  bb.5:
    successors: %bb.6(0x80000000)
    $rdi = COPY %0
    CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  bb.6:
    RET 0
...
# The LEA result is live across a call. Rematerializing it in the cold blocks
# avoids the first use of a callee-saved register.
---
name: lea_csr
tracksRegLiveness: true
frameInfo:
  adjustsStack: true
body: |
  ; CHECK-LABEL: name: lea_csr
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x00800000), %bb.2(0x7f800000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ebx = COPY $edi
  ; CHECK-NEXT:   CALL64pcrel32 @callee, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
  ; CHECK-NEXT:   TEST32rr renamable $ebx, renamable $ebx, implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
