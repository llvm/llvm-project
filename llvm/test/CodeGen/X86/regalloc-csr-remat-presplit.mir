    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.3
  bb.3:
    successors: %bb.4(0x80000000)
    $rdi = COPY %0
    CALL64pcrel32 @handler, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit-def $rsp, implicit-def $ssp
  bb.4:
