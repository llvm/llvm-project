define i32 @shl_var_eq(i32 %x, i32 %n, i32 %y) {
; CHECK-LABEL: shl_var_eq:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movl %esi, %ecx
; CHECK-NEXT:    # kill: def $cl killed $cl killed $ecx
; CHECK-NEXT:    shll %cl, %edi
; CHECK-NEXT:    testl %edi, %edi
; CHECK-NEXT:    je .LBB7_1
; CHECK-NEXT:  # %bb.2: # %nonzero
; CHECK-NEXT:    addl %edx, %edi
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB7_1: # %zero
; CHECK-NEXT:    movl $7, %eax
; CHECK-NEXT:    retq
entry:
  %s = shl i32 %x, %n
  %c = icmp eq i32 %s, 0
  br i1 %c, label %zero, label %nonzero
zero:
