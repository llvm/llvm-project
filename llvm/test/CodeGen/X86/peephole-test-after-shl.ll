; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs | FileCheck %s

; A TEST of the result of a SHL by immediate is redundant when only ZF/SF/PF
; are consumed afterwards. For shift counts of 1..3 this holds only if the
; shifted operand has no further uses: otherwise the shift is better kept
; convertible to an LEA (which sets no flags) to avoid a register copy.

; The shifted value is used past the branch, so the compare is not folded
; into a masked TEST at ISel time.
define i32 @shl3_eq_multiuse(i32 %x, i32 %y) {
; CHECK-LABEL: shl3_eq_multiuse:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    shll $3, %edi
; CHECK-NEXT:    je .LBB0_1
; CHECK-NEXT:  # %bb.2: # %nonzero
; CHECK-NEXT:    addl %esi, %edi
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB0_1: # %zero
; CHECK-NEXT:    movl $7, %eax
; CHECK-NEXT:    retq
entry:
  %s = shl i32 %x, 3
  %c = icmp eq i32 %s, 0
  br i1 %c, label %zero, label %nonzero
zero:
  ret i32 7
nonzero:
  %r = add i32 %s, %y
  ret i32 %r
}

; The mask for (x << 3) == 0 does not fit an imm32, so ISel keeps the shift
; even though it is the only use.
define void @shl3_eq_oneuse_64(i64 %x, ptr %p) {
; CHECK-LABEL: shl3_eq_oneuse_64:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    shlq $3, %rdi
; CHECK-NEXT:    je .LBB1_2
; CHECK-NEXT:  # %bb.1: # %store
; CHECK-NEXT:    movq $0, (%rsi)
; CHECK-NEXT:  .LBB1_2: # %done
; CHECK-NEXT:    retq
entry:
  %s = shl i64 %x, 3
  %c = icmp eq i64 %s, 0
  br i1 %c, label %done, label %store
store:
  store i64 0, ptr %p
  br label %done
done:
  ret void
}

