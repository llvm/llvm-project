; Negative test: %x is also returned, so the shift stays LEA-convertible and
; the TEST must survive.
define i32 @shl3_eq_src_reused(i32 %x, i32 %y) {
; CHECK-LABEL: shl3_eq_src_reused:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    # kill: def $edi killed $edi def $rdi
; CHECK-NEXT:    leal (,%rdi,8), %eax
; CHECK-NEXT:    testl %eax, %eax
; CHECK-NEXT:    je .LBB5_1
; CHECK-NEXT:  # %bb.2: # %nonzero
; CHECK-NEXT:    addl %esi, %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB5_1: # %zero
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    retq
entry:
  %s = shl i32 %x, 3
  %c = icmp eq i32 %s, 0
  br i1 %c, label %zero, label %nonzero
zero:
  ret i32 %x
nonzero:
  %r = add i32 %s, %y
  ret i32 %r
}

