  ret i64 %r
}

; The sign flag is valid after a shift by a nonzero immediate.
define i32 @shl2_slt_multiuse(i32 %x, i32 %y) {
; CHECK-LABEL: shl2_slt_multiuse:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    shll $2, %edi
; CHECK-NEXT:    js .LBB3_2
; CHECK-NEXT:  # %bb.1: # %pos
; CHECK-NEXT:    movl $7, %eax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB3_2: # %neg
; CHECK-NEXT:    addl %esi, %edi
; CHECK-NEXT:    movl %edi, %eax
; CHECK-NEXT:    retq
entry:
  %s = shl i32 %x, 2
  %c = icmp slt i32 %s, 0
  br i1 %c, label %neg, label %pos
pos:
  ret i32 7
neg:
  %r = add i32 %s, %y
  ret i32 %r
}

