; CHECK-NEXT:    je .LBB2_1
; CHECK-NEXT:  # %bb.2: # %nonzero
; CHECK-NEXT:    addq %rsi, %rdi
; CHECK-NEXT:    movq %rdi, %rax
; CHECK-NEXT:    retq
; CHECK-NEXT:  .LBB2_1: # %zero
; CHECK-NEXT:    movl $7, %eax
; CHECK-NEXT:    retq
entry:
