define i64 @zext_insert_byte(i32 %x, i32 %y, ptr %p) {
; CHECK-LABEL: zext_insert_byte:
; CHECK:       # %bb.0:
; CHECK-NEXT:    # kill: def $esi killed $esi def $rsi
; CHECK-NEXT:    # kill: def $edi killed $edi def $rdi
; CHECK-NEXT:    leal (%rdi,%rsi), %eax
; CHECK-NEXT:    movb (%rdx), %al
; CHECK-NEXT:    retq
  %s = add i32 %x, %y
  %hi = and i32 %s, -256
  %b = load i8, ptr %p
  %zb = zext i8 %b to i32
  %o = or i32 %hi, %zb
  %z = zext i32 %o to i64
  ret i64 %z
}

