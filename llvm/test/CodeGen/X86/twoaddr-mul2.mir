# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=x86_64-unknown -mcpu=haswell -run-pass=two-address-instruction -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown -mcpu=haswell --passes=two-address-instruction -verify-each %s -o - | FileCheck %s

# Check that ADD32rr of the same register converts to an LEA using a single
# COPY of the source.
---
name: test_mul_by_2
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi

    ; CHECK-LABEL: name: test_mul_by_2
    ; CHECK: liveins: $edi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY killed $edi
    ; CHECK-NEXT: undef %2.sub_32bit:gr64_nosp = COPY [[COPY]]
    ; CHECK-NEXT: [[LEA64_32r:%[0-9]+]]:gr32 = LEA64_32r %2, 1, %2, 0, $noreg
    ; CHECK-NEXT: $eax = COPY [[LEA64_32r]]
    ; CHECK-NEXT: RET 0, killed $eax
    %0:gr32 = COPY killed $edi
    %1:gr32 = ADD32rr %0, %0, implicit-def dead $eflags
    $eax = COPY %1
    RET 0, killed $eax
...
