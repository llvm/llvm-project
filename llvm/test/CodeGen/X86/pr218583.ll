  %xor6 = xor i64 %xor, 1
  %conv2.i = trunc i64 %xor6 to i32
  %call.i = tail call i32 null(i32 %conv2.i)
  %conv3.i = trunc i64 %xor6 to i8
  store i8 %conv3.i, ptr null, align 1
