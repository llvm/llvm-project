# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=i686 -debugify-and-strip-all-safe -run-pass=x86-cmov-conversion %s -o - | FileCheck %s

# The CMOV result is used as the base of a load. A DBG_VALUE of the result must
# not hide that use and let the CMOV be converted to a branch.

---
name:            cmov_pointer_load_debug_use
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: cmov_pointer_load_debug_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $eax, $ecx, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $eax
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $ecx
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr32_nosp = COPY $esi
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.1(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32rm:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 4, [[COPY2]], 0, $noreg :: (load (s32))
  ; CHECK-NEXT:   CMP32ri [[MOV32rm]], 8, implicit-def $eflags
  ; CHECK-NEXT:   [[CMOV32rr:%[0-9]+]]:gr32 = CMOV32rr [[COPY]], [[COPY1]], 13, implicit $eflags
  ; CHECK-NEXT:   dead [[MOV32rm1:%[0-9]+]]:gr32 = MOV32rm [[CMOV32rr]], 4, [[COPY2]], 0, $noreg :: (load (s32))
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1
    liveins: $eax, $ecx, $esi

    %0:gr32 = COPY $eax
    %1:gr32 = COPY $ecx
    %2:gr32_nosp = COPY $esi
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)

    %3:gr32 = MOV32rm %2, 4, %2, 0, $noreg :: (load (s32))
    CMP32ri %3, 8, implicit-def $eflags
    %4:gr32 = CMOV32rr %0, %1, 13, implicit $eflags
    dead %5:gr32 = MOV32rm %4, 4, %2, 0, $noreg :: (load (s32))
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...
