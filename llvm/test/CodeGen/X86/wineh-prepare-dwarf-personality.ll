; RUN: opt < %s -win-eh-prepare -S | FileCheck %s
; RUN: opt < %s -passes=win-eh-prepare -S | FileCheck %s

; On a Dwarf EH target the personality is not scope-based, so
; WinEHPrepare is a no-op.

target triple = "x86_64-unknown-linux-gnu"

define i32 @dwarf_phi(i1 %c) personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: define i32 @dwarf_phi(
; CHECK-SAME: i1 [[C:%.*]]) personality ptr @__gxx_personality_v0 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[LEFT:.*]], label %[[RIGHT:.*]]
; CHECK:       [[LEFT]]:
; CHECK-NEXT:    invoke void @foo()
; CHECK-NEXT:            to label %[[CONT:.*]] unwind label %[[LPAD:.*]]
; CHECK:       [[RIGHT]]:
; CHECK-NEXT:    invoke void @foo()
; CHECK-NEXT:            to label %[[CONT]] unwind label %[[LPAD]]
; CHECK:       [[LPAD]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ 0, %[[LEFT]] ], [ 1, %[[RIGHT]] ]
; CHECK-NEXT:    [[LP:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    call void @bar(i32 [[P]])
; CHECK-NEXT:    resume { ptr, i32 } [[LP]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    ret i32 0
;
entry:
  br i1 %c, label %left, label %right

left:                                             ; preds = %entry
  invoke void @foo()
  to label %cont unwind label %lpad

right:                                            ; preds = %entry
  invoke void @foo()
  to label %cont unwind label %lpad

lpad:                                             ; preds = %left, %right
  %p = phi i32 [ 0, %left ], [ 1, %right ]
  %lp = landingpad { ptr, i32 }
  cleanup
  call void @bar(i32 %p)
  resume { ptr, i32 } %lp

cont:                                             ; preds = %left, %right
  ret i32 0
}

declare void @foo()
declare void @bar(i32)
declare i32 @__gxx_personality_v0(...)
