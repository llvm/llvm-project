; An acyclic branch retains the existing cost model.
define i32 @acyclic_branch(i8 %a, i64 %b) {
; CHECK-LABEL: acyclic_branch:
; CHECK:       # %bb.0:
; CHECK-NEXT:    testb %dil, %dil
; CHECK-NEXT:    setne %al
; CHECK-NEXT:    cmpq $4096, %rsi # imm = 0x1000
; CHECK-NEXT:    sete %cl
; CHECK-NEXT:    orb %al, %cl
; CHECK-NEXT:    cmpb $1, %cl
; CHECK-NEXT:    jne no@PLT # TAILCALL
; CHECK-NEXT:  # %bb.1: # %yes
; CHECK-NEXT:    jmp yes@PLT # TAILCALL
;
; CCMP-LABEL: acyclic_branch:
; CCMP:       # %bb.0:
; CCMP-NEXT:    testb %dil, %dil
; CCMP-NEXT:    ccmpeq {dfv=zf} $4096, %rsi # imm = 0x1000
; CCMP-NEXT:    jne no@PLT # TAILCALL
; CCMP-NEXT:  # %bb.1: # %yes
; CCMP-NEXT:    jmp yes@PLT # TAILCALL
  %x = icmp ne i8 %a, 0
  %y = icmp eq i64 %b, 4096
  %r = select i1 %x, i1 true, i1 %y
