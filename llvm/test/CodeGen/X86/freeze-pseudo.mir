# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -passes=process-implicit-defs -o - %s | FileCheck %s --check-prefix=IMPDEF
# RUN: llc -mtriple=x86_64-- -passes=process-implicit-defs,two-address-instruction,register-coalescer,greedy,virt-reg-rewriter -o - %s | FileCheck %s --check-prefix=RA

# A COPY of an IMPLICIT_DEF is undefined, so each use may read a different
# register. Every use of a FREEZE of an IMPLICIT_DEF reads the same register.

---
name: copy_undef
tracksRegLiveness: true
body: |
  bb.0:
    ; IMPDEF-LABEL: name: copy_undef
    ; IMPDEF: RET 0, implicit undef $eax, implicit undef $ecx
    ;
    ; RA-LABEL: name: copy_undef
    ; RA: RET 0, implicit undef $eax, implicit undef $ecx
    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = COPY %0
    $eax = COPY %1
    $ecx = COPY %1
    RET 0, implicit $eax, implicit $ecx
...
---
name: freeze_undef
tracksRegLiveness: true
body: |
  bb.0:
    ; IMPDEF-LABEL: name: freeze_undef
    ; IMPDEF: [[FREEZE:%[0-9]+]]:gr32 = FREEZE undef %0:gr32
    ; IMPDEF-NEXT: $eax = COPY [[FREEZE]]
    ; IMPDEF-NEXT: $ecx = COPY [[FREEZE]]
    ; IMPDEF-NEXT: RET 0, implicit $eax, implicit $ecx
    ;
    ; RA-LABEL: name: freeze_undef
    ; RA: renamable $eax = FREEZE undef renamable $eax
    ; RA-NEXT: $ecx = COPY renamable $eax
    ; RA-NEXT: RET 0, implicit $eax, implicit $ecx
    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = FREEZE %0
    $eax = COPY %1
    $ecx = COPY %1
    RET 0, implicit $eax, implicit $ecx
...
---
name: freeze_defined
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi

    ; IMPDEF-LABEL: name: freeze_defined
    ; IMPDEF: liveins: $edi
    ; IMPDEF-NEXT: {{  $}}
    ; IMPDEF-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
    ; IMPDEF-NEXT: [[FREEZE:%[0-9]+]]:gr32 = FREEZE [[COPY]]
    ; IMPDEF-NEXT: $eax = COPY [[FREEZE]]
    ; IMPDEF-NEXT: $ecx = COPY [[FREEZE]]
    ; IMPDEF-NEXT: RET 0, implicit $eax, implicit $ecx
    ;
    ; RA-LABEL: name: freeze_defined
    ; RA: liveins: $edi
    ; RA-NEXT: {{  $}}
    ; RA-NEXT: renamable $eax = FREEZE killed renamable $edi
    ; RA-NEXT: $ecx = COPY renamable $eax
    ; RA-NEXT: RET 0, implicit $eax, implicit $ecx
    %0:gr32 = COPY $edi
    %1:gr32 = FREEZE %0
    $eax = COPY %1
    $ecx = COPY %1
    RET 0, implicit $eax, implicit $ecx
...
---
name: freeze_undef_cross_block
tracksRegLiveness: true
body: |
  ; IMPDEF-LABEL: name: freeze_undef_cross_block
  ; IMPDEF: bb.0:
  ; IMPDEF-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; IMPDEF-NEXT:   liveins: $edi
  ; IMPDEF-NEXT: {{  $}}
  ; IMPDEF-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; IMPDEF-NEXT:   [[FREEZE:%[0-9]+]]:gr32 = FREEZE undef %1:gr32
  ; IMPDEF-NEXT:   CMP32rr [[FREEZE]], [[COPY]], implicit-def $eflags
  ; IMPDEF-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; IMPDEF-NEXT:   JMP_1 %bb.1
  ; IMPDEF-NEXT: {{  $}}
  ; IMPDEF-NEXT: bb.1:
  ; IMPDEF-NEXT:   $eax = COPY [[FREEZE]]
  ; IMPDEF-NEXT:   RET 0, implicit $eax
  ; IMPDEF-NEXT: {{  $}}
  ; IMPDEF-NEXT: bb.2:
  ; IMPDEF-NEXT:   $eax = COPY [[COPY]]
  ; IMPDEF-NEXT:   RET 0, implicit $eax
  ;
  ; RA-LABEL: name: freeze_undef_cross_block
  ; RA: bb.0:
  ; RA-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; RA-NEXT:   liveins: $edi
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   renamable $eax = FREEZE undef renamable $eax
  ; RA-NEXT:   CMP32rr renamable $eax, renamable $edi, implicit-def $eflags
  ; RA-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; RA-NEXT:   JMP_1 %bb.1
  ; RA-NEXT: {{  $}}
  ; RA-NEXT: bb.1:
  ; RA-NEXT:   liveins: $eax
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   RET 0, implicit $eax
  ; RA-NEXT: {{  $}}
  ; RA-NEXT: bb.2:
  ; RA-NEXT:   liveins: $edi
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   $eax = COPY killed renamable $edi
  ; RA-NEXT:   RET 0, implicit $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi

    %0:gr32 = COPY $edi
    %1:gr32 = IMPLICIT_DEF
    %2:gr32 = FREEZE %1
    CMP32rr %2, %0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    $eax = COPY %2
    RET 0, implicit $eax

  bb.2:
    $eax = COPY %0
    RET 0, implicit $eax
...
---
name: freeze_partially_undef
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi, $rsi

    ; IMPDEF-LABEL: name: freeze_partially_undef
    ; IMPDEF: liveins: $edi, $rsi
    ; IMPDEF-NEXT: {{  $}}
    ; IMPDEF-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
    ; IMPDEF-NEXT: [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
    ; IMPDEF-NEXT: [[INSERT_SUBREG:%[0-9]+]]:gr64 = INSERT_SUBREG undef %2:gr64, [[COPY]], %subreg.sub_32bit
    ; IMPDEF-NEXT: [[FREEZE:%[0-9]+]]:gr64 = FREEZE [[INSERT_SUBREG]]
    ; IMPDEF-NEXT: MOV64mr [[COPY1]], 1, $noreg, 0, $noreg, [[FREEZE]]
    ; IMPDEF-NEXT: RET 0
    ;
    ; RA-LABEL: name: freeze_partially_undef
    ; RA: liveins: $edi, $rsi
    ; RA-NEXT: {{  $}}
    ; RA-NEXT: renamable $edi = KILL $edi, implicit-def $rdi
    ; RA-NEXT: renamable $rdi = FREEZE killed renamable $rdi
    ; RA-NEXT: MOV64mr killed renamable $rsi, 1, $noreg, 0, $noreg, killed renamable $rdi
    ; RA-NEXT: RET 0
    %0:gr32 = COPY $edi
    %1:gr64 = COPY $rsi
    %2:gr64 = IMPLICIT_DEF
    %3:gr64 = INSERT_SUBREG %2, %0, %subreg.sub_32bit
    %4:gr64 = FREEZE %3
    MOV64mr %1, 1, $noreg, 0, $noreg, %4
    RET 0
...
