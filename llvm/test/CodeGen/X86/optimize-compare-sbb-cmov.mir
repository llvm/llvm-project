# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=peephole-opt -o - %s | FileCheck %s

# Sink EFLAGS' use+def below last use-only, allowing removal of extra compare.

---
name: cond_sub
body: |
  bb.0:
    ; CHECK-LABEL: name: cond_sub
    ; CHECK: [[DEF:%[0-9]+]]:gr64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:gr64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF2:%[0-9]+]]:gr64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
    ; CHECK-NEXT: CMP64rr [[DEF]], [[DEF1]], implicit-def $eflags
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:gr64 = SUBREG_TO_REG [[MOV32r0_]], %subreg.sub_32bit
    ; CHECK-NEXT: [[CMOV64rr:%[0-9]+]]:gr64 = CMOV64rr [[DEF1]], [[SUBREG_TO_REG]], 2, implicit $eflags
    ; CHECK-NEXT: [[SBB64ri32_:%[0-9]+]]:gr64 = SBB64ri32 [[DEF2]], -1, implicit-def dead $eflags, implicit $eflags
    ; CHECK-NEXT: $rax = COPY [[SBB64ri32_]]
    ; CHECK-NEXT: $rcx = COPY [[CMOV64rr]]
    ; CHECK-NEXT: RET 0, $rax, $rcx
    %0:gr64 = IMPLICIT_DEF
    %1:gr64 = IMPLICIT_DEF
    %2:gr64 = IMPLICIT_DEF
    %3:gr64 = SUB64rr %0, %1, implicit-def $eflags
    %4:gr64 = SBB64ri32 %2, -1, implicit-def dead $eflags, implicit $eflags
    %5:gr32 = MOV32r0 implicit-def dead $eflags
    %6:gr64 = SUB64rr %0, %1, implicit-def $eflags
    %7:gr64 = SUBREG_TO_REG %5, %subreg.sub_32bit
    %8:gr64 = CMOV64rr %1, %7, 2, implicit $eflags
    $rax = COPY %4
    $rcx = COPY %8
    RET 0, $rax, $rcx
