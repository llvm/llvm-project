# RUN: llc -mtriple=x86_64-pc-windows-msvc -run-pass=x86-avoid-trailing-call -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-pc-windows-msvc -passes=x86-avoid-trailing-call -verify-machineinstrs %s -o - | FileCheck %s

# A call that falls through to an epilogue in the next block needs a NOP
# in its own block. Branches directly to the epilogue must not execute it.

--- |
  declare void @callee()
  define void @cross_block() { ret void }
...
---
name: cross_block
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    CALL64pcrel32 @callee, csr_win64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp

  bb.1:
    frame-destroy SEH_BeginEpilogue
    RET64

# CHECK-LABEL: name: cross_block
# CHECK:       CALL64pcrel32 @callee
# CHECK-NEXT:  NOOP
# CHECK-NOT:   NOOP
# CHECK:       bb.1:
# CHECK-NEXT:    frame-destroy SEH_BeginEpilogue
...
