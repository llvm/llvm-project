# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=phi-node-elimination -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-- -run-pass=liveintervals,phi-node-elimination -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-- --passes=phi-node-elimination -o - %s | FileCheck %s
# RUN: llc -mtriple=x86_64-- --passes='require<live-intervals>,phi-node-elimination' -verify-each -o - %s | FileCheck %s

# Identical PHIs in different blocks share one incoming register and its
# copies. An EH pad or INLINEASM_BR indirect target must not reuse the copies of
# a block lowered before it: its own go before the call or INLINEASM_BR. A
# block lowered after it can reuse those.

---
name:            landing_pad
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: landing_pad
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp0>
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp1>
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[COPY2]]
  ; CHECK-NEXT:   [[INC64r:%[0-9]+]]:gr64 = INC64r [[COPY3]], implicit-def dead $eflags
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp2>
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[INC64r]]
  ; CHECK-NEXT:   CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp3>
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[INC64r]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (landing-pad):
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp4>
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   $rax = COPY [[COPY4]]
  ; CHECK-NEXT:   RET64 implicit $rax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi

    %0:gr64 = COPY $rdi
    EH_LABEL <mcsymbol .Ltmp0>
    CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
    EH_LABEL <mcsymbol .Ltmp1>
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    %1:gr64 = PHI %0, %bb.0, %2, %bb.1
    %2:gr64 = INC64r %1, implicit-def dead $eflags
    EH_LABEL <mcsymbol .Ltmp2>
    CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
    EH_LABEL <mcsymbol .Ltmp3>
    JMP_1 %bb.1

  bb.2 (landing-pad):
    %3:gr64 = PHI %0, %bb.0, %2, %bb.1
    EH_LABEL <mcsymbol .Ltmp4>
    $rax = COPY %3
    RET64 implicit $rax
...
---
name:            landing_pad_first
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: landing_pad_first
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp0>
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp1>
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (landing-pad):
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp4>
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   $rax = COPY [[COPY2]]
  ; CHECK-NEXT:   RET64 implicit $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[INC64r:%[0-9]+]]:gr64 = INC64r [[COPY3]], implicit-def dead $eflags
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp2>
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[INC64r]]
  ; CHECK-NEXT:   CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol .Ltmp3>
  ; CHECK-NEXT:   JMP_1 %bb.2
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $rdi

    %0:gr64 = COPY $rdi
    EH_LABEL <mcsymbol .Ltmp0>
    CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
    EH_LABEL <mcsymbol .Ltmp1>
    JMP_1 %bb.2

  bb.1 (landing-pad):
    %3:gr64 = PHI %0, %bb.0, %2, %bb.2
    EH_LABEL <mcsymbol .Ltmp4>
    $rax = COPY %3
    RET64 implicit $rax

  bb.2:
    successors: %bb.2, %bb.1

    %1:gr64 = PHI %0, %bb.0, %2, %bb.2
    %2:gr64 = INC64r %1, implicit-def dead $eflags
    EH_LABEL <mcsymbol .Ltmp2>
    CALL64pcrel32 &may_throw, csr_64, implicit $rsp, implicit $ssp
    EH_LABEL <mcsymbol .Ltmp3>
    JMP_1 %bb.2
...
---
name:            inlineasm_br
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: inlineasm_br
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.2
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[COPY2]]
  ; CHECK-NEXT:   [[INC64r:%[0-9]+]]:gr64 = INC64r [[COPY3]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[INC64r]]
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.2
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[INC64r]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   $rax = COPY [[COPY4]]
  ; CHECK-NEXT:   RET64 implicit $rax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $rdi

    %0:gr64 = COPY $rdi
    INLINEASM_BR &"", attdialect, imm, %bb.2
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    %1:gr64 = PHI %0, %bb.0, %2, %bb.1
    %2:gr64 = INC64r %1, implicit-def dead $eflags
    INLINEASM_BR &"", attdialect, imm, %bb.2
    JMP_1 %bb.1

  bb.2 (inlineasm-br-indirect-target):
    %3:gr64 = PHI %0, %bb.0, %2, %bb.1
    $rax = COPY %3
    RET64 implicit $rax
...
---
name:            inlineasm_br_first
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: inlineasm_br_first
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.1
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (inlineasm-br-indirect-target):
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   $rax = COPY [[COPY2]]
  ; CHECK-NEXT:   RET64 implicit $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[INC64r:%[0-9]+]]:gr64 = INC64r [[COPY3]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[INC64r]]
  ; CHECK-NEXT:   INLINEASM_BR &"", attdialect, imm, %bb.1
  ; CHECK-NEXT:   JMP_1 %bb.2
  bb.0:
