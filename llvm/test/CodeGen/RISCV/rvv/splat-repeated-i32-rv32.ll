; A dynamic i64 splat with identical i32 halves can use an e32 vmv.v.x.
define <vscale x 1 x i64> @splat_repeated_i32(i32 %x) {
; CHECK-LABEL: splat_repeated_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetvli a1, zero, e32, m1, ta, ma
; CHECK-NEXT:    vmv.v.x v8, a0
; CHECK-NEXT:    ret
  %low = zext i32 %x to i64
  %high = shl i64 %low, 32
  %repeated = or i64 %low, %high
  %head = insertelement <vscale x 1 x i64> poison, i64 %repeated, i64 0
  %splat = shufflevector <vscale x 1 x i64> %head, <vscale x 1 x i64> poison, <vscale x 1 x i32> zeroinitializer
  ret <vscale x 1 x i64> %splat
}

