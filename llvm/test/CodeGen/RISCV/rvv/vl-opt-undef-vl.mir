# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=riscv-vl-optimizer -o - %s | FileCheck %s

# Make sure there's no crash with an undef operand that has no defining
# instruction.

---
name: undef_vl_user
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_vl_user
    ; CHECK: %x:vr = PseudoVADD_VV_M1 $noreg, $noreg, $noreg, -1 /* vl=VLMAX */, 5 /* e32 */, 0 /* tu, mu */
    ; CHECK-NEXT: %y:vr = PseudoVADD_VV_M1 $noreg, %x, $noreg, undef %vl:gprnox0 /* vl */, 5 /* e32 */, 0 /* tu, mu */
    ; CHECK-NEXT: $v8 = COPY %y
    %x:vr = PseudoVADD_VV_M1 $noreg, $noreg, $noreg, -1, 5 /* e32 */, 0 /* tu, mu */
    %y:vr = PseudoVADD_VV_M1 $noreg, %x, $noreg, undef %vl:gprnox0, 5 /* e32 */, 0 /* tu, mu */
    $v8 = COPY %y
...
