# A register-provided VTYPE can change VL/VILL before the endpoint.
---
name: dynamic_vtype
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $v8m4, $v14m2, $v16m2, $v12m2, $v18, $v19
    ; NOLIS-LABEL: name: dynamic_vtype
