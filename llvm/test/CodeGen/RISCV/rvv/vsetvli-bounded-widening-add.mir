# The generated R preserves VL but sets a different SEW and tail policy.
# RET observes its exact final VL/VTYPE state.
---
name: same_ratio_different_endpoint
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8m4, $v14m2, $v16m2, $v12
    ; COMMON-LABEL: name: same_ratio_different_endpoint
    ; COMMON: liveins: $v8m4, $v14m2, $v16m2, $v12
    ; COMMON-NEXT: {{  $}}
    ; COMMON-NEXT: [[PseudoVSETVLIX0_:%[0-9]+]]:gprnox0 = PseudoVSETVLIX0 $x0, 209 /* e32, m2, ta, ma */, implicit-def $vl, implicit-def $vtype
    ; COMMON-NEXT: $v14m2 = PseudoVMADD_VV_M2 $v14m2, $v16m2, $v16m2, -1 /* vl=VLMAX */, 5 /* e32 */, 1 /* ta, mu */, implicit $vl, implicit $vtype
    ; COMMON-NEXT: dead $x0 = PseudoVSETVLIX0X0 killed $x0, 218 /* e64, m4, ta, ma */, implicit-def $vl, implicit-def $vtype, implicit $vl
    ; COMMON-NEXT: $v8m4 = PseudoVADD_VX_M4 undef $v8m4, $v8m4, [[PseudoVSETVLIX0_]], -1 /* vl=VLMAX */, 6 /* e64 */, 3 /* ta, ma */, implicit $vl, implicit $vtype
    ; COMMON-NEXT: dead $x0 = PseudoVSETVLIX0X0 killed $x0, 136 /* e16, m1, tu, ma */, implicit-def $vl, implicit-def $vtype, implicit $vl
    ; COMMON-NEXT: $v12 = PseudoVADD_VV_M1 $v12, $v12, $v12, -1 /* vl=VLMAX */, 4 /* e16 */, 0 /* tu, mu */, implicit $vl, implicit $vtype
    ; COMMON-NEXT: PseudoRET implicit $v8m4, implicit $v12, implicit $vl, implicit $vtype
    %0:gprnox0 = PseudoVSETVLIX0 $x0, 209, implicit-def $vl, implicit-def $vtype
    $v14m2 = PseudoVMADD_VV_M2 $v14m2, $v16m2, $v16m2, -1, 5, 1
    $v8m4 = PseudoVADD_VX_M4 undef $v8m4, $v8m4, %0, -1, 6, 3
    $v12 = PseudoVADD_VV_M1 $v12, $v12, $v12, -1, 4, 0
    PseudoRET implicit $v8m4, implicit $v12, implicit $vl, implicit $vtype
...

# A normal same-ratio endpoint changes AVL and cannot prove a preserving R.
---
name: normal_changed_avl_endpoint
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8m4, $v14m2, $v16m2
    ; COMMON-LABEL: name: normal_changed_avl_endpoint
    ; COMMON: liveins: $v8m4, $v14m2, $v16m2
