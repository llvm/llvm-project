    ; NOLIS-NEXT: $v12m2 = PseudoVADD_VV_M2 $v12m2, $v14m2, $v12m2, $noreg /* vl */, 5 /* e32 */, 0 /* tu, mu */, implicit $vl, implicit $vtype
