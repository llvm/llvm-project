    ; CHECK-NEXT: dead $x0 = PseudoVSETVLIX0X0 killed $x0, 218 /* e64, m4, ta, ma */, implicit-def $vl, implicit-def $vtype, implicit $vl
    ; CHECK-NEXT: $v8m4 = PseudoVADD_VX_M4 undef $v8m4, $v8m4, [[PseudoVSETVLI]], $noreg /* vl */, 6 /* e64 */, 3 /* ta, ma */, implicit $vl, implicit $vtype
    ; CHECK-NEXT: dead $x0 = VSETVL [[COPY]], $x11, implicit-def $vl, implicit-def $vtype
    ; CHECK-NEXT: dead $x0 = PseudoVSETVLI [[COPY]], 145 /* e32, m2, tu, ma */, implicit-def $vl, implicit-def $vtype
    ; CHECK-NEXT: $v12m2 = PseudoVADD_VV_M2 $v12m2, $v14m2, $v12m2, $noreg /* vl */, 5 /* e32 */, 0 /* tu, mu */, implicit $vl, implicit $vtype
