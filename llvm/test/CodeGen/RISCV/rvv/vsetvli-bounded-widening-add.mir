    ; NOLIS-NEXT: $v8m4 = PseudoVADD_VX_M4 undef $v8m4, $v8m4, [[PseudoVSETVLI]], $noreg /* vl */, 6 /* e64 */, 3 /* ta, ma */, implicit $vl, implicit $vtype
