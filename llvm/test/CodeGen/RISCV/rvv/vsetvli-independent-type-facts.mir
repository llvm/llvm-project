---
name: nested_diamond
tracksRegLiveness: true
body: |
 ; CHECK-LABEL: name: nested_diamond
 ; CHECK: bb.5:
 ; CHECK-NOT: PseudoVSET
 ; CHECK: liveins: $vtype
 ; CHECK-NOT: PseudoVSET
 ; CHECK: PseudoBR %bb.6
 ; CHECK: bb.6:
 ; CHECK-NOT: PseudoVSET
 ; CHECK: liveins: $vtype
 ; CHECK-NOT: PseudoVSET
 ; CHECK: PseudoVMV_X_S
 bb.0:
   successors: %bb.1, %bb.2
   liveins: $x10, $x11, $v8, $v9
   %c:gpr = COPY $x10
   %vl:gprnox0 = COPY $x11
   %x:vr = COPY $v8
   %y:vr = COPY $v9
   BEQ %c, $x0, %bb.2
   PseudoBR %bb.1
 bb.1:
   successors: %bb.3, %bb.4
   %a:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, %vl, 6, 0
   BEQ %c, $x0, %bb.4
   PseudoBR %bb.3
 bb.2:
   successors: %bb.5
   %b:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, 7, 6, 0
   PseudoBR %bb.5
 bb.3:
   successors: %bb.5
   PseudoBR %bb.5
 bb.4:
   successors: %bb.5
   PseudoBR %bb.5
 bb.5:
   successors: %bb.6
   PseudoBR %bb.6
 bb.6:
   %r:gpr = PseudoVMV_X_S %x, 6
   $x10 = COPY %r
   PseudoRET implicit $x10
...
---
name: safe_independent_backedge
tracksRegLiveness: true
body: |
 ; CHECK-LABEL: name: safe_independent_backedge
 ; CHECK: bb.1:
 ; CHECK-NOT: PseudoVSET
 ; CHECK: PseudoVMV_X_S
 bb.0:
   successors: %bb.1
   liveins: $x10, $x11, $v8, $v9
   %c:gpr = COPY $x10
   %vl:gprnox0 = COPY $x11
   %x:vr = COPY $v8
   %y:vr = COPY $v9
   %a:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, %vl, 6, 0
   PseudoBR %bb.1
 bb.1:
   successors: %bb.2
   %r:gpr = PseudoVMV_X_S %x, 6
   PseudoBR %bb.2
 bb.2:
   successors: %bb.1, %bb.3
   %b:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, 7, 6, 0
   BNE %c, $x0, %bb.1
   PseudoBR %bb.3
 bb.3:
   $x10 = COPY %r
   PseudoRET implicit $x10
...
---
name: unsafe_changed_backedge
