# RUN: llc -mtriple=riscv64 -run-pass=riscv-insert-vsetvli -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,NOLIS
# RUN: llc -mtriple=riscv32 -run-pass=riscv-insert-vsetvli -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,NOLIS
# RUN: llc -mtriple=riscv64 -run-pass=slotindexes,riscv-insert-vsetvli -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,NOLIS
# RUN: llc -mtriple=riscv64 -run-pass=liveintervals,riscv-insert-vsetvli -precompute-phys-liveness -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,LIS

# Facts describe the final emitted stream independently of AVL/VL. Each
# negative checks that a join setup survives; positive checks preserve the
# consumer while excluding a setup in its block. The optional-chain tests
# require fixed membership and independently justified batch deletion.

--- |
  target triple = "riscv64"
  define i64 @same_type_different_avl() #0 { ret i64 0 }
  define i64 @same_type_same_avl() #0 { ret i64 0 }
  define i64 @unknown_predecessor() #0 { ret i64 0 }
  define i64 @illegal_explicit() #0 { ret i64 0 }
  define i64 @three_predecessors() #0 { ret i64 0 }
  define i64 @three_one_incompatible() #0 { ret i64 0 }
  define i64 @nested_diamond() #0 { ret i64 0 }
  define i64 @safe_independent_backedge() #0 { ret i64 0 }
  define i64 @unsafe_changed_backedge() #0 { ret i64 0 }
  define i64 @first_iteration_unknown() #0 { ret i64 0 }
  define i64 @later_full_vl() #0 { ret i64 0 }
  define i64 @raw_vl_observer() #0 { ret i64 0 }
  define i64 @different_policy() #0 { ret i64 0 }
  define i64 @different_lmul() #0 { ret i64 0 }
  define i64 @floating_extract() #0 { ret i64 0 }
  define i64 @raw_vstart() #0 { ret i64 0 }
  define i64 @system_observer() #0 { ret i64 0 }
  define i64 @unexpected_extract_operand() #0 { ret i64 0 }
  define i64 @return_state_operand() #0 { ret i64 0 }
  define i64 @later_scalar_memory() #0 { ret i64 0 }
  define i64 @unreachable_scc() #0 { ret i64 0 }
  define i64 @optional_chain_batch() #0 { ret i64 0 }
  define i64 @optional_shields_observer() #0 { ret i64 0 }
  define i64 @different_type_whole_copy() #0 { ret i64 0 }
  define i64 @copy_local_source_producer() #0 { ret i64 0 }
  define i64 @optional_only_backedge() #0 { ret i64 0 }
  define i64 @irreducible_independent_seeds() #0 { ret i64 0 }
  define i64 @zve32x_e32() #1 { ret i64 0 }
  define i64 @zve32x_e64_rejected() #1 { ret i64 0 }
  define i64 @original_call() #0 { ret i64 0 }
  define i64 @original_inline_asm() #0 { ret i64 0 }
  define i64 @original_fault_first() #0 { ret i64 0 }
  define i64 @x0x0_continuation() #0 { ret i64 0 }
  define i64 @unexpected_return_operand() #0 { ret i64 0 }
  define i64 @incompatible_sew_successors() #0 { ret i64 0 }
  define i64 @legal_only_and_sew_successors() #0 { ret i64 0 }
  attributes #0 = { "target-features"="+v" }
  attributes #1 = { "target-features"="-v,-zve64d,-zve64f,-zve64x,+zve32x" }
...
---
name: same_type_different_avl
tracksRegLiveness: true
body: |
 ; CHECK-LABEL: name: same_type_different_avl
 ; CHECK: bb.3:
 ; CHECK-NOT: PseudoVSET
 ; CHECK: PseudoVMV_X_S
 bb.0:
   successors: %bb.1, %bb.2
   liveins: $x10, $x11, $v8, $v9
   %c:gpr = COPY $x10
   %vl:gprnox0 = COPY $x11
   %x:vr = COPY $v8
   %y:vr = COPY $v9
   BEQ %c, $x0, %bb.2
   PseudoBR %bb.1
 bb.1:
   successors: %bb.3
   %a:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, %vl, 6, 0
   PseudoBR %bb.3
 bb.2:
   successors: %bb.3
   %b:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, 0, 6, 0
   PseudoBR %bb.3
 bb.3:
   %r:gpr = PseudoVMV_X_S %x, 6
   $x10 = COPY %r
   PseudoRET implicit $x10
...
---
