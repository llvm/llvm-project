   %r:gpr = PseudoVMV_X_S %x, 6
   PseudoBR %bb.2
 bb.2:
   successors: %bb.1, %bb.3
   %b:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, 7, 5, 0
   BNE %c, $x0, %bb.1
   PseudoBR %bb.3
 bb.3:
   $x10 = COPY %r
   PseudoRET implicit $x10
...
