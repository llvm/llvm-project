 ; CHECK: PseudoVSETIVLI 1,
 ; CHECK: PseudoVMV_X_S
 bb.0:
   successors: %bb.1, %bb.2
   liveins: $x10, $x11, $v8, $v9
   %c:gpr = COPY $x10
   %vl:gprnox0 = COPY $x11
   %x:vr = COPY $v8
   %y:vr = COPY $v9
   BEQ %c, $x0, %bb.2
   PseudoBR %bb.1
 bb.1:
   successors: %bb.3
   %a:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, %vl, 6, 0
   PseudoBR %bb.3
 bb.2:
   successors: %bb.3
   %b:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, 7, 6, 0
   PseudoBR %bb.3
 bb.3:
   %r:gpr = PseudoVMV_X_S %x, 6
   %later:vr = PseudoVADD_VV_M1 undef $noreg, %x, %y, 1, 6, 0
   $v8 = COPY %later
   $x10 = COPY %r
   PseudoRET implicit $x10, implicit $v8
...
