# REQUIRES: asserts
# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=liveintervals,riscv-insert-vsetvli \
# RUN:   -precompute-phys-liveness -verify-machineinstrs -o - %s | FileCheck %s

# Clearing the dead flags on an VSETVLI's VL and VTYPE defs must
# update their physreg live ranges. Otherwise a previously-dead def
# leaves a zero-length dead-def segment referencing the (now non-dead)
# def slot. -precompute-phys-liveness forces the VL/VTYPE ranges to
# exist so the stale segment is exercised.

---
name:            bad_removal
tracksRegLiveness: true
isSSA:           false
body:             |
  bb.0:
    liveins: $v8

    ; CHECK-LABEL: name: bad_removal
    ; CHECK: liveins: $v8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[PseudoVSETIVLI:%[0-9]+]]:gpr = PseudoVSETIVLI 16, 216 /* e64, m1, ta, ma */, implicit-def $vl, implicit-def $vtype
    ; CHECK-NEXT: [[PseudoVMV_X_S:%[0-9]+]]:gpr = PseudoVMV_X_S renamable $v8, 6 /* e64 */, implicit $vtype
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:gpr = ADD [[PseudoVMV_X_S]], [[PseudoVSETIVLI]]
    ; CHECK-NEXT: $x10 = COPY [[ADD]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %1:gpr = PseudoVMV_X_S killed renamable $v8, 6 /* e64 */
    %2:gpr = PseudoVSETIVLI 16, 216 /* e64, m1, ta, ma */, implicit-def dead $vl, implicit-def dead $vtype
    %3:gpr = ADD %1, %2
    $x10 = COPY %3
    PseudoRET implicit $x10
...
