  %e = sext <2 x i64> %x to <2 x i128>
  %c1 = call <2 x i128> @llvm.smax.v2i128(<2 x i128> %e, <2 x i128> splat (i128 -2147483648))
  %c2 = call <2 x i128> @llvm.smin.v2i128(<2 x i128> %c1, <2 x i128> splat (i128 2147483647))
