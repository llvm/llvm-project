# REQUIRES: asserts
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=machine-scheduler \
# RUN:   -misched-prera-direction=topdown -debug-only=machine-scheduler \
# RUN:   -verify-machineinstrs -verify-misched -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=HEURISTIC
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=machine-scheduler \
# RUN:   -misched-prera-direction=bottomup -debug-only=machine-scheduler \
# RUN:   -verify-machineinstrs -verify-misched -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=HEURISTIC
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=machine-scheduler \
# RUN:   -debug-only=machine-scheduler -verify-machineinstrs -verify-misched \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=HEURISTIC
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=machine-scheduler \
# RUN:   -riscv-disable-vector-mask-mutation \
# RUN:   -misched-prera-direction=topdown -debug-only=machine-scheduler \
# RUN:   -verify-machineinstrs -verify-misched -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NO-HEURISTIC

# Check the register-pressure heuristic with VMV0 producers and users. These
# remain virtual through scheduling until register allocation.

# A VMV0 use is ordered before a later LMUL=1 mask producer (B8 denotes LMUL=1
# for a mask). Disabling the heuristic removes this edge; the V0 alias mutation
# does not add it.
# HEURISTIC-LABEL: vmv0_use_before_lmul1_producer:%bb.0
# HEURISTIC: SU(2): {{.*}}%use:vrnov0 = PseudoVMERGE_VIM_M1
# HEURISTIC: Successors:
# HEURISTIC-DAG: SU(4): Ord  Latency=0 Artificial
# HEURISTIC: SU(4): {{.*}}%next:vmv0 = PseudoVMSET_M_B8
# HEURISTIC: Predecessors:
# HEURISTIC-DAG: SU(2): Ord  Latency=0 Artificial
# NO-HEURISTIC-LABEL: vmv0_use_before_lmul1_producer:%bb.0
# NO-HEURISTIC: SU(2): {{.*}}%use:vrnov0 = PseudoVMERGE_VIM_M1
# NO-HEURISTIC: Successors:
# NO-HEURISTIC-NOT: SU(4): Ord  Latency=0 Artificial
# NO-HEURISTIC: Pressure Diff
# NO-HEURISTIC: SU(4): {{.*}}%next:vmv0 = PseudoVMSET_M_B8
# NO-HEURISTIC: Predecessors:
# NO-HEURISTIC-NOT: SU(2): Ord  Latency=0 Artificial
# NO-HEURISTIC: Successors:
---
name: vmv0_use_before_lmul1_producer
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v1, $v8, $x10

    %current:vmv0 = COPY $v1
    %false:vrnov0 = COPY $v8
    %use:vrnov0 = PseudoVMERGE_VIM_M1 undef $noreg, %false, 1, %current, 1, 3
    %avl:gprnox0 = COPY $x10
    %next:vmv0 = PseudoVMSET_M_B8 %avl, 0
    %saved:vr = COPY %next
...

# The equivalent LMUL=8 producer (B1 denotes LMUL=8 for a mask) is deliberately
# left unordered to avoid increasing spill risk.
# HEURISTIC-LABEL: vmv0_use_before_lmul8_producer:%bb.0
# HEURISTIC: SU(2): {{.*}}%use:vrnov0 = PseudoVMERGE_VIM_M1
# HEURISTIC: Successors:
# HEURISTIC-NOT: SU(4): Ord  Latency=0 Artificial
# HEURISTIC: Pressure Diff
# HEURISTIC: SU(4): {{.*}}%next:vmv0 = PseudoVMSET_M_B1
# HEURISTIC: Predecessors:
# HEURISTIC-NOT: SU(2): Ord  Latency=0 Artificial
# HEURISTIC: Successors:
---
name: vmv0_use_before_lmul8_producer
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v1, $v8, $x10

    %current:vmv0 = COPY $v1
    %false:vrnov0 = COPY $v8
    %use:vrnov0 = PseudoVMERGE_VIM_M1 undef $noreg, %false, 1, %current, 1, 3
    %avl:gprnox0 = COPY $x10
    %next:vmv0 = PseudoVMSET_M_B1 %avl, 0
    %saved:vr = COPY %next
...

# With two pending VMV0 producers, order the independent second producer after
# the non-copy use of the first one. This limits overlapping mask live ranges.
# HEURISTIC-LABEL: multiple_vmv0_producers_before_use:%bb.0
# HEURISTIC: SU(3): {{.*}}%second:vmv0 = PseudoVMSET_M_B8
# HEURISTIC: Predecessors:
# HEURISTIC-DAG: SU(5): Ord  Latency=0 Artificial
# HEURISTIC: SU(5): {{.*}}%use:vrnov0 = PseudoVMERGE_VIM_M1
# HEURISTIC: Successors:
# HEURISTIC-DAG: SU(3): Ord  Latency=0 Artificial
# NO-HEURISTIC-LABEL: multiple_vmv0_producers_before_use:%bb.0
# NO-HEURISTIC: SU(3): {{.*}}%second:vmv0 = PseudoVMSET_M_B8
# NO-HEURISTIC: Predecessors:
# NO-HEURISTIC-NOT: SU(5): Ord  Latency=0 Artificial
# NO-HEURISTIC: Successors:
# NO-HEURISTIC: SU(5): {{.*}}%use:vrnov0 = PseudoVMERGE_VIM_M1
# NO-HEURISTIC: Successors:
# NO-HEURISTIC-NOT: SU(3): Ord  Latency=0 Artificial
# NO-HEURISTIC: Pressure Diff
---
name: multiple_vmv0_producers_before_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8, $x10, $x11

    %avl0:gprnox0 = COPY $x10
    %avl1:gprnox0 = COPY $x11
    %first:vmv0 = PseudoVMSET_M_B8 %avl0, 0
    %second:vmv0 = PseudoVMSET_M_B8 %avl1, 0
    %false:vrnov0 = COPY $v8
    %use:vrnov0 = PseudoVMERGE_VIM_M1 undef $noreg, %false, 1, %first, 1, 3
    %saved:vr = COPY %second
...
