# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=register-coalescer -verify-coalescing -o - %s | FileCheck %s

# Removing the copy of the vfmadd result into the accumulator needs the tied
# operand commuted with operand 3, which reads the accumulator. The target's
# preferred partner is operand 2.

---
name: vfmadd_partner_op3
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: vfmadd_partner_op3
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $v8, $v9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $x10
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vr = COPY $v8
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vr = COPY $v9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PseudoVLE32_V_M1_:%[0-9]+]]:vr = PseudoVLE32_V_M1 $noreg, [[COPY]], 4 /* vl */, 5 /* e32 */, 3 /* ta, ma */
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vr = nofpexcept PseudoVFMACC_VV_M1_E32 [[COPY1]], [[COPY2]], [[PseudoVLE32_V_M1_]], 7 /* frm=dyn */, 4 /* vl */, 5 /* e32 */, 3 /* ta, ma */, implicit $frm
  ; CHECK-NEXT:   BNE [[COPY]], $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $v8 = COPY [[COPY1]]
  ; CHECK-NEXT:   PseudoRET implicit $v8
  bb.0:
    liveins: $x10, $v8, $v9

    %0:gpr = COPY $x10
    %1:vr = COPY $v8
    %2:vr = COPY $v9

  bb.1:
    %3:vr = PseudoVLE32_V_M1 $noreg, %0, 4, 5, 3
    %3:vr = nofpexcept PseudoVFMADD_VV_M1_E32 %3, %2, killed %1, 7, 4, 5, 3, implicit $frm
    %1:vr = COPY %3
    BNE %0, $x0, %bb.1

  bb.2:
    $v8 = COPY %1
    PseudoRET implicit $v8
...
