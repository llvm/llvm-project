# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=none \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=BASELINE

# Baseline coverage for post-register-allocation V0 copy chains.

--- |
  define void @compare_m1() { ret void }
  define void @compare_m2() { ret void }
  define void @compare_m4() { ret void }
  define void @compare_m8() { ret void }
  define void @vmv_i() { ret void }
  define void @vmv_s_x() { ret void }
  define void @vlm() { ret void }
  define void @vmand_tied_source() { ret void }
  define void @chain_a() { ret void }
  define void @chain_b() { ret void }
...

---
name: compare_m1
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8
    ; BASELINE-LABEL: name: compare_m1
    ; BASELINE: $v10 = PseudoVMSEQ_VI_M1
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v10
    renamable $v10 = PseudoVMSEQ_VI_M1 killed renamable $v8, 0, -1, 5
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...

---
name: compare_m2
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8m2, $v10m2
    ; BASELINE-LABEL: name: compare_m2
    ; BASELINE: early-clobber renamable $v12 = PseudoVMSEQ_VV_M2
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v12
    early-clobber renamable $v12 = PseudoVMSEQ_VV_M2 killed renamable $v8m2, killed renamable $v10m2, -1, 5
    $v0 = COPY killed renamable $v12
    PseudoRET implicit $v0
...

---
name: compare_m4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8m4, $v12m4
    ; BASELINE-LABEL: name: compare_m4
    ; BASELINE: early-clobber renamable $v16 = PseudoVMSEQ_VV_M4
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v16
    early-clobber renamable $v16 = PseudoVMSEQ_VV_M4 killed renamable $v8m4, killed renamable $v12m4, -1, 5
    $v0 = COPY killed renamable $v16
    PseudoRET implicit $v0
...

---
name: compare_m8
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8m8, $v16m8
    ; BASELINE-LABEL: name: compare_m8
    ; BASELINE: early-clobber renamable $v24 = PseudoVMSEQ_VV_M8
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v24
    early-clobber renamable $v24 = PseudoVMSEQ_VV_M8 killed renamable $v8m8, killed renamable $v16m8, -1, 5
    $v0 = COPY killed renamable $v24
    PseudoRET implicit $v0
...

---
name: vmv_i
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    ; BASELINE-LABEL: name: vmv_i
    ; BASELINE: $v10 = PseudoVMV_V_I_M1 undef renamable $v10
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v10
    renamable $v10 = PseudoVMV_V_I_M1 undef renamable $v10, 0, -1, 3, 0
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...

---
name: vmv_s_x
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $x10
    ; BASELINE-LABEL: name: vmv_s_x
    ; BASELINE: $v10 = PseudoVMV_S_X undef renamable $v10
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v10
    renamable $v10 = PseudoVMV_S_X undef renamable $v10, killed $x10, 1, 5
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...

---
name: vlm
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $x10
    ; BASELINE-LABEL: name: vlm
    ; BASELINE: $v10 = PseudoVLM_V_B8 undef renamable $v10
    ; BASELINE-SAME: :: (load
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v10
    renamable $v10 = PseudoVLM_V_B8 undef renamable $v10, killed $x10, -1, 0, 0 :: (load unknown-size)
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...

---
name: vmand_tied_source
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8, $v10, $vl, $vtype
    ; BASELINE-LABEL: name: vmand_tied_source
    ; BASELINE: $v10 = PseudoVMAND_MM_B64 killed renamable $v8, killed renamable $v10
    ; BASELINE-NEXT: $v0 = COPY renamable $v10, implicit $vtype
    renamable $v10 = PseudoVMAND_MM_B64 killed renamable $v8, killed renamable $v10, -1, 0, implicit $vl, implicit $vtype
    $v0 = COPY renamable $v10, implicit $vtype
    PseudoRET implicit $v0
...

---
name: chain_a
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v0, $v8, $v9
    ; BASELINE-LABEL: name: chain_a
    ; BASELINE: $v10 = COPY renamable $v0
    ; BASELINE-NEXT: $v10 = PseudoVMFLT_VV_MF4_MASK
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v10
    renamable $v10 = COPY renamable $v0
    renamable $v10 = PseudoVMFLT_VV_MF4_MASK killed renamable $v10, killed renamable $v8, killed renamable $v9, killed renamable $v0, -1, 4, 1
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...

---
name: chain_b
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8, $v9, $v10
    ; BASELINE-LABEL: name: chain_b
    ; BASELINE: $v0 = COPY renamable $v10
    ; BASELINE-NEXT: $v10 = PseudoVMFLT_VV_MF4_MASK
    ; BASELINE-NEXT: $v0 = COPY killed renamable $v10
    renamable $v0 = COPY renamable $v10
    renamable $v10 = PseudoVMFLT_VV_MF4_MASK killed renamable $v10, killed renamable $v8, killed renamable $v9, killed renamable $v0, -1, 4, 1
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...
