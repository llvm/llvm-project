    ; CHECK-LABEL: name: nonadjacent_vset_read
    ; CHECK: $v0 = PseudoVMSEQ_VI_M1
    ; CHECK-NEXT: dead renamable $v13 = PseudoVADD_VV_M1
    ; CHECK-NOT: $v0 = COPY
    renamable $v10 = PseudoVMSEQ_VI_M1 killed renamable $v8, 0, -1, 5, implicit $vl, implicit $vtype
    dead renamable $v13 = PseudoVADD_VV_M1 undef $v13, killed renamable $v11, killed renamable $v12, -1, 5, 0, implicit $vl, implicit $vtype
    $v0 = COPY killed renamable $v10, implicit $vl, implicit $vtype
    PseudoRET implicit $v0
...

