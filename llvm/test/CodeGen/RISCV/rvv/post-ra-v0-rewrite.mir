# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=riscv-post-ra-v0-rewrite \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=riscv64 -mattr=+v -enable-new-pm \
# RUN:   -passes=riscv-post-ra-v0-rewrite -verify-machineinstrs -o - %s | \
# RUN:   FileCheck %s

--- |
  define void @nonadjacent_scalar() { ret void }
  define void @nonadjacent_unordered_load() { ret void }
  define void @keep_nonadjacent_volatile_load() { ret void }
  define void @keep_nonadjacent_ordered_load() { ret void }
  define void @nonadjacent_vset_read() { ret void }
  define void @nonadjacent_scan_limit() { ret void }
  define void @keep_nonadjacent_vl_vtype_def() { ret void }
  define void @keep_nonadjacent_d_read() { ret void }
  define void @keep_nonadjacent_d_def() { ret void }
  define void @keep_nonadjacent_v0_read() { ret void }
  define void @keep_nonadjacent_v0_def() { ret void }
  define void @keep_nonadjacent_regmask() { ret void }
  define void @keep_nonadjacent_bundle() { ret void }
  define void @keep_nonadjacent_debug_number() { ret void }
  define void @keep_nonadjacent_probe() { ret void }
  define void @keep_nonadjacent_scan_cap() { ret void }
  define void @producer_compare() { ret void }
  define void @producer_vmv_i() { ret void }
  define void @producer_vmv_s_x() { ret void }
  define void @producer_vlm() { ret void }
  define void @producer_slidedown_vx() { ret void }
  define void @producer_slidedown_vi() { ret void }
  define void @producer_vle64() { ret void }
  define void @keep_slidedown_nonundef() { ret void }
  define void @keep_slidedown_masked() { ret void }
  define void @keep_slidedown_v0_source() { ret void }
  define void @keep_vle64_nonundef() { ret void }
  define void @keep_vle64_masked() { ret void }
  define void @producer_copy_vtype() { ret void }
  define void @producer_copy_vl_vtype() { ret void }
  define void @producer_vmand_tied_source() { ret void }
  define void @producer_vmand_both_tied_sources() { ret void }
  define void @producer_vmand_untied_sources() { ret void }
  define void @keep_vmand_live_source() { ret void }
  define void @keep_vmand_v0_source() { ret void }
  define void @producer_compare_m2() { ret void }
  define void @producer_compare_m4() { ret void }
  define void @producer_compare_m8() { ret void }
  define void @keep_compare_m8_v0_overlap() { ret void }
  define void @chain_a() { ret void }
  define void @chain_b() { ret void }
  define void @chain_copy_vtype() { ret void }
  define void @chain_b_copy_vl_vtype() { ret void }
  define void @two_kinds() { ret void }
  define void @keep_live() { ret void }
  define void @keep_masked_producer() { ret void }
  define void @keep_tied_live() { ret void }
  define void @keep_lr_split() { ret void }
  define void @keep_debug_between() !dbg !4 { ret void }
  define void @keep_debug_before() !dbg !10 { ret void }
  define void @keep_debug_after() !dbg !16 { ret void }
  define void @keep_probe() { ret void }
  define void @keep_bundle() { ret void }
  define void @keep_flagged_copy() { ret void }
  define void @keep_internal_read_copy() { ret void }
  define void @keep_internal_read_copy_source() { ret void }
  define void @keep_copy_vl() { ret void }
  define void @keep_copy_vtype_def() { ret void }
  define void @keep_copy_vtype_unshared() { ret void }
  define void @keep_chain_copy_vl() { ret void }
  define void @keep_chain_debug_after() !dbg !22 { ret void }
  define void @keep_chain_probe() { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "llc", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "post-ra-v0-rewrite.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !{i32 2, !"Dwarf Version", i32 4}
  !4 = distinct !DISubprogram(name: "keep_debug_between", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
  !5 = !DISubroutineType(types: !6)
  !6 = !{null}
  !7 = !DILocalVariable(name: "between", scope: !4, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !4)
  !10 = distinct !DISubprogram(name: "keep_debug_before", scope: !1, file: !1, line: 2, type: !5, scopeLine: 2, spFlags: DISPFlagDefinition, unit: !0)
  !11 = !DILocalVariable(name: "before", scope: !10, file: !1, line: 2, type: !8)
  !12 = !DILocation(line: 2, column: 1, scope: !10)
  !16 = distinct !DISubprogram(name: "keep_debug_after", scope: !1, file: !1, line: 3, type: !5, scopeLine: 3, spFlags: DISPFlagDefinition, unit: !0)
  !17 = !DILocalVariable(name: "after", scope: !16, file: !1, line: 3, type: !8)
  !18 = !DILocation(line: 3, column: 1, scope: !16)
  !22 = distinct !DISubprogram(name: "keep_chain_debug_after", scope: !1, file: !1, line: 4, type: !5, scopeLine: 4, spFlags: DISPFlagDefinition, unit: !0)
  !23 = !DILocalVariable(name: "chain_after", scope: !22, file: !1, line: 4, type: !8)
  !24 = !DILocation(line: 4, column: 1, scope: !22)
...
---
name: nonadjacent_scalar
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8, $x10

    ; CHECK-LABEL: name: nonadjacent_scalar
    ; CHECK: $v0 = PseudoVMSEQ_VI_M1
    ; CHECK-NEXT: dead $x11 = ADDI
    ; CHECK-NOT: $v0 = COPY
    renamable $v10 = PseudoVMSEQ_VI_M1 killed renamable $v8, 0, -1, 5
    dead $x11 = ADDI killed $x10, 1
    $v0 = COPY killed renamable $v10
    PseudoRET implicit $v0
...

---
name: nonadjacent_unordered_load
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8, $x10, $vl, $vtype

    ; CHECK-LABEL: name: nonadjacent_unordered_load
    ; CHECK: $v0 = PseudoVMSEQ_VI_M1
    ; CHECK-NEXT: dead $x11 = LW
    ; CHECK-NOT: $v0 = COPY
    renamable $v10 = PseudoVMSEQ_VI_M1 killed renamable $v8, 0, -1, 5, implicit $vl, implicit $vtype
    dead $x11 = LW killed $x10, 0 :: (load (s32))
    $v0 = COPY killed renamable $v10, implicit $vl, implicit $vtype
    PseudoRET implicit $v0
...

---
name: keep_nonadjacent_volatile_load
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $v8, $x10, $vl, $vtype

    ; CHECK-LABEL: name: keep_nonadjacent_volatile_load
    ; CHECK: $v10 = PseudoVMSEQ_VI_M1
    ; CHECK-NEXT: dead $x11 = LW
    ; CHECK-NEXT: $v0 = COPY killed {{(renamable )?}}$v10
    renamable $v10 = PseudoVMSEQ_VI_M1 killed renamable $v8, 0, -1, 5, implicit $vl, implicit $vtype
    dead $x11 = LW killed $x10, 0 :: (volatile load (s32))
    $v0 = COPY killed renamable $v10, implicit $vl, implicit $vtype
    PseudoRET implicit $v0
...

