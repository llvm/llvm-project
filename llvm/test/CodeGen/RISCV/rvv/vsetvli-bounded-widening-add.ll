; Derived from JM's IntraChromaPrediction vector loop. Accumulate weighted
; differences of a forward and a reverse i16 input using an i64 induction vector.
; The vector length is zero-extended from i32 before updating the indices.

define i32 @bounded_widening_add(i32 %count, ptr %forward, ptr %reverse) {
; CHECK-LABEL: bounded_widening_add:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    sext.w a3, a0
; CHECK-NEXT:    beqz a3, .LBB0_4
; CHECK-NEXT:  # %bb.1: # %preheader
; CHECK-NEXT:    li a3, 0
; CHECK-NEXT:    vsetvli a4, zero, e64, m4, ta, ma
; CHECK-NEXT:    vid.v v8
; CHECK-NEXT:    vsetvli zero, zero, e32, m2, ta, ma
; CHECK-NEXT:    vmv.v.i v12, 0
; CHECK-NEXT:    slli a0, a0, 32
; CHECK-NEXT:    srli a0, a0, 32
; CHECK-NEXT:    li a4, -2
; CHECK-NEXT:  .LBB0_2: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    vsetvli a5, a0, e32, m2, ta, ma
; CHECK-NEXT:    sub a0, a0, a5
; CHECK-NEXT:    slli a6, a5, 1
; CHECK-NEXT:    slli a7, a0, 1
; CHECK-NEXT:    add a6, a6, a2
; CHECK-NEXT:    add a6, a6, a7
; CHECK-NEXT:    addi a6, a6, -2
; CHECK-NEXT:    vlse16.v v18, (a6), a4
; CHECK-NEXT:    vnsrl.wi v14, v8, 0
; CHECK-NEXT:    slli a6, a3, 1
; CHECK-NEXT:    add a6, a1, a6
; CHECK-NEXT:    vle16.v v19, (a6)
; CHECK-NEXT:    vsetvli zero, zero, e16, m1, ta, ma
; CHECK-NEXT:    vwsubu.vv v16, v19, v18
; CHECK-NEXT:    vsetvli zero, zero, e32, m2, ta, ma
; CHECK-NEXT:    vmadd.vv v14, v16, v16
; CHECK-NEXT:    vsetvli zero, zero, e64, m4, ta, ma
; CHECK-NEXT:    vadd.vx v8, v8, a5
; CHECK-NEXT:    vsetvli zero, zero, e32, m2, tu, ma
; CHECK-NEXT:    vadd.vv v12, v14, v12
; CHECK-NEXT:    add a3, a3, a5
; CHECK-NEXT:    bnez a0, .LBB0_2
; CHECK-NEXT:  # %bb.3: # %exit
; CHECK-NEXT:    vsetvli a0, zero, e32, m2, ta, ma
; CHECK-NEXT:    vmv.s.x v8, zero
; CHECK-NEXT:    vredsum.vs v8, v12, v8
; CHECK-NEXT:    vmv.x.s a0, v8
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_4: # %return.zero
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    ret
entry:
  %empty = icmp eq i32 %count, 0
  br i1 %empty, label %return.zero, label %preheader

preheader:
  %trip.count = zext i32 %count to i64
  %initial.indices = call <vscale x 4 x i64> @llvm.stepvector.nxv4i64()
  br label %loop

loop:
  %index = phi i64 [ 0, %preheader ], [ %index.next, %loop ]
  %indices = phi <vscale x 4 x i64> [ %initial.indices, %preheader ], [ %indices.next, %loop ]
  %acc = phi <vscale x 4 x i32> [ zeroinitializer, %preheader ], [ %acc.next, %loop ]
  %remaining = phi i64 [ %trip.count, %preheader ], [ %remaining.next, %loop ]
  %vl = call i32 @llvm.experimental.get.vector.length.i64(i64 %remaining, i32 4, i1 true)
  %step = zext i32 %vl to i64
  %step.insert = insertelement <vscale x 4 x i64> zeroinitializer, i64 %step, i64 0
  %step.splat = shufflevector <vscale x 4 x i64> %step.insert, <vscale x 4 x i64> zeroinitializer, <vscale x 4 x i32> zeroinitializer
  %forward.ptr = getelementptr i16, ptr %forward, i64 %index
  %forward16 = call <vscale x 4 x i16> @llvm.vp.load.nxv4i16.p0(ptr align 2 %forward.ptr, <vscale x 4 x i1> splat (i1 true), i32 %vl)
  %forward32 = zext <vscale x 4 x i16> %forward16 to <vscale x 4 x i32>
  %reverse.index = sub i64 %remaining, %step
  %reverse.ptr = getelementptr i16, ptr %reverse, i64 %reverse.index
  %reverse16 = call <vscale x 4 x i16> @llvm.vp.load.nxv4i16.p0(ptr align 2 %reverse.ptr, <vscale x 4 x i1> splat (i1 true), i32 %vl)
  %reversed = call <vscale x 4 x i16> @llvm.experimental.vp.reverse.nxv4i16(<vscale x 4 x i16> %reverse16, <vscale x 4 x i1> splat (i1 true), i32 %vl)
  %reverse32 = zext <vscale x 4 x i16> %reversed to <vscale x 4 x i32>
  %difference = sub <vscale x 4 x i32> %forward32, %reverse32
  %indices32 = trunc <vscale x 4 x i64> %indices to <vscale x 4 x i32>
  %offsets = add <vscale x 4 x i32> %indices32, splat (i32 1)
  %products = mul <vscale x 4 x i32> %difference, %offsets
  %sum = add <vscale x 4 x i32> %products, %acc
  %acc.next = call <vscale x 4 x i32> @llvm.vp.merge.nxv4i32(<vscale x 4 x i1> splat (i1 true), <vscale x 4 x i32> %sum, <vscale x 4 x i32> %acc, i32 %vl)
  %index.next = add i64 %index, %step
  %remaining.next = sub i64 %remaining, %step
  %indices.next = add <vscale x 4 x i64> %indices, %step.splat
  %done = icmp eq i64 %remaining.next, 0
  br i1 %done, label %exit, label %loop

exit:
  %result = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %acc.next)
  ret i32 %result

return.zero:
  ret i32 0
}

