; RUN: llc -mtriple=riscv64 -mattr=+v < %s | FileCheck %s

; Every use of a frozen value must observe the same value.

; Element 1 is poison before the freeze. The result must be 0.
define i32 @partial_vector(i32 %x) {
; CHECK-LABEL: partial_vector:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 4, e32, m1, ta, ma
; CHECK-NEXT:    vmv.v.x v8, a0
; CHECK-NEXT:    vadd.vx v8, v8, a0
; CHECK-NEXT:    vslidedown.vi v8, v8, 1
; CHECK-NEXT:    vmv.x.s a0, v8
; CHECK-NEXT:    add a1, a0, a0
; CHECK-NEXT:    subw a0, a0, a1
; CHECK-NEXT:    ret
  %v = insertelement <4 x i32> poison, i32 %x, i32 0
  %w = freeze <4 x i32> %v
  %y = add <4 x i32> %w, %w
  %e = extractelement <4 x i32> %w, i32 1
  %e2 = extractelement <4 x i32> %y, i32 1
  %r = sub i32 %e2, %e
  %q = sub i32 %r, %e
  ret i32 %q
}

; The returned value must be the one passed to @usev.
define <4 x i32> @vec_across_call() nounwind {
; CHECK-LABEL: vec_across_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    call usev
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    ret
  %w = freeze <4 x i32> poison
  call void @usev(<4 x i32> %w)
  ret <4 x i32> %w
}

declare void @usev(<4 x i32>)
