# The formal ADDI definition cannot change x0's architectural zero value.

---
name:            bne_x0_is_zero
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: bne_x0_is_zero
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = ADDI $x0, 9
  ; CHECK-NEXT:   BNE $x0, $x10, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $x10 = ADDI $x0, 9
  ; CHECK-NEXT:   PseudoRET implicit $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $x10
    $x0 = ADDI $x0, 9
    BNE $x0, $x10, %bb.2
    PseudoBR %bb.1
  bb.1:
    $x10 = ADDI $x0, 9
    PseudoRET implicit $x10
  bb.2:
    PseudoRET
...


