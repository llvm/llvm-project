  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10
    $x11 = ADDI $x0, 7
    BEQ $x11, killed $x10, %bb.1
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    $x10 = ADDI $x0, 7
    PseudoRET implicit $x10
  bb.2:
    PseudoRET
...


