; RV32-NEXT:    li s4, 0
; RV32-NEXT:    li s5, 0
; RV32-NEXT:    li s6, 0
; RV32-NEXT:    li s7, 0
; RV32-NEXT:    call next_handler
; RV32-NEXT:    lw ra, 44(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s2, 40(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s3, 36(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s4, 32(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s5, 28(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s6, 24(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s7, 20(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s8, 16(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s9, 12(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s10, 8(sp) # 4-byte Folded Reload
; RV32-NEXT:    lw s11, 4(sp) # 4-byte Folded Reload
; RV32-NEXT:    addi sp, sp, 48
; RV32-NEXT:    ret
;
; RV64-LABEL: no_tail_from_standard:
; RV64:       # %bb.0: # %entry
; RV64-NEXT:    addi sp, sp, -96
; RV64-NEXT:    sd ra, 88(sp) # 8-byte Folded Spill
; RV64-NEXT:    sd s2, 80(sp) # 8-byte Folded Spill
; RV64-NEXT:    sd s3, 72(sp) # 8-byte Folded Spill
