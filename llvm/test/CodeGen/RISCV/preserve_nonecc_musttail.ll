; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv32 < %s | FileCheck %s -check-prefix=RV32
; RUN: llc -mtriple=riscv64 < %s | FileCheck %s -check-prefix=RV64

; Check musttail between preserve_none functions, as used by interpreters that
; dispatch through a table of handlers: no callee-saved registers are saved or
; restored, the interpreter state stays in s2-s5 across the call to a standard
; function, and the handler is reached with an indirect jump.

@handlers = external global [256 x ptr]
declare void @standard_cc_func(i64)
declare preserve_nonecc i64 @next_handler(ptr, ptr, i64, i64)

define preserve_nonecc i64 @direct(ptr %frame, ptr %pc, i64 %acc, i64 %oparg) nounwind {
; RV32-LABEL: direct:
; RV32:       # %bb.0: # %entry
; RV32-NEXT:    add a0, s4, s6
; RV32-NEXT:    add s5, s5, s7
; RV32-NEXT:    sltu a1, a0, s4
; RV32-NEXT:    add s5, s5, a1
; RV32-NEXT:    mv s4, a0
; RV32-NEXT:    tail next_handler
;
; RV64-LABEL: direct:
; RV64:       # %bb.0: # %entry
; RV64-NEXT:    add s4, s4, s5
; RV64-NEXT:    tail next_handler
entry:
  %acc2 = add i64 %acc, %oparg
  %r = musttail call preserve_nonecc i64 @next_handler(ptr %frame, ptr %pc, i64 %acc2, i64 %oparg)
  ret i64 %r
}

define preserve_nonecc i64 @dispatch(ptr %frame, ptr %pc, i64 %acc, i64 %oparg) nounwind {
; RV32-LABEL: dispatch:
; RV32:       # %bb.0: # %entry
; RV32-NEXT:    addi sp, sp, -16
; RV32-NEXT:    sw ra, 12(sp) # 4-byte Folded Spill
; RV32-NEXT:    mv a0, s4
; RV32-NEXT:    mv a1, s5
; RV32-NEXT:    call standard_cc_func
; RV32-NEXT:    lbu a0, 0(s3)
; RV32-NEXT:    slli a0, a0, 2
; RV32-NEXT:    lui a1, %hi(handlers)
; RV32-NEXT:    addi a1, a1, %lo(handlers)
; RV32-NEXT:    add a0, a1, a0
; RV32-NEXT:    addi s3, s3, 2
; RV32-NEXT:    lw t1, 0(a0)
; RV32-NEXT:    lw ra, 12(sp) # 4-byte Folded Reload
; RV32-NEXT:    addi sp, sp, 16
; RV32-NEXT:    jr t1
;
; RV64-LABEL: dispatch:
; RV64:       # %bb.0: # %entry
; RV64-NEXT:    addi sp, sp, -16
; RV64-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; RV64-NEXT:    mv a0, s4
; RV64-NEXT:    call standard_cc_func
; RV64-NEXT:    lbu a0, 0(s3)
; RV64-NEXT:    slli a0, a0, 3
; RV64-NEXT:    lui a1, %hi(handlers)
; RV64-NEXT:    addi a1, a1, %lo(handlers)
; RV64-NEXT:    add a0, a1, a0
; RV64-NEXT:    ld t1, 0(a0)
; RV64-NEXT:    addi s3, s3, 2
; RV64-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; RV64-NEXT:    addi sp, sp, 16
; RV64-NEXT:    jr t1
entry:
  call void @standard_cc_func(i64 %acc)
  %op = load i8, ptr %pc
  %next = getelementptr i8, ptr %pc, i64 2
  %idx = zext i8 %op to i64
  %slot = getelementptr [256 x ptr], ptr @handlers, i64 0, i64 %idx
  %h = load ptr, ptr %slot
  %r = musttail call preserve_nonecc i64 %h(ptr %frame, ptr %next, i64 %acc, i64 %oparg)
  ret i64 %r
}

; All 18 argument registers are live at an indirect tail call: the target has
; to be in one of the temporaries. The arguments are pointers so that they
; all fit in registers on both RV32 and RV64; musttail with stack-passed
; arguments is deliberately not covered here.
define preserve_nonecc void @dispatch18(ptr %h, ptr %a1, ptr %a2, ptr %a3, ptr %a4, ptr %a5, ptr %a6, ptr %a7, ptr %a8, ptr %a9, ptr %a10, ptr %a11, ptr %a12, ptr %a13, ptr %a14, ptr %a15, ptr %a16, ptr %a17) nounwind {
; RV32-LABEL: dispatch18:
; RV32:       # %bb.0: # %entry
; RV32-NEXT:    mv t1, s2
; RV32-NEXT:    jr t1
;
; RV64-LABEL: dispatch18:
; RV64:       # %bb.0: # %entry
; RV64-NEXT:    mv t1, s2
; RV64-NEXT:    jr t1
entry:
  musttail call preserve_nonecc void %h(ptr %h, ptr %a1, ptr %a2, ptr %a3, ptr %a4, ptr %a5, ptr %a6, ptr %a7, ptr %a8, ptr %a9, ptr %a10, ptr %a11, ptr %a12, ptr %a13, ptr %a14, ptr %a15, ptr %a16, ptr %a17)
  ret void
}

; A (non-must) tail call from preserve_none to a standard function is fine:
; the callee preserves everything the caller has to.
define preserve_nonecc void @tail_to_standard(i64 %a) nounwind {
; RV32-LABEL: tail_to_standard:
; RV32:       # %bb.0: # %entry
; RV32-NEXT:    mv a1, s3
; RV32-NEXT:    mv a0, s2
; RV32-NEXT:    tail standard_cc_func
;
; RV64-LABEL: tail_to_standard:
; RV64:       # %bb.0: # %entry
; RV64-NEXT:    mv a0, s2
; RV64-NEXT:    tail standard_cc_func
entry:
  tail call void @standard_cc_func(i64 %a)
  ret void
}

