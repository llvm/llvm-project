; RV32-NEXT:    sw s3, 36(sp) # 4-byte Folded Spill
; RV32-NEXT:    sw s4, 32(sp) # 4-byte Folded Spill
; RV32-NEXT:    sw s5, 28(sp) # 4-byte Folded Spill
; RV32-NEXT:    sw s6, 24(sp) # 4-byte Folded Spill
