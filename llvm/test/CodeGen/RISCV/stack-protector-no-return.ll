; RUN: llc -mtriple=riscv64-unknown-linux-gnu -verify-machineinstrs < %s | FileCheck %s

;; The guard is checked before a call to a noreturn function that may unwind,
;; as well as before the return.

declare void @fill(ptr)
declare void @__cxa_throw(ptr, ptr, ptr) noreturn
declare void @abort() noreturn nounwind
declare i32 @__gxx_personality_v0(...)

define i32 @check_before_throw(i32 %c) sspstrong {
; CHECK-LABEL: check_before_throw:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -96
; CHECK-NEXT:    .cfi_def_cfa_offset 96
; CHECK-NEXT:    sd ra, 88(sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd s0, 80(sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd s1, 72(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    .cfi_offset s0, -16
; CHECK-NEXT:    .cfi_offset s1, -24
; CHECK-NEXT:    .cfi_remember_state
; CHECK-NEXT:    lui s0, %hi(__stack_chk_guard)
; CHECK-NEXT:    ld a1, %lo(__stack_chk_guard)(s0)
; CHECK-NEXT:    sext.w s1, a0
; CHECK-NEXT:    sd a1, 64(sp)
; CHECK-NEXT:    mv a0, sp
; CHECK-NEXT:    call fill
; CHECK-NEXT:    beqz s1, .LBB0_3
; CHECK-NEXT:  # %bb.1: # %ok
; CHECK-NEXT:    ld a0, %lo(__stack_chk_guard)(s0)
; CHECK-NEXT:    ld a1, 64(sp)
; CHECK-NEXT:    bne a0, a1, .LBB0_5
; CHECK-NEXT:  # %bb.2: # %ok
; CHECK-NEXT:    li a0, 1
; CHECK-NEXT:    ld ra, 88(sp) # 8-byte Folded Reload
; CHECK-NEXT:    ld s0, 80(sp) # 8-byte Folded Reload
; CHECK-NEXT:    ld s1, 72(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    .cfi_restore s0
; CHECK-NEXT:    .cfi_restore s1
; CHECK-NEXT:    addi sp, sp, 96
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_3: # %throw
; CHECK-NEXT:    .cfi_restore_state
; CHECK-NEXT:    ld a0, %lo(__stack_chk_guard)(s0)
; CHECK-NEXT:    ld a1, 64(sp)
; CHECK-NEXT:    bne a0, a1, .LBB0_6
; CHECK-NEXT:  # %bb.4: # %SP_return
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    li a1, 0
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:    call __cxa_throw
; CHECK-NEXT:  .LBB0_5: # %ok
; CHECK-NEXT:    call __stack_chk_fail
; CHECK-NEXT:  .LBB0_6: # %CallStackCheckFailBlk
; CHECK-NEXT:    call __stack_chk_fail
entry:
  %buf = alloca [64 x i8], align 1
  call void @fill(ptr %buf)
  %t = icmp eq i32 %c, 0
  br i1 %t, label %throw, label %ok

throw:
  call void @__cxa_throw(ptr null, ptr null, ptr null)
  unreachable

ok:
  ret i32 1
}

;; Also when the call is an invoke.
define void @check_before_invoke() sspreq personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: check_before_invoke:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    .cfi_remember_state
; CHECK-NEXT:    lui a0, %hi(__stack_chk_guard)
; CHECK-NEXT:    ld a1, %lo(__stack_chk_guard)(a0)
; CHECK-NEXT:    sd a1, 0(sp)
; CHECK-NEXT:    ld a0, %lo(__stack_chk_guard)(a0)
; CHECK-NEXT:    ld a1, 0(sp)
; CHECK-NEXT:    bne a0, a1, .LBB1_3
; CHECK-NEXT:  # %bb.1: # %SP_return
; CHECK-NEXT:  .Ltmp0: # EH_LABEL
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    li a1, 0
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:    call __cxa_throw
; CHECK-NEXT:  .Ltmp1: # EH_LABEL
; CHECK-NEXT:  # %bb.2: # %cont
; CHECK-NEXT:  .LBB1_3: # %CallStackCheckFailBlk
; CHECK-NEXT:    call __stack_chk_fail
; CHECK-NEXT:  .LBB1_4: # %lpad
; CHECK-NEXT:  .Ltmp2: # EH_LABEL
; CHECK-NEXT:    lui a0, %hi(__stack_chk_guard)
; CHECK-NEXT:    ld a0, %lo(__stack_chk_guard)(a0)
; CHECK-NEXT:    ld a1, 0(sp)
; CHECK-NEXT:    bne a0, a1, .LBB1_6
; CHECK-NEXT:  # %bb.5: # %lpad
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_6: # %lpad
; CHECK-NEXT:    .cfi_restore_state
; CHECK-NEXT:    call __stack_chk_fail
entry:
  invoke void @__cxa_throw(ptr null, ptr null, ptr null)
          to label %cont unwind label %lpad

cont:
  unreachable

lpad:
  %lp = landingpad { ptr, i32 }
          cleanup
  ret void
}

