; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=riscv32 -O2 < %s | FileCheck %s

; Both pointers align 8, 8-byte memmove → two i32 pairs. This is the case that
; actually enters DAGCombiner::mayAlias's relative-align proof
; (OrigAlignment0 == OrigAlignment1 && align > size).
;
; On esp_22.x without the same-Value guard, llc interleaved:
;   lw 0(a1) ; sw 0(a0) ; lw 4(a1) ; sw 4(a0)
; If the runtime objects overlap backward, that store to dst[0] can clobber
; src[4] before it is read. After the guard, expansion is load-all then
; store-all (same order current main already emits for this IR).
define void @memmove_align8_8(ptr %dst, ptr %src) {
; CHECK-LABEL: memmove_align8_8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw [[L0:.*]], 0(a1)
; CHECK-NEXT:    lw [[L4:.*]], 4(a1)
; CHECK-NEXT:    sw [[L0]], 0(a0)
; CHECK-NEXT:    sw [[L4]], 4(a0)
; CHECK-NEXT:    ret
  tail call void @llvm.memmove.p0.p0.i32(ptr align 8 %dst, ptr align 8 %src, i32 8, i1 false)
  ret void
}

; 12-byte, both align 8: three i32 pairs. Same proof, extra offsets 0/4/8.
define void @memmove_align8_12(ptr %dst, ptr %src) {
; CHECK-LABEL: memmove_align8_12:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw [[L0:.*]], 0(a1)
; CHECK-NEXT:    lw [[L4:.*]], 4(a1)
; CHECK-NEXT:    lw [[L8:.*]], 8(a1)
; CHECK-NEXT:    sw [[L0]], 0(a0)
; CHECK-NEXT:    sw [[L4]], 4(a0)
; CHECK-NEXT:    sw [[L8]], 8(a0)
; CHECK-NEXT:    ret
  tail call void @llvm.memmove.p0.p0.i32(ptr align 8 %dst, ptr align 8 %src, i32 12, i1 false)
  ret void
}

declare void @llvm.memmove.p0.p0.i32(ptr, ptr, i32, i1)
