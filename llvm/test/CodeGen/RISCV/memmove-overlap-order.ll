; RUN: llc -mtriple=riscv32 -O2 < %s | FileCheck %s

; A 12-byte memmove with dst 16-byte aligned and src 8-byte aligned lowers to
; three i32 load/store pairs (offsets 0/4/8). For a backward copy (runtime
; dst > src with 0 < dst-src < 12) every source chunk must be loaded before
; the first store, otherwise a store to dst[0] clobbers src[4..8) before it
; is read. Pin load-all-then-store-all so a later DAG combine cannot silently
; reintroduce store-before-load.
define void @memmove_overlap_12(ptr %dst, ptr %src) {
; CHECK-LABEL: memmove_overlap_12:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw [[L0:.*]], 0(a1)
; CHECK-NEXT:    lw [[L4:.*]], 4(a1)
; CHECK-NEXT:    lw [[L8:.*]], 8(a1)
; CHECK-NEXT:    sw [[L0]], 0(a0)
; CHECK-NEXT:    sw [[L4]], 4(a0)
; CHECK-NEXT:    sw [[L8]], 8(a0)
; CHECK-NEXT:    ret
entry:
  tail call void @llvm.memmove.p0.p0.i32(ptr align 16 %dst, ptr align 8 %src, i32 12, i1 false)
  ret void
}
