; The RVV sincos ABI cannot be lowered as a function with output pointers.
; Without that mapping, replace-with-veclib can use separate sin and cos calls
; when the intrinsic's users extract its two results.

define void @test_sincos_nxv2f64(<vscale x 2 x double> %x, ptr noalias %out_sin, ptr noalias %out_cos) {
; CHECK-LABEL: define void @test_sincos_nxv2f64(
; CHECK-SAME: <vscale x 2 x double> [[X:%.*]], ptr noalias [[OUT_SIN:%.*]], ptr noalias [[OUT_COS:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[TMP1:%.*]] = call <vscale x 2 x double> @Sleef_sindx_u10rvvm2(<vscale x 2 x double> [[X]])
; CHECK-NEXT:    [[TMP2:%.*]] = call <vscale x 2 x double> @Sleef_cosdx_u10rvvm2(<vscale x 2 x double> [[X]])
; CHECK-NEXT:    store <vscale x 2 x double> [[TMP1]], ptr [[OUT_SIN]], align 8
; CHECK-NEXT:    store <vscale x 2 x double> [[TMP2]], ptr [[OUT_COS]], align 8
; CHECK-NEXT:    ret void
;
  %result = call { <vscale x 2 x double>, <vscale x 2 x double> } @llvm.sincos.nxv2f64(<vscale x 2 x double> %x)
  %sin = extractvalue { <vscale x 2 x double>, <vscale x 2 x double> } %result, 0
  %cos = extractvalue { <vscale x 2 x double>, <vscale x 2 x double> } %result, 1
  store <vscale x 2 x double> %sin, ptr %out_sin, align 8
  store <vscale x 2 x double> %cos, ptr %out_cos, align 8
  ret void
}

