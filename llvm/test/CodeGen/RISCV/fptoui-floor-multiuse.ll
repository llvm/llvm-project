; Shared floors exercise custom expansion and f16 promotion.
define i32 @fptoui_floor_f64_multi_use(double %x, ptr %p) nounwind {
; CHECK-LABEL: fptoui_floor_f64_multi_use:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mv a1, a0
; CHECK-NEXT:    li a0, 1075
; CHECK-NEXT:    slli a0, a0, 52
; CHECK-NEXT:    fabs.d fa5, fa0
; CHECK-NEXT:    fmv.d.x fa4, a0
; CHECK-NEXT:    flt.d a0, fa5, fa4
; CHECK-NEXT:    fmv.d fa5, fa0
; CHECK-NEXT:    beqz a0, .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    fcvt.l.d a0, fa0, rdn
; CHECK-NEXT:    fcvt.d.l fa5, a0, rdn
; CHECK-NEXT:    fsgnj.d fa5, fa5, fa0
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    fcvt.wu.d a0, fa0, rtz
; CHECK-NEXT:    fsd fa5, 0(a1)
; CHECK-NEXT:    ret
  %floor = call double @llvm.floor.f64(double %x)
  store double %floor, ptr %p
  %cvt = fptoui double %floor to i32
  ret i32 %cvt
}

