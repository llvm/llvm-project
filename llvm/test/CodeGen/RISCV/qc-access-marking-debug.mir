# RUN: llc -mtriple=riscv32 -mattr=+xqcili,+relax -code-model=small \
# RUN:   -run-pass=riscv-qc-relax-marking -o - %s | FileCheck %s

# Debug instructions that do not read the address register must not prevent
# marking the access. A debug use of the address register remains a barrier,
# because relaxation may remove the definition that makes its location valid.

--- |
  @global = external global i32

  define i32 @f() !dbg !5 {
    ret i32 0
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !DISubroutineType(types: !4)
  !4 = !{null}
  !5 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !6 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !7 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !6, size: 32)
  !8 = !DILocalVariable(name: "p", scope: !5, file: !1, line: 2, type: !7)
  !9 = !DILocation(line: 0, scope: !5)
...
---
name:            f
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: f
    ; CHECK: renamable $x10 = QC_E_LI @global
    ; CHECK-NEXT: DBG_VALUE $noreg
    ; CHECK-NEXT: renamable $x12 = PseudoQCAccessC_LW killed renamable $x10, 0, target-flags(riscv-qc-access) @global
    ; CHECK-NEXT: renamable $x11 = QC_E_LI @global
    ; CHECK-NEXT: DBG_VALUE $x11
    ; CHECK-NEXT: renamable $x10 = LW killed renamable $x11, 0
    ; CHECK-NEXT: renamable $x13 = QC_E_LI @global
    ; CHECK-NEXT: DBG_VALUE $x12
    ; CHECK-NEXT: renamable $x10 = PseudoQCAccessC_LW killed renamable $x13, 0, target-flags(riscv-qc-access) @global
    ; CHECK-NEXT: PseudoRET implicit $x10
    renamable $x10 = QC_E_LI @global
    DBG_VALUE $noreg, $noreg, !8, !DIExpression(), debug-location !9
    renamable $x12 = LW killed renamable $x10, 0 :: (dereferenceable load (s32) from @global)
    renamable $x11 = QC_E_LI @global
    DBG_VALUE $x11, $noreg, !8, !DIExpression(), debug-location !9
    renamable $x10 = LW killed renamable $x11, 0 :: (dereferenceable load (s32) from @global)
    renamable $x13 = QC_E_LI @global
    DBG_VALUE $x12, $noreg, !8, !DIExpression(), debug-location !9
    renamable $x10 = LW killed renamable $x13, 0 :: (dereferenceable load (s32) from @global)
    PseudoRET implicit $x10
...
