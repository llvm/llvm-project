; (add X, C) can reuse a register that already holds -C by rewriting to
; (sub X, -C). Here -C = 0x0101010101010101 is materialized for the multiply
; and the addition reuses it instead of building the constant a second time.
; The two operands are independent to keep the x*C - C -> C*(x-1) fold from
; firing.
define i64 @reuse_mul_splat_const(i64 %x, i64 %y) {
; CHECK-LABEL: reuse_mul_splat_const:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a2, 4112
; CHECK-NEXT:    addi a2, a2, 257
; CHECK-NEXT:    slli a3, a2, 32
; CHECK-NEXT:    add a2, a2, a3
; CHECK-NEXT:    mul a0, a0, a2
; CHECK-NEXT:    sub a1, a1, a2
; CHECK-NEXT:    add a0, a1, a0
; CHECK-NEXT:    ret
  %mul = mul i64 %x, 72340172838076673
  %add = add i64 %y, -72340172838076673
  %res = add i64 %mul, %add
  ret i64 %res
}

; Same reuse when the constant also feeds a longer and/xor chain (llvm#220555).
define i64 @reuse_neg_const_chain(i64 %ctrl, i8 zeroext %h) {
; CHECK-LABEL: reuse_neg_const_chain:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a2, 4112
; CHECK-NEXT:    addi a2, a2, 257
; CHECK-NEXT:    slli a3, a2, 32
; CHECK-NEXT:    add a2, a2, a3
; CHECK-NEXT:    mul a1, a1, a2
; CHECK-NEXT:    lui a3, %hi(.LCPI7_0)
; CHECK-NEXT:    ld a3, %lo(.LCPI7_0)(a3)
; CHECK-NEXT:    xor a0, a1, a0
; CHECK-NEXT:    sub a1, a0, a2
; CHECK-NEXT:    andn a0, a1, a0
; CHECK-NEXT:    and a0, a0, a3
; CHECK-NEXT:    ret
  %conv = zext i8 %h to i64
  %mul = mul nuw i64 %conv, 72340172838076673
  %xor = xor i64 %mul, %ctrl
  %sub = add i64 %xor, -72340172838076673
  %not = and i64 %xor, -9187201950435737472
  %and = xor i64 %not, -9187201950435737472
  %and1 = and i64 %and, %sub
  ret i64 %and1
}

; C is anchored by the multiply, and it is added on one operand and subtracted
; (via add of -C) on another. Only C needs to be materialized: the add of C
; reuses it directly and the add of -C should become (sub X, C). It must not
; instead flip the add of C to (sub X, -C), which would materialize -C too.
define i64 @add_pos_and_neg_const(i64 %x, i64 %a, i64 %b) {
; CHECK-LABEL: add_pos_and_neg_const:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a3, 4112
; CHECK-NEXT:    addi a3, a3, 257
; CHECK-NEXT:    slli a4, a3, 32
; CHECK-NEXT:    add a3, a3, a4
; CHECK-NEXT:    mul a0, a0, a3
; CHECK-NEXT:    add a1, a1, a3
; CHECK-NEXT:    sub a2, a2, a3
; CHECK-NEXT:    xor a1, a1, a2
; CHECK-NEXT:    xor a0, a0, a1
; CHECK-NEXT:    ret
  %mul = mul i64 %x, 72340172838076673
  %pa = add i64 %a, 72340172838076673
  %na = add i64 %b, -72340172838076673
  %o1 = xor i64 %mul, %pa
  %o2 = xor i64 %o1, %na
  ret i64 %o2
}

