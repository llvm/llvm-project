; RUN: llc -O3 -mtriple=riscv64 -mattr=+d < %s | FileCheck %s

; A long chain of FMA accumulations is reassociated into two shorter chains
; combined by a single add to expose more ILP.

define double @fma_chain_f64(double %y, ptr %pa, double %x0, double %x1, double %x2, double %x3, double %x4, double %x5) {
; CHECK-LABEL: fma_chain_f64:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fld ft0, 0(a0)
; CHECK-NEXT:    fld ft1, 24(a0)
; CHECK-NEXT:    fld ft2, 8(a0)
; CHECK-NEXT:    fld ft3, 16(a0)
; CHECK-NEXT:    fmadd.d fa1, ft0, fa1, fa0
; CHECK-NEXT:    fmul.d fa4, ft1, fa4
; CHECK-NEXT:    fld fa0, 32(a0)
; CHECK-NEXT:    fmadd.d fa2, ft2, fa2, fa1
; CHECK-NEXT:    fld fa1, 40(a0)
; CHECK-NEXT:    fmadd.d fa5, fa0, fa5, fa4
; CHECK-NEXT:    fmadd.d fa4, ft3, fa3, fa2
; CHECK-NEXT:    fmadd.d fa5, fa1, fa6, fa5
; CHECK-NEXT:    fadd.d fa0, fa4, fa5
; CHECK-NEXT:    ret
entry:
  %a0 = load double, ptr %pa, align 8
  %pa1 = getelementptr double, ptr %pa, i64 1
  %a1 = load double, ptr %pa1, align 8
  %pa2 = getelementptr double, ptr %pa, i64 2
  %a2 = load double, ptr %pa2, align 8
  %pa3 = getelementptr double, ptr %pa, i64 3
  %a3 = load double, ptr %pa3, align 8
  %pa4 = getelementptr double, ptr %pa, i64 4
  %a4 = load double, ptr %pa4, align 8
  %pa5 = getelementptr double, ptr %pa, i64 5
  %a5 = load double, ptr %pa5, align 8
  %m0 = fmul reassoc nsz contract double %a0, %x0
  %s0 = fadd reassoc nsz contract double %y, %m0
  %m1 = fmul reassoc nsz contract double %a1, %x1
  %s1 = fadd reassoc nsz contract double %s0, %m1
  %m2 = fmul reassoc nsz contract double %a2, %x2
  %s2 = fadd reassoc nsz contract double %s1, %m2
  %m3 = fmul reassoc nsz contract double %a3, %x3
  %s3 = fadd reassoc nsz contract double %s2, %m3
  %m4 = fmul reassoc nsz contract double %a4, %x4
  %s4 = fadd reassoc nsz contract double %s3, %m4
  %m5 = fmul reassoc nsz contract double %a5, %x5
  %s5 = fadd reassoc nsz contract double %s4, %m5
  ret double %s5
}

