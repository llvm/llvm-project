; CHECK-NEXT:    vmv.x.s a0, v8
; CHECK-NEXT:    vsetvli a1, zero, e32, m1, ta, ma
; CHECK-NEXT:    vmv.v.i v8, 0
; CHECK-NEXT:    vmv.v.i v9, 0
; CHECK-NEXT:    li a1, 0
; CHECK-NEXT:    ret
