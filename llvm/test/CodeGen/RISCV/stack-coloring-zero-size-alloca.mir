# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -run-pass=stack-coloring %s -o - | FileCheck %s

# A zero-sized alloca gets a one-byte stack object, but the alloca, which alias
# analysis uses, allocates nothing, so stack coloring must not merge another
# slot into its slot. In @zero_size_alloca_first, %slot keeps its own slot. In
# @zero_size_alloca_second, %slot sorts first, so %empty is merged into it.

--- |
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64"

  ; Function Attrs: nounwind
  define i8 @zero_size_alloca_first(i8 %v) #0 {
    %empty = alloca [0 x i8], align 1
    %slot = alloca i8, align 1
    %pad = alloca [16 x i8], align 1
    call void @llvm.lifetime.start.p0(ptr %empty)
    call void @use(ptr %empty)
    call void @llvm.lifetime.end.p0(ptr %empty)
    call void @llvm.lifetime.start.p0(ptr %slot)
    store i8 %v, ptr %slot, align 1
    call void @use(ptr %slot)
    %r = load i8, ptr %slot, align 1
    call void @llvm.lifetime.end.p0(ptr %slot)
    ret i8 %r
  }

  ; Function Attrs: nounwind
  define i8 @zero_size_alloca_second(i8 %v) #0 {
    %slot = alloca i8, align 1
    %empty = alloca [0 x i8], align 1
    %pad = alloca [16 x i8], align 1
    call void @llvm.lifetime.start.p0(ptr %slot)
    store i8 %v, ptr %slot, align 1
    call void @use(ptr %slot)
    %r = load i8, ptr %slot, align 1
    call void @llvm.lifetime.end.p0(ptr %slot)
    call void @llvm.lifetime.start.p0(ptr %empty)
    call void @use(ptr %empty)
    call void @llvm.lifetime.end.p0(ptr %empty)
    ret i8 %r
  }

  declare void @use(ptr)

  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
  declare void @llvm.lifetime.end.p0(ptr captures(none)) #1

  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
  declare void @llvm.lifetime.start.p0(ptr captures(none)) #1

  attributes #0 = { nounwind }
  attributes #1 = { nocallback nofree nosync nounwind willreturn memory(argmem: readwrite) }
...
---
name:            zero_size_alloca_first
alignment:       4
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
stack:
  - { id: 0, name: empty, size: 1, alignment: 1 }
  - { id: 1, name: slot, size: 1, alignment: 1 }
  - { id: 2, name: pad, size: 16, alignment: 1 }
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.0):
    liveins: $x10

    ; CHECK-LABEL: name: zero_size_alloca_first
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI %stack.0.empty, 0
    ; CHECK-NEXT: $x10 = COPY [[ADDI]]
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: SB [[COPY]], %stack.1.slot, 0 :: (store (s8) into %ir.slot)
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[ADDI1:%[0-9]+]]:gpr = ADDI %stack.1.slot, 0
    ; CHECK-NEXT: $x10 = COPY [[ADDI1]]
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[LBU:%[0-9]+]]:gpr = LBU %stack.1.slot, 0 :: (dereferenceable load (s8) from %ir.slot)
    ; CHECK-NEXT: $x10 = COPY [[LBU]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gpr = COPY $x10
    LIFETIME_START %stack.0.empty
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %1:gpr = ADDI %stack.0.empty, 0
    $x10 = COPY %1
    PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    LIFETIME_END %stack.0.empty
    LIFETIME_START %stack.1.slot
    SB %0, %stack.1.slot, 0 :: (store (s8) into %ir.slot)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %2:gpr = ADDI %stack.1.slot, 0
    $x10 = COPY %2
    PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %3:gpr = LBU %stack.1.slot, 0 :: (dereferenceable load (s8) from %ir.slot)
    LIFETIME_END %stack.1.slot
    $x10 = COPY %3
    PseudoRET implicit $x10
...
---
name:            zero_size_alloca_second
alignment:       4
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
stack:
  - { id: 0, name: slot, size: 1, alignment: 1 }
  - { id: 1, name: empty, size: 1, alignment: 1 }
  - { id: 2, name: pad, size: 16, alignment: 1 }
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.0):
    liveins: $x10

    ; CHECK-LABEL: name: zero_size_alloca_second
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: SB [[COPY]], %stack.0.slot, 0 :: (store (s8) into %ir.slot)
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[ADDI:%[0-9]+]]:gpr = ADDI %stack.0.slot, 0
    ; CHECK-NEXT: $x10 = COPY [[ADDI]]
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[LBU:%[0-9]+]]:gpr = LBU %stack.0.slot, 0 :: (dereferenceable load (s8) from %ir.slot)
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: [[ADDI1:%[0-9]+]]:gpr = ADDI %stack.0.slot, 0
    ; CHECK-NEXT: $x10 = COPY [[ADDI1]]
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ; CHECK-NEXT: $x10 = COPY [[LBU]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gpr = COPY $x10
    LIFETIME_START %stack.0.slot
    SB %0, %stack.0.slot, 0 :: (store (s8) into %ir.slot)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %1:gpr = ADDI %stack.0.slot, 0
    $x10 = COPY %1
    PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %2:gpr = LBU %stack.0.slot, 0 :: (dereferenceable load (s8) from %ir.slot)
    LIFETIME_END %stack.0.slot
    LIFETIME_START %stack.1.empty
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %3:gpr = ADDI %stack.1.empty, 0
    $x10 = COPY %3
    PseudoCALL target-flags(riscv-call) @use, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    LIFETIME_END %stack.1.empty
