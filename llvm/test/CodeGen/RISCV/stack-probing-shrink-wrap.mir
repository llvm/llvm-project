    liveins: $x10

    $x5 = ADDI $x0, 1
    $x6 = ADDI $x0, 2
    $x7 = ADDI $x0, 3
    $x28 = ADDI $x0, 4
    $x29 = ADDI $x0, 5
    $x30 = ADDI $x0, 6
    BEQ killed $x10, $x0, %bb.2

  bb.1:
    successors: %bb.2
    liveins: $x5, $x6, $x7, $x28, $x29, $x30

    SW killed $x5, %stack.0.buf, 0
    SW killed $x6, %stack.0.buf, 4
    SW killed $x7, %stack.0.buf, 8
    SW killed $x28, %stack.0.buf, 12
    SW killed $x29, %stack.0.buf, 16
    SW killed $x30, %stack.0.buf, 20

