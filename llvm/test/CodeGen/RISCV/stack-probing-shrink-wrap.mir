# RUN: llc -mtriple=riscv64 -x mir -run-pass=shrink-wrap,prolog-epilog -verify-machineinstrs < %s | FileCheck %s --check-prefix=RV64I
# RUN: llc -mtriple=riscv32 -x mir -run-pass=shrink-wrap,prolog-epilog -verify-machineinstrs < %s | FileCheck %s --check-prefix=RV32I

# bb.1 has no two free registers for the probe loop, so the prologue stays in
# the entry block.

--- |
  define void @shrink_wrap_no_free_regs(i64 %c) #0 {
  entry:
    %buf = alloca [100000 x i8], align 8
    ret void
  }

  attributes #0 = { "probe-stack"="inline-asm" }
...
