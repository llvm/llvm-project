; Zero extensions of simple single-use i32 loads can fold into lwu.
define i32 @clmulh_load(ptr %p, ptr %q) {
; CHECK-LABEL: clmulh_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lwu a0, 0(a0)
; CHECK-NEXT:    lwu a1, 0(a1)
; CHECK-NEXT:    clmul a0, a0, a1
; CHECK-NEXT:    srli a0, a0, 32
; CHECK-NEXT:    ret
