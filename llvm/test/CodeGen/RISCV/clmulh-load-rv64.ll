; NOA-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; NOA-NEXT:    .cfi_offset ra, -8
; NOA-NEXT:    .cfi_offset s0, -16
; NOA-NEXT:    .cfi_offset s1, -24
; NOA-NEXT:    mv s0, a1
