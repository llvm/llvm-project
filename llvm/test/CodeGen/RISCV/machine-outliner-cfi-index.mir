# RUN: llc -mtriple=riscv32-linux-gnu -run-pass=machine-outliner \
# RUN:   -enable-machine-outliner=always -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s
# RUN: llc -mtriple=riscv64-linux-gnu -run-pass=machine-outliner \
# RUN:   -enable-machine-outliner=always -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Check that MachineOutliner keeps tails with different CFI rules separate,
# even when their CFI indices match. Indices are local to each function:
# index 0 describes CFA offset 16 in f, but CFA offset 32 in g.
#
# f allocates 16 bytes on the stack and g allocates 32. The instructions after
# the allocation are otherwise identical. Each tail contains all of its
# function's CFI instructions and ends in a return, so both tails pass the
# target's existing CFI checks.
#
# Comparing only the indices would merge these tails into one helper. That
# helper would use f's CFA offset 16, which is wrong when reached from g, until
# the stack pointer is restored. Each function must keep its own CFI rules.
#
# CHECK-LABEL: name: f
# CHECK: CFI_INSTRUCTION def_cfa_offset 16
# CHECK: CFI_INSTRUCTION def_cfa_offset 0
# CHECK-LABEL: name: g
# CHECK: CFI_INSTRUCTION def_cfa_offset 32
# CHECK: CFI_INSTRUCTION def_cfa_offset 0
# CHECK-NOT: name: OUTLINED_FUNCTION_

--- |
  define void @f() #0 { ret void }
  define void @g() #0 { ret void }
  attributes #0 = { nounwind uwtable }
...
---
name: f
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2
    $x7 = ADDI $x2, 0
    $x2 = ADDI $x2, -16
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    $x10 = ORI $x0, 1
    $x11 = ORI $x0, 2
    $x12 = ORI $x0, 3
    $x13 = ORI $x0, 4
    $x14 = ORI $x0, 5
    $x15 = ORI $x0, 6
    $x2 = ADDI $x7, 0
    frame-destroy CFI_INSTRUCTION def_cfa_offset 0
    PseudoRET implicit $x1
...
---
name: g
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x1, $x2
    $x7 = ADDI $x2, 0
    $x2 = ADDI $x2, -32
    frame-setup CFI_INSTRUCTION def_cfa_offset 32
    $x10 = ORI $x0, 1
    $x11 = ORI $x0, 2
    $x12 = ORI $x0, 3
    $x13 = ORI $x0, 4
    $x14 = ORI $x0, 5
    $x15 = ORI $x0, 6
    $x2 = ADDI $x7, 0
    frame-destroy CFI_INSTRUCTION def_cfa_offset 0
    PseudoRET implicit $x1
...
