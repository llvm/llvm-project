# A WAR hazard within a single scheduling region: the second definition is
# renamed so it no longer reuses the register the earlier instruction reads.
---
name:            gpr_region_war
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11, $x12, $x13, $x15
    ; ANTIDEP-LABEL: name: gpr_region_war
    ; ANTIDEP: liveins: $x10, $x11, $x12, $x13, $x15
    ; ANTIDEP-NEXT: {{  $}}
    ; ANTIDEP-NEXT: renamable $x14 = ADD killed renamable $x15, killed renamable $x10
    ; ANTIDEP-NEXT: $x11 = LD killed renamable $x11, 0 :: (load (s64))
    ; ANTIDEP-NEXT: SD killed $x11, killed renamable $x12, 0 :: (store (s64))
    ; ANTIDEP-NEXT: SD killed renamable $x14, killed renamable $x13, 0 :: (store (s64))
    ; ANTIDEP-NEXT: PseudoRET
    ;
    ; NO-ANTIDEP-LABEL: name: gpr_region_war
    ; NO-ANTIDEP: liveins: $x10, $x11, $x12, $x13, $x15
    ; NO-ANTIDEP-NEXT: {{  $}}
    ; NO-ANTIDEP-NEXT: renamable $x14 = ADD killed renamable $x15, killed renamable $x10
    ; NO-ANTIDEP-NEXT: renamable $x15 = LD killed renamable $x11, 0 :: (load (s64))
    ; NO-ANTIDEP-NEXT: SD killed renamable $x15, killed renamable $x12, 0 :: (store (s64))
    ; NO-ANTIDEP-NEXT: SD killed renamable $x14, killed renamable $x13, 0 :: (store (s64))
    ; NO-ANTIDEP-NEXT: PseudoRET
    renamable $x14 = ADD renamable $x15, renamable $x10
    renamable $x15 = LD renamable $x11, 0 :: (load (s64))
    SD renamable $x15, renamable $x12, 0 :: (store (s64))
    SD renamable $x14, renamable $x13, 0 :: (store (s64))
    PseudoRET
...

