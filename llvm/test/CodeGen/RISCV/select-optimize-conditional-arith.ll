  %x = load i32, ptr %ptr, align 4
  %in_lower_half = icmp ult i32 %x, %half
  %offset = sub i32 %modulus, %m
  %correction = select i1 %in_lower_half, i32 0, i32 %offset
  %centered = add i32 %x, %correction
