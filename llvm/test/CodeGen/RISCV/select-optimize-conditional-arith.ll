; CHECK-NEXT:    addi a0, a0, 4
; CHECK-NEXT:    bnez a4, .LBB0_2
; CHECK-NEXT:  .LBB0_6: # %exit
; CHECK-NEXT:    ret
entry:
  %half = lshr i32 %m, 1
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %next, %loop ]
  %ptr = getelementptr i32, ptr %coefficients, i64 %i
  %x = load i32, ptr %ptr, align 4
  %in_lower_half = icmp ult i32 %x, %half
  %offset = sub i32 %modulus, %m
  %correction = select i1 %in_lower_half, i32 0, i32 %offset
  %centered = add i32 %x, %correction
  %product = mul i32 %centered, %factor
  %below_modulus = icmp ult i32 %product, %modulus
  %delta = select i1 %below_modulus, i32 0, i32 %modulus
  %reduced = sub i32 %product, %delta
  store i32 %reduced, ptr %ptr, align 4
  %next = add nuw i64 %i, 1
  %done = icmp eq i64 %next, %count
  br i1 %done, label %exit, label %loop

exit:
