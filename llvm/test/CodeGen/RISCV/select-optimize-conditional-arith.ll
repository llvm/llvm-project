; Center a coefficient and reduce its product without data-dependent branches.
; The Zbb-only run checks the conditional subtract independently of Zicond.
define void @center_and_reduce(ptr %coefficients, i32 %modulus, i32 %m, i32 %factor, i64 %count) {
