; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv64 -verify-machineinstrs < %s | FileCheck %s

; An i32 output is in a 64-bit register, so passing it as a signext argument
; sign-extends it. The indirect target needs its own extension, since the one
; for the default target is after the INLINEASM_BR.

declare void @g(i32 signext)

define void @signext_on_both_paths() {
; CHECK-LABEL: signext_on_both_paths:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    #APP
; CHECK-NEXT:    li a0, -1
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:  .LBB0_1: # Inline asm indirect target
; CHECK-NEXT:    # %b
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    sext.w a0, a0
; CHECK-NEXT:    call g
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
entry:
  %r = callbr i32 asm "li $0, -1", "=r,!i"()
          to label %a [label %b]

a:
  call void @g(i32 signext %r)
  ret void

b:
  call void @g(i32 signext %r)
  ret void
}

; Both paths reach %m, so %t gets the output from either one (#143795).
define void @same_dest(i1 %c) {
; CHECK-LABEL: same_dest:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    .cfi_remember_state
; CHECK-NEXT:    #APP
; CHECK-NEXT:    li a1, -1
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:  # %bb.1: # %m
; CHECK-NEXT:    andi a0, a0, 1
; CHECK-NEXT:    beqz a0, .LBB1_3
; CHECK-NEXT:  .LBB1_2: # %t
; CHECK-NEXT:    sext.w a0, a1
; CHECK-NEXT:    call g
; CHECK-NEXT:  .LBB1_3: # %e
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_4: # Inline asm indirect target
; CHECK-NEXT:    # %entry.m_crit_edge
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    .cfi_restore_state
; CHECK-NEXT:    andi a0, a0, 1
; CHECK-NEXT:    beqz a0, .LBB1_3
; CHECK-NEXT:    j .LBB1_2
entry:
  %r = callbr i32 asm "li $0, -1", "=r,!i"()
          to label %m [label %m]

m:
  br i1 %c, label %t, label %e

t:
  call void @g(i32 signext %r)
  br label %e

e:
  ret void
}
