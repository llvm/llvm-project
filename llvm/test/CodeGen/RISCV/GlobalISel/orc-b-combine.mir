# ONLY-LABEL: name: byte_bit_0
# ONLY: G_INTRINSIC intrinsic(@llvm.riscv.orc.b)
# ONLY-LABEL: name: byte_bit_7
# ONLY: G_INTRINSIC intrinsic(@llvm.riscv.orc.b)

---
name: byte_bit_0
legalized: true
body: |
  bb.0:
    liveins: $x10, $x11

    ; ZBB-LABEL: name: byte_bit_0
    ; ZBB: [[SRC:%[0-9]+]]:_(s64) = G_AND
    ; ZBB: G_INTRINSIC intrinsic(@llvm.riscv.orc.b), [[SRC]]
    ; ZBB-NOT: G_SUB
    ; NOZBB-LABEL: name: byte_bit_0
    ; NOZBB-NOT: G_INTRINSIC
    ; NOZBB: G_SUB
    %0:_(s64) = COPY $x10
    %1:_(s64) = COPY $x11
    %2:_(s64) = G_CONSTANT i64 72340172838076673
    %3:_(s64) = G_AND %0, %2
    %4:_(s64) = G_CONSTANT i64 8
    %5:_(s64) = G_SHL %3, %4
    %6:_(s64) = G_SUB %5, %3
    $x10 = COPY %6(s64)
    PseudoRET implicit $x10
...

