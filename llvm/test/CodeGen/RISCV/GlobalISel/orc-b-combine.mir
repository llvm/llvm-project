# RUN: llc -mtriple=riscv64 -mattr=+zbb -run-pass=riscv-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ZBB
# RUN: llc -mtriple=riscv64 -mattr=-zbb -run-pass=riscv-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=NOZBB
