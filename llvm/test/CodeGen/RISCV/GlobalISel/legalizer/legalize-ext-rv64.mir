---
name:            sext_i32
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    ; CHECK-LABEL: name: sext_i32
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i64) = G_SEXT_INREG [[ADD]], 32
    ; CHECK-NEXT: $x10 = COPY [[SEXT_INREG]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i64) = COPY $x10
    %1:_(i64) = COPY $x11
    %2:_(i32) = G_TRUNC %0(i64)
    %3:_(i32) = G_TRUNC %1(i64)
    %4:_(i32) = G_ADD %2, %3
    %5:_(i64) = G_SEXT %4(i32)
    $x10 = COPY %5(i64)
    PseudoRET implicit $x10

