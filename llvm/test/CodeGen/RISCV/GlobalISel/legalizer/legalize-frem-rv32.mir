    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[TRUNC2:%[0-9]+]]:_(i16) = G_TRUNC [[COPY5]](i32)
    ; CHECK-NEXT: [[BITCAST10:%[0-9]+]]:_(f16) = G_BITCAST [[TRUNC2]](i16)
