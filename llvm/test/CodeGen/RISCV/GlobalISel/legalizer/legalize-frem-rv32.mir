# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=riscv32 -run-pass=legalizer -global-isel-abort=0 %s -o - | FileCheck %s
---
name:            frem_f32
body:             |
  bb.1.entry:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: frem_f32
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(f32) = G_BITCAST [[COPY]](i32)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(f32) = G_BITCAST [[COPY1]](i32)
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[BITCAST2:%[0-9]+]]:_(i32) = G_BITCAST [[BITCAST]](f32)
    ; CHECK-NEXT: [[BITCAST3:%[0-9]+]]:_(i32) = G_BITCAST [[BITCAST1]](f32)
    ; CHECK-NEXT: $x10 = COPY [[BITCAST2]](i32)
    ; CHECK-NEXT: $x11 = COPY [[BITCAST3]](i32)
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) &fmodf, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x10
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[BITCAST4:%[0-9]+]]:_(f32) = G_BITCAST [[COPY2]](i32)
    ; CHECK-NEXT: [[BITCAST5:%[0-9]+]]:_(i32) = G_BITCAST [[BITCAST4]](f32)
    ; CHECK-NEXT: $x10 = COPY [[BITCAST5]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %2:_(i32) = COPY $x10
    %0:_(f32) = G_BITCAST %2(i32)
    %3:_(i32) = COPY $x11
    %1:_(f32) = G_BITCAST %3(i32)
    %4:_(f32) = G_FREM %0, %1
    %5:_(i32) = G_BITCAST %4(f32)
    $x10 = COPY %5(i32)
    PseudoRET implicit $x10

...
---
name:            frem_f64
body:             |
  bb.1.entry:
    liveins: $x10, $x11, $x12, $x13

    ; CHECK-LABEL: name: frem_f64
    ; CHECK: liveins: $x10, $x11, $x12, $x13
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $x12
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i32) = COPY $x13
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: $x10 = COPY [[COPY]](i32)
    ; CHECK-NEXT: $x11 = COPY [[COPY1]](i32)
    ; CHECK-NEXT: $x12 = COPY [[COPY2]](i32)
    ; CHECK-NEXT: $x13 = COPY [[COPY3]](i32)
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) &fmod, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit $x12, implicit $x13, implicit-def $x10, implicit-def $x11
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:_(i32) = COPY $x11
    ; CHECK-NEXT: $x10 = COPY [[COPY4]](i32)
    ; CHECK-NEXT: $x11 = COPY [[COPY5]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %2:_(i32) = COPY $x10
    %3:_(i32) = COPY $x11
    %0:_(f64) = G_MERGE_VALUES %2(i32), %3(i32)
    %4:_(i32) = COPY $x12
    %5:_(i32) = COPY $x13
    %1:_(f64) = G_MERGE_VALUES %4(i32), %5(i32)
    %6:_(f64) = G_FREM %0, %1
    %7:_(i32), %8:_(i32) = G_UNMERGE_VALUES %6(f64)
    $x10 = COPY %7(i32)
    $x11 = COPY %8(i32)
    PseudoRET implicit $x10, implicit $x11

...
