    ; CHECK-NEXT: $x10 = COPY [[BITCAST6]](i32)
    ; CHECK-NEXT: $x11 = COPY [[BITCAST7]](i32)
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) &fmodf, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x10
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[BITCAST8:%[0-9]+]]:_(f32) = G_BITCAST [[COPY4]](i32)
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[BITCAST9:%[0-9]+]]:_(i32) = G_BITCAST [[BITCAST8]](f32)
    ; CHECK-NEXT: $x10 = COPY [[BITCAST9]](i32)
