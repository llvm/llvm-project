    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: $x10 = COPY [[COPY1]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %1:_(i64) = COPY $x10
    %2:_(i32) = G_TRUNC %1(i64)
    %0:_(f32) = G_BITCAST %2(i32)
    %3:_(i1) = G_FPTOSI %0(f32)
    %4:_(i64) = G_ANYEXT %3(i1)
    $x10 = COPY %4(i64)
    PseudoRET implicit $x10

