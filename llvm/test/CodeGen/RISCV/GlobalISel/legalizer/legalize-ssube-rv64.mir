    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i64) = G_SEXT_INREG [[COPY]], 32
    ; CHECK-NEXT: [[SEXT_INREG1:%[0-9]+]]:_(i64) = G_SEXT_INREG [[COPY1]], 32
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[SEXT_INREG]], [[SEXT_INREG1]]
