---
name:            ssube_i128
body:             |
  bb.1:
    liveins: $x10, $x11, $x12, $x13, $x14

    ; CHECK-LABEL: name: ssube_i128
    ; CHECK: liveins: $x10, $x11, $x12, $x13, $x14
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x12
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i64) = COPY $x13
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:_(i64) = COPY $x14
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i64) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY4]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i64) = G_AND [[DEF]], [[C1]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[COPY2]], [[AND]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), [[ADD]](i64), [[AND]]
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:_(i64) = COPY [[ADD]](i64)
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i64) = G_ADD [[COPY3]], [[AND1]]
    ; CHECK-NEXT: [[ADD2:%[0-9]+]]:_(i64) = G_ADD [[ADD1]], [[ICMP]]
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:_(i64) = COPY [[ADD2]](i64)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[COPY5]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), [[COPY]](i64), [[COPY5]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i64) = G_SUB [[COPY1]], [[COPY6]]
    ; CHECK-NEXT: [[SUB2:%[0-9]+]]:_(i64) = G_SUB [[SUB1]], [[ICMP1]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i64) = G_XOR [[COPY]], [[COPY2]]
    ; CHECK-NEXT: [[XOR1:%[0-9]+]]:_(i64) = G_XOR [[COPY1]], [[COPY3]]
    ; CHECK-NEXT: [[XOR2:%[0-9]+]]:_(i64) = G_XOR [[COPY]], [[SUB]]
    ; CHECK-NEXT: [[XOR3:%[0-9]+]]:_(i64) = G_XOR [[COPY1]], [[SUB2]]
    ; CHECK-NEXT: [[AND2:%[0-9]+]]:_(i64) = G_AND [[XOR]], [[XOR2]]
    ; CHECK-NEXT: [[AND3:%[0-9]+]]:_(i64) = G_AND [[XOR1]], [[XOR3]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), [[AND2]](i64), [[C1]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i64) = G_ICMP intpred(slt), [[AND3]](i64), [[C1]]
    ; CHECK-NEXT: [[ICMP4:%[0-9]+]]:_(i64) = G_ICMP intpred(eq), [[AND3]](i64), [[C1]]
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[ICMP2]](i64)
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(i32) = G_TRUNC [[ICMP3]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP4]](i64), [[TRUNC]], [[TRUNC1]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[SELECT]](i32)
    ; CHECK-NEXT: $x10 = COPY [[SUB]](i64)
    ; CHECK-NEXT: $x11 = COPY [[SUB2]](i64)
    ; CHECK-NEXT: $x12 = COPY [[ANYEXT]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11, implicit $x12
    %0:_(i64) = COPY $x10
    %1:_(i64) = COPY $x11
    %2:_(i128) = G_MERGE_VALUES %0(i64), %1(i64)
    %3:_(i64) = COPY $x12
    %4:_(i64) = COPY $x13
    %5:_(i128) = G_MERGE_VALUES %3(i64), %4(i64)
    %6:_(i64) = COPY $x14
    %7:_(i1)  = G_TRUNC %6(i64)
    %8:_(i128), %9:_(i1) = G_SSUBE %2, %5, %7
    %10:_(i64), %11:_(i64) = G_UNMERGE_VALUES %8(i128)
    %12:_(i64) = G_ANYEXT %9(i1)
    $x10 = COPY %10(i64)
    $x11 = COPY %11(i64)
    $x12 = COPY %12(i64)
    PseudoRET implicit $x10, implicit $x11, implicit $x12
...
