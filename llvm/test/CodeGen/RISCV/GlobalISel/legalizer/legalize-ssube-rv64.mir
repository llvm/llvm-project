# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -run-pass=legalizer %s -o - | FileCheck %s

---
name:            ssube_i8
body:             |
  bb.1:
    liveins: $x10, $x11, $x12

    ; CHECK-LABEL: name: ssube_i8
    ; CHECK: liveins: $x10, $x11, $x12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x12
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 56
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[COPY]], [[C]](i64)
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(i64) = G_ASHR [[SHL]], [[C]](i64)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL [[COPY1]], [[C]](i64)
    ; CHECK-NEXT: [[ASHR1:%[0-9]+]]:_(i64) = G_ASHR [[SHL1]], [[C]](i64)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[ASHR]], [[ASHR1]]
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY2]], [[C1]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i64) = G_SUB [[SUB]], [[AND]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL [[SUB1]], [[C]](i64)
    ; CHECK-NEXT: [[ASHR2:%[0-9]+]]:_(i64) = G_ASHR [[SHL2]], [[C]](i64)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i64) = G_ICMP intpred(ne), [[SUB1]](i64), [[ASHR2]]
    ; CHECK-NEXT: $x10 = COPY [[SUB1]](i64)
    ; CHECK-NEXT: $x11 = COPY [[ICMP]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %0:_(i64) = COPY $x10
    %1:_(i8) = G_TRUNC %0(i64)
    %2:_(i64) = COPY $x11
    %3:_(i8) = G_TRUNC %2(i64)
    %4:_(i64) = COPY $x12
    %5:_(i1) = G_TRUNC %4(i64)
    %6:_(i8), %7:_(i1) = G_SSUBE %1, %3, %5
    %8:_(i64) = G_ANYEXT %6(i8)
    %9:_(i64) = G_ANYEXT %7(i1)
    $x10 = COPY %8(i64)
    $x11 = COPY %9(i64)
    PseudoRET implicit $x10, implicit $x11

...
