    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x12
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY2]], [[C]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[COPY1]], [[AND]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[ADD]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i64) = COPY [[SUB]](i64)
