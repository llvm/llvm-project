    ; RV64ZBB: liveins: $x10, $x11
    ; RV64ZBB-NEXT: {{  $}}
    ; RV64ZBB-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; RV64ZBB-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; RV64ZBB-NEXT: [[UMAX:%[0-9]+]]:_(i64) = G_UMAX [[COPY]], [[COPY1]]
    ; RV64ZBB-NEXT: [[UMIN:%[0-9]+]]:_(i64) = G_UMIN [[COPY]], [[COPY1]]
    ; RV64ZBB-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[UMAX]], [[UMIN]]
    ; RV64ZBB-NEXT: $x10 = COPY [[SUB]](i64)
    ; RV64ZBB-NEXT: PseudoRET implicit $x10
    %1:_(i64) = COPY $x10
    %2:_(i64) = COPY $x11
    %3:_(i64) = G_ABDU %1, %2
    $x10 = COPY %3(i64)
    PseudoRET implicit $x10
...
