# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 4
# RUN: llc -mtriple=riscv32 -mattr=+f,+v -run-pass=legalizer %s -o - | FileCheck %s
---
name:            freeze_i32
body:             |
  bb.0.entry:
    liveins: $x10
    ; CHECK-LABEL: name: freeze_i32
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:_(i32) = G_FREEZE [[COPY]]
    ; CHECK-NEXT: $x10 = COPY [[FREEZE]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %1:_(i32) = COPY $x10
    %2:_(i32) = G_FREEZE %1
    $x10 = COPY %2(i32)
    PseudoRET implicit $x10

...
