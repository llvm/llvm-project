    ; CHECK-M-NEXT: [[UDIV:%[0-9]+]]:_(i64) = G_UDIV [[COPY]], [[COPY1]]
    ; CHECK-M-NEXT: [[UREM:%[0-9]+]]:_(i64) = G_UREM [[COPY]], [[COPY1]]
    ; CHECK-M-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[UDIV]], [[UREM]]
    ; CHECK-M-NEXT: $x10 = COPY [[ADD]](i64)
    ; CHECK-M-NEXT: PseudoRET implicit $x10
    %0:_(i64) = COPY $x10
    %1:_(i64) = COPY $x11
    %2:_(i64), %3:_(i64) = G_UDIVREM %0, %1
    %4:_(i64) = G_ADD %2, %3
    $x10 = COPY %4(i64)
    PseudoRET implicit $x10

...
