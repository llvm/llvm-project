    ; CHECK-NEXT: $x10 = COPY [[ANYEXT]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i64) = COPY $x10
    %1:_(i64) = COPY $x11
    %2:_(i64) = COPY $x12
    %3:_(i8) = G_TRUNC %0(i64)
    %4:_(i8) = G_TRUNC %1(i64)
    %5:_(i1) = G_TRUNC %2(i64)
    %6:_(i8) = G_SELECT %5(i1), %3(i8), %4
    %7:_(i64) = G_ANYEXT %6(i8)
    $x10 = COPY %7(i64)
    PseudoRET implicit $x10

