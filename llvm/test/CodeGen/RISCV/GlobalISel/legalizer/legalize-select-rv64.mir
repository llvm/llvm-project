name:            select_i8
body:             |
  bb.0.entry:
    liveins: $x10, $x11, $x12
    ; CHECK-LABEL: name: select_i8
    ; CHECK: liveins: $x10, $x11, $x12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
