    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[ICMP1]](i32), [[COPY]], [[SELECT]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i32), [[LSHR]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[SUB]], [[C1]]
    ; CHECK-NEXT: [[SUB3:%[0-9]+]]:_(i32) = G_SUB [[AND1]], [[C2]]
    ; CHECK-NEXT: [[SUB4:%[0-9]+]]:_(i32) = G_SUB [[C2]], [[AND1]]
