    ; CHECK-NEXT: [[SHL3:%[0-9]+]]:_(i32) = G_SHL [[COPY]], [[SUB3]](i32)
    ; CHECK-NEXT: [[SELECT3:%[0-9]+]]:_(i32) = G_SELECT [[ICMP2]](i32), [[SHL1]], [[C]]
    ; CHECK-NEXT: [[SELECT4:%[0-9]+]]:_(i32) = G_SELECT [[ICMP2]](i32), [[OR1]], [[SHL3]]
    ; CHECK-NEXT: [[SELECT5:%[0-9]+]]:_(i32) = G_SELECT [[ICMP3]](i32), [[COPY1]], [[SELECT4]]
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(i32) = G_OR [[SELECT1]], [[SELECT3]]
    ; CHECK-NEXT: [[OR3:%[0-9]+]]:_(i32) = G_OR [[SELECT2]], [[SELECT5]]
    ; CHECK-NEXT: $x10 = COPY [[OR2]](i32)
    ; CHECK-NEXT: $x11 = COPY [[OR3]](i32)
