    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 63
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[C]], [[COPY2]]
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY2]], [[C1]]
