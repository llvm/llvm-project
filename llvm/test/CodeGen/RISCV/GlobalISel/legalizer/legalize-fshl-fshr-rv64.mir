# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -run-pass=legalizer %s -o - \
# RUN: | FileCheck %s

---
name:            fshl_i8
body:             |
  bb.1:
    liveins: $x10, $x11, $x12

    ; CHECK-LABEL: name: fshl_i8
    ; CHECK: liveins: $x10, $x11, $x12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x12
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 7
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY2]], [[C]]
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 -1
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i64) = G_XOR [[COPY2]], [[C1]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i64) = G_AND [[XOR]], [[C]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[COPY]], [[AND]](i64)
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(i64) = G_CONSTANT i64 255
    ; CHECK-NEXT: [[AND2:%[0-9]+]]:_(i64) = G_AND [[COPY1]], [[C3]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[AND2]], [[C2]](i64)
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(i64) = G_LSHR [[LSHR]], [[AND1]](i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[SHL]], [[LSHR1]]
    ; CHECK-NEXT: $x10 = COPY [[OR]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %3:_(i64) = COPY $x10
    %0:_(i8) = G_TRUNC %3(i64)
    %4:_(i64) = COPY $x11
    %1:_(i8) = G_TRUNC %4(i64)
    %5:_(i64) = COPY $x12
    %2:_(i8) = G_TRUNC %5(i64)
    %6:_(i8) = G_FSHL %0, %1, %2(i8)
    %7:_(i64) = G_ANYEXT %6(i8)
    $x10 = COPY %7(i64)
    PseudoRET implicit $x10

...
