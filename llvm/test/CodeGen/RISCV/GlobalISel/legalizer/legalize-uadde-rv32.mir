---
name:            uadde_i8
body:             |
  bb.1:
    liveins: $x10, $x11, $x12

    ; CHECK-LABEL: name: uadde_i8
    ; CHECK: liveins: $x10, $x11, $x12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $x12
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[ADD]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[COPY]], [[C]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[AND]](i32), [[AND1]]
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[AND2:%[0-9]+]]:_(i32) = G_AND [[COPY2]], [[C1]]
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[ADD]], [[AND2]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[AND3:%[0-9]+]]:_(i32) = G_AND [[ADD1]], [[C]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[AND3]](i32), [[C2]]
    ; CHECK-NEXT: [[AND4:%[0-9]+]]:_(i32) = G_AND [[ICMP1]], [[COPY2]]
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[ICMP]], [[AND4]]
    ; CHECK-NEXT: $x10 = COPY [[ADD1]](i32)
    ; CHECK-NEXT: $x11 = COPY [[OR]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %0:_(i32) = COPY $x10
    %1:_(i8) = G_TRUNC %0(i32)
    %2:_(i32) = COPY $x11
    %3:_(i8) = G_TRUNC %2(i32)
    %4:_(i32) = COPY $x12
    %5:_(i1) = G_TRUNC %4(i32)
    %6:_(i8), %7:_(i1) = G_UADDE %1, %3, %5
    %8:_(i32) = G_ANYEXT %6(i8)
    %9:_(i32) = G_ANYEXT %7(i1)
    $x10 = COPY %8(i32)
    $x11 = COPY %9(i32)
    PseudoRET implicit $x10, implicit $x11

...
