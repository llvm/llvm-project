# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv32 -run-pass=legalizer %s -o - | FileCheck %s --check-prefixes=CHECK,RV32I
# RUN: llc -mtriple=riscv32 -mattr=+zbb -run-pass=legalizer %s -o - \
# RUN:   | FileCheck %s --check-prefixes=CHECK,RV32ZBB

---
name:            umin_i8
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    ; RV32I-LABEL: name: umin_i8
    ; RV32I: liveins: $x10, $x11
    ; RV32I-NEXT: {{  $}}
    ; RV32I-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; RV32I-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; RV32I-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; RV32I-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY]], [[C]]
    ; RV32I-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[COPY1]], [[C]]
    ; RV32I-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[AND]](i32), [[AND1]]
    ; RV32I-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i32), [[COPY]], [[COPY1]]
    ; RV32I-NEXT: [[AND2:%[0-9]+]]:_(i32) = G_AND [[SELECT]], [[C]]
    ; RV32I-NEXT: $x10 = COPY [[AND2]](i32)
    ; RV32I-NEXT: PseudoRET implicit $x10
    ;
    ; RV32ZBB-LABEL: name: umin_i8
    ; RV32ZBB: liveins: $x10, $x11
    ; RV32ZBB-NEXT: {{  $}}
    ; RV32ZBB-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; RV32ZBB-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; RV32ZBB-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; RV32ZBB-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY]], [[C]]
    ; RV32ZBB-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[COPY1]], [[C]]
    ; RV32ZBB-NEXT: [[UMIN:%[0-9]+]]:_(i32) = G_UMIN [[AND]], [[AND1]]
    ; RV32ZBB-NEXT: $x10 = COPY [[UMIN]](i32)
    ; RV32ZBB-NEXT: PseudoRET implicit $x10
    %0:_(i32) = COPY $x10
    %1:_(i32) = COPY $x11
    %2:_(i8) = G_TRUNC %0(i32)
    %3:_(i8) = G_TRUNC %1(i32)
    %4:_(i8) = G_UMIN %2, %3
    %5:_(i32) = G_ZEXT %4(i8)
    $x10 = COPY %5(i32)
    PseudoRET implicit $x10
...

