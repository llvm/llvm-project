---
name:            umin_i64
body:             |
  bb.0.entry:
    liveins: $x10, $x11, $x12, $x13
    ; CHECK-LABEL: name: umin_i64
    ; CHECK: liveins: $x10, $x11, $x12, $x13
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $x12
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i32) = COPY $x13
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](i32), [[COPY2]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY1]](i32), [[COPY3]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY1]](i32), [[COPY3]]
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP2]](i32), [[ICMP]], [[ICMP1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[SELECT]](i32), [[COPY]], [[COPY2]]
    ; CHECK-NEXT: $x10 = COPY [[SELECT1]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i32) = COPY $x10
    %1:_(i32) = COPY $x11
    %2:_(i32) = COPY $x12
    %3:_(i32) = COPY $x13
    %4:_(i64) = G_MERGE_VALUES %0(i32), %1(i32)
    %5:_(i64) = G_MERGE_VALUES %2(i32), %3(i32)
    %6:_(i64) = G_UMIN %4, %5
    %7:_(i32) = G_TRUNC %6(i64)
    $x10 = COPY %7(i32)
    PseudoRET implicit $x10
...
