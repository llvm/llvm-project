    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i32) = COPY $x13
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[COPY]](i32), [[COPY2]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(sgt), [[COPY1]](i32), [[COPY3]]
