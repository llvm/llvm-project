    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 65535
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i64) = G_AND [[COPY1]], [[C]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), [[AND]](i64), [[AND1]]
    ; CHECK-NEXT: $x10 = COPY [[SUB]](i64)
    ; CHECK-NEXT: $x11 = COPY [[ICMP]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %2:_(i64) = COPY $x10
    %0:_(i16) = G_TRUNC %2(i64)
    %3:_(i64) = COPY $x11
    %1:_(i16) = G_TRUNC %3(i64)
    %4:_(i16), %5:_(i1) = G_USUBO %0, %1
    %6:_(i64) = G_ANYEXT %4(i16)
    %7:_(i64) = G_ANYEXT %5(i1)
    $x10 = COPY %6(i64)
    $x11 = COPY %7(i64)
    PseudoRET implicit $x10, implicit $x11

...
