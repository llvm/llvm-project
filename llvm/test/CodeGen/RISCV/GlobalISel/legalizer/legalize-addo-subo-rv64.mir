---
name:            saddo_i8
body:             |
  bb.1:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: saddo_i8
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 56
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[COPY]], [[C]](i64)
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(i64) = G_ASHR [[SHL]], [[C]](i64)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL [[COPY1]], [[C]](i64)
    ; CHECK-NEXT: [[ASHR1:%[0-9]+]]:_(i64) = G_ASHR [[SHL1]], [[C]](i64)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[ASHR]], [[ASHR1]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL [[ADD]], [[C]](i64)
    ; CHECK-NEXT: [[ASHR2:%[0-9]+]]:_(i64) = G_ASHR [[SHL2]], [[C]](i64)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i64) = G_ICMP intpred(ne), [[ADD]](i64), [[ASHR2]]
    ; CHECK-NEXT: $x10 = COPY [[ADD]](i64)
    ; CHECK-NEXT: $x11 = COPY [[ICMP]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %2:_(i64) = COPY $x10
    %0:_(i8) = G_TRUNC %2(i64)
    %3:_(i64) = COPY $x11
    %1:_(i8) = G_TRUNC %3(i64)
    %4:_(i8), %5:_(i1) = G_SADDO %0, %1
    %6:_(i64) = G_ANYEXT %4(i8)
    %7:_(i64) = G_ANYEXT %5(i1)
    $x10 = COPY %6(i64)
    $x11 = COPY %7(i64)
    PseudoRET implicit $x10, implicit $x11

...
