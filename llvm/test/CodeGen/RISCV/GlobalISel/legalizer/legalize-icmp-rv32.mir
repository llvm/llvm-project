    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[XOR]], [[XOR1]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[OR]](i32), [[C2]]
    ; CHECK-NEXT: $x10 = COPY [[ICMP]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %xhi:_(i32) = COPY $x10
    %xlo:_(i32) = COPY $x11
    %yhi:_(i32) = COPY $x12
    %ylo:_(i32) = COPY $x13
    %x0:_(i64) = G_MERGE_VALUES %xhi(i32), %xlo(i32)
    %y0:_(i64) = G_MERGE_VALUES %yhi(i32), %ylo(i32)
    %x:_(i48) = G_TRUNC %x0(i64)
    %y:_(i48) = G_TRUNC %y0(i64)
    %z:_(i1) = G_ICMP intpred(ne), %x(i48), %y
    %z0:_(i32) = G_ANYEXT %z(i1)
    $x10 = COPY %z0(i32)
    PseudoRET implicit $x10

...
