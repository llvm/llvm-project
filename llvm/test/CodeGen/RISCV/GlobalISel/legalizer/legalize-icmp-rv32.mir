---
name:            cmp_slt_i128
body:             |
  bb.1:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: cmp_slt_i128
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x10
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i32) = G_LOAD [[COPY]](p0) :: (load (i32), align 8)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C]](i32)
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD]](p0) :: (load (i32) from unknown-address + 4)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[PTR_ADD1:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C1]](i32)
    ; CHECK-NEXT: [[LOAD2:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD1]](p0) :: (load (i32) from unknown-address + 8, align 8)
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 12
    ; CHECK-NEXT: [[PTR_ADD2:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C2]](i32)
    ; CHECK-NEXT: [[LOAD3:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD2]](p0) :: (load (i32) from unknown-address + 12)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(p0) = COPY $x11
    ; CHECK-NEXT: [[LOAD4:%[0-9]+]]:_(i32) = G_LOAD [[COPY1]](p0) :: (load (i32), align 8)
    ; CHECK-NEXT: [[PTR_ADD3:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY1]], [[C]](i32)
    ; CHECK-NEXT: [[LOAD5:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD3]](p0) :: (load (i32) from unknown-address + 4)
    ; CHECK-NEXT: [[PTR_ADD4:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY1]], [[C1]](i32)
    ; CHECK-NEXT: [[LOAD6:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD4]](p0) :: (load (i32) from unknown-address + 8, align 8)
    ; CHECK-NEXT: [[PTR_ADD5:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY1]], [[C2]](i32)
    ; CHECK-NEXT: [[LOAD7:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD5]](p0) :: (load (i32) from unknown-address + 12)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[LOAD]](i32), [[LOAD4]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[LOAD1]](i32), [[LOAD5]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[LOAD1]](i32), [[LOAD5]]
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP2]](i32), [[ICMP]], [[ICMP1]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[LOAD2]](i32), [[LOAD6]]
    ; CHECK-NEXT: [[ICMP4:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[LOAD2]](i32), [[LOAD6]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[ICMP4]](i32), [[SELECT]], [[ICMP3]]
    ; CHECK-NEXT: [[ICMP5:%[0-9]+]]:_(i32) = G_ICMP intpred(slt), [[LOAD3]](i32), [[LOAD7]]
    ; CHECK-NEXT: [[ICMP6:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[LOAD3]](i32), [[LOAD7]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[ICMP6]](i32), [[SELECT1]], [[ICMP5]]
    ; CHECK-NEXT: $x10 = COPY [[SELECT2]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %2:_(p0) = COPY $x10
    %0:_(i128) = G_LOAD %2(p0) :: (load (i128), align 8)
    %3:_(p0) = COPY $x11
    %1:_(i128) = G_LOAD %3(p0) :: (load (i128), align 8)
    %4:_(i1) = G_ICMP intpred(slt), %0(i128), %1
    %5:_(i32) = G_ANYEXT %4(i1)
    $x10 = COPY %5(i32)
    PseudoRET implicit $x10

...
