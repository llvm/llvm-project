name:            lshr_i48
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: lshr_i48
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 281474976710655
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i64) = G_AND [[COPY1]], [[C]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[AND]], [[AND1]](i64)
    ; CHECK-NEXT: $x10 = COPY [[LSHR]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %2:_(i64) = COPY $x10
    %0:_(i48) = G_TRUNC %2(i64)
    %3:_(i64) = COPY $x11
    %1:_(i48) = G_TRUNC %3(i64)
    %4:_(i48) = G_LSHR %0, %1(i48)
    %5:_(i64) = G_ANYEXT %4(i48)
    $x10 = COPY %5(i64)
    PseudoRET implicit $x10

...
