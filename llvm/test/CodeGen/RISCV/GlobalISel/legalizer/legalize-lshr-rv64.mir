name:            lshr_i32_const_exact
body:             |
  bb.0:
    liveins: $x10

    ; CHECK-LABEL: name: lshr_i32_const_exact
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 5
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 4294967295
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY]], [[C1]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = exact G_LSHR [[AND]], [[C]](i64)
    ; CHECK-NEXT: $x10 = COPY [[LSHR]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i64) = COPY $x10
    %1:_(i32) = G_TRUNC %0(i64)
    %2:_(i32) = G_CONSTANT i32 5
    %3:_(i32) = exact G_LSHR %1, %2(i32)
    %4:_(i64) = G_ANYEXT %3(i32)
    $x10 = COPY %4(i64)
    PseudoRET implicit $x10

