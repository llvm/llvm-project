name:            lshr_i32_i48
body:             |
  bb.1:
    liveins: $x10

    ; CHECK-LABEL: name: lshr_i32_i48
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
