    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 4294967295
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY]], [[C1]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[AND]], [[C]](i64)
    ; CHECK-NEXT: $x10 = COPY [[LSHR]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %1:_(i64) = COPY $x10
    %0:_(i48) = G_TRUNC %1(i64)
    %2:_(i48) = G_CONSTANT i48 16
    %6:_(i32) = G_TRUNC %0(i48)
    %7:_(i32) = G_LSHR %6, %2(i48)
    %5:_(i64) = G_ANYEXT %7(i32)
    $x10 = COPY %5(i64)
    PseudoRET implicit $x10

...
