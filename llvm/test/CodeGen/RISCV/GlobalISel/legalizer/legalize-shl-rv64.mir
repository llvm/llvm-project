    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL %mid1, %lo2(i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[LSHR]], [[SHL1]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL %lo1, [[SUB2]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP2]](i64), [[SHL]], [[C1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i64) = G_SELECT [[ICMP2]](i64), [[OR]], [[SHL2]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i64) = G_SELECT [[ICMP3]](i64), %mid1, [[SELECT1]]
    ; CHECK-NEXT: [[SUB4:%[0-9]+]]:_(i64) = G_SUB [[SUB1]], [[C2]]
    ; CHECK-NEXT: [[SUB5:%[0-9]+]]:_(i64) = G_SUB [[C2]], [[SUB1]]
    ; CHECK-NEXT: [[ICMP4:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), [[SUB1]](i64), [[C2]]
    ; CHECK-NEXT: [[ICMP5:%[0-9]+]]:_(i64) = G_ICMP intpred(eq), [[SUB1]](i64), [[C1]]
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(i64) = G_LSHR %lo1, [[SUB1]](i64)
    ; CHECK-NEXT: [[SHL3:%[0-9]+]]:_(i64) = G_SHL %mid1, [[SUB5]](i64)
    ; CHECK-NEXT: [[OR1:%[0-9]+]]:_(i64) = G_OR [[LSHR1]], [[SHL3]]
    ; CHECK-NEXT: [[LSHR2:%[0-9]+]]:_(i64) = G_LSHR %mid1, [[SUB4]](i64)
    ; CHECK-NEXT: [[SELECT3:%[0-9]+]]:_(i64) = G_SELECT [[ICMP4]](i64), [[OR1]], [[LSHR2]]
    ; CHECK-NEXT: [[SELECT4:%[0-9]+]]:_(i64) = G_SELECT [[ICMP5]](i64), %lo1, [[SELECT3]]
    ; CHECK-NEXT: [[ICMP6:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), %lo2(i64), [[C2]]
    ; CHECK-NEXT: [[SHL4:%[0-9]+]]:_(i64) = G_SHL %hi1, %lo2(i64)
    ; CHECK-NEXT: [[SELECT5:%[0-9]+]]:_(i64) = G_SELECT [[ICMP6]](i64), [[SHL4]], [[C1]]
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(i64) = G_OR [[SELECT4]], [[SELECT5]]
    ; CHECK-NEXT: [[ICMP7:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), [[SUB]](i64), [[C2]]
    ; CHECK-NEXT: [[SHL5:%[0-9]+]]:_(i64) = G_SHL %lo1, [[SUB]](i64)
    ; CHECK-NEXT: [[SELECT6:%[0-9]+]]:_(i64) = G_SELECT [[ICMP7]](i64), [[SHL5]], [[C1]]
    ; CHECK-NEXT: [[SELECT7:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i64), [[SELECT]], [[C1]]
    ; CHECK-NEXT: [[SELECT8:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i64), [[SELECT2]], [[C1]]
    ; CHECK-NEXT: [[SELECT9:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i64), [[OR2]], [[SELECT6]]
    ; CHECK-NEXT: [[SELECT10:%[0-9]+]]:_(i64) = G_SELECT [[ICMP1]](i64), %hi1, [[SELECT9]]
    ; CHECK-NEXT: $x10 = COPY [[SELECT7]](i64)
    ; CHECK-NEXT: $x11 = COPY [[SELECT8]](i64)
    ; CHECK-NEXT: $x12 = COPY [[SELECT10]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11, implicit $x12
    %lo1:_(i64) = COPY $x10
    %mid1:_(i64) = COPY $x11
    %hi1:_(i64) = COPY $x12
    %lo2:_(i64) = COPY $x13
    %mid2:_(i64) = COPY $x14
    %hi2:_(i64) = COPY $x15
    %x1:_(i192) = G_MERGE_VALUES %lo1(i64), %mid1(i64), %hi1(i64)
    %x2:_(i192) = G_MERGE_VALUES %lo2(i64), %mid2(i64), %hi2(i64)
    %y:_(i192) = G_SHL %x1, %x2
    %lo:_(i64), %mid:_(i64), %hi:_(i64) = G_UNMERGE_VALUES %y(i192)
    $x10 = COPY %lo(i64)
    $x11 = COPY %mid(i64)
    $x12 = COPY %hi(i64)
    PseudoRET implicit $x10, implicit $x11, implicit $x12

