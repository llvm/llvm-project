    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL %x01, %y00(i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[LSHR]], [[SHL1]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL %x00, [[SUB]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i64), [[SHL]], [[C1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i64), [[OR]], [[SHL2]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i64) = G_SELECT [[ICMP1]](i64), %x01, [[SELECT1]]
