    %y01:_(i64) = COPY $x13
    %x0:_(i128) = G_MERGE_VALUES %x00(i64), %x01
    %y0:_(i128) = G_MERGE_VALUES %y00(i64), %y01
    %x:_(i72) = G_TRUNC %x0(i128)
    %y:_(i72) = G_TRUNC %y0(i128)
    %z:_(i72) = G_SHL %x, %y
    %z0:_(i128) = G_ANYEXT %z(i72)
