    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB %y00, [[C]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i64) = G_SUB [[C]], %y00
