    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[SUB2:%[0-9]+]]:_(i64) = G_SUB %lo2, [[C2]]
    ; CHECK-NEXT: [[SUB3:%[0-9]+]]:_(i64) = G_SUB [[C2]], %lo2
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i64) = G_ICMP intpred(ult), %lo2(i64), [[C2]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i64) = G_ICMP intpred(eq), %lo2(i64), [[C1]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL %lo1, %lo2(i64)
