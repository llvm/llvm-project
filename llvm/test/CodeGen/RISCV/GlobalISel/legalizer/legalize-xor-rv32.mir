---
name:            xor_i7
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    ; CHECK-LABEL: name: xor_i7
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $x11
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i32) = G_XOR [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $x10 = COPY [[XOR]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i32) = COPY $x10
    %1:_(i32) = COPY $x11
    %2:_(i7) = G_TRUNC %0(i32)
    %3:_(i7) = G_TRUNC %1(i32)
    %4:_(i7) = G_XOR %2, %3
    %5:_(i32) = G_ANYEXT %4(i7)
    $x10 = COPY %5(i32)
    PseudoRET implicit $x10

...
