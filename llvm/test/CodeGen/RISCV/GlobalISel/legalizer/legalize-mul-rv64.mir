# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -run-pass=legalizer %s -o - \
# RUN: | FileCheck %s
---
name:            mul_i8
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    ; CHECK-LABEL: name: mul_i8
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: $x10 = COPY [[COPY]](i64)
    ; CHECK-NEXT: $x11 = COPY [[COPY1]](i64)
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) &__muldi3, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x10
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: $x10 = COPY [[COPY2]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i64) = COPY $x10
    %1:_(i64) = COPY $x11
    %2:_(i8) = G_TRUNC %0(i64)
    %3:_(i8) = G_TRUNC %1(i64)
    %4:_(i8) = G_MUL %2, %3
    %5:_(i64) = G_ANYEXT %4(i8)
    $x10 = COPY %5(i64)
    PseudoRET implicit $x10

...
