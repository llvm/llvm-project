name:            mul_i128
body:             |
  bb.0.entry:
    liveins: $x10, $x11, $x12, $x13
    ; CHECK-LABEL: name: mul_i128
    ; CHECK: liveins: $x10, $x11, $x12, $x13
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %lo1:_(i64) = COPY $x10
    ; CHECK-NEXT: %hi1:_(i64) = COPY $x11
    ; CHECK-NEXT: %lo2:_(i64) = COPY $x12
    ; CHECK-NEXT: %hi2:_(i64) = COPY $x13
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: $x10 = COPY %lo1(i64)
    ; CHECK-NEXT: $x11 = COPY %hi1(i64)
    ; CHECK-NEXT: $x12 = COPY %lo2(i64)
    ; CHECK-NEXT: $x13 = COPY %hi2(i64)
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) &__multi3, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit $x12, implicit $x13, implicit-def $x10, implicit-def $x11
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def $x2, implicit $x2
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: $x10 = COPY [[COPY]](i64)
    ; CHECK-NEXT: $x11 = COPY [[COPY1]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %lo1:_(i64) = COPY $x10
    %hi1:_(i64) = COPY $x11
    %lo2:_(i64) = COPY $x12
    %hi2:_(i64) = COPY $x13
    %x1:_(i128) = G_MERGE_VALUES %lo1(i64), %hi1(i64)
    %x2:_(i128) = G_MERGE_VALUES %lo2(i64), %hi2(i64)
    %y:_(i128) = G_MUL %x1, %x2
    %loy:_(i64), %hiy:_(i64) = G_UNMERGE_VALUES %y(i128)
    $x10 = COPY %loy(i64)
    $x11 = COPY %hiy(i64)
    PseudoRET implicit $x10, implicit $x11

