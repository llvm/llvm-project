    liveins: $x10, $x11, $x12, $x13
    ; CHECK-LABEL: name: shl_i48
    ; CHECK: liveins: $x10, $x11, $x12, $x13
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %xlo:_(i32) = COPY $x10
    ; CHECK-NEXT: %xhi:_(i32) = COPY $x11
    ; CHECK-NEXT: %ylo:_(i32) = COPY $x12
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 32
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB %ylo, [[C]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i32) = G_SUB [[C]], %ylo
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), %ylo(i32), [[C]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), %ylo(i32), [[C1]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i32) = G_SHL %xlo, %ylo(i32)
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR %xlo, [[SUB1]](i32)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i32) = G_SHL %xhi, %ylo(i32)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[LSHR]], [[SHL1]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i32) = G_SHL %xlo, [[SUB]](i32)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i32), [[SHL]], [[C1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i32), [[OR]], [[SHL2]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[ICMP1]](i32), %xhi, [[SELECT1]]
    ; CHECK-NEXT: $x10 = COPY [[SELECT]](i32)
    ; CHECK-NEXT: $x11 = COPY [[SELECT2]](i32)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %xlo:_(i32) = COPY $x10
    %xhi:_(i32) = COPY $x11
    %ylo:_(i32) = COPY $x12
    %yhi:_(i32) = COPY $x13
    %x0:_(i64) = G_MERGE_VALUES %xlo(i32), %xhi(i32)
    %y0:_(i64) = G_MERGE_VALUES %ylo(i32), %yhi(i32)
    %x:_(i48) = G_TRUNC %x0(i64)
    %y:_(i48) = G_TRUNC %y0(i64)
    %z:_(i48) = G_SHL %x, %y
    %z0:_(i64) = G_ANYEXT %z(i48)
    %zlo:_(i32), %zhi:_(i32) = G_UNMERGE_VALUES %z0(i64)
    $x10 = COPY %zlo(i32)
    $x11 = COPY %zhi(i32)
    PseudoRET implicit $x10, implicit $x11

