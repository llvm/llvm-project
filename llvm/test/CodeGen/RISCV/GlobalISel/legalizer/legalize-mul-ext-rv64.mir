    ; CHECK-NEXT: %yhi:_(i64) = COPY $x13
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL %xlo, %ylo
    ; CHECK-NEXT: [[UMULH:%[0-9]+]]:_(i64) = G_UMULH %xlo, %ylo
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i64) = G_MUL %xlo, %yhi
