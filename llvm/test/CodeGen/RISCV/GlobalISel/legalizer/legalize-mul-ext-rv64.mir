name:            smulh_i32
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    ; CHECK-LABEL: name: smulh_i32
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x11
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i64) = G_SEXT_INREG [[COPY]], 32
    ; CHECK-NEXT: [[SEXT_INREG1:%[0-9]+]]:_(i64) = G_SEXT_INREG [[COPY1]], 32
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[SEXT_INREG]], [[SEXT_INREG1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 32
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(i64) = G_ASHR [[MUL]], [[C]](i64)
    ; CHECK-NEXT: $x10 = COPY [[ASHR]](i64)
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:_(i64) = COPY $x10
    %1:_(i64) = COPY $x11
    %2:_(i32) = G_TRUNC %0(i64)
    %3:_(i32) = G_TRUNC %1(i64)
    %4:_(i32) = G_SMULH %2, %3
    %5:_(i64) = G_ANYEXT %4(i32)
    $x10 = COPY %5(i64)
    PseudoRET implicit $x10

