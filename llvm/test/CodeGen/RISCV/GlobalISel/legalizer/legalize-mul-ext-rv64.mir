    %xhi:_(i64) = COPY $x11
    %ylo:_(i64) = COPY $x12
    %yhi:_(i64) = COPY $x13
    %x0:_(i128) = G_MERGE_VALUES %xlo(i64), %xhi(i64)
    %y0:_(i128) = G_MERGE_VALUES %ylo(i64), %yhi(i64)
    %x:_(i72) = G_TRUNC %x0(i128)
    %y:_(i72) = G_TRUNC %y0(i128)
    %z:_(i72) = G_MUL %x, %y
    %z0:_(i128) = G_ANYEXT %z(i72)
