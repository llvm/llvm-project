; GEPs whose source element type is scalable have a vscale-dependent stride.

define ptr @const_idx(ptr %p) {
  ; CHECK-LABEL: name: const_idx
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $x10
  ; CHECK-NEXT:   [[VSCALE:%[0-9]+]]:_(i64) = G_VSCALE i64 32
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY]], [[VSCALE]](i64)
  ; CHECK-NEXT:   $x10 = COPY [[PTR_ADD]](p0)
  ; CHECK-NEXT:   PseudoRET implicit $x10
  %q = getelementptr <vscale x 16 x i8>, ptr %p, i64 2
  ret ptr %q
}

; Negative constant indices are not folded into the G_VSCALE immediate.
define ptr @neg_const_idx(ptr %p) {
  ; CHECK-LABEL: name: neg_const_idx
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $x10
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 -2
  ; CHECK-NEXT:   [[SEXT:%[0-9]+]]:_(i64) = G_SEXT [[C]](i32)
  ; CHECK-NEXT:   [[VSCALE:%[0-9]+]]:_(i64) = G_VSCALE i64 16
  ; CHECK-NEXT:   [[MUL:%[0-9]+]]:_(i64) = nsw G_MUL [[SEXT]], [[VSCALE]]
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = nusw inbounds G_PTR_ADD [[COPY]], [[MUL]](i64)
  ; CHECK-NEXT:   $x10 = COPY [[PTR_ADD]](p0)
  ; CHECK-NEXT:   PseudoRET implicit $x10
  %q = getelementptr inbounds <vscale x 2 x i64>, ptr %p, i32 -2
  ret ptr %q
}

