; RUN: llc -global-isel=1 -mtriple=riscv32 -mattr=+f,+d -target-abi=ilp32 -verify-machineinstrs < %s \
; RUN:     | FileCheck %s

define fastcc float @callee([32 x float] %A) nounwind {
; CHECK-LABEL: callee:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmv.x.w a0, fa1
; CHECK-NEXT:    ret
  %b = extractvalue [32 x float] %A, 1
  ret float %b
}

; With the fastcc, arguments will be passed by fa0-fa7 and ft0-ft11.
