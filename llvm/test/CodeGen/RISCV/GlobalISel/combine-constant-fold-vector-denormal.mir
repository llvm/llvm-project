# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=ieee %s -o - | FileCheck %s --check-prefix=IEEE
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=preserve-sign %s -o - | FileCheck %s --check-prefix=NONIEEE
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=positive-zero %s -o - | FileCheck %s --check-prefix=NONIEEE
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=dynamic %s -o - | FileCheck %s --check-prefix=NONIEEE
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=ieee -denormal-fp-math-f32=preserve-sign %s -o - | FileCheck %s --check-prefix=F32-NONIEEE

# RISC-V uses untyped s16/s32/s64 for FP values. Vector FP constant folds must
# check the denormal mode of the matching IEEE format and fold only under IEEE.
# Inputs are the smallest subnormal of each format. The last RUN line flushes
# only f32, so only the s32 cases stay unfolded.

# fadd: x + x.
---
name:            fadd_vector_denormal_s32
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal_s32
    ; IEEE: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 2.802600e-45
    ; IEEE-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; IEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; NONIEEE-LABEL: name: fadd_vector_denormal_s32
    ; NONIEEE: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; NONIEEE-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; NONIEEE-NEXT: %res:_(<2 x s32>) = G_FADD %av, %av
    ; NONIEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; NONIEEE-NEXT: PseudoRET implicit $v8
    ;
    ; F32-NONIEEE-LABEL: name: fadd_vector_denormal_s32
    ; F32-NONIEEE: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; F32-NONIEEE-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; F32-NONIEEE-NEXT: %res:_(<2 x s32>) = G_FADD %av, %av
    ; F32-NONIEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; F32-NONIEEE-NEXT: PseudoRET implicit $v8
    %denorm:_(s32) = G_FCONSTANT float 0x36A0000000000000
    %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    %res:_(<2 x s32>) = G_FADD %av, %av
    $v8 = COPY %res(<2 x s32>)
    PseudoRET implicit $v8

...

# fneg: unary fold path applies the same guard.
---
name:            fneg_vector_denormal_s32
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fneg_vector_denormal_s32
    ; IEEE: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float -1.401300e-45
    ; IEEE-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; IEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; NONIEEE-LABEL: name: fneg_vector_denormal_s32
    ; NONIEEE: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; NONIEEE-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; NONIEEE-NEXT: %res:_(<2 x s32>) = G_FNEG %av
    ; NONIEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; NONIEEE-NEXT: PseudoRET implicit $v8
    ;
    ; F32-NONIEEE-LABEL: name: fneg_vector_denormal_s32
    ; F32-NONIEEE: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; F32-NONIEEE-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; F32-NONIEEE-NEXT: %res:_(<2 x s32>) = G_FNEG %av
    ; F32-NONIEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; F32-NONIEEE-NEXT: PseudoRET implicit $v8
    %denorm:_(s32) = G_FCONSTANT float 0x36A0000000000000
    %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    %res:_(<2 x s32>) = G_FNEG %av
    $v8 = COPY %res(<2 x s32>)
    PseudoRET implicit $v8

...

# fma: fma(x, 1.0, x) = x + x.
---
name:            fma_vector_denormal_s32
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fma_vector_denormal_s32
    ; IEEE: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 2.802600e-45
    ; IEEE-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; IEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; NONIEEE-LABEL: name: fma_vector_denormal_s32
    ; NONIEEE: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; NONIEEE-NEXT: %one:_(s32) = G_FCONSTANT float 1.000000e+00
    ; NONIEEE-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; NONIEEE-NEXT: %bv:_(<2 x s32>) = G_BUILD_VECTOR %one(s32), %one(s32)
    ; NONIEEE-NEXT: %res:_(<2 x s32>) = G_FMA %av, %bv, %av
    ; NONIEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; NONIEEE-NEXT: PseudoRET implicit $v8
    ;
    ; F32-NONIEEE-LABEL: name: fma_vector_denormal_s32
    ; F32-NONIEEE: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; F32-NONIEEE-NEXT: %one:_(s32) = G_FCONSTANT float 1.000000e+00
    ; F32-NONIEEE-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; F32-NONIEEE-NEXT: %bv:_(<2 x s32>) = G_BUILD_VECTOR %one(s32), %one(s32)
    ; F32-NONIEEE-NEXT: %res:_(<2 x s32>) = G_FMA %av, %bv, %av
    ; F32-NONIEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; F32-NONIEEE-NEXT: PseudoRET implicit $v8
    %denorm:_(s32) = G_FCONSTANT float 0x36A0000000000000
    %one:_(s32) = G_FCONSTANT float 1.0
    %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    %bv:_(<2 x s32>) = G_BUILD_VECTOR %one(s32), %one(s32)
    %res:_(<2 x s32>) = G_FMA %av, %bv, %av
    $v8 = COPY %res(<2 x s32>)
    PseudoRET implicit $v8

...

# s16 (half) uses the default mode, so it folds when only f32 is flushed.
---
name:            fadd_vector_denormal_s16
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal_s16
    ; IEEE: [[C:%[0-9]+]]:_(s16) = G_FCONSTANT half 1.192090e-07
    ; IEEE-NEXT: %res:_(<4 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
    ; IEEE-NEXT: $v8 = COPY %res(<4 x s16>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; NONIEEE-LABEL: name: fadd_vector_denormal_s16
    ; NONIEEE: %denorm:_(s16) = G_FCONSTANT half 5.960460e-08
    ; NONIEEE-NEXT: %av:_(<4 x s16>) = G_BUILD_VECTOR %denorm(s16), %denorm(s16), %denorm(s16), %denorm(s16)
    ; NONIEEE-NEXT: %res:_(<4 x s16>) = G_FADD %av, %av
    ; NONIEEE-NEXT: $v8 = COPY %res(<4 x s16>)
    ; NONIEEE-NEXT: PseudoRET implicit $v8
    ;
    ; F32-NONIEEE-LABEL: name: fadd_vector_denormal_s16
    ; F32-NONIEEE: [[C:%[0-9]+]]:_(s16) = G_FCONSTANT half 1.192090e-07
    ; F32-NONIEEE-NEXT: %res:_(<4 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
    ; F32-NONIEEE-NEXT: $v8 = COPY %res(<4 x s16>)
    ; F32-NONIEEE-NEXT: PseudoRET implicit $v8
    %denorm:_(s16) = G_FCONSTANT half 0xH0001
    %av:_(<4 x s16>) = G_BUILD_VECTOR %denorm(s16), %denorm(s16), %denorm(s16), %denorm(s16)
    %res:_(<4 x s16>) = G_FADD %av, %av
    $v8 = COPY %res(<4 x s16>)
    PseudoRET implicit $v8

...

