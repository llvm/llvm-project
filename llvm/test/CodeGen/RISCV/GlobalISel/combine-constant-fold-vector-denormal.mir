name:            fadd_vector_denormal_s64
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal_s64
    ; IEEE: [[C:%[0-9]+]]:_(s64) = G_FCONSTANT double 9.881310e-324
    ; IEEE-NEXT: %res:_(<2 x s64>) = G_BUILD_VECTOR [[C]](s64), [[C]](s64)
    ; IEEE-NEXT: $v8m2 = COPY %res(<2 x s64>)
    ; IEEE-NEXT: PseudoRET implicit $v8m2
    ;
    ; NONIEEE-LABEL: name: fadd_vector_denormal_s64
    ; NONIEEE: %denorm:_(s64) = G_FCONSTANT double 4.940660e-324
    ; NONIEEE-NEXT: %av:_(<2 x s64>) = G_BUILD_VECTOR %denorm(s64), %denorm(s64)
    ; NONIEEE-NEXT: %res:_(<2 x s64>) = G_FADD %av, %av
