# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=ieee %s -o - | FileCheck %s --check-prefixes=CHECK,IEEE
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=preserve-sign %s -o - | FileCheck %s --check-prefixes=CHECK,FTZ
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=positive-zero %s -o - | FileCheck %s --check-prefixes=CHECK,FTZ
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=dynamic %s -o - | FileCheck %s --check-prefixes=CHECK,DYNAMIC
# RUN: llc -mtriple=riscv64 -run-pass=riscv-prelegalizer-combiner -denormal-fp-math=ieee -denormal-fp-math-f32=preserve-sign %s -o - | FileCheck %s --check-prefixes=CHECK,F32-FTZ

# RISC-V uses untyped s16/s32/s64 for FP values. Vector FP constant folds must
# honour the denormal mode of the matching IEEE format: arithmetic folds to zero
# with flushing enabled and stays unfolded when flushing is dynamic.
# Inputs are the smallest subnormal of each format. The last RUN line flushes
# only f32, so the s16/s64 arithmetic keeps its IEEE result.
# FNEG only changes the sign bit and preserves subnormals in every mode.

# fadd: x + x.
---
name:            fadd_vector_denormal_s32
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal_s32
    ; IEEE: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 2.802600e-45
    ; IEEE-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; IEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; FTZ-LABEL: name: fadd_vector_denormal_s32
    ; FTZ: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 0.000000e+00
    ; FTZ-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; FTZ-NEXT: $v8 = COPY %res(<2 x s32>)
    ; FTZ-NEXT: PseudoRET implicit $v8
    ;
    ; DYNAMIC-LABEL: name: fadd_vector_denormal_s32
    ; DYNAMIC: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; DYNAMIC-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; DYNAMIC-NEXT: %res:_(<2 x s32>) = G_FADD %av, %av
    ; DYNAMIC-NEXT: $v8 = COPY %res(<2 x s32>)
    ; DYNAMIC-NEXT: PseudoRET implicit $v8
    ;
    ; F32-FTZ-LABEL: name: fadd_vector_denormal_s32
    ; F32-FTZ: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 0.000000e+00
    ; F32-FTZ-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; F32-FTZ-NEXT: $v8 = COPY %res(<2 x s32>)
    ; F32-FTZ-NEXT: PseudoRET implicit $v8
    %denorm:_(s32) = G_FCONSTANT float f0x00000001
    %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    %res:_(<2 x s32>) = G_FADD %av, %av
    $v8 = COPY %res(<2 x s32>)
    PseudoRET implicit $v8

...

# fneg: fold without flushing, independently of the denormal mode.
---
name:            fneg_vector_denormal_s32
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: fneg_vector_denormal_s32
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float -1.401300e-45
    ; CHECK-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; CHECK-NEXT: $v8 = COPY %res(<2 x s32>)
    ; CHECK-NEXT: PseudoRET implicit $v8
    %denorm:_(s32) = G_FCONSTANT float f0x00000001
    %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    %res:_(<2 x s32>) = G_FNEG %av
    $v8 = COPY %res(<2 x s32>)
    PseudoRET implicit $v8

...

# fma: fma(x, 1.0, x) = x + x.
---
name:            fma_vector_denormal_s32
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fma_vector_denormal_s32
    ; IEEE: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 2.802600e-45
    ; IEEE-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; IEEE-NEXT: $v8 = COPY %res(<2 x s32>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; FTZ-LABEL: name: fma_vector_denormal_s32
    ; FTZ: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 0.000000e+00
    ; FTZ-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; FTZ-NEXT: $v8 = COPY %res(<2 x s32>)
    ; FTZ-NEXT: PseudoRET implicit $v8
    ;
    ; DYNAMIC-LABEL: name: fma_vector_denormal_s32
    ; DYNAMIC: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; DYNAMIC-NEXT: %one:_(s32) = G_FCONSTANT float 1.000000e+00
    ; DYNAMIC-NEXT: %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    ; DYNAMIC-NEXT: %bv:_(<2 x s32>) = G_BUILD_VECTOR %one(s32), %one(s32)
    ; DYNAMIC-NEXT: %res:_(<2 x s32>) = G_FMA %av, %bv, %av
    ; DYNAMIC-NEXT: $v8 = COPY %res(<2 x s32>)
    ; DYNAMIC-NEXT: PseudoRET implicit $v8
    ;
    ; F32-FTZ-LABEL: name: fma_vector_denormal_s32
    ; F32-FTZ: [[C:%[0-9]+]]:_(s32) = G_FCONSTANT float 0.000000e+00
    ; F32-FTZ-NEXT: %res:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; F32-FTZ-NEXT: $v8 = COPY %res(<2 x s32>)
    ; F32-FTZ-NEXT: PseudoRET implicit $v8
    %denorm:_(s32) = G_FCONSTANT float f0x00000001
    %one:_(s32) = G_FCONSTANT float 1.0
    %av:_(<2 x s32>) = G_BUILD_VECTOR %denorm(s32), %denorm(s32)
    %bv:_(<2 x s32>) = G_BUILD_VECTOR %one(s32), %one(s32)
    %res:_(<2 x s32>) = G_FMA %av, %bv, %av
    $v8 = COPY %res(<2 x s32>)
    PseudoRET implicit $v8

...

# s16 (half) uses the default mode, so it keeps subnormals when only f32 flushes.
---
name:            fadd_vector_denormal_s16
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal_s16
    ; IEEE: [[C:%[0-9]+]]:_(s16) = G_FCONSTANT half 1.192090e-07
    ; IEEE-NEXT: %res:_(<4 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
    ; IEEE-NEXT: $v8 = COPY %res(<4 x s16>)
    ; IEEE-NEXT: PseudoRET implicit $v8
    ;
    ; FTZ-LABEL: name: fadd_vector_denormal_s16
    ; FTZ: [[C:%[0-9]+]]:_(s16) = G_FCONSTANT half 0.000000e+00
    ; FTZ-NEXT: %res:_(<4 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
    ; FTZ-NEXT: $v8 = COPY %res(<4 x s16>)
    ; FTZ-NEXT: PseudoRET implicit $v8
    ;
    ; DYNAMIC-LABEL: name: fadd_vector_denormal_s16
    ; DYNAMIC: %denorm:_(s16) = G_FCONSTANT half 5.960460e-08
    ; DYNAMIC-NEXT: %av:_(<4 x s16>) = G_BUILD_VECTOR %denorm(s16), %denorm(s16), %denorm(s16), %denorm(s16)
    ; DYNAMIC-NEXT: %res:_(<4 x s16>) = G_FADD %av, %av
    ; DYNAMIC-NEXT: $v8 = COPY %res(<4 x s16>)
    ; DYNAMIC-NEXT: PseudoRET implicit $v8
    ;
    ; F32-FTZ-LABEL: name: fadd_vector_denormal_s16
    ; F32-FTZ: [[C:%[0-9]+]]:_(s16) = G_FCONSTANT half 1.192090e-07
    ; F32-FTZ-NEXT: %res:_(<4 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16), [[C]](s16), [[C]](s16)
    ; F32-FTZ-NEXT: $v8 = COPY %res(<4 x s16>)
    ; F32-FTZ-NEXT: PseudoRET implicit $v8
    %denorm:_(s16) = G_FCONSTANT half f0x0001
    %av:_(<4 x s16>) = G_BUILD_VECTOR %denorm(s16), %denorm(s16), %denorm(s16), %denorm(s16)
    %res:_(<4 x s16>) = G_FADD %av, %av
    $v8 = COPY %res(<4 x s16>)
    PseudoRET implicit $v8

...

# s64 (double) uses the default mode, so it keeps subnormals when only f32 flushes.
---
name:            fadd_vector_denormal_s64
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal_s64
    ; IEEE: [[C:%[0-9]+]]:_(s64) = G_FCONSTANT double 9.881310e-324
    ; IEEE-NEXT: %res:_(<2 x s64>) = G_BUILD_VECTOR [[C]](s64), [[C]](s64)
    ; IEEE-NEXT: $v8m2 = COPY %res(<2 x s64>)
    ; IEEE-NEXT: PseudoRET implicit $v8m2
    ;
    ; FTZ-LABEL: name: fadd_vector_denormal_s64
    ; FTZ: [[C:%[0-9]+]]:_(s64) = G_FCONSTANT double 0.000000e+00
    ; FTZ-NEXT: %res:_(<2 x s64>) = G_BUILD_VECTOR [[C]](s64), [[C]](s64)
    ; FTZ-NEXT: $v8m2 = COPY %res(<2 x s64>)
