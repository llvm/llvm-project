    ; F32-FTZ-NEXT: $v8m2 = COPY %res(<2 x s64>)
    ; F32-FTZ-NEXT: PseudoRET implicit $v8m2
    %denorm:_(s64) = G_FCONSTANT double f0x0000000000000001
    %av:_(<2 x s64>) = G_BUILD_VECTOR %denorm(s64), %denorm(s64)
    %res:_(<2 x s64>) = G_FADD %av, %av
    $v8m2 = COPY %res(<2 x s64>)
    PseudoRET implicit $v8m2

