; RV64-LABEL: sub_of_add:
; RV64:       # %bb.0:
; RV64-NEXT:    mul a2, a2, a2
; RV64-NEXT:    sub a0, a0, a1
; RV64-NEXT:    subw a0, a0, a2
; RV64-NEXT:    ret
;
; RV64-O0-LABEL: sub_of_add:
; RV64-O0:       # %bb.0:
; RV64-O0-NEXT:    addi sp, sp, -16
; RV64-O0-NEXT:    sd a1, 8(sp) # 8-byte Folded Spill
; RV64-O0-NEXT:    mv a1, a2
; RV64-O0-NEXT:    ld a2, 8(sp) # 8-byte Folded Reload
; RV64-O0-NEXT:    mulw a1, a1, a1
; RV64-O0-NEXT:    addw a1, a1, a2
; RV64-O0-NEXT:    subw a0, a0, a1
; RV64-O0-NEXT:    addi sp, sp, 16
; RV64-O0-NEXT:    ret
;
; RV64ZBA-LABEL: sub_of_add:
; RV64ZBA:       # %bb.0:
