; Test that a sign-extended i32 register-register add/sub on RV64 is selected
; as a single ADDW/SUBW instead of ADDW/SUBW followed by a separate sext.w,
; which at -O0 is never removed.

define signext i32 @add_sext(i32 signext %a, i32 signext %b) nounwind {
; RV64-LABEL: add_sext:
; RV64:       # %bb.0:
; RV64-NEXT:    addw a0, a0, a1
; RV64-NEXT:    ret
;
; RV64-O0-LABEL: add_sext:
; RV64-O0:       # %bb.0:
; RV64-O0-NEXT:    addw a0, a0, a1
; RV64-O0-NEXT:    ret
;
; RV64ZBA-LABEL: add_sext:
; RV64ZBA:       # %bb.0:
; RV64ZBA-NEXT:    addw a0, a0, a1
; RV64ZBA-NEXT:    ret
  %r = add i32 %a, %b
  ret i32 %r
}

define signext i32 @sub_sext(i32 signext %a, i32 signext %b) nounwind {
; RV64-LABEL: sub_sext:
; RV64:       # %bb.0:
; RV64-NEXT:    subw a0, a0, a1
; RV64-NEXT:    ret
;
; RV64-O0-LABEL: sub_sext:
; RV64-O0:       # %bb.0:
; RV64-O0-NEXT:    subw a0, a0, a1
; RV64-O0-NEXT:    ret
;
; RV64ZBA-LABEL: sub_sext:
; RV64ZBA:       # %bb.0:
; RV64ZBA-NEXT:    subw a0, a0, a1
; RV64ZBA-NEXT:    ret
  %r = sub i32 %a, %b
  ret i32 %r
}

; The intermediate sext.w also blocks MachineCombiner from reassociating
; s - (a + b) when b is the late operand.

