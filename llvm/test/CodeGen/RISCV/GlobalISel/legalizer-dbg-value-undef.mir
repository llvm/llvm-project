# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv32 -run-pass=legalizer %s -o - | FileCheck %s

# A DBG_VALUE must not keep referring to a vreg whose def the legalizer
# erases, both when salvaging fails and when the def dies as an artifact. A
# DBG_VALUE of an unmerge result that a combine forwarded must be kept.

--- |
  define void @dead_merge() !dbg !3 {
    ret void
  }

  define i64 @narrowed_xor() !dbg !8 {
    ret i64 0
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "dead_merge", scope: !1, file: !1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
  !4 = !DISubroutineType(types: !{})
  !5 = !DILocalVariable(name: "a", scope: !3, file: !1, type: !6)
  !6 = !DIBasicType(name: "long long", size: 64, encoding: DW_ATE_signed)
  !7 = !DILocation(line: 1, scope: !3)
  !8 = distinct !DISubprogram(name: "narrowed_xor", scope: !1, file: !1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
  !9 = !DILocalVariable(name: "n", scope: !8, file: !1, type: !6)
  !10 = !DILocation(line: 2, scope: !8)
...
---
name:            dead_merge
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: dead_merge
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: PseudoRET
    %0:_(s32) = COPY $x10
    %1:_(s32) = COPY $x11
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    DBG_VALUE %2(s64), $noreg, !5, !DIExpression(), debug-location !7
    PseudoRET
...
---
name:            narrowed_xor
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: narrowed_xor
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $x11
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 -1
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(s32) = G_XOR [[COPY]], [[C]]
    ; CHECK-NEXT: [[XOR1:%[0-9]+]]:_(s32) = G_XOR [[COPY1]], [[C]]
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 2, scope: !6)
    ; CHECK-NEXT: DBG_VALUE [[XOR]](s32), $noreg, !7, !DIExpression(DW_OP_LLVM_fragment, 0, 32), debug-location !DILocation(line: 2, scope: !6)
    ; CHECK-NEXT: $x10 = COPY [[XOR]](s32)
    ; CHECK-NEXT: $x11 = COPY [[XOR1]](s32)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %0:_(s32) = COPY $x10
    %1:_(s32) = COPY $x11
    %2:_(s64) = G_MERGE_VALUES %0(s32), %1(s32)
    %3:_(s64) = G_CONSTANT i64 -1
    %4:_(s64) = G_XOR %2, %3
    DBG_VALUE %4(s64), $noreg, !9, !DIExpression(), debug-location !10
    %5:_(s32), %6:_(s32) = G_UNMERGE_VALUES %4(s64)
    DBG_VALUE %5(s32), $noreg, !9, !DIExpression(DW_OP_LLVM_fragment, 0, 32), debug-location !10
    $x10 = COPY %5(s32)
    $x11 = COPY %6(s32)
    PseudoRET implicit $x10, implicit $x11
...
