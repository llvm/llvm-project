---
# The add has a second user, so it must not be folded into the sext_inreg.
name:            add_sext_two_uses
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: add_sext_two_uses
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $x11
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:gpr = ADD [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[ADDIW:%[0-9]+]]:gpr = ADDIW [[ADD]], 0
    ; CHECK-NEXT: $x10 = COPY [[ADDIW]]
    ; CHECK-NEXT: $x11 = COPY [[ADD]]
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    %0:gprb(s64) = COPY $x10
    %1:gprb(s64) = COPY $x11
    %2:gprb(s64) = G_ADD %0, %1
    %3:gprb(s64) = G_SEXT_INREG %2, 32
    $x10 = COPY %3(s64)
    $x11 = COPY %2(s64)
    PseudoRET implicit $x10, implicit $x11

...
---
# Adds of constants are left to the immediate patterns.
name:            add_imm_sext
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10

    ; CHECK-LABEL: name: add_imm_sext
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: [[ADDIW:%[0-9]+]]:gpr = ADDIW [[COPY]], 2047
    ; CHECK-NEXT: [[ADDIW1:%[0-9]+]]:gpr = ADDIW [[ADDIW]], 2047
    ; CHECK-NEXT: [[ADDIW2:%[0-9]+]]:gpr = ADDIW [[ADDIW1]], 0
    ; CHECK-NEXT: $x10 = COPY [[ADDIW2]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gprb(s64) = COPY $x10
    %1:gprb(s64) = G_CONSTANT i64 4094
    %2:gprb(s64) = G_ADD %0, %1
    %3:gprb(s64) = G_SEXT_INREG %2, 32
    $x10 = COPY %3(s64)
    PseudoRET implicit $x10

...
---
# Adds of a shift by a constant are left to fused shift-add patterns (SH3ADD).
name:            add_shl_sext
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: add_shl_sext
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $x11
    ; CHECK-NEXT: [[SH3ADD:%[0-9]+]]:gpr = SH3ADD [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[ADDIW:%[0-9]+]]:gpr = ADDIW [[SH3ADD]], 0
    ; CHECK-NEXT: $x10 = COPY [[ADDIW]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gprb(s64) = COPY $x10
    %1:gprb(s64) = COPY $x11
    %2:gprb(s64) = G_CONSTANT i64 3
    %3:gprb(s64) = G_SHL %0, %2(s64)
    %4:gprb(s64) = G_ADD %3, %1
    %5:gprb(s64) = G_SEXT_INREG %4, 32
    $x10 = COPY %5(s64)
    PseudoRET implicit $x10

...
---
# A shift amount that no shift-add instruction can fuse does not block the fold.
name:            add_shl4_sext
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: add_shl4_sext
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $x11
    ; CHECK-NEXT: [[SLLIW:%[0-9]+]]:gpr = SLLIW [[COPY]], 4
    ; CHECK-NEXT: [[ADDW:%[0-9]+]]:gpr = ADDW [[SLLIW]], [[COPY1]]
    ; CHECK-NEXT: $x10 = COPY [[ADDW]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gprb(s64) = COPY $x10
    %1:gprb(s64) = COPY $x11
    %2:gprb(s64) = G_CONSTANT i64 4
    %3:gprb(s64) = G_SHL %0, %2(s64)
    %4:gprb(s64) = G_ADD %3, %1
    %5:gprb(s64) = G_SEXT_INREG %4, 32
    $x10 = COPY %5(s64)
    PseudoRET implicit $x10

...
---
# There is no fused shift-sub, so a shifted operand does not block the fold.
name:            sub_shl_sext
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: sub_shl_sext
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x10
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $x11
    ; CHECK-NEXT: [[SLLIW:%[0-9]+]]:gpr = SLLIW [[COPY]], 3
    ; CHECK-NEXT: [[SUBW:%[0-9]+]]:gpr = SUBW [[COPY1]], [[SLLIW]]
    ; CHECK-NEXT: $x10 = COPY [[SUBW]]
    ; CHECK-NEXT: PseudoRET implicit $x10
    %0:gprb(s64) = COPY $x10
    %1:gprb(s64) = COPY $x11
    %2:gprb(s64) = G_CONSTANT i64 3
    %3:gprb(s64) = G_SHL %0, %2(s64)
    %4:gprb(s64) = G_SUB %1, %3
    %5:gprb(s64) = G_SEXT_INREG %4, 32
    $x10 = COPY %5(s64)
    PseudoRET implicit $x10

...
