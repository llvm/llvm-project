# RUN: llc -mtriple=riscv32-unknown-elf -stats -run-pass=machine-outliner -verify-machineinstrs %s -o /dev/null 2>&1 | FileCheck %s
# REQUIRES: asserts

# Debug instructions must not reset the mapper's separator state. The two
# blocks therefore contribute one sentinel each and no extra separator.
# CHECK: 2 machine-outliner - Unoutlinable instructions mapped + number of sentinel values

--- |
  define void @separator_source() { unreachable }
  define void @separator_with_debug() !dbg !5 { unreachable }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "separator_with_debug", linkageName: "separator_with_debug", scope: null, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !8)
  !6 = !DISubroutineType(types: !7)
  !7 = !{}
  !8 = !{!9}
  !9 = !DILocalVariable(name: "ghost", scope: !5, file: !1, line: 1, type: !10)
  !10 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !11 = !DILocation(line: 1, column: 1, scope: !5)
...
---
name:            separator_source
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11
    $x10 = ADDI $x10, 1
    $x11 = ADDI $x11, 2
    PseudoRET implicit $x10
...
---
name:            separator_with_debug
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11
    DBG_VALUE $x10, $noreg, !9, !DIExpression(), debug-location !11
    INLINEASM &"", sideeffect attdialect
    $x10 = ADDI $x10, 1
    $x11 = ADDI $x11, 2
    PseudoRET implicit $x10
...
