; Register allocation reuses a1 for the load after the first XOR reads it.
; Breaking this WAR dependency lets the load move before the XOR, testing both
; register renaming and scheduling with the rebuilt DAG.
define i64 @load_war(i64 %a, i64 %b, ptr %p) {
; ALL-LABEL: load_war:
; ALL:       # %bb.0:
; ALL-NEXT:    ld a5, 0(a2)
; ALL-NEXT:    xor a0, a0, a1
; ALL-NEXT:    xori a1, a5, 3
; ALL-NEXT:    add a0, a0, a1
; ALL-NEXT:    ret
;
; NONE-LABEL: load_war:
; NONE:       # %bb.0:
; NONE-NEXT:    xor a0, a0, a1
; NONE-NEXT:    ld a1, 0(a2)
; NONE-NEXT:    xori a1, a1, 3
; NONE-NEXT:    add a0, a0, a1
; NONE-NEXT:    ret
  %x = xor i64 %a, %b
  %v = load i64, ptr %p
  %y = xor i64 %v, 3
  %result = add i64 %x, %y
  ret i64 %result
}
