# RUN: llc -mtriple=riscv64 -passes=greedy -stress-regalloc=3 \
# RUN:   -verify-machineinstrs -verify-regalloc -o - %s | FileCheck %s

# Four live values with only three allocatable registers make Greedy insert
# an adjacent spill/reload before the update. Both temporaries are assigned
# to the same register, so the reload can become a COPY. The later reload
# of the updated value must remain. The input contains no stack accesses.
--- |
  define void @adjacent_restore() { ret void }
...
---
name: adjacent_restore
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x20, $x21

    ; CHECK-LABEL: name: adjacent_restore
    ; CHECK: SD {{%[0-9]+}}, {{%stack\.[0-9]+}}, 0
    ; CHECK-NEXT: [[INITIAL:%[0-9]+]]:gpr = ADD $x20, $x21
    ; CHECK-NEXT: SD [[INITIAL]], [[SLOT:%stack\.[0-9]+]], 0
    ; CHECK-NEXT: [[UPDATED:%[0-9]+]]:gpr = COPY [[INITIAL]]
    ; CHECK-NEXT: [[UPDATED]]:gpr = ADDI [[UPDATED]], 1
    ; CHECK-NEXT: SD [[UPDATED]], [[SLOT]], 0
    ; CHECK: [[RELOADED:%[0-9]+]]:gpr = LD [[SLOT]], 0
    ; CHECK-NEXT: [[RESULT:%[0-9]+]]:gpr = ADD [[RESULT]], [[RELOADED]]
    ; CHECK-NEXT: $x10 = COPY [[RESULT]]
    %0:gpr = ADD $x20, $x21
    %1:gpr = ADD $x20, $x21
    %2:gpr = ADD $x20, $x21
    %1:gpr = ADDI %1, 1
    %2:gpr = ADDI %2, 1
    %2:gpr = ADDI %2, 1
    %1:gpr = ADDI %1, 1
    %3:gpr = ADD $x20, $x21
    %3:gpr = ADDI %3, 1
    %0:gpr = ADD %0, %1
    %0:gpr = ADD %0, %2
    %0:gpr = ADD %0, %3
    $x10 = COPY %0
    PseudoRET implicit $x10
...
