; The prologue is a call to a __riscv_save_N libcall, which needs t0 (x5) for
; its return address and clobbers t1 (x6) and t2 (x7) internally. Check that
; shrink-wrapping does not move the prologue into a block where one of those
; registers is live. The inline asm only pins the value to a fixed register so
; the test stays small.

define void @live_t0(i1 %c) nounwind {
; CHECK-LABEL: live_t0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    call t0, __riscv_save_5
; CHECK-NEXT:    #APP
; CHECK-NEXT:    li t0, 42
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    andi a0, a0, 1
; CHECK-NEXT:    beqz a0, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %slow
; CHECK-NEXT:    #APP
; CHECK-NEXT:    # clobber s0-s4
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    #APP
; CHECK-NEXT:    # use t0
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:  .LBB0_2: # %fast
; CHECK-NEXT:    tail __riscv_restore_5
  %x = call i64 asm sideeffect "li $0, 42", "={x5}"()
  br i1 %c, label %slow, label %fast

slow:
  call void asm sideeffect "# clobber s0-s4", "~{x8},~{x9},~{x18},~{x19},~{x20}"()
  call void asm sideeffect "# use $0", "{x5}"(i64 %x)
  br label %fast

fast:
  ret void
}

