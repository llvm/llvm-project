; A cmpxchg with a seq_cst failure ordering needs a leading fence for the
; broadest atomics ABI compatibility, but only when Zacas is enabled.

define i32 @cmpxchg_seq_cst_failure(ptr %ptr, i32 %cmp, i32 %new) {
; ZACAS-LABEL: define i32 @cmpxchg_seq_cst_failure(
; ZACAS-SAME: ptr [[PTR:%.*]], i32 [[CMP:%.*]], i32 [[NEW:%.*]]) #[[ATTR0:[0-9]+]] {
; ZACAS-NEXT:    fence seq_cst
; ZACAS-NEXT:    [[RES:%.*]] = cmpxchg ptr [[PTR]], i32 [[CMP]], i32 [[NEW]] seq_cst seq_cst, align 4
; ZACAS-NEXT:    [[VAL:%.*]] = extractvalue { i32, i1 } [[RES]], 0
; ZACAS-NEXT:    ret i32 [[VAL]]
;
; NOZACAS-LABEL: define i32 @cmpxchg_seq_cst_failure(
; NOZACAS-SAME: ptr [[PTR:%.*]], i32 [[CMP:%.*]], i32 [[NEW:%.*]]) #[[ATTR0:[0-9]+]] {
; NOZACAS-NEXT:    [[RES:%.*]] = cmpxchg ptr [[PTR]], i32 [[CMP]], i32 [[NEW]] seq_cst seq_cst, align 4
; NOZACAS-NEXT:    [[VAL:%.*]] = extractvalue { i32, i1 } [[RES]], 0
; NOZACAS-NEXT:    ret i32 [[VAL]]
;
  %res = cmpxchg ptr %ptr, i32 %cmp, i32 %new seq_cst seq_cst
  %val = extractvalue { i32, i1 } %res, 0
  ret i32 %val
}

; A cmpxchg with a weaker failure ordering never needs a leading fence.

define i32 @cmpxchg_monotonic_failure(ptr %ptr, i32 %cmp, i32 %new) {
; CHECK-LABEL: define i32 @cmpxchg_monotonic_failure(
; CHECK-SAME: ptr [[PTR:%.*]], i32 [[CMP:%.*]], i32 [[NEW:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[RES:%.*]] = cmpxchg ptr [[PTR]], i32 [[CMP]], i32 [[NEW]] seq_cst monotonic, align 4
; CHECK-NEXT:    [[VAL:%.*]] = extractvalue { i32, i1 } [[RES]], 0
; CHECK-NEXT:    ret i32 [[VAL]]
;
  %res = cmpxchg ptr %ptr, i32 %cmp, i32 %new seq_cst monotonic
  %val = extractvalue { i32, i1 } %res, 0
  ret i32 %val
}
