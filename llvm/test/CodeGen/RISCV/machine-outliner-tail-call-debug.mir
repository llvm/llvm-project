# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "PseudoTAIL|PseudoCALLReg|PseudoRET" --version 6
# The two runs intentionally use the same check prefix: a DBG_VALUE that reads
# the register used to expand PseudoTAIL (x6) must not stop the outliner from
# tail-calling the outlined function.
# RUN: llc -mtriple=riscv32 -run-pass=machine-outliner %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv32 -run-pass=mir-strip-debug,machine-outliner \
# RUN:   -mir-strip-debugify-only=0 %s -o - | FileCheck %s

--- |
  define void @f0() minsize { ret void }
  define void @f1() minsize { ret void }
...
---
name:            f0
body:             |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: f0
    ; CHECK: PseudoTAIL target-flags(riscv-call) @OUTLINED_FUNCTION_0, implicit-def $x6, implicit-def $x7, implicit $x2, implicit-def $x6, implicit-def $x7, implicit-def $x10, implicit-def $x11, implicit-def $x12, implicit-def $x13, implicit $x10, implicit $x2
    DBG_VALUE $x6, $noreg
    $x11 = SLLI $x10, 10
    $x10 = SRAI $x11, 21
    $x11 = SRAI $x11, 31
    $x12 = ADDI $x10, 10
    $x13 = XOR $x12, $x11
    $x10 = ADD $x13, $x10
    PseudoRET implicit $x10
...
---
name:            f1
body:             |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: f1
    ; CHECK: PseudoTAIL target-flags(riscv-call) @OUTLINED_FUNCTION_0, implicit-def $x6, implicit-def $x7, implicit $x2, implicit-def $x6, implicit-def $x7, implicit-def $x10, implicit-def $x11, implicit-def $x12, implicit-def $x13, implicit $x10, implicit $x2
    $x11 = SLLI $x10, 10
    $x10 = SRAI $x11, 21
    $x11 = SRAI $x11, 31
    $x12 = ADDI $x10, 10
    $x13 = XOR $x12, $x11
    $x10 = ADD $x13, $x10
    PseudoRET implicit $x10
...
