; Exercise the truncate form when the bit is consumed by a branch.
define i32 @extract_trunc_i8(i8 %x, i8 %amt, ptr %p) {
; RV32-LABEL: extract_trunc_i8:
; RV32:       # %bb.0:
; RV32-NEXT:    zext.b a0, a0
; RV32-NEXT:    bext a0, a0, a1
; RV32-NEXT:    beqz a0, .LBB4_2
; RV32-NEXT:  # %bb.1: # %taken
; RV32-NEXT:    li a0, 7
; RV32-NEXT:    sw a0, 0(a2)
; RV32-NEXT:  .LBB4_2: # %exit
; RV32-NEXT:    li a0, 0
; RV32-NEXT:    ret
;
; RV64-LABEL: extract_trunc_i8:
; RV64:       # %bb.0:
; RV64-NEXT:    bext a0, a0, a1
; RV64-NEXT:    beqz a0, .LBB4_2
; RV64-NEXT:  # %bb.1: # %taken
; RV64-NEXT:    li a0, 7
; RV64-NEXT:    sw a0, 0(a2)
; RV64-NEXT:  .LBB4_2: # %exit
; RV64-NEXT:    li a0, 0
; RV64-NEXT:    ret
;
; NOZBS-LABEL: extract_trunc_i8:
; NOZBS:       # %bb.0:
; NOZBS-NEXT:    zext.b a0, a0
; NOZBS-NEXT:    srl a0, a0, a1
; NOZBS-NEXT:    andi a0, a0, 1
; NOZBS-NEXT:    beqz a0, .LBB4_2
; NOZBS-NEXT:  # %bb.1: # %taken
; NOZBS-NEXT:    li a0, 7
; NOZBS-NEXT:    sw a0, 0(a2)
; NOZBS-NEXT:  .LBB4_2: # %exit
; NOZBS-NEXT:    li a0, 0
; NOZBS-NEXT:    ret
  %s = lshr i8 %x, %amt
  %b = trunc i8 %s to i1
  br i1 %b, label %taken, label %exit
taken:
  store volatile i32 7, ptr %p
  br label %exit
exit:
  ret i32 0
}

