;; Arguments and return values of a preserve_none function are assigned to
;; x9, x18-x27, x10-x17, x28-x31 and x5, in this order: the 24 GPRs that are
;; neither hardwired, reserved for the ABI, nor used as a scratch register by
;; the backend at a point where the arguments of the convention are still live
;; (x6, and x7 with Zicfilp, are used by the tail call expansion, the inline
;; stack probe and the KCFI check).  No register is preserved by a
;; preserve_none callee, so there is no callee-save or register-restore code in
;; the function itself, and all live registers have to be saved by the caller.

; The incoming argument registers are already the outgoing return
; registers: the function compiles to a bare ret.
define preserve_nonecc {i64, i64, i64, i64} @forward_4(i64 %a0, i64 %a1, i64 %a2, i64 %a3) {
; CHECK-LABEL: forward_4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ret
  %v0 = insertvalue {i64, i64, i64, i64} poison, i64 %a0, 0
  %v1 = insertvalue {i64, i64, i64, i64} %v0, i64 %a1, 1
  %v2 = insertvalue {i64, i64, i64, i64} %v1, i64 %a2, 2
  %v3 = insertvalue {i64, i64, i64, i64} %v2, i64 %a3, 3
  ret {i64, i64, i64, i64} %v3
}

; The 25th argument does not fit in the register pool and is passed on
; the stack instead.
define preserve_nonecc i64 @arg_25(i64 %a0, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8, i64 %a9, i64 %a10, i64 %a11, i64 %a12, i64 %a13, i64 %a14, i64 %a15, i64 %a16, i64 %a17, i64 %a18, i64 %a19, i64 %a20, i64 %a21, i64 %a22, i64 %a23, i64 %a24) {
; CHECK-LABEL: arg_25:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ld s1, 0(sp)
; CHECK-NEXT:    ret
  ret i64 %a24
}

