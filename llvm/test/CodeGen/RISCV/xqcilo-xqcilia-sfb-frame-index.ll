; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv32 -verify-machineinstrs \
; RUN:   -mattr=+xqcilo,+xqcilia,+short-forward-branch-iload -riscv-no-aliases < %s \
; RUN:   | FileCheck %s

; Stack loads folded into a select as predicated loads.
;  - *_near:  final offset fits in 12 bits.
;  - *_far:   ISel offset fits in 12 bits, final offset does not (PseudoCCL*).
;  - *_large: ISel offset does not fit in 12 bits (PseudoCCQC_E_L*).

declare void @use(ptr, ptr)

define i32 @sfb_lw_near(i32 %a, i1 zeroext %c) nounwind optsize {
; CHECK-LABEL: sfb_lw_near:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    c.addi16sp sp, -256
; CHECK-NEXT:    c.swsp ra, 252(sp) # 4-byte Folded Spill
; CHECK-NEXT:    c.swsp s0, 248(sp) # 4-byte Folded Spill
; CHECK-NEXT:    c.swsp s1, 244(sp) # 4-byte Folded Spill
; CHECK-NEXT:    qc.e.addi sp, sp, -16160
; CHECK-NEXT:    c.mv s0, a1
; CHECK-NEXT:    c.mv s1, a0
; CHECK-NEXT:    c.addi4spn a0, sp, 20
; CHECK-NEXT:    c.addi4spn a1, sp, 4
; CHECK-NEXT:    call use
; CHECK-NEXT:    c.beqz s0, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %entry
; CHECK-NEXT:    c.lwsp s1, 8(sp)
; CHECK-NEXT:  .LBB0_2: # %entry
; CHECK-NEXT:    c.mv a0, s1
; CHECK-NEXT:    qc.e.addi sp, sp, 16160
; CHECK-NEXT:    c.lwsp ra, 252(sp) # 4-byte Folded Reload
; CHECK-NEXT:    c.lwsp s0, 248(sp) # 4-byte Folded Reload
; CHECK-NEXT:    c.lwsp s1, 244(sp) # 4-byte Folded Reload
; CHECK-NEXT:    c.addi16sp sp, 256
; CHECK-NEXT:    c.jr ra
entry:
  %big = alloca [4096 x i32], align 4
  %small = alloca [4 x i32], align 4
  call void @use(ptr %big, ptr %small)
  %p = getelementptr inbounds i8, ptr %small, i32 4
  %v = load i32, ptr %p, align 4
  %r = select i1 %c, i32 %v, i32 %a
  ret i32 %r
}

