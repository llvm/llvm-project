; DEFAULT-NEXT:    snez a0, a0
; DEFAULT-NEXT:    addi a0, a0, -1
; DEFAULT-NEXT:    or a0, a0, a2
; DEFAULT-NEXT:    ret
;
; LATE-LABEL: select_all_ones:
