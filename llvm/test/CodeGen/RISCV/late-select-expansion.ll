; Both values are ALU ops: one is computed, the other is folded under the
; short forward branch (PseudoCCADD), where the generic lowering needs two
; blocks.
define i32 @select_two_alu_ops(i32 %a, i32 %b, i32 %x, i32 %y, i32 %z, i32 %w) {
;
; DEFAULT-LABEL: select_two_alu_ops:
; DEFAULT:       # %bb.0:
; DEFAULT-NEXT:    blt a0, a1, .LBB4_2
; DEFAULT-NEXT:  # %bb.1:
; DEFAULT-NEXT:    sub a0, a3, a5
; DEFAULT-NEXT:    ret
; DEFAULT-NEXT:  .LBB4_2:
; DEFAULT-NEXT:    add a0, a2, a4
; DEFAULT-NEXT:    ret
;
; LATE-LABEL: select_two_alu_ops:
; LATE:       # %bb.0:
; LATE-NEXT:    sub a3, a3, a5
; LATE-NEXT:    bge a0, a1, .LBB4_2
; LATE-NEXT:  # %bb.1:
; LATE-NEXT:    add a3, a2, a4
; LATE-NEXT:  .LBB4_2:
; LATE-NEXT:    mv a0, a3
; LATE-NEXT:    ret
;
; SFB-LABEL: select_two_alu_ops:
; SFB:       # %bb.0:
; SFB-NEXT:    sub a3, a3, a5
; SFB-NEXT:    bge a0, a1, .LBB4_2
; SFB-NEXT:  # %bb.1:
; SFB-NEXT:    add a3, a2, a4
; SFB-NEXT:  .LBB4_2:
; SFB-NEXT:    mv a0, a3
; SFB-NEXT:    ret
;
; RV64-LATE-LABEL: select_two_alu_ops:
; RV64-LATE:       # %bb.0:
; RV64-LATE-NEXT:    sext.w a1, a1
; RV64-LATE-NEXT:    sext.w a6, a0
; RV64-LATE-NEXT:    subw a0, a3, a5
; RV64-LATE-NEXT:    bge a6, a1, .LBB4_2
; RV64-LATE-NEXT:  # %bb.1:
; RV64-LATE-NEXT:    addw a0, a2, a4
; RV64-LATE-NEXT:  .LBB4_2:
; RV64-LATE-NEXT:    ret
  %c = icmp slt i32 %a, %b
  %s = add i32 %x, %z
  %u = sub i32 %y, %w
  %r = select i1 %c, i32 %s, i32 %u
