# CHECK: ld_add
# CHECK: Macro fuse: {{.*}}ADD - LD
---
name: ld_add
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    %1:gpr = COPY $x10
    %2:gpr = COPY $x11
    %3:gpr = ADD %1, %2
    %4:gpr = XORI %2, 3
    %5:gpr = LD %3, 0
    $x10 = COPY %4
    $x11 = COPY %5
    PseudoRET
...

