# CHECK: Macro fuse: {{.*}}SH1ADD - LH
---
name: sh1add_lh
body:             |
  bb.0.entry:
    liveins: $x10, $x11
    %1:gpr = COPY $x10
    %2:gpr = COPY $x11
    %3:gpr = SH1ADD %1, %2
    %4:gpr = XORI %2, 3
    %5:gpr = LH %3, 8
    $x10 = COPY %4
    $x11 = COPY %5
    PseudoRET
...

