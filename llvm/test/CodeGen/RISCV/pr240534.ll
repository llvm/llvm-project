; RUN: llc < %s -mtriple=riscv32 -mattr=+experimental-p,+zve64x,+zilsd | FileCheck %s

; This exposed an interaction between P and RVV through
; combineVectorSizedSetCCEquality. combineVectorSizedSetCCEquality created
; a setcc with v8i1 result type fo RVV, but LowerBUILD_VECTOR saw P was enabled
; and didn't think v8i1 was a valid build_vector.

define i1 @cas_reduced() {
; CHECK-LABEL: cas_reduced:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    ld a0, 0(zero)
; CHECK-NEXT:    or a0, a0, a1
; CHECK-NEXT:    seqz a0, a0
; CHECK-NEXT:    ret
entry:
  %0 = load i64, ptr null, align 8
  %cmp = icmp eq i64 %0, 0
  ret i1 %cmp
}

