; The RVV SLEEF functions return their two results in a packed vector. Until
; that ABI is supported, the scalable intrinsics lower to scalar loops.
; Returning the struct directly also prevents replace-with-veclib from
; splitting sincos into two vector calls.

define { <vscale x 2 x double>, <vscale x 2 x double> } @sincos_nxv2f64(<vscale x 2 x double> %x) {
; CHECK-LABEL: sincos_nxv2f64:
; CHECK:    call sincos
;
; O0-LABEL: sincos_nxv2f64:
; O0:    call sincos
  %result = call { <vscale x 2 x double>, <vscale x 2 x double> } @llvm.sincos.nxv2f64(<vscale x 2 x double> %x)
  ret { <vscale x 2 x double>, <vscale x 2 x double> } %result
}

define { <vscale x 4 x float>, <vscale x 4 x float> } @sincos_nxv4f32(<vscale x 4 x float> %x) {
; CHECK-LABEL: sincos_nxv4f32:
; CHECK:    call sincosf
;
; O0-LABEL: sincos_nxv4f32:
; O0:    call sincosf
