# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv32 -x mir -run-pass=machine-outliner -simplify-mir -verify-machineinstrs \
# RUN:   -riscv-outliner-regsave=true < %s | FileCheck -check-prefixes=CHECK-NONE-RESERVED %s
# RUN: llc -mtriple=riscv32 -mattr=+reserve-x28 -x mir -run-pass=machine-outliner -simplify-mir -verify-machineinstrs \
# RUN:   -riscv-outliner-regsave=true < %s | FileCheck -check-prefixes=CHECK-X28-RESERVED %s

# x6 and x7 are live throughout the sequence so they can't be used to save x5.
# Reserving x28 should make the outliner pick the next register, x29.

--- |
  define i32 @outline_x5_live_reserved_0(i32 %a, i32 %b) { ret i32 0 }
  define i32 @outline_x5_live_reserved_1(i32 %a, i32 %b) { ret i32 0 }
  define i32 @outline_x5_live_reserved_2(i32 %a, i32 %b) { ret i32 0 }
...
---
name:            outline_x5_live_reserved_0
tracksRegLiveness: true
body:             |
  ; CHECK-NONE-RESERVED-LABEL: name: outline_x5_live_reserved_0
  ; CHECK-NONE-RESERVED: bb.0:
  ; CHECK-NONE-RESERVED-NEXT:   liveins: $x10, $x11, $x5, $x6, $x7
  ; CHECK-NONE-RESERVED-NEXT: {{  $}}
  ; CHECK-NONE-RESERVED-NEXT:   $x28 = ADDI $x5, 0
  ; CHECK-NONE-RESERVED-NEXT:   $x5 = PseudoCALLReg target-flags(riscv-call) @OUTLINED_FUNCTION_0, implicit-def $x5, implicit-def $x11, implicit-def $x12, implicit-def $x14, implicit $x10, implicit $x11, implicit $x28
  ; CHECK-NONE-RESERVED-NEXT:   $x5 = ADDI $x28, 0
  ; CHECK-NONE-RESERVED-NEXT:   PseudoBR %bb.1
  ; CHECK-NONE-RESERVED-NEXT: {{  $}}
  ; CHECK-NONE-RESERVED-NEXT: bb.1:
  ; CHECK-NONE-RESERVED-NEXT:   liveins: $x5, $x6, $x7, $x14
  ; CHECK-NONE-RESERVED-NEXT: {{  $}}
  ; CHECK-NONE-RESERVED-NEXT:   $x10 = ADD $x14, $x5
  ; CHECK-NONE-RESERVED-NEXT:   $x10 = ADD $x10, $x6
  ; CHECK-NONE-RESERVED-NEXT:   $x10 = ADD $x10, $x7
  ; CHECK-NONE-RESERVED-NEXT:   PseudoRET implicit $x10
  ;
  ; CHECK-X28-RESERVED-LABEL: name: outline_x5_live_reserved_0
  ; CHECK-X28-RESERVED: bb.0:
  ; CHECK-X28-RESERVED-NEXT:   liveins: $x10, $x11, $x5, $x6, $x7
  ; CHECK-X28-RESERVED-NEXT: {{  $}}
  ; CHECK-X28-RESERVED-NEXT:   $x29 = ADDI $x5, 0
  ; CHECK-X28-RESERVED-NEXT:   $x5 = PseudoCALLReg target-flags(riscv-call) @OUTLINED_FUNCTION_0, implicit-def $x5, implicit-def $x11, implicit-def $x12, implicit-def $x14, implicit $x10, implicit $x11, implicit $x29
  ; CHECK-X28-RESERVED-NEXT:   $x5 = ADDI $x29, 0
  ; CHECK-X28-RESERVED-NEXT:   PseudoBR %bb.1
  ; CHECK-X28-RESERVED-NEXT: {{  $}}
  ; CHECK-X28-RESERVED-NEXT: bb.1:
  ; CHECK-X28-RESERVED-NEXT:   liveins: $x5, $x6, $x7, $x14
  ; CHECK-X28-RESERVED-NEXT: {{  $}}
  ; CHECK-X28-RESERVED-NEXT:   $x10 = ADD $x14, $x5
  ; CHECK-X28-RESERVED-NEXT:   $x10 = ADD $x10, $x6
  ; CHECK-X28-RESERVED-NEXT:   $x10 = ADD $x10, $x7
  ; CHECK-X28-RESERVED-NEXT:   PseudoRET implicit $x10
  bb.0:
    liveins: $x10, $x11, $x5, $x6, $x7
    $x11 = ANDI $x11, 1023
    $x12 = ADDI $x10, 17
    $x11 = AND $x12, $x11
    $x14 = SUB $x10, $x11
    $x11 = ANDI $x11, 1023
    $x12 = ADDI $x10, 17
    $x11 = AND $x12, $x11
    $x14 = SUB $x10, $x11
    PseudoBR %bb.1

  bb.1:
    liveins: $x5, $x6, $x7, $x14
    $x10 = ADD $x14, $x5
    $x10 = ADD $x10, $x6
    $x10 = ADD $x10, $x7
    PseudoRET implicit $x10
...
