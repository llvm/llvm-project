; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv64-unknown-linux-gnu -mattr=+v -vector-library=sleefgnuabi -verify-machineinstrs < %s | FileCheck %s --implicit-check-not=_ZGV

; SLEEF uses unmasked RVV functions for scalable frem, rather than the masked
; AArch64 SVE functions with the same vector types.

define <vscale x 2 x double> @frem_nxv2f64(<vscale x 2 x double> %x, <vscale x 2 x double> %y) {
; CHECK-LABEL: frem_nxv2f64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    call Sleef_fmoddx_rvvm2
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
  %r = frem <vscale x 2 x double> %x, %y
  ret <vscale x 2 x double> %r
}

define <vscale x 4 x float> @frem_nxv4f32(<vscale x 4 x float> %x, <vscale x 4 x float> %y) {
; CHECK-LABEL: frem_nxv4f32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd ra, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    call Sleef_fmodfx_rvvm2
; CHECK-NEXT:    ld ra, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
  %r = frem <vscale x 4 x float> %x, %y
  ret <vscale x 4 x float> %r
}
