# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -mattr=+m -run-pass=early-machinelicm -verify-machineinstrs %s -o - | FileCheck %s

# Virtual registers defined and used more than once only within the preheader
# are not live out of it, even without kill flags. They must not inflate the
# initial register pressure, otherwise the conditionally executed MUL below is
# not speculatively hoisted.

---
name:            preheader_local_multi_use
tracksRegLiveness: true
body:             |
