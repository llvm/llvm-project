  ; CHECK-NEXT:   SD [[ADDI31]], [[COPY2]], 504
  ; CHECK-NEXT:   [[MUL:%[0-9]+]]:gpr = MUL [[COPY]], [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY]], %bb.0, %36, %bb.3
  ; CHECK-NEXT:   BEQ [[PHI]], [[COPY1]], %bb.3
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
