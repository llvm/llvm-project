  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADDI32:%[0-9]+]]:gpr = ADDI [[PHI]], 1
  ; CHECK-NEXT:   BNE [[ADDI32]], [[COPY1]], %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1
    liveins: $x10, $x11, $x12

    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
