# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -mattr=+use-postra-scheduler -run-pass=postmisched %s -o - | FileCheck %s

# Sanitizers need a valid frame register at any point where a crash can
# happen, so frame register modifications in the prologue/epilogue of
# sanitized functions are scheduling boundaries.

--- |
  define void @nosanitize(ptr %p, i32 %v) "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }

  define void @sanitize_address(ptr %p, i32 %v) sanitize_address "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }

  define void @sanitize_hwaddress(ptr %p, i32 %v) sanitize_hwaddress "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }

  define void @sanitize_memory(ptr %p, i32 %v) sanitize_memory "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }

  define void @sanitize_memtag(ptr %p, i32 %v) sanitize_memtag "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }

  define void @sanitize_thread(ptr %p, i32 %v) sanitize_thread "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }

  define void @sanitize_type(ptr %p, i32 %v) sanitize_type "frame-pointer"="all" {
    store i32 %v, ptr %p, align 4
    ret void
  }
...
---
name:            nosanitize
tracksRegLiveness: true
frameInfo:
  stackSize:       16
  maxAlignment:    8
  framePointerPolicy: all
  isCalleeSavedInfoValid: true
stack:
  - { id: 0, type: spill-slot, offset: -8, size: 8, alignment: 8, callee-saved-register: '$x1' }
  - { id: 1, type: spill-slot, offset: -16, size: 8, alignment: 8, callee-saved-register: '$x8' }
body:             |
  bb.0 (%ir-block.0):
    liveins: $x10, $x11, $x1, $x8

    ; CHECK-LABEL: name: nosanitize
    ; CHECK: liveins: $x10, $x11, $x1, $x8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x2 = frame-setup ADDI $x2, -16
    ; CHECK-NEXT: frame-setup SD killed $x1, $x2, 8 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: frame-setup SD $x8, $x2, 0 :: (store (s64) into %stack.1)
    ; CHECK-NEXT: $x8 = frame-setup ADDI $x2, 16
    ; CHECK-NEXT: $x1 = frame-destroy LD $x2, 8 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: $x8 = frame-destroy LD $x2, 0 :: (load (s64) from %stack.1)
    ; CHECK-NEXT: SW killed renamable $x11, killed renamable $x10, 0 :: (store (s32) into %ir.p)
    ; CHECK-NEXT: $x2 = frame-destroy ADDI $x2, 16
    ; CHECK-NEXT: PseudoRET
    $x2 = frame-setup ADDI $x2, -16
    frame-setup SD killed $x1, $x2, 8 :: (store (s64) into %stack.0)
    frame-setup SD killed $x8, $x2, 0 :: (store (s64) into %stack.1)
    $x8 = frame-setup ADDI $x2, 16
    SW killed renamable $x11, killed renamable $x10, 0 :: (store (s32) into %ir.p)
    $x1 = frame-destroy LD $x2, 8 :: (load (s64) from %stack.0)
    $x8 = frame-destroy LD $x2, 0 :: (load (s64) from %stack.1)
    $x2 = frame-destroy ADDI $x2, 16
    PseudoRET
...
