; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv64 -mattr=+xandesperf,+late-select-expansion -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; late-select-expansion folds nds.bfoz and nds.bfos under the branch, like the
; base ALU ops.

define i64 @select_bfoz(i64 %a, i64 %b, i64 %x, i64 %y) {
; CHECK-LABEL: select_bfoz:
; CHECK:       # %bb.0:
; CHECK-NEXT:    blt a2, a3, .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    nds.bfoz a1, a0, 25, 23
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    ret
  %c = icmp slt i64 %x, %y
  %shr = lshr i64 %a, 23
  %and = and i64 %shr, 7
  %r = select i1 %c, i64 %b, i64 %and
  ret i64 %r
}

define i64 @select_bfos(i64 %a, i64 %b, i64 %x, i64 %y) {
; CHECK-LABEL: select_bfos:
; CHECK:       # %bb.0:
; CHECK-NEXT:    blt a2, a3, .LBB1_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    nds.bfos a1, a0, 14, 46
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    ret
  %c = icmp slt i64 %x, %y
  %shl = shl i64 %a, 31
  %shr = ashr i64 %shl, 17
  %r = select i1 %c, i64 %b, i64 %shr
  ret i64 %r
}
