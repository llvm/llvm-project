# RUN: not llc -mtriple=riscv64 -mattr=+v -x mir -run-pass=prolog-epilog < %s -o /dev/null 2>&1 | FileCheck %s
# RUN: not llc -mtriple=riscv32 -mattr=+v -x mir -run-pass=prolog-epilog < %s -o /dev/null 2>&1 | FileCheck %s

# Every temporary is live at the prologue. A fixed-size allocation is then
# probed without a loop (see no_free_regs in stack-probing-frame-setup.mir),
# but a scalable one cannot be.

# CHECK: error: {{.*}}no free register for stack probing

--- |
  define void @no_free_regs_rvv() #0 {
  entry:
    %buf = alloca <vscale x 16 x i8>, align 16
    ret void
  }

  attributes #0 = { "probe-stack"="inline-asm" "target-features"="+v" }
...
---
name:            no_free_regs_rvv
tracksRegLiveness: true
liveins:
  - { reg: '$x5', virtual-reg: '' }
  - { reg: '$x6', virtual-reg: '' }
  - { reg: '$x7', virtual-reg: '' }
  - { reg: '$x28', virtual-reg: '' }
  - { reg: '$x29', virtual-reg: '' }
  - { reg: '$x30', virtual-reg: '' }
  - { reg: '$x31', virtual-reg: '' }
frameInfo:
  maxAlignment:    16
stack:
  - { id: 0, name: buf, type: default, offset: 0, size: 16, alignment: 16, stack-id: scalable-vector }
body:             |
  bb.0.entry:
    liveins: $x5, $x6, $x7, $x28, $x29, $x30, $x31

    $x10 = ADDI %stack.0.buf, 0
    PseudoRET implicit $x5, implicit $x6, implicit $x7, implicit $x28, implicit $x29, implicit $x30, implicit $x31, implicit killed $x10
...
