# Negative tests

# Renaming a loop with only one definition would only move the same backedge
# WAR to another register, so a second complete definition is required.
---
name:            single_def_loop_carried_war
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: single_def_loop_carried_war
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x15 = LD renamable $x10, 0 :: (load (s64))
  ; CHECK-NEXT:   SD killed renamable $x15, renamable $x11, 0 :: (store (s64))
  ; CHECK-NEXT:   BNE renamable $x12, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1(0x80000000)

    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x10, $x11, $x12

    renamable $x15 = LD renamable $x10, 0 :: (load (s64))
    SD renamable $x15, renamable $x11, 0 :: (store (s64))
    BNE renamable $x12, $x0, %bb.1

  bb.2:
    PseudoRET
...

# A use before the first definition means that the old value is live across the
# backedge, so the def-use segment cannot be split safely.
---
name:            live_in_use_loop_carried_war
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: live_in_use_loop_carried_war
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13, $x15
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SD killed renamable $x15, renamable $x12, 0 :: (store (s64))
  ; CHECK-NEXT:   renamable $x15 = LD renamable $x10, 0 :: (load (s64))
  ; CHECK-NEXT:   renamable $x15 = ADD killed renamable $x15, renamable $x11
  ; CHECK-NEXT:   SD renamable $x15, renamable $x12, 8 :: (store (s64))
  ; CHECK-NEXT:   BNE renamable $x13, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1(0x80000000)

    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x10, $x11, $x12, $x13, $x15

    SD renamable $x15, renamable $x12, 0 :: (store (s64))
    renamable $x15 = LD renamable $x10, 0 :: (load (s64))
    renamable $x15 = ADD killed renamable $x15, renamable $x11
    SD renamable $x15, renamable $x12, 8 :: (store (s64))
    BNE renamable $x13, $x0, %bb.1

  bb.2:
    PseudoRET
...

