  ; CHECK-NEXT:   PseudoVSE32_V_M8 killed renamable $v8m8, renamable $x11, $noreg /* vl */, 5 /* e32 */, implicit $vl, implicit $vtype :: (store unknown-size, align 4)
  ; CHECK-NEXT:   BNE renamable $x12, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1(0x80000000)

    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x10, $x11, $x12, $v16m8

    dead $x0 = PseudoVSETIVLI 0, 211 /* e32, m8, ta, ma */, implicit-def $vl, implicit-def $vtype
    renamable $v8m8 = PseudoVLE32_V_M8 undef renamable $v8m8, renamable $x10, $noreg /* vl */, 5 /* e32 */, 2 /* tu, ma */, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    renamable $v8m8 = nofpexcept PseudoVFADD_VV_M8_E32 renamable $v8m8, killed renamable $v8m8, renamable $v16m8, 7 /* frm=dyn */, $noreg /* vl */, 5 /* e32 */, 0 /* tu, mu */, implicit $frm, implicit $vl, implicit $vtype
    PseudoVSE32_V_M8 killed renamable $v8m8, renamable $x11, $noreg /* vl */, 5 /* e32 */, implicit $vl, implicit $vtype :: (store unknown-size, align 4)
    BNE renamable $x12, $x0, %bb.1

  bb.2:
    PseudoRET
...

# The only otherwise available VRM8 group has a live-in alias, so there is no
# safe register to use for the first def-use segment.
---
name:            no_free_rvv_register
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: no_free_rvv_register
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $v0m8, $v16m8, $v24
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead $x0 = PseudoVSETIVLI 0, 211 /* e32, m8, ta, ma */, implicit-def $vl, implicit-def $vtype
  ; CHECK-NEXT:   renamable $v8m8 = PseudoVLE32_V_M8 undef renamable $v8m8, renamable $x10, $noreg /* vl */, 5 /* e32 */, 2 /* tu, ma */, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
  ; CHECK-NEXT:   renamable $v8m8 = nofpexcept PseudoVFADD_VV_M8_E32 undef renamable $v8m8, killed renamable $v8m8, renamable $v16m8, 7 /* frm=dyn */, $noreg /* vl */, 5 /* e32 */, 0 /* tu, mu */, implicit $frm, implicit $vl, implicit $vtype
  ; CHECK-NEXT:   PseudoVSE32_V_M8 killed renamable $v8m8, renamable $x11, $noreg /* vl */, 5 /* e32 */, implicit $vl, implicit $vtype :: (store unknown-size, align 4)
  ; CHECK-NEXT:   BNE renamable $x12, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1(0x80000000)

    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x10, $x11, $x12, $v0m8, $v16m8, $v24

    dead $x0 = PseudoVSETIVLI 0, 211 /* e32, m8, ta, ma */, implicit-def $vl, implicit-def $vtype
    renamable $v8m8 = PseudoVLE32_V_M8 undef renamable $v8m8, renamable $x10, $noreg /* vl */, 5 /* e32 */, 2 /* tu, ma */, implicit $vl, implicit $vtype :: (load unknown-size, align 4)
    renamable $v8m8 = nofpexcept PseudoVFADD_VV_M8_E32 undef renamable $v8m8, killed renamable $v8m8, renamable $v16m8, 7 /* frm=dyn */, $noreg /* vl */, 5 /* e32 */, 0 /* tu, mu */, implicit $frm, implicit $vl, implicit $vtype
    PseudoVSE32_V_M8 killed renamable $v8m8, renamable $x11, $noreg /* vl */, 5 /* e32 */, implicit $vl, implicit $vtype :: (store unknown-size, align 4)
    BNE renamable $x12, $x0, %bb.1

  bb.2:
    PseudoRET
...

# Bundles are skipped because renaming a member independently could make the
# bundle header's register operands and liveness stale.
---
name:            bundled_loop_carried_war
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: bundled_loop_carried_war
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x15 = LD renamable $x10, 0 :: (load (s64))
  ; CHECK-NEXT:   BUNDLE implicit-def $x14, implicit $x11 {
  ; CHECK-NEXT:     renamable $x14 = ADD renamable $x11, renamable $x11
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   renamable $x15 = ADD killed renamable $x15, renamable $x11
  ; CHECK-NEXT:   SD killed renamable $x15, renamable $x12, 0 :: (store (s64))
  ; CHECK-NEXT:   BNE renamable $x13, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1(0x80000000)

    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $x10, $x11, $x12, $x13

    renamable $x15 = LD renamable $x10, 0 :: (load (s64))
    BUNDLE implicit-def $x14, implicit $x11 {
      renamable $x14 = ADD renamable $x11, renamable $x11
    }
    renamable $x15 = ADD killed renamable $x15, renamable $x11
    SD renamable $x15, renamable $x12, 0 :: (store (s64))
    BNE renamable $x13, $x0, %bb.1

  bb.2:
    PseudoRET
...
