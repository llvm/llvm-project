  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x15 = LD renamable $x10, 0 :: (load (s64))
  ; CHECK-NEXT:   renamable $x15 = ADD killed renamable $x15, renamable $x11
  ; CHECK-NEXT:   SD killed renamable $x15, renamable $x12, 0 :: (store (s64))
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.3(0x04000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE renamable $x13, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    successors: %bb.1(0x80000000)

    PseudoBR %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $x10, $x11, $x12, $x13

    renamable $x15 = LD renamable $x10, 0 :: (load (s64))
    renamable $x15 = ADD killed renamable $x15, renamable $x11
    SD renamable $x15, renamable $x12, 0 :: (store (s64))
    PseudoBR %bb.2

  bb.2:
    successors: %bb.1(0x7c000000), %bb.3(0x04000000)
    liveins: $x10, $x11, $x12, $x13

