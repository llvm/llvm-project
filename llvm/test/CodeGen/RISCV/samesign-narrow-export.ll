; A zext nneg address use, as produced by CVP for the C example,
; can share the sign-extended export.
define ptr @signed_and_samesign_zext_nneg_i8(ptr %p) {
; CHECK-LABEL: signed_and_samesign_zext_nneg_i8:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lb a1, 0(a0)
; CHECK-NEXT:    li a2, 90
; CHECK-NEXT:    blt a2, a1, .LBB13_2
; CHECK-NEXT:  # %bb.1: # %small
; CHECK-NEXT:    addi a0, a0, 1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB13_2: # %check
; CHECK-NEXT:    zext.b a1, a1
; CHECK-NEXT:    li a2, 96
; CHECK-NEXT:    bltu a1, a2, .LBB13_4
; CHECK-NEXT:  # %bb.3: # %large
; CHECK-NEXT:    add a0, a0, a1
; CHECK-NEXT:    addi a0, a0, -94
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB13_4: # %middle
; CHECK-NEXT:    addi a0, a0, 2
; CHECK-NEXT:    ret
entry:
  %x = load i8, ptr %p, align 1
  %wide = zext nneg i8 %x to iXLen
  %first = icmp slt i8 %x, 91
  br i1 %first, label %small, label %check
small:
  %p1 = getelementptr inbounds i8, ptr %p, iXLen 1
  ret ptr %p1
check:
  %second = icmp samesign ugt i8 %x, 95
  br i1 %second, label %large, label %middle
large:
  %po = getelementptr inbounds i8, ptr %p, iXLen %wide
  %pr = getelementptr inbounds i8, ptr %po, iXLen -94
  ret ptr %pr
middle:
  %p2 = getelementptr inbounds i8, ptr %p, iXLen 2
  ret ptr %p2
}

; A cross-block samesign comparison alone should not force sign extension.
; The narrow store keeps the load live on both paths without an extension use.
define i1 @only_samesign_no_ext(ptr %p, ptr %out, i1 %gate, i8 %rhs) {
; CHECK-LABEL: only_samesign_no_ext:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lbu a4, 0(a0)
; CHECK-NEXT:    andi a2, a2, 1
; CHECK-NEXT:    beqz a2, .LBB14_2
; CHECK-NEXT:  # %bb.1: # %check
; CHECK-NEXT:    zext.b a0, a3
; CHECK-NEXT:    sltu a0, a4, a0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB14_2: # %other
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    sb a4, 0(a1)
; CHECK-NEXT:    ret
entry:
  %x = load i8, ptr %p, align 1
  br i1 %gate, label %check, label %other

other:
  store i8 %x, ptr %out, align 1
  ret i1 false

check:
  %cmp = icmp samesign ult i8 %x, %rhs
  ret i1 %cmp
}

