; A real zero-extension use must still receive the zero-extended value.
define i32 @i8_sext_zext_uses(ptr %p) {
; CHECK-LABEL: i8_sext_zext_uses:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lb a0, 0(a0)
; CHECK-NEXT:    li a2, -16
; CHECK-NEXT:    zext.b a1, a0
; CHECK-NEXT:    blt a0, a2, .LBB11_2
; CHECK-NEXT:  # %bb.1: # %small
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB11_2: # %check
; CHECK-NEXT:    li a2, 161
; CHECK-NEXT:    bltu a1, a2, .LBB11_4
; CHECK-NEXT:  # %bb.3: # %check
; CHECK-NEXT:    li a0, -7
; CHECK-NEXT:  .LBB11_4: # %check
; CHECK-NEXT:    ret
entry:
  %x = load i8, ptr %p
  %wide = sext i8 %x to i32
  %first = icmp sgt i8 %x, -17
  br i1 %first, label %small, label %check
small:
  %z = zext i8 %x to i32
  ret i32 %z
check:
  %cmp = icmp samesign ult i8 %x, -95
  %r = select i1 %cmp, i32 %wide, i32 -7
  ret i32 %r
}

; Preserve the original preference when i1 comparisons lower to Boolean logic.
define i1 @i1_export(ptr %p, i1 %gate, i1 %rhs) {
; CHECK-LABEL: i1_export:
