; CHECK-NEXT:  # %bb.1: # %check
; CHECK-NEXT:    xori a0, a0, 1
; CHECK-NEXT:    and a0, a2, a0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB12_2: # %other
; CHECK-NEXT:    xori a1, a2, 1
; CHECK-NEXT:    and a0, a0, a1
; CHECK-NEXT:    ret
