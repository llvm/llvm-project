# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=riscv64 -x mir -run-pass=prolog-epilog  -verify-machineinstrs < %s \
# RUN:  | FileCheck %s -check-prefixes=RV64I
# RUN: llc -mtriple=riscv32 -x mir -run-pass=prolog-epilog  -verify-machineinstrs < %s \
# RUN:  | FileCheck %s -check-prefixes=RV32I
--- |
  ; Function Attrs: uwtable
  define void @no_reserved_call_frame(i64 %n) #0 {
  entry:
    %v = alloca i32, i64 %n, align 4
    call void @callee_stack_args(ptr %v, [518 x i64] poison)
    ret void
  }

  declare void @callee_stack_args(ptr, [518 x i64]) #1

  ; A call frame large enough for a probe loop, allocated where $x6 and $x7 are
  ; live: the probe loop must use other registers.
  define void @call_frame_live_regs(i64 %c, i64 %n) #0 {
  entry:
    %v = alloca i32, i64 %n, align 4
    call void @callee_large_args(ptr %v, [5127 x i64] poison)
    ret void
  }

  declare void @callee_large_args(ptr, [5127 x i64]) #1

  ; The same with every temporary live: the allocation is probed without a
  ; loop, moving SP by at most 2048 bytes at a time.
  define void @call_frame_no_free_regs(i64 %n) #0 {
  entry:
    %v = alloca i32, i64 %n, align 4
    call void @callee_large_args(ptr %v, [5127 x i64] poison)
    ret void
  }

  ; Every temporary is live at the prologue: its allocation is probed without a
  ; loop, moving SP by at most 2048 bytes at a time.
  define void @no_free_regs() #0 {
  entry:
    %buf = alloca [24000 x i8], align 8
    ret void
  }

  ; $x5 and $x6 are live at the prologue: the probe loop uses $x7 and $x28.
  define void @two_live_temps() #2 {
  entry:
    %buf = alloca [6000 x i8], align 4
    ret void
  }

  ; The same on RVE, where $x16-$x31 are reserved: only $x7 is free, so the
  ; allocation is probed without a loop.
  define void @two_live_temps_rve() #3 {
  entry:
    %buf = alloca [6000 x i8], align 4
    ret void
  }

  attributes #0 = { uwtable "frame-pointer"="none" "probe-stack"="inline-asm" "target-features"="+m" }
  attributes #1 = { "target-features"="+m" }
  attributes #2 = { uwtable "frame-pointer"="none" "probe-stack"="inline-asm" "stack-probe-size"="1024" "target-features"="+m" }
  attributes #3 = { uwtable "frame-pointer"="none" "probe-stack"="inline-asm" "stack-probe-size"="1024" "target-features"="+m,+e" }
...
