; RUN: llc -mtriple=riscv64 -mattr=+zbs -verify-machineinstrs < %s | FileCheck %s

; The index operand only reads log2(XLEN) bits, while the data operand can
; still read any bit selected by the index.
; These unmasked IR shifts are poison for actual shift amounts >= 64.

define i64 @bext_index(i64 %data, i64 %index, i1 %condition) {
; CHECK-LABEL: bext_index:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andi a2, a2, 1
; CHECK-NEXT:    beqz a2, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %extract
; CHECK-NEXT:    bext a0, a0, a1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_2: # %other
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    ret
entry:
  br i1 %condition, label %extract, label %other
extract:
  %narrow = trunc i64 %index to i32
  %signed = sext i32 %narrow to i64
  %shift = lshr i64 %data, %signed
  %bit = and i64 %shift, 1
  ret i64 %bit
other:
  ret i64 0
}

define i64 @bext_data(i64 %data, i64 %index, i1 %condition) {
; CHECK-LABEL: bext_data:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    andi a2, a2, 1
; CHECK-NEXT:    beqz a2, .LBB1_2
; CHECK-NEXT:  # %bb.1: # %extract
; CHECK-NEXT:    sext.w a0, a0
; CHECK-NEXT:    bext a0, a0, a1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_2: # %other
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    ret
entry:
  br i1 %condition, label %extract, label %other
extract:
  %narrow = trunc i64 %data to i32
  %signed = sext i32 %narrow to i64
  %shift = lshr i64 %signed, %index
  %bit = and i64 %shift, 1
  ret i64 %bit
other:
  ret i64 0
}
