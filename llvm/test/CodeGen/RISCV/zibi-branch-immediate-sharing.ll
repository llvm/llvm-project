; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv64 -mattr=+experimental-zibi -O2 -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=riscv64 -mattr=+experimental-zibi -O3 -verify-machineinstrs < %s | FileCheck %s

; End-to-end check for the sharing lost by selecting an immediate branch too
; early. The constant 1 feeds the entry comparison, the conditional store and
; the loop bound. Selecting BNEI before MachineCSE removes the entry
; definition, so the store's constant no longer dominates the preheader and
; the loop rematerializes it. Keep one definition and fold the comparison
; after allocation instead. The body is checked in full, so a second `li` for
; the constant would fail.
;
; void demo(unsigned long n, volatile unsigned long *p) {
;   if (n == 1)
;     *p = n;
;
;   do {
;     *p = n;
;     --n;
;   } while (n > 1);
; }

define void @demo(i64 %n, ptr %p) {
; CHECK-LABEL: demo:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a2, 1
; CHECK-NEXT:    bnei a0, 1, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %if.then
; CHECK-NEXT:    sd a2, 0(a1)
; CHECK-NEXT:  .LBB0_2: # %do.body
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    sd a0, 0(a1)
; CHECK-NEXT:    addi a0, a0, -1
; CHECK-NEXT:    bltu a2, a0, .LBB0_2
; CHECK-NEXT:  # %bb.3: # %do.end
; CHECK-NEXT:    ret
entry:
  %cmp = icmp eq i64 %n, 1
  br i1 %cmp, label %if.then, label %do.body.preheader

if.then:                                          ; preds = %entry
  store volatile i64 1, ptr %p, align 8
  br label %do.body.preheader

do.body.preheader:                                ; preds = %if.then, %entry
  br label %do.body

do.body:                                          ; preds = %do.body.preheader, %do.body
  %n.addr.0 = phi i64 [ %dec, %do.body ], [ %n, %do.body.preheader ]
  store volatile i64 %n.addr.0, ptr %p, align 8
  %dec = add i64 %n.addr.0, -1
  %cmp1 = icmp ugt i64 %dec, 1
  br i1 %cmp1, label %do.body, label %do.end

do.end:                                           ; preds = %do.body
  ret void
}
