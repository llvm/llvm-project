# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -x mir -run-pass=machine-outliner -simplify-mir \
# RUN:   -verify-machineinstrs < %s | FileCheck %s

# Callers of an outlined function rely on it preserving every register it does
# not define. With -machine-outliner-reruns, saving X5 into X6 inside one
# clobbers the X6 its caller saved X5 into.

--- |
  define void @outlined() { ret void }
  define void @f0() { ret void }
  define void @f1() { ret void }
...
---
name:            outlined
tracksRegLiveness: true
isOutlined:      true
body:             |
  bb.0:
    liveins: $x5, $x10, $x11
    ; CHECK-LABEL: name: outlined
    ; CHECK: liveins: $x5, $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x11 = ANDI $x11, 1023
    ; CHECK-NEXT: $x12 = ADDI $x10, 17
    ; CHECK-NEXT: $x11 = AND $x12, $x11
    ; CHECK-NEXT: $x13 = ORI $x11, 255
    ; CHECK-NEXT: $x12 = XOR $x13, $x10
    ; CHECK-NEXT: $x14 = SUB $x12, $x11
    ; CHECK-NEXT: $x0 = JALR $x5, 0
    $x11 = ANDI $x11, 1023
    $x12 = ADDI $x10, 17
    $x11 = AND $x12, $x11
    $x13 = ORI $x11, 255
    $x12 = XOR $x13, $x10
    $x14 = SUB $x12, $x11
    $x0 = JALR $x5, 0
...
---
name:            f0
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: f0
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x5 = PseudoCALLReg target-flags(riscv-call) @OUTLINED_FUNCTION_0, implicit-def $x5, implicit-def $x11, implicit-def $x12, implicit-def $x13, implicit-def $x14, implicit $x10, implicit $x11
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    liveins: $x10, $x11
    $x11 = ANDI $x11, 1023
    $x12 = ADDI $x10, 17
    $x11 = AND $x12, $x11
    $x13 = ORI $x11, 255
    $x12 = XOR $x13, $x10
    $x14 = SUB $x12, $x11
    PseudoBR %bb.1

  bb.1:
    PseudoRET
...
---
name:            f1
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: f1
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x5 = PseudoCALLReg target-flags(riscv-call) @OUTLINED_FUNCTION_0, implicit-def $x5, implicit-def $x11, implicit-def $x12, implicit-def $x13, implicit-def $x14, implicit $x10, implicit $x11
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PseudoRET
  bb.0:
    liveins: $x10, $x11
    $x11 = ANDI $x11, 1023
    $x12 = ADDI $x10, 17
    $x11 = AND $x12, $x11
    $x13 = ORI $x11, 255
    $x12 = XOR $x13, $x10
    $x14 = SUB $x12, $x11
    PseudoBR %bb.1

  bb.1:
    PseudoRET
...
