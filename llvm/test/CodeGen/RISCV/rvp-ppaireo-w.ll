; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=riscv64 -mattr=+experimental-p,+m,+zbb -verify-machineinstrs < %s | FileCheck %s

; PPAIREO.W packs the low word of rs1 with the high word of rs2.

define i64 @insert_lo_v8i8(i64 %v, i32 %s) {
; CHECK-LABEL: insert_lo_v8i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ppaireo.w a0, a1, a0
; CHECK-NEXT:    ret
  %hi = lshr i64 %v, 32
  %hit = trunc i64 %hi to i32
  %ss = bitcast i32 %s to <4 x i8>
  %hh = bitcast i32 %hit to <4 x i8>
  %cat = shufflevector <4 x i8> %ss, <4 x i8> %hh, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %r = bitcast <8 x i8> %cat to i64
  ret i64 %r
}

define i64 @insert_lo_v4i16(i64 %v, i32 %s) {
; CHECK-LABEL: insert_lo_v4i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ppaireo.w a0, a1, a0
; CHECK-NEXT:    ret
  %hi = lshr i64 %v, 32
  %hit = trunc i64 %hi to i32
  %ss = bitcast i32 %s to <2 x i16>
  %hh = bitcast i32 %hit to <2 x i16>
  %cat = shufflevector <2 x i16> %ss, <2 x i16> %hh, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %r = bitcast <4 x i16> %cat to i64
  ret i64 %r
}

; The high-half insert stays a pack.
define i64 @insert_hi_v8i8(i64 %v, i32 %s) {
; CHECK-LABEL: insert_hi_v8i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pack a0, a0, a1
; CHECK-NEXT:    ret
  %lo = trunc i64 %v to i32
  %ss = bitcast i32 %s to <4 x i8>
  %ll = bitcast i32 %lo to <4 x i8>
  %cat = shufflevector <4 x i8> %ll, <4 x i8> %ss, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %r = bitcast <8 x i8> %cat to i64
  ret i64 %r
}
