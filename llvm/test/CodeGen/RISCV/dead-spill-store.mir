# RUN: llc -mtriple=riscv64 -passes=greedy -stress-regalloc=2 -o - %s \
# RUN:   | FileCheck %s

# Greedy inserts an adjacent save/restore for the initial value of %3.
# Forward the restore, but keep the save: the loop's PHI VNI consumes both
# this value and the updated value saved on its backedge. No remaining reload
# directly consumes the initial VNI. The input contains no stack accesses.
--- |
  declare void @callee()
  define void @phi_consumer() { ret void }
...
---
name: phi_consumer
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: phi_consumer
    ; CHECK-COUNT-3: SD
    ; CHECK: [[INITIAL:%[0-9]+]]:gpr = ADD $x20, $x21
    ; CHECK-NEXT: SD [[INITIAL]], [[SLOT:%stack\.[0-9]+]], 0
    ; CHECK-NEXT: [[FORWARDED:%[0-9]+]]:gpr = COPY [[INITIAL]]
    ; CHECK: = ADD {{%[0-9]+}}, [[FORWARDED]]
    ; CHECK: bb.1:
    ; CHECK: PseudoCALL
    ; CHECK: [[UPDATED:%[0-9]+]]:gpr = LD [[SLOT]], 0
    ; CHECK-NEXT: [[UPDATED]]:gpr = ADDI [[UPDATED]], 1
    ; CHECK-NEXT: SD [[UPDATED]], [[SLOT]], 0
    ; CHECK: [[RELOADED:%[0-9]+]]:gpr = LD [[SLOT]], 0
    ; CHECK-NEXT: = ADD {{%[0-9]+}}, [[RELOADED]]
    ; CHECK: BNE {{.*}}, %bb.1
    liveins: $x20, $x21
    %0:gpr = ADD $x20, $x21
    %1:gpr = ADD $x20, $x21
    %2:gpr = ADD $x20, $x21
    %1:gpr = ADDI %1, 1
    %2:gpr = ADDI %2, 1
    %2:gpr = ADDI %2, 1
    %1:gpr = ADDI %1, 1
    %3:gpr = ADD $x20, $x21
    %1:gpr = ADD %1, %3
    PseudoBR %bb.1

  bb.1:
    PseudoCALL target-flags(riscv-call) @callee, csr_ilp32_lp64, implicit-def $x1
    %3:gpr = ADDI %3, 1
    %0:gpr = ADD %0, %1
    %0:gpr = ADD %0, %2
    %0:gpr = ADD %0, %3
    BNE %0, $x0, %bb.1
    PseudoBR %bb.2

  bb.2:
    $x10 = COPY %0
    PseudoRET implicit $x10
...
