; Device addresses fold base + (extended index << shift) and constant
; offsets; loads are asynchronous and need a wait before their use.

define agx_kernel void @scaled_index(ptr addrspace(1) %a, ptr addrspace(1) %out) {
; CHECK-LABEL: scaled_index:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 3 x 32-bit
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    get_sr r1, sr80 (thread_position_in_grid.x)
; CHECK-NEXT:    device_load 0, i32, x, r2, u0_u1, r1, unsigned
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    fadd32 r2, r2, r2
; CHECK-NEXT:    device_store 0, i32, x, r2, u2_u3, r1, unsigned
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %id = call i32 @llvm.agx.thread.position.in.grid.x()
  %idx = zext i32 %id to i64
  %pa = getelementptr float, ptr addrspace(1) %a, i64 %idx
  %x = load float, ptr addrspace(1) %pa
  %y = fmul float %x, 2.0
  %po = getelementptr float, ptr addrspace(1) %out, i64 %idx
  store float %y, ptr addrspace(1) %po
  ret void
}

