; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; float division and sqrt without arcp / afn are correctly rounded (with the
; ALU's flushing of denormals). Division: the significands, with the exponent
; field set by one bfi each (b's to 128, a's to 127), are divided with the
; refined reciprocal and one remainder correction, and the exponents come
; back as two factors, pb first for a tiny a: a tiny normal quotient (such
; as 0x827ffcfe) stays normal where the reciprocal of b would be flushed.
; 1 / b is the refined reciprocal. sqrt: x rsqrt_special(x) with one
; remainder correction, x below 2^-80 scaled by 2^64. The arcp and afn forms
; stay the hardware's.
; RUN: llc -mtriple=agx -mcpu=agx-g14g -verify-machineinstrs < %s | FileCheck %s

define agx_kernel void @div(ptr addrspace(1) %out, float %a, float %b) {
; CHECK-LABEL: div:
; CHECK:         // uniform registers: 14 x 16-bit (threadgroups_per_grid at u4)
; CHECK-NEXT:    // general purpose registers: 6 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bfi r1, u3, 128, 23, mask 0xFF
; CHECK-NEXT:    bfi r4, u2, 127, 23, mask 0xFF
; CHECK-NEXT:    rcp r2, r1
; CHECK-NEXT:    fmadd32 r3, r1.neg, r2, 1.0
; CHECK-NEXT:    fmadd32 r2, r3, r2, r2
; CHECK-NEXT:    fmul32 r3, r4, r2
; CHECK-NEXT:    fmadd32 r1, r1.neg, r3, r4
; CHECK-NEXT:    mov_imm r4, 25165824
; CHECK-NEXT:    fmadd32 r1, r1, r2, r3
; CHECK-NEXT:    mov_imm r2, 2139095040
; CHECK-NEXT:    and r3, u2, r2
; CHECK-NEXT:    bitop 0100, r2, r2, u3
; CHECK-NEXT:    fcmpsel lt, r5, u2.abs, r4, r2, r3
; CHECK-NEXT:    fcmpsel lt, r2, u2.abs, r4, r3, r2
; CHECK-NEXT:    fmul32 r1, r1, r5
; CHECK-NEXT:    fmul32 r1, r1, r2
; CHECK-NEXT:    mov_imm r2, 2143289344
; CHECK-NEXT:    fcmpsel eq, r1, u3, u3, r1, r2
; CHECK-NEXT:    fcmpsel eq, r1, u2, u2, r1, r2
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %r = fdiv float %a, %b
  store float %r, ptr addrspace(1) %out
  ret void
}

