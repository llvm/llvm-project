; All branches become execution mask operations on r0l: if_icmp / else /
; pop_exec for if-then-else, and push_exec / while_icmp / jmp_exec_any for
; loops. The jumps only skip code no thread executes.

define agx_kernel void @if_then_else(ptr addrspace(1) %out, i32 %n) {
; CHECK-LABEL: if_then_else:
; CHECK:         // uniform registers: 12 x 16-bit (threadgroups_per_grid at u3)
; CHECK-NEXT:    // general purpose registers: 3 x 32-bit
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov_imm r0l, 0
; CHECK-NEXT:    get_sr r1, sr80 (thread_position_in_grid.x)
; CHECK-NEXT:    // implicit-def: $r2
; CHECK-NEXT:    if_icmp r0l, ugte, r1, u2, 1
; CHECK-NEXT:    jmp_exec_none .LBB0_2
; CHECK-NEXT:  // %bb.1: // %else
; CHECK-NEXT:    iadd r2, r1, 7
; CHECK-NEXT:  .LBB0_2: // %Flow
; CHECK-NEXT:    else_fcmp r0l, eq, 0.0, 0.0, 1
; CHECK-NEXT:    jmp_exec_none .LBB0_4
; CHECK-NEXT:  // %bb.3: // %then
; CHECK-NEXT:    imadd r2, r1, 3, 0
; CHECK-NEXT:  .LBB0_4: // %end
; CHECK-NEXT:    pop_exec r0l, 1
; CHECK-NEXT:    device_store 0, i32, x, r2, u0_u1, r1, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %id = call i32 @llvm.agx.thread.position.in.grid.x()
  %c = icmp ult i32 %id, %n
  br i1 %c, label %then, label %else
then:
  %a = mul i32 %id, 3
  br label %end
else:
  %b = add i32 %id, 7
  br label %end
end:
  %r = phi i32 [%a, %then], [%b, %else]
  %p = getelementptr i32, ptr addrspace(1) %out, i32 %id
  store i32 %r, ptr addrspace(1) %p
  ret void
}

