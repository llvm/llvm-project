; Kernel arguments are packed into uniform registers in 16-bit units, each
; aligned to its size, followed by threadgroups_per_grid.xyz.

define agx_kernel void @args(ptr addrspace(1) %out, i16 %a, i32 %b, i64 %c, half %d, float %e) {
; CHECK-LABEL: args:
; CHECK:         // uniform registers: 22 x 16-bit (threadgroups_per_grid at u8)
; CHECK-NEXT:    // general purpose registers: 3 x 32-bit
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bitop 0101, r1, u2l, 0
; CHECK-NEXT:    iadd r1, r1, u3
; CHECK-NEXT:    fadd32 r2, u6l, -0.0
; CHECK-NEXT:    iadd r1, r1, u4
; CHECK-NEXT:    fadd32 r2, r2, u7
; CHECK-NEXT:    iadd r1, r1, r2
; CHECK-NEXT:    iadd r1, r1, u9
; CHECK-NEXT:    device_store 0, i32, x, r1, u0_u1, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %a32 = zext i16 %a to i32
  %s0 = add i32 %a32, %b
  %c32 = trunc i64 %c to i32
  %s1 = add i32 %s0, %c32
  %d32 = fpext half %d to float
  %f = fadd float %d32, %e
  %fi = bitcast float %f to i32
  %s2 = add i32 %s1, %fi
  %g = call i32 @llvm.agx.threadgroups.per.grid.y()
  %s3 = add i32 %s2, %g
  store i32 %s3, ptr addrspace(1) %out
  ret void
}

