; RUN: llc -mtriple=agx -mcpu=agx-g13g -verify-machineinstrs < %s | FileCheck %s

; Device and constant variables live in the global data buffer, whose
; address follows threadgroups_per_grid in the uniform registers. The
; initial contents are in .agx.globals, in module order.

@counter = addrspace(1) global i32 7, align 4
@table = addrspace(4) constant [4 x float] [float 1.0, float 2.0, float 3.0, float 4.0], align 16
@tg = internal addrspace(3) global [8 x i32] undef

define agx_kernel void @kernel(ptr addrspace(1) %out, i32 %i) {
; CHECK-LABEL: kernel:
; CHECK:         // uniform registers: 16 x 16-bit (threadgroups_per_grid at u3)
; CHECK-NEXT:    // general purpose registers: 4 x 32-bit (up to 1024 threads per threadgroup)
; CHECK-NEXT:    // global data buffer at u6_u7
; CHECK-NEXT:    // threadgroup memory: 32 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bitop 0101, r2, u6, 0
; CHECK-NEXT:    bitop 0101, r3, u7, 0
; CHECK-NEXT:    iadd r2_r3, r2_r3, u2.sx, lsl 2
; CHECK-NEXT:    device_load 0, i32, x, r1, u6_u7, 0, signed
; CHECK-NEXT:    device_load 1, i32, x, r2, r2_r3, 4, signed
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    convert s32_to_f, r3, r1, rte
; CHECK-NEXT:    wait 1
; CHECK-NEXT:    fadd32 r2, r2, r3
; CHECK-NEXT:    bfi r3, 0, u2, 2
; CHECK-NEXT:    device_store 0, i32, x, r2, u0_u1, 0, signed
; CHECK-NEXT:    threadgroup_store i32, x, r1, r3l, 0
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %p = getelementptr [4 x float], ptr addrspace(4) @table, i32 0, i32 %i
  %v = load float, ptr addrspace(4) %p
  %c = load i32, ptr addrspace(1) @counter
  %cf = sitofp i32 %c to float
  %s = fadd float %v, %cf
  store float %s, ptr addrspace(1) %out
  %t = getelementptr [8 x i32], ptr addrspace(3) @tg, i32 0, i32 %i
  store i32 %c, ptr addrspace(3) %t
  ret void
}

