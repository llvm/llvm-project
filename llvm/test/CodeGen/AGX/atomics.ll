; CHECK-NEXT:    // general purpose registers: 2 x 32-bit
; CHECK-NEXT:    // threadgroup memory: 0 bytes
; CHECK-NEXT:    // stack size: 0 bytes
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    bitop 0101, r1, u4, 0
; CHECK-NEXT:    atomic add, 0, r1, u0_u1, 0, signed, r1, 0
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    atomic umax, 0, r1, u0_u1, 0, signed, r1, 0
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    atomic xchg, 0, r1, u0_u1, 0, signed, r1, 0
; CHECK-NEXT:    wait 0
; CHECK-NEXT:    device_store 0, i32, x, r1, u2_u3, 0, signed
; CHECK-NEXT:    stop
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
; CHECK-NEXT:    trap
  %a = atomicrmw add ptr addrspace(1) %p, i32 %v monotonic
  %b = atomicrmw umax ptr addrspace(1) %p, i32 %a monotonic
  %c = atomicrmw xchg ptr addrspace(1) %p, i32 %b monotonic
  store i32 %c, ptr addrspace(1) %out
  ret void
}

