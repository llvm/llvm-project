  %t = call i32 @llvm.agx.thread.position.in.grid.x()
  %p0 = getelementptr i32, ptr addrspace(1) %a, i32 0
  %l0 = load volatile i32, ptr addrspace(1) %p0
  %v0 = add i32 %l0, %t
  %p1 = getelementptr i32, ptr addrspace(1) %a, i32 1
