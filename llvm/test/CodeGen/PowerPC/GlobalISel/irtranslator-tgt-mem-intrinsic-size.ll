; Info.offset = -15, which differ from the size of memVT. Like
; SelectionDAGBuilder, the IRTranslator must use Info.size for the memory
; operand instead of the size of memVT.

define <2 x double> @lxvd2x(ptr %p) {
  ; CHECK-LABEL: name: lxvd2x
