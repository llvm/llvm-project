  ; CHECK-NEXT:   liveins: $x3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $x3
  ; CHECK-NEXT:   [[INT:%[0-9]+]]:_(<2 x s64>) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.ppc.vsx.lxvd2x), [[COPY]](p0) :: (load (s248) from %ir.p - 15, align 1)
  ; CHECK-NEXT:   $v2 = COPY [[INT]](<2 x s64>)
  ; CHECK-NEXT:   BLR8 implicit $lr8, implicit $rm, implicit $v2
  %v = call <2 x double> @llvm.ppc.vsx.lxvd2x(ptr %p)
  ret <2 x double> %v
}

