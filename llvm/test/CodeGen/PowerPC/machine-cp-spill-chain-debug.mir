# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=powerpc64le -run-pass=machine-cp -enable-spill-copy-elim -o - %s | FileCheck %s

# A DBG_VALUE inside a spill-reload copy chain must not prevent folding the
# chain. After folding, a DBG_VALUE that reads an intermediate register of the
# chain ($x30 here) is made undefined, because that register no longer holds
# the described value; one that reads the outermost register ($x28) is kept.

--- |
  define void @f() !dbg !5 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !DISubroutineType(types: !4)
  !4 = !{null}
  !5 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !6 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !7 = !DILocalVariable(name: "a", scope: !5, file: !1, line: 2, type: !6)
  !8 = !DILocalVariable(name: "b", scope: !5, file: !1, line: 3, type: !6)
  !9 = !DILocation(line: 0, scope: !5)
...
---
name:            f
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x3, $x18, $x22, $x30

    ; CHECK-LABEL: name: f
    ; CHECK: liveins: $x3, $x18, $x22, $x30
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x28 = COPY killed renamable $x30
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 0, scope: !3)
    ; CHECK-NEXT: $x30 = COPY killed renamable $x18
    ; CHECK-NEXT: DBG_VALUE $x28, $noreg, !8, !DIExpression(), debug-location !DILocation(line: 0, scope: !3)
    ; CHECK-NEXT: renamable $x18 = ADDI8 $x3, 1
    ; CHECK-NEXT: $x3 = ADD8 killed renamable $x18, killed $x3
    ; CHECK-NEXT: renamable $x18 = COPY killed $x30
    ; CHECK-NEXT: renamable $x30 = COPY killed renamable $x28
    ; CHECK-NEXT: BLR8 implicit $lr8, implicit $rm, implicit $x3, implicit $x18, implicit $x22, implicit $x30
    renamable $x28 = COPY killed renamable $x30
    renamable $x30 = COPY killed renamable $x22
    DBG_VALUE $x30, $noreg, !7, !DIExpression(), debug-location !9
    renamable $x22 = COPY killed renamable $x18
    DBG_VALUE $x28, $noreg, !8, !DIExpression(), debug-location !9
    renamable $x18 = ADDI8 $x3, 1
    $x3 = ADD8 killed renamable $x18, killed $x3
    renamable $x18 = COPY killed renamable $x22
    renamable $x22 = COPY killed renamable $x30
    renamable $x30 = COPY killed renamable $x28
    BLR8 implicit $lr8, implicit $rm, implicit $x3, implicit $x18, implicit $x22, implicit $x30
...
