    %0:g8rc = COPY $x3, debug-location !8
    %2:g8rc_and_g8rc_nox0 = SUBF8 %0, %1, debug-location !8
    %3:crrc = CMPLD %0, %1, debug-location !8
    DBG_VALUE %3, $noreg, !7, !DIExpression(), debug-location !8
    %4:g8rc_and_g8rc_nox0 = LI8 0, debug-location !8
