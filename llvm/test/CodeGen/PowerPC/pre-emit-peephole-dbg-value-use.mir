# RUN: llc -mtriple=powerpc64le -run-pass=ppc-pre-emit-peephole %s -o - | FileCheck %s

# A debug use of a load-immediate must not keep the otherwise dead LI8 after
# its value is folded into ADD8. Preserve the variable location as an
# immediate rather than leaving it referring to the erased register value.

--- |
  define i64 @li_dbg_value(i64 %k) !dbg !5 {
    ret i64 %k, !dbg !10
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = !{i32 7, !"Dwarf Version", i32 5}
  !5 = distinct !DISubprogram(name: "li_dbg_value", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !6 = !DISubroutineType(types: !7)
  !7 = !{!8, !8}
  !8 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !9 = !DILocalVariable(name: "a", scope: !5, file: !1, line: 1, type: !8)
  !10 = !DILocation(line: 2, scope: !5)
  !11 = !DILocalVariable(name: "b", scope: !5, file: !1, line: 1, type: !8)
  !12 = !DILocalVariable(name: "c", scope: !5, file: !1, line: 1, type: !8)
  !13 = !DILocalVariable(name: "entry", scope: !5, file: !1, line: 1, type: !8)
...
---
name:            li_dbg_value
tracksRegLiveness: true
isSSA:           false
noVRegs:         true
body:             |
  bb.0:
    liveins: $x5

    ; CHECK-LABEL: name: li_dbg_value
    ; CHECK-NOT: LI8 0
    ; CHECK: DBG_VALUE 0, $noreg
    ; CHECK-NEXT: DBG_VALUE $noreg, 0
    ; CHECK-NEXT: DBG_VALUE_LIST {{.*}}, $noreg
    ; CHECK-NEXT: DBG_VALUE $x8, $noreg, {{.*}}, !DIExpression(DW_OP_LLVM_entry_value, 1)
    ; CHECK-NOT: DBG_PHI
    ; CHECK: ADDI8 {{.*}}, 0
    ; CHECK: $x9 = LI8 1
    ; CHECK: DBG_VALUE $x9, $noreg
    ; CHECK: COPY {{.*}}$x9
    ; CHECK: ADDI8 {{.*}}, 1
    renamable $x8 = LI8 0
    DBG_VALUE $x8, $noreg, !9, !DIExpression(), debug-location !10
    DBG_VALUE $x8, 0, !11, !DIExpression(), debug-location !10
    DBG_VALUE_LIST !12, !DIExpression(DW_OP_LLVM_arg, 0), $x8, debug-location !10
    DBG_VALUE $x8, $noreg, !13, !DIExpression(DW_OP_LLVM_entry_value, 1), debug-location !10
    DBG_PHI $x8, 0
    dead renamable $x3 = nsw ADD8 killed renamable $x8, renamable $x5, debug-location !10
    renamable $x9 = LI8 1
    DBG_VALUE $x9, $noreg, !9, !DIExpression(), debug-location !10
    dead renamable $x6 = COPY $x9
    renamable $x3 = nsw ADD8 killed renamable $x9, killed renamable $x5, debug-location !10
    BLR8 implicit $lr8, implicit $rm, implicit killed $x3, debug-location !10
...
