# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -verify-machineinstrs -mtriple=powerpc64le-unknown-linux  \
# RUN:   -run-pass=ppc-mi-peepholes %s -o - | FileCheck %s

# Test that peephole optimizations correctly update LiveVariables tracking.
# XXPERMDI splat optimization skipped when splat register has multiple uses.
# ISEL to COPY conversion tracks removed operand registers to prevent
# LiveVariables corruption.

---
name: test_xxpermdi_splat_multiple_uses
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: vrrc }
  - { id: 28, class: vrrc }
  - { id: 31, class: f8rc }
  - { id: 34, class: vrrc }
  - { id: 35, class: vrrc }
body: |
  bb.0:
    liveins: $f1

    ; CHECK-LABEL: name: test_xxpermdi_splat_multiple_uses
    ; CHECK: liveins: $f1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[XXLXORz:%[0-9]+]]:vrrc = XXLXORz
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:f8rc = COPY $f1
    ; CHECK-NEXT: [[XXPERMDIs:%[0-9]+]]:vrrc = XXPERMDIs [[COPY]], 0
    ; CHECK-NEXT: [[XXPERMDI:%[0-9]+]]:vrrc = XXPERMDI [[XXLXORz]], [[XXPERMDIs]], 3
    ; CHECK-NEXT: [[XXPERMDI1:%[0-9]+]]:vrrc = XXPERMDI [[XXPERMDIs]], [[XXPERMDIs]], 3
    %28:vrrc = XXLXORz
    %31:f8rc = COPY $f1
    %0:vrrc = XXPERMDIs %31, 0
    %34:vrrc = XXPERMDI %28, %0, 3
    %35:vrrc = XXPERMDI %0, %0, 3

...
---
name: test_swap_isel_livevars
alignment: 16
tracksRegLiveness: true
stack:
  - { id: 0, size: 16, alignment: 16 }
registers:
  - { id: 2, class: vrrc }
  - { id: 3, class: gprc_and_gprc_nor0 }
  - { id: 4, class: gprc }
  - { id: 7, class: gprc }
  - { id: 8, class: gprc }
  - { id: 21, class: vsrc }
  - { id: 22, class: g8rc_and_g8rc_nox0 }
  - { id: 25, class: vsrc }
  - { id: 26, class: vsrc }
  - { id: 29, class: crrc }
  - { id: 31, class: vsrc }
body: |
  bb.0:
    ; CHECK-LABEL: name: test_swap_isel_livevars
    ; CHECK: [[LI:%[0-9]+]]:gprc = LI 0
    ; CHECK-NEXT: [[LI1:%[0-9]+]]:gprc = LI 1
    ; CHECK-NEXT: [[XXLXORz:%[0-9]+]]:vsrc = XXLXORz
    ; CHECK-NEXT: [[ADDI8_:%[0-9]+]]:g8rc_and_g8rc_nox0 = ADDI8 %stack.0, 0
    ; CHECK-NEXT: [[CMPLWI:%[0-9]+]]:crrc = CMPLWI [[LI]], 0
    ; CHECK-NEXT: STXVD2X [[XXLXORz]], $zero8, [[ADDI8_]] :: (store (s128) into %stack.0)
    ; CHECK-NEXT: [[LXVD2X:%[0-9]+]]:vsrc = LXVD2X $zero8, [[ADDI8_]] :: (load (s128) from %stack.0)
    ; CHECK-NEXT: [[XXPERMDI:%[0-9]+]]:vsrc = XXPERMDI [[LXVD2X]], [[LXVD2X]], 2
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vrrc = COPY [[XXPERMDI]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vsrc = COPY [[LXVD2X]]
    ; CHECK-NEXT: [[LI2:%[0-9]+]]:gprc_and_gprc_nor0 = LI 0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gprc = COPY [[LI2]]
    %7:gprc = LI 0
    %8:gprc = LI 1
    %21:vsrc = XXLXORz
    %22:g8rc_and_g8rc_nox0 = ADDI8 %stack.0, 0
    %29:crrc = CMPLWI %7, 0

    STXVD2X %21, $zero8, %22 :: (store (s128) into %stack.0)
    %25:vsrc = LXVD2X $zero8, %22 :: (load (s128) from %stack.0)
    %26:vsrc = XXPERMDI %25, %25, 2
    %2:vrrc = COPY %26
    %31:vsrc = XXPERMDI %2, %2, 2
    %3:gprc_and_gprc_nor0 = LI 0
    %4:gprc = ISEL %3, %8, %29.sub_eq

...
