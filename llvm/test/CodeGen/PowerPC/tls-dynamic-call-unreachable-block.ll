; LE-NEXT:    stdu 1, -112(1)
; LE-NEXT:    std 0, 128(1)
; LE-NEXT:    std 3, 104(1) # 8-byte Folded Spill
; LE-NEXT:    b .LBB0_2
; LE-NEXT:  # %bb.1: # %dead
; LE-NEXT:    ld 3, 104(1) # 8-byte Folded Reload
; LE-NEXT:    bl g
; LE-NEXT:    nop
; LE-NEXT:  .LBB0_2: # %exit
; LE-NEXT:    addi 1, 1, 112
; LE-NEXT:    ld 0, 16(1)
; LE-NEXT:    mtlr 0
; LE-NEXT:    blr
;
; AIX-LABEL: unreachable_block_use:
