; AIX-NEXT:    mflr 0
; AIX-NEXT:    stdu 1, -128(1)
; AIX-NEXT:    std 0, 144(1)
; AIX-NEXT:    std 3, 120(1) # 8-byte Folded Spill
; AIX-NEXT:    b L..BB0_2
; AIX-NEXT:  # %bb.1: # %dead
; AIX-NEXT:    ld 3, 120(1) # 8-byte Folded Reload
; AIX-NEXT:    bl .g[PR]
