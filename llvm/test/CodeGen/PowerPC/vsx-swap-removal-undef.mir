# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -run-pass=ppc-vsx-swaps -o - %s | FileCheck %s

# VSX swap removal must not crash when a vector operand is an undef register
# with no defining instruction.
---
name: vsxswap_undef
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v3
    ; CHECK-LABEL: name: vsxswap_undef
    ; CHECK: liveins: $v3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[VADDUWM:%[0-9]+]]:vrrc = VADDUWM undef %1:vrrc, $v3
    ; CHECK-NEXT: $v2 = COPY [[VADDUWM]]
    ; CHECK-NEXT: BLR implicit $lr, implicit $rm, implicit $v2
    %1:vrrc = VADDUWM undef %0:vrrc, $v3
    $v2 = COPY %1
    BLR implicit $lr, implicit $rm, implicit $v2
...
