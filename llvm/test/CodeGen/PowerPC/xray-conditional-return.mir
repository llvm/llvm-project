# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -start-before=xray-instrumentation -verify-machineinstrs %s -o - | FileCheck %s
## Emitting an object checks each sled's size against getInstSizeInBytes
## (assertions builds only).
# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -start-before=xray-instrumentation -filetype=obj %s -o /dev/null

## A return on CTR != 0 (bdnzlr) branches around its sled with bdz.
# CHECK-LABEL: CtrN:
# CHECK:        mtctr 3
# CHECK-NEXT:   bdz [[LABEL:\.[a-zA-Z0-9]+]]
# CHECK-NEXT:   .p2align 3
# CHECK-NEXT: {{\.[a-zA-Z0-9]+}}:
# CHECK-NEXT:   blr
# CHECK-NEXT:   nop
# CHECK-NEXT:   std 0
# CHECK-NEXT:   mflr 0
# CHECK-NEXT:   bl __xray_FunctionExit
# CHECK-NEXT:   nop
# CHECK-NEXT:   mtlr 0
# CHECK-NEXT:   blr
# CHECK-NEXT: [[LABEL]]:

--- |
  define void @CtrN(i64 %n) #0 {
    ret void
  }

  attributes #0 = { "function-instrument"="xray-always" }
...
---
name:            CtrN
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $x3

    MTCTR8 killed $x3, implicit-def $ctr8
    BDNZLR8 implicit $lr8, implicit $rm, implicit $ctr8, implicit-def $ctr8

  bb.1:
    BLR8 implicit $lr8, implicit $rm
...
