# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -run-pass=ppc-mi-peepholes -o - %s | FileCheck %s

# The MI peephole must not crash when a forwarding-eligible operand is an undef
# register with no def.
---
name: forwarding_undef
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x3
    ; CHECK-LABEL: name: forwarding_undef
    ; CHECK: liveins: $x3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:g8rc = COPY killed $x3
    ; CHECK-NEXT: [[ADDI8_:%[0-9]+]]:g8rc = ADDI8 undef %2:g8rc_and_g8rc_nox0, 4
    ; CHECK-NEXT: [[ADD8_:%[0-9]+]]:g8rc = ADD8 killed [[COPY]], killed [[ADDI8_]]
    ; CHECK-NEXT: $x3 = COPY killed [[ADD8_]]
    ; CHECK-NEXT: BLR8 implicit $lr8, implicit $rm, implicit killed $x3
    %0:g8rc = COPY $x3
    %1:g8rc = ADDI8 undef %2:g8rc_and_g8rc_nox0, 4
    %3:g8rc = ADD8 %0, %1
    $x3 = COPY %3
    BLR8 implicit $lr8, implicit $rm, implicit $x3
...
