; CHECK-NEXT:    li 5, 0
; CHECK-NEXT:    addze 7, 4
; CHECK-NEXT:    cmpldi 5, 6, 1
; CHECK-NEXT:    li 6, 0
; CHECK-NEXT:    cmpldi 1, 7, 0
; CHECK-NEXT:    cmpdi 6, 7, 1
; CHECK-NEXT:    bc 12, 1, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %compare
; CHECK-NEXT:    crandc 20, 24, 6
; CHECK-NEXT:    crandc 22, 6, 21
; CHECK-NEXT:    li 6, 1
; CHECK-NEXT:    crnor 20, 22, 20
; CHECK-NEXT:    isel 6, 0, 6, 20
; CHECK-NEXT:  .LBB0_2: # %merge
; CHECK-NEXT:    clrldi 6, 6, 32
; CHECK-NEXT:    mfcr 12
; CHECK-NEXT:    cmpldi 7, 4, 0
; CHECK-NEXT:    cmpdi 2, 4, 0
; CHECK-NEXT:    crandc 21, 6, 21
; CHECK-NEXT:    stw 12, 8(1)
; CHECK-NEXT:    cmpld 3, 3, 6
; CHECK-NEXT:    li 3, 1
; CHECK-NEXT:    crandc 20, 8, 30
; CHECK-NEXT:    lwz 12, 8(1)
; CHECK-NEXT:    mtcrf 48, 12
; CHECK-NEXT:    crand 22, 30, 12
; CHECK-NEXT:    crnor 20, 22, 20
; CHECK-NEXT:    isel 4, 0, 3, 20
; CHECK-NEXT:    crandc 20, 24, 6
; CHECK-NEXT:    crnor 20, 21, 20
; CHECK-NEXT:    isel 6, 5, 3, 20
; CHECK-NEXT:    iselgt 3, 3, 5
; CHECK-NEXT:    add 4, 4, 6
; CHECK-NEXT:    addi 4, 4, 1
; CHECK-NEXT:    or 3, 4, 3
; CHECK-NEXT:    clrldi 3, 3, 32
; CHECK-NEXT:    blr
entry:
  %value.plus.one = add i128 %value, 1
  br i1 %cond, label %early.exit, label %compare

early.exit:                                       ; preds = %entry
  br label %merge

compare:                                          ; preds = %entry
  %cmp.le = icmp sle i128 %value.plus.one, 1
  %cmp.le.ext = zext i1 %cmp.le to i32
  br label %merge

merge:                                            ; preds = %compare, %early.exit
  %partial = phi i32 [ %cmp.le.ext, %compare ], [ 0, %early.exit ]
  %partial.ext = zext i32 %partial to i128
  %cmp.value = icmp slt i128 %value, %partial.ext
  %cmp.value.ext = zext i1 %cmp.value to i32
  %sum = add i32 1, %cmp.value.ext
  %cmp.le.again = icmp sle i128 %value.plus.one, 1
  %cmp.le.again.ext = zext i1 %cmp.le.again to i32
  %sum.plus = add i32 %sum, %cmp.le.again.ext
  %cond.ext = zext i1 %cond to i32
  %result = or i32 %sum.plus, %cond.ext
  ret i32 %result
}
