    DBG_VALUE $cr0gt, 0, !7, !DIExpression(), debug-location !15
    DBG_VALUE $cr0gt, $noreg, !7, !DIExpression(DW_OP_LLVM_entry_value, 1), debug-location !15
    DBG_VALUE $cr1lt, $noreg, !7, !DIExpression(), debug-location !15
    DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), $cr0, $x3, debug-location !15
    DBG_PHI $cr0gt, 1
    BC killed $cr0gt, %bb.2

  bb.1:
    DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !15
    BLR8 implicit $lr8, implicit $rm

  bb.2:
    BLR8 implicit $lr8, implicit $rm
