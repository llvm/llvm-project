name: debug_use_false
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: debug_use_false
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_VALUE 0, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
