  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
  ; CHECK-NEXT:   DBG_VALUE $noreg, 0, !7, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
  ; CHECK-NEXT:   DBG_VALUE $cr0gt, $noreg, !7, !DIExpression(DW_OP_LLVM_entry_value, 1), debug-location !DILocation(line: 1, column: 1, scope: !3)
  ; CHECK-NEXT:   DBG_VALUE $cr1lt, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
  ; CHECK-NEXT:   DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), $noreg, $noreg, debug-location !DILocation(line: 1, column: 1, scope: !3)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !DILocation(line: 1, column: 1, scope: !3)
  ; CHECK-NEXT:   BLR8 implicit $lr8, implicit $rm
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   BLR8 implicit $lr8, implicit $rm
  bb.0:
    successors: %bb.1, %bb.2

    $cr0gt = CRUNSET implicit-def $cr0
    DBG_VALUE $cr0gt, $noreg, !7, !DIExpression(), debug-location !15
    DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), $cr0gt, $x3, debug-location !15
