    %5:g8rc_and_g8rc_nox0 = ADDIStocHA8 $x2, %const.0
    %6:vssrc = DFLOADf32 target-flags(ppc-toc-lo) %const.0, killed %5 :: (load (s32) from constant-pool)
    %7:vssrc = nsz reassoc nofpexcept XSMADDASP %3, killed %4, killed %6
    %8:vssrc = nsz reassoc nofpexcept XSADDSP %0, %0
    %9:vssrc = nsz reassoc nofpexcept XSADDSP %8, %2
    %10:vssrc = COPY %7
  bb.1:
    %11:vssrc = nsz reassoc nofpexcept XSADDSP %0, %0
    %12:vssrc = nsz reassoc nofpexcept XSMULSP %11, %10
    %13:vssrc = nsz reassoc nofpexcept XSMULSP %12, %0
