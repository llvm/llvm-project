  ; DEBUG-NEXT:   [[XSADDSP1:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSADDSP [[COPY]], [[COPY]]
  ; DEBUG-NEXT:   [[XSADDSP2:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSADDSP [[XSADDSP1]], [[XSADDSP]]
  ; DEBUG-NEXT:   [[COPY1:%[0-9]+]]:vssrc = COPY [[XSMADDASP1]]
  ; DEBUG-NEXT: {{  $}}
  ; DEBUG-NEXT: bb.1:
  ; DEBUG-NEXT:   successors: %bb.1(0x80000000)
