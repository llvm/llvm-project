  ; CHECK-NEXT:   [[XSADDSP:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSADDSP [[XSMULSP]], [[COPY]]
  ; CHECK-NEXT:   [[XSMULSP1:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSMULSP [[XSADDSP]], [[COPY]]
