  ; CHECK-NEXT:   [[XSMADDASP:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSMADDASP killed [[XSMULSP1]], [[COPY]], [[DFLOADf32_1]]
  ; CHECK-NEXT:   [[XSMADDASP1:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSMADDASP killed [[XSMADDASP]], [[COPY]], killed [[DFLOADf32_]]
