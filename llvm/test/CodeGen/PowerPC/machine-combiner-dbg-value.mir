  bb.0:
    liveins: $f2, $x2
    DBG_VALUE 0, $noreg, !10, !DIExpression(), debug-location !9
    %0:vssrc = COPY $f2
    %1:vssrc = nsz reassoc nofpexcept XSMULSP %0, %0
    %2:vssrc = nsz reassoc nofpexcept XSADDSP %1, %0
    %3:vssrc = nsz reassoc nofpexcept XSMULSP %2, %0
