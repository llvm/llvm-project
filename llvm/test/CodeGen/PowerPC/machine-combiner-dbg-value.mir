  ; DEBUG-NEXT:   [[COPY:%[0-9]+]]:vssrc = COPY $f2
  ; DEBUG-NEXT:   [[XSMULSP:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSMULSP [[COPY]], [[COPY]]
  ; DEBUG-NEXT:   [[XSADDSP:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSADDSP [[XSMULSP]], [[COPY]]
  ; DEBUG-NEXT:   [[XSMULSP1:%[0-9]+]]:vssrc = nsz reassoc nofpexcept XSMULSP [[XSADDSP]], [[COPY]]
  ; DEBUG-NEXT:   [[ADDIStocHA8_:%[0-9]+]]:g8rc_and_g8rc_nox0 = ADDIStocHA8 $x2, %const.0
  ; DEBUG-NEXT:   [[DFLOADf32_:%[0-9]+]]:vssrc = DFLOADf32 target-flags(ppc-toc-lo) %const.0, killed [[ADDIStocHA8_]] :: (load (s32) from constant-pool)
  ; DEBUG-NEXT:   [[ADDIStocHA8_1:%[0-9]+]]:g8rc_and_g8rc_nox0 = ADDIStocHA8 $x2, %const.1
