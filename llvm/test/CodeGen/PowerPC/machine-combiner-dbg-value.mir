# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -mcpu=pwr9 -O3 -ppc-fma-rp-factor=0.0 -run-pass mir-strip-debug,machine-combiner -mir-strip-debugify-only=0 -machine-combiner-inc-threshold=11 %s -o - | FileCheck %s
# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -mcpu=pwr9 -O3 -ppc-fma-rp-factor=0.0 -run-pass machine-combiner,mir-strip-debug -mir-strip-debugify-only=0 -machine-combiner-inc-threshold=11 %s -o - | FileCheck %s --check-prefix=DEBUG

# We should get the same result when machine-combiner sees debug info as when
# it does not. "-mir-strip-debugify-only=0" is needed for mir-strip-debug to
# remove all debug info. "-ppc-fma-rp-factor=0.0" is needed to make
# PPCInstrInfo::shouldReduceRegisterPressure return true.
#
# This covers the MBB->size() check in the register pressure reduction part of
# MachineCombinerImpl::combineInstructions.

--- |
  define void @test() !dbg !5 {
    ret void
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !5 = distinct !DISubprogram(name: "test", scope: !1, file: !1, type: !6, spFlags: DISPFlagDefinition, unit: !0)
  !6 = !DISubroutineType(types: !7)
  !7 = !{null}
  !9 = !DILocation(line: 0, scope: !5)
  !10 = !DILocalVariable(name: "x", scope: !5)
...
