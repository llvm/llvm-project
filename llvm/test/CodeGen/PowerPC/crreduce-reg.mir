# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=powerpc64-unknown-linux-gnu -run-pass=ppc-reduce-cr-ops \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

---
name:            subreg_folding_regression
tracksRegLiveness: true
isSSA:           true
body:             |
  ; CHECK-LABEL: name: subreg_folding_regression
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:g8rc_and_g8rc_nox0 = COPY $x3
  ; CHECK-NEXT:   [[LD:%[0-9]+]]:g8rc = LD 0, [[COPY]] :: (load (s64))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x20000000), %bb.3(0x60000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:g8rc_and_g8rc_nox0 = PHI [[LD]], %bb.0, %3, %bb.3, %4, %bb.2
  ; CHECK-NEXT:   [[LBZ:%[0-9]+]]:gprc = LBZ 0, [[PHI]] :: (load (s8))
  ; CHECK-NEXT:   [[CMPWI:%[0-9]+]]:crrc = CMPWI [[LBZ]], 0
  ; CHECK-NEXT:   [[ADDI8_:%[0-9]+]]:g8rc = nuw ADDI8 [[PHI]], 1
  ; CHECK-NEXT:   STD [[ADDI8_]], 0, [[COPY]] :: (store (s64))
  ; CHECK-NEXT:   [[LBZ1:%[0-9]+]]:gprc = LBZ 1, [[PHI]] :: (load (s8))
  ; CHECK-NEXT:   BCn [[CMPWI]].sub_lt, %bb.2
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x55555555), %bb.2(0x2aaaaaab)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[CMPWI1:%[0-9]+]]:crrc = CMPWI [[LBZ1]], 0
  ; CHECK-NEXT:   BC [[CMPWI1]].sub_eq, %bb.1
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADDI8_1:%[0-9]+]]:g8rc = nuw ADDI8 [[PHI]], 2
  ; CHECK-NEXT:   STD [[ADDI8_1]], 0, [[COPY]] :: (store (s64))
  ; CHECK-NEXT:   B %bb.1
  bb.0:
    liveins: $x3

    %0:g8rc_and_g8rc_nox0 = COPY $x3
    %1:g8rc = LD 0, %0 :: (load (s64))

  bb.1:
    %2:g8rc_and_g8rc_nox0 = PHI %1, %bb.0, %3, %bb.1, %4, %bb.2
    %5:gprc = LBZ 0, %2 :: (load (s8))
    %6:crrc = CMPWI %5, 0
    %3:g8rc = nuw ADDI8 %2, 1
    STD %3, 0, %0 :: (store (s64))
    %7:gprc = LBZ 1, %2 :: (load (s8))
    %8:crrc = CMPWI %7, 0
    %9:crbitrc = CRAND %8.sub_eq, %6.sub_lt
    BC %9, %bb.1
    B %bb.2

  bb.2:
    %4:g8rc = nuw ADDI8 %2, 2
    STD %4, 0, %0 :: (store (s64))
    B %bb.1

...
---
# $carry is live out of bb.0, so the block created by the split needs it as a
# live-in.
name:            carry_live_across_split
tracksRegLiveness: true
isSSA:           true
body:             |
  ; CHECK-LABEL: name: carry_live_across_split
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x20000000), %bb.3(0x60000000)
  ; CHECK-NEXT:   liveins: $r3, $r4, $r5, $r6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gprc = COPY $r3
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gprc = COPY $r4
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gprc = COPY $r5
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gprc = COPY $r6
  ; CHECK-NEXT:   [[ADDC:%[0-9]+]]:gprc = ADDC [[COPY]], [[COPY1]], implicit-def $carry
  ; CHECK-NEXT:   [[CMPWI:%[0-9]+]]:crrc = CMPWI [[COPY2]], 0
  ; CHECK-NEXT:   [[LI:%[0-9]+]]:gprc_and_gprc_nor0 = LI 0
  ; CHECK-NEXT:   [[LI1:%[0-9]+]]:gprc_and_gprc_nor0 = LI 1
  ; CHECK-NEXT:   BCn [[CMPWI]].sub_eq, %bb.1
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x2aaaaaab), %bb.2(0x55555555)
  ; CHECK-NEXT:   liveins: $carry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[CMPLWI:%[0-9]+]]:crrc = CMPLWI [[COPY3]], 0
  ; CHECK-NEXT:   BC killed [[CMPLWI]].sub_gt, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $carry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $carry
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gprc_and_gprc_nor0 = PHI [[LI]], %bb.1, [[LI1]], %bb.3
  ; CHECK-NEXT:   [[ADDE:%[0-9]+]]:gprc = ADDE [[COPY]], [[COPY1]], implicit-def dead $carry, implicit $carry
  ; CHECK-NEXT:   $r3 = COPY [[PHI]]
  ; CHECK-NEXT:   $r4 = COPY [[ADDE]]
  ; CHECK-NEXT:   $r5 = COPY [[ADDC]]
  ; CHECK-NEXT:   BLR implicit $lr, implicit $rm, implicit $r3, implicit $r4, implicit $r5
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r3, $r4, $r5, $r6

    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc = COPY $r5
    %3:gprc = COPY $r6
    %4:gprc = ADDC %0, %1, implicit-def $carry
    %5:crrc = CMPWI %2, 0
    %6:crrc = CMPLWI %3, 0
    %7:crbitrc = CRAND %5.sub_eq, %6.sub_gt
    %8:gprc_and_gprc_nor0 = LI 0
    %9:gprc_and_gprc_nor0 = LI 1
    BC killed %7, %bb.2

  bb.1:
    successors: %bb.2
    liveins: $carry

  bb.2:
    liveins: $carry

    %10:gprc_and_gprc_nor0 = PHI %8, %bb.1, %9, %bb.0
    %11:gprc = ADDE %0, %1, implicit-def dead $carry, implicit $carry
    $r3 = COPY %10
    $r4 = COPY %11
    $r5 = COPY %4
    BLR implicit $lr, implicit $rm, implicit $r3, implicit $r4, implicit $r5

...
