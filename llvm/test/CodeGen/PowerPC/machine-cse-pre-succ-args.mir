# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc %s -o - -mtriple=powerpc-unknown-unknown -run-pass=machine-cse | FileCheck %s

# MachineCSE PRE hoists the redundant FDIV into bb.1, which must land before the
# SUCC_ARGS cluster rather than inside it.

--- |
  define void @can_pre() {
  entry:
    br label %for.body
  for.body:
    br i1 poison, label %if.then, label %if.else
  if.then:
    br label %if.end
  if.else:
    br label %if.end
  if.end:
    br label %for.body
  }
...
---
name: can_pre
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: can_pre
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r1, $f1, $f2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gprc = COPY $r1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:f8rc = COPY $f1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:f8rc = COPY $f2
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY1]]
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.for.body:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $cr0 = CMPLWI [[COPY]], 0
  ; CHECK-NEXT:   [[FDIV:%[0-9]+]]:f8rc = nofpexcept FDIV [[COPY1]], [[COPY2]], implicit $rm
  ; CHECK-NEXT:   SUCC_ARGS %bb.4, %3:f8rc
  ; CHECK-NEXT:   BCC 44, $cr0, %bb.2
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.if.then:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.4, [[FDIV]]
  ; CHECK-NEXT:   B %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.if.else:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.4, [[FDIV]]
  ; CHECK-NEXT:   B %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.if.end:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   arguments: %6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, %6:f8rc
  ; CHECK-NEXT:   B %bb.1
  bb.0.entry:
    successors: %bb.1
    liveins: $r1, $f1, $f2
    %2:gprc = COPY $r1
    %4:f8rc = COPY $f1
    %5:f8rc = COPY $f2
    SUCC_ARGS %bb.1, %4
    B %bb.1

  bb.1.for.body:
    successors: %bb.2, %bb.3
    arguments: %6:f8rc
    $cr0 = CMPLWI %2, 0
    SUCC_ARGS %bb.4, %6
    BCC 44, $cr0, %bb.2
    B %bb.3

  bb.2.if.then:
    successors: %bb.4
    %0:f8rc = nofpexcept FDIV %4, %5, implicit $rm
    SUCC_ARGS %bb.4, %0
    B %bb.4

  bb.3.if.else:
    successors: %bb.4
    %1:f8rc = nofpexcept FDIV %4, %5, implicit $rm
    SUCC_ARGS %bb.4, %1
    B %bb.4

  bb.4.if.end:
    successors: %bb.1
    arguments: %7:f8rc
    SUCC_ARGS %bb.1, %7
    B %bb.1
...
