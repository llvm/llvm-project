; When using a PC-relative indirect sibcall, make sure that the stack protector
; split happens before the argument copies, rather than before the mtctr
; instruction.

declare void @use(ptr)

define void @indirect_tail_call(ptr %fp, i64 %a, i64 %b, i64 %c) nounwind sspreq {
; CHECK-LABEL: indirect_tail_call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mflr 0
; CHECK-NEXT:    std 27, -40(1) # 8-byte Folded Spill
; CHECK-NEXT:    std 28, -32(1) # 8-byte Folded Spill
; CHECK-NEXT:    std 29, -24(1) # 8-byte Folded Spill
; CHECK-NEXT:    std 30, -16(1) # 8-byte Folded Spill
; CHECK-NEXT:    std 0, 16(1)
; CHECK-NEXT:    stdu 1, -96(1)
; CHECK-NEXT:    mr 29, 3
; CHECK-NEXT:    ld 3, -28688(13)
; CHECK-NEXT:    mr 30, 6
; CHECK-NEXT:    mr 28, 5
; CHECK-NEXT:    mr 27, 4
; CHECK-NEXT:    std 3, 48(1)
; CHECK-NEXT:    addi 3, 1, 32
; CHECK-NEXT:    bl use@notoc
; CHECK-NEXT:    ld 3, 48(1)
; CHECK-NEXT:    ld 4, -28688(13)
; CHECK-NEXT:    cmpld 4, 3
; CHECK-NEXT:    bne 0, .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mtctr 29
; CHECK-NEXT:    mr 3, 27
; CHECK-NEXT:    mr 4, 28
; CHECK-NEXT:    mr 5, 30
; CHECK-NEXT:    mr 12, 29
; CHECK-NEXT:    addi 1, 1, 96
; CHECK-NEXT:    ld 0, 16(1)
; CHECK-NEXT:    ld 30, -16(1) # 8-byte Folded Reload
; CHECK-NEXT:    mtlr 0
; CHECK-NEXT:    ld 29, -24(1) # 8-byte Folded Reload
; CHECK-NEXT:    ld 28, -32(1) # 8-byte Folded Reload
; CHECK-NEXT:    ld 27, -40(1) # 8-byte Folded Reload
; CHECK-NEXT:    bctr
; CHECK-NEXT:    #TC_RETURNr8 ctr 0
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    bl __stack_chk_fail@notoc
  %buf = alloca [16 x i8]
  call void @use(ptr %buf)
  tail call void %fp(i64 %a, i64 %b, i64 %c)
  ret void
}
