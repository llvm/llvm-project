; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -mcpu=pwr9 -verify-machineinstrs < %s | FileCheck %s

; Logical or selects with branch weights feeding a branch. With CR bits, jumps
; are expensive on PowerPC, so SelectionDAGBuilder does not split a branch on a
; logical or: it combines the conditions with cror, and PPCReduceCRLogicals may
; split the branch later.

define i64 @logical_or_br(i64 %gas, ptr %m, i64 %n) {
; CHECK-LABEL: logical_or_br:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ld 6, 0(4)
; CHECK-NEXT:    addi 6, 6, 32
; CHECK-NEXT:    cmpld 5, 6
; CHECK-NEXT:    bgt 0, .LBB0_3
; CHECK-NEXT:  # %bb.1: # %select.false
; CHECK-NEXT:    ld 7, 8(4)
; CHECK-NEXT:    cmpld 6, 7
; CHECK-NEXT:    bc 12, 1, .LBB0_4
; CHECK-NEXT:  # %bb.2: # %fast
; CHECK-NEXT:    addi 3, 3, -3
; CHECK-NEXT:    std 6, 0(4)
; CHECK-NEXT:    blr
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:  .LBB0_4: # %slow
; CHECK-NEXT:    sub 3, 3, 5
; CHECK-NEXT:    blr
  %size = load i64, ptr %m, align 8
  %s = add i64 %size, 32
  %c1 = icmp ugt i64 %n, %s
  %capp = getelementptr inbounds i8, ptr %m, i64 8
  %cap = load i64, ptr %capp, align 8
  %c2 = icmp ugt i64 %s, %cap
  %or = select i1 %c1, i1 true, i1 %c2, !prof !0
  br i1 %or, label %slow, label %fast, !prof !0

fast:
  store i64 %s, ptr %m, align 8
  %r = add nsw i64 %gas, -3
  ret i64 %r

slow:
  %t = sub i64 %gas, %n
  ret i64 %t
}

define i64 @logical_or3_br(i64 %gas, ptr %m, i64 %n, i64 %k) {
; CHECK-LABEL: logical_or3_br:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ld 7, 0(4)
; CHECK-NEXT:    addi 7, 7, 32
; CHECK-NEXT:    cmpld 5, 7
; CHECK-NEXT:    bgt 0, .LBB1_4
; CHECK-NEXT:  # %bb.1: # %select.false
; CHECK-NEXT:    ld 8, 8(4)
; CHECK-NEXT:    cmpld 7, 8
; CHECK-NEXT:  .LBB1_2: # %select.end
; CHECK-NEXT:    cmpld 1, 6, 7
; CHECK-NEXT:    cror 20, 5, 1
; CHECK-NEXT:    bc 12, 20, .LBB1_5
; CHECK-NEXT:  # %bb.3: # %fast
; CHECK-NEXT:    addi 3, 3, -3
; CHECK-NEXT:    std 7, 0(4)
; CHECK-NEXT:    blr
; CHECK-NEXT:  .LBB1_4:
; CHECK-NEXT:    creqv 1, 1, 1
; CHECK-NEXT:    b .LBB1_2
; CHECK-NEXT:  .LBB1_5: # %slow
; CHECK-NEXT:    sub 3, 3, 5
; CHECK-NEXT:    blr
  %size = load i64, ptr %m, align 8
  %s = add i64 %size, 32
  %c1 = icmp ugt i64 %n, %s
  %capp = getelementptr inbounds i8, ptr %m, i64 8
  %cap = load i64, ptr %capp, align 8
  %c2 = icmp ugt i64 %s, %cap
  %or = select i1 %c1, i1 true, i1 %c2, !prof !0
  %c3 = icmp ugt i64 %k, %s
  %or3 = or i1 %c3, %or
  br i1 %or3, label %slow, label %fast, !prof !0

fast:
  store i64 %s, ptr %m, align 8
  %r = add nsw i64 %gas, -3
  ret i64 %r

slow:
  %t = sub i64 %gas, %n
  ret i64 %t
}

!0 = !{!"branch_weights", i32 1, i32 100}
