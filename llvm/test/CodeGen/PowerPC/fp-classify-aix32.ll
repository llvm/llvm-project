; PPC32-PWR8-O0-NEXT:    isel r3, r3, r4, 4*cr5+lt
; PPC32-PWR8-O0-NEXT:    blr
  %result = call i1 @llvm.is.fpclass.f64(double %x, i32 3)
  ret i1 %result
}

