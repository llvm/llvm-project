; PPC32-PWR7-NEXT:    xscmpudp cr0, f1, f1
; PPC32-PWR7-NEXT:    li r3, 1
; PPC32-PWR7-NEXT:    iseleq r3, 0, r3
; PPC32-PWR7-NEXT:    blr
;
; PPC32-PWR8-LABEL: test_isnan_f64:
; PPC32-PWR8:       # %bb.0:
