; PPC32-PWR8-NEXT:    iseleq r3, 0, r3
; PPC32-PWR8-NEXT:    blr
;
; PPC32-PWR7-O0-LABEL: test_isnan_f64:
; PPC32-PWR7-O0:       # %bb.0:
; PPC32-PWR7-O0-NEXT:    xscmpudp cr7, f1, f1
; PPC32-PWR7-O0-NEXT:    mfocrf r3, 1
; PPC32-PWR7-O0-NEXT:    clrlwi r3, r3, 31
