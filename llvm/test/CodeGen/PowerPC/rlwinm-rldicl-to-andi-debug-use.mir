# RUN: llc -mtriple=powerpc64le-unknown-linux-gnu -verify-machineinstrs \
# RUN:   -run-pass=ppc-mi-peepholes -ppc-convert-rr-to-ri %s -o - | FileCheck %s

--- |
  define i64 @rldicl_to_andi(i64 %a, i64 %b) !dbg !3 {
  entry:
    ret i64 %a, !dbg !8
  }

  define i32 @rlwinm_single_nondebug_use(i32 %a) !dbg !10 {
  entry:
    ret i32 %a, !dbg !13
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "debugify", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "rlwinm-rldicl-to-andi-debug-use.mir", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "rldicl_to_andi", linkageName: "rldicl_to_andi", scope: null, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !6)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !{!7}
  !7 = !DILocalVariable(name: "value", scope: !3, file: !1, line: 1, type: !9)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
  !9 = !DIBasicType(name: "i64", size: 64, encoding: DW_ATE_signed)
  !10 = distinct !DISubprogram(name: "rlwinm_single_nondebug_use", linkageName: "rlwinm_single_nondebug_use", scope: null, file: !1, line: 2, type: !4, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !11)
  !11 = !{!12}
  !12 = !DILocalVariable(name: "value", scope: !10, file: !1, line: 2, type: !14)
  !13 = !DILocation(line: 2, column: 1, scope: !10)
  !14 = !DIBasicType(name: "i32", size: 32, encoding: DW_ATE_signed)
...
---
name:            rldicl_to_andi
alignment:       16
tracksRegLiveness: true
registers:
  - { id: 0, class: g8rc_and_g8rc_nox0 }
  - { id: 1, class: g8rc_and_g8rc_nox0 }
  - { id: 2, class: g8rc }
  - { id: 3, class: crrc }
  - { id: 4, class: g8rc }
liveins:
  - { reg: '$x3', virtual-reg: '%0' }
  - { reg: '$x4', virtual-reg: '%1' }
body:             |
  bb.0.entry:
    liveins: $x3, $x4

    ; CHECK-LABEL: name: rldicl_to_andi
    ; CHECK: liveins: $x3, $x4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:g8rc_and_g8rc_nox0 = COPY $x4, debug-location !9
    ; CHECK-NEXT: [[LI8_:%[0-9]+]]:g8rc_and_g8rc_nox0 = LI8 -11, debug-location !9
    ; CHECK-NEXT: [[ANDI8_rec:%[0-9]+]]:g8rc = ANDI8_rec [[LI8_]], 65525, implicit-def $cr0, debug-location !9
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !9
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:crrc = COPY killed $cr0, debug-location !9
    ; CHECK-NEXT: [[ISEL8_:%[0-9]+]]:g8rc = ISEL8 [[LI8_]], [[COPY]], [[COPY1]].sub_eq, debug-location !9
    ; CHECK-NEXT: $x3 = COPY [[ISEL8_]], debug-location !9
    ; CHECK-NEXT: BLR8 implicit $lr8, implicit $rm, implicit $x3, debug-location !9
    %1:g8rc_and_g8rc_nox0 = COPY $x4, debug-location !8
    %0:g8rc_and_g8rc_nox0 = LI8 -11, debug-location !8
    %2:g8rc = RLDICL_rec %0, 2, 49, implicit-def $cr0, debug-location !8
    DBG_VALUE %2, $noreg, !7, !DIExpression(), debug-location !8
    %3:crrc = COPY killed $cr0, debug-location !8
    %4:g8rc = ISEL8 %0, %1, %3.sub_eq, debug-location !8
    $x3 = COPY %4, debug-location !8
    BLR8 implicit $lr8, implicit $rm, implicit $x3, debug-location !8
...
---
name:            rlwinm_single_nondebug_use
tracksRegLiveness: true
registers:
  - { id: 0, class: gprc }
  - { id: 1, class: gprc }
  - { id: 2, class: crrc }
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: rlwinm_single_nondebug_use
    ; CHECK: [[LI:%[0-9]+]]:gprc = LI 4055, debug-location !14
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !12, !DIExpression(), debug-location !14
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:g8rc = IMPLICIT_DEF debug-location !14
    ; CHECK-NEXT: [[INSERT_SUBREG:%[0-9]+]]:g8rc = INSERT_SUBREG [[DEF]], [[LI]], %subreg.sub_32, debug-location !14
    ; CHECK-NEXT: [[ANDI8_rec:%[0-9]+]]:g8rc = ANDI8_rec killed [[INSERT_SUBREG]], 4055, implicit-def $cr0, implicit-def $cr0, debug-location !14
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gprc = COPY killed [[ANDI8_rec]].sub_32, debug-location !14
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:crrc = COPY killed $cr0, debug-location !14
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:g8rc = IMPLICIT_DEF debug-location !14
    ; CHECK-NEXT: $x3 = INSERT_SUBREG [[DEF1]], [[COPY]], %subreg.sub_32, debug-location !14
    ; CHECK-NEXT: BLR8 implicit $lr8, implicit $rm, implicit $x3, debug-location !14
    %0:gprc = LI -11, debug-location !13
    DBG_VALUE %0, $noreg, !12, !DIExpression(), debug-location !13
    %1:gprc = RLWINM_rec %0, 2, 20, 31, implicit-def $cr0, debug-location !13
    %2:crrc = COPY killed $cr0, debug-location !13
    $x3 = EXTSW_32_64 killed %1, debug-location !13
    BLR8 implicit $lr8, implicit $rm, implicit $x3, debug-location !13
...
