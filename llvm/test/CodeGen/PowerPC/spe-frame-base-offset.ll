; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -verify-machineinstrs < %s -mtriple=powerpc-unknown-linux-gnu \
; RUN:     -mattr=+spe -O2 | FileCheck %s

; Regression test for a bug where evldd and evstdd used an offset that does not actually fit
; in the instruction encoding. They have a 5-bit displacement that gets multiplied by 8, so
; the maximum offset they can encode is `31 * 8 = 248`. For anything higher, these instructions
; cannot be used.

declare void @use(ptr)

define void @store(double %x) {
; CHECK-LABEL: store:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mflr 0
; CHECK-NEXT:    stw 0, 4(1)
; CHECK-NEXT:    lis 0, -1
; CHECK-NEXT:    ori 0, 0, 32496
; CHECK-NEXT:    stwux 1, 1, 0
; CHECK-NEXT:    sub 0, 1, 0
; CHECK-NEXT:    .cfi_def_cfa_offset 33040
; CHECK-NEXT:    .cfi_offset lr, 4
; CHECK-NEXT:    evmergelo 3, 3, 4
; CHECK-NEXT:    lis 4, 0
; CHECK-NEXT:    li 5, 0
; CHECK-NEXT:    ori 4, 4, 32776
; CHECK-NEXT:    stbx 5, 1, 4
; CHECK-NEXT:    lis 4, 0
; CHECK-NEXT:    ori 4, 4, 33032
; CHECK-NEXT:    evstddx 3, 1, 4
; CHECK-NEXT:    addi 3, 1, 8
; CHECK-NEXT:    bl use
; CHECK-NEXT:    mr 0, 31
; CHECK-NEXT:    lwz 31, 0(1)
; CHECK-NEXT:    mr 1, 31
; CHECK-NEXT:    mr 31, 0
; CHECK-NEXT:    lwz 0, 4(1)
; CHECK-NEXT:    mtlr 0
; CHECK-NEXT:    blr
  %d = alloca double, align 8
  %a = alloca [256 x i8], align 8
  %big = alloca [32768 x i8], align 8
  store i8 0, ptr %a, align 8
  store double %x, ptr %d, align 8
  call void @use(ptr %big)
  ret void
}

define double @load() {
; CHECK-LABEL: load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mflr 0
; CHECK-NEXT:    stw 0, 4(1)
; CHECK-NEXT:    lis 0, -1
; CHECK-NEXT:    ori 0, 0, 32496
; CHECK-NEXT:    stwux 1, 1, 0
; CHECK-NEXT:    sub 0, 1, 0
; CHECK-NEXT:    .cfi_def_cfa_offset 33040
; CHECK-NEXT:    .cfi_offset lr, 4
; CHECK-NEXT:    lis 4, 0
; CHECK-NEXT:    li 3, 0
; CHECK-NEXT:    ori 4, 4, 32776
; CHECK-NEXT:    stbx 3, 1, 4
; CHECK-NEXT:    addi 3, 1, 8
; CHECK-NEXT:    bl use
; CHECK-NEXT:    lis 3, 0
; CHECK-NEXT:    ori 3, 3, 33032
; CHECK-NEXT:    evlddx 4, 1, 3
; CHECK-NEXT:    mr 0, 31
; CHECK-NEXT:    evmergehi 3, 4, 4
; CHECK-NEXT:    lwz 31, 0(1)
; CHECK-NEXT:    mr 1, 31
; CHECK-NEXT:    mr 31, 0
; CHECK-NEXT:    lwz 0, 4(1)
; CHECK-NEXT:    mtlr 0
; CHECK-NEXT:    blr
  %d = alloca double, align 8
  %a = alloca [256 x i8], align 8
  %big = alloca [32768 x i8], align 8
  store i8 0, ptr %a, align 8
  call void @use(ptr %big)
  %v = load double, ptr %d, align 8
  ret double %v
}
