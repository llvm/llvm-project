; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=powerpc64le-linux-gnu < %s | FileCheck %s

; On a 64-bit target, an integer wider than 64 bits in an "r" or "b" operand
; goes in 64-bit registers, one for each 64 bits of it. 32-bit registers would
; hold only half of it.

define void @test_i128_input(i128 %x) {
; CHECK-LABEL: test_i128_input:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    # 3
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    blr
entry:
  call void asm sideeffect "# $0", "r"(i128 %x)
  ret void
}

define i128 @test_i128_output() {
; CHECK-LABEL: test_i128_output:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    # 3
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    blr
entry:
  %r = call i128 asm sideeffect "# $0", "=r"()
  ret i128 %r
}

; The asm doesn't change its operand, so the function returns its argument.
define i128 @test_i128_tied(i128 %x) {
; CHECK-LABEL: test_i128_tied:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    blr
entry:
  %r = call i128 asm sideeffect "", "=&r,0"(i128 %x)
  ret i128 %r
}

define void @test_i128_input_b(i128 %x) {
; CHECK-LABEL: test_i128_input_b:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    #APP
; CHECK-NEXT:    # 3
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    blr
entry:
  call void asm sideeffect "# $0", "b"(i128 %x)
  ret void
}
