; ---------------------------------------------------------------------------

define void @truncstore_f64_to_f16(double %v, ptr %p) nounwind {
; P8-LABEL: truncstore_f64_to_f16:
; P8:       # %bb.0:
; P8-NEXT:    mflr r0
; P8-NEXT:    std r30, -16(r1) # 8-byte Folded Spill
; P8-NEXT:    stdu r1, -48(r1)
