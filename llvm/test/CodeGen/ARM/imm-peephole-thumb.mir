# RUN: llc -run-pass=peephole-opt %s -o - | FileCheck %s

# CHECK: [[IN:%.*]]:gprnopc = COPY $r0
# CHECK: [[SUM1TMP:%.*]]:rgpr = t2ADDri [[IN]], 25600
# CHECK: [[SUM1:%.*]]:rgpr = t2ADDri [[SUM1TMP]], 133

# CHECK: [[SUM2TMP:%.*]]:rgpr = t2SUBri [[IN]], 25600
# CHECK: [[SUM2:%.*]]:rgpr = t2SUBri [[SUM2TMP]], 133

# CHECK: [[SUM3TMP:%.*]]:rgpr = t2SUBri [[IN]], 25600
# CHECK: [[SUM3:%.*]]:rgpr = t2SUBri [[SUM3TMP]], 133

# CHECK: [[SUM4TMP:%.*]]:rgpr = t2ADDri [[IN]], 25600
# CHECK: [[SUM4:%.*]]:rgpr = t2ADDri [[SUM4TMP]], 133


--- |
  target datalayout = "e-m:o-p:32:32-f64:32:64-v64:32:64-v128:32:128-a:0:32-n32-S32"
  target triple = "thumbv7-apple-ios"

  define i32 @foo(i32 %in) {
    ret i32 undef
  }
...
---
name:            foo
liveins:
  - { reg: '$r0', virtual-reg: '%0' }
body:             |
  bb.0 (%ir-block.0):
    liveins: $r0
    %0:gprnopc = COPY $r0
    %1:rgpr = t2MOVi32imm -25733
    %2:rgpr = t2SUBrr %0, %1, 14, $noreg, $noreg

    %3:rgpr = t2MOVi32imm 25733
    %4:rgpr = t2SUBrr %0, %3, 14, $noreg, $noreg

    %5:rgpr = t2MOVi32imm -25733
    %6:rgpr= t2ADDrr %0, %5, 14, $noreg, $noreg

    %7:rgpr = t2MOVi32imm 25733
    %8:rgpr = t2ADDrr %0, %7, 14, $noreg, $noreg

    $r0 = COPY %8
    tBX_RET 14, $noreg, implicit $r0

...
