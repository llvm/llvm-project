# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -run-pass=machine-outliner -mtriple=thumbv7m-none-eabi %s -o - | FileCheck %s

# A DBG_VALUE of LR must not make LR look used in the block, so the sequence in
# bb.1 is outlined from both functions.

--- |
  define void @lr_debug_value() !dbg !3 { ret void }

  define void @lr_no_debug_value() { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "lr_debug_value", scope: !1, file: !1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
  !4 = !DISubroutineType(types: !{null})
  !5 = !DILocalVariable(name: "ra", scope: !3)
  !6 = !DILocation(line: 0, scope: !3)
...
---
name:            lr_debug_value
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: lr_debug_value
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r7, $lr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   frame-setup tPUSH 14 /* CC::al */, $noreg, killed $r7, killed $lr, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   tCMPi8 renamable $r0, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   t2Bcc %bb.2, 0 /* CC::eq */, killed $cpsr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_VALUE $lr, $noreg, !9, !DIExpression(), debug-location !DILocation(line: 0, scope: !3)
  ; CHECK-NEXT:   tBL 14 /* CC::al */, $noreg, @OUTLINED_FUNCTION_0, implicit-def $lr, implicit $sp, implicit-def $cpsr, implicit-def $lr, implicit-def $r0, implicit-def $r1, implicit $noreg, implicit $sp, implicit $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   frame-destroy tPOP_RET 14 /* CC::al */, $noreg, def $r7, def $pc
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r7, $lr

    frame-setup tPUSH 14, $noreg, killed $r7, killed $lr, implicit-def $sp, implicit $sp
    tCMPi8 renamable $r0, 0, 14, $noreg, implicit-def $cpsr
    t2Bcc %bb.2, 0, killed $cpsr

  bb.1:
    liveins: $r0

    DBG_VALUE $lr, $noreg, !5, !DIExpression(), debug-location !6
    renamable $r0, dead $cpsr = nuw tADDi8 killed renamable $r0, 7, 14, $noreg
    renamable $r0 = t2BICri killed renamable $r0, 7, 14, $noreg, $noreg
    renamable $r0 = t2SUBrr $sp, killed renamable $r0, 14, $noreg, $noreg
    renamable $r1, dead $cpsr = tMOVi8 0, 14, $noreg
    tSTRBi killed renamable $r1, killed renamable $r0, 0, 14, $noreg

  bb.2:
    frame-destroy tPOP_RET 14, $noreg, def $r7, def $pc
...
