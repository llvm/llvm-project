; CHECK-NEXT:    .pad #508
; CHECK-NEXT:    sub sp, #508
; CHECK-NEXT:    .pad #508
; CHECK-NEXT:    sub sp, #508
; CHECK-NEXT:    .pad #8
; CHECK-NEXT:    sub sp, #8
