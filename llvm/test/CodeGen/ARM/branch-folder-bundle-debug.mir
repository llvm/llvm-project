# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -run-pass=branch-folder %s -o - | FileCheck %s

# Two blocks end in the same three instructions and branch to the same block.
# In %bb.1 the IT bundle holds a DBG_VALUE. Tail merging should still find the
# common tail of three instructions (t2CMPri, t2STRi12, BUNDLE) and should make
# the path-specific variable location unavailable in the shared tail. The
# second function checks that identical trailing debug values are preserved.
--- |
  target triple = "thumbv7-unknown-linux-gnueabi"
  define void @same_debug_value(ptr %a, ptr %b, i32 %c) !dbg !9 { ret void }
  define void @f(ptr %a, ptr %b, i32 %c) !dbg !5 { ret void }
  !llvm.module.flags = !{!1}
  !llvm.dbg.cu = !{!2}
  !1 = !{i32 2, !"Debug Info Version", i32 3}
  !2 = distinct !DICompileUnit(language: DW_LANG_C, file: !3, emissionKind: FullDebug)
  !3 = !DIFile(filename: "t.c", directory: "/")
  !4 = !DISubroutineType(types: !{})
  !5 = distinct !DISubprogram(name: "f", scope: !3, file: !3, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !2)
  !6 = !DILocalVariable(name: "x", scope: !5, file: !3, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, scope: !5)
  !9 = distinct !DISubprogram(name: "same_debug_value", scope: !3, file: !3, line: 2, type: !4, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !2)
  !10 = !DILocalVariable(name: "y", scope: !9, file: !3, line: 2, type: !7)
  !11 = !DILocation(line: 2, scope: !9)
  !12 = !DILocalVariable(name: "z", scope: !5, file: !3, line: 1, type: !7)
...
---
name:            same_debug_value
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: same_debug_value
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2CMPri renamable $r2, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   t2Bcc %bb.2, 0 /* CC::eq */, killed $cpsr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2STRi12 renamable $r1, renamable $r0, 4, 14 /* CC::al */, $noreg
  ; CHECK-NEXT:   t2B %bb.3, 14 /* CC::al */, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2STRi12 renamable $r1, renamable $r0, 8, 14 /* CC::al */, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2CMPri renamable $r1, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   t2STRi12 renamable $r0, renamable $r0, 0, 14 /* CC::al */, $noreg
  ; CHECK-NEXT:   BUNDLE implicit-def dead $itstate, implicit-def dead $r2, implicit $r1, implicit killed $cpsr, implicit $r0 {
  ; CHECK-NEXT:     t2IT 1, 4, implicit-def $itstate
  ; CHECK-NEXT:     renamable $r2 = t2LDRi12 renamable $r1, 0, 1 /* CC::ne */, $cpsr, implicit internal $itstate
  ; CHECK-NEXT:     t2STRi12 internal killed renamable $r2, renamable $r0, 0, 1 /* CC::ne */, killed $cpsr, implicit internal killed $itstate
  ; CHECK-NEXT:     DBG_VALUE 0, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 2, scope: !3)
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   tBX_RET 14 /* CC::al */, $noreg, implicit $r0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r0, $r1, $r2

    t2CMPri renamable $r2, 0, 14, $noreg, implicit-def $cpsr
    t2Bcc %bb.2, 0, killed $cpsr

  bb.1:
    successors: %bb.3
    liveins: $r0, $r1

    t2STRi12 renamable $r1, renamable $r0, 4, 14, $noreg
    t2CMPri renamable $r1, 0, 14, $noreg, implicit-def $cpsr
    t2STRi12 renamable $r0, renamable $r0, 0, 14, $noreg
    BUNDLE implicit-def dead $itstate, implicit-def dead $r2, implicit $r1, implicit killed $cpsr, implicit $r0 {
      t2IT 1, 4, implicit-def $itstate
      renamable $r2 = t2LDRi12 renamable $r1, 0, 1, $cpsr, implicit internal $itstate
      t2STRi12 internal killed renamable $r2, renamable $r0, 0, 1, killed $cpsr, implicit internal killed $itstate
      DBG_VALUE 0, $noreg, !10, !DIExpression(), debug-location !11
    }
    t2B %bb.3, 14, $noreg

  bb.2:
    successors: %bb.3
    liveins: $r0, $r1

    t2STRi12 renamable $r1, renamable $r0, 8, 14, $noreg
    t2CMPri renamable $r1, 0, 14, $noreg, implicit-def $cpsr
    t2STRi12 renamable $r0, renamable $r0, 0, 14, $noreg
    BUNDLE implicit-def dead $itstate, implicit-def dead $r2, implicit $r1, implicit killed $cpsr, implicit $r0 {
      t2IT 1, 4, implicit-def $itstate
      renamable $r2 = t2LDRi12 renamable $r1, 0, 1, $cpsr, implicit internal $itstate
      t2STRi12 internal killed renamable $r2, renamable $r0, 0, 1, killed $cpsr, implicit internal killed $itstate
      DBG_VALUE 0, $noreg, !10, !DIExpression(), debug-location !11
    }

  bb.3:
    liveins: $r0

    tBX_RET 14, $noreg, implicit $r0
...
---
name:            f
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: f
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2CMPri renamable $r2, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   t2Bcc %bb.2, 0 /* CC::eq */, killed $cpsr
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2STRi12 renamable $r1, renamable $r0, 4, 14 /* CC::al */, $noreg
  ; CHECK-NEXT:   t2B %bb.3, 14 /* CC::al */, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2STRi12 renamable $r1, renamable $r0, 8, 14 /* CC::al */, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $r0, $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2CMPri renamable $r1, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   t2STRi12 renamable $r0, renamable $r0, 0, 14 /* CC::al */, $noreg
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, scope: !6)
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !9, !DIExpression(), debug-location !DILocation(line: 1, scope: !6)
  ; CHECK-NEXT:   BUNDLE implicit-def dead $itstate, implicit-def dead $r2, implicit $r1, implicit killed $cpsr, implicit $r0 {
  ; CHECK-NEXT:     t2IT 1, 4, implicit-def $itstate
  ; CHECK-NEXT:     renamable $r2 = t2LDRi12 renamable $r1, 0, 1 /* CC::ne */, $cpsr, implicit internal $itstate
  ; CHECK-NEXT:     t2STRi12 internal killed renamable $r2, renamable $r0, 0, 1 /* CC::ne */, killed $cpsr, implicit internal killed $itstate
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   tBX_RET 14 /* CC::al */, $noreg, implicit $r0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r0, $r1, $r2

    t2CMPri renamable $r2, 0, 14, $noreg, implicit-def $cpsr
    t2Bcc %bb.2, 0, killed $cpsr

  bb.1:
    successors: %bb.3
    liveins: $r0, $r1

    t2STRi12 renamable $r1, renamable $r0, 4, 14, $noreg
    t2CMPri renamable $r1, 0, 14, $noreg, implicit-def $cpsr
    t2STRi12 renamable $r0, renamable $r0, 0, 14, $noreg
    BUNDLE implicit-def dead $itstate, implicit-def dead $r2, implicit $r1, implicit killed $cpsr, implicit $r0 {
      t2IT 1, 4, implicit-def $itstate
      renamable $r2 = t2LDRi12 renamable $r1, 0, 1, $cpsr, implicit internal $itstate
      DBG_VALUE 0, $noreg, !6, !DIExpression(), debug-location !8
      DBG_VALUE $r1, $noreg, !12, !DIExpression(), debug-location !8
      t2STRi12 internal killed renamable $r2, renamable $r0, 0, 1, killed $cpsr, implicit internal killed $itstate
    }
    t2B %bb.3, 14, $noreg

  bb.2:
    successors: %bb.3
    liveins: $r0, $r1

    t2STRi12 renamable $r1, renamable $r0, 8, 14, $noreg
    t2CMPri renamable $r1, 0, 14, $noreg, implicit-def $cpsr
    t2STRi12 renamable $r0, renamable $r0, 0, 14, $noreg
    BUNDLE implicit-def dead $itstate, implicit-def dead $r2, implicit $r1, implicit killed $cpsr, implicit $r0 {
      t2IT 1, 4, implicit-def $itstate
      renamable $r2 = t2LDRi12 renamable $r1, 0, 1, $cpsr, implicit internal $itstate
      t2STRi12 internal killed renamable $r2, renamable $r0, 0, 1, killed $cpsr, implicit internal killed $itstate
    }

  bb.3:
    liveins: $r0

    tBX_RET 14, $noreg, implicit $r0
...
