; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=armv7 | FileCheck %s

; Keep the signed comparison at i32 rather than expanding an i64 comparison.
define i64 @select_i32_sgt(ptr %p) {
; CHECK-LABEL: select_i32_sgt:
; CHECK:       @ %bb.0:
; CHECK-NEXT:    ldr r0, [r0]
; CHECK-NEXT:    mov r1, #0
; CHECK-NEXT:    cmp r0, #95
; CHECK-NEXT:    movle r0, #7
; CHECK-NEXT:    bx lr
  %op = load i32, ptr %p, align 4
  %cmp = icmp sgt i32 %op, 95
  %z = zext nneg i32 %op to i64
  %s = select i1 %cmp, i64 %z, i64 7
  ret i64 %s
}
