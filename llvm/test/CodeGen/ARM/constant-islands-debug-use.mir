# RUN: llc -mtriple=thumbv7-unknown-linux -run-pass=arm-cp-islands -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "thumbv7-unknown-linux"

  define void @distinct_registers() !dbg !3 {
    ret void, !dbg !7
  }

  define void @kept_base() !dbg !16 {
    ret void, !dbg !19
  }

  define void @redefined_base() !dbg !11 {
    ret void, !dbg !14
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "debug use test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "constant-islands-debug-use.mir", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "distinct_registers", linkageName: "distinct_registers", scope: null, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !6)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !{!8, !9}
  !7 = !DILocation(line: 1, column: 1, scope: !3)
  !8 = !DILocalVariable(name: "base", scope: !3, file: !1, line: 1, type: !10)
  !9 = !DILocalVariable(name: "entry", scope: !3, file: !1, line: 1, type: !10)
  !10 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !11 = distinct !DISubprogram(name: "redefined_base", linkageName: "redefined_base", scope: null, file: !1, line: 2, type: !4, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !12)
  !12 = !{!13, !15}
  !13 = !DILocalVariable(name: "new_base", scope: !11, file: !1, line: 2, type: !10)
  !14 = !DILocation(line: 2, column: 1, scope: !11)
  !15 = !DILocalVariable(name: "entry", scope: !11, file: !1, line: 2, type: !10)
  !16 = distinct !DISubprogram(name: "kept_base", linkageName: "kept_base", scope: null, file: !1, line: 3, type: !4, scopeLine: 3, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !17)
  !17 = !{!18}
  !18 = !DILocalVariable(name: "entry", scope: !16, file: !1, line: 3, type: !10)
  !19 = !DILocation(line: 3, column: 1, scope: !16)
...
---
name:            distinct_registers
alignment:       2
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  maxAlignment:    1
jumpTable:
  kind:            inline
  entries:
    - id:              0
      blocks:          [ '%bb.1', '%bb.2' ]
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r1

    ; CHECK-LABEL: name: distinct_registers
    ; CHECK-NOT: t2LEApcrelJT
    ; CHECK-NOT: t2ADDrs
    ; CHECK: DBG_VALUE $noreg, $noreg
    ; CHECK-NEXT: DBG_VALUE_LIST {{.*}} $noreg
    ; CHECK-NEXT: t2TBB_JT $pc, killed $r1
    renamable $r2 = t2LEApcrelJT %jump-table.0, 14 /* CC::al */, $noreg
    DBG_VALUE $r2, $noreg, !8, !DIExpression(), debug-location !7
    renamable $r3 = t2ADDrs killed renamable $r2, renamable $r1, 18, 14 /* CC::al */, $noreg, $noreg
    DBG_VALUE_LIST !9, !DIExpression(DW_OP_LLVM_arg, 0), $r3, debug-location !7
    t2BR_JT killed renamable $r3, killed renamable $r1, %jump-table.0

  bb.1:
    tBX_RET 14 /* CC::al */, $noreg

  bb.2:
    tBX_RET 14 /* CC::al */, $noreg
...
---
name:            kept_base
alignment:       2
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  maxAlignment:    1
jumpTable:
  kind:            inline
  entries:
    - id:              0
      blocks:          [ '%bb.1', '%bb.2' ]
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r1

    ; A real use keeps the LEA, so only preserveBaseRegister can remove the
    ; add across the following debug use.
    ; CHECK-LABEL: name: kept_base
    ; CHECK: renamable $r2 = t2LEApcrelJT
    ; CHECK: COPY renamable $r2
    ; CHECK-NOT: t2ADDrs
    ; CHECK: DBG_VALUE $noreg, $noreg, !{{[0-9]+}}
    ; CHECK-NEXT: t2TBB_JT $pc, killed $r1
    renamable $r2 = t2LEApcrelJT %jump-table.0, 14 /* CC::al */, $noreg
    dead renamable $r0 = COPY renamable $r2
    renamable $r3 = t2ADDrs killed renamable $r2, renamable $r1, 18, 14 /* CC::al */, $noreg, $noreg
    DBG_VALUE $r3, $noreg, !18, !DIExpression(), debug-location !19
    t2BR_JT killed renamable $r3, killed renamable $r1, %jump-table.0

  bb.1:
    tBX_RET 14 /* CC::al */, $noreg

  bb.2:
    tBX_RET 14 /* CC::al */, $noreg
...
---
name:            redefined_base
alignment:       2
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  maxAlignment:    1
jumpTable:
  kind:            inline
  entries:
    - id:              0
      blocks:          [ '%bb.1', '%bb.2' ]
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r1

    ; CHECK-LABEL: name: redefined_base
    ; CHECK-NOT: t2LEApcrelJT
    ; CHECK: renamable $r2 = t2MOVi
    ; CHECK-NEXT: DBG_VALUE $r2, $noreg
    ; CHECK-NOT: t2ADDrs
    ; CHECK: DBG_VALUE $noreg, $noreg
    ; CHECK-NEXT: t2TBB_JT $pc, killed $r1
    renamable $r2 = t2LEApcrelJT %jump-table.0, 14 /* CC::al */, $noreg
    renamable $r2 = t2MOVi 0, 14 /* CC::al */, $noreg, $noreg
    DBG_VALUE $r2, $noreg, !13, !DIExpression(), debug-location !14
    renamable $r3 = t2ADDrs killed renamable $r2, renamable $r1, 18, 14 /* CC::al */, $noreg, $noreg
    DBG_VALUE $r3, $noreg, !15, !DIExpression(), debug-location !14
    t2BR_JT killed renamable $r3, killed renamable $r1, %jump-table.0

  bb.1:
    tBX_RET 14 /* CC::al */, $noreg

  bb.2:
    tBX_RET 14 /* CC::al */, $noreg
...
