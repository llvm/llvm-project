; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=armv4t-none-eabi -mattr=+thumb-mode < %s | FileCheck %s

define ptr @test_cmp_sink(ptr %p, ptr %freep, i32 %n) {
; CHECK-LABEL: test_cmp_sink:
; CHECK:       @ %bb.0: @ %entry
; CHECK-NEXT:    cmp r0, #0
; CHECK-NEXT:    beq .LBB0_4
; CHECK-NEXT:  @ %bb.1: @ %loop.preheader
; CHECK-NEXT:    movs r3, r0
; CHECK-NEXT:  .LBB0_2: @ %loop
; CHECK-NEXT:    @ =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movs r2, r3
; CHECK-NEXT:    ldr r3, [r1]
; CHECK-NEXT:    movs r1, r3
; CHECK-NEXT:    cmp r3, r0
; CHECK-NEXT:    bne .LBB0_2
; CHECK-NEXT:  @ %bb.3: @ %exit
; CHECK-NEXT:    movs r0, r2
; CHECK-NEXT:    bx lr
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    movs r0, #0
; CHECK-NEXT:    bx lr
entry:
  %cmp.start = icmp eq ptr %p, null
  br i1 %cmp.start, label %exit, label %loop

loop:
  %prevp = phi ptr [ %p, %entry ], [ %nextp, %loop ]
  %curr = phi ptr [ %freep, %entry ], [ %nextp, %loop ]
  %nextp = load ptr, ptr %curr, align 4
  %cmp = icmp eq ptr %nextp, %p
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi ptr [ null, %entry ], [ %prevp, %loop ]
  ret ptr %res
}
