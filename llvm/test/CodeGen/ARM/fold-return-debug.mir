# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -run-pass arm-ldst-opt %s -o - | FileCheck %s
# RUN: llc -passes=arm-ldst-opt %s -o - | FileCheck %s

--- |
  target triple = "armv7"

  define void @thumb() #0 !dbg !4 {
    ret void
  }

  define void @arm() #1 !dbg !10 {
    ret void
  }

  attributes #0 = { "target-features"="+thumb-mode,+thumb2" }
  attributes #1 = { "target-features"="-thumb-mode" }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "thumb", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !5 = !DISubroutineType(types: !2)
  !6 = !DILocalVariable(name: "v", scope: !4, file: !1, line: 1, type: !9)
  !7 = !DILabel(scope: !4, name: "return", file: !1, line: 1)
  !8 = !DILocation(line: 1, scope: !4)
  !9 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !10 = distinct !DISubprogram(name: "arm", scope: !1, file: !1, line: 2, type: !5, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !11 = !DILocalVariable(name: "v", scope: !10, file: !1, line: 2, type: !9)
  !12 = !DILabel(scope: !10, name: "return", file: !1, line: 2)
  !13 = !DILocation(line: 2, scope: !10)

...
---
name: thumb
tracksRegLiveness: true
debugInstrRef: true
tracksDebugUserValues: true
stack:
  - { id: 0, offset: 0, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $r0, $r1, $r7, $lr

    ; CHECK-LABEL: name: thumb
    ; CHECK: liveins: $r0, $r1, $r7, $lr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = COPY $r1, debug-instr-number 3
    ; CHECK-NEXT: DBG_VALUE $r1, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0), $noreg, debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(3, 0), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: DBG_INSTR_REF !7, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(2, 0), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: DBG_PHI $r1, 4
    ; CHECK-NEXT: DBG_PHI %stack.0, 6, 32
    ; CHECK-NEXT: DBG_LABEL !9, debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: $sp = t2LDMIA_RET $sp, 14 /* CC::al */, $noreg, def $r7, def $pc, implicit $r0, debug-instr-number 1
    $r2 = COPY $r1, debug-instr-number 3
    $sp = t2LDMIA_UPD $sp, 14, $noreg, def $r7, def $lr, debug-instr-number 1
    DBG_VALUE $r1, $noreg, !6, !DIExpression(), debug-location !8
    DBG_VALUE $r7, $noreg, !6, !DIExpression(), debug-location !8
    DBG_VALUE_LIST !6, !DIExpression(DW_OP_LLVM_arg, 0), $sp, debug-location !8
    DBG_INSTR_REF !6, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !8
    DBG_INSTR_REF !6, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(3, 0), debug-location !8
    DBG_PHI $r7, 2
    DBG_INSTR_REF !6, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(2, 0), debug-location !8
    DBG_PHI $r1, 4
    DBG_PHI %stack.0, 6, 32
    DBG_LABEL !7, debug-location !8
    tBX_RET 14, $noreg, implicit $r0, debug-location !8
...
---
name: arm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r4, $lr

    ; CHECK-LABEL: name: arm
    ; CHECK: liveins: $r0, $r1, $r4, $lr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 2, scope: !6)
    ; CHECK-NEXT: DBG_LABEL !9, debug-location !DILocation(line: 2, scope: !6)
    ; CHECK-NEXT: $sp = LDMIA_RET $sp, 14 /* CC::al */, $noreg, def $r4, def $pc, implicit $r0
    $sp = LDMIA_UPD $sp, 14, $noreg, def $r4, def $lr
    DBG_VALUE $r4, $noreg, !11, !DIExpression(), debug-location !13
    DBG_LABEL !12, debug-location !13
    BX_RET 14, $noreg, implicit $r0, debug-location !13
...
