    $r0 = t2MOVi 2, 14, $noreg, $noreg
    $r1 = t2MOVi 2, 14, $noreg, $noreg
    $r2 = t2MOVi 2, 14, $noreg, $noreg
    tBL 14, $noreg, @bar, implicit-def dead $lr, implicit $sp
  bb.4:
    tBX_RET 14, $noreg
...
