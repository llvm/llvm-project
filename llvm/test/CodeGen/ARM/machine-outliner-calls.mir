    BL @bar, implicit-def dead $lr, implicit $sp
    $r0 = MOVi 2, 14, $noreg, $noreg
    $r1 = MOVi 2, 14, $noreg, $noreg
    $r2 = MOVi 2, 14, $noreg, $noreg
    $r3 = MOVi 2, 14, $noreg, $noreg
    $r4 = MOVi 2, 14, $noreg, $noreg
