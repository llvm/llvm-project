# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=armv7 -run-pass=if-converter -verify-machineinstrs %s -o - | FileCheck %s

# bb.2 is live-in on just $s2 (lane 0x10 of $q0). $s2 and the dead $s3 are the
# two halves of $d1, so $d1 is only partly live and must not be marked live.
# If it were, the dead $s3 would look live too: the if-converter would predicate
# the def of $s3 and add an implicit use of the never-defined $s3, which
# -verify-machineinstrs rejects.
#
# Lane masks: $s2 = 0x10, $s3 = 0x20, $d1 = 0x30.

--- |
  define void @partial_tuple_livein(i32 %n, i32 %x) {
    ret void
  }
...
---
name:            partial_tuple_livein
alignment:       4
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: partial_tuple_livein
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $r0, $r1, $s2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   CMPri killed renamable $r0, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   dead renamable $s3 = VMOVSR killed renamable $r1, 0 /* CC::eq */, killed $cpsr
  ; CHECK-NEXT:   $r0 = VMOVRS killed renamable $s2, 14 /* CC::al */, $noreg
  ; CHECK-NEXT:   BX_RET 14 /* CC::al */, $noreg, implicit killed $r0
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r0, $r1, $s2

    CMPri killed renamable $r0, 0, 14, $noreg, implicit-def $cpsr
    Bcc %bb.2, 1, killed $cpsr

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $r1

    renamable $s3 = VMOVSR killed renamable $r1, 14, $noreg

  bb.2:
    liveins: $q0:0x0000000000000010

    $r0 = VMOVRS killed renamable $s2, 14, $noreg
    BX_RET 14, $noreg, implicit killed $r0
...
