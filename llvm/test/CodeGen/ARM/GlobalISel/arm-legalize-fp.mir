    ; SOFT-DEFAULT-THUMB-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $r0
    ; SOFT-DEFAULT-THUMB-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $r1
    ; SOFT-DEFAULT-THUMB-NEXT: ADJCALLSTACKUP 0, -1, 14 /* CC::al */, $noreg, implicit-def $sp, implicit $sp
    ; SOFT-DEFAULT-THUMB-NEXT: [[BITCAST:%[0-9]+]]:_(f32) = G_BITCAST [[COPY1]](i32)
    ; SOFT-DEFAULT-THUMB-NEXT: [[BITCAST1:%[0-9]+]]:_(f32) = G_BITCAST [[COPY2]](i32)
    ; SOFT-DEFAULT-THUMB-NEXT: $r0 = COPY [[BITCAST]](f32)
    ; SOFT-DEFAULT-THUMB-NEXT: $r1 = COPY [[BITCAST1]](f32)
    ; SOFT-DEFAULT-THUMB-NEXT: BX_RET 14 /* CC::al */, $noreg, implicit $r0, implicit $r1
    %0(i32) = COPY $r0
    %1(f64) = G_UITOFP %0(i32)
    %2(f32), %3(f32) = G_UNMERGE_VALUES %1(f64)
    $r0 = COPY %2(f32)
    $r1 = COPY %3(f32)
    BX_RET 14, $noreg, implicit $r0, implicit $r1
...
---
name:            test_fcmp_true_s32
# CHECK-LABEL: name: test_fcmp_true_s32
legalized:       false
# CHECK: legalized: true
regBankSelected: false
selected:        false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
body:             |
  bb.0:
    liveins: $r0, $r1
    ; For soft float we just need to return a '-1' constant, but the truncation
    ; to 1 bit is converted by the combiner to the following masking sequence.

    ; HARD-LABEL: name: test_fcmp_true_s32
    ; HARD: liveins: $r0, $r1
    ; HARD-NEXT: {{  $}}
    ; HARD-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $r0
    ; HARD-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $r1
    ; HARD-NEXT: [[FCMP:%[0-9]+]]:_(i1) = G_FCMP floatpred(true), [[COPY]](f32), [[COPY1]]
    ; HARD-NEXT: [[ZEXT:%[0-9]+]]:_(i32) = G_ZEXT [[FCMP]](i1)
    ; HARD-NEXT: $r0 = COPY [[ZEXT]](i32)
    ; HARD-NEXT: BX_RET 14 /* CC::al */, $noreg, implicit $r0
    ;
    ; SOFT-LABEL: name: test_fcmp_true_s32
    ; SOFT: liveins: $r0, $r1
    ; SOFT-NEXT: {{  $}}
    ; SOFT-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $r0
    ; SOFT-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $r1
    ; SOFT-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; SOFT-NEXT: $r0 = COPY [[C]](i32)
    ; SOFT-NEXT: BX_RET 14 /* CC::al */, $noreg, implicit $r0
    %0(f32) = COPY $r0
    %1(f32) = COPY $r1
    %2(i1) = G_FCMP floatpred(true), %0(f32), %1
    %3(i32) = G_ZEXT %2(i1)
    $r0 = COPY %3(i32)
    BX_RET 14, $noreg, implicit $r0
...
