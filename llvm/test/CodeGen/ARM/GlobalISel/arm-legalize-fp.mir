    %0(f32) = COPY $r0
    %1(f32) = COPY $r1
    %2(f32) = COPY $r2
    %3(f32) = COPY $r3
    %4(f64) = G_MERGE_VALUES %0(f32), %1
    %5(f64) = G_MERGE_VALUES %2(f32), %3
