    ; SOFT-DEFAULT-ARM-NEXT: {{  $}}
    ; SOFT-DEFAULT-ARM-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $r0
    ; SOFT-DEFAULT-ARM-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $r1
    ; SOFT-DEFAULT-ARM-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $r2
    ; SOFT-DEFAULT-ARM-NEXT: [[COPY3:%[0-9]+]]:_(f32) = COPY $r3
    ; SOFT-DEFAULT-ARM-NEXT: ADJCALLSTACKDOWN 0, 0, 14 /* CC::al */, $noreg, implicit-def $sp, implicit $sp
    ; SOFT-DEFAULT-ARM-NEXT: [[BITCAST:%[0-9]+]]:_(i32) = G_BITCAST [[COPY]](f32)
    ; SOFT-DEFAULT-ARM-NEXT: [[BITCAST1:%[0-9]+]]:_(i32) = G_BITCAST [[COPY1]](f32)
    ; SOFT-DEFAULT-ARM-NEXT: [[BITCAST2:%[0-9]+]]:_(i32) = G_BITCAST [[COPY2]](f32)
    ; SOFT-DEFAULT-ARM-NEXT: [[BITCAST3:%[0-9]+]]:_(i32) = G_BITCAST [[COPY3]](f32)
    ; SOFT-DEFAULT-ARM-NEXT: $r0 = COPY [[BITCAST]](i32)
    ; SOFT-DEFAULT-ARM-NEXT: $r1 = COPY [[BITCAST1]](i32)
