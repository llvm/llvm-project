    ; SOFT-AEABI-ARM-NEXT: $r1 = COPY [[BITCAST1]](i32)
    ; SOFT-AEABI-ARM-NEXT: $r2 = COPY [[BITCAST2]](i32)
    ; SOFT-AEABI-ARM-NEXT: $r3 = COPY [[BITCAST3]](i32)
    ; SOFT-AEABI-ARM-NEXT: BL &pow, csr_aapcs, implicit-def $lr, implicit $sp, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit-def $r0, implicit-def $r1
    ; SOFT-AEABI-ARM-NEXT: [[COPY4:%[0-9]+]]:_(i32) = COPY $r0
    ; SOFT-AEABI-ARM-NEXT: [[COPY5:%[0-9]+]]:_(i32) = COPY $r1
