---
name:            test_fpow_double
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
  - { id: 4, class: _ }
  - { id: 5, class: _ }
  - { id: 6, class: _ }
  - { id: 7, class: _ }
  - { id: 8, class: _ }
body:             |
  bb.0:
    liveins: $r0, $r1, $r2, $r3

    ; The inputs may be in the wrong order (depending on the target's
    ; endianness), but that's orthogonal to what we're trying to test here.
    ; For soft float, we only need to check that the first value, received
    ; through R0-R1, ends up in R0-R1 or R1-R0, and the second value, received
    ; through R2-R3, ends up in R2-R3 or R3-R2, when passed to pow.
    ; For hard float, the values need to end up in D0 and D1.
    ; HARD-ARM-LABEL: name: test_fpow_double
    ; HARD-ARM: liveins: $r0, $r1, $r2, $r3
    ; HARD-ARM-NEXT: {{  $}}
    ; HARD-ARM-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $r0
    ; HARD-ARM-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $r1
    ; HARD-ARM-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $r2
    ; HARD-ARM-NEXT: [[COPY3:%[0-9]+]]:_(f32) = COPY $r3
    ; HARD-ARM-NEXT: [[MV:%[0-9]+]]:_(f64) = G_MERGE_VALUES [[COPY]](f32), [[COPY1]](f32)
    ; HARD-ARM-NEXT: [[MV1:%[0-9]+]]:_(f64) = G_MERGE_VALUES [[COPY2]](f32), [[COPY3]](f32)
    ; HARD-ARM-NEXT: ADJCALLSTACKDOWN 0, 0, 14 /* CC::al */, $noreg, implicit-def $sp, implicit $sp
    ; HARD-ARM-NEXT: $d0 = COPY [[MV]](f64)
    ; HARD-ARM-NEXT: $d1 = COPY [[MV1]](f64)
    ; HARD-ARM-NEXT: BL &pow, csr_aapcs, implicit-def $lr, implicit $sp, implicit $d0, implicit $d1, implicit-def $d0
    ; HARD-ARM-NEXT: [[COPY4:%[0-9]+]]:_(f64) = COPY $d0
    ; HARD-ARM-NEXT: ADJCALLSTACKUP 0, -1, 14 /* CC::al */, $noreg, implicit-def $sp, implicit $sp
    ; HARD-ARM-NEXT: [[UV:%[0-9]+]]:_(f32), [[UV1:%[0-9]+]]:_(f32) = G_UNMERGE_VALUES [[COPY4]](f64)
    ; HARD-ARM-NEXT: $r0 = COPY [[UV]](f32)
    ; HARD-ARM-NEXT: $r1 = COPY [[UV1]](f32)
    ; HARD-ARM-NEXT: BX_RET 14 /* CC::al */, $noreg, implicit $r0, implicit $r1
    ;
    ; SOFT-AEABI-ARM-LABEL: name: test_fpow_double
    ; SOFT-AEABI-ARM: liveins: $r0, $r1, $r2, $r3
    ; SOFT-AEABI-ARM-NEXT: {{  $}}
    ; SOFT-AEABI-ARM-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $r0
    ; SOFT-AEABI-ARM-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $r1
    ; SOFT-AEABI-ARM-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $r2
    ; SOFT-AEABI-ARM-NEXT: [[COPY3:%[0-9]+]]:_(f32) = COPY $r3
    ; SOFT-AEABI-ARM-NEXT: ADJCALLSTACKDOWN 0, 0, 14 /* CC::al */, $noreg, implicit-def $sp, implicit $sp
    ; SOFT-AEABI-ARM-NEXT: [[BITCAST:%[0-9]+]]:_(i32) = G_BITCAST [[COPY]](f32)
    ; SOFT-AEABI-ARM-NEXT: [[BITCAST1:%[0-9]+]]:_(i32) = G_BITCAST [[COPY1]](f32)
    ; SOFT-AEABI-ARM-NEXT: [[BITCAST2:%[0-9]+]]:_(i32) = G_BITCAST [[COPY2]](f32)
    ; SOFT-AEABI-ARM-NEXT: [[BITCAST3:%[0-9]+]]:_(i32) = G_BITCAST [[COPY3]](f32)
