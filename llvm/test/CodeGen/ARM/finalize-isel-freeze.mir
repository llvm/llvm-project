# RUN: llc -mtriple=armv7-- -run-pass=finalize-isel -o - %s | FileCheck %s
# RUN: llc -mtriple=armv7-- -passes=finalize-isel -o - %s | FileCheck %s

# VMOVDRR is like a REG_SEQUENCE, so it passes an undefined input through.
---
name: freeze_vmovdrr_undef_input
body: |
  bb.0:
    liveins: $r0

    ; CHECK-LABEL: name: freeze_vmovdrr_undef_input
    ; CHECK: liveins: $r0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:gpr = IMPLICIT_DEF
    ; CHECK-NEXT: [[VMOVDRR:%[0-9]+]]:dpr = VMOVDRR [[COPY]], [[DEF]], 14 /* CC::al */, $noreg
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:dpr = FREEZE [[VMOVDRR]]
    ; CHECK-NEXT: $d0 = COPY [[FREEZE]]
    ; CHECK-NEXT: BX_RET 14 /* CC::al */, $noreg, implicit $d0
    %0:gpr = COPY $r0
    %1:gpr = IMPLICIT_DEF
    %2:dpr = VMOVDRR %0, %1, 14 /* CC::al */, $noreg
    %3:dpr = FREEZE %2
    $d0 = COPY %3
    BX_RET 14 /* CC::al */, $noreg, implicit $d0
...
---
name: freeze_vmovdrr
body: |
  bb.0:
    liveins: $r0, $r1

    ; CHECK-LABEL: name: freeze_vmovdrr
    ; CHECK: liveins: $r0, $r1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $r0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $r1
    ; CHECK-NEXT: [[VMOVDRR:%[0-9]+]]:dpr = VMOVDRR [[COPY]], [[COPY1]], 14 /* CC::al */, $noreg
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:dpr = COPY [[VMOVDRR]]
    ; CHECK-NEXT: $d0 = COPY [[COPY2]]
    ; CHECK-NEXT: BX_RET 14 /* CC::al */, $noreg, implicit $d0
    %0:gpr = COPY $r0
    %1:gpr = COPY $r1
    %2:dpr = VMOVDRR %0, %1, 14 /* CC::al */, $noreg
    %3:dpr = FREEZE %2
    $d0 = COPY %3
    BX_RET 14 /* CC::al */, $noreg, implicit $d0
...
