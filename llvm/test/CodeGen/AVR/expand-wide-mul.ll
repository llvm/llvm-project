; Ensure that wide MUL expansion via forceExpandWideMUL doesn't emit improper
; libcalls when the wide type is legal or the original/narrow type isn't.

define i8 @legal_wide_type(i8 %a, i8 %b) {
; CHECK-LABEL: legal_wide_type:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov r25, r24
; CHECK-NEXT:    lsl r25
; CHECK-NEXT:    sbc r25, r25
; CHECK-NEXT:    mov r23, r22
; CHECK-NEXT:    lsl r23
; CHECK-NEXT:    sbc r23, r23
; CHECK-NEXT:    rcall __mulhi3
; CHECK-NEXT:    mov r23, r24
; CHECK-NEXT:    mov r24, r25
; CHECK-NEXT:    ret
  %r = tail call i8 @llvm.smulh(i8 %a, i8 %b)
  ret i8 %r
}

