; CHECK-NEXT:    mov r11, r19
; CHECK-NEXT:    mov r20, r24
; CHECK-NEXT:    mov r21, r25
; CHECK-NEXT:    mov r18, r22
; CHECK-NEXT:    mov r19, r23
; CHECK-NEXT:    ldi r22, 0
