# RUN: llc -O0 -run-pass=avr-expand-pseudo -verify-machineinstrs %s -o - \
# RUN:     | FileCheck %s
# RUN: llc -O0 -run-pass=avr-expand-pseudo -verify-machineinstrs -mattr=avrtiny %s -o - \
# RUN:     | FileCheck %s --check-prefix=CHECK-TINY

--- |
  target triple = "avr--"
  define void @test() {
  entry:
    ret void
  }
...

---
name:            test
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $r31r30

    ; CHECK-LABEL: test

    ; CHECK:           $r24 = LDDRdPtrQ $r29r28, 0
    ; CHECK-TINY:      $r24 = LDRdPtr $r29r28
    $r24 = LDDRdPtrQ $r29r28, 0

    ; CHECK-NEXT:      $r25 = LDDRdPtrQ $r31r30, 9
    ; CHECK-TINY-NEXT: $r30 = SUBIRdK killed $r30, 247, implicit-def $sreg
    ; CHECK-TINY-NEXT: $r31 = SBCIRdK killed $r31, 255, implicit-def $sreg, implicit killed $sreg
    ; CHECK-TINY-NEXT: $r25 = LDRdPtr $r31r30
    ; CHECK-TINY-NEXT: $r30 = SUBIRdK killed $r30, 9, implicit-def $sreg
    ; CHECK-TINY-NEXT: $r31 = SBCIRdK killed $r31, 0, implicit-def $sreg, implicit killed $sreg
    $r25 = LDDRdPtrQ $r31r30, 9

    ; CHECK-NEXT:      $r30 = LDDRdPtrQ killed $r31r30, 9
    ; CHECK-TINY-NEXT: $r30 = SUBIRdK killed $r30, 247, implicit-def $sreg
    ; CHECK-TINY-NEXT: $r31 = SBCIRdK killed $r31, 255, implicit-def $sreg, implicit killed $sreg
    ; CHECK-TINY-NEXT: $r30 = LDRdPtr killed $r31r30
    ; CHECK-TINY-NOT:  SUBIRdK
    $r30 = LDDRdPtrQ killed $r31r30, 9
...
