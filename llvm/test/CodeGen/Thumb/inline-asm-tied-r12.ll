; CHECK-NEXT:    mov r12, r0
; CHECK-NEXT:    @APP
; CHECK-NEXT:    @NO_APP
; CHECK-NEXT:    mov r5, r12
; CHECK-NEXT:    mov r0, r4
; CHECK-NEXT:    bl g
; CHECK-NEXT:    adds r0, r5, r4
; CHECK-NEXT:    pop {r4, r5, r7, pc}
  %y = add i32 %x, 1
  %r = call i32 asm sideeffect "", "={r12},0"(i32 %y)
  call void @g(i32 %a, i32 %b, i32 %c, i32 %d)
