    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 0, scope: !6)
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !8, !DIExpression(), debug-location !DILocation(line: 0, scope: !6)
