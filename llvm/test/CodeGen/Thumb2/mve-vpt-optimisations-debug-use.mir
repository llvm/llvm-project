tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q0

    ; CHECK-LABEL: name: reuse_debug_use
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:mqpr = COPY $q0
    ; CHECK-NEXT: [[t2MOVi:%[0-9]+]]:rgpr = t2MOVi 0, 14 /* CC::al */, $noreg, $noreg
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vccr = COPY [[t2MOVi]]
    ; CHECK-NEXT: [[MVE_VORR:%[0-9]+]]:mqpr = MVE_VORR [[COPY]], [[COPY]], 1, [[COPY1]], $noreg, [[COPY]]
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 0, scope: !3)
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !8, !DIExpression(), debug-location !DILocation(line: 0, scope: !3)
    ; CHECK-NEXT: [[MVE_VORR1:%[0-9]+]]:mqpr = MVE_VORR [[MVE_VORR]], [[MVE_VORR]], 1, [[COPY1]], $noreg, [[MVE_VORR]]
    ; CHECK-NEXT: $q0 = COPY [[MVE_VORR1]]
    ; CHECK-NEXT: tBX_RET 14 /* CC::al */, $noreg, implicit $q0
    %0:mqpr = COPY $q0
    %1:rgpr = t2MOVi 0, 14 /* CC::al */, $noreg, $noreg
    %2:vccr = COPY %1
    %3:mqpr = MVE_VORR %0, %0, 1, %2, $noreg, %0
    %4:rgpr = t2MOVi 0, 14 /* CC::al */, $noreg, $noreg
    DBG_VALUE %4, $noreg, !5, !DIExpression(), debug-location !7
    %5:vccr = COPY %4
    DBG_VALUE %5, $noreg, !6, !DIExpression(), debug-location !7
    %6:mqpr = MVE_VORR %3, %3, 1, %5, $noreg, %3
    $q0 = COPY %6
    tBX_RET 14 /* CC::al */, $noreg, implicit $q0
