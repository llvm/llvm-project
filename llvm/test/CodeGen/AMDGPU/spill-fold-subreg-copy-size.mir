# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -mattr=+real-true16 --stress-regalloc=2 -start-before=greedy -stop-after=virt-reg-rewriter -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s

# Folding a spill into a sub-register copy turns it into a spill of the copy
# source, written to the part of the slot the copy defines. The source has to
# be the width of that part, and there has to be a spill of that width. A
# 16-bit SGPR has neither a spill opcode nor a part of its own in the slot, so
# the copy below is left alone and %0 is spilled as a whole dword.

---
name:            spill_fold_sub_dword_copy
tracksRegLiveness: true
body:             |
  bb.0:
    ; GCN-LABEL: name: spill_fold_sub_dword_copy
    ; GCN: renamable $sgpr0_lo16 = IMPLICIT_DEF
    ; GCN-NEXT: renamable $sgpr0_lo16 = KILL killed renamable $sgpr0_lo16, implicit-def $sgpr0
    ; GCN-NEXT: SI_SPILL_S32_SAVE killed renamable $sgpr0, %stack.0, 0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; GCN-NEXT: renamable $sgpr0 = S_MOV_B32 2
    ; GCN-NEXT: renamable $sgpr0 = S_ADD_I32 killed renamable $sgpr0, 1, implicit-def dead $scc
    ; GCN-NEXT: renamable $sgpr1 = S_ADD_I32 renamable $sgpr0, 1, implicit-def dead $scc
    ; GCN-NEXT: SI_SPILL_S32_SAVE killed renamable $sgpr1, %stack.1, 0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.1, addrspace 5)
    ; GCN-NEXT: renamable $sgpr1 = S_MOV_B32 2
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr1
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; GCN-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.1, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.1, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; GCN-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; GCN-NEXT: S_ENDPGM 0
    %1:sgpr_lo16 = IMPLICIT_DEF
    undef %0.lo16:sreg_32 = COPY %1
    %2:sreg_32 = S_MOV_B32 2
    %3:sreg_32 = S_ADD_I32 %2, 1, implicit-def dead $scc
    %4:sreg_32 = S_ADD_I32 %3, 1, implicit-def dead $scc
    S_NOP 0, implicit %2
    S_NOP 0, implicit %3
    S_NOP 0, implicit %4
    S_NOP 0, implicit %0
    S_ENDPGM 0
...
