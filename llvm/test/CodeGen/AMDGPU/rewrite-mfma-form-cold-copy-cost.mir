# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# Two chains. Chain A runs at entry frequency and needs no bridge copy, so it
# pays for itself. Chain B sits in a block that runs half as often and its
# accumulator cannot be recolored, so converting it buys no extra pressure
# relief and costs one bridge copy. Scaled by that frequency the copy costs 4
# rather than 9 -- still enough to make the two-chain prefix worse than chain A
# alone, so only chain A is converted.
#
# Charging the copy BlockFreq / EntryFreq instead rounds it down to zero, which
# ties the two prefixes and lets the AGPR-utilization tiebreak convert both.

--- |
  define amdgpu_kernel void @cold_bridge_copies() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            cold_bridge_copies
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: cold_bridge_copies
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %m0:vreg_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %m1:vreg_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %initA:areg_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p7:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   SCHED_BARRIER 0
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a0:areg_128_align2 = V_MFMA_F32_16X16X32_F16_e64 %m0, %m1, %initA, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %a1:areg_128_align2 = V_MFMA_F32_16X16X32_F16_e64 %m0, %m1, %a0, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.3, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   undef %accB.sub0:vreg_128_align2 = V_ADD_U32_e32 [[DEF]], [[DEF]], implicit $exec
  ; CHECK-NEXT:   %b0:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %m0, %m1, %accB, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit %b0
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   KILL [[DEF1]], %p1, %p2, %p3, %p4, %p5, %p6, %p7
  ; CHECK-NEXT:   S_ENDPGM 0, implicit %a1
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %p7:vreg_1024 = IMPLICIT_DEF
    %m0:vreg_128_align2 = IMPLICIT_DEF
    %m1:vreg_128_align2 = IMPLICIT_DEF
    %initA:vreg_128_align2 = IMPLICIT_DEF
    %e0:vgpr_32 = IMPLICIT_DEF
    SCHED_BARRIER 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)

    %a0:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %m0, %m1, %initA, 0, 0, 0, implicit $mode, implicit $exec
    %a1:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %m0, %m1, %a0, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.3, implicit undef $scc
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.3(0x80000000)

    ; A VGPR-only partial def keeps %accB out of the AGPR bank, so chain B's
    ; src2 has to be bridged rather than recolored.
    undef %accB.sub0:vreg_128_align2 = V_ADD_U32_e32 %e0, %e0, implicit $exec
    %b0:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %m0, %m1, %accB, 0, 0, 0, implicit $mode, implicit $exec
    S_NOP 0, implicit %b0
    S_BRANCH %bb.3

  bb.3:
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7
    S_ENDPGM 0, implicit %a1
...
