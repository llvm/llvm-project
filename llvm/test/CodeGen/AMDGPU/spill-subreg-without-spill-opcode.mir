# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.00-amd-amdhsa -mattr=+real-true16 --stress-regalloc=2 -start-before=greedy -stop-after=virt-reg-rewriter -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s

# Only the lanes a value is defined in are spilled, as the sub-registers
# covering them. Those are picked by lane mask alone, so they can come out as
# sub-registers the target has no spill for: an SGPR is spilled a whole number
# of dwords at a time, and there is no spill of the 16 bit lo16 sub-register
# %0 is defined in below. The whole register is spilled instead.

---
name:            spill_subreg_without_spill_opcode
tracksRegLiveness: true
body:             |
  bb.0:
    ; GCN-LABEL: name: spill_subreg_without_spill_opcode
    ; GCN: renamable $sgpr0_lo16 = IMPLICIT_DEF
    ; GCN-NEXT: renamable $sgpr2_lo16 = COPY renamable $sgpr0_lo16
    ; GCN-NEXT: SI_SPILL_S64_SAVE renamable $sgpr2_sgpr3, %stack.0, 0, implicit $exec, implicit $sp_reg :: (store (s64) into %stack.0, align 4, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0_lo16
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = S_MOV_B64 2
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = S_ADD_U64 killed renamable $sgpr0_sgpr1, 1
    ; GCN-NEXT: SI_SPILL_S64_SAVE renamable $sgpr0_sgpr1, %stack.2, 0, implicit $exec, implicit $sp_reg :: (store (s64) into %stack.2, align 4, addrspace 5)
    ; GCN-NEXT: renamable $sgpr2_sgpr3 = S_ADD_U64 killed renamable $sgpr0_sgpr1, 1
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = S_ADD_U64 renamable $sgpr2_sgpr3, 1
    ; GCN-NEXT: SI_SPILL_S64_SAVE killed renamable $sgpr0_sgpr1, %stack.1, 0, implicit $exec, implicit $sp_reg :: (store (s64) into %stack.1, align 4, addrspace 5)
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = S_MOV_B64 2
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0_sgpr1
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = SI_SPILL_S64_RESTORE %stack.2, implicit $exec, implicit $sp_reg :: (load (s64) from %stack.2, align 4, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0_sgpr1
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr2_sgpr3
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = SI_SPILL_S64_RESTORE %stack.1, implicit $exec, implicit $sp_reg :: (load (s64) from %stack.1, align 4, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0_sgpr1
    ; GCN-NEXT: renamable $sgpr0_sgpr1 = SI_SPILL_S64_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s64) from %stack.0, align 4, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0_sgpr1
    ; GCN-NEXT: S_ENDPGM 0
    %20:sgpr_lo16 = IMPLICIT_DEF
    undef %0.lo16:sreg_64 = COPY %20
    S_NOP 0, implicit %20
    %10:sreg_64 = S_MOV_B64 2
    %11:sreg_64 = S_ADD_U64 %10, 1
    %12:sreg_64 = S_ADD_U64 %11, 1
    %13:sreg_64 = S_ADD_U64 %12, 1
    S_NOP 0, implicit %10
    S_NOP 0, implicit %11
    S_NOP 0, implicit %12
    S_NOP 0, implicit %13
    S_NOP 0, implicit %0
    S_ENDPGM 0
...
