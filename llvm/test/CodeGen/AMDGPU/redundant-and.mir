    ; GFX8-NEXT: %mask:sreg_32 = S_MOV_B32 65534
    ; GFX8-NEXT: %and:vgpr_32 = V_AND_B32_e64 %mask, %op, implicit $exec
    ; GFX8-NEXT: $vgpr0 = COPY %and
    ;
    ; GFX9-LABEL: name: wrong_mask_value
