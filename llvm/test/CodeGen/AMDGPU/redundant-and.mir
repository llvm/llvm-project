    ; GFX10-NEXT: %and:vgpr_32 = V_AND_B32_e64 65534, %op, implicit $exec
    ; GFX10-NEXT: $vgpr0 = COPY %and
    %0:vgpr_32 = COPY $vgpr0
    %op:vgpr_32 = nofpexcept V_CVT_F16_F32_e64 0, killed %0, 0, 0, implicit $mode, implicit $exec
