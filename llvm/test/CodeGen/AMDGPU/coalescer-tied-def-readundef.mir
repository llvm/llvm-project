# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -start-before=register-coalescer -stop-after=regallocfast,0 -sgpr-regalloc=fast -enable-misched=false -o - %s | FileCheck %s

# Coalescing a tied operand into a subregister must not mark the tied def
# read-undef when its tied use reads a defined value.
#

---
name: tied_fmac_subreg_coalesce
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5

    ; The tied FMAC defs must NOT be read-undef (no "undef" prefix). Anchor to the
    ; start of the line content so a stray leading "undef " fails the match.
    ; CHECK-LABEL: name: tied_fmac_subreg_coalesce
    ; CHECK: liveins: $sgpr4_sgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM killed renamable $sgpr4_sgpr5, 0, 0 :: (dereferenceable invariant load (s64), align 16, addrspace 4)
    ; CHECK-NEXT: renamable $sgpr0 = nofpexcept S_FMAC_F32 0, 0, renamable $sgpr0, implicit $mode
    ; CHECK-NEXT: renamable $sgpr0 = nofpexcept S_FMAC_F32 0, 0, renamable $sgpr0, implicit $mode
    ; CHECK-NEXT: undef [[COPY:%[0-9]+]].sub0:vreg_128 = COPY renamable $sgpr0, implicit killed $sgpr0_sgpr1
    ; CHECK-NEXT: [[COPY:%[0-9]+]].sub1:vreg_128 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: DS_WRITE_B128_gfx9 [[COPY]].sub1, [[COPY]], 0, 0, implicit $exec :: (store (s128) into `ptr addrspace(3) null`, addrspace 3)
    ; CHECK-NEXT: S_ENDPGM 0
    %3:sgpr_64 = COPY killed $sgpr4_sgpr5
    %5:sreg_64_xexec = S_LOAD_DWORDX2_IMM killed %3, 0, 0 :: (dereferenceable invariant load (s64), align 16, addrspace 4)
    %8:sgpr_32 = COPY killed %5.sub0
    %8:sgpr_32 = nofpexcept S_FMAC_F32 0, 0, %8, implicit $mode
    %9:sgpr_32 = COPY killed %8
    %9:sgpr_32 = nofpexcept S_FMAC_F32 0, 0, %9, implicit $mode
    %14:vgpr_32 = COPY killed %9
    %15:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    undef %13.sub0:vreg_128 = COPY killed %14
    %13.sub1:vreg_128 = COPY %15
    %13.sub2:vreg_128 = COPY %15
    %13.sub3:vreg_128 = COPY %15
    DS_WRITE_B128_gfx9 killed %15, killed %13, 0, 0, implicit $exec :: (store (s128) into `ptr addrspace(3) null`, addrspace 3)
    S_ENDPGM 0
...
