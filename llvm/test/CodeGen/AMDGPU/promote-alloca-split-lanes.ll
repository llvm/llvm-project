; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -mtriple=amdgpu7.00-amd-amdhsa -passes=amdgpu-promote-alloca-to-vector < %s | FileCheck %s

; Vector promotion merges the alloca at control-flow joins with vector phis.
; If the vector is only accessed element by element at constant indices, each
; element gets its own phi instead.

%complex = type { float, float }

define amdgpu_kernel void @split_constant_indices(ptr addrspace(1) %out, i1 %c, float %a, float %b) {
; CHECK-LABEL: define amdgpu_kernel void @split_constant_indices(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], i1 [[C:%.*]], float [[A:%.*]], float [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[PROMOTEALLOCA_0:%.*]] = phi float [ [[B]], %[[THEN]] ], [ [[A]], %[[ENTRY]] ]
; CHECK-NEXT:    [[PROMOTEALLOCA_3:%.*]] = phi float [ [[A]], %[[THEN]] ], [ [[B]], %[[ENTRY]] ]
; CHECK-NEXT:    [[SUM:%.*]] = fadd float [[PROMOTEALLOCA_0]], [[PROMOTEALLOCA_3]]
; CHECK-NEXT:    store float [[SUM]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %alloca = alloca [2 x %complex], align 8, addrspace(5)
  %p0x = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 0, i32 0
  %p0y = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 0, i32 1
  %p1x = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 1, i32 0
  %p1y = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 1, i32 1
  store float %a, ptr addrspace(5) %p0x, align 8
  store float %b, ptr addrspace(5) %p0y, align 4
  store float %a, ptr addrspace(5) %p1x, align 8
  store float %b, ptr addrspace(5) %p1y, align 4
  br i1 %c, label %then, label %join

then:
  store float %b, ptr addrspace(5) %p0x, align 8
  store float %a, ptr addrspace(5) %p1y, align 4
  br label %join

join:
  %x = load float, ptr addrspace(5) %p0x, align 8
  %y = load float, ptr addrspace(5) %p1y, align 4
  %sum = fadd float %x, %y
  store float %sum, ptr addrspace(1) %out, align 4
  ret void
}

; A dynamic index needs the vector.
define amdgpu_kernel void @keep_dynamic_index(ptr addrspace(1) %out, i1 %c, float %a, float %b, i32 %idx) {
; CHECK-LABEL: define amdgpu_kernel void @keep_dynamic_index(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], i1 [[C:%.*]], float [[A:%.*]], float [[B:%.*]], i32 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ALLOCA:%.*]] = freeze <4 x float> poison
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <4 x float> [[ALLOCA]], float [[A]], i32 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x float> [[TMP0]], float [[B]], i32 1
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <4 x float> [[TMP1]], float [[A]], i32 2
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <4 x float> [[TMP2]], float [[B]], i32 3
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <4 x float> [[TMP3]], float [[B]], i32 0
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[PROMOTEALLOCA:%.*]] = phi <4 x float> [ [[TMP4]], %[[THEN]] ], [ [[TMP3]], %[[ENTRY]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = mul i32 [[IDX]], 2
; CHECK-NEXT:    [[TMP6:%.*]] = extractelement <4 x float> [[PROMOTEALLOCA]], i32 [[TMP5]]
; CHECK-NEXT:    store float [[TMP6]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %alloca = alloca [2 x %complex], align 8, addrspace(5)
  %p0x = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 0, i32 0
  %p0y = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 0, i32 1
  %p1x = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 1, i32 0
  %p1y = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 1, i32 1
  store float %a, ptr addrspace(5) %p0x, align 8
  store float %b, ptr addrspace(5) %p0y, align 4
  store float %a, ptr addrspace(5) %p1x, align 8
  store float %b, ptr addrspace(5) %p1y, align 4
  br i1 %c, label %then, label %join

then:
  store float %b, ptr addrspace(5) %p0x, align 8
  br label %join

join:
  %pi = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 %idx, i32 0
  %x = load float, ptr addrspace(5) %pi, align 8
  store float %x, ptr addrspace(1) %out, align 4
  ret void
}

; A load of the whole alloca needs the vector.
define amdgpu_kernel void @keep_whole_vector_load(ptr addrspace(1) %out, i1 %c, float %a, float %b) {
; CHECK-LABEL: define amdgpu_kernel void @keep_whole_vector_load(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], i1 [[C:%.*]], float [[A:%.*]], float [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ALLOCA:%.*]] = freeze <4 x float> poison
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <4 x float> [[ALLOCA]], float [[A]], i32 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x float> [[TMP0]], float [[B]], i32 1
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <4 x float> [[TMP1]], float [[A]], i32 2
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <4 x float> [[TMP2]], float [[B]], i32 3
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <4 x float> [[TMP3]], float [[B]], i32 0
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[PROMOTEALLOCA:%.*]] = phi <4 x float> [ [[TMP4]], %[[THEN]] ], [ [[TMP3]], %[[ENTRY]] ]
; CHECK-NEXT:    store <4 x float> [[PROMOTEALLOCA]], ptr addrspace(1) [[OUT]], align 16
; CHECK-NEXT:    ret void
;
entry:
  %alloca = alloca [2 x %complex], align 16, addrspace(5)
  %p0x = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 0, i32 0
  %p0y = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 0, i32 1
  %p1x = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 1, i32 0
  %p1y = getelementptr inbounds [2 x %complex], ptr addrspace(5) %alloca, i32 0, i32 1, i32 1
  store float %a, ptr addrspace(5) %p0x, align 16
  store float %b, ptr addrspace(5) %p0y, align 4
  store float %a, ptr addrspace(5) %p1x, align 8
  store float %b, ptr addrspace(5) %p1y, align 4
  br i1 %c, label %then, label %join

then:
  store float %b, ptr addrspace(5) %p0x, align 16
  br label %join

join:
  %v = load <4 x float>, ptr addrspace(5) %alloca, align 16
  store <4 x float> %v, ptr addrspace(1) %out, align 16
  ret void
}
