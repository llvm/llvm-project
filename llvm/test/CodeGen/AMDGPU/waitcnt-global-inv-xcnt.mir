# RUN: llc -mtriple=amdgpu12.50-amd-amdhsa -run-pass si-insert-waitcnts -verify-machineinstrs -o - %s | FileCheck -check-prefix=GFX1250 %s

# s_wait_xcnt on gfx12.5 (XNACK on) when $exec, or the address of an earlier
# s_load/global_load, is redefined after GLOBAL_INV, GLOBAL_WB or GLOBAL_WBINV.

---
name: global_inv_then_exec_def
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; GFX1250-LABEL: name: global_inv_then_exec_def
    ; GFX1250: liveins: $sgpr0_sgpr1
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: S_SETREG_IMM32_B32 1, 1601, implicit-def $mode, implicit $mode
    ; GFX1250-NEXT: $sgpr64_sgpr65 = S_MOV_B64 0
    ; GFX1250-NEXT: V_NOP_e32 implicit $exec
    ; GFX1250-NEXT: GLOBAL_PREFETCH_B8_SADDR $sgpr64_sgpr65, undef $vgpr0, 0, 8, implicit $exec
    ; GFX1250-NEXT: GLOBAL_INV 16, implicit $exec
    ; GFX1250-NEXT: S_WAIT_XCNT 0
    ; GFX1250-NEXT: $exec = S_MOV_B64 $sgpr0_sgpr1
    GLOBAL_INV 16, implicit $exec
    $exec = S_MOV_B64 $sgpr0_sgpr1
...

