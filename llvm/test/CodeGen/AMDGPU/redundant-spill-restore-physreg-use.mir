# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# Explicit verification is required here to catch stale live ranges after
# forwarded copies have been erased.
# RUN: llc -mtriple=amdgpu7.00-amd-amdhsa \
# RUN:   -passes='greedy<vgpr>,virt-reg-rewriter' -verify-each -o - %s \
# RUN:   | FileCheck %s

# The restores read $sgpr32, which is not reserved here. The forwarded copies
# don't, so its live range must no longer end at the restores.
--- |
  define void @adjacent() { ret void }
  define void @gap() { ret void }
...
---
name: adjacent
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
body: |
  bb.0:
    liveins: $vgpr0, $sgpr32
    ; CHECK-LABEL: name: adjacent
    ; CHECK: liveins: $sgpr32, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SI_SPILL_V32_SAVE $vgpr0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    SI_SPILL_V32_SAVE %0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    %1:vgpr_32 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    $vgpr0 = COPY %1
    SI_RETURN implicit $vgpr0
...
---
name: gap
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
body: |
  bb.0:
    liveins: $vgpr0, $sgpr32
    ; CHECK-LABEL: name: gap
    ; CHECK: liveins: $sgpr32, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SI_SPILL_V32_SAVE $vgpr0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: S_NOP 0
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    SI_SPILL_V32_SAVE %0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    S_NOP 0
    %1:vgpr_32 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    $vgpr0 = COPY %1
    SI_RETURN implicit $vgpr0
...
