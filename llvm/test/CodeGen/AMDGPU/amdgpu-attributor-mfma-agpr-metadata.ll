; A function whose MFMAs are untagged needs no AGPRs. One with an MFMA tagged
; !amdgpu.mfma !{!"agpr"} gets no amdgpu-agpr-alloc limit, since the number of
; AGPRs it needs depends on how many tagged results are live at once. Neither
; does a function that calls it. A value other than "agpr" is not a hint.

define <4 x float> @untagged(<8 x half> %a, <8 x half> %b, <4 x float> %c) {
; CHECK-LABEL: define <4 x float> @untagged(
; CHECK-SAME: <8 x half> [[A:%.*]], <8 x half> [[B:%.*]], <4 x float> [[C:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[D:%.*]] = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> [[A]], <8 x half> [[B]], <4 x float> [[C]], i32 0, i32 0, i32 0)
; CHECK-NEXT:    ret <4 x float> [[D]]
;
  %d = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %a, <8 x half> %b, <4 x float> %c, i32 0, i32 0, i32 0)
  ret <4 x float> %d
}

define <4 x float> @tagged(<8 x half> %a, <8 x half> %b, <4 x float> %c) {
; CHECK-LABEL: define <4 x float> @tagged(
; CHECK-SAME: <8 x half> [[A:%.*]], <8 x half> [[B:%.*]], <4 x float> [[C:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[D:%.*]] = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> [[A]], <8 x half> [[B]], <4 x float> [[C]], i32 0, i32 0, i32 0), !amdgpu.mfma [[META0:![0-9]+]]
; CHECK-NEXT:    ret <4 x float> [[D]]
;
  %d = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %a, <8 x half> %b, <4 x float> %c, i32 0, i32 0, i32 0), !amdgpu.mfma !0
  ret <4 x float> %d
}

define amdgpu_kernel void @calls_tagged(ptr addrspace(1) %p, <8 x half> %a, <8 x half> %b) {
; CHECK-LABEL: define amdgpu_kernel void @calls_tagged(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], <8 x half> [[A:%.*]], <8 x half> [[B:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:    [[C:%.*]] = load <4 x float>, ptr addrspace(1) [[P]], align 16
; CHECK-NEXT:    [[D:%.*]] = call <4 x float> @tagged(<8 x half> [[A]], <8 x half> [[B]], <4 x float> [[C]])
; CHECK-NEXT:    store <4 x float> [[D]], ptr addrspace(1) [[P]], align 16
; CHECK-NEXT:    ret void
;
  %c = load <4 x float>, ptr addrspace(1) %p
  %d = call <4 x float> @tagged(<8 x half> %a, <8 x half> %b, <4 x float> %c)
  store <4 x float> %d, ptr addrspace(1) %p
  ret void
}

