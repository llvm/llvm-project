  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %idx = zext i32 %tid to i64
  %gep.a = getelementptr <2 x float>, ptr addrspace(1) %in, i64 %idx
  %a = load <2 x float>, ptr addrspace(1) %gep.a
  %r = call <2 x float> @llvm.fma.v2f32(<2 x float> %a, <2 x float> %s, <2 x float> <float 1.000000e+00, float 1.000000e+00>)
  %gep.out = getelementptr <2 x float>, ptr addrspace(1) %out, i64 %idx
  store <2 x float> %r, ptr addrspace(1) %gep.out
  ret void
