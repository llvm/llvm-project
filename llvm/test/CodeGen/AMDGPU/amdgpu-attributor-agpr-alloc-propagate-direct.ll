; RUN: opt -S -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -passes=amdgpu-attributor %s | FileCheck %s

; AAAMDGPUMinAGPRAlloc propagates the AGPR/VGPR split *down* the call graph as
; well as up. When every edge is known, the whole reachable tree converges on a
; single split value so caller and callees agree on one accum_offset.

; A leaf that forces ~64 AGPRs by clobbering a63.
define internal void @leaf_agpr() {
; CHECK-LABEL: define internal void @leaf_agpr(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    call void asm sideeffect "
; CHECK-NEXT:    ret void
;
  call void asm sideeffect "; touch a63", "~{a63}"()
  ret void
}

; An all-VGPR leaf with no AGPR references of its own. It must be pulled to the
; caller's split (64) via downward propagation rather than staying at 0, which
; would leave the register allocator free to grab the entire VGPR file and break
; the split the kernel was compiled with.
define internal void @leaf_hivgpr(ptr %p) {
; CHECK-LABEL: define internal void @leaf_hivgpr(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[V:%.*]] = load volatile <128 x i32>, ptr [[P]], align 512
; CHECK-NEXT:    store volatile <128 x i32> [[V]], ptr [[P]], align 512
; CHECK-NEXT:    ret void
;
  %v = load volatile <128 x i32>, ptr %p
  store volatile <128 x i32> %v, ptr %p
  ret void
}

; Kernel that directly calls both leaves. Pin occupancy to 1024 threads.
define amdgpu_kernel void @k_direct(ptr %p) #0 {
; CHECK-LABEL: define amdgpu_kernel void @k_direct(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    call void @leaf_agpr()
; CHECK-NEXT:    call void @leaf_hivgpr(ptr [[P]])
; CHECK-NEXT:    ret void
;
  call void @leaf_agpr()
  call void @leaf_hivgpr(ptr %p)
  ret void
}

