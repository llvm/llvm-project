# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa --stress-regalloc=2 -passes=greedy,virt-reg-rewriter -o - %s | FileCheck %s

# %1.sub2_sub3 is defined by a partial subregister def that reads %1.sub0_sub1.
# When the inline spiller spills %1 it must not rematerialize that def at the
# spill point: the rematerialized copy only writes sub2_sub3, so the sub0_sub1
# subregs would have no reaching definition.

---
name: remat_early_clobber_partial_def
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: remat_early_clobber_partial_def
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr8_sgpr9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $sgpr0_sgpr1 = COPY $sgpr8_sgpr9
  ; CHECK-NEXT:   early-clobber renamable $sgpr4_sgpr5 = S_LOAD_DWORDX2_IMM_ec renamable $sgpr0_sgpr1, 0, 0 :: (dereferenceable invariant load (s64), addrspace 4)
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE renamable $sgpr4_sgpr5_sgpr6_sgpr7, %stack.0, implicit $exec, implicit $sp_reg :: (store (s128) into %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit-def $sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7
  ; CHECK-NEXT:   renamable $sgpr4_sgpr5_sgpr6_sgpr7 = SI_SPILL_S128_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s128) from %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   early-clobber renamable $sgpr6_sgpr7 = S_LOAD_DWORDX2_IMM_ec renamable $sgpr0_sgpr1, 8, 0 :: (dereferenceable invariant load (s64), addrspace 4)
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE killed renamable $sgpr4_sgpr5_sgpr6_sgpr7, %stack.0, implicit $exec, implicit $sp_reg :: (store (s128) into %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit-def $sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7
  ; CHECK-NEXT:   renamable $sgpr4_sgpr5_sgpr6_sgpr7 = SI_SPILL_S128_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s128) from %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1, $sgpr4_sgpr5_sgpr6_sgpr7:0x00000000000000FF
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit renamable $sgpr4_sgpr5_sgpr6_sgpr7
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit killed renamable $sgpr0_sgpr1
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr8_sgpr9
    %0:sreg_64_xexec = COPY $sgpr8_sgpr9
    undef early-clobber %1.sub0_sub1:sgpr_128 = S_LOAD_DWORDX2_IMM_ec %0, 0, 0 :: (dereferenceable invariant load (s64), addrspace 4)
    S_NOP 0, implicit-def $sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7
    early-clobber %1.sub2_sub3:sgpr_128 = S_LOAD_DWORDX2_IMM_ec %0, 8, 0 :: (dereferenceable invariant load (s64), addrspace 4)
    S_NOP 0, implicit-def $sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7
    S_BRANCH %bb.1

  bb.1:
    S_NOP 0, implicit %1
    S_CBRANCH_SCC1 %bb.1, implicit undef $scc
    S_BRANCH %bb.2

  bb.2:
    S_NOP 0, implicit %0
    S_ENDPGM 0
...
