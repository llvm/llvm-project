# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu7.00-amd-amdhsa -passes='greedy<sgpr>' \
# RUN:   -verify-machineinstrs -verify-regalloc -o - %s | FileCheck %s

# Greedy spills the SGPR value before the call. The adjacent restore can use
# the still-live assigned register; the restore after the call must remain.
--- |
  declare void @callee()
  define void @sgpr_reproducer() { ret void }
...
---
name: sgpr_reproducer
tracksRegLiveness: true
liveins:
  - { reg: '$sgpr4', virtual-reg: '%2' }
  - { reg: '$vgpr0', virtual-reg: '%3' }
frameInfo:
  adjustsStack: true
  hasCalls: true
machineFunctionInfo:
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
  sgprForEXECCopy: '$sgpr100_sgpr101'
body: |
  ; CHECK-LABEL: name: sgpr_reproducer
  ; CHECK: bb.3:
  ; CHECK: SI_SPILL_S32_SAVE [[REG:%[0-9]+]], [[SLOT:%stack\.[0-9]+]]
  ; CHECK-NEXT: $sgpr4 = COPY [[REG]]
  ; CHECK-NOT: SI_SPILL_S32_RESTORE
  ; CHECK: SI_CALL
  ; CHECK: [[REG]]:sgpr_32 = SI_SPILL_S32_RESTORE [[SLOT]]
  bb.0:
    successors: %bb.3(0x40000000), %bb.1(0x40000000)
    liveins: $sgpr4, $vgpr0

    %3:vgpr_32 = COPY $vgpr0
    %2:sgpr_32 = COPY $sgpr4
    %4:vgpr_32 = V_AND_B32_e32 1, %3, implicit $exec
    %5:sreg_64 = V_CMP_NE_U32_e64 1, %4, implicit $exec
    %16:sreg_64 = COPY $exec, implicit-def $exec
    %17:sreg_64 = S_AND_B64 %16, %5, implicit-def dead $scc
    %0:sreg_64 = S_XOR_B64 %17, %16, implicit-def dead $scc
    $exec = S_MOV_B64_term %17
    S_CBRANCH_EXECZ %bb.1, implicit $exec
    S_BRANCH %bb.3

  bb.1:
    successors: %bb.2(0x40000000), %bb.4(0x40000000)

    %1:sreg_64 = S_OR_SAVEEXEC_B64 %0, implicit-def $exec, implicit-def dead $scc, implicit $exec
    $exec = S_XOR_B64_term $exec, %1, implicit-def dead $scc
    S_CBRANCH_EXECZ %bb.4, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.4(0x80000000)

    %13:sreg_64 = SI_PC_ADD_REL_OFFSET target-flags(amdgpu-gotprel32-lo) @callee, target-flags(amdgpu-gotprel32-hi) @callee, implicit-def dead $scc
    %14:sreg_64_xexec = S_LOAD_DWORDX2_IMM %13, 0, 0 :: (dereferenceable invariant load (s64) from got, addrspace 4)
    ADJCALLSTACKUP 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    $sgpr4 = COPY %2
    dead $sgpr30_sgpr31 = SI_CALL %14, @callee, csr_amdgpu, implicit $sgpr0_sgpr1_sgpr2_sgpr3, implicit $sgpr4
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    S_BRANCH %bb.4

  bb.3:
    successors: %bb.1(0x80000000)

    %8:sreg_64 = SI_PC_ADD_REL_OFFSET target-flags(amdgpu-gotprel32-lo) @callee, target-flags(amdgpu-gotprel32-hi) @callee, implicit-def dead $scc
    %9:sreg_64_xexec = S_LOAD_DWORDX2_IMM %8, 0, 0 :: (dereferenceable invariant load (s64) from got, addrspace 4)
    ADJCALLSTACKUP 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    $sgpr4 = COPY %2
    dead $sgpr30_sgpr31 = SI_CALL %9, @callee, csr_amdgpu, implicit $sgpr0_sgpr1_sgpr2_sgpr3, implicit $sgpr4
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    S_BRANCH %bb.1

  bb.4:
    $exec = S_OR_B64 $exec, %1, implicit-def dead $scc
    SI_RETURN
...
