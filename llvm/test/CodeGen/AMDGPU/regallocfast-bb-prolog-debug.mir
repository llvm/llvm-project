# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu6.00 -run-pass=regallocfast -o - %s | FileCheck %s

# A debug instruction in the block prolog does not make its operands prolog
# live-ins: the reload of %0 still goes after the exec restore.

--- |
  define amdgpu_kernel void @debug_in_bb_prolog() !dbg !4 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "debug_in_bb_prolog", scope: !1, file: !1, type: !5, unit: !0, spFlags: DISPFlagDefinition)
  !5 = !DISubroutineType(types: !{})
  !6 = !DILocalVariable(name: "x", scope: !4, file: !1)
  !7 = !DILocation(line: 1, scope: !4)
...
---
name: debug_in_bb_prolog
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg: '$sgpr96_sgpr97_sgpr98_sgpr99'
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: debug_in_bb_prolog
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   bb-prolog DBG_VALUE renamable $vgpr0, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   $exec = bb-prolog S_OR_B64 $exec, killed $sgpr0_sgpr1, implicit-def dead $scc
  ; CHECK-NEXT:   $vgpr0 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   S_ENDPGM 0, implicit killed renamable $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_SPILL_V32_SAVE killed $vgpr0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   DBG_VALUE %stack.0, 0, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   DBG_VALUE %stack.0, 0, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    successors: %bb.2
    S_BRANCH %bb.2

  bb.1:
    liveins: $sgpr0_sgpr1
    bb-prolog DBG_VALUE %0, $noreg, !6, !DIExpression(), debug-location !7
    $exec = bb-prolog S_OR_B64 $exec, $sgpr0_sgpr1, implicit-def dead $scc
    S_ENDPGM 0, implicit %0

  bb.2:
    successors: %bb.1
    liveins: $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    S_BRANCH %bb.1
...
