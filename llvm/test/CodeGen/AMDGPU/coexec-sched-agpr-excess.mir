# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -amdgpu-sched-strategy=coexec -amdgpu-stress-agpr=8 %s -o - | FileCheck --check-prefix=LIMIT %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -amdgpu-sched-strategy=coexec %s -o - | FileCheck --check-prefix=NO_LIMIT %s

# Test that AGPR pressure is tracked during scheduling.
# Two independent MFMA chains (3 MFMAs each), results written via DS_WRITE.
# With -amdgpu-stress-agpr=8, the scheduler should prefer scheduling
# one chain's consumer before starting the other chain to limit AGPR pressure.

--- |
  define void @agpr_excess_tracking() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name: agpr_excess_tracking
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
