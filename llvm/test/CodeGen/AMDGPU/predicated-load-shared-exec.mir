# RUN: llc -mtriple=amdgpu11.00 -mcpu=gfx1100 -mattr=+wavefrontsize32 -run-pass=post-ra-pseudos -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: same_predicate
# CHECK: $sgpr5 = S_AND_SAVEEXEC_B32
# CHECK-NEXT: {{.*}}GLOBAL_LOAD_DWORD
# CHECK-NEXT: {{.*}}GLOBAL_LOAD_DWORD
# CHECK-NEXT: $exec_lo = S_MOV_B32 killed $sgpr5
# CHECK-NOT: S_AND_SAVEEXEC_B32
# CHECK: S_ENDPGM
---
name: same_predicate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr4, $sgpr6, $vgpr0, $vgpr1, $vgpr2, $vgpr4_vgpr5
    $vgpr0, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 0, $sgpr4, $vgpr0, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    $vgpr1, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 4, $sgpr4, $vgpr1, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    S_ENDPGM 0
...

# CHECK-LABEL: name: three_loads
# CHECK: $sgpr5 = S_AND_SAVEEXEC_B32
# CHECK-NEXT: {{.*}}GLOBAL_LOAD_DWORD
# CHECK-NEXT: {{.*}}GLOBAL_LOAD_DWORD
# CHECK-NEXT: {{.*}}GLOBAL_LOAD_DWORD
# CHECK-NEXT: $exec_lo = S_MOV_B32 killed $sgpr5
# CHECK-NOT: S_AND_SAVEEXEC_B32
# CHECK: S_ENDPGM
---
name: three_loads
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr4, $sgpr6, $vgpr0, $vgpr1, $vgpr2, $vgpr4_vgpr5
    $vgpr0, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 0, $sgpr4, $vgpr0, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    $vgpr1, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 4, $sgpr4, $vgpr1, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    $vgpr2, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 8, $sgpr4, $vgpr2, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    S_ENDPGM 0
...

# CHECK-LABEL: name: different_predicate
# CHECK: S_AND_SAVEEXEC_B32
# CHECK: GLOBAL_LOAD_DWORD
# CHECK: $exec_lo = S_MOV_B32
# CHECK: S_AND_SAVEEXEC_B32
# CHECK: GLOBAL_LOAD_DWORD
# CHECK: $exec_lo = S_MOV_B32
# CHECK-NOT: S_AND_SAVEEXEC_B32
# CHECK: S_ENDPGM
---
name: different_predicate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr4, $sgpr6, $vgpr0, $vgpr1, $vgpr2, $vgpr4_vgpr5
    $vgpr0, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 0, $sgpr4, $vgpr0, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    $vgpr1, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 4, $sgpr6, $vgpr1, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    S_ENDPGM 0
...

# CHECK-LABEL: name: different_scratch
# CHECK: S_AND_SAVEEXEC_B32
# CHECK: GLOBAL_LOAD_DWORD
# CHECK: $exec_lo = S_MOV_B32
# CHECK: S_AND_SAVEEXEC_B32
# CHECK: GLOBAL_LOAD_DWORD
# CHECK: $exec_lo = S_MOV_B32
# CHECK-NOT: S_AND_SAVEEXEC_B32
# CHECK: S_ENDPGM
---
name: different_scratch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr4, $sgpr6, $vgpr0, $vgpr1, $vgpr2, $vgpr4_vgpr5
    $vgpr0, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 0, $sgpr4, $vgpr0, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    $vgpr1, dead early-clobber $sgpr7 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 4, $sgpr4, $vgpr1, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    S_ENDPGM 0
...

# CHECK-LABEL: name: live_scratch
# CHECK: S_AND_SAVEEXEC_B32
# CHECK: GLOBAL_LOAD_DWORD
# CHECK: $exec_lo = S_MOV_B32
# CHECK: S_AND_SAVEEXEC_B32
# CHECK: GLOBAL_LOAD_DWORD
# CHECK: $exec_lo = S_MOV_B32
# CHECK-NOT: S_AND_SAVEEXEC_B32
# CHECK: S_ENDPGM
---
name: live_scratch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr4, $sgpr6, $vgpr0, $vgpr1, $vgpr2, $vgpr4_vgpr5
    $vgpr0, dead early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 0, $sgpr4, $vgpr0, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    $vgpr1, early-clobber $sgpr5 = PRED_GLOBAL_LOAD_DWORD_RA $vgpr4_vgpr5, 4, $sgpr4, $vgpr1, implicit-def dead $scc, implicit $exec :: (load (s32), addrspace 1)
    S_ENDPGM 0
...

