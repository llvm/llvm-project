    $vgpr8_512 = V_WMMA_F64_16X16X4_F64_w32_twoaddr 8, killed $vgpr0_128, 8, killed $vgpr4_128, 8, killed $vgpr8_512, 0, 0, 0, 0, implicit $exec
    $vgpr34_512 = V_WMMA_F64_16X16X4_F64_w32_twoaddr 8, killed $vgpr26_128, 8, killed $vgpr8_128, 8, killed $vgpr34_512, 0, 0, 0, 0, implicit $exec
