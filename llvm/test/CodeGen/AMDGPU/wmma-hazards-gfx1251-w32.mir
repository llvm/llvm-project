# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu12.51 -run-pass post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX1251 %s

# For two conscutive wmma instructions, we need to insert one V_NOP instruction between
# them if matrix A, B or index of the second wmma are the same or overlap with previous
# wmma instruction’s D-matrix.

---
name: test_wmma_f64_16x16x4_f64_D0_overlaps_A1
body: |
  bb.0:
    ; GFX1251-LABEL: name: test_wmma_f64_16x16x4_f64_D0_overlaps_A1
    ; GFX1251: early-clobber $vgpr8_512 = V_WMMA_F64_16X16X4_F64_w32_twoaddr 8, killed $vgpr0_128, 8, killed $vgpr4_128, 8, killed $vgpr8_512, 0, 0, 0, 0, implicit $exec
    ; GFX1251-NEXT: V_NOP_e32 implicit $exec
    ; GFX1251-NEXT: early-clobber $vgpr34_512 = V_WMMA_F64_16X16X4_F64_w32_twoaddr 8, killed $vgpr8_128, 8, killed $vgpr30_128, 8, killed $vgpr34_512, 0, 0, 0, 0, implicit $exec
    $vgpr8_512 = V_WMMA_F64_16X16X4_F64_w32_twoaddr 8, killed $vgpr0_128, 8, killed $vgpr4_128, 8, killed $vgpr8_512, 0, 0, 0, 0, implicit $exec
    $vgpr34_512 = V_WMMA_F64_16X16X4_F64_w32_twoaddr 8, killed $vgpr8_128, 8, killed $vgpr30_128, 8, killed $vgpr34_512, 0, 0, 0, 0, implicit $exec
...

