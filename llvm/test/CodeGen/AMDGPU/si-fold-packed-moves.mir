# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.42 -run-pass=si-fold-packed-moves -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu9.42 -passes=si-fold-packed-moves -o - %s | FileCheck %s

# Each half of the result can come from either half of a VGPR or SGPR pair.
---
name: packed_move
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $sgpr5
    ; CHECK-LABEL: name: packed_move
    ; CHECK: liveins: $vgpr2, $sgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8_vgpr9 = V_PK_MOV_B32 12, undef $sgpr4_sgpr5, 8, undef $vgpr2_vgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $sgpr5, implicit $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9
    $vgpr9 = COPY $vgpr2
    $vgpr8 = COPY $sgpr5
    S_ENDPGM 0, implicit $vgpr8_vgpr9
...

# Both halves of one source pair in order are a 64-bit copy.
---
name: wide_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr4, $vgpr5, $sgpr2, $sgpr3
    ; CHECK-LABEL: name: wide_copy
    ; CHECK: liveins: $vgpr4, $vgpr5, $sgpr2, $sgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8_vgpr9 = COPY $vgpr4_vgpr5, implicit $exec
    ; CHECK-NEXT: $vgpr10_vgpr11 = COPY $sgpr2_sgpr3, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11
    $vgpr8 = COPY $vgpr4
    $vgpr9 = COPY $vgpr5
    $vgpr11 = COPY $sgpr3
    $vgpr10 = COPY $sgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11
...

# The first COPY is sunk, so its source is no longer killed in between.
---
name: sink_past_kill_of_source
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $vgpr4_vgpr5
    ; CHECK-LABEL: name: sink_past_kill_of_source
    ; CHECK: liveins: $vgpr2, $vgpr4_vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr12_vgpr13 = COPY $vgpr4_vgpr5
    ; CHECK-NEXT: $vgpr8_vgpr9 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr2_vgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr12_vgpr13
    $vgpr8 = COPY $vgpr5
    $vgpr12_vgpr13 = COPY killed $vgpr4_vgpr5
    $vgpr9 = COPY $vgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr12_vgpr13
...

# The first COPY cannot be sunk past the read of $vgpr8, so the second one is
# hoisted.
---
name: hoist_past_use_of_first_dst
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr4, $vgpr5
    ; CHECK-LABEL: name: hoist_past_use_of_first_dst
    ; CHECK: liveins: $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8_vgpr9 = COPY $vgpr4_vgpr5, implicit $exec
    ; CHECK-NEXT: $vgpr12 = V_MOV_B32_e32 $vgpr8, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr12
    $vgpr8 = COPY $vgpr4
    $vgpr12 = V_MOV_B32_e32 $vgpr8, implicit $exec
    $vgpr9 = COPY $vgpr5
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr12
...

# A packed move reads both sources before it writes, so the second COPY may
# overwrite the source of the first one but not read its destination.
---
name: dependent_copies
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr5, $vgpr11, $sgpr2
    ; CHECK-LABEL: name: dependent_copies
    ; CHECK: liveins: $vgpr5, $vgpr11, $sgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $vgpr5
    ; CHECK-NEXT: $vgpr9 = COPY $vgpr8
    ; CHECK-NEXT: $vgpr10_vgpr11 = V_PK_MOV_B32 12, undef $vgpr10_vgpr11, 8, undef $sgpr2_sgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr11, implicit $sgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11
    $vgpr8 = COPY $vgpr5
    $vgpr9 = COPY $vgpr8
    $vgpr10 = COPY $vgpr11
    $vgpr11 = COPY $sgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11
...

# Neither COPY can be moved to the other: the instruction in between reads both
# destinations, or writes both sources.
---
name: blocked_both_ways
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr4_vgpr5, $vgpr6_vgpr7, $vgpr9
    ; CHECK-LABEL: name: blocked_both_ways
    ; CHECK: liveins: $vgpr4_vgpr5, $vgpr6_vgpr7, $vgpr9
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $vgpr5
    ; CHECK-NEXT: $vgpr12_vgpr13 = COPY $vgpr8_vgpr9
    ; CHECK-NEXT: $vgpr9 = COPY $vgpr4
    ; CHECK-NEXT: $vgpr10 = COPY $vgpr4
    ; CHECK-NEXT: $vgpr4_vgpr5 = COPY $vgpr6_vgpr7
    ; CHECK-NEXT: $vgpr11 = COPY $vgpr5
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12_vgpr13
    $vgpr8 = COPY $vgpr5
    $vgpr12_vgpr13 = COPY $vgpr8_vgpr9
    $vgpr9 = COPY $vgpr4
    $vgpr10 = COPY $vgpr4
    $vgpr4_vgpr5 = COPY $vgpr6_vgpr7
    $vgpr11 = COPY $vgpr5
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12_vgpr13
...

# A COPY writes only the lanes enabled in EXEC.
---
name: exec_change
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $vgpr5, $sgpr0
    ; CHECK-LABEL: name: exec_change
    ; CHECK: liveins: $vgpr2, $vgpr5, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $vgpr5
    ; CHECK-NEXT: $exec_lo = S_MOV_B32 $sgpr0
    ; CHECK-NEXT: $vgpr9 = COPY $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9
    $vgpr8 = COPY $vgpr5
    $exec_lo = S_MOV_B32 $sgpr0
    $vgpr9 = COPY $vgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9
...

# Two SGPR pairs would need two constant bus slots; one pair read twice does
# not.
---
name: constant_bus
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr2, $sgpr4, $sgpr5
    ; CHECK-LABEL: name: constant_bus
    ; CHECK: liveins: $sgpr2, $sgpr4, $sgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $sgpr2
    ; CHECK-NEXT: $vgpr9 = COPY $sgpr5
    ; CHECK-NEXT: $vgpr10_vgpr11 = V_PK_MOV_B32 12, undef $sgpr4_sgpr5, 8, undef $sgpr4_sgpr5, 0, 0, 0, 0, 0, implicit $exec, implicit $sgpr5, implicit $sgpr4
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11
    $vgpr8 = COPY $sgpr2
    $vgpr9 = COPY $sgpr5
    $vgpr10 = COPY $sgpr5
    $vgpr11 = COPY $sgpr4
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11
...

# COPYs that are not folded: a dead def, an undef source, an extra implicit
# operand, an AGPR source, and destinations that are not an aligned pair.
---
name: not_foldable
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $agpr0, $vgpr4, $vgpr5
    ; CHECK-LABEL: name: not_foldable
    ; CHECK: liveins: $agpr0, $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $vgpr0 = COPY $vgpr4
    ; CHECK-NEXT: $vgpr1 = COPY $vgpr5
    ; CHECK-NEXT: $vgpr2 = COPY undef $vgpr4
    ; CHECK-NEXT: $vgpr3 = COPY $vgpr5
    ; CHECK-NEXT: $vgpr6 = COPY $vgpr4, implicit-def $vgpr20
    ; CHECK-NEXT: $vgpr7 = COPY $vgpr5
    ; CHECK-NEXT: $vgpr8 = COPY $agpr0
    ; CHECK-NEXT: $vgpr9 = COPY $vgpr4
    ; CHECK-NEXT: $vgpr11 = COPY $vgpr4
    ; CHECK-NEXT: $vgpr12 = COPY $vgpr5
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr1, implicit $vgpr3, implicit $vgpr6_vgpr7, implicit $vgpr8_vgpr9, implicit $vgpr11, implicit $vgpr12, implicit $vgpr20
    dead $vgpr0 = COPY $vgpr4
    $vgpr1 = COPY $vgpr5
    $vgpr2 = COPY undef $vgpr4
    $vgpr3 = COPY $vgpr5
    $vgpr6 = COPY $vgpr4, implicit-def $vgpr20
    $vgpr7 = COPY $vgpr5
    $vgpr8 = COPY $agpr0
    $vgpr9 = COPY $vgpr4
    $vgpr11 = COPY $vgpr4
    $vgpr12 = COPY $vgpr5
    S_ENDPGM 0, implicit $vgpr1, implicit $vgpr3, implicit $vgpr6_vgpr7, implicit $vgpr8_vgpr9, implicit $vgpr11, implicit $vgpr12, implicit $vgpr20
...

# The stack pointer is reserved, and so is the pair that contains it.
---
name: reserved_source
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $sgpr33
    ; CHECK-LABEL: name: reserved_source
    ; CHECK: liveins: $sgpr33
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $sgpr32
    ; CHECK-NEXT: $vgpr9 = COPY $sgpr33
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9
    $vgpr8 = COPY $sgpr32
    $vgpr9 = COPY $sgpr33
    S_ENDPGM 0, implicit $vgpr8_vgpr9
...

# Debug instructions must not change what is folded. A debug value between the
# COPYs that refers to the destination of the moved COPY is dropped: $vgpr8 is
# written later than it was, and $vgpr11 earlier.
---
name: debug_values
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr4, $vgpr5
    ; CHECK-LABEL: name: debug_values
    ; CHECK: liveins: $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg
    ; CHECK-NEXT: DBG_VALUE $vgpr4, $noreg
    ; CHECK-NEXT: $vgpr8_vgpr9 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr4
    ; CHECK-NEXT: $vgpr10_vgpr11 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr4
    ; CHECK-NEXT: $vgpr12 = V_MOV_B32_e32 $vgpr10, implicit $exec
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg
    ; CHECK-NEXT: DBG_VALUE $vgpr10, $noreg
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12
    $vgpr8 = COPY $vgpr5
    DBG_VALUE $vgpr8, $noreg
    DBG_VALUE $vgpr4, $noreg
    $vgpr9 = COPY $vgpr4
    $vgpr10 = COPY $vgpr5
    $vgpr12 = V_MOV_B32_e32 $vgpr10, implicit $exec
    DBG_VALUE $vgpr11, $noreg
    DBG_VALUE $vgpr10, $noreg
    $vgpr11 = COPY $vgpr4
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12
...

# Nothing is moved across a switch of the VGPR indexing mode, but that does not
# stop folding elsewhere in the function.
---
name: vgpr_index_mode_switch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $vgpr5
    ; CHECK-LABEL: name: vgpr_index_mode_switch
    ; CHECK: liveins: $sgpr0, $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $vgpr5
    ; CHECK-NEXT: S_SET_GPR_IDX_ON $sgpr0, 1, implicit-def $m0, implicit-def $mode, implicit undef $m0, implicit $mode
    ; CHECK-NEXT: $vgpr12 = V_MOV_B32_indirect_read undef $vgpr0, implicit $exec, implicit $m0, implicit $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: S_SET_GPR_IDX_OFF implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr9 = COPY $vgpr4
    ; CHECK-NEXT: $vgpr10_vgpr11 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr4
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12
    $vgpr8 = COPY $vgpr5
    S_SET_GPR_IDX_ON $sgpr0, 1, implicit-def $m0, implicit-def $mode, implicit undef $m0, implicit $mode
    $vgpr12 = V_MOV_B32_indirect_read undef $vgpr0, implicit $exec, implicit $m0, implicit $vgpr0_vgpr1_vgpr2_vgpr3
    S_SET_GPR_IDX_OFF implicit-def $mode, implicit $mode
    $vgpr9 = COPY $vgpr4
    $vgpr10 = COPY $vgpr5
    $vgpr11 = COPY $vgpr4
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12
...

# Before they are expanded, indexed accesses name the whole vector they index,
# so they are checked like any other instruction: the read does not matter to
# the first pair, the write changes both sources of the second pair.
---
name: vgpr_index_pseudo
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $vgpr5, $vgpr6
    ; CHECK-LABEL: name: vgpr_index_pseudo
    ; CHECK: liveins: $sgpr0, $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $vgpr5, $vgpr6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr12 = V_INDIRECT_REG_READ_GPR_IDX_B32_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0, 3, implicit-def $m0, implicit $m0, implicit $exec
    ; CHECK-NEXT: $vgpr8_vgpr9 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr4
    ; CHECK-NEXT: $vgpr10 = COPY $vgpr1
    ; CHECK-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = V_INDIRECT_REG_WRITE_GPR_IDX_B32_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr6, $sgpr0, 3, implicit-def $m0, implicit $m0, implicit $exec
    ; CHECK-NEXT: $vgpr11 = COPY $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12, implicit $vgpr0_vgpr1_vgpr2_vgpr3
    $vgpr8 = COPY $vgpr5
    $vgpr12 = V_INDIRECT_REG_READ_GPR_IDX_B32_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $sgpr0, %subreg.sub0, implicit-def $m0, implicit $m0, implicit $exec
    $vgpr9 = COPY $vgpr4
    $vgpr10 = COPY $vgpr1
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_INDIRECT_REG_WRITE_GPR_IDX_B32_V4 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr6, $sgpr0, %subreg.sub0, implicit-def $m0, implicit $m0, implicit $exec
    $vgpr11 = COPY $vgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr10_vgpr11, implicit $vgpr12, implicit $vgpr0_vgpr1_vgpr2_vgpr3
...

# COPYs from live range splitting are folded like any other.
---
name: lr_split
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $vgpr5
    ; CHECK-LABEL: name: lr_split
    ; CHECK: liveins: $vgpr2, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8_vgpr9 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr2_vgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9
    $vgpr8 = lr-split COPY $vgpr5
    $vgpr9 = lr-split COPY $vgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9
...

# Instructions that do not touch the registers of the COPYs are no obstacle,
# even if they emit no code or have side effects.
---
name: unrelated_instructions
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $vgpr5, $vgpr20
    ; CHECK-LABEL: name: unrelated_instructions
    ; CHECK: liveins: $vgpr2, $vgpr5, $vgpr20
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: KILL $vgpr20
    ; CHECK-NEXT: $vgpr21 = IMPLICIT_DEF
    ; CHECK-NEXT: ATOMIC_FENCE 5, 0
    ; CHECK-NEXT: $vgpr8_vgpr9 = V_PK_MOV_B32 12, undef $vgpr4_vgpr5, 8, undef $vgpr2_vgpr3, 0, 0, 0, 0, 0, implicit $exec, implicit $vgpr5, implicit $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr21
    $vgpr8 = COPY $vgpr5
    KILL $vgpr20
    $vgpr21 = IMPLICIT_DEF
    ATOMIC_FENCE 5, 0
    $vgpr9 = COPY $vgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9, implicit $vgpr21
...

# Scheduling directives apply to the instructions around them.
---
name: sched_group_barrier
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2, $vgpr5
    ; CHECK-LABEL: name: sched_group_barrier
    ; CHECK: liveins: $vgpr2, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr8 = COPY $vgpr5
    ; CHECK-NEXT: SCHED_GROUP_BARRIER 2, 1, 0
    ; CHECK-NEXT: $vgpr9 = COPY $vgpr2
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr8_vgpr9
    $vgpr8 = COPY $vgpr5
    SCHED_GROUP_BARRIER 2, 1, 0
    $vgpr9 = COPY $vgpr2
    S_ENDPGM 0, implicit $vgpr8_vgpr9
...
