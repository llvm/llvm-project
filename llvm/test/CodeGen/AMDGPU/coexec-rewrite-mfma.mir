# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -start-before=machine-scheduler \
# RUN:     -amdgpu-sched-strategy=coexec --enable-post-misched=0 %s -o - 2>&1 \
# RUN:     | FileCheck %s

# The coexec scheduler strategy pushes RewriteMFMAForm into its pipeline so MFMA
# chains can be rewritten to the AGPR form when ArchVGPR pressure is excessive.
#
# The input is the MIR that reaches the machine scheduler for the IR of
# coexec-rewrite-mfma.ll (also used by avgpr-banking.ll), as it was produced
# while EarlyMachineLICM did not see the pressure of AV registers: the AV
# copies of the MFMA operands are hoisted out of the loop, which makes the VGPR
# pressure high. Every MFMA in the loop is rewritten to the AGPR-destination
# form (v_mfma_f32_16x16x32_f16 a*). coexec-rewrite-mfma.ll checks the full
# pipeline, where the copies stay in the loop.

# CHECK-LABEL: v5_local_prefetch:
# CHECK-COUNT-30: v_mfma_f32_16x16x32_f16 a
# CHECK-NOT: v_mfma_f32_16x16x32_f16 v

--- |
  target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-p10:32:32-p11:32:32-p12:32:32-p13:32:32-p14:32:32-p15:32:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgpu9.50-amd-amdhsa"

  define amdgpu_kernel void @v5_local_prefetch() #0 {
  .lr.ph:
    %0 = load <8 x half>, ptr addrspace(3) null, align 16
    %1 = shufflevector <8 x half> %0, <8 x half> zeroinitializer, <2 x i32> <i32 0, i32 1>
    %2 = shufflevector <8 x half> %0, <8 x half> zeroinitializer, <2 x i32> <i32 2, i32 3>
    %largephi.insertslice1 = call <8 x half> @llvm.vector.insert.v8f16.v2f16(<8 x half> <half 0.000000e+00, half 0.000000e+00, half poison, half poison, half poison, half poison, half poison, half poison>, <2 x half> zeroinitializer, i64 2)
    %largephi.insertslice2 = call <8 x half> @llvm.vector.insert.v8f16.v2f16(<8 x half> %largephi.insertslice1, <2 x half> zeroinitializer, i64 4)
    %largephi.insertslice3 = call <8 x half> @llvm.vector.insert.v8f16.v2f16(<8 x half> %largephi.insertslice2, <2 x half> zeroinitializer, i64 6)
    %3 = shufflevector <8 x half> zeroinitializer, <8 x half> %largephi.insertslice3, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 8, i32 9>
    br label %4

  4:                                                ; preds = %4, %.lr.ph
    %5 = phi float [ 0.000000e+00, %.lr.ph ], [ %53, %4 ]
    %6 = phi float [ 0.000000e+00, %.lr.ph ], [ %54, %4 ]
    %7 = phi float [ 0.000000e+00, %.lr.ph ], [ %61, %4 ]
    %8 = phi float [ 0.000000e+00, %.lr.ph ], [ %62, %4 ]
    %9 = phi float [ 0.000000e+00, %.lr.ph ], [ %63, %4 ]
    %10 = phi float [ 0.000000e+00, %.lr.ph ], [ %64, %4 ]
    %11 = phi float [ 0.000000e+00, %.lr.ph ], [ %71, %4 ]
    %12 = phi float [ 0.000000e+00, %.lr.ph ], [ %72, %4 ]
    %13 = phi float [ 0.000000e+00, %.lr.ph ], [ %73, %4 ]
    %14 = phi float [ 0.000000e+00, %.lr.ph ], [ %74, %4 ]
    %15 = phi float [ 0.000000e+00, %.lr.ph ], [ %80, %4 ]
    %16 = phi float [ 0.000000e+00, %.lr.ph ], [ %81, %4 ]
    %17 = phi float [ 0.000000e+00, %.lr.ph ], [ %82, %4 ]
    %18 = phi float [ 0.000000e+00, %.lr.ph ], [ %87, %4 ]
    %19 = phi float [ 0.000000e+00, %.lr.ph ], [ %88, %4 ]
    %20 = phi float [ 0.000000e+00, %.lr.ph ], [ %93, %4 ]
    %21 = phi float [ 0.000000e+00, %.lr.ph ], [ %94, %4 ]
    %22 = phi float [ 0.000000e+00, %.lr.ph ], [ %99, %4 ]
    %23 = phi float [ 0.000000e+00, %.lr.ph ], [ %100, %4 ]
    %24 = phi float [ 0.000000e+00, %.lr.ph ], [ %25, %4 ]
    %25 = phi float [ 0.000000e+00, %.lr.ph ], [ %105, %4 ]
    %26 = phi float [ 0.000000e+00, %.lr.ph ], [ %112, %4 ]
    %27 = phi float [ 0.000000e+00, %.lr.ph ], [ %113, %4 ]
    %28 = phi float [ 0.000000e+00, %.lr.ph ], [ %114, %4 ]
    %29 = phi float [ 0.000000e+00, %.lr.ph ], [ %115, %4 ]
    %30 = phi float [ 0.000000e+00, %.lr.ph ], [ %122, %4 ]
    %31 = phi float [ 0.000000e+00, %.lr.ph ], [ %123, %4 ]
    %32 = phi float [ 0.000000e+00, %.lr.ph ], [ %124, %4 ]
    %33 = phi float [ 0.000000e+00, %.lr.ph ], [ %125, %4 ]
    %34 = phi float [ 0.000000e+00, %.lr.ph ], [ %132, %4 ]
    %35 = phi float [ 0.000000e+00, %.lr.ph ], [ %133, %4 ]
    %36 = phi float [ 0.000000e+00, %.lr.ph ], [ %134, %4 ]
    %37 = phi float [ 0.000000e+00, %.lr.ph ], [ %135, %4 ]
    %38 = phi float [ 0.000000e+00, %.lr.ph ], [ %140, %4 ]
    %39 = phi float [ 0.000000e+00, %.lr.ph ], [ %141, %4 ]
    %40 = phi float [ 0.000000e+00, %.lr.ph ], [ %146, %4 ]
    %41 = phi float [ 0.000000e+00, %.lr.ph ], [ %147, %4 ]
    %42 = phi float [ 0.000000e+00, %.lr.ph ], [ %152, %4 ]
    %43 = phi float [ 0.000000e+00, %.lr.ph ], [ %42, %4 ]
    %p0 = phi float [ 0.000000e+00, %.lr.ph ], [ %e0, %4 ]
    %p1 = phi float [ 0.000000e+00, %.lr.ph ], [ %e1, %4 ]
    %44 = phi <2 x half> [ %1, %.lr.ph ], [ zeroinitializer, %4 ]
    %45 = phi <2 x half> [ %2, %.lr.ph ], [ zeroinitializer, %4 ]
    %46 = shufflevector <2 x half> %44, <2 x half> %45, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 poison, i32 poison, i32 poison, i32 poison>
    %47 = shufflevector <8 x half> %46, <8 x half> zeroinitializer, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 8, i32 9, i32 poison, i32 poison>
    %48 = shufflevector <8 x half> %46, <8 x half> zeroinitializer, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 8, i32 9>
    %49 = insertelement <4 x float> zeroinitializer, float %5, i64 2
    %50 = insertelement <4 x float> %49, float %6, i64 3
    %51 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %47, <8 x half> zeroinitializer, <4 x float> %50, i32 0, i32 0, i32 0)
    %52 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %51, i32 0, i32 0, i32 0)
    %53 = extractelement <4 x float> %52, i64 2
    %54 = extractelement <4 x float> %52, i64 3
    %55 = insertelement <4 x float> zeroinitializer, float %7, i64 0
    %56 = insertelement <4 x float> %55, float %8, i64 1
    %57 = insertelement <4 x float> %56, float %9, i64 2
    %58 = insertelement <4 x float> %57, float %10, i64 3
    %59 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %58, i32 0, i32 0, i32 0)
    %60 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %59, i32 0, i32 0, i32 0)
    %61 = extractelement <4 x float> %60, i64 0
    %62 = extractelement <4 x float> %60, i64 1
    %63 = extractelement <4 x float> %60, i64 2
    %64 = extractelement <4 x float> %60, i64 3
    %65 = insertelement <4 x float> zeroinitializer, float %11, i64 0
    %66 = insertelement <4 x float> %65, float %12, i64 1
    %67 = insertelement <4 x float> %66, float %13, i64 2
    %68 = insertelement <4 x float> %67, float %14, i64 3
    %69 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %68, i32 0, i32 0, i32 0)
    %70 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %69, i32 0, i32 0, i32 0)
    %71 = extractelement <4 x float> %70, i64 0
    %72 = extractelement <4 x float> %70, i64 1
    %73 = extractelement <4 x float> %70, i64 2
    %74 = extractelement <4 x float> %70, i64 3
    %75 = insertelement <4 x float> zeroinitializer, float %15, i64 0
    %76 = insertelement <4 x float> %75, float %16, i64 1
    %77 = insertelement <4 x float> %76, float %17, i64 2
    %78 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %77, i32 0, i32 0, i32 0)
    %79 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %78, i32 0, i32 0, i32 0)
    %80 = extractelement <4 x float> %79, i64 0
    %81 = extractelement <4 x float> %79, i64 1
    %82 = extractelement <4 x float> %79, i64 2
    %83 = insertelement <4 x float> zeroinitializer, float %18, i64 2
    %84 = insertelement <4 x float> %83, float %19, i64 3
    %85 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %84, i32 0, i32 0, i32 0)
    %86 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %85, i32 0, i32 0, i32 0)
    %87 = extractelement <4 x float> %86, i64 2
    %88 = extractelement <4 x float> %86, i64 3
    %89 = insertelement <4 x float> zeroinitializer, float %20, i64 0
    %90 = insertelement <4 x float> %89, float %21, i64 1
    %91 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %90, i32 0, i32 0, i32 0)
    %92 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %91, i32 0, i32 0, i32 0)
    %93 = extractelement <4 x float> %92, i64 0
    %94 = extractelement <4 x float> %92, i64 1
    %95 = insertelement <4 x float> zeroinitializer, float %22, i64 0
    %96 = insertelement <4 x float> %95, float %23, i64 1
    %97 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %3, <8 x half> zeroinitializer, <4 x float> %96, i32 0, i32 0, i32 0)
    %98 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %97, i32 0, i32 0, i32 0)
    %99 = extractelement <4 x float> %98, i64 0
    %100 = extractelement <4 x float> %98, i64 1
    %101 = insertelement <4 x float> poison, float %24, i64 0
    %102 = insertelement <4 x float> %101, float %25, i64 0
    %103 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %102, i32 0, i32 0, i32 0)
    %104 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %103, i32 0, i32 0, i32 0)
    %105 = extractelement <4 x float> %104, i64 0
