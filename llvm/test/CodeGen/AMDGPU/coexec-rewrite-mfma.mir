    %107 = insertelement <4 x float> %106, float %27, i64 1
    %108 = insertelement <4 x float> %107, float %28, i64 2
    %109 = insertelement <4 x float> %108, float %29, i64 3
    %110 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %48, <8 x half> zeroinitializer, <4 x float> %109, i32 0, i32 0, i32 0)
    %111 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %110, i32 0, i32 0, i32 0)
    %112 = extractelement <4 x float> %111, i64 0
