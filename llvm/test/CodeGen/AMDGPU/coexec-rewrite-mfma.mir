    %131 = tail call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> zeroinitializer, <8 x half> zeroinitializer, <4 x float> %130, i32 0, i32 0, i32 0)
    %132 = extractelement <4 x float> %131, i64 0
    %133 = extractelement <4 x float> %131, i64 1
    %134 = extractelement <4 x float> %131, i64 2
    %135 = extractelement <4 x float> %131, i64 3
