; CHECK-NEXT:    ALU clause starting at 4:
; CHECK-NEXT:     MOV * T0.W, literal.x,
; CHECK-NEXT:    4(5.605194e-45), 0(0.000000e+00)
; CHECK-NEXT:     BFE_UINT T0.X, KC0[2].Z, literal.x, PV.W,
; CHECK-NEXT:     LSHR * T1.X, KC0[2].Y, literal.y,
; CHECK-NEXT:    5(7.006492e-45), 2(2.802597e-45)
entry:
  %0 = lshr i32 %x, 5
  %1 = and i32 %0, 15 ; 0xf
