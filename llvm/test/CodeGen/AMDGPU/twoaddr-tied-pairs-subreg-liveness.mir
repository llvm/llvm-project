# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50 -run-pass=liveintervals,two-address-instruction \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# V_PERMLANE32_SWAP_B32 has two tied operand pairs, and here both read
# subregisters of the same register. Two-address pass emits one copy per
# pair, so %0.sub0 dies at the first copy and %0.sub1 at the second.
#
# Shrinking every subrange to the last copy instead leaves sub0 live up to the
# copy that only reads sub1, which -verify-machineinstrs rejects with
# "Instruction ending live segment doesn't read the register".

---
name:            two_tied_pairs_same_reg
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: two_tied_pairs_same_reg
    ; CHECK: [[DEF:%[0-9]+]]:vreg_64_align2 = IMPLICIT_DEF
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY [[DEF]].sub0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[DEF]].sub1
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32, [[COPY1:%[0-9]+]]:vgpr_32 = V_PERMLANE32_SWAP_B32_e32 [[COPY]], [[COPY1]], implicit $exec
    ; CHECK-NEXT: S_NOP 0, implicit [[COPY]], implicit [[COPY1]]
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vreg_64_align2 = IMPLICIT_DEF
    %1:vgpr_32, %2:vgpr_32 = V_PERMLANE32_SWAP_B32_e32 %0.sub0, %0.sub1, implicit $exec
    S_NOP 0, implicit %1, implicit %2
    S_ENDPGM 0
...
