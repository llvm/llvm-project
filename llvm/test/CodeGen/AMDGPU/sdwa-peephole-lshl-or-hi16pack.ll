; V_LSHLREV_B32 + V_OR_B32_sdwa with src1_sel:WORD_0, so the mask is free.

define i32 @pack_hi16_masked(i32 %hi, i32 %z) {
; GFX9-LABEL: pack_hi16_masked:
; GFX9:       ; %bb.0:
; GFX9-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; GFX9-NEXT:    v_lshlrev_b32_e32 v0, 16, v0
; GFX9-NEXT:    v_or_b32_sdwa v0, v0, v1 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:WORD_0
; GFX9-NEXT:    s_setpc_b64 s[30:31]
  %s = shl i32 %hi, 16
  %m = and i32 %z, 65535
  %o = or i32 %s, %m
  ret i32 %o
}
