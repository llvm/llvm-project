# RUN: not llc -mtriple=amdgpu9.08-amd-amdhsa -stress-regalloc=1 -run-pass=regallocbasic -filetype=null %s 2>&1 | FileCheck -implicit-check-not=error %s
# RUN: not llc -mtriple=amdgpu9.08-amd-amdhsa -stress-regalloc=1 -run-pass=greedy -filetype=null %s 2>&1 | FileCheck -implicit-check-not=error %s

# The failed subregister def should only def the subregister's regunits.

# CHECK: error: <unknown>:0:0: ran out of registers during register allocation in function 'subreg_def'

---
name: subreg_def
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    undef %0.sub1:vreg_64 = COPY $vgpr1
    %0.sub0:vreg_64 = COPY $vgpr0
    %1:vgpr_32 = GLOBAL_LOAD_DWORD %0, 0, 0, implicit $exec :: (volatile load (s32), addrspace 1)
    %2:vgpr_32 = GLOBAL_LOAD_DWORD %0, 0, 0, implicit $exec :: (volatile load (s32), addrspace 1)
    KILL %0.sub0, %0.sub1
    %3:vgpr_32 = V_ADD_U32_e32 %1, %2, implicit $exec
    $vgpr0 = COPY %3
    SI_RETURN implicit $vgpr0
...
