#
# Genuine partial-spill tests: a partial def leaves a LIVE sibling lane
# uncovered in a shared spill slot, so the spiller stores only the defined
# words (SI_SPILL_S32_SAVE_PARTIAL) to avoid clobbering the live sibling
# lane.

--- |
  define amdgpu_kernel void @partial_def_live_sibling() { ret void }
...
