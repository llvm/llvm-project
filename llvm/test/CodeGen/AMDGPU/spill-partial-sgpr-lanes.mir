# RUN: llc -mtriple=amdgpu11.51-amd-amdhsa -passes='greedy<sgpr>' -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu11.51-amd-amdhsa -run-pass=regallocbasic -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s --check-prefix=BASIC
#
# These are genuine updates, not unchanged copies from the shared slot. The
# allocator must keep the stores, and each partial store must only read and
# overwrite the lanes supplied by its source. The loop exercises both ordinary
# insertion and hoistSpillInsideBB without pre-populated split-from metadata.

--- |
  define amdgpu_kernel void @dirty_loop() { ret void }
  define amdgpu_kernel void @dirty_one_lane() { ret void }
  define amdgpu_kernel void @dirty_discontiguous() { ret void }
  define amdgpu_kernel void @wholly_undef_path() { ret void }
  define amdgpu_kernel void @preserving_implicit_def() { ret void }
...
---
name: dirty_loop
# CHECK-LABEL: name: dirty_loop
# CHECK: S_ADD_U32
# CHECK: SI_SPILL_S32_SAVE_PARTIAL {{.*}}.sub2, %stack.0, 2
# CHECK-NEXT: SI_SPILL_S32_SAVE_PARTIAL {{.*}}.sub3, %stack.0, 3
# CHECK: SI_SPILL_S128_RESTORE %stack.0

tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 1
body: |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3
    %0:sgpr_128 = COPY $sgpr0_sgpr1_sgpr2_sgpr3
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103
    S_BRANCH %bb.1
  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    %0.sub2 = S_ADD_U32 %0.sub2, 7, implicit-def dead $scc
    KILL %0.sub3
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103
    KILL %0.sub2
    KILL implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2
  bb.2:
    S_ENDPGM 0
...
---
name: dirty_one_lane
# CHECK-LABEL: name: dirty_one_lane
# CHECK: undef [[SRC:%[0-9]+]].sub2:sgpr_128 = S_ADD_U32
# CHECK-NEXT: SI_SPILL_S32_SAVE_PARTIAL [[SRC]].sub2, %stack.0, 2
# CHECK-NOT: SI_SPILL_S128_SAVE
# CHECK: SI_SPILL_S128_RESTORE %stack.0
# CHECK: KILL {{.*}}.sub2

tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 1
body: |
  bb.0:
    liveins: $sgpr104
    undef %0.sub2:sgpr_128 = S_ADD_U32 $sgpr104, 7, implicit-def dead $scc
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103
    KILL %0.sub2
    S_ENDPGM 0
...
---
name: dirty_discontiguous
# CHECK-LABEL: name: dirty_discontiguous
# CHECK: S_ADD_U32
# CHECK: S_XOR_B32
# CHECK-NOT: SI_SPILL_S128_SAVE
# CHECK: SI_SPILL_S32_SAVE_PARTIAL [[SRC:%[0-9]+]].sub1, %stack.0, 1
# CHECK-NEXT: SI_SPILL_S32_SAVE_PARTIAL [[SRC]].sub3, %stack.0, 3
# CHECK-NOT: SI_SPILL_S128_SAVE
# CHECK: SI_SPILL_S128_RESTORE %stack.0

tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 1
body: |
  bb.0:
    liveins: $sgpr104
    undef %0.sub1:sgpr_128 = S_ADD_U32 $sgpr104, 7, implicit-def dead $scc
    %0.sub3 = S_XOR_B32 $sgpr104, 31, implicit-def dead $scc
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103
    KILL %0.sub1, %0.sub3
    S_ENDPGM 0
...
---
name: wholly_undef_path
# A wholly undefined subregister definition need not be stored. The real
# definition on the other predecessor still needs a partial spill.
# CHECK-LABEL: name: wholly_undef_path
# CHECK: bb.1:
# CHECK: SI_SPILL_S32_SAVE_PARTIAL {{.*}}.sub0, %stack.0, 0
# CHECK: bb.2:
# CHECK: IMPLICIT_DEF
# CHECK-NOT: SI_SPILL
# CHECK: bb.3:
# CHECK: SI_SPILL_S64_RESTORE %stack.0

tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 1
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr104, $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1
  bb.1:
    successors: %bb.3
    liveins: $sgpr104
    undef %0.sub0:sreg_64 = S_ADD_U32 $sgpr104, 7, implicit-def dead $scc
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103, implicit-def $sgpr104_sgpr105, implicit-def $vcc
    S_BRANCH %bb.3
  bb.2:
    successors: %bb.3
    undef %0.sub0:sreg_64 = IMPLICIT_DEF
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103, implicit-def $sgpr104_sgpr105, implicit-def $vcc
    S_BRANCH %bb.3
  bb.3:
    KILL %0.sub0
    S_ENDPGM 0
...
---
name: preserving_implicit_def
# A preserving partial IMPLICIT_DEF retains the real value in sub0. It must
# still be stored before the physical-register clobbers and reloaded afterward.
# The basic allocator exercises ordinary spill insertion at IMPLICIT_DEF;
# greedy hoists the store to that definition from a later split copy.
# CHECK-LABEL: name: preserving_implicit_def
# CHECK: undef [[SRC:%[0-9]+]].sub0:sreg_64 = S_ADD_U32
# CHECK-NEXT: [[SRC]].sub1:sreg_64 = IMPLICIT_DEF
# CHECK-NEXT: SI_SPILL_S64_SAVE [[SRC]], %stack.0
# CHECK: SI_SPILL_S64_RESTORE %stack.0
# BASIC-LABEL: name: preserving_implicit_def
# BASIC: S_ADD_U32
# BASIC-NEXT: SI_SPILL_S32_SAVE_PARTIAL {{.*}}.sub0, %stack.0, 0
# BASIC-NEXT: [[SRC:%[0-9]+]]:sreg_64 = SI_SPILL_S64_RESTORE %stack.0
# BASIC-NEXT: [[SRC]].sub1:sreg_64 = IMPLICIT_DEF
# BASIC-NEXT: SI_SPILL_S64_SAVE [[SRC]], %stack.0
# BASIC: SI_SPILL_S64_RESTORE %stack.0

tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 1
body: |
  bb.0:
    liveins: $sgpr104
    undef %0.sub0:sreg_64 = S_ADD_U32 $sgpr104, 7, implicit-def dead $scc
    %0.sub1 = IMPLICIT_DEF
    KILL implicit-def $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29_sgpr30_sgpr31, implicit-def $sgpr32_sgpr33_sgpr34_sgpr35, implicit-def $sgpr36_sgpr37_sgpr38_sgpr39, implicit-def $sgpr40_sgpr41_sgpr42_sgpr43, implicit-def $sgpr44_sgpr45_sgpr46_sgpr47, implicit-def $sgpr48_sgpr49_sgpr50_sgpr51, implicit-def $sgpr52_sgpr53_sgpr54_sgpr55, implicit-def $sgpr56_sgpr57_sgpr58_sgpr59, implicit-def $sgpr60_sgpr61_sgpr62_sgpr63, implicit-def $sgpr64_sgpr65_sgpr66_sgpr67, implicit-def $sgpr68_sgpr69_sgpr70_sgpr71, implicit-def $sgpr72_sgpr73_sgpr74_sgpr75, implicit-def $sgpr76_sgpr77_sgpr78_sgpr79, implicit-def $sgpr80_sgpr81_sgpr82_sgpr83, implicit-def $sgpr84_sgpr85_sgpr86_sgpr87, implicit-def $sgpr88_sgpr89_sgpr90_sgpr91, implicit-def $sgpr92_sgpr93_sgpr94_sgpr95, implicit-def $sgpr96_sgpr97_sgpr98_sgpr99, implicit-def $sgpr100_sgpr101_sgpr102_sgpr103, implicit-def $sgpr104_sgpr105, implicit-def $vcc
    KILL %0
    S_ENDPGM 0
...
