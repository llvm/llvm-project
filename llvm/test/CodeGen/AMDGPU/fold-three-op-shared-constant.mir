# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-fold-operands -verify-machineinstrs -o - %s | FileCheck %s

# Three pairs share both literals, so one move each pays for the fusions.
---
name: and_or_shared
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: and_or_shared
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 983055
    ; CHECK-NEXT: [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 1677747200
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1677747200, implicit $exec
    ; CHECK-NEXT: [[V_AND_OR_B32_e64_:%[0-9]+]]:vgpr_32 = V_AND_OR_B32_e64 [[COPY]], [[S_MOV_B32_]], [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[V_AND_OR_B32_e64_1:%[0-9]+]]:vgpr_32 = V_AND_OR_B32_e64 [[COPY1]], [[S_MOV_B32_]], [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[V_AND_OR_B32_e64_2:%[0-9]+]]:vgpr_32 = V_AND_OR_B32_e64 [[COPY2]], [[S_MOV_B32_]], [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_AND_OR_B32_e64_]], implicit [[V_AND_OR_B32_e64_1]], implicit [[V_AND_OR_B32_e64_2]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = COPY $vgpr2
    %3:sreg_32 = S_MOV_B32 983055
    %4:sreg_32 = S_MOV_B32 1677747200
    %5:vgpr_32 = V_AND_B32_e64 %0, %3, implicit $exec
    %6:vgpr_32 = V_OR_B32_e64 %5, %4, implicit $exec
    %7:vgpr_32 = V_AND_B32_e64 %1, %3, implicit $exec
    %8:vgpr_32 = V_OR_B32_e64 %7, %4, implicit $exec
    %9:vgpr_32 = V_AND_B32_e64 %2, %3, implicit $exec
    %10:vgpr_32 = V_OR_B32_e64 %9, %4, implicit $exec
    S_ENDPGM 0, implicit %6, implicit %8, implicit %10
...

# Two pairs only break even.
---
name: and_or_shared_twice
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: and_or_shared_twice
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 983055
    ; CHECK-NEXT: [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 1677747200
    ; CHECK-NEXT: [[V_AND_B32_e64_:%[0-9]+]]:vgpr_32 = V_AND_B32_e64 [[COPY]], [[S_MOV_B32_]], implicit $exec
    ; CHECK-NEXT: [[V_OR_B32_e64_:%[0-9]+]]:vgpr_32 = V_OR_B32_e64 [[V_AND_B32_e64_]], [[S_MOV_B32_1]], implicit $exec
    ; CHECK-NEXT: [[V_AND_B32_e64_1:%[0-9]+]]:vgpr_32 = V_AND_B32_e64 [[COPY1]], [[S_MOV_B32_]], implicit $exec
    ; CHECK-NEXT: [[V_OR_B32_e64_1:%[0-9]+]]:vgpr_32 = V_OR_B32_e64 [[V_AND_B32_e64_1]], [[S_MOV_B32_1]], implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_OR_B32_e64_]], implicit [[V_OR_B32_e64_1]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %3:sreg_32 = S_MOV_B32 983055
    %4:sreg_32 = S_MOV_B32 1677747200
    %5:vgpr_32 = V_AND_B32_e64 %0, %3, implicit $exec
    %6:vgpr_32 = V_OR_B32_e64 %5, %4, implicit $exec
    %7:vgpr_32 = V_AND_B32_e64 %1, %3, implicit $exec
    %8:vgpr_32 = V_OR_B32_e64 %7, %4, implicit $exec
    S_ENDPGM 0, implicit %6, implicit %8
...

# A shared literal moves to a VGPR, leaving the bus to the uniform shift amount.
---
name: add_lshl_shared_with_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr0
    ; CHECK-LABEL: name: add_lshl_shared_with_sgpr
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 983055
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 983055, implicit $exec
    ; CHECK-NEXT: [[V_ADD_LSHL_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_LSHL_U32_e64 [[COPY]], [[V_MOV_B32_e32_]], [[COPY3]], implicit $exec
    ; CHECK-NEXT: [[V_ADD_LSHL_U32_e64_1:%[0-9]+]]:vgpr_32 = V_ADD_LSHL_U32_e64 [[COPY1]], [[V_MOV_B32_e32_]], [[COPY3]], implicit $exec
    ; CHECK-NEXT: [[V_ADD_LSHL_U32_e64_2:%[0-9]+]]:vgpr_32 = V_ADD_LSHL_U32_e64 [[COPY2]], [[V_MOV_B32_e32_]], [[COPY3]], implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_ADD_LSHL_U32_e64_]], implicit [[V_ADD_LSHL_U32_e64_1]], implicit [[V_ADD_LSHL_U32_e64_2]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = COPY $vgpr2
    %3:sreg_32 = COPY $sgpr0
    %4:sreg_32 = S_MOV_B32 983055
    %5:vgpr_32 = V_ADD_U32_e64 %0, %4, 0, implicit $exec
    %6:vgpr_32 = V_LSHLREV_B32_e64 %3, %5, implicit $exec
    %7:vgpr_32 = V_ADD_U32_e64 %1, %4, 0, implicit $exec
    %8:vgpr_32 = V_LSHLREV_B32_e64 %3, %7, implicit $exec
    %9:vgpr_32 = V_ADD_U32_e64 %2, %4, 0, implicit $exec
    %10:vgpr_32 = V_LSHLREV_B32_e64 %3, %9, implicit $exec
    S_ENDPGM 0, implicit %6, implicit %8, implicit %10
...

# Inner operands keep undef.
---
name: and_or_shared_flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: and_or_shared_flags
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 983055
    ; CHECK-NEXT: [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 1677747200
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1677747200, implicit $exec
    ; CHECK-NEXT: [[V_AND_OR_B32_e64_:%[0-9]+]]:vgpr_32 = V_AND_OR_B32_e64 undef %5:vgpr_32, [[S_MOV_B32_]], [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[V_AND_OR_B32_e64_1:%[0-9]+]]:vgpr_32 = V_AND_OR_B32_e64 [[COPY]], [[S_MOV_B32_]], [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[V_AND_OR_B32_e64_2:%[0-9]+]]:vgpr_32 = V_AND_OR_B32_e64 [[COPY1]], [[S_MOV_B32_]], [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_AND_OR_B32_e64_]], implicit [[V_AND_OR_B32_e64_1]], implicit [[V_AND_OR_B32_e64_2]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %3:sreg_32 = S_MOV_B32 983055
    %4:sreg_32 = S_MOV_B32 1677747200
    %5:vgpr_32 = V_AND_B32_e64 undef %2:vgpr_32, %3, implicit $exec
    %7:vgpr_32 = V_AND_B32_e64 %0, %3, implicit $exec
    %9:vgpr_32 = V_AND_B32_e64 %1, %3, implicit $exec
    %6:vgpr_32 = V_OR_B32_e64 %5, %4, implicit $exec
    %8:vgpr_32 = V_OR_B32_e64 %7, %4, implicit $exec
    %10:vgpr_32 = V_OR_B32_e64 %9, %4, implicit $exec
    S_ENDPGM 0, implicit %6, implicit %8, implicit %10
...
