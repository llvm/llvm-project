# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=liveintervals,phi-node-elimination -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes='require<live-intervals>,phi-node-elimination' -o - %s | FileCheck %s

# The sub0 lane is read in %bb.1, which follows %bb.2 in index order,
# so the lane's segment continues past %bb.2. Trimming the lane at the
# copy inserted in %bb.2 must not remove its liveness in %bb.1.

---
name:            phi_src_lane_read_in_later_pred
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_src_lane_read_in_later_pred
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[V_MOV_B32_e32_]], %subreg.sub0, [[V_MOV_B32_e32_]], %subreg.sub1
  ; CHECK-NEXT:   $scc = IMPLICIT_DEF
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_64 = COPY [[REG_SEQUENCE]]
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit [[REG_SEQUENCE]].sub0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_64 = COPY [[REG_SEQUENCE]]
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vreg_64 = COPY [[COPY]]
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[COPY1]]
  bb.0:
    successors: %bb.1, %bb.2

    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %1:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %0, %subreg.sub1
    $scc = IMPLICIT_DEF
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.2:
    successors: %bb.3

    S_BRANCH %bb.3

  bb.1:
    successors: %bb.3

    S_NOP 0, implicit %1.sub0
    S_BRANCH %bb.3

  bb.3:
    %2:vreg_64 = PHI %1, %bb.2, %1, %bb.1
    S_ENDPGM 0, implicit %2
...
