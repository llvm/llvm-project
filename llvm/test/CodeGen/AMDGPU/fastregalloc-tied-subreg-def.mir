# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -passes=regallocfast -o - %s | FileCheck %s

# The implicit def created for the read-undef of the subregister of P2 must not
# free the assigment before the tied use is allocated.

---
name: tied_subreg_interpolation
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0

    ; CHECK-LABEL: name: tied_subreg_interpolation
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $vgpr2 = COPY killed $vgpr1
    ; CHECK-NEXT: $m0 = COPY killed $sgpr0
    ; CHECK-NEXT: undef renamable $vgpr0 = V_INTERP_P1_F32 killed $vgpr0, 0, 1, implicit $mode, implicit $m0, implicit $exec, implicit-def $vgpr0_vgpr1
    ; CHECK-NEXT: undef renamable $vgpr0 = V_INTERP_P2_F32 $vgpr0, killed $vgpr2, 0, 1, implicit $mode, implicit $m0, implicit $exec, implicit-def $vgpr0_vgpr1
    ; CHECK-NEXT: renamable $vgpr1 = V_MOV_B32_e32 1065353216, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit killed $vgpr0_vgpr1
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    $m0 = COPY $sgpr0
    undef %2.sub0:vreg_64 = V_INTERP_P1_F32 %0, 0, 1, implicit $mode, implicit $m0, implicit $exec
    undef %2.sub0:vreg_64 = V_INTERP_P2_F32 %2.sub0, %1, 0, 1, implicit $mode, implicit $m0, implicit $exec
    %2.sub1:vreg_64 = V_MOV_B32_e32 1065353216, implicit $exec
    $vgpr0_vgpr1 = COPY %2
    S_ENDPGM 0, implicit $vgpr0_vgpr1
...
