# The COPY source is clobbered before the DBG_VALUE, so it must not be used.
name:            dead_copy_physreg_src
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; DCE-LABEL: name: dead_copy_physreg_src
    ; DCE: liveins: $vgpr0
    ; DCE-NEXT: {{  $}}
    ; DCE-NEXT: $vgpr0 = V_MOV_B32_e32 0, implicit $exec
