# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu6.00 -run-pass livevars -run-pass phi-node-elimination -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu6.00 --passes='require<live-vars>,phi-node-elimination' -verify-each -o - %s | FileCheck %s

# The DBG_VALUE in front of SI_END_CF must not move the copy for %5 above it.

--- |
  define amdgpu_kernel void @phi_dbg_before_end_cf() !dbg !4 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "phi_dbg_before_end_cf", scope: !1, file: !1, type: !5, unit: !0, spFlags: DISPFlagDefinition)
  !5 = !DISubroutineType(types: !{})
  !6 = !DILocalVariable(name: "x", scope: !4, file: !1)
  !7 = !DILocation(line: 1, scope: !4)
...
---
name: phi_dbg_before_end_cf
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_dbg_before_end_cf
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_EQ_U32_e64 0, [[COPY]], implicit $exec
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[V_MOV_B32_e32_]]
  ; CHECK-NEXT:   [[SI_IF:%[0-9]+]]:sreg_64 = SI_IF [[V_CMP_EQ_U32_e64_]], %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   [[S_MOV_B64_term:%[0-9]+]]:sreg_64 = S_MOV_B64_term [[SI_IF]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[V_MOV_B32_e32_1]]
  ; CHECK-NEXT:   [[S_MOV_B64_term:%[0-9]+]]:sreg_64 = COPY [[SI_IF]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   DBG_VALUE %5, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = bb-prolog COPY [[S_MOV_B64_term]]
  ; CHECK-NEXT:   bb-prolog SI_END_CF [[COPY2]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[COPY3]]
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sreg_64 = V_CMP_EQ_U32_e64 0, %0, implicit $exec
    %2:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %3:sreg_64 = SI_IF %1, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2

    %4:vgpr_32 = V_MOV_B32_e32 1, implicit $exec

  bb.2:
    %5:vgpr_32 = PHI %2, %bb.0, %4, %bb.1
    %6:sreg_64 = PHI %3, %bb.0, %3, %bb.1
    DBG_VALUE %5, $noreg, !6, !DIExpression(), debug-location !7
    bb-prolog SI_END_CF %6, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_ENDPGM 0, implicit %5
...
