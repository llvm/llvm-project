# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -mattr=+real-true16 -run-pass=si-fold-operands -o - %s | FileCheck %s

# Check that the bf16 encoding of 1.0 is recognized as an inline constant in
# each source of v_fma_mix_bf16_t16.

---
name:            fold_bf16_one_into_src0
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: fold_bf16_one_into_src0
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[V_FMA_MIX_BF16_t16_:%[0-9]+]]:vgpr_16 = nofpexcept V_FMA_MIX_BF16_t16 4, 16256, 0, [[COPY]], 0, [[COPY1]], 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_FMA_MIX_BF16_t16_]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_32 = S_MOV_B32 16256
    %3:vgpr_16 = nofpexcept V_FMA_MIX_BF16_t16 0, %2, 0, %0, 0, %1, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %3
...

