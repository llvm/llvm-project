# RUN: llc -mtriple=amdgpu12.00 -start-before=amdgpu-insert-delay-alu %s -o - | FileCheck %s

# Check SALU delays for SGPRs written by message and barrier instructions,
# whose results are not produced by the scalar ALU, compared with an ordinary
# SALU instruction.

---
name: salu_to_salu
body: |
  bb.0:
    ; CHECK-LABEL: {{^}}salu_to_salu:
    ; CHECK: %bb.0:
    ; CHECK-NEXT: s_mov_b32 s0, 1
    ; CHECK-NEXT: s_delay_alu instid0(SALU_CYCLE_1)
    ; CHECK-NEXT: s_and_b32 s1, s0, 0x3ff
    $sgpr0 = S_MOV_B32 1
    $sgpr1 = S_AND_B32 $sgpr0, 1023, implicit-def $scc
...

---
name: sendmsg_rtn_to_salu
body: |
  bb.0:
    ; CHECK-LABEL: {{^}}sendmsg_rtn_to_salu:
    ; CHECK: %bb.0:
    ; CHECK-NEXT: s_sendmsg_rtn_b32 s0, sendmsg(MSG_RTN_GET_DOORBELL)
    ; CHECK-NEXT: s_and_b32 s1, s0, 0x3ff
    $sgpr0 = S_SENDMSG_RTN_B32 128
    $sgpr1 = S_AND_B32 $sgpr0, 1023, implicit-def $scc
...

---
name: get_barrier_state_to_salu
body: |
  bb.0:
    ; CHECK-LABEL: {{^}}get_barrier_state_to_salu:
    ; CHECK: %bb.0:
    ; CHECK-NEXT: s_get_barrier_state s0, -1
    ; CHECK-NEXT: s_and_b32 s1, s0, 0x3ff
    $sgpr0 = S_GET_BARRIER_STATE_IMM -1
    $sgpr1 = S_AND_B32 $sgpr0, 1023, implicit-def $scc
...
