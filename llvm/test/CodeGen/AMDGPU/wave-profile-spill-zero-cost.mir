# REQUIRES: amdgpu-registered-target
# RUN: %if asserts %{ llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=spill-code-placement -enable-wave-profiled-spill -debug-only=spill-code-placement -filetype=null %s 2>&1 | FileCheck %s %}

# A measured zero count must still give a reachable block a positive spill cost.
# CHECK: Wave spill frequency diamond %bb.1 = 1 (entry {{[0-9]+}})

--- |
  target triple = "amdgcn-amd-amdhsa"
  define void @diamond() !wave.profile !0 {
  entry:
    br label %cold, !wave.profile.block !1
  cold:
    ret void, !wave.profile.block !2
  }
  !0 = distinct !{i64 2, i64 -1959029408237692815, i64 100, i64 0}
  !1 = !{i64 2, i64 -1959029408237692815, i64 0, i64 1, i64 1}
  !2 = !{i64 2, i64 -1959029408237692815, i64 1, i64 1}
...
---
name: diamond
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    S_BRANCH %bb.1
  bb.1.cold:
    S_ENDPGM 0
...
