    ; NOHAZARD-NEXT: $vgpr10, $vgpr9 = V_DUAL_MUL_F32_e32_X_FMA_F32_e64_e96_gfx1250 0, $vgpr0, 0, $vgpr1, 0, $vgpr15, 0, $vgpr8, 0, $vgpr7, implicit $mode, implicit $exec, implicit $mode, implicit $exec, implicit $mode, implicit $exec
    $vgpr0 = IMPLICIT_DEF
    $vgpr1 = IMPLICIT_DEF
    $vgpr7 = IMPLICIT_DEF
    $vgpr8 = IMPLICIT_DEF
    $vgpr15 = IMPLICIT_DEF
