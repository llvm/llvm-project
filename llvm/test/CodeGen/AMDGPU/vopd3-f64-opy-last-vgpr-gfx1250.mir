    $vgpr4_vgpr5 = IMPLICIT_DEF
    $vgpr7 = IMPLICIT_DEF
    $vgpr8 = IMPLICIT_DEF
    $vgpr14_vgpr15 = IMPLICIT_DEF
    $vgpr10_vgpr11 = V_FMA_F64_e64 0, $vgpr14_vgpr15, 0, $vgpr2_vgpr3, 0, $vgpr4_vgpr5, 0, 0, implicit $mode, implicit $exec
