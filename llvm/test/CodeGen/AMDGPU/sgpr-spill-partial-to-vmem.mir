# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu8.03-amd-amdhsa -amdgpu-spill-sgpr-to-vgpr=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s

# A spill of a sub-register writes only a part of the stack slot: here the
# second dword of %stack.0, while the first one is written by another spill to
# the same slot.
#
# The lanes of the temporary VGPR hold the dwords of the slot, so only the
# lanes of this part may be stored. When an SGPR can be scavenged to save EXEC,
# EXEC is set to the lane mask of this part and a single store writes just
# those lanes. Without a free SGPR, EXEC cannot be set to an arbitrary mask and
# the store has to write every lane, so the slot is read in first to write the
# lanes of the other parts back unchanged.

---
name: partial_sgpr_spill_to_vmem_free_sgpr
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, offset: 0, size: 8, alignment: 4, stack-id: sgpr-spill }

machineFunctionInfo:
  scratchRSrcReg:  $sgpr0_sgpr1_sgpr2_sgpr3
  frameOffsetReg:  $sgpr33
  stackPtrOffsetReg:  $sgpr32

body:             |
  bb.0:
    liveins: $sgpr8

    ; CHECK-LABEL: name: partial_sgpr_spill_to_vmem_free_sgpr
    ; CHECK: liveins: $sgpr8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION llvm_def_aspace_cfa $sgpr32, 0, 6
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION llvm_register_pair $pc_reg, $sgpr30, 32, $sgpr31, 32
    ; CHECK-NEXT: $sgpr4_sgpr5 = S_MOV_B64 $exec
    ; CHECK-NEXT: $exec = S_MOV_B64 2, implicit-def $vgpr0
    ; CHECK-NEXT: BUFFER_STORE_DWORD_OFFSET killed $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 8, 0, 0, implicit $exec :: ("amdgpu-thread-private" store (s32) into %stack.1, addrspace 5)
    ; CHECK-NEXT: $vgpr0 = SI_SPILL_S32_TO_VGPR $sgpr8, 1, undef $vgpr0
    ; CHECK-NEXT: BUFFER_STORE_DWORD_OFFSET killed $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 0, 0, 0, implicit $exec :: ("amdgpu-thread-private" store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr0 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr32, 8, 0, 0, implicit $exec :: ("amdgpu-thread-private" load (s32) from %stack.1, addrspace 5)
    ; CHECK-NEXT: $exec = S_MOV_B64 killed $sgpr4_sgpr5, implicit killed $vgpr0
    ; CHECK-NEXT: S_ENDPGM 0
    SI_SPILL_S32_SAVE $sgpr8, %stack.0, 4, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.0 + 4, addrspace 5)
    S_ENDPGM 0
...

