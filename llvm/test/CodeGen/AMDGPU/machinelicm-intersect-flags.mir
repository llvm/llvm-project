# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50 -passes=early-machinelicm -o - %s | FileCheck %s

# A hoisted instruction that is merged into an identical one in the preheader
# keeps only the flags that both instructions have.

---
name: licm_cse
body: |
  ; CHECK-LABEL: name: licm_cse
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vreg_64_align2 = COPY $vgpr2_vgpr3
  ; CHECK-NEXT:   [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 [[COPY]], [[COPY1]], 0, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   GLOBAL_STORE_DWORD [[COPY3]], [[V_ADD_U32_e64_]], 0, 0, implicit $exec
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[COPY2]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[V_ADD_U32_e64_]]
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3, $sgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_32 = COPY $sgpr0
    %3:vreg_64_align2 = COPY $vgpr2_vgpr3
    %4:vgpr_32 = nuw nsw V_ADD_U32_e64 %0, %1, 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    %5:vgpr_32 = V_ADD_U32_e64 %0, %1, 0, implicit $exec
    GLOBAL_STORE_DWORD %3, %5, 0, 0, implicit $exec
    S_CMP_EQ_U32 %2, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0, implicit %4
...
