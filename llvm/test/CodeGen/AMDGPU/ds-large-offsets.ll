  %lane = and i32 %id, 63
  %idx = shl i32 %lane, 4
  %base = getelementptr i8, ptr addrspace(3) @lds, i32 %idx
  %p0 = getelementptr i8, ptr addrspace(3) %base, i32 131000
  %p1 = getelementptr i8, ptr addrspace(3) %base, i32 132000
  %a = call <4 x i16> @llvm.amdgcn.ds.read.tr16.b64.v4i16.p3(ptr addrspace(3) %p0)
