; Two buffers 8 KiB apart on one lane base fit in a single 64 KiB window.
define amdgpu_kernel void @two_buffers(ptr addrspace(1) %out) {
; CHECK-LABEL: two_buffers:
; CHECK:    v_add_u32_e32 v6, 0x21340, v0
; CHECK:    ds_read_b64_tr_b16 v[0:1], v6
; CHECK:    ds_read_b64_tr_b16 v[2:3], v6 offset:256
; CHECK:    ds_read_b64_tr_b16 v[4:5], v6 offset:8448
; CHECK:    ds_read_b64_tr_b16 v[6:7], v6 offset:8704
  %id = call i32 @llvm.amdgcn.workitem.id.x()
  %lane = and i32 %id, 63
  %idx = shl i32 %lane, 4
  %base = getelementptr i8, ptr addrspace(3) @lds, i32 %idx
  %q0 = getelementptr i8, ptr addrspace(3) %base, i32 136000
  %q1 = getelementptr i8, ptr addrspace(3) %q0, i32 256
  %p0 = getelementptr i8, ptr addrspace(3) %base, i32 144448
  %p1 = getelementptr i8, ptr addrspace(3) %p0, i32 256
  %a = call <4 x i16> @llvm.amdgcn.ds.read.tr16.b64.v4i16.p3(ptr addrspace(3) %q0)
  %b = call <4 x i16> @llvm.amdgcn.ds.read.tr16.b64.v4i16.p3(ptr addrspace(3) %q1)
  %c = call <4 x i16> @llvm.amdgcn.ds.read.tr16.b64.v4i16.p3(ptr addrspace(3) %p0)
  %d = call <4 x i16> @llvm.amdgcn.ds.read.tr16.b64.v4i16.p3(ptr addrspace(3) %p1)
  %ab = xor <4 x i16> %a, %b
  %cd = xor <4 x i16> %c, %d
  %abcd = xor <4 x i16> %ab, %cd
  store <4 x i16> %abcd, ptr addrspace(1) %out, align 8
  ret void
}

