# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu7.00-amd-amdhsa \
# RUN:   -passes='greedy<sgpr>,virt-reg-rewriter<no-clear-vregs>' -o - %s \
# RUN:   | FileCheck %s

# A restore must not be forwarded from an earlier save of the same slot if
# something between them changes the register or the implicit inputs of the
# save and the restore, even though both registers are assigned $sgpr0. The
# stack accesses are part of the input. A save of an undef register does not
# define the slot contents, so there is nothing to forward.
--- |
  define void @gap_exec_change() { ret void }
  define void @gap_redefines_register() { ret void }
  define void @gap_call_clobber() { ret void }
  define void @undef_save_no_segment() { ret void }
  define void @undef_save_earlier_segment() { ret void }
...

# The gap changes EXEC, an implicit input of the save and the restore.
---
name: gap_exec_change
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $sgpr48, $sgpr49
    ; CHECK-LABEL: name: gap_exec_change
    ; CHECK: liveins: $sgpr48, $sgpr49
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $sgpr0 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE killed renamable $sgpr0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: $exec = S_MOV_B64 -1
    ; CHECK-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: SI_RETURN implicit $sgpr0
    %0:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    SI_SPILL_S32_SAVE %0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    $exec = S_MOV_B64 -1
    %1:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    $sgpr0 = COPY %1
    SI_RETURN implicit $sgpr0
...

# The saved register is redefined in the gap, so $sgpr0 no longer holds the
# saved value.
---
name: gap_redefines_register
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $sgpr48, $sgpr49
    ; CHECK-LABEL: name: gap_redefines_register
    ; CHECK: liveins: $sgpr48, $sgpr49
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $sgpr0 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE renamable $sgpr0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: renamable $sgpr0 = S_ADD_I32 killed renamable $sgpr0, 1, implicit-def dead $scc
    ; CHECK-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; CHECK-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: SI_RETURN implicit $sgpr0
    %0:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    SI_SPILL_S32_SAVE %0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    %0:sgpr_32 = S_ADD_I32 %0, 1, implicit-def dead $scc
    S_NOP 0, implicit %0
    %1:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    $sgpr0 = COPY %1
    SI_RETURN implicit $sgpr0
...

# A register mask in the gap clobbers $sgpr0.
---
name: gap_call_clobber
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $sgpr48, $sgpr49
    ; CHECK-LABEL: name: gap_call_clobber
    ; CHECK: liveins: $sgpr48, $sgpr49
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $sgpr0 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE killed renamable $sgpr0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: S_NOP 0, csr_amdgpu
    ; CHECK-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: SI_RETURN implicit $sgpr0
    %0:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    SI_SPILL_S32_SAVE %0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    S_NOP 0, csr_amdgpu
    %1:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    $sgpr0 = COPY %1
    SI_RETURN implicit $sgpr0
...

# The undef save register has no live segment.
---
name: undef_save_no_segment
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    ; CHECK-LABEL: name: undef_save_no_segment
    ; CHECK: SI_SPILL_S32_SAVE undef renamable $sgpr0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: SI_RETURN implicit $sgpr0
    SI_SPILL_S32_SAVE undef %0:sgpr_32, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    %1:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    $sgpr0 = COPY %1
    SI_RETURN implicit $sgpr0
...

# The undef save register has an earlier, unrelated segment. Forwarding would
# extend it across %1, which is assigned the same register.
---
name: undef_save_earlier_segment
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $sgpr48, $sgpr49
    ; CHECK-LABEL: name: undef_save_earlier_segment
    ; CHECK: liveins: $sgpr48, $sgpr49
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $sgpr0 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; CHECK-NEXT: renamable $sgpr0 = S_ADD_I32 $sgpr48, 1, implicit-def dead $scc
    ; CHECK-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; CHECK-NEXT: SI_SPILL_S32_SAVE undef renamable $sgpr0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: SI_RETURN implicit $sgpr0
    %0:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    S_NOP 0, implicit %0
    %1:sgpr_32 = S_ADD_I32 $sgpr48, 1, implicit-def dead $scc
    S_NOP 0, implicit %1
    SI_SPILL_S32_SAVE undef %0, %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    %2:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    $sgpr0 = COPY %2
    SI_RETURN implicit $sgpr0
...
