name: add_co_e32_to_div_fmas_wv32
body: |
  bb.0:
    liveins: $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr6
    ; CHECK-LABEL: name: add_co_e32_to_div_fmas_wv32
    ; CHECK: liveins: $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr0 = V_ADD_CO_U32_e32 $vgpr1, $vgpr2, implicit-def $vcc_lo, implicit $exec
    ; CHECK-NEXT: S_DELAY_ALU .id0_VALU_DEP_1
    ; CHECK-NEXT: $vgpr5 = V_DIV_FMAS_F32_e64 0, $vgpr6, 0, $vgpr3, 0, $vgpr4, 0, 0, implicit $mode, implicit $vcc_lo, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr5
    $vgpr0 = V_ADD_CO_U32_e32 $vgpr1, $vgpr2, implicit-def $vcc, implicit $exec
    $vgpr5 = V_DIV_FMAS_F32_e64 0, $vgpr6, 0, $vgpr3, 0, $vgpr4, 0, 0, implicit $mode, implicit $vcc, implicit $exec
    S_ENDPGM 0, implicit $vgpr5
...
---
name: cmpx_to_valu_exec
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    ; CHECK-LABEL: name: cmpx_to_valu_exec
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: V_CMPX_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $exec, implicit-def $vcc_lo, implicit $exec
    ; CHECK-NEXT: $vgpr2 = V_ADD_F32_e32 $vgpr3, $vgpr4, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr2
    V_CMPX_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $exec, implicit-def $vcc, implicit $exec
    $vgpr2 = V_ADD_F32_e32 $vgpr3, $vgpr4, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...
---
name: cmpx_to_readlane_exec_no_ff_and_no_delay
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3
    ; CHECK-LABEL: name: cmpx_to_readlane_exec_no_ff_and_no_delay
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: V_CMPX_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $exec, implicit-def $vcc_lo, implicit $exec
    ; CHECK-NEXT: $sgpr0 = V_READLANE_B32 $vgpr3, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $sgpr0
    V_CMPX_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $exec, implicit-def $vcc, implicit $exec
    $sgpr0 = V_READLANE_B32 $vgpr3, 0, implicit $exec
    S_ENDPGM 0, implicit $sgpr0
...
---
name: cmp_to_div_fmas_vcc_as_data_negative
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4
    ; CHECK-LABEL: name: cmp_to_div_fmas_vcc_as_data_negative
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vcc_lo = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_DELAY_ALU .id0_VALU_DEP_1
    ; CHECK-NEXT: $vgpr5 = V_DIV_FMAS_F32_e64 0, $vgpr2, 0, $vgpr3, 0, $vgpr4, 0, 0, implicit $mode, implicit $vcc_lo, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr5
    $vcc_lo = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    $vgpr5 = V_DIV_FMAS_F32_e64 0, $vgpr2, 0, $vgpr3, 0, $vgpr4, 0, 0, implicit $mode, implicit $vcc, implicit $exec
    S_ENDPGM 0, implicit $vgpr5
...
---
name: sgpr_merge_mixed_keeps_delay
body: |
  ; CHECK-LABEL: name: sgpr_merge_mixed_keeps_delay
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vcc_lo = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.2, implicit $vcc_lo
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0 = V_READFIRSTLANE_B32 $vgpr2, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $vgpr3, $vgpr4, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_DELAY_ALU .id0_VALU_DEP_1
  ; CHECK-NEXT:   $vgpr5 = V_CNDMASK_B32_e64 0, $vgpr3, 0, $vgpr4, $sgpr0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $vgpr5
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4
    successors: %bb.1, %bb.2
    $vcc_lo = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    liveins: $vgpr0, $vgpr1
    successors: %bb.3
    ; FF path: compare publishes $sgpr0 as an FF producer.
    $sgpr0 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    liveins: $vgpr2
    successors: %bb.3
    ; non-FF path: VALU SGPR producer (not FF-capable for this consumer).
    $sgpr0 = V_READFIRSTLANE_B32 $vgpr2, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    liveins: $vgpr3, $vgpr4, $sgpr0
    $vgpr5 = V_CNDMASK_B32_e64 0, $vgpr3, 0, $vgpr4, $sgpr0, implicit $exec
    S_ENDPGM 0, implicit $vgpr5
...

