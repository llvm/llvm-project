# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu12.00 -mattr=+wavefrontsize32 -run-pass=amdgpu-insert-delay-alu %s -o - | FileCheck %s

# Explicit (e64) VCC/SGPR fast-forward edges. No s_delay_alu for
# { carry-out } -> { carry-in / cndmask }.
# Implicit (e32) VCC fast-forward edges. No s_delay_alu for
# { carry-out / compare } -> { carry-in / cndmask }.
# EXEC fast-forward edge. No s_delay_alu for
# { V_CMPX } -> { VALU using implicit $exec }.
---
name: add_co_to_addc_e64
body: |
  bb.0:
  liveins: $vgpr2, $vgpr3, $vgpr4, $vgpr5
    ; CHECK-LABEL: name: add_co_to_addc_e64
    ; CHECK: liveins: $vgpr2, $vgpr3, $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr2, $vcc_lo = V_ADD_CO_U32_e64 $vgpr2, $vgpr4, 0, implicit $exec
    ; CHECK-NEXT: $vgpr3, $vcc_lo = V_ADDC_U32_e64 $vgpr3, $vgpr5, $vcc_lo, 0, implicit $exec
    $vgpr2, $vcc_lo = V_ADD_CO_U32_e64 $vgpr2, $vgpr4, 0, implicit $exec
    $vgpr3, $vcc_lo = V_ADDC_U32_e64 $vgpr3, $vgpr5, $vcc_lo, 0, implicit $exec
...
---
name: add_co_to_addc_e64_sgpr
body: |
  bb.0:
  liveins: $vgpr2, $vgpr3, $vgpr4, $vgpr5
    ; CHECK-LABEL: name: add_co_to_addc_e64_sgpr
    ; CHECK: liveins: $vgpr2, $vgpr3, $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr2, $sgpr0 = V_ADD_CO_U32_e64 $vgpr2, $vgpr4, 0, implicit $exec
    ; CHECK-NEXT: $vgpr3, $sgpr0 = V_ADDC_U32_e64 $vgpr3, $vgpr5, $sgpr0, 0, implicit $exec
    $vgpr2, $sgpr0 = V_ADD_CO_U32_e64 $vgpr2, $vgpr4, 0, implicit $exec
    $vgpr3, $sgpr0 = V_ADDC_U32_e64 $vgpr3, $vgpr5, $sgpr0, 0, implicit $exec
...
---
name: sub_co_to_subb_e64
