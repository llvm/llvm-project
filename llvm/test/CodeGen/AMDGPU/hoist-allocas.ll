; CHECK:       [[A]]:
; CHECK-NEXT:    [[X:%.*]] = alloca i32, align 4, addrspace(5)
; CHECK-NEXT:    store volatile i32 [[V]], ptr addrspace(5) [[X]], align 4
; CHECK-NEXT:    br i1 [[C1]], label %[[B]], label %[[EXIT:.*]]
; CHECK:       [[B]]:
; CHECK-NEXT:    [[Y:%.*]] = alloca i32, align 4, addrspace(5)
; CHECK-NEXT:    store volatile i32 [[V]], ptr addrspace(5) [[Y]], align 4
; CHECK-NEXT:    br i1 [[C2]], label %[[A]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c0, label %a, label %b

a:
  %x = alloca i32, align 4, addrspace(5)
  store volatile i32 %v, ptr addrspace(5) %x
  br i1 %c1, label %b, label %exit

b:
