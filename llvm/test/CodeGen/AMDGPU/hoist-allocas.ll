; RUN: opt -S -mtriple=amdgcn-amd-amdpal -passes=amdgpu-hoist-allocas %s | FileCheck %s

; Fixed size allocas outside the entry block that execute at most once are moved
; into the entry block, after any existing allocas.
define amdgpu_cs void @hoist_after_branch(i1 %cond, i32 %idx, i32 %v) {
; CHECK-LABEL: define amdgpu_cs void @hoist_after_branch(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[IDX:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IN_ENTRY:%.*]] = alloca i32, align 4, addrspace(5)
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i32], align 4, addrspace(5)
; CHECK-NEXT:    [[B:%.*]] = alloca i32, i32 4, align 16, addrspace(5)
; CHECK-NEXT:    store volatile i32 [[V]], ptr addrspace(5) [[IN_ENTRY]], align 4
; CHECK-NEXT:    br i1 [[COND]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[PA:%.*]] = getelementptr [16 x i32], ptr addrspace(5) [[A]], i32 0, i32 [[IDX]]
; CHECK-NEXT:    store volatile i32 [[V]], ptr addrspace(5) [[PA]], align 4
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[PB:%.*]] = getelementptr i32, ptr addrspace(5) [[B]], i32 [[IDX]]
; CHECK-NEXT:    store volatile i32 [[V]], ptr addrspace(5) [[PB]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %in.entry = alloca i32, align 4, addrspace(5)
  store volatile i32 %v, ptr addrspace(5) %in.entry
  br i1 %cond, label %then, label %join

then:
  %a = alloca [16 x i32], align 4, addrspace(5)
  %pa = getelementptr [16 x i32], ptr addrspace(5) %a, i32 0, i32 %idx
  store volatile i32 %v, ptr addrspace(5) %pa
  br label %join

join:
  %b = alloca i32, i32 4, align 16, addrspace(5)
  %pb = getelementptr i32, ptr addrspace(5) %b, i32 %idx
  store volatile i32 %v, ptr addrspace(5) %pb
  ret void
}

; Allocas in a loop allocate new memory on each iteration and are not moved.
define amdgpu_cs void @no_hoist_in_loop(i32 %n, i32 %idx, i32 %v) {
; CHECK-LABEL: define amdgpu_cs void @no_hoist_in_loop(
; CHECK-SAME: i32 [[N:%.*]], i32 [[IDX:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i32], align 4, addrspace(5)
; CHECK-NEXT:    [[PA:%.*]] = getelementptr [16 x i32], ptr addrspace(5) [[A]], i32 0, i32 [[IDX]]
; CHECK-NEXT:    store volatile i32 [[V]], ptr addrspace(5) [[PA]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %a = alloca [16 x i32], align 4, addrspace(5)
  %pa = getelementptr [16 x i32], ptr addrspace(5) %a, i32 0, i32 %idx
  store volatile i32 %v, ptr addrspace(5) %pa
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; Same for irreducible cycles.
