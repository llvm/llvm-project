# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=amdgpu12.50 -run-pass=none -verify-machineinstrs %t/mark.mir -o /dev/null 2>&1 | FileCheck %s -check-prefix=MARK
# RUN: not --crash llc -mtriple=amdgpu12.50 -run-pass=none -verify-machineinstrs %t/wait.mir -o /dev/null 2>&1 | FileCheck %s -check-prefix=WAIT

#--- mark.mir
# A reserved stage is as invalid as an out-of-range one.
# MARK: *** Bad machine code: invalid asyncmark stage ***
# MARK-NEXT: - function:    asyncmark_reserved_stage
# MARK: ASYNCMARK 4
---
name: asyncmark_reserved_stage
tracksRegLiveness: true
body: |
  bb.0:
    ASYNCMARK 4
    S_ENDPGM 0
...

#--- wait.mir
# WAIT: *** Bad machine code: invalid asyncmark stage ***
# WAIT-NEXT: - function:    wait_asyncmark_out_of_range
# WAIT: WAIT_ASYNCMARK 0, 17
---
name: wait_asyncmark_out_of_range
tracksRegLiveness: true
body: |
  bb.0:
    WAIT_ASYNCMARK 0, 17
    S_ENDPGM 0
...
