    ; CHECK-NEXT: $vgpr33 = V_CVT_PK_BF8_F32_sat_fake16_e64 0, killed $vgpr34, 0, killed $vgpr35, $vgpr33, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: early-clobber $vgpr24_vgpr25_vgpr26_vgpr27_vgpr28_vgpr29_vgpr30_vgpr31 = V_SWMMAC_F32_16X16X64_BF16_w32_twoaddr 8, killed $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 8, killed $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, killed $vgpr24_vgpr25_vgpr26_vgpr27_vgpr28_vgpr29_vgpr30_vgpr31, killed $vgpr32, 0, 0, 0, 0, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr33 = V_CVT_PK_BF8_F32_sat_fake16_e64 0, killed $vgpr34, 0, killed $vgpr35, $vgpr33, 0, implicit $mode, implicit $exec
