# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -run-pass si-mode-register %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu12.50 -passes=si-mode-register %s -o - | FileCheck %s

# The True16 forms of the saturating FP8 conversions need MODE.FP16_OVFL set
# too. WMMA and SWMMAC depend on it without reading the mode register.

---
name: sat_fp8_t16
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: sat_fp8_t16
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0_lo16 = V_CVT_PK_FP8_F32_gfx1250_sat_t16_e64 0, killed $vgpr1, 0, killed $vgpr2, 0, $vgpr0_lo16, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0_lo16 = V_CVT_PK_FP8_F32_gfx1250_sat_t16_e64 0, killed $vgpr1, 0, killed $vgpr2, 0, $vgpr0_lo16, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
