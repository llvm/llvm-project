# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu11.00 -mattr=+real-true16 -run-pass si-fold-operands -verify-machineinstrs %s -o - | FileCheck %s

# V_CVT_U32_U16_t16 of a 16-bit result computed from the low half of a VGPR
# whose high half is known zero becomes a REG_SEQUENCE with that high half.

---
name: lshr_subreg_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: lshr_subreg_use
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_LSHRREV_B32_e64_:%[0-9]+]]:vgpr_32 = V_LSHRREV_B32_e64 17, [[COPY]], implicit $exec
    ; CHECK-NEXT: [[V_MUL_LO_U16_t16_e64_:%[0-9]+]]:vgpr_16 = V_MUL_LO_U16_t16_e64 0, [[V_LSHRREV_B32_e64_]].lo16, 0, 3, 0, implicit $exec
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:vgpr_32 = REG_SEQUENCE [[V_MUL_LO_U16_t16_e64_]], %subreg.lo16, [[V_LSHRREV_B32_e64_]].hi16, %subreg.hi16
    ; CHECK-NEXT: $vgpr0 = COPY [[REG_SEQUENCE]]
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_LSHRREV_B32_e64 17, %0, implicit $exec
    %2:vgpr_16 = V_MUL_LO_U16_t16_e64 0, %1.lo16, 0, 3, 0, implicit $exec
    %3:vgpr_32 = V_CVT_U32_U16_t16_e64 0, %2, 0, implicit $exec
    $vgpr0 = COPY %3
    SI_RETURN implicit $vgpr0
...

