# The source is a 32-bit SGPR, which should not be the lo16 input of the
# REG_SEQUENCE. Intentional to avoid mix-sized copies like 
# %x.lo16:vgpr_32 = COPY %y:sreg_32
---
name: sgpr_src
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: sgpr_src
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[V_LSHRREV_B32_e64_:%[0-9]+]]:vgpr_32 = V_LSHRREV_B32_e64 17, [[COPY]], implicit $exec
    ; CHECK-NEXT: [[V_CMP_EQ_U16_t16_e64_:%[0-9]+]]:sreg_32 = V_CMP_EQ_U16_t16_e64 0, [[V_LSHRREV_B32_e64_]].lo16, 0, [[COPY1]].lo16, 0, implicit $exec
    ; CHECK-NEXT: [[V_CVT_U32_U16_t16_e64_:%[0-9]+]]:vgpr_32 = V_CVT_U32_U16_t16_e64 0, [[V_CMP_EQ_U16_t16_e64_]], 0, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_CVT_U32_U16_t16_e64_]]
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_LSHRREV_B32_e64 17, %0, implicit $exec
    %3:sreg_32 = V_CMP_EQ_U16_t16_e64 0, %2.lo16, 0, %1.lo16, 0, implicit $exec
    %4:vgpr_32 = V_CVT_U32_U16_t16_e64 0, %3, 0, implicit $exec
    $vgpr0 = COPY %4
    SI_RETURN implicit $vgpr0
...
