    ; CHECK-NEXT: $vgpr0 = COPY [[REG_SEQUENCE]]
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_MOV_B32_e32 16, implicit $exec
    %3:vgpr_32 = V_LSHRREV_B32_e64 %2, %0, implicit $exec
