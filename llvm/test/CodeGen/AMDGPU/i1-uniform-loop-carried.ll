  %live.next = phi i1 [ %live, %loop ], [ true, %then.hit ], [ false, %else.kill ]
  %side.next = phi i1 [ %side, %loop ], [ true, %then.hit ], [ %side, %else.kill ]
  %i.next = add i32 %i, 1
  %cont = icmp ult i32 %i.next, %n
  br i1 %cont, label %loop, label %exit

exit:
