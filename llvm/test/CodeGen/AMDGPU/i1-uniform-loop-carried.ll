  %side.end = phi i1 [ false, %entry ], [ %side.next, %latch ]
  %side.z = zext i1 %side.end to i32
  %outv = add i32 %acc.end, %side.z
  store i32 %outv, ptr addrspace(1) %base.ptr, align 4
