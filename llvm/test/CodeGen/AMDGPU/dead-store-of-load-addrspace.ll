; RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa < %s | FileCheck %s

; Verify DAGCombiner::visitSTORE checks address spaces alongside BaseIndexOffset.

; Negative: LDS (addrspace 3) and scratch (addrspace 5) both use 32-bit offsets,
; so %p_lds and %p_scratch share the exact same underlying SDValue (%off), but
; the store must not be elided across distinct address spaces.
define void @different_addrspace_lds_to_scratch_neg(i32 %off) {
; CHECK-LABEL: different_addrspace_lds_to_scratch_neg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    ds_read_b32 v1, v0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    buffer_store_dword v1, v0, s[0:3], 0 offen
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %p_lds = inttoptr i32 %off to ptr addrspace(3)
  %p_scratch = inttoptr i32 %off to ptr addrspace(5)
  %v = load i32, ptr addrspace(3) %p_lds, align 4
  store i32 %v, ptr addrspace(5) %p_scratch, align 4
  ret void
}

; Negative: global (addrspace 1) to flat (addrspace 0) with identical 64-bit
; integer address must not be elided.
define void @different_addrspace_global_to_flat_neg(i64 %addr) {
; CHECK-LABEL: different_addrspace_global_to_flat_neg:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    global_load_dword v2, v[0:1], off
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    flat_store_dword v[0:1], v2
; CHECK-NEXT:    s_waitcnt vmcnt(0) lgkmcnt(0)
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %p_global = inttoptr i64 %addr to ptr addrspace(1)
  %p_flat = inttoptr i64 %addr to ptr addrspace(0)
  %v = load i32, ptr addrspace(1) %p_global, align 4
  store i32 %v, ptr addrspace(0) %p_flat, align 4
  ret void
}

; Positive: same address space (LDS addrspace 3) with reassociated BaseIndexOffset
; (Off == 0) elides the dead store.
define i32 @same_addrspace_lds_reassoc(ptr addrspace(3) %base, i32 %idx) {
; CHECK-LABEL: same_addrspace_lds_reassoc:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_add_u32_e32 v0, 4, v1
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %p1_idx = getelementptr i8, ptr addrspace(3) %base, i32 %idx
  %p1 = getelementptr i8, ptr addrspace(3) %p1_idx, i32 4
  %v = load i32, ptr addrspace(3) %p1, align 4
  %idx_plus_4 = add i32 %idx, 4
  %p2 = getelementptr i8, ptr addrspace(3) %base, i32 %idx_plus_4
  store i32 %v, ptr addrspace(3) %p2, align 4
  ret i32 %idx_plus_4
}
