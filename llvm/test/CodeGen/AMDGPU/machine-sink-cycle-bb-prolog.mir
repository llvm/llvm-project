# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=machine-sink --sink-insts-to-avoid-spills=1 -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu9.00 -passes=machine-sink -verify-each --sink-insts-to-avoid-spills=1 -o - %s | FileCheck %s

# Cycle sinking places the copy of %1 after the block prolog of %bb.1, so the
# prolog instruction keeps reading %1 while the later use reads the copy.

---
name: cycle_sink_past_bb_prolog
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cycle_sink_past_bb_prolog
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_64 = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_64 = COPY [[COPY]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   bb-prolog SI_END_CF [[COPY1]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY [[COPY]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[COPY2]]
  ; CHECK-NEXT:   S_CBRANCH_EXECNZ %bb.1, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $sgpr0_sgpr1

    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = COPY %0

  bb.1:
    successors: %bb.1, %bb.2

    bb-prolog SI_END_CF %1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_NOP 0, implicit %1
    S_CBRANCH_EXECNZ %bb.1, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
