# RUN: llc -mtriple=amdgpu12.00 -run-pass si-insert-waitcnts -o - %s | FileCheck %s -check-prefix=GFX1200
# RUN: llc -mtriple=amdgpu12.50 -run-pass si-insert-waitcnts -o - %s | FileCheck %s -check-prefix=GFX1250

# Barriers do not drain TENSORcnt (CDNA5 ISA), so gfx1250 barrier starts
# and S_BARRIER_WAIT must drain it when the function uses tensor transfers.

---
name:            tensor_before_full_barrier
body:             |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7_sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX1250-LABEL: name: tensor_before_full_barrier
    ; GFX1250: TENSOR_LOAD_TO_LDS_d2_gfx1250
    ; GFX1250: S_WAIT_TENSORCNT 0
    ; GFX1250: S_BARRIER

    ; GFX1200-LABEL: name: tensor_before_full_barrier
    ; GFX1200: TENSOR_LOAD_TO_LDS_d2_gfx1250
    ; GFX1200-NOT: S_WAIT_TENSORCNT
    ; GFX1200: S_BARRIER

    TENSOR_LOAD_TO_LDS_d2_gfx1250 $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7_sgpr8_sgpr9_sgpr10_sgpr11, 0, 0, implicit-def dead $tensorcnt, implicit $exec, implicit $tensorcnt
    S_BARRIER
...

---
name:            tensor_before_split_barrier
body:             |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7_sgpr8_sgpr9_sgpr10_sgpr11
    ; GFX1250-LABEL: name: tensor_before_split_barrier
    ; GFX1250: TENSOR_LOAD_TO_LDS_d2_gfx1250
    ; GFX1250: S_WAIT_TENSORCNT 0
    ; GFX1250: S_BARRIER_SIGNAL_IMM -1
    ; GFX1250: S_WAIT_TENSORCNT 0
    ; GFX1250: S_BARRIER_WAIT -1

    ; GFX1200-LABEL: name: tensor_before_split_barrier
    ; GFX1200: TENSOR_LOAD_TO_LDS_d2_gfx1250
    ; GFX1200-NOT: S_WAIT_TENSORCNT
    ; GFX1200: S_BARRIER_WAIT -1

    TENSOR_LOAD_TO_LDS_d2_gfx1250 $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7_sgpr8_sgpr9_sgpr10_sgpr11, 0, 0, implicit-def dead $tensorcnt, implicit $exec, implicit $tensorcnt
    S_BARRIER_SIGNAL_IMM -1
    S_BARRIER_WAIT -1
...

---
name:            no_tensor_no_drain
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; GFX1250-LABEL: name: no_tensor_no_drain
    ; GFX1250: V_ADD_F32_e32
    ; GFX1250-NOT: S_WAIT_TENSORCNT
    ; GFX1250: S_BARRIER

    $vgpr2 = V_ADD_F32_e32 $vgpr0, $vgpr1, implicit $mode, implicit $exec
    S_BARRIER
...
