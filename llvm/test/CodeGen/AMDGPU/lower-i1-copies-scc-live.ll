; RUN: llc -mtriple=amdgpu11.00-amd-amdhsa < %s | FileCheck %s

; %c is defined in %B and used in %C, which is in the same loop, so
; SILowerI1Copies merges it with the value from previous iterations. The copy
; of %c is scheduled between the compare for the uniform branch back to %A and
; the branch itself, so the merge must not clobber SCC.

define amdgpu_kernel void @copy_to_i1_scc_live(ptr addrspace(1) %out, i32 %n, i32 %m) {
; CHECK-LABEL: copy_to_i1_scc_live:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b128 s[0:3], s[4:5], 0x0
; CHECK-NEXT:    v_dual_mov_b32 v1, 0 :: v_dual_and_b32 v0, 0x3ff, v0
; CHECK-NEXT:    s_mov_b32 s4, 0
; CHECK-NEXT:    ; implicit-def: $sgpr5
; CHECK-NEXT:    .p2align 6
; CHECK-NEXT:  .LBB0_1: ; %A
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_1) | instid1(VALU_DEP_1)
; CHECK-NEXT:    s_mov_b32 s6, s4
; CHECK-NEXT:    s_add_i32 s4, s4, 1
; CHECK-NEXT:    v_add_nc_u32_e32 v2, s6, v0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_cmp_lt_u32 s4, s2
; CHECK-NEXT:    s_cselect_b32 s8, -1, 0
; CHECK-NEXT:    s_and_not1_b32 s5, s5, exec_lo
; CHECK-NEXT:    v_cmp_class_f32_e64 s7, v2, 3
; CHECK-NEXT:    s_delay_alu instid0(VALU_DEP_1)
; CHECK-NEXT:    v_cndmask_b32_e64 v2, 7, s6, s7
; CHECK-NEXT:    s_or_b32 s5, s5, s7
; CHECK-NEXT:    s_cmp_lg_u32 s8, 0
; CHECK-NEXT:    global_store_b32 v1, v2, s[0:1] dlc
; CHECK-NEXT:    s_waitcnt_vscnt null, 0x0
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %C
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    v_cndmask_b32_e64 v2, 0, 1, s5
; CHECK-NEXT:    s_cmp_lt_u32 s4, s3
; CHECK-NEXT:    global_store_b32 v1, v2, s[0:1] dlc
; CHECK-NEXT:    s_waitcnt_vscnt null, 0x0
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_1
; CHECK-NEXT:  ; %bb.3: ; %exit
; CHECK-NEXT:    s_endpgm
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  br label %A

A:
  %i = phi i32 [ 0, %entry ], [ %inc, %B ], [ %inc, %C ]
  %inc = add i32 %i, 1
  br label %B

B:
  %cmp = icmp ult i32 %inc, %n
  %x = add i32 %tid, %i
  %f = bitcast i32 %x to float
  %c = call i1 @llvm.is.fpclass.f32(float %f, i32 3)
  %sel = select i1 %c, i32 %i, i32 7
  store volatile i32 %sel, ptr addrspace(1) %out
  br i1 %cmp, label %A, label %C

C:
  %z = zext i1 %c to i32
  store volatile i32 %z, ptr addrspace(1) %out
  %cmp2 = icmp ult i32 %inc, %m
  br i1 %cmp2, label %A, label %exit

exit:
  ret void
}
