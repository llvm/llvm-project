# RUN: llc -mtriple=amdgpu6.00 -run-pass si-shrink-instructions -o - %s | FileCheck -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu6.00 -passes si-shrink-instructions -o - %s | FileCheck -check-prefix=GCN %s
...
# GCN-LABEL: name: fold_imm_non_ssa{{$}}
# GCN: %0:vgpr_32 = V_MOV_B32_e32 123, implicit $exec
# GCN: %2:vgpr_32 = V_ADD_CO_U32_e32 456, %0, implicit-def $vcc, implicit $exec

name: fold_imm_non_ssa
tracksRegLiveness: true
body:             |
  bb.0:
    %0:vgpr_32 = COPY undef %0
    %0 = V_MOV_B32_e32 123, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 456, implicit $exec
    %2:vgpr_32, $vcc = V_ADD_CO_U32_e64 %0, %1, 0, implicit $exec
    S_ENDPGM 0

...
# GCN-LABEL: name: fold_partially_defined_superreg{{$}}
# GCN: %1:vgpr_32 = V_MOV_B32_e32 456, implicit $exec
# GCN: %2:vgpr_32 = V_ADD_CO_U32_e32 123, %1, implicit-def $vcc, implicit $exec
name: fold_partially_defined_superreg
tracksRegLiveness: true
body:             |
  bb.0:
    undef %3.sub0:vreg_64 = V_MOV_B32_e32 123, implicit $exec, implicit-def %3
    %1:vgpr_32 = V_MOV_B32_e32 456, implicit $exec
    %2:vgpr_32, $vcc = V_ADD_CO_U32_e64 %3.sub0, %1, 0, implicit $exec
    S_ENDPGM 0

...
