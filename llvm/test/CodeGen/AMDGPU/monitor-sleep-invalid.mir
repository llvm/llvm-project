# NOTE: Do not autogenerate. Check the target's MachineVerifier diagnostics.
# RUN: split-file %s %t
# RUN: llc -mtriple=amdgpu12.50 -run-pass=none -verify-machineinstrs -filetype=null %t/valid-duration.mir
# RUN: llc -mtriple=amdgpu12.51 -run-pass=none -verify-machineinstrs -filetype=null %t/valid-duration.mir
# RUN: llc -mtriple=amdgpu12.51 -run-pass=none -verify-machineinstrs -filetype=null %t/valid-forever.mir
# RUN: llc -mtriple=amdgpu13 -run-pass=none -verify-machineinstrs -filetype=null %t/gfx13.mir
# RUN: not --crash llc -mtriple=amdgpu12.51 -run-pass=none -verify-machineinstrs -filetype=null %t/duration.mir 2>&1 | FileCheck %s --check-prefix=DURATION
# RUN: not --crash llc -mtriple=amdgpu12.50 -run-pass=none -verify-machineinstrs -filetype=null %t/forever.mir 2>&1 | FileCheck %s --check-prefix=FOREVER

