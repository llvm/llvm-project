; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=amdgpu9.50-amd-amdhsa %s -o - | FileCheck %s
;
; Rescheduling an already-scheduled physreg copy next to its user must not
; leave stale read-undef flags behind. Here the scheduler moves the copy of
; the inline-asm def across the other subregister def; without the fix the
; machine verifier reports "No live segment at use" for the moved copy.

define amdgpu_kernel void @kernel() {
; CHECK-LABEL: kernel:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    v_mov_b32_e32 v5, 0
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def v4
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ds_write_b64 v5, v[4:5]
; CHECK-NEXT:    s_endpgm
  %1 = tail call i32 asm "; def $0", "=&{v4}"()
  %3 = insertelement <2 x i32> zeroinitializer, i32 %1, i64 0
  store <2 x i32> %3, ptr addrspace(3) null, align 8
  ret void
}
