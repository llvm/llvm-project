    %22:av_32 = PHI %0, %bb.0, %23, %bb.1
    %24:av_32 = PHI %0, %bb.0, %25, %bb.1
    %26:av_32 = PHI %0, %bb.0, %27, %bb.1
    %28:av_32 = PHI %0, %bb.0, %29, %bb.1
    %30:av_32 = PHI %0, %bb.0, %31, %bb.1
