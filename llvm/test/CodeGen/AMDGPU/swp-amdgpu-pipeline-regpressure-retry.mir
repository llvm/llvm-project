# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -run-pass=pipeliner -pipeliner-max-mii=256 -debug-only=pipeliner %s -filetype=null 2>&1 | FileCheck %s
# RUN: llc -mtriple=amdgpu9.08-amd-amdhsa -run-pass=pipeliner -pipeliner-max-mii=256 -debug-only=pipeliner %s -filetype=null 2>&1 | FileCheck %s --check-prefix=GFX908
# REQUIRES: asserts

# Reduced from the Triton _batched_gemm_a8w8_kernel, where pipelining a
# too-high-pressure schedule regressed gfx942 performance by ~80%.
#
# Check that the generic register-pressure detector rejects a schedule needing
# more VGPRs than the target-provided pressure-set limit and the II search
# retries.

# CHECK: Rejected the schedule because of too high register pressure
# CHECK: Schedule Found? 1

# The gfx908 pressure-set limit is lower, and the II search does not find a
# schedule within the search range.
# GFX908: Rejected the schedule because of too high register pressure
# GFX908: Schedule Found? 0

---
name:            swp_amdgpu_pipeline_regpressure_retry
tracksRegLiveness: true
isSSA:           true
machineFunctionInfo:
  isEntryFunction: true
  occupancy:       8
body:             |
  bb.0:
    %0:vgpr_32 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec
    %1:sreg_32 = S_MOV_B32 0
    %2:vreg_64_align2 = AV_MOV_B64_IMM_PSEUDO 0, implicit $exec
    %3:vreg_64_align2 = AV_MOV_B64_IMM_PSEUDO 1, implicit $exec

  bb.1:
    successors: %bb.2, %bb.1

    %4:sreg_32 = PHI %1, %bb.0, %5, %bb.1
    %6:av_32 = PHI %0, %bb.0, %7, %bb.1
    %8:av_32 = PHI %0, %bb.0, %9, %bb.1
    %10:av_32 = PHI %0, %bb.0, %11, %bb.1
    %12:av_32 = PHI %0, %bb.0, %13, %bb.1
    %14:av_32 = PHI %0, %bb.0, %15, %bb.1
