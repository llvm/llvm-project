# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu10.10 -passes=si-insert-hard-clauses %s -o - | FileCheck %s -check-prefix=GFX1010
# RUN: llc -mtriple=amdgpu10.30 -passes=si-insert-hard-clauses %s -o - | FileCheck %s -check-prefix=GFX1030

# RDNA1 (gfx101x) types loads, stores and atomics of the same memory class
# together, while RDNA2 (gfx103x) types them separately (RDNA2 ISA 12.5:
# "clause may not mix atomics, loads & stores").

---
name: flat_load_atomic
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX1010-LABEL: name: flat_load_atomic
    ; GFX1010: liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX1010-NEXT: {{  $}}
    ; GFX1010-NEXT: BUNDLE implicit-def $vgpr3, implicit-def $vgpr4, implicit $vgpr0_vgpr1, implicit $exec, implicit $flat_scr, implicit $vgpr2 {
    ; GFX1010-NEXT:   S_CLAUSE 1
    ; GFX1010-NEXT:   $vgpr3 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    ; GFX1010-NEXT:   $vgpr4 = FLAT_ATOMIC_ADD_RTN $vgpr0_vgpr1, $vgpr2, 4, 0, implicit $exec, implicit $flat_scr
    ; GFX1010-NEXT: }
    ;
    ; GFX1030-LABEL: name: flat_load_atomic
    ; GFX1030: liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX1030-NEXT: {{  $}}
    ; GFX1030-NEXT: $vgpr3 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    ; GFX1030-NEXT: $vgpr4 = FLAT_ATOMIC_ADD_RTN $vgpr0_vgpr1, $vgpr2, 4, 0, implicit $exec, implicit $flat_scr
    $vgpr3 = FLAT_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr4 = FLAT_ATOMIC_ADD_RTN $vgpr0_vgpr1, $vgpr2, 4, 0, implicit $exec, implicit $flat_scr
...
