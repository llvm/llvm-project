# RUN: llc -mtriple=amdgpu10.10 -run-pass=si-peephole-sdwa -o - %s | FileCheck -check-prefix=GFX1010 -check-prefix=GCN %s

# GCN-LABEL: {{^}}name: vop1_instructions

# GFX1010: %{{[0-9]+}}:vgpr_32 = V_MOV_B32_sdwa 0, %{{[0-9]+}}, 0, 5, 0, 5, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FRACT_F32_sdwa 0, %{{[0-9]+}}, 0, 0, 5, 0, 6, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_SIN_F32_sdwa 0, %{{[0-9]+}}, 0, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_CVT_U32_F32_sdwa 0, %{{[0-9]+}}, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_CVT_F32_I32_sdwa 0, %{{[0-9]+}}, 0, 0, 5, 0, 6, implicit $mode, implicit $exec

# GFX1010: %{{[0-9]+}}:vgpr_32 = V_MOV_B32_sdwa 0, %{{[0-9]+}}, 0, 6, 0, 5, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FRACT_F32_sdwa 0, %{{[0-9]+}}, 0, 0, 5, 0, 6, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_SIN_F32_sdwa 0, %{{[0-9]+}}, 0, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_CVT_U32_F32_sdwa 0, %{{[0-9]+}}, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_CVT_F32_I32_sdwa 0, %{{[0-9]+}}, 0, 0, 5, 0, 6, implicit $mode, implicit $exec

# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FRACT_F32_sdwa 1, %{{[0-9]+}}, 0, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_SIN_F32_sdwa 0, %{{[0-9]+}}, 1, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_CVT_U32_F32_sdwa 1, %{{[0-9]+}}, 0, 5, 0, 5, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_CVT_F32_I32_sdwa 0, %{{[0-9]+}}, 0, 1, 5, 0, 5, implicit $mode, implicit $exec

---
name:            vop1_instructions
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr30_sgpr31

    %2:sreg_64 = COPY $sgpr30_sgpr31
    %1:vreg_64 = COPY $vgpr2_vgpr3
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %3:vgpr_32 = FLAT_LOAD_DWORD %1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))

    %5:sreg_32_xm0 = S_MOV_B32 65535
    %6:sreg_32_xm0 = S_MOV_B32 65535

    %10:vgpr_32 = V_LSHRREV_B32_e64 16, %3, implicit $exec
    %11:vgpr_32 = V_MOV_B32_e32 %10, implicit $exec
    %12:vgpr_32 = V_LSHLREV_B32_e64 16, %11, implicit $exec
    %14:vgpr_32 = V_FRACT_F32_e32 123, implicit $mode, implicit $exec
    %15:vgpr_32 = V_LSHLREV_B32_e64 16, %14, implicit $exec
    %16:vgpr_32 = V_LSHRREV_B32_e64 16, %15, implicit $exec
    %17:vgpr_32 = V_SIN_F32_e32 %16, implicit $mode, implicit $exec
    %18:vgpr_32 = V_LSHLREV_B32_e64 16, %17, implicit $exec
    %19:vgpr_32 = V_LSHRREV_B32_e64 16, %18, implicit $exec
    %20:vgpr_32 = V_CVT_U32_F32_e32 %19, implicit $mode, implicit $exec
    %21:vgpr_32 = V_LSHLREV_B32_e64 16, %20, implicit $exec
    %23:vgpr_32 = V_CVT_F32_I32_e32 123, implicit $mode, implicit $exec
    %24:vgpr_32 = V_LSHLREV_B32_e64 16, %23, implicit $exec

    %25:vgpr_32 = V_LSHRREV_B32_e64 16, %3, implicit $exec
    %26:vgpr_32 = V_MOV_B32_e64 %25, implicit $exec
    %26 = V_LSHLREV_B32_e64 16, %26, implicit $exec
    %27:vgpr_32 = V_FRACT_F32_e64 0, %6, 0, 0, implicit $mode, implicit $exec
    %28:vgpr_32 = V_LSHLREV_B32_e64 16, %27, implicit $exec
    %29:vgpr_32 = V_LSHRREV_B32_e64 16, %28, implicit $exec
    %30:vgpr_32 = V_SIN_F32_e64 0, %29, 0, 0, implicit $mode, implicit $exec
    %31:vgpr_32 = V_LSHLREV_B32_e64 16, %30, implicit $exec
    %32:vgpr_32 = V_LSHRREV_B32_e64 16, %31, implicit $exec
    %33:vgpr_32 = V_CVT_U32_F32_e64 0, %32, 0, 0, implicit $mode, implicit $exec
    %34:vgpr_32 = V_LSHLREV_B32_e64 16, %33, implicit $exec
    %35:vgpr_32 = V_CVT_F32_I32_e64 %6, 0, 0, implicit $mode, implicit $exec
    %36:vgpr_32 = V_LSHLREV_B32_e64 16, %35, implicit $exec


    %37:vgpr_32 = V_LSHRREV_B32_e64 16, %36, implicit $exec
    %38:vgpr_32 = V_FRACT_F32_e64 1, %37, 0, 0, implicit $mode, implicit $exec
    %39:vgpr_32 = V_LSHLREV_B32_e64 16, %38, implicit $exec
    %40:vgpr_32 = V_LSHRREV_B32_e64 16, %39, implicit $exec
    %41:vgpr_32 = V_SIN_F32_e64 0, %40, 1, 0, implicit $mode, implicit $exec
    %42:vgpr_32 = V_LSHLREV_B32_e64 16, %41, implicit $exec
    %43:vgpr_32 = V_LSHRREV_B32_e64 16, %42, implicit $exec
    %44:vgpr_32 = V_CVT_U32_F32_e64 1, %43, 0, 0, implicit $mode, implicit $exec
    %45:vgpr_32 = V_LSHLREV_B32_e64 16, %44, implicit $exec
    %46:vgpr_32 = V_LSHRREV_B32_e64 16, %45, implicit $exec
    %47:vgpr_32 = V_CVT_F32_I32_e64 %46, 0, 1, implicit $mode, implicit $exec
    %48:vgpr_32 = V_LSHLREV_B32_e64 16, %47, implicit $exec


    %100:vgpr_32 = V_MOV_B32_e32 %48, implicit $exec

    FLAT_STORE_DWORD %0, %100, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32))
    $sgpr30_sgpr31 = COPY %2
    S_SETPC_B64_return $sgpr30_sgpr31

...
---
# GCN-LABEL: {{^}}name: vop2_instructions

# GFX1010: %{{[0-9]+}}:vgpr_32 = V_AND_B32_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 5, 0, 6, 5, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_ADD_F32_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 0, 5, 0, 5, 1, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_SUB_F16_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 0, 6, 0, 5, 1, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FMAC_F32_e32 %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FMAC_F16_e32 %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}, implicit $mode, implicit $exec

# GFX1010: %{{[0-9]+}}:vgpr_32 = V_AND_B32_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 5, 0, 6, 5, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_ADD_F32_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 0, 5, 0, 5, 1, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_SUB_F16_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 0, 5, 0, 6, 1, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FMAC_F32_e64 0, 23, 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 0, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FMAC_F16_e64 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 0, implicit $mode, implicit $exec

# GFX1010: %{{[0-9]+}}:vgpr_32 = V_ADD_F32_sdwa 0, %{{[0-9]+}}, 1, %{{[0-9]+}}, 0, 0, 5, 0, 5, 1, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_SUB_F16_sdwa 1, %{{[0-9]+}}, 1, %{{[0-9]+}}, 0, 0, 5, 0, 6, 1, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FMAC_F32_e64 1, 23, 1, %{{[0-9]+}}, 1, %{{[0-9]+}}, 1, 0, implicit $mode, implicit $exec
# GFX1010: %{{[0-9]+}}:vgpr_32 = V_FMAC_F16_e64 1, %{{[0-9]+}}, 1, %{{[0-9]+}}, 1, %{{[0-9]+}}, 0, 2, implicit $mode, implicit $exec

name:            vop2_instructions
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr30_sgpr31

    %2:sreg_64 = COPY $sgpr30_sgpr31
    %1:vreg_64 = COPY $vgpr2_vgpr3
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %3:vgpr_32 = FLAT_LOAD_DWORD %1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))

    %5:sreg_32_xm0 = S_MOV_B32 65535
    %6:sreg_32_xm0 = S_MOV_B32 65535

    %11:vgpr_32 = V_LSHRREV_B32_e64 16, %3, implicit $exec
    %12:vgpr_32 = V_AND_B32_e32 %6, %11, implicit $exec
    %13:vgpr_32 = V_LSHLREV_B32_e64 16, %12, implicit $exec
    %14:vgpr_32 = V_LSHRREV_B32_e64 16, %13, implicit $exec
    %15:vgpr_32 = V_BFE_U32_e64 %13, 8, 8, implicit $exec
    %16:vgpr_32 = V_ADD_F32_e32 %14, %15, implicit $mode, implicit $exec
    %17:vgpr_32 = V_LSHLREV_B32_e64 16, %16, implicit $exec
    %18:vgpr_32 = V_LSHRREV_B32_e64 16, %17, implicit $exec
    %19:vgpr_32 = V_BFE_U32_e64 %17, 8, 8, implicit $exec
    %20:vgpr_32 = V_SUB_F16_e32 %18, %19, implicit $mode, implicit $exec
    %21:vgpr_32 = V_LSHLREV_B32_e64 16, %20, implicit $exec
    %22:vgpr_32 = V_BFE_U32_e64 %20, 8, 8, implicit $exec
    %23:vgpr_32 = V_FMAC_F32_e32 %21, %22, %22, implicit $mode, implicit $exec
    %24:vgpr_32 = V_LSHLREV_B32_e64 16, %23, implicit $exec
    %25:vgpr_32 = V_LSHRREV_B32_e64 16, %24, implicit $exec
    %26:vgpr_32 = V_BFE_U32_e64 %24, 8, 8, implicit $exec
    %27:vgpr_32 = V_FMAC_F16_e32 %25, %26, %26, implicit $mode, implicit $exec
    %28:vgpr_32 = V_LSHLREV_B32_e64 16, %27, implicit $exec

    %29:vgpr_32 = V_LSHRREV_B32_e64 16, %28, implicit $exec
    %30:vgpr_32 = V_AND_B32_e64 23, %29, implicit $exec
    %31:vgpr_32 = V_LSHLREV_B32_e64 16, %30, implicit $exec
    %32:vgpr_32 = V_LSHRREV_B32_e64 16, %31, implicit $exec
    %33:vgpr_32 = V_BFE_U32_e64 %31, 8, 8, implicit $exec
    %34:vgpr_32 = V_ADD_F32_e64 0, %32, 0, %33, 0, 0, implicit $mode, implicit $exec
    %35:vgpr_32 = V_LSHLREV_B32_e64 16, %34, implicit $exec
    %37:vgpr_32 = V_BFE_U32_e64 %35, 8, 8, implicit $exec
    %38:vgpr_32 = V_SUB_F16_e64 0, 23, 0, %37, 0, 0, implicit $mode, implicit $exec
    %39:vgpr_32 = V_LSHLREV_B32_e64 16, %38, implicit $exec
    %40:vgpr_32 = V_BFE_U32_e64 %39, 8, 8, implicit $exec
    %41:vgpr_32 = V_FMAC_F32_e64 0, 23, 0, %40, 0, %40, 0, 0, implicit $mode, implicit $exec
    %42:vgpr_32 = V_LSHLREV_B32_e64 16, %41, implicit $exec
    %43:vgpr_32 = V_LSHRREV_B32_e64 16, %42, implicit $exec
    %44:vgpr_32 = V_BFE_U32_e64 %42, 8, 8, implicit $exec
    %45:vgpr_32 = V_FMAC_F16_e64 0, %43, 0, %44, 0, %44, 0, 0, implicit $mode, implicit $exec
    %46:vgpr_32 = V_LSHLREV_B32_e64 16, %45, implicit $exec

    %47:vgpr_32 = V_LSHRREV_B32_e64 16, %46, implicit $exec
    %48:vgpr_32 = V_BFE_U32_e64 %46, 8, 8, implicit $exec
    %49:vgpr_32 = V_ADD_F32_e64 0, %47, 1, %48, 0, 0, implicit $mode, implicit $exec
    %50:vgpr_32 = V_LSHLREV_B32_e64 16, %49, implicit $exec
    %51:vgpr_32 = V_BFE_U32_e64 %50, 8, 8, implicit $exec
    %52:vgpr_32 = V_SUB_F16_e64 1, 23, 1, %51, 0, 0, implicit $mode, implicit $exec
    %53:vgpr_32 = V_LSHLREV_B32_e64 16, %52, implicit $exec
    %54:vgpr_32 = V_BFE_U32_e64 %53, 8, 8, implicit $exec
    %55:vgpr_32 = V_FMAC_F32_e64 1, 23, 1, %54, 1, %54, 1, 0, implicit $mode, implicit $exec
    %56:vgpr_32 = V_LSHLREV_B32_e64 16, %55, implicit $exec
    %57:vgpr_32 = V_LSHRREV_B32_e64 16, %56, implicit $exec
    %58:vgpr_32 = V_BFE_U32_e64 %56, 8, 8, implicit $exec
    %59:vgpr_32 = V_FMAC_F16_e64 1, %57, 1, %58, 1, %58, 0, 2, implicit $mode, implicit $exec
    %60:vgpr_32 = V_LSHLREV_B32_e64 16, %59, implicit $exec

    %100:vgpr_32 = V_MOV_B32_e32 %60, implicit $exec

    FLAT_STORE_DWORD %0, %100, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32))
    $sgpr30_sgpr31 = COPY %2
    S_SETPC_B64_return $sgpr30_sgpr31

...

# GCN-LABEL: {{^}}name: or_of_vopc_sdwa

# VOPC SDWA has no dst_sel, so neither OR order matches dst_unused:UNUSED_PRESERVE.
# GCN: %{{[0-9]+}}:sreg_32_xm0_xexec = V_CMP_EQ_U32_sdwa 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 6, 6, implicit $exec
# GCN: %{{[0-9]+}}:vgpr_32 = V_OR_B32_e64 %{{[0-9]+}}, %{{[0-9]+}}, implicit $exec
# GCN: %{{[0-9]+}}:vgpr_32 = V_OR_B32_e64 %{{[0-9]+}}, %{{[0-9]+}}, implicit $exec

---
name: or_of_vopc_sdwa
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_ADD_F16_sdwa 0, %0, 0, %1, 0, 0, 5, 0, 4, 5, implicit $mode, implicit $exec
    %3:sreg_32_xm0_xexec = V_CMP_EQ_U32_sdwa 0, %0, 0, %1, 0, 6, 6, implicit $exec
    %4:vgpr_32 = V_OR_B32_e64 %2, %3, implicit $exec
    %5:vgpr_32 = V_OR_B32_e64 %3, %2, implicit $exec
    S_ENDPGM 0, implicit %4, implicit %5
...
