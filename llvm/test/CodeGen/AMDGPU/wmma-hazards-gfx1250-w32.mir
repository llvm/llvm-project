# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu12.50 -run-pass post-RA-hazard-rec %s -o - | FileCheck -check-prefixes=GFX1250,GFX1250-NOSTRICT %s
# RUN: llc -mtriple=amdgpu12.50s -run-pass post-RA-hazard-rec %s -o - | FileCheck -check-prefixes=GFX1250,GFX1250-STRICT %s
# RUN: llc -mtriple=amdgpu12.51 -run-pass post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX1251 %s
# RUN: llc -mtriple=amdgpu13.10 -run-pass post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX1310 %s
# Same hazards as gfx1251
# RUN: llc -mtriple=amdgpu12.5 -run-pass post-RA-hazard-rec %s -o - | FileCheck -check-prefix=GFX1251 %s

# For two conscutive wmma instructions, we need to insert one V_NOP instruction between
# them if matrix A, B or index of the second wmma are the same or overlap with previous
# wmma instruction’s D-matrix.

