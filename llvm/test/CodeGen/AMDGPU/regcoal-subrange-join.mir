# RUN: llc -mtriple=amdgpu6.00 -run-pass register-coalescer -o - %s | FileCheck --check-prefix=GCN %s
#
# See bug http://llvm.org/PR33524 for details of the problem being checked here
# This test will provoke a subrange join (see annotations below) during register coalescing
# Without a fix for PR33524 this causes an unreachable in SubRange Join
#
# GCN-DAG: undef %[[REG0:[0-9]+]].sub0:sgpr_64 = COPY $sgpr5
# GCN-DAG: undef %[[REG1:[0-9]+]].sub0:sgpr_64 = COPY $sgpr2
# GCN-DAG: %[[REG0]].sub1:sgpr_64 = S_MOV_B32 1
# GCN-DAG: %[[REG1]].sub1:sgpr_64 = S_MOV_B32 1

--- |
  define amdgpu_vs void @regcoal-subrange-join(i32 inreg %arg, i32 inreg %arg1, i32 inreg %arg2, i32 inreg %arg3, i32 inreg %arg4, i32 inreg %arg5, i32 %arg6) local_unnamed_addr #0 {
    ret void
  }

...
---
name:            regcoal-subrange-join
tracksRegLiveness: true
registers:
  - { id: 6, class: sreg_32_xm0, preferred-register: '%8' }
  - { id: 8, class: sreg_32_xm0, preferred-register: '%6' }
liveins:
  - { reg: '$sgpr2', virtual-reg: '%12' }
  - { reg: '$sgpr5', virtual-reg: '%15' }
body:             |
  bb.0:
    liveins: $sgpr2, $sgpr5

    %15:sgpr_32 = COPY killed $sgpr5
    %12:sgpr_32 = COPY killed $sgpr2
    %17:sreg_32_xm0 = S_MOV_B32 1
    undef %18.sub1:sreg_64 = COPY %17
    %0:sreg_64 = COPY %18
    %0.sub0 = COPY %12
    %21:sreg_64 = COPY %18
    %21.sub0 = COPY %15
    %22:sreg_32_xm0_xexec = S_LOAD_DWORD_IMM %21, 2, 0
    %23:sreg_32_xm0 = S_MOV_B32 491436
    undef %24.sub0:sreg_64_xexec = COPY %22
    %24.sub1 = COPY %23
    %25:sgpr_128 = S_LOAD_DWORDX4_IMM %24, 0, 0
    %1:vreg_128 = COPY %25
    %26:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0, 2, 0
    dead %27:sreg_32_xm0_xexec = S_LOAD_DWORD_IMM %26, 0, 0
    S_CBRANCH_SCC0 %bb.1, implicit undef $scc

  bb.5:
    %58:vreg_128 = COPY %1
    %59:sreg_32_xm0 = COPY %17
    S_BRANCH %bb.2

  bb.1:
    %30:vgpr_32 = V_MOV_B32_e32 1036831949, implicit $exec
    %31:vgpr_32 = nofpexcept V_ADD_F32_e32 %30, %1.sub3, implicit $mode, implicit $exec
    %33:vgpr_32 = nofpexcept V_ADD_F32_e32 %30, %1.sub2, implicit $mode, implicit $exec
    %35:vgpr_32 = nofpexcept V_ADD_F32_e32 %30, %1.sub1, implicit $mode, implicit $exec
    %37:vgpr_32 = nofpexcept V_ADD_F32_e32 %30, %1.sub0, implicit $mode, implicit $exec
    undef %56.sub0:vreg_128 = COPY %37
    %56.sub1 = COPY %35
    %56.sub2 = COPY %33
    %56.sub3 = COPY %31
    %28:sreg_32_xm0 = S_MOV_B32 0
    %2:vreg_128 = COPY %56
    %58 = COPY %2
    %59 = COPY %28

  bb.2:
    %4:sreg_32_xm0 = COPY %59
    %3:vreg_128 = COPY %58
    %39:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0, 6, 0
    %40:sreg_32_xm0_xexec = S_LOAD_DWORD_IMM %39, 0, 0
    %43:vgpr_32 = V_MOV_B32_e32 -1102263091, implicit $exec
    %60:sreg_32_xm0 = COPY %4
    %61:vreg_128 = COPY %3

  bb.3:
    successors: %bb.3, %bb.4

    %7:vreg_128 = COPY %61
    %6 = COPY %60
    %8 = S_ADD_I32 %6, 1, implicit-def dead $scc
    %44:vgpr_32 = nofpexcept V_ADD_F32_e32 %43, %7.sub3, implicit $mode, implicit $exec
    %46:vgpr_32 = nofpexcept V_ADD_F32_e32 %43, %7.sub2, implicit $mode, implicit $exec
    %48:vgpr_32 = nofpexcept V_ADD_F32_e32 %43, %7.sub1, implicit $mode, implicit $exec
    %50:vgpr_32 = nofpexcept V_ADD_F32_e32 %43, %7.sub0, implicit $mode, implicit $exec
    undef %57.sub0:vreg_128 = COPY %50
    %57.sub1 = COPY %48
    %57.sub2 = COPY %46
    %57.sub3 = COPY %44
    S_CMP_LT_I32 %8, %40, implicit-def $scc
    %60 = COPY %8
    %61 = COPY %57
    S_CBRANCH_SCC1 %bb.3, implicit killed $scc
    S_BRANCH %bb.4

  bb.4:
    EXP 32, undef %53:vgpr_32, undef %54:vgpr_32, %46, undef %55:vgpr_32, 0, 0, 15, implicit $exec
    S_ENDPGM 0

...
