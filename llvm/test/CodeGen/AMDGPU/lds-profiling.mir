# Kernels without a clone are not touched.
---
name: unmarked
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  ldsSize: 1024
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: unmarked
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: DS_WRITE_B32_gfx9 [[COPY]], [[COPY1]], 16, 0, implicit $exec :: (store (s32), addrspace 3)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    DS_WRITE_B32_gfx9 %0, %1, 16, 0, implicit $exec :: (store (s32), addrspace 3)
    S_ENDPGM 0
...
