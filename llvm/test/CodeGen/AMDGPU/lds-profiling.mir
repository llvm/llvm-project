# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50-amd-amdhsa -run-pass=amdgpu-lds-profiling -verify-machineinstrs -o - %s | FileCheck %s

--- |
  @clone.counters = external protected addrspace(1) global [0 x i32], align 4
  @clone_dynamic.counters = external protected addrspace(1) global [0 x i32], align 4

  define amdgpu_kernel void @original() "amdgpu-lds-prof-original" "amdgpu-lds-size"="1024" {
    ret void
  }

  define amdgpu_kernel void @clone() "amdgpu-lds-prof-clone"="original" "amdgpu-lds-size"="1024" {
    ret void
  }

  define amdgpu_kernel void @clone_dynamic(ptr addrspace(3) %lds) "amdgpu-lds-prof-clone"="original_dynamic" {
    ret void
  }

  define amdgpu_kernel void @unmarked() "amdgpu-lds-size"="1024" {
    ret void
  }
...

# The kernel which has a clone only gets the site of each LDS instruction.
---
name: original
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  ldsSize: 1024
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: original
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: DS_WRITE_B32_gfx9 [[COPY]], [[COPY1]], 16, 0, implicit $exec, pcsections !0 :: (store (s32), addrspace 3)
    ; CHECK-NEXT: [[DS_READ2_B32_gfx9_:%[0-9]+]]:vreg_64_align2 = DS_READ2_B32_gfx9 [[COPY]], 0, 1, 0, implicit $exec, pcsections !2 :: (load (s64), align 4, addrspace 3)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    DS_WRITE_B32_gfx9 %0, %1, 16, 0, implicit $exec :: (store (s32), addrspace 3)
    %2:vreg_64_align2 = DS_READ2_B32_gfx9 %0, 0, 1, 0, implicit $exec :: (load (s64), align 4, addrspace 3)
    S_ENDPGM 0
...

# The clone measures the bank conflict of each supported access. The paired
# read is a site, but is not instrumented.
---
name: clone
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  ldsSize: 1024
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: clone
    ; CHECK: successors: %bb.5(0x40000000), %bb.1(0x40000000)
    ; CHECK-NEXT: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 16, [[COPY]], implicit $exec
    ; CHECK-NEXT: [[V_LSHRREV_B32_e32_:%[0-9]+]]:vgpr_32 = V_LSHRREV_B32_e32 2, [[V_ADD_U32_e32_]], implicit $exec
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32_xm0_xexec = S_MOV_B32 $exec_lo
    ; CHECK-NEXT: [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 256
    ; CHECK-NEXT: [[V_CMP_LT_U32_e64_:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_LT_U32_e64 [[V_LSHRREV_B32_e32_]], [[S_MOV_B32_1]], implicit $exec
    ; CHECK-NEXT: [[V_AND_B32_e32_:%[0-9]+]]:vgpr_32 = V_AND_B32_e32 63, [[V_LSHRREV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[S_MOV_B32_2:%[0-9]+]]:sreg_32 = S_MOV_B32 0
    ; CHECK-NEXT: [[S_MOV_B32_3:%[0-9]+]]:sreg_32 = S_MOV_B32 1
    ; CHECK-NEXT: S_CMP_EQ_U32 [[S_MOV_B32_]], 0, implicit-def $scc
    ; CHECK-NEXT: S_CBRANCH_SCC1 %bb.5, implicit $scc
    ; CHECK-NEXT: S_BRANCH %bb.1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .1:
    ; CHECK-NEXT: successors: %bb.4(0x40000000), %bb.2(0x40000000)
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_CMP_EQ_U32 [[V_CMP_LT_U32_e64_]], 0, implicit-def $scc
    ; CHECK-NEXT: S_CBRANCH_SCC1 %bb.4, implicit $scc
    ; CHECK-NEXT: S_BRANCH %bb.2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .2:
    ; CHECK-NEXT: successors: %bb.2(0x40000000), %bb.3(0x40000000)
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[PHI:%[0-9]+]]:sreg_32 = PHI [[V_CMP_LT_U32_e64_]], %bb.1, %12, %bb.2
    ; CHECK-NEXT: [[PHI1:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_2]], %bb.1, %14, %bb.2
    ; CHECK-NEXT: [[S_FF1_I32_B32_:%[0-9]+]]:sreg_32 = S_FF1_I32_B32 [[PHI]]
    ; CHECK-NEXT: [[V_READLANE_B32_:%[0-9]+]]:sreg_32_xm0 = V_READLANE_B32 [[V_LSHRREV_B32_e32_]], [[S_FF1_I32_B32_]]
    ; CHECK-NEXT: [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[V_READLANE_B32_]], [[V_LSHRREV_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[V_CMP_EQ_U32_e64_]], [[PHI]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_LSHL_B32_:%[0-9]+]]:sreg_32 = S_LSHL_B32 [[S_MOV_B32_3]], [[S_FF1_I32_B32_]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_OR_B32_:%[0-9]+]]:sreg_32 = S_OR_B32 [[PHI1]], [[S_LSHL_B32_]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_ANDN2_B32_:%[0-9]+]]:sreg_32 = S_ANDN2_B32 [[PHI]], [[S_AND_B32_]], implicit-def dead $scc
    ; CHECK-NEXT: S_CMP_LG_U32 [[S_ANDN2_B32_]], 0, implicit-def $scc
    ; CHECK-NEXT: S_CBRANCH_SCC1 %bb.2, implicit $scc
    ; CHECK-NEXT: S_BRANCH %bb.3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .3:
    ; CHECK-NEXT: successors: %bb.3(0x40000000), %bb.4(0x40000000)
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[PHI2:%[0-9]+]]:sreg_32 = PHI [[S_OR_B32_]], %bb.2, %21, %bb.3
    ; CHECK-NEXT: [[PHI3:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_2]], %bb.2, %23, %bb.3
    ; CHECK-NEXT: [[S_FF1_I32_B32_1:%[0-9]+]]:sreg_32 = S_FF1_I32_B32 [[PHI2]]
    ; CHECK-NEXT: [[V_READLANE_B32_1:%[0-9]+]]:sreg_32_xm0 = V_READLANE_B32 [[V_AND_B32_e32_]], [[S_FF1_I32_B32_1]]
    ; CHECK-NEXT: [[V_CMP_EQ_U32_e64_1:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[V_READLANE_B32_1]], [[V_AND_B32_e32_]], implicit $exec
    ; CHECK-NEXT: [[S_AND_B32_1:%[0-9]+]]:sreg_32 = S_AND_B32 [[V_CMP_EQ_U32_e64_1]], [[PHI2]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_BCNT1_I32_B32_:%[0-9]+]]:sreg_32 = S_BCNT1_I32_B32 [[S_AND_B32_1]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_MAX_U32_:%[0-9]+]]:sreg_32 = S_MAX_U32 [[PHI3]], [[S_BCNT1_I32_B32_]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_ANDN2_B32_1:%[0-9]+]]:sreg_32 = S_ANDN2_B32 [[PHI2]], [[S_AND_B32_1]], implicit-def dead $scc
    ; CHECK-NEXT: S_CMP_LG_U32 [[S_ANDN2_B32_1]], 0, implicit-def $scc
    ; CHECK-NEXT: S_CBRANCH_SCC1 %bb.3, implicit $scc
    ; CHECK-NEXT: S_BRANCH %bb.4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .4:
    ; CHECK-NEXT: successors: %bb.5(0x80000000)
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[PHI4:%[0-9]+]]:sreg_32 = PHI [[S_MAX_U32_]], %bb.3, [[S_MOV_B32_2]], %bb.1
    ; CHECK-NEXT: [[S_MIN_U32_:%[0-9]+]]:sreg_32 = S_MIN_U32 [[PHI4]], [[S_MOV_B32_3]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_MOV_B32_4:%[0-9]+]]:sreg_32_xm0_xexec = S_MOV_B32 $exec_lo
    ; CHECK-NEXT: $exec_lo = S_MOV_B32 1
    ; CHECK-NEXT: [[SI_PC_ADD_REL_OFFSET64_:%[0-9]+]]:sreg_64_xexec_xnull = SI_PC_ADD_REL_OFFSET64 target-flags(amdgpu-rel64) @clone.counters
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[PHI4]]
    ; CHECK-NEXT: [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[S_MIN_U32_]]
    ; CHECK-NEXT: GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[COPY2]], [[SI_PC_ADD_REL_OFFSET64_]], 0, 0, implicit $exec :: (load store monotonic (s32) on @clone.counters, addrspace 1)
    ; CHECK-NEXT: GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[V_MOV_B32_e32_1]], [[SI_PC_ADD_REL_OFFSET64_]], 4, 0, implicit $exec :: (load store monotonic (s32) on @clone.counters + 4, addrspace 1)
    ; CHECK-NEXT: GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[COPY2]], [[SI_PC_ADD_REL_OFFSET64_]], 8, 0, implicit $exec :: (load store monotonic (s32) on @clone.counters + 8, addrspace 1)
    ; CHECK-NEXT: GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[COPY3]], [[SI_PC_ADD_REL_OFFSET64_]], 12, 0, implicit $exec :: (load store monotonic (s32) on @clone.counters + 12, addrspace 1)
    ; CHECK-NEXT: $exec_lo = S_MOV_B32 [[S_MOV_B32_4]]
    ; CHECK-NEXT: S_BRANCH %bb.5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .5:
    ; CHECK-NEXT: DS_WRITE_B32_gfx9 [[COPY]], [[COPY1]], 16, 0, implicit $exec, pcsections !0 :: (store (s32), addrspace 3)
    ; CHECK-NEXT: [[DS_READ2_B32_gfx9_:%[0-9]+]]:vreg_64_align2 = DS_READ2_B32_gfx9 [[COPY]], 0, 1, 0, implicit $exec, pcsections !2 :: (load (s64), align 4, addrspace 3)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    DS_WRITE_B32_gfx9 %0, %1, 16, 0, implicit $exec :: (store (s32), addrspace 3)
    %2:vreg_64_align2 = DS_READ2_B32_gfx9 %0, 0, 1, 0, implicit $exec :: (load (s64), align 4, addrspace 3)
    S_ENDPGM 0
...

# SCC is live across the access, so it is saved and restored. The size of
# dynamic LDS is unknown, so every executing lane is counted.
---
name: clone_dynamic
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: clone_dynamic
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.6(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[COPY1]], 0, implicit-def $scc
  ; CHECK-NEXT:   [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
  ; CHECK-NEXT:   [[V_LSHRREV_B32_e32_:%[0-9]+]]:vgpr_32 = V_LSHRREV_B32_e32 2, [[COPY]], implicit $exec
  ; CHECK-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32_xm0_xexec = S_MOV_B32 $exec_lo
  ; CHECK-NEXT:   [[V_AND_B32_e32_:%[0-9]+]]:vgpr_32 = V_AND_B32_e32 63, [[V_LSHRREV_B32_e32_]], implicit $exec
  ; CHECK-NEXT:   [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 0
  ; CHECK-NEXT:   [[S_MOV_B32_2:%[0-9]+]]:sreg_32 = S_MOV_B32 1
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[S_MOV_B32_]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.6, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_]], %bb.0, %10, %bb.3
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_1]], %bb.0, %12, %bb.3
  ; CHECK-NEXT:   [[S_FF1_I32_B32_:%[0-9]+]]:sreg_32 = S_FF1_I32_B32 [[PHI]]
  ; CHECK-NEXT:   [[V_READLANE_B32_:%[0-9]+]]:sreg_32_xm0 = V_READLANE_B32 [[V_LSHRREV_B32_e32_]], [[S_FF1_I32_B32_]]
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[V_READLANE_B32_]], [[V_LSHRREV_B32_e32_]], implicit $exec
  ; CHECK-NEXT:   [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[V_CMP_EQ_U32_e64_]], [[PHI]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_LSHL_B32_:%[0-9]+]]:sreg_32 = S_LSHL_B32 [[S_MOV_B32_2]], [[S_FF1_I32_B32_]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_OR_B32_:%[0-9]+]]:sreg_32 = S_OR_B32 [[PHI1]], [[S_LSHL_B32_]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_ANDN2_B32_:%[0-9]+]]:sreg_32 = S_ANDN2_B32 [[PHI]], [[S_AND_B32_]], implicit-def dead $scc
  ; CHECK-NEXT:   S_CMP_LG_U32 [[S_ANDN2_B32_]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.3, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:sreg_32 = PHI [[S_OR_B32_]], %bb.3, %19, %bb.4
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_1]], %bb.3, %21, %bb.4
  ; CHECK-NEXT:   [[S_FF1_I32_B32_1:%[0-9]+]]:sreg_32 = S_FF1_I32_B32 [[PHI2]]
  ; CHECK-NEXT:   [[V_READLANE_B32_1:%[0-9]+]]:sreg_32_xm0 = V_READLANE_B32 [[V_AND_B32_e32_]], [[S_FF1_I32_B32_1]]
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_1:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[V_READLANE_B32_1]], [[V_AND_B32_e32_]], implicit $exec
  ; CHECK-NEXT:   [[S_AND_B32_1:%[0-9]+]]:sreg_32 = S_AND_B32 [[V_CMP_EQ_U32_e64_1]], [[PHI2]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_BCNT1_I32_B32_:%[0-9]+]]:sreg_32 = S_BCNT1_I32_B32 [[S_AND_B32_1]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_MAX_U32_:%[0-9]+]]:sreg_32 = S_MAX_U32 [[PHI3]], [[S_BCNT1_I32_B32_]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_ANDN2_B32_1:%[0-9]+]]:sreg_32 = S_ANDN2_B32 [[PHI2]], [[S_AND_B32_1]], implicit-def dead $scc
  ; CHECK-NEXT:   S_CMP_LG_U32 [[S_ANDN2_B32_1]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.4, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.6(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_MOV_B32_3:%[0-9]+]]:sreg_32_xm0_xexec = S_MOV_B32 $exec_lo
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 1
  ; CHECK-NEXT:   [[SI_PC_ADD_REL_OFFSET64_:%[0-9]+]]:sreg_64_xexec_xnull = SI_PC_ADD_REL_OFFSET64 target-flags(amdgpu-rel64) @clone_dynamic.counters
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[S_MAX_U32_]]
  ; CHECK-NEXT:   [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
  ; CHECK-NEXT:   GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[COPY2]], [[SI_PC_ADD_REL_OFFSET64_]], 0, 0, implicit $exec :: (load store monotonic (s32) on @clone_dynamic.counters, addrspace 1)
  ; CHECK-NEXT:   GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[V_MOV_B32_e32_1]], [[SI_PC_ADD_REL_OFFSET64_]], 4, 0, implicit $exec :: (load store monotonic (s32) on @clone_dynamic.counters + 4, addrspace 1)
  ; CHECK-NEXT:   GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[COPY2]], [[SI_PC_ADD_REL_OFFSET64_]], 8, 0, implicit $exec :: (load store monotonic (s32) on @clone_dynamic.counters + 8, addrspace 1)
  ; CHECK-NEXT:   GLOBAL_ATOMIC_ADD_SADDR [[V_MOV_B32_e32_]], [[V_MOV_B32_e32_1]], [[SI_PC_ADD_REL_OFFSET64_]], 12, 0, implicit $exec :: (load store monotonic (s32) on @clone_dynamic.counters + 12, addrspace 1)
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 [[S_MOV_B32_3]]
  ; CHECK-NEXT:   S_BRANCH %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_CMP_LG_U32 [[S_CSELECT_B32_]], 0, implicit-def $scc
  ; CHECK-NEXT:   [[DS_READ_B32_gfx9_:%[0-9]+]]:vgpr_32 = DS_READ_B32_gfx9 [[COPY]], 0, 0, implicit $exec, pcsections !0 :: (load (s32), addrspace 3)
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.10(0x40000000), %bb.7(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_LSHRREV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_LSHRREV_B32_e32 2, [[COPY]], implicit $exec
  ; CHECK-NEXT:   [[S_MOV_B32_4:%[0-9]+]]:sreg_32_xm0_xexec = S_MOV_B32 $exec_lo
  ; CHECK-NEXT:   [[V_AND_B32_e32_1:%[0-9]+]]:vgpr_32 = V_AND_B32_e32 63, [[V_LSHRREV_B32_e32_1]], implicit $exec
  ; CHECK-NEXT:   [[S_MOV_B32_5:%[0-9]+]]:sreg_32 = S_MOV_B32 0
  ; CHECK-NEXT:   [[S_MOV_B32_6:%[0-9]+]]:sreg_32 = S_MOV_B32 1
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[S_MOV_B32_4]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.10, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7:
  ; CHECK-NEXT:   successors: %bb.7(0x40000000), %bb.8(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI4:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_4]], %bb.1, %38, %bb.7
  ; CHECK-NEXT:   [[PHI5:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_5]], %bb.1, %40, %bb.7
  ; CHECK-NEXT:   [[S_FF1_I32_B32_2:%[0-9]+]]:sreg_32 = S_FF1_I32_B32 [[PHI4]]
  ; CHECK-NEXT:   [[V_READLANE_B32_2:%[0-9]+]]:sreg_32_xm0 = V_READLANE_B32 [[V_LSHRREV_B32_e32_1]], [[S_FF1_I32_B32_2]]
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_2:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[V_READLANE_B32_2]], [[V_LSHRREV_B32_e32_1]], implicit $exec
  ; CHECK-NEXT:   [[S_AND_B32_2:%[0-9]+]]:sreg_32 = S_AND_B32 [[V_CMP_EQ_U32_e64_2]], [[PHI4]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_LSHL_B32_1:%[0-9]+]]:sreg_32 = S_LSHL_B32 [[S_MOV_B32_6]], [[S_FF1_I32_B32_2]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_OR_B32_1:%[0-9]+]]:sreg_32 = S_OR_B32 [[PHI5]], [[S_LSHL_B32_1]], implicit-def dead $scc
