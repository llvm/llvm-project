# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.06-amd-amdhsa -verify-machineinstrs -run-pass=postrapseudos -o - %s | FileCheck %s

# Don't set a kill of the super register on the last instruction with
# an overlapping copy. This would kill part of the values in the
# result copies.

---
name: overlapping_copy_kill_undef_reg_after_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr30_64, $sgpr4_256

    ; CHECK-LABEL: name: overlapping_copy_kill_undef_reg_after_copy
    ; CHECK: liveins: $sgpr30_64, $sgpr4_256
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr0_64 = S_MOV_B64 $sgpr4_64, implicit $sgpr4_256
    ; CHECK-NEXT: $sgpr2_64 = S_MOV_B64 $sgpr6_64, implicit $sgpr4_256
    ; CHECK-NEXT: $sgpr4_64 = S_MOV_B64 $sgpr8_64, implicit $sgpr4_256
    ; CHECK-NEXT: $sgpr6_64 = S_MOV_B64 $sgpr10_64, implicit $sgpr4_256
    ; CHECK-NEXT: renamable $sgpr1 = S_ADD_I32 0, $sgpr1, implicit-def $scc
    ; CHECK-NEXT: S_SETPC_B64 $sgpr30_64, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2, implicit $sgpr3, implicit $sgpr4, implicit $sgpr5, implicit $sgpr6, implicit $sgpr7
    renamable $sgpr0_256 = COPY killed renamable $sgpr4_256
    renamable $sgpr1 = S_ADD_I32 0, $sgpr1, implicit-def $scc
    S_SETPC_B64 $sgpr30_64, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2, implicit $sgpr3, implicit $sgpr4, implicit $sgpr5, implicit $sgpr6, implicit $sgpr7

...

---
name: nonoverlapping_copy_kill
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr30_64, $sgpr4_96

    ; CHECK-LABEL: name: nonoverlapping_copy_kill
    ; CHECK: liveins: $sgpr30_64, $sgpr4_96
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr0_64 = S_MOV_B64 $sgpr4_64, implicit $sgpr4_96
    ; CHECK-NEXT: $sgpr2 = S_MOV_B32 $sgpr6, implicit killed $sgpr4_96
    ; CHECK-NEXT: renamable $sgpr1 = S_ADD_I32 0, $sgpr1, implicit-def $scc
    ; CHECK-NEXT: S_SETPC_B64 $sgpr30_64, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2
    renamable $sgpr0_96 = COPY killed renamable $sgpr4_96
    renamable $sgpr1 = S_ADD_I32 0, $sgpr1, implicit-def $scc
    S_SETPC_B64 $sgpr30_64, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2

...
