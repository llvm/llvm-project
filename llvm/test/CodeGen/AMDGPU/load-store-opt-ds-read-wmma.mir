  ; COEXEC-NEXT:   [[DS_READ_B64_gfx9_:%[0-9]+]]:vreg_64_align2 = DS_READ_B64_gfx9 [[DEF]], 0, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
