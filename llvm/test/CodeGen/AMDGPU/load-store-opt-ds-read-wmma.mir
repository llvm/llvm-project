  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DS_READ2_B64_gfx9_:%[0-9]+]]:vreg_128_align2 = DS_READ2_B64_gfx9 [[DEF]], 0, 1, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_64_align2 = COPY [[DS_READ2_B64_gfx9_]].sub0_sub1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vreg_64_align2 = COPY killed [[DS_READ2_B64_gfx9_]].sub2_sub3
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_256_align2 = REG_SEQUENCE [[COPY]], %subreg.sub0_sub1, [[DEF1]].sub2_sub3, %subreg.sub2_sub3, [[DEF1]].sub4_sub5, %subreg.sub4_sub5, [[DEF1]].sub6_sub7, %subreg.sub6_sub7
  ; CHECK-NEXT:   [[REG_SEQUENCE1:%[0-9]+]]:vreg_256_align2 = REG_SEQUENCE [[COPY1]], %subreg.sub0_sub1, [[DEF1]].sub2_sub3, %subreg.sub2_sub3, [[DEF1]].sub4_sub5, %subreg.sub4_sub5, [[DEF1]].sub6_sub7, %subreg.sub6_sub7
  ; CHECK-NEXT:   early-clobber %10:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr [[REG_SEQUENCE]], [[DEF1]], 8, [[DEF2]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   early-clobber %11:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr [[REG_SEQUENCE1]], [[DEF1]], 8, [[DEF3]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   early-clobber %12:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr [[DEF1]], [[DEF1]], 8, [[DEF4]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_CMP_LG_U32 [[DEF5]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0, implicit %10, implicit %11, implicit %12
  bb.0:
    successors: %bb.1

    %0:vgpr_32 = IMPLICIT_DEF
    %1:vreg_256_align2 = IMPLICIT_DEF
    %2:vreg_256_align2 = IMPLICIT_DEF
    %3:vreg_256_align2 = IMPLICIT_DEF
    %4:vreg_256_align2 = IMPLICIT_DEF
    %5:sreg_32 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    %6:vreg_64_align2 = DS_READ_B64_gfx9 %0, 0, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
    %7:vreg_64_align2 = DS_READ_B64_gfx9 %0, 8, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
    %8:vreg_256_align2 = REG_SEQUENCE %6, %subreg.sub0_sub1, %1.sub2_sub3, %subreg.sub2_sub3, %1.sub4_sub5, %subreg.sub4_sub5, %1.sub6_sub7, %subreg.sub6_sub7
    %9:vreg_256_align2 = REG_SEQUENCE %7, %subreg.sub0_sub1, %1.sub2_sub3, %subreg.sub2_sub3, %1.sub4_sub5, %subreg.sub4_sub5, %1.sub6_sub7, %subreg.sub6_sub7
    early-clobber %10:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr %8, %1, 8, %2, 0, 0, 0, 0, implicit $exec
    early-clobber %11:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr %9, %1, 8, %3, 0, 0, 0, 0, implicit $exec
    early-clobber %12:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr %1, %1, 8, %4, 0, 0, 0, 0, implicit $exec
    S_CMP_LG_U32 %5, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0, implicit %10, implicit %11, implicit %12
...

---

# Condition 1 fails: the loop body spans bb.1 -> bb.2 -> bb.1, so bb.1 is not
# its own successor. Multi-block loop bodies are out of scope.
name: ds_read_wmma_multi_block_loop
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ds_read_wmma_multi_block_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:vreg_256_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:vreg_256_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF3:%[0-9]+]]:vreg_256_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF4:%[0-9]+]]:sreg_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DS_READ2_B64_gfx9_:%[0-9]+]]:vreg_128_align2 = DS_READ2_B64_gfx9 [[DEF]], 0, 1, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_64_align2 = COPY [[DS_READ2_B64_gfx9_]].sub0_sub1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vreg_64_align2 = COPY killed [[DS_READ2_B64_gfx9_]].sub2_sub3
  ; CHECK-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_256_align2 = REG_SEQUENCE [[COPY]], %subreg.sub0_sub1, [[DEF1]].sub2_sub3, %subreg.sub2_sub3, [[DEF1]].sub4_sub5, %subreg.sub4_sub5, [[DEF1]].sub6_sub7, %subreg.sub6_sub7
  ; CHECK-NEXT:   [[REG_SEQUENCE1:%[0-9]+]]:vreg_256_align2 = REG_SEQUENCE [[COPY1]], %subreg.sub0_sub1, [[DEF1]].sub2_sub3, %subreg.sub2_sub3, [[DEF1]].sub4_sub5, %subreg.sub4_sub5, [[DEF1]].sub6_sub7, %subreg.sub6_sub7
  ; CHECK-NEXT:   early-clobber %9:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr [[REG_SEQUENCE]], [[DEF1]], 8, [[DEF2]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   early-clobber %10:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr [[REG_SEQUENCE1]], [[DEF1]], 8, [[DEF3]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_CMP_LG_U32 [[DEF4]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.3, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   S_ENDPGM 0, implicit %9, implicit %10
  bb.0:
    successors: %bb.1

    %0:vgpr_32 = IMPLICIT_DEF
    %1:vreg_256_align2 = IMPLICIT_DEF
    %2:vreg_256_align2 = IMPLICIT_DEF
    %3:vreg_256_align2 = IMPLICIT_DEF
    %4:sreg_32 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %5:vreg_64_align2 = DS_READ_B64_gfx9 %0, 0, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
    %6:vreg_64_align2 = DS_READ_B64_gfx9 %0, 8, 0, implicit $exec :: (load (s64) from `ptr addrspace(3) poison`, addrspace 3)
    %7:vreg_256_align2 = REG_SEQUENCE %5, %subreg.sub0_sub1, %1.sub2_sub3, %subreg.sub2_sub3, %1.sub4_sub5, %subreg.sub4_sub5, %1.sub6_sub7, %subreg.sub6_sub7
    %8:vreg_256_align2 = REG_SEQUENCE %6, %subreg.sub0_sub1, %1.sub2_sub3, %subreg.sub2_sub3, %1.sub4_sub5, %subreg.sub4_sub5, %1.sub6_sub7, %subreg.sub6_sub7
    early-clobber %9:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr %7, %1, 8, %2, 0, 0, 0, 0, implicit $exec
    early-clobber %10:vreg_256_align2 = V_WMMA_F32_16X16X32_F16_w32_twoaddr %8, %1, 8, %3, 0, 0, 0, 0, implicit $exec
    S_CMP_LG_U32 %4, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.3, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.1

    S_BRANCH %bb.1

  bb.3:
    S_ENDPGM 0, implicit %9, implicit %10
...
