# Combining a DS_READ pair gives the two results a single wide def, so every
# consumer waits on the same DS counter. Each function below isolates one of the
# conditions in combinePreventsLatencyHiding().

---

# All conditions met: both loads feed all of the loop's WMMAs.
name: ds_read_wmma_self_loop_all_covered
tracksRegLiveness: true
body: |
  ; DEFAULT-LABEL: name: ds_read_wmma_self_loop_all_covered
  ; DEFAULT: bb.0:
  ; DEFAULT-NEXT:   successors: %bb.1(0x80000000)
  ; DEFAULT-NEXT: {{  $}}
