# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -amdgpu-rewrite-mfma-form-sched-stage=true -debug-only=machine-scheduler -o /dev/null %s 2>&1 | FileCheck %s

# %acc is the MFMA's src2, kept from recoloring by a VGPR-only read in the
# epilogue, so the rewrite copies it into an AGPR after its def. The estimate
# counts the AGPR copy from the def to the MFMA, and the VGPR only as far as the
# DS_READ.

# CHECK: region 0: ArchVGPR 294 -> 294, AGPR 0 -> 2, spills 38 -> 38
# CHECK: region 1: ArchVGPR 296 -> 294, AGPR 0 -> 4, spills 40 -> 38
# CHECK: region 2: ArchVGPR 291 -> 291, AGPR 0 -> 0, spills 35 -> 35

--- |
  define amdgpu_kernel void @src2_bridge_pressure() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-flat-work-group-size"="1,256" }
...
---
name:            src2_bridge_pressure
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr0

    %s0:vreg_64_align2 = COPY $vgpr0_vgpr1
    %s1:vreg_64_align2 = COPY $vgpr2_vgpr3
    %cnt:sgpr_32 = COPY $sgpr0
    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %p7:vreg_1024 = IMPLICIT_DEF
    %p8:vreg_1024 = IMPLICIT_DEF
    %acc:vreg_64_align2 = AV_MOV_B64_IMM_PSEUDO 0, implicit $exec

  bb.1:
    successors: %bb.1, %bb.2
    dead %mdst:vreg_64_align2 = V_MFMA_F64_4X4X4F64_vgprcd_e64 %s0, %s1, %acc, 0, 0, 0, implicit $mode, implicit $exec
    %cnt:sgpr_32 = S_SUB_I32 %cnt, 1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    %acc.sub0 = AV_MOV_B32_IMM_PSEUDO 7, implicit $exec
    %ld:vgpr_32 = DS_READ_B32_gfx9 %acc.sub0, 0, 0, implicit $exec :: (load (s32), addrspace 3)
    dead %conn:vreg_64_align2 = COPY %acc
    S_ENDPGM 0, implicit %ld, implicit %p0, implicit %p1, implicit %p2, implicit %p3, implicit %p4, implicit %p5, implicit %p6, implicit %p7, implicit %p8
...
