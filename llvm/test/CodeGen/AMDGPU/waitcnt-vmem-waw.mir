    ; GFX9-NEXT: $vgpr2 = FLAT_LOAD_DWORD $vgpr0_64, 0, 0, implicit $exec, implicit $flat_scr
    $vgpr2 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_128, $sgpr4, 0, 0, 0, implicit $exec
