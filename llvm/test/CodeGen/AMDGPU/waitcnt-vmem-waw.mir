# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.00 -verify-machineinstrs -run-pass si-insert-waitcnts -o - %s | FileCheck -check-prefix=GFX9 %s

# Two buffer loads with overlapping outputs. No waitcnt required.
---
name: buffer_buffer
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_128, $sgpr4, $sgpr5
    ; GFX9-LABEL: name: buffer_buffer
    ; GFX9: liveins: $sgpr0_128, $sgpr4, $sgpr5
    ; GFX9-NEXT: {{  $}}
    ; GFX9-NEXT: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
    ; GFX9-NEXT: $vgpr0_128 = BUFFER_LOAD_DWORDX4_OFFSET $sgpr0_128, $sgpr4, 0, 0, 0, implicit $exec
    ; GFX9-NEXT: $vgpr1 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_128, $sgpr5, 0, 0, 0, implicit $exec
    $vgpr0_128 = BUFFER_LOAD_DWORDX4_OFFSET $sgpr0_128, $sgpr4, 0, 0, 0, implicit $exec
    $vgpr1 = BUFFER_LOAD_DWORD_OFFSET $sgpr0_128, $sgpr5, 0, 0, 0, implicit $exec
...

