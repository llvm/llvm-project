define amdgpu_kernel void @kernel() {
; CHECK-LABEL: kernel:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_add_u32 s0, s0, s17
; CHECK-NEXT:    s_mov_b64 s[4:5], src_private_base
; CHECK-NEXT:    s_addc_u32 s1, s1, 0
; CHECK-NEXT:    s_mov_b32 s4, 4
; CHECK-NEXT:    v_mov_b32_e32 v0, s5
; CHECK-NEXT:    buffer_store_dword v0, off, s[0:3], 0 offset:4
; CHECK-NEXT:    v_mov_b32_e32 v0, s4
; CHECK-NEXT:    buffer_store_dword v0, off, s[0:3], 0
; CHECK-NEXT:    s_endpgm
entry:
  %a = alloca [2 x i32], align 4, addrspace(5)
  %p = getelementptr i8, ptr addrspace(5) %a, i32 4
  %c = load i8, ptr null, align 1
  %cond = icmp eq i8 %c, 0
  br i1 %cond, label %end, label %then

then:
  %unused = addrspacecast ptr addrspace(5) %p to ptr
  br label %end

end:
  %q = addrspacecast ptr addrspace(5) %p to ptr
  store ptr %q, ptr addrspace(5) null, align 8
  ret void
}
