# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -run-pass=si-pre-emit-peephole %s -o - | FileCheck -check-prefix=GFX1250 %s
# RUN: llc -mtriple=amdgpu13.10 -run-pass=si-pre-emit-peephole %s -o - | FileCheck -check-prefix=GFX1310 %s
# Make sure mandatory skips are not removed around V_PERM_PK16, which must issue
# with a non-zero EXEC on gfx1250. gfx13 has the instruction but not the hazard,
# so the skip is removed there.

---

name: need_skip_vperm_pk16
body: |
  ; GFX1250-LABEL: name: need_skip_vperm_pk16
  ; GFX1250: bb.0:
  ; GFX1250-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT:   S_CBRANCH_EXECZ %bb.2, implicit $exec
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT: bb.1:
  ; GFX1250-NEXT:   successors: %bb.2(0x80000000)
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT:   $vgpr0_vgpr1 = V_PERM_PK16_B4_U4_e64 $vgpr0, $vgpr1, $vgpr2_vgpr3, implicit $exec
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT: bb.2:
  ; GFX1250-NEXT:   S_ENDPGM 0
  ;
  ; GFX1310-LABEL: name: need_skip_vperm_pk16
  ; GFX1310: bb.0:
  ; GFX1310-NEXT:   successors: %bb.1(0x40000000)
  ; GFX1310-NEXT: {{  $}}
  ; GFX1310-NEXT: bb.1:
  ; GFX1310-NEXT:   successors: %bb.2(0x80000000)
  ; GFX1310-NEXT: {{  $}}
  ; GFX1310-NEXT:   $vgpr0_vgpr1 = V_PERM_PK16_B4_U4_e64 $vgpr0, $vgpr1, $vgpr2_vgpr3, implicit $exec
  ; GFX1310-NEXT: {{  $}}
  ; GFX1310-NEXT: bb.2:
  ; GFX1310-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    successors: %bb.2
    $vgpr0_vgpr1 = V_PERM_PK16_B4_U4_e64 $vgpr0, $vgpr1, $vgpr2_vgpr3, implicit $exec

  bb.2:
    S_ENDPGM 0
...

---

name: remove_skip_without_vperm_pk16
body: |
  ; GFX1250-LABEL: name: remove_skip_without_vperm_pk16
  ; GFX1250: bb.0:
  ; GFX1250-NEXT:   successors: %bb.1(0x40000000)
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT: bb.1:
  ; GFX1250-NEXT:   successors: %bb.2(0x80000000)
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT:   $vgpr0 = V_MOV_B32_e32 0, implicit $exec
  ; GFX1250-NEXT: {{  $}}
  ; GFX1250-NEXT: bb.2:
  ; GFX1250-NEXT:   S_ENDPGM 0
  ;
  ; GFX1310-LABEL: name: remove_skip_without_vperm_pk16
  ; GFX1310: bb.0:
  ; GFX1310-NEXT:   successors: %bb.1(0x40000000)
  ; GFX1310-NEXT: {{  $}}
  ; GFX1310-NEXT: bb.1:
  ; GFX1310-NEXT:   successors: %bb.2(0x80000000)
  ; GFX1310-NEXT: {{  $}}
  ; GFX1310-NEXT:   $vgpr0 = V_MOV_B32_e32 0, implicit $exec
  ; GFX1310-NEXT: {{  $}}
  ; GFX1310-NEXT: bb.2:
  ; GFX1310-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    successors: %bb.2
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec

  bb.2:
    S_ENDPGM 0
...
