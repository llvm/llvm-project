# RUN: llc -mtriple=amdgpu9.00 -start-before si-shrink-instructions -stop-before si-late-branch-lowering -o - %s | FileCheck -check-prefix=GCN %s

# GCN-LABEL: name: subbrev{{$}}
# GCN:       V_SUBBREV_U32_e32 0, undef $vgpr0, implicit-def dead $vcc, implicit killed $vcc, implicit $exec

---
name:            subbrev
tracksRegLiveness: true
body:             |
  bb.0:

    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = IMPLICIT_DEF
    %3:sreg_64_xexec = V_CMP_GT_U32_e64 %0, %1, implicit $exec
    %4:vgpr_32, %5:sreg_64_xexec = V_SUBBREV_U32_e64 0, %0, %3, 0, implicit $exec
    GLOBAL_STORE_DWORD undef $vgpr0_vgpr1, %4, 0, 0, implicit $exec

...

# GCN-LABEL: name: subb{{$}}
# GCN:       V_SUBBREV_U32_e32 0, undef $vgpr0, implicit-def dead $vcc, implicit killed $vcc, implicit $exec

---
name:            subb
tracksRegLiveness: true
body:             |
  bb.0:

    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = IMPLICIT_DEF
    %3:sreg_64_xexec = V_CMP_GT_U32_e64 %0, %1, implicit $exec
    %4:vgpr_32, %5:sreg_64_xexec = V_SUBB_U32_e64 %0, 0, %3, 0, implicit $exec
    GLOBAL_STORE_DWORD undef $vgpr0_vgpr1, %4, 0, 0, implicit $exec

...

# GCN-LABEL: name: addc{{$}}
# GCN:       V_ADDC_U32_e32 0, undef $vgpr0, implicit-def dead $vcc, implicit killed $vcc, implicit $exec

---
name:            addc
tracksRegLiveness: true
body:             |
  bb.0:

    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = IMPLICIT_DEF
    %3:sreg_64_xexec = V_CMP_GT_U32_e64 %0, %1, implicit $exec
    %4:vgpr_32, %5:sreg_64_xexec = V_ADDC_U32_e64 0, %0, %3, 0, implicit $exec
    GLOBAL_STORE_DWORD undef $vgpr0_vgpr1, %4, 0, 0, implicit $exec

...

# GCN-LABEL: name: addc2{{$}}
# GCN:       V_ADDC_U32_e32 0, undef $vgpr0, implicit-def dead $vcc, implicit killed $vcc, implicit $exec

---
name:            addc2
tracksRegLiveness: true
body:             |
  bb.0:

    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = IMPLICIT_DEF
    %3:sreg_64_xexec = V_CMP_GT_U32_e64 %0, %1, implicit $exec
    %4:vgpr_32, %5:sreg_64_xexec = V_ADDC_U32_e64 %0, 0, %3, 0, implicit $exec
    GLOBAL_STORE_DWORD undef $vgpr0_vgpr1, %4, 0, 0, implicit $exec

...
