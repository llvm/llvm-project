# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# %c0 is read twice by MFMAs we are converting: once as src2, which becomes an
# AGPR, and once as a scale operand, which stays VGPR-only in AGPR form. So
# whether a use can read the AGPR result is a property of the operand, not of
# the instruction -- the scale operand still needs a bridge copy back to a VGPR.

--- |
  define void @scale_operand_use() #0 {
  entry:
    unreachable
  }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            scale_operand_use
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: scale_operand_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %init:areg_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p7:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p8:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   KILL [[DEF]], %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:av_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:av_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF3:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64_:%[0-9]+]]:areg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64 [[DEF1]], [[DEF2]], %init, 4, 4, [[DEF3]], [[DEF3]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %c1:areg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64 [[DEF1]], [[DEF2]], [[V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64_]], 4, 4, [[DEF3]], [[DEF3]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_128_align2 = COPY [[V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64_]]
  ; CHECK-NEXT:   %c2:areg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64 [[DEF1]], [[DEF2]], %c1, 4, 4, [[COPY]].sub0, [[DEF3]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %c3:areg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_e64 [[DEF1]], [[DEF2]], %c2, 4, 4, [[DEF3]], [[DEF3]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   KILL %c3
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %p7:vreg_1024 = IMPLICIT_DEF
    %p8:vreg_1024 = IMPLICIT_DEF

    %a:av_128_align2 = IMPLICIT_DEF
    %b:av_128_align2 = IMPLICIT_DEF
    %sc:vgpr_32 = IMPLICIT_DEF
    %init:vreg_128_align2 = IMPLICIT_DEF

    S_BRANCH %bb.1

  bb.1:
    %c0:vreg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_vgprcd_e64 %a, %b, %init, 4, 4, %sc, %sc, 0, 0, implicit $mode, implicit $exec
    %c1:vreg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_vgprcd_e64 %a, %b, %c0, 4, 4, %sc, %sc, 0, 0, implicit $mode, implicit $exec
    %c2:vreg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_vgprcd_e64 %a, %b, %c1, 4, 4, %c0.sub0, %sc, 0, 0, implicit $mode, implicit $exec
    %c3:vreg_128_align2 = contract nofpexcept V_MFMA_SCALE_F32_16X16X128_F8F6F4_f4_f4_vgprcd_e64 %a, %b, %c2, 4, 4, %sc, %sc, 0, 0, implicit $mode, implicit $exec

    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
    KILL %c3
    S_ENDPGM 0
...
