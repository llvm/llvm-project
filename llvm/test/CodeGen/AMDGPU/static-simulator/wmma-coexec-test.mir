    $sgpr1 = S_MOV_B32 1
    $sgpr2 = S_MOV_B32 2
    $sgpr3 = S_MOV_B32 3
    $sgpr4 = S_MOV_B32 4
    $vgpr24 = V_EXP_F32_e32 $vgpr0, implicit $exec, implicit $mode, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2, implicit $sgpr3, implicit $sgpr4
    $vgpr25 = V_EXP_F32_e32 $vgpr1, implicit $exec, implicit $mode
    S_ENDPGM 0, implicit $vgpr16, implicit $vgpr24, implicit $vgpr25, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2, implicit $sgpr3, implicit $sgpr4
...

