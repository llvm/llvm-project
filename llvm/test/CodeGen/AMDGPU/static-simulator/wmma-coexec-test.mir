# RUN: llc -mtriple=amdgpu12.50 -amdgpu-enable-static-simulator -amdgpu-static-sim-verbose -debug-only=amdgpu-static-simulator -run-pass=amdgpu-static-simulator -filetype=null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# ============================================================================
# WMMA Co-execution Tests
# ============================================================================
# BF16 16x16x32 pattern: 0EIIEEIIV (9 cycles, occupancy 8)
# E0: CTRL | E: CTRL/SALU/MEM | I: CTRL/SALU/MEM/VALU/TRANS
# V: CTRL/SALU/MEM/WMMA
# F8F6F4 wider inputs: 0EEIEEIIVV, or 0EEIEEISVV when scaled (occupancy 8)
# Two FP4 inputs: 0EEIVV, or 0EESVV when scaled (occupancy 4)
# ============================================================================

---
# MSB_SET fused free, SALU in E-slot, VALU in I-slots - no stalls
name: wmma_basic_coexec
# CHECK-LABEL: wmma_basic_coexec
# CHECK: End BB#0: 7 insts, 5 cycles, 0 stalls
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23
    $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 8, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 0, 0, 0, 0, implicit $exec
    S_SET_VGPR_MSB 4, implicit-def $mode
    $sgpr0 = S_MOV_B32 100
    $vgpr24 = V_MOV_B32_e32 40, implicit $exec
    S_SET_VGPR_MSB 2, implicit-def $mode
    $vgpr25 = V_MOV_B32_e32 41, implicit $exec
    S_ENDPGM 0, implicit $vgpr16, implicit $vgpr24, implicit $vgpr25, implicit $sgpr0
...

---
# Memory ops co-execute in E/I slots
name: wmma_with_memory_coexec
# CHECK-LABEL: wmma_with_memory_coexec
# CHECK: End BB#0: 4 insts, 4 cycles, 0 stalls
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, $vgpr24
    $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 8, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 0, 0, 0, 0, implicit $exec
    $vgpr28_vgpr29_vgpr30_vgpr31 = DS_READ_B128_gfx9 $vgpr24, 0, 0, implicit $exec
    $vgpr32_vgpr33_vgpr34_vgpr35 = DS_READ_B128_gfx9 $vgpr24, 16, 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr16, implicit $vgpr28, implicit $vgpr32
...

---
# Verify that DS_READ stalls in E0 of a scaled WMMA with two F4 inputs.
name: wmma_scale_e0_blocks_ds_then_ssrc
# CHECK-LABEL: wmma_scale_e0_blocks_ds_then_ssrc
# CHECK: Class: WMMA | Unit: XDL | Occupancy: 4 | Window: 6
# CHECK: End BB#0: 6 insts, 7 cycles, 1 stalls
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr50_vgpr51_vgpr52_vgpr53_vgpr54_vgpr55_vgpr56_vgpr57_vgpr58_vgpr59_vgpr60_vgpr61_vgpr62_vgpr63_vgpr64_vgpr65, $vgpr114_vgpr115_vgpr116_vgpr117_vgpr118_vgpr119_vgpr120_vgpr121_vgpr122_vgpr123_vgpr124_vgpr125_vgpr126_vgpr127_vgpr128_vgpr129, $vgpr154_vgpr155_vgpr156_vgpr157_vgpr158_vgpr159_vgpr160_vgpr161, $sgpr86, $sgpr87, $vgpr200
    early-clobber $vgpr154_vgpr155_vgpr156_vgpr157_vgpr158_vgpr159_vgpr160_vgpr161 = V_WMMA_SCALE_F32_16X16X128_F8F6F4_f8_f8_w32_threeaddr $vgpr114_vgpr115_vgpr116_vgpr117_vgpr118_vgpr119_vgpr120_vgpr121_vgpr122_vgpr123_vgpr124_vgpr125_vgpr126_vgpr127_vgpr128_vgpr129, $vgpr50_vgpr51_vgpr52_vgpr53_vgpr54_vgpr55_vgpr56_vgpr57_vgpr58_vgpr59_vgpr60_vgpr61_vgpr62_vgpr63_vgpr64_vgpr65, 8, 0, $sgpr87, $sgpr86, 4, 4, 0, 0, 0, 0, 0, 0, 0, 0, implicit $exec
    $vgpr28_vgpr29_vgpr30_vgpr31 = DS_READ_B128_gfx9 $vgpr200, 0, 0, implicit $exec
    $vgpr32_vgpr33_vgpr34_vgpr35 = DS_READ_B128_gfx9 $vgpr200, 16, 0, implicit $exec
    $vgpr36_vgpr37_vgpr38_vgpr39 = DS_READ_B128_gfx9 $vgpr200, 32, 0, implicit $exec
    $vgpr40_vgpr41_vgpr42_vgpr43 = DS_READ_B128_gfx9 $vgpr200, 48, 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr154, implicit $vgpr28, implicit $vgpr32, implicit $vgpr36, implicit $vgpr40
...

---
# 7 SALUs fill slots 1-7, VALU lands in V-slot (8) - stall=1
name: valu_blocked_in_v_stage
# CHECK-LABEL: valu_blocked_in_v_stage
# CHECK: End BB#0: 10 insts, 11 cycles, 1 stalls
# CHECK: WMMACoExec:1(VALU:1)
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23
    $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 8, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 0, 0, 0, 0, implicit $exec
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 1
    $sgpr2 = S_MOV_B32 2
    $sgpr3 = S_MOV_B32 3
    $sgpr4 = S_MOV_B32 4
    $sgpr5 = S_MOV_B32 5
    $sgpr6 = S_MOV_B32 6
    $vgpr24 = V_MOV_B32_e32 40, implicit $exec
    S_ENDPGM 0, implicit $vgpr16, implicit $vgpr24, implicit $sgpr0, implicit $sgpr1, implicit $sgpr2, implicit $sgpr3, implicit $sgpr4, implicit $sgpr5, implicit $sgpr6
...

---
# 5 SALUs, then V_EXP in I-slot OK; 2nd V_EXP waits FU+V-slot - stall=2
name: trans_fu_lands_in_v_stage
# CHECK-LABEL: trans_fu_lands_in_v_stage
# CHECK: End BB#0: 9 insts, 11 cycles, 2 stalls
# CHECK: WMMACoExec:2(TRANS:2)
