    ; BASIC-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = GLOBAL_LOAD_DWORDX4_SADDR $sgpr2_sgpr3, killed renamable $vgpr0, 0, 0, implicit $exec
    ; BASIC-NEXT: renamable $vgpr1 = V_MOV_B32_e32 1, implicit $exec
    ; BASIC-NEXT: renamable $vgpr0 = V_MOV_B32_e32 2, implicit $exec
