    ; BASIC-NEXT: $sgpr0 = SI_RESTORE_S32_FROM_VGPR killed $vgpr31, 0
    ; BASIC-NEXT: INLINEASM &"; def $0", sideeffect attdialect, regdef:VGPR_32, def renamable $vgpr0
    ; BASIC-NEXT: SI_SPILL_AV32_SAVE killed $vgpr0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    ; BASIC-NEXT: INLINEASM &"; clobber vgprs and agprs", sideeffect attdialect, clobber, implicit-def dead early-clobber $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, clobber, implicit-def dead early-clobber $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, clobber, implicit-def dead early-clobber $vgpr24_vgpr25_vgpr26_vgpr27, clobber, implicit-def dead early-clobber $vgpr28_vgpr29, clobber, implicit-def dead early-clobber $vgpr30, clobber, implicit-def dead early-clobber $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15_agpr16_agpr17_agpr18_agpr19_agpr20_agpr21_agpr22_agpr23_agpr24_agpr25_agpr26_agpr27_agpr28_agpr29_agpr30_agpr31
    ; BASIC-NEXT: renamable $vgpr0 = SI_SPILL_AV32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    ; BASIC-NEXT: renamable $vgpr1 = V_MOV_B32_e32 0, implicit $exec
    ; BASIC-NEXT: GLOBAL_STORE_DWORD_SADDR killed renamable $vgpr1, killed renamable $vgpr0, $sgpr2_sgpr3, 0, 0, implicit $exec
