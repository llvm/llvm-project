# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=amdgpu-reserve-wwm-regs,greedy,amdgpu-rewrite-agpr-copy-mfma,virt-reg-rewriter -o - %s | FileCheck --check-prefix=GREEDY %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes='amdgpu-reserve-wwm-regs,greedy<vgpr>,amdgpu-rewrite-agpr-copy-mfma,virt-reg-rewriter' -o - %s | FileCheck --check-prefix=GREEDY %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=amdgpu-reserve-wwm-regs,regallocbasic,amdgpu-rewrite-agpr-copy-mfma,virt-reg-rewriter -o - %s | FileCheck --check-prefix=BASIC %s

# $vgpr31 holds an SGPR spill lane and is only reserved by AMDGPUReserveWWMRegs,
# after the MIR parser froze the reserved registers, so the pass list must start
# there for the shared RegisterClassInfo to be stale until the allocator updates
# it. %5 is AGPR-only, so the MFMA is rewritten to AGPRs, and the clobber leaves
# %6 a spill slot for which only the reserved $vgpr31 has no interference.
# Assigning it, by the allocator or by the spill elimination, fails an assertion
# in VirtRegMap or, without assertions, the machine verifier. Regenerated checks
# must keep V_MFMA_I32_4X4X4I8_e64 (the MFMA was not rewritten, so no spill
# elimination runs) and SI_SPILL_AV32_SAVE (no spill): without them, the
# intended scenario is gone.

--- |
  define amdgpu_kernel void @reserved_wwm_vgpr_not_in_alloc_order() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-agpr-alloc"="32,32" "amdgpu-waves-per-eu"="8,8" }
...
---
name: reserved_wwm_vgpr_not_in_alloc_order
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $sgpr0, $sgpr2_sgpr3
    ; GREEDY-LABEL: name: reserved_wwm_vgpr_not_in_alloc_order
    ; GREEDY: liveins: $sgpr0, $sgpr2_sgpr3
    ; GREEDY-NEXT: {{  $}}
    ; GREEDY-NEXT: $vgpr31 = IMPLICIT_DEF
    ; GREEDY-NEXT: $vgpr31 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, killed $vgpr31
    ; GREEDY-NEXT: renamable $vgpr6 = V_MOV_B32_e32 0, implicit $exec
    ; GREEDY-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = GLOBAL_LOAD_DWORDX4_SADDR $sgpr2_sgpr3, renamable $vgpr6, 0, 0, implicit $exec
    ; GREEDY-NEXT: renamable $vgpr4 = V_MOV_B32_e32 1, implicit $exec
    ; GREEDY-NEXT: renamable $vgpr5 = V_MOV_B32_e32 2, implicit $exec
    ; GREEDY-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = V_MFMA_I32_4X4X4I8_e64 killed $vgpr4, killed $vgpr5, killed $agpr0_agpr1_agpr2_agpr3, 0, 0, 0, implicit $mode, implicit $exec
    ; GREEDY-NEXT: GLOBAL_STORE_DWORDX4_SADDR killed renamable $vgpr6, killed renamable $agpr0_agpr1_agpr2_agpr3, $sgpr2_sgpr3, 0, 0, implicit $exec
    ; GREEDY-NEXT: $sgpr0 = SI_RESTORE_S32_FROM_VGPR killed $vgpr31, 0
    ; GREEDY-NEXT: INLINEASM &"; def $0", sideeffect attdialect, regdef:VGPR_32, def renamable $vgpr0
    ; GREEDY-NEXT: SI_SPILL_AV32_SAVE killed $vgpr0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    ; GREEDY-NEXT: INLINEASM &"; clobber vgprs and agprs", sideeffect attdialect, clobber, implicit-def dead early-clobber $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, clobber, implicit-def dead early-clobber $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, clobber, implicit-def dead early-clobber $vgpr24_vgpr25_vgpr26_vgpr27, clobber, implicit-def dead early-clobber $vgpr28_vgpr29, clobber, implicit-def dead early-clobber $vgpr30, clobber, implicit-def dead early-clobber $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15_agpr16_agpr17_agpr18_agpr19_agpr20_agpr21_agpr22_agpr23_agpr24_agpr25_agpr26_agpr27_agpr28_agpr29_agpr30_agpr31
    ; GREEDY-NEXT: renamable $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    ; GREEDY-NEXT: renamable $vgpr1 = SI_SPILL_AV32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    ; GREEDY-NEXT: GLOBAL_STORE_DWORD_SADDR killed renamable $vgpr0, killed renamable $vgpr1, $sgpr2_sgpr3, 0, 0, implicit $exec
    ; GREEDY-NEXT: S_ENDPGM 0, implicit $sgpr0
    ;
    ; BASIC-LABEL: name: reserved_wwm_vgpr_not_in_alloc_order
