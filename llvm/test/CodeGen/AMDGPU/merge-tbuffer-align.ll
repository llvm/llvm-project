; CHECK-NEXT:    ; return to shader part epilog
  %o4 = add i32 %voff, 4
  %a = call float @llvm.amdgcn.struct.ptr.tbuffer.load.f32(ptr addrspace(8) %rsrc, i32 %vidx, i32 %voff, i32 0, i32 22, i32 0)
