tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0, $vgpr1_vgpr2

    ; CHECK-LABEL: name: freeze_sgpr_moved_to_valu
    ; CHECK: liveins: $vgpr0, $sgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vreg_64 = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 [[COPY]], [[COPY2]], 0, implicit $exec
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:vgpr_32 = FREEZE [[V_ADD_U32_e64_]]
    ; CHECK-NEXT: [[V_MUL_LO_U32_e64_:%[0-9]+]]:vgpr_32 = V_MUL_LO_U32_e64 [[FREEZE]], [[FREEZE]], implicit $exec
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[V_MUL_LO_U32_e64_]]
    ; CHECK-NEXT: GLOBAL_STORE_DWORD [[COPY1]], [[COPY3]], 0, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vreg_64 = COPY $vgpr1_vgpr2
    %2:sreg_32 = COPY $sgpr0
    %3:sreg_32 = COPY %0
    %4:sreg_32 = S_ADD_I32 %3, %2, implicit-def dead $scc
    %5:sreg_32 = FREEZE %4
    %6:sreg_32 = S_MUL_I32 %5, %5
    %7:vgpr_32 = COPY %6
