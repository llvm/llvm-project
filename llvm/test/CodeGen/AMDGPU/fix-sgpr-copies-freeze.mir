# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=si-fix-sgpr-copies -o - %s | FileCheck %s

---
name: freeze_vgpr_to_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2

    ; CHECK-LABEL: name: freeze_vgpr_to_sgpr
    ; CHECK: liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vreg_64 = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:vgpr_32 = FREEZE [[COPY]]
    ; CHECK-NEXT: [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 [[FREEZE]], [[FREEZE]], 0, implicit $exec
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[V_ADD_U32_e64_]]
    ; CHECK-NEXT: GLOBAL_STORE_DWORD [[COPY1]], [[COPY2]], 0, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = COPY $vgpr0
    %1:vreg_64 = COPY $vgpr1_vgpr2
    %2:sreg_32 = FREEZE %0
    %3:sreg_32 = S_ADD_I32 %2, %2, implicit-def dead $scc
    %4:vgpr_32 = COPY %3
    GLOBAL_STORE_DWORD %1, %4, 0, 0, implicit $exec
    S_ENDPGM 0
...
