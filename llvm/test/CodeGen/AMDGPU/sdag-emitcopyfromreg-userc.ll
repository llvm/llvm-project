; RUN: llc -mtriple=amdgpu9.00 -stop-after=finalize-isel -o - %s | FileCheck %s

;; Reading a uniform physical SGPR ($m0) gives RegClassForVT = SReg_32.
;; When the only user requires an allocatable disjoint register class (VGPR_32
;; for DS_SWIZZLE_B32's src operand), EmitCopyFromReg should directly create a
;; vgpr_32 virtual register rather than copying to sreg_32 first and emitting a
;; second copy to vgpr_32.
define amdgpu_ps float @copy_from_phys_sgpr_to_vgpr_use() {
  ; CHECK-LABEL: name: copy_from_phys_sgpr_to_vgpr_use
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $m0
  ; CHECK-NEXT:   [[DS_SWIZZLE_B32_:%[0-9]+]]:vgpr_32 = DS_SWIZZLE_B32 [[COPY]], 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr0 = COPY [[DS_SWIZZLE_B32_]]
  ; CHECK-NEXT:   SI_RETURN_TO_EPILOG $vgpr0
  %s_val = call i32 @llvm.read_register.i32(metadata !0)
  %swz = call i32 @llvm.amdgcn.ds.swizzle(i32 %s_val, i32 0)
  %res = bitcast i32 %swz to float
  ret float %res
}

;; When the user operand allows a non-allocatable union class (VS_32 for
;; V_ADD_U32_e64's src0 operand), delaying getAllocatableClass until after
;; intersecting UseRC (VS_32) with RegClassForVT (SReg_32) preserves the SGPR
;; class (sreg_32) instead of prematurely collapsing VS_32 to vgpr_32.
define amdgpu_ps float @copy_from_phys_sgpr_to_vs32_use(i32 %v_op) {
  ; CHECK-LABEL: name: copy_from_phys_sgpr_to_vs32_use
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $m0
  ; CHECK-NEXT:   [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 [[COPY1]], [[COPY]], 0, implicit $exec
  ; CHECK-NEXT:   $vgpr0 = COPY [[V_ADD_U32_e64_]]
  ; CHECK-NEXT:   SI_RETURN_TO_EPILOG $vgpr0
  %s_val = call i32 @llvm.read_register.i32(metadata !0)
  %res = add i32 %s_val, %v_op
  %res.f = bitcast i32 %res to float
  ret float %res.f
}

;; When multiple users constrain the physical SGPR copy to both VS_32
;; (V_ADD3_U32_e64) and VGPR_32 (DS_SWIZZLE_B32), delaying getAllocatableClass
;; allows the user loop to narrow UseRC to the common subclass VGPR_32 and emit
;; a single copy from $m0 to vgpr_32.
define amdgpu_ps float @copy_from_phys_sgpr_to_vs32_and_vgpr_uses(i32 %v_op) {
  ; CHECK-LABEL: name: copy_from_phys_sgpr_to_vs32_and_vgpr_uses
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $m0
  ; CHECK-NEXT:   [[DS_SWIZZLE_B32_:%[0-9]+]]:vgpr_32 = DS_SWIZZLE_B32 [[COPY1]], 0, 0, implicit $exec
  ; CHECK-NEXT:   [[V_ADD3_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD3_U32_e64 [[COPY1]], [[COPY]], [[DS_SWIZZLE_B32_]], implicit $exec
  ; CHECK-NEXT:   $vgpr0 = COPY [[V_ADD3_U32_e64_]]
  ; CHECK-NEXT:   SI_RETURN_TO_EPILOG $vgpr0
  %s_val = call i32 @llvm.read_register.i32(metadata !0)
  %v_add = add i32 %s_val, %v_op
  %swz = call i32 @llvm.amdgcn.ds.swizzle(i32 %s_val, i32 0)
  %sum = add i32 %v_add, %swz
  %res = bitcast i32 %sum to float
  ret float %res
}

declare i32 @llvm.amdgcn.ds.swizzle(i32, i32 immarg) #0
declare i32 @llvm.read_register.i32(metadata) #1

attributes #0 = { convergent nocallback nofree nounwind willreturn memory(none) }
attributes #1 = { nocallback nofree nosync nounwind willreturn memory(read) }

!0 = !{!"m0"}
