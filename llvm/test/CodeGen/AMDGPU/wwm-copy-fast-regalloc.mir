# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -O0 -start-before=si-lower-sgpr-spills -stop-after=si-lower-wwm-copies -verify-machineinstrs -o %t %s
# RUN: FileCheck %s < %t
# RUN: FileCheck %s --check-prefix=SPILLS < %t

# Fast allocation rewrites WWM_COPY operands before lowering, when VirtRegMap
# is no longer available.

# SPILLS-LABEL: name: fast_wwm_copy
# SPILLS: stack:
# SPILLS-NEXT: - { id: 0, name: '', type: spill-slot, offset: 0, size: 4, alignment: 4,
# SPILLS: - { id: 1, name: '', type: spill-slot, offset: 0, size: 4, alignment: 4,

---
name: fast_wwm_copy
tracksRegLiveness: true
isSSA: false
registers:
  - { id: 0, class: vgpr_32, flags: [ WWM_REG ] }
  - { id: 1, class: vgpr_32, flags: [ WWM_REG ] }
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
  frameOffsetReg: '$sgpr33'
  sgprForEXECCopy: '$sgpr4_sgpr5'
body: |
  bb.0:
    liveins: $vgpr63, $vgpr62, $sgpr30_sgpr31
    ; CHECK-LABEL: name: fast_wwm_copy
    ; CHECK: liveins: $vgpr63, $vgpr62, $sgpr30_sgpr31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr4_sgpr5 = S_MOV_B64 killed $exec
    ; CHECK-NEXT: $exec = S_MOV_B64 -1
    ; CHECK-NEXT: renamable $vgpr0 = COPY killed $vgpr63
    ; CHECK-NEXT: $exec = S_MOV_B64 killed $sgpr4_sgpr5
    ; CHECK-NEXT: $sgpr4_sgpr5 = S_MOV_B64 killed $exec
    ; CHECK-NEXT: $exec = S_MOV_B64 -1
    ; CHECK-NEXT: renamable $vgpr1 = COPY killed $vgpr62
    ; CHECK-NEXT: $exec = S_MOV_B64 killed $sgpr4_sgpr5
    ; CHECK-NEXT: S_NOP 0, implicit killed renamable $vgpr0, implicit killed renamable $vgpr1
    ; CHECK-NEXT: S_SETPC_B64_return killed $sgpr30_sgpr31
    %0 = WWM_COPY $vgpr63
    %1 = WWM_COPY $vgpr62
    S_NOP 0, implicit %0, implicit %1
    S_SETPC_B64_return $sgpr30_sgpr31
...
