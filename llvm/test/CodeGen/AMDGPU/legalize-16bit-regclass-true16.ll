; RUN: llc -mtriple=amdgpu11.00 -mattr=+real-true16 -stop-after=amdgpu-isel < %s| FileCheck -check-prefixes=CHECK %s

; Due to the missing sgpr16 register class a 16bit value lives either in a
; vgpr16 or in the low half of an sgpr32, so ISel has to reconcile the two
; whenever a 16bit def and one of its users disagree. Each test below pins down
; one case of that legalization.

declare i32 @llvm.amdgcn.workitem.id.x()
declare half @llvm.copysign.f16(half, half)

; EXTRACT_SUBREG lo16 of an sgpr32 feeding a VALU user: the source is copied
; into a vgpr32 and the lo16 is extracted from there.
define i16 @src_s32_lo16_use_valu16(half inreg %sign) {
  ; CHECK-LABEL: name: src_s32_lo16_use_valu16
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY [[COPY]]
  ; CHECK-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 32768
  ; CHECK-NEXT:   [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[COPY1]], [[S_MOV_B32_]], implicit-def dead $scc
  ; CHECK-NEXT:   [[S_MOV_B32_1:%[0-9]+]]:sreg_32 = S_MOV_B32 18688
  ; CHECK-NEXT:   [[S_OR_B32_:%[0-9]+]]:sreg_32 = S_OR_B32 [[S_AND_B32_]], [[S_MOV_B32_1]], implicit-def dead $scc
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_16 = COPY [[S_OR_B32_]].lo16
  ; CHECK-NEXT:   $vgpr0 = COPY [[COPY2]]
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  %result = call half @llvm.copysign.f16(half 10.0, half %sign)
  %cast = bitcast half %result to i16
  ret i16 %cast
}

