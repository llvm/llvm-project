# The V2S copy has no SALU-only use chain, so it is turned to VALU via
# moveToVALU instead of v_readfirstlane_b32. getDestEquivalentVGPRClass
# must not narrow the AV-class source to a VGPR-only class.
---
name:            moveto_valu_preserves_av
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: moveto_valu_preserves_av
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: S_NOP 0, implicit [[COPY]]
    %0:av_32 = COPY $vgpr0
    %1:sgpr_32 = COPY %0
    S_NOP 0, implicit %1
...

