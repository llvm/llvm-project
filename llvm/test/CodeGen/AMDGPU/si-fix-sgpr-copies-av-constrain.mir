  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:av_32 = PHI [[COPY]], %bb.0, [[COPY3]], %bb.1
  ; CHECK-NEXT:   $vgpr0 = COPY [[PHI]]
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $agpr0, $sgpr0_sgpr1

    %0:agpr_32 = COPY $agpr0
    %1:av_32 = COPY $vgpr0
    %2:sreg_64 = COPY $sgpr0_sgpr1
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %3:av_32 = COPY %1

  bb.2:
    %4:av_32 = PHI %0, %bb.0, %3, %bb.1
    $vgpr0 = COPY %4
    SI_RETURN implicit $vgpr0
...

# An SGPR PHI feeding a PHI that moves to AGPR moves to AGPR too.
---
name:            phi_sgpr_phi_operand_to_agpr
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_sgpr_phi_operand_to_agpr
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr1, $sgpr2_sgpr3, $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY $sgpr2_sgpr3
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   $vcc = COPY [[COPY2]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:agpr_32 = COPY [[COPY]], implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.2, implicit $vcc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_ADD_U32_:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY1]], implicit-def dead $scc
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:agpr_32 = COPY [[S_ADD_U32_]], implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:agpr_32 = PHI [[COPY4]], %bb.0, [[COPY5]], %bb.1
  ; CHECK-NEXT:   $vcc = COPY [[COPY2]]
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:agpr_32 = COPY [[PHI]], implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.4, implicit $vcc
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[COPY3]], [[COPY3]], implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:agpr_32 = PHI [[COPY6]], %bb.2, [[V_ADD_U32_e32_]], %bb.3
  ; CHECK-NEXT:   [[COPY7:%[0-9]+]]:agpr_32 = COPY [[PHI1]]
  ; CHECK-NEXT:   $agpr0 = COPY [[COPY7]]
  ; CHECK-NEXT:   SI_RETURN implicit $agpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $sgpr1, $sgpr2_sgpr3, $vgpr0
    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    %2:sreg_64 = COPY $sgpr2_sgpr3
    %3:vgpr_32 = COPY $vgpr0
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %4:sreg_32 = S_ADD_U32 %0, %1, implicit-def dead $scc

  bb.2:
    successors: %bb.3, %bb.4
    %5:sreg_32 = PHI %0, %bb.0, %4, %bb.1
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.4, implicit $vcc
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.4
    %6:vgpr_32 = V_ADD_U32_e32 %3, %3, implicit $exec

  bb.4:
    %7:vgpr_32 = PHI %5, %bb.2, %6, %bb.3
    %8:agpr_32 = COPY %7
    $agpr0 = COPY %8
    SI_RETURN implicit $agpr0
...

# A VGPR PHI feeding a PHI that moves to AGPR stays VGPR.
---
name:            phi_vgpr_phi_operand_stays_vgpr
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_vgpr_phi_operand_stays_vgpr
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   $vcc = COPY [[COPY2]]
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.2, implicit $vcc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[COPY]], [[COPY1]], implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, [[V_ADD_U32_e32_]], %bb.1
  ; CHECK-NEXT:   $vcc = COPY [[COPY2]]
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.4, implicit $vcc
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[COPY1]], [[COPY1]], implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:agpr_32 = PHI [[PHI]], %bb.2, [[V_ADD_U32_e32_1]], %bb.3
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:agpr_32 = COPY [[PHI1]]
  ; CHECK-NEXT:   $agpr0 = COPY [[COPY3]]
  ; CHECK-NEXT:   SI_RETURN implicit $agpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:sreg_64 = COPY $sgpr0_sgpr1
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %3:vgpr_32 = V_ADD_U32_e32 %0, %1, implicit $exec

  bb.2:
    successors: %bb.3, %bb.4
    %4:vgpr_32 = PHI %0, %bb.0, %3, %bb.1
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.4, implicit $vcc
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.4
    %5:vgpr_32 = V_ADD_U32_e32 %1, %1, implicit $exec

  bb.4:
    %6:vgpr_32 = PHI %4, %bb.2, %5, %bb.3
    %7:agpr_32 = COPY %6
    $agpr0 = COPY %7
    SI_RETURN implicit $agpr0
...
