    S_CBRANCH_SCC1 %bb.2, implicit killed $scc

  ; fall-through: async-mark predecessor, merged second (non-empty OtherMarks)
  bb.1:
    successors: %bb.3
    liveins: $vgpr0_vgpr1, $vgpr2

    $m0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    ASYNCMARK
    S_BRANCH %bb.3

  ; branch target: load predecessor, merged first (seeds incoming state)
  bb.2:
    successors: %bb.3
    liveins: $vgpr0_vgpr1, $vgpr2

    $m0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    S_BRANCH %bb.3

  bb.3:
    liveins: $vgpr2

    WAIT_ASYNCMARK 0
    renamable $vgpr0 = DS_READ_B32_gfx9 killed $vgpr2, 0, 0, implicit $exec :: (load (s32), addrspace 3)
    S_ENDPGM 0
...
