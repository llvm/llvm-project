    KILL %t50
    KILL %t52
    KILL %t54
    KILL %t56
    KILL %t58
    KILL %t60
    KILL %t62
    KILL %t64
    KILL %t66
    KILL %t68
    KILL %t70
    KILL %t72
    KILL %t74
    KILL %t76
    KILL %t78
    KILL %t80
    KILL %t82
    KILL %t84
    KILL %t86
    KILL %t88
    KILL %t90
    KILL %t92
