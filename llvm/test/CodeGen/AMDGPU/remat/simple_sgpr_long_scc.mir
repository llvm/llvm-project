# RUN: llc -mtriple=amdgcn -mcpu=gfx1030 -mattr=+wavefrontsize32 -verify-machineinstrs %s -o - -run-pass=amdgpu-hot-block-remat -amdgpu-remat-aggressive | FileCheck %s

# SCC-defining instructions (S_NOT_B32) are sunk into a block that also
# contains a live SCC computation. The SCC-smash guard must keep SCC valid;
# -verify-machineinstrs on the RUN line confirms SCC is not corrupted.
# CHECK: bb.0:
# CHECK-NOT: = S_NOT_B32
# CHECK: bb.2:
# CHECK: = S_NOT_B32 0

--- |
  define amdgpu_ps void @main() {
    ret void
  }
...
---
name:            main
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    %v0:vreg_1024 = IMPLICIT_DEF
    %v1:vreg_1024 = IMPLICIT_DEF
    %v2:vreg_1024 = IMPLICIT_DEF
    %v3:vreg_1024 = IMPLICIT_DEF

    %t0:sgpr_32 = S_NOT_B32 0, implicit-def $scc
    %t2:sgpr_32 = S_NOT_B32 1, implicit-def $scc
    %t4:sgpr_32 = S_NOT_B32 2, implicit-def $scc
    %t6:sgpr_32 = S_NOT_B32 3, implicit-def $scc
    %t8:sgpr_32 = S_NOT_B32 4, implicit-def $scc
