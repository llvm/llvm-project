# RUN: llc -mtriple=amdgcn -mcpu=gfx1030 -mattr=+wavefrontsize32 -verify-machineinstrs %s -o - -run-pass=amdgpu-hot-block-remat -amdgpu-remat-aggressive | FileCheck %s

# Check that the scalar descriptor loads are sunk out of bb.0 and cloned/moved
# to their uses in bb.2.
# CHECK: bb.0:
# CHECK-NOT: S_LOAD_DWORDX4_IMM
# CHECK: bb.2:
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 0, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 16, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 32, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 48, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 64, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 80, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 96, 0
# CHECK: S_LOAD_DWORDX4_IMM %ptr, 112, 0

--- |
  define amdgpu_ps void @main() {
    ret void
  }
...
---
name:            main
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    ; Inflate VGPR count so occupancy is limited and SGPR pressure is hot.
    %v0:vreg_1024 = IMPLICIT_DEF
    %v1:vreg_1024 = IMPLICIT_DEF
    %v2:vreg_1024 = IMPLICIT_DEF
    %v3:vreg_1024 = IMPLICIT_DEF

    %ptr:sgpr_64 = IMPLICIT_DEF

    ; Descriptor loads defined early, used only in bb.2.
    %t0:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 0, 0
    %t2:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 16, 0
    %t4:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 32, 0
    %t6:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 48, 0
    %t8:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 64, 0
    %t10:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 80, 0
    %t12:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 96, 0
    %t14:sgpr_128 = S_LOAD_DWORDX4_IMM %ptr, 112, 0

    ; Branch
    %cmp:sreg_32_xm0 = V_CMP_GT_F32_e64 0, 0, 0, %v0.sub0, 0, implicit $exec, implicit $mode
    $exec_lo = S_MOV_B32_term %cmp:sreg_32_xm0
    S_CBRANCH_EXECZ %bb.2, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    S_BRANCH %bb.2

  bb.2:
    KILL %t0
    KILL %t2
    KILL %t4
    KILL %t6
    KILL %t8
    KILL %t10
    KILL %t12
    KILL %t14

    ; Uses to inflate VGPR count.
    KILL %v0
    KILL %v1
    KILL %v2
    KILL %v3
    S_ENDPGM 0
...
