    %6:sgpr_64 = IMPLICIT_DEF
    %9:vgpr_32 = IMPLICIT_DEF
    %0:sreg_32 = COPY $exec_lo, implicit-def $exec_lo
    S_CBRANCH_EXECZ %bb.2, implicit $exec
