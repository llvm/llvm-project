    %11:vgpr_32 = V_MOV_B32_e32 4, implicit $exec
    GLOBAL_STORE_ASYNC_FROM_LDS_B128_SADDR %6, %11, %3, 0, 0, implicit-def dead $asynccnt, implicit $exec, implicit $asynccnt

  bb.2:
    $exec_lo = S_OR_B32 $exec_lo, %0, implicit-def $scc
    S_ENDPGM 0
...
