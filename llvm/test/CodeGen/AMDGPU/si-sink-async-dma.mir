  ; CHECK-NEXT:   [[DEF4:%[0-9]+]]:sgpr_64 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[SI_IF:%[0-9]+]]:sreg_32 = SI_IF [[DEF2]], %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
