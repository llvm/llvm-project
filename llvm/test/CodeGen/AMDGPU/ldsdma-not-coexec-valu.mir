# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# LDSDMA must not be treated as a co-executable VALU by the WMMA co-execution
# hazard handling. Here the LDSDMA reads $vgpr16 (its vaddr), which overlaps the
# WMMA result in $vgpr16_..._vgpr23. If LDSDMA were a co-executable VALU it would
# be a hazard victim and require V_NOP padding after the WMMA; it must not be.
# RUN: llc -mtriple=amdgpu12.50 -run-pass=post-RA-hazard-rec -o - %s | FileCheck %s

---
name: ldsdma_not_coexec_valu_victim
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_256, $vgpr8_256, $vgpr16_256, $sgpr0_64
    ; CHECK-LABEL: name: ldsdma_not_coexec_valu_victim
    ; CHECK: liveins: $vgpr0_256, $vgpr8_256, $vgpr16_256, $sgpr0_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $exec = IMPLICIT_DEF
    ; CHECK-NEXT: $m0 = IMPLICIT_DEF
    ; CHECK-NEXT: early-clobber $vgpr16_256 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_256, $vgpr8_256, 8, $vgpr16_256, 0, 0, 0, 0, implicit $exec
    ; CHECK-NEXT: GLOBAL_LOAD_LDS_DWORD_SADDR $sgpr0_64, $vgpr16, 0, 0, 0, implicit $m0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $exec = IMPLICIT_DEF
    $m0 = IMPLICIT_DEF
    $vgpr16_256 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_256, $vgpr8_256, 8, $vgpr16_256, 0, 0, 0, 0, implicit $exec
    GLOBAL_LOAD_LDS_DWORD_SADDR $sgpr0_64, $vgpr16, 0, 0, 0, implicit $m0, implicit $exec
    S_ENDPGM 0
...
