liveins:
  - { reg: '$vgpr0', virtual-reg: '%50' }
  - { reg: '$sgpr4_sgpr5', virtual-reg: '%53' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  explicitKernArgSize: 36
  maxKernArgAlign: 16
  ldsSize:         0
  gdsSize:         0
  dynLDSAlign:     1
  isEntryFunction: true
  isChainFunction: false
  memoryBound:     true
  waveLimiter:     true
  hasSpilledSGPRs: false
  hasSpilledVGPRs: false
  hasNoWWMPoolSGPRSpillFallback: false
  numWaveDispatchSGPRs: 0
  numWaveDispatchVGPRs: 0
  scratchRSrcReg:  '$private_rsrc_reg'
  frameOffsetReg:  '$fp_reg'
  stackPtrOffsetReg: '$sgpr32'
  bytesInStackArgArea: 0
  returnsVoid:     true
  argumentInfo:
    dispatchPtr:     { reg: '$sgpr0_sgpr1' }
    queuePtr:        { reg: '$sgpr2_sgpr3' }
    kernargSegmentPtr: { reg: '$sgpr4_sgpr5' }
    dispatchID:      { reg: '$sgpr6_sgpr7' }
    workGroupIDX:    { reg: '$sgpr8' }
    workGroupIDY:    { reg: '$sgpr9' }
    workGroupIDZ:    { reg: '$sgpr10' }
    workItemIDX:     { reg: '$vgpr0', mask: 1023 }
    workItemIDY:     { reg: '$vgpr0', mask: 1047552 }
    workItemIDZ:     { reg: '$vgpr0', mask: 1072693248 }
  psInputAddr:     0
  psInputEnable:   0
  maxMemoryClusterDWords: 8
  mode:
    ieee:            true
    dx10-clamp:      true
    fp32-input-denormals: true
    fp32-output-denormals: true
    fp64-fp16-input-denormals: true
    fp64-fp16-output-denormals: true
  highBitsOf32BitAddress: 0
  occupancy:       7
  vgprForAGPRCopy: ''
  sgprForEXECCopy: '$sgpr56_sgpr57'
  longBranchReservedReg: ''
  hasInitWholeWave: false
  dynamicVGPRBlockSize: 0
  scratchReservedForDynamicVGPRs: 0
  numKernargPreloadSGPRs: 0
  isWholeWaveFunction: false
  minNumAGPRs:     4294967295
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $vgpr0, $sgpr4_sgpr5

    %53:sgpr_64(p4) = COPY $sgpr4_sgpr5
    %50:vgpr_32(i32) = COPY $vgpr0
    early-clobber %312:sgpr_256 = S_LOAD_DWORDX8_IMM_ec %53(p4), 0, 0 :: (dereferenceable invariant load (s256) from %ir.out.kernarg.offset25, align 16, addrspace 4)
    %61:sgpr_32 = S_MOV_B32 1077936128
    %66:sreg_32_xm0_xexec = S_LOAD_DWORD_IMM %53(p4), 32, 0 :: (dereferenceable invariant load (s32) from %ir.iterations.kernarg.offset, align 16, addrspace 4)
    early-clobber %3:sgpr_512 = S_LOAD_DWORDX16_IMM_ec %312.sub2_sub3, 0, 0 :: (volatile load (s512) from %ir.1, align 16, addrspace 4)
    KILL %53(p4)
    early-clobber %4:sgpr_512 = S_LOAD_DWORDX16_IMM_ec %312.sub2_sub3, 0, 0 :: (volatile load (s512) from %ir.1, align 16, addrspace 4)
    %313:sreg_32 = S_MOV_B32 0
    undef %73.sub0:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 1065353216, implicit $exec
    %73.sub1:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 1073741824, implicit $exec
    %73.sub2:vreg_128_align2 = COPY %61, implicit $exec
    %73.sub3:vreg_128_align2 = V_MOV_B32_e32 1088421888, implicit $exec
    undef %72.sub0:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 1065353216, implicit $exec
    %72.sub1:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 1073741824, implicit $exec
    %72.sub3:vreg_128_align2 = V_MOV_B32_e32 1086324736, implicit $exec
    undef %71.sub0:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 1065353216, implicit $exec
    %71.sub1:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 1073741824, implicit $exec
    %71.sub3:vreg_128_align2 = V_MOV_B32_e32 1084227584, implicit $exec
    undef %70.sub0:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec
    %70.sub1:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec
    %70.sub2:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec
    %70.sub3:vreg_128_align2 = AV_MOV_B32_IMM_PSEUDO 0, implicit $exec
    %75:av_128_align2 = COPY %312.sub4_sub5_sub6_sub7
    %72.sub2:vreg_128_align2 = COPY %73.sub2
    %71.sub2:vreg_128_align2 = COPY %73.sub2
    early-clobber %5:sgpr_512 = S_LOAD_DWORDX16_IMM_ec %312.sub2_sub3, 0, 0 :: (volatile load (s512) from %ir.1, align 16, addrspace 4)
    early-clobber %6:sgpr_512 = S_LOAD_DWORDX16_IMM_ec %312.sub2_sub3, 0, 0 :: (volatile load (s512) from %ir.1, align 16, addrspace 4)
    early-clobber %7:sgpr_512 = S_LOAD_DWORDX16_IMM_ec %312.sub2_sub3, 0, 0 :: (volatile load (s512) from %ir.1, align 16, addrspace 4)

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)

    %70:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %75, %75, %70, 0, 0, 0, implicit $mode, implicit $exec
    %71:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %75, %75, %71, 0, 0, 0, implicit $mode, implicit $exec
    %72:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %75, %75, %72, 0, 0, 0, implicit $mode, implicit $exec
    %313:sreg_32 = S_ADD_I32 %313, 1, implicit-def dead $scc
    S_CMP_LT_U32 %313, %66, implicit-def $scc
    %73:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %75, %75, %73, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2.exit:
    %91:vgpr_32 = V_AND_B32_e32 1023, %50(i32), implicit $exec
    %93:vgpr_32 = V_MUL_U32_U24_e32 96, %91, implicit $exec
    %95:vgpr_32 = V_LSHLREV_B32_e32 2, %93, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %95, %70, %312.sub0_sub1, 0, 0, implicit $exec :: (store (s128) into %ir.lane.out, align 4, addrspace 1)
    GLOBAL_STORE_DWORDX4_SADDR %95, %71, %312.sub0_sub1, 16, 0, implicit $exec :: (store (s128) into %ir.mfma.out1, align 4, addrspace 1)
    undef %101.sub0:av_128_align2 = COPY %3.sub12
    %101.sub1:av_128_align2 = COPY %3.sub13
    %101.sub2:av_128_align2 = COPY %3.sub14
    %101.sub3:av_128_align2 = COPY %3.sub15
    undef %107.sub0:av_128_align2 = COPY %3.sub8
    %107.sub1:av_128_align2 = COPY %3.sub9
    %107.sub2:av_128_align2 = COPY %3.sub10
    %107.sub3:av_128_align2 = COPY %3.sub11
    undef %113.sub0:av_128_align2 = COPY %3.sub4
    %113.sub1:av_128_align2 = COPY %3.sub5
    %113.sub2:av_128_align2 = COPY %3.sub6
    %113.sub3:av_128_align2 = COPY %3.sub7
    undef %119.sub0:av_128_align2 = COPY %3.sub0
    %119.sub1:av_128_align2 = COPY %3.sub1
