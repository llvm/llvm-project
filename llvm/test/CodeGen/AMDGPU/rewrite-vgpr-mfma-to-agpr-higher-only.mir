# NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --filter "v_mfma|v_accvgpr_(write_b32 a[01],|read_b32 v[0-9]+, a[01]($| ))" --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -amdgpu-num-vgprs-for-wwm-alloc=1 \
# RUN:     -start-after=machine-scheduler %s -o - | FileCheck %s

# The input is the MIR after the machine scheduler for the IR of
# rewrite-vgpr-mfma-to-agpr-higher-only.ll, as it was produced while the
# generic register pressure tracker did not count AV registers. Register
# allocation and the MFMA rewrite do not read pressure sets, so whole-wave
# copies still use AGPR0 and AGPR1, and the rewrite must find the higher AGPRs
# assigned to per-lane values and let an MFMA accumulate directly in AGPRs.

--- |
  target triple = "amdgpu9.50-amd-amdhsa"

  define amdgpu_kernel void @rewrite_with_higher_agprs(ptr addrspace(1) %out, ptr addrspace(4) %uniforms, <8 x half> %input, i32 %iterations) #0 {
  ; CHECK-LABEL: rewrite_with_higher_agprs:
  ; CHECK:    v_accvgpr_write_b32 a1, v15
  ; CHECK:    v_accvgpr_write_b32 a0, v15
  ; CHECK:    v_mfma_f32_16x16x32_f16 v[2:5], a[2:5], a[2:5], v[2:5]
  ; CHECK:    v_mfma_f32_16x16x32_f16 v[10:13], a[2:5], a[2:5], v[10:13]
  ; CHECK:    v_mfma_f32_16x16x32_f16 v[6:9], a[2:5], a[2:5], v[6:9]
  ; CHECK:    v_mfma_f32_16x16x32_f16 a[10:13], a[2:5], a[2:5], a[10:13]
  ; CHECK:    v_accvgpr_read_b32 v15, a1
  ; CHECK:    v_accvgpr_read_b32 v15, a0
  entry:
    %rewrite_with_higher_agprs.kernarg.segment = call nonnull align 16 dereferenceable(296) ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr()
    %out.kernarg.offset25 = bitcast ptr addrspace(4) %rewrite_with_higher_agprs.kernarg.segment to ptr addrspace(4), !amdgpu.uniform !0
    %0 = load <2 x i64>, ptr addrspace(4) %out.kernarg.offset25, align 16, !invariant.load !0
    %uniforms.load27 = extractelement <2 x i64> %0, i64 1
    %1 = inttoptr i64 %uniforms.load27 to ptr addrspace(4), !amdgpu.uniform !0
    %input.kernarg.offset = getelementptr inbounds i8, ptr addrspace(4) %rewrite_with_higher_agprs.kernarg.segment, i64 16, !amdgpu.uniform !0
    %input.load = load <8 x half>, ptr addrspace(4) %input.kernarg.offset, align 16, !invariant.load !0
    %iterations.kernarg.offset = getelementptr inbounds i8, ptr addrspace(4) %rewrite_with_higher_agprs.kernarg.segment, i64 32, !amdgpu.uniform !0
    %iterations.load = load i32, ptr addrspace(4) %iterations.kernarg.offset, align 16, !invariant.load !0
    %uniform0 = load volatile <16 x i32>, ptr addrspace(4) %1, align 16
    %uniform1 = load volatile <16 x i32>, ptr addrspace(4) %1, align 16
    %uniform2 = load volatile <16 x i32>, ptr addrspace(4) %1, align 16
    %uniform3 = load volatile <16 x i32>, ptr addrspace(4) %1, align 16
    %uniform4 = load volatile <16 x i32>, ptr addrspace(4) %1, align 16
    br label %loop

  loop:                                             ; preds = %loop, %entry
    %iter = phi i32 [ 0, %entry ], [ %next, %loop ]
    %2 = phi float [ 1.000000e+00, %entry ], [ %largephi.extractslice1, %loop ]
    %3 = phi float [ 2.000000e+00, %entry ], [ %largephi.extractslice3, %loop ]
    %4 = phi float [ 3.000000e+00, %entry ], [ %largephi.extractslice5, %loop ]
    %5 = phi float [ 7.000000e+00, %entry ], [ %largephi.extractslice7, %loop ]
    %6 = phi float [ 1.000000e+00, %entry ], [ %largephi.extractslice11, %loop ]
    %7 = phi float [ 2.000000e+00, %entry ], [ %largephi.extractslice32, %loop ]
    %8 = phi float [ 3.000000e+00, %entry ], [ %largephi.extractslice53, %loop ]
    %9 = phi float [ 6.000000e+00, %entry ], [ %largephi.extractslice74, %loop ]
    %10 = phi float [ 1.000000e+00, %entry ], [ %largephi.extractslice19, %loop ]
    %11 = phi float [ 2.000000e+00, %entry ], [ %largephi.extractslice310, %loop ]
    %12 = phi float [ 3.000000e+00, %entry ], [ %largephi.extractslice511, %loop ]
    %13 = phi float [ 5.000000e+00, %entry ], [ %largephi.extractslice712, %loop ]
    %14 = phi float [ 0.000000e+00, %entry ], [ %largephi.extractslice117, %loop ]
    %15 = phi float [ 0.000000e+00, %entry ], [ %largephi.extractslice318, %loop ]
    %16 = phi float [ 0.000000e+00, %entry ], [ %largephi.extractslice519, %loop ]
    %17 = phi float [ 0.000000e+00, %entry ], [ %largephi.extractslice720, %loop ]
    %largephi.insertslice021 = insertelement <4 x float> poison, float %14, i64 0
    %largephi.insertslice122 = insertelement <4 x float> %largephi.insertslice021, float %15, i64 1
    %largephi.insertslice223 = insertelement <4 x float> %largephi.insertslice122, float %16, i64 2
    %largephi.insertslice324 = insertelement <4 x float> %largephi.insertslice223, float %17, i64 3
    %largephi.insertslice013 = insertelement <4 x float> poison, float %10, i64 0
    %largephi.insertslice114 = insertelement <4 x float> %largephi.insertslice013, float %11, i64 1
    %largephi.insertslice215 = insertelement <4 x float> %largephi.insertslice114, float %12, i64 2
    %largephi.insertslice316 = insertelement <4 x float> %largephi.insertslice215, float %13, i64 3
    %largephi.insertslice05 = insertelement <4 x float> poison, float %6, i64 0
    %largephi.insertslice16 = insertelement <4 x float> %largephi.insertslice05, float %7, i64 1
    %largephi.insertslice27 = insertelement <4 x float> %largephi.insertslice16, float %8, i64 2
    %largephi.insertslice38 = insertelement <4 x float> %largephi.insertslice27, float %9, i64 3
    %largephi.insertslice0 = insertelement <4 x float> poison, float %2, i64 0
    %largephi.insertslice1 = insertelement <4 x float> %largephi.insertslice0, float %3, i64 1
    %largephi.insertslice2 = insertelement <4 x float> %largephi.insertslice1, float %4, i64 2
    %largephi.insertslice3 = insertelement <4 x float> %largephi.insertslice2, float %5, i64 3
    %mfma0 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input.load, <8 x half> %input.load, <4 x float> %largephi.insertslice324, i32 0, i32 0, i32 0)
    %mfma1 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input.load, <8 x half> %input.load, <4 x float> %largephi.insertslice316, i32 0, i32 0, i32 0)
    %mfma2 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input.load, <8 x half> %input.load, <4 x float> %largephi.insertslice38, i32 0, i32 0, i32 0)
    %mfma3 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input.load, <8 x half> %input.load, <4 x float> %largephi.insertslice3, i32 0, i32 0, i32 0)
    %next = add i32 %iter, 1
    %largephi.extractslice1 = extractelement <4 x float> %mfma3, i64 0
    %largephi.extractslice3 = extractelement <4 x float> %mfma3, i64 1
    %largephi.extractslice5 = extractelement <4 x float> %mfma3, i64 2
    %largephi.extractslice7 = extractelement <4 x float> %mfma3, i64 3
    %largephi.extractslice11 = extractelement <4 x float> %mfma2, i64 0
    %largephi.extractslice32 = extractelement <4 x float> %mfma2, i64 1
    %largephi.extractslice53 = extractelement <4 x float> %mfma2, i64 2
    %largephi.extractslice74 = extractelement <4 x float> %mfma2, i64 3
    %largephi.extractslice19 = extractelement <4 x float> %mfma1, i64 0
    %largephi.extractslice310 = extractelement <4 x float> %mfma1, i64 1
    %largephi.extractslice511 = extractelement <4 x float> %mfma1, i64 2
    %largephi.extractslice712 = extractelement <4 x float> %mfma1, i64 3
    %largephi.extractslice117 = extractelement <4 x float> %mfma0, i64 0
    %largephi.extractslice318 = extractelement <4 x float> %mfma0, i64 1
    %largephi.extractslice519 = extractelement <4 x float> %mfma0, i64 2
    %largephi.extractslice720 = extractelement <4 x float> %mfma0, i64 3
    %done = icmp uge i32 %next, %iterations.load
    br i1 %done, label %exit, label %loop, !structurizecfg.uniform !0, !amdgpu.uniform !0

  exit:                                             ; preds = %loop
    %mfma0.lcssa = phi <4 x float> [ %mfma0, %loop ]
    %mfma1.lcssa = phi <4 x float> [ %mfma1, %loop ]
    %mfma2.lcssa = phi <4 x float> [ %mfma2, %loop ]
    %mfma3.lcssa = phi <4 x float> [ %mfma3, %loop ]
    %out.load26 = extractelement <2 x i64> %0, i64 0
    %18 = inttoptr i64 %out.load26 to ptr addrspace(1)
    %lane = call i32 @llvm.amdgcn.workitem.id.x()
    %lane.offset = call i32 @llvm.amdgcn.mul.u24.i32(i32 %lane, i32 96)
    %idxprom = sext i32 %lane.offset to i64
    %lane.out = getelementptr i32, ptr addrspace(1) %18, i64 %idxprom
    store <4 x float> %mfma0.lcssa, ptr addrspace(1) %lane.out, align 4
    %mfma.out1 = getelementptr i32, ptr addrspace(1) %lane.out, i32 4
    store <4 x float> %mfma1.lcssa, ptr addrspace(1) %mfma.out1, align 4
    %mfma.out2 = getelementptr i32, ptr addrspace(1) %lane.out, i32 8
    store <4 x float> %mfma2.lcssa, ptr addrspace(1) %mfma.out2, align 4
    %mfma.out3 = getelementptr i32, ptr addrspace(1) %lane.out, i32 12
    store <4 x float> %mfma3.lcssa, ptr addrspace(1) %mfma.out3, align 4
    %uniform.out0 = getelementptr i32, ptr addrspace(1) %lane.out, i32 16
    store volatile <16 x i32> %uniform0, ptr addrspace(1) %uniform.out0, align 4
    %uniform.out1 = getelementptr i32, ptr addrspace(1) %lane.out, i32 32
    store volatile <16 x i32> %uniform1, ptr addrspace(1) %uniform.out1, align 4
    %uniform.out2 = getelementptr i32, ptr addrspace(1) %lane.out, i32 48
    store volatile <16 x i32> %uniform2, ptr addrspace(1) %uniform.out2, align 4
    %uniform.out3 = getelementptr i32, ptr addrspace(1) %lane.out, i32 64
    store volatile <16 x i32> %uniform3, ptr addrspace(1) %uniform.out3, align 4
    %uniform.out4 = getelementptr i32, ptr addrspace(1) %lane.out, i32 80
    store volatile <16 x i32> %uniform4, ptr addrspace(1) %uniform.out4, align 4
    ret void
  }





  attributes #0 = { "amdgpu-memory-bound"="true" "amdgpu-num-sgpr"="64" "amdgpu-num-vgpr"="16" "amdgpu-wave-limiter"="true" }

  !0 = !{}
...
