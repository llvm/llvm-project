# RUN: llc -mtriple=amdgpu11.00 -run-pass=register-coalescer -o - %s | FileCheck %s

# Joining the copies makes both bundled V_MOVs define subregisters of %2. %1 is
# joined first, so its def is marked undef; joining %0 then makes it a partial
# redefinition, so the undef flag must be removed again. That has to happen
# inside the bundle as well as on the BUNDLE header.

---
name: subreg_defs_in_bundles
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1
    ; CHECK-LABEL: name: subreg_defs_in_bundles
    ; CHECK:      BUNDLE implicit-def undef [[REG:%[0-9]+]].sub1, implicit $vgpr0, implicit $exec {
    ; CHECK-NEXT: {{^ *}}undef [[REG]].sub1:vreg_64 = V_MOV_B32_e32 $vgpr0, implicit $exec
    ; CHECK-NEXT: }
    ; CHECK-NEXT: BUNDLE implicit-def [[REG]].sub0, implicit $vgpr1, implicit $exec {
    ; CHECK-NEXT: {{^ *}}[[REG]].sub0:vreg_64 = V_MOV_B32_e32 $vgpr1, implicit $exec
    ; CHECK-NEXT: }
    BUNDLE implicit-def %0, implicit $vgpr0, implicit $exec {
      %0:vgpr_32 = V_MOV_B32_e32 $vgpr0, implicit $exec
    }
    BUNDLE implicit-def %1, implicit $vgpr1, implicit $exec {
      %1:vgpr_32 = V_MOV_B32_e32 $vgpr1, implicit $exec
    }
    undef %2.sub0:vreg_64 = COPY %1
    %2.sub1:vreg_64 = COPY %0
    GLOBAL_STORE_DWORDX2_SADDR undef %3:vgpr_32, %2, $sgpr0_sgpr1, 0, 0, implicit $exec
    S_ENDPGM 0
...
