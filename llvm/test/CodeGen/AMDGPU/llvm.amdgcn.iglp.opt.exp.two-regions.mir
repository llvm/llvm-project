# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -start-before=machine-scheduler -stop-before=postmisched -verify-misched -o - %s | FileCheck %s

# The iglp_opt(2) analysis data is computed pre-RA, stored on each IGLP_OPT and
# reused post-RA. Each region must keep its own data: the small kernel region
# must not get the data of the large kernel region, which is analyzed after it.

# CHECK-LABEL: name: small_then_large
# CHECK: IGLP_OPT 2, 32, 33, 1, 2, 4, 3, 0, 1{{$}}
# CHECK: IGLP_OPT 2, 64, 93, 0, 4, 4, 6, 1, 0{{$}}

--- |
  define amdgpu_kernel void @small_then_large() #0 { ret void }
  attributes #0 = { "amdgpu-flat-work-group-size"="256,256" }
...
---
name:            small_then_large
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2, $sgpr3, $sgpr4

