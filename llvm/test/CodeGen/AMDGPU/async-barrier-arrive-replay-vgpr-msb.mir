# NOTE: Do not autogenerate. Check the bank switch inside the workaround and assemble compiler output with fatal warnings.
# RUN: llc -mtriple=amdgpu12.50-amd-amdpal -start-before=si-insert-async-barrier-arrive-workaround -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu12.51-amd-amdpal -start-before=si-insert-async-barrier-arrive-workaround -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu12.50-amd-amdpal -start-before=si-insert-async-barrier-arrive-workaround -o - %s | llvm-mc -triple=amdgpu12.50-amd-amdpal -filetype=null --fatal-warnings
# RUN: llc -mtriple=amdgpu12.51-amd-amdpal -start-before=si-insert-async-barrier-arrive-workaround -o - %s | llvm-mc -triple=amdgpu12.51-amd-amdpal -filetype=null --fatal-warnings

--- |
  define amdgpu_cs void @high_vgpr_arrive() { ret void }
...

---
name: high_vgpr_arrive
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  sgprForEXECCopy: '$sgpr105'
body: |
  bb.0:
    liveins: $vgpr256
    ; The arrival needs a high VGPR, but the dummy uses v[0:1]. The late
    ; encoding pass resets the bank after EXEC is cleared.
    ; CHECK-LABEL: high_vgpr_arrive:
    ; CHECK: s_set_vgpr_msb 1
    ; CHECK-NEXT: ds_atomic_async_barrier_arrive_b64 v0 /*v256*/
    ; CHECK: s_mov_b32 s105, exec_lo
    ; CHECK-NEXT: s_mov_b32 exec_lo, 0
    ; CHECK-NEXT: s_set_vgpr_msb 0x100
    ; CHECK-NEXT: global_load_async_to_lds_b8 v0, v[0:1], off
    ; CHECK-NEXT: s_mov_b32 exec_lo, s105
    DS_ATOMIC_ASYNC_BARRIER_ARRIVE_B64 $vgpr256, 0, 0, implicit-def $asynccnt, implicit $asynccnt, implicit $exec
    S_ENDPGM 0
...
