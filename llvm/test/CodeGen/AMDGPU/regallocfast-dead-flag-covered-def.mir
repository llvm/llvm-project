# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -passes=regallocfast -o - %s | FileCheck %s

# The sub-register def is covered by the live implicit-def of the whole tuple,
# so it must not be marked dead. The check is anchored with {{^}}, since an
# unanchored check also matches a line with a spurious "dead".

---
name:            subreg_def_covered_by_tuple_def
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: subreg_def_covered_by_tuple_def
    ; CHECK: {{^}}    $sgpr4 = S_MOV_B32 0, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7{{$}}
    $sgpr4 = S_MOV_B32 0, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7
    S_ENDPGM 0
...
