# RUN: llc -mtriple=amdgpu6.00 -run-pass=register-coalescer,rename-independent-subregs -o - %s | FileCheck -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu6.00 -passes=register-coalescer,rename-independent-subregs -o - %s | FileCheck -check-prefix=GCN %s
---

# GCN-LABEL: name: mac_invalid_operands
# GCN: undef %17.sub0:vreg_128 = nofpexcept V_MAC_F32_e32 undef %1:vgpr_32, undef %8:vgpr_32, undef %17.sub0, implicit $mode, implicit $exec

name:            mac_invalid_operands
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  frameOffsetReg:  '$sgpr4'

body:             |
  bb.0:
    successors: %bb.2, %bb.1

    %7:sreg_64 = nofpexcept V_CMP_NEQ_F32_e64 0, 0, 0, undef %3:vgpr_32, 0, implicit $mode, implicit $exec
    $vcc = COPY %7
    S_CBRANCH_VCCZ %bb.2, implicit killed $vcc

  bb.1:
    successors: %bb.3

    %4:vgpr_32 = nofpexcept V_ADD_F32_e32 undef %6:vgpr_32, undef %5:vgpr_32, implicit $mode, implicit $exec
    undef %12.sub0:vreg_128 = COPY %4
    %17:vreg_128 = COPY %12
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    %8:vgpr_32 = nofpexcept V_MAC_F32_e32 undef %3, undef %9:vgpr_32, undef %8, implicit $mode, implicit $exec
    undef %13.sub0:vreg_128 = COPY %8
    %13.sub1 = COPY %8
    %13.sub2 = COPY %8
    %0:vreg_128 = COPY %13
    %17 = COPY %0

  bb.3:
    %1:vreg_128 = COPY %17
    FLAT_STORE_DWORD undef %10:vreg_64, %1.sub2, 0, 0, implicit $exec, implicit $flat_scr
    %14:vgpr_32 = COPY %1.sub1
    %16:vgpr_32 = COPY %1.sub0
    undef %15.sub0:vreg_64 = COPY %16
    %15.sub1 = COPY %14
    FLAT_STORE_DWORDX2 undef %11:vreg_64, %15, 0, 0, implicit $exec, implicit $flat_scr
    S_ENDPGM 0

...
---
# Make sure others uses after the mac are properly handled and not
# left unreplaced due to iterator issues from substituteRegister.

# GCN-LABEL: name: vreg_does_not_dominate

# GCN: undef %7.sub1:vreg_128 = nofpexcept V_MAC_F32_e32 undef %3:vgpr_32, undef %4:vgpr_32, undef %7.sub1, implicit $mode, implicit $exec
# GCN: undef %6.sub0:vreg_128 = V_MOV_B32_e32 0, implicit $exec
# GCN: undef %8.sub2:vreg_128 = COPY %6.sub0

# GCN: undef %2.sub3:vreg_128 = nofpexcept V_ADD_F32_e32 undef %5:vgpr_32, undef %5:vgpr_32, implicit $mode, implicit $exec
# GCN: undef %6.sub0:vreg_128 = nofpexcept V_ADD_F32_e64 0, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
# GCN: %7.sub1:vreg_128 = nofpexcept V_ADD_F32_e32 %7.sub1, %7.sub1, implicit $mode, implicit $exec

# GCN: BUFFER_STORE_DWORD_OFFEN %2.sub3, %0,
# GCN: BUFFER_STORE_DWORD_OFFEN %8.sub2, %0,
# GCN: BUFFER_STORE_DWORD_OFFEN %7.sub1, %0,
# GCN: BUFFER_STORE_DWORD_OFFEN %6.sub0, %0,
name:            vreg_does_not_dominate
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  frameOffsetReg:  '$sgpr4'
liveins:
  - { reg: '$vgpr0', virtual-reg: '%0' }
  - { reg: '$sgpr30_sgpr31', virtual-reg: '%5' }
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $vgpr0, $sgpr30_sgpr31, $sgpr5

    %5:sreg_64 = COPY $sgpr30_sgpr31
    %0:vgpr_32 = COPY $vgpr0
    undef %6.sub1:vreg_128 = nofpexcept V_MAC_F32_e32 undef %2:vgpr_32, undef %1:vgpr_32, undef %6.sub1, implicit $mode, implicit $exec
    %6.sub0 = V_MOV_B32_e32 0, implicit $exec
    %6.sub2 = COPY %6.sub0
    S_CBRANCH_VCCNZ %bb.2, implicit undef $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2

    %6.sub3 = nofpexcept V_ADD_F32_e32 undef %3:vgpr_32, undef %3, implicit $mode, implicit $exec
    %6.sub0 = nofpexcept V_ADD_F32_e64 0, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    %6.sub1 = nofpexcept V_ADD_F32_e32 %6.sub1, %6.sub1, implicit $mode, implicit $exec
    %6.sub2 = COPY %6.sub0

  bb.2:
    BUFFER_STORE_DWORD_OFFEN %6.sub3, %0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4, 12, 0, 0, implicit $exec
    BUFFER_STORE_DWORD_OFFEN %6.sub2, %0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4, 8, 0, 0, implicit $exec
    BUFFER_STORE_DWORD_OFFEN %6.sub1, %0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4, 4, 0, 0, implicit $exec
    BUFFER_STORE_DWORD_OFFEN %6.sub0, %0, $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4, 0, 0, 0, implicit $exec
    $sgpr30_sgpr31 = COPY %5
    S_SETPC_B64_return $sgpr30_sgpr31

...

# GCN-LABEL: name: inf_loop_tied_operand
# GCN: bb.0:
# GCN-NEXT: undef %2.sub0:vreg_128 = nofpexcept V_MAC_F32_e32 1073741824, undef %1:vgpr_32, undef %2.sub0, implicit $mode, implicit $exec
# GCN-NEXT: dead undef %3.sub1:vreg_128 = COPY %2.sub0

name:            inf_loop_tied_operand
tracksRegLiveness: true
body:             |
  bb.0:
    %1:vgpr_32 = nofpexcept V_MAC_F32_e32 1073741824, undef %0:vgpr_32, undef %1, implicit $mode, implicit $exec
    undef %2.sub0:vreg_128 = COPY %1
    %2.sub1 = COPY %1

...
