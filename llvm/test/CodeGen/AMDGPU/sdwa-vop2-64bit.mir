# RUN: llc -mtriple=amdgpu7.00 -run-pass=si-peephole-sdwa -o - %s | FileCheck -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu8.03 -run-pass=si-peephole-sdwa -o - %s | FileCheck -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-peephole-sdwa -o - %s | FileCheck -check-prefix=GCN %s

# No conversion for VOP2 instructions that have only 64-bit encoding

# GCN-LABEL: {{^}}name: vop2_64bit

# GCN: %{{[0-9]+}}:vgpr_32 = V_BCNT_U32_B32_e64 %{{[0-9]+}}, %{{[0-9]+}}, implicit-def $vcc, implicit $exec
# GCN: %{{[0-9]+}}:vgpr_32 = V_BFM_B32_e64 %{{[0-9]+}}, %{{[0-9]+}}, implicit-def $vcc, implicit $exec
# GCN: %{{[0-9]+}}:vgpr_32 = V_CVT_PKNORM_I16_F32_e64 0, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, implicit-def $vcc, implicit $exec
# GCN: %{{[0-9]+}}:sgpr_32 = V_READLANE_B32 %{{[0-9]+}}, 0, implicit-def $vcc, implicit $exec

---
name:            vop2_64bit
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr30_sgpr31

    %2:sreg_64 = COPY $sgpr30_sgpr31
    %1:vreg_64 = COPY $vgpr2_vgpr3
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %3:vgpr_32 = FLAT_LOAD_DWORD %1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))

    %12:vgpr_32 = V_LSHRREV_B32_e64 16, %3, implicit $exec
    %13:vgpr_32 = V_BCNT_U32_B32_e64 %3, %12, implicit-def $vcc, implicit $exec

    %14:vgpr_32 = V_LSHRREV_B32_e64 16, %13, implicit $exec
    %15:vgpr_32 = V_BFM_B32_e64 %13, %14, implicit-def $vcc, implicit $exec

    %16:vgpr_32 = V_LSHRREV_B32_e64 16, %15, implicit $exec
    %17:vgpr_32 = V_CVT_PKNORM_I16_F32_e64 0, %15, 0, %16, 0, implicit-def $vcc, implicit $exec

    %18:vgpr_32 = V_LSHRREV_B32_e64 16, %17, implicit $exec
    %19:sgpr_32 = V_READLANE_B32 %18, 0, implicit-def $vcc, implicit $exec
    %20:vgpr_32 = V_MOV_B32_e64 %19, implicit $exec

    FLAT_STORE_DWORD %0, %20, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32))
    $sgpr30_sgpr31 = COPY %2
    S_SETPC_B64_return $sgpr30_sgpr31
...
