# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# REQUIRES: expensive_checks
# RUN: llc -mtriple=amdgpu9.08-amd-amdhsa -run-pass=machine-scheduler %s -o - | FileCheck %s

# An instruction with a live sub-register def ($agpr1) overlapping a
# dead super-register def ($agpr0_agpr1) must keep the live
# sub-register unit counted, so the cached PressureDiff agrees with
# the recomputed pressure. The lane-mask collector previously
# subtracted the dead super-register def and under-counted the live
# sub-register, tripping the EXPENSIVE_CHECKS pressure cross-check in
# GCNSchedStrategy.

---
name:            dead_superreg_live_subreg
tracksRegLiveness: true
machineFunctionInfo:
  occupancy:       6
  vgprForAGPRCopy: '$vgpr39'
body:             |
  bb.0:
    ; CHECK-LABEL: name: dead_superreg_live_subreg
    ; CHECK: [[DEF:%[0-9]+]]:areg_64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:areg_64 = IMPLICIT_DEF
    ; CHECK-NEXT: INLINEASM &"; copy", sideeffect attdialect, regdef, implicit-def $agpr1, reguse:AReg_64, [[DEF]], clobber, implicit-def dead early-clobber $agpr0_agpr1
    ; CHECK-NEXT: dead [[COPY:%[0-9]+]]:agpr_32 = COPY $agpr1
    ; CHECK-NEXT: $agpr0_agpr1 = COPY [[DEF1]]
    ; CHECK-NEXT: SI_RETURN
    %0:areg_64 = IMPLICIT_DEF
    %1:areg_64 = IMPLICIT_DEF
    INLINEASM &"; copy", sideeffect attdialect, regdef, implicit-def $agpr1, reguse:AReg_64, %0, clobber, implicit-def dead early-clobber $agpr0_agpr1
    %2:agpr_32 = COPY killed $agpr1
    $agpr0_agpr1 = COPY %1
    SI_RETURN
...
