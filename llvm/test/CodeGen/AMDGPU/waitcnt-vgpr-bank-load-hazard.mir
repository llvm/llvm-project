# b128 loads cover 4 banks each: v[0:3] and v[4:7] do not overlap, v[8:11]
# overlaps v[0:3].
---
name: ds_b128
body: |
  bb.0:
    ; WAR-LABEL: name: ds_b128
    ; WAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; WAR-NEXT: S_WAIT_KMCNT 0
    ; WAR-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = DS_READ_B128_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; WAR-NEXT: $vgpr4_vgpr5_vgpr6_vgpr7 = DS_READ_B128_gfx9 undef $vgpr100, 16, 0, implicit $exec
    ; WAR-NEXT: S_WAIT_DSCNT 0
    ; WAR-NEXT: $vgpr8_vgpr9_vgpr10_vgpr11 = DS_READ_B128_gfx9 undef $vgpr100, 32, 0, implicit $exec
    ; WAR-NEXT: S_ENDPGM 0
    ;
    ; NOWAR-LABEL: name: ds_b128
    ; NOWAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; NOWAR-NEXT: S_WAIT_KMCNT 0
    ; NOWAR-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = DS_READ_B128_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr4_vgpr5_vgpr6_vgpr7 = DS_READ_B128_gfx9 undef $vgpr100, 16, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr8_vgpr9_vgpr10_vgpr11 = DS_READ_B128_gfx9 undef $vgpr100, 32, 0, implicit $exec
    ; NOWAR-NEXT: S_ENDPGM 0
    $vgpr0_vgpr1_vgpr2_vgpr3 = DS_READ_B128_gfx9 undef $vgpr100, 0, 0, implicit $exec
    $vgpr4_vgpr5_vgpr6_vgpr7 = DS_READ_B128_gfx9 undef $vgpr100, 16, 0, implicit $exec
    $vgpr8_vgpr9_vgpr10_vgpr11 = DS_READ_B128_gfx9 undef $vgpr100, 32, 0, implicit $exec
    S_ENDPGM 0
...

# Bank is taken from the full register number: v256 is in the same bank as v0.
---
name: high_vgpr_same_bank
body: |
  bb.0:
    ; WAR-LABEL: name: high_vgpr_same_bank
    ; WAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; WAR-NEXT: S_WAIT_KMCNT 0
    ; WAR-NEXT: $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; WAR-NEXT: S_WAIT_DSCNT 0
    ; WAR-NEXT: $vgpr256 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    ; WAR-NEXT: S_ENDPGM 0
    ;
    ; NOWAR-LABEL: name: high_vgpr_same_bank
    ; NOWAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; NOWAR-NEXT: S_WAIT_KMCNT 0
    ; NOWAR-NEXT: $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr256 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    ; NOWAR-NEXT: S_ENDPGM 0
    $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    $vgpr256 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    S_ENDPGM 0
...

# Stores do not write VGPRs and are not affected.
---
name: ds_store_not_affected
body: |
  bb.0:
    ; WAR-LABEL: name: ds_store_not_affected
    ; WAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; WAR-NEXT: S_WAIT_KMCNT 0
    ; WAR-NEXT: $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; WAR-NEXT: DS_WRITE_B32_gfx9 undef $vgpr100, undef $vgpr8, 4, 0, implicit $exec
    ; WAR-NEXT: S_ENDPGM 0
    ;
    ; NOWAR-LABEL: name: ds_store_not_affected
    ; NOWAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; NOWAR-NEXT: S_WAIT_KMCNT 0
    ; NOWAR-NEXT: $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; NOWAR-NEXT: DS_WRITE_B32_gfx9 undef $vgpr100, undef $vgpr8, 4, 0, implicit $exec
    ; NOWAR-NEXT: S_ENDPGM 0
    $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    DS_WRITE_B32_gfx9 undef $vgpr100, undef $vgpr8, 4, 0, implicit $exec
    S_ENDPGM 0
...

# Hazard pattern: loads into v24's bank followed by a transcendental
# writing v24.
---
name: same_bank_loads_then_trans
body: |
  bb.0:
    ; WAR-LABEL: name: same_bank_loads_then_trans
    ; WAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; WAR-NEXT: S_WAIT_KMCNT 0
    ; WAR-NEXT: $vgpr24 = V_MOV_B32_e32 805306368, implicit $exec
    ; WAR-NEXT: $vgpr112 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    ; WAR-NEXT: S_WAIT_DSCNT 0
    ; WAR-NEXT: $vgpr120 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    ; WAR-NEXT: S_WAIT_DSCNT 0
    ; WAR-NEXT: $vgpr128 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    ; WAR-NEXT: $vgpr24 = V_EXP_F32_e32 1073741824, implicit $exec, implicit $mode
    ; WAR-NEXT: $vgpr49 = V_MOV_B32_e32 $vgpr24, implicit $exec
    ; WAR-NEXT: S_ENDPGM 0
    ;
    ; NOWAR-LABEL: name: same_bank_loads_then_trans
    ; NOWAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; NOWAR-NEXT: S_WAIT_KMCNT 0
    ; NOWAR-NEXT: $vgpr24 = V_MOV_B32_e32 805306368, implicit $exec
    ; NOWAR-NEXT: $vgpr112 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr120 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr128 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr24 = V_EXP_F32_e32 1073741824, implicit $exec, implicit $mode
    ; NOWAR-NEXT: $vgpr49 = V_MOV_B32_e32 $vgpr24, implicit $exec
    ; NOWAR-NEXT: S_ENDPGM 0
    $vgpr24 = V_MOV_B32_e32 805306368, implicit $exec
    $vgpr112 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    $vgpr120 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    $vgpr128 = DS_READ_B32_gfx9 undef $vgpr1, 0, 0, implicit $exec
    $vgpr24 = V_EXP_F32_e32 1073741824, implicit $exec, implicit $mode
    $vgpr49 = V_MOV_B32_e32 $vgpr24, implicit $exec
    S_ENDPGM 0
...

# Outstanding loads are tracked across blocks.
---
name: across_blocks
body: |
  ; WAR-LABEL: name: across_blocks
  ; WAR: bb.0:
  ; WAR-NEXT:   successors: %bb.1(0x80000000)
  ; WAR-NEXT: {{  $}}
  ; WAR-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; WAR-NEXT:   S_WAIT_KMCNT 0
  ; WAR-NEXT:   $vgpr5 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
  ; WAR-NEXT:   S_BRANCH %bb.1
  ; WAR-NEXT: {{  $}}
  ; WAR-NEXT: bb.1:
  ; WAR-NEXT:   S_WAIT_DSCNT 0
  ; WAR-NEXT:   $vgpr13 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
  ; WAR-NEXT:   S_ENDPGM 0
  ;
  ; NOWAR-LABEL: name: across_blocks
  ; NOWAR: bb.0:
  ; NOWAR-NEXT:   successors: %bb.1(0x80000000)
  ; NOWAR-NEXT: {{  $}}
  ; NOWAR-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NOWAR-NEXT:   S_WAIT_KMCNT 0
  ; NOWAR-NEXT:   $vgpr5 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
  ; NOWAR-NEXT:   S_BRANCH %bb.1
  ; NOWAR-NEXT: {{  $}}
  ; NOWAR-NEXT: bb.1:
  ; NOWAR-NEXT:   $vgpr13 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
  ; NOWAR-NEXT:   S_ENDPGM 0
  bb.0:
    $vgpr5 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    $vgpr13 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    S_ENDPGM 0
...
