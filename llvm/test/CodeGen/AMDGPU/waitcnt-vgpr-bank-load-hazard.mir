# VGPRBankLoadHazard: a DS/VMEM load must not be issued while another DS/VMEM
# load writing the same VGPR bank (vN mod 8) is outstanding.

---
name: ds_same_bank
body: |
  bb.0:
    ; WAR-LABEL: name: ds_same_bank
    ; WAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; WAR-NEXT: S_WAIT_KMCNT 0
    ; WAR-NEXT: $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; WAR-NEXT: S_WAIT_DSCNT 0
    ; WAR-NEXT: $vgpr8 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    ; WAR-NEXT: S_ENDPGM 0
    ;
    ; NOWAR-LABEL: name: ds_same_bank
    ; NOWAR: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; NOWAR-NEXT: S_WAIT_KMCNT 0
    ; NOWAR-NEXT: $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    ; NOWAR-NEXT: $vgpr8 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    ; NOWAR-NEXT: S_ENDPGM 0
    $vgpr0 = DS_READ_B32_gfx9 undef $vgpr100, 0, 0, implicit $exec
    $vgpr8 = DS_READ_B32_gfx9 undef $vgpr100, 4, 0, implicit $exec
    S_ENDPGM 0
...

