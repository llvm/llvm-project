; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=amdgcn -mcpu=gfx900 < %s | FileCheck %s

; Two vectors derived from the same poison-padded base constant. CSE shares the
; base BUILD_VECTOR; the combine rebuilds each insert as its own BUILD_VECTOR so
; the shared base does not force copies of its undef lanes.
define amdgpu_kernel void @shared_poison_base(i32 %a, i32 %b, ptr addrspace(1) %out0, ptr addrspace(1) %out1) {
; CHECK-LABEL: shared_poison_base:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_load_dwordx2 s[6:7], s[4:5], 0x24
; CHECK-NEXT:    s_load_dwordx4 s[0:3], s[4:5], 0x2c
; CHECK-NEXT:    v_mov_b32_e32 v3, 0
; CHECK-NEXT:    v_mov_b32_e32 v0, 1
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    v_mov_b32_e32 v1, s6
; CHECK-NEXT:    v_mov_b32_e32 v2, s7
; CHECK-NEXT:    global_store_dwordx4 v3, v[0:3], s[0:1]
; CHECK-NEXT:    global_store_dwordx4 v3, v[2:5], s[2:3]
; CHECK-NEXT:    s_endpgm
  %v0 = insertelement <4 x i32> <i32 1, i32 poison, i32 poison, i32 poison>, i32 %a, i64 1
  %v1 = insertelement <4 x i32> <i32 1, i32 poison, i32 poison, i32 poison>, i32 %b, i64 0
  store <4 x i32> %v0, ptr addrspace(1) %out0
  store <4 x i32> %v1, ptr addrspace(1) %out1
  ret void
}
