# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -start-before=greedy,0 \
# RUN:   -stop-after=virt-reg-rewriter,2 -verify-machineinstrs -verify-regalloc \
# RUN:   -greedy-compact-slot-indexes=false %s -o - | FileCheck %s --check-prefix=PACK
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -start-before=greedy,0 \
# RUN:   -stop-after=virt-reg-rewriter,2 -verify-machineinstrs -verify-regalloc \
# RUN:   -greedy-compact-slot-indexes %s -o - | FileCheck %s --check-prefix=COMPACT

# This checks the impact of removing dead slot indexes.
# Run the real SGPR, WWM and VGPR allocation pipeline. SGPR rewriting deletes
# the six identity copies between the two VGPR definitions. With those entries
# retained, %0 spans more slots than %1 and is allocated first. Removing them
# makes %1 the longer global range, so it gets the first available VGPR instead.

---
name: compact_priority
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; PACK-LABEL: name: compact_priority
  ; PACK: bb.0:
  ; PACK-NEXT:   successors: %bb.1(0x80000000)
  ; PACK-NEXT:   liveins: $sgpr0
  ; PACK-NEXT: {{  $}}
  ; PACK-NEXT:   renamable $vgpr0 = V_MOV_B32_e32 100, implicit $exec
  ; PACK-NEXT:   S_NOP 0, implicit killed renamable $sgpr0
  ; PACK-NEXT:   renamable $vgpr1 = V_MOV_B32_e32 200, implicit $exec
  ; PACK-NEXT:   S_BRANCH %bb.1
  ; PACK-NEXT: {{  $}}
  ; PACK-NEXT: bb.1:
  ; PACK-NEXT:   liveins: $vgpr0, $vgpr1
  ; PACK-NEXT: {{  $}}
  ; PACK-NEXT:   S_NOP 0, implicit killed renamable $vgpr0
  ; PACK-NEXT:   S_NOP 1
  ; PACK-NEXT:   S_NOP 2
  ; PACK-NEXT:   S_NOP 3
  ; PACK-NEXT:   S_NOP 0, implicit killed renamable $vgpr1
  ; PACK-NEXT:   S_ENDPGM 0
  ;
  ; COMPACT-LABEL: name: compact_priority
  ; COMPACT: bb.0:
  ; COMPACT-NEXT:   successors: %bb.1(0x80000000)
  ; COMPACT-NEXT:   liveins: $sgpr0
  ; COMPACT-NEXT: {{  $}}
  ; COMPACT-NEXT:   renamable $vgpr1 = V_MOV_B32_e32 100, implicit $exec
  ; COMPACT-NEXT:   S_NOP 0, implicit killed renamable $sgpr0
  ; COMPACT-NEXT:   renamable $vgpr0 = V_MOV_B32_e32 200, implicit $exec
  ; COMPACT-NEXT:   S_BRANCH %bb.1
  ; COMPACT-NEXT: {{  $}}
  ; COMPACT-NEXT: bb.1:
  ; COMPACT-NEXT:   liveins: $vgpr0, $vgpr1
  ; COMPACT-NEXT: {{  $}}
  ; COMPACT-NEXT:   S_NOP 0, implicit killed renamable $vgpr1
  ; COMPACT-NEXT:   S_NOP 1
  ; COMPACT-NEXT:   S_NOP 2
  ; COMPACT-NEXT:   S_NOP 3
  ; COMPACT-NEXT:   S_NOP 0, implicit killed renamable $vgpr0
  ; COMPACT-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $sgpr0

    %0:vgpr_32 = V_MOV_B32_e32 100, implicit $exec
    %2:sreg_32 = COPY $sgpr0
    %3:sreg_32 = COPY %2
    %4:sreg_32 = COPY %3
    %5:sreg_32 = COPY %4
    %6:sreg_32 = COPY %5
    %7:sreg_32 = COPY %6
    S_NOP 0, implicit %7
    %1:vgpr_32 = V_MOV_B32_e32 200, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    S_NOP 0, implicit %0
    S_NOP 1
    S_NOP 2
    S_NOP 3
    S_NOP 0, implicit %1
    S_ENDPGM 0
...
