# RUN: llc -mtriple=amdgpu9.0a -run-pass=amdgpu-resource-usage -verify-machineinstrs %s -o -

# Checks that ResourceUsageAnalysis does not assert if it sees agpr_lo16, agpr_hi16 or TTMP regs.
---

name: test
tracksRegLiveness: true
frameInfo:
  hasCalls: true
body: |
  bb.0:
    liveins: $sgpr0_64, $ttmp0, $ttmp0_64, $ttmp0_128
    $vgpr0 = COPY $ttmp0
    $vgpr1_64 = COPY $ttmp0_64
    $vgpr1_128 = COPY $ttmp0_128
    $vgpr1_256 = COPY $ttmp0_256
    $vgpr1_512 = COPY $ttmp0_512
    $agpr1_lo16 = IMPLICIT_DEF
    $agpr1_hi16 = IMPLICIT_DEF
    $sgpr2_64 = SI_CALL undef $sgpr0_64, 0, CustomRegMask()
    S_ENDPGM 0
...
