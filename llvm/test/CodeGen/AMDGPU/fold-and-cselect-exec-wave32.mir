    S_ENDPGM 0, implicit $vcc_lo
...

---
name: cselect_all_ones
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1
    ; CHECK-LABEL: name: cselect_all_ones
    ; CHECK: liveins: $sgpr0, $sgpr1
    ; CHECK-NEXT: {{  $}}
