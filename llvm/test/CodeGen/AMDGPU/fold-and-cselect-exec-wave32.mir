    ; CHECK-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32_xm0_xexec = S_CSELECT_B32 [[COPY]], 0, implicit $scc
    ; CHECK-NEXT: $vcc_lo = COPY [[S_CSELECT_B32_]]
