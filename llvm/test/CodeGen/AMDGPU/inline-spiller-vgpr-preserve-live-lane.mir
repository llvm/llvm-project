# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=greedy,virt-reg-rewriter -stress-regalloc=1 -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s
# RUN: %if asserts %{ llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=greedy -stress-regalloc=1 -verify-machineinstrs -verify-regalloc -stats %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=STATS %}
#
# A full-width spill of a write-only partial VGPR def must preserve the other
# live words of its shared slot. split-from models two pieces of one incoming
# tuple: %0 keeps sub0 live, %1 copies the unchanged sub2; the clobbers and
# -stress-regalloc=1 force both into one slot.
#
# The diamond gives the original a PHI value at bb.3, distinct from the values
# spilled in the predecessors, so the partial def's spill survives hoistAllSpills
# and is visible in the final MIR.
#
# vgpr0 is 0xdeadbeef before only vgpr2 is defined. Without preservation the
# full-width store writes 0xdeadbeef over the slot's live sub0, and a later
# reload sends that corrupted word to the store at offset 0. With preservation
# the outputs are 0x11223344 at offset 0 and 42 at offset 4 on either path.
#
# STATS: {{^ *1 regalloc +- Number of preservation reloads for partial split defs$}}

# CHECK-LABEL: name: preserve_vgpr_live_lane
# CHECK: bb.0:
# CHECK: $vgpr4 = V_MOV_B32_e32 287454020,
# CHECK: $vgpr6 = V_MOV_B32_e32 42,
# CHECK: bb.1:
# CHECK: SI_SPILL_V128_SAVE $vgpr4_vgpr5_vgpr6_vgpr7, [[SLOT:%stack\.[0-9]+]],
# CHECK: bb.2:
# CHECK: SI_SPILL_V128_SAVE $vgpr4_vgpr5_vgpr6_vgpr7, [[SLOT]],
# CHECK: bb.3:
# CHECK: $vgpr0 = V_MOV_B32_e32 -559038737, implicit $exec
# CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2_vgpr3 = SI_SPILL_V128_RESTORE [[SLOT]],
# CHECK-NEXT: renamable $vgpr2 = COPY $vgpr6
# CHECK-NEXT: SI_SPILL_V128_SAVE killed $vgpr0_vgpr1_vgpr2_vgpr3, [[SLOT]],
# CHECK-NEXT: KILL implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
# CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2_vgpr3 = SI_SPILL_V128_RESTORE [[SLOT]],
# CHECK-NEXT: BUFFER_STORE_DWORD_OFFSET killed renamable $vgpr2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4,
# CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2_vgpr3 = SI_SPILL_V128_RESTORE [[SLOT]],
# CHECK-NEXT: BUFFER_STORE_DWORD_OFFSET killed renamable $vgpr0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0,
# CHECK-NEXT: S_ENDPGM 0
---
name: preserve_vgpr_live_lane
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vreg_128, split-from: '%0' }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $scc
    $vgpr4 = V_MOV_B32_e32 287454020, implicit $exec
    $vgpr5 = V_MOV_B32_e32 1432778632, implicit $exec
    $vgpr6 = V_MOV_B32_e32 42, implicit $exec
    $vgpr7 = V_MOV_B32_e32 99, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1
  bb.1:
    successors: %bb.3
    liveins: $vgpr4_vgpr5_vgpr6_vgpr7
    %0:vreg_128 = COPY $vgpr4_vgpr5_vgpr6_vgpr7
    KILL implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    KILL %0.sub0
    S_BRANCH %bb.3
  bb.2:
    successors: %bb.3
    liveins: $vgpr4_vgpr5_vgpr6_vgpr7
    %0:vreg_128 = COPY $vgpr4_vgpr5_vgpr6_vgpr7
    KILL implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    KILL %0.sub0
    S_BRANCH %bb.3
  bb.3:
    liveins: $vgpr6, $sgpr0_sgpr1_sgpr2_sgpr3
    $vgpr0 = V_MOV_B32_e32 -559038737, implicit $exec
    undef %1.sub2:vreg_128 = COPY $vgpr6
    KILL implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    BUFFER_STORE_DWORD_OFFSET %1.sub2, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 4, 0, 0, implicit $exec :: (volatile store (s32), addrspace 1)
    BUFFER_STORE_DWORD_OFFSET %0.sub0, $sgpr0_sgpr1_sgpr2_sgpr3, 0, 0, 0, 0, implicit $exec :: (volatile store (s32), addrspace 1)
    S_ENDPGM 0
...
