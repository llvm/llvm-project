# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa --sink-insts-to-avoid-spills=1 \
# RUN:   --stop-after=machine-sink -o - %s | FileCheck %s

# CHECK-LABEL: name: cycle_sink_debug_uses
# CHECK: bb.0:
# CHECK: [[DEF:%[0-9]+]]:vreg_256_align2 = IMPLICIT_DEF
# CHECK: bb.1:
# CHECK-NOT: DBG_VALUE
# CHECK: EH_LABEL
# CHECK-NEXT: [[COPY:%[0-9]+]]:vreg_256_align2 = COPY [[DEF]]
# CHECK-NEXT: DBG_VALUE [[COPY]], $noreg, !{{[0-9]+}}, !DIExpression(), debug-location !{{[0-9]+}}

--- |
  define void @cycle_sink_debug_uses() !dbg !5 {
  entry:
    unreachable, !dbg !11
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "debugify", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "machine-sink-cycle-debug.mir", directory: "/")
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "cycle_sink_debug_uses", scope: null, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !8)
  !6 = !DISubroutineType(types: !7)
  !7 = !{}
  !8 = !{!9}
  !9 = !DILocalVariable(name: "x", scope: !5, file: !1, line: 1, type: !10)
  !10 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !11 = !DILocation(line: 1, column: 1, scope: !5)
...
---
name: cycle_sink_debug_uses
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    %0:vreg_256 = IMPLICIT_DEF
    %1:vreg_256 = COPY %0
    S_BRANCH %bb.1

  bb.1:
    DBG_VALUE %1, $noreg, !9, !DIExpression(), debug-location !11
    EH_LABEL <mcsymbol .Ltmp0>
    INLINEASM &"", 1, implicit %1
    S_BRANCH %bb.1
...
