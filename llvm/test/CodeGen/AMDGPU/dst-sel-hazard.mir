    ; NOHAZARD-NEXT: $vgpr8 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: S_ENDPGM 0
  $vgpr0 = V_PK_MUL_F16 12, $vgpr2, 8, $vgpr4, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
  $vgpr8 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
  $vgpr0 = V_FMA_MIX_F32 12, $vgpr2, 8, $vgpr4, 8, $vgpr6, 0, 0, 0, implicit $mode, implicit $exec
  $vgpr8 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
  S_ENDPGM 0
...

