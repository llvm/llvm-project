# VOP3P source selectors share the DST_OP_SEL modifier bit, but do not
# select a partial destination. Check both halves, packed RAW and WAW,
# and inline-assembly consumers. Genuine VOP3 destination selection must
# still be protected when its consumer is VOP3P.

---
name:            vop3p_opsel_no_hazard
body:            |
  bb.0:
  liveins: $vgpr2_vgpr3, $vgpr4_vgpr5, $exec, $mode

    ; HAZARD-LABEL: name: vop3p_opsel_no_hazard
    ; HAZARD: liveins: $vgpr2_vgpr3, $vgpr4_vgpr5, $exec, $mode
    ; HAZARD-NEXT: {{  $}}
    ; HAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 0, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 4, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr1, $vgpr4, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 8, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 12, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr1, $vgpr4, implicit $mode, implicit $exec
    ; HAZARD-NEXT: S_ENDPGM 0
    ;
    ; NOHAZARD-LABEL: name: vop3p_opsel_no_hazard
    ; NOHAZARD: liveins: $vgpr2_vgpr3, $vgpr4_vgpr5, $exec, $mode
    ; NOHAZARD-NEXT: {{  $}}
    ; NOHAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 0, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 4, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr1, $vgpr4, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 8, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr0_vgpr1 = V_PK_MUL_F32 12, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr6 = V_ADD_F32_e32 $vgpr1, $vgpr4, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: S_ENDPGM 0
  $vgpr0_vgpr1 = V_PK_MUL_F32 0, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
  $vgpr6 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
  $vgpr0_vgpr1 = V_PK_MUL_F32 4, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
  $vgpr6 = V_ADD_F32_e32 $vgpr1, $vgpr4, implicit $mode, implicit $exec
  $vgpr0_vgpr1 = V_PK_MUL_F32 8, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
  $vgpr6 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
  $vgpr0_vgpr1 = V_PK_MUL_F32 12, $vgpr2_vgpr3, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
  $vgpr6 = V_ADD_F32_e32 $vgpr1, $vgpr4, implicit $mode, implicit $exec
  S_ENDPGM 0
...

