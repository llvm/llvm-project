    ; HAZARD-NEXT: $vgpr8 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr0 = V_FMA_MIX_F32 12, $vgpr2, 8, $vgpr4, 8, $vgpr6, 0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: $vgpr8 = V_ADD_F32_e32 $vgpr0, $vgpr4, implicit $mode, implicit $exec
