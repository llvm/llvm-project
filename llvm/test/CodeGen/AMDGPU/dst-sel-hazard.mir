    ; HAZARD-NEXT: $vgpr0 = V_MAD_U16_gfx9_e64 12, $vgpr2, 4, $vgpr4, 4, $vgpr6, 0, 0, implicit $exec
    ; HAZARD-NEXT: S_NOP 0
    ; HAZARD-NEXT: $vgpr8_vgpr9 = V_PK_MUL_F32 8, $vgpr0_vgpr1, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: S_ENDPGM 0
    ;
    ; NOHAZARD-LABEL: name: opsel_vop3p_hazard
    ; NOHAZARD: liveins: $vgpr1, $vgpr2, $vgpr4_vgpr5, $vgpr6, $exec, $mode
    ; NOHAZARD-NEXT: {{  $}}
    ; NOHAZARD-NEXT: $vgpr0 = V_MAD_U16_gfx9_e64 12, $vgpr2, 4, $vgpr4, 4, $vgpr6, 0, 0, implicit $exec
    ; NOHAZARD-NEXT: $vgpr8_vgpr9 = V_PK_MUL_F32 8, $vgpr0_vgpr1, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: S_ENDPGM 0
  $vgpr0 = V_MAD_U16_gfx9_e64 12, $vgpr2, 4, $vgpr4, 4, $vgpr6, 0, 0, implicit $exec
  $vgpr8_vgpr9 = V_PK_MUL_F32 8, $vgpr0_vgpr1, 8, $vgpr4_vgpr5, 0, 0, 0, 0, 0, implicit $mode, implicit $exec
  S_ENDPGM 0
...

# VOP3P MIXLO/MIXHI write only one half of a tied vdst and preserve the other
# half, so they are destination-select producers regardless of the source
# op_sel_hi bits (which share the DST_OP_SEL modifier bit). MIX_F32 writes
# the whole register and is covered by vop3p_f16_mix_no_hazard above.

---
name:            mixhi_f16_src0_hazard
body:            |
  bb.0:
  liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $exec, $mode
    ; HAZARD-LABEL: name: mixhi_f16_src0_hazard
    ; HAZARD: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $exec, $mode
    ; HAZARD-NEXT: {{  $}}
    ; HAZARD-NEXT: $vgpr0 = V_FMA_MIXHI_F16 8, $vgpr1, 8, $vgpr2, 8, $vgpr3, 0, $vgpr0, 0, 0, implicit $mode, implicit $exec
    ; HAZARD-NEXT: S_NOP 0
    ; HAZARD-NEXT: $vgpr4 = V_ADD_F32_e32 $vgpr0, $vgpr1, implicit $mode, implicit $exec
    ; HAZARD-NEXT: S_ENDPGM 0
    ;
    ; NOHAZARD-LABEL: name: mixhi_f16_src0_hazard
    ; NOHAZARD: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $exec, $mode
    ; NOHAZARD-NEXT: {{  $}}
    ; NOHAZARD-NEXT: $vgpr0 = V_FMA_MIXHI_F16 8, $vgpr1, 8, $vgpr2, 8, $vgpr3, 0, $vgpr0, 0, 0, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: $vgpr4 = V_ADD_F32_e32 $vgpr0, $vgpr1, implicit $mode, implicit $exec
    ; NOHAZARD-NEXT: S_ENDPGM 0
  $vgpr0 = V_FMA_MIXHI_F16 8, $vgpr1, 8, $vgpr2, 8, $vgpr3, 0, $vgpr0, 0, 0, implicit $mode, implicit $exec
  $vgpr4 = V_ADD_F32_e32 $vgpr0, $vgpr1, implicit $mode, implicit $exec
  S_ENDPGM 0
...

