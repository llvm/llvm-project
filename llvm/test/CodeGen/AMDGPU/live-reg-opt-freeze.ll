; Keep loop-carried bytes packed even when a freeze separates the PHI from
; its store. The freeze must still operate on individual bytes.
; NOTE: Do not autogenerate. The ASM checks guard emitted packing and
; register usage without depending on the exact instruction schedule.
; ASM-LABEL: freeze_loop:
; ASM-NOT: v_perm
; ASM: global_store_dwordx2
; ASM-NOT: v_perm
; ASM: s_endpgm
; ASM: .amdhsa_kernel freeze_loop
; ASM: .amdhsa_next_free_vgpr 4
define amdgpu_kernel void @freeze_loop(ptr addrspace(1) %src, ptr addrspace(1) %dst, i1 %done) {
; CHECK-LABEL: define amdgpu_kernel void @freeze_loop(
; CHECK-SAME: ptr addrspace(1) [[SRC:%.*]], ptr addrspace(1) [[DST:%.*]], i1 [[DONE:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[INITIAL:%.*]] = load <8 x i8>, ptr addrspace(1) [[SRC]], align 8
; CHECK-NEXT:    [[INITIAL_BC:%.*]] = bitcast <8 x i8> [[INITIAL]] to <2 x i32>
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[BYTES_TC:%.*]] = phi <2 x i32> [ [[INITIAL_BC]], %[[ENTRY]] ], [ [[NEXT_BC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[BYTES_TC_BC:%.*]] = bitcast <2 x i32> [[BYTES_TC]] to <8 x i8>
; CHECK-NEXT:    [[FROZEN:%.*]] = freeze <8 x i8> [[BYTES_TC_BC]]
; CHECK-NEXT:    store <8 x i8> [[FROZEN]], ptr addrspace(1) [[DST]], align 8
; CHECK-NEXT:    [[NEXT:%.*]] = load <8 x i8>, ptr addrspace(1) [[SRC]], align 8
; CHECK-NEXT:    [[NEXT_BC]] = bitcast <8 x i8> [[NEXT]] to <2 x i32>
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %initial = load <8 x i8>, ptr addrspace(1) %src, align 8
  br label %loop
loop:
  %bytes = phi <8 x i8> [ %initial, %entry ], [ %next, %loop ]
  %frozen = freeze <8 x i8> %bytes
  store <8 x i8> %frozen, ptr addrspace(1) %dst, align 8
  %next = load <8 x i8>, ptr addrspace(1) %src, align 8
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

