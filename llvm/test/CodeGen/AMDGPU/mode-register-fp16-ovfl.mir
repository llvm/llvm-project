# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50 -run-pass si-mode-register %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50 -passes=si-mode-register %s -o - | FileCheck %s

# The saturating FP8 conversions need MODE.FP16_OVFL set. Everything else that
# depends on the mode keeps the default.

---
name: sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
name: sat_bf8
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: sat_bf8
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_BF8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_BF8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# One mode change covers both conversions.
name: sat_twice
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: sat_twice
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# An instruction that does not read the mode does not end the saturating range.
name: sat_int_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: sat_int_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = V_ADD_U32_e32 killed $vgpr0, $vgpr0, implicit $exec
    ; CHECK-NEXT: $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $vgpr0 = V_ADD_U32_e32 killed $vgpr0, $vgpr0, implicit $exec
    $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
name: sat_fp_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: sat_fp_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr1 = V_ADD_F32_e32 killed $vgpr1, $vgpr2, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $vgpr1 = V_ADD_F32_e32 killed $vgpr1, $vgpr2, implicit $mode, implicit $exec
    $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# The entry mode already suits the first instruction.
name: fp_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: fp_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr1 = V_ADD_F32_e32 killed $vgpr1, $vgpr2, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr1 = V_ADD_F32_e32 killed $vgpr1, $vgpr2, implicit $mode, implicit $exec
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# The non-saturating conversion must produce infinity.
name: sat_nosat_bf8
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: sat_nosat_bf8
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_BF8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr3 = V_CVT_PK_BF8_F32_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_BF8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $vgpr3 = V_CVT_PK_BF8_F32_e64 0, killed $vgpr2, 0, killed $vgpr1, $vgpr3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# The MFMA clamp uses FP16_OVFL.
name: sat_mfma
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $agpr0_agpr1_agpr2_agpr3
    ; CHECK-LABEL: name: sat_mfma
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $agpr0_agpr1_agpr2_agpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_4X4X1F32_e64 killed $vgpr1, killed $vgpr2, killed $agpr0_agpr1_agpr2_agpr3, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_4X4X1F32_e64 killed $vgpr1, killed $vgpr2, killed $agpr0_agpr1_agpr2_agpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# The program already set FP16_OVFL.
name: explicit_ovfl_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: explicit_ovfl_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# Without a saturating conversion FP16_OVFL is left to the program.
name: explicit_ovfl_no_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: explicit_ovfl_no_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr1 = V_ADD_F32_e32 killed $vgpr1, $vgpr2, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_BF8_F32_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    $vgpr1 = V_ADD_F32_e32 killed $vgpr1, $vgpr2, implicit $mode, implicit $exec
    $vgpr0 = V_CVT_PK_BF8_F32_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# The caller expects the default mode back.
name: sat_return
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr30_sgpr31
    ; CHECK-LABEL: name: sat_return
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr30_sgpr31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
...
---
# The program's rounding mode stays, FP16_OVFL is still restored.
name: explicit_round_sat_return
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr30_sgpr31
    ; CHECK-LABEL: name: explicit_round_sat_return
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr30_sgpr31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 3, 2177, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
    S_SETREG_IMM32_B32 3, 2177, implicit-def $mode, implicit $mode
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
...
---
# The program's FP16_OVFL is not undone on return.
name: explicit_ovfl_sat_return
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr30_sgpr31
    ; CHECK-LABEL: name: explicit_ovfl_sat_return
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr30_sgpr31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
    S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
...
---
# The mode set in the loop reaches the next iteration, the entry mode does not.
name: sat_loop
body: |
  ; CHECK-LABEL: name: sat_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   $vgpr0 = V_ADD_F32_e32 killed $vgpr1, killed $vgpr2, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    successors: %bb.1

  bb.1:
    liveins: $vgpr0, $vgpr1, $vgpr2
    successors: %bb.1, %bb.2
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit undef $scc
    S_BRANCH %bb.2

  bb.2:
    liveins: $vgpr1, $vgpr2
    $vgpr0 = V_ADD_F32_e32 killed $vgpr1, killed $vgpr2, implicit $mode, implicit $exec
    S_ENDPGM 0
...
---
# FP16_OVFL is not set ahead of an instruction that needs the default.
name: sat_f64_fptrunc_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7, $sgpr30_sgpr31
    ; CHECK-LABEL: name: sat_f64_fptrunc_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4_vgpr5, $vgpr6_vgpr7, $sgpr30_sgpr31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 2177, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr4_vgpr5 = V_ADD_F64_e64 0, killed $vgpr4_vgpr5, 0, killed $vgpr6_vgpr7, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 129, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr6 = V_CVT_F32_F64_e32 killed $vgpr4_vgpr5, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr3, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 129, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $vgpr4_vgpr5 = V_ADD_F64_e64 0, killed $vgpr4_vgpr5, 0, killed $vgpr6_vgpr7, 0, 0, implicit $mode, implicit $exec
    $vgpr6 = FPTRUNC_ROUND_F32_F64_PSEUDO killed $vgpr4_vgpr5, 1, implicit $mode, implicit $exec
    $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, killed $vgpr1, 0, killed $vgpr2, $vgpr3, 0, implicit $mode, implicit $exec
    S_SETPC_B64_return killed $sgpr30_sgpr31, implicit $vgpr0
...
---
# FP16_OVFL is not set ahead of the call for the conversion after it.
name: sat_fp_round_call_sat
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4_vgpr5, $vgpr6, $vgpr7, $sgpr16_sgpr17
    ; CHECK-LABEL: name: sat_fp_round_call_sat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4_vgpr5, $vgpr6, $vgpr7, $sgpr16_sgpr17
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 2177, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr6 = V_ADD_F32_e32 killed $vgpr6, $vgpr7, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr7 = V_CVT_F32_F64_e32 killed $vgpr4_vgpr5, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_SETREG_IMM32_B32 0, 129, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: dead $sgpr30_sgpr31 = SI_CALL killed $sgpr16_sgpr17, 0, csr_amdgpu
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 129, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_SETREG_IMM32_B32 1, 1473, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, undef $vgpr1, 0, undef $vgpr2, undef $vgpr3, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr0 = V_CVT_PK_FP8_F32_sat_e64 0, $vgpr1, 0, $vgpr2, $vgpr0, 0, implicit $mode, implicit $exec
    $vgpr6 = V_ADD_F32_e32 killed $vgpr6, $vgpr7, implicit $mode, implicit $exec
    $vgpr7 = FPTRUNC_ROUND_F32_F64_PSEUDO killed $vgpr4_vgpr5, 1, implicit $mode, implicit $exec
    dead $sgpr30_sgpr31 = SI_CALL killed $sgpr16_sgpr17, 0, csr_amdgpu
    $vgpr3 = V_CVT_PK_FP8_F32_sat_e64 0, undef $vgpr1, 0, undef $vgpr2, undef $vgpr3, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
