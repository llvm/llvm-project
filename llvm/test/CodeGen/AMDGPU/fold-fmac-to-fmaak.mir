# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.01 -run-pass=peephole-opt -o - %s | FileCheck %s

# An FMAC whose src0 or src1 is already a literal must not be folded into FMAAK
# as VOP2/VOP3 instruction cannot uses more than one literal. An inline constant
# does not occupy the literal slot, so folding is still possible in that case.

---
name:            fold_fmac_to_fmaak_f32_src0_literal
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fold_fmac_to_fmaak_f32_src0_literal
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 8478, implicit $exec
    ; CHECK-NEXT: [[V_FMAC_F32_e64_:%[0-9]+]]:vgpr_32 = contract nofpexcept V_FMAC_F32_e64 0, 10526, 0, [[COPY]], 0, [[V_MOV_B32_e32_]], 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_FMAC_F32_e64_]]
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_MOV_B32_e32 8478, implicit $exec
    %2:vgpr_32 = contract nofpexcept V_FMAC_F32_e64 0, 10526, 0, %0, 0, %1, 0, 0, implicit $mode, implicit $exec
    $vgpr0 = COPY %2
    SI_RETURN implicit $vgpr0

...
