  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_32 = COPY [[FREEZE]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:sreg_32_xm0_xexec = COPY [[COPY2]]
