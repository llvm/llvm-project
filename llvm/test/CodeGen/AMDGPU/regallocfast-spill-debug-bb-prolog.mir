# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -sgpr-regalloc=fast -start-before=regallocfast,0 -stop-after=regallocfast,0 -o - %s | FileCheck %s

# %0 is defined in the block prolog and spilled there. The DBG_VALUE that
# describes the spill slot joins the prolog with the spill; its copy at the end
# of the block does not.

--- |
  define amdgpu_kernel void @spill_debug_in_bb_prolog() !dbg !4 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "spill_debug_in_bb_prolog", scope: !1, file: !1, type: !5, unit: !0, spFlags: DISPFlagDefinition)
  !5 = !DISubroutineType(types: !{})
  !6 = !DILocalVariable(name: "x", scope: !4, file: !1)
  !7 = !DILocation(line: 1, scope: !4)
...
---
name: spill_debug_in_bb_prolog
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg: '$sgpr96_sgpr97_sgpr98_sgpr99'
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: spill_debug_in_bb_prolog
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr2_sgpr3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   bb-prolog SI_SPILL_S32_SAVE killed $sgpr0, %stack.0, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   bb-prolog DBG_VALUE %stack.0, 0, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   bb-prolog DBG_VALUE renamable $sgpr0, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   $exec = bb-prolog S_OR_B64 $exec, killed $sgpr2_sgpr3, implicit-def dead $scc
  ; CHECK-NEXT:   DBG_VALUE %stack.0, 0, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32 :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   S_ENDPGM 0, implicit killed renamable $sgpr0
  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $sgpr2_sgpr3
    %0:sreg_32 = bb-prolog COPY $sgpr0
    bb-prolog DBG_VALUE %0, $noreg, !6, !DIExpression(), debug-location !7
    $exec = bb-prolog S_OR_B64 $exec, $sgpr2_sgpr3, implicit-def dead $scc
    S_BRANCH %bb.1

  bb.1:
    S_ENDPGM 0, implicit %0
...
