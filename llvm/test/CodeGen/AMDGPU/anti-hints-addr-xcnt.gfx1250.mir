---
name:            addr_fallthrough_block
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: addr_fallthrough_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $vgpr0_vgpr1 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $vgpr3 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $vgpr2 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; CHECK-NEXT:   S_WAIT_KMCNT 0
  ; CHECK-NEXT:   GLOBAL_STORE_DWORD renamable $vgpr0_vgpr1, killed renamable $vgpr3, 0, 0, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $vgpr2, $vgpr0_vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAIT_XCNT 0
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VmVsrc_0
  ; CHECK-NEXT:   renamable $vgpr3 = V_ADD_U32_e32 1, $vgpr2, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit killed renamable $vgpr0_vgpr1, implicit killed renamable $vgpr2, implicit killed renamable $vgpr3
  ;
  ; NOAH-LABEL: name: addr_fallthrough_block
  ; NOAH: bb.0:
  ; NOAH-NEXT:   successors: %bb.1(0x80000000)
  ; NOAH-NEXT: {{  $}}
  ; NOAH-NEXT:   renamable $vgpr0_vgpr1 = IMPLICIT_DEF
  ; NOAH-NEXT:   renamable $vgpr3 = IMPLICIT_DEF
  ; NOAH-NEXT:   renamable $vgpr2 = IMPLICIT_DEF
  ; NOAH-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; NOAH-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; NOAH-NEXT:   S_WAIT_KMCNT 0
  ; NOAH-NEXT:   GLOBAL_STORE_DWORD renamable $vgpr0_vgpr1, killed renamable $vgpr3, 0, 0, implicit $exec
  ; NOAH-NEXT: {{  $}}
  ; NOAH-NEXT: bb.1:
  ; NOAH-NEXT:   liveins: $vgpr2, $vgpr0_vgpr1
  ; NOAH-NEXT: {{  $}}
  ; NOAH-NEXT:   S_WAIT_XCNT 0
  ; NOAH-NEXT:   S_WAITCNT_DEPCTR .VmVsrc_0
  ; NOAH-NEXT:   renamable $vgpr3 = V_ADD_U32_e32 1, $vgpr2, implicit $exec
  ; NOAH-NEXT:   S_ENDPGM 0, implicit killed renamable $vgpr0_vgpr1, implicit killed renamable $vgpr2, implicit killed renamable $vgpr3
  bb.0:
    successors: %bb.1
    %0:vreg_64_align2 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = IMPLICIT_DEF
    GLOBAL_STORE_DWORD %0, %1, 0, 0, implicit $exec

  bb.1:
    %3:vgpr_32 = V_ADD_U32_e32 1, %2, implicit $exec
    S_ENDPGM 0, implicit %0, implicit %2, implicit %3
...

