; The two sums have the same terms with different association. Folding %t
; into the second FMA chain makes it identical to the first chain, which
; must then replace the outer fadd without adding %t a second time.

define amdgpu_ps void @fadd_fma_chain_cse(float %a, float %b, float %c, float %x, float %y, float %z, float %t, float %view) {
; CHECK-LABEL: fadd_fma_chain_cse:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    v_fmac_f32_e32 v6, v2, v5
; CHECK-NEXT:    s_delay_alu instid0(VALU_DEP_1) | instskip(NEXT) | instid1(VALU_DEP_1)
; CHECK-NEXT:    v_fmac_f32_e32 v6, v1, v4
; CHECK-NEXT:    v_fmac_f32_e32 v6, v0, v3
; CHECK-NEXT:    s_delay_alu instid0(VALU_DEP_1)
; CHECK-NEXT:    v_sub_f32_e32 v0, v7, v6
; CHECK-NEXT:    export mrt0, v6, v0, off, off done
; CHECK-NEXT:    s_endpgm
  %ax = fmul reassoc nnan nsz arcp contract afn float %a, %x
  %by = fmul reassoc nnan nsz arcp contract afn float %b, %y
  %cz = fmul reassoc nnan nsz arcp contract afn float %c, %z
  %s0 = fadd reassoc nnan nsz arcp contract afn float %cz, %t
  %s1 = fadd reassoc nnan nsz arcp contract afn float %s0, %by
  %world = fadd reassoc nnan nsz arcp contract afn float %s1, %ax
  %r0 = fadd reassoc nnan nsz arcp contract afn float %by, %cz
  %r1 = fadd reassoc nnan nsz arcp contract afn float %r0, %ax
  %world2 = fadd reassoc nnan nsz arcp contract afn float %r1, %t
  %dir = fsub reassoc nnan nsz arcp contract afn float %view, %world2
  call void @llvm.amdgcn.exp.f32(i32 0, i32 3, float %world, float %dir, float poison, float poison, i1 true, i1 true)
  ret void
}

