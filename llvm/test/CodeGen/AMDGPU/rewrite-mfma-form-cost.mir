  bb.2:
    undef %17.sub0:vreg_128_align2 = V_ADD_U32_e32 %15.sub0, %13, implicit $exec
    %18:vreg_128_align2 = COPY %16
    SCHED_BARRIER 0
    KILL %0, %1, %2, %3, %4, %5, %6, %7, %14, %17, %18
    S_NOP 0, implicit %8, implicit %9
    S_ENDPGM 0
...

