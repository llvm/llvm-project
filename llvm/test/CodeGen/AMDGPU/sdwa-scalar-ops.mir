# RUN: llc -mtriple=amdgpu8.03 -start-before si-peephole-sdwa -o - %s | FileCheck -check-prefix=VI -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu9.00 -start-before si-peephole-sdwa -o - %s | FileCheck -check-prefix=GFX9 -check-prefix=GCN %s

# GCN-LABEL: {{^}}sdwa_imm_operand:
# GCN: v_mov_b32_e32 v[[SHIFT:[0-9]+]], 2
# GCN-NOT: v_mov_b32_e32 v{{[0-9]+}}, 2
# GCN: BB0_1:
# GCN: v_lshlrev_b32_sdwa v{{[0-9]+}}, v[[SHIFT]], v{{[0-9]+}} dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1
# GCN: v_lshlrev_b32_sdwa v{{[0-9]+}}, v[[SHIFT]], v{{[0-9]+}} dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1

# GCN-LABEL: {{^}}sdwa_sgpr_operand:
# VI: v_mov_b32_e32 v[[SHIFT:[0-9]+]], 2
# VI-NOT: v_mov_b32_e32 v{{[0-9]+}}, 2
# VI: BB1_1:
# VI: v_lshlrev_b32_sdwa v{{[0-9]+}}, v[[SHIFT]], v{{[0-9]+}} dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1
# VI: v_lshlrev_b32_sdwa v{{[0-9]+}}, v[[SHIFT]], v{{[0-9]+}} dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1

# GFX9: s_mov_b32 s[[SHIFT:[0-9]+]], 2
# GFX9-NOT: v_mov_b32_e32 v{{[0-9]+}}, 2
# GFX9: BB1_1:
# GFX9: v_lshlrev_b32_sdwa v{{[0-9]+}}, s[[SHIFT]], v{{[0-9]+}} dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1
# GFX9: v_lshlrev_b32_sdwa v{{[0-9]+}}, s[[SHIFT]], v{{[0-9]+}} dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1

--- |
  ; ModuleID = 'sdwa-scalar-ops.opt.ll'
  source_filename = "sdwa-scalar-ops.opt.ll"

  define amdgpu_kernel void @sdwa_imm_operand(ptr addrspace(1) nocapture %arg) {
  bb:
    br label %bb2

  bb1:                                              ; preds = %bb2
    ret void

  bb2:                                              ; preds = %bb2, %bb
    %lsr.iv = phi i64 [ %lsr.iv.next, %bb2 ], [ 0, %bb ]
    %bc = bitcast ptr addrspace(1) %arg to ptr addrspace(1)
    %uglygep4 = getelementptr i8, ptr addrspace(1) %bc, i64 %lsr.iv
    %uglygep45 = bitcast ptr addrspace(1) %uglygep4 to ptr addrspace(1)
    %tmp5 = load i32, ptr addrspace(1) %uglygep45, align 4
    %tmp6 = lshr i32 %tmp5, 8
    %tmp7 = and i32 %tmp6, 255
    %tmp8 = zext i32 %tmp7 to i64
    %tmp9 = getelementptr inbounds i32, ptr addrspace(1) %arg, i64 %tmp8
    store i32 1, ptr addrspace(1) %tmp9, align 4
    %scevgep = getelementptr i32, ptr addrspace(1) %uglygep45, i64 1
    %tmp13 = load i32, ptr addrspace(1) %scevgep, align 4
    %tmp14 = lshr i32 %tmp13, 8
    %tmp15 = and i32 %tmp14, 255
    %tmp16 = zext i32 %tmp15 to i64
    %tmp17 = getelementptr inbounds i32, ptr addrspace(1) %arg, i64 %tmp16
    store i32 1, ptr addrspace(1) %tmp17, align 4
    %lsr.iv.next = add nuw nsw i64 %lsr.iv, 8
    %tmp1 = trunc i64 %lsr.iv.next to i32
    %tmp19 = icmp eq i32 %tmp1, 4096
    br i1 %tmp19, label %bb1, label %bb2
  }

  define amdgpu_kernel void @sdwa_sgpr_operand(ptr addrspace(1) nocapture %arg) {
  bb:
    br label %bb2

  bb1:                                              ; preds = %bb2
    ret void

  bb2:                                              ; preds = %bb2, %bb
    %lsr.iv = phi i64 [ %lsr.iv.next, %bb2 ], [ 0, %bb ]
    %bc = bitcast ptr addrspace(1) %arg to ptr addrspace(1)
    %uglygep4 = getelementptr i8, ptr addrspace(1) %bc, i64 %lsr.iv
    %uglygep45 = bitcast ptr addrspace(1) %uglygep4 to ptr addrspace(1)
    %tmp5 = load i32, ptr addrspace(1) %uglygep45, align 4
    %tmp6 = lshr i32 %tmp5, 8
    %tmp7 = and i32 %tmp6, 255
    %tmp8 = zext i32 %tmp7 to i64
    %tmp9 = getelementptr inbounds i32, ptr addrspace(1) %arg, i64 %tmp8
    store i32 1, ptr addrspace(1) %tmp9, align 4
    %scevgep = getelementptr i32, ptr addrspace(1) %uglygep45, i64 1
    %tmp13 = load i32, ptr addrspace(1) %scevgep, align 4
    %tmp14 = lshr i32 %tmp13, 8
    %tmp15 = and i32 %tmp14, 255
    %tmp16 = zext i32 %tmp15 to i64
    %tmp17 = getelementptr inbounds i32, ptr addrspace(1) %arg, i64 %tmp16
    store i32 1, ptr addrspace(1) %tmp17, align 4
    %lsr.iv.next = add nuw nsw i64 %lsr.iv, 8
    %tmp1 = trunc i64 %lsr.iv.next to i32
    %tmp19 = icmp eq i32 %tmp1, 4096
    br i1 %tmp19, label %bb1, label %bb2
  }

...
---
name:            sdwa_imm_operand
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
liveins:
  - { reg: '$sgpr4_sgpr5', virtual-reg: '%4' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    0
  adjustsStack:    false
  hasCalls:        false
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
body:             |
  bb.0.bb:
    successors: %bb.2.bb2(0x80000000)
    liveins: $sgpr4_sgpr5

    %4:sgpr_64 = COPY $sgpr4_sgpr5
    %9:sreg_64_xexec = S_LOAD_DWORDX2_IMM %4, 0, 0 :: (non-temporal dereferenceable invariant load (s64) from `ptr addrspace(4) poison`)
    %8:sreg_64 = S_MOV_B64 0
    %7:sreg_64 = COPY %9
    %30:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    S_BRANCH %bb.2.bb2

  bb.1.bb1:
    S_ENDPGM 0

  bb.2.bb2:
    successors: %bb.1.bb1(0x04000000), %bb.2.bb2(0x7c000000)

    %0:sreg_64 = PHI %8, %bb.0.bb, %1, %bb.2.bb2
    %13:sreg_32_xm0 = COPY %7.sub1
    %14:sreg_32_xm0 = S_ADD_U32 %7.sub0, %0.sub0, implicit-def $scc
    %15:sreg_32_xm0 = S_ADDC_U32 %7.sub1, %0.sub1, implicit-def dead $scc, implicit $scc
    %16:sreg_64 = REG_SEQUENCE %14, %subreg.sub0, %15, %subreg.sub1
    %18:vreg_64 = COPY %16
    %17:vgpr_32 = FLAT_LOAD_DWORD %18, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %ir.uglygep45)
    %60:vgpr_32 = V_BFE_U32_e64 %17, 8, 8, implicit $exec
    %61:vgpr_32 = V_LSHLREV_B32_e32 2, %60, implicit $exec
    %70:vgpr_32 = V_ADD_CO_U32_e32 %7.sub0, %61, implicit-def $vcc, implicit $exec
    %66:vgpr_32 = COPY %13
    %65:vgpr_32 = V_ADDC_U32_e32 0, %66, implicit-def $vcc, implicit $vcc, implicit $exec
    %67:vreg_64 = REG_SEQUENCE %70, %subreg.sub0, %65, %subreg.sub1
    FLAT_STORE_DWORD %67, %30, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %ir.tmp9)
    %37:sreg_32_xm0 = S_ADD_U32 %14, 4, implicit-def $scc
    %38:sreg_32_xm0 = S_ADDC_U32 %15, 0, implicit-def dead $scc, implicit $scc
    %71:vgpr_32 = COPY %37
    %72:vgpr_32 = COPY %38
    %41:vreg_64 = REG_SEQUENCE %71, %subreg.sub0, %72, %subreg.sub1
    %40:vgpr_32 = FLAT_LOAD_DWORD %41, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %ir.scevgep)
    %73:vgpr_32 = V_BFE_U32_e64 %40, 8, 8, implicit $exec
    %74:vgpr_32 = V_LSHLREV_B32_e32 2, %73, implicit $exec
    %83:vgpr_32 = V_ADD_CO_U32_e32 %7.sub0, %74, implicit-def $vcc, implicit $exec
    %78:vgpr_32 = V_ADDC_U32_e32 0, %66, implicit-def $vcc, implicit $vcc, implicit $exec
    %80:vreg_64 = REG_SEQUENCE %83, %subreg.sub0, %78, %subreg.sub1
    FLAT_STORE_DWORD %80, %30, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %ir.tmp17)
    %55:sreg_32_xm0 = S_ADD_U32 %0.sub0, 8, implicit-def $scc
    %56:sreg_32_xm0 = S_ADDC_U32 %0.sub1, 0, implicit-def dead $scc, implicit $scc
    %57:sreg_64 = REG_SEQUENCE %55, %subreg.sub0, %56, %subreg.sub1
    %1:sreg_64 = COPY %57
    S_CMPK_EQ_I32 %55, 4096, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1.bb1, implicit $scc
    S_BRANCH %bb.2.bb2

...
---
name:            sdwa_sgpr_operand
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
liveins:
  - { reg: '$sgpr4_sgpr5', virtual-reg: '%4' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    0
  adjustsStack:    false
  hasCalls:        false
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
body:             |
  bb.0.bb:
    successors: %bb.2.bb2(0x80000000)
    liveins: $sgpr4_sgpr5

    %4:sgpr_64 = COPY $sgpr4_sgpr5
    %9:sreg_64_xexec = S_LOAD_DWORDX2_IMM %4, 0, 0 :: (non-temporal dereferenceable invariant load (s64) from `ptr addrspace(4) poison`)
    %8:sreg_64 = S_MOV_B64 0
    %7:sreg_64 = COPY %9
    %30:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %84:sreg_32_xm0 = S_MOV_B32 2
    S_BRANCH %bb.2.bb2

  bb.1.bb1:
    S_ENDPGM 0

  bb.2.bb2:
    successors: %bb.1.bb1(0x04000000), %bb.2.bb2(0x7c000000)

    %0:sreg_64 = PHI %8, %bb.0.bb, %1, %bb.2.bb2
    %13:sreg_32_xm0 = COPY %7.sub1
    %14:sreg_32_xm0 = S_ADD_U32 %7.sub0, %0.sub0, implicit-def $scc
    %15:sreg_32_xm0 = S_ADDC_U32 %7.sub1, %0.sub1, implicit-def dead $scc, implicit $scc
    %16:sreg_64 = REG_SEQUENCE %14, %subreg.sub0, %15, %subreg.sub1
    %18:vreg_64 = COPY %16
    %17:vgpr_32 = FLAT_LOAD_DWORD %18, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %ir.uglygep45)
    %60:vgpr_32 = V_BFE_U32_e64 %17, 8, 8, implicit $exec
    %61:vgpr_32 = V_LSHLREV_B32_e32 %84, %60, implicit $exec
    %70:vgpr_32 = V_ADD_CO_U32_e32 %7.sub0, %61, implicit-def $vcc, implicit $exec
    %66:vgpr_32 = COPY %13
    %65:vgpr_32 = V_ADDC_U32_e32 0, %66, implicit-def $vcc, implicit $vcc, implicit $exec
    %67:vreg_64 = REG_SEQUENCE %70, %subreg.sub0, %65, %subreg.sub1
    FLAT_STORE_DWORD %67, %30, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %ir.tmp9)
    %37:sreg_32_xm0 = S_ADD_U32 %14, 4, implicit-def $scc
    %38:sreg_32_xm0 = S_ADDC_U32 %15, 0, implicit-def dead $scc, implicit $scc
    %71:vgpr_32 = COPY %37
    %72:vgpr_32 = COPY %38
    %41:vreg_64 = REG_SEQUENCE %71, %subreg.sub0, %72, %subreg.sub1
    %40:vgpr_32 = FLAT_LOAD_DWORD %41, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %ir.scevgep)
    %73:vgpr_32 = V_BFE_U32_e64 %40, 8, 8, implicit $exec
    %74:vgpr_32 = V_LSHLREV_B32_e32 %84, %73, implicit $exec
    %83:vgpr_32 = V_ADD_CO_U32_e32 %7.sub0, %74, implicit-def $vcc, implicit $exec
    %78:vgpr_32 = V_ADDC_U32_e32 0, %66, implicit-def $vcc, implicit $vcc, implicit $exec
    %80:vreg_64 = REG_SEQUENCE %83, %subreg.sub0, %78, %subreg.sub1
    FLAT_STORE_DWORD %80, %30, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %ir.tmp17)
    %55:sreg_32_xm0 = S_ADD_U32 %0.sub0, 8, implicit-def $scc
    %56:sreg_32_xm0 = S_ADDC_U32 %0.sub1, 0, implicit-def dead $scc, implicit $scc
    %57:sreg_64 = REG_SEQUENCE %55, %subreg.sub0, %56, %subreg.sub1
    %1:sreg_64 = COPY %57
    S_CMPK_EQ_I32 %55, 4096, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1.bb1, implicit $scc
    S_BRANCH %bb.2.bb2

...
