    ; EXTEND-NEXT: %base:vgpr_32 = V_ADD_U32_e32 %x, %y, implicit $exec
    ; EXTEND-NEXT: %addr0:vgpr_32 = V_ADD_U32_e32 0, %base, implicit $exec
    ; EXTEND-NEXT: %addr1:vgpr_32 = V_ADD_U32_e32 16, %base, implicit $exec
    ; EXTEND-NEXT: %addr2:vgpr_32 = V_ADD_U32_e32 32, %base, implicit $exec
    ; EXTEND-NEXT: %addr3:vgpr_32 = V_ADD_U32_e32 48, %base, implicit $exec
    ; EXTEND-NEXT: S_NOP 0, implicit %addr0, implicit %addr1, implicit %addr2, implicit %addr3
    ; EXTEND-NEXT: SCHED_BARRIER 0
    ; EXTEND-NEXT: [[V_CVT_I32_F64_e32_:%[0-9]+]]:vgpr_32 = nofpexcept V_CVT_I32_F64_e32 0, implicit $exec, implicit $mode, implicit-def $m0
    ; EXTEND-NEXT: [[V_CVT_I32_F64_e32_1:%[0-9]+]]:vgpr_32 = nofpexcept V_CVT_I32_F64_e32 1, implicit $exec, implicit $mode, implicit-def $m0
    ; EXTEND-NEXT: [[V_CVT_I32_F64_e32_2:%[0-9]+]]:vgpr_32 = nofpexcept V_CVT_I32_F64_e32 2, implicit $exec, implicit $mode, implicit-def $m0
    ; EXTEND-NEXT: [[V_CVT_I32_F64_e32_3:%[0-9]+]]:vgpr_32 = nofpexcept V_CVT_I32_F64_e32 3, implicit $exec, implicit $mode, implicit-def $m0
