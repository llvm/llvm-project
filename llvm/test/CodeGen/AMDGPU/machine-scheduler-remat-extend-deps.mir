# Same as above except that the second set of address users is in a different
# block than %base's definition, which prevents extending %base's live range.
name:            no_extend_across_blocks
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; EXTEND-LABEL: name: no_extend_across_blocks
  ; EXTEND: bb.0:
  ; EXTEND-NEXT:   successors: %bb.1(0x80000000)
