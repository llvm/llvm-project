# RUN: llc -mtriple=amdgpu9.08 -run-pass=machine-scheduler -amdgpu-disable-unclustered-high-rp-reschedule -amdgpu-remat-extend-deps -verify-machineinstrs %s -o - | FileCheck -check-prefix=EXTEND %s
# RUN: llc -mtriple=amdgpu9.08 -run-pass=machine-scheduler -amdgpu-disable-unclustered-high-rp-reschedule -verify-machineinstrs %s -o - | FileCheck -check-prefix=NOEXTEND %s

--- |
  define void @extend_shared_base() "amdgpu-num-vgpr"="12" {
    ret void
  }
  define void @no_extend_across_blocks() "amdgpu-num-vgpr"="12" {
    ret void
  }
---
# Addresses %addr0-3 are computed from a shared base %base and used both in
# their defining region and in a later region of the same block, with a high
# pressure region in between. %base is computed from unrematerializable
# registers that die in the defining region, so it cannot be rematerialized
# along with the addresses. Rematerializing the addresses into the later region
# reduces pressure in the high pressure region only if %base's live range is
# extended there.
name:            extend_shared_base
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; EXTEND-LABEL: name: extend_shared_base
    ; EXTEND: liveins: $vgpr0, $vgpr1
    ; EXTEND-NEXT: {{  $}}
    ; EXTEND-NEXT: %x:vgpr_32 = COPY $vgpr0
    ; EXTEND-NEXT: %y:vgpr_32 = COPY $vgpr1
