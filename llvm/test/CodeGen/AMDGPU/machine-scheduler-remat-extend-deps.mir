    ; NOEXTEND-NEXT: %addr1:vgpr_32 = V_ADD_U32_e32 16, %base, implicit $exec
    ; NOEXTEND-NEXT: %addr2:vgpr_32 = V_ADD_U32_e32 32, %base, implicit $exec
    ; NOEXTEND-NEXT: %addr3:vgpr_32 = V_ADD_U32_e32 48, %base, implicit $exec
    ; NOEXTEND-NEXT: S_NOP 0, implicit %addr0, implicit %addr1, implicit %addr2, implicit %addr3
    ; NOEXTEND-NEXT: SCHED_BARRIER 0
    ; NOEXTEND-NEXT: [[V_CVT_I32_F64_e32_:%[0-9]+]]:vgpr_32 = nofpexcept V_CVT_I32_F64_e32 0, implicit $exec, implicit $mode, implicit-def $m0
