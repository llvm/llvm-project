# RUN: llc -mtriple=amdgpu9.08 -run-pass post-RA-sched -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s

# GCN-LABEL: name: unrelated_mfma
# GCN: V_MFMA_F32_32X32X1F32
# GCN: S_CMP_LG_U32
# GCN: V_MFMA_F32_32X32X1F32

---
name:            unrelated_mfma
body:             |
  bb.0.entry:
    renamable $agpr0_1024 = V_MFMA_F32_32X32X1F32_e64 $vgpr67, $vgpr66, $agpr0_1024, 0, 0, 0, implicit $mode, implicit $exec
    renamable $agpr32_1024 = V_MFMA_F32_32X32X1F32_e64 $vgpr69, $vgpr68, killed $agpr32_1024, 0, 0, 0, implicit $mode, implicit $exec
    renamable $sgpr2 = S_ADD_U32 renamable $sgpr2, 4, implicit-def $scc
    renamable $sgpr3 = S_ADDC_U32 renamable $sgpr3, 0, implicit-def dead $scc, implicit killed $scc
    S_CMP_LG_U32 renamable $sgpr2, 64, implicit-def $scc

...
