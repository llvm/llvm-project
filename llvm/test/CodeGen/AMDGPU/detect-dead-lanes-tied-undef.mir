# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=detect-dead-lanes -o - %s | FileCheck %s

## %2.sub1 is undefined, but one of the three reads is tied, so marking them
## undef would leave the tie's rewrite with nothing to follow.

---
name: tied_undef_read
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: tied_undef_read
    ; CHECK: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: dead [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE undef [[V_MOV_B32_e32_]], %subreg.sub0, undef [[DEF]], %subreg.sub1
    ; CHECK-NEXT: [[V_FMAC_F32_e32_:%[0-9]+]]:vgpr_32 = nofpexcept V_FMAC_F32_e32 [[REG_SEQUENCE]].sub1, [[REG_SEQUENCE]].sub1, [[REG_SEQUENCE]].sub1, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_FMAC_F32_e32_]]
    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    %2:vreg_64 = REG_SEQUENCE %1, %subreg.sub0, %0, %subreg.sub1
    %3:vgpr_32 = nofpexcept V_FMAC_F32_e32 %2.sub1, %2.sub1, %2.sub1, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %3
...
