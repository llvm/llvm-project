# RUN: llc -mtriple=amdgpu9.00 -verify-machineinstrs -run-pass=liveintervals,phi-node-elimination -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu9.00 -verify-each -passes='require<live-intervals>,phi-node-elimination' -o - %s | FileCheck %s

# Splitting the critical edge from %bb.1 to %bb.2 removes the new block's
# interval from %wide. Only %wide.sub0 is live out of %bb.1; %wide.sub1 has a
# later, non-overlapping segment in %bb.4. Do not try to remove the new block's
# interval from that non-overlapping subrange.

# CHECK-LABEL: name: split_critical_edge_nonoverlapping_subrange
# CHECK: bb.1:
# CHECK: bb.5:
# CHECK: bb.2:

---
name: split_critical_edge_nonoverlapping_subrange
tracksRegLiveness: true
body: |
  bb.0:
    %lo:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %hi:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %wide:vreg_64 = REG_SEQUENCE %lo, %subreg.sub0, %hi, %subreg.sub1
    %phisrc:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    $scc = IMPLICIT_DEF
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.4

  bb.1:
    $scc = IMPLICIT_DEF
    S_CBRANCH_SCC1 %bb.3, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    %phi:vgpr_32 = PHI %phisrc, %bb.1, %other:vgpr_32, %bb.4
    S_ENDPGM 0, implicit %phi

  bb.3:
    S_ENDPGM 0, implicit %wide.sub0, implicit %phisrc

  bb.4:
    %other:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    S_NOP 0, implicit %wide.sub1
    S_BRANCH %bb.2
...
