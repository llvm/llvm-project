# A subregister operand keeps the copy.
---
name:            phi_vgpr_av64_subreg_operand
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_vgpr_av64_subreg_operand
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0_vgpr1, $vgpr2, $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:av_64_align2 = COPY $vgpr0_vgpr1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr2
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   $vcc = COPY [[COPY2]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY]].sub1, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.2, implicit $vcc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[COPY1]], [[COPY1]], implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY3]], %bb.0, [[V_ADD_U32_e32_]], %bb.1
  ; CHECK-NEXT:   $vgpr0 = COPY [[PHI]]
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0_vgpr1, $vgpr2, $sgpr0_sgpr1

    %0:av_64_align2 = COPY $vgpr0_vgpr1
    %1:vgpr_32 = COPY $vgpr2
    %2:sreg_64 = COPY $sgpr0_sgpr1
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %3:vgpr_32 = V_ADD_U32_e32 %1, %1, implicit $exec

  bb.2:
    %4:vgpr_32 = PHI %0.sub1, %bb.0, %3, %bb.1
    $vgpr0 = COPY %4
    SI_RETURN implicit $vgpr0
...

# The common subclass of an av_32 operand and an agpr_32 PHI is an AGPR class.
# The copy is kept.
---
name:            phi_agpr_av_operand
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: phi_agpr_av_operand
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $agpr0, $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:av_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:agpr_32 = COPY $agpr0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   $vcc = COPY [[COPY2]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:agpr_32 = COPY [[COPY]], implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.2, implicit $vcc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:agpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:agpr_32 = PHI [[COPY3]], %bb.0, [[COPY4]], %bb.1
  ; CHECK-NEXT:   $agpr0 = COPY [[PHI]]
  ; CHECK-NEXT:   SI_RETURN implicit $agpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $agpr0, $sgpr0_sgpr1

    %0:av_32 = COPY $vgpr0
    %1:agpr_32 = COPY $agpr0
    %2:sreg_64 = COPY $sgpr0_sgpr1
    $vcc = COPY %2
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %3:agpr_32 = COPY %1

  bb.2:
    %4:agpr_32 = PHI %0, %bb.0, %3, %bb.1
    $agpr0 = COPY %4
    SI_RETURN implicit $agpr0
...

