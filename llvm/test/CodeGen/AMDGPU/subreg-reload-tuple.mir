    SI_RETURN implicit $vgpr0
...

---
name:            subreg_reload_test_tied_ops
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vgpr_32 }
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3

    ; CHECK-LABEL: name: subreg_reload_test_tied_ops
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SI_SPILL_V128_SAVE $vgpr0_vgpr1_vgpr2_vgpr3, %stack.0, $sgpr32, 0, implicit $exec :: (store (s128) into %stack.0, align 4, addrspace 5)
    ; CHECK-NEXT: S_NOP 0, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: renamable $vgpr0_vgpr1 = SI_SPILL_V64_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s64) from %stack.0, align 4, addrspace 5)
    ; CHECK-NEXT: renamable $vgpr1 = V_ADD_U32_e32 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY killed renamable $vgpr1
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    undef %0.sub0:vreg_128 = COPY $vgpr0
    %0.sub1:vreg_128 = COPY $vgpr1
    %0.sub2:vreg_128 = COPY $vgpr2
    %0.sub3:vreg_128 = COPY $vgpr3
    S_NOP 0, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    %0.sub1 = V_ADD_U32_e32 %0.sub0, %0.sub1, implicit $exec
    $vgpr0 = COPY %0.sub1
    SI_RETURN implicit $vgpr0
...
