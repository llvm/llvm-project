# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -start-before=greedy,2 -stress-regalloc=4 -stop-after=virtregrewriter,2 -o - %s | FileCheck %s

# Test that spilling a register tuple and reloading two sub-register
# indices in the same instruction works correctly.

---
name:            subreg_reload_test
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vgpr_32 }
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3

    ; CHECK-LABEL: name: subreg_reload_test
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SI_SPILL_V128_SAVE $vgpr0_vgpr1_vgpr2_vgpr3, %stack.0, $sgpr32, 0, implicit $exec :: (store (s128) into %stack.0, align 4, addrspace 5)
    ; CHECK-NEXT: S_NOP 0, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: renamable $vgpr0_vgpr1 = SI_SPILL_V64_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s64) from %stack.0, align 4, addrspace 5)
    ; CHECK-NEXT: renamable $vgpr0 = V_ADD_U32_e32 killed $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    undef %0.sub0:vreg_128 = COPY $vgpr0
    %0.sub1:vreg_128 = COPY $vgpr1
    %0.sub2:vreg_128 = COPY $vgpr2
    %0.sub3:vreg_128 = COPY $vgpr3
    S_NOP 0, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    %1:vgpr_32 = V_ADD_U32_e32 %0.sub0, %0.sub1, implicit $exec
    $vgpr0 = COPY %1
    SI_RETURN implicit $vgpr0
...

---
name:            subreg_reload_test_disjoint_subregs
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vgpr_32 }
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3

    ; CHECK-LABEL: name: subreg_reload_test_disjoint_subregs
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SI_SPILL_V128_SAVE $vgpr0_vgpr1_vgpr2_vgpr3, %stack.0, $sgpr32, 0, implicit $exec :: (store (s128) into %stack.0, align 4, addrspace 5)
    ; CHECK-NEXT: S_NOP 0, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2 = SI_SPILL_V96_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s96) from %stack.0, align 4, addrspace 5)
    ; CHECK-NEXT: renamable $vgpr0 = V_ADD_U32_e32 killed $vgpr0, $vgpr2, implicit $exec
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    undef %0.sub0:vreg_128 = COPY $vgpr0
    %0.sub1:vreg_128 = COPY $vgpr1
    %0.sub2:vreg_128 = COPY $vgpr2
    %0.sub3:vreg_128 = COPY $vgpr3
    S_NOP 0, implicit-def $vgpr0_vgpr1_vgpr2_vgpr3
    %1:vgpr_32 = V_ADD_U32_e32 %0.sub0, %0.sub2, implicit $exec
