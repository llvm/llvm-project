loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %store.ok ]
  %sum = phi float [ 0.0, %entry ], [ %sum.next, %store.ok ]
  %i.64 = zext i32 %i to i64
  %row = shl i64 %i.64, 6
  %j = add i64 %row, %tid.64
  %off = shl i64 %j, 2
  %last = add i64 %off, 3
  %load.bad = icmp uge i64 %last, %size
  br i1 %load.bad, label %load.fail, label %load.ok, !prof !0

load.fail:
  %load.ptr = getelementptr inbounds i8, ptr addrspace(1) %in, i64 %off
  call void @report_load(ptr addrspace(1) %load.ptr, i64 4)
  unreachable

load.ok:
  %in.gep = getelementptr inbounds float, ptr addrspace(1) %in, i64 %j
  %v = load float, ptr addrspace(1) %in.gep
  %store.bad = icmp uge i64 %off, %size
  br i1 %store.bad, label %store.fail, label %store.ok, !prof !0

store.fail:
  %store.ptr = getelementptr inbounds i8, ptr addrspace(1) %out, i64 %off
  call void @report_store(ptr addrspace(1) %store.ptr, i64 4)
  unreachable

store.ok:
  %out.gep = getelementptr inbounds float, ptr addrspace(1) %out, i64 %j
  %r = fmul float %v, 2.0
  store float %r, ptr addrspace(1) %out.gep
  %sum.next = fadd float %sum, %v
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  %res = phi float [ 0.0, %entry ], [ %sum.next, %store.ok ]
  %sums.gep = getelementptr inbounds float, ptr addrspace(1) %sums, i64 %tid.64
  store float %res, ptr addrspace(1) %sums.gep
  ret void
}

