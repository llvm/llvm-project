    %x6.sub2:vreg_128_align2 = COPY %init
    %x6.sub3:vreg_128_align2 = COPY %init
    undef %x7.sub0:vreg_128_align2 = COPY %init
    %x7.sub1:vreg_128_align2 = COPY %init
    %x7.sub2:vreg_128_align2 = COPY %init
    %x7.sub3:vreg_128_align2 = COPY %init
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1(0x7e000000), %bb.2(0x02000000)

    %t0_0:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %x0, 0, 0, 0, implicit $mode, implicit $exec
    %t0_1:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %t0_0, 0, 0, 0, implicit $mode, implicit $exec
    %t0_2:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %t0_1, 0, 0, 0, implicit $mode, implicit $exec
