    %p12:vreg_1024 = IMPLICIT_DEF
    %srca:vgpr_32 = IMPLICIT_DEF
    %srcb:vgpr_32 = IMPLICIT_DEF
    %init:vgpr_32 = V_MOV_B32_e32 1065353216, implicit $exec
    undef %x0.sub0:vreg_128_align2 = COPY %init
    %x0.sub1:vreg_128_align2 = COPY %init
    %x0.sub2:vreg_128_align2 = COPY %init
    %x0.sub3:vreg_128_align2 = COPY %init
    undef %x1.sub0:vreg_128_align2 = COPY %init
    %x1.sub1:vreg_128_align2 = COPY %init
    %x1.sub2:vreg_128_align2 = COPY %init
    %x1.sub3:vreg_128_align2 = COPY %init
    undef %x2.sub0:vreg_128_align2 = COPY %init
    %x2.sub1:vreg_128_align2 = COPY %init
    %x2.sub2:vreg_128_align2 = COPY %init
    %x2.sub3:vreg_128_align2 = COPY %init
    undef %x3.sub0:vreg_128_align2 = COPY %init
    %x3.sub1:vreg_128_align2 = COPY %init
    %x3.sub2:vreg_128_align2 = COPY %init
    %x3.sub3:vreg_128_align2 = COPY %init
    undef %x4.sub0:vreg_128_align2 = COPY %init
    %x4.sub1:vreg_128_align2 = COPY %init
    %x4.sub2:vreg_128_align2 = COPY %init
    %x4.sub3:vreg_128_align2 = COPY %init
