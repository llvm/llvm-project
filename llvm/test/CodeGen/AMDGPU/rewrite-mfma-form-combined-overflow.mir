# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -run-pass=machine-scheduler -amdgpu-rewrite-mfma-form-sched-stage=true -debug-only=machine-scheduler -o /dev/null %s 2>&1 | FileCheck %s

# Moving ArchVGPR overflow into the AGPRs only helps while both files hold what
# the region needs. Eight accumulators are restored after the loop, so each
# stays a VGPR next to its AGPR. The functions differ by a few filler registers: in
# the first all eight chains fit the combined file, in the second only five.

# CHECK: RewriteMFMAForm: best 8/8 chains
# CHECK: RewriteMFMAForm: best 5/8 chains

--- |
  define void @combined_file_fits() #0 {
  entry:
    unreachable
  }
  define void @combined_file_overflows() #0 {
  entry:
    unreachable
  }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            combined_file_fits
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
