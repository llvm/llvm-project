; RUN: llc -mtriple=amdgpu9.00 < %s | FileCheck -check-prefix=GFX9 %s

; DAGCombiner folds fadd a, select(c, (fneg x), (fneg y)) into
; fsub a, select(c, x, y), because negating the select removes both fnegs.
; The new select must keep the fast-math flags of the original select.
;
; The test checks the flags through a fold that needs them. With nnan and nsz,
; select (fcmp olt x, y), x, y becomes fminnum, which is selected to v_min_f32.
; Without the flags, the select stays v_cmp and v_cndmask_b32.

; With nnan and nsz the new select becomes fminnum.
define float @fadd_select_fneg_min(float %a, float %x, float %y) {
; GFX9-LABEL: fadd_select_fneg_min:
; GFX9:       ; %bb.0:
; GFX9-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; GFX9-NEXT:    v_min_f32_e32 v1, v1, v2
; GFX9-NEXT:    v_sub_f32_e32 v0, v0, v1
; GFX9-NEXT:    s_setpc_b64 s[30:31]
  %cmp = fcmp olt float %x, %y
  %nx = fneg float %x
  %ny = fneg float %y
  %sel = select nnan nsz i1 %cmp, float %nx, float %ny
  %r = fadd float %a, %sel
  ret float %r
}

define float @fadd_select_fneg_max(float %a, float %x, float %y) {
; GFX9-LABEL: fadd_select_fneg_max:
