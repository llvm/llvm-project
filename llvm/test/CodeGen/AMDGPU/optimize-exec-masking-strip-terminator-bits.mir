# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu8.03 -verify-machineinstrs -run-pass=si-optimize-exec-masking -o - %s | FileCheck %s

# There are multiple _term pseudos here. Starting from the end of the
# block, they all need to be converted to regular copies removed in
# order to avoid making the verifier unhappy.

---
name:  multi_term_pseudos
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: multi_term_pseudos
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr4_64, $sgpr6_64, $sgpr8_64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $exec = COPY killed renamable $sgpr4_64
  ; CHECK-NEXT:   renamable $sgpr10_64 = COPY killed renamable $sgpr6_64, implicit $exec
  ; CHECK-NEXT:   renamable $sgpr12_64 = COPY killed renamable $sgpr8_64, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.1, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $sgpr12_64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $sgpr12_64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $sgpr12_64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $sgpr12_64
  bb.0:
    successors: %bb.2(0x40000000), %bb.1(0x40000000)
    liveins: $sgpr4_64, $sgpr6_64, $sgpr8_64
    $exec = S_MOV_B64_term killed renamable $sgpr4_64
    renamable $sgpr10_64 = S_MOV_B64_term killed renamable $sgpr6_64, implicit $exec
    renamable $sgpr12_64 = S_MOV_B64_term killed renamable $sgpr8_64, implicit $exec
    S_CBRANCH_EXECZ %bb.1, implicit $exec
    S_BRANCH %bb.2

  bb.1:
    liveins: $sgpr12_64
    S_ENDPGM 0, implicit $sgpr12_64

  bb.2:
    liveins: $sgpr12_64
    S_ENDPGM 0, implicit $sgpr12_64

...
