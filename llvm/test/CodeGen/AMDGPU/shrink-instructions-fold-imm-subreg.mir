# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-shrink-instructions -o - %s | FileCheck %s

# Folding a 64-bit move immediate into a subregister use must only fold
# the immediate value of the used half. A global address cannot be folded
# into a subregister use.

---
name: fold_v_mov_b64_sub0
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fold_v_mov_b64_sub0
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_AND_B32_e32_:%[0-9]+]]:vgpr_32 = V_AND_B32_e32 22136, [[COPY]], implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_AND_B32_e32_]]
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vreg_64_align2 = V_MOV_B64_PSEUDO 4611686022722377336, implicit $exec
    %2:vgpr_32 = V_AND_B32_e64 %1.sub0, %0, implicit $exec
    $vgpr0 = COPY %2
    SI_RETURN implicit $vgpr0
...

