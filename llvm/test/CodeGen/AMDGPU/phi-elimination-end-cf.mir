# RUN: llc -mtriple=amdgpu6.00 -run-pass livevars -run-pass phi-node-elimination -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu6.00 --passes='require<live-vars>,phi-node-elimination' -verify-each -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu6.00 -mir-strip-debugify-only=false -run-pass mir-strip-debug -run-pass livevars -run-pass phi-node-elimination -o - %s | FileCheck %s --check-prefix=NODBG

# CHECK-LABEL:  phi-cf-test
# CHECK: bb.0:
# CHECK:     [[COND:%[0-9]+]]:sreg_64 = V_CMP_EQ_U32_e64
# CHECK:     [[IF_SOURCE0:%[0-9]+]]:sreg_64 = SI_IF [[COND]], %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
# CHECK:     [[IF_INPUT_REG:%[0-9]+]]:sreg_64 = S_MOV_B64_term [[IF_SOURCE0]], implicit $exec

# CHECK: bb.1:
# CHECK:     [[END_CF_ARG:%[0-9]+]]:sreg_64 = COPY [[IF_INPUT_REG]]
# CHECK:     SI_END_CF [[END_CF_ARG]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
# CHECK-NEXT: [[VALUE:%[0-9]+]]:vgpr_32 = COPY
# CHECK-NEXT: DBG_VALUE [[VALUE]]

# CHECK: bb.2:
# CHECK:     [[IF_SOURCE1:%[0-9]+]]:sreg_64 = SI_IF [[COND]], %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
# CHECK:     [[IF_INPUT_REG]]:sreg_64 = S_MOV_B64_term [[IF_SOURCE1]], implicit $exec

# NODBG-LABEL: phi-cf-test
# NODBG: bb.1:
# NODBG: [[NODBG_END_CF_ARG:%[0-9]+]]:sreg_64 = COPY
# NODBG-NEXT: SI_END_CF [[NODBG_END_CF_ARG]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
# NODBG-NEXT: [[NODBG_PHI_DEST:%[0-9]+]]:vgpr_32 = COPY [[NODBG_PHI_INPUT:%[0-9]+]]
# NODBG-NEXT: {{.*}} V_ADD_CO_U32_e64 1, [[NODBG_PHI_DEST]], 0, implicit $exec
--- |
  define void @"phi-cf-test"() !dbg !3 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "phi-elimination-end-cf.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "phi-cf-test", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !5)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !DILocalVariable(name: "value", scope: !3, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
...
---
name:            phi-cf-test
tracksRegLiveness: true
body:             |

  bb.0:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)
    liveins: $vgpr0

    %5:vgpr_32(s32) = COPY $vgpr0
    %0:sreg_64 = V_CMP_EQ_U32_e64 0, %5(s32), implicit $exec
    %18:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %22:sreg_64 = SI_IF %0, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3(0x80000000)

    %24:sreg_64 = PHI %20, %bb.3, %22, %bb.0
    %23:vgpr_32 = PHI %19, %bb.3, %18, %bb.0
    DBG_VALUE %23, $noreg, !6, !DIExpression(), debug-location !8
    SI_END_CF %24, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    %3:vgpr_32, dead %10:sreg_64 = nsw V_ADD_CO_U32_e64 1, %23, 0, implicit $exec

  bb.3:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)

    %4:vgpr_32 = PHI %19, %bb.3, %3, %bb.2, %18, %bb.0
    %15:sreg_32_xm0 = S_MOV_B32 61440
    %16:sreg_32_xm0 = S_MOV_B32 -1
    %17:sgpr_128 = REG_SEQUENCE undef %14:sreg_32_xm0, %subreg.sub0, undef %12:sreg_32_xm0, %subreg.sub1, %16, %subreg.sub2, %15, %subreg.sub3
    BUFFER_STORE_DWORD_OFFSET %4, %17, 0, 0, 0, 0, implicit $exec :: (volatile store (s32) into `ptr addrspace(1) poison`, addrspace 1)
    %19:vgpr_32 = COPY %4
    %20:sreg_64 = SI_IF %0, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.3

...
