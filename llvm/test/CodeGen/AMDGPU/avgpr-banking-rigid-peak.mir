# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler \
# RUN:     -amdgpu-avgpr-banking=1 -misched-only-block=1 \
# RUN:     -debug-only=machine-scheduler -filetype=null %s 2>&1 | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler \
# RUN:     -amdgpu-avgpr-banking=0 -misched-only-block=1 \
# RUN:     -debug-only=machine-scheduler -filetype=null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# The region enters with 257 rigid ArchVGPRs, which %t kills, and then defines
# 258 AVGPRs. The region maximum keeps only the AVGPR point, which fits the
# two banks, so the ArchVGPR excess at the region entry must be found by
# distributing the pressure of each point separately.

# CHECK: Starting scheduling stage: Max Occupancy Initial Schedule
# CHECK: Region live-in pressure:  VGPRs: 257 AGPRs: 0
# CHECK: Pressure after scheduling: VGPRs: 259 (AV: 258) AGPRs: 0
# CHECK: Starting scheduling stage: Unclustered High Register Pressure Reschedule
# CHECK: Region is known to spill

--- |
  define amdgpu_kernel void @rigid_peak() #0 {
    ret void
  }
  attributes #0 = { "amdgpu-flat-work-group-size"="1,64" "amdgpu-waves-per-eu"="1,1" }
...
---
name:            rigid_peak
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
  occupancy:       1
body:             |
  bb.0:
    %v0:vreg_1024_align2 = IMPLICIT_DEF
    %v1:vreg_1024_align2 = IMPLICIT_DEF
    %v2:vreg_1024_align2 = IMPLICIT_DEF
    %v3:vreg_1024_align2 = IMPLICIT_DEF
    %v4:vreg_1024_align2 = IMPLICIT_DEF
    %v5:vreg_1024_align2 = IMPLICIT_DEF
    %v6:vreg_1024_align2 = IMPLICIT_DEF
    %v7:vreg_1024_align2 = IMPLICIT_DEF
    %w:vgpr_32 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
    %t:vgpr_32 = V_MOV_B32_e32 0, implicit $exec, implicit %v0, implicit %v1, implicit %v2, implicit %v3, implicit %v4, implicit %v5, implicit %v6, implicit %v7, implicit %w
    %a0:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a1:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a2:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a3:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a4:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a5:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a6:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a7:av_1024_align2 = IMPLICIT_DEF implicit %t
    %a8:av_64_align2 = IMPLICIT_DEF implicit %t
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0, implicit %t, implicit %a0, implicit %a1, implicit %a2, implicit %a3, implicit %a4, implicit %a5, implicit %a6, implicit %a7, implicit %a8
...
