name:            v_xor_imm_zero_operand_to_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: v_xor_imm_zero_operand_to_copy
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG [[COPY1]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_XOR_B32_e32 0, %0, implicit $exec
