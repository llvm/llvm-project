    ; CHECK-LABEL: name: merge_second_src_is_first_dst_across_unrelated
    ; CHECK: liveins: $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr3 = V_MOV_B32_e32 $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr0 = V_PERM_B32_e64 $vgpr1, $vgpr1, 84148480, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr3
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr1_lo16, implicit $exec
    $vgpr3 = V_MOV_B32_e32 $vgpr2, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr0_lo16, implicit $exec
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr3
...

---
# Negative immediates are masked to 16 bits.
name: merge_second_src_is_first_dst_neg_imm
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: merge_second_src_is_first_dst_neg_imm
    ; CHECK: $vgpr0 = V_MOV_B32_e32 4294967295, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_lo16 = V_MOV_B16_t16_e32 -1, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr0_lo16, implicit $exec
    S_ENDPGM 0, implicit $vgpr0
...

---
# Negative on one half only: checks the other half's mask.
name: merge_both_imm_neg_lo
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: merge_both_imm_neg_lo
    ; CHECK: $vgpr0 = V_MOV_B32_e32 262143, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_lo16 = V_MOV_B16_t16_e32 -1, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 3, implicit $exec
    S_ENDPGM 0, implicit $vgpr0
...

---
# An SGPR forwards into both v_perm_b32 operands; one unique SGPR is legal.
name: merge_second_src_is_first_dst_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr2

    ; CHECK-LABEL: name: merge_second_src_is_first_dst_sgpr
    ; CHECK: liveins: $sgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr0 = V_PERM_B32_e64 $sgpr2, $sgpr2, 84148480, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $sgpr2, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr0_lo16, implicit $exec
    S_ENDPGM 0, implicit $vgpr0
...

---
# Forwarded source clobbered between the movs, but nothing reads $vgpr0, so
# the merge goes before the clobber.
name: merge_forwarded_src_clobbered_after
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr1

    ; CHECK-LABEL: name: merge_forwarded_src_clobbered_after
    ; CHECK: liveins: $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr0 = V_PERM_B32_e64 $vgpr1, $vgpr1, 84148480, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 7, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr1_lo16, implicit $exec
    $vgpr1 = V_MOV_B32_e32 7, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr0_lo16, implicit $exec
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
...

---
# Negative: forwarded source clobbered before a read of $vgpr0, so no
# insertion point works.
name: no_merge_forwarded_src_clobbered
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: no_merge_forwarded_src_clobbered
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr1_lo16, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 7, implicit $exec
    ; CHECK-NEXT: $vgpr2 = V_MOV_B32_e32 $vgpr0, implicit $exec
    ; CHECK-NEXT: $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr0_lo16, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1, implicit $vgpr2
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr1_lo16, implicit $exec
    $vgpr1 = V_MOV_B32_e32 7, implicit $exec
    $vgpr2 = V_MOV_B32_e32 $vgpr0, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr0_lo16, implicit $exec
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1, implicit $vgpr2
...

---
# The first mov reads the half the second writes; the merge reads before
# writing, so it is still correct.
name: merge_first_src_is_second_dst
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: merge_first_src_is_second_dst
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr0 = V_PERM_B32_e64 $vgpr1, $vgpr0, 84148994, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr0_hi16, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr1_lo16, implicit $exec
    S_ENDPGM 0, implicit $vgpr0
...

---
# Allow merging across a WWM exec region since the merged instruction doesn't land
# in there.
name: merge_across_wwm_exec_write
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr1, $sgpr105

    ; CHECK-LABEL: name: merge_across_wwm_exec_write
    ; CHECK: liveins: $vgpr1, $sgpr105
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr105 = S_OR_SAVEEXEC_B32 -1, implicit-def $exec, implicit-def dead $scc, implicit $exec
    ; CHECK-NEXT: $exec_lo = S_MOV_B32 $sgpr105
    ; CHECK-NEXT: $vgpr0 = V_PERM_B32_e64 $vgpr1, $vgpr1, 84148994, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr1_hi16, implicit $exec, implicit $exec
    $sgpr105 = S_OR_SAVEEXEC_B32 -1, implicit-def $exec, implicit-def dead $scc, implicit $exec
    $exec_lo = S_MOV_B32 $sgpr105
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr1_lo16, implicit $exec, implicit $exec
    S_ENDPGM 0, implicit $vgpr0
...

---
# Allow merging accross a WWM SGPR spill reload
name: merge_across_wwm_sgpr_spill_reload
tracksRegLiveness: true
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 4, alignment: 4 }
body:             |
  bb.0:
    liveins: $vgpr6, $vgpr8, $vgpr9, $vgpr10, $sgpr0, $sgpr105

    ; CHECK-LABEL: name: merge_across_wwm_sgpr_spill_reload
    ; CHECK: liveins: $vgpr6, $vgpr8, $vgpr9, $vgpr10, $sgpr0, $sgpr105
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr9_hi16 = V_CNDMASK_B16_t16_e64 0, 0, 0, killed $vgpr9_hi16, killed $sgpr0, 0, implicit $exec
    ; CHECK-NEXT: $sgpr0 = V_READLANE_B32 $vgpr10, 20
    ; CHECK-NEXT: $vgpr12_lo16 = V_MOV_B16_t16_e64 0, $vgpr9_hi16, 0, implicit $exec, implicit $exec
    ; CHECK-NEXT: $vgpr8_lo16 = V_CNDMASK_B16_t16_e64 0, 0, 0, killed $vgpr8_lo16, killed $sgpr0, 0, implicit $exec
    ; CHECK-NEXT: $sgpr0 = V_READLANE_B32 $vgpr10, 22
    ; CHECK-NEXT: $vgpr6_lo16 = V_CNDMASK_B16_t16_e64 0, 0, 0, killed $vgpr6_lo16, killed $sgpr0, 0, implicit $exec
    ; CHECK-NEXT: $sgpr105 = S_OR_SAVEEXEC_B32 -1, implicit-def $exec, implicit-def dead $scc, implicit $exec
    ; CHECK-NEXT: $vgpr11 = SCRATCH_LOAD_DWORD_ST 12, 0, implicit $exec, implicit $flat_scr :: ("amdgpu-thread-private" load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: $exec_lo = S_MOV_B32 $sgpr105
    ; CHECK-NEXT: $sgpr0 = V_READLANE_B32 $vgpr11, 3
    ; CHECK-NEXT: $vgpr13_hi16 = V_MOV_B16_t16_e32 $vgpr8_lo16, implicit $exec, implicit $exec
    ; CHECK-NEXT: $vgpr0 = V_PERM_B32_e64 $vgpr6, $vgpr6, 84148994, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr12, implicit $vgpr13
    $vgpr0_lo16 = V_MOV_B16_t16_e32 $vgpr6_hi16, implicit $exec, implicit $exec
    $vgpr9_hi16 = V_CNDMASK_B16_t16_e64 0, 0, 0, killed $vgpr9_hi16, killed $sgpr0, 0, implicit $exec
    $sgpr0 = V_READLANE_B32 $vgpr10, 20
    $vgpr12_lo16 = V_MOV_B16_t16_e64 0, $vgpr9_hi16, 0, implicit $exec, implicit $exec
    $vgpr8_lo16 = V_CNDMASK_B16_t16_e64 0, 0, 0, killed $vgpr8_lo16, killed $sgpr0, 0, implicit $exec
    $sgpr0 = V_READLANE_B32 $vgpr10, 22
    $vgpr6_lo16 = V_CNDMASK_B16_t16_e64 0, 0, 0, killed $vgpr6_lo16, killed $sgpr0, 0, implicit $exec
    $sgpr105 = S_OR_SAVEEXEC_B32 -1, implicit-def $exec, implicit-def dead $scc, implicit $exec
    $vgpr11 = SCRATCH_LOAD_DWORD_ST 12, 0, implicit $exec, implicit $flat_scr :: ("amdgpu-thread-private" load (s32) from %stack.0, addrspace 5)
    $exec_lo = S_MOV_B32 $sgpr105
    $sgpr0 = V_READLANE_B32 $vgpr11, 3
    $vgpr13_hi16 = V_MOV_B16_t16_e32 $vgpr8_lo16, implicit $exec, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 $vgpr6_lo16, implicit $exec, implicit $exec
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr12, implicit $vgpr13
...
