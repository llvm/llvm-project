    $vgpr0_lo16 = V_MOV_B16_t16_e64 0, $vgpr128_hi16, 0, implicit $exec
    $vgpr0_hi16 = V_MOV_B16_t16_e32 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr0
...

