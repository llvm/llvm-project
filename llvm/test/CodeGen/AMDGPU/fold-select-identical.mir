# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -run-pass=si-fold-operands -o - %s | FileCheck %s

# A select whose two sources are the same value is folded into a copy or move.

---
name:            s_cselect_b32_same_reg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2
    ; CHECK-LABEL: name: s_cselect_b32_same_reg
    ; CHECK: liveins: $sgpr0, $sgpr1, $sgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr2
    ; CHECK-NEXT: S_CMP_EQ_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:sreg_32 = COPY [[COPY2]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[COPY3]]
    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    %2:sreg_32 = COPY $sgpr2
    S_CMP_EQ_U32 %0, %1, implicit-def $scc
    %3:sreg_32 = S_CSELECT_B32 %2, %2, implicit $scc
    S_ENDPGM 0, implicit %3
...

---
name:            s_cselect_b32_same_imm
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr0, $sgpr1
    ; CHECK-LABEL: name: s_cselect_b32_same_imm
    ; CHECK: liveins: $sgpr0, $sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; CHECK-NEXT: S_CMP_EQ_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 16
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[S_MOV_B32_]]
    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    S_CMP_EQ_U32 %0, %1, implicit-def $scc
    %2:sreg_32 = S_CSELECT_B32 16, 16, implicit $scc
    S_ENDPGM 0, implicit %2
...

# The two sources are different registers which hold the same immediate.
---
name:            s_cselect_b32_same_materialized_imm
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr0, $sgpr1
    ; CHECK-LABEL: name: s_cselect_b32_same_materialized_imm
    ; CHECK: liveins: $sgpr0, $sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; CHECK-NEXT: S_CMP_EQ_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; CHECK-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 12345
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[S_MOV_B32_]]
    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    %2:sreg_32 = S_MOV_B32 12345
    %3:sreg_32 = S_MOV_B32 12345
    S_CMP_EQ_U32 %0, %1, implicit-def $scc
    %4:sreg_32 = S_CSELECT_B32 %2, %3, implicit $scc
    S_ENDPGM 0, implicit %4
...

---
name:            s_cselect_b32_different_imm
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr0, $sgpr1
    ; CHECK-LABEL: name: s_cselect_b32_different_imm
    ; CHECK: liveins: $sgpr0, $sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; CHECK-NEXT: S_CMP_EQ_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 16, 17, implicit $scc
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[S_CSELECT_B32_]]
    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    S_CMP_EQ_U32 %0, %1, implicit-def $scc
    %2:sreg_32 = S_CSELECT_B32 16, 17, implicit $scc
    S_ENDPGM 0, implicit %2
...

