; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=amdgpu12.50-amd-amdhsa -mattr=+real-true16 < %s | FileCheck %s

; An f16 value merged by a PHI across a wave-uniform branch is held in a 32-bit
; register, and the true16 fcopysign pattern feeds it to a REG_SEQUENCE lo16
; slot. DetectDeadLanes used to treat that as a lane-for-lane transfer and mark
; the value produced in %big dead, deleting the whole block.

define amdgpu_kernel void @uniform_f16_phi_copysign(half %x, ptr addrspace(1) %out) {
; CHECK-LABEL: uniform_f16_phi_copysign:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_setreg_imm32_b32 hwreg(HW_REG_WAVE_MODE, 25, 1), 1 ; msbs: dst=0 src0=0 src1=0 src2=0
; CHECK-NEXT:    s_mov_b64 s[64:65], 0
; CHECK-NEXT:    v_nop
; CHECK-NEXT:    global_prefetch_b8 v0, s[64:65] scope:SCOPE_SE
; CHECK-NEXT:    s_load_b32 s0, s[4:5], 0x0 nv
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_cmp_nle_f16 s0, 0x3800
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %small
; CHECK-NEXT:    s_mul_f16 s1, s0, s0
; CHECK-NEXT:    s_mov_b32 s2, 0
; CHECK-NEXT:    s_branch .LBB0_3
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    s_mov_b32 s2, -1
; CHECK-NEXT:    ; implicit-def: $sgpr1
; CHECK-NEXT:  .LBB0_3: ; %Flow
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_1) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_b32 s2, s2, exec_lo
; CHECK-NEXT:    s_cselect_b32 s2, 1, 0
; CHECK-NEXT:    s_cmp_lg_u32 s2, 1
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_5
; CHECK-NEXT:  ; %bb.4: ; %big
; CHECK-NEXT:    s_cvt_f32_f16 s1, s0
; CHECK-NEXT:    v_mov_b32_e32 v0, 0.5
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_2) | instskip(SKIP_1) | instid1(TRANS32_DEP_1)
; CHECK-NEXT:    v_s_sqrt_f32 s1, s1
; CHECK-NEXT:    v_nop
; CHECK-NEXT:    v_fma_mixlo_f16 v0, s1, s0, v0 op_sel_hi:[0,1,0]
; CHECK-NEXT:    s_branch .LBB0_6
; CHECK-NEXT:  .LBB0_5:
; CHECK-NEXT:    v_mov_b32_e32 v0, s1
; CHECK-NEXT:  .LBB0_6: ; %exit
; CHECK-NEXT:    s_load_b64 s[2:3], s[4:5], 0x8 nv
; CHECK-NEXT:    v_mov_b16_e32 v1.l, s0
; CHECK-NEXT:    v_mov_b32_e32 v2, 0
; CHECK-NEXT:    s_delay_alu instid0(VALU_DEP_2)
; CHECK-NEXT:    v_bfi_b32 v0, 0x7fff, v0, v1
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    global_store_b16 v2, v0, s[2:3]
; CHECK-NEXT:    s_endpgm
entry:
  %c = fcmp ugt half %x, 0xH3800
  br i1 %c, label %big, label %small

small:
  %s = fmul half %x, %x
  br label %exit

big:
  %e = fpext half %x to float
  %q = call float @llvm.amdgcn.sqrt.f32(float %e)
  %m = call float @llvm.fmuladd.f32(float %q, float %e, float 5.000000e-01)
  %t = fptrunc float %m to half
  br label %exit

exit:
  %p = phi half [ %s, %small ], [ %t, %big ]
  %r = call half @llvm.copysign.f16(half %p, half %x)
  store half %r, ptr addrspace(1) %out
  ret void
}
