# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu10.10 -run-pass=si-optimize-exec-masking-pre-ra %s -o - | FileCheck %s

---
name: exec_clobber
isSSA: false
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: exec_clobber
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:sreg_32_xm0_xexec = IMPLICIT_DEF
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32_xm0_xexec = COPY $exec_lo
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 0
  ; CHECK-NEXT:   [[S_XOR_B32_:%[0-9]+]]:sreg_32_xm0_xexec = S_XOR_B32 [[DEF]], [[COPY]], implicit-def dead $scc
  ; CHECK-NEXT:   $vcc_lo = COPY [[S_XOR_B32_]]
  ; CHECK-NEXT:   S_CBRANCH_VCCNZ %bb.1, implicit $vcc_lo
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2

    %0:sreg_32_xm0_xexec = IMPLICIT_DEF
    %1:sreg_32_xm0_xexec = COPY $exec_lo
    $exec_lo = S_MOV_B32 0
    %2:sreg_32_xm0_xexec = S_XOR_B32 %0, %1, implicit-def dead $scc
    $vcc_lo = COPY %2
    S_CBRANCH_VCCNZ %bb.1, implicit $vcc
    S_BRANCH %bb.2

  bb.1:
    S_ENDPGM 0

  bb.2:
    S_ENDPGM 0
...
