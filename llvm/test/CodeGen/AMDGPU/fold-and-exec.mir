# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-fold-operands -o - %s | FileCheck %s

# A V_CMP already writes 0 to the bits of inactive lanes, so ANDing its result
# with EXEC is a no-op.

---
name: vcmp_e64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: vcmp_e64
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: $vcc = COPY [[V_CMP_LT_I32_e64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    %1:sreg_64_xexec = S_AND_B64 $exec, %0, implicit-def dead $scc
    $vcc = COPY %1
    S_ENDPGM 0, implicit $vcc
...

# The AND is commutative, so EXEC may be either operand.
---
name: vcmp_e64_commuted
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: vcmp_e64_commuted
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: $vcc = COPY [[V_CMP_LT_I32_e64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    %1:sreg_64_xexec = S_AND_B64 %0, $exec, implicit-def dead $scc
    $vcc = COPY %1
    S_ENDPGM 0, implicit $vcc
...

# V_CMP_CLASS is not marked isCompare, but is still a VOPC.
---
name: vcmp_class
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: vcmp_class
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_CLASS_F32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_CLASS_F32_e64 0, $vgpr0, 3, implicit $exec
    ; CHECK-NEXT: $vcc = COPY [[V_CMP_CLASS_F32_e64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_CLASS_F32_e64 0, $vgpr0, 3, implicit $exec
    %1:sreg_64_xexec = S_AND_B64 $exec, %0, implicit-def dead $scc
    $vcc = COPY %1
    S_ENDPGM 0, implicit $vcc
...

# Bitwise combinations of lane masks are still masked by EXEC.
---
name: and_or_xor_tree
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: and_or_xor_tree
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_1:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr1, $vgpr2, implicit $exec
    ; CHECK-NEXT: [[S_OR_B64_:%[0-9]+]]:sreg_64_xexec = S_OR_B64 [[V_CMP_LT_I32_e64_]], [[V_CMP_LT_I32_e64_1]], implicit-def dead $scc
    ; CHECK-NEXT: [[S_XOR_B64_:%[0-9]+]]:sreg_64_xexec = S_XOR_B64 [[S_OR_B64_]], [[V_CMP_LT_I32_e64_]], implicit-def dead $scc
    ; CHECK-NEXT: $vcc = COPY [[S_XOR_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    %1:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr1, $vgpr2, implicit $exec
    %2:sreg_64_xexec = S_OR_B64 %0, %1, implicit-def dead $scc
    %3:sreg_64_xexec = S_XOR_B64 %2, %0, implicit-def dead $scc
    %4:sreg_64_xexec = S_AND_B64 $exec, %3, implicit-def dead $scc
    $vcc = COPY %4
    S_ENDPGM 0, implicit $vcc
...

# S_AND only needs one of its operands to be masked by EXEC.
---
name: and_one_masked_operand
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1
    ; CHECK-LABEL: name: and_one_masked_operand
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0_sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: [[S_AND_B64_:%[0-9]+]]:sreg_64_xexec = S_AND_B64 [[V_CMP_LT_I32_e64_]], $sgpr0_sgpr1, implicit-def dead $scc
    ; CHECK-NEXT: $vcc = COPY [[S_AND_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    %1:sreg_64_xexec = S_AND_B64 %0, $sgpr0_sgpr1, implicit-def dead $scc
    %2:sreg_64_xexec = S_AND_B64 $exec, %1, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# The AND may write a physical register, as inserted by moveToVALU.
---
name: physreg_dst
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: physreg_dst
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: $vcc = COPY [[V_CMP_LT_I32_e64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    $vcc = S_AND_B64 $exec, %0, implicit-def dead $scc
    S_ENDPGM 0, implicit $vcc
...

