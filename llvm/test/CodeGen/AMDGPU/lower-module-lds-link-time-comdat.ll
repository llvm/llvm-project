; RUN: opt -S -mtriple=amdgpu9.00-amd-amdhsa -passes=amdgpu-lower-module-lds -amdgpu-enable-object-linking < %s | FileCheck %s

; With object linking, LDS lowering converts global-scope LDS to external
; declarations. LDS with vague linkage, for example a static __shared__ variable
; in an inline function, is in a comdat, and a declaration cannot be in a
; comdat. The declaration must not keep the comdat.

$lds = comdat any

@lds = linkonce_odr addrspace(3) global [4 x i32] poison, comdat, align 4

