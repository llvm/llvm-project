    ; GFX908-NEXT: frame-setup CFI_INSTRUCTION undefined $agpr0
    ; GFX908-NEXT: frame-setup CFI_INSTRUCTION undefined $agpr1
    ; GFX908-NEXT: frame-setup CFI_INSTRUCTION undefined $agpr2
    ; GFX908-NEXT: frame-setup CFI_INSTRUCTION undefined $agpr3
    ; GFX908-NEXT: $agpr0_64 = IMPLICIT_DEF
    ; GFX908-NEXT: $vgpr1 = V_ACCVGPR_READ_B32_e64 killed $agpr0, implicit $exec, implicit-def $agpr0_64, implicit $agpr0_64
    ; GFX908-NEXT: $vgpr0 = V_ACCVGPR_READ_B32_e64 killed $agpr1, implicit $exec, implicit killed $agpr0_64
    ; GFX908-NEXT: $agpr0 = V_ACCVGPR_WRITE_B32_e64 $vgpr1, implicit $exec, implicit-def $agpr0_64
    ; GFX908-NEXT: $agpr1 = V_ACCVGPR_WRITE_B32_e64 $vgpr0, implicit $exec, implicit $agpr0_64
    ; GFX908-NEXT: $agpr3 = V_ACCVGPR_WRITE_B32_e64 $vgpr0, implicit $exec, implicit $agpr0_64
