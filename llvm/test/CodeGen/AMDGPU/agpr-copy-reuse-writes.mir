  - { id: 0, name: '', type: spill-slot, offset: 0, size: 8, alignment: 4 }
machineFunctionInfo:
  scratchRSrcReg:  $sgpr0_128
  stackPtrOffsetReg: '$sgpr32'
  hasSpilledVGPRs: true
