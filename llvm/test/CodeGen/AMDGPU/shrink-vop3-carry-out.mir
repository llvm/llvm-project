# GCN-LABEL: name: shrink_addc_undef_vcc{{$}}
# GCN: %14:vgpr_32 = V_ADDC_U32_e32 %13, %12, implicit-def $vcc, implicit undef $vcc, implicit $exec
# GCN: %15:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, killed $vcc, implicit $exec
