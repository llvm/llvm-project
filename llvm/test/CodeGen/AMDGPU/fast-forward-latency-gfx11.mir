# RUN: llc -mtriple=amdgpu11.00 -run-pass=postmisched %s -o /dev/null -debug-only=machine-scheduler 2>&1 | FileCheck -check-prefixes=CHECK,FF %s
# RUN: llc -mtriple=amdgpu12.00 -run-pass=postmisched %s -o /dev/null -debug-only=machine-scheduler 2>&1 | FileCheck -check-prefixes=CHECK,NOFF %s
# RUN: llc -mtriple=amdgpu12.50 -run-pass=postmisched %s -o /dev/null -debug-only=machine-scheduler 2>&1 | FileCheck -check-prefixes=CHECK,FF %s
# REQUIRES: asserts

# Check the scheduling latency of dependencies through a lane mask or carry
# SGPR from a VALU fast forward producer to a VALU fast forward consumer in
# wave32. GFX12.0 has a hazard between VALU SGPR producers and consumers, so the
# latency is not reduced there.

# CHECK-LABEL: # Machine code for function vopc_e32_to_cndmask_e32:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_e32
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$vcc_lo{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$vcc_lo{{$}}
---
name: vopc_e32_to_cndmask_e32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    V_CMP_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $vcc, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e32 $vgpr3, $vgpr4, implicit $vcc, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

# CHECK-LABEL: # Machine code for function vopc_e64_to_cndmask_e64:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$sgpr0{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0{{$}}
---
name: vopc_e64_to_cndmask_e64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    $sgpr0 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e64 0, $vgpr3, 0, $vgpr4, $sgpr0, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

# CHECK-LABEL: # Machine code for function vopc_e64_to_cndmask_e64_dpp:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_e64_dpp
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$sgpr0{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0{{$}}
---
name: vopc_e64_to_cndmask_e64_dpp
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4
    $sgpr0 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e64_dpp $vgpr2, 0, $vgpr3, 0, $vgpr4, $sgpr0, 1, 15, 15, 1, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

# CHECK-LABEL: # Machine code for function vopc_e64_to_cndmask_b16_t16:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B16_t16_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
