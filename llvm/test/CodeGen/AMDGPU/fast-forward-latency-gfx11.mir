# CHECK-LABEL: # Machine code for function carry_e64_chain:
# CHECK:       SU(1): {{.*}}V_ADDC_U32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$sgpr0{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0{{$}}
# CHECK:       SU(2): {{.*}}V_SUBB_U32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(1): Data Latency=0 Reg=$sgpr1{{$}}
# NOFF:           SU(1): Data Latency={{[1-9][0-9]*}} Reg=$sgpr1{{$}}
# CHECK:       SU(3): {{.*}}V_SUBBREV_U32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(2): Data Latency=0 Reg=$sgpr2{{$}}
# NOFF:           SU(2): Data Latency={{[1-9][0-9]*}} Reg=$sgpr2{{$}}
---
name: carry_e64_chain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    $vgpr2, $sgpr0 = V_ADD_CO_U32_e64 $vgpr0, $vgpr1, 0, implicit $exec
    $vgpr3, $sgpr1 = V_ADDC_U32_e64 $vgpr0, $vgpr1, $sgpr0, 0, implicit $exec
    $vgpr4, $sgpr2 = V_SUBB_U32_e64 $vgpr0, $vgpr1, $sgpr1, 0, implicit $exec
    $vgpr5, $sgpr3 = V_SUBBREV_U32_e64 $vgpr0, $vgpr1, $sgpr2, 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr2, implicit $vgpr3, implicit $vgpr4, implicit $vgpr5, implicit $sgpr3
...

# V_MAD_U64_U32_gfx11 is never a fast forward producer.
# CHECK-LABEL: # Machine code for function mad_u64_u32_gfx11_to_addc_e64:
# CHECK:       SU(1): {{.*}}V_ADDC_U32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# CHECK:          SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0{{$}}
---
name: mad_u64_u32_gfx11_to_addc_e64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr4_vgpr5
    early-clobber $vgpr2_vgpr3, $sgpr0 = V_MAD_U64_U32_gfx11_e64 $vgpr0, $vgpr1, $vgpr4_vgpr5, 0, implicit $exec
    $vgpr6, $sgpr1 = V_ADDC_U32_e64 $vgpr0, $vgpr1, $sgpr0, 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr2_vgpr3, implicit $vgpr6, implicit $sgpr1
...

# The V_CMP result is used as a data operand of the V_CNDMASK, not as its
# mask, so this is not a fast forward case.
# CHECK-LABEL: # Machine code for function not_mask_operand:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# CHECK:          SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0{{$}}
---
name: not_mask_operand
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr4, $sgpr1
    $sgpr0 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e64 0, $sgpr0, 0, $vgpr4, $sgpr1, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...
