---
name: vopc_e64_to_cndmask_b16_t16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    $sgpr0 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    $vgpr2_lo16 = V_CNDMASK_B16_t16_e64 0, $vgpr3_lo16, 0, $vgpr4_lo16, $sgpr0, 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr2_lo16
...

