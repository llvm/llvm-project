    %1:sreg_64 = S_OR_SAVEEXEC_B64 undef %0:sreg_64, implicit-def $exec, implicit-def dead $scc, implicit $exec
    %2:sreg_64 = S_AND_B64 $exec, %1, implicit-def dead $scc
    $exec = S_XOR_B64_term $exec, %2, implicit-def dead $scc
