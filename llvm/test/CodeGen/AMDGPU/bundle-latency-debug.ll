; RUN: llc -mtriple=amdgpu9.00-amd-amdhsa < %s | FileCheck %s
; RUN: opt -passes=strip-nonlinetable-debuginfo < %s | llc -mtriple=amdgpu9.00-amd-amdhsa | FileCheck %s

; The two RUN lines intentionally share a check prefix. The post-RA bundler
; keeps the DBG_VALUE of %p inside the bundle of the two kernel argument loads.
; It must not add to the latency of the bundle and change the post-RA schedule.

declare hidden void @sink()

define amdgpu_kernel void @k(ptr addrspace(1) %p, i32 %a) !dbg !4 {
; CHECK-LABEL: k:
; CHECK:  ; %bb.0:
; CHECK:    s_add_u32 flat_scratch_lo, s12, s17
; CHECK:    s_addc_u32 flat_scratch_hi, s13, 0
; CHECK:    s_add_u32 s0, s0, s17
; CHECK:    s_load_dwordx2 s[34:35], s[8:9], 0x0
; CHECK:    s_load_dword s33, s[8:9], 0x8
; CHECK:    s_addc_u32 s1, s1, 0
; CHECK:    s_add_u32 s8, s8, 16
; CHECK:    s_addc_u32 s9, s9, 0
; CHECK:    v_lshlrev_b32_e32 v2, 20, v2
; CHECK:    v_lshlrev_b32_e32 v1, 10, v1
; CHECK:    s_mov_b32 s13, s15
; CHECK:    s_mov_b32 s12, s14
; CHECK:    s_getpc_b64 s[18:19]
; CHECK:    s_add_u32 s18, s18, sink@rel32@lo+4
; CHECK:    s_addc_u32 s19, s19, sink@rel32@hi+12
; CHECK:    v_or3_b32 v31, v0, v1, v2
; CHECK:    s_mov_b32 s14, s16
; CHECK:    s_mov_b32 s32, 0
; CHECK:    v_mov_b32_e32 v40, 0
; CHECK:    s_swappc_b64 s[30:31], s[18:19]
; CHECK:    v_mov_b32_e32 v0, s33
; CHECK:    global_store_dword v40, v0, s[34:35]
; CHECK:    s_endpgm
  #dbg_value(ptr addrspace(1) %p, !5, !DIExpression(), !7)
  call void @sink()
  store i32 %a, ptr addrspace(1) %p, align 4
  ret void
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2}

!0 = distinct !DICompileUnit(language: DW_LANG_OpenCL, file: !1, emissionKind: FullDebug)
!1 = !DIFile(filename: "t.cl", directory: "/")
!2 = !{i32 2, !"Debug Info Version", i32 3}
!3 = !DISubroutineType(types: !{})
!4 = distinct !DISubprogram(name: "k", scope: !1, file: !1, line: 1, type: !3, spFlags: DISPFlagDefinition, unit: !0)
!5 = !DILocalVariable(name: "p", arg: 1, scope: !4, file: !1, line: 1, type: !6)
