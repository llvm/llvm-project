# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.00 -run-pass=amdgpu-mark-last-scratch-load -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu12.00 -passes=amdgpu-mark-last-scratch-load -verify-machineinstrs -o - %s | FileCheck %s

# Spill slot liveness is tracked in dwords: a load reads every dword it touches,
# a store only kills the dwords it fully overwrites. Callee-saved slots and
# non-spill stack objects are ignored.
---
name: slot_units
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 8, alignment: 4 }
  - { id: 2, type: spill-slot, size: 2, alignment: 2 }
  - { id: 3, type: spill-slot, size: 4, alignment: 4, callee-saved-register: '$vgpr40' }
  - { id: 4, type: default, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2

    ; CHECK-LABEL: name: slot_units
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SCRATCH_STORE_DWORDX2_ST $vgpr0_vgpr1, 4, 0, implicit $exec, implicit $flat_scr :: (store (s64) into %stack.1, addrspace 5)
    ; CHECK-NEXT: SCRATCH_STORE_SHORT_ST $vgpr2, 12, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.2, addrspace 5)
    ; CHECK-NEXT: $vgpr3 = SCRATCH_LOAD_DWORD_ST 8, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1 + 4, addrspace 5)
    ; CHECK-NEXT: $vgpr4 = SCRATCH_LOAD_USHORT_ST 12, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s16) from %stack.2, addrspace 5)
    ; CHECK-NEXT: $vgpr5_vgpr6 = SCRATCH_LOAD_DWORDX2_ST 4, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s64) from %stack.1, addrspace 5)
    ; CHECK-NEXT: $vgpr7 = SCRATCH_LOAD_DWORD_ST 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr8 = SCRATCH_LOAD_DWORD_ST 16, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.3, addrspace 5)
    ; CHECK-NEXT: $vgpr9 = SCRATCH_LOAD_DWORD_ST 20, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.4, addrspace 5)
    ; CHECK-NEXT: S_ENDPGM 0
    SCRATCH_STORE_DWORDX2_ST $vgpr0_vgpr1, 4, 0, implicit $exec, implicit $flat_scr :: (store (s64) into %stack.1, addrspace 5)
    SCRATCH_STORE_SHORT_ST $vgpr2, 12, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.2, addrspace 5)
    $vgpr3 = SCRATCH_LOAD_DWORD_ST 8, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1 + 4, addrspace 5)
    $vgpr4 = SCRATCH_LOAD_USHORT_ST 12, 0, implicit $exec, implicit $flat_scr :: (load (s16) from %stack.2, addrspace 5)
    $vgpr5_vgpr6 = SCRATCH_LOAD_DWORDX2_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s64) from %stack.1, addrspace 5)
    $vgpr7 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    $vgpr8 = SCRATCH_LOAD_DWORD_ST 16, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.3, addrspace 5)
    $vgpr9 = SCRATCH_LOAD_DWORD_ST 20, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.4, addrspace 5)
    S_ENDPGM 0
...

# fi#0 is reloaded in both arms; fi#1 in bb.1 and again in bb.3.
---
name: diamond
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: diamond
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.1, addrspace 5)
  ; CHECK-NEXT:   S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.1, addrspace 5)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $sgpr0

    SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    SCRATCH_STORE_DWORD_ST $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.1, addrspace 5)
    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)

  bb.3:
    $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)
    S_ENDPGM 0
...

# The loop header reloads fi#0 on every iteration, so it is never a last use.
# The latch has no accesses and only sees fi#0 live through the back edge.
---
name: loop
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.1, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.1, addrspace 5)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    SCRATCH_STORE_DWORD_ST $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.1, addrspace 5)

  bb.1:
    successors: %bb.2
    liveins: $sgpr0

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)

  bb.2:
    successors: %bb.1, %bb.3
    liveins: $sgpr0

    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.3:
    $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)
    S_ENDPGM 0
...

# The slot is overwritten at the top of every iteration, so the reload at the
# bottom is a last use even inside the loop.
---
name: loop_store
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: loop_store
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   $vgpr0 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   $vgpr0 = SCRATCH_LOAD_DWORD_ST 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $sgpr0

    SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    $vgpr0 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2:
    S_ENDPGM 0
...

# Straight-line blocks followed by nested loops. fi#0, reloaded by the outer
# header (bb.2), only reaches the inner loop (bb.3, bb.4) through the outer back
# edge, so the inner blocks must be recomputed after bb.2. fi#3 is overwritten
# at the top of every outer iteration, so its reload in the outer latch (bb.5)
# is a last use.
---
name: nested_loops
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 4, alignment: 4 }
  - { id: 2, type: spill-slot, size: 4, alignment: 4 }
  - { id: 3, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: nested_loops
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.1, addrspace 5)
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 8, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.2, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 12, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.3, addrspace 5)
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.3, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.6(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 12, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.3, addrspace 5)
  ; CHECK-NEXT:   S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 8, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.2, addrspace 5)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    SCRATCH_STORE_DWORD_ST $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.1, addrspace 5)
    SCRATCH_STORE_DWORD_ST $vgpr0, 8, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.2, addrspace 5)

  bb.1:
    successors: %bb.2
    liveins: $vgpr0, $sgpr0

  bb.2:
    successors: %bb.3
    liveins: $vgpr0, $sgpr0

    SCRATCH_STORE_DWORD_ST $vgpr0, 12, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.3, addrspace 5)
    $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)

  bb.3:
    successors: %bb.4
    liveins: $vgpr0, $sgpr0

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)

  bb.4:
    successors: %bb.5, %bb.3
    liveins: $vgpr0, $sgpr0

    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.5:
    successors: %bb.6, %bb.2
    liveins: $vgpr0, $sgpr0

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 12, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.3, addrspace 5)
    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.6:
    $vgpr1 = SCRATCH_LOAD_DWORD_ST 8, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.2, addrspace 5)
    S_ENDPGM 0
...

# Divergent if/else: the wave executes both arms, so the reload in the first arm
# (bb.1) is not a last use.
---
name: divergent_if_else
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: divergent_if_else
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   $sgpr1 = S_AND_SAVEEXEC_B32 $sgpr0, implicit-def $exec, implicit-def $scc, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.2, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr1 = S_ANDN2_SAVEEXEC_B32 $sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.4, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $sgpr0

    SCRATCH_STORE_DWORD_ST $vgpr0, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    $sgpr1 = S_AND_SAVEEXEC_B32 $sgpr0, implicit-def $exec, implicit-def $scc, implicit $exec
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    successors: %bb.2
    liveins: $sgpr1

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)

  bb.2:
    successors: %bb.3, %bb.4
    liveins: $sgpr1

    $sgpr1 = S_ANDN2_SAVEEXEC_B32 $sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    S_CBRANCH_EXECZ %bb.4, implicit $exec

  bb.3:
    successors: %bb.4

    $vgpr1 = SCRATCH_LOAD_DWORD_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)

  bb.4:
    S_ENDPGM 0
...
