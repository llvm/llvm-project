# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa --stress-regalloc=2 -start-before=greedy -stop-after=virt-reg-rewriter -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s

# A spill of the destination of a sub-register copy can be folded into the
# copy, which turns it into a spill of the copy source. That is not possible
# when the source is undef: there is nothing to store, and the register read
# may have no definition at all. %0.sub1 below is never defined, so the copy
# has to be left alone - the spill of %1 then stores the copy result like any
# other value.

---
name:            spill_fold_undef_subreg_copy
tracksRegLiveness: true
body:             |
  bb.0:
    ; GCN-LABEL: name: spill_fold_undef_subreg_copy
    ; GCN: renamable $sgpr2 = S_MOV_B32 1
    ; GCN-NEXT: renamable $sgpr0 = COPY undef renamable $sgpr3
    ; GCN-NEXT: SI_SPILL_S32_SAVE killed renamable $sgpr0, %stack.0, 0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; GCN-NEXT: renamable $sgpr0 = S_MOV_B32 2
    ; GCN-NEXT: renamable $sgpr0 = S_ADD_I32 killed renamable $sgpr0, 1, implicit-def dead $scc
    ; GCN-NEXT: renamable $sgpr1 = S_ADD_I32 renamable $sgpr0, 1, implicit-def dead $scc
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr1
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr2
    ; GCN-NEXT: renamable $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $sgpr0
    ; GCN-NEXT: S_ENDPGM 0
    undef %0.sub0:sreg_64 = S_MOV_B32 1
    %1:sreg_32 = COPY undef %0.sub1
    %2:sreg_32 = S_MOV_B32 2
    %3:sreg_32 = S_ADD_I32 %2, 1, implicit-def dead $scc
    %4:sreg_32 = S_ADD_I32 %3, 1, implicit-def dead $scc
    S_NOP 0, implicit %3
    S_NOP 0, implicit %4
    S_NOP 0, implicit %0.sub0
    S_NOP 0, implicit %1
    S_ENDPGM 0
...
