; Test that GCN trackers correctly track physical register pressure from inline asm

; A single physical def copied straight to a virtual register only changes the
; LSGPR weight.

; GCN-DEBUG-LABEL: test_single_physreg
; GCN-DEBUG: Region register pressure: VGPRs: 1 AGPRs: 0, SGPRs: 5, LVGPR WT: 0, LSGPR WT: 5
; GCN-DEBUG: Pressure after scheduling: VGPRs: 1 AGPRs: 0, SGPRs: 5, LVGPR WT: 0, LSGPR WT: 5

; GENERIC-DEBUG-LABEL: test_single_physreg
; GENERIC-DEBUG: Region register pressure: VGPRs: 1 AGPRs: 0, SGPRs: 5, LVGPR WT: 0, LSGPR WT: 5
; GENERIC-DEBUG: Pressure after scheduling: VGPRs: 1 AGPRs: 0, SGPRs: 5, LVGPR WT: 0, LSGPR WT: 5

; GCN-NOPHYS-DEBUG-LABEL: test_single_physreg
; GCN-NOPHYS-DEBUG: Region register pressure: VGPRs: 1 AGPRs: 0, SGPRs: 5, LVGPR WT: 0, LSGPR WT: 4
; GCN-NOPHYS-DEBUG: Pressure after scheduling: VGPRs: 1 AGPRs: 0, SGPRs: 5, LVGPR WT: 0, LSGPR WT: 4

define amdgpu_kernel void @test_single_physreg(ptr addrspace(1) %out) {
; CHECK-LABEL: test_single_physreg:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x9
; CHECK-NEXT:    s_mov_b32 s3, 0xf000
; CHECK-NEXT:    s_mov_b32 s2, -1
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    s_mov_b32 s10, 0
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    v_mov_b32_e32 v0, s10
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    buffer_store_dword v0, off, s[0:3], 0
; CHECK-NEXT:    s_endpgm
entry:
  %val = call i32 asm sideeffect "s_mov_b32 $0, 0", "={s10}"()
  store i32 %val, ptr addrspace(1) %out
  ret void
}

; Clobbered physical registers are dead defs with no virtual copy, so they only
; add pressure when physical registers are tracked: 8 + 4 SGPRs at the clobber.

; GCN-DEBUG-LABEL: test_live_across_clobber
; GCN-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 12, LVGPR WT: 0, LSGPR WT: 12
; GCN-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 12, LVGPR WT: 0, LSGPR WT: 12

; GENERIC-DEBUG-LABEL: test_live_across_clobber
; GENERIC-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 12, LVGPR WT: 0, LSGPR WT: 12
; GENERIC-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 12, LVGPR WT: 0, LSGPR WT: 12

; GCN-NOPHYS-DEBUG-LABEL: test_live_across_clobber
; GCN-NOPHYS-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 8, LVGPR WT: 0, LSGPR WT: 8
; GCN-NOPHYS-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 8, LVGPR WT: 0, LSGPR WT: 8

define amdgpu_kernel void @test_live_across_clobber() {
; CHECK-LABEL: test_live_across_clobber:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def s[0:7]
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; clobber
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; use s[0:7]
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    s_endpgm
entry:
  %v = call <8 x i32> asm sideeffect "; def $0", "=s"()
  call void asm sideeffect "; clobber", "~{s10},~{s11},~{s12},~{s13}"()
  call void asm sideeffect "; use $0", "s"(<8 x i32> %v)
  ret void
}

; The unused s11 output is a dead physical def, so with physical tracking the
; peak at the asm is 8 + s10 + s11 rather than 8 + the copy of s10.

; GCN-DEBUG-LABEL: test_live_across_dead_physreg_def
; GCN-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 10, LVGPR WT: 0, LSGPR WT: 10
; GCN-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 10, LVGPR WT: 0, LSGPR WT: 10

; GENERIC-DEBUG-LABEL: test_live_across_dead_physreg_def
; GENERIC-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 10, LVGPR WT: 0, LSGPR WT: 10
; GENERIC-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 10, LVGPR WT: 0, LSGPR WT: 10

; GCN-NOPHYS-DEBUG-LABEL: test_live_across_dead_physreg_def
; GCN-NOPHYS-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 9, LVGPR WT: 0, LSGPR WT: 8
; GCN-NOPHYS-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 9, LVGPR WT: 0, LSGPR WT: 8

define amdgpu_kernel void @test_live_across_dead_physreg_def() {
; CHECK-LABEL: test_live_across_dead_physreg_def:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def s[0:7]
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def s10, s11
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; use s[0:7], s10
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    s_endpgm
entry:
  %v = call <8 x i32> asm sideeffect "; def $0", "=s"()
  %r = call { i32, i32 } asm sideeffect "; def $0, $1", "={s10},={s11}"()
  %r0 = extractvalue { i32, i32 } %r, 0
  call void asm sideeffect "; use $0, $1", "s,s"(<8 x i32> %v, i32 %r0)
  ret void
}

; The early-clobber s[10:11] def overlaps its s12 input, so with physical
; tracking the peak at the asm is 8 + 2 + 1 SGPRs.

; GCN-DEBUG-LABEL: test_live_across_early_clobber_tuple
; GCN-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 11, LVGPR WT: 0, LSGPR WT: 11
; GCN-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 11, LVGPR WT: 0, LSGPR WT: 11

; GENERIC-DEBUG-LABEL: test_live_across_early_clobber_tuple
; GENERIC-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 11, LVGPR WT: 0, LSGPR WT: 11
; GENERIC-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 11, LVGPR WT: 0, LSGPR WT: 11

; GCN-NOPHYS-DEBUG-LABEL: test_live_across_early_clobber_tuple
; GCN-NOPHYS-DEBUG: Region register pressure: VGPRs: 0 AGPRs: 0, SGPRs: 10, LVGPR WT: 0, LSGPR WT: 10
; GCN-NOPHYS-DEBUG: Pressure after scheduling: VGPRs: 0 AGPRs: 0, SGPRs: 10, LVGPR WT: 0, LSGPR WT: 10

define amdgpu_kernel void @test_live_across_early_clobber_tuple() {
; CHECK-LABEL: test_live_across_early_clobber_tuple:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def s[0:7]
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def s12
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; def s[10:11], use s12
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    ;;#ASMSTART
; CHECK-NEXT:    ; use s[0:7], s[10:11]
; CHECK-NEXT:    ;;#ASMEND
; CHECK-NEXT:    s_endpgm
entry:
  %v = call <8 x i32> asm sideeffect "; def $0", "=s"()
  %in = call i32 asm sideeffect "; def $0", "={s12}"()
  %ec = call i64 asm sideeffect "; def $0, use $1", "=&{s[10:11]},{s12}"(i32 %in)
  call void asm sideeffect "; use $0, $1", "s,s"(<8 x i32> %v, i64 %ec)
  ret void
}

