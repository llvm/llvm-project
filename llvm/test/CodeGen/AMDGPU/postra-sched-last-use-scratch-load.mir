# RUN: llc -mtriple=amdgpu12.00 -run-pass=si-post-ra-bundler,postmisched,amdgpu-mark-last-scratch-load -verify-misched -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu12.00 -passes=si-post-ra-bundler,postmisched,amdgpu-mark-last-scratch-load -verify-machineinstrs -o - %s | FileCheck %s

# The post-RA scheduler may move the second reload of a spill slot above the
# first one. TH_LU must end up on the reload that is last after scheduling.

---
name: last_use_reload_order
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0, $vgpr2, $vgpr10

    ; CHECK-LABEL: name: last_use_reload_order
    ; CHECK: liveins: $vgpr0, $vgpr2, $vgpr10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 $vgpr2, killed $vgpr10, implicit $exec
    ; CHECK-NEXT: SCRATCH_STORE_DWORD_ST killed $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr3 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, killed $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 $vgpr3, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr12 = V_ADD_U32_e32 killed $vgpr2, killed $vgpr11, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, killed $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr5 = V_ADD_U32_e32 killed $vgpr12, killed $vgpr4, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit killed $vgpr5
    SCRATCH_STORE_DWORD_ST killed $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    $vgpr11 = V_ADD_U32_e32 $vgpr2, $vgpr10, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    $vgpr12 = V_ADD_U32_e32 $vgpr2, $vgpr11, implicit $exec
    $vgpr3 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    $vgpr4 = V_ADD_U32_e32 $vgpr3, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr5 = V_ADD_U32_e32 $vgpr12, $vgpr4, implicit $exec
    S_ENDPGM 0, implicit $vgpr5
...

# The reloads end up in a memory clause bundle.
---
name: last_use_reload_order_bundle
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0, $vgpr2, $vgpr10

    ; CHECK-LABEL: name: last_use_reload_order_bundle
    ; CHECK: liveins: $vgpr0, $vgpr2, $vgpr10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SCRATCH_STORE_DWORD_ST killed $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: BUNDLE implicit-def $vgpr3, implicit-def $vgpr6, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5), ("amdgpu-last-use" load (s32) from %stack.1, addrspace 5) {
    ; CHECK-NEXT:   $vgpr3 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT:   $vgpr6 = SCRATCH_LOAD_DWORD_ST 8, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.1, addrspace 5)
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 $vgpr2, killed $vgpr10, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, killed $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 $vgpr3, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr12 = V_ADD_U32_e32 killed $vgpr2, killed $vgpr11, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, killed $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr5 = V_ADD_U32_e32 killed $vgpr12, killed $vgpr4, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit killed $vgpr5, implicit killed $vgpr6
    SCRATCH_STORE_DWORD_ST killed $vgpr0, 4, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    $vgpr11 = V_ADD_U32_e32 $vgpr2, $vgpr10, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    $vgpr12 = V_ADD_U32_e32 $vgpr2, $vgpr11, implicit $exec
    $vgpr3 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    $vgpr6 = SCRATCH_LOAD_DWORD_ST 8, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.1, addrspace 5)
    $vgpr4 = V_ADD_U32_e32 $vgpr3, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr5 = V_ADD_U32_e32 $vgpr12, $vgpr4, implicit $exec
    S_ENDPGM 0, implicit $vgpr5, implicit $vgpr6
...

# The hoisted reload covers the whole slot, the other reload only its upper half,
# so only the upper-half reload is a last use.
---
name: last_use_reload_order_partial
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2, $vgpr10

    ; CHECK-LABEL: name: last_use_reload_order_partial
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2, $vgpr10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 $vgpr2, killed $vgpr10, implicit $exec
    ; CHECK-NEXT: SCRATCH_STORE_DWORDX2_ST killed $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr :: (store (s64) into %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr6_vgpr7 = SCRATCH_LOAD_DWORDX2_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s64) from %stack.0, addrspace 5)
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr11 = V_ADD_U32_e32 killed $vgpr11, killed $vgpr2, implicit $exec
    ; CHECK-NEXT: $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0 + 4, addrspace 5)
    ; CHECK-NEXT: $vgpr3 = V_ADD_U32_e32 killed $vgpr6, killed $vgpr7, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 $vgpr3, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr12 = V_ADD_U32_e32 killed $vgpr2, killed $vgpr11, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr4 = V_ADD_U32_e32 killed $vgpr4, killed $vgpr3, implicit $exec
    ; CHECK-NEXT: $vgpr5 = V_ADD_U32_e32 killed $vgpr12, killed $vgpr4, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit killed $vgpr5
    SCRATCH_STORE_DWORDX2_ST killed $vgpr0_vgpr1, 0, 0, implicit $exec, implicit $flat_scr :: (store (s64) into %stack.0, addrspace 5)
    $vgpr11 = V_ADD_U32_e32 $vgpr2, $vgpr10, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr11 = V_ADD_U32_e32 $vgpr11, $vgpr2, implicit $exec
    $vgpr2 = SCRATCH_LOAD_DWORD_ST 4, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0 + 4, addrspace 5)
    $vgpr12 = V_ADD_U32_e32 $vgpr2, $vgpr11, implicit $exec
    $vgpr6_vgpr7 = SCRATCH_LOAD_DWORDX2_ST 0, 0, implicit $exec, implicit $flat_scr :: (load (s64) from %stack.0, addrspace 5)
    $vgpr3 = V_ADD_U32_e32 $vgpr6, $vgpr7, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr3, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr4, $vgpr3, implicit $exec
    $vgpr5 = V_ADD_U32_e32 $vgpr12, $vgpr4, implicit $exec
    S_ENDPGM 0, implicit $vgpr5
...
