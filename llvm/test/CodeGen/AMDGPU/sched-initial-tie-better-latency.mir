# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -stress-regalloc=18 -amdgpu-sched-strategy=max-ilp -passes=machine-scheduler -verify-misched -debug-only=machine-scheduler -o - %s 2>&1 | FileCheck %s

# bb.1 has excess VGPR pressure at the minimum occupancy: 16 VGPRs of %1 live
# through it, and it defines 4 more, over the limit of 18 that
# -stress-regalloc=18 sets. Every value defined in bb.1 is live out of it, so
# the pressures before and after scheduling are equal in any order. The ILP
# initial stage moves the COPY of the S_LOAD_DWORDX4 result below independent
# instructions to hide the load latency, and keeps the new schedule since it
# has a better latency metric.

# CHECK: tie_order_invariant:%bb.1
# CHECK: Region register pressure: VGPRs: [[VGPRS:[0-9]+]] AGPRs: 0, SGPRs: [[SGPRS:[0-9]+]],
# CHECK: Pressure after scheduling: VGPRs: [[VGPRS]] AGPRs: 0, SGPRs: [[SGPRS]],
# CHECK: New pressure will result in more spilling.
# CHECK: Equivalent RP, keeping schedule with better latency.

--- |
  define amdgpu_kernel void @tie_order_invariant() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-waves-per-eu"="8,8" }
...
---
name:            tie_order_invariant
body:             |
  ; CHECK-LABEL: name: tie_order_invariant
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr4_sgpr5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr_64 = COPY $sgpr4_sgpr5
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_512_align2 = IMPLICIT_DEF
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_LOAD_DWORDX4_IMM:%[0-9]+]]:sgpr_128 = S_LOAD_DWORDX4_IMM [[COPY]], 16, 0 :: (dereferenceable invariant load (s128), addrspace 4)
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 4, implicit $exec
  ; CHECK-NEXT:   [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vreg_64_align2 = COPY [[S_LOAD_DWORDX4_IMM]].sub2_sub3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_NOP 0, implicit [[DEF]], implicit [[S_LOAD_DWORDX4_IMM]], implicit [[COPY1]], implicit [[V_MOV_B32_e32_]], implicit [[V_MOV_B32_e32_1]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr4_sgpr5

    %0:sgpr_64 = COPY $sgpr4_sgpr5
    %1:vreg_512_align2 = IMPLICIT_DEF

  bb.1:
    %2:sgpr_128 = S_LOAD_DWORDX4_IMM %0, 16, 0 :: (dereferenceable invariant load (s128), addrspace 4)
    %3:vreg_64_align2 = COPY %2.sub2_sub3
    %4:vgpr_32 = V_MOV_B32_e32 4, implicit $exec
    %5:vgpr_32 = V_MOV_B32_e32 5, implicit $exec

  bb.2:
    S_NOP 0, implicit %1, implicit %2, implicit %3, implicit %4, implicit %5
    S_ENDPGM 0
...
