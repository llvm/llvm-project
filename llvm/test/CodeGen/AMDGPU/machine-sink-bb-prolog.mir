# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=machine-sink -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu9.00 -passes=machine-sink -verify-each -o - %s | FileCheck %s

# %1 is only read by a block prolog instruction in %bb.2, so it cannot sink
# there: the insertion point is after the prolog. %2 is read after the prolog
# and sinks.

---
name: sink_past_bb_prolog
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: sink_past_bb_prolog
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_64 = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[COPY]], [[COPY]], implicit-def dead $scc
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.2, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   bb-prolog SI_END_CF [[S_AND_B64_]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   [[S_OR_B64_:%[0-9]+]]:sreg_64 = S_OR_B64 [[COPY]], [[COPY]], implicit-def dead $scc
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_OR_B64_]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0_sgpr1

    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = S_AND_B64 %0, %0, implicit-def dead $scc
    %2:sreg_64 = S_OR_B64 %0, %0, implicit-def dead $scc
    S_CBRANCH_EXECZ %bb.2, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    S_ENDPGM 0

  bb.2:
    bb-prolog SI_END_CF %1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_NOP 0, implicit %2
    S_ENDPGM 0
...
