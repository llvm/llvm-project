# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -mattr=+real-true16 -run-pass post-ra-pseudos -verify-machineinstrs -o - %s | FileCheck -check-prefix=GFX1250 %s

# 16-bit copies from read-only source registers with real true16, where VGPR
# halves are written with V_MOV_B16_t16. copy-phys-reg-read-only-src.mir covers
# the same copies on targets without true16, which use V_MOV_B32_sdwa.

---
name: sgpr_lo16_from_src_scc_lo16
tracksRegLiveness: true
body: |
  bb.0:
    ; GFX1250-LABEL: name: sgpr_lo16_from_src_scc_lo16
    ; GFX1250: $sgpr0 = S_MOV_B32 $src_scc
    ; GFX1250-NEXT: S_ENDPGM 0, implicit $sgpr0
    $sgpr0_lo16 = COPY $src_scc_lo16
    S_ENDPGM 0, implicit $sgpr0
...
---
name: sgpr_lo16_from_src_flat_scratch_base_lo_lo16
tracksRegLiveness: true
body: |
  bb.0:
    ; GFX1250-LABEL: name: sgpr_lo16_from_src_flat_scratch_base_lo_lo16
    ; GFX1250: $sgpr0 = S_MOV_B32 $src_flat_scratch_base_lo
    ; GFX1250-NEXT: S_ENDPGM 0, implicit $sgpr0
    $sgpr0_lo16 = COPY $src_flat_scratch_base_lo_lo16
    S_ENDPGM 0, implicit $sgpr0
...
---
name: vgpr_lo16_from_src_shared_base_lo_lo16
tracksRegLiveness: true
body: |
  bb.0:
    ; GFX1250-LABEL: name: vgpr_lo16_from_src_shared_base_lo_lo16
    ; GFX1250: $vgpr0_lo16 = V_MOV_B16_t16_e32 $src_shared_base_lo, implicit $exec
    ; GFX1250-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_lo16 = COPY $src_shared_base_lo_lo16
    S_ENDPGM 0, implicit $vgpr0
...
---
name: vgpr_hi16_from_src_flat_scratch_base_hi_lo16
tracksRegLiveness: true
body: |
  bb.0:
    ; GFX1250-LABEL: name: vgpr_hi16_from_src_flat_scratch_base_hi_lo16
    ; GFX1250: $vgpr0_hi16 = V_MOV_B16_t16_e32 $src_flat_scratch_base_hi, implicit $exec
    ; GFX1250-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0_hi16 = COPY $src_flat_scratch_base_hi_lo16
    S_ENDPGM 0, implicit $vgpr0
...
