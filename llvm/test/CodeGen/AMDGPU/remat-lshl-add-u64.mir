# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa --stress-regalloc=2 -start-before=greedy,0 -stop-after=virt-reg-rewriter,2 -o - %s | FileCheck -check-prefixes=GCN,GFX950 %s
