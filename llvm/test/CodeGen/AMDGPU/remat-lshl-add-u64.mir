# V_LSHL_ADD_U64 is only rematerializable when the shift amount is the
# immediate 0, i.e. when it is just a 64-bit add. The VGPR allocation runs
# with a stressed register budget, so values are either rematerialized or
# spilled.

---
name:            test_remat_v_lshl_add_u64_zero_shift
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg:  $sgpr32
body:             |
  bb.0:
    ; GCN-LABEL: name: test_remat_v_lshl_add_u64_zero_shift
    ; GCN: renamable $vgpr0_vgpr1 = V_LSHL_ADD_U64_e64 1, 0, 2, implicit $exec
    ; GCN-NEXT: renamable $vgpr2_vgpr3 = V_LSHL_ADD_U64_e64 3, 0, 4, implicit $exec
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $vgpr0_vgpr1
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $vgpr2_vgpr3
    ; GCN-NEXT: renamable $vgpr0_vgpr1 = V_LSHL_ADD_U64_e64 5, 0, 6, implicit $exec
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $vgpr0_vgpr1
    ; GCN-NEXT: S_ENDPGM 0
    %0:vreg_64_align2 = V_LSHL_ADD_U64_e64 1, 0, 2, implicit $exec
    %1:vreg_64_align2 = V_LSHL_ADD_U64_e64 3, 0, 4, implicit $exec
    %2:vreg_64_align2 = V_LSHL_ADD_U64_e64 5, 0, 6, implicit $exec
    S_NOP 0, implicit %0
    S_NOP 0, implicit %1
    S_NOP 0, implicit %2
    S_ENDPGM 0
...
