# Window 11 with the nearest producer 1 wait state away needs 10; taking the
# detour's distance leaves it two short.
# GCN-LABEL: name: smfma16x16_write_vgpr_valu_read_diamond_long_edge_first
# GCN:      bb.3:
# GCN-NEXT: S_NOP 9
# GCN-NEXT: $vgpr4 = V_MOV_B32_e32 $vgpr2
name:            smfma16x16_write_vgpr_valu_read_diamond_long_edge_first
body:             |
  bb.0:
    successors: %bb.2
    S_BRANCH %bb.2

  bb.1:
    successors: %bb.3
    $sgpr0 = S_MOV_B32 0
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.1, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.3:
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...
# GCN-LABEL: name: smfma16x16_write_vgpr_valu_read_diamond_short_edge_first
# GCN:      bb.3:
# GCN-NEXT: S_NOP 9
# GCN-NEXT: $vgpr4 = V_MOV_B32_e32 $vgpr2
name:            smfma16x16_write_vgpr_valu_read_diamond_short_edge_first
body:             |
  bb.0:
    successors: %bb.1
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.2:
    successors: %bb.3
    $sgpr0 = S_MOV_B32 0
    S_BRANCH %bb.3

  bb.3:
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

# The same with a detour longer than the window: expiring on the long edge must
# not stop the direct edge from being measured.

# GCN-LABEL: name: smfma16x16_valu_read_detour_longer_than_window
# GCN:      bb.3:
# GCN-NEXT: S_NOP 9
# GCN-NEXT: $vgpr4 = V_MOV_B32_e32 $vgpr2
name:            smfma16x16_valu_read_detour_longer_than_window
body:             |
  bb.0:
    successors: %bb.2
    S_BRANCH %bb.2

  bb.1:
    successors: %bb.3
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    $sgpr2 = S_MOV_B32 0
    $sgpr3 = S_MOV_B32 0
    $sgpr4 = S_MOV_B32 0
    $sgpr5 = S_MOV_B32 0
    $sgpr6 = S_MOV_B32 0
    $sgpr7 = S_MOV_B32 0
    $sgpr8 = S_MOV_B32 0
    $sgpr9 = S_MOV_B32 0
    $sgpr10 = S_MOV_B32 0
    $sgpr11 = S_MOV_B32 0
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.1, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.3:
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...
# An MFMA overlapping nothing must not set the window for one that does: the
# 32x32 writing v[0:3] asks for 16, the unrelated 4x4 for 2.
# GCN-LABEL: name: smfma32x32_srcc_read_unrelated_mfma_producer_block_first
# GCN:      bb.3:
# GCN-NEXT: S_NOP 14
# GCN-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32
name:            smfma32x32_srcc_read_unrelated_mfma_producer_block_first
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    $vgpr40_vgpr41_vgpr42_vgpr43 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr40_vgpr41_vgpr42_vgpr43, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
# GCN-LABEL: name: smfma32x32_srcc_read_unrelated_mfma_decoy_block_first
# GCN:      bb.3:
# GCN-NEXT: S_NOP 14
# GCN-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32
name:            smfma32x32_srcc_read_unrelated_mfma_decoy_block_first
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    $vgpr40_vgpr41_vgpr42_vgpr43 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr40_vgpr41_vgpr42_vgpr43, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
# srcC is exactly the producer's destination, so nothing is needed; an unrelated
# MFMA of the same shape must not turn that into 15.
# GCN-LABEL: name: smfma32x32_full_srcc_read_unrelated_mfma
# GCN:      bb.3:
# GCN-NEXT: early-clobber {{.*}} = V_MFMA_F32_32X32X2F32
name:            smfma32x32_full_srcc_read_unrelated_mfma
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    $vgpr40_vgpr41_vgpr42_vgpr43_vgpr44_vgpr45_vgpr46_vgpr47_vgpr48_vgpr49_vgpr50_vgpr51_vgpr52_vgpr53_vgpr54_vgpr55 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr40_vgpr41_vgpr42_vgpr43_vgpr44_vgpr45_vgpr46_vgpr47_vgpr48_vgpr49_vgpr50_vgpr51_vgpr52_vgpr53_vgpr54_vgpr55, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
# Window and distance must come from one producer: the 32x32 needs 19 from 11
# away, the 4x4 needs 5 from 1 away, so 8. Mispairing would ask 18.

# GCN-LABEL: name: mfma_mixed_window_far_wide_near_narrow
# GCN:      bb.3:
# GCN-NEXT: S_NOP 7
# GCN-NEXT: $vgpr16 = V_MOV_B32
name:            mfma_mixed_window_far_wide_near_narrow
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    $sgpr2 = S_MOV_B32 0
    $sgpr3 = S_MOV_B32 0
    $sgpr4 = S_MOV_B32 0
    $sgpr5 = S_MOV_B32 0
    $sgpr6 = S_MOV_B32 0
    $sgpr7 = S_MOV_B32 0
    $sgpr8 = S_MOV_B32 0
    $sgpr9 = S_MOV_B32 0
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    $vgpr16 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_ENDPGM 0
...
# The same around a loop: the 16x16 needs 11 from 1 away, the 4x4 needs 5 around
# the latch, so 10. Mispairing would ask 4.

# GCN-LABEL: name: mfma_mixed_window_loop
# GCN:      bb.2:
# GCN:      S_NOP 9
# GCN-NEXT: $vgpr16 = V_MOV_B32
name:            mfma_mixed_window_loop
body:             |
  bb.0:
    successors: %bb.1
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_16X16X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.3, %bb.4
    $vgpr16 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_CBRANCH_SCC1 %bb.4, implicit $scc
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.2
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.2

  bb.4:
    S_ENDPGM 0
...
# A trailing branch to another successor is not executed on the edge into the
# consumer, so it must not count. Both need 10.

# GCN-LABEL: name: smfma16x16_valu_read_two_terminators
# GCN:      bb.2:
# GCN-NEXT: S_NOP 9
# GCN-NEXT: $vgpr40 = V_MOV_B32
name:            smfma16x16_valu_read_two_terminators
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_16X16X1F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    S_BRANCH %bb.2

  bb.2:
    $vgpr40 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_ENDPGM 0
...
# Only the bb.3 edge skips bb.0's trailing S_BRANCH, so the edges arrive at
# different distances; along the cheaper one 3 of the 19 are left.

# GCN-LABEL: name: smfma32x32_valu_read_unexecuted_branch_on_one_edge
# GCN:      bb.4:
# GCN:      $sgpr5 = S_MOV_B32 0
# GCN-NEXT: S_NOP 2
# GCN-NEXT: $vgpr16 = V_MOV_B32
name:            smfma32x32_valu_read_unexecuted_branch_on_one_edge
body: |
  bb.0:
    successors: %bb.1, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_32X32X2F32_vgprcd_e64 $vgpr26, $vgpr27, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    $sgpr2 = S_MOV_B32 0
    S_CBRANCH_SCC1 %bb.3, implicit $scc
    S_BRANCH %bb.1
  bb.1:
    successors: %bb.2, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15 = V_MFMA_F32_16X16X1F32_vgprcd_e64 $vgpr20, $vgpr21, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    $sgpr0 = S_MOV_B32 0
    S_CBRANCH_SCC1 %bb.3, implicit $scc
    S_BRANCH %bb.2
  bb.2:
    successors: %bb.4
    $sgpr0 = S_MOV_B32 0
    S_BRANCH %bb.4
  bb.3:
    successors: %bb.4
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    $sgpr2 = S_MOV_B32 0
    $sgpr3 = S_MOV_B32 0
    $sgpr4 = S_MOV_B32 0
    S_BRANCH %bb.4
  bb.4:
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    $sgpr2 = S_MOV_B32 0
    $sgpr3 = S_MOV_B32 0
    $sgpr4 = S_MOV_B32 0
    $sgpr5 = S_MOV_B32 0
    $vgpr16 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_ENDPGM 0
...
# The same when the reader is an MFMA: srcA after a 32x32 needs 19, after a 4x4
# needs 5, one branch away each, so 18.

# GCN-LABEL: name: smfma_srca_read_mixed_shapes
# GCN:      bb.3:
# GCN-NEXT: S_NOP 15
# GCN-NEXT: S_NOP 1
# GCN-NEXT: $agpr20_agpr21_agpr22_agpr23 = V_MFMA_F32_4X4X1F32
name:            smfma_srca_read_mixed_shapes
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15 = V_MFMA_F32_32X32X2F32_e64 $vgpr1, $vgpr0, $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_4X4X1F32_e64 $vgpr1, $vgpr0, $agpr0_agpr1_agpr2_agpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    $agpr20_agpr21_agpr22_agpr23 = V_MFMA_F32_4X4X1F32_e64 $agpr1, $vgpr0, $agpr20_agpr21_agpr22_agpr23, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
# A producer writing exactly the srcC register needs nothing and must not hide a
# farther partial overlap: the 16x16 needs 8 from 1 away.

# GCN-LABEL: name: smfma_full_srcc_producer_does_not_hide_partial
# GCN:      V_MFMA_F32_4X4X1F32
# GCN-NEXT: S_NOP 6
# GCN-NEXT: $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_4X4X1F32
name:            smfma_full_srcc_producer_does_not_hide_partial
body:             |
  bb.0:
    $agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15_agpr16_agpr17 = V_MFMA_F32_16X16X1F32_e64 $vgpr1, $vgpr0, $agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15_agpr16_agpr17, 0, 0, 0, implicit $mode, implicit $exec
    $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_4X4X1F32_e64 $vgpr1, $vgpr0, $agpr30_agpr31_agpr32_agpr33, 0, 0, 0, implicit $mode, implicit $exec
    $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_4X4X1F32_e64 $vgpr1, $vgpr0, $agpr4_agpr5_agpr6_agpr7, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
# Control leaves at the first terminator that transfers to the successor, so a
# taken conditional branch is the only one executed: 1 of the 11.

# GCN-LABEL: name: smfma16x16_valu_read_same_target_terminators
# GCN:      bb.1:
# GCN-NEXT: S_NOP 9
# GCN-NEXT: $vgpr4 = V_MOV_B32
name:            smfma16x16_valu_read_same_target_terminators
body:             |
  bb.0:
    successors: %bb.1
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...
# Each successor executes a different number of the three terminators, so the
# same producer is 1 and 3 wait states away.

# GCN-LABEL: name: smfma16x16_valu_read_first_conditional_target
# GCN:      bb.2:
# GCN-NEXT: S_NOP 9
# GCN-NEXT: $vgpr4 = V_MOV_B32
name:            smfma16x16_valu_read_first_conditional_target
body:             |
  bb.0:
    successors: %bb.1, %bb.2, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_CBRANCH_EXECZ %bb.3, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    S_ENDPGM 0

  bb.2:
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0

  bb.3:
    S_ENDPGM 0
...
# GCN-LABEL: name: smfma16x16_valu_read_unconditional_target
# GCN:      bb.1:
# GCN-NEXT: S_NOP 7
# GCN-NEXT: $vgpr4 = V_MOV_B32
name:            smfma16x16_valu_read_unconditional_target
body:             |
  bb.0:
    successors: %bb.1, %bb.2, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_CBRANCH_EXECZ %bb.3, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0

  bb.2:
    S_ENDPGM 0

  bb.3:
    S_ENDPGM 0
...

# The empty fallthrough contributes nothing: along bb.0 -> bb.1 -> bb.2 only the
# conditional branch executes, leaving 5 of the 11.

# GCN-LABEL: name: smfma16x16_valu_read_across_empty_fallthrough
# GCN:      bb.2:
# GCN-NEXT: $sgpr0 = S_MOV_B32 0
# GCN:      S_NOP 4
# GCN-NEXT: $vgpr4 = V_MOV_B32
name:            smfma16x16_valu_read_across_empty_fallthrough
body:             |
  bb.0:
    successors: %bb.1, %bb.3
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_16X16X16F16_vgprcd_e64 $vgpr8_vgpr9, $vgpr10_vgpr11, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.3

  bb.1:
    successors: %bb.2

  bb.2:
    $sgpr0 = S_MOV_B32 0
    $sgpr1 = S_MOV_B32 0
    $sgpr2 = S_MOV_B32 0
    $sgpr3 = S_MOV_B32 0
    $sgpr4 = S_MOV_B32 0
    $vgpr4 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_ENDPGM 0

  bb.3:
    S_ENDPGM 0
...

# Blocks holding nothing but a branch: with no instruction to notice the window
# is spent, the bound has to be tested on the edge. 24 is past it.

# GCN-LABEL: name: valu_read_across_long_branch_chain
# GCN:      bb.24:
# GCN-NEXT: $vgpr8 = V_MOV_B32
name:            valu_read_across_long_branch_chain
body: |
  bb.0:
    successors: %bb.1
    $vgpr0_vgpr1_vgpr2_vgpr3 = V_MFMA_F32_4X4X1F32_vgprcd_e64 $vgpr1, $vgpr0, $vgpr0_vgpr1_vgpr2_vgpr3, 0, 0, 0, implicit $mode, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.4
    S_BRANCH %bb.4

  bb.4:
    successors: %bb.5
    S_BRANCH %bb.5

  bb.5:
    successors: %bb.6
    S_BRANCH %bb.6

  bb.6:
    successors: %bb.7
    S_BRANCH %bb.7

  bb.7:
    successors: %bb.8
    S_BRANCH %bb.8

  bb.8:
    successors: %bb.9
    S_BRANCH %bb.9

  bb.9:
    successors: %bb.10
    S_BRANCH %bb.10

  bb.10:
    successors: %bb.11
    S_BRANCH %bb.11

  bb.11:
    successors: %bb.12
    S_BRANCH %bb.12

  bb.12:
    successors: %bb.13
    S_BRANCH %bb.13

  bb.13:
    successors: %bb.14
    S_BRANCH %bb.14

  bb.14:
    successors: %bb.15
    S_BRANCH %bb.15

  bb.15:
    successors: %bb.16
    S_BRANCH %bb.16

  bb.16:
    successors: %bb.17
    S_BRANCH %bb.17

  bb.17:
    successors: %bb.18
    S_BRANCH %bb.18

  bb.18:
    successors: %bb.19
    S_BRANCH %bb.19

  bb.19:
    successors: %bb.20
    S_BRANCH %bb.20

  bb.20:
    successors: %bb.21
    S_BRANCH %bb.21

  bb.21:
    successors: %bb.22
    S_BRANCH %bb.22

  bb.22:
    successors: %bb.23
    S_BRANCH %bb.23

  bb.23:
    successors: %bb.24
    S_BRANCH %bb.24

  bb.24:
    $vgpr8 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_ENDPGM 0
...
# Every block in the empty chain is reached at the same distance, once by
# fallthrough and once from a branch below, so the traversal keeps queueing
# arrivals at the distance it is currently visiting. The chain costs nothing,
# leaving the whole 11 of the window.

# GCN-LABEL: name: smfma16x16_valu_read_many_equal_distance_arrivals
# GCN:      bb.7:
# GCN:      S_NOP 10
# GCN-NEXT: $vgpr4 = V_MOV_B32
name:            smfma16x16_valu_read_many_equal_distance_arrivals
body:             |
  bb.0:
