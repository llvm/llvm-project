; CHECK-NEXT:    v_mov_b32_e32 v1, s5
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    v_add_f32_e64 v0, s0, 0
; CHECK-NEXT:    v_add_f32_e32 v0, s1, v0
; CHECK-NEXT:    v_add_f32_e32 v0, s2, v0
; CHECK-NEXT:    v_add_f32_e32 v2, s3, v0
