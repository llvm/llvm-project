  %tmp7 = getelementptr inbounds float, ptr addrspace(1) %arg, i64 2
  %tmp8 = load float, ptr addrspace(1) %tmp7, align 4, !tbaa !8
  %tmp9 = fadd float %tmp6, %tmp8
