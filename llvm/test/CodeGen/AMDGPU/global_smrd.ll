; CHECK-NEXT:    flat_store_dword v[0:1], v2
; CHECK-NEXT:    s_endpgm
bb:
  %tmp2 = load float, ptr addrspace(1) %arg, align 4, !tbaa !8
  %tmp3 = fadd float %tmp2, 0.000000e+00
