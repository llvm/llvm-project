; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=amdgpu11.00 < %s | FileCheck %s

; The region tree puts the latches of %header other than %A in a sub-region
; header => A, which is structurized as a loop of its own, nested inside the
; loop closed by %A. The outer loop must get its own header so that
; UniformityInfo sees the nesting: lanes leave the inner loop on different
; iterations, so %u and the branch in %A are divergent. @self_loop is the same
; as @latch_block after CodeGenPrepare has removed the empty latch block.

define amdgpu_kernel void @latch_block(ptr addrspace(1) %p, ptr addrspace(1) %out) {
; CHECK-LABEL: latch_block:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b128 s[0:3], s[4:5], 0x24
; CHECK-NEXT:    v_dual_mov_b32 v1, 0 :: v_dual_and_b32 v0, 0x3ff, v0
; CHECK-NEXT:    s_mov_b32 s4, 0
; CHECK-NEXT:    s_branch .LBB0_2
; CHECK-NEXT:    .p2align 6
; CHECK-NEXT:  .LBB0_1: ; %A
; CHECK-NEXT:    ; in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s5
; CHECK-NEXT:    v_cmp_lt_u32_e32 vcc_lo, 0x64, v2
; CHECK-NEXT:    s_or_b32 s4, vcc_lo, s4
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_not1_b32 exec_lo, exec_lo, s4
; CHECK-NEXT:    s_cbranch_execz .LBB0_6
; CHECK-NEXT:  .LBB0_2: ; %header.outer
; CHECK-NEXT:    ; =>This Loop Header: Depth=1
; CHECK-NEXT:    ; Child Loop BB0_4 Depth 2
; CHECK-NEXT:    s_mov_b32 s5, 0
; CHECK-NEXT:    ; implicit-def: $sgpr6
; CHECK-NEXT:    s_branch .LBB0_4
; CHECK-NEXT:  .LBB0_3: ; %Flow
; CHECK-NEXT:    ; in Loop: Header=BB0_4 Depth=2
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s7
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_b32 s7, exec_lo, s6
; CHECK-NEXT:    s_or_b32 s5, s7, s5
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_not1_b32 exec_lo, exec_lo, s5
; CHECK-NEXT:    s_cbranch_execz .LBB0_1
; CHECK-NEXT:  .LBB0_4: ; %header
; CHECK-NEXT:    ; Parent Loop BB0_2 Depth=1
; CHECK-NEXT:    ; => This Inner Loop Header: Depth=2
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_load_b32 v2, v1, s[0:1] glc dlc
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    s_or_b32 s6, s6, exec_lo
; CHECK-NEXT:    s_mov_b32 s7, exec_lo
; CHECK-NEXT:    v_cmpx_lt_u32_e32 v2, v0
; CHECK-NEXT:    s_cbranch_execz .LBB0_3
; CHECK-NEXT:  ; %bb.5: ; %B
; CHECK-NEXT:    ; in Loop: Header=BB0_4 Depth=2
; CHECK-NEXT:    s_and_not1_b32 s6, s6, exec_lo
; CHECK-NEXT:    global_store_b32 v1, v1, s[0:1] dlc
; CHECK-NEXT:    s_waitcnt_vscnt null, 0x0
; CHECK-NEXT:    s_branch .LBB0_3
; CHECK-NEXT:  .LBB0_6: ; %exit
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s4
; CHECK-NEXT:    v_lshlrev_b32_e32 v0, 2, v0
; CHECK-NEXT:    global_store_b32 v0, v2, s[2:3]
; CHECK-NEXT:    s_endpgm
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  br label %header

header:
  %u = load volatile i32, ptr addrspace(1) %p
  %d = icmp ult i32 %u, %tid
  br i1 %d, label %B, label %A

B:
  store volatile i32 0, ptr addrspace(1) %p
  br label %header

A:
  %c = icmp ugt i32 %u, 100
  br i1 %c, label %exit, label %header

exit:
  %gep = getelementptr i32, ptr addrspace(1) %out, i32 %tid
  store i32 %u, ptr addrspace(1) %gep
  ret void
}

define amdgpu_kernel void @self_loop(ptr addrspace(1) %p, ptr addrspace(1) %out) {
; CHECK-LABEL: self_loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b128 s[0:3], s[4:5], 0x24
; CHECK-NEXT:    v_dual_mov_b32 v1, 0 :: v_dual_and_b32 v0, 0x3ff, v0
; CHECK-NEXT:    s_mov_b32 s4, 0
; CHECK-NEXT:  .LBB1_1: ; %header
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_load_b32 v2, v1, s[0:1] glc dlc
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    v_readfirstlane_b32 s5, v2
; CHECK-NEXT:    v_cmp_ge_u32_e32 vcc_lo, v2, v0
; CHECK-NEXT:    s_cmpk_gt_u32 s5, 0x64
; CHECK-NEXT:    s_cselect_b32 s5, -1, 0
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_b32 s5, vcc_lo, s5
; CHECK-NEXT:    s_and_b32 s5, exec_lo, s5
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_or_b32 s4, s5, s4
; CHECK-NEXT:    s_and_not1_b32 exec_lo, exec_lo, s4
; CHECK-NEXT:    s_cbranch_execnz .LBB1_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s4
