; RUN: llc -mtriple=amdgpu11.00 < %s | FileCheck %s

; The region tree places the inner latch(es) of %header in a sub-region
; header => A, which is structurized as a loop of its own, while %A is a latch
; of the same cycle outside that sub-region. Lanes leave the inner loop on
; different iterations, so %u is not uniform in %A even though UniformityInfo
; (which sees a single cycle) says it is.

define amdgpu_kernel void @latch_block(ptr addrspace(1) %p, ptr addrspace(1) %out) {
; CHECK-LABEL: latch_block:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b128 s[0:3], s[4:5], 0x24
; CHECK-NEXT:    v_dual_mov_b32 v1, 0 :: v_dual_and_b32 v0, 0x3ff, v0
; CHECK-NEXT:    s_mov_b32 s4, 0
; CHECK-NEXT:    ; implicit-def: $sgpr5
; CHECK-NEXT:    .p2align 6
; CHECK-NEXT:  .LBB0_1: ; %header
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_load_b32 v2, v1, s[0:1] glc dlc
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    s_or_b32 s5, s5, exec_lo
; CHECK-NEXT:    s_mov_b32 s6, exec_lo
; CHECK-NEXT:    v_cmpx_lt_u32_e32 v2, v0
; CHECK-NEXT:    s_cbranch_execz .LBB0_3
; CHECK-NEXT:  ; %bb.2: ; %B
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_and_not1_b32 s5, s5, exec_lo
; CHECK-NEXT:    global_store_b32 v1, v1, s[0:1] dlc
; CHECK-NEXT:    s_waitcnt_vscnt null, 0x0
; CHECK-NEXT:  .LBB0_3: ; %Flow
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s6
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_b32 s6, exec_lo, s5
; CHECK-NEXT:    s_or_b32 s4, s6, s4
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_not1_b32 exec_lo, exec_lo, s4
; CHECK-NEXT:    s_cbranch_execnz .LBB0_1
; CHECK-NEXT:  ; %bb.4: ; %A
; CHECK-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s4
; CHECK-NEXT:    s_mov_b32 s4, 0
; CHECK-NEXT:    v_cmp_gt_u32_e32 vcc_lo, 0x65, v2
; CHECK-NEXT:    ; implicit-def: $sgpr5
; CHECK-NEXT:    s_cbranch_vccnz .LBB0_1
; CHECK-NEXT:  ; %bb.5: ; %exit
; CHECK-NEXT:    v_lshlrev_b32_e32 v0, 2, v0
; CHECK-NEXT:    global_store_b32 v0, v2, s[2:3]
; CHECK-NEXT:    s_endpgm
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  br label %header

header:
  %u = load volatile i32, ptr addrspace(1) %p
  %d = icmp ult i32 %u, %tid
  br i1 %d, label %B, label %A

B:
  store volatile i32 0, ptr addrspace(1) %p
  br label %header

A:
  %c = icmp ugt i32 %u, 100
  br i1 %c, label %exit, label %header

exit:
  %gep = getelementptr i32, ptr addrspace(1) %out, i32 %tid
  store i32 %u, ptr addrspace(1) %gep
  ret void
}

