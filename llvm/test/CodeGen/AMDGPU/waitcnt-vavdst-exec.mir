# The EXEC write is in a block with nothing pending at its end.
name: kernel_exec_write_on_one_path
tracksRegLiveness: false
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: kernel_exec_write_on_one_path
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 1, 1601, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   $sgpr64_sgpr65 = S_MOV_B64 0
  ; CHECK-NEXT:   V_NOP_e32 implicit $exec
  ; CHECK-NEXT:   GLOBAL_PREFETCH_B8_SADDR $sgpr64_sgpr65, undef $vgpr0, 0, 8, implicit $exec
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   $vgpr40 = V_MOV_B32_e32 $vgpr95, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit undef $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_0
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 $sgpr8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr30 = V_WRITELANE_B32 $sgpr0, 0, $vgpr30
  ; CHECK-NEXT:   $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_0
  ; CHECK-NEXT:   DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    $vgpr40 = V_MOV_B32_e32 $vgpr95, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit undef $scc
  bb.1:
    successors: %bb.2
    S_WAITCNT_DEPCTR .VaVdst_0
    $exec_lo = S_MOV_B32 $sgpr8
  bb.2:
    $vgpr30 = V_WRITELANE_B32 $sgpr0, 0, $vgpr30
    $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    S_ENDPGM 0
...

---
# The EXEC write reaches the writelane through the backedge.
name: kernel_exec_write_in_loop
tracksRegLiveness: false
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: kernel_exec_write_in_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 1, 1601, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   $sgpr64_sgpr65 = S_MOV_B64 0
  ; CHECK-NEXT:   V_NOP_e32 implicit $exec
  ; CHECK-NEXT:   GLOBAL_PREFETCH_B8_SADDR $sgpr64_sgpr65, undef $vgpr0, 0, 8, implicit $exec
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VmVsrc_0
  ; CHECK-NEXT:   $vgpr30 = V_WRITELANE_B32 $sgpr0, 0, $vgpr30
  ; CHECK-NEXT:   $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_0
  ; CHECK-NEXT:   DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 $sgpr8
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    $vgpr30 = V_WRITELANE_B32 $sgpr0, 0, $vgpr30
    $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    $exec_lo = S_MOV_B32 $sgpr8
    S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  bb.2:
    S_ENDPGM 0
...
