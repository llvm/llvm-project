name: writelane_on_one_cfg_path
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: writelane_on_one_cfg_path
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; CHECK-NEXT:   S_WAIT_KMCNT 0
  ; CHECK-NEXT:   $vgpr30 = V_MOV_B32_e32 $vgpr95, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit undef $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr30 = V_WRITELANE_B32 $sgpr0, 0, $vgpr30
  ; CHECK-NEXT:   $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $vgpr35 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_0
  ; CHECK-NEXT:   DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    $vgpr30 = V_MOV_B32_e32 $vgpr95, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit undef $scc

  bb.1:
    $vgpr30 = V_WRITELANE_B32 $sgpr0, 0, $vgpr30
    $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    $vgpr34 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec

  bb.3:
    $vgpr35 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    S_ENDPGM 0
...

