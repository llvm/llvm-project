# WMMA is issued even when EXEC is zero. The F32 WMMA is not XDL, so it is in
# order with the V_ADD, which may be skipped.
name: non_xdl_wmma_then_skippable_valu
tracksRegLiveness: false
body: |
  bb.0:
    ; CHECK-LABEL: name: non_xdl_wmma_then_skippable_valu
