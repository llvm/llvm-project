# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes='greedy<wwm>' -stress-regalloc=3 -verify-regalloc -verify-machineinstrs -o - %s | FileCheck %s

# InlineSpiller hoists the spill of %2 to right after its definition, which is
# inside the block prolog. The spill must join the prolog.

---
name: hoist_spill_in_bb_prolog
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg:    '$sgpr96_sgpr97_sgpr98_sgpr99'
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: vgpr_32, flags: [ WWM_REG ], split-from: '%2' }
  - { id: 1, class: vgpr_32, flags: [ WWM_REG ], split-from: '%2' }
  - { id: 2, class: vgpr_32, flags: [ WWM_REG ] }
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; CHECK-LABEL: name: hoist_spill_in_bb_prolog
    ; CHECK: liveins: $sgpr0_sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[KILL:%[0-9]+]]:av_32 = bb-prolog KILL
    ; CHECK-NEXT: bb-prolog SI_SPILL_WWM_AV32_SAVE [[KILL]], %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: [[WWM_COPY:%[0-9]+]]:vgpr_32 = bb-prolog WWM_COPY [[KILL]]
    ; CHECK-NEXT: bb-prolog KILL [[WWM_COPY]]
    ; CHECK-NEXT: bb-prolog KILL [[WWM_COPY]]
    ; CHECK-NEXT: $exec = bb-prolog S_AND_B64 $exec, $sgpr0_sgpr1, implicit-def $scc
    ; CHECK-NEXT: KILL implicit-def $vgpr0, implicit-def $vgpr1, implicit-def $vgpr2
    ; CHECK-NEXT: [[SI_SPILL_WWM_AV32_RESTORE:%[0-9]+]]:av_32 = SI_SPILL_WWM_AV32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: [[SI_SPILL_WWM_V32_RESTORE:%[0-9]+]]:vgpr_32 = SI_SPILL_WWM_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: KILL [[SI_SPILL_WWM_V32_RESTORE]], [[SI_SPILL_WWM_AV32_RESTORE]]
    ; CHECK-NEXT: S_ENDPGM 0
    %2:vgpr_32 = bb-prolog KILL
    %0:vgpr_32 = bb-prolog WWM_COPY %2
    bb-prolog KILL %0
    bb-prolog KILL %0
    %1:vgpr_32 = lr-split bb-prolog WWM_COPY %0:vgpr_32
    $exec = bb-prolog S_AND_B64 $exec, killed $sgpr0_sgpr1, implicit-def $scc
    KILL implicit-def $vgpr0, implicit-def $vgpr1, implicit-def $vgpr2
    KILL %1:vgpr_32, %2:vgpr_32
    S_ENDPGM 0
...
