; RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -amdgpu-num-vgprs-for-wwm-alloc=1 < %s | FileCheck %s

; Keep five uniform tuples live across four independent MFMA accumulators.
; The restricted register budgets and one-VGPR whole-wave pool cause
; whole-wave copies to use AGPR0 and AGPR1. The rewrite must still find
; the higher AGPRs assigned to per-lane values and let an MFMA accumulate
; directly in AGPRs.
define amdgpu_kernel void @rewrite_with_higher_agprs(ptr addrspace(1) %out, ptr addrspace(4) %uniforms, <8 x half> %input, i32 %iterations) #0 {
; CHECK-LABEL: rewrite_with_higher_agprs:
; CHECK:    v_accvgpr_write_b32 a1, v15
; CHECK:    v_accvgpr_write_b32 a0, v15
; CHECK:    v_mfma_f32_16x16x32_f16 v[2:5], a[2:5], a[2:5], v[2:5]
; CHECK:    v_mfma_f32_16x16x32_f16 v[10:13], a[2:5], a[2:5], v[10:13]
; CHECK:    v_mfma_f32_16x16x32_f16 v[6:9], a[2:5], a[2:5], v[6:9]
; CHECK:    v_mfma_f32_16x16x32_f16 a[10:13], a[2:5], a[2:5], a[10:13]
; CHECK:    v_accvgpr_read_b32 v15, a1
; CHECK:    v_accvgpr_read_b32 v15, a0
entry:
  %lane = call i32 @llvm.amdgcn.workitem.id.x()
  %lane.offset = mul i32 %lane, 96
  %lane.out = getelementptr i32, ptr addrspace(1) %out, i32 %lane.offset
  %uniform0 = load volatile <16 x i32>, ptr addrspace(4) %uniforms, align 16
  %uniform1 = load volatile <16 x i32>, ptr addrspace(4) %uniforms, align 16
  %uniform2 = load volatile <16 x i32>, ptr addrspace(4) %uniforms, align 16
  %uniform3 = load volatile <16 x i32>, ptr addrspace(4) %uniforms, align 16
  %uniform4 = load volatile <16 x i32>, ptr addrspace(4) %uniforms, align 16
  br label %loop

loop:
  %iter = phi i32 [ 0, %entry ], [ %next, %loop ]
  %acc0 = phi <4 x float> [ zeroinitializer, %entry ], [ %mfma0, %loop ]
  %acc1 = phi <4 x float> [ <float 1.0, float 2.0, float 3.0, float 5.0>, %entry ], [ %mfma1, %loop ]
  %acc2 = phi <4 x float> [ <float 1.0, float 2.0, float 3.0, float 6.0>, %entry ], [ %mfma2, %loop ]
  %acc3 = phi <4 x float> [ <float 1.0, float 2.0, float 3.0, float 7.0>, %entry ], [ %mfma3, %loop ]
  %mfma0 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input, <8 x half> %input, <4 x float> %acc0, i32 0, i32 0, i32 0)
  %mfma1 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input, <8 x half> %input, <4 x float> %acc1, i32 0, i32 0, i32 0)
  %mfma2 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input, <8 x half> %input, <4 x float> %acc2, i32 0, i32 0, i32 0)
  %mfma3 = call <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half> %input, <8 x half> %input, <4 x float> %acc3, i32 0, i32 0, i32 0)
  %next = add i32 %iter, 1
  %done = icmp uge i32 %next, %iterations
  br i1 %done, label %exit, label %loop

exit:
  store <4 x float> %mfma0, ptr addrspace(1) %lane.out, align 4
  %mfma.out1 = getelementptr i32, ptr addrspace(1) %lane.out, i32 4
  store <4 x float> %mfma1, ptr addrspace(1) %mfma.out1, align 4
  %mfma.out2 = getelementptr i32, ptr addrspace(1) %lane.out, i32 8
  store <4 x float> %mfma2, ptr addrspace(1) %mfma.out2, align 4
  %mfma.out3 = getelementptr i32, ptr addrspace(1) %lane.out, i32 12
  store <4 x float> %mfma3, ptr addrspace(1) %mfma.out3, align 4
  %uniform.out0 = getelementptr i32, ptr addrspace(1) %lane.out, i32 16
  store volatile <16 x i32> %uniform0, ptr addrspace(1) %uniform.out0, align 4
  %uniform.out1 = getelementptr i32, ptr addrspace(1) %lane.out, i32 32
  store volatile <16 x i32> %uniform1, ptr addrspace(1) %uniform.out1, align 4
  %uniform.out2 = getelementptr i32, ptr addrspace(1) %lane.out, i32 48
  store volatile <16 x i32> %uniform2, ptr addrspace(1) %uniform.out2, align 4
  %uniform.out3 = getelementptr i32, ptr addrspace(1) %lane.out, i32 64
  store volatile <16 x i32> %uniform3, ptr addrspace(1) %uniform.out3, align 4
  %uniform.out4 = getelementptr i32, ptr addrspace(1) %lane.out, i32 80
  store volatile <16 x i32> %uniform4, ptr addrspace(1) %uniform.out4, align 4
  ret void
}

declare i32 @llvm.amdgcn.workitem.id.x()
declare <4 x float> @llvm.amdgcn.mfma.f32.16x16x32.f16(<8 x half>, <8 x half>, <4 x float>, i32 immarg, i32 immarg, i32 immarg)

attributes #0 = { "amdgpu-num-sgpr"="64" "amdgpu-num-vgpr"="16" }
