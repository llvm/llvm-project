  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_SPILL_S32_SAVE $sgpr15, %stack.3, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.3, addrspace 5)
  ; CHECK-NEXT:   SI_SPILL_S32_SAVE $sgpr14, %stack.4, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.4, addrspace 5)
  ; CHECK-NEXT:   renamable $sgpr12_13 = V_CMP_GT_I32_e64 1, undef %18:vgpr_32, implicit $exec
