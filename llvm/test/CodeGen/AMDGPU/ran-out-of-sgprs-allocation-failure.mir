  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr14, $sgpr15, $sgpr16, $vgpr0, $sgpr4_64, $sgpr6_64, $sgpr8_64, $sgpr10_64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_SPILL_S32_SAVE $sgpr15, %stack.0, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   SI_SPILL_S32_SAVE $sgpr14, %stack.1, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.1, addrspace 5)
  ; CHECK-NEXT:   renamable $sgpr14_64 = V_CMP_GT_I32_e64 1, undef %18:vgpr_32, implicit $exec
  ; CHECK-NEXT:   renamable $sgpr12_64 = V_CMP_EQ_U32_e64 0, undef %18:vgpr_32, implicit $exec
