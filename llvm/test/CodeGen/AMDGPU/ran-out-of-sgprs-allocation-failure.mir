  ; CHECK-NEXT:   renamable $sgpr12_64 = V_CMP_NE_U32_e64 0, undef %18:vgpr_32, implicit $exec
  ; CHECK-NEXT:   SI_SPILL_S64_SAVE killed renamable $sgpr12_64, %stack.4, implicit $exec, implicit $sgpr32 :: (store (s64) into %stack.4, align 4, addrspace 5)
  ; CHECK-NEXT:   renamable $sgpr34_64 = V_CMP_GT_I32_e64 0, undef %18:vgpr_32, implicit $exec
  ; CHECK-NEXT:   renamable $sgpr56 = S_MOV_B32 0
