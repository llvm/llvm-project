    %38:sgpr_32 = S_ADD_I32 %0, %1, implicit-def $scc
    S_ENDPGM 0, implicit %20, implicit %22, implicit %23, implicit %24, implicit %25, implicit %26, implicit %27, implicit %28, implicit %29, implicit %30, implicit %31, implicit %32, implicit %33, implicit %34, implicit %35, implicit %36, implicit %21, implicit %38
