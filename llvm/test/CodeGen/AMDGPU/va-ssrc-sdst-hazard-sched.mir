    %25:vgpr_32 = V_ADD_F32_e64 0, %9, 0, %10, 0, 0, implicit $mode, implicit $exec
    %26:vgpr_32 = V_ADD_F32_e64 0, %11, 0, %12, 0, 0, implicit $mode, implicit $exec
    %27:vgpr_32 = V_ADD_F32_e64 0, %13, 0, %14, 0, 0, implicit $mode, implicit $exec
    %28:vgpr_32 = V_ADD_F32_e64 0, %15, 0, %16, 0, 0, implicit $mode, implicit $exec
    %29:vgpr_32 = V_ADD_F32_e64 0, %17, 0, %18, 0, 0, implicit $mode, implicit $exec
    %30:vgpr_32 = V_ADD_F32_e64 0, %19, 0, %2, 0, 0, implicit $mode, implicit $exec
    %31:vgpr_32 = V_ADD_F32_e64 0, %3, 0, %5, 0, 0, implicit $mode, implicit $exec
    %32:vgpr_32 = V_ADD_F32_e64 0, %4, 0, %6, 0, 0, implicit $mode, implicit $exec
    %33:vgpr_32 = V_ADD_F32_e64 0, %7, 0, %9, 0, 0, implicit $mode, implicit $exec
    %34:vgpr_32 = V_ADD_F32_e64 0, %8, 0, %10, 0, 0, implicit $mode, implicit $exec
