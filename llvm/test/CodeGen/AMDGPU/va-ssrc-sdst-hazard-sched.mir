  ; CHECK-NEXT:   dead [[V_ADD_F32_e64_14:%[0-9]+]]:vgpr_32 = V_ADD_F32_e64 0, [[COPY12]], 0, [[COPY14]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   $vcc_lo = COPY [[V_CMP_LT_F32_e64_]]
  ; CHECK-NEXT:   S_CBRANCH_VCCZ %bb.1, implicit $vcc_lo
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[V_ADD_F32_e64_]], implicit [[V_ADD_F32_e64_1]], implicit [[V_ADD_F32_e64_2]], implicit [[V_ADD_F32_e64_3]], implicit [[V_ADD_F32_e64_4]], implicit [[V_ADD_F32_e64_5]], implicit [[V_ADD_F32_e64_6]], implicit [[V_ADD_F32_e64_7]], implicit [[V_ADD_F32_e64_8]], implicit [[V_ADD_F32_e64_9]], implicit [[V_ADD_F32_e64_10]], implicit [[V_ADD_F32_e64_11]], implicit [[V_ADD_F32_e64_12]], implicit [[V_ADD_F32_e64_13]]
  ; V_CMP writes VCC
  ; VALUs fill the 16-cycle gap before CBRANCH
  ; After ~16 cycles, CBRANCH can execute
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5, $vgpr6, $vgpr7, $vgpr8, $vgpr9, $vgpr10, $vgpr11, $vgpr12, $vgpr13, $vgpr14, $vgpr15, $vgpr16, $vgpr17
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = COPY $vgpr2
    %3:vgpr_32 = COPY $vgpr3
    %4:vgpr_32 = COPY $vgpr4
    %5:vgpr_32 = COPY $vgpr5
    %6:vgpr_32 = COPY $vgpr6
    %7:vgpr_32 = COPY $vgpr7
    %8:vgpr_32 = COPY $vgpr8
    %9:vgpr_32 = COPY $vgpr9
    %10:vgpr_32 = COPY $vgpr10
    %11:vgpr_32 = COPY $vgpr11
    %12:vgpr_32 = COPY $vgpr12
    %13:vgpr_32 = COPY $vgpr13
    %14:vgpr_32 = COPY $vgpr14
    %15:vgpr_32 = COPY $vgpr15
    %16:vgpr_32 = COPY $vgpr16
    %17:vgpr_32 = COPY $vgpr17
    ; VALU writes VCC - creates va_sdst hazard for following CBRANCH that reads VCCZ
    %18:sreg_32_xm0_xexec = V_CMP_LT_F32_e64 0, %0, 0, %1, 0, implicit $mode, implicit $exec
    ; Independent VALUs to fill the gap (need 16 for wave32)
    %19:vgpr_32 = V_ADD_F32_e64 0, %2, 0, %3, 0, 0, implicit $mode, implicit $exec
    %20:vgpr_32 = V_ADD_F32_e64 0, %4, 0, %5, 0, 0, implicit $mode, implicit $exec
    %21:vgpr_32 = V_ADD_F32_e64 0, %6, 0, %7, 0, 0, implicit $mode, implicit $exec
    %22:vgpr_32 = V_ADD_F32_e64 0, %8, 0, %9, 0, 0, implicit $mode, implicit $exec
    %23:vgpr_32 = V_ADD_F32_e64 0, %10, 0, %11, 0, 0, implicit $mode, implicit $exec
    %24:vgpr_32 = V_ADD_F32_e64 0, %12, 0, %13, 0, 0, implicit $mode, implicit $exec
    %25:vgpr_32 = V_ADD_F32_e64 0, %14, 0, %15, 0, 0, implicit $mode, implicit $exec
    %26:vgpr_32 = V_ADD_F32_e64 0, %16, 0, %17, 0, 0, implicit $mode, implicit $exec
    %27:vgpr_32 = V_ADD_F32_e64 0, %0, 0, %2, 0, 0, implicit $mode, implicit $exec
    %28:vgpr_32 = V_ADD_F32_e64 0, %1, 0, %3, 0, 0, implicit $mode, implicit $exec
    %29:vgpr_32 = V_ADD_F32_e64 0, %4, 0, %6, 0, 0, implicit $mode, implicit $exec
    %30:vgpr_32 = V_ADD_F32_e64 0, %5, 0, %7, 0, 0, implicit $mode, implicit $exec
    %31:vgpr_32 = V_ADD_F32_e64 0, %8, 0, %10, 0, 0, implicit $mode, implicit $exec
    %32:vgpr_32 = V_ADD_F32_e64 0, %9, 0, %11, 0, 0, implicit $mode, implicit $exec
    %33:vgpr_32 = V_ADD_F32_e64 0, %12, 0, %14, 0, 0, implicit $mode, implicit $exec
    ; CBRANCH that reads VCCZ - should be delayed 16 cycles after V_CMP
    $vcc_lo = COPY %18
    S_CBRANCH_VCCZ %bb.1, implicit $vcc
  bb.1:
    S_ENDPGM 0, implicit %19, implicit %20, implicit %21, implicit %22, implicit %23, implicit %24, implicit %25, implicit %26, implicit %27, implicit %28, implicit %29, implicit %30, implicit %31, implicit %32
