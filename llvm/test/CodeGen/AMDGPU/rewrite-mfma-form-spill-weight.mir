# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# The region is one ArchVGPR over the limit and the accumulator cannot be
# recolored, so converting the MFMA keeps one register out of scratch at the
# price of one bridge copy. A spilled register costs a store and a reload, far
# more than the single VALU op a copy costs, so the conversion is worth it.
#
# Pricing a spilled register at twice a copy instead leaves the conversion
# looking like a loss and the MFMA stays in VGPR form.

--- |
  define amdgpu_kernel void @one_reg_over() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            one_reg_over
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: one_reg_over
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %p0:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %q0:vreg_512 = IMPLICIT_DEF
  ; CHECK-NEXT:   %q1:vreg_128 = IMPLICIT_DEF
  ; CHECK-NEXT:   %m0:vreg_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %m1:vreg_128_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %e0:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   SCHED_BARRIER 0
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef %acc.sub0:vreg_128_align2 = V_ADD_U32_e32 %e0, %e0, implicit $exec
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:areg_128_align2 = COPY %acc
  ; CHECK-NEXT:   %a0:areg_128_align2 = V_MFMA_F32_16X16X32_F16_e64 %m0, %m1, [[COPY]], 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit %a0
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %q0, %q1
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %q0:vreg_512 = IMPLICIT_DEF
    %q1:vreg_128 = IMPLICIT_DEF
    %m0:vreg_128_align2 = IMPLICIT_DEF
    %m1:vreg_128_align2 = IMPLICIT_DEF
    %e0:vgpr_32 = IMPLICIT_DEF
    SCHED_BARRIER 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    ; A VGPR-only partial def keeps %acc out of the AGPR bank, so src2 has to
    ; be bridged rather than recolored.
    undef %acc.sub0:vreg_128_align2 = V_ADD_U32_e32 %e0, %e0, implicit $exec
    %a0:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %m0, %m1, %acc, 0, 0, 0, implicit $mode, implicit $exec
    S_NOP 0, implicit %a0
    S_BRANCH %bb.2

  bb.2:
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %q0, %q1
    S_ENDPGM 0
...
