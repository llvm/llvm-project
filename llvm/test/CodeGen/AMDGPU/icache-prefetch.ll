  %cond = icmp eq i32 %id, 0
  br i1 %cond, label %then, label %else

then:
  call void asm sideeffect ".space 8000", ""()
  br label %join

else:
  call void asm sideeffect ".space 8000", ""()
  br label %join

join:
  call void asm sideeffect ".space 32000", ""()
  ret void
