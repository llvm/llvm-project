# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu11.00 -passes=machine-scheduler -amdgpu-use-amdgpu-trackers -misched-prera-direction=topdown -verify-misched %s -o - | FileCheck %s

# Use AMDGPU pressure trackers and top-down scheduling to query pressure after
# the bundle. The query must skip all bundled instructions; stepping into the
# bundle used to assert in MachineInstrBundleIterator.

---
name: bundled_pressure_query
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: bundled_pressure_query
    ; CHECK: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: BUNDLE implicit-def %2, implicit [[DEF]], implicit [[DEF1]], implicit $mode, implicit $exec {
    ; CHECK-NEXT:   [[V_ADD_F32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_F32_e32 [[DEF]], [[DEF1]], implicit $mode, implicit $exec
    ; CHECK-NEXT: }
    ; CHECK-NEXT: [[V_EXP_F32_e32_:%[0-9]+]]:vgpr_32 = V_EXP_F32_e32 [[V_ADD_F32_e32_]], implicit $mode, implicit $exec
    ; CHECK-NEXT: [[V_ADD_F32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_F32_e32 [[V_ADD_F32_e32_]], [[DEF1]], implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_EXP_F32_e32_]], implicit [[V_ADD_F32_e32_1]]
    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    BUNDLE implicit-def %2, implicit %0, implicit %1, implicit $mode, implicit $exec {
      %2:vgpr_32 = V_ADD_F32_e32 %0, %1, implicit $mode, implicit $exec
    }
    %3:vgpr_32 = V_EXP_F32_e32 %2, implicit $mode, implicit $exec
    %4:vgpr_32 = V_ADD_F32_e32 %2, %1, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %3, implicit %4
...
