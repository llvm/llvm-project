# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# Several chain prefixes can cost exactly the same. AGPR utilization decides
# between them, but only while there are AGPRs to spare, and never over a
# cheaper prefix.

--- |
  define amdgpu_kernel void @agpr_tiebreak_gate() #0 { ret void }
  define amdgpu_kernel void @agpr_tiebreak_cost() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

# Eleven identical chains. From nine chains on, every longer prefix saves the
# same -7680, because the loop is already under the ArchVGPR limit. Breaking
# the tie on utilization alone would run to all eleven, which puts 248 of 256
# AGPRs in use -- close enough to the AGPR limit that the next thing to need
# one spills instead. Utilization only counts while it stays under 7/8 of the
# limit, so the scan stops at nine chains.


---
name: agpr_tiebreak_gate
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
