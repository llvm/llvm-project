# RUN: llc -mtriple=amdgpu10.10 -mattr=+wavefrontsize32 -run-pass=si-fix-sgpr-copies -o - %s | FileCheck %s

# Wave32 version of fix-sgpr-copies-scc-cmp.mir, which uses S_CMP_LG_U32.

---
name: vcmp_to_scc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: vcmp_to_scc
    ; CHECK: [[CMP:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 [[CMP]], 0, implicit-def $scc
    %0:sreg_32_xm0_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    $scc = COPY %0
    %1:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
    S_ENDPGM 0, implicit %1
...

---
name: exec_to_scc
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: exec_to_scc
    ; CHECK: S_CMP_LG_U32 $exec_lo, 0, implicit-def $scc
    $scc = COPY $exec_lo
    %0:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
    S_ENDPGM 0, implicit %0
...

# Negative test: nothing is known about the lane mask, so it must be masked
# with EXEC.
---
name: unknown_mask_to_scc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0
    ; CHECK-LABEL: name: unknown_mask_to_scc
    ; CHECK: [[MASK:%[0-9]+]]:sreg_32_xm0_xexec = COPY $sgpr0
    ; CHECK-NEXT: {{%[0-9]+}}:sreg_32 = S_AND_B32 [[MASK]], $exec_lo, implicit-def $scc
    %0:sreg_32_xm0_xexec = COPY $sgpr0
    $scc = COPY %0
    %1:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
    S_ENDPGM 0, implicit %1
...
