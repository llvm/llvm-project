# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu -mcpu=gfx90a -run-pass=amdgpu-break-load-cluster-deps -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s
# Reproducer 1 for AMDGPUBreakLoadClusterDeps (llvm/llvm-project#216343):
# a scratch_store_dwordx4 tuple is renamed, but the load feeding its first
# dword keeps its old destination, and the new tuple's first register is also
# chosen as an address register.  Reduced (llvm-reduce) from the loop body of
# a CK kernel (test_ck_tile_grouped_gemm_abquant_1x1x128, case /0).
#
#   "$LLVM_BIN"/llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 \
#     -run-pass=amdgpu-break-load-cluster-deps repro/repro-1-tuple-store.mir -o out.mir
#   python3 tools/check-renames.py repro/repro-1-tuple-store.mir out.mir
#
# Expected: SCRATCH_STORE_DWORDX4_SADDR reads $vgpr222 from a V_LSHLREV_B32
# instead of the BUFFER_LOAD_DWORD that wrote $vgpr70.
--- |
  ; ModuleID = 'input.mir'
  source_filename = "input.mir"
  target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-p10:32:32-p11:32:32-p12:32:32-p13:32:32-p14:32:32-p15:32:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @loop_block_rename() #0 {
    ret void
  }

  define amdgpu_kernel void @lane_def_rename() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-agpr-alloc"="0" "amdgpu-flat-work-group-size"="1,256" "amdgpu-waves-per-eu"="1" "target-cpu"="gfx950" }
...
