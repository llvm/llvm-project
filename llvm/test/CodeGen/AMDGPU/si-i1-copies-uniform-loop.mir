    %20:sreg_64 = S_MOV_B64 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2

    %5:sreg_32 = PHI %2, %bb.0, %10, %bb.3
    %6:vreg_1 = PHI %4, %bb.0, %36, %bb.3
    %21:sreg_64 = PHI %20, %bb.0, %23, %bb.3
    %31:sreg_32 = S_MOV_B32 0
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.2, %bb.3

    %32:sreg_32 = PHI %31, %bb.1, %33, %bb.2
    %34:vreg_1 = PHI %6, %bb.1, %36, %bb.2
    %35:sreg_64 = V_CMP_NE_U32_e64 %0, %32, implicit $exec
    %38:sreg_64 = COPY %34
    %39:sreg_64 = S_XOR_B64 %38, %35, implicit-def dead $scc
    %36:vreg_1 = COPY %39
    %33:sreg_32 = S_ADD_I32 %32, 1, implicit-def dead $scc
    S_CMP_LT_U32 %33, %1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.1, %bb.4

    %10:sreg_32 = S_ADD_I32 %5, 1, implicit-def dead $scc
    %22:sreg_64 = V_CMP_EQ_U32_e64 %0, %10, implicit $exec
    %23:sreg_64 = SI_IF_BREAK %22, %21, implicit-def dead $scc
    SI_LOOP %23, %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.4

  bb.4:
    SI_END_CF %23, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    %13:sreg_64_xexec = COPY %36
    %14:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, %13, implicit $exec
    S_ENDPGM 0
...
