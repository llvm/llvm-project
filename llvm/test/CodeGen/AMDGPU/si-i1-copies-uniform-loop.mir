    S_BRANCH %bb.4

  bb.4:
    successors: %bb.5

    %9:sreg_64 = V_CMP_NE_U32_e64 %0, %5, implicit $exec
    %12:vreg_1 = COPY %9

  bb.5:
    successors: %bb.1, %bb.6

    %11:vreg_1 = PHI %6, %bb.3, %12, %bb.4
    SI_END_CF %8, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_CMP_LT_U32 %15, %1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.6

  bb.6:
    %13:sreg_64_xexec = COPY %11
    %14:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, %13, implicit $exec
    S_ENDPGM 0
...

# A vreg_1 COPY in a uniform loop that is used after the loop is lowered by
# lowerCopiesToI1 to a plain copy, without a merge across the back-edge.
---
name:            uniform_latch_copy_used_outside
tracksRegLiveness: true
body:             |
  ; GCN-LABEL: name: uniform_latch_copy_used_outside
  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT:   liveins: $vgpr0, $sgpr0
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; GCN-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; GCN-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 0
  ; GCN-NEXT:   S_BRANCH %bb.1
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[PHI:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_]], %bb.0, %4, %bb.1
  ; GCN-NEXT:   [[V_CMP_NE_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_NE_U32_e64 [[COPY]], [[PHI]], implicit $exec
  ; GCN-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY [[V_CMP_NE_U32_e64_]]
  ; GCN-NEXT:   [[S_ADD_I32_:%[0-9]+]]:sreg_32 = S_ADD_I32 [[PHI]], 1, implicit-def dead $scc
  ; GCN-NEXT:   S_CMP_LT_U32 [[S_ADD_I32_]], [[COPY1]], implicit-def $scc
  ; GCN-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; GCN-NEXT:   S_BRANCH %bb.2
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.2:
  ; GCN-NEXT:   [[COPY3:%[0-9]+]]:sreg_64_xexec = COPY [[COPY2]]
  ; GCN-NEXT:   [[V_CNDMASK_B32_e64_:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, [[COPY3]], implicit $exec
  ; GCN-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sreg_32 = COPY $sgpr0
    %2:sreg_32 = S_MOV_B32 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    %5:sreg_32 = PHI %2, %bb.0, %10, %bb.1
    %9:sreg_64 = V_CMP_NE_U32_e64 %0, %5, implicit $exec
    %12:vreg_1 = COPY %9
    %10:sreg_32 = S_ADD_I32 %5, 1, implicit-def dead $scc
    S_CMP_LT_U32 %10, %1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    %13:sreg_64_xexec = COPY %12
    %14:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, %13, implicit $exec
    S_ENDPGM 0
...

# Same COPY, but lanes leave through a divergent SI_LOOP, so lowerCopiesToI1
# must keep the merge.
---
name:            divergent_latch_copy_used_outside
tracksRegLiveness: true
body:             |
  ; GCN-LABEL: name: divergent_latch_copy_used_outside
  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT:   liveins: $vgpr0, $sgpr0
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; GCN-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 0
  ; GCN-NEXT:   [[S_MOV_B64_:%[0-9]+]]:sreg_64 = S_MOV_B64 0
  ; GCN-NEXT:   [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
  ; GCN-NEXT:   S_BRANCH %bb.1
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[PHI:%[0-9]+]]:sreg_64 = PHI [[DEF]], %bb.0, %8, %bb.1
  ; GCN-NEXT:   [[PHI1:%[0-9]+]]:sreg_32 = PHI [[S_MOV_B32_]], %bb.0, %4, %bb.1
  ; GCN-NEXT:   [[PHI2:%[0-9]+]]:sreg_64 = PHI [[S_MOV_B64_]], %bb.0, %6, %bb.1
  ; GCN-NEXT:   [[V_CMP_NE_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_NE_U32_e64 [[COPY]], [[PHI1]], implicit $exec
  ; GCN-NEXT:   [[S_ANDN2_B64_:%[0-9]+]]:sreg_64 = S_ANDN2_B64 [[PHI]], $exec, implicit-def dead $scc
  ; GCN-NEXT:   [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[V_CMP_NE_U32_e64_]], $exec, implicit-def dead $scc
  ; GCN-NEXT:   [[S_OR_B64_:%[0-9]+]]:sreg_64 = S_OR_B64 [[S_ANDN2_B64_]], [[S_AND_B64_]], implicit-def dead $scc
  ; GCN-NEXT:   [[S_ADD_I32_:%[0-9]+]]:sreg_32 = S_ADD_I32 [[PHI1]], 1, implicit-def dead $scc
  ; GCN-NEXT:   [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_EQ_U32_e64 [[COPY]], [[S_ADD_I32_]], implicit $exec
  ; GCN-NEXT:   [[SI_IF_BREAK:%[0-9]+]]:sreg_64 = SI_IF_BREAK [[V_CMP_EQ_U32_e64_]], [[PHI2]], implicit-def dead $scc
  ; GCN-NEXT:   SI_LOOP [[SI_IF_BREAK]], %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; GCN-NEXT:   S_BRANCH %bb.2
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.2:
  ; GCN-NEXT:   SI_END_CF [[SI_IF_BREAK]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; GCN-NEXT:   [[COPY1:%[0-9]+]]:sreg_64_xexec = COPY [[S_OR_B64_]]
  ; GCN-NEXT:   [[V_CNDMASK_B32_e64_:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, [[COPY1]], implicit $exec
  ; GCN-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    %2:sreg_32 = S_MOV_B32 0
    %20:sreg_64 = S_MOV_B64 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2

    %5:sreg_32 = PHI %2, %bb.0, %10, %bb.1
    %21:sreg_64 = PHI %20, %bb.0, %23, %bb.1
    %9:sreg_64 = V_CMP_NE_U32_e64 %0, %5, implicit $exec
    %12:vreg_1 = COPY %9
    %10:sreg_32 = S_ADD_I32 %5, 1, implicit-def dead $scc
    %22:sreg_64 = V_CMP_EQ_U32_e64 %0, %10, implicit $exec
    %23:sreg_64 = SI_IF_BREAK %22, %21, implicit-def dead $scc
    SI_LOOP %23, %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    SI_END_CF %23, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    %13:sreg_64_xexec = COPY %12
    %14:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, %13, implicit $exec
    S_ENDPGM 0
...

# A uniform inner loop (bb.2) nested in a divergent outer loop (latch bb.3).
# The inner back-edge needs no merges, but the outer loop must keep them.
---
name:            uniform_inner_divergent_outer
tracksRegLiveness: true
body:             |
  ; GCN-LABEL: name: uniform_inner_divergent_outer
  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT:   liveins: $vgpr0, $sgpr0
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; GCN-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; GCN-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 0
  ; GCN-NEXT:   [[S_MOV_B64_:%[0-9]+]]:sreg_64 = S_MOV_B64 -1
  ; GCN-NEXT:   [[S_MOV_B64_1:%[0-9]+]]:sreg_64 = S_MOV_B64 0
  ; GCN-NEXT:   [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
