    %1:sreg_32 = COPY $sgpr0
    %18:sreg_32 = COPY $sgpr1
    %2:sreg_32 = S_MOV_B32 0
    %3:sreg_64 = S_MOV_B64 -1
    %4:vreg_1 = COPY %3
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %5:sreg_32 = PHI %2, %bb.0, %15, %bb.2, %15, %bb.5
    %6:vreg_1 = PHI %4, %bb.0, %17, %bb.2, %11, %bb.5
    %15:sreg_32 = S_ADD_I32 %5, 1, implicit-def dead $scc
    S_CMP_EQ_U32 %5, %18, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.1

    %16:sreg_64 = V_CMP_EQ_U32_e64 %0, %5, implicit $exec
    %17:vreg_1 = COPY %16
    S_BRANCH %bb.1

  bb.3:
    successors: %bb.4, %bb.5

    %7:sreg_64 = COPY %6
