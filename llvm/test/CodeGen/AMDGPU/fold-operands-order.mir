# RUN: llc -mtriple=amdgpu7.01--amdhsa -run-pass si-fold-operands -o - %s | FileCheck -check-prefix=GCN %s
...
---

# Blocks should be processed in program order to make sure folds
# aren't made in users before the def is seen.

# GCN-LABEL: name: mov_in_use_list_2x{{$}}
# GCN: %2:vgpr_32 = COPY undef %3


name: mov_in_use_list_2x
tracksRegLiveness: true
liveins:
body:             |
  bb.0:
    successors: %bb.2

    S_BRANCH %bb.2

  bb.1:
    successors: %bb.2

    %2:vgpr_32 = COPY %1
    %3:vgpr_32 = V_XOR_B32_e64 %2, undef %0:vgpr_32, implicit $exec
    S_NOP 0, implicit %3

  bb.2:
    successors: %bb.1

    %1:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    S_BRANCH %bb.1

...
