# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.42 -run-pass=machine-loops,si-pre-emit-peephole -amdgpu-gfx9-cross-wave-valu-coexec-opt-threshold=0 -o - %s | FileCheck -check-prefix=NONOP %s
# RUN: llc -mtriple=amdgpu9.0a -run-pass=machine-loops,si-pre-emit-peephole -o - %s | FileCheck -check-prefix=NONOP %s
# RUN: llc -mtriple=amdgpu9.42 -run-pass=machine-loops,si-pre-emit-peephole,post-RA-hazard-rec -o - %s | FileCheck -check-prefix=HAZARD %s

# V_CNDMASK_B32 reading VCC needs 2 wait states after V_CMP writes it. The
# hazard recognizer counts the s_nop 0 inserted between them as one of them and
# adds only one more.

---
name: nop_with_hazard_nop
tracksRegLiveness: true
machineFunctionInfo:
  occupancy: 8
body: |
  ; NONOP-LABEL: name: nop_with_hazard_nop
  ; NONOP: bb.0:
  ; NONOP-NEXT:   successors: %bb.1(0x80000000)
  ; NONOP-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $scc
  ; NONOP-NEXT: {{  $}}
  ; NONOP-NEXT: bb.1:
  ; NONOP-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; NONOP-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $scc
  ; NONOP-NEXT: {{  $}}
  ; NONOP-NEXT:   V_CMP_EQ_U32_e32 0, $vgpr0, implicit-def $vcc, implicit $exec
  ; NONOP-NEXT:   $vgpr4 = V_CNDMASK_B32_e32 $vgpr1, $vgpr2, implicit $vcc, implicit $exec
  ; NONOP-NEXT:   $vgpr5 = V_XOR_B32_e32 $vgpr2, $vgpr4, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr1, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; NONOP-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; NONOP-NEXT: {{  $}}
  ; NONOP-NEXT: bb.2:
  ; NONOP-NEXT:   liveins: $vgpr5, $vgpr20
  ; NONOP-NEXT: {{  $}}
  ; NONOP-NEXT:   S_ENDPGM 0, implicit $vgpr5, implicit $vgpr20
  ;
  ; HAZARD-LABEL: name: nop_with_hazard_nop
  ; HAZARD: bb.0:
  ; HAZARD-NEXT:   successors: %bb.1(0x80000000)
  ; HAZARD-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $scc
  ; HAZARD-NEXT: {{  $}}
  ; HAZARD-NEXT: bb.1:
  ; HAZARD-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; HAZARD-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $scc
  ; HAZARD-NEXT: {{  $}}
  ; HAZARD-NEXT:   V_CMP_EQ_U32_e32 0, $vgpr0, implicit-def $vcc, implicit $exec
  ; HAZARD-NEXT:   S_NOP 0
  ; HAZARD-NEXT:   S_NOP 0
  ; HAZARD-NEXT:   $vgpr4 = V_CNDMASK_B32_e32 $vgpr1, $vgpr2, implicit $vcc, implicit $exec
  ; HAZARD-NEXT:   $vgpr5 = V_XOR_B32_e32 $vgpr2, $vgpr4, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr1, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; HAZARD-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; HAZARD-NEXT: {{  $}}
  ; HAZARD-NEXT: bb.2:
  ; HAZARD-NEXT:   liveins: $vgpr5, $vgpr20
  ; HAZARD-NEXT: {{  $}}
  ; HAZARD-NEXT:   S_ENDPGM 0, implicit $vgpr5, implicit $vgpr20
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $scc

  bb.1:
    liveins: $vgpr0, $vgpr1, $vgpr2, $scc
    V_CMP_EQ_U32_e32 0, $vgpr0, implicit-def $vcc, implicit $exec
    $vgpr4 = V_CNDMASK_B32_e32 $vgpr1, $vgpr2, implicit $vcc, implicit $exec
    $vgpr5 = V_XOR_B32_e32 $vgpr2, $vgpr4, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr1, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2:
    liveins: $vgpr5, $vgpr20
    S_ENDPGM 0, implicit $vgpr5, implicit $vgpr20
...
