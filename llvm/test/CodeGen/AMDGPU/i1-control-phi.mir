# RUN: llc -mtriple=amdgpu12.01-amd-amdhsa -run-pass=si-i1-copies -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: CSMain
# CHECK-NOT: S_ANDN2_B32
# CHECK-NOT: S_AND_B32 {{.*}}$exec_lo
# CHECK-NOT: S_OR_B32

---
name: CSMain
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0
    %7:sreg_32 = V_CMP_NE_U32_e64 %0, 0, implicit $exec
    %1:vreg_1 = COPY %7, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.4

    %2:vreg_1 = PHI %1, %bb.0, %4, %bb.3
    %5:sreg_32 = COPY %2
    %6:sreg_32 = SI_IF %5, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.3, %bb.4

    %8:vreg_1 = PHI %2, %bb.1
    %9:sreg_32 = COPY %8
    %10:sreg_32 = SI_IF %9, %bb.3, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.1

    %11:sreg_32 = V_CMP_NE_U32_e64 %0, 1, implicit $exec
    %4:vreg_1 = COPY %11, implicit $exec
    S_BRANCH %bb.1

  bb.4:
    S_ENDPGM 0
...
