# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.01 -passes='greedy<sgpr>' \
# RUN:   -stress-regalloc=4 -verify-regalloc -o - %s | FileCheck %s
#
# %2 is a live range split that only defines the sub2_sub3 lanes of %0. All
# splits of %0 share one stack slot, and the spill stores the whole register,
# so hoisting the spill of %2 to its def would write undefined sub0_sub1 lanes
# over the lanes another split holds in that slot. Reject the hoist and spill
# %2 after its last use instead.

--- |
  define amdgpu_kernel void @partial_sibling_spill() {
    ret void
  }
...
---
name:            partial_sibling_spill
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: sgpr_128 }
  - { id: 1, class: sgpr_128, split-from: '%0' }
  - { id: 2, class: sgpr_128, split-from: '%0' }
  - { id: 3, class: sgpr_128, split-from: '%0' }
  - { id: 10, class: sgpr_128 }
  - { id: 11, class: sgpr_128 }
  - { id: 12, class: sgpr_128 }
  - { id: 13, class: sgpr_128 }
body: |
  ; CHECK-LABEL: name: partial_sibling_spill
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[KILL:%[0-9]+]]:sgpr_128 = KILL
  ; CHECK-NEXT:   [[KILL1:%[0-9]+]]:sgpr_128 = KILL
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE [[KILL1]], %stack.1, implicit $exec, implicit $sgpr32 :: (store (s128) into %stack.1, align 4, addrspace 5)
  ; CHECK-NEXT:   [[KILL2:%[0-9]+]]:sgpr_128 = KILL
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE [[KILL2]], %stack.2, implicit $exec, implicit $sgpr32 :: (store (s128) into %stack.2, align 4, addrspace 5)
  ; CHECK-NEXT:   [[KILL3:%[0-9]+]]:sgpr_128 = KILL
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE [[KILL3]], %stack.0, implicit $exec, implicit $sgpr32 :: (store (s128) into %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   [[KILL4:%[0-9]+]]:sgpr_128 = KILL
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE [[KILL4]], %stack.3, implicit $exec, implicit $sgpr32 :: (store (s128) into %stack.3, align 4, addrspace 5)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr_128 = lr-split COPY [[KILL]]
  ; CHECK-NEXT:   KILL [[COPY]]
  ; CHECK-NEXT:   undef [[COPY1:%[0-9]+]].sub2_sub3:sgpr_128 = lr-split COPY [[COPY]].sub2_sub3
  ; CHECK-NEXT:   SI_SPILL_S128_SAVE [[COPY1]], %stack.4, implicit $exec, implicit $sgpr32 :: (store (s128) into %stack.4, align 4, addrspace 5)
  ; CHECK-NEXT:   KILL [[COPY1]].sub2_sub3
  ; CHECK-NEXT:   KILL [[COPY1]].sub2_sub3
  ; CHECK-NEXT:   KILL [[KILL]]
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.2, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.2, align 4, addrspace 5)
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE1:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.1, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.1, align 4, addrspace 5)
  ; CHECK-NEXT:   KILL [[SI_SPILL_S128_RESTORE1]], [[SI_SPILL_S128_RESTORE]]
  ; CHECK-NEXT:   KILL [[KILL]]
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE2:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.0, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE3:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.3, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.3, align 4, addrspace 5)
  ; CHECK-NEXT:   KILL [[SI_SPILL_S128_RESTORE2]], [[SI_SPILL_S128_RESTORE3]]
  ; CHECK-NEXT:   KILL [[KILL]]
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE4:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.1, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.1, align 4, addrspace 5)
  ; CHECK-NEXT:   KILL [[SI_SPILL_S128_RESTORE4]], [[SI_SPILL_S128_RESTORE]]
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE5:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.4, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.4, align 4, addrspace 5)
  ; CHECK-NEXT:   undef [[COPY2:%[0-9]+]].sub2_sub3:sgpr_128 = lr-split COPY [[SI_SPILL_S128_RESTORE5]].sub2_sub3
  ; CHECK-NEXT:   KILL [[COPY2]].sub2_sub3
  ; CHECK-NEXT:   KILL [[COPY2]].sub2_sub3
  ; CHECK-NEXT:   S_CMP_EQ_U32 0, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   KILL [[KILL]]
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE6:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.0, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE7:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.1, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.1, align 4, addrspace 5)
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE8:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.2, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.2, align 4, addrspace 5)
  ; CHECK-NEXT:   [[SI_SPILL_S128_RESTORE9:%[0-9]+]]:sgpr_128 = SI_SPILL_S128_RESTORE %stack.3, implicit $exec, implicit $sgpr32 :: (load (s128) from %stack.3, align 4, addrspace 5)
  ; CHECK-NEXT:   KILL [[SI_SPILL_S128_RESTORE7]], [[SI_SPILL_S128_RESTORE8]], [[SI_SPILL_S128_RESTORE6]], [[SI_SPILL_S128_RESTORE9]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    %0:sgpr_128 = KILL
    %10:sgpr_128 = KILL
    %11:sgpr_128 = KILL
    %12:sgpr_128 = KILL
    %13:sgpr_128 = KILL

  bb.1:
    successors: %bb.1, %bb.2
    %1:sgpr_128 = lr-split COPY %0:sgpr_128
    KILL %1:sgpr_128
    undef %2.sub2_sub3:sgpr_128 = lr-split COPY %1.sub2_sub3:sgpr_128
    KILL %2.sub2_sub3:sgpr_128
    KILL %2.sub2_sub3:sgpr_128
    %3:sgpr_128 = lr-split COPY %2:sgpr_128
    KILL %0:sgpr_128
    KILL %10:sgpr_128, %11:sgpr_128
    KILL %0:sgpr_128
    KILL %12:sgpr_128, %13:sgpr_128
    KILL %0:sgpr_128
    KILL %10:sgpr_128, %11:sgpr_128
    KILL %3.sub2_sub3:sgpr_128
    KILL %3.sub2_sub3:sgpr_128
    S_CMP_EQ_U32 0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.2:
    KILL %0:sgpr_128
    KILL %10:sgpr_128, %11:sgpr_128, %12:sgpr_128, %13:sgpr_128
    S_ENDPGM 0
...
