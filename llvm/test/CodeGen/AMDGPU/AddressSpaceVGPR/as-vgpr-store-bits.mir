# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.00-- -passes=finalize-isel -o - %s | FileCheck %s --check-prefix=GFX12
# RUN: llc -mtriple=amdgpu8.03-- -passes=finalize-isel -o - %s | FileCheck %s --check-prefix=GFX8

# The custom inserter expands a store into part of a dword in the VGPR address
# space into the whole-dword load and store of its form and a V_BFI, each with
# the memory operand of its half of the access. gfx8 takes no literal in VOP3,
# so a literal mask is moved into a register there.

---
name: store_bits
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0, $vgpr1
    ; GFX12-LABEL: name: store_bits
    ; GFX12: liveins: $sgpr0, $vgpr0, $vgpr1
    ; GFX12-NEXT: {{  $}}
    ; GFX12-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GFX12-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; GFX12-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; GFX12-NEXT: $m0 = COPY [[COPY]]
    ; GFX12-NEXT: [[V_LOAD_IDX_B32_:%[0-9]+]]:vgpr_32 = V_LOAD_IDX_B32 0, implicit $m0, implicit $exec :: (load (s32), addrspace 13)
    ; GFX12-NEXT: [[V_BFI_B32_e64_:%[0-9]+]]:vgpr_32 = V_BFI_B32_e64 [[COPY2]], [[COPY1]], [[V_LOAD_IDX_B32_]], implicit $exec
    ; GFX12-NEXT: V_STORE_IDX_B32 [[V_BFI_B32_e64_]], 0, implicit $m0, implicit $exec :: (store (s32), addrspace 13)
    ; GFX12-NEXT: SI_RETURN
    ;
    ; GFX8-LABEL: name: store_bits
    ; GFX8: liveins: $sgpr0, $vgpr0, $vgpr1
    ; GFX8-NEXT: {{  $}}
    ; GFX8-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GFX8-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; GFX8-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; GFX8-NEXT: $m0 = COPY [[COPY]]
    ; GFX8-NEXT: [[V_LOAD_IDX_B32_:%[0-9]+]]:vgpr_32 = V_LOAD_IDX_B32 0, implicit $m0, implicit $exec :: (load (s32), addrspace 13)
    ; GFX8-NEXT: [[V_BFI_B32_e64_:%[0-9]+]]:vgpr_32 = V_BFI_B32_e64 [[COPY2]], [[COPY1]], [[V_LOAD_IDX_B32_]], implicit $exec
    ; GFX8-NEXT: V_STORE_IDX_B32 [[V_BFI_B32_e64_]], 0, implicit $m0, implicit $exec :: (store (s32), addrspace 13)
    ; GFX8-NEXT: SI_RETURN
    %0:sreg_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    %2:vgpr_32 = COPY $vgpr1
    $m0 = COPY %0
    V_STORE_IDX_BITS %1, 0, %2, implicit $m0, implicit $exec :: (load store (s32), addrspace 13)
    SI_RETURN
...

