# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.42-- -passes=finalize-isel -o - %s | FileCheck %s

# The custom inserter expands a store into part of a dword in the VGPR address
# space into the whole-dword load and store of the VGPR indexing mode form and a
# V_BFI. A literal mask is moved into a register, as VOP3 takes none here.

---
name: store_bits
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $vgpr0
    ; CHECK-LABEL: name: store_bits
    ; CHECK: liveins: $sgpr0, $sgpr1, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; CHECK-NEXT: [[V_LOAD_IDX_GPR_IDX_B32_:%[0-9]+]]:vgpr_32 = V_LOAD_IDX_GPR_IDX_B32 [[COPY]], 0, implicit-def dead $m0, implicit $m0, implicit $exec :: (load (s32), addrspace 13)
    ; CHECK-NEXT: [[V_BFI_B32_e64_:%[0-9]+]]:vgpr_32 = V_BFI_B32_e64 [[COPY2]], [[COPY1]], [[V_LOAD_IDX_GPR_IDX_B32_]], implicit $exec
    ; CHECK-NEXT: V_STORE_IDX_GPR_IDX_B32 [[V_BFI_B32_e64_]], [[COPY]], 0, implicit-def dead $m0, implicit $m0, implicit $exec :: (store (s32), addrspace 13)
    ; CHECK-NEXT: SI_RETURN
    %0:sreg_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    %2:sreg_32 = COPY $sgpr1
    V_STORE_IDX_GPR_IDX_BITS %1, %0, 0, %2, implicit-def dead $m0, implicit $m0, implicit $exec :: (load store (s32), addrspace 13)
    SI_RETURN
...

---
name: store_bits_imm_mask_offset
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0
    ; CHECK-LABEL: name: store_bits_imm_mask_offset
    ; CHECK: liveins: $sgpr0, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_LOAD_IDX_GPR_IDX_B32_:%[0-9]+]]:vgpr_32 = V_LOAD_IDX_GPR_IDX_B32 [[COPY]], 3, implicit-def dead $m0, implicit $m0, implicit $exec :: (volatile load (s32), addrspace 13)
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 65280, implicit $exec
    ; CHECK-NEXT: [[V_BFI_B32_e64_:%[0-9]+]]:vgpr_32 = V_BFI_B32_e64 [[V_MOV_B32_e32_]], [[COPY1]], [[V_LOAD_IDX_GPR_IDX_B32_]], implicit $exec
    ; CHECK-NEXT: V_STORE_IDX_GPR_IDX_B32 [[V_BFI_B32_e64_]], [[COPY]], 3, implicit-def dead $m0, implicit $m0, implicit $exec :: (volatile store (s32), addrspace 13)
    ; CHECK-NEXT: SI_RETURN
    %0:sreg_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    V_STORE_IDX_GPR_IDX_BITS %1, %0, 3, 65280, implicit-def dead $m0, implicit $m0, implicit $exec :: (volatile load store (s32), addrspace 13)
    SI_RETURN
...
