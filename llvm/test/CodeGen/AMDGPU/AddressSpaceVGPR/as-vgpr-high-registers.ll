; With more than 256 VGPRs, a move whose base register is v256 or above needs
; S_SET_VGPR_MSB, or only the low eight bits are encoded. SelectionDAG can fold
; a constant offset into the base register and so reach a high base; GlobalISel
; folds it into the index and always uses v0 as the base.

; The dword index is %i + 254, so a four-dword access spans v254, v255, v256 and
; v257 relative to M0.
define void @fold_across_256(ptr addrspace(1) %out, i32 inreg %i) {
; SDAG-LABEL: fold_across_256:
; SDAG:       ; %bb.0:
; SDAG-NEXT:    s_wait_loadcnt_dscnt 0x0
; SDAG-NEXT:    s_wait_kmcnt 0x0
; SDAG-NEXT:    s_mov_b32 m0, s0
; SDAG-NEXT:    v_movrels_b32_e32 v2, v254
; SDAG-NEXT:    v_movrels_b32_e32 v3, v255
; SDAG-NEXT:    s_set_vgpr_msb 1 ; msbs: dst=0 src0=1 src1=0 src2=0
; SDAG-NEXT:    v_movrels_b32_e32 v4, v0 /*v256*/
; SDAG-NEXT:    v_movrels_b32_e32 v5, v1 /*v257*/
; SDAG-NEXT:    s_set_vgpr_msb 0x100 ; msbs: dst=0 src0=0 src1=0 src2=0
; SDAG-NEXT:    global_store_b128 v[0:1], v[2:5], off
; SDAG-NEXT:    s_set_pc_i64 s[30:31]
;
; GISEL-LABEL: fold_across_256:
; GISEL:       ; %bb.0:
; GISEL-NEXT:    s_wait_loadcnt_dscnt 0x0
; GISEL-NEXT:    s_wait_kmcnt 0x0
; GISEL-NEXT:    s_lshl2_add_u32 s0, s0, 0x3f8
; GISEL-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_2) | instid1(VALU_DEP_2)
; GISEL-NEXT:    s_lshr_b32 m0, s0, 2
; GISEL-NEXT:    v_movrels_b32_e32 v2, v0
; GISEL-NEXT:    v_movrels_b32_e32 v3, v1
; GISEL-NEXT:    v_movrels_b32_e32 v4, v2
; GISEL-NEXT:    s_delay_alu instid0(VALU_DEP_2)
; GISEL-NEXT:    v_movrels_b32_e32 v5, v3
; GISEL-NEXT:    global_store_b128 v[0:1], v[2:5], off
; GISEL-NEXT:    s_set_pc_i64 s[30:31]
  %s = shl nuw i32 %i, 2
  %a = add nuw i32 %s, 1016
  %p = inttoptr i32 %a to ptr addrspace(13)
  %v = load <4 x i32>, ptr addrspace(13) %p, align 16
  store <4 x i32> %v, ptr addrspace(1) %out, align 16
  ret void
}

