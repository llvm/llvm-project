    ; CHECK-NEXT: [[S_ANDN2_B32_1:%[0-9]+]]:sreg_32_xm0_xexec = S_ANDN2_B32 [[PHI1]], $exec_lo, implicit-def $scc
    ; CHECK-NEXT: $exec_lo = S_MOV_B32_term [[S_ANDN2_B32_1]]
    ; CHECK-NEXT: SI_WATERFALL_LOOP %bb.1, implicit $exec
