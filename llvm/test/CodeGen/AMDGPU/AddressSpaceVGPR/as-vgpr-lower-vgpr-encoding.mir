# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx942 -run-pass=amdgpu-lower-vgpr-encoding -verify-machineinstrs -o - %s | FileCheck %s

# Selection never folds an offset past the addressable VGPRs, but MIR can still
# hold one. It is masked into range rather than naming a register that does not
# exist. The range is 256 here: gfx942 counts its AGPRs as addressable, and an
# index cannot reach them.

---
name: load_past_end
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0
    ; CHECK-LABEL: name: load_past_end
    ; CHECK: liveins: $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $m0 = S_MOV_B32 $sgpr0
    ; CHECK-NEXT: $vgpr0 = V_MOVRELS_B32_as_mem undef $vgpr44, implicit $m0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $m0 = S_MOV_B32 $sgpr0
    $vgpr0 = V_LOAD_IDX_B32 300, implicit $m0, implicit $exec :: (load (s32), addrspace 13)
    S_ENDPGM 0, implicit $vgpr0
...

---
name: store_straddling_end
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $vgpr4_vgpr5_vgpr6_vgpr7
    ; CHECK-LABEL: name: store_straddling_end
    ; CHECK: liveins: $sgpr0, $vgpr4_vgpr5_vgpr6_vgpr7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $m0 = S_MOV_B32 $sgpr0
    ; CHECK-NEXT: V_MOVRELD_B32_as_mem undef $vgpr254, $vgpr4, implicit $m0, implicit $exec
    ; CHECK-NEXT: V_MOVRELD_B32_as_mem undef $vgpr255, $vgpr5, implicit $m0, implicit $exec
    ; CHECK-NEXT: V_MOVRELD_B32_as_mem undef $vgpr0, $vgpr6, implicit $m0, implicit $exec
    ; CHECK-NEXT: V_MOVRELD_B32_as_mem undef $vgpr1, $vgpr7, implicit $m0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $m0 = S_MOV_B32 $sgpr0
    V_STORE_IDX_B128 $vgpr4_vgpr5_vgpr6_vgpr7, 254, implicit $m0, implicit $exec :: (store (s128), addrspace 13)
    S_ENDPGM 0
...

---
name: gpr_idx_load_past_end
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0
    ; CHECK-LABEL: name: gpr_idx_load_past_end
    ; CHECK: liveins: $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE implicit-def $m0, implicit-def $mode, implicit-def $vgpr0, implicit $sgpr0, implicit $m0, implicit $mode, implicit undef $vgpr44, implicit $exec {
    ; CHECK-NEXT:   S_SET_GPR_IDX_ON $sgpr0, 1, implicit-def $m0, implicit-def undef $mode, implicit $m0, implicit $mode
    ; CHECK-NEXT:   $vgpr0 = V_MOV_B32_indirect_read undef $vgpr44, implicit $exec, implicit internal $m0
    ; CHECK-NEXT:   S_SET_GPR_IDX_OFF implicit-def $mode, implicit internal $mode
    ; CHECK-NEXT: }
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    $vgpr0 = V_LOAD_IDX_GPR_IDX_B32 $sgpr0, 300, implicit-def $m0, implicit $m0, implicit $exec :: (load (s32), addrspace 13)
    S_ENDPGM 0, implicit $vgpr0
...
