# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=pipeliner -pass-remarks-analysis=pipeliner %s -o /dev/null 2>&1 | FileCheck %s

# ProcessImplicitDefs, which runs after the pipeliner, marks the reads of values
# that only come from IMPLICIT_DEF undef and deletes their definitions. Check
# that the register pressure detector leaves such reads out, and still counts
# the reads that ProcessImplicitDefs keeps.
#
# "amdgpu-num-vgpr"="4" limits both functions to 8 VGPRs.

# In implicit_def_reads, the old operand of each DPP move only comes from an
# IMPLICIT_DEF: through a COPY hoisted to the preheader, as MachineLICM does,
# through a COPY in the loop, or directly. Counted as registers, they would
# need more than 8 VGPRs, and the detector would reject every schedule.
# CHECK-NOT: Unable to find schedule
# CHECK: Schedule found with Initiation Interval

# In tied_and_other_read, each DPP add reads its IMPLICIT_DEF value through the
# tied old operand and through src1. ProcessImplicitDefs keeps these reads, so
# they need more than 8 VGPRs, and the detector rejects every schedule.
# CHECK-NOT: Schedule found
# CHECK: Unable to find schedule

--- |
  define amdgpu_kernel void @implicit_def_reads() #0 {
    ret void
  }

  define amdgpu_kernel void @tied_and_other_read() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" }
...
---
name:            implicit_def_reads
tracksRegLiveness: true
isSSA:           true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    %n:sreg_32 = COPY $sgpr0
    %tid:vgpr_32 = COPY $vgpr0
    %zero:sreg_32 = S_MOV_B32 0
    %vzero:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %imp0:sreg_32 = IMPLICIT_DEF
    %old0:vgpr_32 = COPY %imp0
    %imp1:sreg_32 = IMPLICIT_DEF
    %old1:vgpr_32 = COPY %imp1
    %imp2:sreg_32 = IMPLICIT_DEF
    %old2:vgpr_32 = COPY %imp2
    %imp3:sreg_32 = IMPLICIT_DEF
    %old3:vgpr_32 = COPY %imp3
    %imp4:sreg_32 = IMPLICIT_DEF
    %old4:vgpr_32 = COPY %imp4
    %imp5:sreg_32 = IMPLICIT_DEF
    %old5:vgpr_32 = COPY %imp5
    %imp6:sreg_32 = IMPLICIT_DEF
    %old7:vgpr_32 = IMPLICIT_DEF

  bb.1:
    successors: %bb.1, %bb.2

    %i:sreg_32 = PHI %zero, %bb.0, %i_next, %bb.1
    %acc:vgpr_32 = PHI %vzero, %bb.0, %acc_next, %bb.1
    %addr:vgpr_32 = V_ADD_U32_e32 %i, %tid, implicit $exec
    %x:vgpr_32 = DS_READ_B32_gfx9 %addr, 0, 0, implicit $exec
    %d0:vgpr_32 = V_MOV_B32_dpp %old0, %x, 273, 15, 15, 0, implicit $exec
    %d1:vgpr_32 = V_MOV_B32_dpp %old1, %d0, 273, 15, 15, 0, implicit $exec
    %d2:vgpr_32 = V_MOV_B32_dpp %old2, %d1, 273, 15, 15, 0, implicit $exec
    %d3:vgpr_32 = V_MOV_B32_dpp %old3, %d2, 273, 15, 15, 0, implicit $exec
    %d4:vgpr_32 = V_MOV_B32_dpp %old4, %d3, 273, 15, 15, 0, implicit $exec
    %d5:vgpr_32 = V_MOV_B32_dpp %old5, %d4, 273, 15, 15, 0, implicit $exec
    %old6:vgpr_32 = COPY %imp6
    %d6:vgpr_32 = V_MOV_B32_dpp %old6, %d5, 273, 15, 15, 0, implicit $exec
    %d7:vgpr_32 = V_MOV_B32_dpp %old7, %d6, 273, 15, 15, 0, implicit $exec
    %acc_next:vgpr_32 = V_ADD_U32_e32 %acc, %d7, implicit $exec
    %i_next:sreg_32 = S_ADD_I32 %i, 1, implicit-def dead $scc
    S_CMP_LT_I32 %i_next, %n, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
---
name:            tied_and_other_read
tracksRegLiveness: true
isSSA:           true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    %n:sreg_32 = COPY $sgpr0
    %tid:vgpr_32 = COPY $vgpr0
    %zero:sreg_32 = S_MOV_B32 0
    %vzero:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %imp0:sreg_32 = IMPLICIT_DEF
    %old0:vgpr_32 = COPY %imp0
    %imp1:sreg_32 = IMPLICIT_DEF
    %old1:vgpr_32 = COPY %imp1
    %imp2:sreg_32 = IMPLICIT_DEF
    %old2:vgpr_32 = COPY %imp2
    %imp3:sreg_32 = IMPLICIT_DEF
    %old3:vgpr_32 = COPY %imp3
    %imp4:sreg_32 = IMPLICIT_DEF
    %old4:vgpr_32 = COPY %imp4
    %imp5:sreg_32 = IMPLICIT_DEF
    %old5:vgpr_32 = COPY %imp5
    %imp6:sreg_32 = IMPLICIT_DEF
    %old6:vgpr_32 = COPY %imp6
    %imp7:sreg_32 = IMPLICIT_DEF
    %old7:vgpr_32 = COPY %imp7

  bb.1:
    successors: %bb.1, %bb.2

    %i:sreg_32 = PHI %zero, %bb.0, %i_next, %bb.1
    %acc:vgpr_32 = PHI %vzero, %bb.0, %acc_next, %bb.1
    %addr:vgpr_32 = V_ADD_U32_e32 %i, %tid, implicit $exec
    %x:vgpr_32 = DS_READ_B32_gfx9 %addr, 0, 0, implicit $exec
    %d0:vgpr_32 = V_ADD_U32_dpp %old0, %x, %old0, 273, 15, 15, 0, implicit $exec
    %d1:vgpr_32 = V_ADD_U32_dpp %old1, %d0, %old1, 273, 15, 15, 0, implicit $exec
    %d2:vgpr_32 = V_ADD_U32_dpp %old2, %d1, %old2, 273, 15, 15, 0, implicit $exec
    %d3:vgpr_32 = V_ADD_U32_dpp %old3, %d2, %old3, 273, 15, 15, 0, implicit $exec
    %d4:vgpr_32 = V_ADD_U32_dpp %old4, %d3, %old4, 273, 15, 15, 0, implicit $exec
    %d5:vgpr_32 = V_ADD_U32_dpp %old5, %d4, %old5, 273, 15, 15, 0, implicit $exec
    %d6:vgpr_32 = V_ADD_U32_dpp %old6, %d5, %old6, 273, 15, 15, 0, implicit $exec
    %d7:vgpr_32 = V_ADD_U32_dpp %old7, %d6, %old7, 273, 15, 15, 0, implicit $exec
    %acc_next:vgpr_32 = V_ADD_U32_e32 %acc, %d7, implicit $exec
    %i_next:sreg_32 = S_ADD_I32 %i, 1, implicit-def dead $scc
    S_CMP_LT_I32 %i_next, %n, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
