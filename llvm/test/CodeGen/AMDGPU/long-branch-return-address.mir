# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "S_(GETPC_B64|ADD_U32|ADDC_U32|SETPC_B64|MOV_B64)" --version 6
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -amdgpu-s-branch-bits=4 \
# RUN:   -passes=amdgpu-pre-ra-long-branch-reg %s -o %t
# RUN: FileCheck %s --check-prefix=RESERVE < %t
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -amdgpu-s-branch-bits=4 \
# RUN:   -passes=amdgpu-pre-ra-long-branch-reg,prolog-epilog,post-ra-pseudos,branch-relaxation \
# RUN:   %s -o - | FileCheck %s

# The return-address use is hidden in SI_RETURN when frame lowering moves the
# scratch reservation. With the low caller-clobbered pairs in use, the next
# scratch pair must preserve the return address and callee-saved registers.

# FIXME: The initial reservation picks a callee-saved pair. Frame lowering
# then moves the reservation to the return-address pair.
# RESERVE: longBranchReservedReg: '$sgpr100_sgpr101'
---
name: preserve_return_address
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: preserve_return_address
  ; CHECK: bb.0:
  ; CHECK: bb.3:
  ; CHECK:   $sgpr30_sgpr31 = S_GETPC_B64 post-instr-symbol <mcsymbol >
  ; CHECK-NEXT:   $sgpr30 = S_ADD_U32 $sgpr30, target-flags(<unknown target flag>) <mcsymbol >, implicit-def $scc
  ; CHECK-NEXT:   $sgpr31 = S_ADDC_U32 $sgpr31, target-flags(<unknown target flag>) <mcsymbol >, implicit-def $scc, implicit $scc
  ; CHECK-NEXT:   S_SETPC_B64 $sgpr30_sgpr31
  ; CHECK: bb.1:
  ; CHECK: bb.2:
  ; CHECK-NEXT:   S_SETPC_B64_return undef $sgpr30_sgpr31
  bb.0:
    S_NOP 0, implicit-def $sgpr4_sgpr5_sgpr6_sgpr7, implicit-def $sgpr8_sgpr9_sgpr10_sgpr11
    S_NOP 0, implicit-def $sgpr12_sgpr13_sgpr14_sgpr15, implicit-def $sgpr16_sgpr17_sgpr18_sgpr19
    S_NOP 0, implicit-def $sgpr20_sgpr21_sgpr22_sgpr23, implicit-def $sgpr24_sgpr25_sgpr26_sgpr27, implicit-def $sgpr28_sgpr29
    S_CMP_EQ_U32 $sgpr4, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit killed $scc

  bb.1:
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_BRANCH %bb.2

  bb.2:
    SI_RETURN
...
