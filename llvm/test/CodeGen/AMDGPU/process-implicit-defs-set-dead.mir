# RUN: llc -mtriple=amdgpu9.00 -passes=process-implicit-defs -o - %s | FileCheck %s

# Successor live-ins given as a super-register with a lane mask.

---
name:            livein_super_lanemask_covers
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: livein_super_lanemask_covers
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0 = IMPLICIT_DEF
  ; CHECK-NEXT:   $sgpr2 = COPY undef $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $sgpr2, $sgpr0_sgpr1:0x0000000000000003
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $sgpr2, implicit $sgpr0
  bb.0:
    successors: %bb.1

    $sgpr0 = IMPLICIT_DEF
    $sgpr2 = COPY $sgpr0

  bb.1:
    liveins: $sgpr2, $sgpr0_sgpr1:0x0000000000000003

    S_ENDPGM 0, implicit $sgpr2, implicit $sgpr0
...
