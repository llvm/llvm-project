# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.00 -run-pass=amdgpu-insert-delay-alu %s -o - | FileCheck %s

# An SALU instruction with register operands waits for all outstanding VALU
# writes to SGPRs, including those from TRANS instructions, so it does not need
# an s_delay_alu for a TRANS result.

---
name: trans_sgpr_to_salu
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1

    ; CHECK-LABEL: name: trans_sgpr_to_salu
    ; CHECK: liveins: $sgpr0, $sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr0 = V_S_EXP_F32_e64 0, $sgpr0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $sgpr0 = S_MUL_F32 $sgpr0, $sgpr1, implicit $mode
    $sgpr0 = V_S_EXP_F32_e64 0, $sgpr0, 0, 0, implicit $mode, implicit $exec
    $sgpr0 = S_MUL_F32 $sgpr0, $sgpr1, implicit $mode
...

# After the SALU has waited for the TRANS that wrote an SGPR, earlier TRANS
# instructions have also completed, so the VALU needs no s_delay_alu.
---
name: trans_sgpr_to_salu_then_older_trans_vgpr
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $vgpr0

    ; CHECK-LABEL: name: trans_sgpr_to_salu_then_older_trans_vgpr
    ; CHECK: liveins: $sgpr0, $sgpr1, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vgpr1 = V_EXP_F32_e32 $vgpr0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $sgpr0 = V_S_EXP_F32_e64 0, $sgpr0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $sgpr0 = S_MUL_F32 $sgpr0, $sgpr1, implicit $mode
    ; CHECK-NEXT: $vgpr2 = V_ADD_F32_e32 $vgpr1, $vgpr1, implicit $mode, implicit $exec
    $vgpr1 = V_EXP_F32_e32 $vgpr0, implicit $mode, implicit $exec
    $sgpr0 = V_S_EXP_F32_e64 0, $sgpr0, 0, 0, implicit $mode, implicit $exec
    $sgpr0 = S_MUL_F32 $sgpr0, $sgpr1, implicit $mode
    $vgpr2 = V_ADD_F32_e32 $vgpr1, $vgpr1, implicit $mode, implicit $exec
...

# A VALU reading the TRANS result still needs the delay.
---
name: trans_sgpr_to_valu
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0

    ; CHECK-LABEL: name: trans_sgpr_to_valu
    ; CHECK: liveins: $sgpr0, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $sgpr0 = V_S_EXP_F32_e64 0, $sgpr0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_DELAY_ALU .id0_TRANS32_DEP_1
    ; CHECK-NEXT: $vgpr0 = V_ADD_F32_e32 $sgpr0, $vgpr0, implicit $mode, implicit $exec
    $sgpr0 = V_S_EXP_F32_e64 0, $sgpr0, 0, 0, implicit $mode, implicit $exec
    $vgpr0 = V_ADD_F32_e32 $sgpr0, $vgpr0, implicit $mode, implicit $exec
...
