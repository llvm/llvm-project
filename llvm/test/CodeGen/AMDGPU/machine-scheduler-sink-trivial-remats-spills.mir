# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -start-before=machine-scheduler -stop-after=greedy,2 -verify-machineinstrs -o - %s | FileCheck %s

# Check that rematerialization for higher occupancy does not introduce spills.

# CHECK-LABEL: name: remat_occupancy_no_spill
# CHECK-NOT: SI_SPILL_
# CHECK: S_ENDPGM

--- |
  define amdgpu_kernel void @remat_occupancy_no_spill() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-waves-per-eu"="9,10" "amdgpu-num-vgpr"="25" }
...
---
name:            remat_occupancy_no_spill
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    successors: %bb.1

    S_NOP 0, implicit-def %live16:vreg_512, implicit-def %live5:vreg_160
    %loaded:vreg_64 = DS_READ2_B32_gfx9 %live5.sub0, 0, 1, 0, implicit $exec :: (load (s64), align 4, addrspace 3)
    %address:vgpr_32 = V_ADD_U32_e64 16, %live5.sub0, 0, implicit $exec

  bb.1:
    successors: %bb.2

    %converted0:vgpr_32 = nofpexcept V_CVT_F32_I32_e32 %loaded.sub0, implicit $exec, implicit $mode
    DS_WRITE_B32_gfx9 %live5.sub0, %converted0, 8, 0, implicit $exec :: (store (s32), addrspace 3)

    %converted1:vgpr_32 = nofpexcept V_CVT_F32_I32_e32 %loaded.sub1, implicit $exec, implicit $mode
    DS_WRITE_B32_gfx9 %live5.sub0, %converted1, 12, 0, implicit $exec :: (store (s32), addrspace 3)
    DS_WRITE_B32_gfx9 %address, %loaded.sub0, 0, 0, implicit $exec :: (store (s32), addrspace 3)
    DS_WRITE_B32_gfx9 %address, %loaded.sub1, 4, 0, implicit $exec :: (store (s32), addrspace 3)

  bb.2:
    S_NOP 0, implicit %live16, implicit %live5, implicit %loaded
    S_ENDPGM 0
...
