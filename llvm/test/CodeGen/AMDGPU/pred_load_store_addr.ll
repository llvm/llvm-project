; RUN: llc -global-isel=0 -verify-machineinstrs -mtriple=amdgcn -mcpu=gfx9900 -mattr=+wavefrontsize32 < %s | FileCheck %s

; Test predicated load/store with different addressing modes:
; - GVS (Global Vector-Scalar): uniform SGPR base + divergent VGPR offset
; - GV  (Global Vector):        fully divergent 64-bit VGPR address

declare i32 @llvm.amdgcn.predicated.load.i32(ptr addrspace(1), i1, i32)
declare <2 x i32> @llvm.amdgcn.predicated.load.v2i32(ptr addrspace(1), i1, <2 x i32>)
declare void @llvm.amdgcn.predicated.store.i32(i32, ptr addrspace(1), i1)
declare void @llvm.amdgcn.predicated.store.v2i32(<2 x i32>, ptr addrspace(1), i1)
declare i32 @llvm.amdgcn.workitem.id.x()

; GVS load: uniform base + divergent offset → SADDR variant with scale_offset
define amdgpu_kernel void @pred_load_gvs(ptr addrspace(1) %base, i1 %pred, ptr addrspace(1) %out) {
; CHECK-LABEL: pred_load_gvs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_clause 0x1
; CHECK-NEXT:    s_load_b96 s[0:2], s[4:5], 0x24 nv
; CHECK-NEXT:    s_load_b64 s[4:5], s[4:5], 0x34 nv
; CHECK-NEXT:    s_mov_b32 s3, 0x3ff
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_4) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    v_dual_mov_b32 v1, 0 :: v_dual_bitop2_b32 v0, s3, v0 bitop3:0x40
; CHECK-NEXT:    v_mov_b32_e32 v2, 0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_bitcmp1_b32 s2, 0
; CHECK-NEXT:    s_cselect_b32 s2, -1, 0
; CHECK-NEXT:    s_and_saveexec_b32 s3, s2
; CHECK-NEXT:    global_load_b32 v1, v0, s[0:1] scale_offset
; CHECK-NEXT:    s_mov_b32 exec_lo, s3
; CHECK-NEXT:    s_wait_loadcnt 0x0
; CHECK-NEXT:    global_store_b32 v2, v1, s[4:5]
; CHECK-NEXT:    s_endpgm
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %gep = getelementptr i32, ptr addrspace(1) %base, i32 %tid
  %val = call i32 @llvm.amdgcn.predicated.load.i32(ptr addrspace(1) %gep, i1 %pred, i32 0)
  store i32 %val, ptr addrspace(1) %out
  ret void
}

; GV load: fully divergent address → VADDR variant
define void @pred_load_gv(ptr addrspace(1) %ptr, i1 %pred, ptr addrspace(1) %out) {
; CHECK-LABEL: pred_load_gv:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_wait_loadcnt_dscnt 0x0
; CHECK-NEXT:    s_wait_expcnt 0x0
; CHECK-NEXT:    s_wait_samplecnt 0x0
; CHECK-NEXT:    s_wait_bvhcnt 0x0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    v_and_b32_e32 v2, 1, v2
; CHECK-NEXT:    s_delay_alu instid0(VALU_DEP_1)
; CHECK-NEXT:    v_cmp_eq_u32_e32 vcc_lo, 1, v2
; CHECK-NEXT:    v_mov_b32_e32 v2, 0
; CHECK-NEXT:    s_and_saveexec_b32 s0, vcc_lo
; CHECK-NEXT:    global_load_b32 v2, v[0:1], off
; CHECK-NEXT:    s_mov_b32 exec_lo, s0
; CHECK-NEXT:    s_wait_loadcnt 0x0
; CHECK-NEXT:    global_store_b32 v[3:4], v2, off
; CHECK-NEXT:    s_set_pc_i64 s[30:31]
  %val = call i32 @llvm.amdgcn.predicated.load.i32(ptr addrspace(1) %ptr, i1 %pred, i32 0)
  store i32 %val, ptr addrspace(1) %out
  ret void
}

; GVS load with constant offset folded into addressing
define amdgpu_kernel void @pred_load_gvs_offset(ptr addrspace(1) %base, i1 %pred, ptr addrspace(1) %out) {
; CHECK-LABEL: pred_load_gvs_offset:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_clause 0x1
; CHECK-NEXT:    s_load_b96 s[0:2], s[4:5], 0x24 nv
; CHECK-NEXT:    s_load_b64 s[4:5], s[4:5], 0x34 nv
; CHECK-NEXT:    s_mov_b32 s3, 0x3ff
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_4) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    v_dual_mov_b32 v1, -1 :: v_dual_bitop2_b32 v0, s3, v0 bitop3:0x40
; CHECK-NEXT:    v_mov_b32_e32 v2, 0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_bitcmp1_b32 s2, 0
; CHECK-NEXT:    s_cselect_b32 s2, -1, 0
; CHECK-NEXT:    s_and_saveexec_b32 s3, s2
; CHECK-NEXT:    global_load_b32 v1, v0, s[0:1] offset:64 scale_offset
; CHECK-NEXT:    s_mov_b32 exec_lo, s3
; CHECK-NEXT:    s_wait_loadcnt 0x0
; CHECK-NEXT:    global_store_b32 v2, v1, s[4:5]
; CHECK-NEXT:    s_endpgm
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %idx = add i32 %tid, 16
  %gep = getelementptr i32, ptr addrspace(1) %base, i32 %idx
  %val = call i32 @llvm.amdgcn.predicated.load.i32(ptr addrspace(1) %gep, i1 %pred, i32 -1)
  store i32 %val, ptr addrspace(1) %out
  ret void
}

; GVS store: uniform base + divergent offset
define amdgpu_kernel void @pred_store_gvs(ptr addrspace(1) %base, i1 %pred) {
; CHECK-LABEL: pred_store_gvs:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_load_b96 s[0:2], s[4:5], 0x24 nv
; CHECK-NEXT:    v_and_b32_e32 v0, 0x3ff, v0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_bitcmp1_b32 s2, 0
; CHECK-NEXT:    s_cselect_b32 s2, -1, 0
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_saveexec_b32 s3, s2
; CHECK-NEXT:    global_store_b32 v0, v0, s[0:1] scale_offset
; CHECK-NEXT:    s_mov_b32 exec_lo, s3
; CHECK-NEXT:    s_endpgm
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %gep = getelementptr i32, ptr addrspace(1) %base, i32 %tid
  call void @llvm.amdgcn.predicated.store.i32(i32 %tid, ptr addrspace(1) %gep, i1 %pred)
  ret void
}

; GV store: fully divergent address
define void @pred_store_gv(i32 %val, ptr addrspace(1) %ptr, i1 %pred) {
; CHECK-LABEL: pred_store_gv:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_wait_loadcnt_dscnt 0x0
; CHECK-NEXT:    s_wait_expcnt 0x0
; CHECK-NEXT:    s_wait_samplecnt 0x0
; CHECK-NEXT:    s_wait_bvhcnt 0x0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    v_and_b32_e32 v3, 1, v3
; CHECK-NEXT:    s_delay_alu instid0(VALU_DEP_1)
; CHECK-NEXT:    v_cmp_eq_u32_e32 vcc_lo, 1, v3
; CHECK-NEXT:    s_and_saveexec_b32 s0, vcc_lo
; CHECK-NEXT:    global_store_b32 v[1:2], v0, off
; CHECK-NEXT:    s_mov_b32 exec_lo, s0
; CHECK-NEXT:    s_set_pc_i64 s[30:31]
  call void @llvm.amdgcn.predicated.store.i32(i32 %val, ptr addrspace(1) %ptr, i1 %pred)
  ret void
}

; GVS v2i32 load with scale_offset
define amdgpu_kernel void @pred_load_v2i32_gvs(ptr addrspace(1) %base, i1 %pred, ptr addrspace(1) %out) {
; CHECK-LABEL: pred_load_v2i32_gvs:
