; CHECK-NEXT:    s_load_b96 s[0:2], s[4:5], 0x24 nv
; CHECK-NEXT:    s_load_b64 s[4:5], s[4:5], 0x34 nv
; CHECK-NEXT:    v_dual_mov_b32 v1, 0 :: v_dual_mov_b32 v2, 0
; CHECK-NEXT:    s_mov_b32 s3, 0x3ff
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_3) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    v_dual_mov_b32 v3, 0 :: v_dual_bitop2_b32 v0, s3, v0 bitop3:0x40
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_bitcmp1_b32 s2, 0
; CHECK-NEXT:    s_cselect_b32 s2, -1, 0
; CHECK-NEXT:    s_and_saveexec_b32 s3, s2
; CHECK-NEXT:    global_load_b64 v[1:2], v0, s[0:1] scale_offset
; CHECK-NEXT:    s_mov_b32 exec_lo, s3
; CHECK-NEXT:    s_wait_loadcnt 0x0
; CHECK-NEXT:    global_store_b64 v3, v[1:2], s[4:5]
