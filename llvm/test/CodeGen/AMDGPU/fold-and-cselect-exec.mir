tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: cselect_extra_use
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
