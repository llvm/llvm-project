  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: physreg_dst
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 [[V_CMP_LT_I32_e64_]], 0, implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    $vcc = S_AND_B64 %1, %0, implicit-def dead $scc
    S_ENDPGM 0, implicit $vcc
...

# Negative test: the S_CSELECT has another use.
---
