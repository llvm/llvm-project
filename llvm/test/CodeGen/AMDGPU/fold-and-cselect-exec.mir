# Negative test: the other AND operand is not known to be exec-masked.
---
name: unknown_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr2_sgpr3
    ; CHECK-LABEL: name: unknown_mask
    ; CHECK: liveins: $sgpr0, $sgpr2_sgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64_xexec = COPY $sgpr2_sgpr3
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    ; CHECK-NEXT: [[S_AND_B64_:%[0-9]+]]:sreg_64_xexec = S_AND_B64 [[S_CSELECT_B64_]], [[COPY]], implicit-def dead $scc
    ; CHECK-NEXT: $vcc = COPY [[S_AND_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %0:sreg_64_xexec = COPY $sgpr2_sgpr3
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# Negative test: the SCC defined by the AND is used.
---
name: scc_not_dead
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: scc_not_dead
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    ; CHECK-NEXT: [[S_AND_B64_:%[0-9]+]]:sreg_64_xexec = S_AND_B64 [[S_CSELECT_B64_]], [[V_CMP_LT_I32_e64_]], implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_AND_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc, implicit [[S_CSELECT_B32_]]
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def $scc
    %3:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc, implicit %3
...

# SCC may be clobbered between the S_CSELECT and the AND, since the S_CSELECT
# is not moved.
---
name: scc_clobbered_after_cselect
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0, $sgpr1
    ; CHECK-LABEL: name: scc_clobbered_after_cselect
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0, $sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 [[V_CMP_LT_I32_e64_]], 0, implicit $scc
    ; CHECK-NEXT: %t:sreg_32 = S_ADD_I32 $sgpr1, 1, implicit-def $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc, implicit %t
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    %t:sreg_32 = S_ADD_I32 $sgpr1, 1, implicit-def $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc, implicit %t
...

# Negative test: the S_CSELECT is in a different basic block.
---
name: cselect_in_predecessor
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cselect_in_predecessor
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
  ; CHECK-NEXT:   S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[S_AND_B64_:%[0-9]+]]:sreg_64_xexec = S_AND_B64 [[S_CSELECT_B64_]], [[V_CMP_LT_I32_e64_]], implicit-def dead $scc
  ; CHECK-NEXT:   $vcc = COPY [[S_AND_B64_]]
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $vcc
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $sgpr0
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc

  bb.1:
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...
