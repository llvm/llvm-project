# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -passes=si-fold-operands -o - %s | FileCheck %s

# Fold:
#   %a = S_CSELECT $exec, 0
#   %d = S_AND %a, %mask
# into:
#   %a = S_CSELECT %mask, 0
# and replace %d with %a, when %mask is exec-masked (e.g. a V_CMP result) and
# defined before the S_CSELECT.

---
name: cselect_exec_and_vcmp
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: cselect_exec_and_vcmp
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 [[V_CMP_LT_I32_e64_]], 0, implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# The AND is commutative.
---
name: cselect_exec_and_vcmp_commuted
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: cselect_exec_and_vcmp_commuted
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 [[V_CMP_LT_I32_e64_]], 0, implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %0, %1, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# Negative test: the V_CMP is defined after the S_CSELECT.
---
name: vcmp_after_cselect
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: vcmp_after_cselect
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: [[S_AND_B64_:%[0-9]+]]:sreg_64_xexec = S_AND_B64 [[S_CSELECT_B64_]], [[V_CMP_LT_I32_e64_]], implicit-def dead $scc
    ; CHECK-NEXT: $vcc = COPY [[S_AND_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, 0, implicit $scc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# S_CSELECT -1, 0 & x -> S_CSELECT x, 0 for any x (the AND is an identity on
# the true arm).
---
name: cselect_all_ones
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr2_sgpr3
    ; CHECK-LABEL: name: cselect_all_ones
    ; CHECK: liveins: $sgpr0, $sgpr2_sgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sreg_64_xexec = COPY $sgpr2_sgpr3
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 [[COPY]], 0, implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %0:sreg_64_xexec = COPY $sgpr2_sgpr3
    %1:sreg_64_xexec = S_CSELECT_B64 -1, 0, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# Inverted S_CSELECT 0, EXEC.
---
name: cselect_zero_exec
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: cselect_zero_exec
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 0, [[V_CMP_LT_I32_e64_]], implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %1:sreg_64_xexec = S_CSELECT_B64 0, $exec, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

# A zero materialised in a register is folded into the S_CSELECT before the AND
# is visited.
---
name: cselect_exec_mov_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-LABEL: name: cselect_exec_mov_zero
    ; CHECK: liveins: $vgpr0, $vgpr1, $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    ; CHECK-NEXT: S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    ; CHECK-NEXT: [[S_CSELECT_B64_:%[0-9]+]]:sreg_64_xexec = S_CSELECT_B64 [[V_CMP_LT_I32_e64_]], 0, implicit $scc
    ; CHECK-NEXT: $vcc = COPY [[S_CSELECT_B64_]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vcc
    %0:sreg_64_xexec = V_CMP_LT_I32_e64 $vgpr0, $vgpr1, implicit $exec
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    %z:sreg_64 = S_MOV_B64 0
    %1:sreg_64_xexec = S_CSELECT_B64 $exec, %z, implicit $scc
    %2:sreg_64_xexec = S_AND_B64 %1, %0, implicit-def dead $scc
    $vcc = COPY %2
    S_ENDPGM 0, implicit $vcc
...

