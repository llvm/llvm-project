# RUN: llc -mtriple=amdgpu12.00-amd-amdhsa -mattr=+real-true16 -run-pass=amdgpu-regbank-combiner -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu12.00-amd-amdhsa -mattr=+real-true16 -passes=amdgpu-regbank-combiner -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @zext_i8_lo_volatile_debugloc() !dbg !3 { ret void }
  define void @zext_i8_hi_late_preserved_debugloc() !dbg !4 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "d16.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "zext_i8_lo_volatile_debugloc", scope: !1, file: !1, line: 1, type: !5, spFlags: DISPFlagDefinition, unit: !0)
  !4 = distinct !DISubprogram(name: "zext_i8_hi_late_preserved_debugloc", scope: !1, file: !1, line: 1, type: !5, spFlags: DISPFlagDefinition, unit: !0)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !DILocation(line: 10, scope: !3)
  !8 = !DILocation(line: 30, scope: !3)
  !9 = !DILocation(line: 20, scope: !4)
  !10 = !DILocation(line: 40, scope: !4)
...

---
name: zext_i8_lo_volatile_debugloc
legalized: true
regBankSelected: true
tracksRegLiveness: true
# CHECK-LABEL: name: zext_i8_lo_volatile_debugloc
# CHECK: G_AMDGPU_LOAD_D16_LO_U8 {{.*}}debug-location !DILocation(line: 10,
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2

    %0:vgpr(p1) = COPY $vgpr0_vgpr1
    %1:vgpr(<2 x i16>) = COPY $vgpr2
    %2:vgpr(i32) = G_BITCAST %1
    %3:sgpr(i32) = G_CONSTANT i32 -65536
    %4:vgpr(i32) = COPY %3(i32)
    %5:vgpr(i32) = G_AND %2, %4
    %6:vgpr(i32) = G_ZEXTLOAD %0, debug-location !7 :: (volatile load (i8), align 4, addrspace 1)
    %7:vgpr(i32) = G_OR %5, %6
    %8:vgpr(<2 x i16>) = G_BITCAST %7, debug-location !8
    G_STORE %8(<2 x i16>), %0(p1) :: (store (<2 x i16>), addrspace 1)
    S_ENDPGM 0
...

---
name: zext_i8_hi_late_preserved_debugloc
legalized: true
regBankSelected: true
tracksRegLiveness: true
# CHECK-LABEL: name: zext_i8_hi_late_preserved_debugloc
# CHECK: G_AMDGPU_LOAD_D16_HI_U8 {{.*}}debug-location !DILocation(line: 20,
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2

    %0:vgpr(p1) = COPY $vgpr0_vgpr1
    %6:vgpr(i32) = G_ZEXTLOAD %0, debug-location !9 :: (load (i8), align 4, addrspace 1)
    %1:vgpr(<2 x i16>) = COPY $vgpr2
    %2:vgpr(i32) = G_BITCAST %1
    %3:sgpr(i32) = G_CONSTANT i32 65535
    %4:vgpr(i32) = COPY %3(i32)
    %5:vgpr(i32) = G_AND %2, %4
    %7:sgpr(i32) = G_CONSTANT i32 16
    %8:vgpr(i32) = COPY %7(i32)
    %9:vgpr(i32) = G_SHL %6, %8
    %10:vgpr(i32) = G_OR %5, %9
    %11:vgpr(<2 x i16>) = G_BITCAST %10, debug-location !10
    G_STORE %11(<2 x i16>), %0(p1) :: (store (<2 x i16>), addrspace 1)
    S_ENDPGM 0
...
