# The high halves of both operands are known zero, so this should
# use the 32-bit expansion and zero resultant high halves, like
# AMDGPUTargetLowering::LowerUDIVREM64.
---
name: test_udivrem_s64_32bit
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3

    ; GFX8-LABEL: name: test_udivrem_s64_32bit
    ; GFX8: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    ; GFX8-NEXT: {{  $}}
    ; GFX8-NEXT: %num:_(s64) = COPY $vgpr0_vgpr1
    ; GFX8-NEXT: %den:_(s64) = COPY $vgpr2_vgpr3
    ; GFX8-NEXT: %mask:_(s64) = G_CONSTANT i64 4294967295
    ; GFX8-NEXT: %num_masked:_(s64) = G_AND %num, %mask
    ; GFX8-NEXT: %den_masked:_(s64) = G_AND %den, %mask
    ; GFX8-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES %num_masked(s64)
    ; GFX8-NEXT: [[UV2:%[0-9]+]]:_(i32), [[UV3:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES %den_masked(s64)
    ; GFX8-NEXT: [[UITOFP:%[0-9]+]]:_(f32) = G_UITOFP [[UV2]](i32)
    ; GFX8-NEXT: [[AMDGPU_RCP_IFLAG:%[0-9]+]]:_(f32) = G_AMDGPU_RCP_IFLAG [[UITOFP]](f32)
    ; GFX8-NEXT: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float f0x4F7FFFFE
    ; GFX8-NEXT: [[FMUL:%[0-9]+]]:_(f32) = G_FMUL [[AMDGPU_RCP_IFLAG]], [[C]]
    ; GFX8-NEXT: [[FPTOUI:%[0-9]+]]:_(i32) = G_FPTOUI [[FMUL]](f32)
    ; GFX8-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; GFX8-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[C1]], [[UV2]]
    ; GFX8-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[SUB]], [[FPTOUI]]
    ; GFX8-NEXT: [[UMULH:%[0-9]+]]:_(i32) = G_UMULH [[FPTOUI]], [[MUL]]
    ; GFX8-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[FPTOUI]], [[UMULH]]
    ; GFX8-NEXT: [[UMULH1:%[0-9]+]]:_(i32) = G_UMULH [[UV]], [[ADD]]
    ; GFX8-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[UMULH1]], [[UV2]]
    ; GFX8-NEXT: [[SUB1:%[0-9]+]]:_(i32) = G_SUB [[UV]], [[MUL1]]
    ; GFX8-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; GFX8-NEXT: [[ICMP:%[0-9]+]]:_(s1) = G_ICMP intpred(uge), [[SUB1]](i32), [[UV2]]
    ; GFX8-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[UMULH1]], [[C2]]
    ; GFX8-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](s1), [[ADD1]], [[UMULH1]]
    ; GFX8-NEXT: [[SUB2:%[0-9]+]]:_(i32) = G_SUB [[SUB1]], [[UV2]]
    ; GFX8-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](s1), [[SUB2]], [[SUB1]]
    ; GFX8-NEXT: [[ICMP1:%[0-9]+]]:_(s1) = G_ICMP intpred(uge), [[SELECT1]](i32), [[UV2]]
    ; GFX8-NEXT: [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[SELECT]], [[C2]]
    ; GFX8-NEXT: [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[ICMP1]](s1), [[ADD2]], [[SELECT]]
    ; GFX8-NEXT: [[SUB3:%[0-9]+]]:_(i32) = G_SUB [[SELECT1]], [[UV2]]
    ; GFX8-NEXT: [[SELECT3:%[0-9]+]]:_(i32) = G_SELECT [[ICMP1]](s1), [[SUB3]], [[SELECT1]]
    ; GFX8-NEXT: %div:_(s64) = G_MERGE_VALUES [[SELECT2]](i32), [[C1]](i32)
    ; GFX8-NEXT: %rem:_(s64) = G_MERGE_VALUES [[SELECT3]](i32), [[C1]](i32)
    ; GFX8-NEXT: $vgpr0_vgpr1 = COPY %div(s64)
    ; GFX8-NEXT: $vgpr2_vgpr3 = COPY %rem(s64)
    %num:_(s64) = COPY $vgpr0_vgpr1
    %den:_(s64) = COPY $vgpr2_vgpr3
    %mask:_(s64) = G_CONSTANT i64 4294967295
    %num_masked:_(s64) = G_AND %num, %mask
    %den_masked:_(s64) = G_AND %den, %mask
    %div:_(s64), %rem:_(s64) = G_UDIVREM %num_masked, %den_masked
    $vgpr0_vgpr1 = COPY %div
    $vgpr2_vgpr3 = COPY %rem

...

