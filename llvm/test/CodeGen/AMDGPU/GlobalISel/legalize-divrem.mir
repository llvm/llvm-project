    %div:_(s64), %rem:_(s64) = G_UDIVREM %num_masked, %den
    $vgpr0_vgpr1 = COPY %div
    $vgpr2_vgpr3 = COPY %rem

...

# Element 0 fits in 32 bits and should use the 32-bit expansion.
# Element 1 may use bit 32 and so it needs the 64-bit expansion.
---
name: test_udivrem_v2s64_elt0_32bit_elt1_33bit
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7

