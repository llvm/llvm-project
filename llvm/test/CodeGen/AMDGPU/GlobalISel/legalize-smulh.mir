    %11:_(<2 x s8>) = G_BUILD_VECTOR %5, %6
    %12:_(<2 x s8>) = G_BUILD_VECTOR %7, %8
    %13:_(<2 x s8>) = G_SMULH %11, %12
    %14:_(s8), %15:_(s8) = G_UNMERGE_VALUES %13
    %17:_(s16) = G_MERGE_VALUES %14, %15
    %18:_(s32) = G_ANYEXT %17
    $vgpr0 = COPY %18

...

