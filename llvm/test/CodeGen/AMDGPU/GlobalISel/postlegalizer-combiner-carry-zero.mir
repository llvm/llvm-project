    %z:_(i32) = COPY $vgpr2
    %sum0:_(i32), %carry0:_(i1) = G_UADDO %x, %y
    %sum1:_(i32), %carry1:_(i1) = G_UADDO %y, %z
    %wide0:_(i32) = G_ZEXT %carry0(i1)
    %wide1:_(i32) = G_ZEXT %carry1(i1)
    %add:_(i32) = G_ADD %wide0, %wide1
