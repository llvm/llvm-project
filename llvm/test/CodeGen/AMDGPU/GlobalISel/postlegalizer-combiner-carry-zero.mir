# RUN: llc -mtriple=amdgpu12.00-amd-amdhsa \
# RUN:   -run-pass=amdgpu-postlegalizer-combiner -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s

# Keep zero-plus-carry as a G_ZEXT without relying on uadde_zero_zero_to_zext.
# Subtraction from zero must still fold to G_USUBE.
# When both addends are carries, fold the RHS carry first.

---
name: add_zero_carry
tracksRegLiveness: true
legalized: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: add_zero_carry
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: %sum:_(i32), %carry:_(i1) = G_UADDO %x, %y
    ; CHECK-NEXT: %wide:_(i32) = G_ZEXT %carry(i1)
    ; CHECK-NEXT: $vgpr0 = COPY %wide(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %sum(i32)
    %x:_(i32) = COPY $vgpr0
    %y:_(i32) = COPY $vgpr1
    %sum:_(i32), %carry:_(i1) = G_UADDO %x, %y
    %wide:_(i32) = G_ZEXT %carry(i1)
    %zero:_(i32) = G_CONSTANT i32 0
    %add:_(i32) = G_ADD %zero, %wide
    $vgpr0 = COPY %add(i32)
    $vgpr1 = COPY %sum(i32)
...
