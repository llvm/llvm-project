    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i16) = G_BITCAST [[LOAD]](f16)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 8
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i16) = G_LSHR [[BITCAST]], [[C]](i16)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST]](i16)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[LSHR]](i16)
    ; CHECK-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[ANYEXT1]](i32)
    %0:_(p1) = G_IMPLICIT_DEF
    %1:_(f16) = G_LOAD %0 :: (load (f16), addrspace 1)
    %2:_(i8), %3:_(i8) = G_UNMERGE_VALUES %1
    %4:_(i32) = G_ANYEXT %2
    %5:_(i32) = G_ANYEXT %3
    $vgpr0 = COPY %4
    $vgpr1 = COPY %5
...

---
name: test_unmerge_i4_bf16
body: |
  bb.0:
    ; CHECK-LABEL: name: test_unmerge_i4_bf16
    ; CHECK: [[DEF:%[0-9]+]]:_(p1) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(bf16) = G_LOAD [[DEF]](p1) :: (load (bf16), addrspace 1)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i16) = G_BITCAST [[LOAD]](bf16)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 12
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i16) = G_LSHR [[BITCAST]], [[C]](i16)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST]](i16)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[LSHR]](i16)
    ; CHECK-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[ANYEXT1]](i32)
    %0:_(p1) = G_IMPLICIT_DEF
    %1:_(bf16) = G_LOAD %0 :: (load (bf16), addrspace 1)
    %2:_(i4), %3:_(i4), %4:_(i4), %5:_(i4) = G_UNMERGE_VALUES %1
    %6:_(i32) = G_ANYEXT %2
    %7:_(i32) = G_ANYEXT %5
    $vgpr0 = COPY %6
    $vgpr1 = COPY %7
...
