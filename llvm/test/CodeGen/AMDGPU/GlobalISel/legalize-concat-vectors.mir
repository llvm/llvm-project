---
name: concat_vectors_v2s32_v2s32

body: |
  bb.0:
    liveins: $vgpr0_64, $vgpr2_64
    ; CHECK-LABEL: name: concat_vectors_v2s32_v2s32
    ; CHECK: liveins: $vgpr0_64, $vgpr2_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<2 x s32>) = COPY $vgpr0_64
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<2 x s32>) = COPY $vgpr2_64
    ; CHECK-NEXT: [[CONCAT_VECTORS:%[0-9]+]]:_(<4 x s32>) = G_CONCAT_VECTORS [[COPY]](<2 x s32>), [[COPY1]](<2 x s32>)
    ; CHECK-NEXT: $vgpr0_128 = COPY [[CONCAT_VECTORS]](<4 x s32>)
    %0:_(<2 x s32>) = COPY $vgpr0_64
    %1:_(<2 x s32>) = COPY $vgpr2_64
    %2:_(<4 x s32>) = G_CONCAT_VECTORS %0, %1
    $vgpr0_128 = COPY %2
...

