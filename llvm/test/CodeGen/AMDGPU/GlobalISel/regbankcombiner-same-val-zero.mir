# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx1030 -run-pass=amdgpu-regbank-combiner -verify-machineinstrs %s -o - | FileCheck %s

# same_val_zero (xor x, x -> 0) creates a vreg with no bank after RegBankSelect.

---
name: xor_v2i32_shared_elt0
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: xor_v2i32_shared_elt0
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr(s32) = COPY [[C]](s32)
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:vgpr(s32) = G_XOR [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[COPY2]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY [[XOR]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %10:vgpr(s32) = COPY $vgpr0
    %11:vgpr(s32) = COPY $vgpr1
    %0:vgpr(<2 x s32>) = G_BUILD_VECTOR %10(s32), %11(s32)
    %1:vgpr(s32) = COPY $vgpr2
    %12:vgpr(<2 x s32>) = G_BUILD_VECTOR %10(s32), %1(s32)
    %17:vgpr(s32), %18:vgpr(s32) = G_UNMERGE_VALUES %0(<2 x s32>)
    %19:vgpr(s32), %20:vgpr(s32) = G_UNMERGE_VALUES %12(<2 x s32>)
    %21:vgpr(s32) = G_XOR %17, %19
    %22:vgpr(s32) = G_XOR %18, %20
    %14:vgpr(<2 x s32>) = G_BUILD_VECTOR %21(s32), %22(s32)
    %15:vgpr(s32), %16:vgpr(s32) = G_UNMERGE_VALUES %14(<2 x s32>)
    $vgpr0 = COPY %15(s32)
    $vgpr1 = COPY %16(s32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
name: xor_v4i16_shared_hi
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: xor_v4i16_shared_hi
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(<2 x s16>) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(<2 x s16>) = COPY $vgpr1
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:vgpr(<2 x s16>) = G_XOR [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:sgpr(s16) = G_CONSTANT i16 0
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:sgpr(<2 x s16>) = G_BUILD_VECTOR [[C]](s16), [[C]](s16)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr(<2 x s16>) = COPY [[BUILD_VECTOR]](<2 x s16>)
    ; CHECK-NEXT: $vgpr0 = COPY [[XOR]](<2 x s16>)
    ; CHECK-NEXT: $vgpr1 = COPY [[COPY2]](<2 x s16>)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:vgpr(<2 x s16>) = COPY $vgpr0
    %1:vgpr(<2 x s16>) = COPY $vgpr1
    %2:vgpr(<2 x s16>) = COPY $vgpr2
    %16:vgpr(<4 x s16>) = G_CONCAT_VECTORS %0(<2 x s16>), %2(<2 x s16>)
    %17:vgpr(<4 x s16>) = G_CONCAT_VECTORS %1(<2 x s16>), %2(<2 x s16>)
    %18:vgpr(<2 x s16>), %19:vgpr(<2 x s16>) = G_UNMERGE_VALUES %16(<4 x s16>)
    %20:vgpr(<2 x s16>), %21:vgpr(<2 x s16>) = G_UNMERGE_VALUES %17(<4 x s16>)
    %22:vgpr(<2 x s16>) = G_XOR %18, %20
    %23:vgpr(<2 x s16>) = G_XOR %19, %21
    %13:vgpr(<4 x s16>) = G_CONCAT_VECTORS %22(<2 x s16>), %23(<2 x s16>)
    %14:vgpr(<2 x s16>), %15:vgpr(<2 x s16>) = G_UNMERGE_VALUES %13(<4 x s16>)
    $vgpr0 = COPY %14(<2 x s16>)
    $vgpr1 = COPY %15(<2 x s16>)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
