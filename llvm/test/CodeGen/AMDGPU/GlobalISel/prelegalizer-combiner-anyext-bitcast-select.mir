# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.00 -run-pass=amdgpu-prelegalizer-combiner -verify-machineinstrs -o - %s | FileCheck %s

---
name: anyext_select_i16
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: anyext_select_i16
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %cond32:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %cond32(i32)
    ; CHECK-NEXT: %a:_(i16) = COPY $vgpr1
    ; CHECK-NEXT: %b:_(i16) = COPY $vgpr2
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT %a(i16)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT %b(i16)
    ; CHECK-NEXT: %result:_(i32) = G_SELECT %cond(i1), [[ANYEXT]], [[ANYEXT1]]
    ; CHECK-NEXT: $vgpr0 = COPY %result(i32)
    %cond32:_(i32) = COPY $vgpr0
    %cond:_(i1) = G_TRUNC %cond32
    %a:_(i16) = COPY $vgpr1
    %b:_(i16) = COPY $vgpr2
    %selected:_(i16) = G_SELECT %cond, %a, %b
    %result:_(i32) = G_ANYEXT %selected
    $vgpr0 = COPY %result
...

---
name: anyext_bitcast_select_f16
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: anyext_bitcast_select_f16
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %cond32:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %cond32(i32)
    ; CHECK-NEXT: %a:_(f16) = COPY $vgpr1
    ; CHECK-NEXT: %b:_(f16) = COPY $vgpr2
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i16) = G_BITCAST %a(f16)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(i16) = G_BITCAST %b(f16)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST]](i16)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST1]](i16)
    ; CHECK-NEXT: %result:_(i32) = G_SELECT %cond(i1), [[ANYEXT]], [[ANYEXT1]]
    ; CHECK-NEXT: $vgpr0 = COPY %result(i32)
    %cond32:_(i32) = COPY $vgpr0
    %cond:_(i1) = G_TRUNC %cond32
    %a:_(f16) = COPY $vgpr1
    %b:_(f16) = COPY $vgpr2
    %selected:_(f16) = G_SELECT %cond, %a, %b
    %bits:_(i16) = G_BITCAST %selected
    %result:_(i32) = G_ANYEXT %bits
    $vgpr0 = COPY %result
...

# Reproduce the call-lowering shape: the new casts and extensions should fold
# with the input casts and truncations, leaving a select of the original i32s.
---
name: anyext_bitcast_select_bf16_from_i32
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: anyext_bitcast_select_bf16_from_i32
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %cond32:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %cond32(i32)
    ; CHECK-NEXT: %a32:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: %b32:_(i32) = COPY $vgpr2
    ; CHECK-NEXT: %result:_(i32) = G_SELECT %cond(i1), %a32, %b32
    ; CHECK-NEXT: $vgpr0 = COPY %result(i32)
    %cond32:_(i32) = COPY $vgpr0
    %cond:_(i1) = G_TRUNC %cond32
    %a32:_(i32) = COPY $vgpr1
    %b32:_(i32) = COPY $vgpr2
    %a16:_(i16) = G_TRUNC %a32
    %b16:_(i16) = G_TRUNC %b32
    %a:_(bf16) = G_BITCAST %a16
    %b:_(bf16) = G_BITCAST %b16
    %selected:_(bf16) = G_SELECT %cond, %a, %b
    %bits:_(i16) = G_BITCAST %selected
    %result:_(i32) = G_ANYEXT %bits
    $vgpr0 = COPY %result
...

---
# AMDGPU does not consider this vector extension free.
name: anyext_bitcast_select_v2f16_not_free
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: anyext_bitcast_select_v2f16_not_free
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %cond32:_(<2 x i32>) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: %cond:_(<2 x i1>) = G_TRUNC %cond32(<2 x i32>)
    ; CHECK-NEXT: %a:_(<2 x f16>) = COPY $vgpr1
    ; CHECK-NEXT: %b:_(<2 x f16>) = COPY $vgpr2
    ; CHECK-NEXT: %selected:_(<2 x f16>) = G_SELECT %cond(<2 x i1>), %a, %b
    ; CHECK-NEXT: %bits:_(<2 x i16>) = G_BITCAST %selected(<2 x f16>)
    ; CHECK-NEXT: %result:_(<2 x i32>) = G_ANYEXT %bits(<2 x i16>)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %result(<2 x i32>)
    %cond32:_(<2 x i32>) = COPY $vgpr0_vgpr1
    %cond:_(<2 x i1>) = G_TRUNC %cond32
    %a:_(<2 x f16>) = COPY $vgpr1
    %b:_(<2 x f16>) = COPY $vgpr2
    %selected:_(<2 x f16>) = G_SELECT %cond, %a, %b
    %bits:_(<2 x i16>) = G_BITCAST %selected
    %result:_(<2 x i32>) = G_ANYEXT %bits
    $vgpr0_vgpr1 = COPY %result
...

