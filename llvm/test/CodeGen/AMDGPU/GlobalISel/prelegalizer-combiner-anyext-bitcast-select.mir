# A vector condition cannot select the scalar result of the bitcast.
---
name: anyext_bitcast_select_vector_to_scalar
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: anyext_bitcast_select_vector_to_scalar
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %cond32:_(<2 x i32>) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: %cond:_(<2 x i1>) = G_TRUNC %cond32(<2 x i32>)
    ; CHECK-NEXT: %a:_(<2 x f16>) = COPY $vgpr1
    ; CHECK-NEXT: %b:_(<2 x f16>) = COPY $vgpr2
    ; CHECK-NEXT: %selected:_(<2 x f16>) = G_SELECT %cond(<2 x i1>), %a, %b
    ; CHECK-NEXT: %bits:_(i32) = G_BITCAST %selected(<2 x f16>)
    ; CHECK-NEXT: %result:_(i64) = G_ANYEXT %bits(i32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %result(i64)
    %cond32:_(<2 x i32>) = COPY $vgpr0_vgpr1
    %cond:_(<2 x i1>) = G_TRUNC %cond32
    %a:_(<2 x f16>) = COPY $vgpr1
    %b:_(<2 x f16>) = COPY $vgpr2
    %selected:_(<2 x f16>) = G_SELECT %cond, %a, %b
    %bits:_(i32) = G_BITCAST %selected
    %result:_(i64) = G_ANYEXT %bits
    $vgpr0_vgpr1 = COPY %result
...

# Keeping a vector result is insufficient: the condition's lane count must
# still match after commuting the bitcast.
---
name: anyext_bitcast_select_change_lanes
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr1_vgpr2, $vgpr3_vgpr4

    ; CHECK-LABEL: name: anyext_bitcast_select_change_lanes
    ; CHECK: liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr1_vgpr2, $vgpr3_vgpr4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %cond32:_(<4 x i32>) = COPY $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: %cond:_(<4 x i1>) = G_TRUNC %cond32(<4 x i32>)
    ; CHECK-NEXT: %a:_(<4 x f16>) = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: %b:_(<4 x f16>) = COPY $vgpr3_vgpr4
    ; CHECK-NEXT: %selected:_(<4 x f16>) = G_SELECT %cond(<4 x i1>), %a, %b
    ; CHECK-NEXT: %bits:_(<2 x i32>) = G_BITCAST %selected(<4 x f16>)
    ; CHECK-NEXT: %result:_(<2 x i64>) = G_ANYEXT %bits(<2 x i32>)
    ; CHECK-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = COPY %result(<2 x i64>)
    %cond32:_(<4 x i32>) = COPY $vgpr0_vgpr1_vgpr2_vgpr3
    %cond:_(<4 x i1>) = G_TRUNC %cond32
    %a:_(<4 x f16>) = COPY $vgpr1_vgpr2
    %b:_(<4 x f16>) = COPY $vgpr3_vgpr4
    %selected:_(<4 x f16>) = G_SELECT %cond, %a, %b
    %bits:_(<2 x i32>) = G_BITCAST %selected
    %result:_(<2 x i64>) = G_ANYEXT %bits
    $vgpr0_vgpr1_vgpr2_vgpr3 = COPY %result
...

