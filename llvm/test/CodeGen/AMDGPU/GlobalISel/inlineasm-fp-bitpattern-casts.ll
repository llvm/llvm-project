; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i32)
; CHECK-NEXT:   [[BITCAST:%[0-9]+]]:_(f16) = G_BITCAST [[TRUNC]](i16)
; CHECK-NEXT:   [[BITCAST1:%[0-9]+]]:_(i16) = G_BITCAST [[BITCAST]](f16)
; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST1]](i16)
; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32_lo256 = COPY [[ANYEXT]](i32)
; CHECK-NEXT:   INLINEASM &"; $0 $1", sideeffect attdialect, regdef:VGPR_32_Lo256, def %11, reguse:VGPR_32_Lo256, [[COPY1]]
; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(i32) = COPY %11
; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(i16) = G_TRUNC [[COPY2]](i32)
; CHECK-NEXT:   [[BITCAST2:%[0-9]+]]:_(f16) = G_BITCAST [[TRUNC1]](i16)
; CHECK-NEXT:   [[BITCAST3:%[0-9]+]]:_(i16) = G_BITCAST [[BITCAST2]](f16)
; CHECK-NEXT:   [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST3]](i16)
; CHECK-NEXT:   $vgpr0 = COPY [[ANYEXT1]](i32)
; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  %r = call half asm sideeffect "; $0 $1", "=v,v"(half %a)
  ret half %r
}

