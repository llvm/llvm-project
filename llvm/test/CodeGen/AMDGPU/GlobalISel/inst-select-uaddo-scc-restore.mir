# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu10.10 -run-pass=instruction-select -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s

# A uniform carry from G_UADDO/G_USUBO is recomputed at its SCC users instead of
# being saved with "COPY $scc" and restored with "$scc = COPY".

---
name:            usubo_clobber_between
legalized:       true
regBankSelected: true

body: |
  bb.0:
    liveins: $sgpr0, $sgpr1

    ; GCN-LABEL: name: usubo_clobber_between
    ; GCN: liveins: $sgpr0, $sgpr1
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; GCN-NEXT: [[S_SUB_U32_:%[0-9]+]]:sreg_32 = S_SUB_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; GCN-NEXT: [[S_SUB_I32_:%[0-9]+]]:sreg_32 = S_SUB_I32 [[COPY1]], [[COPY]], implicit-def dead $scc
    ; GCN-NEXT: [[S_SUB_U32_1:%[0-9]+]]:sreg_32 = S_SUB_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; GCN-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_SUB_I32_]], [[S_SUB_U32_]], implicit $scc
    ; GCN-NEXT: $sgpr0 = COPY [[S_CSELECT_B32_]]
    ; GCN-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0
    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32), %3:sgpr(i32) = G_USUBO %0, %1
    %4:sgpr(i32) = G_SUB %1, %0
    %5:sgpr(i32) = G_SELECT %3, %4, %2
    $sgpr0 = COPY %5
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

---
name:            uaddo_two_restores
legalized:       true
regBankSelected: true

body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2

    ; GCN-LABEL: name: uaddo_two_restores
    ; GCN: liveins: $sgpr0, $sgpr1, $sgpr2
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; GCN-NEXT: [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr2
    ; GCN-NEXT: [[S_ADD_U32_:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; GCN-NEXT: [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[COPY]], [[COPY2]], implicit-def dead $scc
    ; GCN-NEXT: [[S_ADD_U32_1:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; GCN-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_AND_B32_]], [[S_ADD_U32_]], implicit $scc
    ; GCN-NEXT: [[S_OR_B32_:%[0-9]+]]:sreg_32 = S_OR_B32 [[S_CSELECT_B32_]], [[COPY2]], implicit-def dead $scc
    ; GCN-NEXT: [[S_ADD_U32_2:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY1]], implicit-def $scc
    ; GCN-NEXT: [[S_CSELECT_B32_1:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_OR_B32_]], [[COPY1]], implicit $scc
    ; GCN-NEXT: $sgpr0 = COPY [[S_CSELECT_B32_1]]
    ; GCN-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0
    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = COPY $sgpr2
    %3:sgpr(i32), %4:sgpr(i32) = G_UADDO %0, %1
    %5:sgpr(i32) = G_AND %0, %2
    %6:sgpr(i32) = G_SELECT %4, %5, %3
    %7:sgpr(i32) = G_OR %6, %2
    %8:sgpr(i32) = G_SELECT %4, %7, %1
    $sgpr0 = COPY %8
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

# The G_UADDE carry has a carry-in, so it is still saved and restored.
---
name:            uaddo_carry_into_uadde
legalized:       true
regBankSelected: true

body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2, $sgpr3

    ; GCN-LABEL: name: uaddo_carry_into_uadde
    ; GCN: liveins: $sgpr0, $sgpr1, $sgpr2, $sgpr3
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; GCN-NEXT: [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr2
    ; GCN-NEXT: [[COPY3:%[0-9]+]]:sreg_32 = COPY $sgpr3
    ; GCN-NEXT: [[S_ADD_U32_:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY2]], implicit-def $scc
    ; GCN-NEXT: [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[S_ADD_U32_]], [[COPY3]], implicit-def dead $scc
    ; GCN-NEXT: [[S_ADD_U32_1:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY2]], implicit-def $scc
    ; GCN-NEXT: [[S_ADDC_U32_:%[0-9]+]]:sreg_32 = S_ADDC_U32 [[COPY1]], [[COPY3]], implicit-def $scc, implicit $scc
    ; GCN-NEXT: [[COPY4:%[0-9]+]]:sreg_32 = COPY $scc
    ; GCN-NEXT: [[S_AND_B32_1:%[0-9]+]]:sreg_32 = S_AND_B32 [[S_ADDC_U32_]], [[COPY2]], implicit-def dead $scc
    ; GCN-NEXT: $scc = COPY [[COPY4]]
    ; GCN-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_AND_B32_1]], [[COPY1]], implicit $scc
    ; GCN-NEXT: $sgpr0 = COPY [[S_AND_B32_]]
    ; GCN-NEXT: $sgpr1 = COPY [[S_CSELECT_B32_]]
    ; GCN-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0, implicit $sgpr1
    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = COPY $sgpr2
    %3:sgpr(i32) = COPY $sgpr3
    %4:sgpr(i32), %5:sgpr(i32) = G_UADDO %0, %2
    %6:sgpr(i32) = G_AND %4, %3
    %7:sgpr(i32), %8:sgpr(i32) = G_UADDE %1, %3, %5
    %9:sgpr(i32) = G_AND %7, %2
    %10:sgpr(i32) = G_SELECT %8, %9, %1
    $sgpr0 = COPY %6
    $sgpr1 = COPY %10
    SI_RETURN_TO_EPILOG implicit $sgpr0, implicit $sgpr1
...

---
name:            uaddo_restore_in_other_block
legalized:       true
regBankSelected: true
tracksRegLiveness: true

body: |
  ; GCN-LABEL: name: uaddo_restore_in_other_block
  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT:   liveins: $sgpr0, $sgpr1, $sgpr2
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; GCN-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
  ; GCN-NEXT:   [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr2
  ; GCN-NEXT:   [[S_ADD_U32_:%[0-9]+]]:sreg_32 = S_ADD_U32 [[COPY]], [[COPY1]], implicit-def $scc
  ; GCN-NEXT:   [[COPY3:%[0-9]+]]:sreg_32 = COPY $scc
  ; GCN-NEXT:   S_BRANCH %bb.1
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[COPY]], [[COPY2]], implicit-def dead $scc
  ; GCN-NEXT:   $scc = COPY [[COPY3]]
  ; GCN-NEXT:   [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_AND_B32_]], [[S_ADD_U32_]], implicit $scc
  ; GCN-NEXT:   $sgpr0 = COPY [[S_CSELECT_B32_]]
  ; GCN-NEXT:   SI_RETURN_TO_EPILOG implicit $sgpr0
  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $sgpr1, $sgpr2

    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = COPY $sgpr2
    %3:sgpr(i32), %4:sgpr(i32) = G_UADDO %0, %1
    G_BR %bb.1

  bb.1:
    %5:sgpr(i32) = G_AND %0, %2
    %6:sgpr(i32) = G_SELECT %4, %5, %3
    $sgpr0 = COPY %6
    SI_RETURN_TO_EPILOG implicit $sgpr0
...
