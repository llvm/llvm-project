    ; CHECK-NEXT: $vgpr0 = COPY %lo(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %hi(i32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
    %c:sgpr(i64) = G_FCONSTANT double 1.000000e+00
    %copy:vgpr(i64) = COPY %c
    %lo:vgpr(i32), %hi:vgpr(i32) = G_UNMERGE_VALUES %copy(i64)
    $vgpr0 = COPY %lo(i32)
    $vgpr1 = COPY %hi(i32)
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
...
---
name: constant_fold_barrier
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: constant_fold_barrier
    ; CHECK: %constant:sgpr(i64) = G_CONSTANT i64 80
    ; CHECK-NEXT: %c:sgpr(i64) = G_CONSTANT_FOLD_BARRIER %constant
    ; CHECK-NEXT: %copy:vgpr(i64) = COPY %c(i64)
    ; CHECK-NEXT: %lo:vgpr(i32), %hi:vgpr(i32) = G_UNMERGE_VALUES %copy(i64)
    ; CHECK-NEXT: $vgpr0 = COPY %lo(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %hi(i32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
    %constant:sgpr(i64) = G_CONSTANT i64 80
    %c:sgpr(i64) = G_CONSTANT_FOLD_BARRIER %constant
    %copy:vgpr(i64) = COPY %c
    %lo:vgpr(i32), %hi:vgpr(i32) = G_UNMERGE_VALUES %copy(i64)
    $vgpr0 = COPY %lo(i32)
    $vgpr1 = COPY %hi(i32)
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
...
