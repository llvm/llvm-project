# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=amdgpu-regbank-combiner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Split constants through single-use bank copies, retaining the destination banks.
# Shared constants and copies must not have their materializations duplicated.
# Physical register copies and constant-fold barriers must not be folded.

---
name: integer_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: integer_copy
    ; CHECK: %lo:vgpr(i32) = G_CONSTANT i32 80
    ; CHECK-NEXT: %hi:vgpr(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY %lo(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %hi(i32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
    %c:sgpr(i64) = G_CONSTANT i64 80
    %copy0:sgpr(i64) = COPY %c
    %copy:vgpr(i64) = COPY %copy0
    %lo:vgpr(i32), %hi:vgpr(i32) = G_UNMERGE_VALUES %copy(i64)
    $vgpr0 = COPY %lo(i32)
    $vgpr1 = COPY %hi(i32)
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
...
