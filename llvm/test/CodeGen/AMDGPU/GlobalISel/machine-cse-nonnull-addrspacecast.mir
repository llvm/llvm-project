# RUN: llc -mtriple=amdgpu9.50 -passes=machine-cse -o - %s | FileCheck %s

# The surviving cast must not keep nonnull when the eliminated one lacks it.

---
name: cse_nonnull_addrspacecast
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: cse_nonnull_addrspacecast
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[ADDRSPACE_CAST:%[0-9]+]]:_(p3) = G_ADDRSPACE_CAST [[COPY]](p0)
    ; CHECK-NEXT: $vgpr0 = COPY [[ADDRSPACE_CAST]](p3)
    ; CHECK-NEXT: $vgpr1 = COPY [[ADDRSPACE_CAST]](p3)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(p0) = COPY $vgpr0_vgpr1
    %1:_(p3) = nonnull G_ADDRSPACE_CAST %0
    %2:_(p3) = G_ADDRSPACE_CAST %0
    $vgpr0 = COPY %1
    $vgpr1 = COPY %2
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
