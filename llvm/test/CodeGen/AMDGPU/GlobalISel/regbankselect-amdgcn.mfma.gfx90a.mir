    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:vgpr(<32 x s32>) = COPY [[INTRINSIC_CONVERGENT]](<32 x s32>)
    ; CHECK-NEXT: $vgpr0_1024 = COPY [[COPY4]](<32 x s32>)
    %0:_(s64) = COPY $vgpr0_64
    %1:_(s64) = COPY $vgpr2_64
    %2:_(<32 x s32>) = COPY $agpr0_1024
    %3:_(<32 x s32>) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.mfma.f32.32x32x4bf16.1k), %0, %1, %2, 0, 0, 0
    $vgpr0_1024 = COPY %3
...

