name: mfma_f32_32x32x4bf16_1k_vva
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_64, $vgpr2_64, $agpr0_1024

    ; CHECK-LABEL: name: mfma_f32_32x32x4bf16_1k_vva
    ; CHECK: liveins: $vgpr0_64, $vgpr2_64, $agpr0_1024
    ; CHECK-NEXT: {{  $}}
