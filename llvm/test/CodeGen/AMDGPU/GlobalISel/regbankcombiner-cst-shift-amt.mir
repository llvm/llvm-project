    %0:sgpr(<2 x s16>) = COPY $sgpr0
    %1:sgpr(s16) = G_CONSTANT i16 11
    %2:sgpr(s16) = G_CONSTANT i16 15
    %3:sgpr(<2 x s16>) = G_BUILD_VECTOR %1(s16), %2(s16)
    %4:sgpr(s32) = G_BITCAST %3(<2 x s16>)
    %5:sgpr(s32) = G_BITCAST %0(<2 x s16>)
    %6:sgpr(s32) = G_CONSTANT i32 16
    %7:sgpr(s32) = G_LSHR %5, %6
    %8:sgpr(s32) = G_LSHR %4, %6
    %9:sgpr(s32) = G_SHL %5, %4
    %10:sgpr(s32) = G_SHL %7, %8
    %11:sgpr(<2 x s16>) = G_BUILD_VECTOR_TRUNC %9(s32), %10(s32)
    $sgpr0 = COPY %11(<2 x s16>)
    S_ENDPGM 0
...

