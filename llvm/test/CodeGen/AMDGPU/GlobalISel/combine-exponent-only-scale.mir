# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.50 -run-pass=amdgpu-postlegalizer-combiner -amdgpupostlegalizercombiner-only-enable-rule=exponent_only_scale -verify-machineinstrs %s -o - | FileCheck %s

# V_CVT_SCALEF32_* conversions to narrow formats only read the exponent field
# of the f32 scale operand.

---
name: fneg_multi_use
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: fneg_multi_use
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:_(<2 x f16>) = COPY $vgpr0
    ; CHECK-NEXT: %s:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: %old:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %fneg:_(f32) = G_FNEG %s
    ; CHECK-NEXT: %r:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %src(<2 x f16>), %s(f32), 0
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %fneg(f32)
    %src:_(<2 x f16>) = COPY $vgpr0
    %s:_(f32) = COPY $vgpr1
    %old:_(i32) = G_CONSTANT i32 0
    %fneg:_(f32) = G_FNEG %s
    %r:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %src(<2 x f16>), %fneg(f32), 0
    $vgpr0 = COPY %r(i32)
    $vgpr1 = COPY %fneg(f32)
...

---
name: e8m0_zext
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: e8m0_zext
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:_(<2 x f16>) = COPY $vgpr0
    ; CHECK-NEXT: %w:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: %old:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %w16:_(i16) = G_TRUNC %w(i32)
    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %w16(i16)
    ; CHECK-NEXT: %c23:_(i32) = G_CONSTANT i32 23
    ; CHECK-NEXT: %shl:_(i32) = G_SHL %ext, %c23(i32)
    ; CHECK-NEXT: %scale:_(f32) = G_BITCAST %shl(i32)
    ; CHECK-NEXT: %r:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %src(<2 x f16>), %scale(f32), 0
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    %src:_(<2 x f16>) = COPY $vgpr0
    %w:_(i32) = COPY $vgpr1
    %old:_(i32) = G_CONSTANT i32 0
    %w16:_(i16) = G_TRUNC %w(i32)
    %mask:_(i16) = G_CONSTANT i16 255
    %e8m0:_(i16) = G_AND %w16, %mask
    %ext:_(i32) = G_ZEXT %e8m0(i16)
    %c23:_(i32) = G_CONSTANT i32 23
    %shl:_(i32) = G_SHL %ext, %c23(i32)
    %scale:_(f32) = G_BITCAST %shl(i32)
    %r:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %src(<2 x f16>), %scale(f32), 0
    $vgpr0 = COPY %r(i32)
...

---
name: vector_lane_constant
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3

    ; CHECK-LABEL: name: vector_lane_constant
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(<2 x f16>) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(<2 x f16>) = COPY $vgpr1
    ; CHECK-NEXT: %p:_(p1) = COPY $vgpr2_vgpr3
    ; CHECK-NEXT: %old:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %load:_(<2 x i32>) = G_LOAD %p(p1) :: (load (<2 x i32>), addrspace 1)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES %load(<2 x i32>)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(f32) = G_BITCAST [[UV]](i32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float 3.573310e-43
    ; CHECK-NEXT: %r0:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %a(<2 x f16>), [[BITCAST]](f32), 0
    ; CHECK-NEXT: %r1:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %b(<2 x f16>), [[C]](f32), 0
    ; CHECK-NEXT: $vgpr0 = COPY %r0(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %r1(i32)
    %a:_(<2 x f16>) = COPY $vgpr0
    %b:_(<2 x f16>) = COPY $vgpr1
    %p:_(p1) = COPY $vgpr2_vgpr3
    %old:_(i32) = G_CONSTANT i32 0
    %exp:_(i32) = G_CONSTANT i32 2139095040
    %low:_(i32) = G_CONSTANT i32 255
    %mask:_(<2 x i32>) = G_BUILD_VECTOR %exp(i32), %low(i32)
    %load:_(<2 x i32>) = G_LOAD %p(p1) :: (load (<2 x i32>), addrspace 1)
    %and:_(<2 x i32>) = G_AND %load, %mask
    %cast:_(<2 x f32>) = G_BITCAST %and(<2 x i32>)
    %s0:_(f32), %s1:_(f32) = G_UNMERGE_VALUES %cast(<2 x f32>)
    %r0:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %a(<2 x f16>), %s0(f32), 0
    %r1:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %b(<2 x f16>), %s1(f32), 0
    $vgpr0 = COPY %r0(i32)
    $vgpr1 = COPY %r1(i32)
...

# A demanded lane of a constant splat is still recognized as constant. Each
# scale use can bypass the exponent mask independently, for either lane.
---
name: vector_lane_constant_splat
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3

    ; CHECK-LABEL: name: vector_lane_constant_splat
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(<2 x f16>) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(<2 x f16>) = COPY $vgpr1
    ; CHECK-NEXT: %p:_(p1) = COPY $vgpr2_vgpr3
    ; CHECK-NEXT: %old:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %load:_(<2 x i32>) = G_LOAD %p(p1) :: (load (<2 x i32>), addrspace 1)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES %load(<2 x i32>)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(f32) = G_BITCAST [[UV]](i32)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(f32) = G_BITCAST [[UV1]](i32)
    ; CHECK-NEXT: %r0:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %a(<2 x f16>), [[BITCAST]](f32), 0
    ; CHECK-NEXT: %r1:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %b(<2 x f16>), [[BITCAST1]](f32), 0
    ; CHECK-NEXT: $vgpr0 = COPY %r0(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %r1(i32)
    %a:_(<2 x f16>) = COPY $vgpr0
    %b:_(<2 x f16>) = COPY $vgpr1
    %p:_(p1) = COPY $vgpr2_vgpr3
    %old:_(i32) = G_CONSTANT i32 0
    %exp:_(i32) = G_CONSTANT i32 2139095040
    %mask:_(<2 x i32>) = G_BUILD_VECTOR %exp(i32), %exp(i32)
    %load:_(<2 x i32>) = G_LOAD %p(p1) :: (load (<2 x i32>), addrspace 1)
    %and:_(<2 x i32>) = G_AND %load, %mask
    %cast:_(<2 x f32>) = G_BITCAST %and(<2 x i32>)
    %s0:_(f32), %s1:_(f32) = G_UNMERGE_VALUES %cast(<2 x f32>)
    %r0:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %a(<2 x f16>), %s0(f32), 0
    %r1:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.scalef32.pk.fp4.f16), %old(i32), %b(<2 x f16>), %s1(f32), 0
    $vgpr0 = COPY %r0(i32)
    $vgpr1 = COPY %r1(i32)
...
