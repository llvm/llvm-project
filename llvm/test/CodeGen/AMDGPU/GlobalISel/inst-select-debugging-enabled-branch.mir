# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1310 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1310 -O0 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

---
name: negated_fallthrough
legalized: true
regBankSelected: true
body: |
  ; CHECK-LABEL: name: negated_fallthrough
  ; CHECK: bb.0:
  ; CHECK-NEXT: successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NOT: S_GETREG_B32
  ; CHECK: nomerge S_CBRANCH_CDBGSYS_OR_USER %bb.1
  ; CHECK-NEXT: S_BRANCH %bb.2
  ; CHECK-NOT: S_GETREG_B32
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.s.getreg), 3330
    %1:sgpr(s32) = G_CONSTANT i32 0
    %2:sgpr(s32) = G_ICMP intpred(eq), %0, %1
    G_BRCOND %2, %bb.2
  bb.1:
    S_ENDPGM 0
  bb.2:
    S_ENDPGM 0
...

---
name: negated_explicit_branch
legalized: true
regBankSelected: true
body: |
  ; CHECK-LABEL: name: negated_explicit_branch
  ; CHECK: bb.0:
  ; CHECK-NOT: S_GETREG_B32
  ; CHECK: nomerge S_CBRANCH_CDBGSYS_OR_USER %bb.2
  ; CHECK-NEXT: S_BRANCH %bb.1
  ; CHECK-NOT: S_GETREG_B32
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.s.getreg), 3330
    %1:sgpr(s32) = G_CONSTANT i32 0
    %2:sgpr(s32) = G_ICMP intpred(eq), %0, %1
    G_BRCOND %2, %bb.1
    G_BR %bb.2
  bb.1:
    S_ENDPGM 0
  bb.2:
    S_ENDPGM 0
...

---
name: bitwise_not_wide
legalized: true
regBankSelected: true
body: |
  ; CHECK-LABEL: name: bitwise_not_wide
  ; CHECK: S_GETREG_B32
  ; CHECK: S_CMP_LG_U32
  ; CHECK: S_XOR_B32
  ; CHECK: S_CBRANCH_SCC1 %bb.1
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.s.getreg), 3330
    %1:sgpr(s32) = G_CONSTANT i32 0
    %2:sgpr(s32) = G_ICMP intpred(ne), %0, %1
    %3:sgpr(s32) = G_CONSTANT i32 -1
    %4:sgpr(s32) = G_XOR %2, %3
    G_BRCOND %4, %bb.1
    G_BR %bb.2
  bb.1:
    S_ENDPGM 0
  bb.2:
    S_ENDPGM 0
...

---
name: shared_condition
legalized: true
regBankSelected: true
body: |
  ; CHECK-LABEL: name: shared_condition
  ; CHECK: S_GETREG_B32
  ; CHECK: S_CMP_LG_U32
  ; CHECK: S_CBRANCH_SCC1 %bb.1
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.s.getreg), 3330
    %1:sgpr(s32) = G_CONSTANT i32 0
    %2:sgpr(s32) = G_ICMP intpred(ne), %0, %1
    $sgpr0 = COPY %2
    G_BRCOND %2, %bb.1
    G_BR %bb.2
  bb.1:
    S_ENDPGM 0
  bb.2:
    S_ENDPGM 0
...

---
name: shared_getreg
legalized: true
regBankSelected: true
body: |
  ; CHECK-LABEL: name: shared_getreg
  ; CHECK: S_GETREG_B32
  ; CHECK: S_CMP_LG_U32
  ; CHECK: S_CBRANCH_SCC1 %bb.1
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.s.getreg), 3330
    $sgpr0 = COPY %0
    %1:sgpr(s32) = G_CONSTANT i32 0
    %2:sgpr(s32) = G_ICMP intpred(ne), %0, %1
    G_BRCOND %2, %bb.1
    G_BR %bb.2
  bb.1:
    S_ENDPGM 0
  bb.2:
    S_ENDPGM 0
...

---
name: other_hwreg
legalized: true
regBankSelected: true
body: |
  ; CHECK-LABEL: name: other_hwreg
  ; CHECK: S_GETREG_B32 3331
  ; CHECK: S_CMP_LG_U32
  ; CHECK: S_CBRANCH_SCC1 %bb.1
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr(s32) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.s.getreg), 3331
    %1:sgpr(s32) = G_CONSTANT i32 0
    %2:sgpr(s32) = G_ICMP intpred(ne), %0, %1
    G_BRCOND %2, %bb.1
    G_BR %bb.2
  bb.1:
    S_ENDPGM 0
  bb.2:
    S_ENDPGM 0
...
