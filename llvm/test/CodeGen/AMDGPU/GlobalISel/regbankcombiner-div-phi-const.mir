  ; CHECK-NEXT:   [[FCMP:%[0-9]+]]:vcc(i1) = G_FCMP floatpred(uge), [[COPY]](f32), [[COPY1]]
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:vgpr(i32) = G_CONSTANT i32 -1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64_xexec(i1) = COPY [[FCMP]](i1)
  ; CHECK-NEXT:   [[SI_IF:%[0-9]+]]:sreg_64_xexec(i64) = SI_IF [[COPY2]](i1), %bb.2, implicit-def $exec, implicit-def dead $scc, implicit $exec
