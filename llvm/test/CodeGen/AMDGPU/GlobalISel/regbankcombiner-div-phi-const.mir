  ; CHECK-NEXT:   G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.end.cf), [[COPY3]](i64)
  ; CHECK-NEXT:   $vgpr0 = COPY [[PHI]](i32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
