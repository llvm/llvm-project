    %1:_(i16) = G_TRUNC %0
    %2:_(f16) = G_BITCAST %1
    %3:_(f16) = G_FEXP %2
    %4:_(i16) = G_BITCAST %3
    %5:_(i32) = G_ANYEXT %4
    $vgpr0 = COPY %5
...

