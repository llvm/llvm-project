# RUN: llc -mtriple=amdgpu10.10 -run-pass="amdgpu-reg-bank-select,amdgpu-reg-bank-legalize" %s -o - | FileCheck %s

# Registers created by the S1 cleanup combines keep the source's typed LLT.

---
name: brcond_trunc_i64
legalized: true
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: brcond_trunc_i64
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr(i64) = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:sgpr(i32), [[UV1:%[0-9]+]]:sgpr(i32) = G_UNMERGE_VALUES [[COPY]](i64)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:sgpr(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:sgpr(i32) = G_AND [[UV]], [[C]]
  ; CHECK-NEXT:   G_BRCOND [[AND]](i32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0_sgpr1
    %0:_(i64) = COPY $sgpr0_sgpr1
    %1:_(i1) = G_TRUNC %0(i64)
    G_BRCOND %1(i1), %bb.2
    G_BR %bb.1

  bb.1:
    S_ENDPGM 0

  bb.2:
    S_ENDPGM 0
...
---
name: anyext_trunc_i32_to_i64
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0
    ; CHECK-LABEL: name: anyext_trunc_i32_to_i64
    ; CHECK: liveins: $sgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr(i32) = COPY $sgpr0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:sgpr(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[MV:%[0-9]+]]:sgpr(i64) = G_MERGE_VALUES [[COPY]](i32), [[DEF]](i32)
    ; CHECK-NEXT: $sgpr0_sgpr1 = COPY [[MV]](i64)
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0_sgpr1
    %0:_(i32) = COPY $sgpr0
    %1:_(i1) = G_TRUNC %0(i32)
    %2:_(i64) = G_ANYEXT %1(i1)
    $sgpr0_sgpr1 = COPY %2(i64)
    SI_RETURN_TO_EPILOG implicit $sgpr0_sgpr1
...
