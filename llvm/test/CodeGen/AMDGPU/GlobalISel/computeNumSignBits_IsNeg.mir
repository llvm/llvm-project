# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=amdgpu-regbank-combiner %s -o - | FileCheck %s

# Ensure IsNeg is set correctly for computeNumSignBits.  Verify IsNeg is set to false by
# checking for generation of the llvm.amdgcn.mul.u24 intrinsic.  Nodes tested in this
# file are difficult to test via LLVM IR (computeNumSignBits_IsNeg.ll) because:
#  - G_TRUNC(G_AND i64, mask): IR folds trunc(and i64 x, mask) to and(trunc x, mask)
#    before GISel, eliminating the G_TRUNC before the regbank combiner runs.
#  - G_SHL with constant shift: reg-bank-legalize places the constant in SGPR and
#    inserts a COPY to VGPR; getValidShiftAmountRange does not trace through COPY,
#    so the G_SHL early returns that bypass the final getKnownBits are not triggered.

# G_TRUNC path: trunc(and i64 x, 0xFFFFFF) has 40 leading zeros in i64.
# Truncation yields NSB=8; IsNeg=false.
---
name: mul24_trunc_nonneg
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2

    ; CHECK-LABEL: name: mul24_trunc_nonneg
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr2
    ; CHECK-NEXT: %mask64:sgpr(s64) = G_CONSTANT i64 16777215
    ; CHECK-NEXT: %mask64v:vgpr(s64) = COPY %mask64(s64)
    ; CHECK-NEXT: %masked64:vgpr(s64) = G_AND [[COPY]], %mask64v
    ; CHECK-NEXT: %tr:vgpr(s32) = G_TRUNC %masked64(s64)
    ; CHECK-NEXT: %mask32:sgpr(s32) = G_CONSTANT i32 16777215
    ; CHECK-NEXT: %mask32v:vgpr(s32) = COPY %mask32(s32)
    ; CHECK-NEXT: %masked32:vgpr(s32) = G_AND [[COPY1]], %mask32v
    ; CHECK-NEXT: %result:vgpr(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24), %tr(s32), %masked32(s32)
    ; CHECK-NEXT: $vgpr0 = COPY %result(s32)
    ; CHECK-NEXT: S_SETPC_B64_return undef $sgpr30_sgpr31, implicit $vgpr0
    %0:vgpr(s64) = COPY $vgpr0_vgpr1
    %1:vgpr(s32) = COPY $vgpr2
    %mask64:sgpr(s64) = G_CONSTANT i64 16777215
    %mask64v:vgpr(s64) = COPY %mask64(s64)
    %masked64:vgpr(s64) = G_AND %0, %mask64v
    %tr:vgpr(s32) = G_TRUNC %masked64(s64)
    %mask32:sgpr(s32) = G_CONSTANT i32 16777215
    %mask32v:vgpr(s32) = COPY %mask32(s32)
    %masked32:vgpr(s32) = G_AND %1, %mask32v
    %result:vgpr(s32) = G_MUL %tr, %masked32
    $vgpr0 = COPY %result(s32)
    S_SETPC_B64_return undef $sgpr30_sgpr31, implicit $vgpr0
...

# G_SHL general path: shl(and x, 0xffff), 8.
# shl yields NSB=8; SrcIsNeg=false.
---
name: mul24_shl_general
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: mul24_shl_general
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr1
    ; CHECK-NEXT: %mask16:sgpr(s32) = G_CONSTANT i32 65535
    ; CHECK-NEXT: %mask16v:vgpr(s32) = COPY %mask16(s32)
    ; CHECK-NEXT: %andx:vgpr(s32) = G_AND [[COPY]], %mask16v
    ; CHECK-NEXT: %shamt:vgpr(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %shl:vgpr(s32) = G_SHL %andx, %shamt(s32)
    ; CHECK-NEXT: %mask24:sgpr(s32) = G_CONSTANT i32 16777215
    ; CHECK-NEXT: %mask24v:vgpr(s32) = COPY %mask24(s32)
    ; CHECK-NEXT: %andy:vgpr(s32) = G_AND [[COPY1]], %mask24v
    ; CHECK-NEXT: %result:vgpr(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24), %shl(s32), %andy(s32)
    ; CHECK-NEXT: $vgpr0 = COPY %result(s32)
    ; CHECK-NEXT: S_SETPC_B64_return undef $sgpr30_sgpr31, implicit $vgpr0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(s32) = COPY $vgpr1
    %mask16:sgpr(s32) = G_CONSTANT i32 65535
    %mask16v:vgpr(s32) = COPY %mask16(s32)
    %andx:vgpr(s32) = G_AND %0, %mask16v
    %shamt:vgpr(s32) = G_CONSTANT i32 8
    %shl:vgpr(s32) = G_SHL %andx, %shamt
    %mask24:sgpr(s32) = G_CONSTANT i32 16777215
    %mask24v:vgpr(s32) = COPY %mask24(s32)
    %andy:vgpr(s32) = G_AND %1, %mask24v
    %result:vgpr(s32) = G_MUL %shl, %andy
    $vgpr0 = COPY %result(s32)
    S_SETPC_B64_return undef $sgpr30_sgpr31, implicit $vgpr0
...

# G_SHL extend path: shl(zext(and i16 x, 0x7F), 16).
# shl yields NSB=9; ExtIsNeg=false.
---
name: mul24_shl_zext
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: mul24_shl_zext
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr1
    ; CHECK-NEXT: %x16:vgpr(s16) = G_TRUNC [[COPY]](s32)
    ; CHECK-NEXT: %mask7f:sgpr(s16) = G_CONSTANT i16 127
    ; CHECK-NEXT: %mask7fv:vgpr(s16) = COPY %mask7f(s16)
    ; CHECK-NEXT: %masked16:vgpr(s16) = G_AND %x16, %mask7fv
    ; CHECK-NEXT: %zext:vgpr(s32) = G_ZEXT %masked16(s16)
    ; CHECK-NEXT: %shamt:vgpr(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %shl:vgpr(s32) = G_SHL %zext, %shamt(s32)
    ; CHECK-NEXT: %mask24:sgpr(s32) = G_CONSTANT i32 16777215
    ; CHECK-NEXT: %mask24v:vgpr(s32) = COPY %mask24(s32)
    ; CHECK-NEXT: %andy:vgpr(s32) = G_AND [[COPY1]], %mask24v
    ; CHECK-NEXT: %result:vgpr(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24), %shl(s32), %andy(s32)
    ; CHECK-NEXT: $vgpr0 = COPY %result(s32)
    ; CHECK-NEXT: S_SETPC_B64_return undef $sgpr30_sgpr31, implicit $vgpr0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(s32) = COPY $vgpr1
    %x16:vgpr(s16) = G_TRUNC %0(s32)
    %mask7f:sgpr(s16) = G_CONSTANT i16 127
    %mask7fv:vgpr(s16) = COPY %mask7f(s16)
    %masked16:vgpr(s16) = G_AND %x16, %mask7fv
    %zext:vgpr(s32) = G_ZEXT %masked16(s16)
    %shamt:vgpr(s32) = G_CONSTANT i32 16
    %shl:vgpr(s32) = G_SHL %zext, %shamt
    %mask24:sgpr(s32) = G_CONSTANT i32 16777215
    %mask24v:vgpr(s32) = COPY %mask24(s32)
    %andy:vgpr(s32) = G_AND %1, %mask24v
    %result:vgpr(s32) = G_MUL %shl, %andy
    $vgpr0 = COPY %result(s32)
    S_SETPC_B64_return undef $sgpr30_sgpr31, implicit $vgpr0
...
