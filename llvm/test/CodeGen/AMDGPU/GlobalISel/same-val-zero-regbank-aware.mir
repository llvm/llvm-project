# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu10.10-amd-mesa3d -run-pass=amdgpu-regbank-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Fold (xor x, x) / (sub x, x) -> 0 after RegBankSelect. Every register the
# fold creates needs a bank, or selection fails later.

---
name: xor_same_reg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: xor_same_reg
    ; CHECK: liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p1) = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: G_STORE [[C]](s32), [[COPY]](p1) :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(p1) = COPY $vgpr1_vgpr2
    %2:vgpr(s32) = G_XOR %0, %0
    G_STORE %2(s32), %1(p1) :: (store (s32), addrspace 1)
    S_ENDPGM 0
...
---
name: sub_same_reg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: sub_same_reg
    ; CHECK: liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p1) = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: G_STORE [[C]](s32), [[COPY]](p1) :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(p1) = COPY $vgpr1_vgpr2
    %2:vgpr(s32) = G_SUB %0, %0
    G_STORE %2(s32), %1(p1) :: (store (s32), addrspace 1)
    S_ENDPGM 0
...
---
name: xor_same_reg_through_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: xor_same_reg_through_copy
    ; CHECK: liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p1) = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: G_STORE [[C]](s32), [[COPY]](p1) :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(p1) = COPY $vgpr1_vgpr2
    %2:vgpr(s32) = COPY %0
    %3:vgpr(s32) = G_XOR %0, %2
    G_STORE %3(s32), %1(p1) :: (store (s32), addrspace 1)
    S_ENDPGM 0
...

# Vector 0s come out as a scalar G_CONSTANT bitcast into shape.
---
name: xor_same_reg_v2s16_vgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: xor_same_reg_v2s16_vgpr
    ; CHECK: liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p1) = COPY $vgpr1_vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:vgpr(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:vgpr(<2 x s16>) = G_BITCAST [[C]](i32)
    ; CHECK-NEXT: G_STORE [[BITCAST]](<2 x s16>), [[COPY]](p1) :: (store (<2 x s16>), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr(<2 x s16>) = COPY $vgpr0
    %1:vgpr(p1) = COPY $vgpr1_vgpr2
    %2:vgpr(<2 x s16>) = G_XOR %0, %0
    G_STORE %2(<2 x s16>), %1(p1) :: (store (<2 x s16>), addrspace 1)
    S_ENDPGM 0
...

# A G_BUILD_VECTOR splat of <4 x s16> wouldn't be legal here.
---
name: xor_same_reg_v4s16_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr0_vgpr1
    ; CHECK-LABEL: name: xor_same_reg_v4s16_sgpr
    ; CHECK: liveins: $sgpr0_sgpr1, $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p1) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:sgpr(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:sgpr(<4 x s16>) = G_BITCAST [[C]](i64)
    ; CHECK-NEXT: G_STORE [[BITCAST]](<4 x s16>), [[COPY]](p1) :: (store (<4 x s16>), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:sgpr(<4 x s16>) = COPY $sgpr0_sgpr1
    %1:vgpr(p1) = COPY $vgpr0_vgpr1
    %2:sgpr(<4 x s16>) = G_XOR %0, %0
    G_STORE %2(<4 x s16>), %1(p1) :: (store (<4 x s16>), addrspace 1)
    S_ENDPGM 0
...

