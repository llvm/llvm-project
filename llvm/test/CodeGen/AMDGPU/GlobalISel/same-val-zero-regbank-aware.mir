body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr0_vgpr1
    ; CHECK-LABEL: name: xor_same_reg_v2s32_sgpr
    ; CHECK: liveins: $sgpr0_sgpr1, $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p1) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:sgpr(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:sgpr(<2 x s32>) = G_BITCAST [[C]](i64)
    ; CHECK-NEXT: G_STORE [[BITCAST]](<2 x s32>), [[COPY]](p1) :: (store (<2 x s32>), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:sgpr(<2 x s32>) = COPY $sgpr0_sgpr1
    %1:vgpr(p1) = COPY $vgpr0_vgpr1
    %2:sgpr(<2 x s32>) = G_XOR %0, %0
    G_STORE %2(<2 x s32>), %1(p1) :: (store (<2 x s32>), addrspace 1)
    S_ENDPGM 0
...
