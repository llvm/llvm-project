# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu10.10 -run-pass=instruction-select -verify-machineinstrs -o - %s | FileCheck -check-prefix=GCN %s

# A uniform compare is re-emitted at its SCC users instead of being saved with
# "COPY $scc" and restored with "$scc = COPY", when SCC may be clobbered in
# between.

---
name:            one_restore_clobber_between
legalized:       true
regBankSelected: true

body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2

    ; GCN-LABEL: name: one_restore_clobber_between
    ; GCN: liveins: $sgpr0, $sgpr1, $sgpr2
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; GCN-NEXT: [[COPY2:%[0-9]+]]:sreg_32 = COPY $sgpr2
    ; GCN-NEXT: [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[COPY]], [[COPY2]], implicit-def dead $scc
    ; GCN-NEXT: S_CMP_GT_I32 [[COPY]], [[COPY1]], implicit-def $scc
    ; GCN-NEXT: [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_AND_B32_]], [[COPY]], implicit $scc
    ; GCN-NEXT: $sgpr0 = COPY [[S_CSELECT_B32_]]
    ; GCN-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0
    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = COPY $sgpr2
    %3:sgpr(i32) = G_ICMP intpred(sgt), %0, %1
    %4:sgpr(i32) = G_AND %0, %2
    %5:sgpr(i32) = G_SELECT %3, %4, %0
    $sgpr0 = COPY %5
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

