    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = COPY $sgpr2
    %3:sgpr(i32) = G_ICMP intpred(sgt), %0, %1
    %4:sgpr(i32) = G_AND %0, %2
    G_BRCOND %3, %bb.1
    G_BR %bb.2

  bb.1:
    $sgpr0 = COPY %4
    SI_RETURN_TO_EPILOG implicit $sgpr0

  bb.2:
    $sgpr0 = COPY %0
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

