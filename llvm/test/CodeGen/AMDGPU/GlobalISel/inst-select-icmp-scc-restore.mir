  ; GCN-NEXT:   [[COPY3:%[0-9]+]]:sreg_32 = COPY $scc
  ; GCN-NEXT:   S_BRANCH %bb.1
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   [[S_AND_B32_:%[0-9]+]]:sreg_32 = S_AND_B32 [[COPY]], [[COPY2]], implicit-def dead $scc
  ; GCN-NEXT:   $scc = COPY [[COPY3]]
  ; GCN-NEXT:   [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 [[S_AND_B32_]], [[COPY]], implicit $scc
  ; GCN-NEXT:   $sgpr0 = COPY [[S_CSELECT_B32_]]
  ; GCN-NEXT:   SI_RETURN_TO_EPILOG implicit $sgpr0
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2

    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = COPY $sgpr2
    %3:sgpr(i32) = G_ICMP intpred(sgt), %0, %1
    G_BR %bb.1

  bb.1:
    %4:sgpr(i32) = G_AND %0, %2
    %5:sgpr(i32) = G_SELECT %3, %4, %0
    $sgpr0 = COPY %5
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

