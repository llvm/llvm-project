---
name: test_flog2_bf16
body: |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: test_flog2_bf16
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i32) = G_SHL [[COPY]], [[C]](i32)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(f32) = G_BITCAST [[SHL]](i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(f32) = G_FCONSTANT float f0x00800000
    ; CHECK-NEXT: [[FCMP:%[0-9]+]]:_(s1) = G_FCMP floatpred(olt), [[BITCAST]](f32), [[C1]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(f32) = G_FCONSTANT float f0x4F800000
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(f32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(f32) = G_SELECT [[FCMP]](s1), [[C2]], [[C3]]
    ; CHECK-NEXT: [[FMUL:%[0-9]+]]:_(f32) = G_FMUL [[BITCAST]], [[SELECT]]
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(f32) = G_INTRINSIC intrinsic(@llvm.amdgcn.log), [[FMUL]](f32)
    ; CHECK-NEXT: [[C4:%[0-9]+]]:_(f32) = G_FCONSTANT float 3.200000e+01
    ; CHECK-NEXT: [[C5:%[0-9]+]]:_(f32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(f32) = G_SELECT [[FCMP]](s1), [[C4]], [[C5]]
    ; CHECK-NEXT: [[FSUB:%[0-9]+]]:_(f32) = G_FSUB [[INT]], [[SELECT1]]
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(i32) = G_BITCAST [[FSUB]](f32)
    ; CHECK-NEXT: [[C6:%[0-9]+]]:_(i32) = G_CONSTANT i32 4194304
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[BITCAST1]], [[C6]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR [[BITCAST1]], [[C]](i32)
    ; CHECK-NEXT: [[C7:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[LSHR]], [[C7]]
    ; CHECK-NEXT: [[C8:%[0-9]+]]:_(i32) = G_CONSTANT i32 32767
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[AND]], [[C8]]
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[BITCAST1]], [[ADD]]
    ; CHECK-NEXT: [[FCMP1:%[0-9]+]]:_(i1) = G_FCMP floatpred(uno), [[FSUB]](f32), [[C5]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[FCMP1]](i1), [[OR]], [[ADD1]]
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(i32) = G_LSHR [[SELECT2]], [[C]](i32)
    ; CHECK-NEXT: $vgpr0 = COPY [[LSHR1]](i32)
    ;
    ; GFX1250-LABEL: name: test_flog2_bf16
    ; GFX1250: liveins: $vgpr0
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; GFX1250-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i32)
    ; GFX1250-NEXT: [[BITCAST:%[0-9]+]]:_(bf16) = G_BITCAST [[TRUNC]](i16)
    ; GFX1250-NEXT: [[FLOG2_:%[0-9]+]]:_(bf16) = G_FLOG2 [[BITCAST]]
    ; GFX1250-NEXT: [[BITCAST1:%[0-9]+]]:_(i16) = G_BITCAST [[FLOG2_]](bf16)
    ; GFX1250-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST1]](i16)
    ; GFX1250-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    %0:_(i32) = COPY $vgpr0
    %1:_(i16) = G_TRUNC %0
    %2:_(bf16) = G_BITCAST %1
    %3:_(bf16) = G_FLOG2 %2
    %4:_(i16) = G_BITCAST %3
    %5:_(i32) = G_ANYEXT %4
    $vgpr0 = COPY %5
...

