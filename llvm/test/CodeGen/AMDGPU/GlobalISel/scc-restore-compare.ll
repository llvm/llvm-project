  br i1 %u, label %then, label %exit

then:
  %mul = mul i32 %and, %c
  br label %exit

exit:
  %p = phi i32 [ %and, %entry ], [ %mul, %then ]
  %r = select i1 %cmp, i32 %p, i32 %a
  ret i32 %r
}

