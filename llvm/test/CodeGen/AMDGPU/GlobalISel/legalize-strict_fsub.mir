---
name: test_strict_fsub_f64
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3

    ; GCN-LABEL: name: test_strict_fsub_f64
    ; GCN: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:_(f64) = COPY $vgpr0_vgpr1
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:_(f64) = COPY $vgpr2_vgpr3
    ; GCN-NEXT: [[FNEG:%[0-9]+]]:_(f64) = G_FNEG [[COPY1]]
    ; GCN-NEXT: [[STRICT_FADD:%[0-9]+]]:_(f64) = G_STRICT_FADD [[COPY]], [[FNEG]]
    ; GCN-NEXT: $vgpr0_vgpr1 = COPY [[STRICT_FADD]](f64)
    %0:_(f64) = COPY $vgpr0_vgpr1
    %1:_(f64) = COPY $vgpr2_vgpr3
    %2:_(f64) = G_STRICT_FSUB %0, %1
    $vgpr0_vgpr1 = COPY %2
...

