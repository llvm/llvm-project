# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: split-file %s %t
# RUN: llc -mtriple=amdgpu8.03 -run-pass='amdgpu-reg-bank-select,amdgpu-reg-bank-legalize' -o - %t/valid.mir | FileCheck %s

# RUN: not --crash llc -mtriple=amdgpu8.03 -run-pass='amdgpu-reg-bank-select,amdgpu-reg-bank-legalize' -filetype=null %t/virtual.mir 2>&1 | FileCheck -check-prefix=ERR %s

#--- valid.mir
# TODO: We could use scalar
---
name: amdgpu_wave_address
legalized: true
tracksRegLiveness: false
body: |
  bb.0:
    ; CHECK-LABEL: name: amdgpu_wave_address
    ; CHECK: [[AMDGPU_WAVE_ADDRESS:%[0-9]+]]:sgpr(p5) = G_AMDGPU_WAVE_ADDRESS $sgpr32
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[AMDGPU_WAVE_ADDRESS]](p5)
    %0:_(p5) = G_AMDGPU_WAVE_ADDRESS $sgpr32
    S_ENDPGM 0, implicit %0
...

# TODO: Should infer v here
---
name: amdgpu_wave_address_v
legalized: true
tracksRegLiveness: false
body: |
  bb.0:
    ; CHECK-LABEL: name: amdgpu_wave_address_v
    ; CHECK: [[DEF:%[0-9]+]]:sgpr(p1) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[AMDGPU_WAVE_ADDRESS:%[0-9]+]]:sgpr(p5) = G_AMDGPU_WAVE_ADDRESS $sgpr32
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(p5) = COPY [[AMDGPU_WAVE_ADDRESS]](p5)
    ; CHECK-NEXT: G_STORE [[COPY]](p5), [[DEF]](p1) :: (store (p5), addrspace 1)
    %0:_(p1) = G_IMPLICIT_DEF
    %1:_(p5) = G_AMDGPU_WAVE_ADDRESS $sgpr32
    G_STORE %1, %0 :: (store (p5), addrspace 1)
...

#--- virtual.mir
# ERR: *** Bad machine code: pseudo expects only physical SGPRs ***
# ERR: - function:    amdgpu_wave_address_virtual_src
# ERR: - instruction: {{.*}} = G_AMDGPU_WAVE_ADDRESS {{%[0-9]+}}
---
name: amdgpu_wave_address_virtual_src
legalized: true
tracksRegLiveness: false
body: |
  bb.0:
    %0:_(p5) = COPY $sgpr32
    %1:_(p5) = G_AMDGPU_WAVE_ADDRESS %0
    S_ENDPGM 0, implicit %1
...
