# The condition has another user. With 64-bit scalar adds, a uniform add or
# select does not clobber SCC, but the two carry ops would.
name: select_inc_s64_shared_cond_not_folded
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    ; CHECK-LABEL: name: select_inc_s64_shared_cond_not_folded
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $vgpr2_vgpr3
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(uge), [[COPY]](i32), [[COPY1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[COPY2]], [[C]]
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i1), [[ADD]], [[COPY2]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i1), [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[SELECT]](i64)
    ; CHECK-NEXT: $vgpr2 = COPY [[SELECT1]](i32)
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i64) = COPY $vgpr2_vgpr3
    %3:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %4:_(i64) = G_CONSTANT i64 1
    %5:_(i64) = G_ADD %2, %4
    %6:_(i64) = G_SELECT %3(i1), %5, %2
    %7:_(i32) = G_SELECT %3(i1), %0, %1
    $vgpr0_vgpr1 = COPY %6(i64)
    $vgpr2 = COPY %7(i32)
...
