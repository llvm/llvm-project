    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP]](i1), [[COPY]], [[COPY1]]
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[ADD]](i64)
    ; CHECK-NEXT: $vgpr2 = COPY [[SELECT]](i32)
    %0:_(i32) = COPY $vgpr0
    %1:_(i32) = COPY $vgpr1
    %2:_(i64) = COPY $vgpr2_vgpr3
    %3:_(i1) = G_ICMP intpred(uge), %0(i32), %1
    %4:_(i64) = G_ZEXT %3(i1)
    %5:_(i64) = G_ADD %2, %4
    %6:_(i32) = G_SELECT %3(i1), %0, %1
    $vgpr0_vgpr1 = COPY %5(i64)
    $vgpr2 = COPY %6(i32)
...
