# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=amdgpu-prelegalizer-combiner %s -o - | FileCheck %s

# The offset and width operands of G_SBFX are unsigned. An i1 width of 1 must
# not be read as -1 when the compare is folded with known bits.

---
name:            sbfx_i1_width1_unknown
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sbfx_i1_width1_unknown
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i1) = G_CONSTANT i1 false
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i1) = G_CONSTANT i1 true
    ; CHECK-NEXT: [[SBFX:%[0-9]+]]:_(i32) = G_SBFX [[COPY]], [[C]](i1), [[C1]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(eq), [[SBFX]](i32), [[C2]]
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i32) = G_ZEXT [[ICMP]](i1)
    ; CHECK-NEXT: $vgpr0 = COPY [[ZEXT]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %1:_(i1) = G_CONSTANT i1 false
    %2:_(i1) = G_CONSTANT i1 true
    %3:_(i32) = G_SBFX %0, %1, %2
    %4:_(i32) = G_CONSTANT i32 0
    %5:_(i1) = G_ICMP intpred(eq), %3, %4
    %6:_(i32) = G_ZEXT %5
    $vgpr0 = COPY %6
    SI_RETURN implicit $vgpr0
...
---
name:            sbfx_i1_width1_odd
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sbfx_i1_width1_odd
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY [[C]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %7:_(i32) = G_CONSTANT i32 1
    %8:_(i32) = G_OR %0, %7
    %1:_(i1) = G_CONSTANT i1 false
    %2:_(i1) = G_CONSTANT i1 true
    %3:_(i32) = G_SBFX %8, %1, %2
    %4:_(i32) = G_CONSTANT i32 0
    %5:_(i1) = G_ICMP intpred(eq), %3, %4
    %6:_(i32) = G_ZEXT %5
    $vgpr0 = COPY %6
    SI_RETURN implicit $vgpr0
...
---
name:            sbfx_i1_width1_even
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sbfx_i1_width1_even
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: $vgpr0 = COPY [[C]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %7:_(i32) = G_CONSTANT i32 -2
    %8:_(i32) = G_AND %0, %7
    %1:_(i1) = G_CONSTANT i1 false
    %2:_(i1) = G_CONSTANT i1 true
    %3:_(i32) = G_SBFX %8, %1, %2
    %4:_(i32) = G_CONSTANT i32 0
    %5:_(i1) = G_ICMP intpred(eq), %3, %4
    %6:_(i32) = G_ZEXT %5
    $vgpr0 = COPY %6
    SI_RETURN implicit $vgpr0
...
