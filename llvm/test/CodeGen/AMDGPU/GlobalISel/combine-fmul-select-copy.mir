# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa \
# RUN:   -run-pass=amdgpu-prelegalizer-combiner \
# RUN:   -amdgpuprelegalizercombiner-only-enable-rule=combine_fmul_with_select_to_fldexp \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa \
# RUN:   -run-pass=amdgpu-postlegalizer-combiner \
# RUN:   -amdgpupostlegalizercombiner-only-enable-rule=combine_fmul_with_select_to_fldexp \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Restrict the combiner to this rule so copy propagation cannot remove the copy
# before the matcher looks through it. Constant creation order depends on the
# host compiler argument evaluation order. The multiplicand must remain %x in
# either operand order, including when negative constants require an fneg.

---
name: rhs_select_copy
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: rhs_select_copy
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: %cond32:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %cond32(i32)
    ; CHECK-DAG: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 3
    ; CHECK-DAG: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT %cond(i1), [[C]], [[C1]]
    ; CHECK-NEXT: %mul:_(f32) = G_FLDEXP %x, [[SELECT]](i32)
    ; CHECK-NEXT: $vgpr0 = COPY %mul(f32)
    %x:_(f32) = COPY $vgpr0
    %cond32:_(i32) = COPY $vgpr1
    %cond:_(i1) = G_TRUNC %cond32
    %a:_(f32) = G_FCONSTANT float 8.0
    %b:_(f32) = G_FCONSTANT float 16.0
    %sel:_(f32) = G_SELECT %cond, %a, %b
    %copy:_(f32) = COPY %sel
    %mul:_(f32) = G_FMUL %x, %copy
    $vgpr0 = COPY %mul
...

