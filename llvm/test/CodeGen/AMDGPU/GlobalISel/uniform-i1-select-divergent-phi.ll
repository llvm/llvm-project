; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -global-isel -mtriple=amdgpu12.01-amd-amdhsa < %s | FileCheck %s

; The uniform i1 select is legalized as an S16 select. Its result is used by a
; divergent phi, so it needs to be copied to a lane mask.

define amdgpu_kernel void @uniform_i1_select_divergent_phi(ptr addrspace(1) %out, i1 %c, i1 %a, i1 %b, i32 %n) {
; CHECK-LABEL: uniform_i1_select_divergent_phi:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b64 s[0:1], s[4:5], 0x8
; CHECK-NEXT:    v_and_b32_e32 v0, 0x3ff, v0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_lshr_b32 s2, s0, 8
; CHECK-NEXT:    s_lshr_b32 s3, s0, 16
; CHECK-NEXT:    s_and_b32 s0, s0, 1
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_3) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_cmp_lg_u32 s0, 0
; CHECK-NEXT:    s_cselect_b32 s0, s2, s3
; CHECK-NEXT:    s_mov_b32 s2, exec_lo
; CHECK-NEXT:    s_and_b32 s0, s0, 1
; CHECK-NEXT:    s_cmp_lg_u32 s0, 0
; CHECK-NEXT:    s_cselect_b32 s0, exec_lo, 0
; CHECK-NEXT:    v_cmpx_ne_u32_e32 0, v0
; CHECK-NEXT:  ; %bb.1: ; %else
; CHECK-NEXT:    s_cmp_lg_u32 s1, 0
; CHECK-NEXT:    s_cselect_b32 s1, exec_lo, 0
; CHECK-NEXT:    s_and_not1_b32 s0, s0, exec_lo
; CHECK-NEXT:    s_and_b32 s1, exec_lo, s1
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    s_or_b32 s0, s0, s1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s2
; CHECK-NEXT:    s_load_b64 s[2:3], s[4:5], 0x0
; CHECK-NEXT:    v_mov_b32_e32 v0, 0
; CHECK-NEXT:    v_cndmask_b32_e64 v1, 0, 1, s0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    global_store_b32 v0, v1, s[2:3]
; CHECK-NEXT:    s_endpgm
entry:
  %s = select i1 %c, i1 %a, i1 %b
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %d = icmp eq i32 %tid, 0
  br i1 %d, label %exit, label %else

else:
  %t = icmp ne i32 %n, 0
  br label %exit

exit:
  %p = phi i1 [ %t, %else ], [ %s, %entry ]
  %z = zext i1 %p to i32
  store i32 %z, ptr addrspace(1) %out
  ret void
}
