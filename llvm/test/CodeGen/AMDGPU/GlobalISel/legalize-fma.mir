    ; GCN-NEXT: $vgpr0 = COPY [[FMA]](<2 x f16>)
    %0:_(<2 x f16>) = COPY $vgpr0
    %1:_(<2 x f16>) = COPY $vgpr1
    %2:_(<2 x f16>) = COPY $vgpr2
    %3:_(<2 x f16>) = G_FMA %0, %1, %2
    $vgpr0 = COPY %3
...

