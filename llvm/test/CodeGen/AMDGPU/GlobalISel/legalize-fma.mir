    ; SI-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $vgpr2
    ; SI-NEXT: [[FMA:%[0-9]+]]:_(f32) = G_FMA [[COPY]], [[COPY1]], [[COPY2]]
    ; SI-NEXT: $vgpr0 = COPY [[FMA]](f32)
    ;
    ; VI-LABEL: name: test_fma_f32
    ; VI: liveins: $vgpr0, $vgpr1, $vgpr2
    ; VI-NEXT: {{  $}}
