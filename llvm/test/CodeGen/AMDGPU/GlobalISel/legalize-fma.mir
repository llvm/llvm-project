    ; VI-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; VI-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $vgpr2
    ; VI-NEXT: [[FMA:%[0-9]+]]:_(f32) = G_FMA [[COPY]], [[COPY1]], [[COPY2]]
    ; VI-NEXT: $vgpr0 = COPY [[FMA]](f32)
    ;
    ; GCN-LABEL: name: test_fma_f32
    ; GCN: liveins: $vgpr0, $vgpr1, $vgpr2
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; GCN-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $vgpr2
    ; GCN-NEXT: [[FMA:%[0-9]+]]:_(f32) = G_FMA [[COPY]], [[COPY1]], [[COPY2]]
    ; GCN-NEXT: $vgpr0 = COPY [[FMA]](f32)
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(f32) = COPY $vgpr2
    %3:_(f32) = G_FMA %0, %1, %2
    $vgpr0 = COPY %3
...
