# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=amdgpu9.08 -run-pass=instruction-select,machineverifier -o - %s | FileCheck -check-prefixes=GFX9 %s

---
name: foo
legalized: true
regBankSelected: true
machineFunctionInfo:
  mode:
    fp32-output-denormals: false
    fp32-input-denormals: false
body: |
  bb.0:
    ; GFX9-LABEL: name: foo
    ; GFX9: [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
    ; GFX9-NEXT: [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
    ; GFX9-NEXT: [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 16
    ; GFX9-NEXT: [[S_LSHR_B32_:%[0-9]+]]:sreg_32 = S_LSHR_B32 [[COPY]], [[S_MOV_B32_]], implicit-def dead $scc
    ; GFX9-NEXT: [[S_LSHR_B32_1:%[0-9]+]]:sreg_32 = S_LSHR_B32 [[COPY1]], [[S_MOV_B32_]], implicit-def dead $scc
    ; GFX9-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[S_LSHR_B32_]]
    ; GFX9-NEXT: [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[S_LSHR_B32_1]]
    ; GFX9-NEXT: [[V_FMA_MIX_F32_:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_MIX_F32 9, [[COPY3]], 8, [[COPY3]], 8, [[COPY2]], 0, 0, 0, implicit $mode, implicit $exec
    ; GFX9-NEXT: [[V_READFIRSTLANE_B32_:%[0-9]+]]:sreg_32_xm0 = V_READFIRSTLANE_B32 [[V_FMA_MIX_F32_]], implicit $exec
    ; GFX9-NEXT: $sgpr0 = COPY [[V_READFIRSTLANE_B32_]]
    ; GFX9-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0
    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:sgpr(i32) = G_CONSTANT i32 16
    %3:sgpr(i32) = G_LSHR %0:sgpr, %2:sgpr(i32)
    %4:sgpr(f16) = G_TRUNC %3:sgpr(i32)
    %5:sgpr(i32) = G_LSHR %1:sgpr, %2:sgpr(i32)
    %6:sgpr(f16) = G_TRUNC %5:sgpr(i32)
    %7:vgpr(f16) = COPY %4:sgpr(f16)
    %8:vgpr(f32) = G_FPEXT %7:vgpr(f16)
    %9:vgpr(f16) = COPY %6:sgpr(f16)
    %10:vgpr(f32) = G_FPEXT %9:vgpr(f16)
    %11:vgpr(f32) = G_FNEG %10:vgpr
    %12:vgpr(f32) = G_FMA %11:vgpr, %10:vgpr, %8:vgpr
    %13:sgpr(f32) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.readfirstlane), %12:vgpr(f32)
    $sgpr0 = COPY %13:sgpr(f32)
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

# The <4 x half> result of a D16 image sample lives in a single 64-bit register,
# so extracting channel 1 reaches the selector as G_TRUNC(G_LSHR s64, 16).
# V_FMA_MIX_F32 reads hi16 from a 32-bit source via op_sel, so isExtractHiElt
# must reject the 64-bit shift rather than fold it into the operand, which would
# leave a 64-bit register where a 32-bit one is required.
---
name: hi16_from_s64
legalized: true
regBankSelected: true
machineFunctionInfo:
  mode:
    fp32-output-denormals: false
    fp32-input-denormals: false
body: |
  bb.0:
    ; GFX9-LABEL: name: hi16_from_s64
    ; GFX9: [[COPY:%[0-9]+]]:vreg_64 = COPY $vgpr0_vgpr1
    ; GFX9-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 16, implicit $exec
    ; GFX9-NEXT: [[V_LSHRREV_B64_e64_:%[0-9]+]]:vreg_64 = V_LSHRREV_B64_e64 [[V_MOV_B32_e32_]], [[COPY]], implicit $exec
    ; GFX9-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[V_LSHRREV_B64_e64_]].sub0
    ; GFX9-NEXT: [[V_FMA_MIX_F32_:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_MIX_F32 8, [[COPY1]], 8, [[COPY1]], 8, [[COPY1]], 0, 0, 0, implicit $mode, implicit $exec
    ; GFX9-NEXT: $vgpr0 = COPY [[V_FMA_MIX_F32_]]
    ; GFX9-NEXT: SI_RETURN_TO_EPILOG implicit $vgpr0
    %0:vgpr(i64) = COPY $vgpr0_vgpr1
    %1:vgpr(i32) = G_CONSTANT i32 16
    %2:vgpr(i64) = G_LSHR %0:vgpr, %1:vgpr(i32)
    %3:vgpr(f16) = G_TRUNC %2:vgpr(i64)
    %4:vgpr(f32) = G_FPEXT %3:vgpr(f16)
    %5:vgpr(f32) = G_FMA %4:vgpr, %4:vgpr, %4:vgpr
    $vgpr0 = COPY %5:vgpr(f32)
    SI_RETURN_TO_EPILOG implicit $vgpr0
...
