name: known_never_zero_build_vector
body: |
  bb.0:
  ; CHECK-LABEL: name: @known_never_zero_build_vector
  ; CHECK-NEXT: %zero:_ KnownBits:00000000000000000000000000000000 SignBits:32 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %two:_ KnownBits:00000000000000000000000000000010 SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %all_nonzero:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %may_be_zero:_ KnownBits:0000000000000000000000000000000? SignBits:31 IsKnownNeverZero:0
    %zero:_(s32) = G_CONSTANT i32 0
    %one:_(s32) = G_CONSTANT i32 1
    %two:_(s32) = G_CONSTANT i32 2
    %all_nonzero:_(<2 x s32>) = G_BUILD_VECTOR %one, %two
    %may_be_zero:_(<2 x s32>) = G_BUILD_VECTOR %one, %zero
...
