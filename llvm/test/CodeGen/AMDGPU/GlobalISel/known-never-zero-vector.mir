    %one:_(s32) = G_CONSTANT i32 1
    %two:_(s32) = G_CONSTANT i32 2
    %four:_(s32) = G_CONSTANT i32 4
    %eight:_(s32) = G_CONSTANT i32 8
    %lhs:_(<2 x s32>) = G_BUILD_VECTOR %one, %two
    %rhs:_(<2 x s32>) = G_BUILD_VECTOR %four, %eight
    %zero_src:_(<2 x s32>) = G_BUILD_VECTOR %one, %zero
    %lhs_only:_(<2 x s32>) = G_SHUFFLE_VECTOR %lhs, %rhs, shufflemask(0, 1)
    %rhs_only:_(<2 x s32>) = G_SHUFFLE_VECTOR %lhs, %rhs, shufflemask(2, 3)
    %mixed:_(<2 x s32>) = G_SHUFFLE_VECTOR %lhs, %rhs, shufflemask(0, 3)
    %zero_mix:_(<2 x s32>) = G_SHUFFLE_VECTOR %zero_src, %rhs, shufflemask(0, 1)
    %undef_vec:_(<2 x s32>) = G_SHUFFLE_VECTOR %lhs, %rhs, shufflemask(0, undef)
    %idx0:_(s32) = G_CONSTANT i32 0
    %idx1:_(s32) = G_CONSTANT i32 1
    %zero_mix_lane0:_(s32) = G_EXTRACT_VECTOR_ELT %zero_mix, %idx0
    %zero_mix_lane1:_(s32) = G_EXTRACT_VECTOR_ELT %zero_mix, %idx1
    %undef_lane0:_(s32) = G_EXTRACT_VECTOR_ELT %undef_vec, %idx0
    %undef_lane1:_(s32) = G_EXTRACT_VECTOR_ELT %undef_vec, %idx1
