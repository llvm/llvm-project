name: known_never_zero_shuffle_vector
body: |
  bb.0:
  ; CHECK-LABEL: name: @known_never_zero_shuffle_vector
  ; CHECK-NEXT: %zero:_ KnownBits:00000000000000000000000000000000 SignBits:32 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %two:_ KnownBits:00000000000000000000000000000010 SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %four:_ KnownBits:00000000000000000000000000000100 SignBits:29 IsKnownNeverZero:1
  ; CHECK-NEXT: %eight:_ KnownBits:00000000000000000000000000001000 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %lhs:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %rhs:_ KnownBits:0000000000000000000000000000??00 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %zero_src:_ KnownBits:0000000000000000000000000000000? SignBits:31 IsKnownNeverZero:0
  ; CHECK-NEXT: %lhs_only:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %rhs_only:_ KnownBits:0000000000000000000000000000??00 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %mixed:_ KnownBits:0000000000000000000000000000?00? SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %zero_mix:_ KnownBits:0000000000000000000000000000000? SignBits:31 IsKnownNeverZero:0
  ; CHECK-NEXT: %undef_vec:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %idx0:_ KnownBits:00000000000000000000000000000000 SignBits:32 IsKnownNeverZero:0
  ; CHECK-NEXT: %idx1:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
