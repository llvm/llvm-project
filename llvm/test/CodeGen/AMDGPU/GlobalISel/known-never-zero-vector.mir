  ; CHECK-NEXT: %zero_mix_lane1:_ KnownBits:00000000000000000000000000000000 SignBits:32 IsKnownNeverZero:0
  ; CHECK-NEXT: %undef_lane0:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %undef_lane1:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
