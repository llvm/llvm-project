# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=amdgpu9.00 -passes='print<gisel-value-tracking>' %s -filetype=null 2>&1 | FileCheck %s

# A constant RHS of a 24-bit multiply provides known bits for the product even
# when the LHS is completely unknown: 12 == 4 * 3, so the low 2 bits are zero.

---
name: mul_i24_known_rhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_known_rhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:??????????????????????????????00 SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %x(s32), %c(s32)
    $sgpr0 = COPY %m
...

---
name: mul_u24_known_rhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_u24_known_rhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:0000??????????????????????????00 SignBits:4 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24.i32), %x(s32), %c(s32)
    $sgpr0 = COPY %m
...

# The LHS is a known constant and the RHS is unknown. The known bits of the
# LHS must still be used.

---
name: mul_i24_known_lhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_known_lhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:??????????????????????????????00 SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %c(s32), %x(s32)
    $sgpr0 = COPY %m
...

# The LHS is a known constant and the RHS is unknown, for the unsigned
# multiply.

---
name: mul_u24_known_lhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_u24_known_lhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:0000??????????????????????????00 SignBits:4 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24.i32), %c(s32), %x(s32)
    $sgpr0 = COPY %m
...

# For a self-multiply both operands are the same value, so the known bits of
# that value are computed once and used for both sides. A plain register copy
# is not known to be defined, so no square-bit inference is possible.

---
name: mul_i24_self_multiply
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_self_multiply
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %m:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %x(s32), %x(s32)
    $sgpr0 = COPY %m
...

# An undef self-multiply must stay unknown: the square-bit inference is only
# valid for a value that is guaranteed not to be undef.

---
name: mul_i24_self_multiply_implicit_def
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_self_multiply_implicit_def
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %m:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = G_IMPLICIT_DEF
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %x(s32), %x(s32)
    $sgpr0 = COPY %m
...

# A freeze makes the shared operand defined, so a self-multiply still has bit 1
# clear (x * x is 0 or 1 modulo 4) even though all other bits are unknown.

---
name: mul_i24_self_multiply_freeze
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_self_multiply_freeze
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %f:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %m:_ KnownBits:??????????????????????????????0? SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %f:_(s32) = G_FREEZE %x
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %f(s32), %f(s32)
    $sgpr0 = COPY %m
...

---
name: mul_u24_self_multiply_freeze
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_u24_self_multiply_freeze
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %f:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %m:_ KnownBits:??????????????????????????????0? SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %f:_(s32) = G_FREEZE %x
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24.i32), %f(s32), %f(s32)
    $sgpr0 = COPY %m
...

# A self-multiply of a known odd value: the square of an odd number has bits 1
# and 2 clear and bit 0 set, i.e. the low bits are 001.

---
name: mul_i24_known_self_multiply
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_known_self_multiply
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %f:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %o:_ KnownBits:???????????????????????????????1 SignBits:1 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:?????????????????????????????001 SignBits:1 IsKnownNeverZero:1
    %x:_(s32) = COPY $vgpr0
    %f:_(s32) = G_FREEZE %x
    %one:_(s32) = G_CONSTANT i32 1
    %o:_(s32) = G_OR %f, %one
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %o(s32), %o(s32)
    $sgpr0 = COPY %m
...

# The unsigned twin of the known self-multiply above.

---
name: mul_u24_known_self_multiply
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_u24_known_self_multiply
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %f:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %o:_ KnownBits:???????????????????????????????1 SignBits:1 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:?????????????????????????????001 SignBits:1 IsKnownNeverZero:1
    %x:_(s32) = COPY $vgpr0
    %f:_(s32) = G_FREEZE %x
    %one:_(s32) = G_CONSTANT i32 1
    %o:_(s32) = G_OR %f, %one
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24.i32), %o(s32), %o(s32)
    $sgpr0 = COPY %m
...

# A 24x24 unsigned product needs at most 48 bits, so the upper 16 bits of the
# i64 result are known zero even when both operands are unknown.

---
name: mul_u24_i64_upper_bits
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
  ; CHECK-LABEL: name: @mul_u24_i64_upper_bits
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %y:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %m:_ KnownBits:0000000000000000???????????????????????????????????????????????? SignBits:16 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %m:_(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24.i64), %x(s32), %y(s32)
    $sgpr0_sgpr1 = COPY %m
...
