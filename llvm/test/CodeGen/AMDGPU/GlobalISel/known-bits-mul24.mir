# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=amdgpu9.00 -passes='print<gisel-value-tracking>' %s -filetype=null 2>&1 | FileCheck %s

# A constant RHS of a 24-bit multiply provides known bits for the product even
# when the LHS is completely unknown: 12 == 4 * 3, so the low 2 bits are zero.

---
name: mul_i24_known_rhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_known_rhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:??????????????????????????????00 SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %x(s32), %c(s32)
    $sgpr0 = COPY %m
...

---
name: mul_u24_known_rhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_u24_known_rhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:0000??????????????????????????00 SignBits:4 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.u24.i32), %x(s32), %c(s32)
    $sgpr0 = COPY %m
...

# The LHS is a known constant and the RHS is unknown. The known bits of the
# LHS must still be used.

---
name: mul_i24_known_lhs
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_known_lhs
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:00000000000000000000000000001100 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %m:_ KnownBits:??????????????????????????????00 SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %c:_(s32) = G_CONSTANT i32 12
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %c(s32), %x(s32)
    $sgpr0 = COPY %m
...

# For a self-multiply both operands are the same value, so an unknown operand
# bails out early and nothing is reported.

---
name: mul_i24_self_multiply
body: |
  bb.0:
    liveins: $vgpr0
  ; CHECK-LABEL: name: @mul_i24_self_multiply
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %m:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
    %x:_(s32) = COPY $vgpr0
    %m:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.mul.i24.i32), %x(s32), %x(s32)
    $sgpr0 = COPY %m
...
