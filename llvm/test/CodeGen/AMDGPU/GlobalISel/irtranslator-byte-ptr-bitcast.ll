; A bitcast is the provenance-preserving conversion between a byte type and a
; pointer, and CreateBitPreservingCastChain emits it for both directions (see
; CodeGen/AMDGPU/promote-alloca-byte-ptr-cast.ll). G_BITCAST cannot cross the
; pointer boundary, so it is translated to G_INTTOPTR / G_PTRTOINT, with a
; G_BITCAST to the pointer-sized integer whenever the byte side is shaped
; differently from the pointer side.

; A byte vector standing in for a 64-bit pointer.
define ptr @ptr_from_byte_vec(<2 x b32> %v) {
  ; CHECK-LABEL: name: ptr_from_byte_vec
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(i32) = COPY $vgpr1
  ; CHECK-NEXT:   [[BUILD_VECTOR:%[0-9]+]]:_(<2 x i32>) = G_BUILD_VECTOR [[COPY]](i32), [[COPY1]](i32)
  ; CHECK-NEXT:   [[BITCAST:%[0-9]+]]:_(i64) = G_BITCAST [[BUILD_VECTOR]](<2 x i32>)
  ; CHECK-NEXT:   [[INTTOPTR:%[0-9]+]]:_(p0) = G_INTTOPTR [[BITCAST]](i64)
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[INTTOPTR]](p0)
  ; CHECK-NEXT:   $vgpr0 = COPY [[UV]](i32)
  ; CHECK-NEXT:   $vgpr1 = COPY [[UV1]](i32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0, implicit $vgpr1
  %p = bitcast <2 x b32> %v to ptr
  ret ptr %p
}

