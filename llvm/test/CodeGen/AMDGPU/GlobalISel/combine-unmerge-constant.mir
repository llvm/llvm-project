# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=amdgpu-regbank-combiner -verify-machineinstrs %s -o - | FileCheck %s

---
name: unmerge_physical_sgpr_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; CHECK-LABEL: name: unmerge_physical_sgpr_copy
    ; CHECK: liveins: $sgpr0_sgpr1
    ; CHECK: %0:sgpr(s64) = COPY $sgpr0_sgpr1
    ; CHECK: %1:vgpr(s64) = COPY %0(s64)
    ; CHECK: %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    %0:sgpr(s64) = COPY $sgpr0_sgpr1
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    $vgpr0 = COPY %2(s32)
    $vgpr1 = COPY %3(s32)
...
---
name: unmerge_physical_vgpr_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: unmerge_physical_vgpr_copy
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK: %0:vgpr(s64) = COPY $vgpr0_vgpr1
    ; CHECK: %1:vgpr(s64) = COPY %0(s64)
    ; CHECK: %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    %0:vgpr(s64) = COPY $vgpr0_vgpr1
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    $vgpr2 = COPY %2(s32)
    $vgpr3 = COPY %3(s32)
...
---
name: unmerge_multiple_copies_from_physical_sgpr
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; CHECK-LABEL: name: unmerge_multiple_copies_from_physical_sgpr
    ; CHECK: %0:sgpr(s64) = COPY $sgpr0_sgpr1
    ; CHECK: %1:vgpr(s64) = COPY %0(s64)
    ; CHECK: %2:vgpr(s64) = COPY %1(s64)
    ; CHECK: %3:vgpr(s64) = COPY %2(s64)
    ; CHECK: %4:vgpr(s32), %5:vgpr(s32) = G_UNMERGE_VALUES %3(s64)
    %0:sgpr(s64) = COPY $sgpr0_sgpr1
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s64) = COPY %1(s64)
    %3:vgpr(s64) = COPY %2(s64)
    %4:vgpr(s32), %5:vgpr(s32) = G_UNMERGE_VALUES %3(s64)
    $vgpr0 = COPY %4(s32)
    $vgpr1 = COPY %5(s32)
...

---
name: unmerge_copy_chain_ends_at_g_add
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr2_sgpr3
    ; CHECK-LABEL: name: unmerge_copy_chain_ends_at_g_add
    ; CHECK: %0:sgpr(s64) = COPY $sgpr0_sgpr1
    ; CHECK: %1:sgpr(s64) = COPY $sgpr2_sgpr3
    ; CHECK: %2:vgpr(s64) = G_ADD %0, %1
    ; CHECK: %3:vgpr(s64) = COPY %2(s64)
    ; CHECK: %4:vgpr(s32), %5:vgpr(s32) = G_UNMERGE_VALUES %3(s64)
    %0:sgpr(s64) = COPY $sgpr0_sgpr1
    %1:sgpr(s64) = COPY $sgpr2_sgpr3
    %2:vgpr(s64) = G_ADD %0, %1
    %3:vgpr(s64) = COPY %2(s64)
    %4:vgpr(s32), %5:vgpr(s32) = G_UNMERGE_VALUES %3(s64)
    $vgpr0 = COPY %4(s32)
    $vgpr1 = COPY %5(s32)
...
---
name: unmerge_constant_after_multiple_copies
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unmerge_constant_after_multiple_copies
    ; CHECK: G_CONSTANT i32 -1
    ; CHECK: G_CONSTANT i32 -1
    %0:sgpr(s64) = G_CONSTANT i64 -1
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s64) = COPY %1(s64)
    %3:vgpr(s64) = COPY %2(s64)
    %4:vgpr(s32), %5:vgpr(s32) = G_UNMERGE_VALUES %3(s64)
    $vgpr0 = COPY %4(s32)
    $vgpr1 = COPY %5(s32)
...
---
name: unmerge_nonuniform_constant_after_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unmerge_nonuniform_constant_after_copy
    ; CHECK: G_CONSTANT i32 1432778632
    ; CHECK: G_CONSTANT i32 287454020
    %0:sgpr(s64) = G_CONSTANT i64 1234605616436508552
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    $vgpr0 = COPY %2(s32)
    $vgpr1 = COPY %3(s32)
...
---
name: unmerge_zero_constant_after_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unmerge_zero_constant_after_copy
    ; CHECK: G_CONSTANT i32 0
    ; CHECK: G_CONSTANT i32 0
    %0:sgpr(s64) = G_CONSTANT i64 0
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    $vgpr0 = COPY %2(s32)
    $vgpr1 = COPY %3(s32)
...
---
name: unmerge_constant_copy_with_another_use
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unmerge_constant_copy_with_another_use
    ; CHECK: G_CONSTANT i32 1432778632
    ; CHECK: G_CONSTANT i32 287454020
    ; CHECK: $vgpr2_vgpr3 = COPY
    %0:sgpr(s64) = G_CONSTANT i64 1234605616436508552
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    $vgpr2_vgpr3 = COPY %1(s64)
    $vgpr0 = COPY %2(s32)
    $vgpr1 = COPY %3(s32)
...
---
name: unmerge_constant_into_four_16bit_pieces
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unmerge_constant_into_four_16bit_pieces
    ; CHECK: G_CONSTANT i16 30600
    ; CHECK: G_CONSTANT i16 21862
    ; CHECK: G_CONSTANT i16 13124
    ; CHECK: G_CONSTANT i16 4386
    %0:sgpr(s64) = G_CONSTANT i64 1234605616436508552
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s16), %3:vgpr(s16), %4:vgpr(s16), %5:vgpr(s16) = G_UNMERGE_VALUES %1(s64)
    $vgpr0 = COPY %2(s16)
    $vgpr1 = COPY %3(s16)
    $vgpr2 = COPY %4(s16)
    $vgpr3 = COPY %5(s16)
...
---
name: unmerge_floating_constant_after_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unmerge_floating_constant_after_copy
    ; CHECK: G_CONSTANT i32 0
    ; CHECK: G_CONSTANT i32 1072693248
    %0:sgpr(s64) = G_FCONSTANT double 1.0
    %1:vgpr(s64) = COPY %0(s64)
    %2:vgpr(s32), %3:vgpr(s32) = G_UNMERGE_VALUES %1(s64)
    $vgpr0 = COPY %2(s32)
    $vgpr1 = COPY %3(s32)
...