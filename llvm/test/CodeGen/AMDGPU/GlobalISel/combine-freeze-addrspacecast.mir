# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50 -passes=amdgpu-prelegalizer-combiner -o - %s | FileCheck %s

# An addrspacecast can create poison, so a freeze must not be pushed above it.

---
name: freeze_nonnull_addrspacecast
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: freeze_nonnull_addrspacecast
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[ADDRSPACE_CAST:%[0-9]+]]:_(p3) = nonnull G_ADDRSPACE_CAST [[COPY]](p0)
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:_(p3) = G_FREEZE [[ADDRSPACE_CAST]]
    ; CHECK-NEXT: $vgpr0 = COPY [[FREEZE]](p3)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(p0) = COPY $vgpr0_vgpr1
    %1:_(p3) = nonnull G_ADDRSPACE_CAST %0
    %2:_(p3) = G_FREEZE %1
    $vgpr0 = COPY %2
    SI_RETURN implicit $vgpr0
...

---
name: freeze_addrspacecast
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: freeze_addrspacecast
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[ADDRSPACE_CAST:%[0-9]+]]:_(p3) = G_ADDRSPACE_CAST [[COPY]](p0)
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:_(p3) = G_FREEZE [[ADDRSPACE_CAST]]
    ; CHECK-NEXT: $vgpr0 = COPY [[FREEZE]](p3)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(p0) = COPY $vgpr0_vgpr1
    %1:_(p3) = G_ADDRSPACE_CAST %0
    %2:_(p3) = G_FREEZE %1
    $vgpr0 = COPY %2
    SI_RETURN implicit $vgpr0
...
