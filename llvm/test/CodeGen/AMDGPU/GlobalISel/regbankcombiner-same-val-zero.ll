; RUN: llc -mtriple=amdgcn -mcpu=gfx1030 -global-isel -verify-machineinstrs < %s | FileCheck %s

; RegBankLegalize splits these xors into 32-bit halves after the post-legalizer
; combiner ran, so the xor of two copies of one register is first seen by
; RegBankCombiner, whose same_val_zero apply materializes a bankless constant.

; Scalar zero: the bankless reg is the G_CONSTANT itself, which reaches
; instruction selection as "cannot select".
define <2 x i32> @xor_v2i32_shared_elt0(<2 x i32> %a, i32 %hi) {
; CHECK-LABEL: xor_v2i32_shared_elt0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_xor_b32_e32 v1, v1, v2
; CHECK-NEXT:    v_mov_b32_e32 v0, 0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %b = insertelement <2 x i32> %a, i32 %hi, i32 1
  %r = xor <2 x i32> %a, %b
  ret <2 x i32> %r
}

; Vector zero: the bankless regs are a G_BUILD_VECTOR splat and its G_CONSTANT.
; selectG_BUILD_VECTOR dereferences the null bank, so this crashes the selector
; rather than failing cleanly.
define <4 x i16> @xor_v4i16_shared_hi(<2 x i16> %lo1, <2 x i16> %lo2, <2 x i16> %hi) {
; CHECK-LABEL: xor_v4i16_shared_hi:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_xor_b32_e32 v0, v0, v1
; CHECK-NEXT:    v_mov_b32_e32 v1, 0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %a = shufflevector <2 x i16> %lo1, <2 x i16> %hi, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %b = shufflevector <2 x i16> %lo2, <2 x i16> %hi, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %r = xor <4 x i16> %a, %b
  ret <4 x i16> %r
}
