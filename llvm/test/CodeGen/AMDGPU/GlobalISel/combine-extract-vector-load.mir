    ; CHECK-LABEL: name: test_ptradd_crash__offset_wider
    ; CHECK: [[C:%[0-9]+]]:_(p1) = G_CONSTANT i64 12
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(s32) = G_LOAD [[C]](p1) :: (load (s32) from `ptr addrspace(1) null` + 12, addrspace 1)
    ; CHECK-NEXT: $sgpr0 = COPY [[LOAD]](s32)
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0
    %1:_(p1) = G_CONSTANT i64 0
    %3:_(s32) = G_CONSTANT i32 3
    %0:_(<4 x s32>) = G_LOAD %1 :: (load (<4 x s32>) from `ptr addrspace(1) null`, addrspace 1)
    %2:_(s32) = G_EXTRACT_VECTOR_ELT %0, %3
    $sgpr0 = COPY %2
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

# Verifies that a vector load followed by an extract element with a constant
# index gets combined into an element load that with an updated MMO pointer
# info (which takes the element offset into account).
---
name:            extracting_vec_elt_with_const_idx_preserves_load_mmo_pointer
tracksRegLiveness: true
body:             |
  bb.0:
    ; A constant lane keeps the IR buffer pointer and adds four bytes to its MMO.
    ; CHECK-LABEL: name: extracting_vec_elt_with_const_idx_preserves_load_mmo_pointer
    ; CHECK: [[GV:%[0-9]+]]:_(p1) = G_GLOBAL_VALUE @buffer
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 4
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p1) = G_PTR_ADD [[GV]], [[C]](s64)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(s32) = G_LOAD [[PTR_ADD]](p1) :: (load (s32) from @buffer + 4, addrspace 1)
    ; CHECK-NEXT: $sgpr0 = COPY [[LOAD]](s32)
    ; CHECK-NEXT: SI_RETURN_TO_EPILOG implicit $sgpr0
    %0:_(p1) = G_GLOBAL_VALUE @buffer
    %1:_(<2 x s32>) = G_LOAD %0 :: (load (<2 x s32>) from @buffer, addrspace 1)
    %2:_(s32) = G_CONSTANT i32 1
    %3:_(s32) = G_EXTRACT_VECTOR_ELT %1(<2 x s32>), %2(s32)
    $sgpr0 = COPY %3(s32)
    SI_RETURN_TO_EPILOG implicit $sgpr0
...
