    ; GCN-NEXT: [[FNEG1:%[0-9]+]]:_(f32) = G_FNEG [[BITCAST5]]
    ; GCN-NEXT: [[FMA1:%[0-9]+]]:_(f32) = G_FMA [[FNEG1]], [[INT]], [[SELECT]]
    ; GCN-NEXT: [[C5:%[0-9]+]]:_(f32) = G_FCONSTANT float 0.000000e+00
    ; GCN-NEXT: [[FCMP1:%[0-9]+]]:_(i1) = G_FCMP floatpred(ole), [[FMA]](f32), [[C5]]
    ; GCN-NEXT: [[SELECT1:%[0-9]+]]:_(f32) = G_SELECT [[FCMP1]](i1), [[BITCAST4]], [[INT]]
    ; GCN-NEXT: [[FCMP2:%[0-9]+]]:_(i1) = G_FCMP floatpred(ogt), [[FMA1]](f32), [[C5]]
    ; GCN-NEXT: [[SELECT2:%[0-9]+]]:_(f32) = G_SELECT [[FCMP2]](i1), [[BITCAST5]], [[SELECT1]]
    ; GCN-NEXT: [[C6:%[0-9]+]]:_(f32) = G_FCONSTANT float f0x37800000
    ; GCN-NEXT: [[FMUL1:%[0-9]+]]:_(f32) = G_FMUL [[SELECT2]], [[C6]]
    ; GCN-NEXT: [[SELECT3:%[0-9]+]]:_(f32) = G_SELECT [[FCMP]](i1), [[FMUL1]], [[SELECT2]]
    ; GCN-NEXT: [[IS_FPCLASS:%[0-9]+]]:_(i1) = G_IS_FPCLASS [[SELECT]](f32), 608
    ; GCN-NEXT: [[SELECT4:%[0-9]+]]:_(f32) = G_SELECT [[IS_FPCLASS]](i1), [[SELECT]], [[SELECT3]]
    ; GCN-NEXT: [[BITCAST6:%[0-9]+]]:_(i32) = G_BITCAST [[SELECT4]](f32)
    ; GCN-NEXT: [[C7:%[0-9]+]]:_(i32) = G_CONSTANT i32 4194304
    ; GCN-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[BITCAST6]], [[C7]]
    ; GCN-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR [[BITCAST6]], [[C]](i32)
    ; GCN-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[LSHR]], [[C4]]
    ; GCN-NEXT: [[C8:%[0-9]+]]:_(i32) = G_CONSTANT i32 32767
    ; GCN-NEXT: [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[AND]], [[C8]]
    ; GCN-NEXT: [[ADD3:%[0-9]+]]:_(i32) = G_ADD [[BITCAST6]], [[ADD2]]
    ; GCN-NEXT: [[FCMP3:%[0-9]+]]:_(i1) = G_FCMP floatpred(uno), [[SELECT4]](f32), [[C5]]
    ; GCN-NEXT: [[SELECT5:%[0-9]+]]:_(i32) = G_SELECT [[FCMP3]](i1), [[OR]], [[ADD3]]
    ; GCN-NEXT: [[LSHR1:%[0-9]+]]:_(i32) = G_LSHR [[SELECT5]], [[C]](i32)
    ; GCN-NEXT: [[TRUNC1:%[0-9]+]]:_(i16) = G_TRUNC [[LSHR1]](i32)
    ; GCN-NEXT: [[BITCAST7:%[0-9]+]]:_(bf16) = G_BITCAST [[TRUNC1]](i16)
    ; GCN-NEXT: [[BITCAST8:%[0-9]+]]:_(i16) = G_BITCAST [[BITCAST7]](bf16)
    ; GCN-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST8]](i16)
    ; GCN-NEXT: $vgpr0 = COPY [[ANYEXT1]](i32)
    ;
    ; GFX1250-LABEL: name: test_fsqrt_bf16
    ; GFX1250: liveins: $vgpr0
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; GFX1250-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i32)
    ; GFX1250-NEXT: [[BITCAST:%[0-9]+]]:_(bf16) = G_BITCAST [[TRUNC]](i16)
    ; GFX1250-NEXT: [[FSQRT:%[0-9]+]]:_(bf16) = G_FSQRT [[BITCAST]]
    ; GFX1250-NEXT: [[BITCAST1:%[0-9]+]]:_(i16) = G_BITCAST [[FSQRT]](bf16)
    ; GFX1250-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST1]](i16)
    ; GFX1250-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    %0:_(i32) = COPY $vgpr0
    %1:_(i16) = G_TRUNC %0
    %2:_(bf16) = G_BITCAST %1
    %3:_(bf16) = G_FSQRT %2
    %4:_(i16) = G_BITCAST %3
    %5:_(i32) = G_ANYEXT %4
    $vgpr0 = COPY %5
...

