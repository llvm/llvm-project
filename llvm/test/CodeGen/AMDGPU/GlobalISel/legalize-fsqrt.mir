    ; GCN-NEXT: [[BITCAST3:%[0-9]+]]:_(i32) = G_BITCAST [[INT]](f32)
    ; GCN-NEXT: [[C3:%[0-9]+]]:_(i32) = G_CONSTANT i32 -1
