    ; GFX9-NEXT: [[BITCAST1:%[0-9]+]]:_(i16) = G_BITCAST [[FSQRT]](f16)
    ; GFX9-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST1]](i16)
    ; GFX9-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    ;
    ; GFX1250-LABEL: name: test_fsqrt_f16
    ; GFX1250: liveins: $vgpr0
    ; GFX1250-NEXT: {{  $}}
    ; GFX1250-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; GFX1250-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i32)
    ; GFX1250-NEXT: [[BITCAST:%[0-9]+]]:_(f16) = G_BITCAST [[TRUNC]](i16)
    ; GFX1250-NEXT: [[FSQRT:%[0-9]+]]:_(f16) = G_FSQRT [[BITCAST]]
    ; GFX1250-NEXT: [[BITCAST1:%[0-9]+]]:_(i16) = G_BITCAST [[FSQRT]](f16)
    ; GFX1250-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[BITCAST1]](i16)
    ; GFX1250-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    %0:_(i32) = COPY $vgpr0
    %1:_(i16) = G_TRUNC %0
    %2:_(f16) = G_BITCAST %1
    %3:_(f16) = G_FSQRT %2
    %4:_(i16) = G_BITCAST %3
    %5:_(i32) = G_ANYEXT %4
    $vgpr0 = COPY %5
...

