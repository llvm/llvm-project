name: test_fsqrt_bf16
body: |
  bb.0:
    liveins: $vgpr0

    ; GCN-LABEL: name: test_fsqrt_bf16
    ; GCN: liveins: $vgpr0
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; GCN-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i32)
