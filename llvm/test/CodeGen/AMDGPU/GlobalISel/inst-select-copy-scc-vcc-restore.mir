# A uniform lane mask converted to SCC by G_AMDGPU_COPY_SCC_VCC is converted
# again at its SCC users instead of being saved with "COPY $scc" and restored
# with "$scc = COPY".

---
name:            two_restores_clobber_between
legalized:       true
regBankSelected: true

