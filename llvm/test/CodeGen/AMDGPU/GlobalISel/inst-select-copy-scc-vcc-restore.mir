    successors: %bb.1
    liveins: $sgpr0, $sgpr1, $vgpr0, $vgpr1

    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:vgpr(i32) = COPY $vgpr0
    %3:vgpr(i32) = COPY $vgpr1
