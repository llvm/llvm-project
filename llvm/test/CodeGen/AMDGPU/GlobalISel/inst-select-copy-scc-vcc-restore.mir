  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $sgpr1, $vgpr0, $vgpr1

    %0:sgpr(i32) = COPY $sgpr0
    %1:sgpr(i32) = COPY $sgpr1
    %2:vgpr(i32) = COPY $vgpr0
    %3:vgpr(i32) = COPY $vgpr1
    %4:vcc(i1) = G_ICMP intpred(eq), %2, %3
    %5:sgpr(i32) = G_AMDGPU_COPY_SCC_VCC %4
    G_BR %bb.1

  bb.1:
    %6:sgpr(i32) = G_AND %0, %1
    %7:sgpr(i32) = G_SELECT %5, %6, %0
    $sgpr0 = COPY %7
    SI_RETURN_TO_EPILOG implicit $sgpr0
...

