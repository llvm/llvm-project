name:            restore_in_other_block
legalized:       true
regBankSelected: true
tracksRegLiveness: true

body: |
  ; GFX7-LABEL: name: restore_in_other_block
  ; GFX7: bb.0:
  ; GFX7-NEXT:   successors: %bb.1(0x80000000)
