---
name: test_fmad_s64_flush
machineFunctionInfo:
  mode:
    fp64-fp16-output-denormals: false
    fp64-fp16-input-denormals: false

body: |
  bb.0:
    liveins: $vgpr0_64, $vgpr2_64,  $vgpr4_64

    ; CHECK-LABEL: name: test_fmad_s64_flush
    ; CHECK: liveins: $vgpr0_64, $vgpr2_64, $vgpr4_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f64) = COPY $vgpr0_64
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f64) = COPY $vgpr2_64
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(f64) = COPY $vgpr4_64
    ; CHECK-NEXT: [[FMUL:%[0-9]+]]:_(f64) = G_FMUL [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:_(f64) = G_FADD [[FMUL]], [[COPY2]]
    ; CHECK-NEXT: $vgpr0_64 = COPY [[FADD]](f64)
    %0:_(f64) = COPY $vgpr0_64
    %1:_(f64) = COPY $vgpr2_64
    %2:_(f64) = COPY $vgpr4_64
    %3:_(f64) = G_FMAD %0, %1, %2
    $vgpr0_64 = COPY %3
...

