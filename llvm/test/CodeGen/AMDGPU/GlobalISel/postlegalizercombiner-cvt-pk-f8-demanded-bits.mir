# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=amdgpu-postlegalizer-combiner -amdgpupostlegalizercombiner-only-enable-rule=simplify_demanded_bits,intrinsic_demanded_bits %s -o - | FileCheck %s

# Packed FP8/BF8 conversions write one half of their result and keep the other
# half from their tied destination input (vdst_in). These tests check the
# AMDGPU simplifyDemandedBitsForTargetInstr hook, reached from the conversion
# rule and from the generic simplify_demanded_bits rule.

# Value tracking knows the conversion's preserved high half is zero without
# rewriting it. The AND does not demand the high bits set by the OR.
---
name: known_zero_without_rewrite
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: known_zero_without_rewrite
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[C]](i32), 0
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY2]], [[INT]]
    ; CHECK-NEXT: $vgpr0 = COPY [[AND]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(i32) = COPY $vgpr2
    %3:_(i32) = G_CONSTANT i32 0
    %4:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %0(f32), %1(f32), %3(i32), 0
    %5:_(i32) = G_CONSTANT i32 -65536
    %6:_(i32) = G_OR %2, %5
    %7:_(i32) = G_AND %6, %4
    $vgpr0 = COPY %7(i32)
    SI_RETURN implicit $vgpr0
...

# Likewise, value tracking knows the preserved high half is all ones, making
# the bits cleared by the AND irrelevant to the OR without a conversion rewrite.
---
name: known_one_without_rewrite
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: known_one_without_rewrite
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 -65536
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.bf8.f32), [[COPY]](f32), [[COPY1]](f32), [[C]](i32), 0
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[COPY2]], [[INT]]
    ; CHECK-NEXT: $vgpr0 = COPY [[OR]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(i32) = COPY $vgpr2
    %3:_(i32) = G_CONSTANT i32 -65536
    %4:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.bf8.f32), %0(f32), %1(f32), %3(i32), 0
    %5:_(i32) = G_CONSTANT i32 65535
    %6:_(i32) = G_AND %2, %5
    %7:_(i32) = G_OR %6, %4
    $vgpr0 = COPY %7(i32)
    SI_RETURN implicit $vgpr0
...

# The second conversion only reads the low half of %5, which %5 writes itself,
# so the vdst_in of %5 is not demanded.
---
name: chain
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: chain
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $vgpr2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(f32) = COPY $vgpr3
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[DEF]](i32), 0
    ; CHECK-NEXT: [[INT1:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.bf8.f32), [[COPY2]](f32), [[COPY3]](f32), [[INT]](i32), -1
    ; CHECK-NEXT: $vgpr0 = COPY [[INT1]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(f32) = COPY $vgpr2
    %3:_(f32) = COPY $vgpr3
    %4:_(i32) = G_CONSTANT i32 458752
    %5:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %0(f32), %1(f32), %4(i32), 0
    %6:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.bf8.f32), %2(f32), %3(f32), %5(i32), -1
    $vgpr0 = COPY %6(i32)
    SI_RETURN implicit $vgpr0
...

