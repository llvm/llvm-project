...

# %5 has two users, so all of its bits are demanded.
---
name: chain_multiple_uses
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: chain_multiple_uses
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(f32) = COPY $vgpr2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(f32) = COPY $vgpr3
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 458752
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[C]](i32), 0
    ; CHECK-NEXT: [[INT1:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY2]](f32), [[COPY3]](f32), [[INT]](i32), -1
    ; CHECK-NEXT: [[INT2:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.bf8.f32), [[COPY]](f32), [[COPY3]](f32), [[INT]](i32), -1
    ; CHECK-NEXT: $vgpr0 = COPY [[INT1]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[INT2]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(f32) = COPY $vgpr2
    %3:_(f32) = COPY $vgpr3
    %4:_(i32) = G_CONSTANT i32 458752
    %5:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %0(f32), %1(f32), %4(i32), 0
    %6:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %2(f32), %3(f32), %5(i32), -1
    %7:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.bf8.f32), %0(f32), %3(f32), %5(i32), -1
    $vgpr0 = COPY %6(i32)
    $vgpr1 = COPY %7(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

