    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[DEF]](i32), -1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 16
