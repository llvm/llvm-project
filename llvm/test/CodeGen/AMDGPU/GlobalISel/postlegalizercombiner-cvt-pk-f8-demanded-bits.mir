    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 -65536
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[COPY2]], [[C]]
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[COPY2]](i32), -1
    ; CHECK-NEXT: $vgpr0 = COPY [[INT]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[OR]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(i32) = COPY $vgpr2
    %3:_(i32) = G_CONSTANT i32 -65536
    %4:_(i32) = G_OR %2, %3
    %5:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %0(f32), %1(f32), %4(i32), -1
    $vgpr0 = COPY %5(i32)
    $vgpr1 = COPY %4(i32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
