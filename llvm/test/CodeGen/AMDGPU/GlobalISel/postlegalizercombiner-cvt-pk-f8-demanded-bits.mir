...

# The mask only reads bits 0-7 of the half kept from vdst_in, which the or does
# not change, so the conversion can read %2 directly.
---
name: vdst_in_partially_demanded
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: vdst_in_partially_demanded
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $vgpr2
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[COPY2]](i32), -1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[INT]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY [[AND]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(i32) = COPY $vgpr2
    %3:_(i32) = G_CONSTANT i32 65280
    %4:_(i32) = G_OR %2, %3
    %5:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %0(f32), %1(f32), %4(i32), -1
    %6:_(i32) = G_CONSTANT i32 255
    %7:_(i32) = G_AND %5, %6
    $vgpr0 = COPY %7(i32)
    SI_RETURN implicit $vgpr0
...

# vdst_in has another user, but the or does not change the low half that the
# conversion keeps, so the conversion can read %2 directly.
---
