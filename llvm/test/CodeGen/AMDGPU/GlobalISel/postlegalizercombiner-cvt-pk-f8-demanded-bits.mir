    %6:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %2(f32), %3(f32), %5(i32), -1
    $vgpr0 = COPY %6(i32)
    SI_RETURN implicit $vgpr0
...

# The mask only reads the low half, which the conversion writes.
---
name: mask_written_half
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: mask_written_half
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(f32) = COPY $vgpr1
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[INT:%[0-9]+]]:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), [[COPY]](f32), [[COPY1]](f32), [[DEF]](i32), 0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 65535
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[INT]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY [[AND]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(i32) = G_CONSTANT i32 458752
    %3:_(i32) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.fp8.f32), %0(f32), %1(f32), %2(i32), 0
    %4:_(i32) = G_CONSTANT i32 65535
    %5:_(i32) = G_AND %3, %4
    $vgpr0 = COPY %5(i32)
    SI_RETURN implicit $vgpr0
...

