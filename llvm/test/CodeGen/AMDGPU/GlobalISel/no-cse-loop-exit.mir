# RUN: llc -mtriple=amdgpu10.10-amd-amdhsa -o - -run-pass=machine-cse %s | FileCheck %s
# RUN: llc -mtriple=amdgpu10.10-amd-amdhsa -o - -passes=machine-cse %s | FileCheck %s

# Checking that when an instruction is convergent it is not CSE'D if its BB is in a cycle.
# For example, BB1 dominates BB2, and BB2 post-dominates BB1, but BB1 is in
# the body of a loop that could execute many times while BB2 only executes once,
# meaning both calls to swizzle execute in different conditions and should not be CSE'D.

# CHECK-LABEL: name: no_cse_loop_exit
# CHECK: bb.1.loop
# CHECK: [[SWIZZLE1:%[0-9]+]]:vgpr_32 = DS_SWIZZLE_B32 [[SRC:%[0-9]+]], 100, 0, implicit $exec
# CHECK: bb.2.exit
# CHECK: [[SWIZZLE2:%[0-9]+]]:vgpr_32 = DS_SWIZZLE_B32 [[SRC]], 100, 0, implicit $exec
# CHECK-NEXT: V_ADD_CO_U32_e64 [[SWIZZLE2]], {{%[0-9]+}}, 0, implicit $exec

--- |
  define amdgpu_kernel void @no_cse_loop_exit(ptr addrspace(1), i32, i1) {
  entry:
    unreachable
  loop:
    unreachable
  exit:
    unreachable
  }
...
---
name: no_cse_loop_exit
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $sgpr4_sgpr5
    %0:sgpr_64 = COPY $sgpr4_sgpr5
    %1:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0(p4), 0, 0
    %2:sreg_32 = COPY %1.sub0
    %3:vgpr_32 = COPY %2
    %4:sreg_32 = S_MOV_B32 42
    S_BRANCH %bb.1

  bb.1.loop:
    %5:vgpr_32 = DS_SWIZZLE_B32 %3, 100, 0, implicit $exec
    %6:vgpr_32, %7:sreg_32 = V_ADD_CO_U32_e64 %5, %4, 0, implicit $exec
    S_CMP_LT_I32 %2, %4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2.exit:
    %8:vgpr_32 = DS_SWIZZLE_B32 %3, 100, 0, implicit $exec
    %9:vgpr_32, %10:sreg_32 = V_ADD_CO_U32_e64 %8, %4, 0, implicit $exec
    S_ENDPGM 0

...
