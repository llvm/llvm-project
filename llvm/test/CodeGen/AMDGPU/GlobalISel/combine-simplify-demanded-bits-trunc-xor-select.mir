# The shared XOR agrees with %y on the demanded high bits, so the root's use
# bypasses it; the other user keeps the XOR.
---
name: multi_use_xor_bypass_rhs
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: multi_use_xor_bypass_rhs
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: %a:_(i32) = G_ASSERT_ZEXT %x, 16
    ; CHECK-NEXT: %v:_(i32) = G_XOR %a, %y
    ; CHECK-NEXT: %amt:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %res:_(i32) = G_LSHR %y, %amt(i32)
    ; CHECK-NEXT: $vgpr0 = COPY %res(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %v(i32)
    %x:_(i32) = COPY $vgpr0
    %y:_(i32) = COPY $vgpr1
    %a:_(i32) = G_ASSERT_ZEXT %x, 16
    %v:_(i32) = G_XOR %a, %y
    %amt:_(i32) = G_CONSTANT i32 16
    %res:_(i32) = G_LSHR %v, %amt(i32)
    $vgpr0 = COPY %res(i32)
    $vgpr1 = COPY %v(i32)
...

# The shared AND agrees with its RHS on the demanded high bits, which are known
# zero in both.
---
name: multi_use_and_bypass_rhs
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: multi_use_and_bypass_rhs
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: %b:_(i32) = G_ASSERT_ZEXT %y, 16
    ; CHECK-NEXT: %v:_(i32) = G_AND %x, %b
    ; CHECK-NEXT: %amt:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %res:_(i32) = G_LSHR %b, %amt(i32)
    ; CHECK-NEXT: $vgpr0 = COPY %res(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %v(i32)
    %x:_(i32) = COPY $vgpr0
    %y:_(i32) = COPY $vgpr1
    %b:_(i32) = G_ASSERT_ZEXT %y, 16
    %v:_(i32) = G_AND %x, %b
    %amt:_(i32) = G_CONSTANT i32 16
    %res:_(i32) = G_LSHR %v, %amt(i32)
    $vgpr0 = COPY %res(i32)
    $vgpr1 = COPY %v(i32)
...

# Neither XOR operand simplifies in place, but the OR operand can be bypassed
# for the demanded high bits, so the XOR is rebuilt on top of %x.
---
name: xor_rebuild_with_bypassed_operand
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2

    ; CHECK-LABEL: name: xor_rebuild_with_bypassed_operand
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i32) = G_XOR %x, %y
    ; CHECK-NEXT: %amt:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %res:_(i32) = G_LSHR [[XOR]], %amt(i32)
    ; CHECK-NEXT: $vgpr0 = COPY %res(i32)
    %x:_(i32) = COPY $vgpr0
    %y:_(i32) = COPY $vgpr1
    %z:_(i32) = COPY $vgpr2
    %b:_(i32) = G_ASSERT_ZEXT %z, 16
    %p:_(i32) = G_OR %x, %b
    %v:_(i32) = G_XOR %p, %y
    %amt:_(i32) = G_CONSTANT i32 16
    %res:_(i32) = G_LSHR %v, %amt(i32)
    $vgpr0 = COPY %res(i32)
...

# The single-use OR cannot be simplified in place, so the root's use is routed
# around it. The bypass changes undemanded bits, so exact must be dropped.
---
name: route_use_around_or_drops_exact
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: route_use_around_or_drops_exact
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %amt:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %res:_(i32) = G_LSHR %x, %amt(i32)
    ; CHECK-NEXT: $vgpr0 = COPY %res(i32)
    %x:_(i32) = COPY $vgpr0
    %y:_(i32) = COPY $vgpr1
    %b:_(i32) = G_ASSERT_ZEXT %y, 16
    %p:_(i32) = G_OR %x, %b
    %amt:_(i32) = G_CONSTANT i32 16
    %res:_(i32) = exact G_LSHR %p, %amt(i32)
    $vgpr0 = COPY %res(i32)
...
