# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=amdgpu-postlegalizer-combiner -amdgpupostlegalizercombiner-only-enable-rule=simplify_demanded_bits -verify-machineinstrs %s -o - | FileCheck %s

---
name: trunc_select_both_arms
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4

    ; CHECK-LABEL: name: trunc_select_both_arms
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: %y:_(i64) = COPY $vgpr2_vgpr3
    ; CHECK-NEXT: %c32:_(i32) = COPY $vgpr4
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %c32(i32)
    ; CHECK-NEXT: %v:_(i64) = G_SELECT %cond(i1), %x, %y
    ; CHECK-NEXT: %res:_(i32) = G_TRUNC %v(i64)
    ; CHECK-NEXT: $vgpr0 = COPY %res(i32)
    %x:_(i64) = COPY $vgpr0_vgpr1
    %y:_(i64) = COPY $vgpr2_vgpr3
    %c32:_(i32) = COPY $vgpr4
    %cond:_(i1) = G_TRUNC %c32(i32)
    %lo:_(i64) = G_CONSTANT i64 4294967295
    %hi:_(i64) = G_CONSTANT i64 -4294967296
    %a:_(i64) = G_AND %x, %lo
    %b:_(i64) = G_OR %y, %hi
    %v:_(i64) = G_SELECT %cond(i1), %a, %b
    %res:_(i32) = G_TRUNC %v(i64)
    $vgpr0 = COPY %res(i32)
...

