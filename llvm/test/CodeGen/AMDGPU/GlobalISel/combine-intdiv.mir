    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: srem_unknown_rhs
    ; CHECK: [[Y:%.+]]:_(s32) = COPY $vgpr1
    ; CHECK: [[LHS:%.+]]:_(s32) = G_AND {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_SREM [[LHS]], [[Y]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %lhs:_(s32) = G_AND %x, %mask
    %r:_(s32) = G_SREM %lhs, %y
    $vgpr0 = COPY %r
...

---
name: sdiv_nonnegative_vector
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: sdiv_nonnegative_vector
    ; CHECK: [[LHS:%.+]]:_(<2 x s32>) = G_AND {{.+}}
    ; CHECK: [[DEN:%.+]]:_(<2 x s32>) = G_AND {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(<2 x s32>) = G_UDIV [[LHS]], [[DEN]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %y
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %masks:_(<2 x s32>) = G_BUILD_VECTOR %mask, %mask
    %lhs:_(<2 x s32>) = G_AND %num, %masks
    %ys:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %den:_(<2 x s32>) = G_AND %ys, %masks
    %r:_(<2 x s32>) = G_SDIV %lhs, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...

---
name: srem_nonnegative_vector
body: |
