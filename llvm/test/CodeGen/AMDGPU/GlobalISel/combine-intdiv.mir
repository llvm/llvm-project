    ; CHECK-NEXT: %y:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 12
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %y, [[C]]
    ; CHECK-NEXT: %r:_(s32) = G_LSHR %x, [[ADD]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
