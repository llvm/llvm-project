# RUN: llc -mtriple=amdgpu6.00-mesa-mesa3d -run-pass=amdgpu-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

---
name: udiv_shifted_pow2
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_pow2
    ; CHECK: [[X:%.+]]:_(s32) = COPY $vgpr0
    ; CHECK: [[Y:%.+]]:_(s32) = COPY $vgpr1
    ; CHECK: [[LOG:%.+]]:_(s32) = G_CONSTANT i32 12
    ; CHECK: [[TOTAL:%.+]]:_(s32) = G_ADD [[Y]], [[LOG]]
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_LSHR [[X]], [[TOTAL]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %c:_(s32) = G_CONSTANT i32 4096
    %den:_(s32) = G_SHL %c, %y
    %r:_(s32) = G_UDIV %x, %den
    $vgpr0 = COPY %r
...

---
name: udiv_shifted_one
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_one
    ; CHECK: [[X:%.+]]:_(s32) = COPY $vgpr0
    ; CHECK: [[Y:%.+]]:_(s32) = COPY $vgpr1
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_LSHR [[X]], [[Y]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %c:_(s32) = G_CONSTANT i32 1
    %den:_(s32) = G_SHL %c, %y
    %r:_(s32) = G_UDIV %x, %den
    $vgpr0 = COPY %r
...

---
name: udiv_shifted_pow2_exact
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_pow2_exact
    ; CHECK: [[X:%.+]]:_(s32) = COPY $vgpr0
    ; CHECK: [[Y:%.+]]:_(s32) = COPY $vgpr1
    ; CHECK: [[LOG:%.+]]:_(s32) = G_CONSTANT i32 3
    ; CHECK: [[TOTAL:%.+]]:_(s32) = G_ADD [[Y]], [[LOG]]
    ; CHECK: [[RESULT:%.+]]:_(s32) = exact G_LSHR [[X]], [[TOTAL]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %c:_(s32) = G_CONSTANT i32 8
    %den:_(s32) = G_SHL %c, %y
    %r:_(s32) = exact G_UDIV %x, %den
    $vgpr0 = COPY %r
...

---
name: udiv_shifted_pow2_s64
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_pow2_s64
    ; CHECK: [[Y:%.+]]:_(s32) = COPY $vgpr1
    ; CHECK: [[WIDE:%.+]]:_(s64) = G_ZEXT {{.+}}
    ; CHECK: [[LOG:%.+]]:_(s32) = G_CONSTANT i32 12
    ; CHECK: [[TOTAL:%.+]]:_(s32) = G_ADD [[Y]], [[LOG]]
    ; CHECK: [[RESULT:%.+]]:_(s64) = G_LSHR [[WIDE]], [[TOTAL]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %wide:_(s64) = G_ZEXT %x
    %c:_(s64) = G_CONSTANT i64 4096
    %den:_(s64) = G_SHL %c, %y
    %r:_(s64) = G_UDIV %wide, %den
    %out:_(s32) = G_TRUNC %r
    $vgpr0 = COPY %out
...

---
name: udiv_shifted_pow2_s8_amount
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_pow2_s8_amount
    ; CHECK: [[X:%.+]]:_(s32) = COPY $vgpr0
    ; CHECK: [[AMT:%.+]]:_(s8) = G_TRUNC {{.+}}
    ; CHECK: [[LOG:%.+]]:_(s8) = G_CONSTANT i8 4
    ; CHECK: [[TOTAL:%.+]]:_(s8) = G_ADD [[AMT]], [[LOG]]
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_LSHR [[X]], [[TOTAL]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %amt:_(s8) = G_TRUNC %y
    %c:_(s32) = G_CONSTANT i32 16
    %den:_(s32) = G_SHL %c, %amt
    %r:_(s32) = G_UDIV %x, %den
    $vgpr0 = COPY %r
...

