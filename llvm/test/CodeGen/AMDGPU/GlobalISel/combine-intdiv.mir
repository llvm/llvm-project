    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %y
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %masks:_(<2 x s32>) = G_BUILD_VECTOR %mask, %mask
    %lhs:_(<2 x s32>) = G_AND %num, %masks
    %ys:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %den:_(<2 x s32>) = G_AND %ys, %masks
    %r:_(<2 x s32>) = G_SDIV %lhs, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...

---
name: srem_nonnegative_vector
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: srem_nonnegative_vector
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %num:_(<2 x s32>) = G_BUILD_VECTOR %x(s32), %y(s32)
    ; CHECK-NEXT: %mask:_(s32) = G_CONSTANT i32 2147483647
    ; CHECK-NEXT: %masks:_(<2 x s32>) = G_BUILD_VECTOR %mask(s32), %mask(s32)
    ; CHECK-NEXT: %lhs:_(<2 x s32>) = G_AND %num, %masks
    ; CHECK-NEXT: %ys:_(<2 x s32>) = G_BUILD_VECTOR %y(s32), %y(s32)
    ; CHECK-NEXT: %den:_(<2 x s32>) = G_AND %ys, %masks
    ; CHECK-NEXT: %r:_(<2 x s32>) = G_UREM %lhs, %den
    ; CHECK-NEXT: %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r(<2 x s32>)
    ; CHECK-NEXT: $vgpr0 = COPY %lo(s32)
    ; CHECK-NEXT: $vgpr1 = COPY %hi(s32)
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %y
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %masks:_(<2 x s32>) = G_BUILD_VECTOR %mask, %mask
    %lhs:_(<2 x s32>) = G_AND %num, %masks
    %ys:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %den:_(<2 x s32>) = G_AND %ys, %masks
    %r:_(<2 x s32>) = G_SREM %lhs, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...
