---
name: udiv_shifted_vector
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_vector
    ; CHECK: [[NUM:%.+]]:_(<2 x s32>) = G_BUILD_VECTOR {{.+}}
    ; CHECK: [[AMT:%.+]]:_(<2 x s32>) = G_BUILD_VECTOR {{.+}}
    ; CHECK: [[C0:%.+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK: [[C12:%.+]]:_(s32) = G_CONSTANT i32 12
    ; CHECK: [[LOG:%.+]]:_(<2 x s32>) = G_BUILD_VECTOR [[C0]](s32), [[C12]](s32)
    ; CHECK: [[TOTAL:%.+]]:_(<2 x s32>) = G_ADD [[AMT]], [[LOG]]
    ; CHECK: [[RESULT:%.+]]:_(<2 x s32>) = G_LSHR [[NUM]], [[TOTAL]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %x
    %amt:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %c0:_(s32) = G_CONSTANT i32 1
    %c1:_(s32) = G_CONSTANT i32 4096
    %base:_(<2 x s32>) = G_BUILD_VECTOR %c0, %c1
    %den:_(<2 x s32>) = G_SHL %base, %amt
    %r:_(<2 x s32>) = G_UDIV %num, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...

---
name: udiv_shifted_vector_nonpow2
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_vector_nonpow2
    ; CHECK: [[NUM:%.+]]:_(<2 x s32>) = G_BUILD_VECTOR {{.+}}
    ; CHECK: [[DEN:%.+]]:_(<2 x s32>) = G_SHL {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(<2 x s32>) = G_UDIV [[NUM]], [[DEN]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %x
    %amt:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %c0:_(s32) = G_CONSTANT i32 4
    %c1:_(s32) = G_CONSTANT i32 3
    %base:_(<2 x s32>) = G_BUILD_VECTOR %c0, %c1
    %den:_(<2 x s32>) = G_SHL %base, %amt
    %r:_(<2 x s32>) = G_UDIV %num, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...

---
name: udiv_shifted_vector_undef
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_vector_undef
    ; CHECK: [[NUM:%.+]]:_(<2 x s32>) = G_BUILD_VECTOR {{.+}}
    ; CHECK: [[DEN:%.+]]:_(<2 x s32>) = G_SHL {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(<2 x s32>) = G_UDIV [[NUM]], [[DEN]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %x
    %amt:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %c0:_(s32) = G_CONSTANT i32 4
    %c1:_(s32) = G_IMPLICIT_DEF
    %base:_(<2 x s32>) = G_BUILD_VECTOR %c0, %c1
    %den:_(<2 x s32>) = G_SHL %base, %amt
    %r:_(<2 x s32>) = G_UDIV %num, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...

---
name: sdiv_nonnegative
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: sdiv_nonnegative
    ; CHECK: [[LHS:%.+]]:_(s32) = G_AND {{.+}}
    ; CHECK: [[RHS:%.+]]:_(s32) = G_AND {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_UDIV [[LHS]], [[RHS]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %lhs:_(s32) = G_AND %x, %mask
    %rhs:_(s32) = G_AND %y, %mask
    %r:_(s32) = G_SDIV %lhs, %rhs
    $vgpr0 = COPY %r
...

---
name: sdiv_exact_nonnegative
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: sdiv_exact_nonnegative
    ; CHECK: [[LHS:%.+]]:_(s32) = G_AND {{.+}}
    ; CHECK: [[RHS:%.+]]:_(s32) = G_AND {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(s32) = exact G_UDIV [[LHS]], [[RHS]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %lhs:_(s32) = G_AND %x, %mask
    %rhs:_(s32) = G_AND %y, %mask
    %r:_(s32) = exact G_SDIV %lhs, %rhs
    $vgpr0 = COPY %r
...

