    ; CHECK: [[RHS:%.+]]:_(s32) = G_AND {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_UREM [[LHS]], [[RHS]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %lhs:_(s32) = G_AND %x, %mask
    %rhs:_(s32) = G_AND %y, %mask
    %r:_(s32) = G_SREM %lhs, %rhs
    $vgpr0 = COPY %r
...

