name: udiv_shifted_vector
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_vector
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %num:_(<2 x s32>) = G_BUILD_VECTOR %x(s32), %x(s32)
    ; CHECK-NEXT: %amt:_(<2 x s32>) = G_BUILD_VECTOR %y(s32), %y(s32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 12
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C1]](s32)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(<2 x s32>) = G_ADD %amt, [[BUILD_VECTOR]]
    ; CHECK-NEXT: %r:_(<2 x s32>) = G_LSHR %num, [[ADD]](<2 x s32>)
    ; CHECK-NEXT: %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r(<2 x s32>)
    ; CHECK-NEXT: $vgpr0 = COPY %lo(s32)
    ; CHECK-NEXT: $vgpr1 = COPY %hi(s32)
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %num:_(<2 x s32>) = G_BUILD_VECTOR %x, %x
    %amt:_(<2 x s32>) = G_BUILD_VECTOR %y, %y
    %c0:_(s32) = G_CONSTANT i32 1
    %c1:_(s32) = G_CONSTANT i32 4096
    %base:_(<2 x s32>) = G_BUILD_VECTOR %c0, %c1
    %den:_(<2 x s32>) = G_SHL %base, %amt
    %r:_(<2 x s32>) = G_UDIV %num, %den
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
...

