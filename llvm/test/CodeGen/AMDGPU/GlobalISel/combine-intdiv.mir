name: udiv_shifted_pow2_narrow_amount
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: udiv_shifted_pow2_narrow_amount
    ; CHECK: [[X:%.+]]:_(s32) = COPY $vgpr0
    ; CHECK: [[DEN:%.+]]:_(s32) = G_SHL {{.+}}
    ; CHECK: [[RESULT:%.+]]:_(s32) = G_UDIV [[X]], [[DEN]]
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %amt:_(s1) = G_TRUNC %y
    %c:_(s32) = G_CONSTANT i32 16
    %den:_(s32) = G_SHL %c, %amt
    %r:_(s32) = G_UDIV %x, %den
