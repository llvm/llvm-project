# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.00 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

# A shift only reads the low log2(bitwidth) bits of its amount, so an (and amt,
# mask) covering those bits is folded away by the constrained shift patterns.
# For a divergent shift the mask constant stays in the SGPR bank, so a COPY
# sits between it and the G_AND; the patterns have to see through it.

---
name: shl_i32_masked_amount_through_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: shl_i32_masked_amount_through_copy
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[V_LSHLREV_B32_e64_:%[0-9]+]]:vgpr_32 = V_LSHLREV_B32_e64 [[COPY1]], [[COPY]], implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_LSHLREV_B32_e64_]]
    %0:vgpr(i32) = COPY $vgpr0
    %1:vgpr(i32) = COPY $vgpr1
    %2:sgpr(i32) = G_CONSTANT i32 31
    %3:vgpr(i32) = COPY %2
    %4:vgpr(i32) = G_AND %1, %3
    %5:vgpr(i32) = G_SHL %0, %4
    S_ENDPGM 0, implicit %5
...

