    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[V_LSHRREV_B32_e64_:%[0-9]+]]:vgpr_32 = V_LSHRREV_B32_e64 [[COPY1]], [[COPY]], implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[V_LSHRREV_B32_e64_]]
    %0:vgpr(i32) = COPY $vgpr0
    %1:vgpr(i32) = COPY $vgpr1
    %2:sgpr(i32) = G_CONSTANT i32 31
    %3:vgpr(i32) = COPY %2
    %4:vgpr(i32) = G_AND %1, %3
    %5:vgpr(i32) = G_LSHR %0, %4
    S_ENDPGM 0, implicit %5
...

