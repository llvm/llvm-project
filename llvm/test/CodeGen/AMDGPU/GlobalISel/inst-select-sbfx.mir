    ; FAKE16-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
    ; FAKE16-NEXT: [[V_BFE_I32_e64_:%[0-9]+]]:vgpr_32 = V_BFE_I32_e64 [[COPY]], [[COPY1]], [[COPY2]], implicit $exec
    ; FAKE16-NEXT: S_ENDPGM 0, implicit [[V_BFE_I32_e64_]]
    %0:vgpr(s32) = COPY $vgpr0
    %1:vgpr(s32) = COPY $vgpr1
    %2:vgpr(s32) = COPY $vgpr2
    %3:vgpr(s32) = G_SBFX %0, %1(s32), %2
    S_ENDPGM 0, implicit %3
...

---
name: sbfx_s32_low_i16
legalized: true
regBankSelected: true
body: |
  bb.0:
    ; CHECK-LABEL: name: sbfx_s32_low_i16
    ; CHECK: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 16, implicit $exec
    ; CHECK-NEXT: [[V_BFE_I32_e64_:%[0-9]+]]:vgpr_32 = V_BFE_I32_e64 [[DEF]], [[V_MOV_B32_e32_]], [[V_MOV_B32_e32_1]], implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_BFE_I32_e64_]]
    ; CHECK-NEXT: S_ENDPGM 0
    ;
    ; REAL16-LABEL: name: sbfx_s32_low_i16
    ; REAL16: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; REAL16-NEXT: [[V_CVT_I32_I16_t16_e64_:%[0-9]+]]:vgpr_32 = V_CVT_I32_I16_t16_e64 0, [[DEF]].lo16, 0, implicit $exec
    ; REAL16-NEXT: $vgpr0 = COPY [[V_CVT_I32_I16_t16_e64_]]
    ; REAL16-NEXT: S_ENDPGM 0
    ;
    ; FAKE16-LABEL: name: sbfx_s32_low_i16
    ; FAKE16: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; FAKE16-NEXT: [[V_CVT_I32_I16_fake16_e64_:%[0-9]+]]:vgpr_32 = V_CVT_I32_I16_fake16_e64 [[DEF]], implicit $exec
    ; FAKE16-NEXT: $vgpr0 = COPY [[V_CVT_I32_I16_fake16_e64_]]
    ; FAKE16-NEXT: S_ENDPGM 0
    %0:vgpr(s32) = IMPLICIT_DEF
    %1:vgpr(s32) = G_CONSTANT i32 0
    %2:vgpr(s32) = G_CONSTANT i32 16
    %3:vgpr(s32) = G_SBFX %0, %1, %2
    $vgpr0 = COPY %3
    S_ENDPGM 0
...
