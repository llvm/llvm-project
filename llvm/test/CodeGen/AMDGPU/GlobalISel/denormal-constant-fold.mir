name: f64_ieee
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; f64 defaults to IEEE; the f32 FTZ setting must not affect these folds.
    ; G_FADD produces f0x0000000000000002, G_FCEIL produces 1, and G_FCMP is false
    ; CHECK-LABEL: name: f64_ieee
    ; CHECK: %add:_(f64) = G_FCONSTANT double 9.881310e-324
    ; CHECK-NEXT: %ceil:_(f64) = G_FCONSTANT double 1.000000e+00
