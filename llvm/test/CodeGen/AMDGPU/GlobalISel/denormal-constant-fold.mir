# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=amdgpu-prelegalizer-combiner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# The generic GlobalISel constant-folding rules obtain their denormal mode from
# the MachineFunction.  A minimum f32 subnormal is therefore zero here. This
# covers every G_F* binary operation, G_FMA, and G_FCMP routed through
# CombinerHelper.

--- |
  define void @fbinops() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @fma() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @ftz_boundary() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @fcmp() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @dynamic() denormal_fpenv(float: dynamic) {
    ret void
  }

  define void @ceil() denormal_fpenv(float: preservesign) { ret void }

  define void @ceil_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @minmax() denormal_fpenv(float: preservesign) { ret void }

  define void @minmax_dynamic() denormal_fpenv(float: dynamic) { ret void }

...

---
name: fbinops
body: |
  bb.0:
    ; CHECK-LABEL: name: fbinops
    ; CHECK: %add:_(s32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %add(s32)
    ; CHECK-NEXT: $vgpr1 = COPY %add(s32)
    ; CHECK-NEXT: $vgpr2 = COPY %add(s32)
    ; CHECK-NEXT: $vgpr3 = COPY %add(s32)
    ; CHECK-NEXT: $vgpr4 = COPY %add(s32)
    %denorm:_(s32) = G_FCONSTANT float 1.40129846e-45
    %negdenorm:_(s32) = G_FCONSTANT float -1.40129846e-45
    %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    %two:_(s32) = G_FCONSTANT float 2.000000e+00
    %half:_(s32) = G_FCONSTANT float 5.000000e-01
    %add:_(s32) = G_FADD %denorm, %denorm
    %sub:_(s32) = G_FSUB %denorm, %negdenorm
    %mul:_(s32) = G_FMUL %denorm, %two
    %div:_(s32) = G_FDIV %denorm, %half
    %rem:_(s32) = G_FREM %denorm, %two
    $vgpr0 = COPY %add
    $vgpr1 = COPY %sub
    $vgpr2 = COPY %mul
    $vgpr3 = COPY %div
    $vgpr4 = COPY %rem
...

---
name: fma
body: |
  bb.0:
    ; CHECK-LABEL: name: fma
    ; CHECK: %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %zero(s32)
    %denorm:_(s32) = G_FCONSTANT float 1.40129846e-45
    %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    %one:_(s32) = G_FCONSTANT float 1.000000e+00
    %result:_(s32) = G_FMA %denorm, %one, %zero
    $vgpr0 = COPY %result
...

---
name: ftz_boundary
body: |
  bb.0:
    ; CHECK-LABEL: name: ftz_boundary
    ; CHECK: %a:_(s32) = G_FCONSTANT float f0x91FFFFFF
    ; CHECK-NEXT: %b:_(s32) = G_FCONSTANT float f0xAE000000
    ; CHECK-NEXT: %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: %mul:_(s32) = G_FMUL %a, %b
    ; CHECK-NEXT: %fma:_(s32) = G_FMA %a, %b, %zero
    ; CHECK-NEXT: $vgpr0 = COPY %mul(s32)
    ; CHECK-NEXT: $vgpr1 = COPY %fma(s32)
    %a:_(s32) = G_FCONSTANT float f0x91FFFFFF
    %b:_(s32) = G_FCONSTANT float f0xAE000000
    %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    %mul:_(s32) = G_FMUL %a, %b
    %fma:_(s32) = G_FMA %a, %b, %zero
    $vgpr0 = COPY %mul
    $vgpr1 = COPY %fma
...

---
name: fcmp
body: |
  bb.0:
    ; CHECK-LABEL: name: fcmp
    ; CHECK: %extended:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: $vgpr0 = COPY %extended(s32)
    %denorm:_(s32) = G_FCONSTANT float 1.40129846e-45
    %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    %result:_(s1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(s32) = G_ZEXT %result
    $vgpr0 = COPY %extended
...

