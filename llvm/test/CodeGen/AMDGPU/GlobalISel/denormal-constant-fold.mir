    ; CHECK-NEXT: $vgpr0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float 1.40129846e-45
    %result:_(f32) = G_FADD %denorm, %denorm
    $vgpr0 = COPY %result
...

