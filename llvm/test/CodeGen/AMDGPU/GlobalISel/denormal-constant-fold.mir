---
name: minmax
body: |
  bb.0:
    ; CHECK-LABEL: name: minmax
    ; CHECK: %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %zero(s32)
    ; CHECK-NEXT: $vgpr1 = COPY %zero(s32)
    ; CHECK-NEXT: $vgpr2 = COPY %zero(s32)
    ; CHECK-NEXT: $vgpr3 = COPY %zero(s32)
    ; CHECK-NEXT: $vgpr4 = COPY %zero(s32)
    ; CHECK-NEXT: $vgpr5 = COPY %zero(s32)
    %denorm:_(s32) = G_FCONSTANT float 1.40129846e-45
    %zero:_(s32) = G_FCONSTANT float 0.000000e+00
    %one:_(s32) = G_FCONSTANT float 1.000000e+00
    %minnum:_(s32) = G_FMINNUM %denorm, %one
    %maxnum:_(s32) = G_FMAXNUM %denorm, %zero
    %minimum:_(s32) = G_FMINIMUM %denorm, %one
    %maximum:_(s32) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(s32) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(s32) = G_FMAXIMUMNUM %denorm, %zero
    $vgpr0 = COPY %minnum
    $vgpr1 = COPY %maxnum
    $vgpr2 = COPY %minimum
    $vgpr3 = COPY %maximum
    $vgpr4 = COPY %minimumnum
    $vgpr5 = COPY %maximumnum
...

