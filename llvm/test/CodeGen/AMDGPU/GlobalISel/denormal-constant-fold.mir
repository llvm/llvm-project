# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=amdgpu-prelegalizer-combiner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# The generic GlobalISel constant-folding rules obtain their denormal mode from
# the MachineFunction. A minimum subnormal is therefore zero in FTZ mode. This
# covers every G_F* binary operation, G_FMA, and G_FCMP routed through
# CombinerHelper.
# The f16/f64 cases use the default denormal mode, independently of float:.

--- |
  define void @fbinops() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @fma() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @ftz_boundary() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @fcmp() denormal_fpenv(float: preservesign) {
    ret void
  }

  define void @dynamic() denormal_fpenv(float: dynamic) {
    ret void
  }

  define void @ceil() denormal_fpenv(float: preservesign) { ret void }

  define void @ceil_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @minmax() denormal_fpenv(float: preservesign) { ret void }

  define void @minmax_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @f16_ftz() denormal_fpenv(preservesign, float: ieee) { ret void }

  define void @f16_dynamic() denormal_fpenv(dynamic, float: ieee) { ret void }

  define void @f16_ieee() denormal_fpenv(float: preservesign) { ret void }

  define void @f64_ftz() denormal_fpenv(preservesign, float: ieee) { ret void }

  define void @f64_dynamic() denormal_fpenv(dynamic, float: ieee) { ret void }

  define void @f64_ieee() denormal_fpenv(float: preservesign) { ret void }

...

---
name: fbinops
body: |
  bb.0:
    ; CHECK-LABEL: name: fbinops
    ; CHECK: %add:_(f32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr1 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr2 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr3 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr4 = COPY %add(f32)
    %denorm:_(f32) = G_FCONSTANT float 1.40129846e-45
    %negdenorm:_(f32) = G_FCONSTANT float -1.40129846e-45
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %two:_(f32) = G_FCONSTANT float 2.000000e+00
    %half:_(f32) = G_FCONSTANT float 5.000000e-01
    %add:_(f32) = G_FADD %denorm, %denorm
    %sub:_(f32) = G_FSUB %denorm, %negdenorm
    %mul:_(f32) = G_FMUL %denorm, %two
    %div:_(f32) = G_FDIV %denorm, %half
    %rem:_(f32) = G_FREM %denorm, %two
    $vgpr0 = COPY %add
    $vgpr1 = COPY %sub
    $vgpr2 = COPY %mul
    $vgpr3 = COPY %div
    $vgpr4 = COPY %rem
...

---
name: fma
body: |
  bb.0:
    ; CHECK-LABEL: name: fma
    ; CHECK: %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %zero(f32)
    %denorm:_(f32) = G_FCONSTANT float 1.40129846e-45
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %result:_(f32) = G_FMA %denorm, %one, %zero
    $vgpr0 = COPY %result
...

---
name: ftz_boundary
body: |
  bb.0:
    ; CHECK-LABEL: name: ftz_boundary
    ; CHECK: %a:_(f32) = G_FCONSTANT float f0x91FFFFFF
    ; CHECK-NEXT: %b:_(f32) = G_FCONSTANT float f0xAE000000
    ; CHECK-NEXT: %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: %mul:_(f32) = G_FMUL %a, %b
    ; CHECK-NEXT: %fma:_(f32) = G_FMA %a, %b, %zero
    ; CHECK-NEXT: $vgpr0 = COPY %mul(f32)
    ; CHECK-NEXT: $vgpr1 = COPY %fma(f32)
    %a:_(f32) = G_FCONSTANT float f0x91FFFFFF
    %b:_(f32) = G_FCONSTANT float f0xAE000000
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %mul:_(f32) = G_FMUL %a, %b
    %fma:_(f32) = G_FMA %a, %b, %zero
    $vgpr0 = COPY %mul
    $vgpr1 = COPY %fma
...

---
name: fcmp
body: |
  bb.0:
    ; CHECK-LABEL: name: fcmp
    ; CHECK: %extended:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: $vgpr0 = COPY %extended(i32)
    %denorm:_(f32) = G_FCONSTANT float 1.40129846e-45
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %result:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %result
    $vgpr0 = COPY %extended
...

