name: dynamic
body: |
  bb.0:
    ; CHECK-LABEL: name: dynamic
    ; CHECK: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: %result:_(s32) = G_FADD %denorm, %denorm
    ; CHECK-NEXT: $vgpr0 = COPY %result(s32)
    %denorm:_(s32) = G_FCONSTANT float 1.40129846e-45
    %result:_(s32) = G_FADD %denorm, %denorm
    $vgpr0 = COPY %result
...

