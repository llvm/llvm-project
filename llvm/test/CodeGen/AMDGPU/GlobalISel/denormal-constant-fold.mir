    ; CHECK-NEXT: $vgpr2_vgpr3 = COPY %ceil(f64)
    ; CHECK-NEXT: $vgpr4 = COPY %extended(i32)
    %denorm:_(f64) = G_FCONSTANT double f0x0000000000000001
    %zero:_(f64) = G_FCONSTANT double 0.000000e+00
    %add:_(f64) = G_FADD %denorm, %denorm
    %ceil:_(f64) = G_FCEIL %denorm
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $vgpr0_vgpr1 = COPY %add
    $vgpr2_vgpr3 = COPY %ceil
    $vgpr4 = COPY %extended
...
