---
name: f16_ftz
body: |
  bb.0:
    ; CHECK-LABEL: name: f16_ftz
    ; CHECK: %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: $vgpr0 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr1 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr2 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr3 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr4 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr5 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr6 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr7 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr8 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr9 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr10 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr11 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr12 = COPY %zero(f16)
    ; CHECK-NEXT: $vgpr13 = COPY %extended(i32)
    ; CHECK-NEXT: $vgpr14 = COPY %zero(f16)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %negdenorm:_(f16) = G_FCONSTANT half f0x8001
    %one:_(f16) = G_FCONSTANT half 1.000000e+00
    %two:_(f16) = G_FCONSTANT half 2.000000e+00
    %half:_(f16) = G_FCONSTANT half 5.000000e-01
    %add:_(f16) = G_FADD %denorm, %denorm
    %sub:_(f16) = G_FSUB %denorm, %negdenorm
    %mul:_(f16) = G_FMUL %denorm, %two
    %div:_(f16) = G_FDIV %denorm, %half
    %rem:_(f16) = G_FREM %denorm, %two
    %fma:_(f16) = G_FMA %denorm, %one, %zero
    %ceil:_(f16) = G_FCEIL %denorm
    %minnum:_(f16) = G_FMINNUM %denorm, %one
    %maxnum:_(f16) = G_FMAXNUM %denorm, %zero
    %minimum:_(f16) = G_FMINIMUM %denorm, %one
    %maximum:_(f16) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f16) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f16) = G_FMAXIMUMNUM %denorm, %zero
    %minnormal:_(f16) = G_FCONSTANT half f0x0400
    %output_mul:_(f16) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $vgpr0 = COPY %add
    $vgpr1 = COPY %sub
    $vgpr2 = COPY %mul
    $vgpr3 = COPY %div
    $vgpr4 = COPY %rem
    $vgpr5 = COPY %fma
    $vgpr6 = COPY %ceil
    $vgpr7 = COPY %minnum
    $vgpr8 = COPY %maxnum
    $vgpr9 = COPY %minimum
    $vgpr10 = COPY %maximum
    $vgpr11 = COPY %minimumnum
    $vgpr12 = COPY %maximumnum
    $vgpr13 = COPY %extended
    $vgpr14 = COPY %output_mul
...

