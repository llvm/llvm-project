body: |
  bb.0:
    ; CHECK-LABEL: name: minmax_dynamic
    ; CHECK: %denorm:_(s32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: %one:_(s32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: %result:_(s32) = G_FMINNUM %denorm, %one
    ; CHECK-NEXT: $vgpr0 = COPY %result(s32)
    %denorm:_(s32) = G_FCONSTANT float 1.40129846e-45
