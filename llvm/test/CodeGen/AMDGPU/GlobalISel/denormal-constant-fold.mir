name: f64_ftz
# denormal_fpenv(preservesign, float: ieee)
body: |
  bb.0:
    ; FIXME: Fold the arithmetic, FMA, ceil, and min/max results to +0, and
    ; G_FCMP to true (G_ZEXT to 1). Flush %output_mul to +0 too: its inputs
    ; are normal, but its result is subnormal. The float: ieee mode only
    ; applies to f32 and must not disable flushing for f64.
    ; CHECK-LABEL: name: f64_ftz
    ; CHECK: %denorm:_(f64) = G_FCONSTANT double 4.940660e-324
    ; CHECK-NEXT: %one:_(f64) = G_FCONSTANT double 1.000000e+00
    ; CHECK-NEXT: %add:_(f64) = G_FCONSTANT double 9.881310e-324
    ; CHECK-NEXT: %output_mul:_(f64) = G_FCONSTANT double f0x0008000000000000
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %add(f64)
    ; CHECK-NEXT: $vgpr2_vgpr3 = COPY %add(f64)
    ; CHECK-NEXT: $vgpr4_vgpr5 = COPY %add(f64)
    ; CHECK-NEXT: $vgpr6_vgpr7 = COPY %add(f64)
    ; CHECK-NEXT: $vgpr10_vgpr11 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr12_vgpr13 = COPY %one(f64)
    ; CHECK-NEXT: $vgpr14_vgpr15 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr16_vgpr17 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr18_vgpr19 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr20_vgpr21 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr22_vgpr23 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr24_vgpr25 = COPY %denorm(f64)
    ; CHECK-NEXT: $vgpr26 = COPY %extended(i32)
    ; CHECK-NEXT: $vgpr28_vgpr29 = COPY %output_mul(f64)
    %denorm:_(f64) = G_FCONSTANT double f0x0000000000000001
    %zero:_(f64) = G_FCONSTANT double 0.000000e+00
    %negdenorm:_(f64) = G_FCONSTANT double f0x8000000000000001
    %one:_(f64) = G_FCONSTANT double 1.000000e+00
    %two:_(f64) = G_FCONSTANT double 2.000000e+00
    %half:_(f64) = G_FCONSTANT double 5.000000e-01
    %add:_(f64) = G_FADD %denorm, %denorm
    %sub:_(f64) = G_FSUB %denorm, %negdenorm
    %mul:_(f64) = G_FMUL %denorm, %two
    %div:_(f64) = G_FDIV %denorm, %half
    %fma:_(f64) = G_FMA %denorm, %one, %zero
    %ceil:_(f64) = G_FCEIL %denorm
    %minnum:_(f64) = G_FMINNUM %denorm, %one
    %maxnum:_(f64) = G_FMAXNUM %denorm, %zero
    %minimum:_(f64) = G_FMINIMUM %denorm, %one
    %maximum:_(f64) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f64) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f64) = G_FMAXIMUMNUM %denorm, %zero
    %minnormal:_(f64) = G_FCONSTANT double f0x0010000000000000
    %output_mul:_(f64) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $vgpr0_vgpr1 = COPY %add
    $vgpr2_vgpr3 = COPY %sub
    $vgpr4_vgpr5 = COPY %mul
    $vgpr6_vgpr7 = COPY %div
    $vgpr10_vgpr11 = COPY %fma
    $vgpr12_vgpr13 = COPY %ceil
    $vgpr14_vgpr15 = COPY %minnum
    $vgpr16_vgpr17 = COPY %maxnum
    $vgpr18_vgpr19 = COPY %minimum
    $vgpr20_vgpr21 = COPY %maximum
    $vgpr22_vgpr23 = COPY %minimumnum
    $vgpr24_vgpr25 = COPY %maximumnum
    $vgpr26 = COPY %extended
    $vgpr28_vgpr29 = COPY %output_mul
...

