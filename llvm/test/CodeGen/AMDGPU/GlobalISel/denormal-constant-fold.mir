    ; CHECK-NEXT: %minnormal:_(f16) = G_FCONSTANT half 6.103520e-05
    ; CHECK-NEXT: %half:_(f16) = G_FCONSTANT half 5.000000e-01
    ; CHECK-NEXT: %output_mul:_(f16) = G_FMUL %minnormal, %half
    ; CHECK-NEXT: %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm(f16), %zero
    ; CHECK-NEXT: %extended:_(i32) = G_ZEXT %cmp(i1)
    ; CHECK-NEXT: $vgpr0 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr1 = COPY %fma(f16)
    ; CHECK-NEXT: $vgpr2 = COPY %ceil(f16)
