# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=amdgpu-prelegalizer-combiner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Record the current generic GlobalISel folding behavior for arithmetic,
# G_FREM, G_FMA, G_FCMP, rounding, and min/max. These folds currently ignore the
# MachineFunction's denormal mode, including dynamic environments.
# Cover f16/f64 environments independently of the float: mode as well.
# FIXME: Make these constant folds honor the denormal environment.

--- |
  define void @fbinops() denormal_fpenv(float: preservesign) { ret void }

  define void @frem() denormal_fpenv(float: preservesign) { ret void }

  define void @fma() denormal_fpenv(float: preservesign) { ret void }

  define void @ftz_boundary() denormal_fpenv(float: preservesign) { ret void }

  define void @fcmp() denormal_fpenv(float: preservesign) { ret void }

  define void @dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @ceil() denormal_fpenv(float: preservesign) { ret void }

  define void @ceil_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @minmax() denormal_fpenv(float: preservesign) { ret void }

  define void @minmax_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @f16_ftz() denormal_fpenv(preservesign, float: ieee) { ret void }

  define void @f16_dynamic() denormal_fpenv(dynamic, float: ieee) { ret void }

  define void @f16_ieee() denormal_fpenv(float: preservesign) { ret void }

  define void @f64_ftz() denormal_fpenv(preservesign, float: ieee) { ret void }

  define void @f64_dynamic() denormal_fpenv(dynamic, float: ieee) { ret void }

  define void @f64_ieee() denormal_fpenv(float: preservesign) { ret void }

...

---
name: fbinops
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; FIXME: Flush the subnormal inputs and fold all four results to +0.
    ; CHECK-LABEL: name: fbinops
    ; CHECK: %add:_(f32) = G_FCONSTANT float 2.802600e-45
    ; CHECK-NEXT: $vgpr0 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr1 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr2 = COPY %add(f32)
    ; CHECK-NEXT: $vgpr3 = COPY %add(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %negdenorm:_(f32) = G_FCONSTANT float f0x80000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %two:_(f32) = G_FCONSTANT float 2.000000e+00
    %half:_(f32) = G_FCONSTANT float 5.000000e-01
    %add:_(f32) = G_FADD %denorm, %denorm
    %sub:_(f32) = G_FSUB %denorm, %negdenorm
    %mul:_(f32) = G_FMUL %denorm, %two
    %div:_(f32) = G_FDIV %denorm, %half
    $vgpr0 = COPY %add
    $vgpr1 = COPY %sub
    $vgpr2 = COPY %mul
    $vgpr3 = COPY %div
...

---
name: frem
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; Both inputs are normal, but the remainder is subnormal. The expanded
    ; FRem arithmetic path flushes this result to +0 under preservesign.
    ; FIXME: Fold to +0 instead of the unflushed f0x00400000.
    ; CHECK-LABEL: name: frem
    ; CHECK: %result:_(f32) = G_FCONSTANT float f0x00400000
    ; CHECK-NEXT: $vgpr0 = COPY %result(f32)
    %x:_(f32) = G_FCONSTANT float f0x00C00000
    %y:_(f32) = G_FCONSTANT float f0x00800000
    %result:_(f32) = G_FREM %x, %y
    $vgpr0 = COPY %result
...

---
name: fma
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; FIXME: Flush the subnormal input and fold G_FMA to +0.
    ; CHECK-LABEL: name: fma
    ; CHECK: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: $vgpr0 = COPY %denorm(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %result:_(f32) = G_FMA %denorm, %one, %zero
    $vgpr0 = COPY %result
...

---
name: ftz_boundary
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; FIXME: Leave G_FMUL and G_FMA unfolded rather than folding to min-normal.
    ; Their exact results are subnormal and FTZ produces +0 before rounding.
    ; CHECK-LABEL: name: ftz_boundary
    ; CHECK: %mul:_(f32) = G_FCONSTANT float f0x00800000
    ; CHECK-NEXT: $vgpr0 = COPY %mul(f32)
    ; CHECK-NEXT: $vgpr1 = COPY %mul(f32)
    %a:_(f32) = G_FCONSTANT float f0x91FFFFFF
    %b:_(f32) = G_FCONSTANT float f0xAE000000
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %mul:_(f32) = G_FMUL %a, %b
    %fma:_(f32) = G_FMA %a, %b, %zero
    $vgpr0 = COPY %mul
    $vgpr1 = COPY %fma
...

---
name: fcmp
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; FIXME: Flush the subnormal input so G_FCMP is true and G_ZEXT yields 1.
    ; CHECK-LABEL: name: fcmp
    ; CHECK: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY %extended(i32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %result:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %result
    $vgpr0 = COPY %extended
...

---
name: dynamic
# denormal_fpenv(float: dynamic)
body: |
  bb.0:
    ; FIXME: Leave G_FADD unfolded: its result depends on dynamic flushing.
    ; CHECK-LABEL: name: dynamic
    ; CHECK: %result:_(f32) = G_FCONSTANT float 2.802600e-45
    ; CHECK-NEXT: $vgpr0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %result:_(f32) = G_FADD %denorm, %denorm
    $vgpr0 = COPY %result
...

---
name: ceil
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; FIXME: Flush the subnormal input and fold G_FCEIL to +0 instead of 1.
    ; CHECK-LABEL: name: ceil
    ; CHECK: %result:_(f32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %result:_(f32) = G_FCEIL %denorm
    $vgpr0 = COPY %result
...

---
name: ceil_dynamic
# denormal_fpenv(float: dynamic)
body: |
  bb.0:
    ; FIXME: Leave G_FCEIL unfolded: IEEE gives 1, but input FTZ gives +0.
    ; CHECK-LABEL: name: ceil_dynamic
    ; CHECK: %result:_(f32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %result:_(f32) = G_FCEIL %denorm
    $vgpr0 = COPY %result
...

---
name: minmax
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; FIXME: Flush the subnormal inputs and fold all six min/max results to +0.
    ; CHECK-LABEL: name: minmax
    ; CHECK: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: $vgpr0 = COPY %denorm(f32)
    ; CHECK-NEXT: $vgpr1 = COPY %denorm(f32)
    ; CHECK-NEXT: $vgpr2 = COPY %denorm(f32)
    ; CHECK-NEXT: $vgpr3 = COPY %denorm(f32)
    ; CHECK-NEXT: $vgpr4 = COPY %denorm(f32)
    ; CHECK-NEXT: $vgpr5 = COPY %denorm(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %minnum:_(f32) = G_FMINNUM %denorm, %one
    %maxnum:_(f32) = G_FMAXNUM %denorm, %zero
    %minimum:_(f32) = G_FMINIMUM %denorm, %one
    %maximum:_(f32) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f32) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f32) = G_FMAXIMUMNUM %denorm, %zero
    $vgpr0 = COPY %minnum
    $vgpr1 = COPY %maxnum
    $vgpr2 = COPY %minimum
    $vgpr3 = COPY %maximum
    $vgpr4 = COPY %minimumnum
    $vgpr5 = COPY %maximumnum
...

---
name: minmax_dynamic
# denormal_fpenv(float: dynamic)
body: |
  bb.0:
    ; FIXME: Leave G_FMINNUM unfolded: its result depends on dynamic flushing.
    ; CHECK-LABEL: name: minmax_dynamic
    ; CHECK: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: $vgpr0 = COPY %denorm(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %result:_(f32) = G_FMINNUM %denorm, %one
    $vgpr0 = COPY %result
...

---
name: f16_ftz
# denormal_fpenv(preservesign, float: ieee)
body: |
  bb.0:
    ; FIXME: Fold the arithmetic, FMA, ceil, and min/max results to +0, and
    ; G_FCMP to true (G_ZEXT to 1). Flush %output_mul to +0 too: its inputs
    ; are normal, but its result is subnormal. The float: ieee mode only
    ; applies to f32 and must not disable flushing for f16.
    ; CHECK-LABEL: name: f16_ftz
    ; CHECK: %denorm:_(f16) = G_FCONSTANT half 5.960460e-08
    ; CHECK-NEXT: %one:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: %add:_(f16) = G_FCONSTANT half 1.192090e-07
    ; CHECK-NEXT: %output_mul:_(f16) = G_FCONSTANT half 3.051760e-05
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr1 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr2 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr3 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr5 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr6 = COPY %one(f16)
    ; CHECK-NEXT: $vgpr7 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr8 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr9 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr10 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr11 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr12 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr13 = COPY %extended(i32)
    ; CHECK-NEXT: $vgpr14 = COPY %output_mul(f16)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %negdenorm:_(f16) = G_FCONSTANT half f0x8001
    %one:_(f16) = G_FCONSTANT half 1.000000e+00
    %two:_(f16) = G_FCONSTANT half 2.000000e+00
    %half:_(f16) = G_FCONSTANT half 5.000000e-01
    %add:_(f16) = G_FADD %denorm, %denorm
    %sub:_(f16) = G_FSUB %denorm, %negdenorm
    %mul:_(f16) = G_FMUL %denorm, %two
    %div:_(f16) = G_FDIV %denorm, %half
    %fma:_(f16) = G_FMA %denorm, %one, %zero
    %ceil:_(f16) = G_FCEIL %denorm
    %minnum:_(f16) = G_FMINNUM %denorm, %one
    %maxnum:_(f16) = G_FMAXNUM %denorm, %zero
    %minimum:_(f16) = G_FMINIMUM %denorm, %one
    %maximum:_(f16) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f16) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f16) = G_FMAXIMUMNUM %denorm, %zero
    %minnormal:_(f16) = G_FCONSTANT half f0x0400
    %output_mul:_(f16) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $vgpr0 = COPY %add
    $vgpr1 = COPY %sub
    $vgpr2 = COPY %mul
    $vgpr3 = COPY %div
    $vgpr5 = COPY %fma
    $vgpr6 = COPY %ceil
    $vgpr7 = COPY %minnum
    $vgpr8 = COPY %maxnum
    $vgpr9 = COPY %minimum
    $vgpr10 = COPY %maximum
    $vgpr11 = COPY %minimumnum
    $vgpr12 = COPY %maximumnum
    $vgpr13 = COPY %extended
    $vgpr14 = COPY %output_mul
...

---
name: f16_dynamic
# denormal_fpenv(dynamic, float: ieee)
body: |
  bb.0:
    ; FIXME: Leave G_FADD, G_FMA, G_FCEIL, G_FMINNUM, G_FMUL, and G_FCMP
    ; unfolded: their results depend on dynamic input/output flushing for f16,
    ; independently of the float: ieee mode.
    ; CHECK-LABEL: name: f16_dynamic
    ; CHECK: %denorm:_(f16) = G_FCONSTANT half 5.960460e-08
    ; CHECK-NEXT: %one:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: %add:_(f16) = G_FCONSTANT half 1.192090e-07
    ; CHECK-NEXT: %output_mul:_(f16) = G_FCONSTANT half 3.051760e-05
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr1 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr2 = COPY %one(f16)
    ; CHECK-NEXT: $vgpr3 = COPY %denorm(f16)
    ; CHECK-NEXT: $vgpr4 = COPY %extended(i32)
    ; CHECK-NEXT: $vgpr5 = COPY %output_mul(f16)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %one:_(f16) = G_FCONSTANT half 1.000000e+00
    %add:_(f16) = G_FADD %denorm, %denorm
    %fma:_(f16) = G_FMA %denorm, %one, %zero
    %ceil:_(f16) = G_FCEIL %denorm
    %minnum:_(f16) = G_FMINNUM %denorm, %one
    %minnormal:_(f16) = G_FCONSTANT half f0x0400
    %half:_(f16) = G_FCONSTANT half 5.000000e-01
    %output_mul:_(f16) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $vgpr0 = COPY %add
    $vgpr1 = COPY %fma
    $vgpr2 = COPY %ceil
    $vgpr3 = COPY %minnum
    $vgpr4 = COPY %extended
    $vgpr5 = COPY %output_mul
...

---
name: f16_ieee
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; f16 defaults to IEEE; the f32 FTZ setting must not affect these folds.
    ; G_FADD produces f0x0002, G_FCEIL produces 1, and G_FCMP is false
    ; CHECK-LABEL: name: f16_ieee
    ; CHECK: %add:_(f16) = G_FCONSTANT half 1.192090e-07
    ; CHECK-NEXT: %ceil:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY %add(f16)
    ; CHECK-NEXT: $vgpr1 = COPY %ceil(f16)
    ; CHECK-NEXT: $vgpr2 = COPY %extended(i32)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %add:_(f16) = G_FADD %denorm, %denorm
    %ceil:_(f16) = G_FCEIL %denorm
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $vgpr0 = COPY %add
    $vgpr1 = COPY %ceil
    $vgpr2 = COPY %extended
...

