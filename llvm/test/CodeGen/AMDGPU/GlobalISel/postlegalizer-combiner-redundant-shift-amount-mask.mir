    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 15
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND [[COPY1]], [[C]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s64) = G_SHL [[COPY]], [[AND]](s32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[SHL]](s64)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0_vgpr1
    %0:_(s64) = COPY $vgpr0_vgpr1
    %1:_(s32) = COPY $vgpr2
    %2:_(s32) = G_CONSTANT i32 15
    %3:_(s32) = G_AND %1, %2
    %4:_(s64) = G_SHL %0, %3
    $vgpr0_vgpr1 = COPY %4
    S_ENDPGM 0, implicit $vgpr0_vgpr1
...

