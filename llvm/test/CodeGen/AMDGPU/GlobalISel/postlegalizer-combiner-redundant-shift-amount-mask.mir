# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=amdgpu-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# A scalar shift only reads the low log2(bitwidth) bits of its amount, so an
# (and amt, mask) feeding the amount is redundant when mask covers those bits.

---
name: shl_and_31
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: shl_and_31
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL [[COPY]], [[COPY1]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_CONSTANT i32 31
    %3:_(s32) = G_AND %1, %2
    %4:_(s32) = G_SHL %0, %3
    $vgpr0 = COPY %4
    S_ENDPGM 0, implicit $vgpr0
...

