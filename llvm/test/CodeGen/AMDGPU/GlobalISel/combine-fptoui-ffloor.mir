name:            fptoui_ffloor_s32
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: fptoui_ffloor_s32
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[FPTOUI:%[0-9]+]]:_(s32) = G_FPTOUI [[COPY]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[FPTOUI]](s32)
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_FFLOOR %0
    %2:_(s32) = G_FPTOUI %1
    $vgpr0 = COPY %2
...
