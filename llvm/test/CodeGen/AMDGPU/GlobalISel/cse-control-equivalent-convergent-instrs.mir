# RUN: llc -mtriple=amdgpu10.10-amd-amdhsa -o - -passes=machine-cse %s | FileCheck %s

# Check that a convergent instruction is CSE'd across BB's when the
# blocks are control-equivalent. The block holding the earlier instruction
# dominates the later block, and the later block post-dominates the earlier
# one. Every path that reaches bb.2 goes through bb.1, and every path that
# leaves bb.1 goes through bb.2, so both swizzles execute under the same
# conditions.
#
# This test contrast's  no-cse-nonlocal-convergent-instrs.mir, where bb.1 can branch
# around bb.2, so bb.2 does not post-dominate bb.1 and the CSE is refused.

# CHECK-LABEL: name: cse_control_equivalent_instrs
# CHECK: bb.1.if.then
# CHECK: [[SWIZZLE:%[0-9]+]]:vgpr_32 = DS_SWIZZLE_B32 {{%[0-9]+}}, 100, 0, implicit $exec
# CHECK: bb.2.if.then.if.then
# CHECK-NOT: DS_SWIZZLE_B32
# CHECK: V_ADD_CO_U32_e64 [[SWIZZLE]], {{%[0-9]+}}, 0, implicit $exec

--- |
  define amdgpu_kernel void @cse_control_equivalent_instrs(ptr addrspace(1), i32, i1) {
  entry:
    unreachable
  if.then:
    unreachable
  if.then.if.then:
    unreachable
  if.then.phi:
    unreachable
  exit:
    unreachable
  }
...
---
name: cse_control_equivalent_instrs
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $sgpr4_sgpr5
    %0:sgpr_64(p4) = COPY $sgpr4_sgpr5
    %1:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0(p4), 0, 0
    %2:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0(p4), 2, 0
    %3:sreg_64 = COPY %1
    %4:sreg_32 = COPY %2.sub1
    %5:sreg_32 = S_MOV_B32 42
    S_CMP_EQ_U32 %4, %5, implicit-def $scc
    %6:vgpr_32 = COPY %5, implicit $exec
    S_CBRANCH_SCC1 %bb.4, implicit $scc
    S_BRANCH %bb.1
  
  bb.1.if.then:
    %7:sreg_32 = COPY %2.sub0
    %8:vgpr_32 = COPY %7
    %9:vgpr_32 = DS_SWIZZLE_B32 %8, 100, 0, implicit $exec
    %10:vgpr_32, %21:sreg_32 = V_ADD_CO_U32_e64 %9, %5, 0, implicit $exec
    S_BRANCH %bb.2
  
  bb.2.if.then.if.then:
    %11:sreg_32 = S_MOV_B32 64
    %12:vgpr_32 = DS_SWIZZLE_B32 %8, 100, 0, implicit $exec
    %13:vgpr_32, %24:sreg_32 = V_ADD_CO_U32_e64 %12, %11, 0, implicit $exec
  
  bb.3.if.then.phi:
  
  bb.4.exit:
    %15:vgpr_32 = PHI %6, %bb.0, %13, %bb.3
    %16:vreg_64 = COPY %3
    FLAT_STORE_DWORD %16, %15, 0, 0, implicit $exec, implicit $flat_scr
    S_ENDPGM 0

...
