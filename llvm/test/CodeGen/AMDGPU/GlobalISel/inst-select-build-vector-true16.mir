    %1:vgpr(i16) = G_TRUNC %0
    %2:sgpr(i16) = G_CONSTANT i16 0
    %3:vgpr(i16) = COPY %2
    %4:vgpr(<2 x i16>) = G_BUILD_VECTOR %3, %1
    S_ENDPGM 0, implicit %4
...

