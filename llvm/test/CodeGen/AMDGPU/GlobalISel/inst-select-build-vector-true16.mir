---
name: test_build_vector_in_range_v2s16
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: test_build_vector_in_range_v2s16
    ; CHECK-NOT: V_CVT_PK_U16_U32
    ; CHECK: S_ENDPGM
    %0:vgpr(i32) = COPY $vgpr0
    %1:vgpr(i32) = COPY $vgpr1
    %2:vgpr(i32) = G_CONSTANT i32 17
    %3:vgpr(i32) = G_LSHR %0, %2
    %4:vgpr(i32) = G_LSHR %1, %2
    %5:vgpr(i16) = G_TRUNC %3
    %6:vgpr(i16) = G_TRUNC %4
    %7:vgpr(<2 x i16>) = G_BUILD_VECTOR %5, %6
    S_ENDPGM 0, implicit %7
...

