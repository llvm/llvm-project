# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -amdgpu-global-isel-new-legality -mtriple=amdgpu11.00 -mattr=+real-true16 -run-pass=amdgpu-reg-bank-select,amdgpu-reg-bank-legalize -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,GFX11
# RUN: llc -amdgpu-global-isel-new-legality -mtriple=amdgpu12.00 -mattr=+real-true16 -run-pass=amdgpu-reg-bank-select,amdgpu-reg-bank-legalize -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,GFX12
# RUN: llc -amdgpu-global-isel-new-legality -mtriple=amdgpu12.50 -mattr=+real-true16 -run-pass=amdgpu-reg-bank-select,amdgpu-reg-bank-legalize -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,GFX12

# Splitting uniform values and moving uniform floating results back from VGPRs
# must preserve the register banks on integer intermediates.

---
name: unmerge_sgpr_i64_f16
legalized: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; GCN-LABEL: name: unmerge_sgpr_i64_f16
    ; GCN: liveins: $sgpr0_sgpr1
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: [[COPY:%[0-9]+]]:sgpr(i64) = COPY $sgpr0_sgpr1
    ; GCN-NEXT: [[UV:%[0-9]+]]:sgpr(i32), [[UV1:%[0-9]+]]:sgpr(i32) = G_UNMERGE_VALUES [[COPY]](i64)
    ; GCN-NEXT: [[C:%[0-9]+]]:sgpr(i32) = G_CONSTANT i32 16
    ; GCN-NEXT: [[LSHR:%[0-9]+]]:sgpr(i32) = G_LSHR [[UV]], [[C]](i32)
    ; GCN-NEXT: [[TRUNC:%[0-9]+]]:sgpr(i16) = G_TRUNC [[UV]](i32)
    ; GCN-NEXT: [[BITCAST:%[0-9]+]]:sgpr(f16) = G_BITCAST [[TRUNC]](i16)
    ; GCN-NEXT: [[TRUNC1:%[0-9]+]]:sgpr(i16) = G_TRUNC [[LSHR]](i32)
    ; GCN-NEXT: [[BITCAST1:%[0-9]+]]:sgpr(f16) = G_BITCAST [[TRUNC1]](i16)
    ; GCN-NEXT: [[LSHR1:%[0-9]+]]:sgpr(i32) = G_LSHR [[UV1]], [[C]](i32)
    ; GCN-NEXT: [[TRUNC2:%[0-9]+]]:sgpr(i16) = G_TRUNC [[UV1]](i32)
    ; GCN-NEXT: [[BITCAST2:%[0-9]+]]:sgpr(f16) = G_BITCAST [[TRUNC2]](i16)
    ; GCN-NEXT: [[TRUNC3:%[0-9]+]]:sgpr(i16) = G_TRUNC [[LSHR1]](i32)
    ; GCN-NEXT: [[BITCAST3:%[0-9]+]]:sgpr(f16) = G_BITCAST [[TRUNC3]](i16)
    ; GCN-NEXT: $vgpr0 = COPY [[BITCAST]](f16)
    ; GCN-NEXT: $vgpr1 = COPY [[BITCAST1]](f16)
    ; GCN-NEXT: $vgpr2 = COPY [[BITCAST2]](f16)
    ; GCN-NEXT: $vgpr3 = COPY [[BITCAST3]](f16)
    %0:_(i64) = COPY $sgpr0_sgpr1
    %1:_(f16), %2:_(f16), %3:_(f16), %4:_(f16) = G_UNMERGE_VALUES %0
    $vgpr0 = COPY %1
    $vgpr1 = COPY %2
    $vgpr2 = COPY %3
    $vgpr3 = COPY %4
...

