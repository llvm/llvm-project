body: |
  bb.0:
    liveins: $sgpr0_64, $sgpr2_64, $sgpr4_64, $sgpr6_64

    ; GCN-LABEL: name: test_concat_vectors_s_v8p3_s_v2p3_s_v2p3_v2p3_s_v2p3
    ; GCN: liveins: $sgpr0_64, $sgpr2_64, $sgpr4_64, $sgpr6_64
