    ; GCN-NEXT: [[COPY:%[0-9]+]]:sreg_64 = COPY $sgpr0_64
    ; GCN-NEXT: [[COPY1:%[0-9]+]]:sreg_64 = COPY $sgpr2_64
    ; GCN-NEXT: [[COPY2:%[0-9]+]]:sreg_64 = COPY $sgpr4_64
    ; GCN-NEXT: [[COPY3:%[0-9]+]]:sreg_64 = COPY $sgpr6_64
    ; GCN-NEXT: [[REG_SEQUENCE:%[0-9]+]]:sgpr_256 = REG_SEQUENCE [[COPY]], %subreg.sub0_sub1, [[COPY1]], %subreg.sub2_sub3, [[COPY2]], %subreg.sub4_sub5, [[COPY3]], %subreg.sub6_sub7
    ; GCN-NEXT: $sgpr0_256 = COPY [[REG_SEQUENCE]]
    %0:sgpr(<2 x p3>) = COPY $sgpr0_64
    %1:sgpr(<2 x p3>) = COPY $sgpr2_64
    %2:sgpr(<2 x p3>) = COPY $sgpr4_64
    %3:sgpr(<2 x p3>) = COPY $sgpr6_64
