; CHECK:       ; %bb.0:
; CHECK-NEXT:    v_mov_b32_e32 v3, 0x12d8fb
; CHECK-NEXT:    v_mul_u32_u24_sdwa v0, v0, v3 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_0 src1_sel:DWORD
; CHECK-NEXT:    global_store_dword v[1:2], v0, off
; CHECK-NEXT:    s_endpgm
  %z = zext i8 %x to i32
  %r = mul i32 %z, 1235195
  store i32 %r, ptr addrspace(1) %p
  ret void
}

