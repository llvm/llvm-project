; CHECK-NEXT:    v_mul_u32_u24_e32 v0, 0x12d8fb, v0
; CHECK-NEXT:    global_store_dword v[1:2], v0, off
; CHECK-NEXT:    s_endpgm
  %masked = and i8 %x, 63     ; bit 7 of i8 known zero -> non-negative i8
  %s = sext i8 %masked to i32  ; source IsNeg=false -> G_SEXT propagates IsNeg=false
  %r = mul i32 %s, 1235195
