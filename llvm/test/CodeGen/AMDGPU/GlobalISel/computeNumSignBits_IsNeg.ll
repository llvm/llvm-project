; CHECK-NEXT:    v_cndmask_b32_sdwa v0, v2, v1, vcc dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:WORD_0 src1_sel:WORD_0
; CHECK-NEXT:    v_mul_u32_u24_e32 v0, 0x12d8fb, v0
