; CHECK-NEXT:    v_mul_i32_i24_sdwa v0, sext(v0), v3 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_0 src1_sel:DWORD
; CHECK-NEXT:    global_store_dword v[1:2], v0, off
; CHECK-NEXT:    s_endpgm
