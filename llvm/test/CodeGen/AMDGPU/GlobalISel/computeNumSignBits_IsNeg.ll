; Test for GISelValueTracking::computeNumSignBits IsNeg output parameter.
; Each function exercises a different code path that sets or propagates IsNeg,
; using the mul24 combiner as the observable outcome: when IsNeg=false for both
; operands v_mul_u32_u24 is selected, otherwise v_mul_i32_i24.

; COPY path: IsNeg=false constant loaded into SGPR, copied to VGPR.
define amdgpu_ps void @mul24_copy_sgpr_const(i32 %x, ptr addrspace(1) %p) {
; CHECK-LABEL: mul24_copy_sgpr_const:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    v_mov_b32_e32 v3, 0x12d8fb
; CHECK-NEXT:    v_mul_u32_u24_sdwa v0, v0, v3 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:WORD_0 src1_sel:DWORD
; CHECK-NEXT:    global_store_dword v[1:2], v0, off
; CHECK-NEXT:    s_endpgm
  %masked = and i32 %x, 65535     ; 16 leading zeros in VGPR, IsNeg=false
  %r = mul i32 %masked, 1235195   ; const 1235195: SGPR->VGPR COPY, IsNeg=false
  store i32 %r, ptr addrspace(1) %p
  ret void
}

; G_ZEXT path: IsNeg=false zero-extended value.
define amdgpu_ps void @mul24_zext(i8 %x, ptr addrspace(1) %p) {
