# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa --passes='print<live-intervals>' -filetype=null %s 2>&1 | FileCheck %s

# The undef def of %0.sub0 in %bb.2 makes the exit of %bb.2 undefined for
# sub1, but %0.sub1 is still live into %bb.2 for the use before it. Computing
# the sub1 subrange must not treat %bb.2 as undefined on entry.

# CHECK-LABEL: Live intervals for machine function: undef_subreg_def_after_use_in_loop:
# CHECK: %0 [16r,48B:0)[48B,80r:2)[96r,144B:1)[144B,208B:0) 0@16r 1@96r 2@48B-phi  L000000000000000C [16r,48B:0)[48B,80r:1)[144B,208B:0) 0@16r 1@48B-phi  L0000000000000003 [16r,16d:1)[96r,96d:0) 0@96r 1@16r
---
name: undef_subreg_def_after_use_in_loop
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    %0:vreg_64_align2 = COPY $vgpr0_vgpr1
    S_BRANCH %bb.3

  bb.1:

  bb.2:
    $vgpr0 = COPY %0.sub1
    undef %0.sub0:vreg_64_align2 = IMPLICIT_DEF
    S_CBRANCH_SCC1 %bb.1, implicit undef $scc
    S_BRANCH %bb.6

  bb.3:

  bb.4:

  bb.5:
    S_BRANCH %bb.1

  bb.6:
    S_ENDPGM 0
...
