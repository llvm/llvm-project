# REQUIRES: asserts
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=machine-scheduler -misched-only-block=1 -misched-prera-direction=topdown -amdgpu-use-amdgpu-trackers=true -amdgpu-mfma-vgpr-form=0 -verify-machineinstrs -debug-only=machine-scheduler %s -o /dev/null 2>&1 | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=machine-scheduler -misched-only-block=1 -misched-prera-direction=topdown -amdgpu-use-amdgpu-trackers=false -amdgpu-mfma-vgpr-form=0 -verify-machineinstrs -debug-only=machine-scheduler %s -o /dev/null 2>&1 | FileCheck %s

--- |
  define amdgpu_kernel void @reuse_vgpr_peak() #0 { ret void }
  define amdgpu_kernel void @reuse_agpr_peak() #0 { ret void }
  attributes #0 = { "amdgpu-flat-work-group-size"="64,64" }
...

# After the gate consumes old, V=32 and A=28. Both candidates increase
# instantaneous combined pressure to 64, above the critical limit of 61.
# The earlier VGPR peak was 36: adding VGPRs reuses that peak, whereas adding
# AGPRs raises the allocation implied by the per-bank peaks from 64 to 68.
# Prefer new_v even though new_a comes first in the original order.
# CHECK-LABEL: reuse_vgpr_peak:%bb.1
# CHECK: UnifiedVGPRCriticalLimit = 61
# CHECK: Scheduling SU(0) %gate:
# CHECK: Reason:{{ *}}Cand SU(2) REG-CRIT
# CHECK: Scheduling SU(2) %new_v:
# CHECK: Scheduling SU(1) %new_a:
---
name: reuse_vgpr_peak
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 8
body: |
  bb.0:
    %v:vreg_1024 = IMPLICIT_DEF
    %a0:areg_512 = IMPLICIT_DEF
    %a1:areg_384 = IMPLICIT_DEF
    %old:vreg_128 = IMPLICIT_DEF
    S_BRANCH %bb.1
  bb.1:
    %gate:sreg_32 = S_MOV_B32 0, implicit %old
    %new_a:areg_128 = IMPLICIT_DEF implicit %gate
    %new_v:vreg_128 = IMPLICIT_DEF implicit %gate
    S_NOP 0, implicit %v, implicit %a0, implicit %a1, implicit %new_v, implicit %new_a
    S_ENDPGM 0
...

# Reverse the banks: the earlier AGPR peak was 32, and both candidates still
# have instantaneous combined pressure 64. Adding AGPRs reuses the peak;
# adding VGPRs raises the projected allocation to 68. This requires a bank
# peak comparison, rather than a fixed preference for either register bank.
# CHECK-LABEL: reuse_agpr_peak:%bb.1
# CHECK: UnifiedVGPRCriticalLimit = 61
# CHECK: Scheduling SU(0) %gate:
# CHECK: Reason:{{ *}}Cand SU(2) REG-CRIT
# CHECK: Scheduling SU(2) %new_a:
# CHECK: Scheduling SU(1) %new_v:
---
name: reuse_agpr_peak
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 8
body: |
  bb.0:
    %v:vreg_1024 = IMPLICIT_DEF
    %a0:areg_512 = IMPLICIT_DEF
    %a1:areg_384 = IMPLICIT_DEF
    %old:areg_128 = IMPLICIT_DEF
    S_BRANCH %bb.1
  bb.1:
    %gate:sreg_32 = S_MOV_B32 0, implicit %old
    %new_v:vreg_128 = IMPLICIT_DEF implicit %gate
    %new_a:areg_128 = IMPLICIT_DEF implicit %gate
    S_NOP 0, implicit %v, implicit %a0, implicit %a1, implicit %new_v, implicit %new_a
    S_ENDPGM 0
...
