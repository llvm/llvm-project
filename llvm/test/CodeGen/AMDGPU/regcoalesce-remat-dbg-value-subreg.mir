# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=register-coalescer -o - %s | FileCheck %s

# When the coalescer rematerializes a def into a copy and the copy's source
# register has no other uses, debug uses of the source register are updated to
# refer to the destination register instead. Make sure that the subregister
# index is updated too.

--- |
  define void @copy_to_subreg() !dbg !10 {
    ret void, !dbg !12
  }

  define void @copy_from_subreg_narrowed() !dbg !13 {
    ret void, !dbg !15
  }

  define void @copy_from_subreg_narrowed_other_lanes() !dbg !16 {
    ret void, !dbg !18
  }

  define void @copy_from_subreg_widened() !dbg !19 {
    ret void, !dbg !21
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !DISubroutineType(types: !4)
  !4 = !{null}
  !5 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)

  !10 = distinct !DISubprogram(name: "copy_to_subreg", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !{!11})
  !11 = !DILocalVariable(name: "v", scope: !10, file: !1, line: 1, type: !5)
  !12 = !DILocation(line: 1, scope: !10)

  !13 = distinct !DISubprogram(name: "copy_from_subreg_narrowed", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !{!14})
  !14 = !DILocalVariable(name: "v", scope: !13, file: !1, line: 1, type: !5)
  !15 = !DILocation(line: 1, scope: !13)

  !16 = distinct !DISubprogram(name: "copy_from_subreg_narrowed_other_lanes", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !{!17})
  !17 = !DILocalVariable(name: "v", scope: !16, file: !1, line: 1, type: !5)
  !18 = !DILocation(line: 1, scope: !16)

  !19 = distinct !DISubprogram(name: "copy_from_subreg_widened", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !{!20})
  !20 = !DILocalVariable(name: "v", scope: !19, file: !1, line: 1, type: !5)
  !21 = !DILocation(line: 1, scope: !19)
...

# Copy into a subregister: SrcReg becomes the sub1 subregister of DstReg.
---
name:            copy_to_subreg
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: copy_to_subreg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_MOV_B:%[0-9]+]]:vreg_64 = V_MOV_B64_PSEUDO 0, implicit $exec
  ; CHECK-NEXT:   $scc = COPY $sgpr0
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B]]
  ; CHECK-NEXT:   undef [[V_MOV_B:%[0-9]+]].sub1:vreg_64 = V_MOV_B32_e32 7, implicit $exec
  ; CHECK-NEXT:   DBG_VALUE [[V_MOV_B]].sub1, $noreg, !7, !DIExpression(), debug-location !9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0

    %1:vreg_64 = V_MOV_B64_PSEUDO 0, implicit $exec
    $scc = COPY $sgpr0
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    %0:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
    DBG_VALUE %0, $noreg, !11, !DIExpression(), debug-location !12
    S_NOP 0, implicit %1
    undef %1.sub1:vreg_64 = COPY %0

  bb.2:
    S_NOP 0, implicit %1
    S_ENDPGM 0
...

# Copy from a subregister of a subregister def: DstReg is not widened, so
# SrcReg.sub1 becomes DstReg.
---
name:            copy_from_subreg_narrowed
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: copy_from_subreg_narrowed
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   $scc = COPY $sgpr0
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B32_e32_]]
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
  ; CHECK-NEXT:   DBG_VALUE [[V_MOV_B32_e32_]], $noreg, !12, !DIExpression(), debug-location !13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B32_e32_]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0

    %1:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    $scc = COPY $sgpr0
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    undef %0.sub1:vreg_64 = V_MOV_B32_e32 7, implicit $exec
    DBG_VALUE %0.sub1, $noreg, !14, !DIExpression(), debug-location !15
    S_NOP 0, implicit %1
    %1:vgpr_32 = COPY %0.sub1

  bb.2:
    S_NOP 0, implicit %1
    S_ENDPGM 0
...

# As above, but the debug value uses all of SrcReg, which is not available in
# DstReg.
---
name:            copy_from_subreg_narrowed_other_lanes
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: copy_from_subreg_narrowed_other_lanes
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   $scc = COPY $sgpr0
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B32_e32_]]
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 7, implicit $exec
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !16, !DIExpression(), debug-location !17
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B32_e32_]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0

    %1:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    $scc = COPY $sgpr0
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    undef %0.sub1:vreg_64 = V_MOV_B32_e32 7, implicit $exec
    DBG_VALUE %0, $noreg, !17, !DIExpression(), debug-location !18
    S_NOP 0, implicit %1
    %1:vgpr_32 = COPY %0.sub1

  bb.2:
    S_NOP 0, implicit %1
    S_ENDPGM 0
...

# Copy from a subregister of a full def: DstReg is widened to SrcReg's class,
# so debug uses keep their subregister.
---
name:            copy_from_subreg_widened
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: copy_from_subreg_widened
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[V_MOV_B32_e32_:%[0-9]+]].sub1:vreg_64 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   $scc = COPY $sgpr0
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B32_e32_]].sub1
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vreg_64 = V_MOV_B64_PSEUDO 7, implicit $exec
  ; CHECK-NEXT:   DBG_VALUE [[V_MOV_B32_e32_]].sub1, $noreg, !20, !DIExpression(), debug-location !21
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_MOV_B32_e32_]].sub1
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0

    %1:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    $scc = COPY $sgpr0
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    %0:vreg_64 = V_MOV_B64_PSEUDO 7, implicit $exec
    DBG_VALUE %0.sub1, $noreg, !20, !DIExpression(), debug-location !21
    S_NOP 0, implicit %1
    %1:vgpr_32 = COPY %0.sub1

  bb.2:
    S_NOP 0, implicit %1
    S_ENDPGM 0
...
