# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -run-pass=postmisched,post-RA-hazard-rec -verify-misched %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=postmisched,post-RA-hazard-rec -verify-misched %s -o - | FileCheck %s

# Keep an independent scalar move between an asm producer and consumer rather
# than relying on the hazard recognizer to insert an S_NOP afterward.

---
name: asm_producer_latency
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: asm_producer_latency
    ; CHECK: INLINEASM &"; def $0", attdialect, regdef:SGPR_192, def $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5
    ; CHECK-NEXT: $sgpr10 = S_MOV_B32 killed $sgpr0
    ; CHECK-NEXT: INLINEASM &"; def $0", attdialect, regdef:SGPR_192, def $sgpr4_sgpr5_sgpr6_sgpr7_sgpr8_sgpr9
    ; CHECK-NEXT: $sgpr11 = S_MOV_B32 killed $sgpr1
    ; CHECK-NEXT: INLINEASM &"; use $0", sideeffect attdialect, reguse:SGPR_128, killed $sgpr8_sgpr9_sgpr10_sgpr11
    ; CHECK-NEXT: S_ENDPGM 0
    INLINEASM &"; def $0", attdialect, regdef:SGPR_192, def $sgpr0_sgpr1_sgpr2_sgpr3_sgpr4_sgpr5
    INLINEASM &"; def $0", attdialect, regdef:SGPR_192, def $sgpr4_sgpr5_sgpr6_sgpr7_sgpr8_sgpr9
    $sgpr10 = S_MOV_B32 $sgpr0
    $sgpr11 = S_MOV_B32 $sgpr1
    INLINEASM &"; use $0", sideeffect attdialect, reguse:SGPR_128, $sgpr8_sgpr9_sgpr10_sgpr11
    S_ENDPGM 0
...
