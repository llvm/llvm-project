# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -verify-machineinstrs -run-pass=postrapseudos -o - %s | FileCheck %s

# This test verifies that target flags on 64-bit global-address pseudos
# are split into correct lo/hi flags when post-RA pseudos are expanded.

--- |
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_rel32() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_rel32-hi() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_rel64() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_abs32() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_abs32-hi() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_abs64() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_gotprel() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_gotprel32() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_gotprel32-hi() {
    ret void
  }
  define amdgpu_kernel void @v_mov_b64_pseudo_globaladdr_gotprel64() {
    ret void
  }

  @gv = external addrspace(1) global i32
...

---
name: v_mov_b64_pseudo_globaladdr_rel32
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: v_mov_b64_pseudo_globaladdr_rel32
    ; CHECK: $vgpr0 = V_MOV_B32_e32 target-flags(amdgpu-rel32-lo) @gv, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 target-flags(amdgpu-rel32-hi) @gv, implicit $exec

    $vgpr0_vgpr1 = V_MOV_B64_PSEUDO target-flags(amdgpu-rel32-lo) @gv, implicit $exec
...

---
name: v_mov_b64_pseudo_globaladdr_rel32-hi
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: v_mov_b64_pseudo_globaladdr_rel32-hi
    ; CHECK: $vgpr0 = V_MOV_B32_e32 target-flags(amdgpu-rel32-lo) @gv, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 target-flags(amdgpu-rel32-hi) @gv, implicit $exec

    $vgpr0_vgpr1 = V_MOV_B64_PSEUDO target-flags(amdgpu-rel32-hi) @gv, implicit $exec
...

---
name: v_mov_b64_pseudo_globaladdr_rel64
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: v_mov_b64_pseudo_globaladdr_rel64
    ; CHECK: $vgpr0 = V_MOV_B32_e32 target-flags(amdgpu-rel32-lo) @gv, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 target-flags(amdgpu-rel32-hi) @gv, implicit $exec

    $vgpr0_vgpr1 = V_MOV_B64_PSEUDO target-flags(amdgpu-rel64) @gv, implicit $exec
...

---
name: v_mov_b64_pseudo_globaladdr_abs32
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: v_mov_b64_pseudo_globaladdr_abs32
    ; CHECK: $vgpr0 = V_MOV_B32_e32 target-flags(amdgpu-abs32-lo) @gv, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 target-flags(amdgpu-abs32-hi) @gv, implicit $exec

    $vgpr0_vgpr1 = V_MOV_B64_PSEUDO target-flags(amdgpu-abs32-lo) @gv, implicit $exec
...

---
name: v_mov_b64_pseudo_globaladdr_abs32-hi
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: v_mov_b64_pseudo_globaladdr_abs32-hi
    ; CHECK: $vgpr0 = V_MOV_B32_e32 target-flags(amdgpu-abs32-lo) @gv, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 target-flags(amdgpu-abs32-hi) @gv, implicit $exec

    $vgpr0_vgpr1 = V_MOV_B64_PSEUDO target-flags(amdgpu-abs32-hi) @gv, implicit $exec
...

---
name: v_mov_b64_pseudo_globaladdr_abs64
tracksRegLiveness: true
body: |
