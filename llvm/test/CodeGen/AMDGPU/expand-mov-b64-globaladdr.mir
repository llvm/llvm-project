    ; CHECK: $vgpr0 = V_MOV_B32_e32 target-flags(amdgpu-gotprel64) @gv, implicit $exec
    ; CHECK-NEXT: $vgpr1 = V_MOV_B32_e32 target-flags(amdgpu-gotprel64) @gv, implicit $exec

