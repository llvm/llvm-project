# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu7.00-amd-amdhsa -passes='greedy<vgpr>' \
# RUN:   -verify-machineinstrs -verify-regalloc -o - %s | FileCheck %s

# Greedy spills the VGPR value before the call. The adjacent restore can use
# the still-live assigned register; the restore after the call must remain.
--- |
  declare void @callee()
  define float @vgpr_reproducer() { ret float 0.0 }
...
---
name: vgpr_reproducer
tracksRegLiveness: true
liveins:
  - { reg: '$vgpr31', virtual-reg: '%8' }
frameInfo:
  adjustsStack: true
  hasCalls: true
machineFunctionInfo:
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
  spillPhysVGPRs: [ '$vgpr63' ]
  wwmReservedRegs: [ '$vgpr63' ]
body: |
  ; CHECK-LABEL: name: vgpr_reproducer
  ; CHECK: bb.3:
  ; CHECK: SI_SPILL_V32_SAVE [[REG:%[0-9]+]], [[SLOT:%stack\.[0-9]+]]
  ; CHECK-NEXT: $vgpr31 = COPY [[REG]]
  ; CHECK-NOT: SI_SPILL_V32_RESTORE
  ; CHECK: SI_CALL
  ; CHECK: [[REG]]:vgpr_32 = SI_SPILL_V32_RESTORE [[SLOT]]
  bb.0:
    successors: %bb.3(0x40000000), %bb.1(0x40000000)
    liveins: $vgpr31, $vgpr63, $sgpr30_sgpr31

    $vgpr63 = SI_SPILL_S32_TO_VGPR $sgpr30, 0, $vgpr63, implicit-def $sgpr30_sgpr31, implicit $sgpr30_sgpr31
    $vgpr63 = SI_SPILL_S32_TO_VGPR killed $sgpr31, 1, $vgpr63, implicit killed $sgpr30_sgpr31
    frame-setup CFI_INSTRUCTION llvm_vector_registers $pc_reg, $vgpr63, 0, 32, $vgpr63, 1, 32
    %8:vgpr_32 = COPY $vgpr31
    %4:vreg_64 = V_MOV_B64_PSEUDO 0, implicit $exec
    %5:vgpr_32 = FLAT_LOAD_DWORD %4, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from `ptr addrspace(1) null`, addrspace 1)
    renamable $sgpr4_sgpr5 = S_MOV_B64 -1
    renamable $vcc = V_CMP_LT_I32_e64 -1, %5, implicit $exec
    S_CBRANCH_VCCNZ %bb.3, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x40000000), %bb.4(0x40000000)
    liveins: $vgpr63, $sgpr4_sgpr5

    dead renamable $sgpr4_sgpr5 = S_AND_B64 killed renamable $sgpr4_sgpr5, $exec, implicit-def $scc
    %25:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    S_CBRANCH_SCC0 %bb.4, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.4(0x80000000)
    liveins: $vgpr63

    renamable $sgpr4_sgpr5 = SI_PC_ADD_REL_OFFSET target-flags(amdgpu-gotprel32-lo) @callee, target-flags(amdgpu-gotprel32-hi) @callee, implicit-def dead $scc
    renamable $sgpr4_sgpr5 = S_LOAD_DWORDX2_IMM killed renamable $sgpr4_sgpr5, 0, 0 :: (dereferenceable invariant load (s64) from got, addrspace 4)
    ADJCALLSTACKUP 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    $vgpr31 = COPY %8
    dead $sgpr30_sgpr31 = SI_CALL killed renamable $sgpr4_sgpr5, @callee, csr_amdgpu, implicit $vgpr31, implicit $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def $vgpr0
    %25:vgpr_32 = COPY $vgpr0
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    S_BRANCH %bb.4

  bb.3:
    successors: %bb.1(0x80000000)
    liveins: $vgpr63

    renamable $sgpr4_sgpr5 = SI_PC_ADD_REL_OFFSET target-flags(amdgpu-gotprel32-lo) @callee, target-flags(amdgpu-gotprel32-hi) @callee, implicit-def dead $scc
    renamable $sgpr4_sgpr5 = S_LOAD_DWORDX2_IMM killed renamable $sgpr4_sgpr5, 0, 0 :: (dereferenceable invariant load (s64) from got, addrspace 4)
    ADJCALLSTACKUP 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    $vgpr31 = COPY %8
    dead $sgpr30_sgpr31 = SI_CALL killed renamable $sgpr4_sgpr5, @callee, csr_amdgpu, implicit $vgpr31, implicit $sgpr0_sgpr1_sgpr2_sgpr3, implicit-def dead $vgpr0
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    renamable $sgpr4_sgpr5 = S_MOV_B64 0
    S_BRANCH %bb.1

  bb.4:
    liveins: $vgpr63

    $vgpr0 = COPY %25
    $sgpr30 = SI_RESTORE_S32_FROM_VGPR $vgpr63, 0, implicit-def $sgpr30_sgpr31
    $sgpr31 = SI_RESTORE_S32_FROM_VGPR $vgpr63, 1
    SI_RETURN implicit $vgpr0
...
