# RUN: llc -mtriple=amdgpu6.00 -run-pass register-coalescer -o - %s | FileCheck --check-prefix=GCN %s
# REQUIRES: asserts
#
# This test will provoke a Couldn't join subrange unreachable without the
# fix for http://llvm.org/PR35373
#
# GCN: S_CBRANCH_SCC1 %bb.6, implicit undef $scc

--- |
  define amdgpu_ps void @regcoal-subrange-join-seg() local_unnamed_addr #0 {
    ret void
  }
...
---
name:            regcoal-subrange-join-seg
tracksRegLiveness: true
body:             |
  bb.0:
    S_CBRANCH_SCC1 %bb.6, implicit undef $scc
    S_BRANCH %bb.1

  bb.1:
    S_CBRANCH_SCC1 %bb.4, implicit undef $scc
    S_BRANCH %bb.2

  bb.2:
    S_CBRANCH_SCC1 %bb.4, implicit undef $scc
    S_BRANCH %bb.3

  bb.3:

  bb.4:
    successors: %bb.5, %bb.6

    S_CBRANCH_SCC1 %bb.6, implicit undef $scc
    S_BRANCH %bb.5

  bb.5:

  bb.6:
    S_CBRANCH_SCC1 %bb.14, implicit undef $scc
    S_BRANCH %bb.7

  bb.7:
    S_CBRANCH_SCC1 %bb.9, implicit undef $scc
    S_BRANCH %bb.8

  bb.8:

  bb.9:
    successors: %bb.10, %bb.13

    S_CBRANCH_SCC1 %bb.13, implicit undef $scc
    S_BRANCH %bb.10

  bb.10:
    S_CBRANCH_SCC1 %bb.12, implicit undef $scc
    S_BRANCH %bb.11

  bb.11:

  bb.12:

  bb.13:

  bb.14:
    S_CBRANCH_SCC1 %bb.26, implicit undef $scc
    S_BRANCH %bb.15

  bb.15:
    S_CBRANCH_SCC1 %bb.20, implicit undef $scc
    S_BRANCH %bb.16

  bb.16:
    successors: %bb.17, %bb.19

    S_CBRANCH_SCC1 %bb.19, implicit undef $scc
    S_BRANCH %bb.17

  bb.17:
    successors: %bb.18, %bb.19

    S_CBRANCH_SCC1 %bb.19, implicit undef $scc
    S_BRANCH %bb.18

  bb.18:

  bb.19:

  bb.20:
    S_CBRANCH_SCC1 %bb.25, implicit undef $scc
    S_BRANCH %bb.21

  bb.21:
    successors: %bb.22, %bb.24

    S_CBRANCH_SCC1 %bb.24, implicit undef $scc
    S_BRANCH %bb.22

  bb.22:
    successors: %bb.23, %bb.24

    S_CBRANCH_SCC1 %bb.24, implicit undef $scc
    S_BRANCH %bb.23

  bb.23:

  bb.24:

  bb.25:

  bb.26:
    S_CBRANCH_SCC1 %bb.35, implicit undef $scc
    S_BRANCH %bb.27

  bb.27:
    S_CBRANCH_SCC1 %bb.32, implicit undef $scc
    S_BRANCH %bb.28

  bb.28:
    %9:sreg_32_xm0 = S_FF1_I32_B32 undef %10:sreg_32_xm0
    %13:vgpr_32 = V_MAD_U32_U24_e64 %9, 48, 32, 0, implicit $exec
    %45:vgpr_32 = BUFFER_LOAD_DWORD_OFFEN %13, undef %15:sgpr_128, 0, 0, 0, 0, implicit $exec :: (dereferenceable invariant load (s32))
    %46:vgpr_32 = V_AND_B32_e32 1, %45, implicit $exec
    %21:sreg_32_xm0_xexec = S_BUFFER_LOAD_DWORD_SGPR undef %22:sgpr_128, undef %23:sreg_32_xm0, 0 :: (dereferenceable invariant load (s32))
    %25:sreg_64_xexec = nofpexcept V_CMP_GE_F32_e64 0, 0, 0, %21, 0, implicit $mode, implicit $exec
    %26:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, -1, %25, implicit $exec
    %62:vreg_128 = IMPLICIT_DEF

  bb.29:
    successors: %bb.30(0x30000000), %bb.36(0x50000000)

    %53:vreg_128 = COPY %62
    %47:vgpr_32 = V_ADD_CO_U32_e32 -1, %46, implicit-def dead $vcc, implicit $exec
    %48:vgpr_32 = V_OR_B32_e32 %47, %26, implicit $exec
    %49:vreg_128 = COPY %53
    %49.sub2 = COPY undef %48
    %51:vreg_128 = COPY %49
    %51.sub3 = COPY undef %26
    V_CMP_NE_U32_e32 0, %48, implicit-def $vcc, implicit $exec
    $vcc = S_AND_B64 $exec, killed $vcc, implicit-def dead $scc
    S_CBRANCH_VCCZ %bb.30, implicit killed $vcc

  bb.36:
    %63:vreg_128 = COPY %51
    S_BRANCH %bb.31

  bb.30:
    %33:vgpr_32 = nofpexcept V_MAD_F32_e64 1, %53.sub0, 0, undef %34:vgpr_32, 0, 0, 0, 0, implicit $mode, implicit $exec
    %35:vgpr_32 = nofpexcept V_MAC_F32_e32 %33, undef %36:vgpr_32, undef %35, implicit $mode, implicit $exec
    %38:vgpr_32 = nofpexcept V_MAX_F32_e32 0, %35, implicit $mode, implicit $exec
    %39:vgpr_32 = nofpexcept V_LOG_F32_e32 %38, implicit $mode, implicit $exec
    %40:vgpr_32 = nofpexcept V_MUL_F32_e32 %39, undef %41:vgpr_32, implicit $mode, implicit $exec
    %42:vgpr_32 = nofpexcept V_EXP_F32_e32 %40, implicit $mode, implicit $exec
    dead %43:vgpr_32 = nofpexcept V_MUL_F32_e32 %42, undef %44:vgpr_32, implicit $mode, implicit $exec
    %63 = COPY %51

  bb.31:
    %52:vreg_128 = COPY %63
    %62 = COPY %52
    S_BRANCH %bb.29

  bb.32:
    S_CBRANCH_SCC1 %bb.34, implicit undef $scc
    S_BRANCH %bb.33

  bb.33:

  bb.34:

  bb.35:
    S_ENDPGM 0

...
