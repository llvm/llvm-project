# RUN: llc -mtriple=amdgpu6.00 -run-pass si-fold-operands -o - %s | FileCheck %s

# CHECK: %1:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
# CHECK: %2:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
# CHECK: %4:vgpr_32 = COPY %3
# CHECK: %6:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
# CHECK: %7:vgpr_32 = COPY %3

---
name:            fold_cndmask
tracksRegLiveness: true
body:             |
  bb.0.entry:
    %0:sgpr_64 = IMPLICIT_DEF
    %1:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 0, %0, implicit $exec
    %2:vgpr_32 = V_CNDMASK_B32_e64 0, %1, 0, %1, %0, implicit $exec
    %3:vgpr_32 = IMPLICIT_DEF
    %4:vgpr_32 = V_CNDMASK_B32_e64 0, %3, 0, %3, %0, implicit $exec
    %5:vgpr_32 = COPY %1
    %6:vgpr_32 = V_CNDMASK_B32_e64 0, %5, 0, 0, %0, implicit $exec
    $vcc = IMPLICIT_DEF
    %7:vgpr_32 = V_CNDMASK_B32_e32 %3, %3, implicit $exec, implicit $vcc
    S_ENDPGM 0, implicit %1, implicit %2, implicit %4, implicit %6, implicit %7
...
