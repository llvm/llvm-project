; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -mtriple=amdgpu9.00-amd-amdhsa -passes=amdgpu-promote-alloca-to-vector,verify < %s | FileCheck %s

; Promoting these allocas to a floating-point vector forces a conversion between
; a pointer and a floating-point value or vector of the same size. A bitcast
; cannot convert between pointers and non-pointers, so the conversion must
; route through a pointer-sized integer via ptrtoint/inttoptr instead of
; producing e.g. `bitcast ptr to <2 x float>`.

target datalayout = "e-p:64:64-p5:32:32-A5"

define amdgpu_kernel void @struct_ptr_store(ptr %p, i1 %c, ptr %out) {
; CHECK-LABEL: define amdgpu_kernel void @struct_ptr_store(
; CHECK-SAME: ptr [[P:%.*]], i1 [[C:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = freeze <2 x float> poison
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[F:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i64 [[TMP0]] to <2 x float>
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[F]]:
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x float> [[A]], float 1.000000e+00, i32 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <2 x float> [[TMP2]], float 2.000000e+00, i32 1
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[PROMOTEALLOCA:%.*]] = phi <2 x float> [ [[TMP3]], %[[F]] ], [ [[TMP1]], %[[T]] ]
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <2 x float> [[PROMOTEALLOCA]], i32 0
; CHECK-NEXT:    store float [[TMP4]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a = alloca { float, float }, align 4, addrspace(5)
  br i1 %c, label %t, label %f

t:
  store ptr %p, ptr addrspace(5) %a, align 4
  br label %end

f:
  store float 1.0, ptr addrspace(5) %a, align 4
  %g = getelementptr inbounds i8, ptr addrspace(5) %a, i32 4
  store float 2.0, ptr addrspace(5) %g, align 4
  br label %end

end:
  %v = load float, ptr addrspace(5) %a, align 4
  store float %v, ptr %out, align 4
  ret void
}

define amdgpu_kernel void @float_vec_from_ptr(ptr %argp, ptr %out) {
; CHECK-LABEL: define amdgpu_kernel void @float_vec_from_ptr(
; CHECK-SAME: ptr [[ARGP:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = freeze <2 x float> poison
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint ptr [[ARGP]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i64 [[TMP0]] to <2 x float>
; CHECK-NEXT:    store <2 x float> [[TMP1]], ptr [[OUT]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %a = alloca [2 x float], align 8, addrspace(5)
  store ptr %argp, ptr addrspace(5) %a, align 8
  %v = load <2 x float>, ptr addrspace(5) %a, align 8
  store <2 x float> %v, ptr %out, align 8
  ret void
}

