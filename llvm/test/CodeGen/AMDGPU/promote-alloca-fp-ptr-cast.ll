; CHECK-SAME: <2 x ptr> [[ARGP:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = freeze <4 x double> poison
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint <2 x ptr> [[ARGP]] to <2 x i64>
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <2 x i64> [[TMP0]] to <2 x double>
; CHECK-NEXT:    [[TMP2:%.*]] = extractelement <2 x double> [[TMP1]], i64 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <4 x double> [[A]], double [[TMP2]], i32 2
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <2 x double> [[TMP1]], i64 1
; CHECK-NEXT:    [[TMP5:%.*]] = insertelement <4 x double> [[TMP3]], double [[TMP4]], i32 3
; CHECK-NEXT:    [[TMP6:%.*]] = insertelement <2 x double> poison, double [[TMP2]], i64 0
; CHECK-NEXT:    [[TMP7:%.*]] = insertelement <2 x double> [[TMP6]], double [[TMP4]], i64 1
; CHECK-NEXT:    [[TMP8:%.*]] = bitcast <2 x double> [[TMP7]] to <2 x i64>
; CHECK-NEXT:    [[TMP9:%.*]] = inttoptr <2 x i64> [[TMP8]] to <2 x ptr>
; CHECK-NEXT:    store <2 x ptr> [[TMP9]], ptr [[OUT]], align 16
