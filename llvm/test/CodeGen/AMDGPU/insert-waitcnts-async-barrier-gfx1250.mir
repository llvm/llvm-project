# RUN: llc -mtriple=amdgpu12.00 -run-pass si-insert-waitcnts -o - %s | FileCheck %s -check-prefix=GFX1200
# RUN: llc -mtriple=amdgpu12.50 -run-pass si-insert-waitcnts -o - %s | FileCheck %s -check-prefix=GFX1250

# Barriers do not drain ASYNCcnt (CDNA5 ISA), so gfx1250 barrier starts
# and S_BARRIER_WAIT must drain it when the function uses async transfers.

---
name:            async_before_full_barrier
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX1250-LABEL: name: async_before_full_barrier
    ; GFX1250: GLOBAL_LOAD_ASYNC_TO_LDS_B32
    ; GFX1250: S_WAIT_ASYNCCNT 0
    ; GFX1250: S_BARRIER

    ; GFX1200-LABEL: name: async_before_full_barrier
    ; GFX1200: GLOBAL_LOAD_ASYNC_TO_LDS_B32
    ; GFX1200-NOT: S_WAIT_ASYNCCNT
    ; GFX1200: S_BARRIER

    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def $asynccnt, implicit $exec, implicit $asynccnt
    S_BARRIER
...

---
name:            async_before_split_barrier
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2
    ; GFX1250-LABEL: name: async_before_split_barrier
    ; GFX1250: GLOBAL_LOAD_ASYNC_TO_LDS_B32
    ; GFX1250: S_WAIT_ASYNCCNT 0
    ; GFX1250: S_BARRIER_SIGNAL_IMM -1
    ; GFX1250: S_WAIT_ASYNCCNT 0
    ; GFX1250: S_BARRIER_WAIT -1

    ; GFX1200-LABEL: name: async_before_split_barrier
    ; GFX1200: GLOBAL_LOAD_ASYNC_TO_LDS_B32
    ; GFX1200-NOT: S_WAIT_ASYNCCNT
    ; GFX1200: S_BARRIER_WAIT -1

    GLOBAL_LOAD_ASYNC_TO_LDS_B32 $vgpr2, $vgpr0_vgpr1, 0, 0, implicit-def $asynccnt, implicit $exec, implicit $asynccnt
    S_BARRIER_SIGNAL_IMM -1
    S_BARRIER_WAIT -1
...

---
name:            no_async_no_drain
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; GFX1250-LABEL: name: no_async_no_drain
    ; GFX1250: V_ADD_F32_e32
    ; GFX1250-NOT: S_WAIT_ASYNCCNT
    ; GFX1250: S_BARRIER

    ; GFX1200-LABEL: name: no_async_no_drain
    ; GFX1200: V_ADD_F32_e32
    ; GFX1200-NOT: S_WAIT_ASYNCCNT
    ; GFX1200: S_BARRIER

    $vgpr2 = V_ADD_F32_e32 $vgpr0, $vgpr1, implicit $mode, implicit $exec
    S_BARRIER
...
