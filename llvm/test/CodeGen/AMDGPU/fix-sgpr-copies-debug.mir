# RUN: llc -mtriple=amdgpu6.00 -run-pass=si-fix-sgpr-copies %s -o - | FileCheck %s

--- |
  define void @hoist_m0_past_dbg_value_undef() !dbg !4 { ret void }
  define void @keep_unrelated_dbg_value() !dbg !8 { ret void }
  define void @do_not_move_past_only_debug() !dbg !12 { ret void }
  define void @debug_does_not_count_toward_limit() !dbg !16 { ret void }
  define void @keep_uncrossed_m0_dbg_value() !dbg !20 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "fix-sgpr-copies-debug.mir", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !DISubroutineType(types: !{})
  !4 = distinct !DISubprogram(name: "hoist_m0_past_dbg_value_undef", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !5)
  !5 = !{!6}
  !6 = !DILocalVariable(name: "m0", scope: !4, file: !1, line: 1, type: null)
  !7 = !DILocation(line: 1, column: 1, scope: !4)
  !8 = distinct !DISubprogram(name: "keep_unrelated_dbg_value", scope: !1, file: !1, line: 2, type: !3, scopeLine: 2, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !9)
  !9 = !{!10}
  !10 = !DILocalVariable(name: "vgpr0", scope: !8, file: !1, line: 2, type: null)
  !11 = !DILocation(line: 2, column: 1, scope: !8)
  !12 = distinct !DISubprogram(name: "do_not_move_past_only_debug", scope: !1, file: !1, line: 3, type: !3, scopeLine: 3, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !13)
  !13 = !{!14}
  !14 = !DILocalVariable(name: "old_m0", scope: !12, file: !1, line: 3, type: null)
  !15 = !DILocation(line: 3, column: 1, scope: !12)
  !16 = distinct !DISubprogram(name: "debug_does_not_count_toward_limit", scope: !1, file: !1, line: 4, type: !3, scopeLine: 4, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !17)
  !17 = !{!18}
  !18 = !DILocalVariable(name: "unused", scope: !16, file: !1, line: 4, type: null)
  !19 = !DILocation(line: 4, column: 1, scope: !16)
  !20 = distinct !DISubprogram(name: "keep_uncrossed_m0_dbg_value", scope: !1, file: !1, line: 5, type: !3, scopeLine: 5, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !21)
  !21 = !{!22}
  !22 = !DILocalVariable(name: "old_m0", scope: !20, file: !1, line: 5, type: null)
  !23 = !DILocation(line: 5, column: 1, scope: !20)
...
---
name: hoist_m0_past_dbg_value_undef
body: |
  bb.0:
    ; CHECK-LABEL: name: hoist_m0_past_dbg_value_undef
    ; CHECK: $m0 = S_MOV_B32 -1
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !{{[0-9]+}}, !DIExpression(), debug-location !{{.*}}
    ; CHECK-NEXT: DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    DBG_VALUE $m0, $noreg, !6, !DIExpression(), debug-location !7
    $m0 = S_MOV_B32 -1
    DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
...
---
name: keep_unrelated_dbg_value
body: |
  bb.0:
    ; CHECK-LABEL: name: keep_unrelated_dbg_value
    ; CHECK: $m0 = S_MOV_B32 -1
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: DBG_VALUE $vgpr0, $noreg, !{{[0-9]+}}, !DIExpression(), debug-location !{{.*}}
    ; CHECK-NEXT: DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    DBG_VALUE $vgpr0, $noreg, !10, !DIExpression(), debug-location !11
    $m0 = S_MOV_B32 -1
    DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
...
---
name: do_not_move_past_only_debug
body: |
  bb.0:
    ; CHECK-LABEL: name: do_not_move_past_only_debug
    ; CHECK: $m0 = S_MOV_B32 7
    ; CHECK-NEXT: DBG_VALUE $m0, $noreg, !{{[0-9]+}}, !DIExpression(), debug-location !{{.*}}
    ; CHECK-NEXT: $m0 = S_MOV_B32 -1
    ; CHECK-NEXT: DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
    $m0 = S_MOV_B32 7
    DBG_VALUE $m0, $noreg, !14, !DIExpression(), debug-location !15
    $m0 = S_MOV_B32 -1
    DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
...
---
name: debug_does_not_count_toward_limit
body: |
  bb.0:
    ; CHECK-LABEL: name: debug_does_not_count_toward_limit
    ; CHECK: $m0 = S_MOV_B32 -1
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    ; Keep at least Threshold debug records here so the unpatched scan stops.
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    DBG_VALUE $noreg, $noreg, !18, !DIExpression(), debug-location !19
    $m0 = S_MOV_B32 -1
    DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
...
---
name: keep_uncrossed_m0_dbg_value
body: |
  bb.0:
    ; CHECK-LABEL: name: keep_uncrossed_m0_dbg_value
    ; CHECK: $m0 = S_MOV_B32 7
    ; CHECK-NEXT: DBG_VALUE $m0, $noreg, !{{[0-9]+}}, !DIExpression(), debug-location !{{.*}}
    ; CHECK-NEXT: $m0 = S_MOV_B32 -1
    ; CHECK-NEXT: $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
    $m0 = S_MOV_B32 7
    DBG_VALUE $m0, $noreg, !22, !DIExpression(), debug-location !23
    $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    $m0 = S_MOV_B32 -1
    DS_GWS_INIT $vgpr0, 0, implicit $m0, implicit $exec
...
