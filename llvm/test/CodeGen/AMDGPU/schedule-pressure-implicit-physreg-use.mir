# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu6.01 -run-pass=machine-scheduler %s -o - | FileCheck %s

# PressureDiffs assume a single use of a physreg, so each implicit
# $vcc user counted as making it live. Make sure this doesn't fail the
# expensive checks pressure consistency check.

---
name: multiple_implicit_vcc_uses
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr16

    ; CHECK-LABEL: name: multiple_implicit_vcc_uses
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $sgpr16
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr_32 = COPY $sgpr16
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr2
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_CMP_NEQ_F32_e64_:%[0-9]+]]:sreg_64 = nofpexcept V_CMP_NEQ_F32_e64 0, 1065353216, 0, [[COPY]], 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: [[V_ADD_CO_U32_e64_:%[0-9]+]]:vgpr_32, dead [[V_ADD_CO_U32_e64_1:%[0-9]+]]:sreg_64 = V_ADD_CO_U32_e64 [[COPY1]], [[COPY1]], 0, implicit $exec
    ; CHECK-NEXT: [[V_ADD_CO_U32_e64_2:%[0-9]+]]:vgpr_32, dead [[V_ADD_CO_U32_e64_3:%[0-9]+]]:sreg_64 = V_ADD_CO_U32_e64 [[COPY2]], [[COPY2]], 0, implicit $exec
    ; CHECK-NEXT: [[V_ADD_CO_U32_e64_4:%[0-9]+]]:vgpr_32, dead [[V_ADD_CO_U32_e64_5:%[0-9]+]]:sreg_64 = V_ADD_CO_U32_e64 [[COPY3]], [[COPY3]], 0, implicit $exec
    ; CHECK-NEXT: $vcc = COPY [[V_CMP_NEQ_F32_e64_]]
    ; CHECK-NEXT: [[V_CNDMASK_B32_e32_:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e32 [[V_ADD_CO_U32_e64_4]], [[COPY3]], implicit $vcc, implicit $exec
    ; CHECK-NEXT: [[V_CNDMASK_B32_e32_1:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e32 [[V_ADD_CO_U32_e64_2]], [[COPY2]], implicit $vcc, implicit $exec
    ; CHECK-NEXT: [[V_CNDMASK_B32_e32_2:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e32 [[V_ADD_CO_U32_e64_]], [[COPY1]], implicit $vcc, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_CNDMASK_B32_e32_]]
    ; CHECK-NEXT: $vgpr1 = COPY [[V_CNDMASK_B32_e32_1]]
    ; CHECK-NEXT: $vgpr2 = COPY [[V_CNDMASK_B32_e32_2]]
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1, implicit $vgpr2
    %0:sgpr_32 = COPY $sgpr16
    %1:vgpr_32 = COPY $vgpr2
    %2:vgpr_32 = COPY $vgpr1
    %3:vgpr_32 = COPY $vgpr0
    %4:sreg_64 = nofpexcept V_CMP_NEQ_F32_e64 0, 1065353216, 0, %0, 0, implicit $mode, implicit $exec
    $vcc = COPY %4
    %5:vgpr_32, dead %6:sreg_64 = V_ADD_CO_U32_e64 %1, %1, 0, implicit $exec
    %7:vgpr_32, dead %8:sreg_64 = V_ADD_CO_U32_e64 %2, %2, 0, implicit $exec
    %9:vgpr_32, dead %10:sreg_64 = V_ADD_CO_U32_e64 %3, %3, 0, implicit $exec
    %11:vgpr_32 = V_CNDMASK_B32_e32 %9, %3, implicit $vcc, implicit $exec
    %12:vgpr_32 = V_CNDMASK_B32_e32 %7, %2, implicit $vcc, implicit $exec
    %13:vgpr_32 = V_CNDMASK_B32_e32 %5, %1, implicit $vcc, implicit $exec
    $vgpr0 = COPY %11
    $vgpr1 = COPY %12
    $vgpr2 = COPY %13
    SI_RETURN implicit $vgpr0, implicit $vgpr1, implicit $vgpr2
...
