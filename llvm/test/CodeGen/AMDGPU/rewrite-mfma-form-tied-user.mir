# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# The MFMA's result is read by a tied operand of a V_FMAC, which also writes a
# lane of it. The write pins the register to the VGPR bank, so the MFMA's def is
# redirected to a fresh AGPR and the old register has to be given back the value.
#
# Redirecting the read to a bridge copy instead rewrites only half of the tie and
# the result does not verify.

--- |
  define amdgpu_kernel void @tied_user() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            tied_user
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: tied_user
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %q0:vreg_128 = IMPLICIT_DEF
  ; CHECK-NEXT:   %q1:vreg_512 = IMPLICIT_DEF
  ; CHECK-NEXT:   %m0:vreg_64_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %e0:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %init:areg_512_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   SCHED_BARRIER 0
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   early-clobber %13:areg_512_align2 = V_MFMA_F32_32X32X8F16_e64 %m0, %m0, %init, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %acc:vreg_512_align2 = COPY %13
  ; CHECK-NEXT:   %acc.sub0:vreg_512_align2 = V_FMAC_F32_e32 %e0, %e0, %acc.sub0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit %acc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   KILL [[DEF]], %p1, %p2, %p3, %p4, %p5, %p6, %q0, %q1
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %q0:vreg_128 = IMPLICIT_DEF
    %q1:vreg_512 = IMPLICIT_DEF
    %m0:vreg_64_align2 = IMPLICIT_DEF
    %e0:vgpr_32 = IMPLICIT_DEF
    %init:vreg_512_align2 = IMPLICIT_DEF
    SCHED_BARRIER 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    %acc:vreg_512_align2 = V_MFMA_F32_32X32X8F16_vgprcd_e64 %m0, %m0, %init, 0, 0, 0, implicit $mode, implicit $exec
    %acc.sub0:vreg_512_align2 = V_FMAC_F32_e32 %e0, %e0, %acc.sub0, implicit $mode, implicit $exec
    S_NOP 0, implicit %acc
    S_BRANCH %bb.2

  bb.2:
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %q0, %q1
    S_ENDPGM 0
...
