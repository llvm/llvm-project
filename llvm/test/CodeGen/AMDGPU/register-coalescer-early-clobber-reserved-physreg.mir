# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=register-coalescer -verify-coalescing -o - %s | FileCheck %s

# When joinReservedPhysReg folds a copy of a virtual register into a reserved
# physical register, and the vreg's defining instruction has an early-clobber
# def, the new physreg dead def must be created at the early-clobber slot.
# Previously the interference check iterated by slot index using the def's slot,
# which for an early-clobber def caused it to walk past the copy and reject the
# join due to a later use of the physreg.

---
name: early_clobber_into_reserved_physreg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5

    ; CHECK-LABEL: name: early_clobber_into_reserved_physreg
    ; CHECK: liveins: $sgpr4_sgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr_64 = COPY $sgpr4_sgpr5
    ; CHECK-NEXT: early-clobber $flat_scr = S_LOAD_DWORDX2_IMM_ec [[COPY]], 36, 0
    ; CHECK-NEXT: S_ENDPGM 0, implicit $flat_scr
    %0:sgpr_64 = COPY $sgpr4_sgpr5
    early-clobber %1:sreg_64_xexec = S_LOAD_DWORDX2_IMM_ec %0, 36, 0
    $flat_scr = COPY %1
    S_ENDPGM 0, implicit $flat_scr
...
