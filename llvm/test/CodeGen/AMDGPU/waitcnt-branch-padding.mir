    $sgpr0 = S_ADD_U32 $sgpr0, 1, implicit-def dead $scc
    S_CMP_LT_U32 $sgpr0, 4, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.4:
    liveins: $exec

    WAIT_ASYNCMARK 0
    S_ENDPGM 0

  ; CHECK: bb.5:
  ; CHECK-NOT: S_MOV_B64
  ; CHECK: BUFFER_INV 0, implicit $exec
  ; CHECK-NEXT: S_BRANCH %bb.3
...

