    $sgpr0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK
    S_WAITCNT_lds_direct
    ; CHECK: ASYNCMARK
    ; CHECK: ASYNCMARK
    ; CHECK-NOT: BUFFER_INV
    ; CHECK: bb.1:

  bb.1:
    liveins: $exec, $m0, $sgpr0, $vgpr0_vgpr1

    S_BITCMP0_B32 $sgpr0, 0, implicit-def $scc
    $sgpr2_sgpr3 = S_CSELECT_B64 -1, 0, implicit $scc
    $sgpr4_sgpr5 = S_AND_SAVEEXEC_B64 killed $sgpr2_sgpr3, implicit-def $exec, implicit-def dead $scc, implicit $exec
    ; CHECK: S_CBRANCH_EXECZ %bb.5
    S_CBRANCH_EXECZ %bb.3, implicit $exec

  bb.2:
    liveins: $exec, $m0, $sgpr0, $sgpr4_sgpr5, $vgpr0_vgpr1

    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec

  bb.3:
    liveins: $exec, $m0, $sgpr0, $sgpr4_sgpr5, $vgpr0_vgpr1

    $exec = S_OR_B64 $exec, killed $sgpr4_sgpr5, implicit-def dead $scc
    ASYNCMARK
    ; CHECK: WAIT_ASYNCMARK 1
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    ; CHECK-NEXT: $sgpr0 = S_ADD_U32
    ; CHECK-NEXT: S_CMP_LT_U32
