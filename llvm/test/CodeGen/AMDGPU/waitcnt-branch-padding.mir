# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -mattr=-gfx940-insts -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefix=NO-GFX940 %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -amdgpu-waitcnt-branch-padding=true -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefix=FORCE-ENABLED %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -amdgpu-waitcnt-branch-padding=false -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefix=DISABLED %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefix=OTHER-GFX9 %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -verify-machineinstrs -passes=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -verify-machineinstrs -start-before=si-insert-waitcnts -stop-after=si-insert-waitcnts -o - %s | FileCheck %s
# RUN: llc -O0 -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -amdgpu-waitcnt-branch-padding=true -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefix=O0 %s
# RUN: llc -O0 -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -amdgpu-waitcnt-branch-padding=true -verify-machineinstrs -passes=si-insert-waitcnts -o - %s | FileCheck --check-prefix=O0 %s
# Cache PDT before the merged pass and verify its post-pass result contains the
# newly split block.
# RUN: llc -simplify-mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -passes='require<machine-post-dom-tree>,si-insert-waitcnts,print<machine-post-dom-tree>' -filetype=null %s 2>&1 | FileCheck --check-prefix=PDT %s

--- |
  define amdgpu_kernel void @pad_execz_edge_for_vmem() #0 { ret void }
  define amdgpu_kernel void @pad_ordinary_vmem_dependency() #0 { ret void }
  define amdgpu_kernel void @pad_execz_edge_for_second_vmem() #0 { ret void }
  define amdgpu_kernel void @pad_masked_else_execz_edge() #0 { ret void }
  define amdgpu_kernel void @share_buffer_inv_padding_suffix() #0 { ret void }
  define amdgpu_kernel void @share_equal_buffer_inv_padding_suffix() #0 { ret void }
  define amdgpu_kernel void @share_buffer_inv_padding_suffix_from_fallthrough() #0 { ret void }
  define amdgpu_kernel void @pad_active_edge_preserving_exec_and_scc() #0 { ret void }
  define amdgpu_kernel void @pad_direct_and_split_edges() #0 { ret void }
  define amdgpu_kernel void @pad_without_sgpr_resources() #0 { ret void }
  define amdgpu_kernel void @equal_arm_counts_need_no_padding() #0 { ret void }
  define amdgpu_kernel void @pad_after_common_wait() #0 { ret void }
  define amdgpu_kernel void @pad_inner_join_not_loop_header() #0 { ret void }
  define amdgpu_kernel void @pad_before_loop() #0 { ret void }
  define amdgpu_kernel void @padding_disabled_without_attribute() { ret void }
  define amdgpu_kernel void @padding_skipped_for_optnone() #1 { ret void }

  attributes #0 = { "amdgpu-waitcnt-branch-padding"="true" }
  attributes #1 = { noinline optnone "amdgpu-waitcnt-branch-padding"="true" }
...

---
name:            pad_execz_edge_for_vmem
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy:       8
body:             |
  ; CHECK-LABEL: name: pad_execz_edge_for_vmem
  ; O0-LABEL: name: pad_execz_edge_for_vmem
  ; O0-NOT: BUFFER_INV
  ; NO-GFX940-LABEL: name: pad_execz_edge_for_vmem
  ; DISABLED-LABEL: name: pad_execz_edge_for_vmem
  ; OTHER-GFX9-LABEL: name: pad_execz_edge_for_vmem
  ; PDT-LABEL: MachinePostDominatorTree for machine function: pad_execz_edge_for_vmem
  ; PDT: %bb.3
  bb.0:
    liveins: $exec, $m0, $sgpr0_sgpr1, $vgpr0_vgpr1

    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK
    $sgpr2_sgpr3 = S_AND_SAVEEXEC_B64 $sgpr0_sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    ; CHECK: S_CBRANCH_EXECZ %bb.3
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    liveins: $exec, $sgpr2_sgpr3, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec

  bb.2:
    liveins: $exec, $sgpr2_sgpr3

    $exec = S_OR_B64 $exec, killed $sgpr2_sgpr3, implicit-def dead $scc
    ; CHECK: WAIT_ASYNCMARK 0
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    ; O0: WAIT_ASYNCMARK 0
    ; O0-NEXT: S_WAITCNT .Vmcnt_0
    ; DISABLED-NOT: BUFFER_INV
    ; DISABLED: WAIT_ASYNCMARK 0
    ; DISABLED-NEXT: S_WAITCNT .Vmcnt_0
    ; NO-GFX940-NOT: BUFFER_INV
    ; NO-GFX940: WAIT_ASYNCMARK 0
    ; NO-GFX940-NEXT: S_WAITCNT .Vmcnt_0
    ; OTHER-GFX9-NOT: BUFFER_INV
    ; OTHER-GFX9: WAIT_ASYNCMARK 0
    ; OTHER-GFX9-NEXT: S_WAITCNT .Vmcnt_0
    WAIT_ASYNCMARK 0
    S_ENDPGM 0

  ; CHECK: bb.3:
  ; CHECK-NOT: S_MOV_B64
  ; CHECK: BUFFER_INV 0, implicit $exec
  ; CHECK-NEXT: S_BRANCH %bb.2
  ; O0-NOT: BUFFER_INV
...

---
name:            pad_ordinary_vmem_dependency
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy:       8
body:             |
  ; CHECK-LABEL: name: pad_ordinary_vmem_dependency
  ; O0-LABEL: name: pad_ordinary_vmem_dependency
  ; PDT-LABEL: MachinePostDominatorTree for machine function: pad_ordinary_vmem_dependency
  bb.0:
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    ; CHECK: S_CBRANCH_SCC1 %bb.3
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    liveins: $exec, $vgpr0_vgpr1

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec

  bb.2:
    liveins: $exec, $vgpr2

    ; CHECK: S_WAITCNT .Vmcnt_1
    ; CHECK-NEXT: $vgpr4 = V_MOV_B32_e32 $vgpr2
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0

  ; CHECK: bb.3:
  ; CHECK: BUFFER_INV 0, implicit $exec
  ; CHECK-NEXT: S_BRANCH %bb.2
...

---
name:            pad_execz_edge_for_second_vmem
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy:       8
body:             |
  ; CHECK-LABEL: name: pad_execz_edge_for_second_vmem
  ; DISABLED-LABEL: name: pad_execz_edge_for_second_vmem
  ; OTHER-GFX9-LABEL: name: pad_execz_edge_for_second_vmem
  bb.0:
    liveins: $exec, $m0, $sgpr0_sgpr1, $vgpr0_vgpr1

    S_NOP 0, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK
    $sgpr2_sgpr3 = S_AND_SAVEEXEC_B64 $sgpr0_sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    ; CHECK: S_CBRANCH_EXECZ %bb.3
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    liveins: $exec, $m0, $sgpr2_sgpr3, $vgpr0_vgpr1

    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec

  bb.2:
    liveins: $exec, $sgpr2_sgpr3

    $exec = S_OR_B64 $exec, killed $sgpr2_sgpr3, implicit-def dead $scc
    ; CHECK: WAIT_ASYNCMARK 0
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    WAIT_ASYNCMARK 0
    S_ENDPGM 0

  ; CHECK: bb.3:
  ; CHECK-NOT: S_MOV_B64
  ; CHECK: BUFFER_INV 0, implicit $exec
  ; CHECK-NEXT: S_BRANCH %bb.2
...

---
name:            pad_masked_else_execz_edge
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy:       8
body:             |
  ; CHECK-LABEL: name: pad_masked_else_execz_edge
  bb.0:
    liveins: $exec, $m0, $sgpr0_sgpr1, $vgpr0_vgpr1

    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec
    ASYNCMARK
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    liveins: $exec, $m0, $sgpr0_sgpr1, $vgpr0_vgpr1

    DS_WRITE_B32 $vgpr0, $vgpr1, 0, 0, implicit $m0, implicit $exec

  bb.2:
    liveins: $exec, $sgpr0_sgpr1, $vgpr0_vgpr1

    $sgpr0_sgpr1 = S_OR_SAVEEXEC_B64 killed $sgpr0_sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    $exec = S_XOR_B64 $exec, $sgpr0_sgpr1, implicit-def dead $scc
    ; CHECK: S_CBRANCH_EXECZ %bb.5
    S_CBRANCH_EXECZ %bb.4, implicit $exec

  bb.3:
    liveins: $exec, $sgpr0_sgpr1, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec

  bb.4:
    liveins: $exec, $sgpr0_sgpr1

    $exec = S_OR_B64 $exec, killed $sgpr0_sgpr1, implicit-def dead $scc
    ASYNCMARK
    ; CHECK: WAIT_ASYNCMARK 1
    ; CHECK-NEXT: S_WAITCNT .Vmcnt_1
    WAIT_ASYNCMARK 1
    S_ENDPGM 0

  ; CHECK: bb.5:
  ; CHECK-NOT: S_MOV_B64
  ; CHECK: BUFFER_INV 0, implicit $exec
  ; CHECK-NEXT: S_BRANCH %bb.4
...

