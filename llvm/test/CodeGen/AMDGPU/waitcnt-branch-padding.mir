    $sgpr2_sgpr3 = S_AND_SAVEEXEC_B64 $sgpr0_sgpr1, implicit-def $exec, implicit-def $scc, implicit $exec
    ; CHECK: S_CBRANCH_EXECZ %bb.3
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    liveins: $exec, $sgpr2_sgpr3, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec

  bb.2:
    liveins: $exec, $sgpr2_sgpr3

    $exec = S_OR_B64 $exec, killed $sgpr2_sgpr3, implicit-def dead $scc
    ; CHECK: WAIT_ASYNCMARK 0
    WAIT_ASYNCMARK 0
    S_ENDPGM 0

  ; CHECK: bb.3:
  ; CHECK: BUFFER_INV 0, implicit $exec
  ; CHECK-NEXT: S_BRANCH %bb.2
...

