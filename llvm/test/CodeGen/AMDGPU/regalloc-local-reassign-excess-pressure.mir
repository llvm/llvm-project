# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -passes=greedy,virt-reg-rewriter -o - %s | FileCheck %s --check-prefixes=CHECK,DEFAULT
# RUN: llc -mtriple=amdgpu12.50 -passes=greedy,virt-reg-rewriter -enable-local-reassign=true -o - %s | FileCheck %s --check-prefixes=CHECK,FORCE-ON

# The greedy allocator's local reassignment heuristic is expensive when the
# register file is full, so AMDGPU disables it for functions in which the
# scheduler found excess register pressure (hasExcessRegPressure). Both
# functions have the same body and differ only in hasExcessRegPressure.

---
name:            reassign_allowed
tracksRegLiveness: true
machineFunctionInfo:
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
  occupancy:       16
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3

    ; CHECK-LABEL: name: reassign_allowed
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $vgpr4_vgpr5 = V_MAD_NC_U64_U32_e64 $vgpr0, $vgpr2, $vgpr0_vgpr1, 0, implicit $exec
    ; CHECK-NEXT: renamable $vgpr1 = V_MAD_U32_e64 $vgpr1, killed $vgpr2, $vgpr5, implicit $exec
    ; CHECK-NEXT: renamable $vgpr1 = V_MAD_U32_e64 killed $vgpr0, killed $vgpr3, killed $vgpr1, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY killed renamable $vgpr4
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %11:vgpr_32 = COPY $vgpr3
    %10:vgpr_32 = COPY $vgpr2
    undef %26.sub1:vreg_64_align2 = COPY $vgpr1
    %26.sub0:vreg_64_align2 = COPY $vgpr0
    %16:vreg_64_align2 = V_MAD_NC_U64_U32_e64 %26.sub0, %10, %26, 0, implicit $exec
    %18:vgpr_32 = V_MAD_U32_e64 %26.sub1, %10, %16.sub1, implicit $exec
    %19:vgpr_32 = V_MAD_U32_e64 %26.sub0, %11, %18, implicit $exec
    $vgpr0 = COPY %16.sub0
    $vgpr1 = COPY %19
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
name:            reassign_disabled
tracksRegLiveness: true
machineFunctionInfo:
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
  occupancy:       16
  hasExcessRegPressure: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3

    ; DEFAULT-LABEL: name: reassign_disabled
    ; DEFAULT: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; DEFAULT-NEXT: {{  $}}
    ; DEFAULT-NEXT: renamable $vgpr4 = COPY $vgpr3
    ; DEFAULT-NEXT: renamable $vgpr5 = COPY $vgpr2
    ; DEFAULT-NEXT: renamable $vgpr2_vgpr3 = V_MAD_NC_U64_U32_e64 $vgpr0, $vgpr5, $vgpr0_vgpr1, 0, implicit $exec
    ; DEFAULT-NEXT: renamable $vgpr1 = V_MAD_U32_e64 $vgpr1, killed $vgpr5, $vgpr3, implicit $exec
    ; DEFAULT-NEXT: renamable $vgpr1 = V_MAD_U32_e64 killed $vgpr0, killed $vgpr4, killed $vgpr1, implicit $exec
    ; DEFAULT-NEXT: $vgpr0 = COPY killed renamable $vgpr2
    ; DEFAULT-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    ;
    ; FORCE-ON-LABEL: name: reassign_disabled
    ; FORCE-ON: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; FORCE-ON-NEXT: {{  $}}
    ; FORCE-ON-NEXT: renamable $vgpr4_vgpr5 = V_MAD_NC_U64_U32_e64 $vgpr0, $vgpr2, $vgpr0_vgpr1, 0, implicit $exec
    ; FORCE-ON-NEXT: renamable $vgpr1 = V_MAD_U32_e64 $vgpr1, killed $vgpr2, $vgpr5, implicit $exec
    ; FORCE-ON-NEXT: renamable $vgpr1 = V_MAD_U32_e64 killed $vgpr0, killed $vgpr3, killed $vgpr1, implicit $exec
    ; FORCE-ON-NEXT: $vgpr0 = COPY killed renamable $vgpr4
    ; FORCE-ON-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %11:vgpr_32 = COPY $vgpr3
    %10:vgpr_32 = COPY $vgpr2
    undef %26.sub1:vreg_64_align2 = COPY $vgpr1
    %26.sub0:vreg_64_align2 = COPY $vgpr0
    %16:vreg_64_align2 = V_MAD_NC_U64_U32_e64 %26.sub0, %10, %26, 0, implicit $exec
    %18:vgpr_32 = V_MAD_U32_e64 %26.sub1, %10, %16.sub1, implicit $exec
    %19:vgpr_32 = V_MAD_U32_e64 %26.sub0, %11, %18, implicit $exec
    $vgpr0 = COPY %16.sub0
    $vgpr1 = COPY %19
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
