; When an edge is unknown, AAAMDGPUMinAGPRAlloc stays pessimistic and emits no
; amdgpu-agpr-alloc attribute, so every function falls back to the default
; split instead of committing to an inconsistent one. Here the kernel reaches
; its callee through an unknown indirect call, and the leaves are externally
; callable (their full caller set is not known), so none of them are annotated.

; Leaf that would otherwise force ~64 AGPRs, but is only reachable indirectly.
;.
; CHECK: @fptr = global ptr null
;.
define void @leaf_agpr() {
; CHECK-LABEL: define void @leaf_agpr(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    call void asm sideeffect "
; CHECK-NEXT:    ret void
;
  call void asm sideeffect "; touch a63", "~{a63}"()
  ret void
}

; All-VGPR leaf, also only reachable indirectly.
define void @leaf_hivgpr(ptr %p) {
; CHECK-LABEL: define void @leaf_hivgpr(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[V:%.*]] = load volatile <128 x i32>, ptr [[P]], align 512
; CHECK-NEXT:    store volatile <128 x i32> [[V]], ptr [[P]], align 512
; CHECK-NEXT:    ret void
;
  %v = load volatile <128 x i32>, ptr %p
  store volatile <128 x i32> %v, ptr %p
  ret void
}

@fptr = global ptr null

define amdgpu_kernel void @k_indirect() #0 {
; CHECK-LABEL: define amdgpu_kernel void @k_indirect(
; CHECK-SAME: ) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[FN:%.*]] = load ptr, ptr @fptr, align 8
; CHECK-NEXT:    call void [[FN]]()
; CHECK-NEXT:    ret void
;
  %fn = load ptr, ptr @fptr
  call void %fn()
  ret void
}

