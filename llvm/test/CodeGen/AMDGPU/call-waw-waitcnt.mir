# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu9.00 -verify-machineinstrs -run-pass=si-insert-waitcnts %s -o - | FileCheck -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu9.00 -passes=si-insert-waitcnts %s -o - | FileCheck -check-prefix=GCN %s

# $sgpr30_64 will hold the return address. We need a waitcnt before SI_CALL so
# that the return address is not clobbered in the callee by the outstanding load.

--- |
  define amdgpu_kernel void @call_waw_waitcnt() #0 {
    %1 = call i32 @func()
    ret void
  }

  declare hidden i32 @func() #0

  attributes #0 = { nounwind }
...

---
name:            call_waw_waitcnt
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr4_64, $sgpr7, $sgpr0_128

    ; GCN-LABEL: name: call_waw_waitcnt
    ; GCN: liveins: $sgpr4_64, $sgpr7, $sgpr0_128
    ; GCN-NEXT: {{  $}}
    ; GCN-NEXT: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
    ; GCN-NEXT: $sgpr30_64 = S_LOAD_DWORDX2_IMM $sgpr4_64, 0, 0
    ; GCN-NEXT: $sgpr33 = S_MOV_B32 killed $sgpr7
    ; GCN-NEXT: $flat_scr_lo = S_ADD_U32 killed $sgpr4, $sgpr33, implicit-def $scc
    ; GCN-NEXT: $flat_scr_hi = S_ADDC_U32 killed $sgpr5, 0, implicit-def $scc, implicit killed $scc
    ; GCN-NEXT: BUNDLE implicit-def $sgpr4_64, implicit-def $sgpr4, implicit-def $sgpr5, implicit-def $scc {
    ; GCN-NEXT:   $sgpr4_64 = S_GETPC_B64
    ; GCN-NEXT:   $sgpr4 = S_ADD_U32 internal $sgpr4, target-flags(amdgpu-rel32-lo) @func + 4, implicit-def $scc
    ; GCN-NEXT:   $sgpr5 = S_ADDC_U32 internal $sgpr5, target-flags(amdgpu-rel32-hi) @func + 4, implicit-def $scc, implicit internal $scc
    ; GCN-NEXT: }
    ; GCN-NEXT: $sgpr32 = S_MOV_B32 $sgpr33
    ; GCN-NEXT: S_WAITCNT .Lgkmcnt_0
    ; GCN-NEXT: dead $sgpr30_64 = SI_CALL killed renamable $sgpr4_64, @func, csr_amdgpu, implicit $sgpr0_128, implicit-def dead $vgpr0
    ; GCN-NEXT: S_ENDPGM 0
    $sgpr30_64 = S_LOAD_DWORDX2_IMM $sgpr4_64, 0, 0
    $sgpr33 = S_MOV_B32 killed $sgpr7
    $flat_scr_lo = S_ADD_U32 killed $sgpr4, $sgpr33, implicit-def $scc
    $flat_scr_hi = S_ADDC_U32 killed $sgpr5, 0, implicit-def $scc, implicit killed $scc
    BUNDLE implicit-def $sgpr4_64, implicit-def $sgpr4, implicit-def $sgpr5, implicit-def $scc {
      $sgpr4_64 = S_GETPC_B64
      $sgpr4 = S_ADD_U32 internal $sgpr4, target-flags(amdgpu-rel32-lo) @func + 4, implicit-def $scc
      $sgpr5 = S_ADDC_U32 internal $sgpr5, target-flags(amdgpu-rel32-hi) @func + 4, implicit-def $scc, implicit internal $scc
    }
    $sgpr32 = S_MOV_B32 $sgpr33
    dead $sgpr30_64 = SI_CALL killed renamable $sgpr4_64, @func, csr_amdgpu, implicit $sgpr0_128, implicit-def dead $vgpr0
    S_ENDPGM 0
...
