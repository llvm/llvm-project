# CMP_CLASS is also a documented comparison producer.
# CHECK-LABEL: name: cmp_class_cndmask
# CHECK: V_CMP_CLASS_F32_e32
# CHECK-NEXT: V_CNDMASK_B32_e32
---
name: cmp_class_cndmask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    V_CMP_CLASS_F32_e32 $vgpr0, $vgpr1, implicit-def $vcc, implicit $exec
    $vgpr0 = V_CNDMASK_B32_e32 -1, $vgpr0, implicit $vcc, implicit $exec
...

# CMP_CLASS SDWA is also a documented comparison producer.
# CHECK-LABEL: name: cmp_class_sdwa_cndmask
# CHECK: V_CMP_CLASS_F32_sdwa
# CHECK-NEXT: V_CNDMASK_B32_e64
---
name: cmp_class_sdwa_cndmask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    $sgpr0_sgpr1 = V_CMP_CLASS_F32_sdwa 0, $vgpr0, 0, $vgpr1, 0, 6, 6, implicit-def $vcc, implicit $exec
    $vgpr0 = V_CNDMASK_B32_e64 0, -1, 0, $vgpr0, $sgpr0_sgpr1, implicit $exec
...

# An unlisted producer retains the wait even for a known condition input.
# CHECK-LABEL: name: mad_cndmask
# CHECK: V_MAD_U64_U32_e64
# CHECK-NEXT: S_NOP 1
# CHECK-NEXT: V_CNDMASK_B32_e32
---
name: mad_cndmask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    $vgpr4_vgpr5, $vcc = V_MAD_U64_U32_e64 $vgpr0, $vgpr1, $vgpr2_vgpr3, 0, implicit $exec
    $vgpr0 = V_CNDMASK_B32_e32 -1, $vgpr0, implicit $vcc, implicit $exec
...

# An unlisted producer also retains the wait for an explicit carry input.
# CHECK-LABEL: name: mad_addc
# CHECK: V_MAD_I64_I32_e64
# CHECK-NEXT: S_NOP 1
# CHECK-NEXT: V_ADDC_U32_e64
---
name: mad_addc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3
    $vgpr4_vgpr5, $sgpr0_sgpr1 = V_MAD_I64_I32_e64 $vgpr0, $vgpr1, $vgpr2_vgpr3, 0, implicit $exec
    $vgpr0, $vcc = V_ADDC_U32_e64 $vgpr0, $vgpr1, $sgpr0_sgpr1, 0, implicit $exec
...

# A documented producer also permits an explicit SGPR condition input.
# CHECK-LABEL: name: readfirstlane_cndmask
# CHECK: V_READFIRSTLANE_B32
# CHECK-NEXT: V_CNDMASK_B32_e64
---
name: readfirstlane_cndmask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $sgpr1
    $sgpr0 = V_READFIRSTLANE_B32 $vgpr0, implicit $exec
    $vgpr0 = V_CNDMASK_B32_e64 0, -1, 0, $vgpr0, $sgpr0_sgpr1, implicit $exec
...

# DIV_FMAS uses VCC implicitly, but is not a condition/carry input covered by
# the zero-wait rule. Preserve its separate four-state VCC hazard.
# CHECK-LABEL: name: cmp_div_fmas
# CHECK: V_CMP_NE_U64_e32
# CHECK-NEXT: S_NOP 3
# CHECK-NEXT: V_DIV_FMAS_F32_e64
---
name: cmp_div_fmas
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr1, $vgpr2_vgpr3
    V_CMP_NE_U64_e32 0, $vgpr2_vgpr3, implicit-def $vcc, implicit $exec
    $vgpr0 = V_DIV_FMAS_F32_e64 0, $vgpr1, 0, $vgpr2, 0, $vgpr3, 0, 0, implicit $mode, implicit $vcc, implicit $exec
...
