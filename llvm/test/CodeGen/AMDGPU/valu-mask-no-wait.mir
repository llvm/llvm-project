    V_CMP_NE_U64_e32 0, $vgpr2_vgpr3, implicit-def $vcc, implicit $exec
    $vgpr1 = V_CNDMASK_B32_dpp $vgpr1, 0, $vgpr0, 0, $vgpr1, 1, 15, 15, 1, implicit $vcc, implicit $exec
...

