# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -verify-machineinstrs -run-pass=post-RA-hazard-rec %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=post-RA-hazard-rec %s -o - | FileCheck %s

# CHECK-LABEL: name: cmp_cndmask
# CHECK: V_CMP_NE_U64_e32
# CHECK-NEXT: V_CNDMASK_B32_e32
---
name: cmp_cndmask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2_vgpr3
    V_CMP_NE_U64_e32 0, $vgpr2_vgpr3, implicit-def $vcc, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e32 -1, $vgpr2, implicit $vcc, implicit $exec
...

# CHECK-LABEL: name: add_addc
# CHECK: V_ADD_CO_U32_e32
# CHECK-NEXT: V_ADDC_U32_e32
---
name: add_addc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    $vgpr0 = V_ADD_CO_U32_e32 $vgpr0, $vgpr2, implicit-def $vcc, implicit $exec
    $vgpr1 = V_ADDC_U32_e32 0, $vgpr1, implicit-def $vcc, implicit $vcc, implicit $exec
...

# CHECK-LABEL: name: cmp_vcc_as_data
# CHECK: V_CMP_NE_U64_e32
# CHECK-NEXT: S_NOP 1
# CHECK-NEXT: V_MOV_B32_e32
---
name: cmp_vcc_as_data
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2_vgpr3
    V_CMP_NE_U64_e32 0, $vgpr2_vgpr3, implicit-def $vcc, implicit $exec
    $vgpr2 = V_MOV_B32_e32 $vcc_lo, implicit $exec
...

# CHECK-LABEL: name: readfirstlane_as_data
# CHECK: V_READFIRSTLANE_B32
# CHECK-NEXT: S_NOP 1
# CHECK-NEXT: V_MOV_B32_e32
---
name: readfirstlane_as_data
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    $sgpr0 = V_READFIRSTLANE_B32 $vgpr0, implicit $exec
    $vgpr1 = V_MOV_B32_e32 $sgpr0, implicit $exec
...

# CHECK-LABEL: name: cmp_cndmask_e64_sgpr
# CHECK: V_CMP_NE_U64_e64
# CHECK-NEXT: V_CNDMASK_B32_e64
---
name: cmp_cndmask_e64_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2_vgpr3
    $sgpr0_sgpr1 = V_CMP_NE_U64_e64 0, $vgpr2_vgpr3, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e64 0, -1, 0, $vgpr2, $sgpr0_sgpr1, implicit $exec
...

# CHECK-LABEL: name: cmp_cndmask_same_mask_as_data
# CHECK: V_CMP_NE_U64_e32
# CHECK-NEXT: S_NOP 1
# CHECK-NEXT: V_CNDMASK_B32_e32
---
name: cmp_cndmask_same_mask_as_data
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr2_vgpr3
    V_CMP_NE_U64_e32 0, $vgpr2_vgpr3, implicit-def $vcc, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e32 $vcc_lo, $vgpr2, implicit $vcc, implicit $exec
...

# CHECK-LABEL: name: cmp_addc_e64_sgpr
# CHECK: V_CMP_NE_U64_e64
# CHECK-NEXT: V_ADDC_U32_e64
---
name: cmp_addc_e64_sgpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr1, $vgpr2_vgpr3
    $sgpr0_sgpr1 = V_CMP_NE_U64_e64 0, $vgpr2_vgpr3, implicit $exec
    $vgpr1, $vcc = V_ADDC_U32_e64 0, $vgpr1, $sgpr0_sgpr1, 0, implicit $exec
...

