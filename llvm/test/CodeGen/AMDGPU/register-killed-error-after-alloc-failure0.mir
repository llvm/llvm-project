# RUN: not llc -mtriple=amdgpu9.00-amd-amdhsa -vgpr-regalloc=basic -sgpr-regalloc=basic -start-before=regallocbasic,0 -stop-after=virtregrewriter,2 -verify-regalloc -o - %s 2> %t.basic.err | FileCheck -check-prefix=BASIC %s
# RUN: not llc -mtriple=amdgpu9.00-amd-amdhsa -start-before=greedy,0 -stop-after=virtregrewriter,2 -verify-regalloc -o - %s 2> %t.greedy.err | FileCheck -check-prefix=GREEDY %s

# RUN: FileCheck -check-prefix=ERR -implicit-check-not=error %s < %t.basic.err
# RUN: FileCheck -check-prefix=ERR -implicit-check-not=error %s < %t.greedy.err

# This testcase must fail register allocation. It should also not
# produce a verifier error after doing so. Previously, it would not
# properly update the liveness for the dummy selected register. As a
# result, VirtRegRewriter would incorrectly add kill flags which
# combined with other uses of the physical register produced a
# verifier error.

# ERR: error: <unknown>:0:0: ran out of registers during register allocation

# GREEDY: SI_SPILL_V256_SAVE undef $vgpr0_256
# GREEDY-NEXT: SI_SPILL_V512_SAVE killed $vgpr4_512, %stack.1, $sgpr32, 0, implicit $exec :: (store (s512) into %stack.1, align 4, addrspace 5)
# GREEDY-NEXT: SI_SPILL_V128_SAVE killed $vgpr0_128

# GREEDY: $vgpr4_512 = SI_SPILL_V512_RESTORE
# GREEDY: $vgpr0_256 = SI_SPILL_V256_RESTORE
# GREEDY:  S_NOP 0, implicit killed renamable $vgpr4_512, implicit undef $vgpr0_256, implicit killed renamable $vgpr0_128
# GREEDY: S_NOP 0, implicit killed renamable $vgpr20_64


# BASIC: SI_SPILL_V512_SAVE killed $vgpr0_512
# BASIC: SI_SPILL_V256_SAVE killed $vgpr16_256
# BASIC: SI_SPILL_V128_SAVE undef $vgpr0_128
# BASIC: SI_SPILL_V64_SAVE killed $vgpr0_64
# BASIC: renamable $vgpr0_128 = SI_SPILL_V128_RESTORE
# BASIC: renamable $vgpr16_256 = SI_SPILL_V256_RESTORE
# BASIC: $vgpr0_512 = SI_SPILL_V512_RESTORE
# BASIC: S_NOP 0, implicit undef $vgpr0_512, implicit killed renamable $vgpr16_256, implicit killed renamable $vgpr0_128
# BASIC: renamable $vgpr0_64 = SI_SPILL_V64_RESTORE
# BASIC: S_NOP 0, implicit killed renamable $vgpr0_64

--- |
  define void @killed_reg_after_regalloc_failure() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-waves-per-eu"="10,10" }

...
---
name:            killed_reg_after_regalloc_failure
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_128'
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    S_NOP 0, implicit-def %0:vreg_512, implicit-def %1:vreg_256, implicit-def %2:vreg_128
    S_NOP 0, implicit-def %3:vreg_64
    S_NOP 0, implicit %0, implicit %1, implicit %2
    S_NOP 0, implicit %3
    S_ENDPGM 0

...
