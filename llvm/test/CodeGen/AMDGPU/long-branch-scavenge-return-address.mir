# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "S_(GETPC_B64|ADD_U32|ADDC_U32|SETPC_B64|MOV_B64)" --version 6
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -amdgpu-s-branch-bits=4 \
# RUN:   -passes=branch-relaxation %s -o - | FileCheck %s

# With no reserved scratch pair, branch relaxation scavenges a pair. Model
# a branch after the return address has been restored. The frame records that
# the pair was saved, so pristine-register tracking alone won't protect it, and
# the return does not expose its use to liveness tracking.
# FIXME: The scavenger currently chooses the restored return-address pair.
---
name: scavenge_after_return_address_restore
frameInfo:
  isCalleeSavedInfoValid: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8, callee-saved-register: '$sgpr30_sgpr31' }
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: scavenge_after_return_address_restore
  ; CHECK: bb.0:
  ; CHECK:   $sgpr30_sgpr31 = S_MOV_B64 killed $sgpr40_sgpr41
  ; CHECK: bb.3:
  ; CHECK:   $sgpr30_sgpr31 = S_GETPC_B64 post-instr-symbol <mcsymbol >
  ; CHECK-NEXT:   $sgpr30 = S_ADD_U32 $sgpr30, target-flags(<unknown target flag>) <mcsymbol >, implicit-def $scc
  ; CHECK-NEXT:   $sgpr31 = S_ADDC_U32 $sgpr31, target-flags(<unknown target flag>) <mcsymbol >, implicit-def $scc, implicit $scc
  ; CHECK-NEXT:   S_SETPC_B64 $sgpr30_sgpr31
  ; CHECK: bb.1:
  ; CHECK: bb.2:
  ; CHECK:   S_SETPC_B64_return undef $sgpr30_sgpr31
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, $sgpr12_sgpr13_sgpr14_sgpr15, $sgpr16_sgpr17_sgpr18_sgpr19, $sgpr20_sgpr21_sgpr22_sgpr23, $sgpr24_sgpr25_sgpr26_sgpr27, $sgpr28_sgpr29, $sgpr40_sgpr41
    $sgpr30_sgpr31 = S_MOV_B64 killed $sgpr40_sgpr41
    S_CMP_EQ_U32 $sgpr4, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit killed $scc

  bb.1:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, $sgpr12_sgpr13_sgpr14_sgpr15, $sgpr16_sgpr17_sgpr18_sgpr19, $sgpr20_sgpr21_sgpr22_sgpr23, $sgpr24_sgpr25_sgpr26_sgpr27, $sgpr28_sgpr29
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0
    S_NOP 0

  bb.2:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7, $sgpr8_sgpr9_sgpr10_sgpr11, $sgpr12_sgpr13_sgpr14_sgpr15, $sgpr16_sgpr17_sgpr18_sgpr19, $sgpr20_sgpr21_sgpr22_sgpr23, $sgpr24_sgpr25_sgpr26_sgpr27, $sgpr28_sgpr29
    S_NOP 0, implicit $sgpr0_sgpr1_sgpr2_sgpr3, implicit $sgpr4_sgpr5_sgpr6_sgpr7, implicit $sgpr8_sgpr9_sgpr10_sgpr11, implicit $sgpr12_sgpr13_sgpr14_sgpr15
    S_NOP 0, implicit $sgpr16_sgpr17_sgpr18_sgpr19, implicit $sgpr20_sgpr21_sgpr22_sgpr23, implicit $sgpr24_sgpr25_sgpr26_sgpr27, implicit $sgpr28_sgpr29
    S_SETPC_B64_return undef $sgpr30_sgpr31
...
