# Low SGPR pressure: only s0-s29 are clobbered. A free non-callee-saved pair
# exists both before and after RA, so the pair is reserved and later moved down
# to the lowest free non-callee-saved pair (s[40:41]). Without the fix it is
# moved to s[30:31], so the long branch overwrites the return address.

---
name:            low_sgpr_pressure
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_sgpr1_sgpr2_sgpr3'
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
  sgprForEXECCopy: '$sgpr100_sgpr101'
body:             |
  ; CHECK-LABEL: name: low_sgpr_pressure
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr16
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
  ; CHECK-NEXT:   S_CMP_LG_U32 killed $sgpr16, 0, implicit-def $scc
  ; CHECK-NEXT:   INLINEASM &"; clobber", sideeffect attdialect, clobber, implicit-def dead early-clobber $sgpr0, clobber, implicit-def dead early-clobber $sgpr1, clobber, implicit-def dead early-clobber $sgpr2, clobber, implicit-def dead early-clobber $sgpr3, clobber, implicit-def dead early-clobber $sgpr4, clobber, implicit-def dead early-clobber $sgpr5, clobber, implicit-def dead early-clobber $sgpr6, clobber, implicit-def dead early-clobber $sgpr7, clobber, implicit-def dead early-clobber $sgpr8, clobber, implicit-def dead early-clobber $sgpr9, clobber, implicit-def dead early-clobber $sgpr10, clobber, implicit-def dead early-clobber $sgpr11, clobber, implicit-def dead early-clobber $sgpr12, clobber, implicit-def dead early-clobber $sgpr13, clobber, implicit-def dead early-clobber $sgpr14, clobber, implicit-def dead early-clobber $sgpr15, clobber, implicit-def dead early-clobber $sgpr16, clobber, implicit-def dead early-clobber $sgpr17, clobber, implicit-def dead early-clobber $sgpr18, clobber, implicit-def dead early-clobber $sgpr19, clobber, implicit-def dead early-clobber $sgpr20, clobber, implicit-def dead early-clobber $sgpr21, clobber, implicit-def dead early-clobber $sgpr22, clobber, implicit-def dead early-clobber $sgpr23, clobber, implicit-def dead early-clobber $sgpr24, clobber, implicit-def dead early-clobber $sgpr25, clobber, implicit-def dead early-clobber $sgpr26, clobber, implicit-def dead early-clobber $sgpr27, clobber, implicit-def dead early-clobber $sgpr28, clobber, implicit-def dead early-clobber $sgpr29
  ; CHECK-NEXT:   S_CBRANCH_SCC0 %bb.1, implicit killed $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr40_sgpr41 = S_GETPC_B64 post-instr-symbol <mcsymbol >
  ; CHECK-NEXT:   $sgpr40 = S_ADD_U32 $sgpr40, target-flags(<unknown target flag>) <mcsymbol >, implicit-def $scc
  ; CHECK-NEXT:   $sgpr41 = S_ADDC_U32 $sgpr41, target-flags(<unknown target flag>) <mcsymbol >, implicit-def $scc, implicit $scc
  ; CHECK-NEXT:   S_SETPC_B64 $sgpr40_sgpr41
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   S_SETPC_B64_return undef $sgpr30_sgpr31
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
  ; CHECK-NEXT:   S_SETPC_B64_return undef $sgpr30_sgpr31
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr16

    S_CMP_LG_U32 killed $sgpr16, 0, implicit-def $scc
    INLINEASM &"; clobber", sideeffect attdialect, clobber, implicit-def dead early-clobber $sgpr0, clobber, implicit-def dead early-clobber $sgpr1, clobber, implicit-def dead early-clobber $sgpr2, clobber, implicit-def dead early-clobber $sgpr3, clobber, implicit-def dead early-clobber $sgpr4, clobber, implicit-def dead early-clobber $sgpr5, clobber, implicit-def dead early-clobber $sgpr6, clobber, implicit-def dead early-clobber $sgpr7, clobber, implicit-def dead early-clobber $sgpr8, clobber, implicit-def dead early-clobber $sgpr9, clobber, implicit-def dead early-clobber $sgpr10, clobber, implicit-def dead early-clobber $sgpr11, clobber, implicit-def dead early-clobber $sgpr12, clobber, implicit-def dead early-clobber $sgpr13, clobber, implicit-def dead early-clobber $sgpr14, clobber, implicit-def dead early-clobber $sgpr15, clobber, implicit-def dead early-clobber $sgpr16, clobber, implicit-def dead early-clobber $sgpr17, clobber, implicit-def dead early-clobber $sgpr18, clobber, implicit-def dead early-clobber $sgpr19, clobber, implicit-def dead early-clobber $sgpr20, clobber, implicit-def dead early-clobber $sgpr21, clobber, implicit-def dead early-clobber $sgpr22, clobber, implicit-def dead early-clobber $sgpr23, clobber, implicit-def dead early-clobber $sgpr24, clobber, implicit-def dead early-clobber $sgpr25, clobber, implicit-def dead early-clobber $sgpr26, clobber, implicit-def dead early-clobber $sgpr27, clobber, implicit-def dead early-clobber $sgpr28, clobber, implicit-def dead early-clobber $sgpr29
    S_CBRANCH_SCC1 %bb.2, implicit killed $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect
    INLINEASM &"v_nop_e64\0A  v_nop_e64\0A  v_nop_e64\0A  v_nop_e64", sideeffect attdialect

  bb.3:
    SI_RETURN
...
