; CHECK-NEXT:    ALU 5, @8, KC0[CB0:0-32], KC1[]
; CHECK-NEXT:    TEX 0 @6
; CHECK-NEXT:    ALU 2, @14, KC0[CB0:0-32], KC1[]
; CHECK-NEXT:    MEM_RAT_CACHELESS STORE_RAW T0.X, T1.X, 1
; CHECK-NEXT:    CF_END
; CHECK-NEXT:    PAD
; CHECK-NEXT:    Fetch clause starting at 6:
; CHECK-NEXT:     VTX_READ_32 T0.X, T0.X, 0, #1
; CHECK-NEXT:    ALU clause starting at 8:
; CHECK-NEXT:     MOV T0.X, KC0[2].Z,
; CHECK-NEXT:     LSHL * T0.W, KC0[2].W, literal.x,
; CHECK-NEXT:    2(2.802597e-45), 0(0.000000e+00)
; CHECK-NEXT:     LDS_READ_RET * OQAP, T0.W
; CHECK-NEXT:     MOV * T0.Y, OQAP,
; CHECK-NEXT:     GROUP_BARRIER
; CHECK-NEXT:    ALU clause starting at 14:
; CHECK-NEXT:     ADD_INT T0.X, T0.Y, T0.X,
; CHECK-NEXT:     LSHR * T1.X, KC0[2].Y, literal.x,
; CHECK-NEXT:    2(2.802597e-45), 0(0.000000e+00)
entry:
  %0 = getelementptr inbounds [2 x i32], ptr addrspace(3) @local_mem, i32 0, i32 %index
  %1 = load i32, ptr addrspace(3) %0
  call void @llvm.r600.group.barrier()

  ; This will start a new clause for the vertex fetch
  %2 = load i32, ptr addrspace(1) %in
  %3 = add i32 %1, %2
  store i32 %3, ptr addrspace(1) %out
  ret void
