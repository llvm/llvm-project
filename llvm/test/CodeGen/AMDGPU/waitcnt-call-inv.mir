# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefixes=GCN,INV %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefixes=GCN,INV %s
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefixes=GCN,NOINV %s
# RUN: llc -mtriple=amdgpu10.10-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefixes=GCN,NOINV %s
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefixes=GCN,NOINV %s

# A callee can leave BUFFER_INV events outstanding. With a new load after the
# call, vmcnt(1) cannot be removed based on a presumed empty incoming counter.
---
name: call_then_load_soft_wait
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr40_vgpr41

    ; GCN-LABEL: name: call_then_load_soft_wait
    ; GCN: dead $sgpr30_sgpr31 = SI_CALL $sgpr0_sgpr1, 0, csr_amdgpu
    ; GCN-NEXT: $vgpr2 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    ; INV-NEXT: S_WAITCNT .Vmcnt_1
    ; INV-NEXT: S_NOP 0
    ; NOINV-NEXT: S_NOP 0
    ; GCN-NEXT: S_ENDPGM 0
    dead $sgpr30_sgpr31 = SI_CALL $sgpr0_sgpr1, 0, csr_amdgpu
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    S_WAITCNT_soft .Vmcnt_1
    S_NOP 0
    S_ENDPGM 0
...

# The only possible pending VM events after this call are INV events. They do
# not require a soft wait or a wait at return.
---
name: call_inv_only_return
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $sgpr34_sgpr35

    ; GCN-LABEL: name: call_inv_only_return
    ; GCN: dead $sgpr30_sgpr31 = SI_CALL $sgpr0_sgpr1, 0, csr_amdgpu
    ; GCN-NEXT: S_SETPC_B64_return $sgpr34_sgpr35
    dead $sgpr30_sgpr31 = SI_CALL $sgpr0_sgpr1, 0, csr_amdgpu
    S_WAITCNT_soft 0
    S_SETPC_B64_return $sgpr34_sgpr35
...

# Pre-call loads are drained by the callee. Its unknown INV events do not
# change the relative ages of loads issued after the call.
---
name: call_retires_pre_call_loads
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr40_vgpr41

    ; GCN-LABEL: name: call_retires_pre_call_loads
    ; GCN: $vgpr42 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    ; GCN-NEXT: dead $sgpr30_sgpr31 = SI_CALL $sgpr0_sgpr1, 0, csr_amdgpu
    ; GCN-NEXT: $vgpr2 = V_MOV_B32_e32 $vgpr42, implicit $exec
    ; GCN-NEXT: $vgpr0 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    ; GCN-NEXT: $vgpr1 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    ; GCN-NEXT: S_WAITCNT .Vmcnt_1
    ; GCN-NEXT: $vgpr2 = V_MOV_B32_e32 $vgpr0, implicit $exec
    ; GCN-NEXT: S_ENDPGM 0
    $vgpr42 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    dead $sgpr30_sgpr31 = SI_CALL $sgpr0_sgpr1, 0, csr_amdgpu
    $vgpr2 = V_MOV_B32_e32 $vgpr42, implicit $exec
    $vgpr0 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    $vgpr1 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    $vgpr2 = V_MOV_B32_e32 $vgpr0, implicit $exec
    S_ENDPGM 0
...

# The unknown state is reinitialized at each call in the loop, and the block
# analysis must converge while retaining the post-call wait.
---
name: call_inv_loop
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $vgpr40_vgpr41
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vgpr40_vgpr41

    ; GCN-LABEL: name: call_inv_loop
    ; GCN: dead $sgpr30_sgpr31 = SI_CALL undef $sgpr0_sgpr1, 0, csr_amdgpu
    ; GCN-NEXT: $vgpr2 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    ; INV-NEXT: S_WAITCNT .Vmcnt_1
    ; GCN-NEXT: S_CBRANCH_EXECNZ %bb.1, implicit $exec
    dead $sgpr30_sgpr31 = SI_CALL undef $sgpr0_sgpr1, 0, csr_amdgpu
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr40_vgpr41, 0, 0, implicit $exec
    S_WAITCNT_soft .Vmcnt_1
    S_CBRANCH_EXECNZ %bb.1, implicit $exec

  bb.2:
    S_ENDPGM 0
...
