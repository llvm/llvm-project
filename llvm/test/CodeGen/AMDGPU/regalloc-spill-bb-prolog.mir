# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=greedy -stress-regalloc=3 -verify-regalloc -verify-machineinstrs -o - %s | FileCheck %s

# %0 is defined and used inside the block prolog and spilled around the clobber.
# The spill stays right after the def, ahead of the reload: it cannot move to
# the end of the prolog.

---
name: spill_in_bb_prolog
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg:    '$sgpr96_sgpr97_sgpr98_sgpr99'
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1
    ; CHECK-LABEL: name: spill_in_bb_prolog
    ; CHECK: liveins: $vgpr0, $sgpr0_sgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = bb-prolog V_ADD_U32_e32 $vgpr0, $vgpr0, implicit $exec
    ; CHECK-NEXT: bb-prolog SI_SPILL_V32_SAVE [[V_ADD_U32_e32_]], %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: bb-prolog KILL implicit-def $vgpr0, implicit-def $vgpr1, implicit-def $vgpr2
    ; CHECK-NEXT: [[SI_SPILL_V32_RESTORE:%[0-9]+]]:vgpr_32 = bb-prolog SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: bb-prolog S_NOP 0, implicit [[SI_SPILL_V32_RESTORE]]
    ; CHECK-NEXT: $exec = bb-prolog S_AND_B64 $exec, $sgpr0_sgpr1, implicit-def $scc
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = bb-prolog V_ADD_U32_e32 $vgpr0, $vgpr0, implicit $exec
    bb-prolog KILL implicit-def $vgpr0, implicit-def $vgpr1, implicit-def $vgpr2
    bb-prolog S_NOP 0, implicit %0
    $exec = bb-prolog S_AND_B64 $exec, killed $sgpr0_sgpr1, implicit-def $scc
    S_ENDPGM 0
...
