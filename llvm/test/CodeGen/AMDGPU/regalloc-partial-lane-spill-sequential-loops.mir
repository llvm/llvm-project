--- |
  define void @sequential_partial_spill(i1 %enter1, i1 %c1, i1 %back1, i1 %c2) {
  entry:
    br i1 %enter1, label %loop1.header, label %bridge

  loop1.header:
    br label %loop1.body

  loop1.body:
    br i1 %c1, label %loop1.body, label %loop1.latch

  loop1.latch:
    br i1 %back1, label %loop1.header, label %bridge

  bridge:
    br label %loop2.preheader

  loop2.preheader:
    br label %loop2

  loop2:
    br i1 %c2, label %loop2, label %exit

  exit:
    ret void
  }
...
