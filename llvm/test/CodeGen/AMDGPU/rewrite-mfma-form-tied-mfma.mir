# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# The _mac_ MFMAs tie vdst to src2, so the two share one register. The rewrite
# is keyed by register rather than by operand, so both ends of the tie get the
# same decision and the tie survives.
#
# tied_mac_recolor: the register is free to move to the AGPR bank, so it just
# changes class.
# tied_mac_bridge: a VGPR-only write pins it, so it is bridged in and out -- one
# copy per end, with the tie still pointing at the same register.
# tied_src2_def: src2 comes from a tied V_FMAC. Bridging a reaching def only
# adds a copy after it, so the tied instruction is left alone.

--- |
  define amdgpu_kernel void @tied_mac_recolor() #0 { ret void }
  define amdgpu_kernel void @tied_mac_bridge() #0 { ret void }
  define amdgpu_kernel void @tied_src2_def() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            tied_mac_recolor
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: tied_mac_recolor
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %p0:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %q0:vreg_128 = IMPLICIT_DEF
  ; CHECK-NEXT:   %q1:vreg_512 = IMPLICIT_DEF
  ; CHECK-NEXT:   %m0:vreg_64_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   dead %e0:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   SCHED_BARRIER 0
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %acc:areg_512_align2 = IMPLICIT_DEF
  ; CHECK-NEXT:   %acc:areg_512_align2 = V_MFMA_F32_32X32X8F16_mac_e64 %m0, %m0, %acc, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit %acc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %q0, %q1
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %q0:vreg_128 = IMPLICIT_DEF
    %q1:vreg_512 = IMPLICIT_DEF
    %m0:vreg_64_align2 = IMPLICIT_DEF
    %e0:vgpr_32 = IMPLICIT_DEF
    SCHED_BARRIER 0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    %acc:vreg_512_align2 = IMPLICIT_DEF
    %acc:vreg_512_align2 = V_MFMA_F32_32X32X8F16_mac_vgprcd_e64 %m0, %m0, %acc, 0, 0, 0, implicit $mode, implicit $exec
    S_NOP 0, implicit %acc
    S_BRANCH %bb.2

  bb.2:
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %q0, %q1
    S_ENDPGM 0
...

