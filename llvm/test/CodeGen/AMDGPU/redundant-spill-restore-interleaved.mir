# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu7.00-amd-amdhsa -passes='greedy<sgpr>' \
# RUN:   -stress-regalloc=3 -o - %s | FileCheck %s

# Greedy spills %5 first and %3 later. The restore of %5 before the update of
# %3 is inserted first, so it ends up between the save and the restore of the
# initial %3. Both pieces of %3 are assigned the same SGPR, so the restore is
# forwarded across the unrelated restore, and the initial save becomes dead.
# The input contains no stack accesses.
--- |
  define void @interleaved_restore() { ret void }
...
---
name: interleaved_restore
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr48, $sgpr49
    ; CHECK-LABEL: name: interleaved_restore
    ; CHECK: liveins: $sgpr48, $sgpr49
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[S_ADD_I32_:%[0-9]+]]:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: [[S_ADD_I32_1:%[0-9]+]]:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: [[S_ADD_I32_2:%[0-9]+]]:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE [[S_ADD_I32_2]], %stack.0, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.0, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_3:%[0-9]+]]:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: [[S_ADD_I32_1:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_1]], 1, implicit-def dead $scc
    ; CHECK-NEXT: [[S_ADD_I32_3:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_3]], 1, implicit-def dead $scc
    ; CHECK-NEXT: [[S_ADD_I32_3:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_3]], 1, implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE [[S_ADD_I32_3]], %stack.2, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.2, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_1:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_1]], 1, implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE [[S_ADD_I32_1]], %stack.3, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.3, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_4:%[0-9]+]]:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    ; CHECK-NEXT: [[SI_SPILL_S32_RESTORE:%[0-9]+]]:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr_32 = COPY [[S_ADD_I32_4]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[COPY]], [[SI_SPILL_S32_RESTORE]], implicit-def dead $scc
    ; CHECK-NEXT: SI_SPILL_S32_SAVE [[COPY]], %stack.1, implicit $exec, implicit $sp_reg :: (store (s32) into %stack.1, addrspace 5)
    ; CHECK-NEXT: [[SI_SPILL_S32_RESTORE1:%[0-9]+]]:sgpr_32 = SI_SPILL_S32_RESTORE %stack.3, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.3, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_]], [[SI_SPILL_S32_RESTORE1]], implicit-def dead $scc
    ; CHECK-NEXT: [[SI_SPILL_S32_RESTORE2:%[0-9]+]]:sgpr_32 = SI_SPILL_S32_RESTORE %stack.2, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.2, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_]], [[SI_SPILL_S32_RESTORE2]], implicit-def dead $scc
    ; CHECK-NEXT: [[SI_SPILL_S32_RESTORE3:%[0-9]+]]:sgpr_32 = SI_SPILL_S32_RESTORE %stack.1, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.1, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_]], [[SI_SPILL_S32_RESTORE3]], implicit-def dead $scc
    ; CHECK-NEXT: [[SI_SPILL_S32_RESTORE4:%[0-9]+]]:sgpr_32 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sp_reg :: (load (s32) from %stack.0, addrspace 5)
    ; CHECK-NEXT: [[S_ADD_I32_:%[0-9]+]]:sgpr_32 = S_ADD_I32 [[S_ADD_I32_]], [[SI_SPILL_S32_RESTORE4]], implicit-def dead $scc
    ; CHECK-NEXT: $sgpr0 = COPY [[S_ADD_I32_]]
    ; CHECK-NEXT: SI_RETURN implicit $sgpr0
    %0:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    %1:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    %5:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    %2:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    %1:sgpr_32 = S_ADD_I32 %1, 1, implicit-def dead $scc
    %2:sgpr_32 = S_ADD_I32 %2, 1, implicit-def dead $scc
    %2:sgpr_32 = S_ADD_I32 %2, 1, implicit-def dead $scc
    %1:sgpr_32 = S_ADD_I32 %1, 1, implicit-def dead $scc
    %3:sgpr_32 = S_ADD_I32 $sgpr48, $sgpr49, implicit-def dead $scc
    %3:sgpr_32 = S_ADD_I32 %3, %5, implicit-def dead $scc
    %0:sgpr_32 = S_ADD_I32 %0, %1, implicit-def dead $scc
    %0:sgpr_32 = S_ADD_I32 %0, %2, implicit-def dead $scc
    %0:sgpr_32 = S_ADD_I32 %0, %3, implicit-def dead $scc
    %0:sgpr_32 = S_ADD_I32 %0, %5, implicit-def dead $scc
    $sgpr0 = COPY %0
    SI_RETURN implicit $sgpr0
...
