# GFX942-NEXT: global_atomic_add_f32 a1, v0, a2, s[0:1] sc0 sc1 ; encoding: [0x00,0x80,0x35,0xdf,0x00,0x02,0x80,0x01]
# GFX942-NEXT: global_atomic_pk_add_f16 a1, v[0:1], a2, off sc0 ; encoding: [0x00,0x80,0x39,0xdd,0x00,0x02,0xff,0x01]
# GFX942-NEXT: global_atomic_pk_add_f16 a1, v0, a2, s[0:1] sc0 ; encoding: [0x00,0x80,0x39,0xdd,0x00,0x02,0x80,0x01]
# GFX942-NEXT: global_atomic_pk_add_f16 a1, v[0:1], a2, off sc0 sc1 ; encoding: [0x00,0x80,0x39,0xdf,0x00,0x02,0xff,0x01]
# GFX942-NEXT: global_atomic_pk_add_f16 a1, v0, a2, s[0:1] sc0 sc1 ; encoding: [0x00,0x80,0x39,0xdf,0x00,0x02,0x80,0x01]
# GFX942-NEXT: s_endpgm ; encoding: [0x00,0x00,0x81,0xbf]
---
name: f32_rtn_agpr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $agpr2, $sgpr0_sgpr1
    $agpr1 = GLOBAL_ATOMIC_ADD_F32_RTN_agpr $vgpr0_vgpr1, $agpr2, 0, 1, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_ADD_F32_SADDR_RTN_agpr $vgpr0, $agpr2, $sgpr0_sgpr1, 0, 1, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_ADD_F32_RTN_agpr $vgpr0_vgpr1, $agpr2, 0, 17, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_ADD_F32_SADDR_RTN_agpr $vgpr0, $agpr2, $sgpr0_sgpr1, 0, 17, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_PK_ADD_F16_RTN_agpr $vgpr0_vgpr1, $agpr2, 0, 1, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_PK_ADD_F16_SADDR_RTN_agpr $vgpr0, $agpr2, $sgpr0_sgpr1, 0, 1, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_PK_ADD_F16_RTN_agpr $vgpr0_vgpr1, $agpr2, 0, 17, implicit $exec
    $agpr1 = GLOBAL_ATOMIC_PK_ADD_F16_SADDR_RTN_agpr $vgpr0, $agpr2, $sgpr0_sgpr1, 0, 17, implicit $exec
    S_ENDPGM 0
...
