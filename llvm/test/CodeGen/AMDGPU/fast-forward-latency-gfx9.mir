name: vopc_sdwa_to_cndmask_e64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    $sgpr0_sgpr1 = V_CMP_EQ_U32_sdwa 0, $vgpr0, 0, $vgpr1, 0, 6, 6, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e64 0, $vgpr3, 0, $vgpr4, $sgpr0_sgpr1, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

# CHECK-LABEL: # Machine code for function vopc_e32_to_cndmask_dpp:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_dpp
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# CHECK:          SU(0): Data Latency=0 Reg=$vcc{{$}}
---
name: vopc_e32_to_cndmask_dpp
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4
    V_CMP_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $vcc, implicit $exec
    $vgpr2 = V_CNDMASK_B32_dpp $vgpr2, 0, $vgpr3, 0, $vgpr4, 1, 15, 15, 1, implicit $vcc, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

