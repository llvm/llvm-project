    liveins: $vgpr0, $vgpr1, $vgpr2, $scc

  bb.1:
    liveins: $vgpr0, $vgpr1, $vgpr2, $scc
    $vgpr3 = V_BFE_U32_e64 $vgpr0, 8, 8, implicit $exec
    $vgpr4 = V_ADD_U32_e32 $vgpr1, $vgpr3, implicit $exec
    $vgpr5 = V_XOR_B32_e32 $vgpr2, $vgpr4, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr1, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
    $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
