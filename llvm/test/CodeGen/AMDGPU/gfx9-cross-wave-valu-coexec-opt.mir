  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $scc
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GCN-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2, $scc
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   $vgpr3 = V_BFE_U32_e64 $vgpr0, 8, 8, implicit $exec
  ; GCN-NEXT:   S_NOP 0
  ; GCN-NEXT:   $vgpr4 = V_ADD_U32_e32 $vgpr1, $vgpr3, implicit $exec
  ; GCN-NEXT:   $vgpr5 = V_XOR_B32_e32 $vgpr2, $vgpr4, implicit $exec
  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr1, implicit $exec
  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
