  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; GCN-NEXT:   $vgpr20 = V_ADD_U32_e32 1, $vgpr20, implicit $exec
  ; GCN-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.2:
  ; GCN-NEXT:   liveins: $vgpr5, $vgpr20
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   S_ENDPGM 0, implicit $vgpr5, implicit $vgpr20
