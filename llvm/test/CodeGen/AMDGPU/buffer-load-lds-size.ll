; RUN: llc -mtriple=amdgpu9.00 -show-mc-encoding < %s | FileCheck %s

; The swz/IsAsync fields of LDS-DMA buffer loads are packed into the instruction
; word, so getInstSizeInBytes must not count them as a trailing literal. The
; estimated code size (codeLenInByte) sums getInstSizeInBytes over the function;
; each load contributes 8 bytes, not 12.

declare void @llvm.amdgcn.raw.ptr.buffer.load.lds(ptr addrspace(8), ptr addrspace(3) nocapture, i32, i32, i32, i32, i32)

define amdgpu_ps void @buffer_load_lds_dword_offen(ptr addrspace(8) inreg %rsrc, ptr addrspace(3) inreg %lds) {
; CHECK-LABEL: buffer_load_lds_dword_offen:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    v_mov_b32_e32 v0, 0x800 ; encoding: [0xff,0x02,0x00,0x7e,0x00,0x08,0x00,0x00]
; CHECK-NEXT:    s_mov_b32 m0, s4 ; encoding: [0x04,0x00,0xfc,0xbe]
; CHECK-NEXT:    s_nop 0 ; encoding: [0x00,0x00,0x80,0xbf]
; CHECK-NEXT:    buffer_load_dword v0, s[0:3], 0 offen lds ; encoding: [0x00,0x10,0x51,0xe0,0x00,0x00,0x00,0x80]
; CHECK-NEXT:    s_endpgm ; encoding: [0x00,0x00,0x81,0xbf]
  call void @llvm.amdgcn.raw.ptr.buffer.load.lds(ptr addrspace(8) %rsrc, ptr addrspace(3) %lds, i32 4, i32 2048, i32 0, i32 0, i32 0)
  ret void
}
; CHECK: codeLenInByte = 28

define amdgpu_ps void @buffer_load_lds_dword_offset(ptr addrspace(8) inreg %rsrc, ptr addrspace(3) inreg %lds) {
; CHECK-LABEL: buffer_load_lds_dword_offset:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_mov_b32 m0, s4 ; encoding: [0x04,0x00,0xfc,0xbe]
; CHECK-NEXT:    s_nop 0 ; encoding: [0x00,0x00,0x80,0xbf]
; CHECK-NEXT:    buffer_load_dword off, s[0:3], 0 lds ; encoding: [0x00,0x00,0x51,0xe0,0x00,0x00,0x00,0x80]
; CHECK-NEXT:    s_endpgm ; encoding: [0x00,0x00,0x81,0xbf]
  call void @llvm.amdgcn.raw.ptr.buffer.load.lds(ptr addrspace(8) %rsrc, ptr addrspace(3) %lds, i32 4, i32 0, i32 0, i32 0, i32 0)
  ret void
}
; CHECK: codeLenInByte = 20
