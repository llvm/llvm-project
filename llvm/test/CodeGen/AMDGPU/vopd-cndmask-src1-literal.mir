# RUN: llc -mtriple=amdgpu12.50 -run-pass=gcn-create-vopd -verify-machineinstrs %s -o - | FileCheck %s

# Move the shared src1 literal to one free VGPR. Use the VGPR in both VOPD
# components.
---
name:            cndmask_src1_literal
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr1, $vgpr3, $vcc_lo
    ; CHECK-LABEL: name: cndmask_src1_literal
    ; CHECK: [[LITERAL:\$vgpr[0-9]+]] = V_MOV_B32_e32 12345, implicit $exec
    ; CHECK-NEXT: $vgpr10, $vgpr1 = V_DUAL_CNDMASK_B32_e32_X_CNDMASK_B32_e32{{.*}} $vgpr3, {{.*}}[[LITERAL]]{{.*}}$vgpr1, {{.*}}[[LITERAL]]
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr10 = V_CNDMASK_B32_e64 0, $vgpr3, 0, 12345, $vcc_lo, implicit $exec
    $vgpr1 = V_CNDMASK_B32_e64 0, $vgpr1, 0, 12345, $vcc_lo, implicit $exec
    S_ENDPGM 0
...
