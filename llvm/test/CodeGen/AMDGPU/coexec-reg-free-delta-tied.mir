# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -amdgpu-sched-strategy=coexec %s -o - | FileCheck %s

# An instruction that redefines a register in place, such as an accumulating
# FMA or WMMA, frees nothing and grows nothing: the old value dies and the new
# one takes its registers. The coexec scheduler must rank it as net zero
# wherever the old value came from.

--- |
  define void @in_region_and_live_in() #0 { ret void }
  define void @in_place_form() #0 { ret void }
  define void @above_growth() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

# %p accumulates onto %live, which is defined before the region, and %q onto
# %acc, which the region defines. Both net zero, so they keep their source
# order.
---
name: in_region_and_live_in
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: in_region_and_live_in
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   %b:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   %live:vgpr_32 = COPY $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %p:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %live, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %acc:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
  ; CHECK-NEXT:   %q:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %acc, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit %p, implicit %q
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2

    %a:vgpr_32 = COPY $vgpr0
    %b:vgpr_32 = COPY $vgpr1
    %live:vgpr_32 = COPY $vgpr2

  bb.1:
    %acc:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
    %p:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %live, implicit $mode, implicit $exec
    %q:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %acc, implicit $mode, implicit $exec

    S_ENDPGM 0, implicit %p, implicit %q
...

# The same, after the two-address pass: the def and the tied use are one
# register.
---
name: in_place_form
tracksRegLiveness: true
isSSA: false
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: in_place_form
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   %b:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   %live:vgpr_32 = COPY $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %live:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %live, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %acc:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
  ; CHECK-NEXT:   %acc:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %acc, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit %live, implicit %acc
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2

    %a:vgpr_32 = COPY $vgpr0
    %b:vgpr_32 = COPY $vgpr1
    %live:vgpr_32 = COPY $vgpr2

  bb.1:
    %acc:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
    %live:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %live, implicit $mode, implicit $exec
    %acc:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %acc, implicit $mode, implicit $exec

    S_ENDPGM 0, implicit %live, implicit %acc
...

# Net zero beats growing a register: %p goes ahead of %grow although it comes
# later in the source.
---
name: above_growth
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: above_growth
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   %b:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   %live:vgpr_32 = COPY $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %p:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %live, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %grow:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit %grow, implicit %p
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2

    %a:vgpr_32 = COPY $vgpr0
    %b:vgpr_32 = COPY $vgpr1
    %live:vgpr_32 = COPY $vgpr2

  bb.1:
    %grow:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
    %p:vgpr_32 = nofpexcept V_FMAC_F32_e32 %a, %b, %live, implicit $mode, implicit $exec

    S_ENDPGM 0, implicit %grow, implicit %p
...
