# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu10.10 -run-pass=regallocbasic -stress-regalloc=4 -verify-regalloc -verify-machineinstrs -o - %s | FileCheck %s

# %1 is spilled and reloaded for the exec write in the prolog of %bb.3. Its
# sibling %0 is PHI-defined there, but hoisting the store of %0 to the end of
# the prolog would put it after that reload. The store stays at the copy.

---
name: hoist_spill_phi_def_bb_prolog
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  scratchRSrcReg: '$sgpr96_sgpr97_sgpr98_sgpr99'
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: sreg_32, split-from: '%2' }
  - { id: 1, class: sreg_32, split-from: '%2' }
  - { id: 2, class: sreg_32 }
body: |
  ; CHECK-LABEL: name: hoist_spill_phi_def_bb_prolog
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_ADD_U32_:%[0-9]+]]:sreg_32 = S_ADD_U32 $sgpr4, $sgpr4, implicit-def $scc
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32_xm0_xexec = COPY [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[COPY]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[COPY]]
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32_xm0_xexec = COPY [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[COPY]]
  ; CHECK-NEXT:   S_NOP 0, implicit [[COPY]]
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   bb-prolog SI_SPILL_S32_SAVE [[COPY]], %stack.0, implicit $exec, implicit $sgpr32 :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   [[SI_SPILL_S32_RESTORE:%[0-9]+]]:sreg_32_xm0_xexec = bb-prolog SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32 :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   $exec_lo = bb-prolog S_AND_B32 $exec_lo, [[SI_SPILL_S32_RESTORE]], implicit-def dead $scc
  ; CHECK-NEXT:   KILL implicit-def $sgpr0, implicit-def $sgpr1, implicit-def $sgpr2
  ; CHECK-NEXT:   [[SI_SPILL_S32_RESTORE1:%[0-9]+]]:sreg_32_xm0_xexec = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32 :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit [[SI_SPILL_S32_RESTORE1]], implicit [[S_ADD_U32_]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr4
    %2:sreg_32 = S_ADD_U32 $sgpr4, $sgpr4, implicit-def $scc
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_NOP 0, implicit %2
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1
  bb.1:
    %0:sreg_32 = COPY %2
    S_NOP 0, implicit %0
    S_NOP 0, implicit %0
    S_BRANCH %bb.3
  bb.2:
    %0:sreg_32 = COPY %2
    S_NOP 0, implicit %0
    S_NOP 0, implicit %0
    S_BRANCH %bb.3
  bb.3:
    %1:sreg_32 = lr-split bb-prolog COPY %0
    $exec_lo = bb-prolog S_AND_B32 $exec_lo, %1, implicit-def dead $scc
    KILL implicit-def $sgpr0, implicit-def $sgpr1, implicit-def $sgpr2
    S_NOP 0, implicit %1, implicit %2
    S_ENDPGM 0
...
