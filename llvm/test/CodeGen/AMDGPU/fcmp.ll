; RUN: llc < %s -mtriple=r600 -mcpu=redwood | FileCheck %s

; CHECK: {{^}}fcmp_sext:
; CHECK: SETE_DX10  T{{[0-9]+\.[XYZW], T[0-9]+\.[XYZW], T[0-9]+\.[XYZW]}}

define amdgpu_kernel void @fcmp_sext(ptr addrspace(1) %out, ptr addrspace(1) %in) {
; CHECK-LABEL: fcmp_sext:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    ALU 0, @8, KC0[CB0:0-32], KC1[]
; CHECK-NEXT:    TEX 0 @6
; CHECK-NEXT:    ALU 2, @9, KC0[CB0:0-32], KC1[]
; CHECK-NEXT:    MEM_RAT_CACHELESS STORE_RAW T0.X, T1.X, 1
; CHECK-NEXT:    CF_END
; CHECK-NEXT:    PAD
; CHECK-NEXT:    Fetch clause starting at 6:
; CHECK-NEXT:     VTX_READ_64 T0.XY, T0.X, 0, #1
; CHECK-NEXT:    ALU clause starting at 8:
; CHECK-NEXT:     MOV * T0.X, KC0[2].Z,
; CHECK-NEXT:    ALU clause starting at 9:
; CHECK-NEXT:     SETE_DX10 T0.X, T0.X, T0.Y,
; CHECK-NEXT:     LSHR * T1.X, KC0[2].Y, literal.x,
; CHECK-NEXT:    2(2.802597e-45), 0(0.000000e+00)
entry:
  %0 = load float, ptr addrspace(1) %in
  %arrayidx1 = getelementptr inbounds float, ptr addrspace(1) %in, i32 1
  %1 = load float, ptr addrspace(1) %arrayidx1
  %cmp = fcmp oeq float %0, %1
  %sext = sext i1 %cmp to i32
  store i32 %sext, ptr addrspace(1) %out
  ret void
}

; This test checks that a setcc node with f32 operands is lowered to a
; SET*_DX10 instruction.  Previously we were lowering this to:
; SET* + FP_TO_SINT

; CHECK: {{^}}fcmp_br:
; CHECK: SET{{[N]*}}E_DX10 * T{{[0-9]+\.[XYZW],}}
; CHECK-NEXT: {{[0-9]+\(5.0}}

define amdgpu_kernel void @fcmp_br(ptr addrspace(1) %out, float %in) {
; CHECK-LABEL: fcmp_br:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    ALU_PUSH_BEFORE 4, @8, KC0[CB0:0-32], KC1[]
; CHECK-NEXT:    JUMP @5 POP:1
; CHECK-NEXT:    ALU 3, @13, KC0[], KC1[]
; CHECK-NEXT:    MEM_RAT_CACHELESS STORE_RAW T0.X, T1.X, 0
; CHECK-NEXT:    POP @5 POP:1
; CHECK-NEXT:    ALU 1, @17, KC0[], KC1[]
; CHECK-NEXT:    MEM_RAT_CACHELESS STORE_RAW T0.X, T1.X, 1
; CHECK-NEXT:    CF_END
; CHECK-NEXT:    ALU clause starting at 8:
; CHECK-NEXT:     MOV T0.X, literal.x,
; CHECK-NEXT:     MOV T0.W, KC0[2].Y,
; CHECK-NEXT:     SETNE_DX10 * T1.W, KC0[2].Z, literal.y,
; CHECK-NEXT:    0(0.000000e+00), 1084227584(5.000000e+00)
; CHECK-NEXT:     PRED_SETE_INT * ExecMask,PredicateBit (MASKED), PS, 0.0,
; CHECK-NEXT:    ALU clause starting at 13:
; CHECK-NEXT:     ADD_INT * T1.W, T0.W, literal.x,
; CHECK-NEXT:    4(5.605194e-45), 0(0.000000e+00)
; CHECK-NEXT:     LSHR * T1.X, PV.W, literal.x,
; CHECK-NEXT:    2(2.802597e-45), 0(0.000000e+00)
; CHECK-NEXT:    ALU clause starting at 17:
; CHECK-NEXT:     LSHR * T1.X, T0.W, literal.x,
; CHECK-NEXT:    2(2.802597e-45), 0(0.000000e+00)
entry:
  %0 = fcmp oeq float %in, 5.0
  br i1 %0, label %IF, label %ENDIF

IF:
  %1 = getelementptr i32, ptr addrspace(1) %out, i32 1
  store i32 0, ptr addrspace(1) %1
  br label %ENDIF

ENDIF:
  store i32 0, ptr addrspace(1) %out
  ret void
}
