# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -amdgpu-disable-rewrite-mfma-form-sched-stage=false -amdgpu-disable-rewrite-mfma-cost-check -verify-machineinstrs -o - %s | FileCheck %s

# ds_read_src2_no_copy:
# DS_READ simply feeds MFMA src2.
# DS_READ reg should be reclassified to AGPR (no bridge copy).
#
# ds_read_src2_subreg_vgpr_user:
# DS_READ sub1 overwritten by COPY; cross-block V_ADD user of MFMA dst.
# DS_READ reg should stay VGPR and bridge COPY inserted.
#
# ds_read_src2_subreg_divergent:
# Divergent CFG. DS_READ sub1 overwritten on one path but not the other.
# DS_READ reg should stay VGPR and bridge COPYs inserted on both paths.
#
# ds_read_src2_ds_write_user_no_copy:
# DS_READ used by DS_WRITE in a different block.
# DS_READ reg should be reclassified to AGPR as DS_WRITE accepts AGPR.

--- |
  define void @ds_read_src2_no_copy() #0 {
  entry:
    unreachable
  }

  define void @ds_read_src2_subreg_vgpr_user() #0 {
  entry:
    unreachable
  }

  define void @ds_read_src2_subreg_divergent() #0 {
  entry:
    unreachable
  }

  define void @ds_read_src2_ds_write_user_no_copy() #0 {
  entry:
    unreachable
  }

  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64"}
...

