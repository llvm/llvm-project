# bb.2 returns current pressure to the header's estimate before its scope is
# popped. Its dead temporary has no later uses, so this does not need pressure
# or RegSeen restoration between siblings. The COPY in bb.3 can then move.
---
name: sibling_pressure_peak
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: sibling_pressure_peak
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, [[PHI]], %bb.2, %3, %bb.3
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[COPY1]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; CHECK-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY2]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %2:vgpr_32 = PHI %0, %bb.0, %2, %bb.2, %5, %bb.3
    S_CMP_EQ_U32 %1, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2:
    %3:vreg_128 = DS_READ_B128_gfx9 %2, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %2, %3, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    S_BRANCH %bb.1

  bb.3:
    %4:vgpr_32 = COPY %1
    %5:vgpr_32 = V_ADD_U32_e32 %2, %4, implicit $exec
    S_BRANCH %bb.1
...

# The preheader load raises VGPR pressure to 5, then the store lowers it to 1.
# The COPY can move after the store, before the branch. Its result does not
# cross the earlier preheader peak, so only the final estimate seeds the loop.
---
name: preheader_pressure_peak
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: preheader_pressure_peak
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[COPY]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; CHECK-NEXT:   DS_WRITE_B128_gfx9 [[COPY]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %4, %bb.1
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY2]], implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    %2:vreg_128 = DS_READ_B128_gfx9 %0, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %0, %2, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    S_BRANCH %bb.1

  bb.1:
    %3:vgpr_32 = PHI %0, %bb.0, %5, %bb.1
    %4:vgpr_32 = COPY %1
    %5:vgpr_32 = V_ADD_U32_e32 %3, %4, implicit $exec
    S_BRANCH %bb.1
...

