  ; LIMIT8-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr4
  ; LIMIT8-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; LIMIT8-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY]].sub0
  ; LIMIT8-NEXT:   S_BRANCH %bb.1
  ; LIMIT8-NEXT: {{  $}}
