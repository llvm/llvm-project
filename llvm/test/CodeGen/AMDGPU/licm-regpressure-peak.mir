  ; LIMIT8-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; LIMIT8-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; LIMIT8-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; LIMIT8-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY3]], implicit $exec
  ; LIMIT8-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY4]], implicit $exec
  ; LIMIT8-NEXT:   S_BRANCH %bb.1
  ;
  ; LIMIT9-LABEL: name: negative_cost_hoist_lowers_peak
  ; LIMIT9: bb.0:
  ; LIMIT9-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT9-NEXT:   liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr0
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[COPY:%[0-9]+]]:vreg_128 = COPY $vgpr0_vgpr1_vgpr2_vgpr3
  ; LIMIT9-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr4
  ; LIMIT9-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; LIMIT9-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY]].sub0
  ; LIMIT9-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; LIMIT9-NEXT:   S_BRANCH %bb.1
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT: bb.1:
  ; LIMIT9-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY1]], %bb.0, %4, %bb.1
  ; LIMIT9-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; LIMIT9-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY3]], implicit $exec
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY4]], implicit $exec
  ; LIMIT9-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4, $sgpr0

    %0:vreg_128 = COPY $vgpr0_vgpr1_vgpr2_vgpr3
    %1:vgpr_32 = COPY $vgpr4
    %2:sgpr_32 = COPY $sgpr0
    S_BRANCH %bb.1

  bb.1:
    %3:vgpr_32 = PHI %1, %bb.0, %8, %bb.1
    %4:vreg_128 = DS_READ_B128_gfx9 %3, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %3, %4, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    %5:vgpr_32 = COPY %0.sub0
    %6:vgpr_32 = COPY %2
    %7:vgpr_32 = V_ADD_U32_e32 %3, %5, implicit $exec
    %8:vgpr_32 = V_ADD_U32_e32 %7, %6, implicit $exec
    S_BRANCH %bb.1
