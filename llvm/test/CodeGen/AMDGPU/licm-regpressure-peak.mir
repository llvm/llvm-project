  ; LIMIT9-NEXT: bb.1:
  ; LIMIT9-NEXT:   successors: %bb.2(0x80000000)
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %4, %bb.3
  ; LIMIT9-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; LIMIT9-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; LIMIT9-NEXT:   S_BRANCH %bb.2
  ; LIMIT9-NEXT: {{  $}}
