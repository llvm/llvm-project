  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY3]], implicit $exec
  ; LIMIT9-NEXT:   S_BRANCH %bb.3
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT: bb.3:
  ; LIMIT9-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY4]], implicit $exec
  ; LIMIT9-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0, $sgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    %2:sgpr_32 = COPY $sgpr1
    S_BRANCH %bb.1

  bb.1:
    %3:vgpr_32 = PHI %0, %bb.0, %8, %bb.3
    %4:vreg_128 = DS_READ_B128_gfx9 %3, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %3, %4, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    S_BRANCH %bb.2

  bb.2:
    %5:vgpr_32 = COPY %1
    %6:vgpr_32 = V_ADD_U32_e32 %3, %5, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    %7:vgpr_32 = COPY %2
    %8:vgpr_32 = V_ADD_U32_e32 %6, %7, implicit $exec
    S_BRANCH %bb.1
...

# At limit 9, current pressure falls from 6 to 2 before the COPYs. Two hoists
# increase the saved peak to 7 and 8. The third would reach the limit of 9.
# Both accepted hoists must be charged once even while current pressure is low.
---
name: multiple_hoists_raise_peak
tracksRegLiveness: true
body: |
  ; LIMIT6-LABEL: name: multiple_hoists_raise_peak
  ; LIMIT6: bb.0:
  ; LIMIT6-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT6-NEXT:   liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2
  ; LIMIT6-NEXT: {{  $}}
  ; LIMIT6-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; LIMIT6-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; LIMIT6-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr1
  ; LIMIT6-NEXT:   [[COPY3:%[0-9]+]]:sgpr_32 = COPY $sgpr2
  ; LIMIT6-NEXT:   S_BRANCH %bb.1
  ; LIMIT6-NEXT: {{  $}}
  ; LIMIT6-NEXT: bb.1:
  ; LIMIT6-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT6-NEXT: {{  $}}
