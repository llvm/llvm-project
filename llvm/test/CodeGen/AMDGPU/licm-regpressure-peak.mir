  ; LIMIT6-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; LIMIT6-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; LIMIT6-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; LIMIT6-NEXT:   [[COPY5:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; LIMIT6-NEXT:   [[COPY6:%[0-9]+]]:vgpr_32 = COPY [[COPY3]]
  ; LIMIT6-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY4]], implicit $exec
  ; LIMIT6-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY5]], implicit $exec
  ; LIMIT6-NEXT:   [[V_ADD_U32_e32_2:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_1]], [[COPY6]], implicit $exec
  ; LIMIT6-NEXT:   S_BRANCH %bb.1
  ;
  ; LIMIT8-LABEL: name: multiple_hoists_raise_peak
  ; LIMIT8: bb.0:
  ; LIMIT8-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT8-NEXT:   liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2
  ; LIMIT8-NEXT: {{  $}}
  ; LIMIT8-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; LIMIT8-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; LIMIT8-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr1
  ; LIMIT8-NEXT:   [[COPY3:%[0-9]+]]:sgpr_32 = COPY $sgpr2
  ; LIMIT8-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; LIMIT8-NEXT:   S_BRANCH %bb.1
  ; LIMIT8-NEXT: {{  $}}
  ; LIMIT8-NEXT: bb.1:
  ; LIMIT8-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT8-NEXT: {{  $}}
  ; LIMIT8-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %5, %bb.1
  ; LIMIT8-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; LIMIT8-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; LIMIT8-NEXT:   [[COPY5:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; LIMIT8-NEXT:   [[COPY6:%[0-9]+]]:vgpr_32 = COPY [[COPY3]]
  ; LIMIT8-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY4]], implicit $exec
  ; LIMIT8-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY5]], implicit $exec
  ; LIMIT8-NEXT:   [[V_ADD_U32_e32_2:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_1]], [[COPY6]], implicit $exec
  ; LIMIT8-NEXT:   S_BRANCH %bb.1
  ;
  ; LIMIT9-LABEL: name: multiple_hoists_raise_peak
  ; LIMIT9: bb.0:
  ; LIMIT9-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT9-NEXT:   liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; LIMIT9-NEXT:   [[COPY1:%[0-9]+]]:sgpr_32 = COPY $sgpr0
  ; LIMIT9-NEXT:   [[COPY2:%[0-9]+]]:sgpr_32 = COPY $sgpr1
  ; LIMIT9-NEXT:   [[COPY3:%[0-9]+]]:sgpr_32 = COPY $sgpr2
  ; LIMIT9-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; LIMIT9-NEXT:   [[COPY5:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; LIMIT9-NEXT:   S_BRANCH %bb.1
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT: bb.1:
  ; LIMIT9-NEXT:   successors: %bb.1(0x80000000)
  ; LIMIT9-NEXT: {{  $}}
  ; LIMIT9-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY]], %bb.0, %5, %bb.1
  ; LIMIT9-NEXT:   [[DS_READ_B128_gfx9_:%[0-9]+]]:vreg_128 = DS_READ_B128_gfx9 [[PHI]], 0, 0, implicit $exec :: (load (s128), addrspace 3)
  ; LIMIT9-NEXT:   DS_WRITE_B128_gfx9 [[PHI]], [[DS_READ_B128_gfx9_]], 16, 0, implicit $exec :: (store (s128), addrspace 3)
  ; LIMIT9-NEXT:   [[COPY6:%[0-9]+]]:vgpr_32 = COPY [[COPY3]]
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[PHI]], [[COPY4]], implicit $exec
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_]], [[COPY5]], implicit $exec
  ; LIMIT9-NEXT:   [[V_ADD_U32_e32_2:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[V_ADD_U32_e32_1]], [[COPY6]], implicit $exec
  ; LIMIT9-NEXT:   S_BRANCH %bb.1
  bb.0:
    liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2

    %0:vgpr_32 = COPY $vgpr0
    %1:sgpr_32 = COPY $sgpr0
    %2:sgpr_32 = COPY $sgpr1
    %3:sgpr_32 = COPY $sgpr2
    S_BRANCH %bb.1

  bb.1:
    %4:vgpr_32 = PHI %0, %bb.0, %11, %bb.1
    %5:vreg_128 = DS_READ_B128_gfx9 %4, 0, 0, implicit $exec :: (load (s128), addrspace 3)
    DS_WRITE_B128_gfx9 %4, %5, 16, 0, implicit $exec :: (store (s128), addrspace 3)
    %6:vgpr_32 = COPY %1
    %7:vgpr_32 = COPY %2
    %8:vgpr_32 = COPY %3
    %9:vgpr_32 = V_ADD_U32_e32 %4, %6, implicit $exec
    %10:vgpr_32 = V_ADD_U32_e32 %9, %7, implicit $exec
    %11:vgpr_32 = V_ADD_U32_e32 %10, %8, implicit $exec
    S_BRANCH %bb.1
...

# The one-use vreg_128 input costs 4 even though the COPY selects one subregister.
# Hoisting that COPY has net VGPR cost -3, lowering the peak from 10 to 7.
# The following +1 COPY moves at limit 9 and stays at limits 6 and 8.
---
name: negative_cost_hoist_lowers_peak
tracksRegLiveness: true
body: |
  ; LIMIT6-LABEL: name: negative_cost_hoist_lowers_peak
  ; LIMIT6: bb.0:
