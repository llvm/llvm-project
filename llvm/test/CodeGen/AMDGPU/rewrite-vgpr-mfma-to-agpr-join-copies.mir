# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -start-before=greedy,2 -stop-after=virt-reg-rewriter,2 -verify-regalloc -o - %s | FileCheck %s

# Joins of copy-related AGPRs after an MFMA chain is rewritten to the AGPR form.

# %3 is joined into %2 first, and the joined register is live across the call.
# The second join, of %2 into %1, must see the call: the result must be in a
# callee-saved AGPR.
---
name:            consecutive_joins_across_call
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
machineFunctionInfo:
  scratchRSrcReg:  $sgpr0_sgpr1_sgpr2_sgpr3
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    liveins: $sgpr30_sgpr31

    ; CHECK-LABEL: name: consecutive_joins_across_call
    ; CHECK: liveins: $sgpr30_sgpr31
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $vgpr0 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $agpr32 = COPY renamable $vgpr0
    ; CHECK-NEXT: renamable $agpr33 = COPY renamable $vgpr0
    ; CHECK-NEXT: renamable $agpr34 = COPY renamable $vgpr0
    ; CHECK-NEXT: renamable $agpr35 = COPY renamable $vgpr0
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR killed renamable $vgpr0, renamable $agpr32_agpr33_agpr34_agpr35, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: ADJCALLSTACKUP 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    ; CHECK-NEXT: dead $sgpr30_sgpr31 = SI_CALL undef renamable $sgpr16_sgpr17, 0, csr_amdgpu_gfx90ainsts
    ; CHECK-NEXT: ADJCALLSTACKDOWN 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    ; CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2_vgpr3 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr0_vgpr1_vgpr2_vgpr3, killed $agpr32_agpr33_agpr34_agpr35, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: renamable $vgpr4 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR killed renamable $vgpr4, killed renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: SI_RETURN
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    undef %1.sub0:areg_128_align2 = COPY %0
    %1.sub1:areg_128_align2 = COPY %0
    %1.sub2:areg_128_align2 = COPY %0
    %1.sub3:areg_128_align2 = COPY %0
    %2:areg_128_align2 = COPY %1
    %3:vreg_128_align2 = COPY %2
    GLOBAL_STORE_DWORDX4_SADDR %0, %1, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ADJCALLSTACKUP 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    dead $sgpr30_sgpr31 = SI_CALL undef renamable $sgpr16_sgpr17, 0, csr_amdgpu_gfx90ainsts
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $scc, implicit-def $sgpr32, implicit $sgpr32
    %4:av_128_align2 = IMPLICIT_DEF
    %5:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %4, %4, %3, 0, 0, 0, implicit $mode, implicit $exec
    %6:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %6, %5, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s128), addrspace 1)
    SI_RETURN

...

# %2 is a copy of %1, which has only two defined lanes. %2 is not joined into
# %1, because the use of %2.sub3 would read an undefined lane of %1.
---
name:            undefined_lanes_in_copy_source
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    ; CHECK-LABEL: name: undefined_lanes_in_copy_source
    ; CHECK: renamable $vgpr8 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $agpr0 = COPY renamable $vgpr8
    ; CHECK-NEXT: renamable $agpr1 = COPY renamable $vgpr8
    ; CHECK-NEXT: renamable $agpr2_agpr3_agpr4_agpr5 = COPY renamable $agpr0_agpr1_agpr2_agpr3
    ; CHECK-NEXT: renamable $vgpr4_vgpr5_vgpr6_vgpr7 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr4_vgpr5_vgpr6_vgpr7, $vgpr4_vgpr5_vgpr6_vgpr7, $agpr2_agpr3_agpr4_agpr5, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: renamable $vgpr0 = COPY killed renamable $agpr5
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR renamable $vgpr8, killed renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: GLOBAL_STORE_DWORD_SADDR killed renamable $vgpr8, killed renamable $vgpr0, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    undef %1.sub0:areg_128_align2 = COPY %0
    %1.sub1:areg_128_align2 = COPY %0
    %2:vreg_128_align2 = COPY %1
    %3:av_128_align2 = IMPLICIT_DEF
    %4:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %3, %3, %2, 0, 0, 0, implicit $mode, implicit $exec
    %5:areg_128_align2 = COPY %4
    %6:vgpr_32 = COPY %2.sub3
    GLOBAL_STORE_DWORDX4_SADDR %0, %5, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    GLOBAL_STORE_DWORD_SADDR %0, %6, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    S_ENDPGM 0

...

# SplitKit bundles the copies of a register that no single subregister index
# covers. Both copies are removed when %2 is joined into %1.
---
name:            bundled_copies
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    ; CHECK-LABEL: name: bundled_copies
    ; CHECK: renamable $vgpr4 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $agpr0 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $agpr1 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $agpr2 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $agpr3 = COPY renamable $vgpr4
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR renamable $vgpr4, renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: renamable $vgpr6_vgpr7_vgpr8_vgpr9 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr6_vgpr7_vgpr8_vgpr9, $vgpr6_vgpr7_vgpr8_vgpr9, killed $agpr0_agpr1_agpr2_agpr3, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR killed renamable $vgpr4, killed renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    undef %1.sub0:areg_128_align2 = COPY %0
    %1.sub1:areg_128_align2 = COPY %0
    %1.sub2:areg_128_align2 = COPY %0
    %1.sub3:areg_128_align2 = COPY %0
    undef %2.sub0_sub1:vreg_128_align2 = COPY %1.sub0_sub1 {
      internal %2.sub2_sub3:vreg_128_align2 = COPY %1.sub2_sub3
    }
    GLOBAL_STORE_DWORDX4_SADDR %0, %1, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    %3:av_128_align2 = IMPLICIT_DEF
    %4:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %3, %3, %2, 0, 0, 0, implicit $mode, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %0, %4, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s128), addrspace 1)
    S_ENDPGM 0

...

# %2 has one defined lane, and the MFMA reads all of it. After %2 is joined into
# %1, the MFMA reads the other lanes of %1 too, so they stay live up to the
# MFMA. $agpr1 and $agpr2 are live there: the joined register cannot use the
# AGPRs of %1, and it uses the AGPRs of %2.
---
name:            partial_copy_extends_source_lanes
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    ; CHECK-LABEL: name: partial_copy_extends_source_lanes
    ; CHECK: renamable $vgpr4 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2_vgpr3 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr4_agpr5_agpr6_agpr7 = COPY killed renamable $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: $agpr1 = COPY renamable $vgpr4
    ; CHECK-NEXT: $agpr2 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $vgpr5 = COPY renamable $agpr4
    ; CHECK-NEXT: renamable $vgpr6_vgpr7_vgpr8_vgpr9 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr6_vgpr7_vgpr8_vgpr9, $vgpr6_vgpr7_vgpr8_vgpr9, killed $agpr4_agpr5_agpr6_agpr7, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR renamable $vgpr4, killed renamable $agpr4_agpr5_agpr6_agpr7, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: GLOBAL_STORE_DWORD_SADDR killed renamable $vgpr4, killed renamable $vgpr5, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $agpr1, implicit $agpr2
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %9:vreg_128_align2 = IMPLICIT_DEF
    %1:areg_128_align2 = COPY %9
    undef %2.sub0:vreg_128_align2 = COPY %1.sub0
    $agpr1 = COPY %0
    $agpr2 = COPY %0
    %7:vgpr_32 = COPY %1.sub0
    %3:av_128_align2 = IMPLICIT_DEF
    %4:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %3, %3, %2, 0, 0, 0, implicit $mode, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %0, %4, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    GLOBAL_STORE_DWORD_SADDR %0, %7, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    S_ENDPGM 0, implicit $agpr1, implicit $agpr2

...

# The same, but $agpr5 is live too: the joined register can use neither the
# AGPRs of %1 nor those of %2. It gets another free AGPR.
---
name:            partial_copy_other_agpr
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    ; CHECK-LABEL: name: partial_copy_other_agpr
    ; CHECK: renamable $vgpr4 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $vgpr0_vgpr1_vgpr2_vgpr3 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr6_agpr7_agpr8_agpr9 = COPY killed renamable $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: $agpr1 = COPY renamable $vgpr4
    ; CHECK-NEXT: $agpr2 = COPY renamable $vgpr4
    ; CHECK-NEXT: $agpr5 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $vgpr5 = COPY renamable $agpr6
    ; CHECK-NEXT: renamable $vgpr6_vgpr7_vgpr8_vgpr9 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr6_agpr7_agpr8_agpr9 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr6_vgpr7_vgpr8_vgpr9, $vgpr6_vgpr7_vgpr8_vgpr9, killed $agpr6_agpr7_agpr8_agpr9, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR renamable $vgpr4, killed renamable $agpr6_agpr7_agpr8_agpr9, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: GLOBAL_STORE_DWORD_SADDR killed renamable $vgpr4, killed renamable $vgpr5, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0, implicit $agpr1, implicit $agpr2, implicit $agpr5
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %9:vreg_128_align2 = IMPLICIT_DEF
    %1:areg_128_align2 = COPY %9
    undef %2.sub0:vreg_128_align2 = COPY %1.sub0
    $agpr1 = COPY %0
    $agpr2 = COPY %0
    $agpr5 = COPY %0
    %7:vgpr_32 = COPY %1.sub0
    %3:av_128_align2 = IMPLICIT_DEF
    %4:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %3, %3, %2, 0, 0, 0, implicit $mode, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %0, %4, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    GLOBAL_STORE_DWORD_SADDR %0, %7, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    S_ENDPGM 0, implicit $agpr1, implicit $agpr2, implicit $agpr5

...

# The copy in bb.1 defines %2 from an undefined %1. %2 is not joined into %1:
# without that copy, the MFMA would read %1 with no def on the path through
# bb.1.
---
name:            undef_copy_source
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  ; CHECK-LABEL: name: undef_copy_source
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $vgpr4 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $agpr4_agpr5_agpr6_agpr7 = COPY undef renamable $agpr0_agpr1_agpr2_agpr3
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $vgpr0_vgpr1_vgpr2_vgpr3 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $agpr0_agpr1_agpr2_agpr3 = COPY killed renamable $vgpr0_vgpr1_vgpr2_vgpr3
  ; CHECK-NEXT:   renamable $agpr4_agpr5_agpr6_agpr7 = COPY renamable $agpr0_agpr1_agpr2_agpr3
  ; CHECK-NEXT:   GLOBAL_STORE_DWORDX4_SADDR renamable $vgpr4, killed renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s128), addrspace 1)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $vgpr4, $agpr4_agpr5_agpr6_agpr7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $vgpr6_vgpr7_vgpr8_vgpr9 = IMPLICIT_DEF
  ; CHECK-NEXT:   renamable $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr6_vgpr7_vgpr8_vgpr9, $vgpr6_vgpr7_vgpr8_vgpr9, killed $agpr4_agpr5_agpr6_agpr7, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   GLOBAL_STORE_DWORDX4_SADDR killed renamable $vgpr4, killed renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2

    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit undef $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3

    %2:vreg_128_align2 = COPY undef %1:areg_128_align2
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    %9:vreg_128_align2 = IMPLICIT_DEF
    %1:areg_128_align2 = COPY %9
    %2:vreg_128_align2 = COPY %1
    GLOBAL_STORE_DWORDX4_SADDR %0, %1, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s128), addrspace 1)

  bb.3:
    %3:av_128_align2 = IMPLICIT_DEF
    %4:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %3, %3, %2, 0, 0, 0, implicit $mode, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %0, %4, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    S_ENDPGM 0

...

# The def of %1.sub1 is dead. After %2 is joined into %1, the MFMA reads that
# lane, and the def must lose its dead flag. The check of that def is anchored
# by hand, so that it does not match a def with the flag; keep the anchor when
# the checks are regenerated.
---
name:            dead_def_made_live
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    ; CHECK-LABEL: name: dead_def_made_live
    ; CHECK: renamable $vgpr4 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $agpr0 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $agpr1 = COPY renamable $vgpr4
    ; CHECK-NEXT: renamable $vgpr5 = COPY renamable $agpr0
    ; CHECK-NEXT: renamable $vgpr6_vgpr7_vgpr8_vgpr9 = IMPLICIT_DEF
    ; CHECK-NEXT: renamable $agpr0_agpr1_agpr2_agpr3 = V_MFMA_F32_16X16X32_F16_e64 killed $vgpr6_vgpr7_vgpr8_vgpr9, $vgpr6_vgpr7_vgpr8_vgpr9, $agpr0_agpr1_agpr2_agpr3, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX4_SADDR renamable $vgpr4, killed renamable $agpr0_agpr1_agpr2_agpr3, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    ; CHECK-NEXT: GLOBAL_STORE_DWORD_SADDR killed renamable $vgpr4, killed renamable $vgpr5, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    undef %1.sub0:areg_128_align2 = COPY %0
    dead %1.sub1:areg_128_align2 = COPY %0
    undef %2.sub0:vreg_128_align2 = COPY %1.sub0
    %7:vgpr_32 = COPY %1.sub0
    %3:av_128_align2 = IMPLICIT_DEF
    %4:vreg_128_align2 = V_MFMA_F32_16X16X32_F16_vgprcd_e64 %3, %3, %2, 0, 0, 0, implicit $mode, implicit $exec
    GLOBAL_STORE_DWORDX4_SADDR %0, %4, undef $sgpr0_sgpr1, 0, 0, implicit $exec :: (store (s128), addrspace 1)
    GLOBAL_STORE_DWORD_SADDR %0, %7, undef $sgpr0_sgpr1, 16, 0, implicit $exec :: (store (s32), addrspace 1)
    S_ENDPGM 0

...
