# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: expensive_checks
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -passes=machine-scheduler %s -o - | FileCheck %s

# The clobber is dead except for $vgpr1 but has no dead flag. Its dead
# lanes must be found from LiveIntervals with lane mask tracking.

---
name:            unflagged_dead_clobber
tracksRegLiveness: true
machineFunctionInfo:
  occupancy:       6
body:             |
  bb.0:
    ; CHECK-LABEL: name: unflagged_dead_clobber
    ; CHECK: [[DEF:%[0-9]+]]:vreg_128 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:vreg_128 = IMPLICIT_DEF
    ; CHECK-NEXT: INLINEASM &"; copy", sideeffect attdialect, regdef, implicit-def $vgpr1, reguse:VReg_128, [[DEF]], clobber, implicit-def early-clobber $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: $vgpr0_vgpr1_vgpr2_vgpr3 = COPY [[DEF1]]
    ; CHECK-NEXT: INLINEASM &"; use", sideeffect attdialect, reguse:VGPR_32, [[COPY]], reguse, $vgpr0_vgpr1_vgpr2_vgpr3
    ; CHECK-NEXT: SI_RETURN
    %0:vreg_128 = IMPLICIT_DEF
    %1:vreg_128 = IMPLICIT_DEF
    INLINEASM &"; copy", sideeffect attdialect, regdef, implicit-def $vgpr1, reguse:VReg_128, %0, clobber, implicit-def early-clobber $vgpr0_vgpr1_vgpr2_vgpr3
    %2:vgpr_32 = COPY killed $vgpr1
    $vgpr0_vgpr1_vgpr2_vgpr3 = COPY %1
    INLINEASM &"; use", sideeffect attdialect, reguse:VGPR_32, %2, reguse, $vgpr0_vgpr1_vgpr2_vgpr3
    SI_RETURN
...
