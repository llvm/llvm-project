# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=CHECK-PEEPHOLE
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 -run-pass=peephole-opt,si-fold-operands -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=CHECK-FOLD

# peephole-opt creates COPYs for REG_SEQUENCE subregister uses,
# si-fold-operands folds those into use instructions.

---
name: test_regseq_fold_basic
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-PEEPHOLE-LABEL: name: test_regseq_fold_basic
    ; CHECK-PEEPHOLE: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-PEEPHOLE-NEXT: [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    ; CHECK-PEEPHOLE-NEXT: [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[V_MOV_B32_e32_]], %subreg.sub0, [[V_MOV_B32_e32_1]], %subreg.sub1
    ; CHECK-PEEPHOLE-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY [[V_MOV_B32_e32_]]
    ; CHECK-PEEPHOLE-NEXT: S_ENDPGM 0, implicit [[COPY]]
    ;
    ; CHECK-FOLD-LABEL: name: test_regseq_fold_basic
    ; CHECK-FOLD: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-FOLD-NEXT: [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    ; CHECK-FOLD-NEXT: [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[V_MOV_B32_e32_]], %subreg.sub0, [[V_MOV_B32_e32_1]], %subreg.sub1
    ; CHECK-FOLD-NEXT: [[V_MOV_B32_e32_2:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-FOLD-NEXT: S_ENDPGM 0, implicit [[V_MOV_B32_e32_2]]
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %2:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1
    %3:vgpr_32 = COPY %2.sub0
    S_ENDPGM 0, implicit %3

...
