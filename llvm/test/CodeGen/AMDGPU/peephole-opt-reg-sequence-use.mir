name: test_regseq_fold_phi_multiple_preds
tracksRegLiveness: true
body:             |
  ; CHECK-PEEPHOLE-LABEL: name: test_regseq_fold_phi_multiple_preds
  ; CHECK-PEEPHOLE: bb.0:
  ; CHECK-PEEPHOLE-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-PEEPHOLE-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-PEEPHOLE-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-PEEPHOLE-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
  ; CHECK-PEEPHOLE-NEXT:   S_CBRANCH_EXECZ %bb.2, implicit $exec, implicit [[COPY2]]
  ; CHECK-PEEPHOLE-NEXT:   S_BRANCH %bb.1, implicit [[COPY]], implicit [[COPY1]]
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT: bb.1:
  ; CHECK-PEEPHOLE-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[COPY]], %subreg.sub0, [[COPY1]], %subreg.sub1
  ; CHECK-PEEPHOLE-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
  ; CHECK-PEEPHOLE-NEXT:   S_BRANCH %bb.3, implicit [[REG_SEQUENCE]]
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT: bb.2:
  ; CHECK-PEEPHOLE-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT:   S_BRANCH %bb.3, implicit [[COPY2]]
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT: bb.3:
  ; CHECK-PEEPHOLE-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY3]], %bb.1, [[COPY2]], %bb.2
  ; CHECK-PEEPHOLE-NEXT:   $vgpr0 = COPY [[PHI]]
  ;
  ; CHECK-FOLD-LABEL: name: test_regseq_fold_phi_multiple_preds
  ; CHECK-FOLD: bb.0:
  ; CHECK-FOLD-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-FOLD-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-FOLD-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-FOLD-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
  ; CHECK-FOLD-NEXT:   S_CBRANCH_EXECZ %bb.2, implicit $exec, implicit [[COPY2]]
  ; CHECK-FOLD-NEXT:   S_BRANCH %bb.1, implicit [[COPY]], implicit [[COPY1]]
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT: bb.1:
  ; CHECK-FOLD-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[COPY]], %subreg.sub0, [[COPY1]], %subreg.sub1
  ; CHECK-FOLD-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
  ; CHECK-FOLD-NEXT:   S_BRANCH %bb.3, implicit [[REG_SEQUENCE]]
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT: bb.2:
  ; CHECK-FOLD-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT:   S_BRANCH %bb.3, implicit [[COPY2]]
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT: bb.3:
  ; CHECK-FOLD-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY3]], %bb.1, [[COPY2]], %bb.2
  ; CHECK-FOLD-NEXT:   $vgpr0 = COPY [[PHI]]
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    successors: %bb.1, %bb.2

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = COPY $vgpr2
    S_CBRANCH_EXECZ %bb.2, implicit $exec, implicit %2
    S_BRANCH %bb.1, implicit %0, implicit %1

  bb.1:
    successors: %bb.3

    %3:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1
    S_BRANCH %bb.3, implicit %3

  bb.2:
    successors: %bb.3

    S_BRANCH %bb.3, implicit %2

  bb.3:
    %4:vgpr_32 = PHI %3.sub0, %bb.1, %2, %bb.2
    $vgpr0 = COPY %4
...


