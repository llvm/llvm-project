name: test_regseq_fold_phi_single_pred
tracksRegLiveness: true
body:             |
  ; CHECK-PEEPHOLE-LABEL: name: test_regseq_fold_phi_single_pred
  ; CHECK-PEEPHOLE: bb.0:
  ; CHECK-PEEPHOLE-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-PEEPHOLE-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-PEEPHOLE-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-PEEPHOLE-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[COPY]], %subreg.sub0, [[COPY1]], %subreg.sub1
  ; CHECK-PEEPHOLE-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
  ; CHECK-PEEPHOLE-NEXT:   S_BRANCH %bb.1, implicit [[REG_SEQUENCE]]
  ; CHECK-PEEPHOLE-NEXT: {{  $}}
  ; CHECK-PEEPHOLE-NEXT: bb.1:
  ; CHECK-PEEPHOLE-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY2]], %bb.0
  ; CHECK-PEEPHOLE-NEXT:   $vgpr0 = COPY [[PHI]]
  ;
  ; CHECK-FOLD-LABEL: name: test_regseq_fold_phi_single_pred
  ; CHECK-FOLD: bb.0:
  ; CHECK-FOLD-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-FOLD-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-FOLD-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-FOLD-NEXT:   [[REG_SEQUENCE:%[0-9]+]]:vreg_64 = REG_SEQUENCE [[COPY]], %subreg.sub0, [[COPY1]], %subreg.sub1
  ; CHECK-FOLD-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
  ; CHECK-FOLD-NEXT:   S_BRANCH %bb.1, implicit [[REG_SEQUENCE]]
  ; CHECK-FOLD-NEXT: {{  $}}
  ; CHECK-FOLD-NEXT: bb.1:
  ; CHECK-FOLD-NEXT:   [[PHI:%[0-9]+]]:vgpr_32 = PHI [[COPY2]], %bb.0
  ; CHECK-FOLD-NEXT:   $vgpr0 = COPY [[PHI]]
  bb.0:
    liveins: $vgpr0, $vgpr1
    successors: %bb.1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1
    S_BRANCH %bb.1, implicit %2

  bb.1:
    %3:vgpr_32 = PHI %2.sub0, %bb.0
    $vgpr0 = COPY %3
...

