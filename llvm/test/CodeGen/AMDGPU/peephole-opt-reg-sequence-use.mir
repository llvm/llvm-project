name: test_regseq_fold_multiple_uses_same_regclass
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-PEEPHOLE-LABEL: name: test_regseq_fold_multiple_uses_same_regclass
    ; CHECK-PEEPHOLE: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-PEEPHOLE-NEXT: [[V_MOV_B32_e32_1:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    ; CHECK-PEEPHOLE-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY [[V_MOV_B32_e32_]]
    ; CHECK-PEEPHOLE-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[V_MOV_B32_e32_]]
    ; CHECK-PEEPHOLE-NEXT: [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 [[COPY1]], [[COPY]], implicit $exec
    ; CHECK-PEEPHOLE-NEXT: S_ENDPGM 0, implicit [[V_ADD_U32_e32_]]
    ;
    ; CHECK-FOLD-LABEL: name: test_regseq_fold_multiple_uses_same_regclass
    ; CHECK-FOLD: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-FOLD-NEXT: [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 0, [[V_MOV_B32_e32_]], implicit $exec
    ; CHECK-FOLD-NEXT: S_ENDPGM 0, implicit [[V_ADD_U32_e32_]]
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %2:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1
    %3:vgpr_32 = V_ADD_U32_e32 %2.sub0, %2.sub0, implicit $exec
    S_ENDPGM 0, implicit %3
...
