    ; CHECK-FOLD-NEXT: INLINEASM &"; use $0", sideeffect attdialect, reguse:VGPR_32, [[REG_SEQUENCE]].sub0
    ; CHECK-FOLD-NEXT: S_ENDPGM 0
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %2:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1
    INLINEASM &"; use $0", sideeffect attdialect, reguse:VGPR_32, %2.sub0
    S_ENDPGM 0

...
