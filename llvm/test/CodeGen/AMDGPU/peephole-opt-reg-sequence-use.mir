# NOTE: This test case is commented out because it exposes a pre-existing bug
# in SIFoldOperands which crashes on REG_SEQUENCE with physical register inputs.
# TODO: Re-enable once SIFoldOperands is fixed.
# name: test_regseq_fold_skip_phys_source
# tracksRegLiveness: true
# body: |
#   bb.0:
#     liveins: $vgpr0, $vgpr2
#     %0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
#     %1:vreg_64 = REG_SEQUENCE $vgpr0, %subreg.sub0, %0, %subreg.sub1
#     %2:vgpr_32 = V_ADD_CO_U32_e32 %1.sub0, $vgpr2, implicit-def $vcc, implicit $exec
#     S_ENDPGM 0, implicit %2
---
