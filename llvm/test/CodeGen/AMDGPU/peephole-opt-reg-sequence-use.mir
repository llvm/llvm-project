    %1:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %2:sreg_32 = S_MOV_B32 42
    %3:vreg_64 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1
    %4:vgpr_32, dead %5:sreg_64_xexec = V_ADD_CO_U32_e64 %3.sub0, %2, 0, implicit $exec ; folding would violate constant bus restriction
    S_ENDPGM 0, implicit %4

