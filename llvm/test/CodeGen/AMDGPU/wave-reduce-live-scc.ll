; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=amdgpu9.00 -global-isel=0 < %s | FileCheck %s

; The wave.reduce expansions write SCC. A uniform condition that is live
; across the call must not be read from SCC after it.
; FIXME: The select reads the SCC written by s_bcnt1, not by the compare.

define amdgpu_kernel void @add_uniform_live_scc(ptr addrspace(1) %out, i32 %a, i32 %b, i32 %u) {
; CHECK-LABEL: add_uniform_live_scc:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_load_dwordx4 s[0:3], s[4:5], 0x2c
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_load_dwordx2 s[0:1], s[4:5], 0x24
; CHECK-NEXT:    ; kill: killed $sgpr4_sgpr5
; CHECK-NEXT:    s_mov_b64 s[4:5], exec
; CHECK-NEXT:    s_bcnt1_i32_b64 s3, s[4:5]
; CHECK-NEXT:    v_mov_b32_e32 v0, 0
; CHECK-NEXT:    s_mul_i32 s2, s2, s3
; CHECK-NEXT:    s_cselect_b32 s2, s2, 1
; CHECK-NEXT:    v_mov_b32_e32 v1, s2
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_store_dword v0, v1, s[0:1]
; CHECK-NEXT:    s_endpgm
  %c = icmp eq i32 %a, %b
  %r = call i32 @llvm.amdgcn.wave.reduce.add.i32(i32 %u, i32 0)
  %s = select i1 %c, i32 %r, i32 1
  store i32 %s, ptr addrspace(1) %out
  ret void
}
