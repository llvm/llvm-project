# RUN: llc -mtriple=amdgpu10.10 -mattr=+wavefrontsize64 -run-pass=postmisched %s -o /dev/null -debug-only=machine-scheduler 2>&1 | FileCheck -check-prefixes=CHECK,FF %s
# RUN: llc -mtriple=amdgpu11.00 -mattr=+wavefrontsize64 -run-pass=postmisched %s -o /dev/null -debug-only=machine-scheduler 2>&1 | FileCheck -check-prefixes=CHECK,NOFF %s
# RUN: llc -mtriple=amdgpu12.00 -mattr=+wavefrontsize64 -run-pass=postmisched %s -o /dev/null -debug-only=machine-scheduler 2>&1 | FileCheck -check-prefixes=CHECK,NOFF %s
# REQUIRES: asserts

# Check the scheduling latency of dependencies through a lane mask or carry
# SGPR from a VALU fast forward producer to a VALU fast forward consumer in
# wave64. GFX11 in wave64 and GFX12.0 have hazards between VALU SGPR producers
# and consumers, so the latency is not reduced there.

# CHECK-LABEL: # Machine code for function vopc_e32_to_cndmask_e32:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_e32
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$vcc{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$vcc{{$}}
---
name: vopc_e32_to_cndmask_e32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    V_CMP_EQ_U32_e32 $vgpr0, $vgpr1, implicit-def $vcc, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e32 $vgpr3, $vgpr4, implicit $vcc, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

# CHECK-LABEL: # Machine code for function vopc_e64_to_cndmask_e64:
# CHECK:       SU(1): {{.*}}V_CNDMASK_B32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$sgpr0_sgpr1{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0_sgpr1{{$}}
---
name: vopc_e64_to_cndmask_e64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr3, $vgpr4
    $sgpr0_sgpr1 = V_CMP_EQ_U32_e64 $vgpr0, $vgpr1, implicit $exec
    $vgpr2 = V_CNDMASK_B32_e64 0, $vgpr3, 0, $vgpr4, $sgpr0_sgpr1, implicit $exec
    S_ENDPGM 0, implicit $vgpr2
...

# CHECK-LABEL: # Machine code for function carry_e64_to_addc_e64:
# CHECK:       SU(1): {{.*}}V_ADDC_U32_e64
# CHECK:         Predecessors:
# CHECK-NOT:   {{^}}SU(
# FF:             SU(0): Data Latency=0 Reg=$sgpr0_sgpr1{{$}}
# NOFF:           SU(0): Data Latency={{[1-9][0-9]*}} Reg=$sgpr0_sgpr1{{$}}
---
name: carry_e64_to_addc_e64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    $vgpr2, $sgpr0_sgpr1 = V_ADD_CO_U32_e64 $vgpr0, $vgpr1, 0, implicit $exec
    $vgpr3, $sgpr2_sgpr3 = V_ADDC_U32_e64 $vgpr0, $vgpr1, $sgpr0_sgpr1, 0, implicit $exec
    S_ENDPGM 0, implicit $vgpr2, implicit $vgpr3, implicit $sgpr2_sgpr3
...
