# Greedy spills %3 and saves its first value right after the def. The restore
# before the second def is forwarded from that save, which makes the save dead.
# The value must be described in the forwarded register, not in the stack slot
# that is only written after the second def.
--- |
  define void @forwarded_dead_save() !dbg !4 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "t", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !{i32 2, !"Dwarf Version", i32 5}
  !4 = distinct !DISubprogram(name: "forwarded_dead_save", scope: !1, file: !1, line: 1, type: !5, unit: !0, spFlags: DISPFlagDefinition | DISPFlagOptimized)
  !5 = !DISubroutineType(types: !{null})
  !6 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !7 = !DILocalVariable(name: "v1", scope: !4, file: !1, line: 1, type: !6)
  !8 = !DILocalVariable(name: "v2", scope: !4, file: !1, line: 1, type: !6)
  !9 = !DILocalVariable(name: "v3", scope: !4, file: !1, line: 1, type: !6)
  !10 = !DILocalVariable(name: "v5", scope: !4, file: !1, line: 1, type: !6)
  !12 = !DILocation(line: 1, scope: !4)
...
