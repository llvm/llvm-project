# Reusing a failed canReassign search must not change any allocation decision,
# so the test is an equivalence check: the cached run must reproduce the output
# of a run that never caches. The two functions are compiled in one llc
# invocation on purpose, because the cache and the freed-register history it
# reads both outlive a single function.
# RUN: llc -mtriple=amdgpu12.50-amd-amdhsa -run-pass=greedy -stress-regalloc=8 \
# RUN:     -enable-local-reassign=true -regalloc-cache-failed-reassign=false \
# RUN:     -o %t.uncached %s
# RUN: llc -mtriple=amdgpu12.50-amd-amdhsa -run-pass=greedy -stress-regalloc=8 \
# RUN:     -enable-local-reassign=true -o %t.cached %s
# RUN: diff %t.uncached %t.cached

# Forcing the freed-register history to overflow on every unassign drops
# recorded failures instead of rechecking them, which must also not change the
# result.
# RUN: llc -mtriple=amdgpu12.50-amd-amdhsa -run-pass=greedy -stress-regalloc=8 \
# RUN:     -enable-local-reassign=true -live-reg-matrix-freed-history=1 \
# RUN:     -o %t.nohistory %s
# RUN: diff %t.uncached %t.nohistory

# The runs above would still agree if the cache never answered anything, so
# check that it does. Statistics need an assertions build.
# RUN: %if asserts %{ llc -mtriple=amdgpu12.50-amd-amdhsa -run-pass=greedy \
# RUN:     -stress-regalloc=8 -enable-local-reassign=true -stats -o /dev/null \
# RUN:     %s 2>&1 | FileCheck %s %}

# CHECK: canReassign searches answered from a recorded failure

--- |
  define amdgpu_kernel void @failed_reassign_cache() { ret void }
  define amdgpu_kernel void @failed_reassign_cache_tuples() { ret void }
...
---
name: failed_reassign_cache
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = IMPLICIT_DEF
    %3:vgpr_32 = IMPLICIT_DEF
    %4:vgpr_32 = IMPLICIT_DEF
    %5:vgpr_32 = IMPLICIT_DEF
    %6:vgpr_32 = IMPLICIT_DEF
    %7:vgpr_32 = IMPLICIT_DEF
    %8:vgpr_32 = IMPLICIT_DEF
    %9:vgpr_32 = IMPLICIT_DEF
    %10:vgpr_32 = IMPLICIT_DEF
    %11:vgpr_32 = IMPLICIT_DEF
    %12:vgpr_32 = IMPLICIT_DEF
    %13:vgpr_32 = IMPLICIT_DEF
    %14:vgpr_32 = IMPLICIT_DEF
    %15:vgpr_32 = IMPLICIT_DEF
    %16:vgpr_32 = IMPLICIT_DEF
    %17:vgpr_32 = IMPLICIT_DEF
    %18:vgpr_32 = IMPLICIT_DEF
    %19:vgpr_32 = IMPLICIT_DEF
    S_NOP 0, implicit %0, implicit %1
    S_NOP 0, implicit %2, implicit %3
    S_NOP 0, implicit %4, implicit %5
    S_NOP 0, implicit %6, implicit %7
    S_NOP 0, implicit %8, implicit %9
    S_NOP 0, implicit %10, implicit %11
    S_NOP 0, implicit %12, implicit %13
    S_NOP 0, implicit %14, implicit %15
    S_NOP 0, implicit %16, implicit %17
    S_NOP 0, implicit %18, implicit %19
    S_ENDPGM 0
...
---
# Tuple classes make the recheck path do real work: a freed 32-bit register
# only covers part of a wider candidate, so reuse() has to walk aliases of the
# freed register and test each one that appears in the evictee's order. Mixing
# widths means the freed registers and the candidates are different sizes.
name: failed_reassign_cache_tuples
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    %0:vreg_64_align2 = IMPLICIT_DEF
    %1:vreg_64_align2 = IMPLICIT_DEF
    %2:vreg_64_align2 = IMPLICIT_DEF
    %3:vreg_64_align2 = IMPLICIT_DEF
    %4:vreg_64_align2 = IMPLICIT_DEF
    %5:vreg_64_align2 = IMPLICIT_DEF
    %6:vgpr_32 = IMPLICIT_DEF
    %7:vgpr_32 = IMPLICIT_DEF
    %8:vgpr_32 = IMPLICIT_DEF
    %9:vgpr_32 = IMPLICIT_DEF
    %10:vreg_128_align2 = IMPLICIT_DEF
    %11:vreg_128_align2 = IMPLICIT_DEF
    %12:vreg_64_align2 = IMPLICIT_DEF
    %13:vreg_64_align2 = IMPLICIT_DEF
    S_NOP 0, implicit %0, implicit %1
    S_NOP 0, implicit %2, implicit %3
    S_NOP 0, implicit %10
    S_NOP 0, implicit %4, implicit %5
    S_NOP 0, implicit %6, implicit %7
    S_NOP 0, implicit %11
    S_NOP 0, implicit %8, implicit %9
    S_NOP 0, implicit %12, implicit %13
    S_ENDPGM 0
...
