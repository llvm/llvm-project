    %2056:vgpr_32 = V_ADD_U32_e64 %2044, 1, 0, implicit $exec
    S_BRANCH %bb.766

  bb.766:
    successors: %bb.767(0x40000000), %bb.768(0x40000000)

    %2057:vgpr_32 = PHI %2044, %bb.764, %2056, %bb.765
    %2058:sreg_32 = SI_ELSE killed %2055, %bb.768, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.767

  bb.767:
    successors: %bb.768(0x80000000)

    %2059:vgpr_32 = V_MUL_LO_U32_e64 %2044, 2, implicit $exec
    S_BRANCH %bb.768

  bb.768:
    successors: %bb.769(0x80000000)

    %2060:vgpr_32 = PHI %2057, %bb.766, %2059, %bb.767
    SI_END_CF killed %2058, implicit-def dead $exec, implicit-def dead $scc, implicit $exec

  bb.769:

    %2061:vgpr_32 = V_ADD_U32_e64 %2060, %2053, 0, implicit $exec
    %2062:vgpr_32 = V_ADD_U32_e64 %2061, %2044, 0, implicit $exec
    %2063:vgpr_32 = V_ADD_U32_e64 %2062, %2037, 0, implicit $exec
    %2064:sreg_32_xm0 = V_READFIRSTLANE_B32 killed %2063, implicit $exec
    $sgpr0 = COPY killed %2064
    SI_RETURN_TO_EPILOG killed $sgpr0
...
