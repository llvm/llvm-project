# RUN: llc -mtriple=amdgpu9.00 -passes=early-machinelicm -stress-regalloc=6 -o - %s | FileCheck %s --check-prefix=STRESS
# RUN: llc -mtriple=amdgpu9.00 -passes=early-machinelicm -stress-regalloc=8 -o - %s | FileCheck %s --check-prefix=RELAXED
# RUN: llc -mtriple=amdgpu9.00 -passes=early-machinelicm -o - %s | FileCheck %s --check-prefix=RELAXED

# The load remains live from the header into the body. The body starts at
# estimated VGPR pressure 6, so hoisting the COPY would require a seventh unit.
# A stress limit of 6 must keep the COPY in the loop. A limit of 8, or the
# unrestricted target limit, permits the hoist.
--- |
  define void @stress_regalloc_pressure_limit() {
    ret void
  }
...
---
name: stress_regalloc_pressure_limit
tracksRegLiveness: true
