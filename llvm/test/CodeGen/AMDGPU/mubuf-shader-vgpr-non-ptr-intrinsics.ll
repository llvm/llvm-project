; CHECK-NEXT:    v_readfirstlane_b32 s7, v4
; CHECK-NEXT:    v_cmp_eq_u64_e32 vcc, s[4:5], v[1:2]
; CHECK-NEXT:    v_cmp_eq_u64_e64 s[0:1], s[6:7], v[3:4]
