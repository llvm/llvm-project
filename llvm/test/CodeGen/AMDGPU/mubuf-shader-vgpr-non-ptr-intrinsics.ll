; CHECK-NEXT:    ; implicit-def: $vgpr1_vgpr2_vgpr3_vgpr4
; CHECK-NEXT:    s_xor_b64 exec, exec, s[0:1]
; CHECK-NEXT:    s_cbranch_execnz .LBB0_1
; CHECK-NEXT:  ; %bb.2:
