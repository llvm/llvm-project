tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr30_sgpr31

    %2:sreg_64 = COPY $sgpr30_sgpr31
    %1:vreg_64 = COPY $vgpr2_vgpr3
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %3:vgpr_32 = FLAT_LOAD_DWORD %1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))

    %5:sreg_32_xm0 = S_MOV_B32 65535
    %6:sreg_32_xm0 = S_MOV_B32 65535

    %11:vgpr_32 = V_LSHRREV_B32_e64 16, %3, implicit $exec
