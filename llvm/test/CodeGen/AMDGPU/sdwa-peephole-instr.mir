# RUN: llc -mtriple=amdgpu8.03 -run-pass=si-peephole-sdwa -o - %s | FileCheck -check-prefix=VI -check-prefix=GFX89 -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-peephole-sdwa -o - %s | FileCheck -check-prefix=GFX9 -check-prefix=GFX89 -check-prefix=GCN %s

# GFX89-LABEL: {{^}}name: vop1_instructions

