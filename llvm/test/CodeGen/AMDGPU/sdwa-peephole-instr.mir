# GFX9: $vcc = V_CMPX_GT_F32_sdwa 1, %{{[0-9]+}}, 0, %{{[0-9]+}}, 0, 6, 4, implicit-def $exec, implicit $mode, implicit $exec
# GFX9: $vcc = V_CMPX_GT_F32_sdwa 0, %{{[0-9]+}}, 1, %{{[0-9]+}}, 0, 6, 4, implicit-def $exec, implicit $mode, implicit $exec
# GFX9: $vcc = V_CMPX_GT_F32_sdwa 1, %{{[0-9]+}}, 1, %{{[0-9]+}}, 0, 6, 4, implicit-def $exec, implicit $mode, implicit $exec
# GFX9: $vcc = V_CMPX_GT_F32_e64 1, 23, 1, %{{[0-9]+}}, 1, implicit-def $exec, implicit $mode, implicit $exec


name:            vopc_instructions
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr30_sgpr31

    %2:sreg_64 = COPY $sgpr30_sgpr31
    %1:vreg_64 = COPY $vgpr2_vgpr3
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %3:vgpr_32 = FLAT_LOAD_DWORD %1, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32))

    %5:sreg_32_xm0 = S_MOV_B32 65535
    %6:sreg_32_xm0 = S_MOV_B32 65535

    %10:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    V_CMP_EQ_F32_e32 123, %10, implicit-def $vcc, implicit $mode, implicit $exec
    %11:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    V_CMPX_GT_F32_e32 123, %11, implicit-def $vcc, implicit $mode, implicit-def $exec, implicit $exec
    %12:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    V_CMP_LT_I32_e32 123, %12, implicit-def $vcc, implicit $exec
    %13:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    V_CMPX_EQ_I32_e32 123, %13, implicit-def $vcc, implicit-def $exec, implicit $exec

    %14:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMP_EQ_F32_e64 0, %6, 0, %14, 0, implicit $mode, implicit $exec
    %15:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    %18:sreg_64 = V_CMPX_GT_F32_e64 0, 23, 0, %15, 0, implicit-def $exec, implicit $mode, implicit $exec
    %16:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMP_LT_I32_e64 %6, %16, implicit $exec
    %17:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    %19:sreg_64 = V_CMPX_EQ_I32_e64 23, %17, implicit-def $exec, implicit $exec

    %20:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMP_EQ_F32_e64 0, %6, 0, %20, 1, implicit $mode, implicit $exec
    %21:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMPX_GT_F32_e64 0, 23, 0, %21, 0, implicit-def $exec, implicit $mode, implicit $exec
    %23:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMP_EQ_F32_e64 0, %6, 0, %23, 1, implicit $mode, implicit $exec
    %24:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMPX_GT_F32_e64 1, 23, 0, %24, 0, implicit-def $exec, implicit $mode, implicit $exec
    %25:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMPX_GT_F32_e64 0, 23, 1, %25, 0, implicit-def $exec, implicit $mode, implicit $exec
    %26:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMPX_GT_F32_e64 1, 23, 1, %26, 0, implicit-def $exec, implicit $mode, implicit $exec
    %27:vgpr_32 = V_AND_B32_e64 %5, %3, implicit $exec
    $vcc = V_CMPX_GT_F32_e64 1, 23, 1, %27, 1, implicit-def $exec, implicit $mode, implicit $exec


    %100:vgpr_32 = V_MOV_B32_e32 $vcc_lo, implicit $exec

    FLAT_STORE_DWORD %0, %100, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32))
    $sgpr30_sgpr31 = COPY %2
    S_SETPC_B64_return $sgpr30_sgpr31
...

# GCN-LABEL: name: preserve_flags
# GCN: = nnan nofpexcept V_ADD_F32_sdwa 0, %4, 0, %4, 0, 0, 6, 0, 5, 1, implicit $mode, implicit $exec

---
name: preserve_flags
tracksRegLiveness: true

body:             |
  bb.0:
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:sreg_32 = S_MOV_B32 65535
    %2:vgpr_32 = V_LSHRREV_B32_e64 16, %0, implicit $exec
    %3:vgpr_32 = V_AND_B32_e32 %1, %2, implicit $exec
    %4:vgpr_32 = V_LSHLREV_B32_e64 16, %3, implicit $exec
    %5:vgpr_32 = V_LSHRREV_B32_e64 16, %4, implicit $exec
    %6:vgpr_32 = V_BFE_U32_e64 %4, 8, 8, implicit $exec
    %7:vgpr_32 = nnan nofpexcept V_ADD_F32_e32 %5, %6, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %7
...
# GCN-LABEL: name: negative_v_ashrrev_i16
# GCN-NOT: V_XOR_B32_sdwa
# GCN: S_ENDPGM 0
---
# Ensure that V_ASHRREV_I16_* 8, ... instructions are not combined into a sdwa instruction.
# These instructions zero-fill the high 16-bits and thus do not produce a sign-extended
# 8-bit value.

name: negative_v_ashrrev_i16
tracksRegLiveness: true

body:             |
  bb.0:
    liveins: $vgpr0
    liveins: $vgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_ASHRREV_I16_e32 8, %0, implicit $exec
    %3:vgpr_32 = V_XOR_B32_e32 %1, %2, implicit $exec
    %4:vgpr_32 = V_ASHRREV_I16_e64 8, %0, implicit $exec
    %5:vgpr_32 = V_XOR_B32_e32 %1, %4, implicit $exec
    S_ENDPGM 0, implicit %3
...
