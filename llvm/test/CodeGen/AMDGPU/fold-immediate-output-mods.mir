# RUN: llc -mtriple=amdgpu6.00 -run-pass peephole-opt %s -o - | FileCheck -check-prefix=GCN %s
# RUN: llc -mtriple=amdgpu6.00 -passes peephole-opt %s -o - | FileCheck -check-prefix=GCN %s
...
# GCN-LABEL: name: no_fold_imm_madak_mac_clamp_f32
# GCN: %19:vgpr_32 = V_MOV_B32_e32 1090519040, implicit $exec
# GCN-NEXT: %20:vgpr_32 = nofpexcept V_MAC_F32_e64 0, %16, 0, %18, 0, %19, 1, 0, implicit $mode, implicit $exec

name:            no_fold_imm_madak_mac_clamp_f32
tracksRegLiveness: true
liveins:
  - { reg: '$sgpr0_sgpr1', virtual-reg: '%0' }
  - { reg: '$vgpr0', virtual-reg: '%3' }
body:             |
  bb.0:
    liveins: $sgpr0_sgpr1, $vgpr0

    %3:vgpr_32 = COPY $vgpr0
    %0:sgpr_64 = COPY $sgpr0_sgpr1
    %4:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0, 9, 0
    %5:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0, 11, 0
    %6:sreg_64_xexec = S_LOAD_DWORDX2_IMM %0, 13, 0
    %27:vgpr_32 = V_ASHRREV_I32_e32 31, %3, implicit $exec
    %28:vreg_64 = REG_SEQUENCE %3, %subreg.sub0, %27, %subreg.sub1
    %11:sreg_32_xm0 = S_MOV_B32 61440
    %12:sreg_32_xm0 = S_MOV_B32 0
    %13:sgpr_64 = REG_SEQUENCE %12, %subreg.sub0, %11, %subreg.sub1
    %14:sgpr_128 = REG_SEQUENCE %5, %subreg.sub0_sub1, %13, %subreg.sub2_sub3
    %15:sreg_32_xm0 = S_MOV_B32 2
    %29:vreg_64 = V_LSHL_B64_e64 %28, %15, implicit $exec
    %17:sgpr_128 = REG_SEQUENCE %6, %subreg.sub0_sub1, %13, %subreg.sub2_sub3
    %18:sgpr_128 = REG_SEQUENCE %4, %subreg.sub0_sub1, %13, %subreg.sub2_sub3
    %20:vreg_64 = COPY %29
    %19:vgpr_32 = BUFFER_LOAD_DWORD_ADDR64 %20, %14, 0, 0, 0, 0, implicit $exec
    %22:vreg_64 = COPY %29
    %21:vgpr_32 = BUFFER_LOAD_DWORD_ADDR64 %22, %17, 0, 0, 0, 0, implicit $exec
    %23:vgpr_32 = V_MOV_B32_e32 1090519040, implicit $exec
    %24:vgpr_32 = nofpexcept V_MAC_F32_e64 0, %19, 0, %21, 0, %23, 1, 0, implicit $mode, implicit $exec
    %26:vreg_64 = COPY %29
    BUFFER_STORE_DWORD_ADDR64 %24, %26, %18, 0, 0, 0, 0, implicit $exec
    S_ENDPGM 0

...
---
