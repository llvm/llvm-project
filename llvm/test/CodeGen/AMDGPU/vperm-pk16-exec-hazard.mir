    ; GFX1310: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; GFX1310-NEXT: S_WAIT_EXPCNT 0
    ; GFX1310-NEXT: S_WAIT_SAMPLECNT 0
