# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -start-before=machine-scheduler -stop-after=regallocfast,0 -sgpr-regalloc=fast -verify-misched -o - %s | FileCheck %s

# The machine scheduler recomputes read-undef flags for subregister defs. It
# must not mark the tied read-undef which its tied use reads a defined value.

---
name: tied_fmac_subreg_sched
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr4_sgpr5

    ; The tied FMAC def must NOT be read-undef (no "undef" prefix). Anchor to the
    ; start of the line content so a stray leading "undef " fails the match.
    ; CHECK-LABEL: name: tied_fmac_subreg_sched
    ; CHECK: liveins: $sgpr4_sgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $sgpr0_sgpr1 = S_LOAD_DWORDX2_IMM killed renamable $sgpr4_sgpr5, 0, 0 :: (dereferenceable invariant load (s64), align 16, addrspace 4)
    ; CHECK-NEXT: undef [[V_MOV_B32_e32_:%[0-9]+]].sub1:vreg_128 = V_MOV_B32_e32 0, implicit $exec
    ; CHECK-NEXT: renamable $sgpr1 = nofpexcept S_FMAC_F32 0, 0, renamable $sgpr1, implicit $mode
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]].sub0:vreg_128 = COPY renamable $sgpr1, implicit killed $sgpr0_sgpr1
    ; CHECK-NEXT: DS_WRITE_B128_gfx9 [[V_MOV_B32_e32_]].sub1, [[V_MOV_B32_e32_]], 0, 0, implicit $exec :: (store (s128) into `ptr addrspace(3) null`, addrspace 3)
    ; CHECK-NEXT: S_ENDPGM 0
    %3:sgpr_64 = COPY $sgpr4_sgpr5
    %5:sgpr_64 = S_LOAD_DWORDX2_IMM %3, 0, 0 :: (dereferenceable invariant load (s64), align 16, addrspace 4)
    %5.sub1:sgpr_64 = nofpexcept S_FMAC_F32 0, 0, %5.sub1, implicit $mode
    undef %12.sub0:vreg_128 = COPY %5.sub1
    %12.sub1:vreg_128 = V_MOV_B32_e32 0, implicit $exec
    %12.sub2:vreg_128 = COPY %12.sub1
    %12.sub3:vreg_128 = COPY %12.sub1
    DS_WRITE_B128_gfx9 %12.sub1, %12, 0, 0, implicit $exec :: (store (s128) into `ptr addrspace(3) null`, addrspace 3)
    S_ENDPGM 0
...
