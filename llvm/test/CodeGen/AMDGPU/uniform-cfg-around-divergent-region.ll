; Uniform control flow around a region containing divergent control flow does
; not need to be structurized. Check that only the divergent if manipulates
; exec and that the uniform branches are scalar branches on SCC.

; Two uniform branches at the outer level, one of which jumps to the exit of a
; sub-region containing a divergent if.
define amdgpu_cs void @uniform_unstructured_around_nonuniform_subregion(i32 inreg %u1, i32 inreg %u2, i32 %v, ptr addrspace(1) %out) {
; CHECK-LABEL: uniform_unstructured_around_nonuniform_subregion:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_cmp_lg_u32 s0, 0
; CHECK-NEXT:    s_cbranch_scc0 .LBB0_3
; CHECK-NEXT:  ; %bb.1: ; %B
; CHECK-NEXT:    s_cmp_lg_u32 s1, 0
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_6
; CHECK-NEXT:  ; %bb.2: ; %B1
; CHECK-NEXT:    v_mov_b32_e32 v0, 2
; CHECK-NEXT:    global_store_b32 v[1:2], v0, off
; CHECK-NEXT:    s_endpgm
; CHECK-NEXT:  .LBB0_3: ; %A
; CHECK-NEXT:    s_mov_b32 s0, exec_lo
; CHECK-NEXT:    v_cmpx_eq_u32_e32 0, v0
; CHECK-NEXT:    s_cbranch_execz .LBB0_5
; CHECK-NEXT:  ; %bb.4: ; %A.then
; CHECK-NEXT:    v_mov_b32_e32 v0, 1
; CHECK-NEXT:    global_store_b32 v[1:2], v0, off
; CHECK-NEXT:  .LBB0_5: ; %Flow
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s0
; CHECK-NEXT:  .LBB0_6: ; %A.end
; CHECK-NEXT:    v_mov_b32_e32 v0, 3
; CHECK-NEXT:    global_store_b32 v[1:2], v0, off
; CHECK-NEXT:    s_endpgm
entry:
  %c1 = icmp eq i32 %u1, 0
  br i1 %c1, label %A, label %B

A:
  %d = icmp eq i32 %v, 0
  br i1 %d, label %A.then, label %A.end

A.then:
  store i32 1, ptr addrspace(1) %out
  br label %A.end

A.end:
  store i32 3, ptr addrspace(1) %out
  br label %end

B:
  %c2 = icmp eq i32 %u2, 0
  br i1 %c2, label %B1, label %A.end

B1:
  store i32 2, ptr addrspace(1) %out
  br label %end

end:
  ret void
}

; A uniform loop around a sub-region containing a divergent if. The loop body
; has a second uniform branch that jumps to the exit of the sub-region.
define amdgpu_cs void @uniform_loop_around_nonuniform_subregion(i32 inreg %n, i32 inreg %u, i32 %v, ptr addrspace(1) %out) {
; CHECK-LABEL: uniform_loop_around_nonuniform_subregion:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    v_mov_b32_e32 v3, 3
; CHECK-NEXT:    s_mov_b32 s2, 0
; CHECK-NEXT:    s_branch .LBB1_4
; CHECK-NEXT:    .p2align 6
; CHECK-NEXT:  .LBB1_1: ; %Flow
; CHECK-NEXT:    ; in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    s_or_b32 exec_lo, exec_lo, s3
; CHECK-NEXT:  .LBB1_2: ; %div.end
; CHECK-NEXT:    ; in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    global_store_b32 v[1:2], v3, off
; CHECK-NEXT:  .LBB1_3: ; %latch
; CHECK-NEXT:    ; in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    s_add_i32 s2, s2, 1
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    s_cmp_lt_u32 s2, s0
; CHECK-NEXT:    s_cbranch_scc0 .LBB1_8
; CHECK-NEXT:  .LBB1_4: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_cmp_lg_u32 s1, s2
; CHECK-NEXT:    s_cbranch_scc1 .LBB1_7
; CHECK-NEXT:  ; %bb.5: ; %div
; CHECK-NEXT:    ; in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    s_mov_b32 s3, exec_lo
; CHECK-NEXT:    v_cmpx_eq_u32_e32 s2, v0
; CHECK-NEXT:    s_cbranch_execz .LBB1_1
; CHECK-NEXT:  ; %bb.6: ; %div.then
; CHECK-NEXT:    ; in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    v_mov_b32_e32 v4, s2
; CHECK-NEXT:    global_store_b32 v[1:2], v4, off
; CHECK-NEXT:    s_branch .LBB1_1
; CHECK-NEXT:    .p2align 6
; CHECK-NEXT:  .LBB1_7: ; %other
; CHECK-NEXT:    ; in Loop: Header=BB1_4 Depth=1
; CHECK-NEXT:    s_cmp_eq_u32 s2, 7
; CHECK-NEXT:    s_cbranch_scc1 .LBB1_2
; CHECK-NEXT:    s_branch .LBB1_3
; CHECK-NEXT:  .LBB1_8: ; %exit
; CHECK-NEXT:    s_endpgm
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.inc, %latch ]
  %c = icmp eq i32 %i, %u
  br i1 %c, label %div, label %other

div:
  %d = icmp eq i32 %v, %i
  br i1 %d, label %div.then, label %div.end

div.then:
  store i32 %i, ptr addrspace(1) %out
  br label %div.end

div.end:
  store i32 3, ptr addrspace(1) %out
  br label %latch

other:
  %e = icmp eq i32 %i, 7
  br i1 %e, label %div.end, label %latch

latch:
  %i.inc = add i32 %i, 1
  %cont = icmp ult i32 %i.inc, %n
  br i1 %cont, label %loop, label %exit

exit:
  ret void
}

