# This testcase cannot be compiled. An attempted eviction legality
# check was inconsistent with a later assertion when the eviction was
# performed.

# ERR: error: <unknown>:0:0: ran out of registers during register allocation

--- |
  define void @foo() #0 {
    ret void
  }

  attributes #0 = { "amdgpu-waves-per-eu"="8,8" }

...

# CHECK: S_NOP 0, implicit-def renamable $vgpr4_512, implicit-def renamable $vgpr20_256, implicit-def $vgpr0_128, implicit-def renamable $vgpr28_128, implicit-def renamable $vgpr0_128
# CHECK: S_NOP 0, implicit killed renamable $vgpr4_512, implicit killed renamable $vgpr20_256, implicit undef $vgpr0_128, implicit killed renamable $vgpr28_128, implicit killed renamable $vgpr0_128

---
name:            foo
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg:  '$sgpr0_128'
  frameOffsetReg:  '$sgpr33'
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0:
    S_NOP 0, implicit-def %0:vreg_512, implicit-def %1:vreg_256, implicit-def %2:vreg_128, implicit-def %3:vreg_128, implicit-def %4:vreg_128

    S_NOP 0, implicit %0, implicit %1, implicit %2, implicit %3, implicit %4
    S_ENDPGM 0

...
