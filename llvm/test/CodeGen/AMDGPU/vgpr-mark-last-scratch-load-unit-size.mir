# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.00 -run-pass=amdgpu-mark-last-scratch-load -verify-machineinstrs -o - %s | FileCheck -check-prefix=UNIT4 %s
# RUN: llc -mtriple=amdgpu12.00 -run-pass=amdgpu-mark-last-scratch-load -amdgpu-mark-last-scratch-load-unit-size=2 -verify-machineinstrs -o - %s | FileCheck -check-prefix=UNIT2 %s
# RUN: llc -mtriple=amdgpu12.00 -passes=amdgpu-mark-last-scratch-load -amdgpu-mark-last-scratch-load-unit-size=2 -verify-machineinstrs -o - %s | FileCheck -check-prefix=UNIT2 %s

# 16-bit spills only overwrite half a dword. With 4 byte units a 16-bit store
# kills nothing, so the reload before it is not marked as the last use.

# 2-byte spill slot, as created for a VGPR_16 spill.
---
name: slot_2_bytes
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0
    ; UNIT4-LABEL: name: slot_2_bytes
    ; UNIT4: liveins: $vgpr0
    ; UNIT4-NEXT: {{  $}}
    ; UNIT4-NEXT: SCRATCH_STORE_SHORT_SADDR_t16 $vgpr0_lo16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    ; UNIT4-NEXT: $vgpr1_lo16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (load (s16) from %stack.0, addrspace 5)
    ; UNIT4-NEXT: SCRATCH_STORE_SHORT_SADDR_t16 $vgpr0_hi16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    ; UNIT4-NEXT: $vgpr1_hi16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s16) from %stack.0, addrspace 5)
    ; UNIT4-NEXT: S_ENDPGM 0
    ;
    ; UNIT2-LABEL: name: slot_2_bytes
    ; UNIT2: liveins: $vgpr0
    ; UNIT2-NEXT: {{  $}}
    ; UNIT2-NEXT: SCRATCH_STORE_SHORT_SADDR_t16 $vgpr0_lo16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    ; UNIT2-NEXT: $vgpr1_lo16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s16) from %stack.0, addrspace 5)
    ; UNIT2-NEXT: SCRATCH_STORE_SHORT_SADDR_t16 $vgpr0_hi16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    ; UNIT2-NEXT: $vgpr1_hi16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s16) from %stack.0, addrspace 5)
    ; UNIT2-NEXT: S_ENDPGM 0
    SCRATCH_STORE_SHORT_SADDR_t16 $vgpr0_lo16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    $vgpr1_lo16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (load (s16) from %stack.0, addrspace 5)
    SCRATCH_STORE_SHORT_SADDR_t16 $vgpr0_hi16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    $vgpr1_hi16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (load (s16) from %stack.0, addrspace 5)
    S_ENDPGM 0
...

# 4-byte slot reused for a 16-bit value, as after stack slot coloring.
---
name: slot_4_bytes_reused_for_16_bits
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; UNIT4-LABEL: name: slot_4_bytes_reused_for_16_bits
    ; UNIT4: liveins: $vgpr0, $vgpr1
    ; UNIT4-NEXT: {{  $}}
    ; UNIT4-NEXT: SCRATCH_STORE_DWORD_SADDR $vgpr0, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    ; UNIT4-NEXT: $vgpr2 = SCRATCH_LOAD_DWORD_SADDR $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    ; UNIT4-NEXT: SCRATCH_STORE_SHORT_SADDR_t16 $vgpr1_lo16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    ; UNIT4-NEXT: $vgpr3_lo16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s16) from %stack.0, addrspace 5)
    ; UNIT4-NEXT: S_ENDPGM 0
    ;
    ; UNIT2-LABEL: name: slot_4_bytes_reused_for_16_bits
    ; UNIT2: liveins: $vgpr0, $vgpr1
    ; UNIT2-NEXT: {{  $}}
    ; UNIT2-NEXT: SCRATCH_STORE_DWORD_SADDR $vgpr0, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    ; UNIT2-NEXT: $vgpr2 = SCRATCH_LOAD_DWORD_SADDR $sgpr32, 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s32) from %stack.0, addrspace 5)
    ; UNIT2-NEXT: SCRATCH_STORE_SHORT_SADDR_t16 $vgpr1_lo16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    ; UNIT2-NEXT: $vgpr3_lo16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 3, implicit $exec, implicit $flat_scr :: ("amdgpu-last-use" load (s16) from %stack.0, addrspace 5)
    ; UNIT2-NEXT: S_ENDPGM 0
    SCRATCH_STORE_DWORD_SADDR $vgpr0, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s32) into %stack.0, addrspace 5)
    $vgpr2 = SCRATCH_LOAD_DWORD_SADDR $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (load (s32) from %stack.0, addrspace 5)
    SCRATCH_STORE_SHORT_SADDR_t16 $vgpr1_lo16, $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (store (s16) into %stack.0, addrspace 5)
    $vgpr3_lo16 = SCRATCH_LOAD_SHORT_D16_SADDR_t16 $sgpr32, 0, 0, implicit $exec, implicit $flat_scr :: (load (s16) from %stack.0, addrspace 5)
    S_ENDPGM 0
...
