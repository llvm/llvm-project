; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; Test that MMRA local fences in single-wave workgroups keep the LDS/DS wait
; after workgroup scope is demoted to wavefront scope. Global-only MMRA fences
; should not gain an LDS/DS wait.

; RUN: llc -mtriple=amdgcn-amd-amdhsa -O0 -mcpu=gfx942 < %s | FileCheck --check-prefix=GFX942 %s
; RUN: llc -mtriple=amdgcn-amd-amdhsa -O0 -mcpu=gfx1200 < %s | FileCheck --check-prefix=GFX12 %s

define amdgpu_kernel void @workgroup_release_local_fence_single_wave() #0 {
; GFX942-LABEL: workgroup_release_local_fence_single_wave:
; GFX942:       ; %bb.0: ; %entry
; GFX942-NEXT:    s_waitcnt lgkmcnt(0)
; GFX942-NEXT:    s_endpgm
;
; GFX12-LABEL: workgroup_release_local_fence_single_wave:
; GFX12:       ; %bb.0: ; %entry
; GFX12-NEXT:    s_wait_dscnt 0x0
; GFX12-NEXT:    s_endpgm
entry:
  fence syncscope("workgroup") release, !mmra !{!"amdgpu-synchronize-as", !"local"}
  ret void
}

define amdgpu_kernel void @workgroup_release_global_local_fence_single_wave() #0 {
; GFX942-LABEL: workgroup_release_global_local_fence_single_wave:
; GFX942:       ; %bb.0: ; %entry
; GFX942-NEXT:    s_waitcnt lgkmcnt(0)
; GFX942-NEXT:    s_endpgm
;
; GFX12-LABEL: workgroup_release_global_local_fence_single_wave:
; GFX12:       ; %bb.0: ; %entry
; GFX12-NEXT:    s_wait_dscnt 0x0
; GFX12-NEXT:    s_endpgm
entry:
  fence syncscope("workgroup") release, !mmra !0
  ret void
}

define amdgpu_kernel void @workgroup_acquire_local_fence_single_wave() #0 {
; GFX942-LABEL: workgroup_acquire_local_fence_single_wave:
; GFX942:       ; %bb.0: ; %entry
; GFX942-NEXT:    s_waitcnt lgkmcnt(0)
; GFX942-NEXT:    s_endpgm
;
; GFX12-LABEL: workgroup_acquire_local_fence_single_wave:
; GFX12:       ; %bb.0: ; %entry
; GFX12-NEXT:    s_wait_dscnt 0x0
; GFX12-NEXT:    s_endpgm
entry:
  fence syncscope("workgroup") acquire, !mmra !{!"amdgpu-synchronize-as", !"local"}
  ret void
}

define amdgpu_kernel void @workgroup_release_global_fence_single_wave() #0 {
; GFX942-LABEL: workgroup_release_global_fence_single_wave:
; GFX942:       ; %bb.0: ; %entry
; GFX942-NEXT:    s_endpgm
;
; GFX12-LABEL: workgroup_release_global_fence_single_wave:
; GFX12:       ; %bb.0: ; %entry
; GFX12-NEXT:    s_endpgm
entry:
  fence syncscope("workgroup") release, !mmra !{!"amdgpu-synchronize-as", !"global"}
  ret void
}

; 32 threads is a single-wave workgroup on both gfx942 (wave64) and gfx1200
; (wave32), so no RUN line needs to force wave64.
attributes #0 = { "amdgpu-flat-work-group-size"="32,32" nounwind }

!0 = !{!1, !2}
!1 = !{!"amdgpu-synchronize-as", !"global"}
!2 = !{!"amdgpu-synchronize-as", !"local"}
