# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=peephole-opt -o - %s | FileCheck %s

# Compares of (S_CSELECT* A, B) against A or B, where A != B, recompute SCC or
# its inverse.

# sel == 1 iff SCC, so s_cmp_lg sel, 1 is !SCC.
---
name:            cselect_b32_1_0_cmp_lg_1
body:             |
  ; CHECK-LABEL: name: cselect_b32_1_0_cmp_lg_1
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   S_CMP_LG_U32 [[COPY]], 0, implicit-def $scc
  ; CHECK-NEXT:   [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $sgpr0

    %0:sreg_32 = COPY $sgpr0
    S_CMP_LG_U32 %0, 0, implicit-def $scc
    %1:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
    S_CMP_LG_U32 %1, 1, implicit-def $scc
    S_CBRANCH_SCC0 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    S_ENDPGM 0

  bb.2:
    S_ENDPGM 0
...

