  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_15]], [[COPY2]], [[COPY1]], $sgpr_null, 316, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
