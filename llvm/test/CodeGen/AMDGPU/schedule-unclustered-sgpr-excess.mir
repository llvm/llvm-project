  ; CHECK-NEXT:   [[V_FMA_F32_e64_14:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN14]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN14]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_15:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN15]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN15]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_]], [[COPY2]], [[COPY1]], $sgpr_null, 256, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_1]], [[COPY2]], [[COPY1]], $sgpr_null, 260, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_2]], [[COPY2]], [[COPY1]], $sgpr_null, 264, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_3]], [[COPY2]], [[COPY1]], $sgpr_null, 268, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_4]], [[COPY2]], [[COPY1]], $sgpr_null, 272, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_5]], [[COPY2]], [[COPY1]], $sgpr_null, 276, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_6]], [[COPY2]], [[COPY1]], $sgpr_null, 280, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_7]], [[COPY2]], [[COPY1]], $sgpr_null, 284, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   BUFFER_STORE_DWORD_VBUFFER_IDXEN [[V_FMA_F32_e64_8]], [[COPY2]], [[COPY1]], $sgpr_null, 288, 0, 0, implicit $exec :: (dereferenceable store (s32), align 1, addrspace 8)
