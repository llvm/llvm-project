# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu12.01 -run-pass=machine-scheduler -verify-machineinstrs -o - %s | FileCheck %s

# The scalar loads in bb.0 are used in bb.2, so they are live through bb.1 and
# push its SGPR pressure over the limit, while VGPR pressure stays low. The
# unclustered reschedule then serializes the buffer loads in bb.1 to reduce
# VGPR pressure, which does not help because only SGPRs are in excess. Excess
# SGPRs spill to VGPR lanes, so the schedule metric should still be applied,
# and here it reverts to the initial schedule with all loads clustered.

---
name: sgpr_excess_only
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 16
body: |
  ; CHECK-LABEL: name: sgpr_excess_only
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1_sgpr2_sgpr3, $sgpr4_sgpr5_sgpr6_sgpr7, $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr_128 = COPY $sgpr0_sgpr1_sgpr2_sgpr3
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr_128 = COPY $sgpr4_sgpr5_sgpr6_sgpr7
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 0, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM1:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 64, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM2:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 128, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM3:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 192, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM4:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 256, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM5:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 320, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT:   [[S_BUFFER_LOAD_DWORDX16_IMM6:%[0-9]+]]:sgpr_512 = S_BUFFER_LOAD_DWORDX16_IMM [[COPY]], 384, 0 :: (dereferenceable invariant load (s512), align 4)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 0, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN1:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 4, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN2:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 8, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN3:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 12, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN4:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 16, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN5:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 20, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN6:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 24, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN7:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 28, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN8:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 32, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN9:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 36, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN10:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 40, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN11:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 44, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN12:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 48, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN13:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 52, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN14:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 56, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN15:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_VBUFFER_IDXEN [[COPY2]], [[COPY1]], $sgpr_null, 60, 0, 0, implicit $exec :: (dereferenceable invariant load (s32), align 1, addrspace 8)
  ; CHECK-NEXT:   [[V_FMA_F32_e64_:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_1:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN1]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN1]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_2:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN2]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN2]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_3:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN3]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN3]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_4:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN4]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN4]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_5:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN5]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN5]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_6:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN6]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN6]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_7:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN7]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN7]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_8:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN8]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN8]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_9:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN9]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN9]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_10:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN10]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN10]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_11:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN11]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN11]], 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[V_FMA_F32_e64_12:%[0-9]+]]:vgpr_32 = nofpexcept V_FMA_F32_e64 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN12]], 0, [[COPY3]], 0, [[BUFFER_LOAD_DWORD_VBUFFER_IDXEN12]], 0, 0, implicit $mode, implicit $exec
