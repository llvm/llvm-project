# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes=machine-scheduler -misched-prera-direction=topdown -verify-misched -o - %s | FileCheck %s

# The scheduler moves the second V_PERMLANE32_SWAP_B32_e32 up across the
# first one. Its def of %2.sub0 is never read, so handleMoveUp splits the main
# range of %2 at the new position. The segment of the dead def of %2.sub1 by
# the first V_PERMLANE32_SWAP_B32_e32 must keep its own value number.

---
name:            dead_subreg_def_move_up_across_def
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3

    ; CHECK-LABEL: name: dead_subreg_def_move_up_across_def
    ; CHECK: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vreg_64_align2 = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vreg_64_align2 = COPY $vgpr2_vgpr3
    ; CHECK-NEXT: [[GLOBAL_LOAD_DWORDX2_:%[0-9]+]]:vreg_64_align2 = GLOBAL_LOAD_DWORDX2 [[COPY]], 0, 0, implicit $exec
    ; CHECK-NEXT: undef [[V_MOV_B32_e32_:%[0-9]+]].sub0:vreg_64_align2 = V_MOV_B32_e32 1, implicit $exec
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]].sub1:vreg_64_align2 = V_MOV_B32_e32 2, implicit $exec
    ; CHECK-NEXT: [[COPY1:%[0-9]+]].sub0:vreg_64_align2, [[V_MOV_B32_e32_:%[0-9]+]].sub0:vreg_64_align2 = V_PERMLANE32_SWAP_B32_e32 [[COPY1]].sub0, [[V_MOV_B32_e32_]].sub0, implicit $exec
    ; CHECK-NEXT: [[GLOBAL_LOAD_DWORDX2_:%[0-9]+]].sub1:vreg_64_align2, dead undef [[V_MOV_B32_e32_:%[0-9]+]].sub1:vreg_64_align2 = V_PERMLANE32_SWAP_B32_e32 [[GLOBAL_LOAD_DWORDX2_]].sub1, [[V_MOV_B32_e32_]].sub1, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX2 [[COPY]], [[GLOBAL_LOAD_DWORDX2_]], 0, 0, implicit $exec
    ; CHECK-NEXT: GLOBAL_STORE_DWORDX2 [[COPY]], [[COPY1]], 8, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    %0:vreg_64_align2 = COPY $vgpr0_vgpr1
    %1:vreg_64_align2 = GLOBAL_LOAD_DWORDX2 %0, 0, 0, implicit $exec
    undef %2.sub0:vreg_64_align2 = V_MOV_B32_e32 1, implicit $exec
    %2.sub1:vreg_64_align2 = V_MOV_B32_e32 2, implicit $exec
    %3:vreg_64_align2 = COPY $vgpr2_vgpr3
    %1.sub1:vreg_64_align2, dead %2.sub1:vreg_64_align2 = V_PERMLANE32_SWAP_B32_e32 %1.sub1, %2.sub1, implicit $exec
    %3.sub0:vreg_64_align2, %2.sub0:vreg_64_align2 = V_PERMLANE32_SWAP_B32_e32 %3.sub0, %2.sub0, implicit $exec
    GLOBAL_STORE_DWORDX2 %0, %1, 0, 0, implicit $exec
    GLOBAL_STORE_DWORDX2 %0, %3, 8, 0, implicit $exec
    S_ENDPGM 0
...
