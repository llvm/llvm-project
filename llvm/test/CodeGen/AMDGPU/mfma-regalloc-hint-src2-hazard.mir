# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=greedy,virtregrewriter,post-RA-hazard-rec -verify-machineinstrs -o - %s | FileCheck %s

# A write right after an MFMA needs wait states when it reuses the register
# the MFMA reads as its accumulator.

---
name: write_after_mfma_chain
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8, $agpr0_agpr1_agpr2_agpr3
    ; CHECK-LABEL: name: write_after_mfma_chain
    ; CHECK: liveins: $vgpr8, $agpr0_agpr1_agpr2_agpr3, $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_16X16X32_F16_e64 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, 0, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: KILL $agpr0_agpr1_agpr2_agpr3
    ; CHECK-NEXT: renamable $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_16X16X32_F16_e64 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, killed $agpr4_agpr5_agpr6_agpr7, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: renamable $agpr0 = V_ACCVGPR_WRITE_B32_e64 $vgpr8, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit killed renamable $agpr4_agpr5_agpr6_agpr7, implicit killed renamable $agpr0
    %acc:areg_128_align2 = V_MFMA_F32_16X16X32_F16_e64 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, 0, 0, 0, 0, implicit $mode, implicit $exec
    KILL killed $agpr0_agpr1_agpr2_agpr3
    %t:areg_128_align2 = V_MFMA_F32_16X16X32_F16_e64 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, %acc, 0, 0, 0, implicit $mode, implicit $exec
    %w:agpr_32 = V_ACCVGPR_WRITE_B32_e64 $vgpr8, implicit $exec
    S_ENDPGM 0, implicit %t, implicit %w
...

---
name: write_after_mfma_on_copy
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8, $agpr0_agpr1_agpr2_agpr3, $agpr4_agpr5_agpr6_agpr7
    ; CHECK-LABEL: name: write_after_mfma_on_copy
    ; CHECK: liveins: $vgpr8, $agpr0_agpr1_agpr2_agpr3, $agpr4_agpr5_agpr6_agpr7, $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: KILL $agpr0_agpr1_agpr2_agpr3
    ; CHECK-NEXT: renamable $agpr4_agpr5_agpr6_agpr7 = V_MFMA_F32_16X16X32_F16_e64 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, killed $agpr4_agpr5_agpr6_agpr7, 0, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: renamable $agpr0 = V_ACCVGPR_WRITE_B32_e64 $vgpr8, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit killed renamable $agpr4_agpr5_agpr6_agpr7, implicit killed renamable $agpr0
    %acc:areg_128_align2 = COPY $agpr4_agpr5_agpr6_agpr7
    KILL killed $agpr0_agpr1_agpr2_agpr3
    %t:areg_128_align2 = V_MFMA_F32_16X16X32_F16_e64 $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, %acc, 0, 0, 0, implicit $mode, implicit $exec
    %w:agpr_32 = V_ACCVGPR_WRITE_B32_e64 $vgpr8, implicit $exec
    S_ENDPGM 0, implicit %t, implicit %w
...
