name: uniform_loop_exit_still_copies
isSSA: true
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: uniform_loop_exit_still_copies
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
