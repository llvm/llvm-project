  bb.0:
    liveins: $vgpr0
    ; GFX12-LABEL: name: vop3_inline_imm_src0
    ; GFX12: liveins: $vgpr0
    ; GFX12-NEXT: {{  $}}
    ; GFX12-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; GFX12-NEXT: [[V_MUL_LO_U32_e64_:%[0-9]+]]:vgpr_32 = V_MUL_LO_U32_e64 [[COPY]], 64, implicit $exec
    ; GFX12-NEXT: S_ENDPGM 0, implicit [[V_MUL_LO_U32_e64_]], implicit [[V_MUL_LO_U32_e64_]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_MUL_LO_U32_e64 %0, 64, implicit $exec
    %2:vgpr_32 = V_MUL_LO_U32_e64 64, %0, implicit $exec
    S_ENDPGM 0, implicit %1, implicit %2
...

---
name:            vop3_frame_index_src0
tracksRegLiveness: true
stack:
  - { id: 0, size: 4, alignment: 4 }
body:             |
  bb.0:
    liveins: $vgpr0
    ; GFX12-LABEL: name: vop3_frame_index_src0
    ; GFX12: liveins: $vgpr0
    ; GFX12-NEXT: {{  $}}
    ; GFX12-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; GFX12-NEXT: [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 %stack.0, [[COPY]], 0, implicit $exec
    ; GFX12-NEXT: S_ENDPGM 0, implicit [[V_ADD_U32_e64_]], implicit [[V_ADD_U32_e64_]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_ADD_U32_e64 %0, %stack.0, 0, implicit $exec
    %2:vgpr_32 = V_ADD_U32_e64 %stack.0, %0, 0, implicit $exec
