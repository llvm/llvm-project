  bb.0:
    liveins: $vgpr0
    ; GFX12-LABEL: name: vop3_literal_src0_first
    ; GFX12: liveins: $vgpr0
    ; GFX12-NEXT: {{  $}}
    ; GFX12-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; GFX12-NEXT: [[V_MUL_LO_U32_e64_:%[0-9]+]]:vgpr_32 = V_MUL_LO_U32_e64 7680, [[COPY]], implicit $exec
    ; GFX12-NEXT: S_ENDPGM 0, implicit [[V_MUL_LO_U32_e64_]], implicit [[V_MUL_LO_U32_e64_]]
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_MUL_LO_U32_e64 7680, %0, implicit $exec
    %2:vgpr_32 = V_MUL_LO_U32_e64 %0, 7680, implicit $exec
    S_ENDPGM 0, implicit %1, implicit %2
...

