    %0:vgpr_16 = IMPLICIT_DEF
    %1:sreg_32 = IMPLICIT_DEF
    %2:areg_64 = IMPLICIT_DEF
    %3:vreg_128 = IMPLICIT_DEF
    %4:sgpr_128 = IMPLICIT_DEF
    %5:vgpr_32 = SI_LO16_TO_VGPR32 killed %0, implicit $exec
    %6:vgpr_32 = SI_LO16_TO_VGPR32 killed %1, implicit $exec
