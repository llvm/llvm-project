# RUN: llc -mtriple=amdgpu9.0a -passes=finalize-isel -o - %s | FileCheck %s

---
name: lo16_to_vgpr32
body: |
  bb.0:
    ; CHECK-LABEL: name: lo16_to_vgpr32
    ; CHECK: [[DEF:%[0-9]+]]:vgpr_16 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:sreg_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF2:%[0-9]+]]:vgpr_16_lo128 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF3:%[0-9]+]]:vgpr_16_lo16 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF4:%[0-9]+]]:vgpr_32_lo128 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF5:%[0-9]+]]:vgpr_32_lo128 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF6:%[0-9]+]]:vreg_128_align2 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF7:%[0-9]+]]:vreg_128_align2 = IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF8:%[0-9]+]]:vgpr_16 = IMPLICIT_DEF
    ; CHECK-NEXT: [[REG_SEQUENCE:%[0-9]+]]:vgpr_32 = REG_SEQUENCE [[DEF]], %subreg.lo16, [[DEF8]], %subreg.hi16
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY [[DEF1]]
    ; CHECK-NEXT: [[DEF9:%[0-9]+]]:vgpr_16 = IMPLICIT_DEF
    ; CHECK-NEXT: [[REG_SEQUENCE1:%[0-9]+]]:vgpr_32 = REG_SEQUENCE [[DEF2]], %subreg.lo16, [[DEF9]], %subreg.hi16
    ; CHECK-NEXT: [[DEF10:%[0-9]+]]:vgpr_16 = IMPLICIT_DEF
    ; CHECK-NEXT: [[REG_SEQUENCE2:%[0-9]+]]:vgpr_32 = REG_SEQUENCE [[DEF3]], %subreg.lo16, [[DEF10]], %subreg.hi16
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY [[DEF4]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[DEF5]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:vgpr_32 = COPY [[DEF6]].sub2
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[DEF7]].sub3
    %0:vgpr_16 = IMPLICIT_DEF
    %1:sreg_32 = IMPLICIT_DEF
    %2:vgpr_16_lo128 = IMPLICIT_DEF
    %3:vgpr_16_lo16 = IMPLICIT_DEF
    %4:vgpr_32_lo128 = IMPLICIT_DEF
    %5:vgpr_32_lo128 = IMPLICIT_DEF
    %6:vreg_128 = IMPLICIT_DEF
    %7:vreg_128 = IMPLICIT_DEF
    %8:vgpr_32 = SI_LO16_TO_VGPR32 %0, implicit $exec
    %9:vgpr_32 = SI_LO16_TO_VGPR32 %1, implicit $exec
    %10:vgpr_32 = SI_LO16_TO_VGPR32 %2, implicit $exec
    %11:vgpr_32 = SI_LO16_TO_VGPR32 %3, implicit $exec
    %12:vgpr_32 = SI_LO16_TO_VGPR32 %4, implicit $exec
    %13:vgpr_32 = SI_LO16_TO_VGPR32 %5, implicit $exec
    %14:vgpr_32 = SI_LO16_TO_VGPR32 %6.sub2, implicit $exec
    %15:vgpr_32 = SI_LO16_TO_VGPR32 %7.sub3, implicit $exec
...

