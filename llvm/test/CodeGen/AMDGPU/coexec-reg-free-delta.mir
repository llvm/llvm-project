# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -amdgpu-sched-strategy=coexec %s -o - | FileCheck %s

# Both instructions read one register that dies there. %wide also defines a
# register twice as wide, so it grows the register file by one while %narrow
# keeps it level: %narrow ranks ahead although %wide comes first in the source.

--- |
  define void @wide_def_is_not_a_free() #0 { ret void }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name: wide_def_is_not_a_free
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: wide_def_is_not_a_free
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: %r:vgpr_32 = COPY $vgpr1
    ; CHECK-NEXT: %narrow:vgpr_32 = V_MOV_B32_e32 %r, implicit $exec
    ; CHECK-NEXT: %wide:vreg_64_align2 = nofpexcept V_CVT_F64_F32_e32 %x, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0, implicit %wide, implicit %narrow
    %x:vgpr_32 = COPY $vgpr0
    %r:vgpr_32 = COPY $vgpr1
    %wide:vreg_64_align2 = nofpexcept V_CVT_F64_F32_e32 %x, implicit $mode, implicit $exec
    %narrow:vgpr_32 = V_MOV_B32_e32 %r, implicit $exec

    S_ENDPGM 0, implicit %wide, implicit %narrow
...
