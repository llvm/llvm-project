# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -run-pass=machine-scheduler -amdgpu-disable-rewrite-mfma-form-sched-stage=false -o - %s | FileCheck %s

# %x is a loop-carried accumulator: defined by COPYs in the preheader and by the
# last MFMA in the loop. A tied V_FMAC after the loop writes %x.sub0, so %x
# cannot be recolored and the src2 of %a bridges the preheader defs, which puts
# %x in the register map. The last MFMA's dst still needs its restore copy; the
# FMAC and the KILL must see the loop's result, not the preheader value.

--- |
  define void @loop_carried_restore() #0 {
  entry:
    unreachable
  }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            loop_carried_restore
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: loop_carried_restore
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %srca:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %srcb:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %init:vgpr_32 = V_MOV_B32_e32 1065353216, implicit $exec
  ; CHECK-NEXT:   undef [[COPY:%[0-9]+]].sub0:vreg_128_align2 = COPY %init
  ; CHECK-NEXT:   [[COPY:%[0-9]+]].sub1:vreg_128_align2 = COPY %init
  ; CHECK-NEXT:   [[COPY:%[0-9]+]].sub2:vreg_128_align2 = COPY %init
  ; CHECK-NEXT:   [[COPY:%[0-9]+]].sub3:vreg_128_align2 = COPY %init
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:areg_128_align2 = COPY [[COPY]]
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p7:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p8:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7e000000), %bb.2(0x02000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, [[COPY1]], 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %b:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, %a, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %c:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, %b, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, %c, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %x:vreg_128_align2 = COPY [[COPY1]]
  ; CHECK-NEXT:   S_CBRANCH_SCC0 %bb.2, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   KILL [[DEF]], %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
  ; CHECK-NEXT:   %x.sub0:vreg_128_align2 = nofpexcept V_FMAC_F32_e32 %srca, %srcb, %x.sub0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   KILL %x
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %p7:vreg_1024 = IMPLICIT_DEF
    %p8:vreg_1024 = IMPLICIT_DEF

    %srca:vgpr_32 = IMPLICIT_DEF
    %srcb:vgpr_32 = IMPLICIT_DEF
    %init:vgpr_32 = V_MOV_B32_e32 1065353216, implicit $exec
    undef %x.sub0:vreg_128_align2 = COPY %init
    %x.sub1:vreg_128_align2 = COPY %init
    %x.sub2:vreg_128_align2 = COPY %init
    %x.sub3:vreg_128_align2 = COPY %init
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1(0x7e000000), %bb.2(0x02000000)

    %a:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %x, 0, 0, 0, implicit $mode, implicit $exec
    %b:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %a, 0, 0, 0, implicit $mode, implicit $exec
    %c:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %b, 0, 0, 0, implicit $mode, implicit $exec
    %x:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %c, 0, 0, 0, implicit $mode, implicit $exec

    S_CBRANCH_SCC0 %bb.2, implicit undef $scc
    S_BRANCH %bb.1

  bb.2:
    %x.sub0:vreg_128_align2 = nofpexcept V_FMAC_F32_e32 %srca, %srcb, %x.sub0, implicit $mode, implicit $exec
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
    KILL %x
    S_ENDPGM 0
...
