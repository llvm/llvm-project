# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=machine-scheduler \
# RUN:     -amdgpu-disable-rewrite-mfma-form-sched-stage=false \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# %mfma plays two roles at once: it is the dst of a candidate MFMA that cannot be
# recolored -- a VALU reads one of its lanes -- so the def is redirected to a
# fresh AGPR and restored with a copy, and it is the src2 of a later chain, so a
# bridge copies it back into an AGPR.
#
# Both roles have to get their own register. Sharing one leaves it with two
# disconnected value ranges and the verifier rejects the result.

--- |
  define void @dst_restore_src2_bridge() #0 {
  entry:
    unreachable
  }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            dst_restore_src2_bridge
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: dst_restore_src2_bridge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %srca:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %srcb:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[V_MFMA_F32_16X16X4F32_e64_:%[0-9]+]]:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, 0, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %val:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   %mfma:vreg_128_align2 = COPY [[V_MFMA_F32_16X16X4F32_e64_]]
  ; CHECK-NEXT:   %mfma.sub2:vreg_128_align2 = COPY %val
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:areg_128_align2 = COPY %mfma
  ; CHECK-NEXT:   %result:vgpr_32 = nofpexcept V_MUL_F32_e32 0, %mfma.sub2, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %p1:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p2:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p3:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p4:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p5:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p6:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p7:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   %p8:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x7e000000), %bb.2(0x02000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c0:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, [[COPY]], 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %c1:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, %c0, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %c2:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, %c1, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   %c3:areg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_e64 %srca, %srcb, %c2, 0, 0, 0, implicit $mode, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_SCC0 %bb.2, implicit undef $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   KILL [[DEF]], %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
  ; CHECK-NEXT:   KILL %c3, %result
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %p7:vreg_1024 = IMPLICIT_DEF
    %p8:vreg_1024 = IMPLICIT_DEF

    %srca:vgpr_32 = IMPLICIT_DEF
    %srcb:vgpr_32 = IMPLICIT_DEF
    %val:vgpr_32 = IMPLICIT_DEF

    %mfma:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, 0, 0, 0, 0, implicit $mode, implicit $exec
    %mfma.sub2:vreg_128_align2 = COPY %val
    %result:vgpr_32 = nofpexcept V_MUL_F32_e32 0, %mfma.sub2, implicit $mode, implicit $exec

    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1(0x7e000000), %bb.2(0x02000000)

    %c0:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %mfma, 0, 0, 0, implicit $mode, implicit $exec
    %c1:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %c0, 0, 0, 0, implicit $mode, implicit $exec
    %c2:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %c1, 0, 0, 0, implicit $mode, implicit $exec
    %c3:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %c2, 0, 0, 0, implicit $mode, implicit $exec

    S_CBRANCH_SCC0 %bb.2, implicit undef $scc
    S_BRANCH %bb.1

  bb.2:
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
    KILL %c3, %result
    S_ENDPGM 0
...
