# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx1030 -run-pass=machine-cse -verify-machineinstrs -o - %s | FileCheck %s

# SI_IF defines EXEC, and V_CMP_LT_U32_e64 has an SGPR result that depends on
# EXEC, so PRE must not hoist it from bb.1 above the SI_IF in bb.0.

--- |
  define amdgpu_ps void @vcmp_not_hoisted_above_si_if() {
  entry:
    br label %then
  then:
    br label %end
  end:
    ret void
  }
...
---
name:            vcmp_not_hoisted_above_si_if
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: vcmp_not_hoisted_above_si_if
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_32 = V_CMP_EQ_U32_e64 [[COPY2]], 0, implicit $exec
  ; CHECK-NEXT:   [[SI_IF:%[0-9]+]]:sreg_32 = SI_IF [[V_CMP_EQ_U32_e64_]], %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.then:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_CMP_LT_U32_e64_:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_LT_U32_e64 [[COPY]], [[COPY1]], implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_CMP_LT_U32_e64_]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.end:
  ; CHECK-NEXT:   SI_END_CF [[SI_IF]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   [[V_CMP_LT_U32_e64_1:%[0-9]+]]:sreg_32_xm0_xexec = V_CMP_LT_U32_e64 [[COPY]], [[COPY1]], implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit [[V_CMP_LT_U32_e64_1]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $vgpr2

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = COPY $vgpr2
    %3:sreg_32 = V_CMP_EQ_U32_e64 %2, 0, implicit $exec
    %4:sreg_32 = SI_IF %3, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.1

  bb.1.then:
    successors: %bb.2

    %5:sreg_32_xm0_xexec = V_CMP_LT_U32_e64 %0, %1, implicit $exec
    S_NOP 0, implicit %5

  bb.2.end:
    SI_END_CF %4, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    %6:sreg_32_xm0_xexec = V_CMP_LT_U32_e64 %0, %1, implicit $exec
    S_NOP 0, implicit %6
    S_ENDPGM 0
...
