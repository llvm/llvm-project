; The reproducer from #187279, as Clang -O0 IR: the loop stores through arr[i].
define zeroext i8 @fill() {
; CHECK-LABEL: fill:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0: ; %entry
; CHECK-NEXT:    suba.l #12, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -16
; CHECK-NEXT:    clr.l (4,%sp)
; CHECK-NEXT:    lea (9,%sp), %a0
; CHECK-NEXT:    cmpi.l #2, (4,%sp)
; CHECK-NEXT:    bhi .LBB5_3
; CHECK-NEXT:  .LBB5_2: ; %for.body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    move.l (4,%sp), %d0
; CHECK-NEXT:    move.b #123, (0,%a0,%d0)
; CHECK-NEXT:    add.l #1, %d0
; CHECK-NEXT:    move.l %d0, (4,%sp)
; CHECK-NEXT:    cmpi.l #2, (4,%sp)
; CHECK-NEXT:    bls .LBB5_2
; CHECK-NEXT:  .LBB5_3: ; %for.end
; CHECK-NEXT:    move.l %a0, (%sp)
; CHECK-NEXT:    jsr use
; CHECK-NEXT:    moveq #0, %d0
; CHECK-NEXT:    move.b (10,%sp), %d0
; CHECK-NEXT:    adda.l #12, %sp
; CHECK-NEXT:    rts
entry:
  %arr = alloca [3 x i8], align 1
  %i = alloca i32, align 2
  store i32 0, ptr %i, align 2
  br label %for.cond

for.cond:
  %0 = load i32, ptr %i, align 2
  %cmp = icmp ult i32 %0, 3
  br i1 %cmp, label %for.body, label %for.end

for.body:
  %1 = load i32, ptr %i, align 2
  %arrayidx = getelementptr inbounds nuw [3 x i8], ptr %arr, i32 0, i32 %1
  store i8 123, ptr %arrayidx, align 1
  %2 = load i32, ptr %i, align 2
  %inc = add i32 %2, 1
  store i32 %inc, ptr %i, align 2
  br label %for.cond

for.end:
  call void @use(ptr %arr)
  %arrayidx1 = getelementptr inbounds [3 x i8], ptr %arr, i32 0, i32 1
  %3 = load i8, ptr %arrayidx1, align 1
  ret i8 %3
}

