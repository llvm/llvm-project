; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=m68k-linux -verify-machineinstrs | FileCheck %s

declare i16 @llvm.bswap.i16(i16)
declare i32 @llvm.bswap.i32(i32)

define zeroext i16 @bswap16(i16 zeroext %a) nounwind {
; CHECK-LABEL: bswap16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    move.w (6,%sp), %d0
; CHECK-NEXT:    rol.w #8, %d0
; CHECK-NEXT:    swap %d0
; CHECK-NEXT:    clr.w %d0
; CHECK-NEXT:    swap %d0
; CHECK-NEXT:    rts
  %1 = tail call i16 @llvm.bswap.i16(i16 %a)
  ret i16 %1
}

define zeroext i32 @bswap32(i32 zeroext %a) nounwind {
; CHECK-LABEL: bswap32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    move.l (4,%sp), %d0
; CHECK-NEXT:    rol.w #8, %d0
; CHECK-NEXT:    swap %d0
; CHECK-NEXT:    rol.w #8, %d0
; CHECK-NEXT:    rts
  %1 = tail call i32 @llvm.bswap.i32(i32 %a)
  ret i32 %1
}

; The source is still live after the bswap, so the bswap must be done on a
; copy of the whole register, not just of its low word.
define i32 @bswap32_src_live(i32 %a) nounwind {
; CHECK-LABEL: bswap32_src_live:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    move.l (4,%sp), %d1
; CHECK-NEXT:    move.l %d1, %d0
; CHECK-NEXT:    rol.w #8, %d0
; CHECK-NEXT:    swap %d0
; CHECK-NEXT:    rol.w #8, %d0
; CHECK-NEXT:    eor.l %d1, %d0
; CHECK-NEXT:    rts
  %1 = tail call i32 @llvm.bswap.i32(i32 %a)
  %2 = xor i32 %1, %a
  ret i32 %2
}
