; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64-unknown-uefi < %s | FileCheck %s
; RUN: llc -mtriple=aarch64-unknown-uefi -filetype=obj -o - < %s | llvm-readobj --file-headers --sections - | FileCheck %s --check-prefix=OBJ

; UEFI follows the Windows ARM64 ABI: the Windows callee-saved register list
; and frame record pairing rules must be used together with SEH unwind info.
; Previously the Windows CSR list was not used for UEFI while the SEH
; directives were, which tripped the "Non-consecutive registers not allowed
; for save_regp" assertion in the AsmPrinter.

; OBJ: Machine: IMAGE_FILE_MACHINE_ARM64
; OBJ: Name: .text
; OBJ: Name: .xdata
; OBJ: Name: .pdata

define i32 @large_stack_requires_frame_record() "frame-pointer"="all" {
; CHECK-LABEL: large_stack_requires_frame_record:
; CHECK:       .seh_proc large_stack_requires_frame_record
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    str x28, [sp, #-32]! // 8-byte Folded Spill
; CHECK-NEXT:    .seh_save_reg_x x28, 32
; CHECK-NEXT:    stp x29, x30, [sp, #8] // 16-byte Folded Spill
; CHECK-NEXT:    .seh_save_fplr 8
; CHECK-NEXT:    add x29, sp, #8
; CHECK-NEXT:    .seh_add_fp 8
; CHECK-NEXT:    .seh_endprologue
; CHECK-NEXT:    sub sp, sp, #512
; CHECK-NEXT:    mov x0, sp
; CHECK-NEXT:    bl baz
; CHECK-NEXT:    mov w0, wzr
; CHECK-NEXT:    .seh_startepilogue
; CHECK-NEXT:    add sp, sp, #512
; CHECK-NEXT:    .seh_stackalloc 512
; CHECK-NEXT:    ldp x29, x30, [sp, #8] // 16-byte Folded Reload
; CHECK-NEXT:    .seh_save_fplr 8
; CHECK-NEXT:    ldr x28, [sp], #32 // 8-byte Folded Reload
; CHECK-NEXT:    .seh_save_reg_x x28, 32
; CHECK-NEXT:    .seh_endepilogue
; CHECK-NEXT:    ret
; CHECK-NEXT:    .seh_endfunclet
; CHECK-NEXT:    .seh_endproc
  %x = alloca [500 x i8], align 16
  call void @baz(ptr %x)
  ret i32 0
}

declare void @baz(ptr)
