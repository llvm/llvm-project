# RUN: llc -run-pass=machine-combiner -mtriple=arm64-unknown-unknown %s -o - | FileCheck %s

--- |
  define void @uabal_chain_with_debug_user() !dbg !3 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "uabal_chain_with_debug_user", scope: !1, file: !1, type: !4, spFlags: DISPFlagDefinition, unit: !0)
  !4 = !DISubroutineType(types: !{null})
  !5 = !DILocalVariable(name: "acc", scope: !3)
  !6 = !DILocation(line: 0, scope: !3)
...

# The last UABAL in bb.0 is not the end of the chain: its only non-debug user is
# the UABAL in bb.1. A DBG_VALUE user must not make it look like the end of a
# chain, so nothing is reassociated.
# CHECK-LABEL: name: uabal_chain_with_debug_user
# CHECK:          [[START:%.*]]:fpr128 = UABDLv4i16_v4i32
# CHECK:          [[A1:%.*]]:fpr128 = UABALv4i16_v4i32 [[START]]
# CHECK:          [[A2:%.*]]:fpr128 = UABALv4i16_v4i32 [[A1]]
# CHECK:          [[A3:%.*]]:fpr128 = UABALv4i16_v4i32 [[A2]]
# CHECK:          [[A4:%.*]]:fpr128 = UABALv4i16_v4i32 [[A3]]
# CHECK:          [[A5:%.*]]:fpr128 = UABALv4i16_v4i32 [[A4]]
# CHECK:          [[A6:%.*]]:fpr128 = UABALv4i16_v4i32 [[A5]]
# CHECK:          [[A7:%.*]]:fpr128 = UABALv4i16_v4i32 [[A6]]
# CHECK:          [[A8:%.*]]:fpr128 = UABALv4i16_v4i32 [[A7]]
# CHECK-NEXT:     DBG_VALUE [[A8]]
# CHECK:          UABALv4i16_v4i32 [[A8]]

---
name:            uabal_chain_with_debug_user
body:             |
  bb.0:
    liveins: $x0, $x1, $x2, $x3

    %3:gpr64 = COPY $x3
    %2:gpr64common = COPY $x2
    %1:gpr64 = COPY $x1
    %0:gpr64common = COPY $x0
    %4:fpr64 = LDRDui %0, 0 :: (load (s64))
    %5:fpr64 = LDRDui %2, 0 :: (load (s64))
    %6:gpr64common = ADDXrr %0, %1
    %7:gpr64common = ADDXrr %2, %3
    %8:fpr64 = LDRDui %6, 0 :: (load (s64))
    %9:fpr64 = LDRDui %7, 0 :: (load (s64))
    %10:fpr128 = UABDLv4i16_v4i32 %8, %9
    %11:fpr128 = UABALv4i16_v4i32 %10, %4, %5
    %12:gpr64common = ADDXrr %6, %1
    %13:gpr64common = ADDXrr %7, %3
    %14:fpr64 = LDRDui %12, 0 :: (load (s64))
    %15:fpr64 = LDRDui %13, 0 :: (load (s64))
    %16:fpr128 = UABALv4i16_v4i32 %11, %14, %15
    %17:gpr64common = ADDXrr %12, %1
    %18:gpr64common = ADDXrr %13, %3
    %19:fpr64 = LDRDui %17, 0 :: (load (s64))
    %20:fpr64 = LDRDui %18, 0 :: (load (s64))
    %21:fpr128 = UABALv4i16_v4i32 %16, %19, %20
    %22:gpr64common = ADDXrr %17, %1
    %23:gpr64common = ADDXrr %18, %3
    %24:fpr64 = LDRDui %22, 0 :: (load (s64))
    %25:fpr64 = LDRDui %23, 0 :: (load (s64))
    %26:fpr128 = UABALv4i16_v4i32 %21, %24, %25
    %27:gpr64common = ADDXrr %22, %1
    %28:gpr64common = ADDXrr %23, %3
    %29:fpr64 = LDRDui %27, 0 :: (load (s64))
    %30:fpr64 = LDRDui %28, 0 :: (load (s64))
    %31:fpr128 = UABALv4i16_v4i32 %26, %29, %30
    %32:gpr64common = ADDXrr %27, %1
    %33:gpr64common = ADDXrr %28, %3
    %34:fpr64 = LDRDui %32, 0 :: (load (s64))
    %35:fpr64 = LDRDui %33, 0 :: (load (s64))
    %36:fpr128 = UABALv4i16_v4i32 %31, %34, %35
    %37:gpr64common = ADDXrr %32, %1
    %38:gpr64common = ADDXrr %33, %3
    %39:fpr64 = LDRDui %37, 0 :: (load (s64))
    %40:fpr64 = LDRDui %38, 0 :: (load (s64))
    %41:fpr128 = UABALv4i16_v4i32 %36, %39, %40
    %42:gpr64common = ADDXrr %37, %1
    %43:gpr64common = ADDXrr %38, %3
    %44:fpr64 = LDRDui %42, 0 :: (load (s64))
    %45:fpr64 = LDRDui %43, 0 :: (load (s64))
    %46:fpr128 = UABALv4i16_v4i32 %41, %44, %45
    DBG_VALUE %46, $noreg, !5, !DIExpression(), debug-location !6
    B %bb.1

  bb.1:
    %47:fpr128 = UABALv4i16_v4i32 %46, %44, %45
    $q0 = COPY %47
    RET_ReallyLR implicit $q0
...
