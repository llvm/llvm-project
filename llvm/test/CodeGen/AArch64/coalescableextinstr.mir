# RUN: llc -mtriple=aarch64 -run-pass=peephole-opt -verify-machineinstrs -o - %s | FileCheck %s

---
name:            test
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: test
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %0:gpr32 = COPY $x0
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %1:gpr64all = IMPLICIT_DEF
  ; CHECK-NEXT:   %7:gpr32 = COPY %5.sub_32
  ; CHECK-NEXT:   %2:gpr64 = INSERT_SUBREG %1, %7, %subreg.sub_32
  ; CHECK-NEXT:   %4:gpr64common = ANDXri %5, 4096
  ; CHECK-NEXT:   $w0 = COPY %2
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
