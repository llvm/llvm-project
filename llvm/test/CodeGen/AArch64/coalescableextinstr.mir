  ; CHECK-NEXT:   $x0 = COPY %0
  ; CHECK-NEXT:   %6:gpr64 = COPY $x0
  ; CHECK-NEXT:   %3:gpr32all = COPY %6.sub_32
  ; CHECK-NEXT:   %5:gpr64 = SBFMXri %6, 0, 31
  ; CHECK-NEXT:   B %bb.1
  bb.0:
    liveins: $x0
    %6:gpr32 = COPY $x0

    B %bb.2

  bb.1:
    %3:gpr64all = IMPLICIT_DEF
    %4:gpr64 = INSERT_SUBREG %3, %1, %subreg.sub_32
    %5:gpr64common = ANDXri %2, 4096
    $w0 = COPY %4
    RET_ReallyLR implicit $w0

  bb.2:
    $x0 = COPY %6
    %0:gpr64 = COPY $x0
    %1:gpr32all = COPY %0.sub_32
    %2:gpr64 = SBFMXri %0, 0, 31
    B %bb.1
