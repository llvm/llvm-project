# REQUIRES: asserts
# RUN: llc -mtriple=aarch64-apple-darwin -run-pass=machine-outliner \
# RUN:   -codegen-data-generate \
# RUN:   -machine-outliner-publish-unprofitable-candidates -stats %s \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=MAX-THREE
# RUN: llc -mtriple=aarch64-apple-darwin -run-pass=machine-outliner \
# RUN:   -codegen-data-generate \
# RUN:   -machine-outliner-publish-unprofitable-candidates \
# RUN:   -machine-outliner-unprofitable-candidate-max-instrs=2 -stats %s \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=MAX-TWO

# The repeated three-instruction sequence overlaps its two-instruction
# subsequence, so neither group is published with the default maximum. The
# independent two-instruction sequence still contributes two sites. Lowering
# the maximum excludes the three-instruction competitor, allowing both short
# sequences to be published.
#
# MAX-THREE: 1 machine-outliner - Number of locally unprofitable candidate groups published
# MAX-THREE: 2 machine-outliner - Number of locally unprofitable candidate sites published
# MAX-TWO: 2 machine-outliner - Number of locally unprofitable candidate groups published
# MAX-TWO: 4 machine-outliner - Number of locally unprofitable candidate sites published

--- |
  define void @three1() noredzone { unreachable }
  define void @three2() noredzone { unreachable }
  define void @two1() noredzone { unreachable }
  define void @two2() noredzone { unreachable }
...
---
name: three1
tracksRegLiveness: true
body: |
  bb.0:
    $w0 = ORRWri $wzr, 1
    $w1 = ORRWri $wzr, 2
    $w2 = ORRWri $wzr, 3
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: three2
tracksRegLiveness: true
body: |
  bb.0:
    $w0 = ORRWri $wzr, 1
    $w1 = ORRWri $wzr, 2
    $w2 = ORRWri $wzr, 3
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: two1
tracksRegLiveness: true
body: |
  bb.0:
    $w3 = ORRWri $wzr, 4
    $w4 = ORRWri $wzr, 5
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: two2
tracksRegLiveness: true
body: |
  bb.0:
    $w3 = ORRWri $wzr, 4
    $w4 = ORRWri $wzr, 5
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
