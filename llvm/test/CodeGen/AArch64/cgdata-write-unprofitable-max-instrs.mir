# REQUIRES: asserts
# RUN: llc -mtriple=aarch64-apple-darwin -run-pass=machine-outliner \
# RUN:   -codegen-data-generate \
# RUN:   -machine-outliner-publish-unprofitable-candidates -stats %s \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=MAX-THREE
# RUN: llc -mtriple=aarch64-apple-darwin -run-pass=machine-outliner \
# RUN:   -codegen-data-generate \
# RUN:   -machine-outliner-publish-unprofitable-candidates \
# RUN:   -machine-outliner-unprofitable-candidate-max-instrs=2 -stats %s \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=MAX-TWO

# The repeated three-instruction sequence contains its two-instruction suffix,
# which also appears on its own. With the default maximum, only the containing
# sequence is published, along with the independent two-instruction sequence.
# Lowering the maximum excludes the three-instruction sequence, so all three
# suffix sites are published instead.
#
# MAX-THREE: 2 machine-outliner - Number of locally unprofitable candidate groups published
# MAX-THREE: 4 machine-outliner - Number of locally unprofitable candidate sites published
# MAX-TWO: 2 machine-outliner - Number of locally unprofitable candidate groups published
# MAX-TWO: 5 machine-outliner - Number of locally unprofitable candidate sites published

--- |
  define void @three1() noredzone { unreachable }
  define void @three2() noredzone { unreachable }
  define void @bc() noredzone { unreachable }
  define void @two1() noredzone { unreachable }
  define void @two2() noredzone { unreachable }
...
---
name: three1
body: |
  bb.0:
    $w0 = ORRWri $wzr, 1
    $w1 = ORRWri $wzr, 2
    $w2 = ORRWri $wzr, 3
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: three2
body: |
  bb.0:
    $w0 = ORRWri $wzr, 1
    $w1 = ORRWri $wzr, 2
    $w2 = ORRWri $wzr, 3
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: bc
body: |
  bb.0:
    $w1 = ORRWri $wzr, 2
    $w2 = ORRWri $wzr, 3
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: two1
body: |
  bb.0:
    $w3 = ORRWri $wzr, 4
    $w4 = ORRWri $wzr, 5
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
---
name: two2
body: |
  bb.0:
    $w3 = ORRWri $wzr, 4
    $w4 = ORRWri $wzr, 5
    INLINEASM &"", sideeffect attdialect
    RET undef $lr
...
