; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64 -O0 < %s | FileCheck %s

;; An inline asm input tied to a fixed-register output is copied into that
;; register when its value lives elsewhere. No other input of the asm may be
;; assigned that register.

;; %z is also read after the asm.
define <4 x i32> @tied_live_after(<4 x i32> %z, ptr %p) {
; CHECK-LABEL: tied_live_after:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov v1.16b, v0.16b
; CHECK-NEXT:    ldr q3, [x0]
; CHECK-NEXT:    mov v2.16b, v1.16b
; CHECK-NEXT:    //APP
; CHECK-NEXT:    // out=v0 q2=v2 a=v3
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    add v0.4s, v0.4s, v1.4s
; CHECK-NEXT:    ret
  %a = load <4 x i32>, ptr %p
  %r = call { <4 x i32>, <4 x i32> } asm "// out=$0 q2=$1 a=$3", "=&w,=&{q2},1,w"(<4 x i32> %z, <4 x i32> %a)
  %s = extractvalue { <4 x i32>, <4 x i32> } %r, 0
  %res = add <4 x i32> %s, %z
  ret <4 x i32> %res
}

;; %z is tied to two fixed registers.
define <4 x i32> @tied_twice(<4 x i32> %z, ptr %p) {
; CHECK-LABEL: tied_twice:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov v1.16b, v0.16b
; CHECK-NEXT:    ldr q4, [x0]
; CHECK-NEXT:    ldr q5, [x0, #16]
; CHECK-NEXT:    mov v2.16b, v1.16b
; CHECK-NEXT:    mov v3.16b, v1.16b
; CHECK-NEXT:    //APP
; CHECK-NEXT:    // out=v0 q2=v2 q3=v3 a=v4 b=v5
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
  %a = load <4 x i32>, ptr %p
  %pb = getelementptr inbounds <4 x i32>, ptr %p, i64 1
  %b = load <4 x i32>, ptr %pb
  %r = call { <4 x i32>, <4 x i32>, <4 x i32> } asm "// out=$0 q2=$1 q3=$2 a=$5 b=$6", "=&w,=&{q2},=&{q3},1,2,w,w"(<4 x i32> %z, <4 x i32> %z, <4 x i32> %a, <4 x i32> %b)
  %res = extractvalue { <4 x i32>, <4 x i32>, <4 x i32> } %r, 0
  ret <4 x i32> %res
}

;; An untied read of %z is allocated before the tied one.
define <4 x i32> @untied_before_tied(<4 x i32> %z, ptr %p) {
; CHECK-LABEL: untied_before_tied:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov v1.16b, v0.16b
; CHECK-NEXT:    ldr q3, [x0]
; CHECK-NEXT:    mov v2.16b, v1.16b
; CHECK-NEXT:    //APP
; CHECK-NEXT:    // out=v0 q2=v2 z=v1 a=v3
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
  %a = load <4 x i32>, ptr %p
  %r = call { <4 x i32>, <4 x i32> } asm "// out=$0 q2=$1 z=$2 a=$4", "=&w,={q2},w,1,w"(<4 x i32> %z, <4 x i32> %z, <4 x i32> %a)
  %res = extractvalue { <4 x i32>, <4 x i32> } %r, 0
  ret <4 x i32> %res
}
