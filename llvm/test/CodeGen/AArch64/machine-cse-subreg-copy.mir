# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -run-pass=machine-cse -mtriple=aarch64 -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -passes=machine-cse -mtriple=aarch64 -verify-machineinstrs -o - %s | FileCheck %s

# A subregister COPY (%1 = COPY %0.sub_32) is coalesced: the single use is
# rewritten to %0.sub_32 and the now-dead copy is removed.
--- |
  target triple = "aarch64-linux"
  define i32 @basic(i64 %x) {
  entry:
    ret i32 0
  }
  define i32 @multiuse(i64 %x) {
  entry:
    ret i32 0
  }
  define i32 @dbg(i64 %x) !dbg !4 {
  entry:
    ret i32 0, !dbg !12
  }
  define void @insert_subreg() { ret void }
  define void @tuple() { ret void }
  define void @copy_chain() { ret void }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "x", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "a.c", directory: "/")
  !2 = !{i32 7, !"Dwarf Version", i32 5}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "dbg", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !8)
  !5 = !DISubroutineType(types: !6)
  !6 = !{!7, !7}
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !{!9}
  !9 = !DILocalVariable(name: "t", scope: !4, file: !1, line: 1, type: !7)
  !12 = !DILocation(line: 2, column: 1, scope: !4)
...
---
name:            basic
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: basic
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64common = COPY $x0
    ; CHECK-NEXT: [[ADDWri:%[0-9]+]]:gpr32common = ADDWri [[COPY]].sub_32, 100, 0
    ; CHECK-NEXT: $w0 = COPY [[ADDWri]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32common = COPY %0.sub_32
    %2:gpr32common = ADDWri %1, 100, 0
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
# A subregister copy with more than one use is not propagated.
name:            multiuse
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: multiuse
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64 = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY [[COPY]].sub_32
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[COPY1]], [[COPY1]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32 = COPY %0.sub_32
    %2:gpr32 = ADDWrr %1, %1
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
# The DBG_VALUE is rewritten to %0.sub_32 along with the real use, so the
# copy is removed without losing the variable location.
name:            dbg
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: dbg
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64common = COPY $x0
    ; CHECK-NEXT: DBG_VALUE [[COPY]].sub_32, $noreg, !9, !DIExpression(), debug-location !10
    ; CHECK-NEXT: [[ADDWri:%[0-9]+]]:gpr32common = ADDWri [[COPY]].sub_32, 100, 0
    ; CHECK-NEXT: $w0 = COPY [[ADDWri]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32common = COPY %0.sub_32
    DBG_VALUE %1:gpr32common, $noreg, !9, !DIExpression(), debug-location !12
    %2:gpr32common = ADDWri %1, 100, 0
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
# A copy out of an INSERT_SUBREG is left for PeepholeOptimizer to rewrite.
name:            insert_subreg
body:             |
  bb.0:
    liveins: $x0, $w1
    ; CHECK-LABEL: name: insert_subreg
    ; CHECK: liveins: $x0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64 = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[INSERT_SUBREG:%[0-9]+]]:gpr64 = INSERT_SUBREG [[COPY]], [[COPY1]], %subreg.sub_32
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32common = COPY [[INSERT_SUBREG]].sub_32
    ; CHECK-NEXT: [[ADDWri:%[0-9]+]]:gpr32common = ADDWri [[COPY2]], 100, 0
    ; CHECK-NEXT: $w0 = COPY [[ADDWri]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32 = COPY $w1
    %2:gpr64 = INSERT_SUBREG %0, %1, %subreg.sub_32
    %3:gpr32common = COPY %2.sub_32
    %4:gpr32common = ADDWri %3, 100, 0
    $w0 = COPY %4
    RET_ReallyLR implicit $w0
...
---
# Without subregister liveness, reading dsub0 of the tuple would keep both
# D registers live, so the copy is not propagated.
name:            tuple
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: tuple
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64sp = COPY $x0
    ; CHECK-NEXT: [[LD1Twov8b:%[0-9]+]]:dd = LD1Twov8b [[COPY]] :: (load (s128))
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr64 = COPY [[LD1Twov8b]].dsub0
    ; CHECK-NEXT: [[FNEGDr:%[0-9]+]]:fpr64 = FNEGDr [[COPY1]]
    ; CHECK-NEXT: $d0 = COPY [[FNEGDr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %0:gpr64sp = COPY $x0
    %1:dd = LD1Twov8b %0 :: (load (s128))
    %2:fpr64 = COPY %1.dsub0
    %3:fpr64 = FNEGDr %2
    $d0 = COPY %3
    RET_ReallyLR implicit $d0
...
---
# A subregister copy of a cross-class copy is left for the coalescer.
name:            copy_chain
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: copy_chain
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64 = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr64sp = COPY [[COPY]]
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32common = COPY [[COPY1]].sub_32
    ; CHECK-NEXT: [[ADDWri:%[0-9]+]]:gpr32common = ADDWri [[COPY2]], 100, 0
    ; CHECK-NEXT: $w0 = COPY [[ADDWri]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr64sp = COPY %0
    %2:gpr32common = COPY %1.sub_32
    %3:gpr32common = ADDWri %2, 100, 0
    $w0 = COPY %3
    RET_ReallyLR implicit $w0
...
