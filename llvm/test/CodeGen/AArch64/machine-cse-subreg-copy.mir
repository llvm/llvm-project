# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -run-pass=machine-cse -mtriple=aarch64 -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -passes=machine-cse -mtriple=aarch64 -verify-machineinstrs -o - %s | FileCheck %s

# A subregister COPY (%1 = COPY %0.sub_32) is coalesced: the single use is
# rewritten to %0.sub_32 and the now-dead copy is removed.
--- |
  target triple = "aarch64-linux"
  define i32 @basic(i64 %x) {
  entry:
    ret i32 0
  }
  define i32 @multiuse(i64 %x) {
  entry:
    ret i32 0
  }
  define i32 @dbg(i64 %x) !dbg !4 {
  entry:
    ret i32 0, !dbg !12
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "x", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "a.c", directory: "/")
  !2 = !{i32 7, !"Dwarf Version", i32 5}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "dbg", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !8)
  !5 = !DISubroutineType(types: !6)
  !6 = !{!7, !7}
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !{!9}
  !9 = !DILocalVariable(name: "t", scope: !4, file: !1, line: 1, type: !7)
  !12 = !DILocation(line: 2, column: 1, scope: !4)
...
---
name:            basic
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: basic
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64common = COPY $x0
    ; CHECK-NEXT: [[ADDWri:%[0-9]+]]:gpr32common = ADDWri [[COPY]].sub_32, 100, 0
    ; CHECK-NEXT: $w0 = COPY [[ADDWri]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32common = COPY %0.sub_32
    %2:gpr32common = ADDWri %1, 100, 0
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
# Two uses of the subregister copy: both are rewritten to %0.sub_32 and the
# copy becomes dead once the last use is rewritten.
name:            multiuse
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: multiuse
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64 = COPY $x0
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[COPY]].sub_32, [[COPY]].sub_32
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32 = COPY %0.sub_32
    %2:gpr32 = ADDWrr %1, %1
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
# A debug user keeps the copy live: the real use is still rewritten to
# %0.sub_32, but the copy is preserved so the DBG_VALUE is not redirected to
# the full super-register.
name:            dbg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: dbg
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64common = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32common = COPY [[COPY]].sub_32
    ; CHECK-NEXT: DBG_VALUE [[COPY1]], $noreg, !9, !DIExpression(), debug-location !10
    ; CHECK-NEXT: [[ADDWri:%[0-9]+]]:gpr32common = ADDWri [[COPY]].sub_32, 100, 0
    ; CHECK-NEXT: $w0 = COPY [[ADDWri]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr64 = COPY $x0
    %1:gpr32common = COPY %0.sub_32
    DBG_VALUE %1:gpr32common, $noreg, !9, !DIExpression(), debug-location !12
    %2:gpr32common = ADDWri %1, 100, 0
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
