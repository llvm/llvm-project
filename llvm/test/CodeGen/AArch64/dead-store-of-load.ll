; Tests for DAGCombiner::visitSTORE eliding dead stores of values loaded from
; the same memory location via BaseIndexOffset.

@g = external global [16 x i64], align 8
declare void @may_clobber()

; (base + idx) + 8 and base + (idx + 8) use distinct SDValue address nodes when
; (idx + 8) has another use, but resolve to the same BaseIndexOffset (Off == 0).
define i64 @reassoc_base_index_offset_same(ptr %base, i64 %idx) {
; CHECK-LABEL: reassoc_base_index_offset_same:
; CHECK:       // %bb.0:
; CHECK-NEXT:    add x0, x1, #8
; CHECK-NEXT:    ret
  %p1_idx = getelementptr i8, ptr %base, i64 %idx
  %p1 = getelementptr i8, ptr %p1_idx, i64 8
  %v = load i64, ptr %p1, align 8
  %idx_plus_8 = add i64 %idx, 8
  %p2 = getelementptr i8, ptr %base, i64 %idx_plus_8
  store i64 %v, ptr %p2, align 8
  ret i64 %idx_plus_8
}

; Negative: non-zero relative offset (8 vs 16) must not be elided.
define i64 @reassoc_base_index_offset_diff_neg(ptr %base, i64 %idx) {
; CHECK-LABEL: reassoc_base_index_offset_diff_neg:
; CHECK:       // %bb.0:
; CHECK-NEXT:    add x9, x0, x1
; CHECK-NEXT:    mov x8, x0
; CHECK-NEXT:    add x0, x1, #16
; CHECK-NEXT:    ldr x9, [x9, #8]
; CHECK-NEXT:    str x9, [x8, x0]
; CHECK-NEXT:    ret
  %p1_idx = getelementptr i8, ptr %base, i64 %idx
  %p1 = getelementptr i8, ptr %p1_idx, i64 8
  %v = load i64, ptr %p1, align 8
  %idx_plus_16 = add i64 %idx, 16
  %p2 = getelementptr i8, ptr %base, i64 %idx_plus_16
  store i64 %v, ptr %p2, align 8
  ret i64 %idx_plus_16
}

; GlobalAddress + reassociated index/offset (Off == 0).
define i64 @global_base_index_offset_same(i64 %idx) {
; CHECK-LABEL: global_base_index_offset_same:
; CHECK:       // %bb.0:
; CHECK-NEXT:    add x0, x0, #8
; CHECK-NEXT:    ret
  %p1_idx = getelementptr i8, ptr @g, i64 %idx
