; Extending load (zextload i8 -> i32) followed by truncating store (truncstore i8)
; to an equivalent BaseIndexOffset: store is elided while load stays for return.
define { i32, i64 } @zextload_truncstore_same(ptr %base, i64 %idx) {
; CHECK-LABEL: zextload_truncstore_same:
; CHECK:       // %bb.0:
; CHECK-NEXT:    add x8, x0, x1
; CHECK-NEXT:    add x1, x1, #4
; CHECK-NEXT:    ldrb w0, [x8, #4]
; CHECK-NEXT:    ret
  %p1_idx = getelementptr i8, ptr %base, i64 %idx
  %p1 = getelementptr i8, ptr %p1_idx, i64 4
  %v = load i8, ptr %p1, align 1
  %zext = zext i8 %v to i32
  %idx_plus_4 = add i64 %idx, 4
  %p2 = getelementptr i8, ptr %base, i64 %idx_plus_4
  store i8 %v, ptr %p2, align 1
  %r0 = insertvalue { i32, i64 } poison, i32 %zext, 0
  %r1 = insertvalue { i32, i64 } %r0, i64 %idx_plus_4, 1
  ret { i32, i64 } %r1
}

