; Post-indexed load (ldr x0, [x8], #8) followed by a dead store to the original
; pre-increment address ((base - 8) + (idx + 8), Off == 0): store is elided.
define { i64, ptr, i64 } @post_inc_load_dead_store_same(ptr %base, i64 %idx) {
; CHECK-LABEL: post_inc_load_dead_store_same:
; CHECK:       // %bb.0:
; CHECK-NEXT:    add x8, x0, x1
; CHECK-NEXT:    add x2, x1, #8
; CHECK-NEXT:    ldr x0, [x8], #8
; CHECK-NEXT:    mov x1, x8
; CHECK-NEXT:    ret
  %p1 = getelementptr i8, ptr %base, i64 %idx
  %v = load i64, ptr %p1, align 8
  %next = getelementptr i8, ptr %p1, i64 8
  %p2_base = getelementptr i8, ptr %base, i64 -8
  %idx_plus_8 = add i64 %idx, 8
  %p2 = getelementptr i8, ptr %p2_base, i64 %idx_plus_8
  store i64 %v, ptr %p2, align 8
  %r0 = insertvalue { i64, ptr, i64 } poison, i64 %v, 0
  %r1 = insertvalue { i64, ptr, i64 } %r0, ptr %next, 1
  %r2 = insertvalue { i64, ptr, i64 } %r1, i64 %idx_plus_8, 2
  ret { i64, ptr, i64 } %r2
}

