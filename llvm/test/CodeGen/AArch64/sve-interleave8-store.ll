target triple = "aarch64-unknown-linux-gnu"

; Eight input vectors form one wide vector. The scalable case writes it with
; two st4 stores, four vector lengths apart.
define void @interleave8_store_scalable(ptr %dst, <vscale x 2 x double> %a, <vscale x 2 x double> %b, <vscale x 2 x double> %c, <vscale x 2 x double> %d, <vscale x 2 x double> %e, <vscale x 2 x double> %f, <vscale x 2 x double> %g, <vscale x 2 x double> %h) {
; CHECK-LABEL: interleave8_store_scalable:
; CHECK:       // %bb.0:
; CHECK-NEXT:    zip2 z27.d, z3.d, z7.d
; CHECK-NEXT:    ptrue p0.d
; CHECK-NEXT:    zip2 z26.d, z2.d, z6.d
; CHECK-NEXT:    zip2 z25.d, z1.d, z5.d
; CHECK-NEXT:    zip2 z24.d, z0.d, z4.d
; CHECK-NEXT:    st4d { z24.d - z27.d }, p0, [x0, #4, mul vl]
; CHECK-NEXT:    zip1 z27.d, z3.d, z7.d
; CHECK-NEXT:    zip1 z26.d, z2.d, z6.d
; CHECK-NEXT:    zip1 z25.d, z1.d, z5.d
; CHECK-NEXT:    zip1 z24.d, z0.d, z4.d
; CHECK-NEXT:    st4d { z24.d - z27.d }, p0, [x0]
; CHECK-NEXT:    ret
  %wide = call <vscale x 16 x double> @llvm.vector.interleave8.nxv16f64(<vscale x 2 x double> %a, <vscale x 2 x double> %b, <vscale x 2 x double> %c, <vscale x 2 x double> %d, <vscale x 2 x double> %e, <vscale x 2 x double> %f, <vscale x 2 x double> %g, <vscale x 2 x double> %h)
  store <vscale x 16 x double> %wide, ptr %dst, align 8
  ret void
}

