# RUN: llc -mtriple=aarch64 -mcpu=apple-m1 -run-pass=early-ifcvt \
# RUN:   -enable-early-ifcvt-data-dependent -pass-remarks-analysis='early-ifcvt' \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s
# RUN: llc -mtriple=aarch64 -mcpu=apple-m1 -run-pass=early-ifcvt \
# RUN:   -enable-early-ifcvt-data-dependent -early-ifcvt-cold-edge-threshold=0 \
# RUN:   -pass-remarks-analysis='early-ifcvt' \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=NO-COLD-EDGE

# Test the reasons for changing the critical-path extension budget.

# CHECK: remark: <unknown>:0:0: branch has a cold edge below 1%, using a critical-path extension budget of 0 cycles
# CHECK: remark: <unknown>:0:0: branch condition is data-dependent (from memory load), using higher CritLimit of {{[0-9]+}} cycles

# NO-COLD-EDGE-NOT: branch has a cold edge
# NO-COLD-EDGE: remark: <unknown>:0:0: branch condition is data-dependent (from memory load), using higher CritLimit of {{[0-9]+}} cycles
# NO-COLD-EDGE-NOT: branch has a cold edge

--- |
  define i32 @biased_branch(i32 %x, i32 %y) { ret i32 0 }

  define i32 @data_dependent_branch(ptr %p, i32 %x, i32 %y) {
    ret i32 0
  }
...
---
name:            data_dependent_branch
alignment:       4
tracksRegLiveness: true
liveins:
  - { reg: '$x0', virtual-reg: '%0' }
  - { reg: '$w1', virtual-reg: '%1' }
  - { reg: '$w2', virtual-reg: '%2' }
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x0, $w1, $w2

    %0:gpr64common = COPY $x0
    %1:gpr32 = COPY $w1
    %2:gpr32 = COPY $w2
    %10:gpr32common = LDRWui %0, 0 :: (load (s32))
    %11:gpr32 = SUBSWri %10, 100, 0, implicit-def $nzcv
    Bcc 12, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    %20:gpr32 = MADDWrrr %1, %2, $wzr

  bb.2:
    %100:gpr32 = PHI %1, %bb.0, %20, %bb.1
    $w0 = COPY %100
    RET_ReallyLR implicit $w0
...

---
name: biased_branch
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2(0x7fef9fcb), %bb.1(0x00106035)
    liveins: $w0, $w1
    %0:gpr32sp = COPY $w0
    %1:gpr32 = COPY $w1
    $wzr = SUBSWri %0, 0, 0, implicit-def $nzcv
    Bcc 0, %bb.1, implicit $nzcv
    B %bb.2
  bb.1:
    successors: %bb.2(0x80000000)
    %2:gpr32 = ADDWrr %1, %1
    B %bb.2
  bb.2:
    %3:gpr32 = PHI %1, %bb.0, %2, %bb.1
    $w0 = COPY %3
    RET_ReallyLR implicit $w0
...
