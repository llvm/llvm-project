; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=aarch64 < %s | FileCheck %s

; MachineLICM must treat SUBS with dead NZCV as cheap as SUB, and not hoist it
; out of the loop when its result feeds a PHI. The call in %if keeps early
; if-conversion from turning the PHI into a select.

@g = external dso_local global i8

declare void @cold()
declare void @use(i64)

define void @sub_imm(i64 %n) {
; CHECK-LABEL: sub_imm:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    stp x30, x21, [sp, #-32]! // 16-byte Folded Spill
; CHECK-NEXT:    stp x20, x19, [sp, #16] // 16-byte Folded Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    .cfi_offset w19, -8
; CHECK-NEXT:    .cfi_offset w20, -16
; CHECK-NEXT:    .cfi_offset w21, -24
; CHECK-NEXT:    .cfi_offset w30, -32
; CHECK-NEXT:    adrp x8, g
; CHECK-NEXT:    add x8, x8, :lo12:g
; CHECK-NEXT:    mov x19, x0
; CHECK-NEXT:    mov x20, xzr
; CHECK-NEXT:    sub x21, x8, #32
; CHECK-NEXT:    b .LBB0_2
; CHECK-NEXT:  .LBB0_1: // %latch
; CHECK-NEXT:    // in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    bl use
; CHECK-NEXT:    add x20, x20, #1
; CHECK-NEXT:    cmp x19, x20
; CHECK-NEXT:    b.eq .LBB0_4
; CHECK-NEXT:  .LBB0_2: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cmp x20, #5
; CHECK-NEXT:    mov x0, x20
; CHECK-NEXT:    b.ne .LBB0_1
; CHECK-NEXT:  // %bb.3: // %if
; CHECK-NEXT:    // in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    bl cold
; CHECK-NEXT:    mov x0, x21
; CHECK-NEXT:    b .LBB0_1
; CHECK-NEXT:  .LBB0_4: // %exit
; CHECK-NEXT:    ldp x20, x19, [sp, #16] // 16-byte Folded Reload
; CHECK-NEXT:    ldp x30, x21, [sp], #32 // 16-byte Folded Reload
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %c = icmp eq i64 %i, 5
  br i1 %c, label %if, label %latch

if:
  call void @cold()
  br label %latch

latch:
  %v = phi i64 [ sub (i64 ptrtoint (ptr @g to i64), i64 32), %if ], [ %i, %loop ]
  call void @use(i64 %v)
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; SUBSXrr is as cheap as SUBXrr.
define void @sub_reg(i64 %n, i64 %b) {
; CHECK-LABEL: sub_reg:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    stp x30, x21, [sp, #-32]! // 16-byte Folded Spill
; CHECK-NEXT:    stp x20, x19, [sp, #16] // 16-byte Folded Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    .cfi_offset w19, -8
; CHECK-NEXT:    .cfi_offset w20, -16
; CHECK-NEXT:    .cfi_offset w21, -24
; CHECK-NEXT:    .cfi_offset w30, -32
; CHECK-NEXT:    mov x19, x0
; CHECK-NEXT:    mov x20, xzr
; CHECK-NEXT:    sub x21, x0, x1
; CHECK-NEXT:    b .LBB1_2
; CHECK-NEXT:  .LBB1_1: // %latch
