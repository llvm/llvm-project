; With alu-lsl-fast, SUBSXrs with a shift of at most 4 is as cheap as SUBXrs.
define void @sub_lsl(i64 %n, i64 %b) "target-features"="+alu-lsl-fast" {
; CHECK-LABEL: sub_lsl:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    stp x30, x21, [sp, #-32]! // 16-byte Folded Spill
; CHECK-NEXT:    stp x20, x19, [sp, #16] // 16-byte Folded Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    .cfi_offset w19, -8
; CHECK-NEXT:    .cfi_offset w20, -16
; CHECK-NEXT:    .cfi_offset w21, -24
; CHECK-NEXT:    .cfi_offset w30, -32
; CHECK-NEXT:    sub x20, x0, x1, lsl #3
; CHECK-NEXT:    mov x19, x0
; CHECK-NEXT:    mov x21, xzr
; CHECK-NEXT:    b .LBB2_2
; CHECK-NEXT:  .LBB2_1: // %latch
; CHECK-NEXT:    // in Loop: Header=BB2_2 Depth=1
; CHECK-NEXT:    bl use
; CHECK-NEXT:    add x21, x21, #1
; CHECK-NEXT:    cmp x19, x21
; CHECK-NEXT:    b.eq .LBB2_4
; CHECK-NEXT:  .LBB2_2: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    cmp x21, #5
; CHECK-NEXT:    mov x0, x21
; CHECK-NEXT:    b.ne .LBB2_1
; CHECK-NEXT:  // %bb.3: // %if
; CHECK-NEXT:    // in Loop: Header=BB2_2 Depth=1
; CHECK-NEXT:    bl cold
; CHECK-NEXT:    mov x0, x20
; CHECK-NEXT:    b .LBB2_1
; CHECK-NEXT:  .LBB2_4: // %exit
; CHECK-NEXT:    ldp x20, x19, [sp, #16] // 16-byte Folded Reload
; CHECK-NEXT:    ldp x30, x21, [sp], #32 // 16-byte Folded Reload
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %c = icmp eq i64 %i, 5
  br i1 %c, label %if, label %latch

if:
  call void @cold()
  %s = shl i64 %b, 3
  %d = sub i64 %n, %s
  br label %latch

latch:
  %v = phi i64 [ %d, %if ], [ %i, %loop ]
  call void @use(i64 %v)
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}
