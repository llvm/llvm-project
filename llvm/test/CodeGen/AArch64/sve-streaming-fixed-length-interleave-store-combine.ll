; splitting at 128 and 256 bits, and a single group at 512 bits.
define void @interleave_wide_v16i32_factor2_vscale1(ptr %output, ptr %input0, ptr %input1) vscale_range(1,1) {
; CHECK-LABEL: interleave_wide_v16i32_factor2_vscale1:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldp q2, q0, [x1, #32]
; CHECK-NEXT:    ptrue p0.s
; CHECK-NEXT:    ldp q4, q6, [x1]
; CHECK-NEXT:    ldp q3, q1, [x2, #32]
; CHECK-NEXT:    ldp q5, q7, [x2]
; CHECK-NEXT:    st2w { z0.s, z1.s }, p0, [x0, #6, mul vl]
; CHECK-NEXT:    st2w { z2.s, z3.s }, p0, [x0, #4, mul vl]
; CHECK-NEXT:    st2w { z6.s, z7.s }, p0, [x0, #2, mul vl]
; CHECK-NEXT:    st2w { z4.s, z5.s }, p0, [x0]
; CHECK-NEXT:    ret
  %v0 = load <16 x i32>, ptr %input0, align 4
  %v1 = load <16 x i32>, ptr %input1, align 4
  %interleave = call <32 x i32> @llvm.vector.interleave2.v32i32(<16 x i32> %v0, <16 x i32> %v1)
  store <32 x i32> %interleave, ptr %output, align 4
  ret void
}

