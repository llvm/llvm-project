    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:gpr32 = FREEZE [[DEF]]
    ; CHECK-NEXT: $w0 = COPY [[FREEZE]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
