; RUN: opt < %s -S -aarch64-stack-tagging -stack-tagging-use-stack-safety=0 -o - | FileCheck %s

; Stack history is recorded by default on Darwin.

target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx"

declare void @use(ptr)

; With a dynamic alloca in a loop, the base tag and the stack history record are
; hoisted out of the loop, so that they run once per call.
define void @loop(i32 %n) sanitize_memtag {
; CHECK-LABEL: define void @loop(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = call i64 @llvm.read_register.i64(metadata [[META0:![0-9]+]])
; CHECK-NEXT:    [[TMP1:%.*]] = inttoptr i64 [[TMP0]] to ptr
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[TMP1]], i32 1848
; CHECK-NEXT:    [[TMP3:%.*]] = load i64, ptr [[TMP2]], align 8
; CHECK-NEXT:    [[TMP4:%.*]] = call ptr @llvm.frameaddress.p0(i32 0)
; CHECK-NEXT:    [[TMP5:%.*]] = ptrtoint ptr [[TMP4]] to i64
; CHECK-NEXT:    [[TMP6:%.*]] = ptrtoint ptr [[BASETAG]] to i64
; CHECK-NEXT:    [[TMP7:%.*]] = and i64 [[TMP6]], 1080863910568919040
; CHECK-NEXT:    [[TMP8:%.*]] = or i64 [[TMP5]], [[TMP7]]
; CHECK-NEXT:    [[TMP9:%.*]] = call i64 @llvm.read_register.i64(metadata [[META1:![0-9]+]])
; CHECK-NEXT:    [[TMP10:%.*]] = inttoptr i64 [[TMP3]] to ptr
; CHECK-NEXT:    store i64 [[TMP9]], ptr [[TMP10]], align 8
; CHECK-NEXT:    [[TMP11:%.*]] = getelementptr i64, ptr [[TMP10]], i64 1
; CHECK-NEXT:    store i64 [[TMP8]], ptr [[TMP11]], align 8
; CHECK-NEXT:    [[TMP12:%.*]] = ashr i64 [[TMP3]], 60
; CHECK-NEXT:    [[TMP13:%.*]] = shl nuw nsw i64 [[TMP12]], 12
; CHECK-NEXT:    [[TMP14:%.*]] = xor i64 [[TMP13]], -1
; CHECK-NEXT:    [[TMP15:%.*]] = add i64 [[TMP3]], 16
; CHECK-NEXT:    [[TMP16:%.*]] = and i64 [[TMP15]], [[TMP14]]
; CHECK-NEXT:    store i64 [[TMP16]], ptr [[TMP2]], align 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    [[TMP17:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP18:%.*]] = mul i64 [[TMP17]], 1
; CHECK-NEXT:    [[TMP19:%.*]] = add i64 [[TMP18]], 15
; CHECK-NEXT:    [[TMP20:%.*]] = and i64 [[TMP19]], -16
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i64 [[TMP20]], align 16
; CHECK-NEXT:    [[VLA_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[VLA]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP21:%.*]] = ptrtoint ptr [[VLA]] to i64
; CHECK-NEXT:    store i64 [[TMP21]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[VLA_TAG]], i64 [[TMP20]])
; CHECK-NEXT:    call void @use(ptr [[VLA_TAG]])
; CHECK-NEXT:    [[TMP22:%.*]] = call i64 @llvm.get.dynamic.area.offset.i64()
; CHECK-NEXT:    [[TMP23:%.*]] = ptrtoint ptr [[SP]] to i64
; CHECK-NEXT:    [[UNTAG_END1:%.*]] = add i64 [[TMP23]], [[TMP22]]
; CHECK-NEXT:    [[LAST_ALLOCA2:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP24:%.*]] = icmp ne i64 [[LAST_ALLOCA2]], 0
; CHECK-NEXT:    [[TMP25:%.*]] = icmp ule i64 [[LAST_ALLOCA2]], [[UNTAG_END1]]
; CHECK-NEXT:    [[TMP26:%.*]] = and i1 [[TMP24]], [[TMP25]]
; CHECK-NEXT:    [[TMP27:%.*]] = sub i64 [[UNTAG_END1]], [[LAST_ALLOCA2]]
; CHECK-NEXT:    [[UNTAG_SIZE3:%.*]] = select i1 [[TMP26]], i64 [[TMP27]], i64 0
; CHECK-NEXT:    [[TMP28:%.*]] = inttoptr i64 [[LAST_ALLOCA2]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP28]], i64 [[UNTAG_SIZE3]])
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
