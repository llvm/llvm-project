; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP29:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP30:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP31:%.*]] = and i1 [[TMP29]], [[TMP30]]
; CHECK-NEXT:    [[TMP32:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP31]], i64 [[TMP32]], i64 0
; CHECK-NEXT:    [[TMP33:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP33]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %sp = call ptr @llvm.stacksave.p0()
  %vla = alloca i8, i32 %n, align 1
  call void @use(ptr %vla)
  call void @llvm.stackrestore.p0(ptr %sp)
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}
;.
