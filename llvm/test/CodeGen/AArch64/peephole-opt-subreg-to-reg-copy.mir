# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64-- -run-pass=peephole-opt -o - %s | FileCheck %s

# A copy of the inserted subregister of a SUBREG_TO_REG should be
# rewritten to copy the inserted value.

---
name: copy_subreg_to_reg_sub_32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: copy_subreg_to_reg_sub_32
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:gpr64 = SUBREG_TO_REG [[ADDWrr]], %subreg.sub_32
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY [[ADDWrr]]
    ; CHECK-NEXT: $w0 = COPY [[COPY2]]
    ; CHECK-NEXT: $x1 = COPY [[SUBREG_TO_REG]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0, implicit $x1
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = ADDWrr %0, %1
    %3:gpr64 = SUBREG_TO_REG %2, %subreg.sub_32
    %4:gpr32 = COPY %3.sub_32
    $w0 = COPY %4
    $x1 = COPY %3
    RET_ReallyLR implicit $w0, implicit $x1
...

# The copied subregister is disjoint from the inserted subregister, so
# the copy must not be rewritten.
---
name: copy_subreg_to_reg_disjoint_subreg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q0, $q1
    ; CHECK-LABEL: name: copy_subreg_to_reg_disjoint_subreg
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr128 = COPY $q0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr128 = COPY $q1
    ; CHECK-NEXT: [[ADDv4i32_:%[0-9]+]]:fpr128 = ADDv4i32 [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:qq = SUBREG_TO_REG [[ADDv4i32_]], %subreg.qsub0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr128 = COPY [[SUBREG_TO_REG]].qsub1
    ; CHECK-NEXT: $q0 = COPY [[COPY2]]
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:fpr128 = COPY $q0
    %1:fpr128 = COPY $q1
    %2:fpr128 = ADDv4i32 %0, %1
    %3:qq = SUBREG_TO_REG %2, %subreg.qsub0
    %4:fpr128 = COPY %3.qsub1
    $q0 = COPY %4
    RET_ReallyLR implicit $q0
...

# The copied subregister is contained in the inserted subregister. This
# could be rewritten to copy a subregister of the inserted value, but
# composing the subregister indexes is not handled.
---
name: copy_subreg_to_reg_contained_subreg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $d0, $d1
    ; CHECK-LABEL: name: copy_subreg_to_reg_contained_subreg
    ; CHECK: liveins: $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr64 = COPY $d0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr64 = COPY $d1
    ; CHECK-NEXT: [[ADDv2i32_:%[0-9]+]]:fpr64 = ADDv2i32 [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[SUBREG_TO_REG:%[0-9]+]]:fpr128 = SUBREG_TO_REG [[ADDv2i32_]], %subreg.dsub
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr32 = COPY [[SUBREG_TO_REG]].ssub
    ; CHECK-NEXT: $s0 = COPY [[COPY2]]
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %0:fpr64 = COPY $d0
    %1:fpr64 = COPY $d1
    %2:fpr64 = ADDv2i32 %0, %1
    %3:fpr128 = SUBREG_TO_REG %2, %subreg.dsub
    %4:fpr32 = COPY %3.ssub
    $s0 = COPY %4
    RET_ReallyLR implicit $s0
...
