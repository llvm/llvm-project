; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc %s -o - -mtriple=aarch64 -mattr=+outline-atomics -O1 | FileCheck %s

; End-to-end companion to machine-cse-subreg-copy.mir. The atomicrmw expansion
; produces `%v = COPY %x.sub_32` feeding both the AND and the return; coalescing
; that copy lets the loaded value land in w0, so the `mov w0, w8` after the loop
; is traded for a `mov x8, x0` before it. The Atomics/*.ll tests filter `mov`
; out of their CHECK lines, so this file keeps the full sequence visible.
define i8 @nand_i8(ptr %ptr, i8 %value) {
; CHECK-LABEL: nand_i8:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov x8, x0
; CHECK-NEXT:  .LBB0_1: // %atomicrmw.start
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldxrb w0, [x8]
; CHECK-NEXT:    and w9, w0, w1
; CHECK-NEXT:    mvn w9, w9
; CHECK-NEXT:    stxrb w10, w9, [x8]
; CHECK-NEXT:    cbnz w10, .LBB0_1
; CHECK-NEXT:  // %bb.2: // %atomicrmw.end
; CHECK-NEXT:    // kill: def $w0 killed $w0 killed $x0
; CHECK-NEXT:    ret
  %r = atomicrmw nand ptr %ptr, i8 %value monotonic, align 1
  ret i8 %r
}
