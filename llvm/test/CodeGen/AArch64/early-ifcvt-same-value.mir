---
name:            same_def_different_operand
liveins:
  - { reg: '$s1', virtual-reg: '%4' }
  - { reg: '$w0', virtual-reg: '%5' }
  - { reg: '$x2', virtual-reg: '%9' }
body:             |
  ; CHECK-LABEL: name: same_def_different_operand
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   liveins: $s1, $w0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x0
  ; CHECK-NEXT:   early-clobber %3:gpr64common, %4:gpr64 = LDRXpre [[COPY]], 16
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32common = COPY $w0
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:fpr32 = COPY $s1
  ; CHECK-NEXT:   [[SUBSWri:%[0-9]+]]:gpr32 = SUBSWri [[COPY1]], 1, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[CSELXr:%[0-9]+]]:gpr64common = CSELXr %3, %4, 1, implicit $nzcv
  ; CHECK-NEXT:   $x2 = COPY [[CSELXr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $x2
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $s1, $w0, $x2

    %9:gpr64common = COPY $x0
    early-clobber %11:gpr64common, %10:gpr64 = LDRXpre %9:gpr64common, 16

    %5:gpr32common = COPY $w0
    %4:fpr32 = COPY $s1
    %6:gpr32 = SUBSWri %5, 1, 0, implicit-def $nzcv
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.3

    B %bb.3

  bb.2:
    successors: %bb.3

    B %bb.3

  bb.3:
    %2:gpr64common = PHI %11, %bb.2, %10, %bb.1
    $x2 = COPY %2
    RET_ReallyLR implicit $x2

...
---
name:            csel_fold_undef
body: |
  ; CHECK-LABEL: name: csel_fold_undef
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32common = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
  ; CHECK-NEXT:   [[SUBSWri:%[0-9]+]]:gpr32 = SUBSWri [[COPY]], 1, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr32 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr32 = COPY undef %4:gpr32
  ; CHECK-NEXT:   [[CSELWr:%[0-9]+]]:gpr32 = CSELWr [[COPY2]], [[COPY3]], 1, implicit $nzcv
  ; CHECK-NEXT:   $w0 = COPY [[CSELWr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; A csel-fold operand that is a copy of an undef register has no defining
  ; instruction and must not be dereferenced.
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $w0, $w1
    %0:gpr32common = COPY $w0
    %6:gpr32 = COPY $w1
    %1:gpr32 = SUBSWri %0, 1, 0, implicit-def $nzcv
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.3
    %2:gpr32 = COPY undef %3:gpr32
    B %bb.3

  bb.2:
    successors: %bb.3
    %4:gpr32 = COPY %6

  bb.3:
    %5:gpr32 = PHI %4, %bb.2, %2, %bb.1
    $w0 = COPY %5
    RET_ReallyLR implicit $w0
...
