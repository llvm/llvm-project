; Rewrite shifted masks so the resulting left shift folds into users.

; (X >> C) & Mask -> ((X & (Mask << C)) >> (C + Scale)) << Scale.

define i16 @load_i16(ptr %base, i64 %x) {
; CHECK-LABEL: load_i16:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx x8, x1, #6, #8
; CHECK-NEXT:    ldrh w0, [x0, x8, lsl #1]
; CHECK-NEXT:    ret
  %shift = lshr i64 %x, 5
  %offset = and i64 %shift, u0x1fe
  %addr = getelementptr i8, ptr %base, i64 %offset
  %value = load i16, ptr %addr
  ret i16 %value
}

