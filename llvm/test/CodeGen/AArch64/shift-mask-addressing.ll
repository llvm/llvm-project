; CHECK-NEXT:    lsr w8, w1, #28
; CHECK-NEXT:    ldr x0, [x0, w8, uxtw #3]
; CHECK-NEXT:    ret
  %mask = bitcast i32 u0x7f8 to i32
  %shift = lshr i32 %x, 25
  %masked = and i32 %shift, %mask
  %offset = zext i32 %masked to i64
  %addr = getelementptr i8, ptr %base, i64 %offset
  %value = load i64, ptr %addr
  ret i64 %value
}

