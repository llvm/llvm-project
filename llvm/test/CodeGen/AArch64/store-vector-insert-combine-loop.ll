; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=aarch64-none-linux-gnu < %s | FileCheck %s

; Make sure llc does not hang on stores of bitcast constant vectors.
; #238314 split the store of an insert_vector_elt chain into element stores,
; mergeConsecutiveStores merged them back into a store of BUILD_VECTOR, and
; LowerBUILD_VECTOR rebuilt the same chain, so the DAG combiner never finished.

define void @zero_vec_stores(ptr %p) {
; CHECK-LABEL: zero_vec_stores:
; CHECK:       // %bb.0:
; CHECK-NEXT:    movi d0, #0000000000000000
; CHECK-NEXT:    movi v1.2d, #0000000000000000
; CHECK-NEXT:    str xzr, [x0, #48]
; CHECK-NEXT:    movi v2.2d, #0000000000000000
; CHECK-NEXT:    fmov x8, d0
; CHECK-NEXT:    mov v1.d[1], x8
; CHECK-NEXT:    mov v2.d[1], x8
; CHECK-NEXT:    str q1, [x0]
; CHECK-NEXT:    stur q2, [x0, #24]
; CHECK-NEXT:    ret
  store ptr null, ptr %p, align 8
  %p1 = getelementptr i8, ptr %p, i64 8
  store <2 x float> zeroinitializer, ptr %p1, align 8
  %p2 = getelementptr i8, ptr %p, i64 24
  store <2 x i32> zeroinitializer, ptr %p2, align 8
  %p3 = getelementptr i8, ptr %p, i64 32
  store <2 x float> zeroinitializer, ptr %p3, align 8
  %p4 = getelementptr i8, ptr %p, i64 48
  store i32 0, ptr %p4, align 8
  %p5 = getelementptr i8, ptr %p, i64 52
  store float 0.000000e+00, ptr %p5, align 4
  ret void
}
