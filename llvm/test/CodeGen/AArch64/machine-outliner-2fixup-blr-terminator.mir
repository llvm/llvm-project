# RUN: llc -mtriple=aarch64--- -run-pass=machine-outliner %s -o - | FileCheck %s

# Under branch-target-enforcement, an indirect call at the end of the candidate
# is safely outlined as a thunk via X16 without requiring stack fixups.

# CHECK-LABEL: name: OUTLINED_FUNCTION_0
# CHECK:       $x16 = ORRXrs $xzr, $x20, 0
# CHECK-NEXT:  TCRETURNrix16x17 $x16, 0, implicit $sp

--- |
  define void @f1() #0 { ret void }
  define void @f2() #0 { ret void }
  define void @f3() #0 { ret void }
  define void @f4() #0 { ret void }
  attributes #0 = { minsize noredzone "branch-target-enforcement" }
...
---
name: f1
body: |
  bb.0:
  liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x18, $x19, $x20, $x21, $x22, $x23, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $fp
    $x20, $x19 = LDPXi $sp, 11
    $x20, $x19 = LDPXi $sp, 12
    $x20, $x19 = LDPXi $sp, 13
    $x20, $x19 = LDPXi $sp, 14
    $x20, $x19 = LDPXi $sp, 18
    $x20, $x19 = LDPXi $sp, 19
    $x20, $x19 = LDPXi $sp, 20
    $x20, $x19 = LDPXi $sp, 21
    BLR $x20, implicit $sp
  bb.2:
  liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x18, $x19, $x20, $x21, $x22, $x23, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $fp
    RET undef $lr
...
---
name: f2
body: |
  bb.0:
  liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x18, $x19, $x20, $x21, $x22, $x23, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $fp
    $x20, $x19 = LDPXi $sp, 11
    $x20, $x19 = LDPXi $sp, 12
    $x20, $x19 = LDPXi $sp, 13
    $x20, $x19 = LDPXi $sp, 14
    $x20, $x19 = LDPXi $sp, 18
    $x20, $x19 = LDPXi $sp, 19
    $x20, $x19 = LDPXi $sp, 20
    $x20, $x19 = LDPXi $sp, 21
    BLR $x20, implicit $sp
  bb.2:
  liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x18, $x19, $x20, $x21, $x22, $x23, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $fp
    RET undef $lr
...
---
name: f3
body: |
  bb.0:
  liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x18, $x19, $x20, $x21, $x22, $x23, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $fp
    $x20, $x19 = LDPXi $sp, 11
    $x20, $x19 = LDPXi $sp, 12
    $x20, $x19 = LDPXi $sp, 13
    $x20, $x19 = LDPXi $sp, 14
    $x20, $x19 = LDPXi $sp, 18
    $x20, $x19 = LDPXi $sp, 19
    $x20, $x19 = LDPXi $sp, 20
    $x20, $x19 = LDPXi $sp, 21
    BLR $x20, implicit $sp
  bb.2:
  liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x18, $x19, $x20, $x21, $x22, $x23, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $fp
    RET undef $lr
...
---
name: f4
