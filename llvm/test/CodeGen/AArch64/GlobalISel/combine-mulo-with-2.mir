    ; CHECK-NEXT: %overflow_ext:_(i32) = G_ZEXT %o(i1)
    ; CHECK-NEXT: $w0 = COPY %overflow_ext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %copy:_(i64) = COPY $x0
    %two:_(i64) = G_CONSTANT i64 2
    %mul:_(i64), %o:_(i1) = G_SMULO %copy, %two
    %overflow_ext:_(i32) = G_ZEXT %o(i1)
    $w0 = COPY %overflow_ext(i32)
    RET_ReallyLR implicit $w0
...
