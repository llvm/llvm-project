    %mul:_(<2 x i32>), %o:_(<2 x i1>) = G_SMULO %copy, %splat_two
    %overflow_ext:_(<2 x i32>) = G_ANYEXT %o(<2 x i1>)
    $d0 = COPY %overflow_ext(<2 x i32>)
    RET_ReallyLR implicit $d0
