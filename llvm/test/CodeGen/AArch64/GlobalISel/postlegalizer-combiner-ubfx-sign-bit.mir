# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -run-pass=aarch64-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Bits 15..31 of an ashr by 16 are all copies of the sign bit, so a 1-bit
# extract of bit 15 is a shift of the sign bit into bit 0.
---
name:            ashr16_ubfx15
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ashr16_ubfx15
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %sh:_(i64) = G_CONSTANT i64 16
    ; CHECK-NEXT: %ashr:_(i32) = G_ASHR %x, %sh(i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 31
    ; CHECK-NEXT: %ubfx:_(i32) = G_LSHR %ashr, [[C]](i64)
    ; CHECK-NEXT: $w0 = COPY %ubfx(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %sh:_(i64) = G_CONSTANT i64 16
    %ashr:_(i32) = G_ASHR %x, %sh(i64)
    %lsb:_(i32) = G_CONSTANT i32 15
    %one:_(i32) = G_CONSTANT i32 1
    %ubfx:_(i32) = G_UBFX %ashr, %lsb(i32), %one
    $w0 = COPY %ubfx(i32)
    RET_ReallyLR implicit $w0
...
---
# One sign bit too few: bit 15 of an ashr by 15 is not known to be a sign copy.
name:            ashr15_ubfx15
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ashr15_ubfx15
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %sh:_(i64) = G_CONSTANT i64 15
    ; CHECK-NEXT: %ashr:_(i32) = G_ASHR %x, %sh(i64)
    ; CHECK-NEXT: %lsb:_(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %ubfx:_(i32) = G_UBFX %ashr, %lsb(i32), %one
    ; CHECK-NEXT: $w0 = COPY %ubfx(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %sh:_(i64) = G_CONSTANT i64 15
    %ashr:_(i32) = G_ASHR %x, %sh(i64)
    %lsb:_(i32) = G_CONSTANT i32 15
    %one:_(i32) = G_CONSTANT i32 1
    %ubfx:_(i32) = G_UBFX %ashr, %lsb(i32), %one
    $w0 = COPY %ubfx(i32)
    RET_ReallyLR implicit $w0
...
---
# Only 1-bit extracts are combined.
name:            ashr16_ubfx15_width2
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ashr16_ubfx15_width2
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %sh:_(i64) = G_CONSTANT i64 16
    ; CHECK-NEXT: %ashr:_(i32) = G_ASHR %x, %sh(i64)
    ; CHECK-NEXT: %lsb:_(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: %two:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: %ubfx:_(i32) = G_UBFX %ashr, %lsb(i32), %two
    ; CHECK-NEXT: $w0 = COPY %ubfx(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %sh:_(i64) = G_CONSTANT i64 16
    %ashr:_(i32) = G_ASHR %x, %sh(i64)
    %lsb:_(i32) = G_CONSTANT i32 15
    %two:_(i32) = G_CONSTANT i32 2
    %ubfx:_(i32) = G_UBFX %ashr, %lsb(i32), %two
    $w0 = COPY %ubfx(i32)
    RET_ReallyLR implicit $w0
...
---
# 64-bit: bits 31..63 of an ashr by 32 are sign copies, so this becomes an
# lshr by 63.
name:            ashr32_ubfx31_s64
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: ashr32_ubfx31_s64
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: %sh:_(i64) = G_CONSTANT i64 32
    ; CHECK-NEXT: %ashr:_(i64) = G_ASHR %x, %sh(i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 63
    ; CHECK-NEXT: %ubfx:_(i64) = G_LSHR %ashr, [[C]](i64)
    ; CHECK-NEXT: $x0 = COPY %ubfx(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i64) = COPY $x0
    %sh:_(i64) = G_CONSTANT i64 32
    %ashr:_(i64) = G_ASHR %x, %sh(i64)
    %lsb:_(i64) = G_CONSTANT i64 31
    %one:_(i64) = G_CONSTANT i64 1
    %ubfx:_(i64) = G_UBFX %ashr, %lsb(i64), %one
    $x0 = COPY %ubfx(i64)
    RET_ReallyLR implicit $x0
...
