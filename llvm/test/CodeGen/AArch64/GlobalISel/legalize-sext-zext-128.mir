    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(p0) = COPY $x1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 63
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(i64) = G_ASHR [[COPY]], [[C]](i64)
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES [[COPY]](i64), [[ASHR]](i64)
    ; CHECK-NEXT: G_STORE [[MV]](i128), [[COPY1]](p0) :: (store (i128))
    ; CHECK-NEXT: RET_ReallyLR
    %0:_(i64) = COPY $x0
    %1:_(p0) = COPY $x1
    %2:_(i128) = G_SEXT %0(i64)
    G_STORE %2(i128), %1(p0) :: (store (i128))
    RET_ReallyLR

...
