# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -passes="print<gisel-value-tracking>" %s -filetype=null 2>&1 | FileCheck %s
---
# Extract subvector from sign-extended vector - sign bits propagate
name: ExtractSubvector_Sext
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_Sext
  ; CHECK-NEXT: %0:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %2:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %3:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %5:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %6:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %7:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %8:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %9:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %10:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %11:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %12:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %13:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %14:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %15:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %16:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %17:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
    %0:_(i8) = COPY $b0
    %1:_(i16) = G_SEXT %0
    %2:_(i8) = COPY $b1
    %3:_(i16) = G_SEXT %2
    %4:_(i8) = COPY $b2
    %5:_(i16) = G_SEXT %4
    %6:_(i8) = COPY $b3
    %7:_(i16) = G_SEXT %6
    %8:_(i8) = COPY $b4
    %9:_(i16) = G_SEXT %8
    %10:_(i8) = COPY $b5
    %11:_(i16) = G_SEXT %10
    %12:_(i8) = COPY $b6
    %13:_(i16) = G_SEXT %12
    %14:_(i8) = COPY $b7
    %15:_(i16) = G_SEXT %14
    %16:_(<8 x i16>) = G_BUILD_VECTOR %1, %3, %5, %7, %9, %11, %13, %15
    ; Extract first 4 elements - should preserve 9 sign bits
    %17:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %16, 0
...
---
