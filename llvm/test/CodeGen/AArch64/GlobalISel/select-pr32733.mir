# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64-- -run-pass=instruction-select %s -o - | FileCheck %s

--- |
  define i32 @main() {
  entry:
    ret i32 0
  }

  declare i32 @printf(ptr, ...)
...
---
name:            main
alignment:       4
exposesReturnsTwice: false
legalized:       true
regBankSelected: true
selected:        false
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    8
  adjustsStack:    false
  hasCalls:        true
  maxCallFrameSize: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
body:             |
  bb.1.entry:
    liveins: $w0
    ; CHECK-LABEL: name: main
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[ORNWrr:%[0-9]+]]:gpr32 = ORNWrr $wzr, [[COPY]]
    ; CHECK-NEXT: [[EORWri:%[0-9]+]]:gpr32sp = EORWri [[ORNWrr]], 0
    ; CHECK-NEXT: $w0 = COPY [[EORWri]]
    %0:gpr(i32) = G_CONSTANT i32 -1
    %3:gpr(i32) = G_CONSTANT i32 1
    %1:gpr(i32) = COPY $w0
    %2:gpr(i32) = G_XOR %1, %0
    %4:gpr(i32) = G_XOR %2, %3
    $w0 = COPY %4(i32)
...
