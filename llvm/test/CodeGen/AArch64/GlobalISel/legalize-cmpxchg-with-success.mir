# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64-- -mattr=+lse -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"

  define void @cmpxchg_i32(ptr %addr) { ret void }
  define void @cmpxchg_i64(ptr %addr) { ret void }
...

---
name:            cmpxchg_i32

body:             |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: cmpxchg_i32
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[ATOMIC_CMPXCHG:%[0-9]+]]:_(i32) = G_ATOMIC_CMPXCHG [[COPY]](p0), [[C]], [[C1]] :: (load store monotonic (i64) on %ir.addr)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[ATOMIC_CMPXCHG]](i32), [[C]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY [[ATOMIC_CMPXCHG]](i32)
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[COPY1]], [[ICMP]]
    ; CHECK-NEXT: $w0 = COPY [[MUL]](i32)
    %0:_(p0) = COPY $x0
    %1:_(i32) = G_CONSTANT i32 0
    %2:_(i32) = G_CONSTANT i32 1
    %3:_(i32), %4:_(i1) = G_ATOMIC_CMPXCHG_WITH_SUCCESS %0, %1, %2 :: (load store monotonic (i64) on %ir.addr)
    %5:_(i32) = G_ANYEXT %4
    %6:_(i32) = G_MUL %3, %5
    $w0 = COPY %6(i32)
...

---
name:            cmpxchg_i64

body:             |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: cmpxchg_i64
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[ATOMIC_CMPXCHG:%[0-9]+]]:_(i64) = G_ATOMIC_CMPXCHG [[COPY]](p0), [[C]], [[C1]] :: (load store monotonic (i64) on %ir.addr)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[ATOMIC_CMPXCHG]](i64), [[C]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY [[ATOMIC_CMPXCHG]](i64)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[ICMP]](i32)
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[COPY1]], [[ANYEXT]]
    ; CHECK-NEXT: $x0 = COPY [[MUL]](i64)
    %0:_(p0) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 0
    %2:_(i64) = G_CONSTANT i64 1
    %3:_(i64), %4:_(i1) = G_ATOMIC_CMPXCHG_WITH_SUCCESS %0, %1, %2 :: (load store monotonic (i64) on %ir.addr)
    %5:_(i64) = G_ANYEXT %4
    %6:_(i64) = G_MUL %3, %5
    $x0 = COPY %6(i64)
...
