# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner -global-isel %s -o - | FileCheck %s

# (G_*ADDE x, y, 0) -> (G_*ADDO x, y), including splat-zero carry-in.

---
name:            uadde_zero
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: uadde_zero
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %y:_(i32) = COPY $w1
    ; CHECK-NEXT: %add:_(i32), %o:_(i1) = G_UADDO %x, %y
    ; CHECK-NEXT: %o_wide:_(i32) = G_ZEXT %o(i1)
    ; CHECK-NEXT: $w0 = COPY %add(i32)
    ; CHECK-NEXT: $w1 = COPY %o_wide(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %y:_(i32) = COPY $w1
    %zero:_(i1) = G_CONSTANT i1 0
    %add:_(i32), %o:_(i1) = G_UADDE %x, %y, %zero
    %o_wide:_(i32) = G_ZEXT %o(i1)
    $w0 = COPY %add(i32)
    $w1 = COPY %o_wide
    RET_ReallyLR implicit $w0
...
