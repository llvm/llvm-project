---
name:            vector_splat_zero
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0, $d1
    ; CHECK-LABEL: name: vector_splat_zero
    ; CHECK: liveins: $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<2 x i32>) = COPY $d0
    ; CHECK-NEXT: %y:_(<2 x i32>) = COPY $d1
    ; CHECK-NEXT: %add:_(<2 x i32>), %o:_(<2 x i1>) = G_UADDO %x, %y
    ; CHECK-NEXT: %o_ext:_(<2 x i32>) = G_ANYEXT %o(<2 x i1>)
    ; CHECK-NEXT: $d0 = COPY %o_ext(<2 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %x:_(<2 x i32>) = COPY $d0
    %y:_(<2 x i32>) = COPY $d1
    %zero:_(i1) = G_CONSTANT i1 0
    %splat_zero:_(<2 x i1>) = G_BUILD_VECTOR %zero(i1), %zero(i1)
    %add:_(<2 x i32>), %o:_(<2 x i1>) = G_UADDE %x, %y, %splat_zero
    %o_ext:_(<2 x i32>) = G_ANYEXT %o(<2 x i1>)
    $d0 = COPY %o_ext(<2 x i32>)
    RET_ReallyLR implicit $d0
...
