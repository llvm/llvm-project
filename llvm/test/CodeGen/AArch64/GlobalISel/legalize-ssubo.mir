---
name:            test_scalar_ssubo_small
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_scalar_ssubo_small
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i32) = G_SEXT_INREG [[TRUNC]], 8
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(i32) = G_TRUNC [[COPY1]](i64)
    ; CHECK-NEXT: [[SEXT_INREG1:%[0-9]+]]:_(i32) = G_SEXT_INREG [[TRUNC1]], 8
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i32) = G_SUB [[SEXT_INREG]], [[SEXT_INREG1]]
    ; CHECK-NEXT: [[SEXT_INREG2:%[0-9]+]]:_(i32) = G_SEXT_INREG [[SUB]], 8
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[SUB]](i32), [[SEXT_INREG2]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[SUB]](i32)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i64) = G_ANYEXT [[ICMP]](i32)
    ; CHECK-NEXT: $x0 = COPY [[ANYEXT]](i64)
    ; CHECK-NEXT: $x1 = COPY [[ANYEXT1]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i8) = G_TRUNC %0(i64)
    %3:_(i8) = G_TRUNC %1(i64)
    %4:_(i8), %5:_(i1) = G_SSUBO %2, %3
    %6:_(i64) = G_ANYEXT %4(i8)
    %7:_(i64) = G_ANYEXT %5(i1)
    $x0 = COPY %6(i64)
    $x1 = COPY %7(i64)

