    %1:_(i64) = COPY $x1
    %2:_(i64) = COPY $x2
    %3:_(i64) = COPY $x3
    %lhs:_(i128) = G_MERGE_VALUES %0, %1
    %rhs:_(i128) = G_MERGE_VALUES %2, %3
    %sub:_(i128), %carry_out:_(i1) = G_SSUBO %lhs, %rhs
    %sub0:_(i64), %sub1:_(i64) = G_UNMERGE_VALUES %sub
    %carry_out_ext:_(i64) = G_ANYEXT %carry_out
    $x0 = COPY %sub0
    $x1 = COPY %sub1
    $x2 = COPY %carry_out_ext

