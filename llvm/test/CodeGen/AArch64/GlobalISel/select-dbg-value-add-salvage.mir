---
name:            ptr_add_reg_folded
legalized:       true
regBankSelected: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: ptr_add_reg_folded
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64sp = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr64 = COPY $x1
    ; CHECK-NEXT: DBG_VALUE_LIST !12, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), [[COPY]], [[COPY1]], debug-location !DILocation(line: 1, column: 1, scope: !4)
    ; CHECK-NEXT: [[LDRXroX:%[0-9]+]]:gpr64 = LDRXroX [[COPY]], [[COPY1]], 0, 0 :: (load (i64))
    ; CHECK-NEXT: $x0 = COPY [[LDRXroX]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %0:gpr(p0) = COPY $x0
    %1:gpr(i64) = COPY $x1
    %2:gpr(p0) = G_PTR_ADD %0, %1(i64)
    DBG_VALUE %2(p0), $noreg, !21, !DIExpression(), debug-location !22
    %3:gpr(i64) = G_LOAD %2(p0) :: (load (i64))
    $x0 = COPY %3(i64)
    RET_ReallyLR implicit $x0
...
