# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Negative: ctlz(0) is defined as bitwidth and must not become poison.
---
name:            ctlz_constant_zero_no_combine
body:             |
  bb.0:
    ; CHECK-LABEL: name: ctlz_constant_zero_no_combine
    ; CHECK: %r:_(i32) = G_CONSTANT i32 32
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %z:_(i32) = G_CONSTANT i32 0
    %r:_(i32) = G_CTLZ %z
    $w0 = COPY %r(i32)
...
---
name:            ctlz_unknown_no_combine
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ctlz_unknown_no_combine
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %r:_(i32) = G_CTLZ %x(i32)
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i32) = COPY $w0
    %r:_(i32) = G_CTLZ %x
    $w0 = COPY %r(i32)
...
---
name:            ctlz_or_with_one
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ctlz_or_with_one
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %or:_(i32) = G_OR %x, %one
    ; CHECK-NEXT: %r:_(i32) = G_CTLZ_ZERO_POISON %or(i32)
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i32) = COPY $w0
    %one:_(i32) = G_CONSTANT i32 1
    %or:_(i32) = G_OR %x, %one
    %r:_(i32) = G_CTLZ %or
    $w0 = COPY %r(i32)
...
---
name:            cttz_shl_one_nuw
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: cttz_shl_one_nuw
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %shl:_(i32) = nuw G_SHL %one, %x(i32)
    ; CHECK-NEXT: %r:_(i32) = G_CTTZ_ZERO_POISON %shl(i32)
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i32) = COPY $w0
    %one:_(i32) = G_CONSTANT i32 1
    %shl:_(i32) = nuw G_SHL %one, %x
    %r:_(i32) = G_CTTZ %shl
    $w0 = COPY %r(i32)
...
---
name:            cttz_select_both_nonzero
body:             |
  bb.0:
    liveins: $w0, $w1, $w2
    ; CHECK-LABEL: name: cttz_select_both_nonzero
    ; CHECK: liveins: $w0, $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %y:_(i32) = COPY $w1
    ; CHECK-NEXT: %c:_(i32) = COPY $w2
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %c(i32)
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %xo:_(i32) = G_OR %x, %one
    ; CHECK-NEXT: %yo:_(i32) = G_OR %y, %one
    ; CHECK-NEXT: %sel:_(i32) = G_SELECT %cond(i1), %xo, %yo
    ; CHECK-NEXT: %r:_(i32) = G_CTTZ_ZERO_POISON %sel(i32)
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i32) = COPY $w0
    %y:_(i32) = COPY $w1
    %c:_(i32) = COPY $w2
    %cond:_(i1) = G_TRUNC %c
    %one:_(i32) = G_CONSTANT i32 1
    %xo:_(i32) = G_OR %x, %one
    %yo:_(i32) = G_OR %y, %one
    %sel:_(i32) = G_SELECT %cond(i1), %xo, %yo
    %r:_(i32) = G_CTTZ %sel
    $w0 = COPY %r(i32)
...
