# RUN: llc -mtriple=aarch64-- -verify-machineinstrs -run-pass=legalizer %s -o - | FileCheck %s
---
name:            test_udivrem_64
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_udivrem_64
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[UDIV:%[0-9]+]]:_(i64) = G_UDIV [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[UDIV]], [[COPY1]]
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[MUL]]
    ; CHECK-NEXT: $x0 = COPY [[UDIV]](i64)
    ; CHECK-NEXT: $x1 = COPY [[SUB]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64), %3:_(i64) = G_UDIVREM %0, %1
    $x0 = COPY %2(i64)
    $x1 = COPY %3(i64)

...
