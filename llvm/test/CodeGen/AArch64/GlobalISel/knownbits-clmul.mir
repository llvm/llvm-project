# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=aarch64 -passes="print<gisel-value-tracking>" -filetype=null %s 2>&1 | FileCheck %s

---
# Both operands constant: clmul(0b0011, 0b0101) = (x+1)(x^2+1) = x^3+x^2+x+1 =
# 0b1111, so the whole result is known.
name:            ClmulConst
body:             |
  bb.0:
  ; CHECK-LABEL: name: @ClmulConst
  ; CHECK-NEXT: %0:_ KnownBits:00000000000000000000000000000011 SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %1:_ KnownBits:00000000000000000000000000000101 SignBits:29 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:00000000000000000000000000001111 SignBits:28 IsKnownNeverZero:1
    %0:_(s32) = G_CONSTANT i32 3
    %1:_(s32) = G_CONSTANT i32 5
    %2:_(s32) = G_CLMUL %0, %1
...
---
# One operand is a single set bit at position 4 (0b10000), so clmul shifts the
# other operand left by 4 with no carries -> the low 4 result bits are known 0,
# the rest are unknown.
name:            ClmulTrailingZeros
body:             |
  bb.0:
    liveins: $w0
  ; CHECK-LABEL: name: @ClmulTrailingZeros
  ; CHECK-NEXT: %0:_ KnownBits:00000000000000000000000000010000 SignBits:27 IsKnownNeverZero:1
  ; CHECK-NEXT: %1:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %2:_ KnownBits:????????????????????????????0000 SignBits:1 IsKnownNeverZero:0
    %0:_(s32) = G_CONSTANT i32 16
    %1:_(s32) = COPY $w0
    %2:_(s32) = G_CLMUL %0, %1
...
---
# Both operands are masked to 4 bits ([0,15]), so the highest set bit of each is
# bit 3; a carry-less product of two degree-3 polynomials has degree <= 6, so
# result bits 7..31 are known 0 and bits 0..6 are unknown.
name:            ClmulHighZeros
body:             |
  bb.0:
    liveins: $w0, $w1
  ; CHECK-LABEL: name: @ClmulHighZeros
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:00000000000000000000000000001111 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:0000000000000000000000000000???? SignBits:28 IsKnownNeverZero:0
  ; CHECK-NEXT: %3:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:0000000000000000000000000000???? SignBits:28 IsKnownNeverZero:0
  ; CHECK-NEXT: %5:_ KnownBits:0000000000000000000000000??????? SignBits:25 IsKnownNeverZero:0
    %0:_(s32) = COPY $w0
    %1:_(s32) = G_CONSTANT i32 15
    %2:_(s32) = G_AND %0, %1
    %3:_(s32) = COPY $w1
    %4:_(s32) = G_AND %3, %1
    %5:_(s32) = G_CLMUL %2, %4
...
---
# Vector: the same 4-bit-mask reasoning applies per lane, so each lane has result
# bits 7..31 known 0.
name:            ClmulVector
body:             |
  bb.0:
    liveins: $q0, $q1
  ; CHECK-LABEL: name: @ClmulVector
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:00000000000000000000000000001111 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:00000000000000000000000000001111 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %3:_ KnownBits:0000000000000000000000000000???? SignBits:28 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %5:_ KnownBits:0000000000000000000000000000???? SignBits:28 IsKnownNeverZero:0
  ; CHECK-NEXT: %6:_ KnownBits:0000000000000000000000000??????? SignBits:25 IsKnownNeverZero:0
    %0:_(<4 x s32>) = COPY $q0
    %1:_(s32) = G_CONSTANT i32 15
    %2:_(<4 x s32>) = G_BUILD_VECTOR %1, %1, %1, %1
    %3:_(<4 x s32>) = G_AND %0, %2
    %4:_(<4 x s32>) = COPY $q1
    %5:_(<4 x s32>) = G_AND %4, %2
    %6:_(<4 x s32>) = G_CLMUL %3, %5
...
