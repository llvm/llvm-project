    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<4 x f32>) = G_BUILD_VECTOR [[C]](f32), [[C]](f32), [[C]](f32), [[C]](f32)
    ; CHECK-NEXT: [[FMAXIMUM:%[0-9]+]]:_(<4 x f32>) = G_FMAXIMUM [[BITCAST]], [[BUILD_VECTOR]]
    ; CHECK-NEXT: $q0 = COPY [[FMAXIMUM]](<4 x f32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %1:_(<2 x i64>) = COPY $q0
    %0:_(<4 x f32>) = G_BITCAST %1(<2 x i64>)
    %3:_(f32) = G_FCONSTANT float 0.000000e+00
    %2:_(<4 x f32>) = G_BUILD_VECTOR %3(f32), %3(f32), %3(f32), %3(f32)
    %4:_(<4 x i1>) = G_FCMP floatpred(olt), %0(<4 x f32>), %2
    %5:_(<4 x f32>) = G_SELECT %4(<4 x i1>), %2, %0
    $q0 = COPY %5(<4 x f32>)
    RET_ReallyLR implicit $q0

