name:            test_v8s16
body:             |
  bb.0:
    liveins: $q0

    ; CHECK-LABEL: name: test_v8s16
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<8 x f16>) = COPY $q0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f16) = G_FCONSTANT half 0.000000e+00
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<8 x f16>) = G_BUILD_VECTOR [[C]](f16), [[C]](f16), [[C]](f16), [[C]](f16), [[C]](f16), [[C]](f16), [[C]](f16), [[C]](f16)
    ; CHECK-NEXT: [[FMAXIMUM:%[0-9]+]]:_(<8 x f16>) = G_FMAXIMUM [[COPY]], [[BUILD_VECTOR]]
    ; CHECK-NEXT: $q0 = COPY [[FMAXIMUM]](<8 x f16>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(<8 x f16>) = COPY $q0
    %2:_(f16) = G_FCONSTANT half 0xH0000
    %1:_(<8 x f16>) = G_BUILD_VECTOR %2(f16), %2(f16), %2(f16), %2(f16), %2(f16), %2(f16), %2(f16), %2(f16)
    %3:_(<8 x i1>) = G_FCMP floatpred(olt), %0(<8 x f16>), %1
    %4:_(<8 x f16>) = G_SELECT %3(<8 x i1>), %1, %0
    $q0 = COPY %4(<8 x f16>)
    RET_ReallyLR implicit $q0

...
