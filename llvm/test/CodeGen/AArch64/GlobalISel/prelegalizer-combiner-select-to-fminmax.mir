# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -mattr=+fullfp16 -run-pass=aarch64-prelegalizer-combiner -global-isel -verify-machineinstrs %s -o - | FileCheck %s
---
name:            test_s16
body:             |
  bb.0:
    liveins: $h0

    ; CHECK-LABEL: name: test_s16
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f16) = COPY $h0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f16) = G_FCONSTANT half 0.000000e+00
    ; CHECK-NEXT: [[FMAXIMUM:%[0-9]+]]:_(f16) = G_FMAXIMUM [[COPY]], [[C]]
    ; CHECK-NEXT: $h0 = COPY [[FMAXIMUM]](f16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %0:_(f16) = COPY $h0
    %1:_(f16) = G_FCONSTANT half 0xH0000
    %2:_(i1) = G_FCMP floatpred(olt), %0(f16), %1
    %3:_(f16) = G_SELECT %2(i1), %1, %0
    $h0 = COPY %3(f16)
    RET_ReallyLR implicit $h0

...
