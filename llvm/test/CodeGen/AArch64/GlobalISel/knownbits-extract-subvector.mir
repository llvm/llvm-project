# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -passes="print<gisel-value-tracking>" %s -filetype=null 2>&1 | FileCheck %s
---
# Extract subvector from constant vector - known bits propagate
name: ExtractSubvector_Constant
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_Constant
  ; CHECK-NEXT: %0:_ KnownBits:0000000000001111 SignBits:12 IsKnownNeverZero:1
  ; CHECK-NEXT: %1:_ KnownBits:0000000000000111 SignBits:13 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:0000000000000011 SignBits:14 IsKnownNeverZero:1
  ; CHECK-NEXT: %3:_ KnownBits:0000000000000001 SignBits:15 IsKnownNeverZero:1
  ; CHECK-NEXT: %4:_ KnownBits:0000000011111111 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %5:_ KnownBits:0000000000111111 SignBits:10 IsKnownNeverZero:1
  ; CHECK-NEXT: %6:_ KnownBits:0000000000011111 SignBits:11 IsKnownNeverZero:1
  ; CHECK-NEXT: %7:_ KnownBits:0000000001111111 SignBits:9 IsKnownNeverZero:1
  ; CHECK-NEXT: %8:_ KnownBits:00000000???????1 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %9:_ KnownBits:000000000000???1 SignBits:12 IsKnownNeverZero:1
    %0:_(i16) = G_CONSTANT i16 15
    %1:_(i16) = G_CONSTANT i16 7
    %2:_(i16) = G_CONSTANT i16 3
    %3:_(i16) = G_CONSTANT i16 1
    %4:_(i16) = G_CONSTANT i16 255
    %5:_(i16) = G_CONSTANT i16 63
    %6:_(i16) = G_CONSTANT i16 31
    %7:_(i16) = G_CONSTANT i16 127
    %8:_(<8 x i16>) = G_BUILD_VECTOR %0, %1, %2, %3, %4, %5, %6, %7
    %9:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %8, 0
...
---
# Extract subvector with known zero high bits
name: ExtractSubvector_KnownZero
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_KnownZero
  ; CHECK-NEXT: %0:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:0000000011111111 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:0000000011111111 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %3:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
    %0:_(<8 x i16>) = COPY $q0
    %1:_(i16) = G_CONSTANT i16 255
    %2:_(<8 x i16>) = G_BUILD_VECTOR %1, %1, %1, %1, %1, %1, %1, %1
    %3:_(<8 x i16>) = G_AND %0, %2
    %4:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %3, 0
...
---
# Extract from non-zero index
name: ExtractSubvector_HighIndex
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_HighIndex
  ; CHECK-NEXT: %0:_ KnownBits:0000000000001111 SignBits:12 IsKnownNeverZero:1
  ; CHECK-NEXT: %1:_ KnownBits:0000000000000111 SignBits:13 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:0000000000000011 SignBits:14 IsKnownNeverZero:1
  ; CHECK-NEXT: %3:_ KnownBits:0000000000000001 SignBits:15 IsKnownNeverZero:1
  ; CHECK-NEXT: %4:_ KnownBits:0000000011111111 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %5:_ KnownBits:0000000000111111 SignBits:10 IsKnownNeverZero:1
  ; CHECK-NEXT: %6:_ KnownBits:0000000000011111 SignBits:11 IsKnownNeverZero:1
  ; CHECK-NEXT: %7:_ KnownBits:0000000001111111 SignBits:9 IsKnownNeverZero:1
  ; CHECK-NEXT: %8:_ KnownBits:00000000???????1 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %9:_ KnownBits:00000000???11111 SignBits:8 IsKnownNeverZero:1
    %0:_(i16) = G_CONSTANT i16 15
    %1:_(i16) = G_CONSTANT i16 7
    %2:_(i16) = G_CONSTANT i16 3
    %3:_(i16) = G_CONSTANT i16 1
    %4:_(i16) = G_CONSTANT i16 255
    %5:_(i16) = G_CONSTANT i16 63
    %6:_(i16) = G_CONSTANT i16 31
    %7:_(i16) = G_CONSTANT i16 127
    %8:_(<8 x i16>) = G_BUILD_VECTOR %0, %1, %2, %3, %4, %5, %6, %7
    %9:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %8, 4
...
---
# Scalable vector - conservative known bits
name: ExtractSubvector_Scalable
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_Scalable
  ; CHECK-NEXT: %0:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:0000000011111111 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:0000000011111111 SignBits:8 IsKnownNeverZero:1
  ; CHECK-NEXT: %3:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
    %0:_(<vscale x 4 x i16>) = COPY $z0
    %1:_(i16) = G_CONSTANT i16 255
    %2:_(<vscale x 4 x i16>) = G_SPLAT_VECTOR %1
    %3:_(<vscale x 4 x i16>) = G_AND %0, %2
    %4:_(<vscale x 2 x i16>) = G_EXTRACT_SUBVECTOR %3, 0
...
---
---
# computeNumSignBits: sign bits propagate through extract subvector
# Tests both lower and upper half extraction
name: ExtractSubvector_Sext
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_Sext
  ; CHECK-NEXT: %0:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %2:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %3:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %5:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
    %0:_(i8) = COPY $b0
    %1:_(i16) = COPY $h1
    %2:_(i16) = G_SEXT %0
    %3:_(<8 x i16>) = G_BUILD_VECTOR %2, %2, %2, %2, %2, %1, %2, %2
    %4:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %3, 0
    %5:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %3, 4
...
---
# computeNumSignBits: unknown in lower half, extract upper half
name: ExtractSubvector_Sext_HighIndex
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_Sext_HighIndex
  ; CHECK-NEXT: %0:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %2:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %3:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %4:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
    %0:_(i8) = COPY $b0
    %1:_(i16) = COPY $h1
    %2:_(i16) = G_SEXT %0
    %3:_(<8 x i16>) = G_BUILD_VECTOR %1, %1, %1, %1, %2, %2, %2, %2
    %4:_(<4 x i16>) = G_EXTRACT_SUBVECTOR %3, 4
...
---
# computeNumSignBits: scalable vector conservative
name: ExtractSubvector_Sext_Scalable
body: |
  bb.0:
  ; CHECK-LABEL: name: @ExtractSubvector_Sext_Scalable
  ; CHECK-NEXT: %0:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
  ; CHECK-NEXT: %2:_ KnownBits:???????????????? SignBits:9 IsKnownNeverZero:0
    %0:_(<vscale x 4 x i8>) = COPY $z0
    %1:_(<vscale x 4 x i16>) = G_SEXT %0
    %2:_(<vscale x 2 x i16>) = G_EXTRACT_SUBVECTOR %1, 0
...
