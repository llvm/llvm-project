# RUN: llc -mtriple=aarch64 -global-isel -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=LP64
# RUN: llc -mtriple=arm64_32-apple-watchos -global-isel -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ILP32

# Check DBG_VALUEs using a dead G_ASHR when the combiner deletes it.

--- |
  define void @ashr_const() !dbg !4 { ret void }
  define void @ashr_var() !dbg !5 { ret void }
  define void @ashr_const_i64() !dbg !13 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "x", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "a.c", directory: "/tmp")
  !2 = !{i32 2, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "ashr_const", scope: !1, file: !1, line: 1, type: !6, spFlags: DISPFlagDefinition, unit: !0)
  !5 = distinct !DISubprogram(name: "ashr_var", scope: !1, file: !1, line: 1, type: !6, spFlags: DISPFlagDefinition, unit: !0)
  !6 = !DISubroutineType(types: !7)
  !7 = !{}
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocalVariable(name: "shifted", scope: !4, file: !1, line: 2, type: !8)
  !10 = !DILocalVariable(name: "shifted", scope: !5, file: !1, line: 2, type: !8)
  !11 = !DILocation(line: 2, column: 3, scope: !4)
  !12 = !DILocation(line: 2, column: 3, scope: !5)
  !13 = distinct !DISubprogram(name: "ashr_const_i64", scope: !1, file: !1, line: 1, type: !6, spFlags: DISPFlagDefinition, unit: !0)
  !14 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !15 = !DILocalVariable(name: "shifted", scope: !13, file: !1, line: 2, type: !14)
  !16 = !DILocation(line: 2, column: 3, scope: !13)
...
---
name: ashr_const
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; LP64-LABEL: name: ashr_const
    ; LP64: liveins: $w0
    ; LP64-NEXT: {{  $}}
    ; LP64-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; LP64-NEXT: DBG_VALUE [[COPY]](i32), $noreg, !9, !DIExpression(DW_OP_LLVM_convert, 32, DW_ATE_signed, DW_OP_LLVM_convert, 64, DW_ATE_signed, DW_OP_constu, 1, DW_OP_shra, DW_OP_stack_value), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; LP64-NEXT: RET_ReallyLR implicit [[COPY]](i32), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ;
    ; ILP32-LABEL: name: ashr_const
    ; ILP32: liveins: $w0
    ; ILP32-NEXT: {{  $}}
    ; ILP32-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; ILP32-NEXT: DBG_VALUE [[COPY]](i32), $noreg, !9, !DIExpression(DW_OP_constu, 1, DW_OP_shra, DW_OP_stack_value), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; ILP32-NEXT: RET_ReallyLR implicit [[COPY]](i32), debug-location !DILocation(line: 2, column: 3, scope: !4)
    %0:_(i32) = COPY $w0
    %2:_(i32) = G_CONSTANT i32 1
    %3:_(i32) = G_ASHR %0, %2(i32)
    DBG_VALUE %3(i32), $noreg, !9, !DIExpression(), debug-location !11
    RET_ReallyLR implicit %0, debug-location !11
...
