    ; ILP32-NEXT: RET_ReallyLR implicit [[COPY]](i32), implicit [[COPY1]](i32), debug-location !DILocation(line: 2, column: 3, scope: !7)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %3:_(i32) = G_ASHR %0, %1(i32)
