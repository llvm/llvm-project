  bb.0:
    liveins: $w0, $w1
    ; LP64-LABEL: name: ashr_var
    ; LP64: liveins: $w0, $w1
    ; LP64-NEXT: {{  $}}
    ; LP64-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
