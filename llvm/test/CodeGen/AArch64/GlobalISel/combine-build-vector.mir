# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -o - -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s | FileCheck %s
---
name:            full_extracts_from_build_vector
alignment:       4
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
  - { reg: '$x1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: full_extracts_from_build_vector
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %arg1:_(i64) = COPY $x0
    ; CHECK-NEXT: %arg2:_(i64) = COPY $x1
    ; CHECK-NEXT: $x0 = COPY %arg1(i64)
    ; CHECK-NEXT: $x1 = COPY %arg2(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %arg1:_(i64) = COPY $x0
    %arg2:_(i64) = COPY $x1
    %zero:_(i64) = G_CONSTANT i64 0
    %one:_(i64) = G_CONSTANT i64 1
    %bv:_(<2 x i64>) = G_BUILD_VECTOR %arg1(i64), %arg2(i64)
    %extract:_(i64) = G_EXTRACT_VECTOR_ELT %bv(<2 x i64>), %zero(i64)
    %extract2:_(i64) = G_EXTRACT_VECTOR_ELT %bv(<2 x i64>), %one(i64)
    $x0 = COPY %extract(i64)
    $x1 = COPY %extract2(i64)
    RET_ReallyLR implicit $x0

...
