---
name:            test_load
body: |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: test_load
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i8) = G_LOAD [[COPY]](p0) :: (load (i8))
    ; CHECK-NEXT: [[ASSERT_ZEXT:%[0-9]+]]:_(i8) = G_ASSERT_ZEXT [[LOAD]], 1
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[ASSERT_ZEXT]](i8)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(i8) = G_LOAD [[COPY]](p0) :: (load (i8))
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[LOAD1]](i8)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT1]](i32)
    ; CHECK-NEXT: [[LOAD2:%[0-9]+]]:_(i16) = G_LOAD [[COPY]](p0) :: (load (i16))
    ; CHECK-NEXT: [[ANYEXT2:%[0-9]+]]:_(i32) = G_ANYEXT [[LOAD2]](i16)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT2]](i32)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT1]](i32)
    ; CHECK-NEXT: [[LOAD3:%[0-9]+]]:_(i64) = G_LOAD [[COPY]](p0) :: (load (i64))
    ; CHECK-NEXT: $x0 = COPY [[LOAD3]](i64)
    ; CHECK-NEXT: [[LOAD4:%[0-9]+]]:_(p0) = G_LOAD [[COPY]](p0) :: (load (p0))
    ; CHECK-NEXT: [[PTRTOINT:%[0-9]+]]:_(i64) = G_PTRTOINT [[LOAD4]](p0)
    ; CHECK-NEXT: $x0 = COPY [[PTRTOINT]](i64)
    ; CHECK-NEXT: [[LOAD5:%[0-9]+]]:_(<2 x i32>) = G_LOAD [[COPY]](p0) :: (load (<2 x i32>))
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i64) = G_BITCAST [[LOAD5]](<2 x i32>)
    ; CHECK-NEXT: $x0 = COPY [[BITCAST]](i64)
    ; CHECK-NEXT: [[LOAD6:%[0-9]+]]:_(i128) = G_LOAD [[COPY]](p0) :: (load (i128))
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i64) = G_TRUNC [[LOAD6]](i128)
    ; CHECK-NEXT: $x0 = COPY [[TRUNC]](i64)
    %0:_(p0) = COPY $x0
    %1:_(i1) = G_LOAD %0(p0) :: (load (i1))
    %2:_(i32) = G_ANYEXT %1(i1)
    $w0 = COPY %2(i32)
    %3:_(i8) = G_LOAD %0(p0) :: (load (i8))
    %4:_(i32) = G_ANYEXT %3(i8)
    $w0 = COPY %4(i32)
    %5:_(i16) = G_LOAD %0(p0) :: (load (i16))
    %6:_(i32) = G_ANYEXT %5(i16)
    $w0 = COPY %6(i32)
    %7:_(i32) = G_LOAD %0(p0) :: (load (i32))
    $w0 = COPY %4(i32)
    %8:_(i64) = G_LOAD %0(p0) :: (load (i64))
    $x0 = COPY %8(i64)
    %9:_(p0) = G_LOAD %0(p0) :: (load (p0))
    %10:_(i64) = G_PTRTOINT %9(p0)
    $x0 = COPY %10(i64)
    %11:_(<2 x i32>) = G_LOAD %0(p0) :: (load (<2 x i32>))
    %12:_(i64) = G_BITCAST %11(<2 x i32>)
    $x0 = COPY %12(i64)
    %13:_(i128) = G_LOAD %0(p0) :: (load (i128))
    %14:_(i64) = G_TRUNC %13(i128)
    $x0 = COPY %14(i64)
...

