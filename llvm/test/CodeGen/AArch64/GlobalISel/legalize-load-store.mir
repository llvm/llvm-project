name:            test_store
body: |
  bb.0:
    liveins: $x0, $w1

    ; CHECK-LABEL: name: test_store
    ; CHECK: liveins: $x0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY1]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[AND]], [[C]]
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i8) = G_TRUNC [[AND1]](i32)
    ; CHECK-NEXT: G_STORE [[TRUNC]](i8), [[COPY]](p0) :: (store (i8))
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(i8) = G_TRUNC [[COPY1]](i32)
    ; CHECK-NEXT: G_STORE [[TRUNC1]](i8), [[COPY]](p0) :: (store (i8))
    ; CHECK-NEXT: [[TRUNC2:%[0-9]+]]:_(i16) = G_TRUNC [[COPY1]](i32)
    ; CHECK-NEXT: G_STORE [[TRUNC2]](i16), [[COPY]](p0) :: (store (i16))
    ; CHECK-NEXT: G_STORE [[COPY1]](i32), [[COPY]](p0) :: (store (i32))
    ; CHECK-NEXT: [[PTRTOINT:%[0-9]+]]:_(i64) = G_PTRTOINT [[COPY]](p0)
    ; CHECK-NEXT: G_STORE [[PTRTOINT]](i64), [[COPY]](p0) :: (store (i64))
    ; CHECK-NEXT: G_STORE [[COPY]](p0), [[COPY]](p0) :: (store (p0))
    ; CHECK-NEXT: [[PTRTOINT1:%[0-9]+]]:_(i64) = G_PTRTOINT [[COPY]](p0)
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES [[PTRTOINT1]](i64), [[PTRTOINT1]](i64)
    ; CHECK-NEXT: G_STORE [[MV]](i128), [[COPY]](p0) :: (store (i128))
    %0:_(p0) = COPY $x0
    %1:_(i32) = COPY $w1
    %2:_(i1) = G_TRUNC %1(i32)
    G_STORE %2(i1), %0(p0) :: (store (i1))
    %3:_(i8) = G_TRUNC %1(i32)
    G_STORE %3(i8), %0(p0) :: (store (i8))
    %4:_(i16) = G_TRUNC %1(i32)
    G_STORE %4(i16), %0(p0) :: (store (i16))
    G_STORE %1(i32), %0(p0) :: (store (i32))
    %5:_(i64) = G_PTRTOINT %0(p0)
    G_STORE %5(i64), %0(p0) :: (store (i64))
    G_STORE %0(p0), %0(p0) :: (store (p0))
    %6:_(i64) = G_PTRTOINT %0(p0)
    %7:_(i128) = G_MERGE_VALUES %6(i64), %6
    G_STORE %7(i128), %0(p0) :: (store (i128))
...
