# RUN: llc -mtriple=aarch64 -debugify-and-strip-all-safe \
# RUN:   -run-pass=instruction-select %s -o - | FileCheck %s

# CHECK-LABEL: name: shift_mask_neg_debug_use
# CHECK: %value:gpr32 = COPY $w0
# CHECK-NEXT: %amount:gpr32 = COPY $w1
# CHECK-NEXT: [[NEG:%[0-9]+]]:gpr32 = SUBWrr $wzr, %amount
# CHECK-NEXT: %result:gpr32 = LSLVWr %value, [[NEG]]

# CHECK-LABEL: name: shift_mask_not_debug_use
# CHECK: %value:gpr32 = COPY $w0
# CHECK-NEXT: %amount:gpr32 = COPY $w1
# CHECK-NEXT: [[NOT:%[0-9]+]]:gpr32 = ORNWrr $wzr, %amount
# CHECK-NEXT: %result:gpr32 = LSRVWr %value, [[NOT]]

---
name: shift_mask_neg_debug_use
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    %value:gpr(i32) = COPY $w0
    %amount:gpr(i32) = COPY $w1
    %width:gpr(i32) = G_CONSTANT i32 32
    %sub:gpr(i32) = G_SUB %width, %amount
    %result:gpr(i32) = G_SHL %value, %sub
    $w0 = COPY %result(i32)
...
---
name: shift_mask_not_debug_use
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    %value:gpr(i32) = COPY $w0
    %amount:gpr(i32) = COPY $w1
    %mask:gpr(i32) = G_CONSTANT i32 31
    %sub:gpr(i32) = G_SUB %mask, %amount
    %result:gpr(i32) = G_LSHR %value, %sub
    $w0 = COPY %result(i32)
...
