# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Test:
#  (X + Y) == X --> Y == 0
#  (X - Y) == X --> Y == 0
#  (X ^ Y) == X --> Y == 0
#  (X + Y) != X --> Y != 0
#  (X - Y) != X --> Y != 0
#  (X ^ Y) != X --> Y != 0
#
# And all commuted cases.

...
---
name:            add_scalar_eq
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: add_scalar_eq
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %y:_(i32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %cmp:_(i1) = G_ICMP intpred(eq), %y(i32), [[C]]
    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %cmp(i1)
    ; CHECK-NEXT: $w0 = COPY %ext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %y:_(i32) = COPY $w1
    %op:_(i32) = G_ADD %x, %y
    %cmp:_(i1) = G_ICMP intpred(eq), %op(i32), %x
    %ext:_(i32) = G_ZEXT %cmp(i1)
    $w0 = COPY %ext(i32)
    RET_ReallyLR implicit $w0
...
