    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr(<4 x i32>) = COPY $q0
    ; CHECK-NEXT: [[C:%[0-9]+]]:gpr(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[IVEC:%[0-9]+]]:fpr(<4 x i32>) = G_INSERT_VECTOR_ELT [[COPY1]], [[COPY]](i32), [[C]](i64)
    ; CHECK-NEXT: $q0 = COPY [[IVEC]](<4 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(i32) = COPY $w0
    %1:_(<4 x i32>) = COPY $q0
    %3:_(i64) = G_CONSTANT i64 1
    %2:_(<4 x i32>) = G_INSERT_VECTOR_ELT %1, %0(i32), %3(i64)
