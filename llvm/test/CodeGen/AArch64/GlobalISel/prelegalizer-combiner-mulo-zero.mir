---
name:            umulo_zero
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: umulo_zero
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %zero:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %mulo:_(i32) = COPY %zero(i32)
    ; CHECK-NEXT: %carry:_(i1) = G_CONSTANT i1 false
    ; CHECK-NEXT: %carry_wide:_(i32) = G_ZEXT %carry(i1)
    ; CHECK-NEXT: $w0 = COPY %mulo(i32)
    ; CHECK-NEXT: $w1 = COPY %carry_wide(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %lhs:_(i32) = COPY $w0
    %zero:_(i32) = G_CONSTANT i32 0
    %mulo:_(i32), %carry:_(i1) = G_UMULO %lhs, %zero
    %carry_wide:_(i32) = G_ZEXT %carry(i1)
    $w0 = COPY %mulo(i32)
    $w1 = COPY %carry_wide
    RET_ReallyLR implicit $w0
