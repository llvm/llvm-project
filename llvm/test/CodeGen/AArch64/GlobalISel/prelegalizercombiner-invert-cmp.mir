# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64-apple-ios  -run-pass=aarch64-prelegalizer-combiner --aarch64prelegalizercombiner-only-enable-rule="not_cmp_fold" %s -o - -verify-machineinstrs | FileCheck %s

# Need asserts for the only-enable-rule to work.

# REQUIRES: asserts
# Check that we fold an compare result inverted into just inverting the condition code.
---
name: icmp
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0

    ; CHECK-LABEL: name: icmp
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(sle), [[COPY]](i64), [[C]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[ICMP]](i1)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i64) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 1
    %2:_(i1) = G_CONSTANT i1 1
    %3:_(i1) = G_ICMP intpred(sgt), %0(i64), %1
    %4:_(i1) = G_XOR %3, %2
    %5:_(i32) = G_ANYEXT %4
    $w0 = COPY %5(i32)
    RET_ReallyLR implicit $w0
...
---
name: fcmp
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0

    ; CHECK-LABEL: name: fcmp
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[FCMP:%[0-9]+]]:_(i1) = G_FCMP floatpred(ule), [[COPY]](f64), [[C]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[FCMP]](i1)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(f64) = COPY $x0
    %1:_(f64) = G_CONSTANT i64 1
    %2:_(i1) = G_CONSTANT i1 1
    %3:_(i1) = G_FCMP floatpred(ogt), %0(f64), %1
    %4:_(i1) = G_XOR %3, %2
    %5:_(i32) = G_ANYEXT %4
    $w0 = COPY %5(i32)
    RET_ReallyLR implicit $w0
...
---
name: icmp_not_xor_with_1
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0

    ; CHECK-LABEL: name: icmp_not_xor_with_1
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i1) = G_CONSTANT i1 false
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(sgt), [[COPY]](i64), [[C]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i1) = G_XOR [[ICMP]], [[C1]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[XOR]](i1)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i64) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 1
    %2:_(i1) = G_CONSTANT i1 0
    %3:_(i1) = G_ICMP intpred(sgt), %0(i64), %1
    %4:_(i1) = G_XOR %3, %2
    %5:_(i32) = G_ANYEXT %4
    $w0 = COPY %5(i32)
    RET_ReallyLR implicit $w0
...
---
name: icmp_not_xor_with_wrong_bool_contents
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0

    ; Even though bit 0 of the constant is 1, we require zero in the upper bits
    ; for our aarch64's zero-or-one boolean contents.
    ; CHECK-LABEL: name: icmp_not_xor_with_wrong_bool_contents
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 7
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(sgt), [[COPY]](i64), [[C]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i32) = G_XOR [[ICMP]], [[C1]]
    ; CHECK-NEXT: $w0 = COPY [[XOR]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i64) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 1
    %2:_(i32) = G_CONSTANT i32 7
    %3:_(i32) = G_ICMP intpred(sgt), %0(i64), %1
    %4:_(i32) = G_XOR %3, %2
    $w0 = COPY %4(i32)
    RET_ReallyLR implicit $w0
...
---
name: icmp_multiple_use
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0

    ; CHECK-LABEL: name: icmp_multiple_use
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i1) = G_CONSTANT i1 true
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(sgt), [[COPY]](i64), [[C]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i1) = G_XOR [[ICMP]], [[C1]]
    ; CHECK-NEXT: %other_use:_(i1) = G_AND [[ICMP]], [[C1]]
    ; CHECK-NEXT: %other_use_ext:_(i32) = G_ANYEXT %other_use(i1)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[XOR]](i1)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: $w1 = COPY %other_use_ext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i64) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 1
    %2:_(i1) = G_CONSTANT i1 1
    %3:_(i1) = G_ICMP intpred(sgt), %0(i64), %1
    %4:_(i1) = G_XOR %3, %2
    %other_use:_(i1) = G_AND %3, %2
    %other_use_ext:_(i32) = G_ANYEXT %other_use(i1)
    %5:_(i32) = G_ANYEXT %4
    $w0 = COPY %5(i32)
    $w1 = COPY %other_use_ext
    RET_ReallyLR implicit $w0
...
---
name: icmp_vector
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $q0

    ; CHECK-LABEL: name: icmp_vector
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<4 x i32>) = COPY $q0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 5
    ; CHECK-NEXT: %splat_op2:_(<4 x i32>) = G_BUILD_VECTOR [[C]](i32), [[C]](i32), [[C]](i32), [[C]](i32)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(<4 x i1>) = G_ICMP intpred(sle), [[COPY]](<4 x i32>), %splat_op2
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(<4 x i32>) = G_ANYEXT [[ICMP]](<4 x i1>)
    ; CHECK-NEXT: $q0 = COPY [[ANYEXT]](<4 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(<4 x i32>) = COPY $q0
    %1:_(i32) = G_CONSTANT i32 5
    %splat_op2:_(<4 x i32>) = G_BUILD_VECTOR %1, %1, %1, %1
    %2:_(i1) = G_CONSTANT i1 1
    %splat_true:_(<4 x i1>) = G_BUILD_VECTOR %2, %2, %2, %2
    %3:_(<4 x i1>) = G_ICMP intpred(sgt), %0(<4 x i32>), %splat_op2
    %4:_(<4 x i1>) = G_XOR %3, %splat_true
    %5:_(<4 x i32>) = G_ANYEXT %4
    $q0 = COPY %5(<4 x i32>)
    RET_ReallyLR implicit $q0
...
---
