---
name:            extract_from_build_vector
alignment:       4
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
  - { reg: '$x1' }
frameInfo:
  maxAlignment:    1
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: extract_from_build_vector
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %arg1:_(i64) = COPY $x0
    ; CHECK-NEXT: $x0 = COPY %arg1(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %arg1:_(i64) = COPY $x0
    %arg2:_(i64) = COPY $x1
    %zero:_(i64) = G_CONSTANT i64 0
    %bv:_(<2 x i64>) = G_BUILD_VECTOR %arg1(i64), %arg2(i64)
    %extract:_(i64) = G_EXTRACT_VECTOR_ELT %bv(<2 x i64>), %zero(i64)
    $x0 = COPY %extract(i64)
    RET_ReallyLR implicit $x0

...
