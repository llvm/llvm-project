  ; CHECK-NEXT:   [[TRUNC7:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
  ; CHECK-NEXT:   [[AND2:%[0-9]+]]:_(i32) = G_AND [[TRUNC7]], [[C1]]
  ; CHECK-NEXT:   [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[AND2]](i32), [[TRUNC5]], [[TRUNC6]]
  ; CHECK-NEXT:   $w0 = COPY [[SELECT1]](i32)
