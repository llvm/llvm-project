    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES [[COPY]](i64), [[COPY1]](i64)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(<2 x i64>) = G_BITCAST [[MV]](i128)
    ; CHECK-NEXT: $q0 = COPY [[BITCAST]](<2 x i64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %3:_(i128) = G_MERGE_VALUES %0(i64), %1(i64)
    %2:_(<2 x i64>) = G_BITCAST %3(i128)
    $q0 = COPY %2(<2 x i64>)
    RET_ReallyLR implicit $q0

