  ; CHECK-NEXT:   [[AND3:%[0-9]+]]:_(i32) = G_AND [[TRUNC10]], [[C1]]
  ; CHECK-NEXT:   [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[AND3]](i32), [[TRUNC8]], [[TRUNC9]]
  ; CHECK-NEXT:   $w0 = COPY [[SELECT2]](i32)
