  ; CHECK-NEXT:   [[AND4:%[0-9]+]]:_(i32) = G_AND [[TRUNC11]], [[C1]]
  ; CHECK-NEXT:   [[SELECT3:%[0-9]+]]:_(i32) = G_SELECT [[AND4]](i32), [[TRUNC]], [[TRUNC]]
  ; CHECK-NEXT:   [[TRUNC12:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
  ; CHECK-NEXT:   [[AND5:%[0-9]+]]:_(i32) = G_AND [[TRUNC12]], [[C1]]
  ; CHECK-NEXT:   [[SELECT4:%[0-9]+]]:_(i64) = G_SELECT [[AND5]](i32), [[COPY]], [[COPY]]
  ; CHECK-NEXT:   $x0 = COPY [[SELECT4]](i64)
