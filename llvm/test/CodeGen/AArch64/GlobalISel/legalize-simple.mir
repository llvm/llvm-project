  ; CHECK-NEXT:   [[TRUNC3:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
  ; CHECK-NEXT:   [[TRUNC4:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
