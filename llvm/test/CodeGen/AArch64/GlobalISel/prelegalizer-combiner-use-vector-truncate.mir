# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s
---
name:            test_foldable_s32
body:             |
  bb.0:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: test_foldable_s32
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[SRC:%src]]:_(<2 x i32>) = COPY $x1
    ; CHECK-NEXT: [[UNDEF:%[0-9]+]]:_(<2 x i32>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[MID:%[0-9]+]]:_(<4 x i32>) = G_CONCAT_VECTORS [[SRC]](<2 x i32>), [[UNDEF]](<2 x i32>)
    ; CHECK-NEXT: [[DST:%dst]]:_(<4 x i16>) = G_TRUNC [[MID]]
    ; CHECK-NEXT: $x0 = COPY [[DST]]

    %src:_(<2 x i32>) = COPY $x1
    %a:_(i32), %b:_(i32) = G_UNMERGE_VALUES %src:_(<2 x i32>)
    %T_a:_(i16) = G_TRUNC %a:_(i32)
    %T_b:_(i16) = G_TRUNC %b:_(i32)
    %Undef:_(i16) = G_IMPLICIT_DEF
    %dst:_(<4 x i16>) = G_BUILD_VECTOR %T_a:_(i16), %T_b:_(i16), %Undef:_(i16), %Undef:_(i16)
    $x0 = COPY %dst
...
---
name:            test_unfoldable_s32
body:             |
  bb.0:
    liveins: $w0, $x1

    ; CHECK-LABEL: name: test_unfoldable_s32
    ; CHECK: liveins: $w0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[SRC:%src]]:_(<2 x i32>) = COPY $x1
    ; CHECK-NEXT: [[A:%a]]:_(i16), [[B:%b]]:_(i16), [[C:%c]]:_(i16), %d:_(i16) = G_UNMERGE_VALUES [[SRC]](<2 x i32>)
    ; CHECK-NEXT: [[T_A:%T_a]]:_(i8) = G_TRUNC [[A]](i16)
    ; CHECK-NEXT: [[T_B:%T_b]]:_(i8) = G_TRUNC [[B]](i16)
    ; CHECK-NEXT: [[T_C:%T_c]]:_(i8) = G_TRUNC [[C]](i16)
    ; CHECK-NEXT: [[UNDEF:%Undef]]:_(i8) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[DST:%dst]]:_(<4 x i8>) = G_BUILD_VECTOR [[T_A]](i8), [[T_B]](i8), [[T_C]](i8), [[UNDEF]](i8)
    ; CHECK-NEXT: $w0 = COPY [[DST]](<4 x i8>)
    %src:_(<2 x i32>) = COPY $x1
    %a:_(i16), %b:_(i16), %c:_(i16), %d:_(i16) = G_UNMERGE_VALUES %src:_(<2 x i32>)
    %T_a:_(i8) = G_TRUNC %a:_(i16)
    %T_b:_(i8) = G_TRUNC %b:_(i16)
    %T_c:_(i8) = G_TRUNC %c:_(i16)
    %Undef:_(i8) = G_IMPLICIT_DEF
    %dst:_(<4 x i8>) = G_BUILD_VECTOR %T_a:_(i8), %T_b:_(i8), %T_c:_(i8), %Undef:_(i8)
    $w0 = COPY %dst

...
