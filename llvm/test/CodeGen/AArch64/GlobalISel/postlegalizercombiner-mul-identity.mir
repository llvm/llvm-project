legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q0

    ; CHECK-LABEL: name: mul_zero_one_v4i32
    ; CHECK: %zero:_(s32) = G_CONSTANT i32 0
    ; CHECK: %[[NEGONE:[0-9]+]]:_(s32) = G_CONSTANT i32 -1
    ; CHECK: %[[MASK:[0-9]+]]:_(<4 x s32>) = G_BUILD_VECTOR %[[NEGONE]](s32), %zero(s32), %[[NEGONE]](s32), %zero(s32)
    ; CHECK: %mul:_(<4 x s32>) = G_AND %src, %[[MASK]]
    ; CHECK-NOT: G_MUL
    ; CHECK: $q0 = COPY %mul(<4 x s32>)

    %src:_(<4 x s32>) = COPY $q0
    %one:_(s32) = G_CONSTANT i32 1
    %zero:_(s32) = G_CONSTANT i32 0
    %mask:_(<4 x s32>) = G_BUILD_VECTOR %one, %zero, %one, %zero
    %mul:_(<4 x s32>) = G_MUL %src, %mask
