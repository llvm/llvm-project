# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-postlegalizer-combiner %s -o - | FileCheck %s

# The generic 'right_identity_one_int' combine matches (G_MUL x, 1) and is more specific 
# than AArch64's `mul_const` combine, so it must win. mul_const still rewrites other 
# constants scenarios like:
# (x * 2^3 - 1) becomes (x << 3) - x.
---
name:            mul_by_one
legalized:       true
body:             |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: mul_by_one
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: $x0 = COPY %x(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i64) = COPY $x0
    %one:_(i64) = G_CONSTANT i64 1
    %mul:_(i64) = G_MUL %x, %one
    $x0 = COPY %mul(i64)
    RET_ReallyLR implicit $x0

...
---
name:            mul_by_seven
legalized:       true
body:             |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: mul_by_seven
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 3
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL %x, [[C]](i64)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[SHL]], %x
    ; CHECK-NEXT: $x0 = COPY [[SUB]](i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i64) = COPY $x0
    %seven:_(i64) = G_CONSTANT i64 7
    %mul:_(i64) = G_MUL %x, %seven
    $x0 = COPY %mul(i64)
    RET_ReallyLR implicit $x0

...
---
name:            mul_one_zero_rhs
legalized:       true
body:             |
  bb.0:
    liveins: $d0

    ; CHECK-LABEL: name: mul_one_zero_rhs
    ; CHECK: liveins: $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:_(<2 x s32>) = COPY $d0
    ; CHECK-NEXT: %zero:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 -1
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), %zero(s32)
    ; CHECK-NEXT: %mul:_(<2 x s32>) = G_AND %src, [[BUILD_VECTOR]]
    ; CHECK-NEXT: $d0 = COPY %mul(<2 x s32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %src:_(<2 x s32>) = COPY $d0
    %one:_(s32) = G_CONSTANT i32 1
    %zero:_(s32) = G_CONSTANT i32 0
    %mask:_(<2 x s32>) = G_BUILD_VECTOR %one, %zero
    %mul:_(<2 x s32>) = G_MUL %src, %mask
    $d0 = COPY %mul(<2 x s32>)
    RET_ReallyLR implicit $d0

...
