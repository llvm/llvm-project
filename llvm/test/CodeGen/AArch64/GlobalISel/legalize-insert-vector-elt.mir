name:            v3s8_crash
body:             |
  ; CHECK-LABEL: name: v3s8_crash
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w1, $w2, $w3, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(i32) = COPY $w2
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:_(i32) = COPY $w3
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(i8) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i8) = G_CONSTANT i8 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i8) = G_TRUNC [[COPY1]](i32)
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(i8) = G_TRUNC [[COPY2]](i32)
  ; CHECK-NEXT:   [[TRUNC2:%[0-9]+]]:_(i8) = G_TRUNC [[COPY3]](i32)
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:_(i8) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   [[BUILD_VECTOR:%[0-9]+]]:_(<8 x i8>) = G_BUILD_VECTOR [[TRUNC]](i8), [[TRUNC1]](i8), [[TRUNC2]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8)
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(<8 x i16>) = G_ANYEXT [[BUILD_VECTOR]](<8 x i8>)
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:_(<4 x i16>), [[UV1:%[0-9]+]]:_(<4 x i16>) = G_UNMERGE_VALUES [[ANYEXT]](<8 x i16>)
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(i16) = G_CONSTANT i16 0
  ; CHECK-NEXT:   [[IVEC:%[0-9]+]]:_(<4 x i16>) = G_INSERT_VECTOR_ELT [[UV]], [[C2]](i16), [[C1]](i64)
  ; CHECK-NEXT:   [[UV2:%[0-9]+]]:_(i16), [[UV3:%[0-9]+]]:_(i16), [[UV4:%[0-9]+]]:_(i16), [[UV5:%[0-9]+]]:_(i16) = G_UNMERGE_VALUES [[IVEC]](<4 x i16>)
  ; CHECK-NEXT:   [[TRUNC3:%[0-9]+]]:_(i8) = G_TRUNC [[UV2]](i16)
  ; CHECK-NEXT:   [[TRUNC4:%[0-9]+]]:_(i8) = G_TRUNC [[UV3]](i16)
  ; CHECK-NEXT:   [[TRUNC5:%[0-9]+]]:_(i8) = G_TRUNC [[UV4]](i16)
  ; CHECK-NEXT:   [[BUILD_VECTOR1:%[0-9]+]]:_(<16 x i8>) = G_BUILD_VECTOR [[TRUNC3]](i8), [[TRUNC4]](i8), [[TRUNC5]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8)
  ; CHECK-NEXT:   [[BUILD_VECTOR2:%[0-9]+]]:_(<16 x i8>) = G_BUILD_VECTOR [[C]](i8), [[DEF]](i8), [[DEF]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8), [[DEF1]](i8)
  ; CHECK-NEXT:   [[SHUF:%[0-9]+]]:_(<16 x i8>) = G_SHUFFLE_VECTOR [[BUILD_VECTOR1]](<16 x i8>), [[BUILD_VECTOR2]], shufflemask(0, 16, 16, 16, 1, 16, 16, 16, 2, 16, 16, 16, undef, undef, undef, undef)
  ; CHECK-NEXT:   [[BITCAST:%[0-9]+]]:_(<4 x i32>) = G_BITCAST [[SHUF]](<16 x i8>)
  ; CHECK-NEXT:   [[UITOFP:%[0-9]+]]:_(<4 x f32>) = G_UITOFP [[BITCAST]](<4 x i32>)
  ; CHECK-NEXT:   [[UV6:%[0-9]+]]:_(f32), [[UV7:%[0-9]+]]:_(f32), [[UV8:%[0-9]+]]:_(f32), [[UV9:%[0-9]+]]:_(f32) = G_UNMERGE_VALUES [[UITOFP]](<4 x f32>)
  ; CHECK-NEXT:   G_STORE [[UV6]](f32), [[COPY]](p0) :: (store (f32), align 16)
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(i64) = G_CONSTANT i64 4
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C3]](i64)
  ; CHECK-NEXT:   G_STORE [[UV7]](f32), [[PTR_ADD]](p0) :: (store (f32) into unknown-address + 4)
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(i64) = G_CONSTANT i64 8
  ; CHECK-NEXT:   [[PTR_ADD1:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C4]](i64)
  ; CHECK-NEXT:   G_STORE [[UV8]](f32), [[PTR_ADD1]](p0) :: (store (f32) into unknown-address + 8, align 8)
  ; CHECK-NEXT:   G_BR %bb.1
  bb.1:
    liveins: $w1, $w2, $w3, $x0

    %0:_(p0) = COPY $x0
    %2:_(i32) = COPY $w1
    %3:_(i32) = COPY $w2
    %4:_(i32) = COPY $w3
    %5:_(<3 x i32>) = G_BUILD_VECTOR %2(i32), %3(i32), %4(i32)
    %1:_(<3 x i8>) = G_TRUNC %5(<3 x i32>)
    %8:_(i64) = G_CONSTANT i64 0
    %11:_(i8) = G_IMPLICIT_DEF
    %7:_(i8) = G_CONSTANT i8 0
    %10:_(<3 x i8>) = G_BUILD_VECTOR %7(i8), %11(i8), %11(i8)

  bb.2:
    %14:_(i64) = G_CONSTANT i64 0
    %15:_(i8) = G_CONSTANT i8 0
    %6:_(<3 x i8>) = G_INSERT_VECTOR_ELT %1, %15(i8), %14(i64)
    %9:_(<12 x i8>) = G_SHUFFLE_VECTOR %6(<3 x i8>), %10, shufflemask(0, 3, 3, 3, 1, 3, 3, 3, 2, 3, 3, 3)
    %12:_(<3 x i32>) = G_BITCAST %9(<12 x i8>)
    %13:_(<3 x f32>) = G_UITOFP %12(<3 x i32>)
    G_STORE %13(<3 x f32>), %0(p0) :: (store (<3 x f32>))
    G_BR %bb.2

...
