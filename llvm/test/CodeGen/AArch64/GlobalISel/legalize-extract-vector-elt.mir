# Make sure that the pointer legalization rules don't apply when we have
# different address spaces.
name:            cant_legalize_different_address_spaces
body: |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: cant_legalize_different_address_spaces
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %vec:_(<4 x p1>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %idx:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: %eve:_(p0) = G_EXTRACT_VECTOR_ELT %vec(<4 x p1>), %idx(i64)
    ; CHECK-NEXT: $x0 = COPY %eve(p0)
    ; CHECK-NEXT: RET_ReallyLR
    %vec:_(<4 x p1>) = G_IMPLICIT_DEF
    %idx:_(i64) = G_CONSTANT i64 1
    %eve:_(p0) = G_EXTRACT_VECTOR_ELT %vec:_(<4 x p1>), %idx:_(i64)
    $x0 = COPY %eve(p0)
    RET_ReallyLR
