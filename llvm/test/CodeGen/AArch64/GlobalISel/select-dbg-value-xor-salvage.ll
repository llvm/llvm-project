  ; CHECK-NEXT:   DBG_VALUE [[COPY]], $noreg, !7, !DIExpression(DW_OP_constu, 18446744073709551615, DW_OP_xor, DW_OP_stack_value), debug-location !6
  ; CHECK-NEXT:   [[BICWrr:%[0-9]+]]:gpr32 = BICWrr [[COPY1]], [[COPY]], debug-location !6
  ; CHECK-NEXT:   $w0 = COPY [[BICWrr]], debug-location !6
