# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -o - -mtriple=aarch64 -run-pass=legalizer %s | FileCheck %s

# Make sure we don't lose the register bank constraints when
# artifact combining G_UNMERGE_VALUES instructions.
---
name:            test_none_none
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_none_none
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
    ; CHECK-NEXT: $w0 = COPY [[COPY]](i32)
    ; CHECK-NEXT: $w1 = COPY [[COPY1]](i32)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1
    %3:_(i32), %4:_(i32) = G_UNMERGE_VALUES %2(i64)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...
---
name:            test_gpr_none
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_gpr_none
    ; CHECK: [[COPY:%[0-9]+]]:gpr(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(i32) = COPY $w1
    ; CHECK-NEXT: $w0 = COPY [[COPY]](i32)
    ; CHECK-NEXT: $w1 = COPY [[COPY1]](i32)
    %0:gpr(i32) = COPY $w0
    %1:gpr(i32) = COPY $w1
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1
    %3:_(i32), %4:_(i32) = G_UNMERGE_VALUES %2(i64)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...
---
name:            test_none_gpr
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_none_gpr
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr(i32) = COPY [[COPY]](i32)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr(i32) = COPY [[COPY1]](i32)
    ; CHECK-NEXT: $w0 = COPY [[COPY2]](i32)
    ; CHECK-NEXT: $w1 = COPY [[COPY3]](i32)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1
    %3:gpr(i32), %4:gpr(i32) = G_UNMERGE_VALUES %2(i64)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...
---
name:            test_fpr_gpr
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_fpr_gpr
    ; CHECK: [[COPY:%[0-9]+]]:fpr(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr(i32) = COPY $w1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr(i32) = COPY [[COPY]](i32)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr(i32) = COPY [[COPY1]](i32)
    ; CHECK-NEXT: $w0 = COPY [[COPY2]](i32)
    ; CHECK-NEXT: $w1 = COPY [[COPY3]](i32)
    %0:fpr(i32) = COPY $w0
    %1:fpr(i32) = COPY $w1
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1
    %3:gpr(i32), %4:gpr(i32) = G_UNMERGE_VALUES %2(i64)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...
