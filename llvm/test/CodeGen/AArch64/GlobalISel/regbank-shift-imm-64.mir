    ; CHECK-NEXT: [[SHL:%[0-9]+]]:gpr(i32) = G_SHL [[COPY]], [[C]](i32)
    ; CHECK-NEXT: $w0 = COPY [[SHL]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_CONSTANT i32 8
    %2:_(i32) = G_SHL %0, %1(i32)
    $w0 = COPY %2(i32)
    RET_ReallyLR implicit $w0

