; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64-unknown-linux-gnu -global-isel < %s | FileCheck %s --check-prefix=AAPCS
; RUN: llc -mtriple=arm64-apple-macosx -global-isel < %s | FileCheck %s --check-prefix=DARWIN

; lowerTailCall() analyses the outgoing arguments twice: once to compute FPDiff,
; and once to actually assign them. determineAssignments() marks the first part
; of a split argument with ISD::ArgFlagsTy::Split, so re-analysing the same
; ArgInfo list made every part of an i128 inherit Split. That only happens when
; IsSibCall is false, i.e. for tailcc and swifttailcc.
;
; Each of these is a pass-through musttail call, so all of them must lower to a
; bare branch with no argument shuffling and no stores to the caller's (empty)
; incoming argument area.

declare tailcc void @tailcc_callee(i8, i64, i128, i128, ptr, ptr)
declare swifttailcc void @swifttailcc_callee(ptr swiftasync, i8, i64, i128, i128, ptr, ptr, ptr noalias swiftself)
declare swifttailcc void @swifttailcc_x7_callee(ptr swiftasync, i64, i64, i64, i64, i64, i64, i128, ptr noalias swiftself)

; Under CC_AArch64_AAPCS a Split part is assigned from [X0, X2, X4, X6], so
; marking both halves Split gave each its own even register (x2, x4, x6 and a
; stack slot) while the callee reads x2:x3, x4:x5, x6, x7.
define tailcc void @tailcc_split_arg(i8 %a, i64 %b, i128 %c, i128 %d, ptr %e, ptr %f) nounwind {
; AAPCS-LABEL: tailcc_split_arg:
; AAPCS:       // %bb.0:
; AAPCS-NEXT:    b tailcc_callee
;
; DARWIN-LABEL: tailcc_split_arg:
; DARWIN:       ; %bb.0:
; DARWIN-NEXT:    b _tailcc_callee
  musttail call tailcc void @tailcc_callee(i8 %a, i64 %b, i128 %c, i128 %d, ptr %e, ptr %f)
  ret void
}

define swifttailcc void @swifttailcc_split_arg(ptr swiftasync %ctx, i8 %a, i64 %b, i128 %c, i128 %d, ptr %e, ptr %f, ptr noalias swiftself %s) nounwind {
; AAPCS-LABEL: swifttailcc_split_arg:
; AAPCS:       // %bb.0:
; AAPCS-NEXT:    b swifttailcc_callee
;
; DARWIN-LABEL: swifttailcc_split_arg:
; DARWIN:       ; %bb.0:
; DARWIN-NEXT:    b _swifttailcc_callee
  musttail call swifttailcc void @swifttailcc_callee(ptr swiftasync %ctx, i8 %a, i64 %b, i128 %c, i128 %d, ptr %e, ptr %f, ptr noalias swiftself %s)
  ret void
}

; CC_AArch64_DarwinPCS assigns a Split part from the consecutive list [X0 .. X6],
; so the even/odd pairing is unaffected there -- but that list still excludes X7.
; When the second half of the i128 belongs in x7, marking it Split pushed it onto
; the stack instead, so Darwin miscompiles this shape too.
define swifttailcc void @swifttailcc_split_arg_x7(ptr swiftasync %ctx, i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f, i128 %g, ptr noalias swiftself %s) nounwind {
; AAPCS-LABEL: swifttailcc_split_arg_x7:
; AAPCS:       // %bb.0:
; AAPCS-NEXT:    b swifttailcc_x7_callee
;
; DARWIN-LABEL: swifttailcc_split_arg_x7:
; DARWIN:       ; %bb.0:
; DARWIN-NEXT:    b _swifttailcc_x7_callee
  musttail call swifttailcc void @swifttailcc_x7_callee(ptr swiftasync %ctx, i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f, i128 %g, ptr noalias swiftself %s)
  ret void
}
