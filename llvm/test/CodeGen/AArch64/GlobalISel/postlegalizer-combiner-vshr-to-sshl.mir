name:            lshr_by_register
legalized:       true
body:             |
  bb.0:
    liveins: $q0, $q1
    ; CHECK-LABEL: name: lshr_by_register
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<4 x s32>) = COPY $q0
    ; CHECK-NEXT: %amt:_(<4 x s32>) = COPY $q1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<4 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32), [[C]](s32), [[C]](s32)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(<4 x s32>) = G_SUB [[BUILD_VECTOR]], %amt
    ; CHECK-NEXT: %r:_(<4 x s32>) = G_INTRINSIC intrinsic(@llvm.aarch64.neon.ushl), %x(<4 x s32>), [[SUB]](<4 x s32>)
    ; CHECK-NEXT: $q0 = COPY %r(<4 x s32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %x:_(<4 x s32>) = COPY $q0
    %amt:_(<4 x s32>) = COPY $q1
    %r:_(<4 x s32>) = G_LSHR %x, %amt(<4 x s32>)
    $q0 = COPY %r(<4 x s32>)
    RET_ReallyLR implicit $q0
...
