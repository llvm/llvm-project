# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -debugify-and-strip-all-safe -run-pass=aarch64-prelegalizer-combiner --aarch64prelegalizercombiner-only-enable-rule="binop_left_to_zero" -global-isel %s -o - | FileCheck %s
# REQUIRES: asserts

# Fold (0 op x) -> 0, including a splat-zero vector LHS.

---
name:            mul_scalar_zero_lhs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0

    ; CHECK-LABEL: name: mul_scalar_zero_lhs
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %zero:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $w0 = COPY %zero(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %zero:_(i32) = G_CONSTANT i32 0
    %mul:_(i32) = G_MUL %zero, %x
    $w0 = COPY %mul
    RET_ReallyLR implicit $w0
...
---
name:            mul_splat_zero_lhs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0

    ; CHECK-LABEL: name: mul_splat_zero_lhs
    ; CHECK: liveins: $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %zero:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %splat_zero:_(<2 x i32>) = G_BUILD_VECTOR %zero(i32), %zero(i32)
    ; CHECK-NEXT: $d0 = COPY %splat_zero(<2 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %x:_(<2 x i32>) = COPY $d0
    %zero:_(i32) = G_CONSTANT i32 0
    %splat_zero:_(<2 x i32>) = G_BUILD_VECTOR %zero, %zero
    %mul:_(<2 x i32>) = G_MUL %splat_zero, %x
    $d0 = COPY %mul
    RET_ReallyLR implicit $d0
...
---
name:            shl_splat_zero_lhs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0

    ; CHECK-LABEL: name: shl_splat_zero_lhs
    ; CHECK: liveins: $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %zero:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %splat_zero:_(<2 x i32>) = G_BUILD_VECTOR %zero(i32), %zero(i32)
    ; CHECK-NEXT: $d0 = COPY %splat_zero(<2 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %x:_(<2 x i32>) = COPY $d0
    %zero:_(i32) = G_CONSTANT i32 0
    %splat_zero:_(<2 x i32>) = G_BUILD_VECTOR %zero, %zero
    %shl:_(<2 x i32>) = G_SHL %splat_zero, %x
    $d0 = COPY %shl
    RET_ReallyLR implicit $d0
...
---
name:            dont_fold_nonzero_splat_lhs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0

    ; CHECK-LABEL: name: dont_fold_nonzero_splat_lhs
    ; CHECK: liveins: $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<2 x i32>) = COPY $d0
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %splat_one:_(<2 x i32>) = G_BUILD_VECTOR %one(i32), %one(i32)
    ; CHECK-NEXT: %mul:_(<2 x i32>) = G_MUL %splat_one, %x
    ; CHECK-NEXT: $d0 = COPY %mul(<2 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %x:_(<2 x i32>) = COPY $d0
    %one:_(i32) = G_CONSTANT i32 1
    %splat_one:_(<2 x i32>) = G_BUILD_VECTOR %one, %one
    %mul:_(<2 x i32>) = G_MUL %splat_one, %x
    $d0 = COPY %mul
    RET_ReallyLR implicit $d0
...
