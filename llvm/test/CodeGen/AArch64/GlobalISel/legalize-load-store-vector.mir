# FIXME: Non-byte-sized vector elements cause fallback in LegalizerHelper::reduceLoadStoreWidth
---
name:            store-narrow-non-byte-sized
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x8
    ; CHECK-LABEL: name: store-narrow-non-byte-sized
    ; CHECK: liveins: $x8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x8
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i9) = G_CONSTANT i9 -256
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i9) = G_CONSTANT i9 -255
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<8 x i9>) = G_BUILD_VECTOR [[C]](i9), [[C1]](i9), [[C]](i9), [[C1]](i9), [[C]](i9), [[C1]](i9), [[C]](i9), [[C1]](i9)
    ; CHECK-NEXT: G_STORE [[BUILD_VECTOR]](<8 x i9>), [[COPY]](p0) :: (store (<8 x i9>), align 16)
    ; CHECK-NEXT: RET_ReallyLR
    %0:_(p0) = COPY $x8
    %1:_(i9) = G_CONSTANT i9 256
    %2:_(i9) = G_CONSTANT i9 257
    %3:_(<8 x i9>) = G_BUILD_VECTOR %1(i9), %2(i9), %1(i9), %2(i9), %1(i9), %2(i9), %1(i9), %2(i9)
    G_STORE %3(<8 x i9>), %0(p0) :: (store (<8 x i9>), align 16)
    RET_ReallyLR
...

# FIXME: Vector stores only sometimes act as per-lane truncating stores (see e.g. PR#121169).
---
name:            store-narrow-per-lane-trunc
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x8
    ; CHECK-LABEL: name: store-narrow-per-lane-trunc
    ; CHECK: liveins: $x8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x8
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 42
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x i64>) = G_BUILD_VECTOR [[C]](i64), [[C]](i64)
    ; CHECK-NEXT: [[BUILD_VECTOR1:%[0-9]+]]:_(<2 x i64>) = G_BUILD_VECTOR [[C]](i64), [[C]](i64)
    ; CHECK-NEXT: G_STORE [[BUILD_VECTOR]](<2 x i64>), [[COPY]](p0) :: (store (<2 x i64>))
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 16
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C1]](i64)
    ; CHECK-NEXT: G_STORE [[BUILD_VECTOR1]](<2 x i64>), [[PTR_ADD]](p0) :: (store (<2 x i64>) into unknown-address + 16)
    ; CHECK-NEXT: RET_ReallyLR
    %0:_(p0) = COPY $x8
    %1:_(i64) = G_CONSTANT i64 42
    %2:_(<4 x i64>) = G_BUILD_VECTOR %1(i64), %1(i64), %1(i64), %1(i64)
    G_STORE %2(<4 x i64>), %0(p0) :: (store (<4 x i63>), align 16)
    RET_ReallyLR
...

