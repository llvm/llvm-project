# FIXME: Non-byte-sized vector elements cause fallback in LegalizerHelper::reduceLoadStoreWidth
---
name:            load-narrow-non-byte-sized
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x8
    ; CHECK-LABEL: name: load-narrow-non-byte-sized
    ; CHECK: liveins: $x8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x8
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(<8 x i9>) = G_LOAD [[COPY]](p0) :: (load (<8 x i9>), align 16)
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(<8 x i16>) = G_ZEXT [[LOAD]](<8 x i9>)
    ; CHECK-NEXT: $q0 = COPY [[ZEXT]](<8 x i16>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(p0) = COPY $x8
    %2:_(<8 x i9>) = G_LOAD %0(p0) :: (load (<8 x i9>), align 16)
    %3:_(<8 x i16>) = G_ZEXT %2(<8 x i9>)
    $q0 = COPY %3(<8 x i16>)
    RET_ReallyLR implicit $q0
...

# FIXME: Vector stores sometimes act as per-lane truncating stores (see PR#121169). If we want to keep these semantics we should change the semantics of G_LOAD to behave as a per-lane extending load.
---
name:            load-narrow-per-lane-ext
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x8
    ; CHECK-LABEL: name: load-narrow-per-lane-ext
    ; CHECK: liveins: $x8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x8
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(<2 x i64>) = G_LOAD [[COPY]](p0) :: (load (<2 x i64>))
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 16
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C]](i64)
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(<2 x i64>) = G_LOAD [[PTR_ADD]](p0) :: (load (<2 x i64>) from unknown-address + 16)
    ; CHECK-NEXT: $q0 = COPY [[LOAD]](<2 x i64>)
    ; CHECK-NEXT: $q1 = COPY [[LOAD1]](<2 x i64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0, implicit $q1
    %0:_(p0) = COPY $x8
    %2:_(<4 x i64>) = G_LOAD %0(p0) :: (load (<4 x i63>), align 16)
    %3:_(<2 x i64>), %4:_(<2 x i64>) = G_UNMERGE_VALUES %2(<4 x i64>)
    $q0 = COPY %3(<2 x i64>)
    $q1 = COPY %4(<2 x i64>)
    RET_ReallyLR implicit $q0, implicit $q1
...

