    ; CHECK-NEXT: %width:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: %ubfx:_(i32) = G_UBFX %copy, %lsb(i32), %width
    ; CHECK-NEXT: $w0 = COPY %ubfx(i32)
    %copy:_(i32) = COPY $w0
    %lsb:_(i32) = G_CONSTANT i32 1
    %width:_(i32) = G_CONSTANT i32 2
    %ubfx:_(i32) = G_UBFX %copy(i32), %lsb, %width
    $w0 = COPY %ubfx(i32)
