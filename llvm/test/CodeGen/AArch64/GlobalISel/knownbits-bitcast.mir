# RUN: llc -mtriple=aarch64_be -passes="print<gisel-value-tracking>" %s -filetype=null 2>&1 | FileCheck %s --check-prefixes=CHECK,BE

---
name: bitcast_splat_constant
body: |
  bb.0:
  ; CHECK-LABEL: name: @bitcast_splat_constant
  ; CHECK-NEXT: %c:_ KnownBits:00001111 SignBits:4 IsKnownNeverZero:1
  ; CHECK-NEXT: %1:_ KnownBits:00001111 SignBits:4 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:0000111100001111 SignBits:4 IsKnownNeverZero:1
    %c:_(i8) = G_CONSTANT i8 15
    %1:_(<4 x i8>) = G_BUILD_VECTOR %c(i8), %c(i8), %c(i8), %c(i8)
    %2:_(<2 x i16>) = G_BITCAST %1(<4 x i8>)
...
