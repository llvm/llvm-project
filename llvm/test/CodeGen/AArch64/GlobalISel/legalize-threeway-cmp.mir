name:            test_ucmp_vector
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_ucmp_vector
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $w2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i32) = COPY $w3
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<4 x i32>) = G_BUILD_VECTOR [[COPY]](i32), [[COPY1]](i32), [[COPY2]](i32), [[COPY3]](i32)
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:_(i32) = COPY $w1
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:_(i32) = COPY $w2
    ; CHECK-NEXT: [[COPY7:%[0-9]+]]:_(i32) = COPY $w3
    ; CHECK-NEXT: [[BUILD_VECTOR1:%[0-9]+]]:_(<4 x i32>) = G_BUILD_VECTOR [[COPY]](i32), [[COPY1]](i32), [[COPY2]](i32), [[COPY3]](i32)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(<4 x i32>) = G_ICMP intpred(ugt), [[BUILD_VECTOR]](<4 x i32>), [[BUILD_VECTOR1]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(<4 x i32>) = G_ICMP intpred(ult), [[BUILD_VECTOR]](<4 x i32>), [[BUILD_VECTOR1]]
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(<4 x i16>) = G_TRUNC [[ICMP1]](<4 x i32>)
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(<4 x i16>) = G_TRUNC [[ICMP]](<4 x i32>)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(<4 x i16>) = G_SUB [[TRUNC]], [[TRUNC1]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(<4 x i32>) = G_ANYEXT [[SUB]](<4 x i16>)
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(<4 x i32>) = G_SEXT_INREG [[ANYEXT]], 2
    ; CHECK-NEXT: $q0 = COPY [[SEXT_INREG]](<4 x i32>)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %2:_(i32) = COPY $w2
    %3:_(i32) = COPY $w3
    %4:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    %5:_(i32) = COPY $w0
    %6:_(i32) = COPY $w1
    %7:_(i32) = COPY $w2
    %8:_(i32) = COPY $w3
    %9:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    %10:_(<4 x i2>) = G_UCMP %4(<4 x i32>), %9
    %11:_(<4 x i32>) = G_SEXT %10(<4 x i2>)
    $q0 = COPY %11(<4 x i32>)

...
---
name:            test_ucmp_i128
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_ucmp_i128
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i64) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[COPY]](i64), [[COPY1]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[DEF]](i64), [[DEF]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[DEF]](i64), [[DEF]]
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[ICMP2]](i32), [[ICMP]], [[ICMP1]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](i64), [[COPY1]]
    ; CHECK-NEXT: [[ICMP4:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[DEF]](i64), [[DEF]]
    ; CHECK-NEXT: [[ICMP5:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[DEF]](i64), [[DEF]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[ICMP5]](i32), [[ICMP3]], [[ICMP4]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i32) = G_SELECT [[SELECT]](i32), [[C]], [[C1]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[SELECT3:%[0-9]+]]:_(i32) = G_SELECT [[SELECT1]](i32), [[C2]], [[SELECT2]]
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i32) = G_SEXT_INREG [[SELECT3]], 2
    ; CHECK-NEXT: $w0 = COPY [[SEXT_INREG]](i32)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x0
    %l:_(i128) = G_ANYEXT %0
    %r:_(i128) = G_ANYEXT %1
    %4:_(i2) = G_UCMP %l(i128), %r
    %14:_(i32) = G_SEXT %4(i2)
    $w0 = COPY %14(i32)
