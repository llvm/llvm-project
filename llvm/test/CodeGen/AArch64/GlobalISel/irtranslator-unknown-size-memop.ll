; NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
; RUN: llc -O0 -mtriple=aarch64 -mattr=+mops,+mte -global-isel -stop-after=ir-translator %s -o - | FileCheck %s

; getTgtMemIntrinsic reports MemoryLocation::UnknownSize for
; llvm.aarch64.mops.memset.tag. Like SelectionDAGBuilder, the IRTranslator must
; emit an unknown-size memory operand instead of one with the size of memVT.

define ptr @memset_tag(ptr %dst, i8 %val, i64 %size) {
  ; CHECK-LABEL: name: memset_tag
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $w1, $x0, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i8) = G_TRUNC [[COPY1]](i32)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(i64) = COPY $x2
  ; CHECK-NEXT:   [[INT:%[0-9]+]]:_(p0) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aarch64.mops.memset.tag), [[COPY]](p0), [[TRUNC]](i8), [[COPY2]](i64) :: (store unknown-size into %ir.dst, align 1)
  ; CHECK-NEXT:   $x0 = COPY [[INT]](p0)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  %r = call ptr @llvm.aarch64.mops.memset.tag(ptr %dst, i8 %val, i64 %size)
  ret ptr %r
}

define ptr @memset_tag_align16(ptr align 16 %dst, i8 %val) {
  ; CHECK-LABEL: name: memset_tag_align16
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $w1, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(p0) = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i8) = G_TRUNC [[COPY1]](i32)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 32
  ; CHECK-NEXT:   [[INT:%[0-9]+]]:_(p0) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.aarch64.mops.memset.tag), [[COPY]](p0), [[TRUNC]](i8), [[C]](i64) :: (store unknown-size into %ir.dst, align 16)
  ; CHECK-NEXT:   $x0 = COPY [[INT]](p0)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  %r = call ptr @llvm.aarch64.mops.memset.tag(ptr align 16 %dst, i8 %val, i64 32)
  ret ptr %r
}
