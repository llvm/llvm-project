# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s


--- |
  target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
  target triple = "aarch64-unknown-linux-gnu"

  define ptr @dont_combine_ptr_add(i64 %x0, i64 %x1, ptr %x2) {
    ret ptr %x2
  }

  define i64 @dont_combine_mul_with_dbg_use(i64 %x0, i64 %x1) !dbg !5 {
    ret i64 0, !dbg !9
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2)
  !1 = !DIFile(filename: "postlegalizercombiner-mulpow2.mir", directory: "/")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "dont_combine_mul_with_dbg_use", linkageName: "dont_combine_mul_with_dbg_use", scope: null, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !10)
  !6 = !DISubroutineType(types: !7)
  !7 = !{!8, !8, !8}
  !8 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !5)
  !10 = !{!11}
  !11 = !DILocalVariable(name: "mul_result", scope: !5, file: !1, line: 1, type: !8)


...
---
name:            dont_combine_ptr_add
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1, $x2

    ; G_PTR_ADD can become a madd, so we don't want to perform the combine.

    ; CHECK-LABEL: name: dont_combine_ptr_add
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %reg0:_(i64) = COPY $x0
    ; CHECK-NEXT: %reg1:_(i64) = COPY $x1
    ; CHECK-NEXT: %ptr:_(p0) = COPY $x2
    ; CHECK-NEXT: %cst:_(i64) = G_CONSTANT i64 6
    ; CHECK-NEXT: %mul:_(i64) = nsw G_MUL %reg0, %cst
    ; CHECK-NEXT: %ptr_add:_(p0) = G_PTR_ADD %ptr, %mul(i64)
    ; CHECK-NEXT: $x0 = COPY %ptr_add(p0)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %reg0:_(i64) = COPY $x0
    %reg1:_(i64) = COPY $x1
    %ptr:_(p0) = COPY $x2
    %cst:_(i64) = G_CONSTANT i64 6
    %mul:_(i64) = nsw G_MUL %reg0, %cst
    %ptr_add:_(p0) = G_PTR_ADD %ptr, %mul
    $x0 = COPY %ptr_add(p0)
    RET_ReallyLR implicit $x0



...
---
name:            dont_combine_mul_with_dbg_use
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1

    ; We don't want a debug use of the multiply result to hide its sole non-debug
    ; G_ADD user. We want to keep G_MUL so that it can potentially form a madd later.

    ; CHECK-LABEL: name: dont_combine_mul_with_dbg_use
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %reg0:_(i64) = COPY $x0
    ; CHECK-NEXT: %reg1:_(i64) = COPY $x1
    ; CHECK-NEXT: %cst:_(i64) = G_CONSTANT i64 6
    ; CHECK-NEXT: %mul:_(i64) = G_MUL %reg0, %cst
    ; CHECK-NEXT: DBG_VALUE %mul(i64), $noreg, ![[VAR:[0-9]+]], !DIExpression(), debug-location ![[LOC:[0-9]+]]
    ; CHECK-NEXT: %add:_(i64) = G_ADD %mul, %reg1
    ; CHECK-NEXT: $x0 = COPY %add(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0

    %reg0:_(i64) = COPY $x0
    %reg1:_(i64) = COPY $x1
    %cst:_(i64) = G_CONSTANT i64 6
    %mul:_(i64) = G_MUL %reg0, %cst
    DBG_VALUE %mul(i64), $noreg, !11, !DIExpression(), debug-location !9
    %add:_(i64) = G_ADD %mul, %reg1
    $x0 = COPY %add(i64)
    RET_ReallyLR implicit $x0

...
