---
name:            keep_low_64_v4s32
legalized:       true
body:             |
  bb.0:
    liveins: $q0
    ; CHECK-LABEL: name: keep_low_64_v4s32
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:_(<4 x i32>) = COPY $q0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; CHECK-NEXT: [[EXTRACT_SUBVECTOR:%[0-9]+]]:_(<2 x s32>) = G_EXTRACT_SUBVECTOR %src(<4 x i32>), 0
    ; CHECK-NEXT: %and:_(<4 x i32>) = G_CONCAT_VECTORS [[EXTRACT_SUBVECTOR]](<2 x s32>), [[BUILD_VECTOR]](<2 x s32>)
    ; CHECK-NEXT: $q0 = COPY %and(<4 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %src:_(<4 x i32>) = COPY $q0
    %ones:_(i32) = G_CONSTANT i32 -1
    %zero:_(i32) = G_CONSTANT i32 0
    %mask:_(<4 x i32>) = G_BUILD_VECTOR %ones(i32), %ones(i32), %zero(i32), %zero(i32)
    %and:_(<4 x i32>) = G_AND %src, %mask
    $q0 = COPY %and(<4 x i32>)
    RET_ReallyLR implicit $q0
...
