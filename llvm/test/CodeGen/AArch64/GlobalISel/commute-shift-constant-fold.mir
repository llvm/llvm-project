# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner --aarch64prelegalizercombiner-only-enable-rule="commute_shift_or,hoist_logic_op_with_same_opcode_hands" -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=CHECK-OR
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner --aarch64prelegalizercombiner-only-enable-rule="commute_shift_add" -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=CHECK-ADD
# REQUIRES: asserts

# Test that commute_shift_binop's apply constant-folds shl(c1, c2) to a
# G_CONSTANT via MachineIRBuilder + CSE.
#
# CHECK-OR enables both commute_shift_or and
# hoist_logic_op_with_same_opcode_hands to verify that the constant-fold
# breaks the infinite cycle between the two rules.
#
# Without the fix (MIR-pattern apply), commute_shift_or creates a live
# G_SHL(c1, c2) that is NOT constant-folded.  Both operands of the
# resulting OR are now G_SHLs with the same shift amount, so
# hoist_logic_op_with_same_opcode_hands reverses the transform back to
# shl(or(x, c1), c2) — causing an infinite combine loop.
#
# With the fix (MachineIRBuilder apply), B.buildShl routes through the
# CSE/observer infrastructure, collapsing shl(c1, c2) to a G_CONSTANT
# so hoist_logic_op_with_same_opcode_hands cannot match.

---
name:            shl_or_const_fold
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $x1
    ; CHECK-OR-LABEL: name: shl_or_const_fold
    ; CHECK-OR: liveins: $w0, $x1
    ; CHECK-OR-NEXT: {{  $}}
    ; CHECK-OR-NEXT: %x:_(s32) = COPY $w0
    ; CHECK-OR-NEXT: %ptr:_(p0) = COPY $x1
    ; CHECK-OR-NEXT: %c2:_(s32) = G_CONSTANT i32 2
    ; CHECK-OR-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %x, %c2(s32)
    ; CHECK-OR-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 4
    ; CHECK-OR-NEXT: %shl:_(s32) = G_OR [[SHL]], [[C]]
    ; CHECK-OR-NEXT: G_STORE %shl(s32), %ptr(p0) :: (store (s32))
    ; CHECK-OR-NEXT: RET_ReallyLR
    ;
    ; CHECK-ADD-LABEL: name: shl_or_const_fold
    ; CHECK-ADD: liveins: $w0, $x1
    ; CHECK-ADD-NEXT: {{  $}}
    ; CHECK-ADD-NEXT: %x:_(s32) = COPY $w0
    ; CHECK-ADD-NEXT: %ptr:_(p0) = COPY $x1
    ; CHECK-ADD-NEXT: %c1:_(s32) = G_CONSTANT i32 1
    ; CHECK-ADD-NEXT: %c2:_(s32) = G_CONSTANT i32 2
    ; CHECK-ADD-NEXT: %or:_(s32) = G_OR %x, %c1
    ; CHECK-ADD-NEXT: %shl:_(s32) = G_SHL %or, %c2(s32)
    ; CHECK-ADD-NEXT: G_STORE %shl(s32), %ptr(p0) :: (store (s32))
    ; CHECK-ADD-NEXT: RET_ReallyLR
    %x:_(s32) = COPY $w0
    %ptr:_(p0) = COPY $x1
    %c1:_(s32) = G_CONSTANT i32 1
    %c2:_(s32) = G_CONSTANT i32 2
    %or:_(s32) = G_OR %x, %c1
    %shl:_(s32) = G_SHL %or, %c2(s32)
    G_STORE %shl(s32), %ptr(p0) :: (store (s32))
    RET_ReallyLR
...
---
name:            shl_add_const_fold
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $x1
    ; CHECK-OR-LABEL: name: shl_add_const_fold
    ; CHECK-OR: liveins: $w0, $x1
    ; CHECK-OR-NEXT: {{  $}}
    ; CHECK-OR-NEXT: %x:_(s32) = COPY $w0
    ; CHECK-OR-NEXT: %ptr:_(p0) = COPY $x1
    ; CHECK-OR-NEXT: %c1:_(s32) = G_CONSTANT i32 3
    ; CHECK-OR-NEXT: %c2:_(s32) = G_CONSTANT i32 4
    ; CHECK-OR-NEXT: %add:_(s32) = G_ADD %x, %c1
    ; CHECK-OR-NEXT: %shl:_(s32) = G_SHL %add, %c2(s32)
    ; CHECK-OR-NEXT: G_STORE %shl(s32), %ptr(p0) :: (store (s32))
    ; CHECK-OR-NEXT: RET_ReallyLR
    ;
    ; CHECK-ADD-LABEL: name: shl_add_const_fold
    ; CHECK-ADD: liveins: $w0, $x1
    ; CHECK-ADD-NEXT: {{  $}}
    ; CHECK-ADD-NEXT: %x:_(s32) = COPY $w0
    ; CHECK-ADD-NEXT: %ptr:_(p0) = COPY $x1
    ; CHECK-ADD-NEXT: %c2:_(s32) = G_CONSTANT i32 4
    ; CHECK-ADD-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %x, %c2(s32)
    ; CHECK-ADD-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 48
    ; CHECK-ADD-NEXT: %shl:_(s32) = G_ADD [[SHL]], [[C]]
    ; CHECK-ADD-NEXT: G_STORE %shl(s32), %ptr(p0) :: (store (s32))
    ; CHECK-ADD-NEXT: RET_ReallyLR
    %x:_(s32) = COPY $w0
    %ptr:_(p0) = COPY $x1
    %c1:_(s32) = G_CONSTANT i32 3
    %c2:_(s32) = G_CONSTANT i32 4
    %add:_(s32) = G_ADD %x, %c1
    %shl:_(s32) = G_SHL %add, %c2(s32)
    G_STORE %shl(s32), %ptr(p0) :: (store (s32))
    RET_ReallyLR
...
