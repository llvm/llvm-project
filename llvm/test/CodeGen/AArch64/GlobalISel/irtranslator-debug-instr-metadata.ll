; NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64 -global-isel -stop-after=ir-translator -simplify-mir < %s | FileCheck %s

; Debug records attached to the ret are translated before the ret itself, while
; the builder still holds the load's !pcsections/!mmra state. The load must keep
; that metadata; the DBG_VALUE/DBG_LABEL instructions must not inherit it.
@g = global i64 0

define void @f() !dbg !5 {
  ; CHECK-LABEL: name: f
  ; CHECK: bb.1.entry:
  ; CHECK-NEXT:   [[GV:%[0-9]+]]:_(p0) = G_GLOBAL_VALUE @g
  ; CHECK-NEXT:   [[FRAME_INDEX:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0.slot
  ; CHECK-NEXT:   [[LOAD:%[0-9]+]]:_(i64) = G_LOAD [[GV]](p0), pcsections !6, mmra !7 :: (volatile dereferenceable load (i64) from @g)
  ; CHECK-NEXT:   DBG_VALUE 0, 0, !8, !DIExpression(), debug-location !10
  ; CHECK-NEXT:   DBG_VALUE %stack.0.slot, 0, !8, !DIExpression(), debug-location !10
  ; CHECK-NEXT:   DBG_LABEL !11, debug-location !10
  ; CHECK-NEXT:   RET_ReallyLR
entry:
  %slot = alloca i64, align 8
  %v = load volatile i64, ptr @g, align 8, !pcsections !0, !mmra !1
    #dbg_value(i64 0, !8, !DIExpression(), !9)
    #dbg_value(ptr %slot, !8, !DIExpression(DW_OP_deref), !9)
    #dbg_label(!10, !9)
  ret void
}

!llvm.dbg.cu = !{!2}
!llvm.module.flags = !{!4}

!0 = !{!"section"}
!1 = !{!"foo", !"bar"}
!2 = distinct !DICompileUnit(language: DW_LANG_C, file: !3, emissionKind: FullDebug)
!3 = !DIFile(filename: "t.c", directory: "/")
!4 = !{i32 2, !"Debug Info Version", i32 3}
!5 = distinct !DISubprogram(name: "f", scope: !3, file: !3, line: 1, type: !6, spFlags: DISPFlagDefinition, unit: !2)
!6 = !DISubroutineType(types: !{})
!7 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
!8 = !DILocalVariable(name: "x", scope: !5, file: !3, line: 1, type: !7)
!9 = !DILocation(line: 1, scope: !5)
!10 = !DILabel(scope: !5, name: "l", file: !3, line: 1)
