    ; CHECK-NEXT: [[FABS:%[0-9]+]]:_(<2 x f32>) = G_FABS [[COPY]]
    ; CHECK-NEXT: $x0 = COPY [[FABS]](<2 x f32>)
    %0:_(<2 x f32>) = COPY $x0
    %1:_(<2 x f32>) = G_FABS %0(<2 x f32>)
    %2:_(<2 x f32>) = G_FABS %1(<2 x f32>)
    $x0 = COPY %2(<2 x f32>)
...
