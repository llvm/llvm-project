---
name:            test_combine_fabs_fabs
body:             |
  bb.1:
  liveins: $w0
    ; CHECK-LABEL: name: test_combine_fabs_fabs
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $w0
    ; CHECK-NEXT: [[FABS:%[0-9]+]]:_(f32) = G_FABS [[COPY]]
    ; CHECK-NEXT: $w0 = COPY [[FABS]](f32)
    %0:_(f32) = COPY $w0
    %1:_(f32) = G_FABS %0(f32)
    %2:_(f32) = G_FABS %1(f32)
    $w0 = COPY %2(f32)
...
---
