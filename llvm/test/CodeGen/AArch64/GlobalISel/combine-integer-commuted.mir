# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner \
# RUN:   --aarch64prelegalizercombiner-disable-rule=G_ADD_commute_constant_to_rhs \
# RUN:   %s -o - | FileCheck %s

# The constant is the LHS of the commutable G_ADD. G_ADD_commute_constant_to_rhs
# is disabled so the commuted versions of the rules must handle it.

---
name:   APlusC1MinusC2_commuted
body:             |
  bb.0:
    liveins: $w0, $w1

    ; CHECK-LABEL: name: APlusC1MinusC2_commuted
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 -2
    ; CHECK-NEXT: %sub:_(i64) = G_ADD %a, [[C]]
    ; CHECK-NEXT: $x0 = COPY %sub(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %a:_(i64) = COPY $x0
    %c1:_(i64) = G_CONSTANT i64 5
    %c2:_(i64) = G_CONSTANT i64 7
    %add:_(i64) = G_ADD %c1, %a
    %sub:_(i64) = G_SUB %add, %c2
    $x0 = COPY %sub
    RET_ReallyLR implicit $x0

...
---
name:   C2MinusAPlusC1_commuted
body:             |
  bb.0:
    liveins: $w0, $w1

    ; CHECK-LABEL: name: C2MinusAPlusC1_commuted
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 5
    ; CHECK-NEXT: %sub:_(i64) = G_SUB [[C]], %a
    ; CHECK-NEXT: $x0 = COPY %sub(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %a:_(i64) = COPY $x0
    %c1:_(i64) = G_CONSTANT i64 4
    %c2:_(i64) = G_CONSTANT i64 9
    %add:_(i64) = G_ADD %c1, %a
    %sub:_(i64) = G_SUB %c2, %add
    $x0 = COPY %sub
    RET_ReallyLR implicit $x0

...
