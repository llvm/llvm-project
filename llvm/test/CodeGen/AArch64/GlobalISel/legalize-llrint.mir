    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[INTRINSIC_LLRINT]](i64)
    ; CHECK-NEXT: $w0 = COPY [[TRUNC]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(f32) = COPY $s0
    %1:_(i64) = G_INTRINSIC_LLRINT %0(f32)
    %2:_(i32) = G_TRUNC %1(i64)
    $w0 = COPY %2(i32)
    RET_ReallyLR implicit $w0

...
