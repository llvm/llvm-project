    ; CHECK-NEXT: $s0 = COPY [[CTLZ]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %0:_(i32) = COPY $s0
    %2:_(i32) = COPY %0(i32)
    %1:_(i32) = G_CTLZ_ZERO_POISON %2(i32)
    $s0 = COPY %1(i32)
    RET_ReallyLR implicit $s0

...
