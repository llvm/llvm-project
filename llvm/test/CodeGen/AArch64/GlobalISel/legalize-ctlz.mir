name:            test_s65
alignment:       4
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0, $x1

    ; CHECK-LABEL: name: test_s65
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 -1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[COPY]], [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i64) = G_AND [[COPY1]], [[C1]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[AND1]](i64), [[C2]]
    ; CHECK-NEXT: [[CTLZ:%[0-9]+]]:_(i64) = G_CTLZ [[AND]](i64)
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(i64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[UADDO:%[0-9]+]]:_(i64), [[UADDO1:%[0-9]+]]:_(i32) = G_UADDO [[CTLZ]], [[C3]]
    ; CHECK-NEXT: [[UADDE:%[0-9]+]]:_(i64), [[UADDE1:%[0-9]+]]:_(i32) = G_UADDE [[C2]], [[C2]], [[UADDO1]]
    ; CHECK-NEXT: [[CTLZ1:%[0-9]+]]:_(i64) = G_CTLZ [[AND1]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i32), [[UADDO]], [[CTLZ1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i32), [[UADDE]], [[C2]]
    ; CHECK-NEXT: [[C4:%[0-9]+]]:_(i64) = G_CONSTANT i64 63
    ; CHECK-NEXT: [[USUBO:%[0-9]+]]:_(i64), [[USUBO1:%[0-9]+]]:_(i32) = G_USUBO [[SELECT]], [[C4]]
    ; CHECK-NEXT: [[USUBE:%[0-9]+]]:_(i64), [[USUBE1:%[0-9]+]]:_(i32) = G_USUBE [[SELECT1]], [[C2]], [[USUBO1]]
    ; CHECK-NEXT: $x0 = COPY [[USUBO]](i64)
    ; CHECK-NEXT: $x1 = COPY [[USUBE]](i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0, implicit $x1
    %1:_(i64) = COPY $x0
    %2:_(i64) = COPY $x1
    %3:_(i128) = G_MERGE_VALUES %1(i64), %2(i64)
    %0:_(i65) = G_TRUNC %3(i128)
    %4:_(i65) = G_CTLZ %0(i65)
    %7:_(i128) = G_ANYEXT %4(i65)
    %5:_(i64), %6:_(i64) = G_UNMERGE_VALUES %7(i128)
    $x0 = COPY %5(i64)
    $x1 = COPY %6(i64)
    RET_ReallyLR implicit $x0, implicit $x1
