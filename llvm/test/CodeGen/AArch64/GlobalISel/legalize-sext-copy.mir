# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64 -run-pass=legalizer %s -o - | FileCheck %s
---
name:            test_sext_copy
body: |
  bb.0.entry:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: test_sext_copy
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w1
    ; CHECK-NEXT: $w0 = COPY [[COPY]](i32)
    ; CHECK-NEXT: $w0 = COPY [[COPY]](i32)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[SEXT:%[0-9]+]]:_(i64) = G_SEXT [[COPY1]](i32)
    ; CHECK-NEXT: $x0 = COPY [[SEXT]](i64)
    %0:_(i32) = COPY $w1
    $w0 = COPY %0(i32)
    $w0 = COPY %0(i32)
    %1:_(i32) = COPY $w0
    %2:_(i64) = G_SEXT %1(i32)
    $x0 = COPY %2(i64)
...
