# Vector arithmetic, FMA, rounding, and min/max folds must honour the element
# type's denormal mode, just like scalar folds. Flush-to-zero folds subnormal
# inputs to zero; dynamic mode declines folds whose results depend on flushing.
# FNEG is a sign-bit operation and must preserve subnormals in every mode.
---
name:            fadd_vector_denormal
legalized:       true
body:             |
  bb.1.entry:
    ; IEEE-LABEL: name: fadd_vector_denormal
    ; IEEE: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float 2.802600e-45
    ; IEEE-NEXT: %res:_(<2 x f32>) = G_BUILD_VECTOR [[C]](f32), [[C]](f32)
    ; IEEE-NEXT: $d0 = COPY %res(<2 x f32>)
    ; IEEE-NEXT: RET_ReallyLR implicit $d0
    ;
    ; FTZ-LABEL: name: fadd_vector_denormal
    ; FTZ: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float 0.000000e+00
    ; FTZ-NEXT: %res:_(<2 x f32>) = G_BUILD_VECTOR [[C]](f32), [[C]](f32)
    ; FTZ-NEXT: $d0 = COPY %res(<2 x f32>)
    ; FTZ-NEXT: RET_ReallyLR implicit $d0
    ;
    ; DYNAMIC-LABEL: name: fadd_vector_denormal
    ; DYNAMIC: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; DYNAMIC-NEXT: %av:_(<2 x f32>) = G_BUILD_VECTOR %denorm(f32), %denorm(f32)
    ; DYNAMIC-NEXT: %res:_(<2 x f32>) = G_FADD %av, %av
    ; DYNAMIC-NEXT: $d0 = COPY %res(<2 x f32>)
    ; DYNAMIC-NEXT: RET_ReallyLR implicit $d0
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %av:_(<2 x f32>) = G_BUILD_VECTOR %denorm(f32), %denorm(f32)
    %res:_(<2 x f32>) = G_FADD %av, %av
    $d0 = COPY %res(<2 x f32>)
    RET_ReallyLR implicit $d0

...
