---
name:            mul_by_zero
alignment:       4
tracksRegLiveness: true
frameInfo:
  maxAlignment:    1
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: mul_by_zero
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: $x0 = COPY [[C]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 0
    %2:_(i64) = G_MUL %0, %1(i64)
    $x0 = COPY %2(i64)
...
