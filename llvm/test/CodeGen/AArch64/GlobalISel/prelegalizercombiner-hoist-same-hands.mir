    ; CHECK-PRE-NEXT: %y_wide:_(i32) = COPY $w1
    ; CHECK-PRE-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR %x_wide, %y_wide
    ; CHECK-PRE-NEXT: [[TRUNC:%[0-9]+]]:_(i1) = G_TRUNC [[OR]](i32)
    ; CHECK-PRE-NEXT: %logic_op:_(i64) = G_SEXT [[TRUNC]](i1)
    ; CHECK-PRE-NEXT: $x0 = COPY %logic_op(i64)
    ; CHECK-PRE-NEXT: RET_ReallyLR implicit $x0
    ;
    ; CHECK-POST-LABEL: name: illegal_ty
    ; CHECK-POST: liveins: $w0, $w1
    ; CHECK-POST-NEXT: {{  $}}
    ; CHECK-POST-NEXT: %x_wide:_(i32) = COPY $w0
    ; CHECK-POST-NEXT: %y_wide:_(i32) = COPY $w1
    ; CHECK-POST-NEXT: %x:_(i1) = G_TRUNC %x_wide(i32)
    ; CHECK-POST-NEXT: %y:_(i1) = G_TRUNC %y_wide(i32)
    ; CHECK-POST-NEXT: %hand1:_(i64) = G_SEXT %x(i1)
    ; CHECK-POST-NEXT: %hand2:_(i64) = G_SEXT %y(i1)
    ; CHECK-POST-NEXT: %logic_op:_(i64) = G_OR %hand1, %hand2
    ; CHECK-POST-NEXT: $x0 = COPY %logic_op(i64)
    ; CHECK-POST-NEXT: RET_ReallyLR implicit $x0
