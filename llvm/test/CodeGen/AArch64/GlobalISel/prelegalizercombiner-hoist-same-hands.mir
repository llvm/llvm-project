---
name:            dont_combine_different_defs_on_binop
# z1 != z2, so don't combine.
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $x0, $x1, $x2, $x3
    ; CHECK-LABEL: name: dont_combine_different_defs_on_binop
    ; CHECK: liveins: $x0, $x1, $x2, $x3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: %y:_(i64) = COPY $x1
    ; CHECK-NEXT: %z1:_(i64) = COPY $x2
    ; CHECK-NEXT: %z2:_(i64) = COPY $x3
    ; CHECK-NEXT: %hand1:_(i64) = G_AND %x, %z1
    ; CHECK-NEXT: %hand2:_(i64) = G_AND %y, %z2
    ; CHECK-NEXT: %logic_op:_(i64) = G_OR %hand1, %hand2
    ; CHECK-NEXT: $x0 = COPY %logic_op(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i64) = COPY $x0
    %y:_(i64) = COPY $x1
    %z1:_(i64) = COPY $x2
    %z2:_(i64) = COPY $x3
    %hand1:_(i64) = G_AND %x(i64), %z1
    %hand2:_(i64) = G_AND %y(i64), %z2
    %logic_op:_(i64) = G_OR %hand1, %hand2
    $x0 = COPY %logic_op(i64)
    RET_ReallyLR implicit $x0

...
---
name: dont_combine_more_than_one_use
# The LHS register is used more than once. Don't combine.
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: dont_combine_more_than_one_use
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %y:_(i32) = COPY $w1
    ; CHECK-NEXT: %hand1:_(i64) = G_SEXT %x(i32)
    ; CHECK-NEXT: %hand2:_(i64) = G_SEXT %y(i32)
    ; CHECK-NEXT: %logic_op:_(i64) = G_OR %hand1, %hand2
    ; CHECK-NEXT: %other_op:_(i64) = G_ADD %hand1, %logic_op
    ; CHECK-NEXT: $x0 = COPY %other_op(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i32) = COPY $w0
    %y:_(i32) = COPY $w1
    %hand1:_(i64) = G_SEXT %x(i32)
    %hand2:_(i64) = G_SEXT %y(i32)
    %logic_op:_(i64) = G_OR %hand1, %hand2
    %other_op:_(i64) = G_ADD %hand1, %logic_op
    $x0 = COPY %other_op(i64)
    RET_ReallyLR implicit $x0

...
---
name:           combine_vector
# Show that we can combine vector types.
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $d0, $d1
    ; CHECK-LABEL: name: combine_vector
    ; CHECK: liveins: $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<2 x i32>) = COPY $d0
    ; CHECK-NEXT: %y:_(<2 x i32>) = COPY $d1
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(<2 x i32>) = G_OR %x, %y
    ; CHECK-NEXT: %logic_op:_(<2 x i64>) = G_SEXT [[OR]](<2 x i32>)
    ; CHECK-NEXT: $q0 = COPY %logic_op(<2 x i64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %x:_(<2 x i32>) = COPY $d0
    %y:_(<2 x i32>) = COPY $d1
    %hand1:_(<2 x i64>) = G_SEXT %x(<2 x i32>)
    %hand2:_(<2 x i64>) = G_SEXT %y(<2 x i32>)
    %logic_op:_(<2 x i64>) = G_OR %hand1, %hand2
    $q0 = COPY %logic_op(<2 x i64>)
    RET_ReallyLR implicit $q0

...
---
name:           combine_vector_implicitdef
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $d0, $d1
    ; CHECK-LABEL: name: combine_vector_implicitdef
    ; CHECK: liveins: $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: %logic_op:_(<2 x i64>) = G_BUILD_VECTOR [[C]](i64), [[C]](i64)
    ; CHECK-NEXT: $q0 = COPY %logic_op(<2 x i64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %x:_(<2 x i64>) = G_IMPLICIT_DEF
    %y:_(<2 x i64>) = G_IMPLICIT_DEF
    %logic_op:_(<2 x i64>) = G_AND %x, %y
    $q0 = COPY %logic_op(<2 x i64>)
    RET_ReallyLR implicit $q0
