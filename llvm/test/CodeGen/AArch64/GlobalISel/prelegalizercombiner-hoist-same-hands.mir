body:             |
  bb.0:
    liveins: $x0, $x1, $x2
    ; CHECK-LABEL: name: xor_combine_shl
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: %y:_(i64) = COPY $x1
    ; CHECK-NEXT: %z:_(i64) = COPY $x2
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i64) = G_XOR %x, %y
    ; CHECK-NEXT: %logic_op:_(i64) = G_SHL [[XOR]], %z(i64)
    ; CHECK-NEXT: $x0 = COPY %logic_op(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i64) = COPY $x0
    %y:_(i64) = COPY $x1
    %z:_(i64) = COPY $x2
    %hand1:_(i64) = G_SHL %x(i64), %z
    %hand2:_(i64) = G_SHL %y(i64), %z
    %logic_op:_(i64) = G_XOR %hand1, %hand2
    $x0 = COPY %logic_op(i64)
    RET_ReallyLR implicit $x0

