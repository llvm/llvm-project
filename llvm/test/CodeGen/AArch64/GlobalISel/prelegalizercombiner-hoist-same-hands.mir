name:            or_combine_sext
# or (sext X), (sext Y) --> sext (or X, Y)
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: or_combine_sext
