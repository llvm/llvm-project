# RUN: llc -mtriple=aarch64 -run-pass=aarch64-postlegalizer-combiner \
# RUN:   -aarch64postlegalizercombiner-only-enable-rule=trunc_or_to_addhn,subaddmulreassoc \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# CHECK-LABEL: name: trunc_or_to_addhn_debug_use
# CHECK: %cmp_a:_(<8 x s16>) = G_ICMP
# CHECK-NEXT: %cmp_b:_(<8 x s16>) = G_ICMP
# CHECK-NEXT: DBG_VALUE $noreg, $noreg
# CHECK-NEXT: %result:_(<8 x s8>) = G_ADDHN %cmp_a(<8 x s16>), %cmp_b

# CHECK-LABEL: name: sub_add_mul_reassoc_debug_use
# CHECK: %mul1:_(s32) = G_MUL %a, %b
# CHECK-NEXT: %mul2:_(s32) = G_MUL %b, %c
# CHECK-NEXT: DBG_VALUE $noreg, $noreg
# CHECK-NEXT: [[FIRST:%[0-9]+]]:_(s32) = G_SUB %x, %mul1
# CHECK-NEXT: %result:_(s32) = G_SUB [[FIRST]], %mul2

---
name: trunc_or_to_addhn_debug_use
machineMetadataNodes:
  - '!0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "mir-test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)'
  - '!1 = !DIFile(filename: "postlegalizer-direct-hasoneuse-debug.mir", directory: "/")'
  - '!2 = !DISubroutineType(types: !3)'
  - '!3 = !{}'
  - '!4 = distinct !DISubprogram(name: "trunc_or_to_addhn_debug_use", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)'
  - '!5 = !DIBasicType(name: "wide", size: 128, encoding: DW_ATE_unsigned)'
  - '!6 = !DILocalVariable(name: "or", scope: !4, file: !1, line: 1, type: !5)'
  - '!7 = !DILocation(line: 1, column: 1, scope: !4)'
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q0, $q1, $q2
    %a:_(<8 x s16>) = COPY $q0
    %b:_(<8 x s16>) = COPY $q1
    %comparand:_(<8 x s16>) = COPY $q2
    %cmp_a:_(<8 x s16>) = G_ICMP intpred(eq), %a, %comparand
    %cmp_b:_(<8 x s16>) = G_ICMP intpred(eq), %b, %comparand
    %or:_(<8 x s16>) = G_OR %cmp_a, %cmp_b
    DBG_VALUE %or(<8 x s16>), $noreg, !6, !DIExpression(), debug-location !7
    %result:_(<8 x s8>) = G_TRUNC %or
    $d0 = COPY %result(<8 x s8>)
...
---
name: sub_add_mul_reassoc_debug_use
machineMetadataNodes:
  - '!0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "mir-test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)'
  - '!1 = !DIFile(filename: "postlegalizer-direct-hasoneuse-debug.mir", directory: "/")'
  - '!2 = !DISubroutineType(types: !3)'
  - '!3 = !{}'
  - '!4 = distinct !DISubprogram(name: "sub_add_mul_reassoc_debug_use", scope: !1, file: !1, line: 2, type: !2, scopeLine: 2, spFlags: DISPFlagDefinition, unit: !0)'
  - '!5 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)'
  - '!6 = !DILocalVariable(name: "sum", scope: !4, file: !1, line: 2, type: !5)'
  - '!7 = !DILocation(line: 2, column: 1, scope: !4)'
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1, $w2, $w3
    %x:_(s32) = COPY $w0
    %a:_(s32) = COPY $w1
    %b:_(s32) = COPY $w2
    %c:_(s32) = COPY $w3
    %mul1:_(s32) = G_MUL %a, %b
    %mul2:_(s32) = G_MUL %b, %c
    %sum:_(s32) = G_ADD %mul1, %mul2
    DBG_VALUE %sum(s32), $noreg, !6, !DIExpression(), debug-location !7
    %result:_(s32) = G_SUB %x, %sum
    $w0 = COPY %result(s32)
...
