# RUN: llc -mtriple=aarch64 -debugify-and-strip-all-safe \
# RUN:   -run-pass=aarch64-postlegalizer-combiner \
# RUN:   -aarch64postlegalizercombiner-only-enable-rule=trunc_or_to_addhn,subaddmulreassoc \
# RUN:   %s -o - | FileCheck %s

# CHECK-LABEL: name: trunc_or_to_addhn_debug_use
# CHECK: %cmp_a:_(<8 x s16>) = G_ICMP
# CHECK-NEXT: %cmp_b:_(<8 x s16>) = G_ICMP
# CHECK-NEXT: %result:_(<8 x s8>) = G_ADDHN %cmp_a(<8 x s16>), %cmp_b

# CHECK-LABEL: name: sub_add_mul_reassoc_debug_use
# CHECK: %mul1:_(s32) = G_MUL %a, %b
# CHECK-NEXT: %mul2:_(s32) = G_MUL %b, %c
# CHECK-NEXT: [[FIRST:%[0-9]+]]:_(s32) = G_SUB %x, %mul1
# CHECK-NEXT: %result:_(s32) = G_SUB [[FIRST]], %mul2

---
name: trunc_or_to_addhn_debug_use
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q0, $q1, $q2
    %a:_(<8 x s16>) = COPY $q0
    %b:_(<8 x s16>) = COPY $q1
    %comparand:_(<8 x s16>) = COPY $q2
    %cmp_a:_(<8 x s16>) = G_ICMP intpred(eq), %a, %comparand
    %cmp_b:_(<8 x s16>) = G_ICMP intpred(eq), %b, %comparand
    %or:_(<8 x s16>) = G_OR %cmp_a, %cmp_b
    %result:_(<8 x s8>) = G_TRUNC %or
    $d0 = COPY %result(<8 x s8>)
...
---
name: sub_add_mul_reassoc_debug_use
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1, $w2, $w3
    %x:_(s32) = COPY $w0
    %a:_(s32) = COPY $w1
    %b:_(s32) = COPY $w2
    %c:_(s32) = COPY $w3
    %mul1:_(s32) = G_MUL %a, %b
    %mul2:_(s32) = G_MUL %b, %c
    %sum:_(s32) = G_ADD %mul1, %mul2
    %result:_(s32) = G_SUB %x, %sum
    $w0 = COPY %result(s32)
...
