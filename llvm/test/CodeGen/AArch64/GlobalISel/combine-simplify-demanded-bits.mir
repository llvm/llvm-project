    ; RULE-NEXT: $w0 = COPY %res(i32)
    ; RULE-NEXT: RET_ReallyLR implicit $w0
    ;
    ; FULL-LABEL: name: nested_lshr_exact
    ; FULL: liveins: $w0
    ; FULL-NEXT: {{  $}}
    ; FULL-NEXT: %x:_(i32) = COPY $w0
    ; FULL-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 28
    ; FULL-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 3
    ; FULL-NEXT: %res:_(i32) = G_UBFX %x, [[C1]](i32), [[C]]
    ; FULL-NEXT: $w0 = COPY %res(i32)
    ; FULL-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %mask:_(i32) = G_CONSTANT i32 -8
    %masked:_(i32) = G_AND %x, %mask
    %one:_(i32) = G_CONSTANT i32 1
    %four:_(i32) = G_CONSTANT i32 4
    %shl:_(i32) = nuw nsw G_SHL %masked, %one
    %res:_(i32) = exact G_LSHR %shl, %four
    $w0 = COPY %res(i32)
    RET_ReallyLR implicit $w0
...
