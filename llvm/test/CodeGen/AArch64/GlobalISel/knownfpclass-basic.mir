  ; CHECK-NEXT: %result:_ FPClasses:(all) SignBitKnown:?
    %input:_(s32) = COPY $w0
    %mantissa_mask:_(s32) = G_CONSTANT i32 8388607 ; 0x007fffff
    %one_bits:_(s32) = G_CONSTANT i32 1065353216 ; 0x3f800000
    %mantissa:_(s32) = G_AND %input, %mantissa_mask
    %bits:_(s32) = G_OR %mantissa, %one_bits
    %vector:_(<2 x s32>) = G_BUILD_VECTOR %bits, %bits
    %result:_(<2 x f32>) = G_BITCAST %vector
    $d0 = COPY %result(<2 x f32>)
