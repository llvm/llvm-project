  bb.0:
    liveins: $w0
  ; CHECK-LABEL: name: @BitcastKnownNormal
  ; CHECK-NEXT: %input:_ FPClasses:(all) SignBitKnown:?
  ; CHECK-NEXT: %mantissa_mask:_ FPClasses:(all) SignBitKnown:?
  ; CHECK-NEXT: %one_bits:_ FPClasses:(all) SignBitKnown:?
  ; CHECK-NEXT: %mantissa:_ FPClasses:(all) SignBitKnown:?
  ; CHECK-NEXT: %bits:_ FPClasses:(all) SignBitKnown:?
  ; CHECK-NEXT: %result:_ FPClasses:(all) SignBitKnown:?
    %input:_(s32) = COPY $w0
    %mantissa_mask:_(s32) = G_CONSTANT i32 8388607 ; 0x007fffff
    %one_bits:_(s32) = G_CONSTANT i32 1065353216 ; 0x3f800000
    %mantissa:_(s32) = G_AND %input, %mantissa_mask
    %bits:_(s32) = G_OR %mantissa, %one_bits
    %result:_(f32) = G_BITCAST %bits
    $s0 = COPY %result(f32)
