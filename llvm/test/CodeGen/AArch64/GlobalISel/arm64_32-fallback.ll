; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=arm64_32-apple-ios7.0 -global-isel -global-isel-abort=2 -pass-remarks-missed='gisel*' %s -o - 2>&1 | FileCheck %s

; Vectors of 32-bit pointers can't be bitcast to vectors of i64, so these fall
; back to SelectionDAG instead of asserting in the legalizer.

target datalayout = "e-m:o-p:32:32-i64:64-i128:128-n32:64-S128"

; CHECK: remark: <unknown>:0:0: unable to legalize instruction: {{.*}}G_SHUFFLE_VECTOR{{.*}} (in function: shuffle_v2p0)
; CHECK: warning: Instruction selection used fallback path for shuffle_v2p0

define <2 x ptr> @shuffle_v2p0(<2 x ptr> %a, <2 x ptr> %b) {
; CHECK-LABEL: shuffle_v2p0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov.d v0[1], v1[1]
; CHECK-NEXT:    ret
  %r = shufflevector <2 x ptr> %a, <2 x ptr> %b, <2 x i32> <i32 0, i32 3>
  ret <2 x ptr> %r
}
