---
name:            uadd_zero
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: uadd_zero
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %lhs:_(i32) = COPY $w0
    ; CHECK-NEXT: %add:_(i32) = COPY %lhs(i32)
    ; CHECK-NEXT: %o:_(i1) = G_CONSTANT i1 false
    ; CHECK-NEXT: %o_wide:_(i32) = G_ZEXT %o(i1)
    ; CHECK-NEXT: $w0 = COPY %add(i32)
    ; CHECK-NEXT: $w1 = COPY %o_wide(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %lhs:_(i32) = COPY $w0
    %zero:_(i32) = G_CONSTANT i32 0
    %add:_(i32), %o:_(i1) = G_UADDO %lhs, %zero
    %o_wide:_(i32) = G_ZEXT %o(i1)
    $w0 = COPY %add(i32)
    $w1 = COPY %o_wide
    RET_ReallyLR implicit $w0
