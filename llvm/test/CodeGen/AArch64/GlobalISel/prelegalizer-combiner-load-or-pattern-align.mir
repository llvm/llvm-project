    ; NOT_STRICT-NEXT: %ptr:_(p0) = COPY $x1
    ; NOT_STRICT-NEXT: %full_load:_(i32) = G_LOAD %ptr(p0) :: (load (s32), align 2)
    ; NOT_STRICT-NEXT: $w1 = COPY %full_load(i32)
    ; NOT_STRICT-NEXT: RET_ReallyLR implicit $w1
    ;
    ; STRICT-LABEL: name: misaligned
    ; STRICT: liveins: $x0, $x1
    ; STRICT-NEXT: {{  $}}
    ; STRICT-NEXT: %cst_1:_(i64) = G_CONSTANT i64 1
    ; STRICT-NEXT: %cst_16:_(i32) = G_CONSTANT i32 16
    ; STRICT-NEXT: %ptr:_(p0) = COPY $x1
    ; STRICT-NEXT: %ptr_elt_1:_(p0) = G_PTR_ADD %ptr, %cst_1(i64)
    ; STRICT-NEXT: %low_half:_(i32) = G_ZEXTLOAD %ptr(p0) :: (load (i16))
    ; STRICT-NEXT: %elt1:_(i32) = G_ZEXTLOAD %ptr_elt_1(p0) :: (load (i16))
    ; STRICT-NEXT: %high_half:_(i32) = nuw G_SHL %elt1, %cst_16(i32)
    ; STRICT-NEXT: %full_load:_(i32) = G_OR %low_half, %high_half
    ; STRICT-NEXT: $w1 = COPY %full_load(i32)
    ; STRICT-NEXT: RET_ReallyLR implicit $w1
    %cst_1:_(i64) = G_CONSTANT i64 1
    %cst_16:_(i32) = G_CONSTANT i32 16

    %ptr:_(p0) = COPY $x1
    %ptr_elt_1:_(p0) = G_PTR_ADD %ptr, %cst_1(i64)

    %low_half:_(i32) = G_ZEXTLOAD %ptr(p0) :: (load (i16), align 2)
    %elt1:_(i32) = G_ZEXTLOAD %ptr_elt_1(p0) :: (load (i16), align 2)
    %high_half:_(i32) = nuw G_SHL %elt1, %cst_16(i32)

    %full_load:_(i32) = G_OR %low_half, %high_half
    $w1 = COPY %full_load(i32)
    RET_ReallyLR implicit $w1

