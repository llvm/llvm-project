# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -O0 -mtriple aarch64-- -run-pass=instruction-select %s -o - | FileCheck %s

# Check that DBG_VALUE_LIST users of dead instructions erased during
# instruction selection are salvaged.

--- |
  define void @list_trunc() !dbg !5 {
    ret void
  }

  define void @list_trunc_twice() !dbg !10 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2)
  !1 = !DIFile(filename: "test.ll", directory: "/tmp")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "list_trunc", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !6 = !DISubroutineType(types: !2)
  !7 = !DILocalVariable(name: "v", scope: !5, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !5)
  !10 = distinct !DISubprogram(name: "list_trunc_twice", scope: !1, file: !1, line: 2, type: !6, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !11 = !DILocalVariable(name: "w", scope: !10, file: !1, line: 2, type: !8)
  !12 = !DILocation(line: 2, column: 1, scope: !10)
...
---
name:            list_trunc
legalized:       true
regBankSelected: true
body: |
  bb.0:
    liveins: $w1, $x0
    ; CHECK-LABEL: name: list_trunc
    ; CHECK: liveins: $w1, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), $noreg, $noreg, debug-location !DILocation(line: 1, column: 1, scope: !4)
    ; CHECK-NEXT: $w0 = COPY [[COPY]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr(i64) = COPY $x0
    %1:gpr(i32) = COPY $w1
    %2:gpr(i32) = G_TRUNC %0(i64)
    DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), %2(i32), %1(i32), debug-location !9
    $w0 = COPY %1(i32)
    RET_ReallyLR implicit $w0
...
---
name:            list_trunc_twice
legalized:       true
regBankSelected: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: list_trunc_twice
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_mul, DW_OP_stack_value), $noreg, $noreg, debug-location !DILocation(line: 2, column: 1, scope: !6)
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr(i64) = COPY $x0
    %1:gpr(i32) = G_TRUNC %0(i64)
    DBG_VALUE_LIST !11, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_mul, DW_OP_stack_value), %1(i32), %1(i32), debug-location !12
    RET_ReallyLR
...
