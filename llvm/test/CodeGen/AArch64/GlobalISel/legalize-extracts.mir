name:            test_extracts_4
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2


    ; CHECK-LABEL: name: test_extracts_4
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[EXTRACT:%[0-9]+]]:_(i32) = G_EXTRACT [[COPY]](i64), 32
    ; CHECK-NEXT: $w0 = COPY [[EXTRACT]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i128) = G_MERGE_VALUES %0, %1
    %3:_(i32) = G_EXTRACT %2, 32
    $w0 = COPY %3
    RET_ReallyLR implicit $w0
...
