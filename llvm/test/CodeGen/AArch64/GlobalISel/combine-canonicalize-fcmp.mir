---
name:            test_fcmp_no_same_semantics
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_fcmp_no_same_semantics
    ; CHECK: %res:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: $w0 = COPY %res(i32)
    %lhs:_(f64) = G_FCONSTANT double 2.0
    %fabs:_(f64) = G_FABS %lhs
    %trunc:_(f32) = G_FPTRUNC %fabs(f64)
    %rhs:_(f32) = G_FCONSTANT float 1.0
    %res:_(i32) = G_FCMP floatpred(oge), %trunc(f32), %rhs
    $w0 = COPY %res(i32)
...
