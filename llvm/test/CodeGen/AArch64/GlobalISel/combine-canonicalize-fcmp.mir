name:            test_fcmp_canon_splat
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_fcmp_canon_splat
    ; CHECK: %const:_(f64) = G_FCONSTANT double 1.000000e+00
    ; CHECK-NEXT: %lhs:_(<vscale x 2 x f64>) = G_SPLAT_VECTOR %const(f64)
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f64) = COPY $x1
    ; CHECK-NEXT: %rhs:_(<vscale x 2 x f64>) = G_SPLAT_VECTOR [[COPY]](f64)
    ; CHECK-NEXT: %res:_(<vscale x 2 x i32>) = afn G_FCMP floatpred(ole), %rhs(<vscale x 2 x f64>), %lhs
    ; CHECK-NEXT: %z:_(<vscale x 2 x i64>) = G_ZEXT %res(<vscale x 2 x i32>)
    ; CHECK-NEXT: $z0 = COPY %z(<vscale x 2 x i64>)
    %const:_(f64) = G_FCONSTANT double 1.0
    %lhs:_(<vscale x 2 x f64>) = G_SPLAT_VECTOR %const:_(f64)
    %1:_(f64) = COPY $x1
    %rhs:_(<vscale x 2 x f64>) = G_SPLAT_VECTOR %1:_(f64)
    %res:_(<vscale x 2 x i32>) = afn G_FCMP floatpred(oge), %lhs(<vscale x 2 x f64>), %rhs
    %z:_(<vscale x 2 x i64>) = G_ZEXT  %res
    $z0 = COPY %z(<vscale x 2 x i64>)
...
---
