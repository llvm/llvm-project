    ; CHECK-NEXT: $w0 = COPY %res(i32)
    %lhs:_(f64) = G_FCONSTANT double 1.0
    %rhs:_(f64) = G_FCONSTANT double 2.0
    %res:_(i32) = afn G_FCMP floatpred(oge), %lhs(f64), %rhs
    $w0 = COPY %res(i32)
...
