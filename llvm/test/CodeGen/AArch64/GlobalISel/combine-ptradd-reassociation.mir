---
name:            combine_offsets_nuw
alignment:       4
liveins:
  - { reg: '$x0' }
body:             |
  bb.1:
    liveins: $x0

    ; CHECK-LABEL: name: combine_offsets_nuw
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 11
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw G_PTR_ADD [[COPY]], [[C]](i64)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD]](p0) :: (load (s8))
    ; CHECK-NEXT: $w0 = COPY [[LOAD]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(p0) = COPY $x0
    %1:_(i64) = G_CONSTANT i64 10
    %2:_(i64) = G_CONSTANT i64 1
    %3:_(p0) = nuw G_PTR_ADD %0, %1
    %4:_(p0) = nuw G_PTR_ADD %3(p0), %2
    %7:_(i32) = G_LOAD %4(p0) :: (load 1)
    $w0 = COPY %7(i32)
    RET_ReallyLR implicit $w0

...
