    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw nusw inbounds G_PTR_ADD [[COPY]], [[COPY1]](i64)
    ; CHECK-NEXT: [[PTR_ADD1:%[0-9]+]]:_(p0) = nuw nusw inbounds G_PTR_ADD [[PTR_ADD]], [[C]](i64)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i32) = G_LOAD [[PTR_ADD1]](p0) :: (load (s8))
    ; CHECK-NEXT: $w0 = COPY [[LOAD]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(p0) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64) = G_CONSTANT i64 1
    %3:_(p0) = nuw nusw inbounds G_PTR_ADD %0, %2(i64)
    %4:_(p0) = nuw nusw inbounds G_PTR_ADD %3(p0), %1
    %7:_(i32) = G_LOAD %4(p0) :: (load 1)
