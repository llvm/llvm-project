; NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
; RUN: llc -O0 -mtriple=aarch64 -global-isel=1 -global-isel-abort=1 -verify-machineinstrs -stop-after=legalizer %s -o - | FileCheck %s

; Keep the boolean PHI narrow by passing it on the stack. Its invoke-result
; operand must be extended after the call, not before G_INVOKE_REGION_START.
target triple = "aarch64-unknown-linux-gnu"
declare i32 @personality(...)
declare void @consume(i64, i64, i64, i64, i64, i64, i64, i64, i1)
define void @invoke_result_phi(i1 %cond, ptr %callee) personality ptr @personality {
  ; CHECK-LABEL: name: invoke_result_phi
  ; CHECK: bb.1.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64(p0) = COPY $x1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i16) = G_CONSTANT i16 0
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY]], [[C2]]
  ; CHECK-NEXT:   G_BRCOND [[AND]](i32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.call:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_INVOKE_REGION_START
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   BLR [[COPY1]](p0), csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $w0
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY2]](i32)
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.merge:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(i16) = G_PHI [[C1]](i16), %bb.1, [[TRUNC]](i16), %bb.2
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[PHI]](i16)
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND1:%[0-9]+]]:_(i32) = G_AND [[ANYEXT]], [[C3]]
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(i8) = G_TRUNC [[AND1]](i32)
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 8, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:_(p0) = COPY $sp
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD [[COPY3]], [[C4]](i64)
  ; CHECK-NEXT:   G_STORE [[TRUNC1]](i8), [[PTR_ADD]](p0) :: (store (i8) into stack)
  ; CHECK-NEXT:   $x0 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x1 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x2 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x3 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x4 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x5 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x6 = COPY [[C]](i64)
  ; CHECK-NEXT:   $x7 = COPY [[C]](i64)
  ; CHECK-NEXT:   BL @consume, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit $x1, implicit $x2, implicit $x3, implicit $x4, implicit $x5, implicit $x6, implicit $x7
  ; CHECK-NEXT:   ADJCALLSTACKUP 8, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   RET_ReallyLR
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.eh (landing-pad):
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   RET_ReallyLR
entry:
  br i1 %cond, label %call, label %merge
call:
  %value = invoke i1 %callee() to label %merge unwind label %eh
merge:
  %result = phi i1 [ false, %entry ], [ %value, %call ]
  call void @consume(i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i1 %result)
  ret void
eh:
  %lp = landingpad { ptr, i32 } cleanup
  ret void
}

; The vector extension for an unwind PHI must execute even if the call throws.
declare void @callee()
define void @unwind_vector_phi(i1 %cond, ptr %src, ptr %out) personality ptr @personality {
  ; CHECK-LABEL: name: unwind_vector_phi
  ; CHECK: bb.1.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $x1, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(p0) = COPY $x1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(p0) = COPY $x2
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[LOAD:%[0-9]+]]:_(<4 x i32>) = G_LOAD [[COPY1]](p0) :: (load (<4 x i32>) from %ir.src)
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY]], [[C1]]
  ; CHECK-NEXT:   G_BRCOND [[AND]](i32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.first:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_INVOKE_REGION_START
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   BL @callee, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   G_BR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.second:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   [[BUILD_VECTOR:%[0-9]+]]:_(<4 x i32>) = G_BUILD_VECTOR [[C]](i32), [[C]](i32), [[C]](i32), [[DEF]](i32)
  ; CHECK-NEXT:   G_INVOKE_REGION_START
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   BL @callee, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def $sp, implicit $sp
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   G_BR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.done:
  ; CHECK-NEXT:   RET_ReallyLR
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.eh (landing-pad):
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(<4 x i32>) = G_PHI [[LOAD]](<4 x i32>), %bb.2, [[BUILD_VECTOR]](<4 x i32>), %bb.3
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32), [[UV2:%[0-9]+]]:_(i32), [[UV3:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[PHI]](<4 x i32>)
  ; CHECK-NEXT:   EH_LABEL <mcsymbol >
  ; CHECK-NEXT:   G_STORE [[UV]](i32), [[COPY2]](p0) :: (store (i32) into %ir.out, align 16)
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 4
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY2]], [[C2]](i64)
  ; CHECK-NEXT:   G_STORE [[UV1]](i32), [[PTR_ADD]](p0) :: (store (i32) into %ir.out + 4, basealign 16)
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(i64) = G_CONSTANT i64 8
  ; CHECK-NEXT:   [[PTR_ADD1:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY2]], [[C3]](i64)
  ; CHECK-NEXT:   G_STORE [[UV2]](i32), [[PTR_ADD1]](p0) :: (store (i32) into %ir.out + 8, align 8, basealign 16)
  ; CHECK-NEXT:   RET_ReallyLR
entry:
  %value = load <3 x i32>, ptr %src
  br i1 %cond, label %first, label %second
first:
  invoke void @callee() to label %done unwind label %eh
second:
  invoke void @callee() to label %done unwind label %eh
done:
  ret void
eh:
  %phi = phi <3 x i32> [ %value, %first ], [ zeroinitializer, %second ]
  %lp = landingpad { ptr, i32 } cleanup
  store <3 x i32> %phi, ptr %out
  ret void
}
