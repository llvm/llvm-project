# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -o - -mtriple=aarch64-unknown-unknown -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s | FileCheck %s
---
name:            test_combine_shl_undef_x_s32
body:             |
  bb.1:
  liveins: $w0
    ; CHECK-LABEL: name: test_combine_shl_undef_x_s32
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $w0 = COPY [[C]](i32)
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_IMPLICIT_DEF
    %2:_(i32) = G_SHL %1(i32), %0(i32)
    $w0 = COPY %2(i32)
...
---
name:            test_combine_shl_undef_x_v2s32
