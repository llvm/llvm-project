    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x i32>) = G_BUILD_VECTOR [[C]](i32), [[C]](i32)
    ; CHECK-NEXT: $d0 = COPY [[BUILD_VECTOR]](<2 x i32>)
    %0:_(<2 x i32>) = COPY $d0
    %1:_(<2 x i32>) = G_IMPLICIT_DEF
    %2:_(<2 x i32>) = G_SHL %1(<2 x i32>), %0(<2 x i32>)
    $d0 = COPY %2(<2 x i32>)
...
---
