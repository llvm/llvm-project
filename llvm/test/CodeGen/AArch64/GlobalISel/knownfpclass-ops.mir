  ; CHECK-NEXT: %sqrt:_ FPClasses:(nan pinf zero pnorm) SignBitKnown:?
  ; CHECK-NEXT: %neg_one:_ FPClasses:(nnorm) SignBitKnown:1
  ; CHECK-NEXT: %fdiv:_ FPClasses:(nan inf zero nsub nnorm) SignBitKnown:?
  ; CHECK-NEXT: %copy:_ FPClasses:(nan inf zero nsub nnorm) SignBitKnown:?
    %ptr:_(p0) = G_IMPLICIT_DEF
    %x:_(f32) = G_LOAD %ptr(p0) :: (load (f32))
    %neg_x:_(f32) = G_FNEG %x
    %sqrt:_(f32) = G_FSQRT %neg_x
    %neg_one:_(f32) = G_FCONSTANT float -1.0
    %fdiv:_(f32) = G_FDIV %neg_one, %sqrt
    %copy:_(f32) = COPY %fdiv
...
