# f0x35800000 is 0x1p-20, which is normal in f32 and subnormal in f16.
# RoundingMode::NearestTiesToEven is encoded as 1 in MIR.
name:            CstPosNormalFPTruncRound
body:             |
  bb.0:
  ; CHECK-LABEL: name: @CstPosNormalFPTruncRound
  ; CHECK-NEXT: %src:_ FPClasses:(pnorm) SignBitKnown:0
