  ; CHECK-NEXT: %copy:_ FPClasses:(pinf zero psub pnorm) SignBitKnown:?
    %src:_(f32) = G_FCONSTANT float f0x35800000
    %trunc:_(f16) = G_INTRINSIC_FPTRUNC_ROUND %src, 1
    %copy:_(f16) = COPY %trunc
...
