    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i16) = G_SEXT_INREG [[TRUNC]], 8
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[SEXT_INREG]](i16)
    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %1:_(i32) = COPY $w0
    %0:_(i16) = G_TRUNC %1(i32)
    %2:_(i16) = G_CONSTANT i16 8
    %3:_(i16) = G_SHL %0, %2(i16)
    %4:_(i16) = exact G_ASHR %3, %2(i16)
    %5:_(i32) = G_ANYEXT %4(i16)
    $w0 = COPY %5(i32)
    RET_ReallyLR implicit $w0

