  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr(i32) = COPY %copy1(i32)
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr(i32) = COPY %copy2(i32)
  ; CHECK-NEXT:   %cmp:gpr(i32) = G_ICMP intpred(eq), [[COPY]](i32), [[COPY1]]
  ; CHECK-NEXT:   G_BRCOND %cmp(i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %bb1_val:gpr(i32) = COPY %copy2(i32)
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.0(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %phi:fpr(i32) = G_PHI %copy1(i32), %bb.0, %bb1_val(i32), %bb.1
  ; CHECK-NEXT:   %assert_zext:fpr(i32) = G_ASSERT_ZEXT %phi, 16
  ; CHECK-NEXT:   G_BR %bb.0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $s0, $s1
    %copy1:_(i32) = COPY $s0
    %copy2:_(i32) = COPY $s1
    %cmp:_(i32) = G_ICMP intpred(eq), %copy1, %copy2
