name:            fpr_feeding_select
alignment:       4
legalized:       true
tracksRegLiveness: true
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $d0, $x1, $w0

    ; G_ASSERT_ZEXT and G_SELECT should both end up on FPRs.

    ; CHECK-LABEL: name: fpr_feeding_select
    ; CHECK: liveins: $d0, $x1, $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %w0:gpr(i32) = COPY $w0
    ; CHECK-NEXT: %fpr:fpr(i64) = COPY $d0
    ; CHECK-NEXT: %fpr_assert_zext:fpr(i64) = G_ASSERT_ZEXT %fpr, 32
    ; CHECK-NEXT: %gpr:gpr(i64) = COPY $x1
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr(i64) = COPY %gpr(i64)
    ; CHECK-NEXT: %select:fpr(i64) = G_SELECT %w0(i32), %fpr_assert_zext, [[COPY]]
    ; CHECK-NEXT: $d0 = COPY %select(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %w0:_(i32) = COPY $w0
    %fpr:_(i64) = COPY $d0
    %fpr_assert_zext:_(i64) = G_ASSERT_ZEXT %fpr, 32
    %gpr:_(i64) = COPY $x1
    %select:_(i64) = G_SELECT %w0, %fpr_assert_zext, %gpr
    $d0 = COPY %select(i64)
    RET_ReallyLR implicit $d0

