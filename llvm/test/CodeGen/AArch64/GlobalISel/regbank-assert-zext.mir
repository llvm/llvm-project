# RUN: llc -mtriple=aarch64 -run-pass=regbankselect -verify-machineinstrs %s -o - | FileCheck %s
#
# Verify register banks for G_ASSERT_ZEXT.
#

...
---
name:            gpr
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1

    ; G_ASSERT_ZEXT should end up on a GPR.

    ; CHECK-LABEL: name: gpr
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %copy:gpr(i32) = COPY $w0
    ; CHECK-NEXT: %copy_assert_zext:gpr(i32) = G_ASSERT_ZEXT %copy, 16
    ; CHECK-NEXT: $w1 = COPY %copy_assert_zext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w1
    %copy:_(i32) = COPY $w0
    %copy_assert_zext:_(i32) = G_ASSERT_ZEXT %copy(i32), 16
    $w1 = COPY %copy_assert_zext(i32)
    RET_ReallyLR implicit $w1

