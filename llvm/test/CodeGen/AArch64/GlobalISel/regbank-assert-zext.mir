---
name:            fpr_feeding_store
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $s0, $s1

    ; The G_ASSERT_ZEXT should end up on a FPR, and there should be no copy
    ; between it and the G_STORE.

    ; CHECK-LABEL: name: fpr_feeding_store
    ; CHECK: liveins: $x0, $s0, $s1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %ptr:gpr(p0) = COPY $x0
    ; CHECK-NEXT: %copy:fpr(i32) = COPY $s0
    ; CHECK-NEXT: %copy_assert_zext:fpr(i32) = G_ASSERT_ZEXT %copy, 16
    ; CHECK-NEXT: G_STORE %copy_assert_zext(i32), %ptr(p0) :: (store (i32))
    ; CHECK-NEXT: RET_ReallyLR
    %ptr:_(p0) = COPY $x0
    %copy:_(i32) = COPY $s0
    %copy_assert_zext:_(i32) = G_ASSERT_ZEXT %copy(i32), 16
    G_STORE %copy_assert_zext(i32), %ptr(p0) :: (store (i32))
    RET_ReallyLR

