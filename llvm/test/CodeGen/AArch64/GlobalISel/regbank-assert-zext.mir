    G_BR %bb.1
  bb.1:
    successors: %bb.2
    %bb1_val:_(i32) = COPY %copy2
    G_BR %bb.2
  bb.2:
    successors: %bb.0
    ; The G_PHI and G_ASSERT_ZEXT should both end up on FPRs.
    %phi:_(i32) = G_PHI %copy1, %bb.0, %bb1_val, %bb.1
    %assert_zext:_(i32) = G_ASSERT_ZEXT %phi(i32), 16
    G_BR %bb.0

