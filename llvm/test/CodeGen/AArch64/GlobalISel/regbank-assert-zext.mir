---
name:            fpr_feeding_phi
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: fpr_feeding_phi
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $s0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %copy1:fpr(i32) = COPY $s0
  ; CHECK-NEXT:   %copy2:gpr(i32) = COPY $w1
  ; CHECK-NEXT:   %copy_assert_zext:fpr(i32) = G_ASSERT_ZEXT %copy1, 16
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr(i32) = COPY %copy1(i32)
  ; CHECK-NEXT:   %cmp:gpr(i32) = G_ICMP intpred(eq), [[COPY]](i32), %copy2
  ; CHECK-NEXT:   G_BRCOND %cmp(i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %bb1_val:gpr(i32) = COPY %copy2(i32)
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.0(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %phi:fpr(i32) = G_PHI %copy_assert_zext(i32), %bb.0, %bb1_val(i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $s0, $w1
    %copy1:_(i32) = COPY $s0
    %copy2:_(i32) = COPY $w1

    ; This should produce a FPR.
    %copy_assert_zext:_(i32) = G_ASSERT_ZEXT %copy1(i32), 16

    %cmp:_(i32) = G_ICMP intpred(eq), %copy1, %copy2
    G_BRCOND %cmp, %bb.1
    G_BR %bb.1
  bb.1:
    successors: %bb.2
    %bb1_val:_(i32) = COPY %copy2
    G_BR %bb.2
  bb.2:
    successors: %bb.0
    ; This should produce a FPR.
    %phi:_(i32) = G_PHI %copy_assert_zext, %bb.0, %bb1_val, %bb.1
    G_BR %bb.0

...
