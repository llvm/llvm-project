---
name:            load_used_by_sitofp
legalized:       true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; The load should be assigned an fpr bank because it's used by the sitofp.
    ; The sitofp should assign both src and dest to FPR, resulting in no copies.
    ; CHECK-LABEL: name: load_used_by_sitofp
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(p0) = COPY $x0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:fpr(i32) = G_LOAD [[COPY]](p0) :: (load (i32))
    ; CHECK-NEXT: [[SITOFP:%[0-9]+]]:fpr(f32) = G_SITOFP [[LOAD]](i32)
    ; CHECK-NEXT: $s0 = COPY [[SITOFP]](f32)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %0:_(p0) = COPY $x0
    %1:_(i32) = G_LOAD %0 :: (load (i32))
    %2:_(f32) = G_SITOFP %1:_(i32)
    $s0 = COPY %2(f32)
    RET_ReallyLR implicit $s0
...
