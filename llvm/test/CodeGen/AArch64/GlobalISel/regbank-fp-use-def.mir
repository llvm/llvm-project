    ; CHECK-NEXT: $s0 = COPY [[UITOFP]](f32)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %0:_(p0) = COPY $x0
    %1:_(i32) = G_LOAD %0 :: (load (i32))
    %2:_(f32) = G_UITOFP %1:_(i32)
    $s0 = COPY %2(f32)
    RET_ReallyLR implicit $s0
...
