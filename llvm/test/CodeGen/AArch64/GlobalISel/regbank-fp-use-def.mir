    G_BR %bb.2
  bb.1:
    successors: %bb.2
    %unmerge_1:_(i32), %unmerge_2:_(i32) = G_UNMERGE_VALUES %unmerge_src(i64)
    G_BR %bb.2
  bb.2:
    %phi:_(i32) = G_PHI %fpr_copy(i32), %bb.0, %unmerge_1(i32), %bb.1
