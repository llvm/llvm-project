# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -O0 -mtriple arm64-- -run-pass=regbankselect %s -o - | FileCheck %s

# Check that we correctly assign register banks based off of instructions which
# only use or only define FPRs.
#
# For example, G_SITOFP may take in a GPR, but only ever produces values on FPRs.
# Some instructions can have inputs/outputs on either FPRs or GPRs. If one of
# those instructions takes in the result of a G_SITOFP as a source, we should
# put that source on a FPR.
#
# Similarly, G_FPTOSI can only take in a value on a FPR. So, if the result of
# an instruction is consumed by a G_FPTOSI, we should put the instruction on
# FPRs.

---
name:            load_only_uses_fp
legalized:       true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: load_only_uses_fp
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(p0) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:fpr(f32) = G_FCONSTANT float 2.000000e+00
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:fpr(f32) = G_LOAD [[COPY]](p0) :: (load (s32))
    ; CHECK-NEXT: [[FCMP:%[0-9]+]]:gpr(i32) = G_FCMP floatpred(uno), [[C]](f32), [[LOAD]]
    ; CHECK-NEXT: $w0 = COPY [[FCMP]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(p0) = COPY $x0
    %1:_(f32) = G_FCONSTANT float 2.0
    %2:_(f32) = G_LOAD %0 :: (load (s32))
    %3:_(i32) = G_FCMP floatpred(uno), %1, %2
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0
...
---
name:            unmerge_only_uses_fp

legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: unmerge_only_uses_fp
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(f64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr(f64) = COPY [[COPY]](f64)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:fpr(f32), [[UV1:%[0-9]+]]:fpr(f32) = G_UNMERGE_VALUES [[COPY1]](f64)
    ; CHECK-NEXT: [[FCMP:%[0-9]+]]:gpr(i32) = G_FCMP floatpred(uno), [[UV]](f32), [[UV1]]
    ; CHECK-NEXT: $w0 = COPY [[FCMP]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(f64) = COPY $x0
    %1:_(f32), %2:_(f32) = G_UNMERGE_VALUES %0(f64)
    %3:_(i32) = G_FCMP floatpred(uno), %1, %2
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0

...
---
name:            store_defined_by_fp
legalized:       true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $w1
    ; CHECK-LABEL: name: store_defined_by_fp
    ; CHECK: liveins: $x0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(p0) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(i32) = COPY $w1
    ; CHECK-NEXT: [[SITOFP:%[0-9]+]]:fpr(f32) = G_SITOFP [[COPY1]](i32)
    ; CHECK-NEXT: G_STORE [[SITOFP]](f32), [[COPY]](p0) :: (store (s32))
    %0:_(p0) = COPY $x0
    %1:_(i32) = COPY $w1
    %2:_(f32) = G_SITOFP %1
    G_STORE %2, %0 :: (store (s32))

...
---
name:            select_defined_by_fp_using_fp
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1, $w2
    ; CHECK-LABEL: name: select_defined_by_fp_using_fp
    ; CHECK: liveins: $w0, $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr(i32) = COPY $w1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr(f32) = COPY $w2
    ; CHECK-NEXT: [[SITOFP:%[0-9]+]]:fpr(f32) = G_SITOFP [[COPY1]](i32)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fpr(f32) = COPY [[COPY2]](f32)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:fpr(f32) = G_SELECT [[COPY]](i32), [[COPY3]], [[SITOFP]]
    ; CHECK-NEXT: [[FPTOSI:%[0-9]+]]:fpr(i32) = G_FPTOSI [[SELECT]](f32)
    %0:_(i32) = COPY $w0
    %2:_(i32) = COPY $w1
    %3:_(f32) = COPY $w2
    %4:_(f32) = G_SITOFP %2
    %6:_(f32) = G_SELECT %0, %3, %4
    %8:_(i32) = G_FPTOSI %6

...
---
name:            load_used_by_phi_fpr
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: load_used_by_phi_fpr
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $s0, $s1, $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %cond_wide:gpr(i32) = COPY $w0
  ; CHECK-NEXT:   %fpr_copy:fpr(i32) = COPY $s0
  ; CHECK-NEXT:   %ptr:gpr(p0) = COPY $x0
  ; CHECK-NEXT:   G_BRCOND %cond_wide(i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %load:fpr(i32) = G_LOAD %ptr(p0) :: (load (i32))
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   %phi:fpr(i32) = G_PHI %fpr_copy(i32), %bb.0, %load(i32), %bb.1
  ; CHECK-NEXT:   $s0 = COPY %phi(i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $s0
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x0, $s0, $s1, $w0, $w1
    %cond_wide:_(i32) = COPY $w0
    %fpr_copy:_(i32) = COPY $s0
    %ptr:_(p0) = COPY $x0
    G_BRCOND %cond_wide, %bb.1
    G_BR %bb.2
  bb.1:
    successors: %bb.2
    %load:_(i32) = G_LOAD %ptr(p0) :: (load (i32))
    G_BR %bb.2
  bb.2:
    %phi:_(i32) = G_PHI %fpr_copy(i32), %bb.0, %load(i32), %bb.1
    $s0 = COPY %phi(i32)
    RET_ReallyLR implicit $s0

...
