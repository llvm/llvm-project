name:            select_used_by_phi_fpr
legalized:       true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: select_used_by_phi_fpr
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $s0, $s1, $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %cond_wide:gpr(i32) = COPY $w0
  ; CHECK-NEXT:   %fpr_copy:fpr(i32) = COPY $s0
  ; CHECK-NEXT:   %gpr_copy:gpr(i32) = COPY $w1
  ; CHECK-NEXT:   G_BRCOND %cond_wide(i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:fpr(i32) = COPY %gpr_copy(i32)
  ; CHECK-NEXT:   %select:fpr(i32) = G_SELECT %cond_wide(i32), %fpr_copy, [[COPY]]
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   %phi:fpr(i32) = G_PHI %fpr_copy(i32), %bb.0, %select(i32), %bb.1
  ; CHECK-NEXT:   $w0 = COPY %phi(i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; The G_SELECT and G_PHI should end up with the same register bank.
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $s0, $s1, $w0, $w1
    %cond_wide:_(i32) = COPY $w0
    %fpr_copy:_(i32) = COPY $s0
    %gpr_copy:_(i32) = COPY $w1
    G_BRCOND %cond_wide, %bb.1
    G_BR %bb.2
  bb.1:
    successors: %bb.2
    %select:_(i32) = G_SELECT %cond_wide, %fpr_copy, %gpr_copy
    G_BR %bb.2
  bb.2:
    %phi:_(i32) = G_PHI %fpr_copy(i32), %bb.0, %select(i32), %bb.1
    $w0 = COPY %phi(i32)
    RET_ReallyLR implicit $w0

...
