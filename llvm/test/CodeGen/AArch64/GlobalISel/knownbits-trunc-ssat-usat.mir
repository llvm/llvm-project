  ; CHECK-NEXT: %0:_ KnownBits:00000000000000010001000101110000 SignBits:15 IsKnownNeverZero:1
  ; CHECK-NEXT: %1:_ KnownBits:1111111111111111 SignBits:16 IsKnownNeverZero:1
    %0:_(i32) = G_CONSTANT i32 70000
    %1:_(i16) = G_TRUNC_USAT_U %0(i32)
...
