  ; CHECK-NEXT: %2:_ KnownBits:000000000000000????????????????? SignBits:15 IsKnownNeverZero:0
  ; CHECK-NEXT: %3:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_CONSTANT i32 131071
    %2:_(i32) = G_AND %0, %1
    %3:_(i16) = G_TRUNC_USAT_U %2(i32)
...
