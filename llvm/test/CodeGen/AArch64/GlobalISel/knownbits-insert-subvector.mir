name: overwritten_src_ignored
body: |
  bb.0:
  ; CHECK-LABEL: name: @overwritten_src_ignored
  ; CHECK-NEXT: %zero:_ KnownBits:0000000000000000 SignBits:16 IsKnownNeverZero:0
  ; CHECK-NEXT: %bad0:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %bad1:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %src:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %sub:_ KnownBits:0000000000000000 SignBits:16 IsKnownNeverZero:0
  ; CHECK-NEXT: %res:_ KnownBits:0000000000000000 SignBits:16 IsKnownNeverZero:0
    %zero:_(s16) = G_CONSTANT i16 0
    %bad0:_(s16) = COPY $h0
    %bad1:_(s16) = COPY $h1

    %src:_(<4 x i16>) = G_BUILD_VECTOR %zero, %zero, %bad0, %bad1
    %sub:_(<2 x i16>) = G_BUILD_VECTOR %zero, %zero

    %res:_(<4 x i16>) = G_INSERT_SUBVECTOR %src, %sub, 2
