  bb.0:
  ; CHECK-LABEL: name: @zext_insert_subvector
  ; CHECK-NEXT: %0:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:???????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %src:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
  ; CHECK-NEXT: %sub:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
  ; CHECK-NEXT: %res:_ KnownBits:00000000???????? SignBits:8 IsKnownNeverZero:0
    %0:_(<4 x i8>) = COPY $s0
    %1:_(<2 x i8>) = COPY $h1
    %src:_(<4 x i16>) = G_ZEXT %0
    %sub:_(<2 x i16>) = G_ZEXT %1
    %res:_(<4 x i16>) = G_INSERT_SUBVECTOR %src, %sub, 2
...
