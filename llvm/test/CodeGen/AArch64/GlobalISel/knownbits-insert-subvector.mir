  ; CHECK-NEXT: %src:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %sub:_ KnownBits:0000111111111111 SignBits:4 IsKnownNeverZero:1
  ; CHECK-NEXT: %res:_ KnownBits:0000????11111111 SignBits:4 IsKnownNeverZero:1
    %srcval:_(s16) = G_CONSTANT i16 255
    %subval:_(s16) = G_CONSTANT i16 4095
    %bad0:_(s16) = COPY $h0
    %bad1:_(s16) = COPY $h1

    %src:_(<4 x i16>) = G_BUILD_VECTOR %srcval, %srcval, %bad0, %bad1
