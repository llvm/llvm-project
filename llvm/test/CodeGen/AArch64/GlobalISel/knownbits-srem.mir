---
name: srem_pow2
body: |
  bb.1:
    liveins: $w0

  ; CHECK-LABEL: name: @srem_pow2
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %1:_ KnownBits:00000000000000000000000000001000 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %2:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_CONSTANT i32 8
    %2:_(i32) = G_SREM %0, %1
    $w0 = COPY %2(i32)
    RET_ReallyLR implicit $w0
...
