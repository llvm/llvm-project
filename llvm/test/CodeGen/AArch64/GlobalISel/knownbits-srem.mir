name: knownbits_nonnegative
body: |
  bb.0:
    ; CHECK-LABEL: name: @knownbits_nonnegative
    %x:_(s32) = G_IMPLICIT_DEF
    %mask:_(s32) = G_CONSTANT i32 2147483647
    %lhs:_(s32) = G_AND %x, %mask
    ; CHECK: %{{.+}}:_ KnownBits:11111111111111111111111100000000 SignBits:24 IsKnownNeverZero:1
    %rhs:_(s32) = G_CONSTANT i32 -256
    ; CHECK-NEXT: %{{.+}}:_ KnownBits:000000000000000000000000???????? SignBits:24 IsKnownNeverZero:0
    %remainder:_(s32) = G_SREM %lhs, %rhs
