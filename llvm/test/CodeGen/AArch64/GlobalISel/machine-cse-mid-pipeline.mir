# RUN: llc -run-pass machine-cse -verify-machineinstrs -mtriple aarch64-apple-ios %s -o - | FileCheck %s
# RUN: llc -passes machine-cse -mtriple aarch64-apple-ios %s -o - | FileCheck %s
---
name:            irtranslated
legalized:       false
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: irtranslated
  ; CHECK:      %[[ONE:[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT: %[[TWO:[0-9]+]]:_(i32) = G_ADD %[[ONE]], %[[ONE]]
  ; CHECK-NEXT: %[[SUM:[0-9]+]]:_(i32) = G_ADD %[[TWO]], %[[TWO]]
  ; CHECK-NEXT: $[[RET:[wx][0-9]+]] = COPY %[[SUM]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $[[RET]]
  bb.0:
    %0:_(i32) = G_CONSTANT i32 1
    %1:_(i32) = G_ADD %0, %0
    %2:_(i32) = G_ADD %0, %0
    %3:_(i32) = G_ADD %1, %2
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0
...
---
name:            regbankselected
legalized:       true
regBankSelected: true
selected:        false
body:             |
  ; CHECK-LABEL: name: regbankselected
  ; CHECK:      %[[ONE:[0-9]+]]:gpr(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT: %[[TWO:[0-9]+]]:gpr(i32) = G_ADD %[[ONE]], %[[ONE]]
  ; CHECK-NEXT: %[[SUM:[0-9]+]]:gpr(i32) = G_ADD %[[TWO]], %[[TWO]]
  ; CHECK-NEXT: $[[RET:[wx][0-9]+]] = COPY %[[SUM]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $[[RET]]
  bb.0:
    %0:gpr(i32) = G_CONSTANT i32 1
    %1:gpr(i32) = G_ADD %0, %0
    %2:gpr(i32) = G_ADD %0, %0
    %3:gpr(i32) = G_ADD %1, %2
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0
...
---
name:            legalized
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: legalized
  ; CHECK:      %[[ONE:[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT: %[[TWO:[0-9]+]]:gpr(i32) = G_ADD %[[ONE]], %[[ONE]]
  ; CHECK-NEXT: %[[SUM:[0-9]+]]:_(i32) = G_ADD %[[TWO]], %[[TWO]]
  ; CHECK-NEXT: $[[RET:[wx][0-9]+]] = COPY %[[SUM]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $[[RET]]
  bb.0:
    %0:_(i32) = G_CONSTANT i32 1
    %1:_(i32) = G_ADD %0, %0
    %2:gpr(i32) = G_ADD %0, %0
    %3:_(i32) = G_ADD %1, %2
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0
...
---
name:            legalized_sym
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: legalized_sym
  ; CHECK:      %[[ONE:[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT: %[[TWO:[0-9]+]]:gpr(i32) = G_ADD %[[ONE]], %[[ONE]]
  ; CHECK-NEXT: %[[SUM:[0-9]+]]:_(i32) = G_ADD %[[TWO]], %[[TWO]]
  ; CHECK-NEXT: $[[RET:[wx][0-9]+]] = COPY %[[SUM]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $[[RET]]
  bb.0:
    %0:_(i32) = G_CONSTANT i32 1
    %1:gpr(i32) = G_ADD %0, %0
    %2:_(i32) = G_ADD %0, %0
    %3:_(i32) = G_ADD %1, %2
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0
...
---
name:            int_extensions
alignment:       4
legalized:       false
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: int_extensions
  ; CHECK:      %[[ONE:[0-9]+]]:_(i8) = G_CONSTANT i8 1
  ; CHECK-NEXT: %[[S16:[0-9]+]]:_(i16) = G_SEXT %[[ONE]](i8)
  ; CHECK-NEXT: %[[S32:[0-9]+]]:_(i32) = G_SEXT %[[ONE]](i8)
  ; CHECK-NEXT: %[[S16_Z64:[0-9]+]]:_(i64) = G_ZEXT %[[S16]](i16)
  ; CHECK-NEXT: %[[S32_Z64:[0-9]+]]:_(i64) = G_ZEXT %[[S32]](i32)
  ; CHECK-NEXT: %[[SUM:[0-9]+]]:_(i64) = G_ADD %[[S16_Z64]], %[[S32_Z64]]
  ; CHECK-NEXT: $[[RET:[wx][0-9]+]] = COPY %[[SUM]](i64)
  ; CHECK-NEXT: RET_ReallyLR implicit $[[RET]]
  bb.0.entry:
    %0:_(i8) = G_CONSTANT i8 1
    %1:_(i16) = G_SEXT %0(i8)
    %2:_(i32) = G_SEXT %0(i8)
    %3:_(i64) = G_ZEXT %1(i16)
    %4:_(i64) = G_ZEXT %2(i32)
    %5:_(i64) = G_ADD %3, %4
    $x0 = COPY %5(i64)
    RET_ReallyLR implicit $x0
...
---
name:            generic
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: generic
  ; CHECK:      %[[SG:[0-9]+]]:_(i32) = G_ADD %{{[0-9]+}}, %{{[0-9]+}}
  ; CHECK-NEXT: %{{[0-9]+}}:_(i32) = G_ADD %[[SG]], %[[SG]]
  bb.0:
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %2:_(i32) = G_ADD %0, %1
    %3:_(i32) = COPY %2(i32)
    %4:_(i32) = G_ADD %3, %3
    $w0 = COPY %4(i32)
    RET_ReallyLR implicit $w0
...
---
name:            generic_to_concrete_copy
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: generic_to_concrete_copy
  ; CHECK:      %[[S1:[0-9]+]]:gpr32(i32) = G_ADD %{{[0-9]+}}, %{{[0-9]+}}
  ; CHECK-NEXT: %{{[0-9]+}}:gpr32 = ADDWrr %[[S1]](i32), %[[S1]](i32)
  bb.0:
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %2:_(i32) = G_ADD %0, %1
    %3:gpr32 = COPY %2(i32)
    %4:gpr32 = ADDWrr %3, %3
    $w0 = COPY %4
    RET_ReallyLR implicit $w0
...
---
name:            concrete_to_generic_copy
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: concrete_to_generic_copy
  ; CHECK:      %[[S1:[0-9]+]]:gpr32(i32) = ADDWrr %{{[0-9]+}}, %{{[0-9]+}}
  ; CHECK-NEXT: %{{[0-9]+}}:_(i32) = G_ADD %[[S1]], %[[S1]]
  bb.0:
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = ADDWrr %0, %1
    %3:_(i32) = COPY %2
    %4:_(i32) = G_ADD %3, %3
    $w0 = COPY %4(i32)
    RET_ReallyLR implicit $w0
...
---
name:            concrete
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: concrete
  ; CHECK:      %[[SC:[0-9]+]]:gpr32 = ADDWrr %{{[0-9]+}}, %{{[0-9]+}}
  ; CHECK-NEXT: %{{[0-9]+}}:gpr32 = ADDWrr %[[SC]], %[[SC]]
  bb.0:
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = ADDWrr %0, %1
    %3:gpr32 = COPY %2
    %4:gpr32 = ADDWrr %3, %3
    $w0 = COPY %4
    RET_ReallyLR implicit $w0
...
---
name:            variadic_defs_unmerge_vector
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: variadic_defs_unmerge_vector
  ; CHECK:      [[COPY:%[0-9]+]]:_(<4 x i16>) = COPY $d0
  ; CHECK-NEXT: [[UV0:%[0-9]+]]:_(i16), [[UV1:%[0-9]+]]:_(i16), [[UV2:%[0-9]+]]:_(i16), [[UV3:%[0-9]+]]:_(i16) = G_UNMERGE_VALUES [[COPY]](<4 x i16>)
  ; CHECK-NEXT: [[ANYEXT0:%[0-9]+]]:_(i32) = G_ANYEXT [[UV0]](i16)
  ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[UV1]](i16)
  ; CHECK-NEXT: [[ANYEXT2:%[0-9]+]]:_(i32) = G_ANYEXT [[UV2]](i16)
  ; CHECK-NEXT: [[ANYEXT3:%[0-9]+]]:_(i32) = G_ANYEXT [[UV3]](i16)
  ; CHECK-NEXT: [[ADD0:%[0-9]+]]:_(i32) = G_ADD [[ANYEXT0]], [[ANYEXT1]]
  ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[ANYEXT2]], [[ANYEXT3]]
  ; CHECK-NEXT: [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[ADD0]], [[ADD1]]
  ; CHECK-NEXT: $w0 = COPY [[ADD2]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $w0
  bb.0:
    %0 :_(<4 x i16>) = COPY $d0
    %1 :_(i16), %2 :_(i16), %3 :_(i16), %4 :_(i16) = G_UNMERGE_VALUES %0(<4 x i16>)
    %5 :_(i16), %6 :_(i16), %7 :_(i16), %8 :_(i16) = G_UNMERGE_VALUES %0(<4 x i16>)
    %9 :_(i16), %10:_(i16), %11:_(i16), %12:_(i16) = G_UNMERGE_VALUES %0(<4 x i16>)
    %13:_(i16), %14:_(i16), %15:_(i16), %16:_(i16) = G_UNMERGE_VALUES %0(<4 x i16>)
    %17:_(i32) = G_ANYEXT %1 (i16)
    %18:_(i32) = G_ANYEXT %6 (i16)
    %19:_(i32) = G_ANYEXT %11(i16)
    %20:_(i32) = G_ANYEXT %16(i16)
    %21:_(i32) = G_ADD %17, %18
    %22:_(i32) = G_ADD %19, %20
    %23:_(i32) = G_ADD %21, %22
    $w0 = COPY %23(i32)
    RET_ReallyLR implicit $w0
...
---
name:            variadic_defs_unmerge_scalar
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: variadic_defs_unmerge_scalar
  ; CHECK:      [[COPY:%[0-9]+]]:_(i64) = COPY $d0
  ; CHECK-NEXT: [[UV0:%[0-9]+]]:_(i16), [[UV1:%[0-9]+]]:_(i16), [[UV2:%[0-9]+]]:_(i16), [[UV3:%[0-9]+]]:_(i16) = G_UNMERGE_VALUES [[COPY]](i64)
  ; CHECK-NEXT: [[ANYEXT0:%[0-9]+]]:_(i32) = G_ANYEXT [[UV0]](i16)
  ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[UV1]](i16)
  ; CHECK-NEXT: [[ANYEXT2:%[0-9]+]]:_(i32) = G_ANYEXT [[UV2]](i16)
  ; CHECK-NEXT: [[ANYEXT3:%[0-9]+]]:_(i32) = G_ANYEXT [[UV3]](i16)
  ; CHECK-NEXT: [[ADD0:%[0-9]+]]:_(i32) = G_ADD [[ANYEXT0]], [[ANYEXT1]]
  ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[ANYEXT2]], [[ANYEXT3]]
  ; CHECK-NEXT: [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[ADD0]], [[ADD1]]
  ; CHECK-NEXT: $w0 = COPY [[ADD2]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $w0
  bb.0:
    %0 :_(i64) = COPY $d0
    %1 :_(i16), %2 :_(i16), %3 :_(i16), %4 :_(i16) = G_UNMERGE_VALUES %0(i64)
    %5 :_(i16), %6 :_(i16), %7 :_(i16), %8 :_(i16) = G_UNMERGE_VALUES %0(i64)
    %9 :_(i16), %10:_(i16), %11:_(i16), %12:_(i16) = G_UNMERGE_VALUES %0(i64)
    %13:_(i16), %14:_(i16), %15:_(i16), %16:_(i16) = G_UNMERGE_VALUES %0(i64)
    %17:_(i32) = G_ANYEXT %1 (i16)
    %18:_(i32) = G_ANYEXT %6 (i16)
    %19:_(i32) = G_ANYEXT %11(i16)
    %20:_(i32) = G_ANYEXT %16(i16)
    %21:_(i32) = G_ADD %17, %18
    %22:_(i32) = G_ADD %19, %20
    %23:_(i32) = G_ADD %21, %22
    $w0 = COPY %23(i32)
    RET_ReallyLR implicit $w0
...
---
name:            variadic_defs_unmerge_scalar_asym
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: variadic_defs_unmerge_scalar_asym
  ; CHECK:      [[COPY:%[0-9]+]]:_(i64) = COPY $d0
  ; CHECK-NEXT: [[UV0:%[0-9]+]]:_(i16), [[UV1:%[0-9]+]]:_(i16), [[UV2:%[0-9]+]]:_(i16), [[UV3:%[0-9]+]]:_(i16) = G_UNMERGE_VALUES [[COPY]](i64)
  ; CHECK-NEXT: [[UV01:%[0-9]+]]:_(i32), [[UV23:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[COPY]](i64)
  ; CHECK-NEXT: [[ANYEXT0:%[0-9]+]]:_(i32) = G_ANYEXT [[UV0]](i16)
  ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[UV1]](i16)
  ; CHECK-NEXT: [[ADD0:%[0-9]+]]:_(i32) = G_ADD [[ANYEXT0]], [[ANYEXT1]]
  ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[UV01]], [[UV23]]
  ; CHECK-NEXT: [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[ADD0]], [[ADD1]]
  ; CHECK-NEXT: $w0 = COPY [[ADD2]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $w0
  bb.0:
    %0 :_(i64) = COPY $d0
    %1 :_(i16), %2 :_(i16), %3 :_(i16), %4 :_(i16) = G_UNMERGE_VALUES %0(i64)
    %9 :_(i32), %10:_(i32) = G_UNMERGE_VALUES %0(i64)
    %5 :_(i16), %6 :_(i16), %7 :_(i16), %8 :_(i16) = G_UNMERGE_VALUES %0(i64)
    %11:_(i32), %12:_(i32) = G_UNMERGE_VALUES %0(i64)
    %17:_(i32) = G_ANYEXT %1 (i16)
    %18:_(i32) = G_ANYEXT %6 (i16)
    %21:_(i32) = G_ADD %17, %18
    %22:_(i32) = G_ADD %9,  %12
    %23:_(i32) = G_ADD %21, %22
    $w0 = COPY %23(i32)
    RET_ReallyLR implicit $w0
...
---
name:            variadic_defs_unmerge_vector_constraints_mix
legalized:       true
regBankSelected: false
selected:        false
body:             |
  ; CHECK-LABEL: name: variadic_defs_unmerge_vector_constraints_mix
  ; CHECK:      [[COPY:%[0-9]+]]:_(<4 x i32>) = COPY $q0
  ; CHECK-NEXT: [[UV0:%[0-9]+]]:gpr(i32), [[UV1:%[0-9]+]]:gpr(i32), [[UV2:%[0-9]+]]:gpr32(i32), [[UV3:%[0-9]+]]:gpr32(i32) = G_UNMERGE_VALUES [[COPY]](<4 x i32>)
  ; CHECK-NEXT: [[ADD0:%[0-9]+]]:_(i32) = G_ADD [[UV0]], [[UV1]]
  ; CHECK-NEXT: [[ADD1:%[0-9]+]]:gpr32(i32) = ADDWrr [[UV2]](i32), [[UV3]](i32)
  ; CHECK-NEXT: [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[ADD0]], [[ADD1]]
  ; CHECK-NEXT: $w0 = COPY [[ADD2]](i32)
  ; CHECK-NEXT: RET_ReallyLR implicit $w0
  bb.0:
    %0 :_(<4 x i32>) = COPY $q0
    %1 :_(i32), %2 : _ (i32), %3 :_(i32), %4 :  _  (i32) = G_UNMERGE_VALUES %0(<4 x i32>)
    %5 :_(i32), %6 :gpr(i32), %7 :_(i32), %8 :  _  (i32) = G_UNMERGE_VALUES %0(<4 x i32>)
    %9 :_(i32), %10: _ (i32), %11:_(i32), %12:  _  (i32) = G_UNMERGE_VALUES %0(<4 x i32>)
    %13:_(i32), %14: _ (i32), %15:_(i32), %16:gpr32(i32) = G_UNMERGE_VALUES %0(<4 x i32>)
    %21:gpr(i32) = COPY %1(i32)
    %17:_(i32) = G_ADD %21, %6
    %18:gpr32 = COPY %11(i32)
    %19:gpr32(i32) = ADDWrr %18, %16
    %20:_(i32) = G_ADD %17, %19
    $w0 = COPY %20(i32)
    RET_ReallyLR implicit $w0
...
