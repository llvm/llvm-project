---
name:  test_unmerge_s4_constant
body: |
  bb.0:
    ; CHECK-O0-LABEL: name: test_unmerge_s4_constant
    ; CHECK-O0: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-O0-NEXT: $x0 = COPY [[C]](i64)
    ;
    ; CHECK-O2-LABEL: name: test_unmerge_s4_constant
    ; CHECK-O2: [[C:%[0-9]+]]:_(i8) = G_CONSTANT i8 0
    ; CHECK-O2-NEXT: [[TRUNC:%[0-9]+]]:_(i4) = G_TRUNC [[C]](i8)
    ; CHECK-O2-NEXT: [[COPY:%[0-9]+]]:_(i4) = COPY [[TRUNC]](i4)
    ; CHECK-O2-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-O2-NEXT: $x0 = COPY [[C1]](i64)
    %0:_(i8) = G_CONSTANT i8 0
    %1:_(i4), %2:_(i4)= G_UNMERGE_VALUES %0
    %3:_(i64) = G_ANYEXT %1
    $x0 = COPY %3

...

---
name:  test_unmerge_s4
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: test_unmerge_s4
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i8), [[UV1:%[0-9]+]]:_(i8), [[UV2:%[0-9]+]]:_(i8), [[UV3:%[0-9]+]]:_(i8) = G_UNMERGE_VALUES [[COPY]](i32)
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i32) = G_ZEXT [[UV]](i8)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 4
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR [[ZEXT]], [[C]](i64)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[UV]](i8)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i64) = G_ANYEXT [[LSHR]](i32)
    ; CHECK-NEXT: $x0 = COPY [[ANYEXT]](i64)
    ; CHECK-NEXT: $x1 = COPY [[ANYEXT1]](i64)
    %0:_(i32) = COPY $w0
    %1:_(i8) = G_TRUNC %0
    %2:_(i4), %3:_(i4)= G_UNMERGE_VALUES %1
    %4:_(i64) = G_ANYEXT %2
    %5:_(i64) = G_ANYEXT %3
    $x0 = COPY %4
    $x1 = COPY %5

...

---
name:  test_unmerge_unmerge_s64
body: |
  bb.0:
    liveins: $x0,$d0,$d1,$d2
    ; CHECK-LABEL: name: test_unmerge_unmerge_s64
    ; CHECK: liveins: $x0, $d0, $d1, $d2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: $x0 = COPY [[COPY]](i64)
    ; CHECK-NEXT: $x1 = COPY [[COPY]](i64)
    ; CHECK-NEXT: $x2 = COPY [[COPY]](i64)
    %0:_(i64) = COPY $x0
    %1:_(<3 x i64>) = G_BUILD_VECTOR %0:_(i64), %0:_(i64), %0:_(i64)
    %2:_(i64), %3:_(i64), %4:_(i64) = G_UNMERGE_VALUES %1:_(<3 x i64>)
    $x0 = COPY %2:_(i64)
    $x1 = COPY %3:_(i64)
    $x2 = COPY %3:_(i64)

...

