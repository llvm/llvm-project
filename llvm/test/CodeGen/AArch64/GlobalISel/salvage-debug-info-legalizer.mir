# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -global-isel=1 -O0 -run-pass=legalizer -mtriple=aarch64-- %s -o - | FileCheck %s

--- |
  define void @f(i16 %arg) !dbg !6 { ret void }

  !llvm.dbg.cu = !{!2}
  !llvm.module.flags = !{!10, !11}

  !2 = distinct !DICompileUnit(language: DW_LANG_C, file: !3, producer: "clang", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)
  !3 = !DIFile(filename: "t.c", directory: "/")
  !6 = distinct !DISubprogram(name: "f", scope: !3, file: !3, line: 1, type: !8, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !2, retainedNodes: !24)
  !7 = !DIBasicType(name: "short", size: 16, encoding: DW_ATE_signed)
  !8 = !DISubroutineType(types: !23)
  !10 = !{i32 7, !"Dwarf Version", i32 4}
  !11 = !{i32 2, !"Debug Info Version", i32 3}
  !23 = !{!7}
  !24 = !{}
  !25 = !DILocalVariable(name: "arg", scope: !6, file: !3, line: 1, type: !7)
...
---
# Check that we salvage debug information for a G_TRUNC erased by the
# artifact combiner in the Legalizer pass.
name:            f
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: f
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %arg:_(i32) = COPY $w0
    ; CHECK-NEXT: DBG_VALUE %arg(i32), $noreg, !9, !DIExpression(DW_OP_LLVM_convert, 32, DW_ATE_unsigned, DW_OP_LLVM_convert, 16, DW_ATE_unsigned, DW_OP_stack_value), debug-location !DILocation(line: 1, column: 1, scope: !4)
    ; CHECK-NEXT: $w0 = COPY %arg(i32)
    %arg:_(i32) = COPY $w0
    %trunc:_(i16) = G_TRUNC %arg:_(i32)
    DBG_VALUE %trunc:_(i16), $noreg, !25, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !6)
    %ext:_(i32) = G_ANYEXT %trunc:_(i16)
    $w0 = COPY %ext:_(i32)
...
