    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %res(i16)
    ; CHECK-NEXT: $w0 = COPY %ext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i64) = COPY $x0
    %c:_(i64) = G_CONSTANT i64 4294901760
    %wide:_(i64) = G_OR %x, %c
    %mid:_(i32) = G_TRUNC %wide(i64)
    %res:_(i16) = G_TRUNC %mid(i32)
    %ext:_(i32) = G_ZEXT %res(i16)
    $w0 = COPY %ext(i32)
    RET_ReallyLR implicit $w0
...

