name: select_shared_constant_bypass
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $w2
    ; CHECK-LABEL: name: select_shared_constant_bypass
    ; CHECK: liveins: $x0, $x1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: %y:_(i64) = COPY $x1
    ; CHECK-NEXT: %condwide:_(i32) = COPY $w2
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %condwide(i32)
    ; CHECK-NEXT: %high:_(i64) = G_CONSTANT i64 256
    ; CHECK-NEXT: %low:_(i64) = G_CONSTANT i64 255
    ; CHECK-NEXT: %a:_(i64) = G_OR %x, %high
    ; CHECK-NEXT: %b:_(i64) = G_AND %y, %low
    ; CHECK-NEXT: %sel:_(i64) = G_SELECT %cond(i1), %x, %y
    ; CHECK-NEXT: %res:_(i8) = G_TRUNC %sel(i64)
    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %res(i8)
    ; CHECK-NEXT: $w0 = COPY %ext(i32)
    ; CHECK-NEXT: $x1 = COPY %a(i64)
    ; CHECK-NEXT: $x2 = COPY %b(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0, implicit $x1, implicit $x2
    %x:_(i64) = COPY $x0
    %y:_(i64) = COPY $x1
    %condwide:_(i32) = COPY $w2
    %cond:_(i1) = G_TRUNC %condwide(i32)
    %high:_(i64) = G_CONSTANT i64 256
    %low:_(i64) = G_CONSTANT i64 255
    %a:_(i64) = G_OR %x, %high
    %b:_(i64) = G_AND %y, %low
    %sel:_(i64) = G_SELECT %cond(i1), %a, %b
    %res:_(i8) = G_TRUNC %sel(i64)
    %ext:_(i32) = G_ZEXT %res(i8)
    $w0 = COPY %ext(i32)
    $x1 = COPY %a(i64)
    $x2 = COPY %b(i64)
    RET_ReallyLR implicit $w0, implicit $x1, implicit $x2
...

# The shared XOR is reached at depth 5; its constant must remain visible.
---
name: select_shared_xor_at_depth_limit
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $w2
    ; CHECK-LABEL: name: select_shared_xor_at_depth_limit
    ; CHECK: liveins: $x0, $x1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: %y:_(i64) = COPY $x1
    ; CHECK-NEXT: %cw:_(i32) = COPY $w2
    ; CHECK-NEXT: %cond:_(i1) = G_TRUNC %cw(i32)
    ; CHECK-NEXT: %high:_(i64) = G_CONSTANT i64 256
    ; CHECK-NEXT: %a:_(i64) = G_XOR %x, %high
    ; CHECK-NEXT: %s1:_(i64) = G_SELECT %cond(i1), %x, %y
    ; CHECK-NEXT: %s2:_(i64) = G_SELECT %cond(i1), %s1, %y
    ; CHECK-NEXT: %s3:_(i64) = G_SELECT %cond(i1), %s2, %y
    ; CHECK-NEXT: %s4:_(i64) = G_SELECT %cond(i1), %s3, %y
    ; CHECK-NEXT: %res:_(i8) = G_TRUNC %s4(i64)
    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %res(i8)
    ; CHECK-NEXT: $w0 = COPY %ext(i32)
    ; CHECK-NEXT: $x1 = COPY %a(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0, implicit $x1
    %x:_(i64) = COPY $x0
    %y:_(i64) = COPY $x1
    %cw:_(i32) = COPY $w2
    %cond:_(i1) = G_TRUNC %cw(i32)
    %high:_(i64) = G_CONSTANT i64 256
    %a:_(i64) = G_XOR %x, %high
    %s1:_(i64) = G_SELECT %cond(i1), %a, %y
    %s2:_(i64) = G_SELECT %cond(i1), %s1, %y
    %s3:_(i64) = G_SELECT %cond(i1), %s2, %y
    %s4:_(i64) = G_SELECT %cond(i1), %s3, %y
    %res:_(i8) = G_TRUNC %s4(i64)
    %ext:_(i32) = G_ZEXT %res(i8)
    $w0 = COPY %ext(i32)
    $x1 = COPY %a(i64)
    RET_ReallyLR implicit $w0, implicit $x1
...
