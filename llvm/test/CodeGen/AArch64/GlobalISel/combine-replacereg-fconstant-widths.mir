    ; CHECK-LABEL: name: uitofp_zero_f64
    ; CHECK: liveins: $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f64) = G_FCONSTANT double 0.000000e+00
    ; CHECK-NEXT: $d0 = COPY [[C]](f64)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %a:_(i32) = G_CONSTANT i32 0
    %res:_(f64) = G_UITOFP %a
    $d0 = COPY %res(f64)
