body:             |
  bb.1.entry:
    liveins: $q0

    ; CHECK-LABEL: name: uitofp_zero_f128
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f128) = G_FCONSTANT fp128 0.000000e+00
    ; CHECK-NEXT: $q0 = COPY [[C]](f128)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %a:_(i32) = G_CONSTANT i32 0
