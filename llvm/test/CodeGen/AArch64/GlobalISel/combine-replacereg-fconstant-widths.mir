body:             |
  bb.1.entry:
    liveins: $h0

    ; CHECK-LABEL: name: sitofp_zero_f16
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f16) = G_FCONSTANT half 0.000000e+00
    ; CHECK-NEXT: $h0 = COPY [[C]](f16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %a:_(i32) = G_CONSTANT i32 0
    %res:_(f16) = G_SITOFP %a
    $h0 = COPY %res(f16)
    RET_ReallyLR implicit $h0

...
