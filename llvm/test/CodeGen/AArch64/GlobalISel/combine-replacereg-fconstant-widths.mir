    ; CHECK-NEXT: $s0 = COPY [[C]](f32)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %a:_(i32) = G_CONSTANT i32 0
    %res:_(f32) = G_UITOFP %a
