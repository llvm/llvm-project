# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Exercises GIReplaceRegWithFConstant (via the itof_const_zero_fold_* and
# undef_to_fp_zero combine rules) across scalar and vector float widths, to
# make sure the runtime GIR_BuildFConstant handler reconstructs the correct
# IEEE bit pattern (and splat, for fixed vectors) for each destination type.

---
name:            uitofp_zero_f16
liveins:
  - { reg: '$h0' }
body:             |
  bb.1.entry:
    liveins: $h0

    ; CHECK-LABEL: name: uitofp_zero_f16
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f16) = G_FCONSTANT half 0.000000e+00
    ; CHECK-NEXT: $h0 = COPY [[C]](f16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %a:_(i32) = G_CONSTANT i32 0
    %res:_(f16) = G_UITOFP %a
    $h0 = COPY %res(f16)
    RET_ReallyLR implicit $h0

...
---
name:            sitofp_zero_f16
liveins:
