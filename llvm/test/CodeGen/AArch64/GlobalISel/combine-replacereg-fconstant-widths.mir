    $q0 = COPY %res(f128)
    RET_ReallyLR implicit $q0

...
---
name:            undef_uitofp_zero_f16
alignment:       4
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: undef_uitofp_zero_f16
    ; CHECK: [[C:%[0-9]+]]:_(f16) = G_FCONSTANT half 0.000000e+00
    ; CHECK-NEXT: $h0 = COPY [[C]](f16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %0:_(i32) = G_IMPLICIT_DEF
    %1:_(f16) = G_UITOFP %0(i32)
    $h0 = COPY %1(f16)
    RET_ReallyLR implicit $h0

...
