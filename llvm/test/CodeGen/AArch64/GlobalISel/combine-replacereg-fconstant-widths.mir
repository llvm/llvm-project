    ; CHECK-NEXT: $d0 = COPY [[BUILD_VECTOR]](<2 x f32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %0:_(<2 x i32>) = G_IMPLICIT_DEF
    %1:_(<2 x f32>) = G_UITOFP %0(<2 x i32>)
    $d0 = COPY %1(<2 x f32>)
    RET_ReallyLR implicit $d0

...
