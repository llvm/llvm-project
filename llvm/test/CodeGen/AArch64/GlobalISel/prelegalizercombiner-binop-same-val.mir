name:            or_same
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0

    ; Fold: x or x -> x
    ; CHECK-LABEL: name: or_same
    ; CHECK: liveins: $x0
    ; CHECK: %copy:_(i64) = COPY $x0
    ; CHECK: $x0 = COPY %copy(i64)
    ; CHECK: RET_ReallyLR implicit $x0
    %copy:_(i64) = COPY $x0
    %or:_(i64) = G_OR %copy, %copy
    $x0 = COPY %or(i64)
    RET_ReallyLR implicit $x0

...
