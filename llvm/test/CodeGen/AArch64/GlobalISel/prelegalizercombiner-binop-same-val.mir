    ; CHECK-NEXT: $x0 = COPY %or(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %copy1:_(i64) = COPY $x0
    %copy2:_(i64) = COPY $x1
    %or:_(i64) = G_OR %copy1, %copy2
    %same_as_or:_(i64) = COPY %or(i64)
    %and:_(i64) = G_AND %or, %same_as_or
    $x0 = COPY %and(i64)
    RET_ReallyLR implicit $x0

