name:            isnan_32
liveins:
body:             |
  bb.0:
    ; CHECK-LABEL: name: isnan_32
    ; CHECK: [[COPY:%[0-9]+]]:_(f32) = COPY $w0
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i32) = G_BITCAST [[COPY]](f32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 2147483647
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 2139095040
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[BITCAST]], [[C]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[AND]](i32), [[C1]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[C2]], [[ICMP]]
    ; CHECK-NEXT: $w0 = COPY [[OR]](i32)
    %0:_(f32) = COPY $w0
    %1:_(i1) = nofpexcept G_IS_FPCLASS %0(f32), 3
    %2:_(i32) = G_ANYEXT %1(i1)
    $w0 = COPY %2(i32)
...
