    %a:_(i64) = COPY $x0
    %b:_(i64) = COPY $x1
    %c:_(i64) = COPY $x2
    %sub1:_(i64) = G_SUB %b, %c
    %sub2:_(i64) = G_SUB %a, %sub1
    %mul:_(i64) = G_MUL %sub2, %sub1
    $x0 = COPY %mul
    RET_ReallyLR implicit $x0

