# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -O0 -mtriple aarch64-- -run-pass=instruction-select %s -o - | FileCheck %s

# Check that debug users of a G_SUB 0, x erased during instruction selection
# are salvaged as a negation of x.

--- |
  define void @neg_folded_into_cmn() { ret void }
  define void @neg_dead() { ret void }
  define void @neg_dead_i64() { ret void }
  define void @neg_complex_expr() { ret void }
  define void @neg_list() { ret void }
  define void @sub_nonzero_lhs() { ret void }
  define void @sub_reg_lhs() { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "llvm", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2)
  !1 = !DIFile(filename: "test.ll", directory: "/tmp")
  !2 = !{}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !6 = !DISubroutineType(types: !2)
  !7 = !DILocalVariable(name: "v", scope: !5, file: !1, line: 1, type: !8)
  !8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !9 = !DILocation(line: 1, column: 1, scope: !5)
...
---
name:            neg_folded_into_cmn
legalized:       true
regBankSelected: true
body: |
  bb.0:
    liveins: $w1, $w2
    ; CHECK-LABEL: name: neg_folded_into_cmn
    ; CHECK: liveins: $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w2
    ; CHECK-NEXT: DBG_VALUE [[COPY]], $noreg, !4, !DIExpression(DW_OP_neg, DW_OP_stack_value), debug-location !DILocation(line: 1, column: 1, scope: !5)
    ; CHECK-NEXT: [[ADDSWrr:%[0-9]+]]:gpr32 = ADDSWrr [[COPY1]], [[COPY]], implicit-def $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: $w0 = COPY [[CSINCWr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr(i32) = COPY $w1
    %1:gpr(i32) = COPY $w2
    %2:gpr(i32) = G_CONSTANT i32 0
    %3:gpr(i32) = G_SUB %2, %0
    DBG_VALUE %3(i32), $noreg, !7, !DIExpression(), debug-location !9
    %4:gpr(i32) = G_ICMP intpred(eq), %1(i32), %3
    $w0 = COPY %4(i32)
    RET_ReallyLR implicit $w0
...
---
name:            neg_dead
legalized:       true
regBankSelected: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: neg_dead
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $w0, $noreg, !4, !DIExpression(DW_OP_neg, DW_OP_stack_value), debug-location !DILocation(line: 1, column: 1, scope: !5)
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr(i32) = COPY $w0
    %1:gpr(i32) = G_CONSTANT i32 0
    %2:gpr(i32) = G_SUB %1, %0
    DBG_VALUE %2(i32), $noreg, !7, !DIExpression(), debug-location !9
    RET_ReallyLR
...
