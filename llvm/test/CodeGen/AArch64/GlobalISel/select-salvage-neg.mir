    %1:gpr(i32) = COPY $w1
    %2:gpr(i32) = G_CONSTANT i32 0
    %3:gpr(i32) = G_SUB %2, %0
    DBG_VALUE_LIST !7, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), %3(i32), %1(i32), debug-location !9
