# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -o - -mtriple=aarch64-unknown-unknown -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs  %s | FileCheck %s
---
name:            test_combine_anyext_trunc
body:             |
  bb.1:
  liveins: $x0
    ; CHECK-LABEL: name: test_combine_anyext_trunc
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: $x1 = COPY [[COPY]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i32) = G_TRUNC %0(i64)
    %2:_(i64) = G_ANYEXT %1(i32)
    $x1 = COPY %2(i64)
...
---
name:            test_combine_anyext_trunc_with_hint
body:             |
  bb.1:
  liveins: $x0
    ; CHECK-LABEL: name: test_combine_anyext_trunc_with_hint
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: $x1 = COPY [[COPY]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i32) = G_TRUNC %0(i64)
    %2:_(i32) = G_ASSERT_ZEXT %1(i32), 11
    %3:_(i64) = G_ANYEXT %2(i32)
    $x1 = COPY %3(i64)
...
---
name:            test_combine_anyext_trunc_vec
body:             |
  bb.1:
  liveins: $q0
