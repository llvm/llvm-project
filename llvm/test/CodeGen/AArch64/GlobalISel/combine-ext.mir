    %0:_(<2 x i64>) = COPY $q0
    %1:_(<2 x i32>) = G_TRUNC %0(<2 x i64>)
    %2:_(<2 x i64>) = G_ANYEXT %1(<2 x i32>)
    $q0 = COPY %2(<2 x i64>)
...
