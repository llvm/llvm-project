# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -O0 -mtriple=aarch64 -run-pass=legalizer %s -o - | FileCheck %s
---
name:            test_div
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_div
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i32) = G_SEXT_INREG [[TRUNC]], 8
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(i32) = G_TRUNC [[COPY1]](i64)
    ; CHECK-NEXT: [[SEXT_INREG1:%[0-9]+]]:_(i32) = G_SEXT_INREG [[TRUNC1]], 8
    ; CHECK-NEXT: [[SDIV:%[0-9]+]]:_(i32) = G_SDIV [[SEXT_INREG]], [[SEXT_INREG1]]
    ; CHECK-NEXT: $w0 = COPY [[SDIV]](i32)
    ; CHECK-NEXT: [[TRUNC2:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[TRUNC2]], [[C]]
    ; CHECK-NEXT: [[TRUNC3:%[0-9]+]]:_(i32) = G_TRUNC [[COPY1]](i64)
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[TRUNC3]], [[C]]
    ; CHECK-NEXT: [[UDIV:%[0-9]+]]:_(i32) = G_UDIV [[AND]], [[AND1]]
    ; CHECK-NEXT: $w0 = COPY [[UDIV]](i32)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i8) = G_TRUNC %0(i64)
    %3:_(i8) = G_TRUNC %1(i64)
    %4:_(i8) = G_SDIV %2, %3
    %6:_(i32) = G_ANYEXT %4(i8)
    $w0 = COPY %6(i32)
    %5:_(i8) = G_UDIV %2, %3
    %7:_(i32) = G_ANYEXT %5(i8)
    $w0 = COPY %7(i32)

...
---
name:            sdiv_v4s32
alignment:       4
tracksRegLiveness: true
machineFunctionInfo: {}
body:             |
  bb.1:
    liveins: $q0, $q1

    ; CHECK-LABEL: name: sdiv_v4s32
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<4 x i32>) = COPY $q0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<4 x i32>) = COPY $q1
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32), [[UV2:%[0-9]+]]:_(i32), [[UV3:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[COPY]](<4 x i32>)
    ; CHECK-NEXT: [[UV4:%[0-9]+]]:_(i32), [[UV5:%[0-9]+]]:_(i32), [[UV6:%[0-9]+]]:_(i32), [[UV7:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[COPY1]](<4 x i32>)
    ; CHECK-NEXT: [[SDIV:%[0-9]+]]:_(i32) = G_SDIV [[UV]], [[UV4]]
    ; CHECK-NEXT: [[SDIV1:%[0-9]+]]:_(i32) = G_SDIV [[UV1]], [[UV5]]
    ; CHECK-NEXT: [[SDIV2:%[0-9]+]]:_(i32) = G_SDIV [[UV2]], [[UV6]]
    ; CHECK-NEXT: [[SDIV3:%[0-9]+]]:_(i32) = G_SDIV [[UV3]], [[UV7]]
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<4 x i32>) = G_BUILD_VECTOR [[SDIV]](i32), [[SDIV1]](i32), [[SDIV2]](i32), [[SDIV3]](i32)
    ; CHECK-NEXT: $q0 = COPY [[BUILD_VECTOR]](<4 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(<4 x i32>) = COPY $q0
    %1:_(<4 x i32>) = COPY $q1
    %2:_(<4 x i32>) = G_SDIV %0, %1
    $q0 = COPY %2(<4 x i32>)
    RET_ReallyLR implicit $q0

...
