# Transform unmerge(zext) into zext.
# In that test, the source of the zext is same size as the first definition
# of the unmerge. Therefore a we can just reuse the input of the zext for
# this definition.
---
name:            test_combine_unmerge_zext_to_zext_same_size
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_zext_to_zext_same_size
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $w0 = COPY [[COPY]](i32)
    ; CHECK-NEXT: $w1 = COPY [[C]](i32)
    %0:_(i32) = COPY $w0
    %3:_(i64) = G_ZEXT %0(i32)
    %1:_(i32),%2:_(i32) = G_UNMERGE_VALUES %3(i64)
    $w0 = COPY %1(i32)
    $w1 = COPY %2(i32)
...

# Transform unmerge(zext) into zext.
# In that test, the source of the zext is smaller than the first definition
# of the unmerge. Therefore a G_ZEXT is required.
---
name:            test_combine_unmerge_zext_to_zext
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_zext_to_zext
    ; CHECK: [[COPY:%[0-9]+]]:_(i8) = COPY $b0
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i16) = G_ZEXT [[COPY]](i8)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 0
    ; CHECK-NEXT: $h0 = COPY [[ZEXT]](i16)
    ; CHECK-NEXT: $h1 = COPY [[C]](i16)
    ; CHECK-NEXT: $h2 = COPY [[C]](i16)
    ; CHECK-NEXT: $h3 = COPY [[C]](i16)
    %0:_(i8) = COPY $b0
    %3:_(i64) = G_ZEXT %0(i8)
    %1:_(i16),%2:_(i16),%4:_(i16),%5:_(i16) = G_UNMERGE_VALUES %3(i64)
    $h0 = COPY %1(i16)
    $h1 = COPY %2(i16)
    $h2 = COPY %4(i16)
    $h3 = COPY %5(i16)
...

# Check that we don't apply the unmerge(zext) to zext transformation
# when the first destination of the unmerge is smaller than the source
# of the zext.
---
name:            test_dont_combine_unmerge_zext_to_zext_src_bigger
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_dont_combine_unmerge_zext_to_zext_src_bigger
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i64) = G_ZEXT [[COPY]](i32)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i16), [[UV1:%[0-9]+]]:_(i16), [[UV2:%[0-9]+]]:_(i16), [[UV3:%[0-9]+]]:_(i16) = G_UNMERGE_VALUES [[ZEXT]](i64)
    ; CHECK-NEXT: $h0 = COPY [[UV]](i16)
    ; CHECK-NEXT: $h1 = COPY [[UV1]](i16)
    ; CHECK-NEXT: $h2 = COPY [[UV2]](i16)
    ; CHECK-NEXT: $h3 = COPY [[UV3]](i16)
    %0:_(i32) = COPY $w0
    %3:_(i64) = G_ZEXT %0(i32)
    %1:_(i16),%2:_(i16),%4:_(i16),%5:_(i16) = G_UNMERGE_VALUES %3(i64)
    $h0 = COPY %1(i16)
    $h1 = COPY %2(i16)
    $h2 = COPY %4(i16)
    $h3 = COPY %5(i16)
...

# Check that we don't apply the unmerge(zext) to zext transformation
# when the input zext deals with a vector type.
---
name:            test_dont_combine_unmerge_zext_to_zext_src_vector
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_dont_combine_unmerge_zext_to_zext_src_vector
    ; CHECK: [[COPY:%[0-9]+]]:_(<2 x i16>) = COPY $w0
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(<2 x i32>) = G_ZEXT [[COPY]](<2 x i16>)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[ZEXT]](<2 x i32>)
    ; CHECK-NEXT: $w0 = COPY [[UV]](i32)
    ; CHECK-NEXT: $w1 = COPY [[UV1]](i32)
    %0:_(<2 x i16>) = COPY $w0
    %3:_(<2 x i32>) = G_ZEXT %0(<2 x i16>)
    %1:_(i32),%2:_(i32) = G_UNMERGE_VALUES %3(<2 x i32>)
    $w0 = COPY %1(i32)
    $w1 = COPY %2(i32)
...

# Check that we unmerge the build vector on the anyext
---
name:            test_anyext_buildvector
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_anyext_buildvector
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[COPY]](i32)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i64) = G_ANYEXT [[COPY1]](i32)
    ; CHECK-NEXT: %un1:_(<2 x i64>) = G_BUILD_VECTOR [[ANYEXT]](i64), [[ANYEXT1]](i64)
    ; CHECK-NEXT: [[ANYEXT2:%[0-9]+]]:_(i64) = G_ANYEXT [[COPY2]](i32)
    ; CHECK-NEXT: [[ANYEXT3:%[0-9]+]]:_(i64) = G_ANYEXT [[COPY3]](i32)
    ; CHECK-NEXT: %un2:_(<2 x i64>) = G_BUILD_VECTOR [[ANYEXT2]](i64), [[ANYEXT3]](i64)
    ; CHECK-NEXT: $q0 = COPY %un1(<2 x i64>)
    ; CHECK-NEXT: $q1 = COPY %un2(<2 x i64>)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w0
    %2:_(i32) = COPY $w0
    %3:_(i32) = COPY $w0
    %bv:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    %any:_(<4 x i64>) = G_ANYEXT %bv(<4 x i32>)
    %un1:_(<2 x i64>), %un2:_(<2 x i64>) = G_UNMERGE_VALUES %any(<4 x i64>)
    $q0 = COPY %un1(<2 x i64>)
    $q1 = COPY %un2(<2 x i64>)
...

# Check that we unmerge the build vector on the anyext and undef
---
name:            test_anyext_buildvector_undef
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_anyext_buildvector_undef
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[COPY]](i32)
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i64) = G_ANYEXT [[COPY1]](i32)
    ; CHECK-NEXT: %un1:_(<2 x i64>) = G_BUILD_VECTOR [[ANYEXT]](i64), [[ANYEXT1]](i64)
    ; CHECK-NEXT: %un2:_(<2 x i64>) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $q0 = COPY %un1(<2 x i64>)
    ; CHECK-NEXT: $q1 = COPY %un2(<2 x i64>)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w0
    %2:_(i32) = G_IMPLICIT_DEF
    %3:_(i32) = G_IMPLICIT_DEF
    %bv:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    %any:_(<4 x i64>) = G_ANYEXT %bv(<4 x i32>)
    %un1:_(<2 x i64>), %un2:_(<2 x i64>) = G_UNMERGE_VALUES %any(<4 x i64>)
    $q0 = COPY %un1(<2 x i64>)
    $q1 = COPY %un2(<2 x i64>)
...

# Check that we don't unmerge the build vector on the anyext, multi-use
---
name:            test_anyext_buildvector_multi
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_anyext_buildvector_multi
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %bv:_(<4 x i32>) = G_BUILD_VECTOR [[COPY]](i32), [[COPY1]](i32), [[DEF]](i32), [[DEF1]](i32)
    ; CHECK-NEXT: %any:_(<4 x i64>) = G_ANYEXT %bv(<4 x i32>)
    ; CHECK-NEXT: %un1:_(<2 x i64>), %un2:_(<2 x i64>) = G_UNMERGE_VALUES %any(<4 x i64>)
    ; CHECK-NEXT: $q0 = COPY %un1(<2 x i64>)
    ; CHECK-NEXT: $q1 = COPY %un2(<2 x i64>)
    ; CHECK-NEXT: $q2 = COPY %bv(<4 x i32>)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w0
    %2:_(i32) = G_IMPLICIT_DEF
    %3:_(i32) = G_IMPLICIT_DEF
    %bv:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    %any:_(<4 x i64>) = G_ANYEXT %bv(<4 x i32>)
    %un1:_(<2 x i64>), %un2:_(<2 x i64>) = G_UNMERGE_VALUES %any(<4 x i64>)
    $q0 = COPY %un1(<2 x i64>)
    $q1 = COPY %un2(<2 x i64>)
    $q2 = COPY %bv(<4 x i32>)
...

# Check that we don't unmerge the build vector on the anyext into scalar
---
name:            test_anyext_buildvector_scalar
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_anyext_buildvector_scalar
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: %bv:_(<4 x i32>) = G_BUILD_VECTOR [[COPY]](i32), [[COPY1]](i32), [[COPY2]](i32), [[COPY3]](i32)
    ; CHECK-NEXT: %any:_(<4 x i64>) = G_ANYEXT %bv(<4 x i32>)
    ; CHECK-NEXT: %un1:_(i128), %un2:_(i128) = G_UNMERGE_VALUES %any(<4 x i64>)
    ; CHECK-NEXT: $q0 = COPY %un1(i128)
    ; CHECK-NEXT: $q1 = COPY %un2(i128)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w0
    %2:_(i32) = COPY $w0
    %3:_(i32) = COPY $w0
    %bv:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    %any:_(<4 x i64>) = G_ANYEXT %bv(<4 x i32>)
    %un1:_(i128), %un2:_(i128) = G_UNMERGE_VALUES %any(<4 x i64>)
    $q0 = COPY %un1(i128)
    $q1 = COPY %un2(i128)
...

# Check that we anyext the merge
---
name:            test_merge_undef
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_merge_undef
    ; CHECK: %opaque:_(i64) = COPY $x0
    ; CHECK-NEXT: %me:_(i128) = G_ANYEXT %opaque(i64)
    ; CHECK-NEXT: $q0 = COPY %me(i128)
    %opaque:_(i64) = COPY $x0
    %def:_(i64) = G_IMPLICIT_DEF
    %me:_(i128) = G_MERGE_VALUES %opaque(i64), %def
    $q0 = COPY %me(i128)
...

# Check that we don't anyext the merge, multi-use
---
name:            test_merge_undef_multi_use
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_merge_undef_multi_use
    ; CHECK: %opaque:_(i64) = COPY $x0
    ; CHECK-NEXT: %def:_(i64) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %me:_(i128) = G_ANYEXT %opaque(i64)
    ; CHECK-NEXT: $q0 = COPY %me(i128)
    ; CHECK-NEXT: $x0 = COPY %def(i64)
    %opaque:_(i64) = COPY $x0
    %def:_(i64) = G_IMPLICIT_DEF
    %me:_(i128) = G_MERGE_VALUES %opaque(i64), %def
    $q0 = COPY %me(i128)
    $x0 = COPY %def(i64)
...
# Check that we zext the merge
---
name:            test_merge_zero
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_merge_zero
    ; CHECK: %opaque:_(i64) = COPY $x0
    ; CHECK-NEXT: %me:_(i128) = G_ZEXT %opaque(i64)
    ; CHECK-NEXT: $q0 = COPY %me(i128)
    %opaque:_(i64) = COPY $x0
    %def:_(i64) = G_CONSTANT i64 0
    %me:_(i128) = G_MERGE_VALUES %opaque(i64), %def
    $q0 = COPY %me(i128)
...
# Check that we still zext the merge, multi-use
---
name:            test_merge_zero_multi_use
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_merge_zero_multi_use
    ; CHECK: %opaque:_(i64) = COPY $x0
    ; CHECK-NEXT: %def:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: %me:_(i128) = G_ZEXT %opaque(i64)
    ; CHECK-NEXT: $q0 = COPY %me(i128)
    ; CHECK-NEXT: $x0 = COPY %def(i64)
    %opaque:_(i64) = COPY $x0
    %def:_(i64) = G_CONSTANT i64 0
    %me:_(i128) = G_MERGE_VALUES %opaque(i64), %def
    $q0 = COPY %me(i128)
    $x0 = COPY %def(i64)
...
# Check that we don't zext the merge with one
---
name:            test_merge_one
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_merge_one
    ; CHECK: %opaque:_(i64) = COPY $x0
    ; CHECK-NEXT: %def:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: %me:_(i128) = G_MERGE_VALUES %opaque(i64), %def(i64)
    ; CHECK-NEXT: $q0 = COPY %me(i128)
    %opaque:_(i64) = COPY $x0
    %def:_(i64) = G_CONSTANT i64 1
    %me:_(i128) = G_MERGE_VALUES %opaque(i64), %def
    $q0 = COPY %me(i128)
...
