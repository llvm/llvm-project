body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_buildvector_3ops
    ; CHECK: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $w0 = COPY [[DEF]](i32)
    ; CHECK-NEXT: $w1 = COPY [[DEF]](i32)
    ; CHECK-NEXT: $w2 = COPY [[DEF]](i32)
    %0:_(i32) = G_IMPLICIT_DEF
    %1:_(i32) = G_IMPLICIT_DEF
    %5:_(i32) = G_IMPLICIT_DEF
    %2:_(<3 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %5(i32)
    %3:_(i32), %4:_(i32), %6:_(i32) = G_UNMERGE_VALUES %2(<3 x i32>)
    $w0 = COPY %3(i32)
