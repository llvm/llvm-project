---
name:            test_combine_unmerge_merge_3ops
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_merge_3ops
    ; CHECK: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF1:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[DEF2:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $w0 = COPY [[DEF]](i32)
    ; CHECK-NEXT: $w1 = COPY [[DEF1]](i32)
    ; CHECK-NEXT: $w2 = COPY [[DEF2]](i32)
    %0:_(i32) = G_IMPLICIT_DEF
    %1:_(i32) = G_IMPLICIT_DEF
    %5:_(i32) = G_IMPLICIT_DEF
    %2:_(i96) = G_MERGE_VALUES %0(i32), %1(i32), %5(i32)
    %3:_(i32), %4:_(i32), %6:_(i32) = G_UNMERGE_VALUES %2(i96)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
    $w2 = COPY %6(i32)
...

# Simple unmerge(buildvector) case with two operands.
# The sources of the buildvector can be used in place of
# the destinations of the unmerge.
---
name:            test_combine_unmerge_build_vector
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_build_vector
    ; CHECK: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $w0 = COPY [[DEF]](i32)
    ; CHECK-NEXT: $w1 = COPY [[DEF]](i32)
    %0:_(i32) = G_IMPLICIT_DEF
    %1:_(i32) = G_IMPLICIT_DEF
    %2:_(<2 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32)
    %3:_(i32), %4:_(i32) = G_UNMERGE_VALUES %2(<2 x i32>)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...

# Simple unmerge(buildvector) case with three operands.
