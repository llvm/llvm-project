    $w2 = COPY %6(i32)
...

# Simple unmerge(concatvectors) case.
# The sources of the concatvectors can be used in place of
# the destinations of the unmerge.
---
name:            test_combine_unmerge_concat_vectors
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_concat_vectors
    ; CHECK: [[COPY:%[0-9]+]]:_(<2 x i16>) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<2 x i16>) = COPY $w1
    ; CHECK-NEXT: $w0 = COPY [[COPY]](<2 x i16>)
    ; CHECK-NEXT: $w1 = COPY [[COPY1]](<2 x i16>)
    %0:_(<2 x i16>) = COPY $w0
    %1:_(<2 x i16>) = COPY $w1
    %2:_(<4 x i16>) = G_CONCAT_VECTORS %0(<2 x i16>), %1(<2 x i16>)
    %3:_(<2 x i16>), %4:_(<2 x i16>) = G_UNMERGE_VALUES %2(<4 x i16>)
    $w0 = COPY %3(<2 x i16>)
    $w1 = COPY %4(<2 x i16>)
...

# Unmerge(merge) case with two operands and a bitcast in the middle.
# The sources of the merge can be used in place of
# the destinations of the unmerge.
---
name:            test_combine_unmerge_bitcast_merge
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_bitcast_merge
    ; CHECK: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $w0 = COPY [[DEF]](i32)
    ; CHECK-NEXT: $w1 = COPY [[DEF]](i32)
    %0:_(i32) = G_IMPLICIT_DEF
    %1:_(i32) = G_IMPLICIT_DEF
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1(i32)
    %5:_(<2 x i32>) = G_BITCAST %2(i64)
    %3:_(i32), %4:_(i32) = G_UNMERGE_VALUES %5(<2 x i32>)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...

# Unmerge(merge) with incompatible types: unmerge destTy != merge inputTy.
# The sources of the merge cannot be used in place of
# the destinations of the unmerge, since the types don't match.
---
name:            test_combine_unmerge_merge_incompatible_types
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_merge_incompatible_types
    ; CHECK: [[DEF:%[0-9]+]]:_(i16) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $h0 = COPY [[DEF]](i16)
    ; CHECK-NEXT: $h1 = COPY [[DEF]](i16)
    ; CHECK-NEXT: $h2 = COPY [[DEF]](i16)
    ; CHECK-NEXT: $h3 = COPY [[DEF]](i16)
    %0:_(i32) = G_IMPLICIT_DEF
    %1:_(i32) = G_IMPLICIT_DEF
    %2:_(i64) = G_MERGE_VALUES %0(i32), %1(i32)
    %3:_(i16), %4:_(i16), %5:_(i16), %6:_(i16) = G_UNMERGE_VALUES %2(i64)
    $h0 = COPY %3(i16)
    $h1 = COPY %4(i16)
    $h2 = COPY %5(i16)
    $h3 = COPY %6(i16)
...

# Unmerge(concatvectors) with incompatible types: unmerge destTy != merge inputTy
# but destTy.size() == inputTy.size().
# The sources of the concatvectors can be used in place of
# the destinations of the unmerge with a bitcast since the sizes
# match.
---
name:            test_combine_unmerge_merge_incompatible_types_but_same_size
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_merge_incompatible_types_but_same_size
    ; CHECK: [[COPY:%[0-9]+]]:_(<2 x i16>) = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<2 x i16>) = COPY $w1
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i32) = G_BITCAST [[COPY]](<2 x i16>)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(i32) = G_BITCAST [[COPY1]](<2 x i16>)
    ; CHECK-NEXT: $w0 = COPY [[BITCAST]](i32)
    ; CHECK-NEXT: $w1 = COPY [[BITCAST1]](i32)
    %0:_(<2 x i16>) = COPY $w0
    %1:_(<2 x i16>) = COPY $w1
    %2:_(<4 x i16>) = G_CONCAT_VECTORS %0(<2 x i16>), %1(<2 x i16>)
    %5:_(i64) = G_BITCAST %2(<4 x i16>)
    %3:_(i32), %4:_(i32) = G_UNMERGE_VALUES %5(i64)
    $w0 = COPY %3(i32)
    $w1 = COPY %4(i32)
...

# Unmerge a constant into a bunch of smaller constant.
# Constant is 0x0102030405060708090a0b0c0d0e0f10 and we break it down into
# bytes:
# cst1 0x10
# cst2 0x0f
# cst3 0x0e
# ...
---
name:            test_combine_unmerge_cst
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_cst
    ; CHECK: [[C:%[0-9]+]]:_(i8) = G_CONSTANT i8 16
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i8) = G_CONSTANT i8 15
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i8) = G_CONSTANT i8 14
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(i8) = G_CONSTANT i8 13
    ; CHECK-NEXT: [[C4:%[0-9]+]]:_(i8) = G_CONSTANT i8 12
    ; CHECK-NEXT: [[C5:%[0-9]+]]:_(i8) = G_CONSTANT i8 11
    ; CHECK-NEXT: [[C6:%[0-9]+]]:_(i8) = G_CONSTANT i8 10
    ; CHECK-NEXT: [[C7:%[0-9]+]]:_(i8) = G_CONSTANT i8 9
    ; CHECK-NEXT: [[C8:%[0-9]+]]:_(i8) = G_CONSTANT i8 8
    ; CHECK-NEXT: [[C9:%[0-9]+]]:_(i8) = G_CONSTANT i8 7
    ; CHECK-NEXT: [[C10:%[0-9]+]]:_(i8) = G_CONSTANT i8 6
    ; CHECK-NEXT: [[C11:%[0-9]+]]:_(i8) = G_CONSTANT i8 5
    ; CHECK-NEXT: [[C12:%[0-9]+]]:_(i8) = G_CONSTANT i8 4
    ; CHECK-NEXT: [[C13:%[0-9]+]]:_(i8) = G_CONSTANT i8 3
    ; CHECK-NEXT: [[C14:%[0-9]+]]:_(i8) = G_CONSTANT i8 2
    ; CHECK-NEXT: [[C15:%[0-9]+]]:_(i8) = G_CONSTANT i8 1
    ; CHECK-NEXT: $b0 = COPY [[C]](i8)
    ; CHECK-NEXT: $b1 = COPY [[C1]](i8)
    ; CHECK-NEXT: $b2 = COPY [[C2]](i8)
    ; CHECK-NEXT: $b3 = COPY [[C3]](i8)
    ; CHECK-NEXT: $b4 = COPY [[C4]](i8)
    ; CHECK-NEXT: $b5 = COPY [[C5]](i8)
    ; CHECK-NEXT: $b6 = COPY [[C6]](i8)
    ; CHECK-NEXT: $b7 = COPY [[C7]](i8)
    ; CHECK-NEXT: $b8 = COPY [[C8]](i8)
    ; CHECK-NEXT: $b9 = COPY [[C9]](i8)
    ; CHECK-NEXT: $b10 = COPY [[C10]](i8)
    ; CHECK-NEXT: $b11 = COPY [[C11]](i8)
    ; CHECK-NEXT: $b12 = COPY [[C12]](i8)
    ; CHECK-NEXT: $b13 = COPY [[C13]](i8)
    ; CHECK-NEXT: $b14 = COPY [[C14]](i8)
    ; CHECK-NEXT: $b15 = COPY [[C15]](i8)
    %0:_(i128) = G_CONSTANT i128 1339673755198158349044581307228491536
    %1:_(i8),%2:_(i8),%3:_(i8),%4:_(i8),%5:_(i8),%6:_(i8),%7:_(i8),%8:_(i8),%9:_(i8),%10:_(i8),%11:_(i8),%12:_(i8),%13:_(i8),%14:_(i8),%15:_(i8),%16:_(i8) = G_UNMERGE_VALUES %0(i128)
    $b0 = COPY %1(i8)
    $b1 = COPY %2(i8)
    $b2 = COPY %3(i8)
    $b3 = COPY %4(i8)
    $b4 = COPY %5(i8)
    $b5 = COPY %6(i8)
    $b6 = COPY %7(i8)
    $b7 = COPY %8(i8)
    $b8 = COPY %9(i8)
    $b9 = COPY %10(i8)
    $b10 = COPY %11(i8)
    $b11 = COPY %12(i8)
    $b12 = COPY %13(i8)
    $b13 = COPY %14(i8)
    $b14 = COPY %15(i8)
    $b15 = COPY %16(i8)
...

# Unmerge a constant on a non-power of 2 type into a bunch of smaller constant.
# Constant is a 3 | 2 | 1 in chunks of 13-bit.
---
name:            test_combine_unmerge_cst_36bit
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_cst_36bit
    ; CHECK: [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i16) = G_CONSTANT i16 2
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i16) = G_CONSTANT i16 3
    ; CHECK-NEXT: $h0 = COPY [[C]](i16)
    ; CHECK-NEXT: $h1 = COPY [[C1]](i16)
    ; CHECK-NEXT: $h2 = COPY [[C2]](i16)
    %0:_(i39) = G_CONSTANT i39 201342977
    %1:_(i13),%2:_(i13),%3:_(i13) = G_UNMERGE_VALUES %0(i39)
    %4:_(i16) = G_ZEXT %1(i13)
    %5:_(i16) = G_ZEXT %2(i13)
    %6:_(i16) = G_ZEXT %3(i13)
    $h0 = COPY %4(i16)
    $h1 = COPY %5(i16)
    $h2 = COPY %6(i16)
...

# Unmerge floating point constant.
---
name:            test_combine_unmerge_fpcst
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_fpcst
    ; CHECK: [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 1
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i16) = G_CONSTANT i16 2
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i16) = G_CONSTANT i16 3
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(i16) = G_CONSTANT i16 4
    ; CHECK-NEXT: $h0 = COPY [[C]](i16)
    ; CHECK-NEXT: $h1 = COPY [[C1]](i16)
    ; CHECK-NEXT: $h2 = COPY [[C2]](i16)
    ; CHECK-NEXT: $h3 = COPY [[C3]](i16)
    %0:_(i64) = G_FCONSTANT double 0x0004000300020001
    %1:_(i16),%2:_(i16),%3:_(i16),%4:_(i16) = G_UNMERGE_VALUES %0(i64)
    $h0 = COPY %1(i16)
    $h1 = COPY %2(i16)
    $h2 = COPY %3(i16)
    $h3 = COPY %4(i16)
...

# Transform unmerge into trunc when only the first definition is live.
---
name:            test_combine_unmerge_dead_to_trunc
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_dead_to_trunc
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: $h0 = COPY [[TRUNC]](i16)
    %0:_(i64) = COPY $x0
    %1:_(i16),%2:_(i16),%3:_(i16),%4:_(i16) = G_UNMERGE_VALUES %0(i64)
    $h0 = COPY %1(i16)
...

# Don't transform unmerge into trunc when middle lanes are live.
---
name:            test_dont_combine_unmerge_dead_to_trunc
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_dont_combine_unmerge_dead_to_trunc
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i16), [[UV1:%[0-9]+]]:_(i16), [[UV2:%[0-9]+]]:_(i16), [[UV3:%[0-9]+]]:_(i16) = G_UNMERGE_VALUES [[COPY]](i64)
    ; CHECK-NEXT: $h0 = COPY [[UV2]](i16)
    %0:_(i64) = COPY $x0
    %1:_(i16),%2:_(i16),%3:_(i16),%4:_(i16) = G_UNMERGE_VALUES %0(i64)
    $h0 = COPY %3(i16)
...

# Transform unmerge into trunc when only the first definition is live, even
