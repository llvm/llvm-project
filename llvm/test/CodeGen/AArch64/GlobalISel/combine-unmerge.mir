body:             |
  bb.1:
    ; CHECK-LABEL: name: test_combine_unmerge_dead_to_trunc_vec_in_n_out
    ; CHECK: [[COPY:%[0-9]+]]:_(<4 x i16>) = COPY $x0
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<2 x i16>), [[UV1:%[0-9]+]]:_(<2 x i16>) = G_UNMERGE_VALUES [[COPY]](<4 x i16>)
    ; CHECK-NEXT: $w0 = COPY [[UV]](<2 x i16>)
    %0:_(<4 x i16>) = COPY $x0
    %1:_(<2 x i16>),%2:_(<2 x i16>) = G_UNMERGE_VALUES %0(<4 x i16>)
    $w0 = COPY %1(<2 x i16>)
...

