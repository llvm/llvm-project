# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# FP constant matching must use the G_FCONSTANT's semantics: 0x3F80 is bf16 1.0
# but half 1.875, and 0x3C00 is half 1.0 but bf16 0.0078125.

---
name:            fmul_bf16_one
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $h0
    ; CHECK-LABEL: name: fmul_bf16_one
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(bf16) = COPY $h0
    ; CHECK-NEXT: $h0 = COPY %x(bf16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %x:_(bf16) = COPY $h0
    %c:_(bf16) = G_FCONSTANT bfloat 0xR3F80
    %r:_(bf16) = G_FMUL %x, %c
    $h0 = COPY %r(bf16)
    RET_ReallyLR implicit $h0
...
---
name:            fmul_bf16_half_one_bits
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $h0
    ; CHECK-LABEL: name: fmul_bf16_half_one_bits
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(bf16) = COPY $h0
    ; CHECK-NEXT: %c:_(bf16) = G_FCONSTANT bfloat 7.812500e-03
    ; CHECK-NEXT: %r:_(bf16) = G_FMUL %x, %c
    ; CHECK-NEXT: $h0 = COPY %r(bf16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %x:_(bf16) = COPY $h0
    %c:_(bf16) = G_FCONSTANT bfloat 0xR3C00
    %r:_(bf16) = G_FMUL %x, %c
    $h0 = COPY %r(bf16)
    RET_ReallyLR implicit $h0
...
---
name:            fmul_f16_one
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $h0
    ; CHECK-LABEL: name: fmul_f16_one
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(f16) = COPY $h0
    ; CHECK-NEXT: $h0 = COPY %x(f16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %x:_(f16) = COPY $h0
    %c:_(f16) = G_FCONSTANT half 0xH3C00
    %r:_(f16) = G_FMUL %x, %c
    $h0 = COPY %r(f16)
    RET_ReallyLR implicit $h0
...
---
name:            fmul_f16_bf16_one_bits
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $h0
    ; CHECK-LABEL: name: fmul_f16_bf16_one_bits
    ; CHECK: liveins: $h0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(f16) = COPY $h0
    ; CHECK-NEXT: %c:_(f16) = G_FCONSTANT half 1.875000e+00
    ; CHECK-NEXT: %r:_(f16) = G_FMUL %x, %c
    ; CHECK-NEXT: $h0 = COPY %r(f16)
    ; CHECK-NEXT: RET_ReallyLR implicit $h0
    %x:_(f16) = COPY $h0
    %c:_(f16) = G_FCONSTANT half 0xH3F80
    %r:_(f16) = G_FMUL %x, %c
    $h0 = COPY %r(f16)
    RET_ReallyLR implicit $h0
...
---
name:            fmul_v4bf16_splat_one
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0
    ; CHECK-LABEL: name: fmul_v4bf16_splat_one
    ; CHECK: liveins: $d0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<4 x bf16>) = COPY $d0
    ; CHECK-NEXT: $d0 = COPY %x(<4 x bf16>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %x:_(<4 x bf16>) = COPY $d0
    %one:_(bf16) = G_FCONSTANT bfloat 0xR3F80
    %c:_(<4 x bf16>) = G_BUILD_VECTOR %one(bf16), %one(bf16), %one(bf16), %one(bf16)
    %r:_(<4 x bf16>) = G_FMUL %x, %c
    $d0 = COPY %r(<4 x bf16>)
    RET_ReallyLR implicit $d0
...
