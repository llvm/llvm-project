# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s

---
name:            fptrunc_scalar
legalized:       true
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: fptrunc_scalar
    ; CHECK: %res:_(f32) = G_FCONSTANT float 4.000000e+00
    ; CHECK-NEXT: $s0 = COPY %res(f32)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %src:_(f64) = G_FCONSTANT double 4.0
    %res:_(f32) = G_FPTRUNC %src(f64)
    $s0 = COPY %res(f32)
    RET_ReallyLR implicit $s0

...
---
name:            fptrunc_vector
legalized:       true
body:             |
  bb.1.entry:
    ; Folded before legalization, even though <2 x f16> G_BUILD_VECTOR is illegal.
    ; CHECK-LABEL: name: fptrunc_vector
    ; CHECK: [[C:%[0-9]+]]:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(f16) = G_FCONSTANT half 2.000000e+00
    ; CHECK-NEXT: %res:_(<2 x f16>) = G_BUILD_VECTOR [[C]](f16), [[C1]](f16)
    ; CHECK-NEXT: $s0 = COPY %res(<2 x f16>)
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %a0:_(f32) = G_FCONSTANT float 1.0
    %a1:_(f32) = G_FCONSTANT float 2.0
    %src:_(<2 x f32>) = G_BUILD_VECTOR %a0(f32), %a1(f32)
    %res:_(<2 x f16>) = G_FPTRUNC %src(<2 x f32>)
    $s0 = COPY %res(<2 x f16>)
    RET_ReallyLR implicit $s0

...
---
name:            fpext_scalar
legalized:       true
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: fpext_scalar
    ; CHECK: %res:_(f64) = G_FCONSTANT double 4.000000e+00
    ; CHECK-NEXT: $d0 = COPY %res(f64)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %src:_(f32) = G_FCONSTANT float 4.0
    %res:_(f64) = G_FPEXT %src(f32)
    $d0 = COPY %res(f64)
    RET_ReallyLR implicit $d0

...
---
name:            fpext_vector
legalized:       true
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: fpext_vector
    ; CHECK: [[C:%[0-9]+]]:_(f64) = G_FCONSTANT double 1.000000e+00
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(f64) = G_FCONSTANT double 2.000000e+00
    ; CHECK-NEXT: %res:_(<2 x f64>) = G_BUILD_VECTOR [[C]](f64), [[C1]](f64)
    ; CHECK-NEXT: $q0 = COPY %res(<2 x f64>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %a0:_(f32) = G_FCONSTANT float 1.0
    %a1:_(f32) = G_FCONSTANT float 2.0
    %src:_(<2 x f32>) = G_BUILD_VECTOR %a0(f32), %a1(f32)
    %res:_(<2 x f64>) = G_FPEXT %src(<2 x f32>)
    $q0 = COPY %res(<2 x f64>)
    RET_ReallyLR implicit $q0

...
