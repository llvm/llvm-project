; NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --print-fixed-stack --filter "G_|RET_ReallyLR" --version 6
; RUN: llc -mtriple=aarch64-linux-gnu -O0 -global-isel -global-isel-abort=1 -stop-after=ir-translator -simplify-mir -o - %s | FileCheck %s

; The array uses all eight argument GPRs. The plain i1 is passed as a
; zero-extended byte on the stack, so it can be loaded directly as i1.
define void @test_mem_i1([8 x i64], i1 %in) {
  ; CHECK-LABEL: name: test_mem_i1
  ; CHECK: fixedStack:
  ; CHECK-NEXT:   - { id: 0, size: 1, alignment: 16, isImmutable: true }
  ; CHECK: bb.1 (%ir-block.1):
  ; CHECK:   [[FRAME_INDEX:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
  ; CHECK-NEXT:   [[LOAD:%[0-9]+]]:_(i1) = G_LOAD [[FRAME_INDEX]](p0) :: (invariant load (i1) from %fixed-stack.0, align 16)
  ; CHECK-NEXT:   [[FRAME_INDEX1:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0.local
  ; CHECK-NEXT:   G_STORE [[LOAD]](i1), [[FRAME_INDEX1]](p0) :: (volatile store (i1) into %ir.local)
  ; CHECK-NEXT:   RET_ReallyLR
  %local = alloca i1
  store volatile i1 %in, ptr %local
  ret void
}
