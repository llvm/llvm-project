; CHECK-NEXT:    mov w7, #8738 ; =0x2222
; CHECK-NEXT:    mov w8, #7 ; =0x7
; CHECK-NEXT:    movk w6, #13107, lsl #16
; CHECK-NEXT:    movk w7, #4369, lsl #16
; CHECK-NEXT:    str x8, [sp]
; CHECK-NEXT:    b _callee_sibcall
  tail call void @callee_sibcall(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 u0x111122220000000033334444, i64 7)
