; Check that non-sibcall tail calls (tailcc, swifttailcc) pass split i128
; arguments and following arguments in the same registers and stack slots as
; SelectionDAG.

declare tailcc void @callee(i64, i64, i64, i64, i64, i64, i128, i64)
declare swifttailcc void @callee_swift(i64, i64, i64, i64, i64, i64, i128, i64)
declare tailcc void @callee_x0(i128, i64)
declare tailcc void @callee_x5(i64, i64, i64, i64, i64, i128, i64)
declare tailcc void @callee_stack(i64, i64, i64, i64, i64, i64, i64, i128)
declare void @callee_sibcall(i64, i64, i64, i64, i64, i64, i128, i64)

; The i128 is in x6:x7 and the next argument is on the stack.
define tailcc void @caller_musttail(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 %v, i64 %n) {
;
; CHECK-LABEL: caller_musttail:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    b _callee
  musttail call tailcc void @callee(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 %v, i64 %n)
  ret void
}

define swifttailcc void @caller_swift(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 %v, i64 %n) {
;
; CHECK-LABEL: caller_swift:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    b _callee_swift
  musttail call swifttailcc void @callee_swift(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 %v, i64 %n)
  ret void
}

; The i128 starts at x0.
define tailcc void @caller_x0(i128 %v, i64 %n) {
;
; CHECK-LABEL: caller_x0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    b _callee_x0
  musttail call tailcc void @callee_x0(i128 %v, i64 %n)
  ret void
}

; Darwin does not align the i128 to an even register, so it is passed in x5:x6
; and the next argument in x7.
define tailcc void @caller_x5(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i128 %v, i64 %n) {
;
; CHECK-LABEL: caller_x5:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov w5, #17476 ; =0x4444
; CHECK-NEXT:    mov w6, #8738 ; =0x2222
; CHECK-NEXT:    mov w7, #7 ; =0x7
; CHECK-NEXT:    movk w5, #13107, lsl #16
; CHECK-NEXT:    movk w6, #4369, lsl #16
; CHECK-NEXT:    b _callee_x5
  musttail call tailcc void @callee_x5(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i128 u0x111122220000000033334444, i64 7)
  ret void
}

; Constant arguments, so that the stores to registers and the stack are checked.
define tailcc void @caller_const(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 %v, i64 %n) {
;
; CHECK-LABEL: caller_const:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov w6, #17476 ; =0x4444
; CHECK-NEXT:    mov w7, #8738 ; =0x2222
; CHECK-NEXT:    mov w8, #7 ; =0x7
; CHECK-NEXT:    movk w6, #13107, lsl #16
; CHECK-NEXT:    movk w7, #4369, lsl #16
; CHECK-NEXT:    str x8, [sp]
; CHECK-NEXT:    b _callee
  musttail call tailcc void @callee(i64 %p0, i64 %p1, i64 %p2, i64 %p3, i64 %p4, i64 %p5, i128 u0x111122220000000033334444, i64 7)
  ret void
}

; The callee needs more stack argument space than the caller has, so the
; stack is resized by a nonzero FPDiff.
define tailcc void @caller_grow_stack(i128 %v, i64 %n) {
;
; GISEL-LABEL: caller_grow_stack:
; GISEL:       ; %bb.0:
; GISEL-NEXT:    str x2, [sp, #-16]!
; GISEL-NEXT:    .cfi_def_cfa_offset 16
; GISEL-NEXT:    mov x6, x0
; GISEL-NEXT:    mov x7, x1
; GISEL-NEXT:    mov x0, xzr
; GISEL-NEXT:    mov x1, xzr
; GISEL-NEXT:    mov x2, xzr
; GISEL-NEXT:    mov x3, xzr
; GISEL-NEXT:    mov x4, xzr
; GISEL-NEXT:    mov x5, xzr
; GISEL-NEXT:    b _callee
;
; SDAG-LABEL: caller_grow_stack:
; SDAG:       ; %bb.0:
; SDAG-NEXT:    str x2, [sp, #-16]!
; SDAG-NEXT:    .cfi_def_cfa_offset 16
; SDAG-NEXT:    mov x7, x1
; SDAG-NEXT:    mov x6, x0
; SDAG-NEXT:    mov x0, xzr
; SDAG-NEXT:    mov x1, xzr
; SDAG-NEXT:    mov x2, xzr
; SDAG-NEXT:    mov x3, xzr
; SDAG-NEXT:    mov x4, xzr
; SDAG-NEXT:    mov x5, xzr
; SDAG-NEXT:    b _callee
  tail call tailcc void @callee(i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i128 %v, i64 %n)
  ret void
}

; x7 cannot hold half of a split i128, so both halves are passed on the stack,
; contiguously and within the resized argument area.
define tailcc void @caller_stack(i128 %v) {
;
; CHECK-LABEL: caller_stack:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    stp x0, x1, [sp, #-16]!
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    mov x0, xzr
; CHECK-NEXT:    mov x1, xzr
; CHECK-NEXT:    mov x2, xzr
; CHECK-NEXT:    mov x3, xzr
; CHECK-NEXT:    mov x4, xzr
; CHECK-NEXT:    mov x5, xzr
; CHECK-NEXT:    mov x6, xzr
; CHECK-NEXT:    b _callee_stack
  tail call tailcc void @callee_stack(i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i128 %v)
  ret void
}

