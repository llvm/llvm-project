---
name:            test_icmp
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_icmp
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(sge), [[COPY]](i64), [[COPY1]]
    ; CHECK-NEXT: $w0 = COPY [[ICMP]](i32)
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[TRUNC]], [[C]]
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(i32) = G_TRUNC [[COPY1]](i64)
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND [[TRUNC1]], [[C]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[AND]](i32), [[AND1]]
    ; CHECK-NEXT: $w0 = COPY [[ICMP1]](i32)
    ; CHECK-NEXT: [[INTTOPTR:%[0-9]+]]:_(p0) = G_INTTOPTR [[COPY]](i64)
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[INTTOPTR]](p0), [[INTTOPTR]]
    ; CHECK-NEXT: $w0 = COPY [[ICMP2]](i32)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x0
    %2:_(i8) = G_TRUNC %0(i64)
    %3:_(i8) = G_TRUNC %1(i64)
    %4:_(i1) = G_ICMP intpred(sge), %0(i64), %1
    %11:_(i32) = G_ANYEXT %4(i1)
    $w0 = COPY %11(i32)
    %8:_(i1) = G_ICMP intpred(ult), %2(i8), %3
    %12:_(i32) = G_ANYEXT %8(i1)
    $w0 = COPY %12(i32)
    %9:_(p0) = G_INTTOPTR %0(i64)
    %10:_(i1) = G_ICMP intpred(eq), %9(p0), %9
    %14:_(i32) = G_ANYEXT %10(i1)
    $w0 = COPY %14(i32)

...
