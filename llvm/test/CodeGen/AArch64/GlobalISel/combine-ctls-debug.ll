; Debug uses of the intermediate values must not prevent the ctlz -> ctls
; combine.

define i32 @cls_add(i32 %x) !dbg !5 {
  ; CHECK-LABEL: name: cls_add
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !7, !DIExpression(), debug-location !8
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !9, !DIExpression(), debug-location !8
  ; CHECK-NEXT:   [[CTLS:%[0-9]+]]:_(i32) = G_CTLS [[COPY]](i32)
  ; CHECK-NEXT:   $w0 = COPY [[CTLS]](i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  %shr = ashr i32 %x, 31
    #dbg_value(i32 %shr, !9, !DIExpression(), !11)
  %xor = xor i32 %shr, %x
    #dbg_value(i32 %xor, !10, !DIExpression(), !11)
  %ctlz = call i32 @llvm.ctlz.i32(i32 %xor, i1 false)
  %sub = add nsw i32 %ctlz, -1
  ret i32 %sub
}

define i32 @cls_or(i32 %x) !dbg !12 {
  ; CHECK-LABEL: name: cls_or
  ; CHECK: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !11, !DIExpression(), debug-location !12
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !13, !DIExpression(), debug-location !12
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !14, !DIExpression(), debug-location !12
  ; CHECK-NEXT:   DBG_VALUE $noreg, $noreg, !15, !DIExpression(), debug-location !12
  ; CHECK-NEXT:   [[CTLS:%[0-9]+]]:_(i32) = G_CTLS [[COPY]](i32)
  ; CHECK-NEXT:   $w0 = COPY [[CTLS]](i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  %shr = ashr i32 %x, 31
    #dbg_value(i32 %shr, !13, !DIExpression(), !16)
  %xor = xor i32 %shr, %x
    #dbg_value(i32 %xor, !14, !DIExpression(), !16)
  %shl = shl i32 %xor, 1
