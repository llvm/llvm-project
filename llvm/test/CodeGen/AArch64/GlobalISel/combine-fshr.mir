    ; CHECK-NEXT: $w0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %3:_(i32) = COPY $w0
    %0:_(i8) = G_TRUNC %3(i32)
    %4:_(i32) = COPY $w1
    %1:_(i8) = G_TRUNC %4(i32)
    %5:_(i32) = COPY $w2
    %2:_(i8) = G_TRUNC %5(i32)
    %6:_(i8) = G_FSHR %0, %1, %2(i8)
