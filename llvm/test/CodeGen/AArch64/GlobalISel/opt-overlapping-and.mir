    %2:_(i32) = G_CONSTANT i32 255
    %4:_(i32) = G_CONSTANT i32 -128
    %3:_(i32) = G_AND %0, %2
    %5:_(i32) = G_AND %3, %4
    G_STORE %3(i32), %1(p0) :: (store (i32))
    $w0 = COPY %5(i32)
    RET_ReallyLR implicit $w0

