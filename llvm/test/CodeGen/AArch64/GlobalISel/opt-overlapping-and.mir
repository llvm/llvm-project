---
name:            bitmask_overlap1
body:             |
  bb.1:
    ; CHECK-LABEL: name: bitmask_overlap1
    ; CHECK: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 128
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[COPY]], [[C]]
    ; CHECK-NEXT: $w0 = COPY [[AND]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_CONSTANT i32 -128
    %3:_(i32) = G_CONSTANT i32 255
    %2:_(i32) = G_AND %0, %1
    %4:_(i32) = G_AND %2, %3
    $w0 = COPY %4(i32)
    RET_ReallyLR implicit $w0

...
