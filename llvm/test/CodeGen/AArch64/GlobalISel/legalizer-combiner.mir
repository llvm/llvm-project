# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -O0 -mtriple aarch64-- -run-pass=legalizer %s -o - | FileCheck %s

---
name:            test_unmerge
body:             |
  bb.1:
    liveins: $w0
    ; CHECK-LABEL: name: test_unmerge
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: $w0 = COPY [[COPY]](i32)
    %0:_(i32) = COPY $w0
    %1:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %0(i32), %0(i32), %0(i32)
    %2:_(i32), %3:_(i32), %4:_(i32), %5:_(i32) = G_UNMERGE_VALUES %1(<4 x i32>)
    $w0 = COPY %2(i32)
...

---
name:            test_legal_const_ext
body:             |
  bb.1:
    liveins: $w0
    ; CHECK-LABEL: name: test_legal_const_ext
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[C]]
    ; CHECK-NEXT: $w0 = COPY [[ADD]](i32)
    %0:_(i32) = COPY $w0
    %1:_(i1) = G_TRUNC %0(i32)
    %2:_(i1) = G_CONSTANT i1 2
    %3:_(i1) = G_ADD %1(i1), %2(i1)
    %4:_(i32) = G_ANYEXT %3(i1)
    $w0 = COPY %4(i32)
...

# Check that the artifact combiner can get rid of the big
# vector type (4 x s64) by combining the G_UNMERGE_VALUES
# with the G_CONCAT_VECTORS and turning that into bitcast.
---
name:            concat_vectors_unmerge_to_bitcast
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q0, $q1

    ; CHECK-LABEL: name: concat_vectors_unmerge_to_bitcast
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<2 x i64>) = COPY $q0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<2 x i64>) = COPY $q1
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i128) = G_BITCAST [[COPY]](<2 x i64>)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(i128) = G_BITCAST [[COPY1]](<2 x i64>)
    ; CHECK-NEXT: $q0 = COPY [[BITCAST]](i128)
    ; CHECK-NEXT: $q1 = COPY [[BITCAST1]](i128)
    %0:_(<2 x i64>) = COPY $q0
    %1:_(<2 x i64>) = COPY $q1
    %2:_(<4 x i64>) = G_CONCAT_VECTORS %0(<2 x i64>), %1(<2 x i64>)
    %3:_(i128), %4:_(i128) = G_UNMERGE_VALUES %2(<4 x i64>)
    $q0 = COPY %3(i128)
    $q1 = COPY %4(i128)
...

# Check that the artifact combiner can get rid of the big
# vector type (4 x s64) by combining the G_UNMERGE_VALUES
# with the G_CONCAT_VECTORS and turning that into smaller
# 2x64-bit G_UNMERGE_VALUES.
---
name:            concat_vectors_unmerge_to_unmerge
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q0, $q1

    ; CHECK-LABEL: name: concat_vectors_unmerge_to_unmerge
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<2 x i64>) = COPY $q0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<2 x i64>) = COPY $q1
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i64), [[UV1:%[0-9]+]]:_(i64) = G_UNMERGE_VALUES [[COPY]](<2 x i64>)
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(i64), [[UV3:%[0-9]+]]:_(i64) = G_UNMERGE_VALUES [[COPY1]](<2 x i64>)
    ; CHECK-NEXT: $x0 = COPY [[UV]](i64)
    ; CHECK-NEXT: $x1 = COPY [[UV1]](i64)
    ; CHECK-NEXT: $x2 = COPY [[UV2]](i64)
    ; CHECK-NEXT: $x3 = COPY [[UV3]](i64)
    %0:_(<2 x i64>) = COPY $q0
    %1:_(<2 x i64>) = COPY $q1
    %2:_(<4 x i64>) = G_CONCAT_VECTORS %0(<2 x i64>), %1(<2 x i64>)
    %3:_(i64), %4:_(i64), %5:_(i64), %6:_(i64) = G_UNMERGE_VALUES %2(<4 x i64>)
    $x0 = COPY %3(i64)
    $x1 = COPY %4(i64)
    $x2 = COPY %5(i64)
    $x3 = COPY %6(i64)
...
---
name:            unmerge_merge_combine
tracksRegLiveness: true
body:             |
  bb.1:
    liveins: $x0
    ; CHECK-LABEL: name: unmerge_merge_combine
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i64) = G_LOAD [[COPY]](p0) :: (load (i64))
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(i128) = G_LOAD [[COPY]](p0) :: (load (i128))
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i64), [[UV1:%[0-9]+]]:_(i64) = G_UNMERGE_VALUES [[LOAD1]](i128)
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[LOAD]], [[UV]]
    ; CHECK-NEXT: [[UMULH:%[0-9]+]]:_(i64) = G_UMULH [[LOAD]], [[UV]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i64) = G_MUL [[LOAD]], [[UV1]]
    ; CHECK-NEXT: [[MUL2:%[0-9]+]]:_(i64) = G_MUL [[C]], [[UV]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[UMULH]], [[MUL1]]
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i64) = G_ADD [[ADD]], [[MUL2]]
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES [[MUL]](i64), [[ADD1]](i64)
    ; CHECK-NEXT: $q0 = COPY [[MV]](i128)
    ; CHECK-NEXT: RET_ReallyLR
    %0:_(p0) = COPY $x0
    %1:_(i128) = G_ZEXTLOAD %0:_(p0) :: (load (i64))
    %2:_(i128) = G_LOAD %0:_(p0) :: (load (i128))
    %3:_(i128) = G_MUL %1:_, %2:_
    $q0 = COPY %3
    RET_ReallyLR
...
