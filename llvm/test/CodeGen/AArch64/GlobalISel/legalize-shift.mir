    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i64), [[UV1:%[0-9]+]]:_(i64) = G_UNMERGE_VALUES [[COPY]](i128)
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[TRUNC]], [[C]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i64) = G_SUB [[C]], [[TRUNC]]
