name: test_lshr_nonpow2
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_lshr_nonpow2
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: %a:_(i32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(i32), %a(i32)
    ; CHECK-NEXT: [[MV1:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(i32), [[C]](i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[C1]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i64) = G_SUB [[C1]], [[COPY]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](i64), [[C1]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY]](i64), [[C2]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[MV]], [[COPY]](i64)
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[MV1]], [[SUB1]](i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[LSHR]], [[SHL]]
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(i64) = G_LSHR [[MV1]], [[SUB]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i32), [[OR]], [[LSHR1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i64) = G_SELECT [[ICMP1]](i32), [[MV]], [[SELECT]]
    ; CHECK-NEXT: %d1:_(i32), %d2:_(i32) = G_UNMERGE_VALUES [[SELECT1]](i64)
    ; CHECK-NEXT: $w0 = COPY %d2(i32)
    %0:_(i64) = COPY $x0
    %a:_(i32) = COPY $w1
    %merge:_(i96) = G_MERGE_VALUES %a, %a, %a
    %lshr:_(i96) = G_LSHR %merge, %0
    %d1:_(i32), %d2:_(i32), %d3:_(i32) = G_UNMERGE_VALUES %lshr
    $w0 = COPY %d2(i32)

...
---
name: test_lshr_nonpow2_wide
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_lshr_nonpow2_wide
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: %a:_(i32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(i32), %a(i32)
    ; CHECK-NEXT: [[MV1:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(i32), %a(i32)
    ; CHECK-NEXT: [[MV2:%[0-9]+]]:_(i64) = G_MERGE_VALUES %a(i32), [[C]](i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 128
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[C2]]
    ; CHECK-NEXT: [[SUB1:%[0-9]+]]:_(i64) = G_SUB [[C2]], [[COPY]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](i64), [[C2]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY]](i64), [[C1]]
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(i64) = G_CONSTANT i64 64
    ; CHECK-NEXT: [[SUB2:%[0-9]+]]:_(i64) = G_SUB [[COPY]], [[C3]]
    ; CHECK-NEXT: [[SUB3:%[0-9]+]]:_(i64) = G_SUB [[C3]], [[COPY]]
    ; CHECK-NEXT: [[ICMP2:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[COPY]](i64), [[C3]]
    ; CHECK-NEXT: [[ICMP3:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[COPY]](i64), [[C1]]
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[MV]], [[COPY]](i64)
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[MV1]], [[SUB3]](i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[LSHR]], [[SHL]]
    ; CHECK-NEXT: [[LSHR1:%[0-9]+]]:_(i64) = G_LSHR [[MV1]], [[SUB2]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP2]](i32), [[OR]], [[LSHR1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i64) = G_SELECT [[ICMP3]](i32), [[MV]], [[SELECT]]
    ; CHECK-NEXT: [[ICMP4:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[SUB1]](i64), [[C3]]
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL [[MV2]], [[SUB1]](i64)
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i64) = G_SELECT [[ICMP4]](i32), [[SHL1]], [[C1]]
    ; CHECK-NEXT: [[OR1:%[0-9]+]]:_(i64) = G_OR [[SELECT1]], [[SELECT2]]
    ; CHECK-NEXT: [[SUB4:%[0-9]+]]:_(i64) = G_SUB [[SUB]], [[C3]]
    ; CHECK-NEXT: [[SUB5:%[0-9]+]]:_(i64) = G_SUB [[C3]], [[SUB]]
    ; CHECK-NEXT: [[ICMP5:%[0-9]+]]:_(i32) = G_ICMP intpred(ult), [[SUB]](i64), [[C3]]
    ; CHECK-NEXT: [[ICMP6:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[SUB]](i64), [[C1]]
    ; CHECK-NEXT: [[LSHR2:%[0-9]+]]:_(i64) = G_LSHR [[MV2]], [[SUB]](i64)
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL [[C1]], [[SUB5]](i64)
    ; CHECK-NEXT: [[OR2:%[0-9]+]]:_(i64) = G_OR [[LSHR2]], [[SHL2]]
    ; CHECK-NEXT: [[LSHR3:%[0-9]+]]:_(i64) = G_LSHR [[C1]], [[SUB4]](i64)
    ; CHECK-NEXT: [[SELECT3:%[0-9]+]]:_(i64) = G_SELECT [[ICMP5]](i32), [[OR2]], [[LSHR3]]
    ; CHECK-NEXT: [[SELECT4:%[0-9]+]]:_(i64) = G_SELECT [[ICMP6]](i32), [[MV2]], [[SELECT3]]
    ; CHECK-NEXT: [[SELECT5:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i32), [[OR1]], [[SELECT4]]
    ; CHECK-NEXT: [[SELECT6:%[0-9]+]]:_(i64) = G_SELECT [[ICMP1]](i32), [[MV]], [[SELECT5]]
    ; CHECK-NEXT: %d1:_(i32), %d2:_(i32) = G_UNMERGE_VALUES [[SELECT6]](i64)
    ; CHECK-NEXT: $w0 = COPY %d2(i32)
    %0:_(i64) = COPY $x0
    %a:_(i32) = COPY $w1
    %merge:_(i160) = G_MERGE_VALUES %a, %a, %a, %a, %a
    %lshr:_(i160) = G_LSHR %merge, %0
    %d1:_(i32), %d2:_(i32), %d3:_(i32), %d4:_(i32), %d5:_(i32) = G_UNMERGE_VALUES %lshr
    $w0 = COPY %d2(i32)

...
