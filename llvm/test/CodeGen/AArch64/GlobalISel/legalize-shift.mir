    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(eq), [[TRUNC]](i64), [[C1]]
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(i64) = G_SHL [[UV]], [[TRUNC]](i64)
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[UV]], [[SUB1]](i64)
    ; CHECK-NEXT: [[SHL1:%[0-9]+]]:_(i64) = G_SHL [[UV1]], [[TRUNC]](i64)
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[LSHR]], [[SHL1]]
    ; CHECK-NEXT: [[SHL2:%[0-9]+]]:_(i64) = G_SHL [[UV]], [[SUB]](i64)
    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i32), [[SHL]], [[C1]]
    ; CHECK-NEXT: [[SELECT1:%[0-9]+]]:_(i64) = G_SELECT [[ICMP]](i32), [[OR]], [[SHL2]]
    ; CHECK-NEXT: [[SELECT2:%[0-9]+]]:_(i64) = G_SELECT [[ICMP1]](i32), [[UV1]], [[SELECT1]]
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES [[SELECT]](i64), [[SELECT2]](i64)
    ; CHECK-NEXT: $q0 = COPY [[MV]](i128)
    %0:_(i128) = COPY $q0
    %1:_(i128) = COPY $q1
    %2:_(i128) = G_SHL %0, %1
    $q0 = COPY %2

...

