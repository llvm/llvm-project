name:            test_umul_overflow_s24
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_umul_overflow_s24
    ; CHECK: %lhs_wide:_(i32) = COPY $w0
    ; CHECK-NEXT: %rhs_wide:_(i32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 16777215
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND %lhs_wide, [[C]]
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(i32) = G_AND %rhs_wide, [[C]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT %lhs_wide(i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 16777215
    ; CHECK-NEXT: [[AND2:%[0-9]+]]:_(i64) = G_AND [[ANYEXT]], [[C1]]
    ; CHECK-NEXT: [[ANYEXT1:%[0-9]+]]:_(i64) = G_ANYEXT %rhs_wide(i32)
    ; CHECK-NEXT: [[AND3:%[0-9]+]]:_(i64) = G_AND [[ANYEXT1]], [[C1]]
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[AND2]], [[AND3]]
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i64) = G_CONSTANT i64 32
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR [[MUL]], [[C2]](i64)
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[LSHR]](i64)
    ; CHECK-NEXT: [[C3:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i32) = G_MUL [[AND]], [[AND1]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[TRUNC]](i32), [[C3]]
    ; CHECK-NEXT: [[AND4:%[0-9]+]]:_(i32) = G_AND [[MUL1]], [[C]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[MUL1]](i32), [[AND4]]
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[ICMP]], [[ICMP1]]
    ; CHECK-NEXT: $w0 = COPY [[MUL1]](i32)
    ; CHECK-NEXT: $w0 = COPY [[OR]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %lhs_wide:_(i32) = COPY $w0
    %rhs_wide:_(i32) = COPY $w1
    %lhs:_(i24) = G_TRUNC %lhs_wide
    %rhs:_(i24) = G_TRUNC %rhs_wide
    %mul:_(i24), %overflow:_(i1) = G_UMULO %lhs, %rhs
    %ext_mul:_(i32) = G_ANYEXT %mul
    $w0 = COPY %ext_mul(i32)
    %ext_overflow:_(i32) = G_ANYEXT %overflow(i1)
    $w0 = COPY %ext_overflow(i32)
    RET_ReallyLR implicit $w0

...
