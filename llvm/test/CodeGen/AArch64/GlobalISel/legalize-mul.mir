# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1  %s -o - | FileCheck %s
---
name:            test_scalar_mul_small
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_scalar_mul_small
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(i32) = G_TRUNC [[COPY1]](i64)
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i32) = G_MUL [[TRUNC]], [[TRUNC1]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[MUL]](i32)
    ; CHECK-NEXT: $x0 = COPY [[ANYEXT]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i8) = G_TRUNC %0(i64)
    %3:_(i8) = G_TRUNC %1(i64)
    %4:_(i8) = G_MUL %2, %3
    %5:_(i64) = G_ANYEXT %4(i8)
    $x0 = COPY %5(i64)

...
---
name:            test_smul_overflow
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_smul_overflow
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[SMULH:%[0-9]+]]:_(i64) = G_SMULH [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 63
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(i64) = G_ASHR [[MUL]], [[C]](i64)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[SMULH]](i64), [[ASHR]]
    ; CHECK-NEXT: $x0 = COPY [[MUL]](i64)
    ; CHECK-NEXT: $w0 = COPY [[ICMP]](i32)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64), %3:_(i1) = G_SMULO %0, %1
    $x0 = COPY %2(i64)
    %4:_(i32) = G_ANYEXT %3(i1)
    $w0 = COPY %4(i32)

...
