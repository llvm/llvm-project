---
name:            test_umulo_overflow_no_invalid_mir
alignment:       4
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
  - { reg: '$x1' }
  - { reg: '$x2' }
frameInfo:
  maxAlignment:    16
stack:
  - { id: 0, size: 8, alignment: 8 }
  - { id: 1, size: 8, alignment: 8 }
  - { id: 2, size: 16, alignment: 16 }
  - { id: 3, size: 16, alignment: 8 }
machineFunctionInfo: {}
body:             |
  bb.1:
    liveins: $x0, $x1, $x2
    ; Check that the overflow result doesn't generate incorrect MIR by using a G_CONSTANT 0
    ; before it's been defined.
    ; CHECK-LABEL: name: test_umulo_overflow_no_invalid_mir
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-NEXT: [[FRAME_INDEX:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0
    ; CHECK-NEXT: [[FRAME_INDEX1:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.1
    ; CHECK-NEXT: [[FRAME_INDEX2:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.3
    ; CHECK-NEXT: G_STORE [[COPY2]](i64), [[FRAME_INDEX]](p0) :: (store (i64))
    ; CHECK-NEXT: G_STORE [[COPY1]](i64), [[FRAME_INDEX1]](p0) :: (store (i64))
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i64) = G_LOAD [[FRAME_INDEX]](p0) :: (dereferenceable load (i64))
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(i64) = G_LOAD [[FRAME_INDEX1]](p0) :: (dereferenceable load (i64))
    ; CHECK-NEXT: [[UMULH:%[0-9]+]]:_(i64) = G_UMULH [[LOAD]], [[LOAD1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[LOAD]], [[LOAD1]]
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[UMULH]](i64), [[C]]
    ; CHECK-NEXT: G_STORE [[C]](i64), [[FRAME_INDEX2]](p0) :: (store (i64), align 1)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i64) = G_ANYEXT [[ICMP]](i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[ANYEXT]], [[C1]]
    ; CHECK-NEXT: $x0 = COPY [[MUL]](i64)
    ; CHECK-NEXT: $x1 = COPY [[AND]](i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %0:_(p0) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64) = COPY $x2
    %25:_(i32) = G_CONSTANT i32 0
    %3:_(p0) = G_FRAME_INDEX %stack.0
    %4:_(p0) = G_FRAME_INDEX %stack.1
    %6:_(p0) = G_FRAME_INDEX %stack.3
    G_STORE %2(i64), %3(p0) :: (store (i64))
    G_STORE %1(i64), %4(p0) :: (store (i64))
    %7:_(i64) = G_LOAD %3(p0) :: (dereferenceable load (i64))
    %8:_(i64) = G_LOAD %4(p0) :: (dereferenceable load (i64))
    %9:_(i64), %10:_(i1) = G_UMULO %7, %8
    %31:_(i64) = G_CONSTANT i64 0
    G_STORE %31(i64), %6(p0) :: (store (i64), align 1)
    %16:_(i64) = G_ZEXT %10(i1)
    $x0 = COPY %9(i64)
    $x1 = COPY %16(i64)
    RET_ReallyLR implicit $x0

...
