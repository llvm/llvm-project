name:            test_smul_overflow_s32
body:             |
  bb.0:
    ; CHECK-LABEL: name: test_smul_overflow_s32
    ; CHECK: %lhs:_(i32) = COPY $w0
    ; CHECK-NEXT: %rhs:_(i32) = COPY $w1
    ; CHECK-NEXT: [[SEXT:%[0-9]+]]:_(i64) = G_SEXT %lhs(i32)
    ; CHECK-NEXT: [[SEXT1:%[0-9]+]]:_(i64) = G_SEXT %rhs(i32)
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[SEXT]], [[SEXT1]]
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 32
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(i64) = G_ASHR [[MUL]], [[C]](i64)
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[ASHR]](i64)
    ; CHECK-NEXT: %mul:_(i32) = G_MUL %lhs, %rhs
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 31
    ; CHECK-NEXT: [[ASHR1:%[0-9]+]]:_(i32) = G_ASHR %mul, [[C1]](i64)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ne), [[TRUNC]](i32), [[ASHR1]]
    ; CHECK-NEXT: $w0 = COPY %mul(i32)
    ; CHECK-NEXT: $w0 = COPY [[ICMP]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %lhs:_(i32) = COPY $w0
    %rhs:_(i32) = COPY $w1
    %mul:_(i32), %overflow:_(i1) = G_SMULO %lhs, %rhs
    $w0 = COPY %mul(i32)
    %ext_overflow:_(i32) = G_ANYEXT %overflow(i1)
    $w0 = COPY %ext_overflow(i32)
    RET_ReallyLR implicit $w0

...
