# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple arm64-apple-ios -run-pass=aarch64-postlegalizer-combiner -global-isel -verify-machineinstrs %s -o - | FileCheck %s

# Test that redundant_and fires before overlapping_and for and(and(x, C), C)
# where both constants are identical.
#
# Commit 3741dacd195a migrated redundant_and from
# wip_match_opcode to MIR-pattern but left overlapping_and as
# wip_match_opcode. In the generated combiner match table, wip_match_opcode
# rules run before MIR-pattern rules, so overlapping_and fired first and
# created a new G_CONSTANT (C & C = C) via MachineIRBuilder. That new
# constant lacks a register bank, which crashes the machine verifier in
# regBankSelected functions.
#
# With the fix, both rules are MIR-pattern, restoring the original ordering
# where redundant_and (in known_bits_simplifications, listed earlier in the
# combiner) takes priority and replaces the outer AND via register
# substitution — no new instructions.

---
name:            and_same_const_pre_regbankselect
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: and_same_const_pre_regbankselect
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $w0
    ; CHECK-NEXT: %c1:_(s32) = G_CONSTANT i32 255
    ; CHECK-NEXT: %inner:_(s32) = G_AND %x, %c1
    ; CHECK-NEXT: $w0 = COPY %inner(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(s32) = COPY $w0
    %c1:_(s32) = G_CONSTANT i32 255
    %c2:_(s32) = G_CONSTANT i32 255
    %inner:_(s32) = G_AND %x, %c1
    %outer:_(s32) = G_AND %inner, %c2
    $w0 = COPY %outer(s32)
    RET_ReallyLR implicit $w0
...
---
# Same test but with a regBankSelected function. Before the fix,
# overlapping_and would fire and create a G_CONSTANT without a register
# bank, crashing -verify-machineinstrs.
name:            and_same_const_regbankselected
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: and_same_const_regbankselected
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:gpr(s32) = COPY $w0
    ; CHECK-NEXT: %c1:gpr(s32) = G_CONSTANT i32 255
    ; CHECK-NEXT: %inner:gpr(s32) = G_AND %x, %c1
    ; CHECK-NEXT: $w0 = COPY %inner(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:gpr(s32) = COPY $w0
    %c1:gpr(s32) = G_CONSTANT i32 255
    %c2:gpr(s32) = G_CONSTANT i32 255
    %inner:gpr(s32) = G_AND %x, %c1
    %outer:gpr(s32) = G_AND %inner, %c2
    $w0 = COPY %outer(s32)
    RET_ReallyLR implicit $w0
...
