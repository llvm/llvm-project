# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -mattr=+sve -passes="print<gisel-value-tracking>" %s -filetype=null 2>&1 | FileCheck %s

---
name:            splat_nonzero
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
  ; CHECK-LABEL: name: @splat_nonzero
  ; CHECK-NEXT: %w:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %two:_ KnownBits:00000000000000000000000000000010 SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %x:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %splat:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
    %w:_(i32) = COPY $w0
    %c:_(i1) = G_TRUNC %w(i32)
    %one:_(i32) = G_CONSTANT i32 1
    %two:_(i32) = G_CONSTANT i32 2
    %x:_(i32) = G_SELECT %c(i1), %one, %two
    %splat:_(<4 x i32>) = G_SPLAT_VECTOR %x(i32)
...
---
name:            splat_nonzero_scalable
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
  ; CHECK-LABEL: name: @splat_nonzero_scalable
  ; CHECK-NEXT: %w:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %two:_ KnownBits:00000000000000000000000000000010 SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %x:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %splat:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
    %w:_(i32) = COPY $w0
    %c:_(i1) = G_TRUNC %w(i32)
    %one:_(i32) = G_CONSTANT i32 1
    %two:_(i32) = G_CONSTANT i32 2
    %x:_(i32) = G_SELECT %c(i1), %one, %two
    %splat:_(<vscale x 4 x i32>) = G_SPLAT_VECTOR %x(i32)
...
---
# The scalar is never zero, but each element is its low 8 bits, which are zero
# for 256.
name:            splat_wider_maybe_zero
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
  ; CHECK-LABEL: name: @splat_wider_maybe_zero
  ; CHECK-NEXT: %w:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %c:_ KnownBits:? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %big:_ KnownBits:00000000000000000000000100000000 SignBits:23 IsKnownNeverZero:1
  ; CHECK-NEXT: %x:_ KnownBits:00000000000000000000000?0000000? SignBits:23 IsKnownNeverZero:1
  ; CHECK-NEXT: %splat:_ KnownBits:0000000? SignBits:7 IsKnownNeverZero:0
    %w:_(i32) = COPY $w0
    %c:_(i1) = G_TRUNC %w(i32)
    %one:_(i32) = G_CONSTANT i32 1
    %big:_(i32) = G_CONSTANT i32 256
    %x:_(i32) = G_SELECT %c(i1), %one, %big
    %splat:_(<8 x i8>) = G_SPLAT_VECTOR %x(i32)
...
