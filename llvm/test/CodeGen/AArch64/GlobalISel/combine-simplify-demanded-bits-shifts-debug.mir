# RUN: llc -mtriple=aarch64 -run-pass=aarch64-postlegalizer-combiner -aarch64postlegalizercombiner-only-enable-rule=simplify_demanded_bits -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "aarch64"

  define void @drop_mask_debug() !dbg !10 { ret void }
  define void @nested_shift_debug() !dbg !20 { ret void }
  define void @ashr_to_lshr_debug() !dbg !40 { ret void }
  define void @shared_mask_debug() !dbg !50 { ret void }
  define void @full_demand_debug() !dbg !60 { ret void }
  define void @shared_shift_debug() !dbg !70 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!5}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/")
  !2 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !3 = !DISubroutineType(types: !4)
  !4 = !{}
  !5 = !{i32 2, !"Debug Info Version", i32 3}

  !10 = distinct !DISubprogram(name: "drop_mask_debug", scope: !1, file: !1, line: 1, type: !3, spFlags: DISPFlagDefinition, unit: !0)
  !11 = !DILocalVariable(name: "x", scope: !10, file: !1, line: 1, type: !2)
  !12 = !DILocalVariable(name: "masked", scope: !10, file: !1, line: 1, type: !2)
  !13 = !DILocalVariable(name: "sum", scope: !10, file: !1, line: 1, type: !2)
  !19 = !DILocation(line: 1, column: 1, scope: !10)

  !20 = distinct !DISubprogram(name: "nested_shift_debug", scope: !1, file: !1, line: 2, type: !3, spFlags: DISPFlagDefinition, unit: !0)
  !21 = !DILocalVariable(name: "masked", scope: !20, file: !1, line: 2, type: !2)
  !22 = !DILocalVariable(name: "shifted", scope: !20, file: !1, line: 2, type: !2)
  !29 = !DILocation(line: 2, column: 1, scope: !20)

  !40 = distinct !DISubprogram(name: "ashr_to_lshr_debug", scope: !1, file: !1, line: 4, type: !3, spFlags: DISPFlagDefinition, unit: !0)
  !41 = !DILocalVariable(name: "shifted", scope: !40, file: !1, line: 4, type: !2)
  !49 = !DILocation(line: 4, column: 1, scope: !40)

  !50 = distinct !DISubprogram(name: "shared_mask_debug", scope: !1, file: !1, line: 5, type: !3, spFlags: DISPFlagDefinition, unit: !0)
  !51 = !DILocalVariable(name: "masked", scope: !50, file: !1, line: 5, type: !2)
  !59 = !DILocation(line: 5, column: 1, scope: !50)

  !60 = distinct !DISubprogram(name: "full_demand_debug", scope: !1, file: !1, line: 6, type: !3, spFlags: DISPFlagDefinition, unit: !0)
  !61 = !DILocalVariable(name: "masked", scope: !60, file: !1, line: 6, type: !2)
  !69 = !DILocation(line: 6, column: 1, scope: !60)

  !70 = distinct !DISubprogram(name: "shared_shift_debug", scope: !1, file: !1, line: 7, type: !3, spFlags: DISPFlagDefinition, unit: !0)
  !71 = !DILocalVariable(name: "masked", scope: !70, file: !1, line: 7, type: !2)
  !72 = !DILocalVariable(name: "shifted", scope: !70, file: !1, line: 7, type: !2)
  !79 = !DILocation(line: 7, column: 1, scope: !70)
...
---
# The removed mask's debug users cannot use the unmasked value. Keep x's value.
name: drop_mask_debug
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: drop_mask_debug
    ; CHECK: DBG_VALUE %x(i32), $noreg, {{![0-9]+}}, !DIExpression()
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, {{![0-9]+}}, !DIExpression()
    ; CHECK-NEXT: DBG_VALUE_LIST {{![0-9]+}}, !DIExpression({{.*}}), $noreg, $noreg
    ; CHECK: %res:_(i32) = G_SHL %x, %amt(i64)
    %x:_(i32) = COPY $w0
    DBG_VALUE %x, $noreg, !11, !DIExpression(), debug-location !19
    %mask:_(i32) = G_CONSTANT i32 268435455
    %masked:_(i32) = G_AND %x, %mask
    DBG_VALUE %masked, $noreg, !12, !DIExpression(), debug-location !19
    DBG_VALUE_LIST !13, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus), %masked, %x, debug-location !19
    %amt:_(i64) = G_CONSTANT i64 4
    %res:_(i32) = G_SHL %masked, %amt
    $w0 = COPY %res(i32)
    RET_ReallyLR implicit $w0
...
---
# Rewriting the mask also changes the undemanded bits of the surviving SHL.
name: nested_shift_debug
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: nested_shift_debug
    ; CHECK: DBG_VALUE $noreg, $noreg, {{![0-9]+}}, !DIExpression()
    ; CHECK: DBG_VALUE $noreg, $noreg, {{![0-9]+}}, !DIExpression()
    %x:_(i32) = COPY $w0
    %mask:_(i32) = G_CONSTANT i32 -8
    %masked:_(i32) = G_AND %x, %mask
    DBG_VALUE %masked, $noreg, !21, !DIExpression(), debug-location !29
    %one:_(i64) = G_CONSTANT i64 1
    %four:_(i64) = G_CONSTANT i64 4
    %shl:_(i32) = G_SHL %masked, %one
    DBG_VALUE %shl, $noreg, !22, !DIExpression(), debug-location !29
    %res:_(i32) = G_LSHR %shl, %four
    $w0 = COPY %res(i32)
    RET_ReallyLR implicit $w0
...
---
# ASHR and LSHR agree only on the bits demanded by the final mask.
name: ashr_to_lshr_debug
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ashr_to_lshr_debug
    ; CHECK: DBG_VALUE $noreg, $noreg, {{![0-9]+}}, !DIExpression()
    %x:_(i32) = COPY $w0
    %amt:_(i64) = G_CONSTANT i64 8
    %shift:_(i32) = G_ASHR %x, %amt
    DBG_VALUE %shift, $noreg, !41, !DIExpression(), debug-location !49
    %mask:_(i32) = G_CONSTANT i32 65535
    %res:_(i32) = G_AND %shift, %mask
    $w0 = COPY %res(i32)
    RET_ReallyLR implicit $w0
...
---
# Bypassing a shared producer leaves its value and debug users unchanged.
name: shared_mask_debug
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: shared_mask_debug
    ; CHECK: %masked:_(i32) = G_AND %x, %mask
    ; CHECK-NEXT: DBG_VALUE %masked(i32), $noreg, {{![0-9]+}}, !DIExpression()
    ; CHECK: %res:_(i32) = G_SHL %x, %amt(i64)
    %x:_(i32) = COPY $w0
    %mask:_(i32) = G_CONSTANT i32 268435455
    %masked:_(i32) = G_AND %x, %mask
    DBG_VALUE %masked, $noreg, !51, !DIExpression(), debug-location !59
    %amt:_(i64) = G_CONSTANT i64 4
    %res:_(i32) = G_SHL %masked, %amt
    $w0 = COPY %res(i32)
    $w1 = COPY %masked(i32)
    RET_ReallyLR implicit $w0, implicit $w1
...
---
# Full demand makes the replacement valid for debug users as well.
name: full_demand_debug
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: full_demand_debug
    ; CHECK: DBG_VALUE %x(i32), $noreg, {{![0-9]+}}, !DIExpression()
    %x:_(i32) = COPY $w0
    %mask:_(i32) = G_CONSTANT i32 -1
    %masked:_(i32) = G_AND %x, %mask
    DBG_VALUE %masked, $noreg, !61, !DIExpression(), debug-location !69
    %zero:_(i64) = G_CONSTANT i64 0
    %res:_(i32) = G_SHL %masked, %zero
    $w0 = COPY %res(i32)
    RET_ReallyLR implicit $w0
...
---
# Recursion through a shared shift demands all its bits and preserves its value.
name: shared_shift_debug
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: shared_shift_debug
    ; CHECK: DBG_VALUE $noreg, $noreg, {{![0-9]+}}, !DIExpression()
    ; CHECK: %shift:_(i32) = G_SHL %x, %amt(i64)
    ; CHECK-NEXT: DBG_VALUE %shift(i32), $noreg, {{![0-9]+}}, !DIExpression()
    %x:_(i32) = COPY $w0
    %mask:_(i32) = G_CONSTANT i32 268435455
    %masked:_(i32) = G_AND %x, %mask
    DBG_VALUE %masked, $noreg, !71, !DIExpression(), debug-location !79
    %amt:_(i64) = G_CONSTANT i64 4
    %shift:_(i32) = G_SHL %masked, %amt
    DBG_VALUE %shift, $noreg, !72, !DIExpression(), debug-location !79
    %low:_(i32) = G_CONSTANT i32 255
    %res:_(i32) = G_AND %shift, %low
    $w0 = COPY %res(i32)
    $w1 = COPY %shift(i32)
    RET_ReallyLR implicit $w0, implicit $w1
...
