# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=aarch64 -passes="print<gisel-value-tracking>" -filetype=null %s 2>&1 | FileCheck %s

---
name: DUP
body: |
  bb.1:
    liveins: $w0
  ; CHECK-LABEL: name: @DUP
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1
  ; CHECK-NEXT: %1:_ KnownBits:00000000000000000000000000001111 SignBits:28
  ; CHECK-NEXT: %2:_ KnownBits:0000000000000000000000000000???? SignBits:28
  ; CHECK-NEXT: %3:fpr KnownBits:0000000000000000000000000000???? SignBits:28
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_CONSTANT i32 15
    %2:_(i32) = G_AND %0, %1
    %3:fpr(<4 x i32>) = G_DUP %2(i32)
    $q0 = COPY %3:fpr(<4 x i32>)
...
---
name: DUP_implicit_trunc
body: |
  bb.1:
    liveins: $w0
  ; CHECK-LABEL: name: @DUP_implicit_trunc
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1
  ; CHECK-NEXT: %1:_ KnownBits:00000000000000000000000000001000 SignBits:28
  ; CHECK-NEXT: %2:_ KnownBits:????????????????????????????1??? SignBits:1
  ; CHECK-NEXT: %3:fpr KnownBits:????????????1??? SignBits:1
    %0:_(i32) = COPY $w0
    %1:_(i32) = G_CONSTANT i32 8
    %2:_(i32) = G_OR %0, %1
    %3:fpr(<8 x i16>) = G_DUP %2(i32)
    $q0 = COPY %3:fpr(<8 x i16>)
...
