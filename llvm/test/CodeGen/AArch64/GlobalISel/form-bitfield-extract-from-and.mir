# RUN: llc -mtriple aarch64 -run-pass=aarch64-postlegalizer-combiner --aarch64postlegalizercombiner-only-enable-rule="bitfield_extract_from_and" -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple aarch64 -passes=aarch64-postlegalizer-combiner --aarch64postlegalizercombiner-only-enable-rule="bitfield_extract_from_and" %s -o - | FileCheck %s
# REQUIRES: asserts

# Check that we can combine
#
# and (lshr x, cst), mask -> ubfx x, cst, width

# LSB = 5
# Width = LSB + trailing_ones(255) - 1 =
#         5 + 8 - 1 = 12

...
---
name:            ubfx_s32
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $w0


    ; CHECK-LABEL: name: ubfx_s32
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %lsb:_(i32) = G_CONSTANT i32 5
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %and:_(i32) = G_UBFX %x, %lsb(i32), [[C]]
    ; CHECK-NEXT: $w0 = COPY %and(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %lsb:_(i32) = G_CONSTANT i32 5
    %mask:_(i32) = G_CONSTANT i32 255
    %shift:_(i32) = G_LSHR %x, %lsb
    %and:_(i32) = G_AND %shift, %mask
    $w0 = COPY %and
    RET_ReallyLR implicit $w0

# LSB = 5
# Width = LSB + trailing_ones(1) - 1 =
#          5 + 1 - 1 = 5

