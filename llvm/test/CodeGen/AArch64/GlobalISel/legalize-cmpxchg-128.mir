    %3:_(i64) = COPY $x1
    %4:_(i64) = COPY $x2
    %1:_(i128) = G_MERGE_VALUES %3(i64), %4(i64)
    %5:_(i64) = COPY $x3
    %6:_(i64) = COPY $x4
    %2:_(i128) = G_MERGE_VALUES %5(i64), %6(i64)
