    ; CHECK-NOLSE-NEXT: [[COPY7:%[0-9]+]]:gpr64(i64) = COPY [[COPY3]](i64)
    ; CHECK-NOLSE-NEXT: [[COPY8:%[0-9]+]]:gpr64(i64) = COPY [[COPY4]](i64)
    ; CHECK-NOLSE-NEXT: early-clobber %14:gpr64common(i64), early-clobber %15:gpr64common(i64), early-clobber %17:gpr32common = CMP_SWAP_128_ACQUIRE [[COPY]](p0), [[COPY5]](i64), [[COPY6]](i64), [[COPY7]](i64), [[COPY8]](i64) :: (load store acquire acquire (i128))
    ; CHECK-NOLSE-NEXT: [[COPY9:%[0-9]+]]:gpr64 = COPY %17
    ; CHECK-NOLSE-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES %14(i64), %15(i64)
