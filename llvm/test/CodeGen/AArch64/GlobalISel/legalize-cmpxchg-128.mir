    ; CHECK-NOLSE-NEXT: [[COPY4:%[0-9]+]]:_(i64) = COPY $x4
    ; CHECK-NOLSE-NEXT: [[COPY5:%[0-9]+]]:gpr64(i64) = COPY [[COPY1]](i64)
