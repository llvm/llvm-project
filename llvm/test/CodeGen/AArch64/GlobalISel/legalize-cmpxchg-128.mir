    ; CHECK-LSE-NEXT: [[REG_SEQUENCE1:%[0-9]+]]:xseqpairsclass(s128) = REG_SEQUENCE [[COPY3]](i64), %subreg.sube64, [[COPY4]](i64), %subreg.subo64
