    ; CHECK-NOLSE-NEXT: G_STORE [[COPY10]](i128), [[COPY]](p0) :: (store (i128))
    ; CHECK-NOLSE-NEXT: RET_ReallyLR
    ;
    ; CHECK-LSE-LABEL: name: compare_swap_128
    ; CHECK-LSE: liveins: $x0_x1, $x1, $x0, $x1, $x2, $x3, $x4
    ; CHECK-LSE-NEXT: {{  $}}
    ; CHECK-LSE-NEXT: [[COPY:%[0-9]+]]:gpr64sp(p0) = COPY $x0
    ; CHECK-LSE-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-LSE-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-LSE-NEXT: [[COPY3:%[0-9]+]]:_(i64) = COPY $x3
    ; CHECK-LSE-NEXT: [[COPY4:%[0-9]+]]:_(i64) = COPY $x4
