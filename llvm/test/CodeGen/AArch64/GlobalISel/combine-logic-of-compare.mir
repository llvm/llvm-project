# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -debugify-and-strip-all-safe -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs -mtriple aarch64-unknown-unknown %s -o - | FileCheck %s
---
# icmp (x, 1) && icmp (x, 2) -> x
name:            test_icmp_and_icmp
body:             |
  bb.1:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: test_icmp_and_icmp
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: %one:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(i1) = G_ICMP intpred(eq), [[COPY]](i64), %one
    ; CHECK-NEXT: %zext:_(i64) = G_ZEXT [[ICMP]](i1)
    ; CHECK-NEXT: $x0 = COPY %zext(i64)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64) = COPY $x2
    %one:_(i64) = G_CONSTANT i64 1
    %two:_(i64) = G_CONSTANT i64 2
    %cmp1:_(i1) = G_ICMP intpred(eq), %0(i64), %one
    %cmp2:_(i1) = G_ICMP intpred(ne), %0(i64), %two
    %and:_(i1) = G_AND %cmp1, %cmp2
    %zext:_(i64) = G_ZEXT %and(i1)
    $x0 = COPY %zext
...
---
