# fcmp (x, y) && fcmp (x, y) -> fcmp(x, y)
name:            test_fcmp_and_fcmp_with_vectors
body:             |
  bb.1:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: test_fcmp_and_fcmp_with_vectors
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i1) = G_CONSTANT i1 false
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x i1>) = G_BUILD_VECTOR [[C]](i1), [[C]](i1)
    ; CHECK-NEXT: %zext:_(<2 x i64>) = G_ZEXT [[BUILD_VECTOR]](<2 x i1>)
    ; CHECK-NEXT: $q0 = COPY %zext(<2 x i64>)
    %0:_(f64) = COPY $x0
    %1:_(f64) = COPY $x1
    %2:_(f64) = COPY $x2
    %3:_(f64) = COPY $x3
    %v8:_(<2 x f64>) = G_BUILD_VECTOR %0(f64), %1(f64)
    %v9:_(<2 x f64>) = G_BUILD_VECTOR %2(f64), %3(f64)
    %cmp1:_(<2 x i1>) = G_FCMP floatpred(oeq), %v8(<2 x f64>), %v9
    %cmp2:_(<2 x i1>) = G_FCMP floatpred(olt), %v8(<2 x f64>), %v9
    %and:_(<2 x i1>) = G_AND %cmp1, %cmp2
    %zext:_(<2 x i64>) = G_ZEXT %and(<2 x i1>)
    $q0 = COPY %zext
...
---
name:            test_dont_combine_pointers
body:             |
  ; CHECK-LABEL: name: test_dont_combine_pointers
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(p0) = G_CONSTANT i64 0
