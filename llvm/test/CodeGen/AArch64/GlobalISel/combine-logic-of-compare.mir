# icmp (x, 9) && icmp (x, 2)) -> x
# buildConstant 0
# buildICmp ult, R1, NewC
# buildZExtOrTrunc -> COPY
# erase G_AND
# x > 9 && x < 2 => false
name:            test_icmp_and_icmp_9_2
body:             |
  bb.1:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: test_icmp_and_icmp_9_2
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %zext:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: $x0 = COPY %zext(i64)
    %0:_(i64) = COPY $x0
    %nine:_(i64) = G_CONSTANT i64 9
    %two:_(i64) = G_CONSTANT i64 2
    %cmp1:_(i1) = G_ICMP intpred(sgt), %0(i64), %nine
    %cmp2:_(i1) = G_ICMP intpred(slt), %0(i64), %two
    %and:_(i1) = G_AND %cmp1, %cmp2
    %zext:_(i64) = G_ZEXT %and(i1)
    $x0 = COPY %zext
...
---
# icmp (x, v1) && icmp (x, v2)) -> x
name:            test_icmp_and_icmp_with_vectors
body:             |
  bb.1:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: test_icmp_and_icmp_with_vectors
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i64) = COPY $x3
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:_(i64) = COPY $x4
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:_(i64) = COPY $x5
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:_(i64) = COPY $x6
    ; CHECK-NEXT: [[COPY7:%[0-9]+]]:_(i64) = COPY $x7
    ; CHECK-NEXT: %v1:_(<2 x i64>) = G_BUILD_VECTOR [[COPY]](i64), [[COPY1]](i64)
    ; CHECK-NEXT: %v2:_(<2 x i64>) = G_BUILD_VECTOR [[COPY2]](i64), [[COPY3]](i64)
    ; CHECK-NEXT: %v3:_(<2 x i64>) = G_BUILD_VECTOR [[COPY4]](i64), [[COPY5]](i64)
    ; CHECK-NEXT: %v4:_(<2 x i64>) = G_BUILD_VECTOR [[COPY6]](i64), [[COPY7]](i64)
    ; CHECK-NEXT: %cmp1:_(<2 x i1>) = G_ICMP intpred(ne), %v1(<2 x i64>), %v2
    ; CHECK-NEXT: %cmp2:_(<2 x i1>) = G_ICMP intpred(eq), %v3(<2 x i64>), %v4
    ; CHECK-NEXT: %and:_(<2 x i1>) = G_AND %cmp1, %cmp2
    ; CHECK-NEXT: %zext:_(<2 x i64>) = G_ZEXT %and(<2 x i1>)
    ; CHECK-NEXT: $q0 = COPY %zext(<2 x i64>)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64) = COPY $x2
    %3:_(i64) = COPY $x3
    %4:_(i64) = COPY $x4
    %5:_(i64) = COPY $x5
    %6:_(i64) = COPY $x6
    %7:_(i64) = COPY $x7
    %nine:_(i64) = G_CONSTANT i64 9
    %two:_(i64) = G_CONSTANT i64 2
    %v1:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    %v2:_(<2 x i64>) = G_BUILD_VECTOR %2(i64), %3(i64)
    %v3:_(<2 x i64>) = G_BUILD_VECTOR %4(i64), %5(i64)
    %v4:_(<2 x i64>) = G_BUILD_VECTOR %6(i64), %7(i64)
    %cmp1:_(<2 x i1>) = G_ICMP intpred(ne), %v1(<2 x i64>), %v2
    %cmp2:_(<2 x i1>) = G_ICMP intpred(eq), %v3(<2 x i64>), %v4
    %and:_(<2 x i1>) = G_AND %cmp1, %cmp2
    %zext:_(<2 x i64>) = G_ZEXT %and(<2 x i1>)
    $q0 = COPY %zext
...
