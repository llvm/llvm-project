---
name:            s8
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: s8
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 256
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[DEF]], [[C]]
    ; CHECK-NEXT: [[BITREVERSE:%[0-9]+]]:_(i32) = G_BITREVERSE [[OR]]
    ; CHECK-NEXT: [[CTLZ:%[0-9]+]]:_(i32) = G_CTLZ [[BITREVERSE]](i32)
    ; CHECK-NEXT: $w0 = COPY [[CTLZ]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    ;
    ; CHECK-CSSC-LABEL: name: s8
    ; CHECK-CSSC: liveins: $w0
    ; CHECK-CSSC-NEXT: {{  $}}
    ; CHECK-CSSC-NEXT: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-CSSC-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 256
    ; CHECK-CSSC-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[DEF]], [[C]]
    ; CHECK-CSSC-NEXT: [[CTTZ:%[0-9]+]]:_(i32) = G_CTTZ [[OR]](i32)
    ; CHECK-CSSC-NEXT: $w0 = COPY [[CTTZ]](i32)
    ; CHECK-CSSC-NEXT: RET_ReallyLR implicit $w0
    %val:_(i8) = G_IMPLICIT_DEF
    %cttz:_(i8) = G_CTTZ_ZERO_POISON %val(i8)
    %ext:_(i32) = G_ANYEXT %cttz(i8)
    $w0 = COPY %ext(i32)
    RET_ReallyLR implicit $w0

