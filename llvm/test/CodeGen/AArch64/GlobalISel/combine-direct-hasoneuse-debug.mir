# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -debugify-and-strip-all-safe \
# RUN:   -run-pass=aarch64-prelegalizer-combiner \
# RUN:   -aarch64prelegalizercombiner-only-enable-rule=lshr_of_trunc_of_lshr,combine_insert_vec_elts_build_vector \
# RUN:   %s -o - | FileCheck %s
# REQUIRES: asserts

---
name: lshr_trunc_lshr_debug_uses
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: lshr_trunc_lshr_debug_uses
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %src:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 12
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i64) = G_LSHR %src, [[C]](i64)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 268435455
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i64) = G_AND [[LSHR]], [[C1]]
    ; CHECK-NEXT: %dst:_(i32) = G_TRUNC [[AND]](i64)
    ; CHECK-NEXT: $w0 = COPY %dst(i32)
    %src:_(i64) = COPY $x0
    %c1:_(i64) = G_CONSTANT i64 8
    %inner:_(i64) = G_LSHR %src, %c1
    %trunc:_(i32) = G_TRUNC %inner
    %c2:_(i32) = G_CONSTANT i32 4
    %dst:_(i32) = G_LSHR %trunc, %c2
    $w0 = COPY %dst(i32)
...
---
name: insert_vector_chain_debug_use
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: insert_vector_chain_debug_use
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(i32) = COPY $w0
    ; CHECK-NEXT: %b:_(i32) = COPY $w1
    ; CHECK-NEXT: %second:_(<2 x i32>) = G_BUILD_VECTOR %a(i32), %b(i32)
    ; CHECK-NEXT: $x0 = COPY %second(<2 x i32>)
    %a:_(i32) = COPY $w0
    %b:_(i32) = COPY $w1
    %undef:_(<2 x i32>) = G_IMPLICIT_DEF
    %zero:_(i64) = G_CONSTANT i64 0
    %one:_(i64) = G_CONSTANT i64 1
    %first:_(<2 x i32>) = G_INSERT_VECTOR_ELT %undef, %a, %zero
    %second:_(<2 x i32>) = G_INSERT_VECTOR_ELT %first, %b, %one
    $x0 = COPY %second(<2 x i32>)
...
