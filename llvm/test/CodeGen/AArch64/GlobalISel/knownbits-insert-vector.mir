  ; CHECK-NEXT: %5:_ KnownBits:00000?1? SignBits:5 IsKnownNeverZero:1
    %idx:_(i64) = G_CONSTANT i64 1
    %1:_(i8) = G_CONSTANT i8 3
    %2:_(i8) = G_CONSTANT i8 15
    %3:_(<2 x i8>) = G_BUILD_VECTOR %1, %2
    %4:_(i8) = G_CONSTANT i8 6
    %5:_(<2 x i8>) = G_INSERT_VECTOR_ELT %3, %4, %idx
...
