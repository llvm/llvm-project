  ; CHECK-NEXT: %e0:_ KnownBits:???????????????? SignBits:1 IsKnownNeverZero:0
    %w0:_(i32) = COPY $w0
    %w1:_(i32) = COPY $w1
    %a:_(i8) = G_TRUNC %w0
    %s:_(i16) = G_SEXT %a
    %v:_(<4 x i16>) = G_BUILD_VECTOR %s, %s, %s, %s
    %idx0:_(i64) = G_CONSTANT i64 0
    %r:_(<4 x i16>) = G_INSERT_VECTOR_ELT %v, %w1, %idx0
    %e0:_(i16) = G_EXTRACT_VECTOR_ELT %r, %idx0
...
