---
name:            test_freeze_s64
body: |
  bb.0.entry:
    liveins: $x0

    ; CHECK-LABEL: name: test_freeze_s64
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x0:_(i64) = COPY $x0
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:_(i64) = G_FREEZE %x0
    ; CHECK-NEXT: $x0 = COPY [[FREEZE]](i64)
    %x0:_(i64) = COPY $x0
    %1:_(i64) = G_FREEZE %x0
    $x0 = COPY %1(i64)
...
