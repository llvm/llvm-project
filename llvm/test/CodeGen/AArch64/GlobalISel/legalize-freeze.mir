name:            test_freeze_v4s1_select
body: |
  bb.0.entry:
    liveins: $q0, $q1
    ; CHECK-LABEL: name: test_freeze_v4s1_select
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<4 x f32>) = COPY $q0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(<4 x f32>) = COPY $q1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float 0.000000e+00
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<4 x f32>) = G_BUILD_VECTOR [[C]](f32), [[C]](f32), [[C]](f32), [[C]](f32)
    ; CHECK-NEXT: [[FCMP:%[0-9]+]]:_(<4 x i32>) = nnan ninf nsz arcp contract afn reassoc G_FCMP floatpred(olt), [[COPY]](<4 x f32>), [[BUILD_VECTOR]]
    ; CHECK-NEXT: [[FCMP1:%[0-9]+]]:_(<4 x i32>) = nnan ninf nsz arcp contract afn reassoc G_FCMP floatpred(ogt), [[COPY1]](<4 x f32>), [[COPY]]
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(<4 x i16>) = G_TRUNC [[FCMP1]](<4 x i32>)
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:_(<4 x i16>) = G_FREEZE [[TRUNC]]
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(<4 x i16>) = G_TRUNC [[FCMP]](<4 x i32>)
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(<4 x i16>) = G_AND [[TRUNC1]], [[FREEZE]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(<4 x i32>) = G_ANYEXT [[AND]](<4 x i16>)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[BUILD_VECTOR1:%[0-9]+]]:_(<4 x i32>) = G_BUILD_VECTOR [[C1]](i32), [[C1]](i32), [[C1]](i32), [[C1]](i32)
    ; CHECK-NEXT: [[AND1:%[0-9]+]]:_(<4 x i32>) = G_AND [[ANYEXT]], [[BUILD_VECTOR1]]
    ; CHECK-NEXT: $q0 = COPY [[AND1]](<4 x i32>)
    %1:_(<4 x f32>) = COPY $q0
    %2:_(<4 x f32>) = COPY $q1
    %3:_(f32) = G_FCONSTANT float 0.0
    %4:_(<4 x f32>) = G_BUILD_VECTOR %3, %3, %3, %3
    %5:_(i1) = G_CONSTANT i1 false
    %6:_(<4 x i1>) = nnan ninf nsz arcp contract afn reassoc G_FCMP floatpred(olt), %1:_(<4 x f32>), %4:_
    %7:_(<4 x i1>) = nnan ninf nsz arcp contract afn reassoc G_FCMP floatpred(ogt), %2:_(<4 x f32>), %1:_
    %8:_(<4 x i1>) = G_FREEZE %7
    %9:_(<4 x i1>) = G_AND %6, %8
    %10:_(<4 x i32>) = G_ZEXT %9
    $q0 = COPY %10
