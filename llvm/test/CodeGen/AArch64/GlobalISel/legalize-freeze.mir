    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(<8 x i8>) = G_TRUNC [[BUILD_VECTOR]](<8 x i16>)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(<4 x i8>), [[UV1:%[0-9]+]]:_(<4 x i8>) = G_UNMERGE_VALUES [[TRUNC]](<8 x i8>)
    ; CHECK-NEXT: [[FREEZE:%[0-9]+]]:_(<4 x i8>) = G_FREEZE [[UV]]
    ; CHECK-NEXT: [[UV2:%[0-9]+]]:_(i8), [[UV3:%[0-9]+]]:_(i8), [[UV4:%[0-9]+]]:_(i8), [[UV5:%[0-9]+]]:_(i8) = G_UNMERGE_VALUES [[FREEZE]](<4 x i8>)
    ; CHECK-NEXT: %undef:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %ext0:_(i32) = G_ZEXT [[UV2]](i8)
    ; CHECK-NEXT: %ext1:_(i32) = G_ZEXT [[UV3]](i8)
    ; CHECK-NEXT: %ext2:_(i32) = G_ZEXT [[UV4]](i8)
    ; CHECK-NEXT: %res:_(<4 x i32>) = G_BUILD_VECTOR %ext0(i32), %ext1(i32), %ext2(i32), %undef(i32)
