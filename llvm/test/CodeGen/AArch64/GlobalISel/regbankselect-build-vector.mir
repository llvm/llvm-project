---
name:            fed_by_fp_load
alignment:       4
legalized:       true
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
  - { reg: '$x1' }
  - { reg: '$x2' }
  - { reg: '$s0' }
frameInfo:
  maxAlignment:    1
body:             |
  bb.1:
    liveins: $s0, $x0, $x1, $x2

    ; CHECK-LABEL: name: fed_by_fp_load
    ; CHECK: liveins: $s0, $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(p0) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:gpr(i64) = G_CONSTANT i64 328
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:gpr(p0) = G_PTR_ADD [[COPY]], [[C]](i64)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:gpr(i64) = G_CONSTANT i64 344
    ; CHECK-NEXT: [[PTR_ADD1:%[0-9]+]]:gpr(p0) = G_PTR_ADD [[COPY]], [[C1]](i64)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:fpr(i32) = G_LOAD [[PTR_ADD]](p0) :: (load (i32))
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:fpr(i32) = G_LOAD [[PTR_ADD1]](p0) :: (load (i32))
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:fpr(<2 x i32>) = G_BUILD_VECTOR [[LOAD]](i32), [[LOAD1]](i32)
    ; CHECK-NEXT: $d0 = COPY [[BUILD_VECTOR]](<2 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %0:_(p0) = COPY $x0
    %4:_(i64) = G_CONSTANT i64 328
    %5:_(p0) = G_PTR_ADD %0, %4(i64)
    %6:_(i64) = G_CONSTANT i64 344
    %7:_(p0) = G_PTR_ADD %0, %6(i64)
    %15:_(i32) = G_LOAD %5(p0) :: (load (i32))
    %20:_(i32) = G_LOAD %7(p0) :: (load (i32))
    %21:_(<2 x i32>) = G_BUILD_VECTOR %15(i32), %20(i32)
    $d0 = COPY %21(<2 x i32>)
    RET_ReallyLR implicit $d0

...
