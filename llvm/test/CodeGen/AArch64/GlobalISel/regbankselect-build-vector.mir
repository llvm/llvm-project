# RUN: llc -O0 -mtriple arm64-- -run-pass=reg-bank-select -verify-machineinstrs %s -o - | FileCheck %s
---
name:            build_vec_f16
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0

    ; Check that s16 operands are assigned fpr as we don't have 16 bit gpr regs.
    ; CHECK-LABEL: name: build_vec_f16
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr(i32) = COPY $w0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:gpr(i16) = G_TRUNC [[COPY]](i32)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY7:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[COPY8:%[0-9]+]]:fpr(i16) = COPY [[TRUNC]](i16)
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:fpr(<8 x i16>) = G_BUILD_VECTOR [[COPY1]](i16), [[COPY2]](i16), [[COPY3]](i16), [[COPY4]](i16), [[COPY5]](i16), [[COPY6]](i16), [[COPY7]](i16), [[COPY8]](i16)
    ; CHECK-NEXT: $q0 = COPY [[BUILD_VECTOR]](<8 x i16>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(i32) = COPY $w0
    %1:_(i16) = G_TRUNC %0(i32)
    %2:_(<8 x i16>) = G_BUILD_VECTOR %1(i16), %1(i16), %1(i16), %1(i16), %1(i16), %1(i16), %1(i16), %1(i16)
    $q0 = COPY %2(<8 x i16>)
    RET_ReallyLR implicit $q0

...
---
name:            g_constant_operands_on_gpr
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.1:
    ; Check that we assign GPR to the operands even though they're < 32b in size.
    ; They're all constant, so we can select it via a constant-pool load if needed
    ; and this form is more amenable to selection by patterns (without x-bank copies).
    ; CHECK-LABEL: name: g_constant_operands_on_gpr
    ; CHECK: [[C:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:gpr(i8) = G_TRUNC [[C]](i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 10
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:gpr(i8) = G_TRUNC [[C1]](i32)
    ; CHECK-NEXT: [[C2:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[TRUNC2:%[0-9]+]]:gpr(i8) = G_TRUNC [[C2]](i32)
    ; CHECK-NEXT: [[C3:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 11
    ; CHECK-NEXT: [[TRUNC3:%[0-9]+]]:gpr(i8) = G_TRUNC [[C3]](i32)
    ; CHECK-NEXT: [[C4:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: [[TRUNC4:%[0-9]+]]:gpr(i8) = G_TRUNC [[C4]](i32)
    ; CHECK-NEXT: [[C5:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 44
    ; CHECK-NEXT: [[TRUNC5:%[0-9]+]]:gpr(i8) = G_TRUNC [[C5]](i32)
    ; CHECK-NEXT: [[C6:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 22
    ; CHECK-NEXT: [[TRUNC6:%[0-9]+]]:gpr(i8) = G_TRUNC [[C6]](i32)
    ; CHECK-NEXT: [[C7:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 19
    ; CHECK-NEXT: [[TRUNC7:%[0-9]+]]:gpr(i8) = G_TRUNC [[C7]](i32)
    ; CHECK-NEXT: [[C8:%[0-9]+]]:gpr(i32) = G_CONSTANT i32 55
    ; CHECK-NEXT: [[TRUNC8:%[0-9]+]]:gpr(i8) = G_TRUNC [[C8]](i32)
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr(i8) = COPY [[TRUNC]](i8)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr(i8) = COPY [[TRUNC1]](i8)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr(i8) = COPY [[TRUNC2]](i8)
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fpr(i8) = COPY [[TRUNC3]](i8)
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:fpr(i8) = COPY [[TRUNC4]](i8)
    ; CHECK-NEXT: [[COPY5:%[0-9]+]]:fpr(i8) = COPY [[TRUNC]](i8)
    ; CHECK-NEXT: [[COPY6:%[0-9]+]]:fpr(i8) = COPY [[TRUNC1]](i8)
    ; CHECK-NEXT: [[COPY7:%[0-9]+]]:fpr(i8) = COPY [[TRUNC5]](i8)
    ; CHECK-NEXT: [[COPY8:%[0-9]+]]:fpr(i8) = COPY [[TRUNC6]](i8)
    ; CHECK-NEXT: [[COPY9:%[0-9]+]]:fpr(i8) = COPY [[TRUNC4]](i8)
    ; CHECK-NEXT: [[COPY10:%[0-9]+]]:fpr(i8) = COPY [[TRUNC]](i8)
    ; CHECK-NEXT: [[COPY11:%[0-9]+]]:fpr(i8) = COPY [[TRUNC7]](i8)
    ; CHECK-NEXT: [[COPY12:%[0-9]+]]:fpr(i8) = COPY [[TRUNC2]](i8)
    ; CHECK-NEXT: [[COPY13:%[0-9]+]]:fpr(i8) = COPY [[TRUNC3]](i8)
    ; CHECK-NEXT: [[COPY14:%[0-9]+]]:fpr(i8) = COPY [[TRUNC4]](i8)
    ; CHECK-NEXT: [[COPY15:%[0-9]+]]:fpr(i8) = COPY [[TRUNC8]](i8)
    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:fpr(<16 x i8>) = G_BUILD_VECTOR [[COPY]](i8), [[COPY1]](i8), [[COPY2]](i8), [[COPY3]](i8), [[COPY4]](i8), [[COPY5]](i8), [[COPY6]](i8), [[COPY7]](i8), [[COPY8]](i8), [[COPY9]](i8), [[COPY10]](i8), [[COPY11]](i8), [[COPY12]](i8), [[COPY13]](i8), [[COPY14]](i8), [[COPY15]](i8)
    ; CHECK-NEXT: $q0 = COPY [[BUILD_VECTOR]](<16 x i8>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %1:_(i8) = G_CONSTANT i8 4
    %2:_(i8) = G_CONSTANT i8 10
    %3:_(i8) = G_CONSTANT i8 3
    %4:_(i8) = G_CONSTANT i8 11
    %5:_(i8) = G_CONSTANT i8 15
    %6:_(i8) = G_CONSTANT i8 44
    %7:_(i8) = G_CONSTANT i8 22
    %8:_(i8) = G_CONSTANT i8 19
    %9:_(i8) = G_CONSTANT i8 55
    %0:_(<16 x i8>) = G_BUILD_VECTOR %1(i8), %2(i8), %3(i8), %4(i8), %5(i8), %1(i8), %2(i8), %6(i8), %7(i8), %5(i8), %1(i8), %8(i8), %3(i8), %4(i8), %5(i8), %9(i8)
    $q0 = COPY %0(<16 x i8>)
    RET_ReallyLR implicit $q0

