# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple aarch64 -mattr=+sve -passes="print<gisel-value-tracking-fpclass>" %s -filetype=null 2>&1 | FileCheck %s

---
name:            splat_fconstant
body:             |
  bb.0:
  ; CHECK-LABEL: name: @splat_fconstant
  ; CHECK-NEXT: %c:_ FPClasses:(pnorm) SignBitKnown:0
  ; CHECK-NEXT: %splat:_ FPClasses:(pnorm) SignBitKnown:0
    %c:_(f32) = G_FCONSTANT float 1.0
    %splat:_(<4 x f32>) = G_SPLAT_VECTOR %c(f32)
...
---
name:            splat_fconstant_scalable
body:             |
  bb.0:
  ; CHECK-LABEL: name: @splat_fconstant_scalable
  ; CHECK-NEXT: %c:_ FPClasses:(pnorm) SignBitKnown:0
  ; CHECK-NEXT: %splat:_ FPClasses:(pnorm) SignBitKnown:0
    %c:_(f32) = G_FCONSTANT float 1.0
    %splat:_(<vscale x 4 x f32>) = G_SPLAT_VECTOR %c(f32)
...
---
name:            splat_fabs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $s0
  ; CHECK-LABEL: name: @splat_fabs
  ; CHECK-NEXT: %x:_ FPClasses:(all) SignBitKnown:?
  ; CHECK-NEXT: %abs:_ FPClasses:(nan pinf pzero psub pnorm) SignBitKnown:0
  ; CHECK-NEXT: %splat:_ FPClasses:(nan pinf pzero psub pnorm) SignBitKnown:0
    %x:_(f32) = COPY $s0
    %abs:_(f32) = G_FABS %x
    %splat:_(<4 x f32>) = G_SPLAT_VECTOR %abs(f32)
...
---
# Each element is the low 16 bits of the float, which are not a half 1.0.
name:            splat_fconstant_wider
body:             |
  bb.0:
  ; CHECK-LABEL: name: @splat_fconstant_wider
  ; CHECK-NEXT: %c:_ FPClasses:(pnorm) SignBitKnown:0
  ; CHECK-NEXT: %splat:_ FPClasses:(all) SignBitKnown:?
    %c:_(f32) = G_FCONSTANT float 1.0
    %splat:_(<4 x f16>) = G_SPLAT_VECTOR %c(f32)
...
---
# half and bfloat have the same width but different formats. 0x7C00 is +inf as
# a half but a normal number as a bfloat.
name:            splat_fconstant_other_format
body:             |
  bb.0:
  ; CHECK-LABEL: name: @splat_fconstant_other_format
  ; CHECK-NEXT: %c:_ FPClasses:(pinf) SignBitKnown:0
  ; CHECK-NEXT: %splat:_ FPClasses:(all) SignBitKnown:?
    %c:_(f16) = G_FCONSTANT half 0xH7C00
    %splat:_(<8 x bf16>) = G_SPLAT_VECTOR %c(f16)
...
