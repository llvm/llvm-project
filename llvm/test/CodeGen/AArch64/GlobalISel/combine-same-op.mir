    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %xor:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: $x0 = COPY %xor(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %x:_(i64) = COPY $x0
    %xor:_(i64) = G_XOR %x, %x
    $x0 = COPY %xor
    RET_ReallyLR implicit $x0

...
