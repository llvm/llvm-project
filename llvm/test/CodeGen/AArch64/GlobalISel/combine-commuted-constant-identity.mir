# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner \
# RUN:   -aarch64prelegalizercombiner-only-enable-rule=right_identity_one_int,G_MUL_commute_constant_to_rhs,constant_fold_binop \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Both operands are recognized as constants, so canonicalization does not
# commute them. Constant folding cannot handle the extension or vector splats.
# The commuted identity rule must still be available.

---
name: mul_one_zext_constant
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: mul_one_zext_constant
    ; CHECK: %five:_(i32) = G_CONSTANT i32 5
    ; CHECK-NEXT: %wide:_(i64) = G_ZEXT %five(i32)
    ; CHECK-NEXT: $x0 = COPY %wide(i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %one:_(i64) = G_CONSTANT i64 1
    %five:_(i32) = G_CONSTANT i32 5
    %wide:_(i64) = G_ZEXT %five(i32)
    %mul:_(i64) = G_MUL %one, %wide
    $x0 = COPY %mul(i64)
    RET_ReallyLR implicit $x0
...
---
name: mul_one_splat_constant
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: mul_one_splat_constant
    ; CHECK: %five:_(i32) = G_CONSTANT i32 5
    ; CHECK-NEXT: %fives:_(<2 x i32>) = G_BUILD_VECTOR %five(i32), %five(i32)
    ; CHECK-NEXT: $d0 = COPY %fives(<2 x i32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $d0
    %one:_(i32) = G_CONSTANT i32 1
    %five:_(i32) = G_CONSTANT i32 5
    %ones:_(<2 x i32>) = G_BUILD_VECTOR %one(i32), %one(i32)
    %fives:_(<2 x i32>) = G_BUILD_VECTOR %five(i32), %five(i32)
    %mul:_(<2 x i32>) = G_MUL %ones, %fives
    $d0 = COPY %mul(<2 x i32>)
    RET_ReallyLR implicit $d0
...
