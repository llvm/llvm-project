# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# When every element of a build_vector is extracted, the extracts are replaced
# by the sources and the build_vector is erased. Its debug use is salvaged as
# one fragment per element instead of referring to an erased register.

--- |
  define void @extract_all_elts() !dbg !4 { ret void }

  !llvm.module.flags = !{!0}
  !llvm.dbg.cu = !{!1}
  !0 = !{i32 2, !"Debug Info Version", i32 3}
  !1 = distinct !DICompileUnit(language: DW_LANG_C11, file: !2, emissionKind: FullDebug)
  !2 = !DIFile(filename: "t.c", directory: "/")
  !3 = !DISubroutineType(types: !{null})
  !4 = distinct !DISubprogram(name: "extract_all_elts", scope: !2, file: !2, type: !3, spFlags: DISPFlagDefinition, unit: !1)
  !5 = !DILocalVariable(name: "v", scope: !4, file: !2)
  !6 = !DILocation(line: 1, scope: !4)
...

# CHECK-LABEL: name: extract_all_elts
# CHECK-NOT:   G_BUILD_VECTOR
# CHECK:       DBG_VALUE %a(i64), $noreg, !{{[0-9]+}}, !DIExpression(DW_OP_LLVM_fragment, 0, 64)
# CHECK-NEXT:  DBG_VALUE %b(i64), $noreg, !{{[0-9]+}}, !DIExpression(DW_OP_LLVM_fragment, 64, 64)
# CHECK-NOT:   G_EXTRACT_VECTOR_ELT
---
name:            extract_all_elts
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1
    %a:_(i64) = COPY $x0
    %b:_(i64) = COPY $x1
    %bv:_(<2 x i64>) = G_BUILD_VECTOR %a(i64), %b(i64)
    DBG_VALUE %bv(<2 x i64>), $noreg, !5, !DIExpression(), debug-location !6
    %zero:_(i64) = G_CONSTANT i64 0
    %one:_(i64) = G_CONSTANT i64 1
    %e0:_(i64) = G_EXTRACT_VECTOR_ELT %bv(<2 x i64>), %zero(i64)
    %e1:_(i64) = G_EXTRACT_VECTOR_ELT %bv(<2 x i64>), %one(i64)
    $x0 = COPY %e0(i64)
    $x1 = COPY %e1(i64)
    RET_ReallyLR implicit $x0, implicit $x1
...
