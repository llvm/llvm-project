# RUN: llc -mtriple=aarch64 -run-pass=legalizer %s -o - | FileCheck %s

---
name:            test_scalar_sub_big
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_scalar_sub_big
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i64) = COPY $x3
    ; CHECK-NEXT: [[USUBO:%[0-9]+]]:_(i64), [[USUBO1:%[0-9]+]]:_(i32) = G_USUBO [[COPY]], [[COPY2]]
    ; CHECK-NEXT: [[USUBE:%[0-9]+]]:_(i64), [[USUBE1:%[0-9]+]]:_(i32) = G_USUBE [[COPY1]], [[COPY3]], [[USUBO1]]
    ; CHECK-NEXT: $x0 = COPY [[USUBO]](i64)
    ; CHECK-NEXT: $x1 = COPY [[USUBE]](i64)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64) = COPY $x2
    %3:_(i64) = COPY $x3
    %4:_(i128) = G_MERGE_VALUES %0(i64), %1(i64)
    %5:_(i128) = G_MERGE_VALUES %2(i64), %3(i64)
    %6:_(i128) = G_SUB %4, %5
    %7:_(i64), %8:_(i64) = G_UNMERGE_VALUES %6(i128)
    $x0 = COPY %7(i64)
    $x1 = COPY %8(i64)

...
