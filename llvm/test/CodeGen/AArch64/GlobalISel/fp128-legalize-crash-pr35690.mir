# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -O0 -run-pass=legalizer -global-isel-abort=0 %s -o - | FileCheck %s
--- |
  target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
  target triple = "aarch64"

  define fp128 @x(fp128 %a) {
  entry:
    %a.addr = alloca fp128, align 16
    store fp128 %a, ptr %a.addr, align 16
    %0 = load fp128, ptr %a.addr, align 16
    %sub = fsub fp128 0xL00000000000000008000000000000000, %0
    ret fp128 %sub
  }

...
---
name:            x
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
fixedStack:
stack:
  - { id: 0, name: a.addr, type: default, offset: 0, size: 16, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '',
      debug-info-location: '' }
body:             |
  bb.1.entry:
    liveins: $q0

    ; This test just checks we don't crash on G_FNEG of FP128 types.
    ; CHECK-LABEL: name: x
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i128) = COPY $q0
    ; CHECK-NEXT: [[FRAME_INDEX:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0.a.addr
    ; CHECK-NEXT: G_STORE [[COPY]](i128), [[FRAME_INDEX]](p0) :: (store (s128) into %ir.a.addr)
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(f128) = G_LOAD [[FRAME_INDEX]](p0) :: (load (s128) from %ir.a.addr)
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i128) = G_BITCAST [[LOAD]](f128)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 -9223372036854775808
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i64), [[UV1:%[0-9]+]]:_(i64) = G_UNMERGE_VALUES [[BITCAST]](i128)
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i64) = G_XOR [[UV]], [[C]]
    ; CHECK-NEXT: [[XOR1:%[0-9]+]]:_(i64) = G_XOR [[UV1]], [[C1]]
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(i128) = G_MERGE_VALUES [[XOR]](i64), [[XOR1]](i64)
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(f128) = G_BITCAST [[MV]](i128)
    ; CHECK-NEXT: $q0 = COPY [[BITCAST1]](f128)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %0:_(i128) = COPY $q0
    %1:_(p0) = G_FRAME_INDEX %stack.0.a.addr
    G_STORE %0(i128), %1(p0) :: (store (s128) into %ir.a.addr)
    %2:_(f128) = G_LOAD %1(p0) :: (load (s128) from %ir.a.addr)
    %3:_(f128) = G_FNEG %2
    $q0 = COPY %3(f128)
    RET_ReallyLR implicit $q0

...
