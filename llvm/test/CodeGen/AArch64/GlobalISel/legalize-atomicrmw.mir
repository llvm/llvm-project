# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64-- -mattr=+lse -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"

  define void @cmpxchg_i8(ptr %addr) { ret void }
  define void @cmpxchg_i16(ptr %addr) { ret void }
  define void @cmpxchg_i32(ptr %addr) { ret void }
  define void @cmpxchg_i64(ptr %addr) { ret void }
...

---
name:            cmpxchg_i8
body:             |
  bb.0:
    liveins: $x0

    ; CHECK-LABEL: name: cmpxchg_i8
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[ATOMICRMW_ADD:%[0-9]+]]:_(i32) = G_ATOMICRMW_ADD [[COPY]](p0), [[C]] :: (load store monotonic (i8) on %ir.addr)
    ; CHECK-NEXT: $w0 = COPY [[ATOMICRMW_ADD]](i32)
    %0:_(p0) = COPY $x0
    %1:_(i8) = G_CONSTANT i8 1
    %2:_(i8) = G_ATOMICRMW_ADD %0, %1 :: (load store monotonic (i8) on %ir.addr)
    %3:_(i32) = G_ANYEXT %2
    $w0 = COPY %3(i32)
...

