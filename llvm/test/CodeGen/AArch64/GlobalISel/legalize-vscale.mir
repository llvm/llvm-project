# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -mattr=+sve -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
---
name:            vscale_i32
body:             |
  bb.0:
    ; CHECK-LABEL: name: vscale_i32
    ; CHECK: [[VSCALE:%[0-9]+]]:_(i64) = G_VSCALE i64 -16
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[VSCALE]](i64)
    ; CHECK-NEXT: $w0 = COPY [[TRUNC]](i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:_(i32) = G_VSCALE i32 -16
    $w0 = COPY %0(i32)
    RET_ReallyLR implicit $w0
...
---
name:            vscale_i128
body:             |
  bb.0:
    ; CHECK-LABEL: name: vscale_i128
    ; CHECK: [[VSCALE:%[0-9]+]]:_(i64) = G_VSCALE i64 1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 16
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(i64) = G_MUL [[VSCALE]], [[C1]]
    ; CHECK-NEXT: [[UMULH:%[0-9]+]]:_(i64) = G_UMULH [[VSCALE]], [[C1]]
    ; CHECK-NEXT: [[MUL1:%[0-9]+]]:_(i64) = G_MUL [[VSCALE]], [[C]]
    ; CHECK-NEXT: [[MUL2:%[0-9]+]]:_(i64) = G_MUL [[C]], [[C1]]
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(i64) = G_ADD [[UMULH]], [[MUL1]]
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(i64) = G_ADD [[ADD]], [[MUL2]]
    ; CHECK-NEXT: $x0 = COPY [[MUL]](i64)
    ; CHECK-NEXT: $x1 = COPY [[ADD1]](i64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0, implicit $x1
    %0:_(i128) = G_VSCALE i128 16
    %1:_(i64), %2:_(i64) = G_UNMERGE_VALUES %0(i128)
    $x0 = COPY %1(i64)
    $x1 = COPY %2(i64)
    RET_ReallyLR implicit $x0, implicit $x1
...
