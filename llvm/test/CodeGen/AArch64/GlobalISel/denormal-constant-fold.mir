# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -mattr=+fullfp16 -run-pass=aarch64-prelegalizer-combiner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Record the current generic GlobalISel folding behavior for arithmetic,
# G_FMA, G_FCMP, rounding, and min/max. These folds currently ignore the
# MachineFunction's denormal_fpenv attribute, even when set to "dynamic".
#
# Ensure the tests exercise combinations like:
#   denormal_fpenv(ieee, float: preservesign)
#   denormal_fpenv(preservesign, float:ieee)
# to cover cases where f16 should follow the default `denormal_fpenv` but
# f32 is specified differently.
#
# TODO: Make these constant folds honour the denormal environment.
# The current values produced via constant folding are technically legal since
# denormal_fpenv "may" flush but is not required to. However, it may be desirable in
# most cases to have the const-folded results match the results that would be produced
# if they exectuted on the actual hardware with non-const inputs containing the same values.
#
# It is not always possible to 100% match the const-folding to the hardware-executed result.
# For example with f16 flushing enabled, f32 flushing disabled with:
#   denormal_fpenv(preservesign, float:ieee)
# The input:
#   fadd half f0x0001, f0x0002
# could be lowered to:
#   fadd h0, h0, h1
# which would flush if FZ16 was set, but it hypothetically be promoted instead and lowered to:
#   fcvt s2, h0
#   fcvt s3, h1
#   fadd s2, s2, s3
#   fcvt h2, s2   
# which would depend on FZ instead and therefore not flush.
#
# However, making const-folding match the behaviour of the simple scalar version of these
# instructions makes it more likely to be match the results from the hardware-executed
# instruction than if we always ignore `denormal_fpenv` during const-folding.

--- |
  define void @fbinops() denormal_fpenv(float: preservesign) { ret void }

  define void @fma() denormal_fpenv(float: preservesign) { ret void }

  define void @ftz_boundary() denormal_fpenv(float: preservesign) { ret void }

  define void @fcmp() denormal_fpenv(float: preservesign) { ret void }

  define void @dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @ceil() denormal_fpenv(float: preservesign) { ret void }

  define void @ceil_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @minmax() denormal_fpenv(float: preservesign) { ret void }

  define void @minmax_dynamic() denormal_fpenv(float: dynamic) { ret void }

  define void @f16_ftz() denormal_fpenv(preservesign, float: ieee) { ret void }

  define void @f16_dynamic() denormal_fpenv(dynamic, float: ieee) { ret void }

  define void @f16_ieee() denormal_fpenv(float: preservesign) { ret void }

  define void @f64_ftz() denormal_fpenv(preservesign) { ret void }

  define void @f64_dynamic() denormal_fpenv(dynamic) { ret void }

  define void @f64_ieee() denormal_fpenv(ieee) { ret void }

...

---
name: fbinops
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; TODO: Flush the subnormal inputs and fold all four results to +0.
    ; CHECK-LABEL: name: fbinops
    ; CHECK: %add:_(f32) = G_FCONSTANT float 2.802600e-45
    ; CHECK-NEXT: $s0 = COPY %add(f32)
    ; CHECK-NEXT: $s1 = COPY %add(f32)
    ; CHECK-NEXT: $s2 = COPY %add(f32)
    ; CHECK-NEXT: $s3 = COPY %add(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %negdenorm:_(f32) = G_FCONSTANT float f0x80000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %two:_(f32) = G_FCONSTANT float 2.000000e+00
    %half:_(f32) = G_FCONSTANT float 5.000000e-01
    %add:_(f32) = G_FADD %denorm, %denorm
    %sub:_(f32) = G_FSUB %denorm, %negdenorm
    %mul:_(f32) = G_FMUL %denorm, %two
    %div:_(f32) = G_FDIV %denorm, %half
    $s0 = COPY %add
    $s1 = COPY %sub
    $s2 = COPY %mul
    $s3 = COPY %div
...

---
name: fma
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; TODO: Flush the subnormal input and fold G_FMA to +0.
    ; CHECK-LABEL: name: fma
    ; CHECK: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: $s0 = COPY %denorm(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %result:_(f32) = G_FMA %denorm, %one, %zero
    $s0 = COPY %result
...

---
name: ftz_boundary
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; TODO: Leave G_FMUL and G_FMA unfolded rather than folding to min-normal.
    ; The exact results are tiny and FZ can produce +0 instead of min-normal.
    ; The exact behaviour depends on the AH flag, so we should not attempt
    ; to model it during const-folding.
    ; CHECK-LABEL: name: ftz_boundary
    ; CHECK: %mul:_(f32) = G_FCONSTANT float f0x00800000
    ; CHECK-NEXT: $s0 = COPY %mul(f32)
    ; CHECK-NEXT: $s1 = COPY %mul(f32)
    %a:_(f32) = G_FCONSTANT float f0x91FFFFFF
    %b:_(f32) = G_FCONSTANT float f0xAE000000
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %mul:_(f32) = G_FMUL %a, %b
    %fma:_(f32) = G_FMA %a, %b, %zero
    $s0 = COPY %mul
    $s1 = COPY %fma
...

---
name: fcmp
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; TODO: Flush the subnormal input so G_FCMP is true and G_ZEXT yields 1.
    ; CHECK-LABEL: name: fcmp
    ; CHECK: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $w0 = COPY %extended(i32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %result:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %result
    $w0 = COPY %extended
...

---
name: dynamic
# denormal_fpenv(float: dynamic)
body: |
  bb.0:
    ; TODO: Leave G_FADD unfolded: its result depends on dynamic flushing.
    ; CHECK-LABEL: name: dynamic
    ; CHECK: %result:_(f32) = G_FCONSTANT float 2.802600e-45
    ; CHECK-NEXT: $s0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %result:_(f32) = G_FADD %denorm, %denorm
    $s0 = COPY %result
...

---
name: ceil
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; TODO: Flush the subnormal input and fold G_FCEIL to +0 instead of 1.
    ; CHECK-LABEL: name: ceil
    ; CHECK: %result:_(f32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: $s0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %result:_(f32) = G_FCEIL %denorm
    $s0 = COPY %result
...

---
name: ceil_dynamic
# denormal_fpenv(float: dynamic)
body: |
  bb.0:
    ; TODO: Leave G_FCEIL unfolded: IEEE gives 1, but input FTZ gives +0.
    ; CHECK-LABEL: name: ceil_dynamic
    ; CHECK: %result:_(f32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: $s0 = COPY %result(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %result:_(f32) = G_FCEIL %denorm
    $s0 = COPY %result
...

---
name: minmax
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; TODO: Flush the subnormal inputs and fold all six min/max results to +0.
    ; CHECK-LABEL: name: minmax
    ; CHECK: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: $s0 = COPY %denorm(f32)
    ; CHECK-NEXT: $s1 = COPY %denorm(f32)
    ; CHECK-NEXT: $s2 = COPY %denorm(f32)
    ; CHECK-NEXT: $s3 = COPY %denorm(f32)
    ; CHECK-NEXT: $s4 = COPY %denorm(f32)
    ; CHECK-NEXT: $s5 = COPY %denorm(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %zero:_(f32) = G_FCONSTANT float 0.000000e+00
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %minnum:_(f32) = G_FMINNUM %denorm, %one
    %maxnum:_(f32) = G_FMAXNUM %denorm, %zero
    %minimum:_(f32) = G_FMINIMUM %denorm, %one
    %maximum:_(f32) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f32) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f32) = G_FMAXIMUMNUM %denorm, %zero
    $s0 = COPY %minnum
    $s1 = COPY %maxnum
    $s2 = COPY %minimum
    $s3 = COPY %maximum
    $s4 = COPY %minimumnum
    $s5 = COPY %maximumnum
...

---
name: minmax_dynamic
# denormal_fpenv(float: dynamic)
body: |
  bb.0:
    ; TODO: Leave G_FMINNUM unfolded: its result depends on dynamic flushing.
    ; CHECK-LABEL: name: minmax_dynamic
    ; CHECK: %denorm:_(f32) = G_FCONSTANT float 1.401300e-45
    ; CHECK-NEXT: $s0 = COPY %denorm(f32)
    %denorm:_(f32) = G_FCONSTANT float f0x00000001
    %one:_(f32) = G_FCONSTANT float 1.000000e+00
    %result:_(f32) = G_FMINNUM %denorm, %one
    $s0 = COPY %result
...

---
name: f16_ftz
# denormal_fpenv(preservesign, float: ieee)
body: |
  bb.0:
    ; TODO: Fold the arithmetic, FMA, ceil, and min/max results to +0, and
    ; G_FCMP to true (G_ZEXT to 1). Flush %output_mul to +0 too: its inputs
    ; are normal, but its result is subnormal. The float: ieee mode only
    ; applies to f32 and must not disable flushing for f16.
    ; CHECK-LABEL: name: f16_ftz
    ; CHECK: %denorm:_(f16) = G_FCONSTANT half 5.960460e-08
    ; CHECK-NEXT: %one:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: %add:_(f16) = G_FCONSTANT half 1.192090e-07
    ; CHECK-NEXT: %output_mul:_(f16) = G_FCONSTANT half 3.051760e-05
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $h0 = COPY %add(f16)
    ; CHECK-NEXT: $h1 = COPY %add(f16)
    ; CHECK-NEXT: $h2 = COPY %add(f16)
    ; CHECK-NEXT: $h3 = COPY %add(f16)
    ; CHECK-NEXT: $h5 = COPY %denorm(f16)
    ; CHECK-NEXT: $h6 = COPY %one(f16)
    ; CHECK-NEXT: $h7 = COPY %denorm(f16)
    ; CHECK-NEXT: $h8 = COPY %denorm(f16)
    ; CHECK-NEXT: $h9 = COPY %denorm(f16)
    ; CHECK-NEXT: $h10 = COPY %denorm(f16)
    ; CHECK-NEXT: $h11 = COPY %denorm(f16)
    ; CHECK-NEXT: $h12 = COPY %denorm(f16)
    ; CHECK-NEXT: $w13 = COPY %extended(i32)
    ; CHECK-NEXT: $h14 = COPY %output_mul(f16)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %negdenorm:_(f16) = G_FCONSTANT half f0x8001
    %one:_(f16) = G_FCONSTANT half 1.000000e+00
    %two:_(f16) = G_FCONSTANT half 2.000000e+00
    %half:_(f16) = G_FCONSTANT half 5.000000e-01
    %add:_(f16) = G_FADD %denorm, %denorm
    %sub:_(f16) = G_FSUB %denorm, %negdenorm
    %mul:_(f16) = G_FMUL %denorm, %two
    %div:_(f16) = G_FDIV %denorm, %half
    %fma:_(f16) = G_FMA %denorm, %one, %zero
    %ceil:_(f16) = G_FCEIL %denorm
    %minnum:_(f16) = G_FMINNUM %denorm, %one
    %maxnum:_(f16) = G_FMAXNUM %denorm, %zero
    %minimum:_(f16) = G_FMINIMUM %denorm, %one
    %maximum:_(f16) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f16) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f16) = G_FMAXIMUMNUM %denorm, %zero
    %minnormal:_(f16) = G_FCONSTANT half f0x0400
    %output_mul:_(f16) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $h0 = COPY %add
    $h1 = COPY %sub
    $h2 = COPY %mul
    $h3 = COPY %div
    $h5 = COPY %fma
    $h6 = COPY %ceil
    $h7 = COPY %minnum
    $h8 = COPY %maxnum
    $h9 = COPY %minimum
    $h10 = COPY %maximum
    $h11 = COPY %minimumnum
    $h12 = COPY %maximumnum
    $w13 = COPY %extended
    $h14 = COPY %output_mul
...

---
name: f16_dynamic
# denormal_fpenv(dynamic, float: ieee)
body: |
  bb.0:
    ; TODO: Leave G_FADD, G_FMA, G_FCEIL, G_FMINNUM, G_FMUL, and G_FCMP
    ; unfolded: their results depend on dynamic input/output flushing for f16,
    ; independently of the float: ieee mode.
    ; CHECK-LABEL: name: f16_dynamic
    ; CHECK: %denorm:_(f16) = G_FCONSTANT half 5.960460e-08
    ; CHECK-NEXT: %one:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: %add:_(f16) = G_FCONSTANT half 1.192090e-07
    ; CHECK-NEXT: %output_mul:_(f16) = G_FCONSTANT half 3.051760e-05
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $h0 = COPY %add(f16)
    ; CHECK-NEXT: $h1 = COPY %denorm(f16)
    ; CHECK-NEXT: $h2 = COPY %one(f16)
    ; CHECK-NEXT: $h3 = COPY %denorm(f16)
    ; CHECK-NEXT: $w4 = COPY %extended(i32)
    ; CHECK-NEXT: $h5 = COPY %output_mul(f16)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %one:_(f16) = G_FCONSTANT half 1.000000e+00
    %add:_(f16) = G_FADD %denorm, %denorm
    %fma:_(f16) = G_FMA %denorm, %one, %zero
    %ceil:_(f16) = G_FCEIL %denorm
    %minnum:_(f16) = G_FMINNUM %denorm, %one
    %minnormal:_(f16) = G_FCONSTANT half f0x0400
    %half:_(f16) = G_FCONSTANT half 5.000000e-01
    %output_mul:_(f16) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $h0 = COPY %add
    $h1 = COPY %fma
    $h2 = COPY %ceil
    $h3 = COPY %minnum
    $w4 = COPY %extended
    $h5 = COPY %output_mul
...

---
name: f16_ieee
# denormal_fpenv(float: preservesign)
body: |
  bb.0:
    ; f16 defaults to IEEE; the f32 FTZ setting must not affect these folds.
    ; G_FADD produces f0x0002, G_FCEIL produces 1, and G_FCMP is false
    ; CHECK-LABEL: name: f16_ieee
    ; CHECK: %add:_(f16) = G_FCONSTANT half 1.192090e-07
    ; CHECK-NEXT: %ceil:_(f16) = G_FCONSTANT half 1.000000e+00
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $h0 = COPY %add(f16)
    ; CHECK-NEXT: $h1 = COPY %ceil(f16)
    ; CHECK-NEXT: $w2 = COPY %extended(i32)
    %denorm:_(f16) = G_FCONSTANT half f0x0001
    %zero:_(f16) = G_FCONSTANT half 0.000000e+00
    %add:_(f16) = G_FADD %denorm, %denorm
    %ceil:_(f16) = G_FCEIL %denorm
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $h0 = COPY %add
    $h1 = COPY %ceil
    $w2 = COPY %extended
...

---
name: f64_ftz
# denormal_fpenv(preservesign)
body: |
  bb.0:
    ; TODO: Fold the arithmetic, FMA, ceil, and min/max results to +0, and
    ; G_FCMP to true (G_ZEXT to 1). Flush %output_mul to +0 too: its inputs
    ; are normal, but its result is subnormal. FPCR.FZ enables flushing
    ; for both f32 and f64.
    ; CHECK-LABEL: name: f64_ftz
    ; CHECK: %denorm:_(f64) = G_FCONSTANT double 4.940660e-324
    ; CHECK-NEXT: %one:_(f64) = G_FCONSTANT double 1.000000e+00
    ; CHECK-NEXT: %add:_(f64) = G_FCONSTANT double 9.881310e-324
    ; CHECK-NEXT: %output_mul:_(f64) = G_FCONSTANT double f0x0008000000000000
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $d0 = COPY %add(f64)
    ; CHECK-NEXT: $d1 = COPY %add(f64)
    ; CHECK-NEXT: $d2 = COPY %add(f64)
    ; CHECK-NEXT: $d3 = COPY %add(f64)
    ; CHECK-NEXT: $d5 = COPY %denorm(f64)
    ; CHECK-NEXT: $d6 = COPY %one(f64)
    ; CHECK-NEXT: $d7 = COPY %denorm(f64)
    ; CHECK-NEXT: $d8 = COPY %denorm(f64)
    ; CHECK-NEXT: $d9 = COPY %denorm(f64)
    ; CHECK-NEXT: $d10 = COPY %denorm(f64)
    ; CHECK-NEXT: $d11 = COPY %denorm(f64)
    ; CHECK-NEXT: $d12 = COPY %denorm(f64)
    ; CHECK-NEXT: $w26 = COPY %extended(i32)
    ; CHECK-NEXT: $d14 = COPY %output_mul(f64)
    %denorm:_(f64) = G_FCONSTANT double f0x0000000000000001
    %zero:_(f64) = G_FCONSTANT double 0.000000e+00
    %negdenorm:_(f64) = G_FCONSTANT double f0x8000000000000001
    %one:_(f64) = G_FCONSTANT double 1.000000e+00
    %two:_(f64) = G_FCONSTANT double 2.000000e+00
    %half:_(f64) = G_FCONSTANT double 5.000000e-01
    %add:_(f64) = G_FADD %denorm, %denorm
    %sub:_(f64) = G_FSUB %denorm, %negdenorm
    %mul:_(f64) = G_FMUL %denorm, %two
    %div:_(f64) = G_FDIV %denorm, %half
    %fma:_(f64) = G_FMA %denorm, %one, %zero
    %ceil:_(f64) = G_FCEIL %denorm
    %minnum:_(f64) = G_FMINNUM %denorm, %one
    %maxnum:_(f64) = G_FMAXNUM %denorm, %zero
    %minimum:_(f64) = G_FMINIMUM %denorm, %one
    %maximum:_(f64) = G_FMAXIMUM %denorm, %zero
    %minimumnum:_(f64) = G_FMINIMUMNUM %denorm, %one
    %maximumnum:_(f64) = G_FMAXIMUMNUM %denorm, %zero
    %minnormal:_(f64) = G_FCONSTANT double f0x0010000000000000
    %output_mul:_(f64) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $d0 = COPY %add
    $d1 = COPY %sub
    $d2 = COPY %mul
    $d3 = COPY %div
    $d5 = COPY %fma
    $d6 = COPY %ceil
    $d7 = COPY %minnum
    $d8 = COPY %maxnum
    $d9 = COPY %minimum
    $d10 = COPY %maximum
    $d11 = COPY %minimumnum
    $d12 = COPY %maximumnum
    $w26 = COPY %extended
    $d14 = COPY %output_mul
...

---
name: f64_dynamic
# denormal_fpenv(dynamic)
body: |
  bb.0:
    ; TODO: Leave G_FADD, G_FMA, G_FCEIL, G_FMINNUM, G_FMUL, and G_FCMP
    ; unfolded: their results depend on dynamic input/output flushing.
    ; The same FPCR.FZ setting controls f32 and f64.
    ; CHECK-LABEL: name: f64_dynamic
    ; CHECK: %denorm:_(f64) = G_FCONSTANT double 4.940660e-324
    ; CHECK-NEXT: %one:_(f64) = G_FCONSTANT double 1.000000e+00
    ; CHECK-NEXT: %add:_(f64) = G_FCONSTANT double 9.881310e-324
    ; CHECK-NEXT: %output_mul:_(f64) = G_FCONSTANT double f0x0008000000000000
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $d0 = COPY %add(f64)
    ; CHECK-NEXT: $d1 = COPY %denorm(f64)
    ; CHECK-NEXT: $d2 = COPY %one(f64)
    ; CHECK-NEXT: $d3 = COPY %denorm(f64)
    ; CHECK-NEXT: $w8 = COPY %extended(i32)
    ; CHECK-NEXT: $d5 = COPY %output_mul(f64)
    %denorm:_(f64) = G_FCONSTANT double f0x0000000000000001
    %zero:_(f64) = G_FCONSTANT double 0.000000e+00
    %one:_(f64) = G_FCONSTANT double 1.000000e+00
    %add:_(f64) = G_FADD %denorm, %denorm
    %fma:_(f64) = G_FMA %denorm, %one, %zero
    %ceil:_(f64) = G_FCEIL %denorm
    %minnum:_(f64) = G_FMINNUM %denorm, %one
    %minnormal:_(f64) = G_FCONSTANT double f0x0010000000000000
    %half:_(f64) = G_FCONSTANT double 5.000000e-01
    %output_mul:_(f64) = G_FMUL %minnormal, %half
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $d0 = COPY %add
    $d1 = COPY %fma
    $d2 = COPY %ceil
    $d3 = COPY %minnum
    $w8 = COPY %extended
    $d5 = COPY %output_mul
...

---
name: f64_ieee
# denormal_fpenv(ieee)
body: |
  bb.0:
    ; With FPCR.FZ disabled, both f32 and f64 use IEEE denormal handling.
    ; G_FADD produces f0x0000000000000002, G_FCEIL produces 1, and G_FCMP is false
    ; CHECK-LABEL: name: f64_ieee
    ; CHECK: %add:_(f64) = G_FCONSTANT double 9.881310e-324
    ; CHECK-NEXT: %ceil:_(f64) = G_FCONSTANT double 1.000000e+00
    ; CHECK-NEXT: %extended:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $d0 = COPY %add(f64)
    ; CHECK-NEXT: $d1 = COPY %ceil(f64)
    ; CHECK-NEXT: $w4 = COPY %extended(i32)
    %denorm:_(f64) = G_FCONSTANT double f0x0000000000000001
    %zero:_(f64) = G_FCONSTANT double 0.000000e+00
    %add:_(f64) = G_FADD %denorm, %denorm
    %ceil:_(f64) = G_FCEIL %denorm
    %cmp:_(i1) = G_FCMP floatpred(oeq), %denorm, %zero
    %extended:_(i32) = G_ZEXT %cmp
    $d0 = COPY %add
    $d1 = COPY %ceil
    $w4 = COPY %extended
...
