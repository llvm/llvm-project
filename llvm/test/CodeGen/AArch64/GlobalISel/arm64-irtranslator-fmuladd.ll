  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(f32) = COPY $s2
  ; CHECK-NEXT:   [[FMA:%[0-9]+]]:_(f32) = G_FMA [[COPY]], [[COPY1]], [[COPY2]]
  ; CHECK-NEXT:   $s0 = COPY [[FMA]](f32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $s0
  %res = call float @llvm.fmuladd.f32(float %x, float %y, float %z)
