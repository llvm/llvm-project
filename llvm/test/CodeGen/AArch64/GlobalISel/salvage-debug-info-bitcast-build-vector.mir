# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -passes='require<libcall-lowering-info>,function(machine-function(aarch64-prelegalizer-combiner))' %s -o - | FileCheck %s

# Fragment, complex-expression and DBG_VALUE_LIST cases for salvaging a dead
# G_BUILD_VECTOR, which debugify cannot generate.

--- |
  define void @build_vector_fragment() !dbg !4 { ret void }
  define void @build_vector_complex_expr() !dbg !5 { ret void }
  define void @build_vector_list() !dbg !6 { ret void }
  define void @build_vector_list_multi_arg() !dbg !7 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "x", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "a.c", directory: "/tmp")
  !2 = !{i32 2, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "build_vector_fragment", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !5 = distinct !DISubprogram(name: "build_vector_complex_expr", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !6 = distinct !DISubprogram(name: "build_vector_list", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !7 = distinct !DISubprogram(name: "build_vector_list_multi_arg", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !8 = !DISubroutineType(types: !9)
  !9 = !{}
  !10 = !DIBasicType(name: "i128", size: 128, encoding: DW_ATE_unsigned)
  !11 = !DIBasicType(name: "i256", size: 256, encoding: DW_ATE_unsigned)
  !12 = !DILocalVariable(name: "z", scope: !4, file: !1, line: 1, type: !11)
  !13 = !DILocalVariable(name: "w", scope: !5, file: !1, line: 1, type: !10)
  !14 = !DILocalVariable(name: "v", scope: !6, file: !1, line: 1, type: !10)
  !15 = !DILocalVariable(name: "u", scope: !7, file: !1, line: 1, type: !10)
  !16 = !DILocation(line: 2, column: 3, scope: !4)
  !17 = !DILocation(line: 2, column: 3, scope: !5)
  !18 = !DILocation(line: 2, column: 3, scope: !6)
  !19 = !DILocation(line: 2, column: 3, scope: !7)
...
---
name: build_vector_fragment
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: build_vector_fragment
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $x0, $noreg, !10, !DIExpression(DW_OP_LLVM_fragment, 128, 64), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: DBG_VALUE $x1, $noreg, !10, !DIExpression(DW_OP_LLVM_fragment, 192, 64), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !4)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    DBG_VALUE %2(<2 x i64>), $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 128, 128), debug-location !16
    RET_ReallyLR debug-location !16
...
---
# An expression that computes on the whole vector cannot be split per element.
name: build_vector_complex_expr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: build_vector_complex_expr
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !10, !DIExpression(DW_OP_plus_uconst, 1, DW_OP_stack_value), debug-location !DILocation(line: 2, column: 3, scope: !7)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !7)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    DBG_VALUE %2(<2 x i64>), $noreg, !13, !DIExpression(DW_OP_plus_uconst, 1, DW_OP_stack_value), debug-location !17
    RET_ReallyLR debug-location !17
...
---
name: build_vector_list
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: build_vector_list
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE_LIST !10, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_stack_value, DW_OP_LLVM_fragment, 0, 64), $x0, debug-location !DILocation(line: 2, column: 3, scope: !8)
    ; CHECK-NEXT: DBG_VALUE_LIST !10, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_stack_value, DW_OP_LLVM_fragment, 64, 64), $x1, debug-location !DILocation(line: 2, column: 3, scope: !8)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !8)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    DBG_VALUE_LIST !14, !DIExpression(DW_OP_LLVM_arg, 0), %2(<2 x i64>), debug-location !18
    RET_ReallyLR debug-location !18
...
---
# The vector is one of several location operands, so it cannot be split.
name: build_vector_list_multi_arg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2
    ; CHECK-LABEL: name: build_vector_list_multi_arg
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-NEXT: DBG_VALUE_LIST !10, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), $noreg, $noreg, debug-location !DILocation(line: 2, column: 3, scope: !9)
    ; CHECK-NEXT: RET_ReallyLR implicit [[COPY]](i64), debug-location !DILocation(line: 2, column: 3, scope: !9)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    %3:_(i64) = COPY $x2
    DBG_VALUE_LIST !15, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), %2(<2 x i64>), %3(i64), debug-location !19
    RET_ReallyLR implicit %3, debug-location !19
...
