# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -global-isel -run-pass=aarch64-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Check that DBG_VALUEs using a dead G_BITCAST or G_BUILD_VECTOR are salvaged
# instead of being set to undef.

--- |
  define void @bitcast_build_vector() !dbg !4 { ret void }
  define void @build_vector() !dbg !5 { ret void }
  define void @build_vector_fragment() !dbg !6 { ret void }
  define void @build_vector_complex_expr() !dbg !7 { ret void }
  define void @build_vector_list() !dbg !20 { ret void }
  define void @build_vector_list_multi_arg() !dbg !21 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "x", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "a.c", directory: "/tmp")
  !2 = !{i32 2, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "bitcast_build_vector", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !5 = distinct !DISubprogram(name: "build_vector", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !6 = distinct !DISubprogram(name: "build_vector_fragment", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !7 = distinct !DISubprogram(name: "build_vector_complex_expr", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !8 = !DISubroutineType(types: !9)
  !9 = !{}
  !10 = !DIBasicType(name: "i128", size: 128, encoding: DW_ATE_unsigned)
  !11 = !DIBasicType(name: "i256", size: 256, encoding: DW_ATE_unsigned)
  !12 = !DILocalVariable(name: "x", scope: !4, file: !1, line: 1, type: !10)
  !13 = !DILocalVariable(name: "y", scope: !5, file: !1, line: 1, type: !10)
  !14 = !DILocalVariable(name: "z", scope: !6, file: !1, line: 1, type: !11)
  !15 = !DILocalVariable(name: "w", scope: !7, file: !1, line: 1, type: !10)
  !16 = !DILocation(line: 2, column: 3, scope: !4)
  !17 = !DILocation(line: 2, column: 3, scope: !5)
  !18 = !DILocation(line: 2, column: 3, scope: !6)
  !19 = !DILocation(line: 2, column: 3, scope: !7)
  !20 = distinct !DISubprogram(name: "build_vector_list", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !21 = distinct !DISubprogram(name: "build_vector_list_multi_arg", scope: !1, file: !1, line: 1, type: !8, spFlags: DISPFlagDefinition, unit: !0)
  !22 = !DILocalVariable(name: "v", scope: !20, file: !1, line: 1, type: !10)
  !23 = !DILocalVariable(name: "u", scope: !21, file: !1, line: 1, type: !10)
  !24 = !DILocation(line: 2, column: 3, scope: !20)
  !25 = !DILocation(line: 2, column: 3, scope: !21)
...
---
name: bitcast_build_vector
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2, $x3
    ; CHECK-LABEL: name: bitcast_build_vector
    ; CHECK: liveins: $x0, $x1, $x2, $x3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i64) = COPY $x1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:_(i64) = COPY $x3
    ; CHECK-NEXT: DBG_VALUE [[COPY]](i64), $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 0, 64), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: DBG_VALUE [[COPY1]](i64), $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 64, 64), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: [[UADDO:%[0-9]+]]:_(i64), [[UADDO1:%[0-9]+]]:_(i32) = G_UADDO [[COPY]], [[COPY2]], debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: [[UADDE:%[0-9]+]]:_(i64), [[UADDE1:%[0-9]+]]:_(i32) = G_UADDE [[COPY1]], [[COPY3]], [[UADDO1]], debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: $x0 = COPY [[UADDO]](i64), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: $x1 = COPY [[UADDE]](i64), debug-location !DILocation(line: 2, column: 3, scope: !4)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0, implicit $x1, debug-location !DILocation(line: 2, column: 3, scope: !4)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(i64) = COPY $x2
    %3:_(i64) = COPY $x3
    %4:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    %5:_(i128) = G_BITCAST %4(<2 x i64>)
    DBG_VALUE %5(i128), $noreg, !12, !DIExpression(), debug-location !16
    %6:_(i64), %7:_(i64) = G_UNMERGE_VALUES %5(i128), debug-location !16
    %8:_(i64), %9:_(i32) = G_UADDO %6, %2, debug-location !16
    %10:_(i64), %11:_(i32) = G_UADDE %7, %3, %9, debug-location !16
    $x0 = COPY %8(i64), debug-location !16
    $x1 = COPY %10(i64), debug-location !16
    RET_ReallyLR implicit $x0, implicit $x1, debug-location !16
...
---
name: build_vector
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1, $w2, $w3
    ; CHECK-LABEL: name: build_vector
    ; CHECK: liveins: $w0, $w1, $w2, $w3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $w0, $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 0, 32), debug-location !DILocation(line: 2, column: 3, scope: !7)
    ; CHECK-NEXT: DBG_VALUE $w1, $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 32, 32), debug-location !DILocation(line: 2, column: 3, scope: !7)
    ; CHECK-NEXT: DBG_VALUE $w2, $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 64, 32), debug-location !DILocation(line: 2, column: 3, scope: !7)
    ; CHECK-NEXT: DBG_VALUE $w3, $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 96, 32), debug-location !DILocation(line: 2, column: 3, scope: !7)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !7)
    %0:_(i32) = COPY $w0
    %1:_(i32) = COPY $w1
    %2:_(i32) = COPY $w2
    %3:_(i32) = COPY $w3
    %4:_(<4 x i32>) = G_BUILD_VECTOR %0(i32), %1(i32), %2(i32), %3(i32)
    DBG_VALUE %4(<4 x i32>), $noreg, !13, !DIExpression(), debug-location !17
    RET_ReallyLR debug-location !17
...
---
name: build_vector_fragment
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: build_vector_fragment
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $x0, $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 128, 64), debug-location !DILocation(line: 2, column: 3, scope: !8)
    ; CHECK-NEXT: DBG_VALUE $x1, $noreg, !12, !DIExpression(DW_OP_LLVM_fragment, 192, 64), debug-location !DILocation(line: 2, column: 3, scope: !8)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !8)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    DBG_VALUE %2(<2 x i64>), $noreg, !14, !DIExpression(DW_OP_LLVM_fragment, 128, 128), debug-location !18
    RET_ReallyLR debug-location !18
...
---
# An expression that computes on the whole vector cannot be split per element.
name: build_vector_complex_expr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: build_vector_complex_expr
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE $noreg, $noreg, !12, !DIExpression(DW_OP_plus_uconst, 1, DW_OP_stack_value), debug-location !DILocation(line: 2, column: 3, scope: !9)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !9)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    DBG_VALUE %2(<2 x i64>), $noreg, !15, !DIExpression(DW_OP_plus_uconst, 1, DW_OP_stack_value), debug-location !19
    RET_ReallyLR debug-location !19
...
---
name: build_vector_list
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: build_vector_list
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DBG_VALUE_LIST !12, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_stack_value, DW_OP_LLVM_fragment, 0, 64), $x0, debug-location !DILocation(line: 2, column: 3, scope: !10)
    ; CHECK-NEXT: DBG_VALUE_LIST !12, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_stack_value, DW_OP_LLVM_fragment, 64, 64), $x1, debug-location !DILocation(line: 2, column: 3, scope: !10)
    ; CHECK-NEXT: RET_ReallyLR debug-location !DILocation(line: 2, column: 3, scope: !10)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    DBG_VALUE_LIST !22, !DIExpression(DW_OP_LLVM_arg, 0), %2(<2 x i64>), debug-location !24
    RET_ReallyLR debug-location !24
...
---
# The vector is one of several location operands, so it cannot be split.
name: build_vector_list_multi_arg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $x2
    ; CHECK-LABEL: name: build_vector_list_multi_arg
    ; CHECK: liveins: $x0, $x1, $x2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY $x2
    ; CHECK-NEXT: DBG_VALUE_LIST !12, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), $noreg, $noreg, debug-location !DILocation(line: 2, column: 3, scope: !11)
    ; CHECK-NEXT: RET_ReallyLR implicit [[COPY]](i64), debug-location !DILocation(line: 2, column: 3, scope: !11)
    %0:_(i64) = COPY $x0
    %1:_(i64) = COPY $x1
    %2:_(<2 x i64>) = G_BUILD_VECTOR %0(i64), %1(i64)
    %3:_(i64) = COPY $x2
    DBG_VALUE_LIST !23, !DIExpression(DW_OP_LLVM_arg, 0, DW_OP_LLVM_arg, 1, DW_OP_plus, DW_OP_stack_value), %2(<2 x i64>), %3(i64), debug-location !25
    RET_ReallyLR implicit %3, debug-location !25
...
