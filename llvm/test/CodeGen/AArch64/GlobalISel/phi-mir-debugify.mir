    %7(i32) = G_ADD %0, %6
    %8(i1) = G_TRUNC %7(i32)

  bb.3:
    %9(i1) = G_PHI %5(i1), %bb.1, %8(i1), %bb.2
    %11:_(i1) = G_PHI %5(i1), %bb.1, %8(i1), %bb.2
    %10(i32) = G_ZEXT %9(i1)
    $w0 = COPY %10(i32)
    RET_ReallyLR implicit $w0

