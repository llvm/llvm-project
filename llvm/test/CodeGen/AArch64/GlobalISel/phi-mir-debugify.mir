  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $w0

    %0(i32) = COPY $w0
    %1(i32) = G_CONSTANT i32 0
    %3(i32) = G_CONSTANT i32 1
    %6(i32) = G_CONSTANT i32 2
    %2(i1) = G_ICMP intpred(ugt), %0(i32), %1
    G_BRCOND %2(i1), %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.3(0x80000000)

    %4(i32) = G_ADD %0, %3
