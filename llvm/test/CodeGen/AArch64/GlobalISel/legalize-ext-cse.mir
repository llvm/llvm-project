# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64 -run-pass=legalizer %s -o - -enable-cse-in-legalizer=1 | FileCheck %s
---
name:            test_cse_in_legalizer
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: test_cse_in_legalizer
    ; CHECK: [[COPY:%[0-9]+]]:_(i64) = COPY $x0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC [[COPY]](i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[TRUNC]], [[C]]
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i32) = COPY [[AND]](i32)
    ; CHECK-NEXT: $w0 = COPY [[COPY1]](i32)
    ; CHECK-NEXT: $w0 = COPY [[AND]](i32)
    %0:_(i64) = COPY $x0
    %1:_(i8) = G_TRUNC %0(i64)
    %19:_(i32) = G_ZEXT %1(i8)
    $w0 = COPY %19(i32)
    %2:_(i8) = G_TRUNC %0(i64)
    %20:_(i32) = G_ZEXT %2(i8)
    $w0 = COPY %20(i32)
