---
name:            test_combine_inttoptr_narrow_int_vector
body:             |
  bb.0:
    liveins: $q0

    ; CHECK-LABEL: name: test_combine_inttoptr_narrow_int_vector
    ; CHECK: liveins: $q0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(<2 x p0>) = COPY $q0
    ; CHECK-NEXT: $q0 = COPY [[COPY]](<2 x p0>)
    %0:_(<2 x p0>) = COPY $q0
