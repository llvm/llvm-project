    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $x0
    ; CHECK-NEXT: $x0 = COPY [[COPY]](p0)
    %0:_(p0) = COPY $x0
    %1:_(i16) = G_PTRTOINT %0
    %2:_(p0) = G_INTTOPTR %1
    $x0 = COPY %2
...
