name: test_combine_neg_and_one_to_sext_inreg_s32
body: |
  bb.1:
  liveins: $w0
    ; CHECK-LABEL: name: test_combine_neg_and_one_to_sext_inreg_s32
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %res:_(i32) = G_SEXT_INREG %x, 1
    ; CHECK-NEXT: $w0 = COPY %res(i32)
    %x:_(i32) = COPY $w0
    %one:_(i32) = G_CONSTANT i32 1
    %zero:_(i32) = G_CONSTANT i32 0
    %and:_(i32) = G_AND %x:_, %one:_
    %res:_(i32) = G_SUB %zero:_, %and:_
    $w0 = COPY %res:_(i32)
...
