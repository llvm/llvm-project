name:            dont_apply_shift_imm_too_large
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $w0

    ; LSB must be in 0-31.

    ; CHECK-LABEL: name: dont_apply_shift_imm_too_large
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
