    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %lsb:_(i32) = G_CONSTANT i32 32
    %shift:_(i32) = G_ASHR %x, %lsb
    %sext_inreg:_(i32) = G_SEXT_INREG %shift, 1
    $w0 = COPY %sext_inreg
    RET_ReallyLR implicit $w0

