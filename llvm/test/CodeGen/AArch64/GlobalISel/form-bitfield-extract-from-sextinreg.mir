# RUN: llc -mtriple aarch64 -run-pass=aarch64-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Check that we can fold a G_SEXT_INREG fed by a G_ASHR/G_LSHR into a G_SBFX.

...
---
name:            sextinreg_ashr_to_sbfx
tracksRegLiveness: true
legalized: true
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: sextinreg_ashr_to_sbfx
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %lsb:_(i32) = G_CONSTANT i32 5
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 10
    ; CHECK-NEXT: %sext_inreg:_(i32) = G_SBFX %x, %lsb(i32), [[C]]
    ; CHECK-NEXT: $w0 = COPY %sext_inreg(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %lsb:_(i32) = G_CONSTANT i32 5
    %shift:_(i32) = G_ASHR %x, %lsb
    %sext_inreg:_(i32) = G_SEXT_INREG %shift, 10
    $w0 = COPY %sext_inreg
    RET_ReallyLR implicit $w0

