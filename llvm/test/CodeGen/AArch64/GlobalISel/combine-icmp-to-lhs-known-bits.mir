---
name:            apply_ne
alignment:       4
tracksRegLiveness: true
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: apply_ne
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %known_zero_or_one:_(i32) = G_AND %x, %one
    ; CHECK-NEXT: %cmp:_(i1) = G_TRUNC %known_zero_or_one(i32)
    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %cmp(i1)
    ; CHECK-NEXT: $w0 = COPY %ext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(i32) = COPY $w0
    %one:_(i32) = G_CONSTANT i32 1
    %known_zero_or_one:_(i32) = G_AND %x, %one
    %zero:_(i32) = G_CONSTANT i32 0
    %cmp:_(i1) = G_ICMP intpred(ne), %known_zero_or_one(i32), %zero
    %ext:_(i32) = G_ZEXT %cmp(i1)
    $w0 = COPY %ext(i32)
    RET_ReallyLR implicit $w0

