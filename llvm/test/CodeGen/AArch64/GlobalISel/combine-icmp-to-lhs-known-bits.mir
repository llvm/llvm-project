---
name:            dont_apply_vector
alignment:       4
tracksRegLiveness: true
machineFunctionInfo: {}
body:             |
  bb.0:
    liveins: $x0
    ; True is -1 for vectors on AArch64 so we don't want to combine.

    ; CHECK-LABEL: name: dont_apply_vector
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<2 x i32>) = COPY $x0
    ; CHECK-NEXT: %one:_(i32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %one_vec:_(<2 x i32>) = G_BUILD_VECTOR %one(i32), %one(i32)
    ; CHECK-NEXT: %vec_and:_(<2 x i32>) = G_AND %x, %one_vec
    ; CHECK-NEXT: %zero:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %zero64:_(i64) = G_CONSTANT i64 0
    ; CHECK-NEXT: %zero_vec:_(<2 x i32>) = G_BUILD_VECTOR %zero(i32), %zero(i32)
    ; CHECK-NEXT: %cmp:_(<2 x i1>) = G_ICMP intpred(ne), %vec_and(<2 x i32>), %zero_vec
    ; CHECK-NEXT: %elt:_(i1) = G_EXTRACT_VECTOR_ELT %cmp(<2 x i1>), %zero64(i64)
    ; CHECK-NEXT: %ext:_(i32) = G_ZEXT %elt(i1)
    ; CHECK-NEXT: $w0 = COPY %ext(i32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %x:_(<2 x i32>) = COPY $x0
    %one:_(i32) = G_CONSTANT i32 1
    %one_vec:_(<2 x i32>) = G_BUILD_VECTOR %one, %one
    %vec_and:_(<2 x i32>) = G_AND %x, %one_vec
    %zero:_(i32) = G_CONSTANT i32 0
    %zero64:_(i64) = G_CONSTANT i64 0
    %zero_vec:_(<2 x i32>) = G_BUILD_VECTOR %zero, %zero
    %cmp:_(<2 x i1>) = G_ICMP intpred(ne), %vec_and(<2 x i32>), %zero_vec
    %elt:_(i1) = G_EXTRACT_VECTOR_ELT %cmp, %zero64
    %ext:_(i32) = G_ZEXT %elt(i1)
    $w0 = COPY %ext(i32)
    RET_ReallyLR implicit $w0

