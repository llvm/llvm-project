# RUN: llc -mtriple aarch64-unknown-unknown -run-pass=instruction-select -global-isel-abort=1 %s -o - | FileCheck %s
#
# Check folding a G_UBFX into a G_BRCOND which has been matched as a TB(N)Z.
...
---
name:            fold_ubfx
alignment:       4
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: fold_ubfx
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.0(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %copy:gpr32 = COPY $w0
  ; CHECK-NEXT:   TBNZW %copy, 4, %bb.1
  ; CHECK-NEXT:   B %bb.0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $w0
    %copy:gpr(i32) = COPY $w0
    %lsb:gpr(i32) = G_CONSTANT i32 3
    %width:gpr(i32) = G_CONSTANT i32 2
    %bit:gpr(i32) = G_CONSTANT i32 2
    %zero:gpr(i32) = G_CONSTANT i32 0
    %fold_me:gpr(i32) = G_UBFX %copy, %lsb(i32), %width
    %and:gpr(i32) = G_AND %fold_me, %bit
    %cmp:gpr(i32) = G_ICMP intpred(ne), %and(i32), %zero
    G_BRCOND %cmp, %bb.1
    G_BR %bb.0
  bb.1:
    RET_ReallyLR
...
---
# Bit 1 of a one-bit extract is always zero, so it does not map to a bit of
# the source.
name:            dont_fold_ubfx_bit_past_width
alignment:       4
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: dont_fold_ubfx_bit_past_width
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.0(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %copy:gpr32 = COPY $w0
  ; CHECK-NEXT:   %fold_me:gpr32 = UBFMWri %copy, 3, 3
  ; CHECK-NEXT:   TBNZW %fold_me, 1, %bb.1
  ; CHECK-NEXT:   B %bb.0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $w0
    %copy:gpr(i32) = COPY $w0
    %lsb:gpr(i32) = G_CONSTANT i32 3
    %width:gpr(i32) = G_CONSTANT i32 1
    %bit:gpr(i32) = G_CONSTANT i32 2
    %zero:gpr(i32) = G_CONSTANT i32 0
    %fold_me:gpr(i32) = G_UBFX %copy, %lsb(i32), %width
    %and:gpr(i32) = G_AND %fold_me, %bit
    %cmp:gpr(i32) = G_ICMP intpred(ne), %and(i32), %zero
    G_BRCOND %cmp, %bb.1
    G_BR %bb.0
  bb.1:
    RET_ReallyLR
...
