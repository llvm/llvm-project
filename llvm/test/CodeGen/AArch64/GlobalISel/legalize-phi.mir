tracksRegLiveness: true
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
  - { id: 2, class: _, preferred-register: '' }
  - { id: 3, class: _, preferred-register: '' }
  - { id: 4, class: _, preferred-register: '' }
  - { id: 5, class: _, preferred-register: '' }
  - { id: 6, class: _, preferred-register: '' }
  - { id: 7, class: _, preferred-register: '' }
liveins:
body:             |
  ; CHECK-LABEL: name: legalize_phi_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(i16) = G_PHI [[C]](i16), %bb.0, %14(i16), %bb.1
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[PHI]](i16)
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(i32) = G_ADD [[ANYEXT]], [[C1]]
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(i32) = G_AND [[ADD]], [[C2]]
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[AND]](i32), [[COPY]]
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[ADD]](i32)
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](i32), %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
  ; CHECK-NEXT:   [[AND1:%[0-9]+]]:_(i32) = G_AND [[ADD]], [[C3]]
  ; CHECK-NEXT:   $w0 = COPY [[AND1]](i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $w0
   ; Test that we properly legalize a phi that uses a value from the same BB

    %0(i32) = COPY $w0
    %2(i8) = G_CONSTANT i8 1
    %7(i8) = G_CONSTANT i8 0

  bb.1:
    successors: %bb.1(0x40000000), %bb.3(0x40000000)

    %1(i8) = G_PHI %7(i8), %bb.0, %3(i8), %bb.1
    %3(i8) = G_ADD %1, %2
    %4(i32) = G_ZEXT %3(i8)
    %5(i1) = G_ICMP intpred(ugt), %4(i32), %0
    G_BRCOND %5(i1), %bb.1

  bb.3:
    %6(i32) = G_ZEXT %3(i8)
    $w0 = COPY %6(i32)
    RET_ReallyLR implicit $w0

...
