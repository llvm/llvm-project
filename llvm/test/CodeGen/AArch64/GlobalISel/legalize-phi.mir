  - { id: 12, class: _, preferred-register: '' }
  - { id: 13, class: _, preferred-register: '' }
  - { id: 14, class: _, preferred-register: '' }
  - { id: 15, class: _, preferred-register: '' }
liveins:
body:             |
  ; CHECK-LABEL: name: legalize_phi_diff_bb
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(i32) = COPY $w1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 3
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(i32) = G_CONSTANT i32 44
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[COPY]](i32), [[C]]
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[C1]]
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[ADD]](i32)
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(i16) = G_TRUNC [[ADD]](i32)
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(i16) = G_PHI [[TRUNC1]](i16), %bb.0, %22(i16), %bb.1
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[PHI]](i16)
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(i32) = G_AND [[ANYEXT]], [[C4]]
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[AND]], [[C2]]
  ; CHECK-NEXT:   [[ICMP1:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[ADD1]](i32), [[C3]]
  ; CHECK-NEXT:   [[C5:%[0-9]+]]:_(i16) = G_CONSTANT i16 43
  ; CHECK-NEXT:   G_BRCOND [[ICMP1]](i32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:_(i16) = G_PHI [[PHI]](i16), %bb.1, [[TRUNC]](i16), %bb.0
  ; CHECK-NEXT:   [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[PHI1]](i16)
  ; CHECK-NEXT:   [[C6:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
  ; CHECK-NEXT:   [[AND1:%[0-9]+]]:_(i32) = G_AND [[ANYEXT1]], [[C6]]
  ; CHECK-NEXT:   $w0 = COPY [[AND1]](i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1(0x40000000), %bb.3(0x40000000)
    liveins: $w0, $w1
   ; Make sure that we correctly legalize PHIs sharing common defs
   ; in different BBs.



    %0(i32) = COPY $w0
    %1(i32) = COPY $w1
    %2(i32) = G_CONSTANT i32 0
    %4(i32) = G_CONSTANT i32 3
    %9(i32) = G_CONSTANT i32 1
    %11(i32) = G_CONSTANT i32 44
    %15(i8) = G_CONSTANT i8 43
    %3(i1) = G_ICMP intpred(ugt), %0(i32), %2
    %5(i32) = G_ADD %0, %4
    %6(i8) = G_TRUNC %5(i32)
    G_BRCOND %3(i1), %bb.1
    G_BR %bb.3

  bb.1:
    successors: %bb.3(0x40000000), %bb.1(0x40000000)

    %7(i8) = G_PHI %6(i8), %bb.0, %15(i8), %bb.1
    %8(i32) = G_ZEXT %7(i8)
    %10(i32) = G_ADD %8, %9
    %12(i1) = G_ICMP intpred(ugt), %10(i32), %11
    G_BRCOND %12(i1), %bb.3
    G_BR %bb.1

  bb.3:
    %13(i8) = G_PHI %7(i8), %bb.1, %6(i8), %bb.0
    %14(i32) = G_ZEXT %13(i8)
    $w0 = COPY %14(i32)
    RET_ReallyLR implicit $w0

...
