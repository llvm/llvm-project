name:            legalize_phi_same_bb
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
  - { id: 2, class: _, preferred-register: '' }
  - { id: 3, class: _, preferred-register: '' }
  - { id: 4, class: _, preferred-register: '' }
  - { id: 5, class: _, preferred-register: '' }
  - { id: 6, class: _, preferred-register: '' }
  - { id: 7, class: _, preferred-register: '' }
  - { id: 8, class: _, preferred-register: '' }
  - { id: 9, class: _, preferred-register: '' }
  - { id: 10, class: _, preferred-register: '' }
  - { id: 11, class: _, preferred-register: '' }
  - { id: 12, class: _, preferred-register: '' }
  - { id: 13, class: _, preferred-register: '' }
  - { id: 14, class: _, preferred-register: '' }
liveins:
body:             |
  ; CHECK-LABEL: name: legalize_phi_same_bb
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $w0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 3
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(i32) = G_ICMP intpred(ugt), [[COPY]](i32), [[C]]
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[C1]]
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:_(i32) = G_ADD [[COPY]], [[C2]]
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[ADD1]](i32)
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(i16) = G_TRUNC [[ADD1]](i32)
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(i16) = G_CONSTANT i16 42
  ; CHECK-NEXT:   [[TRUNC2:%[0-9]+]]:_(i16) = G_TRUNC [[ADD]](i32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(i16) = G_PHI [[TRUNC1]](i16), %bb.1, [[TRUNC2]](i16), %bb.2
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:_(i16) = G_PHI [[TRUNC]](i16), %bb.1, [[C3]](i16), %bb.2
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[PHI]](i16)
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(i32) = G_AND [[ANYEXT]], [[C4]]
  ; CHECK-NEXT:   [[ANYEXT1:%[0-9]+]]:_(i32) = G_ANYEXT [[PHI1]](i16)
  ; CHECK-NEXT:   [[AND1:%[0-9]+]]:_(i32) = G_AND [[ANYEXT1]], [[C4]]
  ; CHECK-NEXT:   [[ADD2:%[0-9]+]]:_(i32) = G_ADD [[AND]], [[AND1]]
  ; CHECK-NEXT:   $w0 = COPY [[ADD2]](i32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $w0
   ; Make sure that we correctly insert the new legalized G_PHI at the
   ; correct location (ie make sure G_PHIs are the first insts in the BB).




    %0(i32) = COPY $w0
    %1(i32) = G_CONSTANT i32 0
    %3(i32) = G_CONSTANT i32 3
    %6(i32) = G_CONSTANT i32 1
    %14(i8) = G_CONSTANT i8 42
    %2(i1) = G_ICMP intpred(ugt), %0(i32), %1
    %4(i32) = G_ADD %0, %3
    %5(i8) = G_TRUNC %4(i32)
    G_BRCOND %2(i1), %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.3(0x80000000)

    %7(i32) = G_ADD %0, %6
    %8(i8) = G_TRUNC %7(i32)
    G_BR %bb.3

  bb.2:
    successors: %bb.3(0x80000000)


  bb.3:
    %9(i8) = G_PHI %8(i8), %bb.1, %5(i8), %bb.2
    %10(i8) = G_PHI %8(i8), %bb.1, %14(i8), %bb.2
    %11(i32) = G_ZEXT %9(i8)
    %12(i32) = G_ZEXT %10(i8)
    %13(i32) = G_ADD %11, %12
    $w0 = COPY %13(i32)
    RET_ReallyLR implicit $w0

...
