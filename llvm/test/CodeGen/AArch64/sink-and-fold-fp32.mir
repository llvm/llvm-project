---
name: sxtw_scaled
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1, $s0
    ; CHECK-LABEL: name: sxtw_scaled
    ; CHECK: liveins: $x0, $x1, $s0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64common = COPY $x0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr64 = COPY $x1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY [[COPY1]].sub_32
    ; CHECK-NEXT: [[LDRSroW:%[0-9]+]]:fpr32 = LDRSroW [[COPY]], [[COPY2]], 1, 1
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fpr32 = COPY $s0
    ; CHECK-NEXT: [[COPY4:%[0-9]+]]:gpr32 = COPY [[COPY1]].sub_32
    ; CHECK-NEXT: STRSroW [[COPY3]], [[COPY]], [[COPY4]], 1, 1
    ; CHECK-NEXT: RET_ReallyLR
    %0:gpr64common = COPY $x0
    %1:gpr64 = COPY $x1
    %2:gpr64common = SBFMXri %1, 0, 31
    %3:fpr32 = LDRSroX %0, %2, 0, 1
    %4:fpr32 = COPY $s0
    STRSroX %4, %0, %2, 0, 1
    RET_ReallyLR
...

