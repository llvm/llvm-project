  ; CHECK-NEXT:   [[UBFMXri:%[0-9]+]]:gpr64 = UBFMXri [[COPY]], 32, 63
  ; CHECK-NEXT:   CBNZX [[UBFMXri]], %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET_ReallyLR implicit $nzcv
  bb.0:
    liveins: $x0
    %0:gpr64 = COPY $x0

  bb.1:
