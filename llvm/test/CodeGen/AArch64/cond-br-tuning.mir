  ; CHECK-NEXT:   $xzr = SUBSXrr [[COPY]], [[MOVi64imm]], implicit-def $nzcv
  ; CHECK-NEXT:   Bcc 2, %bb.1, implicit $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
