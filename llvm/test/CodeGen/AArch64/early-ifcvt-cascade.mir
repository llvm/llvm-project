  ; CHECK-NEXT:   liveins: $x1, $w2, $w3, $w4, $w5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x1
