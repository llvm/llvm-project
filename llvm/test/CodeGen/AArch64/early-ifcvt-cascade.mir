    ; Thresholds from registers, not memory loads
    %10:gpr32 = COPY %3
    %11:gpr32 = COPY %4
    %12:gpr32 = COPY %5
    %13:gpr32 = COPY %3
    %14:gpr32 = COPY %4
    %15:gpr32 = COPY %5
    %16:gpr32 = COPY %3
