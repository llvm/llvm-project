  ; CHECK-NEXT:   $x0 = COPY [[PHI2]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.10(0x30000000), %bb.1(0x50000000)
    liveins: $x1, $w2, $w3, $w4, $w5

    %1:gpr64common = COPY $x1
    %2:gpr32 = COPY $w2
    %3:gpr32 = COPY $w3
    %4:gpr32 = COPY $w4
    %5:gpr32 = COPY $w5
    %99:gpr64all = COPY $xzr
    CBZW %2, %bb.10
    B %bb.1

  bb.1:
