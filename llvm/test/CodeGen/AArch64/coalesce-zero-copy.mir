# RUN: llc -mtriple=aarch64 -run-pass=register-coalescer -verify-machineinstrs %s -o - | FileCheck %s

# Copies from both architectural zero registers must be coalesced before
# higher-priority blocks merge their intervals with PHI-elimination registers.
---
name: zero_copy_priority_32
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: zero_copy_priority_32
  ; CHECK: bb.0:
  ; CHECK-NOT: COPY $wzr
  ; CHECK: dead $wzr = SUBSWrr {{%[0-9]+}}, $wzr, implicit-def $nzcv
  ; CHECK: bb.1:
  ; CHECK: [[RESULT:%[0-9]+]]:gpr32 = COPY $wzr
  ; CHECK-NEXT: dead $wzr = SUBSWrr [[VALUE:%[0-9]+]], $wzr, implicit-def $nzcv
  ; CHECK: bb.2:
  ; CHECK: [[RESULT]]:gpr32 = COPY [[VALUE]]
  ; CHECK: bb.3:
  ; CHECK: $w0 = COPY [[RESULT]]
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $w0, $w1
    %0:gpr32 = COPY $wzr
    %1:gpr32 = COPY $w0
    %2:gpr32 = COPY $w1
    dead $wzr = SUBSWrr %1, %0, implicit-def $nzcv
    Bcc 1, %bb.2, implicit killed $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    %3:gpr32 = COPY %0
    dead $wzr = SUBSWrr %2, %0, implicit-def $nzcv
    Bcc 1, %bb.3, implicit killed $nzcv
    B %bb.2

  bb.2:
    successors: %bb.3
    %3:gpr32 = COPY %2
    B %bb.3

  bb.3:
    $w0 = COPY %3
    RET_ReallyLR implicit $w0
...
---
name: zero_copy_priority_64
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: zero_copy_priority_64
  ; CHECK: bb.0:
  ; CHECK-NOT: COPY $xzr
  ; CHECK: dead $xzr = SUBSXrr {{%[0-9]+}}, $xzr, implicit-def $nzcv
  ; CHECK: bb.1:
  ; CHECK: [[RESULT:%[0-9]+]]:gpr64 = COPY $xzr
  ; CHECK-NEXT: dead $xzr = SUBSXrr [[VALUE:%[0-9]+]], $xzr, implicit-def $nzcv
  ; CHECK: bb.2:
  ; CHECK: [[RESULT]]:gpr64 = COPY [[VALUE]]
  ; CHECK: bb.3:
  ; CHECK: $x0 = COPY [[RESULT]]
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $x1
    %0:gpr64 = COPY $xzr
    %1:gpr64 = COPY $x0
    %2:gpr64 = COPY $x1
    dead $xzr = SUBSXrr %1, %0, implicit-def $nzcv
    Bcc 1, %bb.2, implicit killed $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    %3:gpr64 = COPY %0
    dead $xzr = SUBSXrr %2, %0, implicit-def $nzcv
    Bcc 1, %bb.3, implicit killed $nzcv
    B %bb.2

  bb.2:
    successors: %bb.3
    %3:gpr64 = COPY %2
    B %bb.3

  bb.3:
    $x0 = COPY %3
    RET_ReallyLR implicit $x0
...
