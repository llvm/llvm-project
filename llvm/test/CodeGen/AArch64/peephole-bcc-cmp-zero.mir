# A dead select reading the flags goes away with the compare. This is the
# shape the CSINC-of-wzr fold above leaves behind for a CAS success check.
name: subs_x_bne_dead_csinc
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: subs_x_bne_dead_csinc
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x0
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[COPY]], 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
  ; CHECK-NEXT:   Bcc 1, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $w0 = MOVZWi 1, 0
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = MOVZWi 2, 0
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $x0
    %0:gpr64common = COPY $x0
    %1:gpr64 = SUBSXri %0, 0, 0, implicit-def $nzcv
    %2:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1
  bb.1:
    $w0 = MOVZWi 1, 0
    RET_ReallyLR implicit $w0
  bb.2:
    $w0 = MOVZWi 2, 0
    RET_ReallyLR implicit $w0
...
---
