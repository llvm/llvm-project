    liveins: $x0
    %0:gpr64common = COPY $x0
    %1:gpr64 = SUBSXri %0, 0, 0, implicit-def $nzcv
    Bcc 0, %bb.2, implicit $nzcv
    Bcc 4, %bb.3, implicit $nzcv
    B %bb.1
  bb.1:
    $w0 = MOVZWi 1, 0
    RET_ReallyLR implicit $w0
  bb.2:
    $w0 = MOVZWi 2, 0
    RET_ReallyLR implicit $w0
  bb.3:
    $w0 = MOVZWi 3, 0
    RET_ReallyLR implicit $w0
...
