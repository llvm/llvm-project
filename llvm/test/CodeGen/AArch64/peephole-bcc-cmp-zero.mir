# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64-unknown-linux-gnu -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s

# 'CMP Rn, #0; B.eq/B.ne' folds to 'CBZ/CBNZ Rn' when the branch is the only
# live reader of the flags and the compare result is unused.
---
name: subs_x_beq
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: subs_x_beq
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x0
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[COPY]], 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   Bcc 0, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $w0 = MOVZWi 1, 0
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = MOVZWi 2, 0
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $x0
    %0:gpr64common = COPY $x0
    %1:gpr64 = SUBSXri %0, 0, 0, implicit-def $nzcv
    Bcc 0, %bb.2, implicit $nzcv
    B %bb.1
  bb.1:
    $w0 = MOVZWi 1, 0
    RET_ReallyLR implicit $w0
  bb.2:
    $w0 = MOVZWi 2, 0
    RET_ReallyLR implicit $w0
...
---
