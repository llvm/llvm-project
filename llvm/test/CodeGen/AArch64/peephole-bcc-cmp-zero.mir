# Negative: the select's result is used, so the flags have a second live
# reader.
name: subs_x_beq_live_csel
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: subs_x_beq_live_csel
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64common = COPY $x1
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[COPY]], 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[CSELXr:%[0-9]+]]:gpr64 = CSELXr [[COPY]], [[COPY1]], 1, implicit $nzcv
  ; CHECK-NEXT:   Bcc 0, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $x0 = COPY [[CSELXr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = MOVZWi 2, 0
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $x0, $x1
    %0:gpr64common = COPY $x0
    %1:gpr64common = COPY $x1
    %2:gpr64 = SUBSXri %0, 0, 0, implicit-def $nzcv
    %3:gpr64 = CSELXr %0, %1, 1, implicit $nzcv
    Bcc 0, %bb.2, implicit $nzcv
    B %bb.1
  bb.1:
    $x0 = COPY %3
    RET_ReallyLR implicit $x0
  bb.2:
    $w0 = MOVZWi 2, 0
    RET_ReallyLR implicit $w0
...
