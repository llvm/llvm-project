; RUN: llc < %s -mtriple=aarch64-unknown-linux-gnu | FileCheck %s

; A select on an illegal integer vector whose operands are already in packed
; form (a load and a constant) and whose result goes straight back to memory.
; The value never needs to exist in the promoted, one-element-per-lane form, so
; the select can be done on a legal type of the same width.

define void @select_v16i4(i1 %cond, ptr %p, ptr %out) {
; CHECK-LABEL: select_v16i4:
; CHECK:       // %bb.0:
; CHECK-NEXT:    tst w0, #0x1
; CHECK-NEXT:    ldr d1, [x1]
; CHECK-NEXT:    csetm w8, ne
; CHECK-NEXT:    dup v0.8b, w8
; CHECK-NEXT:    and v0.8b, v1.8b, v0.8b
; CHECK-NEXT:    str d0, [x2]
; CHECK-NEXT:    ret
  %v = load <16 x i4>, ptr %p
  %s = select i1 %cond, <16 x i4> %v, <16 x i4> zeroinitializer
  store <16 x i4> %s, ptr %out
  ret void
}

