; On big-endian targets, element 0 is in bits 59:56; bits 63:60 are padding.
define i4 @be_v15i4(ptr %pa, i1 %c) {
; CHECK-LABEL: be_v15i4:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sub sp, sp, #16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    tst w1, #0x1
; CHECK-NEXT:    ldr d1, [x0]
; CHECK-NEXT:    csetm w8, ne
; CHECK-NEXT:    dup v0.8b, w8
; CHECK-NEXT:    and v0.8b, v1.8b, v0.8b
; CHECK-NEXT:    fmov x8, d0
; CHECK-NEXT:    and w0, w8, #0xf
; CHECK-NEXT:    add sp, sp, #16
; CHECK-NEXT:    ret
;
; BE-LABEL: be_v15i4:
; BE:       // %bb.0:
; BE-NEXT:    ldr x8, [x0]
; BE-NEXT:    tst w1, #0x1
; BE-NEXT:    csetm w9, ne
; BE-NEXT:    lsr x8, x8, #56
; BE-NEXT:    dup v0.16b, w9
; BE-NEXT:    fmov s1, w8
; BE-NEXT:    and v0.16b, v1.16b, v0.16b
; BE-NEXT:    umov w0, v0.b[0]
; BE-NEXT:    ret
  %a = load <15 x i4>, ptr %pa, align 1
  %s = select i1 %c, <15 x i4> %a, <15 x i4> zeroinitializer
  %e = extractelement <15 x i4> %s, i32 0
  ret i4 %e
}
