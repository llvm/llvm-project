; The offset is consumed by an addressing mode rather than escaping.
define i64 @alloca_offset_load() {
; CHECK-LABEL: alloca_offset_load:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sub sp, sp, #64
; CHECK-NEXT:    .cfi_def_cfa_offset 64
; CHECK-NEXT:    ldr x0, [sp, #8]
; CHECK-NEXT:    add sp, sp, #64
; CHECK-NEXT:    ret
  %a = alloca [64 x i8], align 8
  %p = getelementptr inbounds i8, ptr %a, i64 8
  %v = load i64, ptr %p
  ret i64 %v
}
