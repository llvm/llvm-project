; RUN: llc -mtriple=aarch64-none-linux-gnu -mattr=+sve < %s | FileCheck %s --check-prefixes=CHECK,CHECK-SVE

; Test optimization of DUP with extended narrow loads
; This should avoid GPR->SIMD transfers by loading directly into vector registers

define <4 x i16> @test_dup_zextload_i8_v4i16(ptr %p) {
; CHECK-BASE-LABEL: test_dup_zextload_i8_v4i16:
; CHECK-BASE:       // %bb.0:
; CHECK-BASE-NEXT:    ldr b0, [x0]
; CHECK-BASE-NEXT:    dup v0.4h, v0.h[0]
; CHECK-BASE-NEXT:    ret
;
; CHECK-SVE-NO-LD1R-LABEL: test_dup_zextload_i8_v4i16:
; CHECK-SVE-NO-LD1R:       // %bb.0:
; CHECK-SVE-NO-LD1R-NEXT:    ldr b0, [x0]
; CHECK-SVE-NO-LD1R-NEXT:    dup v0.4h, v0.h[0]
; CHECK-SVE-NO-LD1R-NEXT:    ret
;
; CHECK-SVE-LABEL: test_dup_zextload_i8_v4i16:
; CHECK-SVE:       // %bb.0:
; CHECK-SVE-NEXT:    ptrue p0.h
; CHECK-SVE-NEXT:    ld1rb { z0.h }, p0/z, [x0]
; CHECK-SVE-NEXT:    // kill: def $d0 killed $d0 killed $z0
; CHECK-SVE-NEXT:    ret
  %load = load i8, ptr %p, align 1
  %ext = zext i8 %load to i16
  %vec = insertelement <4 x i16> poison, i16 %ext, i32 0
  %dup = shufflevector <4 x i16> %vec, <4 x i16> poison, <4 x i32> zeroinitializer
  ret <4 x i16> %dup
}

