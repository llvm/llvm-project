; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64 -mattr=+reserve-x21,+reserve-x22 -aarch64-stress-ccmp < %s | FileCheck %s

; x21 and x22 are reserved and hold global register variables. A definition
; of a reserved register must not be hoisted out of a loop or executed
; speculatively: liveness does not track reserved registers, so the previous
; value may still be read, and the write must not happen on paths where the
; source does not perform it.

@mem = external global [16 x i32]

declare i32 @llvm.read_register.i32(metadata)
declare void @llvm.write_register.i32(metadata, i32)
declare void @ext()

; The first iteration stores the old value of w21, so `mov w21, #7` has to
; stay in the loop (post-RA MachineLICM).
define void @licm(i32 %n) {
; CHECK-LABEL: licm:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    cbz w0, .LBB0_3
; CHECK-NEXT:  // %bb.1: // %ph
; CHECK-NEXT:    adrp x8, :got:mem
; CHECK-NEXT:    mov w9, w0
; CHECK-NEXT:    ldr x8, [x8, :got_lo12:mem]
; CHECK-NEXT:  .LBB0_2: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    subs x9, x9, #1
; CHECK-NEXT:    str w21, [x8], #4
; CHECK-NEXT:    mov w21, #7 // =0x7
; CHECK-NEXT:    b.ne .LBB0_2
; CHECK-NEXT:  .LBB0_3: // %exit
; CHECK-NEXT:    ret
entry:
  %z = icmp eq i32 %n, 0
  br i1 %z, label %exit, label %ph

ph:
  %wide = zext i32 %n to i64
  br label %loop

loop:
  %i = phi i64 [ 0, %ph ], [ %next, %loop ]
  %old = tail call i32 @llvm.read_register.i32(metadata !0)
  %p = getelementptr inbounds [16 x i32], ptr @mem, i64 0, i64 %i
  store i32 %old, ptr %p, align 4
  tail call void @llvm.write_register.i32(metadata !0, i32 7)
  %next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %next, %wide
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; The write is conditional and must stay behind the branch (early-ifcvt).
define i32 @ifcvt(i32 %a, i32 %b) {
; CHECK-LABEL: ifcvt:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    cbz w0, .LBB1_2
; CHECK-NEXT:  // %bb.1: // %then
; CHECK-NEXT:    add w0, w1, #1
; CHECK-NEXT:    mov w21, w1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    mov w0, #3 // =0x3
; CHECK-NEXT:    ret
entry:
  %z = icmp eq i32 %a, 0
  br i1 %z, label %join, label %then

then:
  tail call void @llvm.write_register.i32(metadata !0, i32 %b)
  %inc = add i32 %b, 1
  br label %join

join:
  %r = phi i32 [ %inc, %then ], [ 3, %entry ]
  ret i32 %r
}

; The write sits between two compares and must not be executed when the
; first one fails (AArch64ConditionalCompares).
define void @ccmp(i32 %a, i32 %b) {
; CHECK-LABEL: ccmp:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    cmp w0, #5
; CHECK-NEXT:    b.ne .LBB2_3
; CHECK-NEXT:  // %bb.1: // %second
; CHECK-NEXT:    cmp w22, w1
; CHECK-NEXT:    add w21, w1, #1
; CHECK-NEXT:    b.ne .LBB2_3
; CHECK-NEXT:  // %bb.2: // %call
; CHECK-NEXT:    b ext
; CHECK-NEXT:  .LBB2_3: // %exit
; CHECK-NEXT:    ret
entry:
  %c1 = icmp eq i32 %a, 5
  br i1 %c1, label %second, label %exit

second:
  %inc = add i32 %b, 1
  tail call void @llvm.write_register.i32(metadata !0, i32 %inc)
  %other = tail call i32 @llvm.read_register.i32(metadata !1)
  %c2 = icmp eq i32 %other, %b
  br i1 %c2, label %call, label %exit

call:
  tail call void @ext()
  br label %exit

exit:
  ret void
}

!llvm.named.register.w21 = !{!0}
!llvm.named.register.w22 = !{!1}
!0 = !{!"w21"}
!1 = !{!"w22"}
