; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=aarch64 -mattr=+complxnum,+sme,+fullfp16 -o - | FileCheck %s

; Expected not to transform as NEON cmla is not available in streaming mode.
define <4 x half> @complex_mul_streaming_mode(<4 x half> %a, <4 x half> %b) "aarch64_pstate_sm_enabled" {
; CHECK-LABEL: complex_mul_streaming_mode:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    adrp x8, .LCPI0_0
; CHECK-NEXT:    adrp x9, .LCPI0_1
; CHECK-NEXT:    ptrue p0.h, vl4
; CHECK-NEXT:    ldr q2, [x8, :lo12:.LCPI0_0]
; CHECK-NEXT:    ldr q3, [x9, :lo12:.LCPI0_1]
; CHECK-NEXT:    tbl z4.h, { z0.h }, z2.h
; CHECK-NEXT:    tbl z0.h, { z0.h }, z3.h
; CHECK-NEXT:    tbl z3.h, { z1.h }, z3.h
; CHECK-NEXT:    tbl z1.h, { z1.h }, z2.h
; CHECK-NEXT:    movprfx z2, z3
; CHECK-NEXT:    fmul z2.h, p0/m, z2.h, z4.h
; CHECK-NEXT:    fmul z3.h, p0/m, z3.h, z0.h
; CHECK-NEXT:    fmad z0.h, p0/m, z1.h, z2.h
; CHECK-NEXT:    fnmsb z1.h, p0/m, z4.h, z3.h
; CHECK-NEXT:    trn2 z2.h, z1.h, z0.h
; CHECK-NEXT:    zip1 z0.h, z1.h, z0.h
; CHECK-NEXT:    zip1 z0.s, z0.s, z2.s
; CHECK-NEXT:    ret
entry:
  %a.re = shufflevector <4 x half> %a, <4 x half> poison, <2 x i32> <i32 0, i32 2>
  %a.im = shufflevector <4 x half> %a, <4 x half> poison, <2 x i32> <i32 1, i32 3>
  %b.re = shufflevector <4 x half> %b, <4 x half> poison, <2 x i32> <i32 0, i32 2>
  %b.im = shufflevector <4 x half> %b, <4 x half> poison, <2 x i32> <i32 1, i32 3>
  %t0 = fmul fast <2 x half> %b.im, %a.re
  %t1 = fmul fast <2 x half> %b.re, %a.im
  %im = fadd fast <2 x half> %t1, %t0
  %t3 = fmul fast <2 x half> %b.re, %a.re
  %t4 = fmul fast <2 x half> %a.im, %b.im
  %re = fsub fast <2 x half> %t3, %t4
  %r = shufflevector <2 x half> %re, <2 x half> %im, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
  ret <4 x half> %r
}
