# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=regallocfast %s -o - | FileCheck %s

# An inline asm use tied to a physical register def is copied into that
# register when its value lives elsewhere. No other use of the asm may be
# assigned that register. $q0 is first in the allocation order.

---
# %0 is also read after the asm.
name: tied_live_after
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q1, $x0

    ; CHECK-LABEL: name: tied_live_after
    ; CHECK: liveins: $q1, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $q0 = LDRQui killed $x0, 0
    ; CHECK-NEXT: $q0 = COPY $q1
    ; CHECK-NEXT: INLINEASM &"", attdialect, regdef-ec, implicit-def dead early-clobber $q0, reguse tiedto:$0, renamable $q0(tied-def 3), reguse:FPR128, killed renamable $q0
    ; CHECK-NEXT: RET_ReallyLR implicit killed $q1
    %0:fpr128 = COPY $q1
    %1:fpr128 = LDRQui $x0, 0
    INLINEASM &"", attdialect, regdef-ec, implicit-def early-clobber $q0, reguse tiedto:$0, %0(tied-def 3), reguse:FPR128, %1
    $q1 = COPY %0
    RET_ReallyLR implicit $q1
...
---
# %0 is tied to two physical registers.
name: tied_twice
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q2, $x0

    ; CHECK-LABEL: name: tied_twice
    ; CHECK: liveins: $q2, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $q0 = LDRQui $x0, 0
    ; CHECK-NEXT: renamable $q1 = LDRQui killed $x0, 1
    ; CHECK-NEXT: $q0 = COPY $q2
    ; CHECK-NEXT: $q1 = COPY $q2
    ; CHECK-NEXT: INLINEASM &"", attdialect, regdef-ec, implicit-def dead early-clobber $q0, regdef-ec, implicit-def dead early-clobber $q1, reguse tiedto:$0, killed renamable $q0(tied-def 3), reguse tiedto:$1, renamable $q1(tied-def 5), reguse:FPR128, killed renamable $q0, reguse:FPR128, killed renamable $q1
    ; CHECK-NEXT: RET_ReallyLR
    %0:fpr128 = COPY $q2
    %1:fpr128 = LDRQui $x0, 0
    %2:fpr128 = LDRQui $x0, 1
    INLINEASM &"", attdialect, regdef-ec, implicit-def early-clobber $q0, regdef-ec, implicit-def early-clobber $q1, reguse tiedto:$0, %0(tied-def 3), reguse tiedto:$1, %0(tied-def 5), reguse:FPR128, %1, reguse:FPR128, %2
    RET_ReallyLR
...
---
# An untied use of %0 is allocated before the tied one.
name: untied_before_tied
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q1, $x0

    ; CHECK-LABEL: name: untied_before_tied
    ; CHECK: liveins: $q1, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $q0 = LDRQui killed $x0, 0
    ; CHECK-NEXT: $q0 = COPY $q1
    ; CHECK-NEXT: INLINEASM &"", attdialect, regdef, implicit-def dead $q0, reguse:FPR128, killed renamable $q1, reguse tiedto:$0, renamable $q0(tied-def 3), reguse:FPR128, killed renamable $q0
    ; CHECK-NEXT: RET_ReallyLR
    %0:fpr128 = COPY $q1
    %1:fpr128 = LDRQui $x0, 0
    INLINEASM &"", attdialect, regdef, implicit-def $q0, reguse:FPR128, %0, reguse tiedto:$0, %0(tied-def 3), reguse:FPR128, %1
    RET_ReallyLR
...
