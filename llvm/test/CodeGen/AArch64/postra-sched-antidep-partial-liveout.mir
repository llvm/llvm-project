# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=post-RA-sched \
# RUN:   -break-anti-dependencies=all -o - %s | FileCheck %s

# $d6 is live into the successor, and it shares tuple registers (e.g. $d6_d7)
# with $d7. $d7 itself is not live out of bb.0, so it can be renamed.
---
name:            rename_reg_sharing_tuple_with_livein
body:             |
  ; CHECK-LABEL: name: rename_reg_sharing_tuple_with_livein
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x1, $x2, $x3, $d1, $d6, $d7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $d3 = nofpexcept FADDDrr killed renamable $d7, killed renamable $d1, implicit $fpcr
  ; CHECK-NEXT:   $d14 = LDRDui killed renamable $x0, 0 :: (load (s64))
  ; CHECK-NEXT:   STRDui killed $d14, killed renamable $x1, 0 :: (store (s64))
  ; CHECK-NEXT:   STRDui killed renamable $d3, killed renamable $x2, 0 :: (store (s64))
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $x3, $d6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   STRDui killed renamable $d6, killed renamable $x3, 0 :: (store (s64))
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.1
    liveins: $x0, $x1, $x2, $x3, $d1, $d6, $d7
    renamable $d3 = nofpexcept FADDDrr renamable $d7, renamable $d1, implicit $fpcr
    renamable $d7 = LDRDui renamable $x0, 0 :: (load (s64))
    STRDui renamable $d7, renamable $x1, 0 :: (store (s64))
    STRDui renamable $d3, renamable $x2, 0 :: (store (s64))
    B %bb.1

  bb.1:
    liveins: $x3, $d6
    STRDui renamable $d6, renamable $x3, 0 :: (store (s64))
    RET_ReallyLR
...

# $d6 is live into the successor. The def of the tuple $d6_d7 overlaps it, so
# it cannot be renamed, even though $d6_d7 is not fully live out.
---
name:            no_rename_tuple_def_with_livein
body:             |
  ; CHECK-LABEL: name: no_rename_tuple_def_with_livein
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x2, $x3, $d1, $d7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $d3 = nofpexcept FADDDrr killed renamable $d7, killed renamable $d1, implicit $fpcr
  ; CHECK-NEXT:   renamable $d6_d7 = LD1Twov8b killed renamable $x0 :: (load (s128))
  ; CHECK-NEXT:   STRDui killed renamable $d7, renamable $x2, 0 :: (store (s64))
  ; CHECK-NEXT:   STRDui killed renamable $d3, killed renamable $x2, 8 :: (store (s64))
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $x3, $d6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   STRDui killed renamable $d6, killed renamable $x3, 0 :: (store (s64))
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.1
    liveins: $x0, $x2, $x3, $d1, $d7
    renamable $d3 = nofpexcept FADDDrr renamable $d7, renamable $d1, implicit $fpcr
    renamable $d6_d7 = LD1Twov8b renamable $x0 :: (load (s128))
    STRDui renamable $d7, renamable $x2, 0 :: (store (s64))
    STRDui renamable $d3, renamable $x2, 8 :: (store (s64))
    B %bb.1

  bb.1:
    liveins: $x3, $d6
    STRDui renamable $d6, renamable $x3, 0 :: (store (s64))
    RET_ReallyLR
...
