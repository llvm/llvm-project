; CHECK-NEXT:    str x0, [sp, #16] // 8-byte Spill
; CHECK-NEXT:    mov x9, x1
; CHECK-NEXT:    mov x8, x2
; CHECK-NEXT:    mov x10, xzr
; CHECK-NEXT:    str x10, [sp, #40] // 8-byte Spill
