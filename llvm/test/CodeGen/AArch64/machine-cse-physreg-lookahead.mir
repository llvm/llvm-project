# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=machine-cse -o - %s | FileCheck %s
# RUN: llc -mtriple=aarch64 -passes=machine-cse -o - %s | FileCheck %s

# MachineCSE can reuse $nzcv from an FCMP in the sole predecessor only if no
# instruction in between clobbers it. PhysRegDefsReach checks this by scanning
# forward, but only up to a small lookahead limit (5).

---
#   int foo(double a, double b, int *p) {
#     if (a < b) { *p = 7; return -1; }
#     if (a > b) { *p = 8; return +1; }
#     return 0;
#   }
# Five instructions between the two compares, all defining only virtual
# registers: none can clobber $nzcv, so the second FCMP is redundant.
name: 5_vregs_in_bet_2_fcmp_cse
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: 5_vregs_in_bet_2_fcmp_cse
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $d0, $d1, $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:fpr64 = COPY $d1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:fpr64 = COPY $d0
  ; CHECK-NEXT:   [[MOVi32imm:%[0-9]+]]:gpr32 = MOVi32imm -1
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr32all = COPY [[MOVi32imm]]
  ; CHECK-NEXT:   [[MOVi32imm1:%[0-9]+]]:gpr32 = MOVi32imm 7
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gpr32all = COPY [[MOVi32imm1]]
  ; CHECK-NEXT:   nofpexcept FCMPDrr [[COPY2]], [[COPY1]], implicit-def $nzcv, implicit $fpcr
  ; CHECK-NEXT:   Bcc 4, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:gpr32all = COPY $wzr
  ; CHECK-NEXT:   [[MOVi32imm2:%[0-9]+]]:gpr32 = MOVi32imm 1
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:gpr32all = COPY [[MOVi32imm2]]
  ; CHECK-NEXT:   [[MOVi32imm3:%[0-9]+]]:gpr32 = MOVi32imm 8
  ; CHECK-NEXT:   [[COPY7:%[0-9]+]]:gpr32all = COPY [[MOVi32imm3]]
  ; CHECK-NEXT:   Bcc 13, %bb.3, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr32 = PHI [[COPY4]], %bb.0, [[COPY7]], %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr32all = PHI [[COPY3]], %bb.0, [[COPY6]], %bb.1
  ; CHECK-NEXT:   STRWui [[PHI]], [[COPY]], 0
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:gpr32all = PHI [[COPY5]], %bb.1, [[PHI1]], %bb.2
  ; CHECK-NEXT:   $w0 = COPY [[PHI2]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $d0, $d1, $x0

    %5:gpr64common = COPY $x0
    %4:fpr64 = COPY $d1
    %3:fpr64 = COPY $d0
    %8:gpr32 = MOVi32imm -1
    %7:gpr32all = COPY %8
    %9:gpr32 = MOVi32imm 7
    %6:gpr32all = COPY %9
    nofpexcept FCMPDrr %3, %4, implicit-def $nzcv, implicit $fpcr
    Bcc 4, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %12:gpr32all = COPY $wzr
    %14:gpr32 = MOVi32imm 1
    %11:gpr32all = COPY %14
    %15:gpr32 = MOVi32imm 8
    %10:gpr32all = COPY %15
    nofpexcept FCMPDrr %3, %4, implicit-def $nzcv, implicit $fpcr
    Bcc 13, %bb.3, implicit $nzcv
    B %bb.2

  bb.2:
    successors: %bb.3

    %0:gpr32 = PHI %6, %bb.0, %10, %bb.1
    %1:gpr32all = PHI %7, %bb.0, %11, %bb.1
    STRWui %0, %5, 0
    B %bb.3

  bb.3:
    %2:gpr32all = PHI %12, %bb.1, %1, %bb.2
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
# Four instructions defining physregs and one defining only a vreg between the
# two compares. Only the physreg defs need to count against the lookahead
# limit, and four of them fit in it.
name: 4_physregs_1_vreg_in_bet_2_fcmp_cse
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: 4_physregs_1_vreg_in_bet_2_fcmp_cse
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $d0, $d1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:fpr64 = COPY $d1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:fpr64 = COPY $d0
  ; CHECK-NEXT:   nofpexcept FCMPDrr [[COPY1]], [[COPY]], implicit-def $nzcv, implicit $fpcr
  ; CHECK-NEXT:   Bcc 4, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead $w1 = MOVi32imm 1
  ; CHECK-NEXT:   dead $w2 = MOVi32imm 2
  ; CHECK-NEXT:   dead $w3 = MOVi32imm 3
  ; CHECK-NEXT:   [[MOVi32imm:%[0-9]+]]:gpr32 = MOVi32imm 6
  ; CHECK-NEXT:   dead $w4 = MOVi32imm 4
  ; CHECK-NEXT:   Bcc 13, %bb.3, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = MOVi32imm 1
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $w0 = COPY $wzr
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $d0, $d1

    %4:fpr64 = COPY $d1
    %3:fpr64 = COPY $d0
    nofpexcept FCMPDrr %3, %4, implicit-def $nzcv, implicit $fpcr
    Bcc 4, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    dead $w1 = MOVi32imm 1
    dead $w2 = MOVi32imm 2
    dead $w3 = MOVi32imm 3
    %2:gpr32 = MOVi32imm 6
    dead $w4 = MOVi32imm 4
    nofpexcept FCMPDrr %3, %4, implicit-def $nzcv, implicit $fpcr
    Bcc 13, %bb.3, implicit $nzcv
    B %bb.2

  bb.2:
    $w0 = MOVi32imm 1
    RET_ReallyLR implicit $w0

  bb.3:
    $w0 = COPY $wzr
    RET_ReallyLR implicit $w0
...
---
# Same as above with an integer compare (SUBSWrr) instead of FCMPDrr.
name: 4_physregs_1_vreg_in_bet_2_cmp_cse
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: 4_physregs_1_vreg_in_bet_2_cmp_cse
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $w1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[COPY1]], [[COPY]], implicit-def $nzcv
  ; CHECK-NEXT:   Bcc 11, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead $w2 = MOVi32imm 2
  ; CHECK-NEXT:   dead $w3 = MOVi32imm 3
  ; CHECK-NEXT:   dead $w4 = MOVi32imm 4
  ; CHECK-NEXT:   [[MOVi32imm:%[0-9]+]]:gpr32 = MOVi32imm 6
  ; CHECK-NEXT:   dead $w5 = MOVi32imm 5
  ; CHECK-NEXT:   Bcc 13, %bb.3, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = MOVi32imm 1
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $w0 = COPY $wzr
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $w0, $w1

    %1:gpr32 = COPY $w1
    %0:gpr32 = COPY $w0
    %5:gpr32 = SUBSWrr %0, %1, implicit-def $nzcv
    Bcc 11, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    dead $w2 = MOVi32imm 2
    dead $w3 = MOVi32imm 3
    dead $w4 = MOVi32imm 4
    %2:gpr32 = MOVi32imm 6
    dead $w5 = MOVi32imm 5
    %6:gpr32 = SUBSWrr %0, %1, implicit-def $nzcv
    Bcc 13, %bb.3, implicit $nzcv
    B %bb.2

  bb.2:
    $w0 = MOVi32imm 1
    RET_ReallyLR implicit $w0

  bb.3:
    $w0 = COPY $wzr
    RET_ReallyLR implicit $w0
...
