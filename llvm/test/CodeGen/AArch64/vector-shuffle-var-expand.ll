; There is no AArch64 lowering yet, so these all use the generic expansion.

define <4 x i32> @shuffle_v4i32(<4 x i32> %v, <4 x i32> %mask) nounwind {
; CHECK-LABEL: shuffle_v4i32:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sub sp, sp, #16
; CHECK-NEXT:    fmov w10, s1
; CHECK-NEXT:    mov w9, v1.s[1]
; CHECK-NEXT:    mov x8, sp
; CHECK-NEXT:    str q0, [sp]
; CHECK-NEXT:    mov x11, sp
; CHECK-NEXT:    bfi x8, x10, #2, #2
; CHECK-NEXT:    mov w10, v1.s[2]
; CHECK-NEXT:    bfi x11, x9, #2, #2
; CHECK-NEXT:    mov x9, sp
; CHECK-NEXT:    ldr s0, [x8]
; CHECK-NEXT:    mov w8, v1.s[3]
; CHECK-NEXT:    ld1 { v0.s }[1], [x11]
; CHECK-NEXT:    bfi x9, x10, #2, #2
; CHECK-NEXT:    mov x10, sp
; CHECK-NEXT:    bfi x10, x8, #2, #2
; CHECK-NEXT:    ld1 { v0.s }[2], [x9]
; CHECK-NEXT:    ld1 { v0.s }[3], [x10]
; CHECK-NEXT:    add sp, sp, #16
; CHECK-NEXT:    ret
  %res = call <4 x i32> @llvm.vector.shuffle.v4i32.v4i32(<4 x i32> %v, <4 x i32> %mask)
  ret <4 x i32> %res
}

