; CHECK-NEXT:    ld1 { v0.h }[3], [x9]
; CHECK-NEXT:    // kill: def $d0 killed $d0 killed $q0
; CHECK-NEXT:    add sp, sp, #16
; CHECK-NEXT:    ret
