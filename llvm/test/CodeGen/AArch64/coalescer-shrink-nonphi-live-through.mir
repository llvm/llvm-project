# RUN: llc -mtriple=aarch64 \
# RUN:   -aarch64-enable-subreg-liveness-tracking \
# RUN:   -run-pass=register-coalescer -debug-only=regalloc \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# Check that removing an identity copy marks non-PHI live-through subranges for
# shrinking.
#
# Both subranges are non-PHI and live through the removed COPY. Without
# handling non-PHI values, neither subrange is added to ShrinkMask.

# CHECK-LABEL: Function: nonphi_live_through
# CHECK: Expecting instruction removal
# CHECK-COUNT-2: Dead uses at sublane

---
name: nonphi_live_through
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $d0

    undef %0.dsub0:dd = COPY $d0
    %0.dsub1:dd = IMPLICIT_DEF
    B %bb.1

  bb.1:
    %1:dd = COPY %0
    HINT 0, implicit %1.dsub1
    HINT 0, implicit %1.dsub0
    RET_ReallyLR

...
