# A branch with a cold edge below 1% remains conditional; a balanced one can be converted.
---
name:            biased_branch
alignment:       4
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: biased_branch
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x1, $x2, $w3, $x4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64 = COPY $x4
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w3
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY $x2
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY $x1
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.3(0x7fef9fcb), %bb.2(0x00106035)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr64sp = PHI [[COPY4]], %bb.0, %6, %bb.3
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr64sp = PHI [[COPY]], %bb.0, %8, %bb.3
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:gpr64sp = PHI [[COPY3]], %bb.0, %10, %bb.3
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:gpr32 = PHI [[COPY1]], %bb.0, %12, %bb.3
  ; CHECK-NEXT:   early-clobber %13:gpr64sp, %14:gpr32 = LDRBBpost [[PHI]], 1 :: (load (s8))
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:gpr32 = COPY %14
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:gpr64all = COPY $xzr
  ; CHECK-NEXT:   [[COPY7:%[0-9]+]]:gpr64all = COPY [[COPY6]]
  ; CHECK-NEXT:   [[COPY8:%[0-9]+]]:gpr64all = COPY %13
  ; CHECK-NEXT:   CBZW %14, %bb.3
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.read:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SUBREG_TO_REG:%[0-9]+]]:gpr64 = SUBREG_TO_REG [[PHI3]], %subreg.sub_32
  ; CHECK-NEXT:   [[LSLVXr:%[0-9]+]]:gpr64 = LSLVXr [[COPY2]], killed [[SUBREG_TO_REG]]
  ; CHECK-NEXT:   [[COPY9:%[0-9]+]]:gpr32 = COPY $wzr
  ; CHECK-NEXT:   [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[COPY9]], [[COPY5]], implicit-def dead $nzcv
  ; CHECK-NEXT:   [[SUBREG_TO_REG1:%[0-9]+]]:gpr64 = SUBREG_TO_REG killed [[SUBSWrr]], %subreg.sub_32
  ; CHECK-NEXT:   [[LSRVXr:%[0-9]+]]:gpr64 = LSRVXr killed [[LSLVXr]], killed [[SUBREG_TO_REG1]]
  ; CHECK-NEXT:   [[COPY10:%[0-9]+]]:gpr64all = COPY [[LSRVXr]]
  ; CHECK-NEXT:   [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[PHI3]], [[COPY5]]
  ; CHECK-NEXT:   [[COPY11:%[0-9]+]]:gpr32all = COPY [[ADDWrr]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.merge:
  ; CHECK-NEXT:   successors: %bb.4(0x04000000), %bb.1(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI4:%[0-9]+]]:gpr64 = PHI [[COPY7]], %bb.1, [[COPY10]], %bb.2
  ; CHECK-NEXT:   [[PHI5:%[0-9]+]]:gpr32all = PHI [[PHI3]], %bb.1, [[COPY11]], %bb.2
  ; CHECK-NEXT:   early-clobber %28:gpr64sp = STRXpost [[PHI4]], [[PHI1]], 8 :: (store (s64))
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[PHI2]], 1, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[COPY12:%[0-9]+]]:gpr64all = COPY [[SUBSXri]]
  ; CHECK-NEXT:   [[COPY13:%[0-9]+]]:gpr64all = COPY %28
  ; CHECK-NEXT:   Bcc 1, %bb.1, implicit $nzcv
  ; CHECK-NEXT:   B %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.exit:
  ; CHECK-NEXT:   $w0 = COPY [[PHI5]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $x0, $x1, $x2, $w3, $x4

    %16:gpr64 = COPY $x4
    %15:gpr32 = COPY $w3
    %14:gpr64 = COPY $x2
    %13:gpr64 = COPY $x1
    %12:gpr64 = COPY $x0

  bb.1.loop:
    successors: %bb.3(0x7fef9fcb), %bb.2(0x00106035)

    %0:gpr64sp = PHI %12, %bb.0, %5, %bb.3
    %1:gpr64sp = PHI %16, %bb.0, %11, %bb.3
    %2:gpr64sp = PHI %13, %bb.0, %10, %bb.3
    %3:gpr32 = PHI %15, %bb.0, %9, %bb.3
    early-clobber %18:gpr64sp, %19:gpr32 = LDRBBpost %0, 1 :: (load (s8))
    %4:gpr32 = COPY %19
    %20:gpr64all = COPY $xzr
    %17:gpr64all = COPY %20
    %5:gpr64all = COPY %18
    CBZW %19, %bb.3
    B %bb.2

  bb.2.read:
    successors: %bb.3(0x80000000)

    %21:gpr64 = SUBREG_TO_REG %3, %subreg.sub_32
    %22:gpr64 = LSLVXr %14, killed %21
    %23:gpr32 = COPY $wzr
    %24:gpr32 = SUBSWrr %23, %4, implicit-def dead $nzcv
    %25:gpr64 = SUBREG_TO_REG killed %24, %subreg.sub_32
    %26:gpr64 = LSRVXr killed %22, killed %25
    %6:gpr64all = COPY %26
    %27:gpr32 = ADDWrr %3, %4
    %7:gpr32all = COPY %27

  bb.3.merge:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)

    %8:gpr64 = PHI %17, %bb.1, %6, %bb.2
    %9:gpr32all = PHI %3, %bb.1, %7, %bb.2
    early-clobber %28:gpr64sp = STRXpost %8, %1, 8 :: (store (s64))
    %29:gpr64 = SUBSXri %2, 1, 0, implicit-def $nzcv
    %10:gpr64all = COPY %29
    %11:gpr64all = COPY %28
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.4

  bb.4.exit:
    $w0 = COPY %9
    RET_ReallyLR implicit $w0
...

---
name:            balanced_branch
alignment:       4
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: balanced_branch
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x1, $x2, $w3, $x4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64 = COPY $x4
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w3
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY $x2
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY $x1
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.4(0x04000000), %bb.1(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr64sp = PHI [[COPY4]], %bb.0, %6, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gpr64sp = PHI [[COPY]], %bb.0, %8, %bb.1
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:gpr64sp = PHI [[COPY3]], %bb.0, %10, %bb.1
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:gpr32 = PHI [[COPY1]], %bb.0, %12, %bb.1
  ; CHECK-NEXT:   early-clobber %13:gpr64sp, %14:gpr32common = LDRBBpost [[PHI]], 1 :: (load (s8))
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:gpr32 = COPY %14
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:gpr64all = COPY $xzr
  ; CHECK-NEXT:   [[COPY7:%[0-9]+]]:gpr64 = COPY [[COPY6]]
  ; CHECK-NEXT:   [[COPY8:%[0-9]+]]:gpr64all = COPY %13
  ; CHECK-NEXT:   [[SUBREG_TO_REG:%[0-9]+]]:gpr64 = SUBREG_TO_REG [[PHI3]], %subreg.sub_32
  ; CHECK-NEXT:   [[LSLVXr:%[0-9]+]]:gpr64 = LSLVXr [[COPY2]], killed [[SUBREG_TO_REG]]
  ; CHECK-NEXT:   [[COPY9:%[0-9]+]]:gpr32 = COPY $wzr
  ; CHECK-NEXT:   [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[COPY9]], [[COPY5]], implicit-def dead $nzcv
  ; CHECK-NEXT:   [[SUBREG_TO_REG1:%[0-9]+]]:gpr64 = SUBREG_TO_REG killed [[SUBSWrr]], %subreg.sub_32
  ; CHECK-NEXT:   [[LSRVXr:%[0-9]+]]:gpr64 = LSRVXr killed [[LSLVXr]], killed [[SUBREG_TO_REG1]]
  ; CHECK-NEXT:   [[COPY10:%[0-9]+]]:gpr64 = COPY [[LSRVXr]]
  ; CHECK-NEXT:   [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[PHI3]], [[COPY5]]
  ; CHECK-NEXT:   [[COPY11:%[0-9]+]]:gpr32 = COPY [[ADDWrr]]
  ; CHECK-NEXT:   $wzr = SUBSWri %14, 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[CSELXr:%[0-9]+]]:gpr64 = CSELXr [[COPY7]], [[COPY10]], 0, implicit $nzcv
  ; CHECK-NEXT:   $wzr = SUBSWri %14, 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[CSELWr:%[0-9]+]]:gpr32 = CSELWr [[PHI3]], [[COPY11]], 0, implicit $nzcv
  ; CHECK-NEXT:   early-clobber %28:gpr64sp = STRXpost [[CSELXr]], [[PHI1]], 8 :: (store (s64))
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[PHI2]], 1, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[COPY12:%[0-9]+]]:gpr64all = COPY [[SUBSXri]]
  ; CHECK-NEXT:   [[COPY13:%[0-9]+]]:gpr64all = COPY %28
  ; CHECK-NEXT:   Bcc 1, %bb.1, implicit $nzcv
  ; CHECK-NEXT:   B %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.exit:
  ; CHECK-NEXT:   $w0 = COPY [[CSELWr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $x0, $x1, $x2, $w3, $x4

    %16:gpr64 = COPY $x4
    %15:gpr32 = COPY $w3
    %14:gpr64 = COPY $x2
    %13:gpr64 = COPY $x1
    %12:gpr64 = COPY $x0

  bb.1.loop:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)

    %0:gpr64sp = PHI %12, %bb.0, %5, %bb.3
    %1:gpr64sp = PHI %16, %bb.0, %11, %bb.3
    %2:gpr64sp = PHI %13, %bb.0, %10, %bb.3
    %3:gpr32 = PHI %15, %bb.0, %9, %bb.3
    early-clobber %18:gpr64sp, %19:gpr32 = LDRBBpost %0, 1 :: (load (s8))
    %4:gpr32 = COPY %19
    %20:gpr64all = COPY $xzr
    %17:gpr64all = COPY %20
    %5:gpr64all = COPY %18
    CBZW %19, %bb.3
    B %bb.2

  bb.2.read:
    successors: %bb.3(0x80000000)

    %21:gpr64 = SUBREG_TO_REG %3, %subreg.sub_32
    %22:gpr64 = LSLVXr %14, killed %21
    %23:gpr32 = COPY $wzr
    %24:gpr32 = SUBSWrr %23, %4, implicit-def dead $nzcv
    %25:gpr64 = SUBREG_TO_REG killed %24, %subreg.sub_32
    %26:gpr64 = LSRVXr killed %22, killed %25
    %6:gpr64all = COPY %26
    %27:gpr32 = ADDWrr %3, %4
    %7:gpr32all = COPY %27

  bb.3.merge:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)

    %8:gpr64 = PHI %17, %bb.1, %6, %bb.2
    %9:gpr32all = PHI %3, %bb.1, %7, %bb.2
    early-clobber %28:gpr64sp = STRXpost %8, %1, 8 :: (store (s64))
    %29:gpr64 = SUBSXri %2, 1, 0, implicit-def $nzcv
    %10:gpr64all = COPY %29
    %11:gpr64all = COPY %28
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.4

  bb.4.exit:
    $w0 = COPY %9
    RET_ReallyLR implicit $w0
...
