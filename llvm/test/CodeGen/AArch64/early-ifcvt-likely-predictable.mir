# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=arm64-apple-ios -mcpu=apple-m1 -run-pass=early-ifcvt -verify-machineinstrs -verify-each -o - %s | FileCheck %s

--- |
  define void @test_cond_is_load_with_invariant_ops() {
  entry:
    ret void
  }

  define void @test_cond_is_load_with_invariant_ops2() {
  entry:
    ret void
  }

  define void @test_cond_is_load_with_varying_ops() {
  entry:
    ret void
  }

  define void @test_cond_def_inside_loop_with_invariant_operands() {
  entry:
    ret void
  }

  define i32 @biased_branch(ptr %counts, i64 %count, i64 %bits, i32 %initial, ptr %out) {
  entry: br label %loop
  loop: br label %read
  read: br label %merge
  merge: br label %exit
  exit: ret i32 0
  }
  define i32 @balanced_branch(ptr %counts, i64 %count, i64 %bits, i32 %initial, ptr %out) {
  entry: br label %loop
  loop: br label %read
  read: br label %merge
  merge: br label %exit
  exit: ret i32 0
  }
...
