; With equal shift amounts the scalar load prevents keeping the shift pair for
; the masked load, although the left shift could fold into both accesses.
define i64 @equal_shifts_masked_and_scalar(ptr %p, ptr %q, ptr %r, i64 %x, <vscale x 2 x i1> %m) {
; CHECK-LABEL: equal_shifts_masked_and_scalar:
; CHECK:       // %bb.0:
; CHECK-NEXT:    and x8, x3, #0xfffffffffffffff8
; CHECK-NEXT:    add x9, x0, x8
; CHECK-NEXT:    ldr x0, [x1, x8]
; CHECK-NEXT:    ld1d { z0.d }, p0/z, [x9]
; CHECK-NEXT:    // fake_use: $z0
; CHECK-NEXT:    ret
  %i = lshr i64 %x, 3
  %g1 = getelementptr i64, ptr %p, i64 %i
  %g2 = getelementptr i64, ptr %q, i64 %i
  %l1 = call <vscale x 2 x i64> @llvm.masked.load(ptr %g1, i32 8, <vscale x 2 x i1> %m, <vscale x 2 x i64> zeroinitializer)
  %l2 = load i64, ptr %g2
  tail call void (...) @llvm.fake.use(<vscale x 2 x i64> %l1)
  ret i64 %l2
}

