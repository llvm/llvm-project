; Stores must write the results in order at consecutive scalable offsets.
define void @interleave_wide_wrong_order(ptr %output, ptr %input0, ptr %input1) #0 {
; CHECK-LABEL: interleave_wide_wrong_order:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldr z0, [x1, #1, mul vl]
; CHECK-NEXT:    ldr z1, [x2, #1, mul vl]
; CHECK-NEXT:    ldr z2, [x1]
; CHECK-NEXT:    ldr z3, [x2]
; CHECK-NEXT:    zip2 z4.s, z0.s, z1.s
; CHECK-NEXT:    zip1 z0.s, z0.s, z1.s
; CHECK-NEXT:    zip2 z1.s, z2.s, z3.s
; CHECK-NEXT:    zip1 z2.s, z2.s, z3.s
; CHECK-NEXT:    str z4, [x0, #2, mul vl]
; CHECK-NEXT:    str z0, [x0, #3, mul vl]
; CHECK-NEXT:    str z1, [x0]
; CHECK-NEXT:    str z2, [x0, #1, mul vl]
; CHECK-NEXT:    ret
  %v0 = load <vscale x 8 x i32>, ptr %input0, align 1
  %v1 = load <vscale x 8 x i32>, ptr %input1, align 1
  %interleave = call <vscale x 16 x i32> @llvm.vector.interleave2.nxv16i32(<vscale x 8 x i32> %v0, <vscale x 8 x i32> %v1)
  %part0 = call <vscale x 4 x i32> @llvm.vector.extract.nxv4i32.nxv16i32(<vscale x 16 x i32> %interleave, i64 0)
  %part1 = call <vscale x 4 x i32> @llvm.vector.extract.nxv4i32.nxv16i32(<vscale x 16 x i32> %interleave, i64 4)
  %part2 = call <vscale x 4 x i32> @llvm.vector.extract.nxv4i32.nxv16i32(<vscale x 16 x i32> %interleave, i64 8)
  %part3 = call <vscale x 4 x i32> @llvm.vector.extract.nxv4i32.nxv16i32(<vscale x 16 x i32> %interleave, i64 12)
  %swap0 = call <vscale x 16 x i32> @llvm.vector.insert.nxv16i32.nxv4i32(<vscale x 16 x i32> poison, <vscale x 4 x i32> %part1, i64 0)
  %swap1 = call <vscale x 16 x i32> @llvm.vector.insert.nxv16i32.nxv4i32(<vscale x 16 x i32> %swap0, <vscale x 4 x i32> %part0, i64 4)
  %swap2 = call <vscale x 16 x i32> @llvm.vector.insert.nxv16i32.nxv4i32(<vscale x 16 x i32> %swap1, <vscale x 4 x i32> %part3, i64 8)
  %swap3 = call <vscale x 16 x i32> @llvm.vector.insert.nxv16i32.nxv4i32(<vscale x 16 x i32> %swap2, <vscale x 4 x i32> %part2, i64 12)
  store <vscale x 16 x i32> %swap3, ptr %output, align 1
  ret void
}

