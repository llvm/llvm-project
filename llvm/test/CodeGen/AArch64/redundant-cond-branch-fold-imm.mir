# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-redundantcondbranch -verify-machineinstrs -o - %s | FileCheck %s

# A constant materialized by a single MOV is folded into the first add/sub or
# logical instruction reading it, and the MOV is removed once it is dead.
---
name: cmp_killed
body: |
  ; CHECK-LABEL: name: cmp_killed
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $xzr = SUBSXri renamable $x1, 1, 0, implicit-def $nzcv
  ; CHECK-NEXT:   Bcc 3, %bb.1, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY $x1
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $x0 = MOVi64imm -1
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    liveins: $x1
    renamable $w9 = MOVZWi 1, 0, implicit-def $x9
    $xzr = SUBSXrs renamable $x1, killed renamable $x9, 0, implicit-def $nzcv
    Bcc 3, %bb.1, implicit $nzcv
    B %bb.2
  bb.1:
    liveins: $x1
    $x0 = COPY $x1
    RET_ReallyLR implicit $x0
  bb.2:
    $x0 = MOVi64imm -1
    RET_ReallyLR implicit $x0
...
---
name: cmp_mov_still_live
body: |
  bb.0:
    liveins: $x1
    ; CHECK-LABEL: name: cmp_mov_still_live
    ; CHECK: liveins: $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x9 = MOVZXi 5, 0
    ; CHECK-NEXT: $xzr = SUBSXri renamable $x1, 5, 0, implicit-def $nzcv
    ; CHECK-NEXT: renamable $x0 = CSELXr renamable $x1, renamable $x9, 3, implicit $nzcv
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    renamable $x9 = MOVZXi 5, 0
    $xzr = SUBSXrs renamable $x1, renamable $x9, 0, implicit-def $nzcv
    renamable $x0 = CSELXr renamable $x1, renamable $x9, 3, implicit $nzcv
    RET_ReallyLR implicit $x0
...
---
name: cmp_dead_after_user_via_liveness
body: |
  bb.0:
    liveins: $x1
    ; CHECK-LABEL: name: cmp_dead_after_user_via_liveness
    ; CHECK: liveins: $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $xzr = SUBSXri renamable $x1, 5, 0, implicit-def $nzcv
    ; CHECK-NEXT: renamable $x9 = CSINCXr $xzr, $xzr, 2, implicit $nzcv
    ; CHECK-NEXT: $x0 = COPY $x9
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    renamable $x9 = MOVZXi 5, 0
    $xzr = SUBSXrs renamable $x1, renamable $x9, 0, implicit-def $nzcv
    renamable $x9 = CSINCXr $xzr, $xzr, 2, implicit $nzcv
    $x0 = COPY $x9
    RET_ReallyLR implicit $x0
...
---
