# A MOVZ of a symbol (large code model, TLS, block addresses) is not a constant.
name: movz_symbol
body: |
  bb.0:
    liveins: $x1
    ; CHECK-LABEL: name: movz_symbol
    ; CHECK: liveins: $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x9 = MOVZXi target-flags(aarch64-g0, aarch64-nc) <mcsymbol sym>, 0
    ; CHECK-NEXT: $xzr = SUBSXrs renamable $x1, killed renamable $x9, 0, implicit-def $nzcv
    ; CHECK-NEXT: renamable $w0 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    renamable $x9 = MOVZXi target-flags(aarch64-g0, aarch64-nc) <mcsymbol sym>, 0
    $xzr = SUBSXrs renamable $x1, killed renamable $x9, 0, implicit-def $nzcv
    renamable $w0 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    RET_ReallyLR implicit $w0
...
