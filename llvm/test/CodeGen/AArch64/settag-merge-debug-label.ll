; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --filter "st2g|mov x9|add sp|DEBUG_LABEL" --version 6
; RUN: llc -mtriple=aarch64-none-elf -mattr=+mte < %s | FileCheck %s --implicit-check-not='mov x9, sp' --implicit-check-not='add sp, sp, #512'

target triple = "aarch64-none-elf"

declare void @use(ptr)
declare void @llvm.aarch64.settag(ptr, i64)

define void @f() !dbg !4 {
; CHECK-LABEL: f:
; CHECK:    st2g sp, [sp], #32
; CHECK:    //DEBUG_LABEL: f:out
entry:
  %a = alloca [512 x i8], align 16
  call void @use(ptr %a)
  call void @llvm.aarch64.settag(ptr %a, i64 512)
    #dbg_label(!8, !9)
  ret void
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2, !3}
!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
!1 = !DIFile(filename: "settag.c", directory: "/")
!2 = !{i32 7, !"Dwarf Version", i32 5}
!3 = !{i32 2, !"Debug Info Version", i32 3}
!4 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
!5 = !DISubroutineType(types: !6)
!6 = !{null}
!8 = !DILabel(scope: !4, name: "out", file: !1, line: 4)
!9 = !DILocation(line: 4, scope: !4)
