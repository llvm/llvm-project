  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $w0, $w1, $w2, $w3

    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = COPY $w2
    %3:gpr32 = COPY $w3
    CBWPrr 13, %0, %1, %bb.3
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    CBWPrr 13, %2, %3, %bb.3
    B %bb.2

  bb.2:
    successors: %bb.3

    B %bb.3

  bb.3:
    %4:gpr32 = MOVi32imm 7
    $w0 = COPY %4
    RET_ReallyLR implicit $w0
