name:            bsl_mov
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d0, $d1, $d2
    ; CHECK-LABEL: name: bsl_mov
    ; CHECK: liveins: $d0, $d1, $d2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d3 = ORRv8i8 $d0, $d0
    ; CHECK-NEXT: $d3 = BSLv8i8 killed $d3, $d1, $d2
    ; CHECK-NEXT: RET undef $lr, implicit $d3
    $d3 = BSPv8i8 $d0, $d1, $d2
    RET_ReallyLR implicit $d3
...

