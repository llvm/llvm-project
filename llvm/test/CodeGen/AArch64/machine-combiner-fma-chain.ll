; A long chain of FMA accumulations is reassociated into two shorter chains
; combined by a single add to expose more ILP.

define double @fma_chain_f64(double %y, ptr %pa, double %x0, double %x1, double %x2, double %x3, double %x4, double %x5) {
; CHECK-LABEL: fma_chain_f64:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ldp d7, d16, [x0]
; CHECK-NEXT:    ldp d19, d20, [x0, #32]
; CHECK-NEXT:    ldp d17, d18, [x0, #16]
; CHECK-NEXT:    fmadd d0, d7, d1, d0
; CHECK-NEXT:    fmul d1, d18, d4
; CHECK-NEXT:    fmadd d1, d19, d5, d1
; CHECK-NEXT:    fmadd d0, d16, d2, d0
; CHECK-NEXT:    fmadd d1, d20, d6, d1
; CHECK-NEXT:    fmadd d0, d17, d3, d0
; CHECK-NEXT:    fadd d0, d0, d1
; CHECK-NEXT:    ret
entry:
  %a0 = load double, ptr %pa, align 8
  %pa1 = getelementptr double, ptr %pa, i64 1
  %a1 = load double, ptr %pa1, align 8
  %pa2 = getelementptr double, ptr %pa, i64 2
  %a2 = load double, ptr %pa2, align 8
  %pa3 = getelementptr double, ptr %pa, i64 3
  %a3 = load double, ptr %pa3, align 8
  %pa4 = getelementptr double, ptr %pa, i64 4
  %a4 = load double, ptr %pa4, align 8
  %pa5 = getelementptr double, ptr %pa, i64 5
  %a5 = load double, ptr %pa5, align 8
  %s0 = call reassoc nsz double @llvm.fma.f64(double %a0, double %x0, double %y)
  %s1 = call reassoc nsz double @llvm.fma.f64(double %a1, double %x1, double %s0)
  %s2 = call reassoc nsz double @llvm.fma.f64(double %a2, double %x2, double %s1)
  %s3 = call reassoc nsz double @llvm.fma.f64(double %a3, double %x3, double %s2)
  %s4 = call reassoc nsz double @llvm.fma.f64(double %a4, double %x4, double %s3)
  %s5 = call reassoc nsz double @llvm.fma.f64(double %a5, double %x5, double %s4)
  ret double %s5
}

; A chain of unfused FADDs over FMULs is split as well; the FMUL+FADD fusion
; happens in the machine combiner itself.
define void @fadd_chain_loop(ptr %py, ptr %pa, i64 %n, double %x0, double %x1, double %x2, double %x3, double %x4, double %x5) {
; CHECK-LABEL: fadd_chain_loop:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mov x8, xzr
; CHECK-NEXT:    .p2align 5, , 16
; CHECK-NEXT:  .LBB1_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldr d6, [x0]
; CHECK-NEXT:    ldp d7, d16, [x1]
; CHECK-NEXT:    ldp d19, d20, [x1, #32]
; CHECK-NEXT:    add x8, x8, #1
; CHECK-NEXT:    ldp d17, d18, [x1, #16]
; CHECK-NEXT:    fmadd d6, d7, d0, d6
; CHECK-NEXT:    fmul d7, d20, d5
; CHECK-NEXT:    fmadd d6, d16, d1, d6
; CHECK-NEXT:    fmul d16, d18, d3
; CHECK-NEXT:    fmadd d16, d19, d4, d16
; CHECK-NEXT:    fmadd d6, d17, d2, d6
; CHECK-NEXT:    fadd d7, d16, d7
; CHECK-NEXT:    fadd d6, d6, d7
; CHECK-NEXT:    str d6, [x0]
; CHECK-NEXT:    cmp x8, x2
; CHECK-NEXT:    b.lo .LBB1_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %inext, %loop ]
  %y = load double, ptr %py, align 8
  %a0 = load double, ptr %pa, align 8
  %pa1 = getelementptr double, ptr %pa, i64 1
  %a1 = load double, ptr %pa1, align 8
  %pa2 = getelementptr double, ptr %pa, i64 2
  %a2 = load double, ptr %pa2, align 8
  %pa3 = getelementptr double, ptr %pa, i64 3
  %a3 = load double, ptr %pa3, align 8
  %pa4 = getelementptr double, ptr %pa, i64 4
  %a4 = load double, ptr %pa4, align 8
  %pa5 = getelementptr double, ptr %pa, i64 5
  %a5 = load double, ptr %pa5, align 8
  %m0 = fmul reassoc nsz contract double %a0, %x0
  %s0 = fadd reassoc nsz contract double %y, %m0
  %m1 = fmul reassoc nsz contract double %a1, %x1
  %s1 = fadd reassoc nsz contract double %s0, %m1
  %m2 = fmul reassoc nsz contract double %a2, %x2
  %s2 = fadd reassoc nsz contract double %s1, %m2
  %m3 = fmul reassoc nsz contract double %a3, %x3
  %s3 = fadd reassoc nsz contract double %s2, %m3
  %m4 = fmul reassoc nsz contract double %a4, %x4
  %s4 = fadd reassoc nsz contract double %s3, %m4
  %m5 = fmul reassoc nsz contract double %a5, %x5
  %s5 = fadd reassoc nsz contract double %s4, %m5
  store double %s5, ptr %py, align 8
  %inext = add nuw i64 %i, 1
  %cmp = icmp ult i64 %inext, %n
  br i1 %cmp, label %loop, label %exit
exit:
  ret void
}

