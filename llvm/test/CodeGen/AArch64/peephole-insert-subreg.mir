  ; CHECK-NEXT:   [[INSvi8lane:%[0-9]+]]:fpr128 = INSvi8lane [[MOVIv2d_ns]], 0, [[INSERT_SUBREG]], 0
  ; CHECK-NEXT:   $q0 = COPY [[INSvi8lane]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $q0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $q0, $w0

    %0:gpr32 = COPY $w0
    %1:fpr128 = COPY $q0
    %2:fpr8 = SMAXVv16i8v %1:fpr128
    CBZW %0, %bb.2
    B %bb.1

  bb.1:
    successors: %bb.2

    %3:fpr8 = DUPi8 %1:fpr128, 0
    B %bb.2

  bb.2:
    %4:fpr8 = PHI %2, %bb.0, %3, %bb.1
    %5:fpr128 = IMPLICIT_DEF
    %6:fpr128 = INSERT_SUBREG %5, %4, %subreg.bsub
    %7:fpr128 = MOVIv2d_ns 0
    %8:fpr128 = INSvi8lane %7, 0, %6, 0
    $q0 = COPY %8
    RET_ReallyLR implicit $q0
...
