; RUN: llc -mtriple=aarch64-unknown-unknown < %s | FileCheck %s

; (x & 0xffff) - zext((trunc x) urem 3) is (x & 0xffff) udiv 3 * 3.
; Expanding the urem must not leave two subtractions behind.

define i32 @urem_i16_and_mask(i32 %x) {
; CHECK-LABEL: urem_i16_and_mask:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov w8, #43691 // =0xaaab
; CHECK-NEXT:    and w9, w0, #0xffff
; CHECK-NEXT:    mul w8, w9, w8
; CHECK-NEXT:    lsr w8, w8, #17
; CHECK-NEXT:    add w8, w8, w8, lsl #1
; CHECK-NEXT:    and w0, w8, #0xffff
; CHECK-NEXT:    ret
  %and = and i32 %x, 65535
  %t = trunc i32 %x to i16
  %r = urem i16 %t, 3
  %z = zext nneg i16 %r to i32
  %res = sub nuw nsw i32 %and, %z
  ret i32 %res
}

