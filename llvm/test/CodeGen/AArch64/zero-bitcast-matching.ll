; Reject scalar bitcasts of FP negative zero

define <2 x double> @reject_fp_negative_zero(<1 x double> %lo) {
; CHECK-LABEL: reject_fp_negative_zero:
; CHECK:       mov x8, #-9223372036854775808
; CHECK:       fmov d1, x8
; CHECK-NEXT:  mov v0.d[1], v1.d[0]
; CHECK-NEXT:  ret
  %hi = bitcast double -0.000000e+00 to <1 x double>
  %vec = shufflevector <1 x double> %lo, <1 x double> %hi, <2 x i32> <i32 0, i32 1>
  ret <2 x double> %vec
}
