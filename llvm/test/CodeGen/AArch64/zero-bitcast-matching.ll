; These sequences exercise bitcasts of scalar zero to vector types.
; Check code generation for negation and zero-filled concatenation.


define <1 x i64> @neg_low(<2 x i64> %x) {
; CHECK-LABEL: neg_low:
; CHECK:       // %bb.0:
; CHECK-NEXT:    neg d0, d0
; CHECK-NEXT:    ret
  %neg = sub <2 x i64> zeroinitializer, %x
  %low = shufflevector <2 x i64> %neg, <2 x i64> poison, <1 x i32> zeroinitializer
  ret <1 x i64> %low
}

define <1 x i64> @neg_high(<2 x i64> %x) {
; CHECK-LABEL: neg_high:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov d0, v0.d[1]
; CHECK-NEXT:    neg d0, d0
; CHECK-NEXT:    ret
  %neg = sub <2 x i64> zeroinitializer, %x
  %high = shufflevector <2 x i64> %neg, <2 x i64> poison, <1 x i32> <i32 1>
  ret <1 x i64> %high
}

define <2 x i64> @reduce_smax_v1i64_zero_fill(<1 x i64> %a) {
; CHECK-LABEL: reduce_smax_v1i64_zero_fill:
; CHECK:       // %bb.0:
; CHECK-NEXT:    fmov d0, d0
; CHECK-NEXT:    ret
  %t1 = call i64 @llvm.vector.reduce.smax.v1i64(<1 x i64> %a)
  %t2 = insertelement <2 x i64> zeroinitializer, i64 %t1, i64 0
  ret <2 x i64> %t2
}

define <2 x double> @reduce_fmin_v1f64_zero_fill(<1 x double> %a) {
