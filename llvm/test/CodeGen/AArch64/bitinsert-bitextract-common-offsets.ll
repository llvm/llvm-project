; AARCH64:       // %bb.0:
; AARCH64-NEXT:    lsl x8, x0, #32
; AARCH64-NEXT:    // kill: def $w2 killed $w2 def $x2
; AARCH64-NEXT:    extr x0, x2, x8, #32
; AARCH64-NEXT:    ret
  %result = bitinsert b128 %base, i32 %val, i32 32
  ret b128 %result
}

define b128 @test_bitinsert_b128_off64(b128 %base, i64 %val) {
; AARCH64-LABEL: test_bitinsert_b128_off64:
; AARCH64:       // %bb.0:
; AARCH64-NEXT:    mov x1, x2
; AARCH64-NEXT:    ret
  %result = bitinsert b128 %base, i64 %val, i32 64
  ret b128 %result
}
