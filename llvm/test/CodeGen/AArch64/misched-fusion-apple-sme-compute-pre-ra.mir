## SME fusion doesnt require RAW dependency. This is a representative test case for Z write

# CHECK-LABEL: fuse_non_raw
# CHECK: SU({{[0-9]+}}): $z0 = ADD_ZZZ_S
# CHECK: Successors:
# FUSE: SU({{[0-9]+}}): Ord  Latency={{[0-9]+}} Cluster
# NOFUSE-NOT: SU({{[0-9]+}}): Ord  Latency={{[0-9]+}} Cluster
# CHECK: SU({{[0-9]+}}): $z0 = ADD_ZZZ_S
---
name:            fuse_non_raw
tracksRegLiveness: true
body:             |
  bb.0:
    $z0 = ADD_ZZZ_S undef %0:zpr, undef %1:zpr
    %2:gpr32sp = ORRWri undef %3:gpr32common, 4096
    $z0 = ADD_ZZZ_S undef %4:zpr, undef %5:zpr
    RET undef $lr
...
