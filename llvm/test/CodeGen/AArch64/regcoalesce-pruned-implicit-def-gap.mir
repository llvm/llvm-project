# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness=true -run-pass=register-coalescer -verify-machineinstrs -verify-coalescing -o - %s | FileCheck %s

# Removing the dead qsub2 IMPLICIT_DEF must preserve the main-range gap
# pruned for %1's earlier value. The merge block connects %1's two values.

---
name: pruned_implicit_def_gap
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: pruned_implicit_def_gap
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $q0, $q1, $q4, $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[COPY:%[0-9]+]].qsub0:qqq = COPY $q0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]].qsub1:qqq = COPY $q1
  ; CHECK-NEXT:   $q2 = COPY [[COPY]].qsub1
  ; CHECK-NEXT:   Bcc 0, %bb.1, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $q4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]].qsub1:qqq = COPY $q4
  ; CHECK-NEXT:   $q5 = COPY [[COPY]].qsub0
  ; CHECK-NEXT:   $q6 = COPY [[COPY]].qsub1
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $q7 = COPY [[COPY]].qsub1
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $q0, $q1, $q4, $nzcv
    undef %0.qsub0:qqq = COPY $q0
    %1:fpr128 = COPY $q1
    $q2 = COPY %1
    Bcc 0, %bb.1, implicit $nzcv
    B %bb.2

  bb.1:
    successors: %bb.2
    liveins: $q4
    %0.qsub2:qqq = IMPLICIT_DEF
    %1:fpr128 = COPY $q4
    %0.qsub1:qqq = COPY %1
    $q5 = COPY %0.qsub0
    $q6 = COPY %0.qsub1
    B %bb.2

  bb.2:
    $q7 = COPY %1
    RET_ReallyLR
...
