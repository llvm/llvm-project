# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness=true -run-pass=register-coalescer -verify-machineinstrs -o - %s | FileCheck %s

# Removing the dead qsub2 IMPLICIT_DEF must preserve the main-range gap
# pruned for %1's earlier value. Restore coverage for qsub0 after joining.

---
name: pruned_implicit_def_gap
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q0, $q1, $q4

    ; CHECK-LABEL: name: pruned_implicit_def_gap
    ; CHECK: liveins: $q0, $q1, $q4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: undef [[COPY:%[0-9]+]].qsub0:qqq = COPY $q0
    ; CHECK-NEXT: [[COPY:%[0-9]+]].qsub1:qqq = COPY $q1
    ; CHECK-NEXT: $q2 = COPY [[COPY]].qsub1
    ; CHECK-NEXT: [[COPY:%[0-9]+]].qsub1:qqq = COPY $q4
    ; CHECK-NEXT: $q5 = COPY [[COPY]].qsub0
    ; CHECK-NEXT: $q6 = COPY [[COPY]].qsub1
    ; CHECK-NEXT: RET_ReallyLR
    undef %0.qsub0:qqq = COPY $q0
    %1:fpr128 = COPY $q1
    $q2 = COPY %1
    %0.qsub2:qqq = IMPLICIT_DEF
    %1:fpr128 = COPY $q4
    %0.qsub1:qqq = COPY %1
    $q5 = COPY %0.qsub0
    $q6 = COPY %0.qsub1
    RET_ReallyLR
...
