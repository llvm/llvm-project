; RUN: llc -mtriple=aarch64-linux-gnu -mcpu=neoverse-v2 < %s | FileCheck %s

; A logical or and a select of two constants with branch weights, on a CPU
; where a predictable select is expensive.

declare i64 @slow(i64, ptr, i64)

; A logical or feeding a branch in the same block.
define i64 @logical_or_br(i64 %gas, ptr %m, i64 %n) {
; CHECK-LABEL: logical_or_br:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldp x8, x9, [x1]
; CHECK-NEXT:    add x8, x8, #32
; CHECK-NEXT:    cmp x8, x9
; CHECK-NEXT:    cset w9, hi
; CHECK-NEXT:    cmp x2, x8
; CHECK-NEXT:    b.hi .LBB0_3
; CHECK-NEXT:  // %bb.1: // %select.end
; CHECK-NEXT:    tbnz w9, #0, .LBB0_4
; CHECK-NEXT:  .LBB0_2: // %fast
; CHECK-NEXT:    sub x0, x0, #3
; CHECK-NEXT:    str x8, [x1]
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    mov w9, #1 // =0x1
; CHECK-NEXT:    tbz w9, #0, .LBB0_2
; CHECK-NEXT:  .LBB0_4: // %slow
; CHECK-NEXT:    b slow
  %size = load i64, ptr %m, align 8
  %s = add i64 %size, 32
  %c1 = icmp ugt i64 %n, %s
  %capp = getelementptr inbounds i8, ptr %m, i64 8
  %cap = load i64, ptr %capp, align 8
  %c2 = icmp ugt i64 %s, %cap
  %or = select i1 %c1, i1 true, i1 %c2, !prof !0
  br i1 %or, label %slow, label %fast, !prof !0

fast:
  store i64 %s, ptr %m, align 8
  %r = add nsw i64 %gas, -3
  ret i64 %r

slow:
  %t = tail call i64 @slow(i64 %gas, ptr %m, i64 %n)
  ret i64 %t
}

; A select of two constants.
define i32 @select_consts(i32 %a) {
; CHECK-LABEL: select_consts:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cbnz w0, .LBB1_2
; CHECK-NEXT:  // %bb.1: // %select.false
; CHECK-NEXT:    mov w0, #5 // =0x5
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    mov w0, #7 // =0x7
; CHECK-NEXT:    ret
  %cmp = icmp ne i32 %a, 0
  %sel = select i1 %cmp, i32 7, i32 5, !prof !0
  ret i32 %sel
}

!0 = !{!"branch_weights", i32 1, i32 100}
