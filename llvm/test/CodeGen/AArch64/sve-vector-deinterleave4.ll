define void @deinterleave_i8(ptr %src) {
; CHECK-LABEL: deinterleave_i8:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ptrue p0.b
; CHECK-NEXT:    ld2b { z0.b, z1.b }, p0/z, [x0]
; CHECK-NEXT:    uunpkhi z2.h, z0.b
; CHECK-NEXT:    uunpklo z3.h, z0.b
; CHECK-NEXT:    uunpkhi z4.h, z1.b
; CHECK-NEXT:    uunpklo z0.h, z1.b
; CHECK-NEXT:    uzp1 z1.h, z3.h, z2.h
; CHECK-NEXT:    uzp2 z2.h, z3.h, z2.h
; CHECK-NEXT:    uzp2 z5.h, z0.h, z4.h
; CHECK-NEXT:    uzp1 z0.h, z0.h, z4.h
; CHECK-NEXT:    // fake_use: $z1
; CHECK-NEXT:    // fake_use: $z0
; CHECK-NEXT:    // fake_use: $z2
; CHECK-NEXT:    // fake_use: $z5
; CHECK-NEXT:    ret
entry:
  %abcd.vec = load <vscale x 32 x i8>, ptr %src, align 2
  %strided.vec = call { <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8> } @llvm.vector.deinterleave4.nxv32i8(<vscale x 32 x i8> %abcd.vec)

  %a = extractvalue { <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8> } %strided.vec, 0
  %b = extractvalue { <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8> } %strided.vec, 1
  %c = extractvalue { <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8> } %strided.vec, 2
  %d = extractvalue { <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8>, <vscale x 8 x i8> } %strided.vec, 3

  call void (...) @llvm.fake.use(<vscale x 8 x i8> %a)
  call void (...) @llvm.fake.use(<vscale x 8 x i8> %b)
  call void (...) @llvm.fake.use(<vscale x 8 x i8> %c)
  call void (...) @llvm.fake.use(<vscale x 8 x i8> %d)

  ret void
}

