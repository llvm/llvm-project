# RUN: llc -mtriple=aarch64 -run-pass=machine-outliner -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define void @foo() "sign-return-address"="all" { ret void }
  define void @bar() "sign-return-address"="all" { ret void }
...
---
name: foo
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: foo
    ; CHECK-NOT:   BL @OUTLINED_FUNCTION_
    
    $x9 = ADDXri $sp, 16, 0
    $sp = ADDXri $sp, 16, 0
    $x10 = ADDXri $sp, 16, 0
    
    BL @foo, implicit-def $lr, implicit $sp
    RET_ReallyLR
...
---
name: bar
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: bar
    ; CHECK-NOT:   BL @OUTLINED_FUNCTION_
    
    $x9 = ADDXri $sp, 16, 0
    $sp = ADDXri $sp, 16, 0
    $x10 = ADDXri $sp, 16, 0
    
    BL @foo, implicit-def $lr, implicit $sp
    RET_ReallyLR
...