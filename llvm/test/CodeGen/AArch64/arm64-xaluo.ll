;
; Get the actual value of the overflow bit.
;
define zeroext i1 @saddo1.i32(i32 %v1, i32 %v2, ptr %res) {
; CHECK-SD-LABEL: saddo1.i32:
; CHECK-SD:       // %bb.0: // %entry
; CHECK-SD-NEXT:    adds w8, w0, w1
; CHECK-SD-NEXT:    cset w0, vs
; CHECK-SD-NEXT:    str w8, [x2]
; CHECK-SD-NEXT:    ret
;
; CHECK-GI-LABEL: saddo1.i32:
; CHECK-GI:       // %bb.0: // %entry
; CHECK-GI-NEXT:    adds w8, w0, w1
; CHECK-GI-NEXT:    cset w0, vs
; CHECK-GI-NEXT:    str w8, [x2]
; CHECK-GI-NEXT:    ret
;
; CHECK-FI-LABEL: saddo1.i32:
; CHECK-FI:       // %bb.0: // %entry
; CHECK-FI-NEXT:    adds w8, w0, w1
; CHECK-FI-NEXT:    cset w9, vs
; CHECK-FI-NEXT:    str w8, [x2]
; CHECK-FI-NEXT:    and w0, w9, #0x1
; CHECK-FI-NEXT:    ret
entry:
  %t = call {i32, i1} @llvm.sadd.with.overflow.i32(i32 %v1, i32 %v2)
  %val = extractvalue {i32, i1} %t, 0
  %obit = extractvalue {i32, i1} %t, 1
  store i32 %val, ptr %res
  ret i1 %obit
}

