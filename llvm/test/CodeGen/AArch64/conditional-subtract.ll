  %r = sub i64 %x, %s
  ret i64 %r
}

; Keep both SUBS results live while overflow controls the conditional subtraction.

define i64 @overflow_shared_results64(i64 %x, i64 %q, ptr %diff_out, ptr %overflow_out) {
; CHECK-LABEL: overflow_shared_results64:
; CHECK:       // %bb.0:
; CHECK-NEXT:    subs x8, x0, x1
; CHECK-NEXT:    csel x0, x8, x0, vs
; CHECK-NEXT:    cset w9, vs
; CHECK-NEXT:    str x8, [x2]
; CHECK-NEXT:    strb w9, [x3]
; CHECK-NEXT:    ret
  %pair = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 %x, i64 %q)
  %diff = extractvalue { i64, i1 } %pair, 0
  %overflow = extractvalue { i64, i1 } %pair, 1
  store i64 %diff, ptr %diff_out
  store i1 %overflow, ptr %overflow_out
  %s = select i1 %overflow, i64 %q, i64 0
  %r = sub i64 %x, %s
  ret i64 %r
}

