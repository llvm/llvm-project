; Reusing SUBS must preserve other arithmetic-result and flag consumers.

define i64 @shared_flags(i64 %x, i64 %q, ptr %out) {
; CHECK-LABEL: shared_flags:
; CHECK:       // %bb.0:
; CHECK-NEXT:    subs x8, x0, x1
; CHECK-NEXT:    csel x0, x8, x0, hs
; CHECK-NEXT:    cset w8, hs
; CHECK-NEXT:    str x8, [x2]
; CHECK-NEXT:    ret
  %c = icmp uge i64 %x, %q
  %s = select i1 %c, i64 %q, i64 0
  %flag = zext i1 %c to i64
  store i64 %flag, ptr %out
  %r = sub i64 %x, %s
  ret i64 %r
}

