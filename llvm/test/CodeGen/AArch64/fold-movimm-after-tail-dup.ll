; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=aarch64 -O3 < %s | FileCheck %s

; A constant reaching a compare through a PHI. Tail duplication copies the
; compare into the predecessor that supplies the constant, and the copy should
; compare against the immediate rather than a register holding it.
define i64 @cmp_phi_zero(ptr %p, i64 %idx, ptr %q) {
; CHECK-LABEL: cmp_phi_zero:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ldr x8, [x0]
; CHECK-NEXT:    cbz x8, .LBB0_3
; CHECK-NEXT:  // %bb.1: // %tagged
; CHECK-NEXT:    tst x8, #0x7
; CHECK-NEXT:    b.eq .LBB0_5
; CHECK-NEXT:  // %bb.2: // %outofline
; CHECK-NEXT:    ldr x9, [x2]
; CHECK-NEXT:    cmp x1, x9
; CHECK-NEXT:    b.lo .LBB0_4
; CHECK-NEXT:    b .LBB0_6
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    cmp x1, xzr
; CHECK-NEXT:    b.hs .LBB0_6
; CHECK-NEXT:  .LBB0_4: // %load
; CHECK-NEXT:    and x8, x8, #0xfffffffffffffff8
; CHECK-NEXT:    ldr x0, [x8, x1, lsl #3]
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_5:
; CHECK-NEXT:    cmp x1, #1
; CHECK-NEXT:    b.lo .LBB0_4
; CHECK-NEXT:  .LBB0_6:
; CHECK-NEXT:    mov x0, #-1 // =0xffffffffffffffff
; CHECK-NEXT:    ret
entry:
  %info = load i64, ptr %p
  %isnull = icmp eq i64 %info, 0
  br i1 %isnull, label %join, label %tagged

tagged:
  %tag = and i64 %info, 7
  %istag = icmp eq i64 %tag, 0
  br i1 %istag, label %join, label %outofline

outofline:
  %cnt = load i64, ptr %q
  br label %join

join:
  %n = phi i64 [ 0, %entry ], [ 1, %tagged ], [ %cnt, %outofline ]
  %inbounds = icmp ult i64 %idx, %n
  br i1 %inbounds, label %load, label %reject

load:
  %base = and i64 %info, -8
  %bp = inttoptr i64 %base to ptr
  %ptr = getelementptr i64, ptr %bp, i64 %idx
  %v = load i64, ptr %ptr
  ret i64 %v

reject:
  ret i64 -1
}

; The same with an OR of a single-bit flag.
define i32 @or_phi_flag(ptr %p, i32 %x, i1 %c) {
; CHECK-LABEL: or_phi_flag:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    tbz w2, #0, .LBB1_2
; CHECK-NEXT:  // %bb.1: // %a
; CHECK-NEXT:    ldr w8, [x0]
; CHECK-NEXT:    orr w0, w1, w8
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    orr w0, w1, #0x10000
; CHECK-NEXT:    ret
entry:
  br i1 %c, label %a, label %join

a:
  %f = load i32, ptr %p
  br label %join

join:
  %flag = phi i32 [ 65536, %entry ], [ %f, %a ]
  %r = or i32 %x, %flag
  ret i32 %r
}
