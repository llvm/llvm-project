# RUN: llc -mtriple=aarch64-none-linux-gnu -mcpu=cortex-a57 \
# RUN:     -run-pass machine-combiner -machine-combiner-inc-threshold=0 \
# RUN:     -machine-combiner-verify-pattern-order=true -o - %s | FileCheck %s
---
# Test incremental depth updates succeed when triggered after the removal of
# the first instruction in a basic block.

# CHECK-LABEL: name: inc_update_iterator_test
name:            inc_update_iterator_test
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $d0, $w0, $w1, $w2

    %3:gpr32 = COPY $w2
    %2:gpr32 = COPY $w1
    %1:gpr32 = COPY $w0
    %0:fpr64 = COPY $d0
    %4:gpr32 = SUBSWrr %1, %2, implicit-def $nzcv
    Bcc 13, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    ; CHECK: MADDWrrr %2, %1, %0
    %5:gpr32 = MADDWrrr %1, %2, $wzr
    %6:gpr32 = ADDWrr %3, %5
    %7:fpr64 = SCVTFUWDri %6, implicit $fpcr
    ; CHECK: FMADDDrrr %7, %7, %3, implicit $fpcr
    %8:fpr64 = contract FMULDrr %7, %7, implicit $fpcr
    %9:fpr64 = contract FADDDrr %0, %8, implicit $fpcr
    $d0 = COPY %9
    RET_ReallyLR implicit $d0

  bb.2:
    $d0 = COPY %0
    RET_ReallyLR implicit $d0

...
