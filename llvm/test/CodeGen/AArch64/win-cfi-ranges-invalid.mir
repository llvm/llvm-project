# RUN: split-file %s %t
# RUN: not --crash llc -mtriple=aarch64-pc-windows-msvc -run-pass=aarch64-win-cfi \
# RUN:   -verify-machineinstrs %t/bypass-prologue.mir -o - 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=aarch64-pc-windows-msvc -passes=aarch64-win-cfi,verify \
# RUN:   %t/bypass-prologue.mir -o - 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=aarch64-pc-windows-msvc -run-pass=aarch64-win-cfi \
# RUN:   -verify-machineinstrs %t/bypass-epilogue.mir -o - 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=aarch64-pc-windows-msvc -passes=aarch64-win-cfi,verify \
# RUN:   %t/bypass-epilogue.mir -o - 2>&1 | FileCheck %s
# RUN: not --crash llc -mtriple=aarch64-pc-windows-msvc -run-pass=aarch64-win-cfi \
# RUN:   -verify-machineinstrs %t/multiple-prologues.mir -o - 2>&1 | FileCheck %s --check-prefix=MULTIPLE
# RUN: not --crash llc -mtriple=aarch64-pc-windows-msvc -passes=aarch64-win-cfi,verify \
# RUN:   %t/multiple-prologues.mir -o - 2>&1 | FileCheck %s --check-prefix=MULTIPLE

# CHECK: LLVM ERROR: inconsistent Windows ARM64 frame state at CFG join
# MULTIPLE: LLVM ERROR: AArch64 Windows unwind range insertion does not support multiple prologues

# A framed block cannot also be reached by a path that bypasses the prologue.
#--- bypass-prologue.mir
---
name: bypass_prologue
hasWinCFI: true
noPhis: true
isSSA: false
noVRegs: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    CBZW $w0, %bb.2

  bb.1:
    successors: %bb.2
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    B %bb.2

  bb.2:
    RET undef $lr
...

# Paths with and without a completed epilogue must not merge.
#--- bypass-epilogue.mir
---
name: bypass_epilogue
hasWinCFI: true
noPhis: true
isSSA: false
noVRegs: true
body: |
  bb.0:
    successors: %bb.1
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    CBZW $w0, %bb.3

  bb.2:
    successors: %bb.3
    frame-destroy SEH_EpilogStart
    $sp = frame-destroy ADDXri $sp, 16, 0
    frame-destroy SEH_StackAlloc 16
    frame-destroy SEH_EpilogEnd
    B %bb.3

  bb.3:
    RET undef $lr
...

# Disjoint prologue/epilogue paths do not produce a frame-state disagreement at
# a CFG join, but range insertion must reject them rather than use only the last
# prologue's recipe.
#--- multiple-prologues.mir
---
name: multiple_prologues
hasWinCFI: true
noPhis: true
isSSA: false
noVRegs: true
frameInfo:
  stackSize: 16
  maxAlignment: 16
  adjustsStack: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    CBZW $w0, %bb.2

  bb.1:
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    frame-destroy SEH_EpilogStart
    $sp = frame-destroy ADDXri $sp, 16, 0
    frame-destroy SEH_StackAlloc 16
    frame-destroy SEH_EpilogEnd
    RET undef $lr

  bb.2:
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    frame-destroy SEH_EpilogStart
    $sp = frame-destroy ADDXri $sp, 16, 0
    frame-destroy SEH_StackAlloc 16
    frame-destroy SEH_EpilogEnd
    RET undef $lr
...
