# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -verify-machineinstrs -verify-coalescing -enable-subreg-liveness \
# RUN:   -start-before=two-address-instruction -stop-after=register-coalescer \
# RUN:   -o - %s | FileCheck %s

# The tests insert the w0 register into the low bits of two gpr64 registers: src_as_64b and src_as_64b_2.
# Regardless of the instructions used for that (INSERT_SUBREG, SUBREG_TO_REG or COPY), those two vregs can get coalesced into one.
# SUBREG_TO_REG doesn't make coalescing safer, neither does it ensure that a MOV will be created.

---
name: insert_subreg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: insert_subreg
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: undef %src_as_64b_2.sub_32:gpr64common = COPY $w0
    ; CHECK-NEXT: %used:gpr64common = UBFMXri %src_as_64b_2, 63, 31
    ; CHECK-NEXT: %result:gpr64common = ADDXri %src_as_64b_2, 1, 0
    ; CHECK-NEXT: $x1 = COPY %used
    ; CHECK-NEXT: $x0 = COPY %result
    ; CHECK-NEXT: RET_ReallyLR implicit $x0, implicit $x1
    %src:gpr32common = COPY $w0
    %src_as_64b:gpr64 = INSERT_SUBREG undef %passthrough:gpr64all, %src, %subreg.sub_32
    %used:gpr64common = UBFMXri %src_as_64b, 63, 31
    %src_as_64b_2:gpr64sp = INSERT_SUBREG undef %passthrough2:gpr64all, %src, %subreg.sub_32
    %result:gpr64common = ADDXri %src_as_64b_2, 1, 0
    $x1 = COPY %used
    $x0 = COPY %result
    RET_ReallyLR implicit $x0, implicit $x1
...

