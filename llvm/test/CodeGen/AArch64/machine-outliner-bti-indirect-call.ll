; Check vtable-style indirect calls as reported in Android testing.
define i32 @vtable_call_1(ptr %o) minsize "branch-target-enforcement" {
; CHECK-LABEL: vtable_call_1:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    hint #34
; CHECK-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset w30, -16
; CHECK-NEXT:    bl OUTLINED_FUNCTION_2
; CHECK-NEXT:    add w0, w0, #1
; CHECK-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
; CHECK-NEXT:    ret
entry:
  %p0 = getelementptr inbounds i32, ptr %o, i64 2
  %0 = load i32, ptr %p0, align 4
  %p2 = getelementptr inbounds i32, ptr %o, i64 4
  %1 = load i32, ptr %p2, align 4
  %vtbl = load ptr, ptr %o, align 8
  %fnptr = getelementptr inbounds ptr, ptr %vtbl, i64 3
  %fn = load ptr, ptr %fnptr, align 8
  %call = tail call i32 %fn(ptr %o, i32 %0, i32 %1)
  %add = add nsw i32 %call, 1
  ret i32 %add
}

