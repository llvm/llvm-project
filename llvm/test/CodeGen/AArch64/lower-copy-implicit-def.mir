# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=post-ra-pseudos,dead-mi-elimination -verify-machineinstrs %s -o - | FileCheck %s

# When a COPY with an implicit def of a super-register is split into multiple
# instructions, the last one must not redefine the parts of the copy result
# defined by the earlier ones, or they become dead.

---
name:            split_copy_super_reg_def
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q4_q5, $q6_q7, $x0

    ; CHECK-LABEL: name: split_copy_super_reg_def
    ; CHECK: liveins: $q4_q5, $q6_q7, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q0 = ORRv16i8 $q4, $q4
    ; CHECK-NEXT: $q1 = ORRv16i8 $q5, $q5, implicit-def $q2_q3
    ; CHECK-NEXT: $q2 = ORRv16i8 $q6, $q6
    ; CHECK-NEXT: $q3 = ORRv16i8 $q7, $q7
    ; CHECK-NEXT: ST4Fourv4s $q0_q1_q2_q3, $x0
    ; CHECK-NEXT: RET_ReallyLR
    $q0_q1 = COPY $q4_q5, implicit-def $q0_q1_q2_q3
    $q2_q3 = COPY $q6_q7
    ST4Fourv4s $q0_q1_q2_q3, $x0
    RET_ReallyLR
...

# The copy is expanded backwards because the source and destination overlap.
# The source must still be read before the rest of the super-register is
# clobbered.
---
name:            split_copy_overlapping_super_reg_def
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q0_q1, $q4, $q5, $x0

    ; CHECK-LABEL: name: split_copy_overlapping_super_reg_def
    ; CHECK: liveins: $q0_q1, $q4, $q5, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q2 = ORRv16i8 $q1, $q1
    ; CHECK-NEXT: $q1 = ORRv16i8 $q0, $q0, implicit-def $q0, implicit-def $q3
    ; CHECK-NEXT: $q0 = ORRv16i8 $q4, $q4
    ; CHECK-NEXT: $q3 = ORRv16i8 $q5, $q5
    ; CHECK-NEXT: ST4Fourv4s $q0_q1_q2_q3, $x0
    ; CHECK-NEXT: RET_ReallyLR
    $q1_q2 = COPY $q0_q1, implicit-def $q0_q1_q2_q3
    $q0 = COPY $q4
    $q3 = COPY $q5
    ST4Fourv4s $q0_q1_q2_q3, $x0
    RET_ReallyLR
...

# An implicit def covered by the copy result is redundant.
---
name:            split_copy_sub_reg_def
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $q2_q3, $x0

    ; CHECK-LABEL: name: split_copy_sub_reg_def
    ; CHECK: liveins: $q2_q3, $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q0 = ORRv16i8 $q2, $q2
    ; CHECK-NEXT: $q1 = ORRv16i8 $q3, $q3
    ; CHECK-NEXT: ST2Twov4s $q0_q1, $x0
    ; CHECK-NEXT: RET_ReallyLR
    $q0_q1 = COPY $q2_q3, implicit-def $q0
    ST2Twov4s $q0_q1, $x0
    RET_ReallyLR
...

# A copy lowered to a single instruction keeps the super-register def.
---
name:            single_copy_super_reg_def
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w1

    ; CHECK-LABEL: name: single_copy_super_reg_def
    ; CHECK: liveins: $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $w0 = ORRWrr $wzr, $w1, implicit-def $x0
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    $w0 = COPY $w1, implicit-def $x0
    RET_ReallyLR implicit $x0
...
