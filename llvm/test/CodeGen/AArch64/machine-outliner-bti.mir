# RUN: llc -mtriple=aarch64--- -run-pass=prolog-epilog -run-pass=machine-outliner -verify-machineinstrs %s -o - | FileCheck %s

# AArch64 Branch Target Enforcement treats the BR and BLR indirect branch
# instructions differently. The BLR instruction can only target a BTI C
# instruction, and the BR instruction can only target a BTI J instruction. We
# always start indirectly-called functions with BTI C.
#
# However, BR X16 and BR X17 can also target a BTI C instruction. When outlining
# an indirect call as a thunk under branch-target-enforcement, the outliner moves
# the target register to X16 (or X17) and emits a tail-call using TCRETURNrix16x17
# (or TCRETURNrix17).
#
# When BLR has an undef register operand, the outliner must preserve the undef
# flag on the register operand (either in ORRXrs or directly in TCRETURNrix16x17)
# to avoid machine verifier failures.

# CHECK-LABEL: name: bar
# CHECK:       BL @OUTLINED_FUNCTION_2
# CHECK:       BL @OUTLINED_FUNCTION_2
# CHECK:       BL @OUTLINED_FUNCTION_2
# CHECK:       BL @OUTLINED_FUNCTION_2

# CHECK-LABEL: name: OUTLINED_FUNCTION_0
# CHECK:       STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g
# CHECK-NEXT:  TCRETURNrix16x17 undef $x16, 0, implicit $sp

# CHECK-LABEL: name: OUTLINED_FUNCTION_1
# CHECK:       STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g
# CHECK-NEXT:  $x16 = ORRXrs $xzr, undef $x8, 0
# CHECK-NEXT:  TCRETURNrix16x17 $x16, 0, implicit $sp

# CHECK-LABEL: name: OUTLINED_FUNCTION_2
# CHECK:       STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g
# CHECK-NEXT:  $x16 = ORRXrs $xzr, $x19, 0
# CHECK-NEXT:  TCRETURNrix16x17 $x16, 0, implicit $sp

--- |
  @g = hidden local_unnamed_addr global i32 0, align 4

  define hidden void @bar(ptr nocapture %f) "branch-target-enforcement" {
  entry:
    ret void
  }

  define hidden void @undef_x8() "branch-target-enforcement" {
  entry:
    ret void
  }

  define hidden void @undef_x16() "branch-target-enforcement" {
  entry:
    ret void
  }

  declare void @foo()
...
---
name:            bar
body:             |
  bb.0.entry:
    liveins: $x20, $x21, $lr, $x19

    HINT 34

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR renamable $x19, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR renamable $x19, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR renamable $x19, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui killed renamable $w21, killed renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR killed renamable $x19, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    TCRETURNdi @foo, 0, csr_aarch64_aapcs, implicit $sp
...
---
name:            undef_x8
body:             |
  bb.0.entry:
    liveins: $x20, $x21, $lr

    HINT 34

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x8, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x8, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x8, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui killed renamable $w21, killed renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x8, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    TCRETURNdi @foo, 0, csr_aarch64_aapcs, implicit $sp
...
---
name:            undef_x16
body:             |
  bb.0.entry:
    liveins: $x20, $x21, $lr

    HINT 34

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x16, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x16, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui renamable $w21, renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x16, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    STRWui killed renamable $w21, killed renamable $x20, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    BLR undef $x16, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp

    TCRETURNdi @foo, 0, csr_aarch64_aapcs, implicit $sp
...
