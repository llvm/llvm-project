define void @masked_gather_32b_scaled_sext_f16(ptr %a, ptr %b, ptr %base) {
; CHECK-LABEL: masked_gather_32b_scaled_sext_f16:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldr q0, [x0]
; CHECK-NEXT:    ptrue p0.s, vl4
; CHECK-NEXT:    fcmeq v0.8h, v0.8h, #0.0
; CHECK-NEXT:    sshll2 v1.4s, v0.8h, #0
; CHECK-NEXT:    sshll v0.4s, v0.4h, #0
; CHECK-NEXT:    cmpne p1.s, p0/z, z1.s, #0
; CHECK-NEXT:    cmpne p2.s, p0/z, z0.s, #0
; CHECK-NEXT:    ldp q1, q0, [x1]
; CHECK-NEXT:    ld1h { z0.s }, p1/z, [x2, z0.s, sxtw #1]
; CHECK-NEXT:    ld1h { z1.s }, p2/z, [x2, z1.s, sxtw #1]
; CHECK-NEXT:    uzp1 v0.8h, v1.8h, v0.8h
; CHECK-NEXT:    str q0, [x0]
; CHECK-NEXT:    ret
  %cvals = load <8 x half>, ptr %a
  %idxs = load <8 x i32>, ptr %b
  %ext = sext <8 x i32> %idxs to <8 x i64>
  %ptrs = getelementptr half, ptr %base, <8 x i64> %ext
  %mask = fcmp oeq <8 x half> %cvals, zeroinitializer
  %vals = call <8 x half> @llvm.masked.gather.v8f16(<8 x ptr> %ptrs, i32 2, <8 x i1> %mask, <8 x half> poison)
  store <8 x half> %vals, ptr %a
  ret void
}

