; RUN: llc < %s -mattr=+sve | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; Six input vectors form one wide vector. The scalable case writes it with two
; st3 stores, three vector lengths apart.
define void @interleave6_store_scalable(ptr %dst, <vscale x 2 x double> %a, <vscale x 2 x double> %b, <vscale x 2 x double> %c, <vscale x 2 x double> %d, <vscale x 2 x double> %e, <vscale x 2 x double> %f) {
; CHECK-LABEL: interleave6_store_scalable:
; CHECK:       // %bb.0:
; CHECK-NEXT:    zip2 z26.d, z2.d, z5.d
; CHECK-NEXT:    zip1 z7.d, z2.d, z5.d
; CHECK-NEXT:    ptrue p0.d
; CHECK-NEXT:    zip2 z25.d, z1.d, z4.d
; CHECK-NEXT:    zip1 z6.d, z1.d, z4.d
; CHECK-NEXT:    zip2 z24.d, z0.d, z3.d
; CHECK-NEXT:    zip1 z5.d, z0.d, z3.d
; CHECK-NEXT:    st3d { z24.d - z26.d }, p0, [x0, #3, mul vl]
; CHECK-NEXT:    st3d { z5.d - z7.d }, p0, [x0]
; CHECK-NEXT:    ret
  %wide = call <vscale x 12 x double> @llvm.vector.interleave6.nxv12f64(<vscale x 2 x double> %a, <vscale x 2 x double> %b, <vscale x 2 x double> %c, <vscale x 2 x double> %d, <vscale x 2 x double> %e, <vscale x 2 x double> %f)
  store <vscale x 12 x double> %wide, ptr %dst, align 8
  ret void
}

