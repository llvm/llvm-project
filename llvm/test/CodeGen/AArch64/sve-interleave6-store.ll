; CHECK-NEXT:    st3 { v5.2d, v6.2d, v7.2d }, [x8], #48
; CHECK-NEXT:    ldp q1, q0, [sp, #16]
; CHECK-NEXT:    ldr q2, [sp]
; CHECK-NEXT:    stp q1, q0, [x0, #64]
; CHECK-NEXT:    str q2, [x8]
; CHECK-NEXT:    add sp, sp, #48
; CHECK-NEXT:    ret
  %wide = call <12 x double> @llvm.vector.interleave6.v12f64(<2 x double> %a, <2 x double> %b, <2 x double> %c, <2 x double> %d, <2 x double> %e, <2 x double> %f)
  store <12 x double> %wide, ptr %dst, align 8
