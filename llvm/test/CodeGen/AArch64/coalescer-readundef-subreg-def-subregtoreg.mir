# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness \
# RUN:   -passes='require<live-intervals>,verify,register-coalescer,invalidate<live-intervals>,require<live-intervals>,verify' \
# RUN:   %s -o - | FileCheck %s

# Similar to coalescer-readundef-subreg-def.mir but with a SUBREG_TO_REG instead of a read-undef partial COPY.
# The coalescing issue is the same.

---
name: coalescer_subreg_to_reg_undef
isSSA: false
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: coalescer_subreg_to_reg_undef
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[COPY:%[0-9]+]].sub_32:gpr64common = COPY $wzr
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = ADDXri [[COPY]], 1, 0
  ; CHECK-NEXT:   CBNZX [[COPY]], %bb.2
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[COPY:%[0-9]+]].sub_32:gpr64common = SUBWri [[COPY]].sub_32, 1, 0
  ; CHECK-NEXT:   B %bb.1
  bb.0:
    successors: %bb.1

    %0:gpr32all = COPY $wzr
    B %bb.1

  bb.1:
    successors: %bb.2

    %1:gpr32common = COPY %0
    B %bb.2

  bb.2:
    successors: %bb.2, %bb.3

    %2:gpr64common = SUBREG_TO_REG %1, %subreg.sub_32
    %3:gpr64common = ADDXri %2, 1, 0
    %1:gpr32common = COPY %3.sub_32
    CBNZX %3, %bb.2
    B %bb.3

  bb.3:
    successors: %bb.1

    %4:gpr32common = SUBWri %1, 1, 0
    %0:gpr32all = COPY %4
    B %bb.1
...
