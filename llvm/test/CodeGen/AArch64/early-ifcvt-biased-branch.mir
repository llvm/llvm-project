# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --filter "^\s*bb\.[0-9]" --version 6
# RUN: llc -mtriple=aarch64 -run-pass=early-ifcvt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -passes=early-ifcvt -verify-each %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -run-pass=early-ifcvt %s -o - | FileCheck %s --check-prefix=DECISION
# RUN: llc -mtriple=aarch64 -run-pass=early-ifcvt -pass-remarks-analysis=early-ifcvt %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=REMARK

# A branch with a cold edge below 1% must retain its loop-carried fast path.
# The same branch with balanced edges can be if-converted.
# DECISION-LABEL: name: biased_branch
# DECISION: CBZW
# DECISION-NOT: CSELWr
# DECISION-LABEL: name: balanced_branch
# DECISION-NOT: bb.2.read:
# DECISION: CSELWr
# REMARK: branch has a cold edge below 1%, using a critical-path extension budget of 0 cycles

--- |
  define i32 @biased_branch(ptr %counts, i64 %count, i64 %bits, i32 %initial, ptr %out) {
  entry: br label %loop
  loop: br label %read
  read: br label %merge
  merge: br label %exit
  exit: ret i32 0
  }
  define i32 @balanced_branch(ptr %counts, i64 %count, i64 %bits, i32 %initial, ptr %out) {
  entry: br label %loop
  loop: br label %read
  read: br label %merge
  merge: br label %exit
  exit: ret i32 0
  }
...
---
name:            biased_branch
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 6, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr32all, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr32all, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 11, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 12, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 13, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 14, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 15, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 16, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 17, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 18, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 19, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 20, class: gpr64all, preferred-register: '', flags: [  ] }
  - { id: 21, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 22, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 23, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 24, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 25, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 26, class: gpr64, preferred-register: '', flags: [  ] }
  - { id: 27, class: gpr32, preferred-register: '', flags: [  ] }
  - { id: 28, class: gpr64sp, preferred-register: '', flags: [  ] }
  - { id: 29, class: gpr64, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$x0', virtual-reg: '%12' }
  - { reg: '$x1', virtual-reg: '%13' }
  - { reg: '$x2', virtual-reg: '%14' }
  - { reg: '$w3', virtual-reg: '%15' }
  - { reg: '$x4', virtual-reg: '%16' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  ; CHECK-LABEL: name: biased_branch
  ; CHECK: bb.0.entry:
  ; CHECK: bb.1.loop:
  ; CHECK: bb.2.read:
  ; CHECK: bb.3.merge:
  ; CHECK: bb.4.exit:
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $x0, $x1, $x2, $w3, $x4

    %16:gpr64 = COPY $x4
    %15:gpr32 = COPY $w3
    %14:gpr64 = COPY $x2
    %13:gpr64 = COPY $x1
    %12:gpr64 = COPY $x0

  bb.1.loop:
    successors: %bb.3(0x7fef9fcb), %bb.2(0x00106035)

    %0:gpr64sp = PHI %12, %bb.0, %5, %bb.3
    %1:gpr64sp = PHI %16, %bb.0, %11, %bb.3
    %2:gpr64sp = PHI %13, %bb.0, %10, %bb.3
    %3:gpr32 = PHI %15, %bb.0, %9, %bb.3
    early-clobber %18:gpr64sp, %19:gpr32 = LDRBBpost %0, 1 :: (load (s8))
    %4:gpr32 = COPY %19
    %20:gpr64all = COPY $xzr
    %17:gpr64all = COPY %20
    %5:gpr64all = COPY %18
    CBZW %19, %bb.3
    B %bb.2

  bb.2.read:
    successors: %bb.3(0x80000000)

    %21:gpr64 = SUBREG_TO_REG %3, %subreg.sub_32
    %22:gpr64 = LSLVXr %14, killed %21
    %23:gpr32 = COPY $wzr
    %24:gpr32 = SUBSWrr %23, %4, implicit-def dead $nzcv
    %25:gpr64 = SUBREG_TO_REG killed %24, %subreg.sub_32
    %26:gpr64 = LSRVXr killed %22, killed %25
    %6:gpr64all = COPY %26
    %27:gpr32 = ADDWrr %3, %4
    %7:gpr32all = COPY %27

  bb.3.merge:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)

    %8:gpr64 = PHI %17, %bb.1, %6, %bb.2
    %9:gpr32all = PHI %3, %bb.1, %7, %bb.2
    early-clobber %28:gpr64sp = STRXpost %8, %1, 8 :: (store (s64))
    %29:gpr64 = SUBSXri %2, 1, 0, implicit-def $nzcv
    %10:gpr64all = COPY %29
    %11:gpr64all = COPY %28
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.4

  bb.4.exit:
    $w0 = COPY %9
    RET_ReallyLR implicit $w0
...
