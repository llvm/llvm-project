; The shift feeds its own phi.
define i64 @lshr_loop_phi(<2 x i64> %init, i64 %n) {
; CHECK-LABEL: lshr_loop_phi:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:  .LBB2_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ushr v0.2d, v0.2d, #32
; CHECK-NEXT:    subs x0, x0, #1
; CHECK-NEXT:    b.ne .LBB2_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    mov x8, v0.d[1]
; CHECK-NEXT:    fmov x9, d0
; CHECK-NEXT:    umull x0, w9, w8
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %p = phi <2 x i64> [ %init, %entry ], [ %s, %loop ]
  %s = lshr <2 x i64> %p, splat (i64 32)
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  %e0 = extractelement <2 x i64> %s, i64 0
  %e1 = extractelement <2 x i64> %s, i64 1
  %m = mul i64 %e0, %e1
  ret i64 %m
}
