; The shifted vectors come from phis. Both incoming values of the phis in
; @lshr_phi and @ashr_phi have their top 16 bits known zero, so after the shift
; the top 32 bits of every lane are known zero and the i64 multiply of two
; extracted lanes can use umull.

define i64 @lshr_phi(i1 %c, ptr %pa, ptr %pb) {
; CHECK-SD-LABEL: lshr_phi:
; CHECK-SD:       // %bb.0: // %entry
; CHECK-SD-NEXT:    tbz w0, #0, .LBB0_2
; CHECK-SD-NEXT:  // %bb.1: // %if
; CHECK-SD-NEXT:    movi v0.2d, #0x00ffffffff0000
; CHECK-SD-NEXT:    ldr q1, [x1]
; CHECK-SD-NEXT:    and v0.16b, v1.16b, v0.16b
; CHECK-SD-NEXT:    b .LBB0_3
; CHECK-SD-NEXT:  .LBB0_2: // %else
; CHECK-SD-NEXT:    ldr d0, [x2]
; CHECK-SD-NEXT:    ushll v0.2d, v0.2s, #0
; CHECK-SD-NEXT:  .LBB0_3: // %end
; CHECK-SD-NEXT:    ushr v0.2d, v0.2d, #16
; CHECK-SD-NEXT:    mov x8, v0.d[1]
; CHECK-SD-NEXT:    fmov x9, d0
; CHECK-SD-NEXT:    mul x0, x9, x8
; CHECK-SD-NEXT:    ret
;
; CHECK-GI-LABEL: lshr_phi:
; CHECK-GI:       // %bb.0: // %entry
; CHECK-GI-NEXT:    tbz w0, #0, .LBB0_2
; CHECK-GI-NEXT:  // %bb.1: // %if
; CHECK-GI-NEXT:    movi v0.2d, #0x00ffffffff0000
; CHECK-GI-NEXT:    ldr q1, [x1]
; CHECK-GI-NEXT:    and v0.16b, v1.16b, v0.16b
; CHECK-GI-NEXT:    b .LBB0_3
; CHECK-GI-NEXT:  .LBB0_2: // %else
; CHECK-GI-NEXT:    ldr d0, [x2]
; CHECK-GI-NEXT:    ushll v0.2d, v0.2s, #0
; CHECK-GI-NEXT:  .LBB0_3: // %end
; CHECK-GI-NEXT:    ushr v0.2d, v0.2d, #16
; CHECK-GI-NEXT:    mov x8, v0.d[1]
; CHECK-GI-NEXT:    fmov x9, d0
; CHECK-GI-NEXT:    umull x0, w9, w8
; CHECK-GI-NEXT:    ret
entry:
  br i1 %c, label %if, label %else
if:
  %a = load <2 x i64>, ptr %pa
  %a.m = and <2 x i64> %a, splat (i64 281474976645120)
  br label %end
else:
  %b = load <2 x i32>, ptr %pb
  %b.z = zext <2 x i32> %b to <2 x i64>
  br label %end
end:
  %p = phi <2 x i64> [ %a.m, %if ], [ %b.z, %else ]
  %s = lshr <2 x i64> %p, splat (i64 16)
  %e0 = extractelement <2 x i64> %s, i64 0
  %e1 = extractelement <2 x i64> %s, i64 1
  %m = mul i64 %e0, %e1
  ret i64 %m
}

