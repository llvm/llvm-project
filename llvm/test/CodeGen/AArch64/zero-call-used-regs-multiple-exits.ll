; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=aarch64-unknown-linux-gnu -verify-machineinstrs | FileCheck %s

; FIXME: The ordinary return should clear the argument registers.
; Tail-call arguments must not prevent register clearing at the ordinary return.
declare i64 @sink(i64, i64, i64, i64, i64, i64)

define i64 @return_and_tail(i1 %cond, i64 %a, i64 %b) "zero-call-used-regs"="used-gpr" {
; CHECK-LABEL: return_and_tail:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    tbz w0, #0, .LBB0_2
; CHECK-NEXT:  // %bb.1: // %tail
; CHECK-NEXT:    mov x3, x2
; CHECK-NEXT:    mov x2, x1
; CHECK-NEXT:    mov x0, x1
; CHECK-NEXT:    mov x1, x3
; CHECK-NEXT:    mov x4, x2
; CHECK-NEXT:    mov x5, x3
; CHECK-NEXT:    b sink
; CHECK-NEXT:  .LBB0_2: // %common.ret
; CHECK-NEXT:    mov w0, #42 // =0x2a
; CHECK-NEXT:    ret
entry:
  br i1 %cond, label %tail, label %return

tail:
  %result = tail call i64 @sink(i64 %a, i64 %b, i64 %a, i64 %b, i64 %a, i64 %b)
  ret i64 %result

return:
  ret i64 42
}
