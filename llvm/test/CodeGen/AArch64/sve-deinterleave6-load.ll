; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mattr=+sve | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; Each ld3 reads three vectors. The second load must start after those three
; vectors: 3 VL for scalable vectors, or 48 bytes for <2 x double> vectors.

define void @deinterleave6_load_scalable(ptr %src) {
; CHECK-LABEL: deinterleave6_load_scalable:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ptrue p0.d
; CHECK-NEXT:    rdvl x8, #3
; CHECK-NEXT:    add x8, x0, x8
; CHECK-NEXT:    ld3d { z0.d - z2.d }, p0/z, [x0]
; CHECK-NEXT:    ld3d { z3.d - z5.d }, p0/z, [x8]
; CHECK-NEXT:    uzp1 z16.d, z0.d, z3.d
; CHECK-NEXT:    uzp2 z6.d, z2.d, z5.d
; CHECK-NEXT:    uzp2 z7.d, z1.d, z4.d
; CHECK-NEXT:    uzp2 z17.d, z0.d, z3.d
; CHECK-NEXT:    uzp1 z18.d, z2.d, z5.d
; CHECK-NEXT:    uzp1 z0.d, z1.d, z4.d
; CHECK-NEXT:    // fake_use: $z16
; CHECK-NEXT:    // fake_use: $z0
; CHECK-NEXT:    // fake_use: $z18
; CHECK-NEXT:    // fake_use: $z17
; CHECK-NEXT:    // fake_use: $z7
; CHECK-NEXT:    // fake_use: $z6
; CHECK-NEXT:    ret
entry:
  %wide = load <vscale x 12 x double>, ptr %src, align 8
  %parts = call { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } @llvm.vector.deinterleave6.nxv12f64(<vscale x 12 x double> %wide)
  %p0 = extractvalue { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } %parts, 0
  %p1 = extractvalue { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } %parts, 1
  %p2 = extractvalue { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } %parts, 2
  %p3 = extractvalue { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } %parts, 3
  %p4 = extractvalue { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } %parts, 4
  %p5 = extractvalue { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } %parts, 5
  call void (...) @llvm.fake.use(<vscale x 2 x double> %p0)
  call void (...) @llvm.fake.use(<vscale x 2 x double> %p1)
  call void (...) @llvm.fake.use(<vscale x 2 x double> %p2)
  call void (...) @llvm.fake.use(<vscale x 2 x double> %p3)
  call void (...) @llvm.fake.use(<vscale x 2 x double> %p4)
  call void (...) @llvm.fake.use(<vscale x 2 x double> %p5)
  ret void
}

define void @deinterleave6_fixed_load(ptr %src) {
; CHECK-LABEL: deinterleave6_fixed_load:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ld3 { v0.2d, v1.2d, v2.2d }, [x0], #48
; CHECK-NEXT:    ld3 { v3.2d, v4.2d, v5.2d }, [x0]
; CHECK-NEXT:    uzp1 v16.2d, v0.2d, v3.2d
; CHECK-NEXT:    uzp2 v6.2d, v2.2d, v5.2d
; CHECK-NEXT:    uzp2 v7.2d, v1.2d, v4.2d
; CHECK-NEXT:    uzp2 v17.2d, v0.2d, v3.2d
; CHECK-NEXT:    uzp1 v18.2d, v2.2d, v5.2d
; CHECK-NEXT:    uzp1 v0.2d, v1.2d, v4.2d
; CHECK-NEXT:    // fake_use: $q16
; CHECK-NEXT:    // fake_use: $q0
; CHECK-NEXT:    // fake_use: $q18
; CHECK-NEXT:    // fake_use: $q17
; CHECK-NEXT:    // fake_use: $q7
; CHECK-NEXT:    // fake_use: $q6
; CHECK-NEXT:    ret
entry:
  %wide = load <12 x double>, ptr %src, align 8
  %parts = call { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } @llvm.vector.deinterleave6.v12f64(<12 x double> %wide)
  %p0 = extractvalue { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } %parts, 0
  %p1 = extractvalue { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } %parts, 1
  %p2 = extractvalue { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } %parts, 2
  %p3 = extractvalue { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } %parts, 3
  %p4 = extractvalue { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } %parts, 4
  %p5 = extractvalue { <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double>, <2 x double> } %parts, 5
  call void (...) @llvm.fake.use(<2 x double> %p0)
  call void (...) @llvm.fake.use(<2 x double> %p1)
  call void (...) @llvm.fake.use(<2 x double> %p2)
  call void (...) @llvm.fake.use(<2 x double> %p3)
  call void (...) @llvm.fake.use(<2 x double> %p4)
  call void (...) @llvm.fake.use(<2 x double> %p5)
  ret void
}

declare void @llvm.fake.use(...)
declare { <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double>, <vscale x 2 x double> } @llvm.vector.deinterleave6.nxv12f64(<vscale x 12 x double>)
