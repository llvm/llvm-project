; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=aarch64 -mattr=-neon < %s | FileCheck %s
; RUN: llc -mtriple=aarch64 -mattr=-neon,+fullfp16 < %s | FileCheck %s

; Without NEON there are no legal vector types, so an i16 to half or bfloat
; bitcast must not be lowered through vector operations. These used to loop
; forever in type legalization.

define half @bitcast_i16_half(i16 %x) {
; CHECK-LABEL: bitcast_i16_half:
; CHECK:       // %bb.0:
; CHECK-NEXT:    fmov s0, w0
; CHECK-NEXT:    // kill: def $h0 killed $h0 killed $s0
; CHECK-NEXT:    ret
  %h = bitcast i16 %x to half
  ret half %h
}

define bfloat @bitcast_i16_bfloat(i16 %x) {
; CHECK-LABEL: bitcast_i16_bfloat:
; CHECK:       // %bb.0:
; CHECK-NEXT:    fmov s0, w0
; CHECK-NEXT:    // kill: def $h0 killed $h0 killed $s0
; CHECK-NEXT:    ret
  %h = bitcast i16 %x to bfloat
  ret bfloat %h
}

define half @bitcast_v2i8_half(<2 x i8> %x) {
; CHECK-LABEL: bitcast_v2i8_half:
; CHECK:       // %bb.0:
; CHECK-NEXT:    bfi w0, w1, #8, #24
; CHECK-NEXT:    fmov s0, w0
; CHECK-NEXT:    // kill: def $h0 killed $h0 killed $s0
; CHECK-NEXT:    ret
  %h = bitcast <2 x i8> %x to half
  ret half %h
}
