; CHECK-NEXT:    mov z1.s, p0/m, s0
; CHECK-NEXT:    mov z0.d, z1.d
; CHECK-NEXT:    ret
  %a.insert = insertelement <vscale x 1 x float> poison, float %a, i64 0
  %a.splat = shufflevector <vscale x 1 x float> %a.insert, <vscale x 1 x float> poison, <vscale x 1 x i32> zeroinitializer
  %b.insert = insertelement <vscale x 1 x float> poison, float %b, i64 0
  %b.splat = shufflevector <vscale x 1 x float> %b.insert, <vscale x 1 x float> poison, <vscale x 1 x i32> zeroinitializer
  %res = call <vscale x 2 x float> @llvm.vector.interleave2.nxv2f32(<vscale x 1 x float> %a.splat, <vscale x 1 x float> %b.splat)
  ret <vscale x 2 x float> %res
}

