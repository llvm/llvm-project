define <16 x i8> @stv_noundef_frozen_load_i8(ptr %p) {
; CHECK-LABEL: stv_noundef_frozen_load_i8:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldr b0, [x0]
; CHECK-NEXT:    ret
  %v = load i8, ptr %p
  %z = zext i8 %v to i32
  %f = freeze i32 %z
  %t = trunc i32 %f to i8
  %s = insertelement <16 x i8> poison, i8 %t, i32 0
  ret <16 x i8> %s
}

; The same frozen-load shape reaches ISel through bitconvert: visitFREEZE
; pushes freeze through single-use bitcasts, so bitconvert(freeze(extload))
; must also select the direct SIMD-register load forms.

define float @bc_frozen_zextload_i8_f32(ptr %p) {
; CHECK-LABEL: bc_frozen_zextload_i8_f32:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldr b0, [x0]
; CHECK-NEXT:    ret
  %v = load i8, ptr %p
  %f = freeze i8 %v
  %e = zext i8 %f to i32
  %b = bitcast i32 %e to float
  ret float %b
}

define float @bc_frozen_zextload_i16_f32_reg_offset(ptr %p, i64 %i) {
; CHECK-LABEL: bc_frozen_zextload_i16_f32_reg_offset:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ldr h0, [x0, x1, lsl #1]
; CHECK-NEXT:    ret
  %q = getelementptr i16, ptr %p, i64 %i
  %v = load i16, ptr %q
  %f = freeze i16 %v
  %e = zext i16 %f to i32
  %b = bitcast i32 %e to float
  ret float %b
}

