# RUN: llc -mtriple=aarch64 -mcpu=neoverse-n1 -run-pass=pipeliner \
# RUN:   -pipeliner-mve-cg -pipeliner-force-ii=8 -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: can_apply
# CHECK: bb.3:
# CHECK: bb.1:
# CHECK: bb.2:
# CHECK-NEXT: DBG_VALUE $noreg, $noreg

# CHECK-LABEL: name: merge_uses
# CHECK: bb.3:
# CHECK: bb.1:
# CHECK: bb.2:
# CHECK-NEXT: DBG_VALUE $noreg, $noreg

--- |
  define void @can_apply() !dbg !3 { ret void }
  define void @merge_uses() !dbg !7 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "can_apply", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !DILocalVariable(name: "v", scope: !3, file: !1, line: 1, type: !10)
  !7 = distinct !DISubprogram(name: "merge_uses", scope: !1, file: !1, line: 2, type: !4, scopeLine: 2, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !8 = !DILocalVariable(name: "v", scope: !7, file: !1, line: 2, type: !10)
  !9 = !DILocation(line: 1, column: 1, scope: !3)
  !10 = !DIBasicType(name: "double", size: 64, encoding: DW_ATE_float)
  !11 = !DILocation(line: 2, column: 1, scope: !7)
...
---
name: can_apply
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $x0, $x1, $x2

    %11:gpr64common = COPY $x2
    %10:gpr64 = COPY $x1
    %9:gpr64 = COPY $x0
    dead $xzr = SUBSXri %11, 1, 0, implicit-def $nzcv
    %14:gpr64 = CSINCXr %11, $xzr, 12, implicit $nzcv
    %12:fpr64 = FMOVD0
    %0:gpr64all = COPY %14

  bb.1:
    successors: %bb.2, %bb.1

    %1:gpr64sp = PHI %10, %bb.0, %8, %bb.1
    %2:gpr64sp = PHI %9, %bb.0, %7, %bb.1
    %3:gpr64sp = PHI %0, %bb.0, %6, %bb.1
    %4:fpr64 = PHI %12, %bb.0, %5, %bb.1
    early-clobber %15:gpr64sp, %16:fpr64 = LDRDpost %1, 8
    %5:fpr64 = nofpexcept FADDDrr %4, %16, implicit $fpcr
    early-clobber %17:gpr64sp = STRDpost %5, %2, 8
    %18:gpr64 = nsw SUBSXri %3, 1, 0, implicit-def $nzcv
    %6:gpr64all = COPY %18
    %7:gpr64all = COPY %17
    %8:gpr64all = COPY %15
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.2

  bb.2:
    DBG_VALUE %4, $noreg, !6, !DIExpression(), debug-location !9
    RET_ReallyLR
...
---
name: merge_uses
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $x0, $x1, $x2

    %11:gpr64common = COPY $x2
    %10:gpr64 = COPY $x1
    %9:gpr64 = COPY $x0
    dead $xzr = SUBSXri %11, 1, 0, implicit-def $nzcv
    %14:gpr64 = CSINCXr %11, $xzr, 12, implicit $nzcv
    %12:fpr64 = FMOVD0
    %0:gpr64all = COPY %14

  bb.1:
    successors: %bb.2, %bb.1

    %1:gpr64sp = PHI %10, %bb.0, %8, %bb.1
    %2:gpr64sp = PHI %9, %bb.0, %7, %bb.1
    %3:gpr64sp = PHI %0, %bb.0, %6, %bb.1
    %4:fpr64 = PHI %12, %bb.0, %5, %bb.1
    early-clobber %15:gpr64sp, %16:fpr64 = LDRDpost %1, 8
    %5:fpr64 = nofpexcept FADDDrr %4, %16, implicit $fpcr
    early-clobber %17:gpr64sp = STRDpost %5, %2, 8
    %18:gpr64 = nsw SUBSXri %3, 1, 0, implicit-def $nzcv
    %6:gpr64all = COPY %18
    %7:gpr64all = COPY %17
    %8:gpr64all = COPY %15
    Bcc 1, %bb.1, implicit $nzcv
    B %bb.2

  bb.2:
    DBG_VALUE %5, $noreg, !8, !DIExpression(), debug-location !11
    RET_ReallyLR
...
