# RUN: llc -mtriple=aarch64 -o - %s -enable-subreg-liveness=false \
# RUN: -start-before=aarch64-mi-peephole-opt -stop-after=virt-reg-rewriter | FileCheck %s --check-prefixes=MIR-SRLT-OFF
# RUN: llc -mtriple=aarch64 -o - %s -enable-subreg-liveness=true \
# RUN: -start-before=aarch64-mi-peephole-opt -stop-after=virt-reg-rewriter | FileCheck %s --check-prefixes=MIR-SRLT-ON,MIR-SRLT-ON-REWRITER
# RUN: llc -mtriple=aarch64 -o - %s -enable-subreg-liveness=false \
# RUN: -start-before=aarch64-mi-peephole-opt -stop-after=post-ra-pseudos | FileCheck %s --check-prefixes=MIR-SRLT-OFF
# RUN: llc -mtriple=aarch64 -o - %s -enable-subreg-liveness=true \
# RUN: -start-before=aarch64-mi-peephole-opt -stop-after=post-ra-pseudos | FileCheck %s --check-prefixes=MIR-SRLT-ON,MIR-SRLT-ON-POSTRA

# Similar to llvm/test/CodeGen/AArch64/zext-reg-coalesce.mir but checks the instructions after
# regalloc. We want to ensure a zext (ORRW) remains when needed, with or without SRLT enabled.

---
name:            insert_subreg
alignment:       4
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; MIR-SRLT-OFF-LABEL: name: insert_subreg
    ; MIR-SRLT-OFF: liveins: $w0
    ; MIR-SRLT-OFF-NEXT: {{  $}}
    ; MIR-SRLT-OFF-NEXT: renamable $w0 = KILL $w0, implicit-def $x0
    ; MIR-SRLT-OFF-NEXT: RET_ReallyLR implicit $x0
    ;
    ; MIR-SRLT-ON-LABEL: name: insert_subreg
    ; MIR-SRLT-ON: liveins: $w0
    ; MIR-SRLT-ON-NEXT: {{  $}}
    ; MIR-SRLT-ON-NEXT: RET_ReallyLR implicit $x0
    %0:gpr32 = COPY $w0
    %2:gpr64all = INSERT_SUBREG undef %3:gpr64, %0, %subreg.sub_32
    $x0 = COPY %2
    RET_ReallyLR implicit $x0
...

---
name:            insert_subreg_zext
alignment:       4
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; MIR-SRLT-OFF-LABEL: name: insert_subreg_zext
    ; MIR-SRLT-OFF: liveins: $w0
    ; MIR-SRLT-OFF-NEXT: {{  $}}
    ; MIR-SRLT-OFF-NEXT: renamable $w0 = ORRWrs $wzr, killed renamable $w0, 0, implicit-def $x0
    ; MIR-SRLT-OFF-NEXT: RET_ReallyLR implicit $x0
    ;
    ; MIR-SRLT-ON-REWRITER-LABEL: name: insert_subreg_zext
    ; MIR-SRLT-ON-REWRITER: liveins: $w0
    ; MIR-SRLT-ON-REWRITER-NEXT: {{  $}}
    ; MIR-SRLT-ON-REWRITER-NEXT: renamable $w0 = ORRWrs $wzr, killed renamable $w0, 0
    ; MIR-SRLT-ON-REWRITER-NEXT: RET_ReallyLR implicit $x0
    ;
    ; MIR-SRLT-ON-POSTRA-LABEL: name: insert_subreg_zext
    ; MIR-SRLT-ON-POSTRA: liveins: $w0
    ; MIR-SRLT-ON-POSTRA-NEXT: {{  $}}
    ; MIR-SRLT-ON-POSTRA-NEXT: renamable $w0 = ORRWrs $wzr, killed renamable $w0, 0, implicit-def renamable $x0
    ; MIR-SRLT-ON-POSTRA-NEXT: RET_ReallyLR implicit $x0
    %0:gpr32 = COPY $w0
    %1:gpr32 = ORRWrs $wzr, %0, 0
    %2:gpr64all = INSERT_SUBREG undef %3:gpr64all, %1, %subreg.sub_32
    $x0 = COPY %2
    RET_ReallyLR implicit $x0
...

---
name:            subreg_to_reg
alignment:       4
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0
    ; MIR-SRLT-OFF-LABEL: name: subreg_to_reg
    ; MIR-SRLT-OFF: liveins: $w0
    ; MIR-SRLT-OFF-NEXT: {{  $}}
    ; MIR-SRLT-OFF-NEXT: renamable $w0 = KILL $w0, implicit-def $x0
    ; MIR-SRLT-OFF-NEXT: RET_ReallyLR implicit $x0
