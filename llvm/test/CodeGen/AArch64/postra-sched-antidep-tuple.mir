# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -mcpu=cortex-a57 -run-pass=post-RA-sched \
# RUN:   -break-anti-dependencies=all -o - %s | FileCheck %s

# $d7 shares tuple registers (e.g. $d7_d8) with the callee-saved $d8, but it is
# not callee-saved itself, so it can be renamed.
---
name:            rename_caller_saved_reg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x0, $x1, $x2, $d1, $d7
    ; CHECK-LABEL: name: rename_caller_saved_reg
    ; CHECK: liveins: $x0, $x1, $x2, $d1, $d7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $d2 = LDRDui killed renamable $x0, 0 :: (load (s64))
    ; CHECK-NEXT: renamable $d3 = nofpexcept FADDDrr killed renamable $d7, killed renamable $d1, implicit $fpcr
    ; CHECK-NEXT: STRDui killed $d2, killed renamable $x1, 0 :: (store (s64))
    ; CHECK-NEXT: STRDui killed renamable $d3, killed renamable $x2, 0 :: (store (s64))
    ; CHECK-NEXT: RET_ReallyLR
    renamable $d3 = nofpexcept FADDDrr renamable $d7, renamable $d1, implicit $fpcr
    renamable $d7 = LDRDui renamable $x0, 0 :: (load (s64))
    STRDui renamable $d7, renamable $x1, 0 :: (store (s64))
    STRDui renamable $d3, renamable $x2, 0 :: (store (s64))
    RET_ReallyLR
...
