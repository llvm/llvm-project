; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mcpu=apple-m1 -verify-machineinstrs < %s | FileCheck %s
;
; Reading zero bits must not add speculative shifts and selects to the
; loop-carried consumed-bits dependency when the branch is strongly biased.

target triple = "aarch64-unknown-linux-gnu"

define i32 @decode_bits(ptr %counts, i64 %count, i64 %bits, i32 %initial, ptr %out) nounwind {
; CHECK-LABEL: decode_bits:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    // kill: def $w3 killed $w3 def $x3
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldrb w9, [x0], #1
; CHECK-NEXT:    cbnz w9, .LBB0_4
; CHECK-NEXT:  // %bb.2: // in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    mov x8, #0 // =0x0
; CHECK-NEXT:  .LBB0_3: // %merge
; CHECK-NEXT:    // in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    str x8, [x4], #8
; CHECK-NEXT:    subs x1, x1, #1
; CHECK-NEXT:    b.ne .LBB0_1
; CHECK-NEXT:    b .LBB0_5
; CHECK-NEXT:  .LBB0_4: // %read
; CHECK-NEXT:    // in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    lsl x8, x2, x3
; CHECK-NEXT:    neg w10, w9
; CHECK-NEXT:    lsr x8, x8, x10
; CHECK-NEXT:    add w3, w3, w9
; CHECK-NEXT:    b .LBB0_3
; CHECK-NEXT:  .LBB0_5: // %exit
; CHECK-NEXT:    mov x0, x3
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i64 [0, %entry], [%nexti, %merge]
  %consumed = phi i32 [%initial, %entry], [%nextconsumed, %merge]
  %p = getelementptr i8, ptr %counts, i64 %i
  %n8 = load i8, ptr %p
  %zero = icmp eq i8 %n8, 0
  br i1 %zero, label %merge, label %read, !prof !0
read:
  %n = zext i8 %n8 to i32
  %start = and i32 %consumed, 63
  %start64 = zext i32 %start to i64
  %shifted = shl i64 %bits, %start64
  %neg = sub i32 0, %n
  %shift = and i32 %neg, 63
  %shift64 = zext i32 %shift to i64
  %value = lshr i64 %shifted, %shift64
  %added = add i32 %consumed, %n
  br label %merge
merge:
  %result = phi i64 [0, %loop], [%value, %read]
  %nextconsumed = phi i32 [%consumed, %loop], [%added, %read]
  %op = getelementptr i64, ptr %out, i64 %i
  store i64 %result, ptr %op
  %nexti = add i64 %i, 1
  %done = icmp eq i64 %nexti, %count
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %nextconsumed
}

define i32 @decode_bits_balanced(ptr %counts, i64 %count, i64 %bits, i32 %initial, ptr %out) nounwind {
; CHECK-LABEL: decode_bits_balanced:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    // kill: def $w3 killed $w3 def $x3
; CHECK-NEXT:  .LBB1_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldrb w8, [x0], #1
; CHECK-NEXT:    lsl x9, x2, x3
; CHECK-NEXT:    neg w10, w8
; CHECK-NEXT:    lsr x9, x9, x10
; CHECK-NEXT:    add w10, w3, w8
; CHECK-NEXT:    .p2align 6, , 4
; CHECK-NEXT:  // %bb.2: // %loop
; CHECK-NEXT:    // in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    cmp w8, #0
; CHECK-NEXT:    csel w3, w3, w10, eq
; CHECK-NEXT:    csel x8, xzr, x9, eq
; CHECK-NEXT:    str x8, [x4], #8
; CHECK-NEXT:    subs x1, x1, #1
; CHECK-NEXT:    b.ne .LBB1_1
; CHECK-NEXT:  // %bb.3: // %exit
; CHECK-NEXT:    mov x0, x3
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i64 [0, %entry], [%nexti, %merge]
  %consumed = phi i32 [%initial, %entry], [%nextconsumed, %merge]
  %p = getelementptr i8, ptr %counts, i64 %i
  %n8 = load i8, ptr %p
  %zero = icmp eq i8 %n8, 0
  br i1 %zero, label %merge, label %read, !prof !1
read:
  %n = zext i8 %n8 to i32
  %start = and i32 %consumed, 63
  %start64 = zext i32 %start to i64
  %shifted = shl i64 %bits, %start64
  %neg = sub i32 0, %n
  %shift = and i32 %neg, 63
  %shift64 = zext i32 %shift to i64
  %value = lshr i64 %shifted, %shift64
  %added = add i32 %consumed, %n
  br label %merge
merge:
  %result = phi i64 [0, %loop], [%value, %read]
  %nextconsumed = phi i32 [%consumed, %loop], [%added, %read]
  %op = getelementptr i64, ptr %out, i64 %i
  store i64 %result, ptr %op
  %nexti = add i64 %i, 1
  %done = icmp eq i64 %nexti, %count
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %nextconsumed
}

!0 = !{!"branch_weights", i32 2000, i32 1}
!1 = !{!"branch_weights", i32 1, i32 1}
