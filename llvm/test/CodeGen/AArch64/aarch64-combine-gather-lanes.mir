    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr64common = COPY $x0
    ; CHECK-NEXT: [[LDRQui:%[0-9]+]]:fpr128 = LDRQui $x1, 0
    ; CHECK-NEXT: [[LD1i32_:%[0-9]+]]:fpr128 = LD1i32 [[LDRQui]], 3, [[COPY]]
    ; CHECK-NEXT: $q0 = COPY [[LD1i32_]]
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
