define <vscale x 8 x bfloat> @bfmla_z(<vscale x 8 x i1> %pg, <vscale x 8 x bfloat> %a, <vscale x 8 x bfloat> %b, <vscale x 8 x bfloat> %c){
; STREAMING-LABEL: bfmla_z:
; STREAMING:       // %bb.0:
; STREAMING-NEXT:    mov z3.h, #0 // =0x0
; STREAMING-NEXT:    sel z0.h, p0, z0.h, z3.h
; STREAMING-NEXT:    bfmla z0.h, p0/m, z1.h, z2.h
; STREAMING-NEXT:    ret
;
; NONSTREAMING-LABEL: bfmla_z:
; NONSTREAMING:       // %bb.0:
; NONSTREAMING-NEXT:    movi v3.2d, #0000000000000000
; NONSTREAMING-NEXT:    sel z0.h, p0, z0.h, z3.h
