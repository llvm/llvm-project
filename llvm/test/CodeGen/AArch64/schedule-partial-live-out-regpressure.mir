# RUN: llc -mtriple=aarch64 -run-pass=machine-scheduler -misched=converge \
# RUN:   -misched-regpressure=true -misched-track-lane-masks=true -enable-subreg-liveness=false \
# RUN:   -verify-machineinstrs -debug-only=machine-scheduler %s -filetype=null 2>&1 | FileCheck %s
# RUN: llc -mtriple=aarch64 -run-pass=machine-scheduler -misched=converge \
# RUN:   -misched-regpressure=true -misched-track-lane-masks=true -enable-subreg-liveness=true \
# RUN:   -verify-machineinstrs -debug-only=machine-scheduler %s -filetype=null 2>&1 | FileCheck %s
# REQUIRES: asserts

# Check that overwriting dsub0 while dsub1 remains live does not assert or
# double-count register pressure. Disable subregister liveness to reproduce
# the failure; otherwise the overwritten definition is recognized as dead.

# CHECK: GenericScheduler RegionPolicy:  ShouldTrackPressure=1
# CHECK: Scheduling SU({{[0-9]+}}) %0.dsub0:dd = FMOVDi 2
# CHECK-NEXT: Bottom Pressure:{{.*}} FPR8=2{{( |$)}}
# CHECK: Scheduling SU({{[0-9]+}}) %0.dsub0:dd = FMOVDi 1
# CHECK-NEXT: Bottom Pressure:{{.*}} FPR8=2{{( |$)}}
# CHECK: Scheduling SU({{[0-9]+}}) %0:dd = IMPLICIT_DEF
# CHECK-NEXT: Bottom Pressure: {{$}}

---
name: partial_live_out
tracksRegLiveness: true
body: |
  bb.0:
    %0:dd = IMPLICIT_DEF
    %0.dsub0:dd = FMOVDi 1
    %0.dsub0:dd = FMOVDi 2
    $d0_d1 = COPY %0
    RET_ReallyLR
...
