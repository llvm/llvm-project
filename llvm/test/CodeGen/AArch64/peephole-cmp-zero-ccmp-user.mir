    %2:gpr32 = COPY $w2
    %3:gpr32common = nsw ADDWrr %0, %1
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    CCMPWi %2, 7, 8, 10, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...
---
# HS reads C, which ANDS does not compute the way a compare with zero does.
name:            keep_cmp_when_ccmp_reads_carry
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1, $w2
    ; CHECK-LABEL: name: keep_cmp_when_ccmp_reads_carry
    ; CHECK: liveins: $w0, $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $w2
    ; CHECK-NEXT: [[ANDWrr:%[0-9]+]]:gpr32common = ANDWrr [[COPY]], [[COPY1]]
    ; CHECK-NEXT: dead [[SUBSWri:%[0-9]+]]:gpr32 = SUBSWri [[ANDWrr]], 0, 0, implicit-def $nzcv
    ; CHECK-NEXT: CCMPWi [[COPY2]], 7, 4, 2, implicit-def $nzcv, implicit $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr]], [[ANDWrr]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = COPY $w2
    %3:gpr32common = ANDWrr %0, %1
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    CCMPWi %2, 7, 4, 2, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...
---
# GE reads V, and without nsw the add may overflow.
