    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $w2
    ; CHECK-NEXT: [[ANDSWri:%[0-9]+]]:gpr32common = ANDSWri [[COPY]], 7, implicit-def $nzcv
    ; CHECK-NEXT: CCMPWr [[COPY1]], [[COPY2]], 0, 0, implicit-def $nzcv, implicit $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr]], [[ANDSWri]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = COPY $w2
    %3:gpr32common = ANDWri %0, 7
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    CCMPWr %1, %2, 0, 0, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
