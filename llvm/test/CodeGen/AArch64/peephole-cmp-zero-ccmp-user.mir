    %2:gpr32 = COPY $w2
    %3:gpr32common = ADDWrr %0, %1
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    CCMPWi %2, 7, 8, 10, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
