---
# The compare of a CSINC result with zero goes away and the conditional
# compare tests the CSINC's flags directly with the inverted condition.
name:            remove_cmp_after_csinc_ccmp
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: remove_cmp_after_csinc_ccmp
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32common = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: dead [[SUBSWri:%[0-9]+]]:gpr32 = SUBSWri [[COPY]], 3, 0, implicit-def $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32common = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: CCMPWi [[COPY1]], 7, 4, 1, implicit-def $nzcv, implicit $nzcv
    ; CHECK-NEXT: [[CSINCWr1:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr1]], [[CSINCWr]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32common = COPY $w0
    %1:gpr32 = COPY $w1
    dead %2:gpr32 = SUBSWri %0, 3, 0, implicit-def $nzcv
    %3:gpr32common = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    CCMPWi %1, 7, 4, 0, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...
