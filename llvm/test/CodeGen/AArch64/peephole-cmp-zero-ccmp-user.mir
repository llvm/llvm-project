    CCMNXi %2, 5, 8, 0, implicit-def $nzcv, implicit $nzcv
    %5:gpr64 = CSINCXr $xzr, $xzr, 1, implicit $nzcv
    %6:gpr64 = ADDXrr %5, %3
    $x0 = COPY %6
    RET_ReallyLR implicit $x0
...
