# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -passes=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s
#
# A compare with zero whose flags are consumed by a conditional compare
# (CCMP, CCMN, FCCMP) can be folded into the flag-setting form of the
# instruction defining the compared register, or removed after a CSINC, just
# as when the consumer is a branch or a select. The conditional compare reads
# NZCV through its condition code operand and then defines a new NZCV value.

---
name:            ands_from_and_rr_ccmp_wi
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1, $w2
    ; CHECK-LABEL: name: ands_from_and_rr_ccmp_wi
    ; CHECK: liveins: $w0, $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $w2
    ; CHECK-NEXT: [[ANDSWrr:%[0-9]+]]:gpr32common = ANDSWrr [[COPY]], [[COPY1]], implicit-def $nzcv
    ; CHECK-NEXT: CCMPWi [[COPY2]], 7, 4, 1, implicit-def $nzcv, implicit $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr]], [[ANDSWrr]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = COPY $w2
    %3:gpr32common = ANDWrr %0, %1
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    CCMPWi %2, 7, 4, 1, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...
---
