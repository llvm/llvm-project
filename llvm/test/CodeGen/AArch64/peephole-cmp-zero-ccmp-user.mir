tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $s0, $s1
    ; CHECK-LABEL: name: subs_from_sub_ri_fccmp
    ; CHECK: liveins: $w0, $s0, $s1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32common = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr32 = COPY $s0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fpr32 = COPY $s1
    ; CHECK-NEXT: [[SUBSWri:%[0-9]+]]:gpr32common = SUBSWri [[COPY]], 1, 0, implicit-def $nzcv
    ; CHECK-NEXT: FCCMPSrr [[COPY1]], [[COPY2]], 0, 1, implicit-def $nzcv, implicit $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr]], [[SUBSWri]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32common = COPY $w0
    %1:fpr32 = COPY $s0
    %2:fpr32 = COPY $s1
    %3:gpr32common = SUBWri %0, 1, 0
    dead %4:gpr32 = SUBSWri %3, 0, 0, implicit-def $nzcv
    FCCMPSrr %1, %2, 0, 1, implicit-def $nzcv, implicit $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    %6:gpr32 = ADDWrr %5, %3
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...
---
# GE reads N and V; V from ADDS is only usable because the add is nsw.
name:            adds_from_add_nsw_ccmp_ge
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $w1, $w2
    ; CHECK-LABEL: name: adds_from_add_nsw_ccmp_ge
    ; CHECK: liveins: $w0, $w1, $w2
    ; CHECK-NEXT: {{  $}}
