; Unpacked types keep their elements in wider lanes, so the lookup happens in
; the container element width.

define <vscale x 2 x i32> @shuffle_nxv2i32(<vscale x 2 x i32> %v, <vscale x 2 x i32> %mask) {
; CHECK-LABEL: shuffle_nxv2i32:
; CHECK:       // %bb.0:
; CHECK-NEXT:    and z1.d, z1.d, #0xffffffff
; CHECK-NEXT:    tbl z0.d, { z0.d }, z1.d
; CHECK-NEXT:    ret
  %res = call <vscale x 2 x i32> @llvm.vector.shuffle.nxv2i32.nxv2i32(<vscale x 2 x i32> %v, <vscale x 2 x i32> %mask)
  ret <vscale x 2 x i32> %res
}

