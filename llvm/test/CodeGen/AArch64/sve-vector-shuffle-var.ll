; RUN: llc -mtriple=aarch64-none-linux-gnu -mattr=+sve,+bf16 < %s | FileCheck %s

; SVE TBL takes a run-time index vector of the data element width, so a
; scalable dynamic shuffle is a single instruction.

define <vscale x 16 x i8> @shuffle_nxv16i8(<vscale x 16 x i8> %v, <vscale x 16 x i8> %mask) {
; CHECK-LABEL: shuffle_nxv16i8:
; CHECK:       // %bb.0:
; CHECK-NEXT:    tbl z0.b, { z0.b }, z1.b
; CHECK-NEXT:    ret
  %res = call <vscale x 16 x i8> @llvm.vector.shuffle.nxv16i8.nxv16i8(<vscale x 16 x i8> %v, <vscale x 16 x i8> %mask)
  ret <vscale x 16 x i8> %res
}

