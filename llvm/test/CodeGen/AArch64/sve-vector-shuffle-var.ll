  ret <vscale x 4 x i32> %res
}

; Wider than one SVE register: split into two tbls per half plus a per-lane
; select on which source half the index falls in.

define <vscale x 8 x i32> @shuffle_nxv8i32(<vscale x 8 x i32> %v, <vscale x 8 x i32> %mask) {
; CHECK-LABEL: shuffle_nxv8i32:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cntw x8
; CHECK-NEXT:    ptrue p0.s
; CHECK-NEXT:    tbl z5.s, { z0.s }, z2.s
; CHECK-NEXT:    mov z4.s, w8
; CHECK-NEXT:    cmphi p1.s, p0/z, z4.s, z2.s
; CHECK-NEXT:    decw z2.s
; CHECK-NEXT:    cmphi p2.s, p0/z, z4.s, z3.s
; CHECK-NEXT:    tbl z4.s, { z0.s }, z3.s
; CHECK-NEXT:    decw z3.s
; CHECK-NEXT:    tbl z0.s, { z1.s }, z2.s
; CHECK-NEXT:    tbl z1.s, { z1.s }, z3.s
; CHECK-NEXT:    mov z0.s, p1/m, z5.s
; CHECK-NEXT:    mov z1.s, p2/m, z4.s
; CHECK-NEXT:    ret
  %res = call <vscale x 8 x i32> @llvm.vector.shuffle.nxv8i32.nxv8i32(<vscale x 8 x i32> %v, <vscale x 8 x i32> %mask)
  ret <vscale x 8 x i32> %res
}
