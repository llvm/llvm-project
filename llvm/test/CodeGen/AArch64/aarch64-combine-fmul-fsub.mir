# RUN: llc -run-pass=machine-combiner -o - -mtriple=aarch64-unknown-linux -mcpu=cortex-a57 -machine-combiner-verify-pattern-order=true %s | FileCheck --check-prefixes=UNPROFITABLE,ALL %s
# RUN: llc -run-pass=machine-combiner -o - -mtriple=aarch64-unknown-linux -mcpu=falkor %s -machine-combiner-verify-pattern-order=true | FileCheck --check-prefixes=PROFITABLE,ALL %s
# RUN: llc -run-pass=machine-combiner -o - -mtriple=aarch64-unknown-linux -mcpu=exynos-m3 -machine-combiner-verify-pattern-order=true %s | FileCheck --check-prefixes=PROFITABLE,ALL %s
# RUN: llc -run-pass=machine-combiner -o - -mtriple=aarch64-unknown-linux -mcpu=thunderx2t99 -machine-combiner-verify-pattern-order=true %s | FileCheck --check-prefixes=PROFITABLE,ALL %s
# RUN: llc -run-pass=machine-combiner -o - -mtriple=aarch64-unknown-linux -mcpu=thunderx3t110 -machine-combiner-verify-pattern-order=true %s | FileCheck --check-prefixes=PROFITABLE,ALL %s
#
name:            f1_2s
body:             |
  bb.0.entry:
    liveins: $d0, $d1, $d2
    %2:fpr64 = COPY $d2
    %1:fpr64 = COPY $d1
    %0:fpr64 = COPY $d0
    %3:fpr64 = contract FMULv2f32 %0, %1, implicit $fpcr
    %4:fpr64 = contract FSUBv2f32 %3, %2, implicit $fpcr
    $d0 = COPY %4
    RET_ReallyLR implicit $d0

...
# UNPROFITABLE-LABEL: name: f1_2s
# UNPROFITABLE: [[R1:%[0-9]+]]:fpr64 = contract FNEGv2f32 %0
# UNPROFITABLE-NEXT: FMLAv2f32 [[R1]], %2, %1, implicit $fpcr
#
# PROFITABLE-LABEL: name: f1_2s
# PROFITABLE: [[R1:%[0-9]+]]:fpr64 = contract FNEGv2f32 %0
# PROFITABLE-NEXT: FMLAv2f32 [[R1]], %2, %1, implicit $fpcr
---
name:            f1_4s
body:             |
  bb.0.entry:
    liveins: $q0, $q1, $q2
    %2:fpr128 = COPY $q2
    %1:fpr128 = COPY $q1
    %0:fpr128 = COPY $q0
    %3:fpr128 = contract FMULv4f32 %0, %1, implicit $fpcr
    %4:fpr128 = contract FSUBv4f32 %3, %2, implicit $fpcr
    $q0 = COPY %4
    RET_ReallyLR implicit $q0

...
# UNPROFITABLE-LABEL: name: f1_4s
# UNPROFITABLE: [[R1:%[0-9]+]]:fpr128 = contract FMULv4f32 %2, %1, implicit $fpcr
# UNPROFITABLE-NEXT: FSUBv4f32 [[R1]], %0, implicit $fpcr
#
# PROFITABLE-LABEL: name: f1_4s
# PROFITABLE: [[R1:%[0-9]+]]:fpr128 = contract FNEGv4f32 %0
# PROFITABLE-NEXT: FMLAv4f32 [[R1]], %2, %1, implicit $fpcr
---
name:            f1_2d
body:             |
  bb.0.entry:
    liveins: $q0, $q1, $q2
    %2:fpr128 = COPY $q2
    %1:fpr128 = COPY $q1
    %0:fpr128 = COPY $q0
    %3:fpr128 = contract FMULv2f64 %0, %1, implicit $fpcr
    %4:fpr128 = contract FSUBv2f64 %3, %2, implicit $fpcr
    $q0 = COPY %4
    RET_ReallyLR implicit $q0

...
# UNPROFITABLE-LABEL: name: f1_2d
# UNPROFITABLE: %3:fpr128 = contract FMULv2f64 %2, %1, implicit $fpcr
# UNPROFITABLE-NEXT: FSUBv2f64 %3, %0, implicit $fpcr
#
# PROFITABLE-LABEL: name: f1_2d
# PROFITABLE: [[R1:%[0-9]+]]:fpr128 = contract FNEGv2f64 %0
# PROFITABLE-NEXT: FMLAv2f64 [[R1]], %2, %1, implicit $fpcr
---
name:            f1_both_fmul_2s
body:             |
  bb.0.entry:
    liveins: $d0, $d1, $d2, $d3
    %3:fpr64 = COPY $d3
    %2:fpr64 = COPY $d2
    %1:fpr64 = COPY $d1
    %0:fpr64 = COPY $d0
    %4:fpr64 = contract FMULv2f32 %0, %1, implicit $fpcr
    %5:fpr64 = contract FMULv2f32 %2, %3, implicit $fpcr
    %6:fpr64 = contract FSUBv2f32 %4, %5, implicit $fpcr
    $d0 = COPY %6
    RET_ReallyLR implicit $d0

...
# ALL-LABEL: name: f1_both_fmul_2s
# ALL: %4:fpr64 = contract FMULv2f32 %3, %2, implicit $fpcr
# ALL-NEXT: FMLSv2f32 %4, %1, %0, implicit $fpcr
---
name:            f1_both_fmul_4s
body:             |
  bb.0.entry:
    liveins: $q0, $q1, $q2, $q3
    %3:fpr128 = COPY $q3
    %2:fpr128 = COPY $q2
    %1:fpr128 = COPY $q1
    %0:fpr128 = COPY $q0
    %4:fpr128 = contract FMULv4f32 %0, %1, implicit $fpcr
    %5:fpr128 = contract FMULv4f32 %2, %3, implicit $fpcr
    %6:fpr128 = contract FSUBv4f32 %4, %5, implicit $fpcr
    $q0 = COPY %6
    RET_ReallyLR implicit $q0

...
# ALL-LABEL: name: f1_both_fmul_4s
# ALL: %4:fpr128 = contract FMULv4f32 %3, %2, implicit $fpcr
# ALL-NEXT: FMLSv4f32 %4, %1, %0, implicit $fpcr
---
name:            f1_both_fmul_2d
body:             |
  bb.0.entry:
    liveins: $q0, $q1, $q2, $q3
    %3:fpr128 = COPY $q3
    %2:fpr128 = COPY $q2
    %1:fpr128 = COPY $q1
    %0:fpr128 = COPY $q0
    %4:fpr128 = contract FMULv2f64 %0, %1, implicit $fpcr
    %5:fpr128 = contract FMULv2f64 %2, %3, implicit $fpcr
    %6:fpr128 = contract FSUBv2f64 %4, %5, implicit $fpcr
    $q0 = COPY %6
    RET_ReallyLR implicit $q0

...
# ALL-LABEL: name: f1_both_fmul_2d
# ALL: %4:fpr128 = contract FMULv2f64 %3, %2, implicit $fpcr
# ALL-NEXT: FMLSv2f64 %4, %1, %0, implicit $fpcr

