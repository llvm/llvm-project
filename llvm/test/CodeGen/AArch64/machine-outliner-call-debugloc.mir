# RUN: llc -mtriple=aarch64-apple-darwin -run-pass=prolog-epilog \
# RUN:   -run-pass=machine-outliner -verify-machineinstrs %s -o - | FileCheck %s

# Each call replacing an outlined sequence takes the first source location from
# the sequence it replaces. Any link register save/restore the target inserts
# around that call takes the same location, so that the call site does not
# begin with a line 0 address.

# The link register is dead here, so the call needs no save/restore.
# CHECK-LABEL: name: caller
# CHECK:       BL @callee0
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 10,
# CHECK:       BL @callee1
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 20,
# CHECK:       BL @callee2
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 30,
# CHECK:       BL @callee3
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 40,
# CHECK:       BL @callee4
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}
# CHECK-SAME:  implicit $sp{{$}}

# The link register is live, but a callee-saved register is free, so it is
# saved to that register around the call.
# CHECK-LABEL: name: reg_save
# CHECK:       $x[[REG:[0-9]+]] = ORRXrs $xzr, $lr, 0, debug-location !DILocation(line: 11,
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 11,
# CHECK-NEXT:  $lr = ORRXrs $xzr, $x[[REG]], 0, debug-location !DILocation(line: 11,
# CHECK:       $x[[REG]] = ORRXrs $xzr, $lr, 0, debug-location !DILocation(line: 22,
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 22,
# CHECK-NEXT:  $lr = ORRXrs $xzr, $x[[REG]], 0, debug-location !DILocation(line: 22,

# No register is free, so the link register is saved to the stack instead.
# CHECK-LABEL: name: stack_save
# CHECK:       early-clobber $sp = STRXpre $lr, $sp, -16, debug-location !DILocation(line: 111,
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 111,
# CHECK-NEXT:  early-clobber $sp, $lr = LDRXpost $sp, 16, debug-location !DILocation(line: 111,
# CHECK:       early-clobber $sp = STRXpre $lr, $sp, -16, debug-location !DILocation(line: 222,
# CHECK-NEXT:  BL @OUTLINED_FUNCTION_{{[0-9]+}}{{.*}}debug-location !DILocation(line: 222,
# CHECK-NEXT:  early-clobber $sp, $lr = LDRXpost $sp, 16, debug-location !DILocation(line: 222,

--- |
  target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64--"

  declare void @callee0()
  declare void @callee1()
  declare void @callee2()
  declare void @callee3()
  declare void @callee4()

  define void @caller() #0 !dbg !6 {
    ret void
  }

  define void @reg_save() #0 !dbg !20 {
    ret void
  }

  define void @stack_save() #0 !dbg !30 {
    ret void
  }

  attributes #0 = { minsize noredzone nounwind }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.c", directory: "/tmp")
  !2 = !{}
  !3 = !{i32 7, !"Dwarf Version", i32 4}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = !DISubroutineType(types: !2)
  !6 = distinct !DISubprogram(name: "caller", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !7 = !DILocation(line: 9, column: 1, scope: !6)
  !8 = !DILocation(line: 10, column: 1, scope: !6)
  !9 = !DILocation(line: 19, column: 1, scope: !6)
  !10 = !DILocation(line: 20, column: 1, scope: !6)
  !11 = !DILocation(line: 29, column: 1, scope: !6)
  !12 = !DILocation(line: 30, column: 1, scope: !6)
  !13 = !DILocation(line: 39, column: 1, scope: !6)
  !14 = !DILocation(line: 40, column: 1, scope: !6)
  !20 = distinct !DISubprogram(name: "reg_save", scope: !1, file: !1, line: 10, type: !5, scopeLine: 10, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !21 = !DILocation(line: 11, column: 1, scope: !20)
  !22 = !DILocation(line: 22, column: 1, scope: !20)
  !23 = !DILocation(line: 33, column: 1, scope: !20)
  !24 = !DILocation(line: 44, column: 1, scope: !20)
  !30 = distinct !DISubprogram(name: "stack_save", scope: !1, file: !1, line: 100, type: !5, scopeLine: 100, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !31 = !DILocation(line: 111, column: 1, scope: !30)
  !32 = !DILocation(line: 222, column: 1, scope: !30)
  !33 = !DILocation(line: 333, column: 1, scope: !30)

...
---
name:            caller
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $lr

    BL @callee0, implicit-def dead $lr, implicit $sp, debug-location !7
    $w0 = ORRWri $wzr, 1, debug-location !8
    $w1 = ORRWri $wzr, 2, debug-location !8
    $w2 = ORRWri $wzr, 3

    BL @callee1, implicit-def dead $lr, implicit $sp, debug-location !9
    $w0 = ORRWri $wzr, 1, debug-location !10
    $w1 = ORRWri $wzr, 2, debug-location !10
    $w2 = ORRWri $wzr, 4

    BL @callee2, implicit-def dead $lr, implicit $sp, debug-location !11
    $w0 = ORRWri $wzr, 1, debug-location !12
    $w1 = ORRWri $wzr, 2, debug-location !12
    $w2 = ORRWri $wzr, 5

    BL @callee3, implicit-def dead $lr, implicit $sp, debug-location !13
    $w0 = ORRWri $wzr, 1, debug-location !14
    $w1 = ORRWri $wzr, 2, debug-location !14
    $w2 = ORRWri $wzr, 6

    BL @callee4, implicit-def dead $lr, implicit $sp
    $w0 = ORRWri $wzr, 1
    $w1 = ORRWri $wzr, 2
    $w2 = ORRWri $wzr, 7

    RET undef $lr
...
---
name:            reg_save
tracksRegLiveness: true
body:             |
  bb.0:
    $x9 = ORRXri $xzr, 1
    $lr = ORRXri $xzr, 1
  bb.1:
    liveins: $lr, $w9
    $w9 = ORRWri $wzr, 1, debug-location !21
    $w9 = ORRWri $wzr, 1, debug-location !21
    $w9 = ORRWri $wzr, 1, debug-location !21
    $w9 = ORRWri $wzr, 1, debug-location !21
    $w9 = ORRWri $wzr, 1, debug-location !21
    $w9 = ORRWri $wzr, 2, debug-location !21
  bb.2:
    liveins: $lr, $w9
    $w9 = ORRWri $wzr, 1, debug-location !22
    $w9 = ORRWri $wzr, 1, debug-location !22
    $w9 = ORRWri $wzr, 1, debug-location !22
    $w9 = ORRWri $wzr, 1, debug-location !22
    $w9 = ORRWri $wzr, 1, debug-location !22
    $w9 = ORRWri $wzr, 2, debug-location !22
  bb.3:
    liveins: $lr, $w9
    $w9 = ORRWri $wzr, 1, debug-location !23
    $w9 = ORRWri $wzr, 1, debug-location !23
    $w9 = ORRWri $wzr, 1, debug-location !23
    $w9 = ORRWri $wzr, 1, debug-location !23
    $w9 = ORRWri $wzr, 1, debug-location !23
    $w9 = ORRWri $wzr, 2, debug-location !23
  bb.4:
    liveins: $lr, $w9
    $w9 = ORRWri $wzr, 1, debug-location !24
    $w9 = ORRWri $wzr, 1, debug-location !24
    $w9 = ORRWri $wzr, 1, debug-location !24
    $w9 = ORRWri $wzr, 1, debug-location !24
    $w9 = ORRWri $wzr, 1, debug-location !24
    $w9 = ORRWri $wzr, 2, debug-location !24
  bb.5:
    liveins: $w9
    RET undef $lr
...
---
name:            stack_save
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x19, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28
    $lr = ORRXri $xzr, 1
    $w10 = ORRWri $wzr, 1, debug-location !31
    $w10 = ORRWri $wzr, 1, debug-location !31
    $w10 = ORRWri $wzr, 1, debug-location !31
    $w10 = ORRWri $wzr, 1, debug-location !31
    $w10 = ORRWri $wzr, 1, debug-location !31
    $w12 = ORRWri $wzr, 2, debug-location !31
  bb.1:
    liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x19, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28
    $w10 = ORRWri $wzr, 1, debug-location !32
    $w10 = ORRWri $wzr, 1, debug-location !32
    $w10 = ORRWri $wzr, 1, debug-location !32
    $w10 = ORRWri $wzr, 1, debug-location !32
    $w10 = ORRWri $wzr, 1, debug-location !32
    $w12 = ORRWri $wzr, 2, debug-location !32
  bb.2:
    liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x19, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28
    $w10 = ORRWri $wzr, 1, debug-location !33
    $w10 = ORRWri $wzr, 1, debug-location !33
    $w10 = ORRWri $wzr, 1, debug-location !33
    $w10 = ORRWri $wzr, 1, debug-location !33
    $w10 = ORRWri $wzr, 1, debug-location !33
    $w12 = ORRWri $wzr, 2, debug-location !33
  bb.3:
    liveins: $lr, $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x15, $x19, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28
    RET undef $lr
...
