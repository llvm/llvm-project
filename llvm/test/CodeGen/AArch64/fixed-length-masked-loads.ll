; CHECK-NEXT:    ldp q0, q1, [x1]
; CHECK-NEXT:    ptrue p0.s, vl4
; CHECK-NEXT:    mov x8, #4 // =0x4
; CHECK-NEXT:    fcmeq v1.4s, v1.4s, #0.0
; CHECK-NEXT:    fcmeq v0.4s, v0.4s, #0.0
; CHECK-NEXT:    cmpne p1.s, p0/z, z1.s, #0
; CHECK-NEXT:    cmpne p2.s, p0/z, z0.s, #0
; CHECK-NEXT:    ld1w { z0.s }, p2/z, [x0]
; CHECK-NEXT:    ld1w { z1.s }, p1/z, [x0, x8, lsl #2]
; CHECK-NEXT:    // kill: def $q0 killed $q0 killed $z0
; CHECK-NEXT:    // kill: def $q1 killed $q1 killed $z1
; CHECK-NEXT:    ret
  %mask = load <8 x float>, ptr %maskp
  %cmp = fcmp oeq <8 x float> %mask, splat (float zeroinitializer)
  %load = call <8 x float> @llvm.masked.load.v8f32(ptr %src, i32 4, <8 x i1> %cmp, <8 x float> zeroinitializer)
  ret <8 x float> %load
}

