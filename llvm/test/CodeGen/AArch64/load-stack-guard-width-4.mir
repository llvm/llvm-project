# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64-unknown-linux-gnu -run-pass=post-ra-pseudos -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64-unknown-linux-gnu -code-model=large -run-pass=post-ra-pseudos -verify-machineinstrs %s -o - | FileCheck -check-prefix=LARGE %s

# The 32-bit guard load defines the full 64-bit register, so the 32-bit def
# must not be dead.

--- |
  @guard_local = external dso_local global ptr
  @guard_got = external global ptr

  define void @load_stack_guard_local() {
    ret void
  }

  define void @load_stack_guard_got() {
    ret void
  }

  !llvm.module.flags = !{!0}
  !0 = !{i32 1, !"stack-protector-guard-value-width", i32 4}
...
---
name: load_stack_guard_local
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: load_stack_guard_local
    ; CHECK: $x8 = ADRP target-flags(aarch64-page) @guard_local
    ; CHECK-NEXT: $w8 = LDRWui killed $x8, target-flags(aarch64-pageoff, aarch64-nc) @guard_local, implicit-def $x8 :: (dereferenceable invariant load (s32) from @guard_local)
    ; CHECK-NEXT: RET_ReallyLR implicit $x8
    ;
    ; LARGE-LABEL: name: load_stack_guard_local
    ; LARGE: $x8 = MOVZXi target-flags(aarch64-g0, aarch64-nc) @guard_local, 0
    ; LARGE-NEXT: $x8 = MOVKXi killed $x8, target-flags(aarch64-g1, aarch64-nc) @guard_local, 16
    ; LARGE-NEXT: $x8 = MOVKXi killed $x8, target-flags(aarch64-g2, aarch64-nc) @guard_local, 32
    ; LARGE-NEXT: $x8 = MOVKXi killed $x8, target-flags(aarch64-g3) @guard_local, 48
    ; LARGE-NEXT: $w8 = LDRWui killed $x8, 0, implicit-def $x8 :: (dereferenceable invariant load (s32) from @guard_local)
    ; LARGE-NEXT: RET_ReallyLR implicit $x8
    $x8 = LOAD_STACK_GUARD :: (dereferenceable invariant load (s32) from @guard_local)
    RET_ReallyLR implicit $x8
...
---
name: load_stack_guard_got
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: load_stack_guard_got
    ; CHECK: $x8 = LOADgot target-flags(aarch64-got) @guard_got
    ; CHECK-NEXT: $w8 = LDRWui killed $x8, 0, implicit-def $x8 :: (dereferenceable invariant load (s32) from @guard_got)
    ; CHECK-NEXT: RET_ReallyLR implicit $x8
    ;
    ; LARGE-LABEL: name: load_stack_guard_got
    ; LARGE: $x8 = LOADgot target-flags(aarch64-got) @guard_got
    ; LARGE-NEXT: $w8 = LDRWui killed $x8, 0, implicit-def $x8 :: (dereferenceable invariant load (s32) from @guard_got)
    ; LARGE-NEXT: RET_ReallyLR implicit $x8
    $x8 = LOAD_STACK_GUARD :: (dereferenceable invariant load (s32) from @guard_got)
    RET_ReallyLR implicit $x8
...
