  %r = icmp eq i64 %m, 9218868437227405312
  ret i1 %r
}

; The mask is not one run of bits.
define i1 @split_mask(i32 %x) {
; CHECK-LABEL: split_mask:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov w8, #61455 // =0xf00f
; CHECK-NEXT:    mov w9, #4099 // =0x1003
; CHECK-NEXT:    and w8, w0, w8
; CHECK-NEXT:    cmp w8, w9
; CHECK-NEXT:    cset w0, eq
; CHECK-NEXT:    ret
  %m = and i32 %x, 61455
  %r = icmp eq i32 %m, 4099
  ret i1 %r
}

; The masked value has another use, so the AND stays either way.
define i32 @multi_use(i32 %c) {
; CHECK-LABEL: multi_use:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov w8, #55296 // =0xd800
; CHECK-NEXT:    and w9, w0, #0xfc00
; CHECK-NEXT:    cmp w9, w8
; CHECK-NEXT:    csel w0, w9, wzr, eq
; CHECK-NEXT:    ret
  %m = and i32 %c, 64512
  %r = icmp eq i32 %m, 55296
  %s = select i1 %r, i32 %m, i32 0
  ret i32 %s
}
