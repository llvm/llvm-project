  br i1 %r, label %t, label %f
t:
  ret i32 %a
f:
  ret i32 %b
}

; The mask reaches the top bit: a plain shift suffices.
define i1 @high_mask(i32 %x) {
; CHECK-LABEL: high_mask:
; CHECK:       // %bb.0:
; CHECK-NEXT:    lsr w8, w0, #30
; CHECK-NEXT:    cmp w8, #2
; CHECK-NEXT:    cset w0, eq
; CHECK-NEXT:    ret
  %m = and i32 %x, -1073741824
  %r = icmp eq i32 %m, -2147483648
  ret i1 %r
}

; The constant already fits a compare immediate: nothing to gain.
define i1 @imm_fits(i32 %x) {
; CHECK-LABEL: imm_fits:
; CHECK:       // %bb.0:
; CHECK-NEXT:    and w8, w0, #0xf0
; CHECK-NEXT:    cmp w8, #48
; CHECK-NEXT:    cset w0, eq
; CHECK-NEXT:    ret
  %m = and i32 %x, 240
  %r = icmp eq i32 %m, 48
  ret i1 %r
}

; The shifted constant still does not fit.
define i1 @shifted_too_big(i64 %x) {
; CHECK-LABEL: shifted_too_big:
