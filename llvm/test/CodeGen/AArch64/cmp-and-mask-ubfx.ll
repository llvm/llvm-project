; CHECK-NEXT:    ubfx x8, x0, #10, #8
; CHECK-NEXT:    cmp x8, #217
; CHECK-NEXT:    cset w0, eq
; CHECK-NEXT:    ret
  %m = and i64 %x, 261120
  %r = icmp eq i64 %m, 222208
  ret i1 %r
}

; The shifted constant uses the 12-bit immediate's shifted form.
define i1 @shifted_imm12(i64 %x) {
