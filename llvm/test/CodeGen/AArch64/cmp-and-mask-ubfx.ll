; RUN: llc -mtriple=aarch64-unknown-linux-gnu < %s | FileCheck %s

; An equality compare of a masked value against a constant inside the
; mask, where the constant is not a compare immediate but the constant
; shifted down by the mask's trailing zeros is: shift both sides down,
; so the AND + shift select as a UBFX and the compare takes an immediate.

; (c & 0xfc00) == 0xd800: a UTF-16 high surrogate test.
define i1 @surrogate_eq(i32 %c) {
; CHECK-LABEL: surrogate_eq:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx w8, w0, #10, #6
; CHECK-NEXT:    cmp w8, #54
; CHECK-NEXT:    cset w0, eq
; CHECK-NEXT:    ret
  %m = and i32 %c, 64512
  %r = icmp eq i32 %m, 55296
  ret i1 %r
}

define i1 @surrogate_ne(i32 %c) {
; CHECK-LABEL: surrogate_ne:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx w8, w0, #10, #6
; CHECK-NEXT:    cmp w8, #54
; CHECK-NEXT:    cset w0, ne
; CHECK-NEXT:    ret
  %m = and i32 %c, 64512
  %r = icmp ne i32 %m, 55296
  ret i1 %r
}

