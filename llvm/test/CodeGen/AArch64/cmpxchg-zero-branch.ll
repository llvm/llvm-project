; RUN: llc -mtriple=aarch64-unknown-linux-gnu -mattr=+lse -verify-machineinstrs < %s | FileCheck %s

; A branch on the success of a CAS whose expected value is zero tests the CAS
; result against zero, which folds to CBZ/CBNZ. This is the shape of every
; lock acquisition of the form 'compare_exchange(0, locked)'.

define void @cas_zero_branch_64(ptr %p, i64 %new) {
; CHECK-LABEL: cas_zero_branch_64:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mov x8, xzr
; CHECK-NEXT:    casal x8, x1, [x0]
; CHECK-NEXT:    cmp x8, #0
; CHECK-NEXT:    b.ne .LBB0_2
; CHECK-NEXT:  // %bb.1: // %yes
; CHECK-NEXT:    b g
; CHECK-NEXT:  .LBB0_2: // %common.ret
; CHECK-NEXT:    ret
entry:
  %r = cmpxchg ptr %p, i64 0, i64 %new acq_rel acquire
  %ok = extractvalue { i64, i1 } %r, 1
  br i1 %ok, label %yes, label %no
yes:
  tail call void @g()
  ret void
no:
  ret void
}

