; When the success flag has a use besides the branch, the compare stays.

define i1 @cas_zero_branch_and_value(ptr %p, i64 %new) {
; CHECK-LABEL: cas_zero_branch_and_value:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    stp x30, x19, [sp, #-16]! // 16-byte Folded Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset w19, -8
; CHECK-NEXT:    .cfi_offset w30, -16
; CHECK-NEXT:    mov x8, xzr
; CHECK-NEXT:    casal x8, x1, [x0]
; CHECK-NEXT:    cmp x8, #0
; CHECK-NEXT:    cset w19, eq
; CHECK-NEXT:    b.ne .LBB3_2
; CHECK-NEXT:  // %bb.1: // %yes
; CHECK-NEXT:    bl g
; CHECK-NEXT:  .LBB3_2: // %no
; CHECK-NEXT:    mov w0, w19
; CHECK-NEXT:    ldp x30, x19, [sp], #16 // 16-byte Folded Reload
; CHECK-NEXT:    ret
entry:
  %r = cmpxchg ptr %p, i64 0, i64 %new acq_rel acquire
  %ok = extractvalue { i64, i1 } %r, 1
  br i1 %ok, label %yes, label %no
yes:
  tail call void @g()
  br label %no
no:
  ret i1 %ok
}

