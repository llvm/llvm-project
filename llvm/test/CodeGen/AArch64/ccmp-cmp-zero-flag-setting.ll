; The same compare comes out of instruction selection when the ADD/SUB leaf is
; the first compare of a conjunction.
define i64 @add_or_leaf(i64 %x, i64 %y, i64 %z) {
; CHECK-LABEL: add_or_leaf:
; CHECK:       // %bb.0:
; CHECK-NEXT:    adds x8, x0, x1
; CHECK-NEXT:    ccmp x2, #7, #4, ne
; CHECK-NEXT:    csel x0, x8, x2, eq
; CHECK-NEXT:    ret
  %a = add i64 %x, %y
  %c1 = icmp eq i64 %z, 7
  %c2 = icmp eq i64 %a, 0
  %o = or i1 %c1, %c2
  %r = select i1 %o, i64 %a, i64 %z
  ret i64 %r
}

define i64 @sub_and_leaf(i64 %x, i64 %y, i64 %z) {
; CHECK-LABEL: sub_and_leaf:
