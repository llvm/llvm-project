# RUN: llc -mtriple=aarch64-pc-windows-msvc -run-pass=aarch64-win-cfi \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64-pc-windows-msvc -passes=aarch64-win-cfi,verify \
# RUN:   %s -o - | FileCheck %s

--- |
  define void @entry_prologue() uwtable {
    ret void
  }
  define void @handler_prologue() uwtable personality ptr @__C_specific_handler {
    ret void
  }
  define void @section_ranges() uwtable {
    ret void
  }
  declare i32 @__C_specific_handler(...)
...
---
# An entry-block prologue must retain implicit function-wide unwind emission;
# this pass must not insert explicit range or phantom-prologue pseudos.
name: entry_prologue
hasWinCFI: true
noPhis: true
isSSA: false
noVRegs: true
frameInfo:
  stackSize: 16
  maxAlignment: 16
  adjustsStack: true
body: |
  ; CHECK-LABEL: name: entry_prologue
  ; CHECK-NOT: SEH_StartProc
  ; CHECK-NOT: SEH_EndProc
  ; CHECK-NOT: SEH_EndC
  bb.0:
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    frame-destroy SEH_EpilogStart
    $sp = frame-destroy ADDXri $sp, 16, 0
    frame-destroy SEH_StackAlloc 16
    frame-destroy SEH_EpilogEnd
    RET undef $lr
...
---
# A personality-bearing function must remain unchanged even when its prologue
# is delayed, since explicit range splitting does not preserve handler data yet.
name: handler_prologue
hasWinCFI: true
noPhis: true
isSSA: false
noVRegs: true
frameInfo:
  stackSize: 16
  maxAlignment: 16
  adjustsStack: true
body: |
  ; CHECK-LABEL: name: handler_prologue
  ; CHECK-NOT: SEH_StartProc
  ; CHECK-NOT: SEH_EndProc
  ; CHECK-NOT: SEH_EndC
  bb.0:
    successors: %bb.1
    B %bb.1

  bb.1:
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    frame-destroy SEH_EpilogStart
    $sp = frame-destroy ADDXri $sp, 16, 0
    frame-destroy SEH_StackAlloc 16
    frame-destroy SEH_EpilogEnd
    RET undef $lr
...
---
# Unwind records must not span section boundaries. Each new section entered
# with the prologue in effect needs a phantom recipe, and a completed epilogue
# must end its range before the aligned, leaf-style fallthrough return block.
name: section_ranges
hasWinCFI: true
noPhis: true
isSSA: false
noVRegs: true
frameInfo:
  stackSize: 16
  maxAlignment: 16
  adjustsStack: true
body: |
  ; CHECK-LABEL: name: section_ranges
  ; CHECK: bb.0:
  ; CHECK-NOT: SEH_StartProc
  ; CHECK: bb.1:
  ; CHECK: SEH_StartProc
  ; CHECK-NEXT: $sp = frame-setup SUBXri $sp, 16, 0
  ; CHECK-NEXT: frame-setup SEH_StackAlloc 16
  ; CHECK-NEXT: frame-setup SEH_PrologEnd
  ; CHECK-NEXT: B %bb.2 {
  ; CHECK-NEXT: SEH_EndProc
  ; CHECK-NEXT: }
  ; CHECK: bb.2 (bbsections 1):
  ; CHECK: SEH_StartProc
  ; CHECK-NEXT: frame-setup SEH_StackAlloc 16
  ; CHECK-NEXT: SEH_EndC
  ; CHECK-NEXT: SEH_PrologEnd
  ; CHECK-NEXT: B %bb.3 {
  ; CHECK-NEXT: SEH_EndProc
  ; CHECK-NEXT: }
  ; CHECK: bb.3 (bbsections 2):
  ; CHECK: SEH_StartProc
  ; CHECK-NEXT: frame-setup SEH_StackAlloc 16
  ; CHECK-NEXT: SEH_EndC
  ; CHECK-NEXT: SEH_PrologEnd
  ; CHECK-NEXT: frame-destroy SEH_EpilogStart
  ; CHECK-NEXT: $sp = frame-destroy ADDXri $sp, 16, 0
  ; CHECK-NEXT: frame-destroy SEH_StackAlloc 16
  ; CHECK-NEXT: frame-destroy SEH_EpilogEnd
  ; CHECK-NEXT: SEH_EndProc
  ; CHECK: bb.4 (align 16, bbsections 2):
  ; CHECK-NOT: SEH_StartProc
  ; CHECK: RET
  ; CHECK-NOT: SEH_EndProc
  bb.0:
    successors: %bb.1
    B %bb.1

  bb.1:
    successors: %bb.2
    $sp = frame-setup SUBXri $sp, 16, 0
    frame-setup SEH_StackAlloc 16
    frame-setup SEH_PrologEnd
    B %bb.2

  bb.2 (bbsections 1):
    successors: %bb.3
    B %bb.3

  bb.3 (bbsections 2):
    successors: %bb.4
    frame-destroy SEH_EpilogStart
    $sp = frame-destroy ADDXri $sp, 16, 0
    frame-destroy SEH_StackAlloc 16
    frame-destroy SEH_EpilogEnd

  bb.4 (bbsections 2, align 16):
    RET undef $lr
...