; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[OC:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OC]], label %[[OUTER]], label %[[EXIT:.*]], !prof [[PROF1]]
; CHECK:       [[EXIT]]:
