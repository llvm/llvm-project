# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -o - %s \
# RUN: -start-before=aarch64-mi-peephole-opt -stop-after=register-coalescer | FileCheck %s

# Ensure that from AArch64's peephole-opt to coalescing, nothing removes a zext when it's actually required.
# This shows that SUBREG_TO_REG does not provide any more protection against coalescing than a COPY to a subreg,
# a INSERT_SUBREG or a REG_SEQUENCE.

# The test has no zext (ORRW), SUBREG_TO_REG (considered COPY-like) should get safely coalesced.
# A generic COPY into .sub_32 does NOT encode that upper bits are zeroed and that's fine because
# the input MIR did not require that.
#
# FIXME: Get that COPY coalesced!
---
name:            no_zext_subreg_to_reg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $x1

    ; CHECK-LABEL: name: no_zext_subreg_to_reg
    ; CHECK: liveins: $w0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[LDRSBXui:%[0-9]+]]:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    ; CHECK-NEXT: undef [[COPY1:%[0-9]+]].sub_32:gpr64 = COPY [[LDRSBXui]].sub_32
    ; CHECK-NEXT: STRWui [[COPY]], $x1, 0 :: (store (s8))
    ; CHECK-NEXT: $x0 = COPY [[COPY1]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %1:gpr32 = COPY $w0
    %3:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    %0:gpr32 = COPY %3.sub_32
    STRWui %1, $x1, 0 :: (store (s8))
    %8:gpr64all = SUBREG_TO_REG %0, %subreg.sub_32
    $x0 = COPY %8
    RET_ReallyLR implicit $x0
...

# Same as above, but replacing SUBREG_TO_REG with INSERT_SUBREG.
---
name:            no_zext_insert_subreg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $x1

    ; CHECK-LABEL: name: no_zext_insert_subreg
    ; CHECK: liveins: $w0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[LDRSBXui:%[0-9]+]]:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    ; CHECK-NEXT: STRWui [[COPY]], $x1, 0 :: (store (s8))
    ; CHECK-NEXT: $x0 = COPY [[LDRSBXui]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %1:gpr32 = COPY $w0
    %3:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    %0:gpr32 = COPY %3.sub_32
    STRWui %1, $x1, 0 :: (store (s8))
    %10:gpr64all = IMPLICIT_DEF
    %8:gpr64all = INSERT_SUBREG %10, %0, %subreg.sub_32
    $x0 = COPY %8
    RET_ReallyLR implicit $x0
...

# Same as above, but replacing SUBREG_TO_REG with REG_SEQUENCE.
---
name:            no_zext_reg_sequence
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $x1

    ; CHECK-LABEL: name: no_zext_reg_sequence
    ; CHECK: liveins: $w0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[LDRSBXui:%[0-9]+]]:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    ; CHECK-NEXT: STRWui [[COPY]], $x1, 0 :: (store (s8))
    ; CHECK-NEXT: $x0 = COPY [[LDRSBXui]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %1:gpr32 = COPY $w0
    %3:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    %0:gpr32 = COPY %3.sub_32
    STRWui %1, $x1, 0 :: (store (s8))
    %8:gpr64all = REG_SEQUENCE %0, %subreg.sub_32
    $x0 = COPY %8
    RET_ReallyLR implicit $x0
...

# %0 and %8 should get coalesced, but the ORRW must stay to zero the upper bits.
---
name:            orrw_zext
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w0, $x1

    ; CHECK-LABEL: name: orrw_zext
    ; CHECK: liveins: $w0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[LDRSBXui:%[0-9]+]]:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    ; CHECK-NEXT: undef [[ORRWrs:%[0-9]+]].sub_32:gpr64 = ORRWrs $wzr, [[LDRSBXui]].sub_32, 0
    ; CHECK-NEXT: STRWui [[COPY]], $x1, 0 :: (store (s8))
    ; CHECK-NEXT: $x0 = COPY [[ORRWrs]]
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %1:gpr32 = COPY $w0
    %3:gpr64 = LDRSBXui $x1, 0 :: (load (s8))
    %0:gpr32 = ORRWrs $wzr, %3.sub_32, 0
    STRWui %1, $x1, 0 :: (store (s8))
    %8:gpr64all = SUBREG_TO_REG %0, %subreg.sub_32
    $x0 = COPY %8
    RET_ReallyLR implicit $x0
...

