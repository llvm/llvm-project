; LP64-LABEL: @size_1(
; LP64-NEXT:    [[TMP1:%.*]] = ptrtoaddr ptr [[PTR:%.*]] to i64
; LP64-NEXT:    [[TMP2:%.*]] = and i64 [[TMP1]], 0
; LP64-NEXT:    [[TMP3:%.*]] = icmp eq i64 [[TMP2]], 0
; LP64-NEXT:    ret i1 [[TMP3]]
;
; ILP32-LABEL: @size_1(
; ILP32-NEXT:    [[TMP1:%.*]] = ptrtoaddr ptr [[PTR:%.*]] to i32
; ILP32-NEXT:    [[TMP2:%.*]] = and i32 [[TMP1]], 0
; ILP32-NEXT:    [[TMP3:%.*]] = icmp eq i32 [[TMP2]], 0
; ILP32-NEXT:    ret i1 [[TMP3]]
;
  %can_load = call i1 @llvm.can.load.speculatively.p0(ptr %ptr, i64 1)
  ret i1 %can_load
}

