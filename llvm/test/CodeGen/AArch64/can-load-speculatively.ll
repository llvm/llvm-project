; LP64-NEXT:    [[TMP3:%.*]] = ptrtoaddr ptr [[PTR:%.*]] to i64
; LP64-NEXT:    [[TMP4:%.*]] = and i64 [[TMP3]], [[TMP2]]
; LP64-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[TMP4]], 0
; LP64-NEXT:    [[TMP6:%.*]] = and i1 [[TMP1]], [[TMP5]]
; LP64-NEXT:    ret i1 [[TMP6]]
