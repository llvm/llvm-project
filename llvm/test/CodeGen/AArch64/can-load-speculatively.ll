; ILP32-NEXT:    [[TMP4:%.*]] = ptrtoaddr ptr [[PTR:%.*]] to i32
; ILP32-NEXT:    [[TMP5:%.*]] = and i32 [[TMP4]], [[TMP3]]
; ILP32-NEXT:    [[TMP6:%.*]] = icmp eq i32 [[TMP5]], 0
; ILP32-NEXT:    [[TMP7:%.*]] = and i1 [[TMP1]], [[TMP6]]
; ILP32-NEXT:    ret i1 [[TMP7]]
;
  %can_load = call i1 @llvm.can.load.speculatively.p0(ptr %ptr, i64 %size)
  ret i1 %can_load
