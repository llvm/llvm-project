declare void @external_func() "aarch64_inout_za"

; ZA state being live for both caller and callee forces the non-sibcall tail
; call fast path. FPDiff = (caller's incoming argument stack) - (callee's
; outgoing argument stack) can come out either positive or negative, and in
; either case its magnitude must be rounded away from zero to a multiple of
; 16 to keep the stack pointer 16-byte aligned at all times.
declare void @callee_fewer_args(i64, i64, i64, i64, i64, i64, i64, i64) "aarch64_inout_za"
define void @caller_more_args(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) "aarch64_inout_za" uwtable {
; CHECK-LABEL: caller_more_args:
