# RUN: llc -mtriple=aarch64-- -start-before=kcfi -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ASM
# RUN: llc -mtriple=aarch64-- -run-pass=kcfi -verify-machineinstrs %s -o - | llc -mtriple=aarch64-- -x mir -run-pass=none -verify-machineinstrs -o - | FileCheck %s --check-prefix=MIR

## A check of a call to xzr compares the expected type with zero, which it
## moves into x16. The out-of-line trap encodes x16 in its BRK immediate without
## marking x16 live-in to the trap block, and nomerge KCFI_TRAP round-trips
## cleanly through MIR parsing.

# ASM-LABEL: f:
# ASM:         mov x16, xzr
# ASM-NEXT:    movk w17, #24910
# ASM-NEXT:    movk w17, #188, lsl #16
# ASM-NEXT:    cmp w16, w17
# ASM-NEXT:    b.ne [[TRAP:.LBB[0-9_]+]]
# ASM-NEXT:  // %bb.{{[0-9]+}}:
# ASM-NEXT:    blr xzr
# ASM-NEXT:    ret
# ASM-NEXT:  [[TRAP]]:
# ASM-NEXT:    brk #0x8230

# MIR-LABEL: name: f
# MIR:         KCFI_CMP $xzr, 12345678, implicit-def $x9, implicit-def $x16, implicit-def $x17, implicit-def $nzcv
# MIR-NEXT:    Bcc 1, %[[TRAP:bb\.[0-9]+]], implicit $nzcv
# MIR:       bb.{{[0-9]+}}:
# MIR:         BLR $xzr, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp
# MIR:       [[TRAP]]:
# MIR-NOT:     liveins:
# MIR:         nomerge KCFI_TRAP undef $x16, undef $w17

--- |
  define void @f() {
    ret void
  }

  !llvm.module.flags = !{!0, !1}
  !0 = !{i32 4, !"kcfi", i32 1}
  !1 = !{i32 8, !"kcfi-out-of-line-traps", i32 1}
...
---
name:            f
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $lr

    BLR $xzr, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit-def $sp, cfi-type 12345678
    RET undef $lr
...
