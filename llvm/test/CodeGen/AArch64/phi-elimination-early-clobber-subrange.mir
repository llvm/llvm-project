# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness \
# RUN:   -passes='require<live-intervals>,phi-node-elimination,verify' \
# RUN:   %s -o - | FileCheck %s

# CFG:
#
#                      bb.0
#                        |
#                        v
#              +------> bb.1 <------+
#              |          |          |
#              |     +----+----+     |
#              |     |         |     |
#              |     v         v     |
#              +--- bb.2      bb.3 --+
#                                |
#                                v
#                              bb.4
#
# %0 is a loop-carried variable. The bb.2 path consumes all its lanes as the
# tied address/writeback operand of STRBBpost. The bb.4 path consumes only
# %0.sub_32, so LiveIntervals gives %0 lane subranges.
#
# PHI elimination must shorten %0's main range and its lane subranges at STRBBpost
# to the early-clobber slot. The verifier ensures the subranges remain covered
# by the main range.

---
name: phi_early_clobber_subrange
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_early_clobber_subrange
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gpr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:gpr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:gpr64sp = IMPLICIT_DEF
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64sp = COPY [[DEF2]]
  ; CHECK-NEXT:   TBZW [[DEF]], 0, %bb.3
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $wzr
  ; CHECK-NEXT:   early-clobber %6:gpr64sp = STRBBpost [[COPY1]], [[COPY]], 1 :: (store (s8))
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64all = COPY %6
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:gpr64sp = COPY [[COPY2]]
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TBNZW [[DEF1]], 0, %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:gpr64sp = COPY [[COPY]]
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr32all = COPY [[COPY]].sub_32
  ; CHECK-NEXT:   $w0 = COPY [[COPY3]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1

    %3:gpr32 = IMPLICIT_DEF
    %4:gpr32 = IMPLICIT_DEF
    %5:gpr64sp = IMPLICIT_DEF
    B %bb.1

  bb.1:
    successors: %bb.2, %bb.3

    %0:gpr64sp = PHI %5, %bb.0, %0, %bb.3, %1, %bb.2
    TBZW %3, 0, %bb.3
    B %bb.2

  bb.2:
    successors: %bb.1

    %6:gpr32 = COPY $wzr
    early-clobber %2:gpr64sp = STRBBpost %6, %0, 1 :: (store (s8))
    %1:gpr64all = COPY %2
    B %bb.1

  bb.3:
    successors: %bb.4, %bb.1

    TBZW %4, 0, %bb.1

  bb.4:
    %7:gpr32all = COPY %0.sub_32
    $w0 = COPY %7
    RET_ReallyLR implicit $w0
...
