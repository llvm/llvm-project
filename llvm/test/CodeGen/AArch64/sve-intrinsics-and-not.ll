define <vscale x 4 x i32> @and_not_zeroing(<vscale x 4 x i32> %a, <vscale x 4 x i32> %b, <vscale x 4 x i1> %pg) {
; SVE-LABEL: and_not_zeroing:
; SVE:       // %bb.0:
; SVE-NEXT:    movi v2.2d, #0000000000000000
; SVE-NEXT:    not z2.s, p0/m, z1.s
; SVE-NEXT:    and z0.d, z0.d, z2.d
; SVE-NEXT:    ret
;
; SVE2P2-LABEL: and_not_zeroing:
; SVE2P2:       // %bb.0:
; SVE2P2-NEXT:    not z1.s, p0/z, z1.s
; SVE2P2-NEXT:    and z0.d, z0.d, z1.d
; SVE2P2-NEXT:    ret
;
; SME-LABEL: and_not_zeroing:
; SME:       // %bb.0:
; SME-NEXT:    mov z2.s, #0 // =0x0
; SME-NEXT:    not z2.s, p0/m, z1.s
; SME-NEXT:    and z0.d, z0.d, z2.d
; SME-NEXT:    ret
  %not = call <vscale x 4 x i32> @llvm.aarch64.sve.not.nxv4i32(<vscale x 4 x i32> zeroinitializer, <vscale x 4 x i1> %pg, <vscale x 4 x i32> %b)
  %and = and <vscale x 4 x i32> %a, %not
  ret <vscale x 4 x i32> %and
}

