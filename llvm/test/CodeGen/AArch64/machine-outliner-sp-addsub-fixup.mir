# ADD:       name:            [[ADD_FUNC]]
# ADD:       early-clobber $sp = STRXpre $lr, $sp, -16
# ADD-NEXT:  BL @callee
# ADD-NEXT:  $x15 = ADDXri $sp, 64, 0
# ADD-NEXT:  $x15 = ADDXri $sp, 64, 0
# ADD-NEXT:  early-clobber $sp, $lr = LDRXpost $sp, 16
# ADD-NEXT:  RET $lr

# SUB:       name:            [[SUB_FUNC]]
# SUB:       early-clobber $sp = STRXpre $lr, $sp, -16
# SUB-NEXT:  BL @callee
# SUB-NEXT:  $x15 = SUBXri $sp, 32, 0
# SUB-NEXT:  $x15 = SUBXri $sp, 32, 0
# SUB-NEXT:  early-clobber $sp, $lr = LDRXpost $sp, 16
# SUB-NEXT:  RET $lr

# SHIFTED-SUB:       name:            [[SHIFTED_SUB_FUNC]]
# SHIFTED-SUB:       early-clobber $sp = STRXpre $lr, $sp, -16
# SHIFTED-SUB-NEXT:  BL @callee
# SHIFTED-SUB-NEXT:  $x15 = SUBXri $sp, 4080, 0
# SHIFTED-SUB-NEXT:  $x15 = SUBXri $sp, 4080, 0
# SHIFTED-SUB-NEXT:  early-clobber $sp, $lr = LDRXpost $sp, 16
# SHIFTED-SUB-NEXT:  RET $lr

# SUB-TO-ADD:       name:            [[SUB_TO_ADD_FUNC]]
# SUB-TO-ADD:       early-clobber $sp = STRXpre $lr, $sp, -16
# SUB-TO-ADD-NEXT:  BL @callee
# SUB-TO-ADD-NEXT:  $x15 = ADDXri $sp, 8, 0
# SUB-TO-ADD-NEXT:  $x15 = ADDXri $sp, 8, 0
# SUB-TO-ADD-NEXT:  early-clobber $sp, $lr = LDRXpost $sp, 16
# SUB-TO-ADD-NEXT:  RET $lr

# SP-WRITE:       name:            [[SP_WRITE_FUNC]]
# SP-WRITE-NOT:   STRXpre
# SP-WRITE:       $sp = SUBXri $sp, 16, 0
# SP-WRITE-NEXT:  $sp = ADDXri $sp, 16, 0
# SP-WRITE-NEXT:  RET $lr

# OVERFLOW:       name:            [[OVERFLOW_FUNC]]
# OVERFLOW-NOT:   STRXpre
# OVERFLOW:       $x15 = ADDXri $sp, 4095, 0
# OVERFLOW-NEXT:  $x15 = ADDXri $sp, 4095, 0
# OVERFLOW-NEXT:  RET $lr

# SHIFTED-ADD:       name:            [[SHIFTED_ADD_FUNC]]
# SHIFTED-ADD-NOT:   STRXpre
# SHIFTED-ADD:       $x15 = ADDXri $sp, 1, 12
# SHIFTED-ADD-NEXT:  $x15 = ADDXri $sp, 1, 12
# SHIFTED-ADD-NEXT:  RET $lr
