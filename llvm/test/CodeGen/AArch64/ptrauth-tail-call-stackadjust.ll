; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=arm64e-apple-macosx               -o - | FileCheck %s

; Test that epilogue LR authentication uses the correct entry-SP modifier
; when local-frame teardown and callee-popped argument cleanup are combined
; into a single SP adjustment: the entry SP is reconstructed into a scratch
; register (x16) and authentication uses the register form of auti[ab]
; rather than auti[ab]sp, deferring the real SP adjustment to after aut.

%large_struct = type { i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64 }

declare void @external_func()

define swifttailcc void @test_frame_and_args(%large_struct %s) #0 {
; CHECK-LABEL: test_frame_and_args:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    pacibsp
; CHECK-NEXT:    sub sp, sp, #80
; CHECK-NEXT:    str x30, [sp, #64] ; 8-byte Spill
; CHECK-NEXT:    .cfi_def_cfa_offset 80
; CHECK-NEXT:    .cfi_offset w30, -16
; CHECK-NEXT:    bl _external_func
; CHECK-NEXT:    ldr x30, [sp, #64] ; 8-byte Reload
; CHECK-NEXT:    add x16, sp, #80
; CHECK-NEXT:    autib x30, x16
; CHECK-NEXT:    add sp, sp, #144
; CHECK-NEXT:    ret
entry:
  %local1 = alloca [32 x i8], align 8
  %local2 = alloca [32 x i8], align 8
  call void @llvm.lifetime.start.p0(i64 32, ptr %local1)
  call void @llvm.lifetime.start.p0(i64 32, ptr %local2)
  call void @external_func()
  call void @llvm.lifetime.end.p0(i64 32, ptr %local2)
  call void @llvm.lifetime.end.p0(i64 32, ptr %local1)
  ret void
}

declare void @llvm.lifetime.start.p0(i64, ptr nocapture)
declare void @llvm.lifetime.end.p0(i64, ptr nocapture)

attributes #0 = { "ptrauth-returns" "sign-return-address"="all" "sign-return-address-key"="b_key" }
