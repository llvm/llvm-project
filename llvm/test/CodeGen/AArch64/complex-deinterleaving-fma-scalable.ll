; CHECK-NEXT:    uzp2 z2.s, z2.s, z3.s
; CHECK-NEXT:    uzp1 z0.s, z0.s, z1.s
; CHECK-NEXT:    movprfx z5, z4
; CHECK-NEXT:    fneg z5.s, p0/m, z4.s
