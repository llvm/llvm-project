; A defined NOT passthru is observable when the predicates differ.

define <vscale x 4 x i32> @different_predicates(<vscale x 4 x i32> %a, <vscale x 4 x i32> %b, <vscale x 4 x i32> %inactive, <vscale x 4 x i1> %pg, <vscale x 4 x i1> %not_pg) {
; CHECK-LABEL: different_predicates:
; CHECK:       // %bb.0:
; CHECK-NEXT:    not z2.s, p1/m, z1.s
; CHECK-NEXT:    and z0.d, z0.d, z2.d
; CHECK-NEXT:    ret
  %not = call <vscale x 4 x i32> @llvm.aarch64.sve.not.nxv4i32(<vscale x 4 x i32> %inactive, <vscale x 4 x i1> %not_pg, <vscale x 4 x i32> %b)
  %and = call <vscale x 4 x i32> @llvm.aarch64.sve.and.u.nxv4i32(<vscale x 4 x i1> %pg, <vscale x 4 x i32> %a, <vscale x 4 x i32> %not)
  ret <vscale x 4 x i32> %and
}

