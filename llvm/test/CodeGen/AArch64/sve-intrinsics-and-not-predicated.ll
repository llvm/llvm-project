; Commuting a merging AND would replace its inactive lanes from NOT with A.
define <vscale x 4 x i32> @merging_lhs(<vscale x 4 x i32> %a, <vscale x 4 x i32> %b, <vscale x 4 x i32> %inactive, <vscale x 4 x i1> %pg) {
; CHECK-LABEL: merging_lhs:
; CHECK:       // %bb.0:
; CHECK-NEXT:    not z2.s, p0/m, z1.s
; CHECK-NEXT:    and z2.s, p0/m, z2.s, z0.s
; CHECK-NEXT:    mov z0.d, z2.d
; CHECK-NEXT:    ret
  %not = call <vscale x 4 x i32> @llvm.aarch64.sve.not.nxv4i32(<vscale x 4 x i32> %inactive, <vscale x 4 x i1> %pg, <vscale x 4 x i32> %b)
  %and = call <vscale x 4 x i32> @llvm.aarch64.sve.and.nxv4i32(<vscale x 4 x i1> %pg, <vscale x 4 x i32> %not, <vscale x 4 x i32> %a)
  ret <vscale x 4 x i32> %and
}
