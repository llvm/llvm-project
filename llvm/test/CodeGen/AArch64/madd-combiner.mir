# RUN: llc -run-pass=machine-combiner -o - -mtriple=aarch64-unknown-linux %s | FileCheck %s
--- |
  ; ModuleID = 'madd-combiner.ll'
  source_filename = "madd-combiner.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64-unknown-linux-gnu"
  
  define i64 @test(i64 %a, i64 %b, i32 %c) {
  entry:
    %mul = mul nsw i64 %a, %b
    %shr = ashr i32 %c, 2
    %ext = sext i32 %shr to i64
    %add = add nsw i64 %mul, %ext
    ret i64 %add
  }
...
---
name:            test
alignment:       4
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
registers:
  - { id: 0, class: gpr64 }
  - { id: 1, class: gpr64 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr64common }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr64sp }
liveins:
  - { reg: '$x0', virtual-reg: '%0' }
  - { reg: '$x1', virtual-reg: '%1' }
  - { reg: '$w2', virtual-reg: '%2' }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
  maxCallFrameSize: 0
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $x0, $x1, $w2
  
    %2:gpr32 = COPY $w2
    %1:gpr64 = COPY $x1
    %0:gpr64 = COPY $x0
    %3:gpr64common = nsw MADDXrrr %0, %1, $xzr
    %4:gpr32 = SBFMWri %2, 2, 31
    %5:gpr64sp = nsw ADDXrx killed %3, killed %4, 48
    $x0 = COPY %5
    RET_ReallyLR implicit $x0
...
# CHECK-LABEL: name: test
# CHECK: [[TMP1:%[0-9]+]]:gpr64 = IMPLICIT_DEF
# CHECK-NEXT: [[TMP2:%[0-9]+]]:gpr64 = INSERT_SUBREG killed [[TMP1]], %2, %subreg.sub_32
# CHECK-NEXT: [[TMP3:%[0-9]+]]:gpr64 = SBFMXri killed [[TMP2]], 2, 31
# CHECK-NEXT: %5:gpr64common = nsw MADDXrrr %0, %1, killed [[TMP3]]
