# RUN: not --crash llc -mtriple=aarch64-windows-msvc -run-pass=prolog-epilog %s -o - 2>&1 | FileCheck %s
#
# REQUIRES: asserts
#
---
# x16 and x17 are marked as live on function entry, but the __chkstk call
# emitted by the prologue clobbers them.
# Use this to check we catch that the prologue clobbers live registers.
# CHECK: live register clobbered by inserted prologue instructions
name: x16_x17_clobbered_on_fn_entry
tracksRegLiveness: true
frameInfo:
  isFrameAddressTaken: true
stack:
  - { id: 0, size:    16, alignment: 16 }
  - { id: 1, size: 32768, alignment: 32 }
body: |
  bb.0:
    liveins: $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x16, $x17, $x18, $x19, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $lr
    STRXui $x0, %stack.0, 0
    B %bb.1
  bb.1:
    liveins: $x1, $x2, $x3, $x4, $x5, $x6, $x7, $x8, $x9, $x10, $x11, $x12, $x13, $x14, $x16, $x17, $x18, $x19, $x20, $x21, $x22, $x23, $x24, $x25, $x26, $x27, $x28, $lr
    RET_ReallyLR implicit $lr
...
