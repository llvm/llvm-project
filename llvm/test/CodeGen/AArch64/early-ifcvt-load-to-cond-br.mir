name:            load_to_cond_in_backedge
alignment:       4
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr64sp }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr64 }
  - { id: 4, class: gpr32 }
  - { id: 5, class: gpr32all }
  - { id: 6, class: gpr32 }
body:             |
  ; CHECK-COMMON-LABEL: name: load_to_cond_in_backedge
  ; CHECK-COMMON: bb.0:
  ; CHECK-COMMON-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-COMMON-NEXT:   liveins: $x0
  ; CHECK-COMMON-NEXT: {{  $}}
  ; CHECK-COMMON-NEXT:   [[COPY:%[0-9]+]]:gpr64sp = COPY $x0
  ; CHECK-COMMON-NEXT:   [[DEF:%[0-9]+]]:gpr32 = IMPLICIT_DEF
  ; CHECK-COMMON-NEXT:   B %bb.1
  ; CHECK-COMMON-NEXT: {{  $}}
  ; CHECK-COMMON-NEXT: bb.1:
  ; CHECK-COMMON-NEXT:   successors: %bb.5(0x04000000), %bb.1(0x7c000000)
  ; CHECK-COMMON-NEXT: {{  $}}
  ; CHECK-COMMON-NEXT:   [[PHI:%[0-9]+]]:gpr32 = PHI undef [[DEF]], %bb.0, %5, %bb.1
  ; CHECK-COMMON-NEXT:   [[LDRHHroW:%[0-9]+]]:gpr32 = LDRHHroW undef [[COPY]], undef [[PHI]], 0, 1 :: (load (s16))
  ; CHECK-COMMON-NEXT:   [[COPY1:%[0-9]+]]:gpr32all = COPY [[LDRHHroW]]
  ; CHECK-COMMON-NEXT:   [[COPY2:%[0-9]+]]:gpr32 = COPY [[COPY1]]
  ; CHECK-COMMON-NEXT:   Bcc 1, %bb.1, implicit undef $nzcv
  ; CHECK-COMMON-NEXT:   B %bb.5
  ; CHECK-COMMON-NEXT: {{  $}}
  ; CHECK-COMMON-NEXT: bb.5:
  ; CHECK-COMMON-NEXT:   RET_ReallyLR
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x0

    %0:gpr64sp = COPY $x0
    %1:gpr32 = IMPLICIT_DEF
    B %bb.1

  bb.1:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)

    %2:gpr32 = PHI undef %1, %bb.0, %5, %bb.4
    %4:gpr32 = LDRHHroW undef %0, undef %2, 0, 1 :: (load (s16))
    %5:gpr32all = COPY %4
    TBNZW undef %2, 0, %bb.3
    B %bb.2

  bb.2:
    successors: %bb.4(0x80000000)

    B %bb.4

  bb.3:
    successors: %bb.4(0x80000000)

  bb.4:
    successors: %bb.5(0x04000000), %bb.1(0x7c000000)

    %6:gpr32 = PHI undef %5, %bb.3, undef %5, %bb.2
    Bcc 1, %bb.1, implicit undef $nzcv
    B %bb.5

  bb.5:
    RET_ReallyLR
...
---
