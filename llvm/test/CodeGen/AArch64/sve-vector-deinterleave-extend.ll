define void @deinterleave_i32(ptr %src) {
; CHECK-LABEL: deinterleave_i32:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    ptrue p0.s
; CHECK-NEXT:    movi v0.2d, #0000000000000000
; CHECK-NEXT:    ld2w { z1.s, z2.s }, p0/z, [x0]
; CHECK-NEXT:    trn1 z3.s, z1.s, z0.s
; CHECK-NEXT:    trn1 z4.s, z2.s, z0.s
; CHECK-NEXT:    trn2 z5.s, z1.s, z0.s
; CHECK-NEXT:    trn2 z0.s, z2.s, z0.s
; CHECK-NEXT:    // fake_use: $z3
; CHECK-NEXT:    // fake_use: $z4
; CHECK-NEXT:    // fake_use: $z5
; CHECK-NEXT:    // fake_use: $z0
; CHECK-NEXT:    ret
entry:
  %abcd.vec = call { <vscale x 4 x i32>, <vscale x 4 x i32> }
    @llvm.aarch64.sve.ld2.sret.nxv4i32(
      <vscale x 4 x i1> splat (i1 true), ptr %src)

  %ac = extractvalue { <vscale x 4 x i32>, <vscale x 4 x i32> } %abcd.vec, 0
  %bd = extractvalue { <vscale x 4 x i32>, <vscale x 4 x i32> } %abcd.vec, 1

  %ac.vec = call { <vscale x 2 x i32>, <vscale x 2 x i32> } @llvm.vector.deinterleave2.nxv4i32(<vscale x 4 x i32> %ac)
  %bd.vec = call { <vscale x 2 x i32>, <vscale x 2 x i32> } @llvm.vector.deinterleave2.nxv4i32(<vscale x 4 x i32> %bd)

  %a = extractvalue { <vscale x 2 x i32>, <vscale x 2 x i32>} %ac.vec, 0
  %b = extractvalue { <vscale x 2 x i32>, <vscale x 2 x i32>} %bd.vec, 0
  %c = extractvalue { <vscale x 2 x i32>, <vscale x 2 x i32>} %ac.vec, 1
  %d = extractvalue { <vscale x 2 x i32>, <vscale x 2 x i32>} %bd.vec, 1

  %a.i64 = zext <vscale x 2 x i32> %a to <vscale x 2 x i64>
  %b.i64 = zext <vscale x 2 x i32> %b to <vscale x 2 x i64>
  %c.i64 = zext <vscale x 2 x i32> %c to <vscale x 2 x i64>
  %d.i64 = zext <vscale x 2 x i32> %d to <vscale x 2 x i64>

  call void (...) @llvm.fake.use(<vscale x 2 x i64> %a.i64)
  call void (...) @llvm.fake.use(<vscale x 2 x i64> %b.i64)
  call void (...) @llvm.fake.use(<vscale x 2 x i64> %c.i64)
  call void (...) @llvm.fake.use(<vscale x 2 x i64> %d.i64)

