; Test containing a load with its own local offset. Make sure isFrameOffsetLegal
; considers it and creates a virtual base register.
define void @load_with_offset() {
; O1-LABEL: load_with_offset:
; O1:       // %bb.0:
; O1-NEXT:    str x29, [sp, #-16]! // 8-byte Folded Spill
; O1-NEXT:    sub sp, sp, #1, lsl #12 // =4096
; O1-NEXT:    sub sp, sp, #912
; O1-NEXT:    .cfi_def_cfa_offset 5024
; O1-NEXT:    .cfi_offset w29, -16
; O1-NEXT:    add x8, sp, #8
; O1-NEXT:    ldrb w9, [x8, #4088]
; O1-NEXT:    strb w9, [x8, #4088]
; O1-NEXT:    add sp, sp, #1, lsl #12 // =4096
; O1-NEXT:    add sp, sp, #912
; O1-NEXT:    ldr x29, [sp], #16 // 8-byte Folded Reload
; O1-NEXT:    ret
;
; O0-LABEL: load_with_offset:
; O0:       // %bb.0:
; O0-NEXT:    str x29, [sp, #-16]! // 8-byte Folded Spill
; O0-NEXT:    sub sp, sp, #1, lsl #12 // =4096
; O0-NEXT:    sub sp, sp, #912
; O0-NEXT:    .cfi_def_cfa_offset 5024
; O0-NEXT:    .cfi_offset w29, -16
; O0-NEXT:    add x8, sp, #1, lsl #12 // =4096
; O0-NEXT:    ldrb w8, [x8]
; O0-NEXT:    add x9, sp, #1, lsl #12 // =4096
; O0-NEXT:    strb w8, [x9]
; O0-NEXT:    add sp, sp, #1, lsl #12 // =4096
; O0-NEXT:    add sp, sp, #912
; O0-NEXT:    ldr x29, [sp], #16 // 8-byte Folded Reload
; O0-NEXT:    ret
  %va = alloca [5000 x i8], align 4
  %va_gep = getelementptr [5000 x i8], ptr %va, i64 0, i64 4088
  %load = load volatile i8, ptr %va_gep, align 4
