# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness \
# RUN:   -passes='require<live-intervals>,verify,register-coalescer,invalidate<live-intervals>,require<live-intervals>,verify' \
# RUN:   %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -enable-subreg-liveness -verify-machineinstrs \
# RUN:   -passes='register-coalescer,greedy,virt-reg-rewriter' \
# RUN:   %s -o - | FileCheck %s --check-prefix RA
#
# Coalescing must preserve read-undef on the final SUBWri definition. Rebuild
# LiveIntervals after coalescing to check that the MIR describes undefined lanes.

# CFG:
#
#   bb.0
#     |
#     v
#   bb.1 <--------+
#     |           |
#     v           |
#   bb.2 <---+    |
#     |      |    |
#     +------+    |
#     |           |
#     v           |
#   bb.3 ---------+
#
# The coalescer joins all %0, %1, %2, %3, and %4 into %2:gpr64common.
# The final %4 -> %0 join rewrites SUBWri as a %2.sub_32 definition. Its use of
# the low lane must not prevent read-undef from marking the high lane undefined.

---
name: coalescer_preserves_subreg_undef
isSSA: false
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: coalescer_preserves_subreg_undef
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[COPY:%[0-9]+]].sub_32:gpr64common = COPY $wzr
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = ADDXri [[COPY]], 1, 0
  ; CHECK-NEXT:   CBNZX [[COPY]], %bb.2
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   undef [[COPY:%[0-9]+]].sub_32:gpr64common = SUBWri [[COPY]].sub_32, 1, 0
  ; CHECK-NEXT:   B %bb.1
  ;
  ; RA-LABEL: name: coalescer_preserves_subreg_undef
  ; RA: bb.0:
  ; RA-NEXT:   successors: %bb.1(0x80000000)
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   renamable $w8 = COPY $wzr
  ; RA-NEXT:   B %bb.1
  ; RA-NEXT: {{  $}}
  ; RA-NEXT: bb.1:
  ; RA-NEXT:   successors: %bb.2(0x80000000)
  ; RA-NEXT:   liveins: $x8:0x0000000000000040
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   B %bb.2
  ; RA-NEXT: {{  $}}
  ; RA-NEXT: bb.2:
  ; RA-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; RA-NEXT:   liveins: $x8:0x0000000000000040
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   renamable $x8 = ADDXri killed renamable $x8, 1, 0
  ; RA-NEXT:   CBNZX renamable $x8, %bb.2
  ; RA-NEXT:   B %bb.3
  ; RA-NEXT: {{  $}}
  ; RA-NEXT: bb.3:
  ; RA-NEXT:   successors: %bb.1(0x80000000)
  ; RA-NEXT:   liveins: $x8:0x0000000000000040
  ; RA-NEXT: {{  $}}
  ; RA-NEXT:   renamable $w8 = SUBWri renamable $w8, 1, 0
  ; RA-NEXT:   B %bb.1
  bb.0:
    successors: %bb.1

    %0:gpr32all = COPY $wzr
    B %bb.1

  bb.1:
    successors: %bb.2

    %1:gpr32common = COPY %0
    B %bb.2

  bb.2:
    successors: %bb.2, %bb.3

    undef %2.sub_32:gpr64common = COPY %1
    %3:gpr64common = ADDXri %2, 1, 0
    %1:gpr32common = COPY %3.sub_32
    CBNZX %3, %bb.2
    B %bb.3

  bb.3:
    successors: %bb.1

    %4:gpr32common = SUBWri %1, 1, 0
    %0:gpr32all = COPY %4
    B %bb.1
...
