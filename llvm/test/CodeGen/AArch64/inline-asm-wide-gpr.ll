; RUN: llc -mtriple=aarch64-linux-gnu < %s | FileCheck %s --check-prefixes=CHECK,LE
; RUN: llc -mtriple=aarch64_be-linux-gnu < %s | FileCheck %s --check-prefixes=CHECK,BE

; A value wider than 64 bits in an "r" operand, such as an i128 or an fp128,
; goes in 64-bit registers, one for each 64 bits of it. 32-bit registers would
; hold only half of it.
; Big-endian puts the halves of an i128 in the other order (see
; @test_i128_high_half).

define void @test_i128_input(i128 %x) {
; CHECK-LABEL: test_i128_input:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    //APP
; CHECK-NEXT:    // x0
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
entry:
  call void asm sideeffect "// $0", "r"(i128 %x)
  ret void
}

define i128 @test_i128_output() {
; CHECK-LABEL: test_i128_output:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    //APP
; CHECK-NEXT:    // x0
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
entry:
  %r = call i128 asm sideeffect "// $0", "=r"()
  ret i128 %r
}

; The asm doesn't change its operand, so the function returns its argument.
define i128 @test_i128_tied(i128 %x) {
; CHECK-LABEL: test_i128_tied:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    //APP
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
entry:
  %r = call i128 asm sideeffect "", "=&r,0"(i128 %x)
  ret i128 %r
}

; %H names the second register of an i128, so an asm can use both halves.
define void @test_i128_store(ptr %p, i128 %x) {
; CHECK-LABEL: test_i128_store:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    //APP
; CHECK-NEXT:    stp x2, x3, [x0]
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    ret
entry:
  call void asm sideeffect "stp $1, ${1:H}, [$0]", "r,r,~{memory}"(ptr %p, i128 %x)
  ret void
}

define i128 @test_i128_load(ptr %p) {
; CHECK-LABEL: test_i128_load:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    //APP
; CHECK-NEXT:    ldp x8, x1, [x0]
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    mov x0, x8
; CHECK-NEXT:    ret
entry:
  %r = call i128 asm sideeffect "ldp $0, ${0:H}, [$1]", "=&r,r,~{memory}"(ptr %p)
  ret i128 %r
}

; As in GCC, the first register holds the doubleword at the lower address. So
; the high half is in the second register on little-endian, and in the first
; on big-endian.
define i64 @test_i128_high_half() {
; LE-LABEL: test_i128_high_half:
; LE:       // %bb.0: // %entry
; LE-NEXT:    //APP
; LE-NEXT:    // x8 x0
; LE-NEXT:    //NO_APP
; LE-NEXT:    ret
;
; BE-LABEL: test_i128_high_half:
; BE:       // %bb.0: // %entry
; BE-NEXT:    //APP
; BE-NEXT:    // x0 x8
; BE-NEXT:    //NO_APP
; BE-NEXT:    ret
entry:
  %r = call i128 asm sideeffect "// $0 ${0:H}", "=r"()
  %hi = lshr i128 %r, 64
  %t = trunc i128 %hi to i64
  ret i64 %t
}

; A floating-point value or a vector goes in X registers the same way, so
; "stp $1, ${1:H}" stores the same bytes that a plain store of it would.
