; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    ldp x8, x9, [sp]
; CHECK-NEXT:    //APP
; CHECK-NEXT:    stp x8, x9, [x0]
; CHECK-NEXT:    //NO_APP
; CHECK-NEXT:    add sp, sp, #16
; CHECK-NEXT:    ret
entry:
  call void asm sideeffect "stp $1, ${1:H}, [$0]", "r,r,~{memory}"(ptr %p, fp128 %x)
  ret void
}

define fp128 @test_fp128_load(ptr %p) {
