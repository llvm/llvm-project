; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s --mattr=+complxnum,+neon,+fullfp16 -o - | FileCheck %s

target triple = "aarch64"

; The real or imaginary part is a shufflevector that starts at the right lane
; but is not a deinterleave of its source. It must not be treated as one.

; Expected to not transform: the real part of %a is its low half (mask <0, 1>),
; not its even lanes.
define <4 x double> @mul_real_low_half(<4 x double> %a, <4 x double> %b) {
; CHECK-LABEL: mul_real_low_half:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    zip2 v4.2d, v2.2d, v3.2d
; CHECK-NEXT:    zip2 v1.2d, v0.2d, v1.2d
; CHECK-NEXT:    zip1 v2.2d, v2.2d, v3.2d
; CHECK-NEXT:    fmul v3.2d, v1.2d, v4.2d
; CHECK-NEXT:    fmul v1.2d, v1.2d, v2.2d
; CHECK-NEXT:    fneg v3.2d, v3.2d
; CHECK-NEXT:    fmla v1.2d, v4.2d, v0.2d
; CHECK-NEXT:    fmla v3.2d, v2.2d, v0.2d
; CHECK-NEXT:    zip1 v0.2d, v3.2d, v1.2d
; CHECK-NEXT:    zip2 v1.2d, v3.2d, v1.2d
; CHECK-NEXT:    ret
entry:
  %a.real = shufflevector <4 x double> %a, <4 x double> poison, <2 x i32> <i32 0, i32 1>
  %a.imag = shufflevector <4 x double> %a, <4 x double> poison, <2 x i32> <i32 1, i32 3>
  %b.real = shufflevector <4 x double> %b, <4 x double> poison, <2 x i32> <i32 0, i32 2>
  %b.imag = shufflevector <4 x double> %b, <4 x double> poison, <2 x i32> <i32 1, i32 3>
  %0 = fmul contract <2 x double> %a.real, %b.real
  %1 = fmul contract <2 x double> %a.imag, %b.imag
  %2 = fmul contract <2 x double> %a.real, %b.imag
  %3 = fmul contract <2 x double> %a.imag, %b.real
  %4 = fsub contract <2 x double> %0, %1
  %5 = fadd contract <2 x double> %2, %3
  %interleaved.vec = shufflevector <2 x double> %4, <2 x double> %5, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
  ret <4 x double> %interleaved.vec
}

