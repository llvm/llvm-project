; CHECK-NEXT:    st1h { z2.s }, p1, [x2, z3.s, sxtw #1]
; CHECK-NEXT:    cmpne p1.s, p0/z, z1.s, #0
; CHECK-NEXT:    st1h { z0.s }, p1, [x2, z4.s, sxtw #1]
