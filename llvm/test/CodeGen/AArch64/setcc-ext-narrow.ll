; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=aarch64-- | FileCheck %s

; (setcc (sext a), (sext b), sets??) -> (setcc a, b, sets??)

; i128 is not legal, so the wide compare gets expanded.
define i1 @sext_cmp_i64_i128(i64 %a, i64 %b) {
; CHECK-LABEL: sext_cmp_i64_i128:
; CHECK:       // %bb.0:
; CHECK-NEXT:    cmp x0, x1
; CHECK-NEXT:    cset w0, gt
; CHECK-NEXT:    ret
  %sa = sext i64 %a to i128
  %sb = sext i64 %b to i128
  %cond = icmp sgt i128 %sa, %sb
  ret i1 %cond
}

; Negative test: i32 is legal and the target does not narrow scalars.
define i1 @sext_cmp_i8_i32(i8 %a, i8 %b) {
; CHECK-LABEL: sext_cmp_i8_i32:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sxtb w8, w0
; CHECK-NEXT:    cmp w8, w1, sxtb
; CHECK-NEXT:    cset w0, lt
; CHECK-NEXT:    ret
  %sa = sext i8 %a to i32
  %sb = sext i8 %b to i32
  %cond = icmp slt i32 %sa, %sb
  ret i1 %cond
}

