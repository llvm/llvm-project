    ; CHECK-NEXT: $xzr = SUBSXri $sp, 0, 0, implicit-def $nzcv
    ; CHECK-NEXT: $x16 = CSINVXr $xzr, $xzr, 0, implicit $nzcv
    ; CHECK-NEXT: early-clobber renamable $x0, renamable $w9 = LDRWpost killed renamable $x0, 4 :: (load (s32))
    ; CHECK-NEXT: $x0 = ANDXrs killed $x0, $x16, 0
    ; CHECK-NEXT: $w9 = ANDWrs killed $w9, $w16, 0
    ; CHECK-NEXT: renamable $w1 = SUBSWri killed renamable $w1, 1, 0, implicit-def $nzcv
    ; CHECK-NEXT: HINT 20
    ; CHECK-NEXT: $w0 = ADDWrs killed renamable $w9, killed renamable $w1, 0
    ; CHECK-NEXT: $x1 = ADDXri $sp, 0, 0
    ; CHECK-NEXT: renamable $x1 = ANDXrs killed renamable $x1, killed $x16, 0
    ; CHECK-NEXT: $sp = ADDXri killed $x1, 0, 0
    ; CHECK-NEXT: RET undef $lr, implicit $w0
    early-clobber renamable $x0, renamable $w9 = LDRWpost killed renamable $x0, 4 :: (load (s32))
    renamable $w1 = SUBSWri killed renamable $w1, 1, 0, implicit-def $nzcv
    $w0 = ADDWrs killed renamable $w9, killed renamable $w1, 0
    RET undef $lr, implicit $w0
...
