# Check that a DBG_VALUE that reads a masked register does not move the CSDB:
# it must still be inserted just before the first real use of the masked value.
--- |
  define i32 @csdb_debug_value(ptr %p, i32 %n) speculative_load_hardening {
    ret i32 0
  }
...
---
name:            csdb_debug_value
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $w1, $x0

    ; CHECK-LABEL: name: csdb_debug_value
