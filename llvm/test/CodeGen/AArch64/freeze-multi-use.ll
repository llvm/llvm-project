; RUN: llc -mtriple=aarch64-- < %s | FileCheck %s

; Every use of a frozen value must observe the same value.

; The multiply and the shift must read the same value.
define i32 @ashr_mul(i32 %x) {
; CHECK-LABEL: ashr_mul:
; CHECK:       // %bb.0:
; CHECK-NEXT:    asr w8, w8, #3
; CHECK-NEXT:    mul w0, w8, w8
; CHECK-NEXT:    ret
  %p = ashr i32 %x, 32
  %w = freeze i32 %p
  %s = ashr i32 %w, 3
  %r = mul i32 %w, %s
  ret i32 %r
}

; Both halves of the funnel shift must use the same shift amount.
define i8 @fshr(i32 %x) {
; CHECK-LABEL: fshr:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mvn w8, w8
; CHECK-NEXT:    mov w9, #2 // =0x2
; CHECK-NEXT:    lsr w10, w0, w8
; CHECK-NEXT:    lsl w8, w9, w8
; CHECK-NEXT:    orr w0, w8, w10
; CHECK-NEXT:    ret
  %w = freeze i32 poison
  %f = call i32 @llvm.fshr.i32(i32 1, i32 %x, i32 %w)
  %r = trunc i32 %f to i8
  ret i8 %r
}

; The select condition and the zext must read the same bit.
define i64 @select_zext(i64 %a, i64 %b) {
; CHECK-LABEL: select_zext:
; CHECK:       // %bb.0:
; CHECK-NEXT:    tst w8, #0x1
; CHECK-NEXT:    csel x8, x0, x1, ne
; CHECK-NEXT:    and x9, x8, #0x1
; CHECK-NEXT:    add x0, x8, x9
; CHECK-NEXT:    ret
  %w = freeze i1 poison
  %s = select i1 %w, i64 %a, i64 %b
  %z = zext i1 %w to i64
  %r = add i64 %s, %z
  ret i64 %r
}

; The fcmp and the bitcast must see the same float, so the result is 0.
define i32 @float_bits() {
; CHECK-LABEL: float_bits:
; CHECK:       // %bb.0:
; CHECK-NEXT:    fcmp s0, s0
; CHECK-NEXT:    and w8, w8, #0x7fffffff
; CHECK-NEXT:    mov w9, #2139095040 // =0x7f800000
; CHECK-NEXT:    cset w10, vs
; CHECK-NEXT:    cmp w8, w9
; CHECK-NEXT:    cset w8, hi
; CHECK-NEXT:    eor w0, w10, w8
; CHECK-NEXT:    ret
  %w = freeze float poison
  %c = fcmp uno float %w, 0.0
  %b = bitcast float %w to i32
  %e = and i32 %b, 2147483647
  %n = icmp ugt i32 %e, 2139095040
  %x = xor i1 %c, %n
  %r = zext i1 %x to i32
  ret i32 %r
}

; The result must be element 0 of %x.
define i32 @vector_lane_and_whole(<4 x i32> %x) {
; CHECK-LABEL: vector_lane_and_whole:
; CHECK:       // %bb.0:
; CHECK-NEXT:    add v0.4s, v0.4s, v0.4s
; CHECK-NEXT:    fmov w8, s0
; CHECK-NEXT:    sub w0, w8, w8
; CHECK-NEXT:    ret
  %w = freeze <4 x i32> poison
  %e0 = extractelement <4 x i32> %w, i32 0
  %y = add <4 x i32> %w, %x
  %e1 = extractelement <4 x i32> %y, i32 0
  %r = sub i32 %e1, %e0
  ret i32 %r
}

