# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64-linux-gnu -run-pass=aarch64-ldst-opt -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "aarch64-none-linux-gnu"

  define void @f(ptr %p, i32 %v, i32 %c) !dbg !5 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !6, unit: !0, spFlags: DISPFlagDefinition, retainedNodes: !10)
  !6 = !DISubroutineType(types: !{})
  !7 = !DILocalVariable(name: "p", scope: !5, file: !1, line: 1, type: !8)
  !8 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: 64)
  !9 = !DILocation(line: 1, scope: !5)
  !10 = !{!7}
...
---
name:            f
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: f
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $w1, $w2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   early-clobber renamable $x0 = STRWpost killed renamable $w1, renamable $x0, 4 :: (store (s32))
  ; CHECK-NEXT:   CBZW killed renamable $w2, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_VALUE $x0, $noreg, !7, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   STRWui $wzr, killed renamable $x0, 0 :: (store (s32))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET undef $lr
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $w1, $w2

    STRWui killed renamable $w1, renamable $x0, 0 :: (store (s32))
    CBZW killed renamable $w2, %bb.2

  bb.1:
    successors: %bb.2
    liveins: $x0

    DBG_VALUE $x0, $noreg, !7, !DIExpression(), debug-location !9
    renamable $x0 = ADDXri killed renamable $x0, 4, 0
    STRWui $wzr, killed renamable $x0, 0 :: (store (s32))

  bb.2:
    RET undef $lr
...
