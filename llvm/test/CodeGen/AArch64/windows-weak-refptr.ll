; Taking the address of an extern_weak symbol must yield null when the symbol
; is undefined. COFF cannot encode a PC-relative ADRP reference to null, so
; the address is loaded from a .refptr stub that the linker can zero-fill.
; (A call to the same symbol stays a direct BL; see
; windows-extern-weak-dso-local.ll.)

@weakvar = extern_weak dso_local local_unnamed_addr global i32, align 4

define ptr @addr_fn() {
; CHECK-LABEL: addr_fn:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    adrp x0, .refptr.weakfn
; CHECK-NEXT:    ldr x0, [x0, :lo12:.refptr.weakfn]
; CHECK-NEXT:    ret
;
; FISEL-LABEL: addr_fn:
; FISEL:       // %bb.0: // %entry
; FISEL-NEXT:    adrp x8, .refptr.weakfn
; FISEL-NEXT:    ldr x0, [x8, :lo12:.refptr.weakfn]
; FISEL-NEXT:    ret
entry:
  ret ptr @weakfn
}

define ptr @addr_var() {
; CHECK-LABEL: addr_var:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    adrp x0, .refptr.weakvar
; CHECK-NEXT:    ldr x0, [x0, :lo12:.refptr.weakvar]
; CHECK-NEXT:    ret
;
; FISEL-LABEL: addr_var:
; FISEL:       // %bb.0: // %entry
; FISEL-NEXT:    adrp x8, .refptr.weakvar
; FISEL-NEXT:    ldr x0, [x8, :lo12:.refptr.weakvar]
; FISEL-NEXT:    ret
entry:
  ret ptr @weakvar
}

declare extern_weak dso_local ptr @weakfn()
