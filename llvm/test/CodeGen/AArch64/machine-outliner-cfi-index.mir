# RUN: llc -mtriple=aarch64-linux-gnu -run-pass=machine-outliner \
# RUN:   -enable-machine-outliner=always -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Record how MachineOutliner handles tails whose CFI indices match but whose
# CFI rules differ. CFI indices are local to each function: index 0 describes
# CFA offset 16 in f, but CFA offset 32 in g.
#
# f allocates 16 bytes on the stack and g allocates 32. The instructions after
# the allocation are otherwise identical. Each tail contains all of its
# function's CFI instructions and ends in a return, so both tails pass the
# target's existing CFI checks.
#
# FIXME: MachineOutliner compares the CFI indices without checking the rules
# they refer to. It therefore maps these different rules to the same integer
# and moves both tails into one helper. The helper copies f's CFA offset 16,
# which is wrong when reached from g, until the stack pointer is restored.
# MachineOutliner should keep these incompatible tails separate.
#
# CHECK-LABEL: name: f
# CHECK-NOT: CFI_INSTRUCTION
# CHECK: TCRETURNdi @OUTLINED_FUNCTION_0
# CHECK-NOT: CFI_INSTRUCTION
# CHECK-LABEL: name: g
# CHECK-NOT: CFI_INSTRUCTION
# CHECK: TCRETURNdi @OUTLINED_FUNCTION_0
# CHECK-NOT: CFI_INSTRUCTION
# CHECK-LABEL: name: OUTLINED_FUNCTION_0
# CHECK-NOT: CFI_INSTRUCTION def_cfa_offset 32
# CHECK: CFI_INSTRUCTION def_cfa_offset 16
# CHECK-NOT: CFI_INSTRUCTION def_cfa_offset 32
# CHECK: CFI_INSTRUCTION def_cfa_offset 0
# CHECK-NOT: CFI_INSTRUCTION

--- |
  define void @f() #0 { ret void }
  define void @g() #0 { ret void }
  attributes #0 = { noredzone nounwind uwtable }
...
---
name: f
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $lr
    $x9 = ADDXri $sp, 0, 0
    $sp = SUBXri $sp, 16, 0
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    $w10 = ORRWri $wzr, 1
    $w11 = ORRWri $wzr, 2
    $w12 = ORRWri $wzr, 3
    $w13 = ORRWri $wzr, 4
    $w14 = ORRWri $wzr, 5
    $w15 = ORRWri $wzr, 6
    $sp = ADDXri $x9, 0, 0
    frame-destroy CFI_INSTRUCTION def_cfa_offset 0
    RET undef $lr
...
---
name: g
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $lr
    $x9 = ADDXri $sp, 0, 0
    $sp = SUBXri $sp, 32, 0
    frame-setup CFI_INSTRUCTION def_cfa_offset 32
    $w10 = ORRWri $wzr, 1
    $w11 = ORRWri $wzr, 2
    $w12 = ORRWri $wzr, 3
    $w13 = ORRWri $wzr, 4
    $w14 = ORRWri $wzr, 5
    $w15 = ORRWri $wzr, 6
    $sp = ADDXri $x9, 0, 0
    frame-destroy CFI_INSTRUCTION def_cfa_offset 0
    RET undef $lr
...
