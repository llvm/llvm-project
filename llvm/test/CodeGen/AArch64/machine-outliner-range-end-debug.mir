# RUN: llc -mtriple=aarch64 -run-pass=machine-outliner -enable-machine-outliner \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# x16 is live from its definition to the use in the instruction that defines
# x5, so the outlinable range ends one instruction after the definition of x16.
# A DBG_VALUE between them must not move the end of that range. Without the
# DBG_VALUE, the definition of x4 is part of the outlined sequence.

# CHECK-LABEL: name: f0
# CHECK:       BL @OUTLINED_FUNCTION_0
# CHECK-NEXT:  $x5 = ADDXri $x16, 5, 0
# CHECK-LABEL: name: OUTLINED_FUNCTION_0
# CHECK:       $x16 = ADDXri $x0, 16, 0
# CHECK-NEXT:  $x4 = ADDXri $x0, 4, 0
# CHECK-NEXT:  RET $lr

--- |
  define void @f0() !dbg !5 { ret void }
  define void @f1() !dbg !10 { ret void }
  define void @f2() !dbg !12 { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "t", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = !DISubroutineType(types: !{})
  !5 = distinct !DISubprogram(name: "f0", scope: !1, file: !1, line: 1, type: !4, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !6 = !DILocalVariable(name: "v", scope: !5, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, scope: !5)
  !10 = distinct !DISubprogram(name: "f1", scope: !1, file: !1, line: 2, type: !4, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !11 = !DILocalVariable(name: "v", scope: !10, file: !1, line: 2, type: !7)
  !13 = !DILocation(line: 2, scope: !10)
  !12 = distinct !DISubprogram(name: "f2", scope: !1, file: !1, line: 3, type: !4, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !14 = !DILocalVariable(name: "v", scope: !12, file: !1, line: 3, type: !7)
  !15 = !DILocation(line: 3, scope: !12)
...
---
name:            f0
tracksRegLiveness: true
machineFunctionInfo:
  hasRedZone: false
body:             |
  bb.0:
    liveins: $x0, $lr
    $x1 = ADDXri $x0, 1, 0
    $x2 = ADDXri $x0, 2, 0
    $x3 = ADDXri $x0, 3, 0
    $x6 = ADDXri $x0, 6, 0
    $x7 = ADDXri $x0, 7, 0
    $x8 = ADDXri $x0, 8, 0
    $x9 = ADDXri $x0, 9, 0
    $x10 = ADDXri $x0, 10, 0
    $x11 = ADDXri $x0, 11, 0
    $x12 = ADDXri $x0, 12, 0
    $x16 = ADDXri $x0, 16, 0
    DBG_VALUE $x16, $noreg, !6, !DIExpression(), debug-location !8
    $x4 = ADDXri $x0, 4, 0
    $x5 = ADDXri $x16, 5, 0
    RET undef $lr, implicit $x6, implicit $x7, implicit $x8, implicit $x9, implicit $x10, implicit $x11, implicit $x12, implicit $x1, implicit $x2, implicit $x3, implicit $x4, implicit $x5
---
name:            f1
tracksRegLiveness: true
machineFunctionInfo:
  hasRedZone: false
body:             |
  bb.0:
    liveins: $x0, $lr
    $x1 = ADDXri $x0, 1, 0
    $x2 = ADDXri $x0, 2, 0
    $x3 = ADDXri $x0, 3, 0
    $x6 = ADDXri $x0, 6, 0
    $x7 = ADDXri $x0, 7, 0
    $x8 = ADDXri $x0, 8, 0
    $x9 = ADDXri $x0, 9, 0
    $x10 = ADDXri $x0, 10, 0
    $x11 = ADDXri $x0, 11, 0
    $x12 = ADDXri $x0, 12, 0
    $x16 = ADDXri $x0, 16, 0
    DBG_VALUE $x16, $noreg, !11, !DIExpression(), debug-location !13
    $x4 = ADDXri $x0, 4, 0
    $x5 = ADDXri $x16, 5, 0
    RET undef $lr, implicit $x6, implicit $x7, implicit $x8, implicit $x9, implicit $x10, implicit $x11, implicit $x12, implicit $x1, implicit $x2, implicit $x3, implicit $x4, implicit $x5
---
name:            f2
tracksRegLiveness: true
machineFunctionInfo:
  hasRedZone: false
body:             |
  bb.0:
    liveins: $x0, $lr
    $x1 = ADDXri $x0, 1, 0
    $x2 = ADDXri $x0, 2, 0
    $x3 = ADDXri $x0, 3, 0
    $x6 = ADDXri $x0, 6, 0
    $x7 = ADDXri $x0, 7, 0
    $x8 = ADDXri $x0, 8, 0
    $x9 = ADDXri $x0, 9, 0
    $x10 = ADDXri $x0, 10, 0
    $x11 = ADDXri $x0, 11, 0
    $x12 = ADDXri $x0, 12, 0
    $x16 = ADDXri $x0, 16, 0
    DBG_VALUE $x16, $noreg, !14, !DIExpression(), debug-location !15
    $x4 = ADDXri $x0, 4, 0
    $x5 = ADDXri $x16, 5, 0
    RET undef $lr, implicit $x6, implicit $x7, implicit $x8, implicit $x9, implicit $x10, implicit $x11, implicit $x12, implicit $x1, implicit $x2, implicit $x3, implicit $x4, implicit $x5
