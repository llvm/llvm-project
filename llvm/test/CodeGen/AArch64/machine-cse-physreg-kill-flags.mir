# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64 -passes=machine-cse -o - %s | FileCheck %s

---
name: same_block
body: |
  bb.0:
    liveins: $w0, $w1

    ; CHECK-LABEL: name: same_block
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[COPY]], [[COPY1]], implicit-def $nzcv
    ; CHECK-NEXT: [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
    ; CHECK-NEXT: [[CSINCWr1:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 0, implicit killed $nzcv
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr]], [[CSINCWr1]]
    ; CHECK-NEXT: $w0 = COPY [[ADDWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = SUBSWrr %0, %1, implicit-def $nzcv
    %3:gpr32 = CSINCWr $wzr, $wzr, 1, implicit killed $nzcv
    %4:gpr32 = SUBSWrr %0, %1, implicit-def $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 0, implicit killed $nzcv
    %6:gpr32 = ADDWrr %3, %5
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...

---
name: cross_block
body: |
  ; CHECK-LABEL: name: cross_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
  ; CHECK-NEXT:   [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[COPY]], [[COPY1]], implicit-def $nzcv
  ; CHECK-NEXT:   [[CSINCWr:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 1, implicit $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $nzcv
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[CSINCWr1:%[0-9]+]]:gpr32 = CSINCWr $wzr, $wzr, 0, implicit killed $nzcv
  ; CHECK-NEXT:   [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[CSINCWr]], [[CSINCWr1]]
  ; CHECK-NEXT:   $w0 = COPY [[ADDWrr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1

    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = SUBSWrr %0, %1, implicit-def $nzcv
    %3:gpr32 = CSINCWr $wzr, $wzr, 1, implicit killed $nzcv

  bb.1:
    %4:gpr32 = SUBSWrr %0, %1, implicit-def $nzcv
    %5:gpr32 = CSINCWr $wzr, $wzr, 0, implicit killed $nzcv
    %6:gpr32 = ADDWrr %3, %5
    $w0 = COPY %6
    RET_ReallyLR implicit $w0
...
