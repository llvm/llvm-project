# REQUIRES: asserts

# RUN: llc -filetype=null %s -mtriple=aarch64-linux-gnu -mattr=+fuse-movz-movk -passes=machine-scheduler -misched-print-dags 2>&1 | FileCheck %s --check-prefixes=CHECK,FUSE
# RUN: llc -filetype=null %s -mtriple=arm64-apple-macosx -mcpu=apple-a14 -passes=machine-scheduler -misched-print-dags 2>&1 | FileCheck %s --check-prefixes=CHECK,FUSE
# RUN: llc -filetype=null %s -mtriple=arm64-apple-macosx -mcpu=apple-m5 -passes=machine-scheduler -misched-print-dags 2>&1 | FileCheck %s --check-prefixes=CHECK,FUSE

# RUN: llc -filetype=null %s -mtriple=aarch64-linux-gnu -passes=machine-scheduler -misched-print-dags 2>&1 | FileCheck %s --check-prefixes=CHECK,NOFUSE
# RUN: llc -filetype=null %s -mtriple=arm64-apple-macosx -mcpu=apple-m5 -mattr=-fuse-movz-movk -passes=machine-scheduler -misched-print-dags 2>&1 | FileCheck %s --check-prefixes=CHECK,NOFUSE

---
name: movzw0_movkw0_waw
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: movzw0_movkw0_waw
    ; CHECK: SU(0): $w0 = MOVZWi 1, 0
    ; CHECK: Successors:
    ; FUSE: SU(2): Ord  Latency={{[0-9]+}} Cluster
    ; NOFUSE-NOT: SU(2): Ord  Latency={{[0-9]+}} Cluster
    ; CHECK: SU(2): $w0 = MOVKWi $w0(tied-def 0), 2, 0
    $w0 = MOVZWi 1, 0
    $w9 = MOVZWi 9, 0
    $w0 = MOVKWi $w0, 2, 0
...

---
name: movzw0_movkw0_nowaw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: movzw0_movkw0_nowaw
    ; CHECK: SU(0): $w1 = MOVZWi 1, 0
    ; CHECK-NOT: Cluster
    ; CHECK: SU(2): $w0 = MOVKWi $w0(tied-def 0), 2, 0
    $w1 = MOVZWi 1, 0
    $w9 = MOVZWi 9, 0
    $w0 = MOVKWi $w0, 2, 0
...

