; A big select group in an outer-loop latch should not be converted to a branch
; if a later select in the group is unpredictable, even when leading elements
; are select-like binary operations that cannot carry !unpredictable metadata.
define i64 @outer_latch_group_later_unpred(i64 %n, i64 %dim, i64 %c, i64 %d) {
; CHECK-LABEL: define i64 @outer_latch_group_later_unpred(
; CHECK-SAME: i64 [[N:%.*]], i64 [[DIM:%.*]], i64 [[C:%.*]], i64 [[D:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[K:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[K_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[DIM]], %[[OUTER]] ], [ [[IV_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[V:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[CALL:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[CALL]] = tail call i64 @payload(i64 [[V]])
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], -1
; CHECK-NEXT:    [[INNER_DONE:%.*]] = icmp eq i64 [[IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[INNER_DONE]], label %[[LATCH]], label %[[INNER]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i64 [[CALL]], -1
; CHECK-NEXT:    [[LOBIT:%.*]] = lshr i64 [[CALL]], 63
; CHECK-NEXT:    [[I_NEXT]] = add nsw i64 [[LOBIT]], [[I]]
; CHECK-NEXT:    [[INC:%.*]] = zext i1 [[CMP]] to i64
; CHECK-NEXT:    [[J_NEXT]] = add nsw i64 [[J]], [[INC]]
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[CMP]], i64 [[C]], i64 [[D]], !unpredictable [[META1]]
; CHECK-NEXT:    [[SUM1:%.*]] = add i64 [[I_NEXT]], [[J_NEXT]]
; CHECK-NEXT:    [[SUM2:%.*]] = add i64 [[SUM1]], [[SEL]]
; CHECK-NEXT:    [[ACC_NEXT]] = add i64 [[ACC]], [[SUM2]]
; CHECK-NEXT:    [[K_NEXT]] = add i64 [[K]], 1
; CHECK-NEXT:    [[OUTER_DONE:%.*]] = icmp eq i64 [[K_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OUTER_DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 [[ACC_NEXT]]
;
entry:
  br label %outer

outer:
  %k = phi i64 [ 0, %entry ], [ %k.next, %latch ]
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %j = phi i64 [ 0, %entry ], [ %j.next, %latch ]
  %acc = phi i64 [ 0, %entry ], [ %acc.next, %latch ]
  br label %inner

inner:
  %iv = phi i64 [ %dim, %outer ], [ %iv.next, %inner ]
  %v = phi i64 [ 0, %outer ], [ %call, %inner ]
  %call = tail call i64 @payload(i64 %v)
  %iv.next = add i64 %iv, -1
  %inner.done = icmp eq i64 %iv.next, 0
  br i1 %inner.done, label %latch, label %inner

latch:
  %cmp = icmp sgt i64 %call, -1
  %lobit = lshr i64 %call, 63
  %i.next = add nsw i64 %lobit, %i
  %inc = zext i1 %cmp to i64
  %j.next = add nsw i64 %j, %inc
  %sel = select i1 %cmp, i64 %c, i64 %d, !unpredictable !2
  %sum1 = add i64 %i.next, %j.next
  %sum2 = add i64 %sum1, %sel
  %acc.next = add i64 %acc, %sum2
  %k.next = add i64 %k, 1
  %outer.done = icmp eq i64 %k.next, %n
  br i1 %outer.done, label %exit, label %outer

exit:
  ret i64 %acc.next
}

