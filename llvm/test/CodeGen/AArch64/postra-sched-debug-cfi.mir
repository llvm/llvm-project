# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -run-pass=postmisched %s -o - | FileCheck %s

# A DBG_VALUE or PSEUDO_PROBE between the last store and the CFI must not change
# the scheduling regions; otherwise the stores could be reordered only when
# such instructions are present.

--- |
  target triple = "aarch64"

  define void @pseudo_probe(ptr noalias %p, ptr noalias %q, ptr noalias %r) {
    ret void
  }

  define void @f(ptr noalias %p, ptr noalias %q, ptr noalias %r) !dbg !3 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !4 = !DISubroutineType(types: !5)
  !5 = !{null}
  !6 = !DILocalVariable(name: "x", scope: !3, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 64, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
...
---
name:            pseudo_probe
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $x0, $x1, $x2, $lr

    ; CHECK-LABEL: name: pseudo_probe
    ; CHECK: liveins: $x0, $x1, $x2, $lr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x8 = LDRXui killed renamable $x0, 0 :: (load (s64) from %ir.p)
    ; CHECK-NEXT: STRXui killed renamable $x8, killed renamable $x1, 0 :: (store (s64) into %ir.q)
    ; CHECK-NEXT: STRXui $xzr, killed renamable $x2, 0 :: (store (s64) into %ir.r)
    ; CHECK-NEXT: PSEUDO_PROBE 1, 1, 0, 0
    ; CHECK-NEXT: frame-destroy CFI_INSTRUCTION def_cfa $wsp, 0
    ; CHECK-NEXT: RET undef $lr
    renamable $x8 = LDRXui renamable $x0, 0 :: (load (s64) from %ir.p)
    STRXui killed renamable $x8, renamable $x1, 0 :: (store (s64) into %ir.q)
    STRXui $xzr, renamable $x2, 0 :: (store (s64) into %ir.r)
    PSEUDO_PROBE 1, 1, 0, 0
    frame-destroy CFI_INSTRUCTION def_cfa $wsp, 0
    RET undef $lr
...
---
name:            f
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $x0, $x1, $x2, $lr

    ; CHECK-LABEL: name: f
    ; CHECK: liveins: $x0, $x1, $x2, $lr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $x8 = LDRXui killed renamable $x0, 0 :: (load (s64) from %ir.p)
    ; CHECK-NEXT: STRXui killed renamable $x8, killed renamable $x1, 0 :: (store (s64) into %ir.q)
    ; CHECK-NEXT: STRXui $xzr, killed renamable $x2, 0 :: (store (s64) into %ir.r)
    ; CHECK-NEXT: DBG_VALUE 0, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, column: 1, scope: !3)
    ; CHECK-NEXT: frame-destroy CFI_INSTRUCTION def_cfa $wsp, 0
    ; CHECK-NEXT: RET undef $lr
    renamable $x8 = LDRXui renamable $x0, 0 :: (load (s64) from %ir.p)
    STRXui killed renamable $x8, renamable $x1, 0 :: (store (s64) into %ir.q)
    STRXui $xzr, renamable $x2, 0 :: (store (s64) into %ir.r)
    DBG_VALUE 0, $noreg, !6, !DIExpression(), debug-location !8
    frame-destroy CFI_INSTRUCTION def_cfa $wsp, 0
    RET undef $lr
...
