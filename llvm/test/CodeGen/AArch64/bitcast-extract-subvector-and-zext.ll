; DAGCombiner folds (zext (and (bitcast (extract_subvector vNi1, 0)) cst)) into an
; AND on the wider bitcast, treating the bitcast+extract as a truncate of
; bitcast vNi1 -> iN. That is only true on little-endian: on big-endian lane 0
; of the bitcast is the most significant bit, so the low bits of the wider
; bitcast hold the last lanes rather than the extracted first ones.
;
; Lanes 8..15 of the compare must survive the "and 255", i.e. the first half of
; each argument (v0/v2) has to be used. Reading v1/v3 instead would mean the
; fold picked lanes 24..31.
;
; https://github.com/llvm/llvm-project/issues/244527

; RUN: llc -O2 -mtriple=aarch64_be-unknown-linux-gnu %s -o - | FileCheck %s --check-prefix=BE
; RUN: llc -O2 -mtriple=aarch64-unknown-linux-gnu %s -o - | FileCheck %s --check-prefix=LE

define i32 @and_bitcast_extract_subvector_zext(<32 x i8> %a, <32 x i8> %b) {
; BE-LABEL: and_bitcast_extract_subvector_zext:
; BE:       // %bb.0:
; BE-NEXT:    rev64 v1.16b, v2.16b
; BE-NEXT:    rev64 v0.16b, v0.16b
; BE-NEXT:    adrp x8, .LCPI0_0
; BE-NEXT:    add x8, x8, :lo12:.LCPI0_0
; BE-NEXT:    ext v1.16b, v1.16b, v1.16b, #8
; BE-NEXT:    ext v0.16b, v0.16b, v0.16b, #8
; BE-NEXT:    cmeq v0.16b, v0.16b, v1.16b
; BE-NEXT:    ld1 { v1.16b }, [x8]
; BE-NEXT:    and v0.16b, v0.16b, v1.16b
; BE-NEXT:    addp v0.16b, v0.16b, v0.16b
; BE-NEXT:    addp v0.16b, v0.16b, v0.16b
; BE-NEXT:    addp v0.16b, v0.16b, v0.16b
; BE-NEXT:    rev16 v0.16b, v0.16b
; BE-NEXT:    umov w8, v0.h[0]
; BE-NEXT:    and w0, w8, #0xff
; BE-NEXT:    ret
;
; LE-LABEL: and_bitcast_extract_subvector_zext:
; LE:       // %bb.0:
; LE-NEXT:    adrp x8, .LCPI0_0
; LE-NEXT:    cmeq v0.16b, v0.16b, v2.16b
; LE-NEXT:    ldr q1, [x8, :lo12:.LCPI0_0]
; LE-NEXT:    and v0.16b, v0.16b, v1.16b
; LE-NEXT:    addp v0.16b, v0.16b, v0.16b
; LE-NEXT:    addp v0.16b, v0.16b, v0.16b
; LE-NEXT:    addp v0.16b, v0.16b, v0.16b
; LE-NEXT:    umov w8, v0.h[0]
; LE-NEXT:    and w0, w8, #0xff
; LE-NEXT:    ret
  %c = icmp eq <32 x i8> %a, %b
  %s = shufflevector <32 x i1> %c, <32 x i1> poison, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %bc = bitcast <16 x i1> %s to i16
  %an = and i16 %bc, 255
  %z = zext i16 %an to i32
  ret i32 %z
}

