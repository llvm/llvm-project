; With a call to a returns_twice function, dynamic allocas are not
; instrumented, but static ones still are.
define void @returns_twice(i32 %n, ptr %buf) sanitize_memtag {
; CHECK-LABEL: define void @returns_twice(
; CHECK-SAME: i32 [[N:%.*]], ptr [[BUF:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[X:%.*]] = alloca { i32, [12 x i8] }, align 16
; CHECK-NEXT:    [[X_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[X]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[X_TAG]], i64 16)
; CHECK-NEXT:    [[R:%.*]] = call i32 @setjmp(ptr [[BUF]])
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i32 [[N]], align 1
; CHECK-NEXT:    call void @use(ptr [[X_TAG]])
; CHECK-NEXT:    call void @use(ptr [[VLA]])
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[X]], i64 16)
; CHECK-NEXT:    ret void
;
entry:
  %x = alloca i32, align 4
  %r = call i32 @setjmp(ptr %buf)
  %vla = alloca i8, i32 %n, align 1
  call void @use(ptr %x)
  call void @use(ptr %vla)
  ret void
}

; Functions without sanitize_memtag are left alone.
define void @no_sanitizer(i32 %n) {
