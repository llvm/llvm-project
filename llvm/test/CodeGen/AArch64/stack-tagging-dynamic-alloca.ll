; Allocas released in a loop body are tagged each iteration, and an inner
; scope's restore only releases the inner alloca. The base tag is computed
; once, before the loop.
define void @nested_scopes(i32 %n) sanitize_memtag {
; CHECK-LABEL: define void @nested_scopes(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[SP_OUTER:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 15
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -16
; CHECK-NEXT:    [[OUTER:%.*]] = alloca i8, i64 [[TMP3]], align 16
; CHECK-NEXT:    [[OUTER_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[OUTER]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[OUTER]] to i64
; CHECK-NEXT:    store i64 [[TMP4]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[OUTER_TAG]], i64 [[TMP3]])
; CHECK-NEXT:    call void @use(ptr [[OUTER_TAG]])
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[INNER_BB:.*]], label %[[LATCH]]
; CHECK:       [[INNER_BB]]:
; CHECK-NEXT:    [[SP_INNER:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    [[TMP5:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP6:%.*]] = mul i64 [[TMP5]], 1
; CHECK-NEXT:    [[TMP7:%.*]] = add i64 [[TMP6]], 15
; CHECK-NEXT:    [[TMP8:%.*]] = and i64 [[TMP7]], -16
; CHECK-NEXT:    [[INNER:%.*]] = alloca i8, i64 [[TMP8]], align 16
; CHECK-NEXT:    [[INNER_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[INNER]], ptr [[BASETAG]], i64 1)
; CHECK-NEXT:    [[TMP9:%.*]] = ptrtoint ptr [[INNER]] to i64
; CHECK-NEXT:    store i64 [[TMP9]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[INNER_TAG]], i64 [[TMP8]])
; CHECK-NEXT:    call void @use(ptr [[INNER_TAG]])
; CHECK-NEXT:    [[TMP10:%.*]] = call i64 @llvm.get.dynamic.area.offset.i64()
; CHECK-NEXT:    [[TMP11:%.*]] = ptrtoint ptr [[SP_INNER]] to i64
; CHECK-NEXT:    [[UNTAG_END1:%.*]] = add i64 [[TMP11]], [[TMP10]]
; CHECK-NEXT:    [[LAST_ALLOCA2:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP12:%.*]] = icmp ne i64 [[LAST_ALLOCA2]], 0
; CHECK-NEXT:    [[TMP13:%.*]] = icmp ule i64 [[LAST_ALLOCA2]], [[UNTAG_END1]]
; CHECK-NEXT:    [[TMP14:%.*]] = and i1 [[TMP12]], [[TMP13]]
; CHECK-NEXT:    [[TMP15:%.*]] = sub i64 [[UNTAG_END1]], [[LAST_ALLOCA2]]
; CHECK-NEXT:    [[UNTAG_SIZE3:%.*]] = select i1 [[TMP14]], i64 [[TMP15]], i64 0
; CHECK-NEXT:    [[TMP16:%.*]] = inttoptr i64 [[LAST_ALLOCA2]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP16]], i64 [[UNTAG_SIZE3]])
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP_INNER]])
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[TMP17:%.*]] = call i64 @llvm.get.dynamic.area.offset.i64()
; CHECK-NEXT:    [[TMP18:%.*]] = ptrtoint ptr [[SP_OUTER]] to i64
; CHECK-NEXT:    [[UNTAG_END4:%.*]] = add i64 [[TMP18]], [[TMP17]]
; CHECK-NEXT:    [[LAST_ALLOCA5:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP19:%.*]] = icmp ne i64 [[LAST_ALLOCA5]], 0
; CHECK-NEXT:    [[TMP20:%.*]] = icmp ule i64 [[LAST_ALLOCA5]], [[UNTAG_END4]]
; CHECK-NEXT:    [[TMP21:%.*]] = and i1 [[TMP19]], [[TMP20]]
; CHECK-NEXT:    [[TMP22:%.*]] = sub i64 [[UNTAG_END4]], [[LAST_ALLOCA5]]
; CHECK-NEXT:    [[UNTAG_SIZE6:%.*]] = select i1 [[TMP21]], i64 [[TMP22]], i64 0
; CHECK-NEXT:    [[TMP23:%.*]] = inttoptr i64 [[LAST_ALLOCA5]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP23]], i64 [[UNTAG_SIZE6]])
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP_OUTER]])
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C2:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C2]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP24:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP25:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP26:%.*]] = and i1 [[TMP24]], [[TMP25]]
; CHECK-NEXT:    [[TMP27:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP26]], i64 [[TMP27]], i64 0
; CHECK-NEXT:    [[TMP28:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP28]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %sp.outer = call ptr @llvm.stacksave.p0()
  %outer = alloca i8, i32 %n, align 1
  call void @use(ptr %outer)
  %c = call i1 @cond()
  br i1 %c, label %inner.bb, label %latch

inner.bb:
  %sp.inner = call ptr @llvm.stacksave.p0()
  %inner = alloca i8, i32 %n, align 1
  call void @use(ptr %inner)
  call void @llvm.stackrestore.p0(ptr %sp.inner)
  br label %latch

latch:
  call void @llvm.stackrestore.p0(ptr %sp.outer)
  %i.next = add i32 %i, 1
  %c2 = icmp ult i32 %i.next, %n
  br i1 %c2, label %loop, label %exit

exit:
  ret void
}

; Without static allocas, the base tag is inserted in the block of the dynamic
; alloca, which may begin with PHIs. It has to go after them.
define void @after_phi(i1 %c, i32 %a, i32 %b) sanitize_memtag {
; CHECK-LABEL: define void @after_phi(
; CHECK-SAME: i1 [[C:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[MERGE:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[N:%.*]] = phi i32 [ [[A]], %[[ENTRY]] ], [ [[B]], %[[T]] ]
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 15
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -16
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i64 [[TMP3]], align 16
; CHECK-NEXT:    [[VLA_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[VLA]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[VLA]] to i64
; CHECK-NEXT:    store i64 [[TMP4]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[VLA_TAG]], i64 [[TMP3]])
; CHECK-NEXT:    call void @use(ptr [[VLA_TAG]])
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP7:%.*]] = and i1 [[TMP5]], [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP7]], i64 [[TMP8]], i64 0
; CHECK-NEXT:    [[TMP9:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP9]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %t, label %merge

t:
  br label %merge

merge:
  %n = phi i32 [ %a, %entry ], [ %b, %t ]
  %vla = alloca i8, i32 %n, align 1
  call void @use(ptr %vla)
  ret void
}

