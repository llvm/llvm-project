; A scope with an early exit before the alloca shares one restore, as a
; compiler emits for a VLA declared after a conditional continue.
define void @early_exit_in_scope(i32 %n) sanitize_memtag {
; CHECK-LABEL: define void @early_exit_in_scope(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[CLEANUP:.*]], label %[[ALLOC:.*]]
; CHECK:       [[ALLOC]]:
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 15
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -16
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i64 [[TMP3]], align 16
; CHECK-NEXT:    [[VLA_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[VLA]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[VLA]] to i64
; CHECK-NEXT:    store i64 [[TMP4]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[VLA_TAG]], i64 [[TMP3]])
; CHECK-NEXT:    call void @use(ptr [[VLA_TAG]])
; CHECK-NEXT:    br label %[[CLEANUP]]
; CHECK:       [[CLEANUP]]:
; CHECK-NEXT:    [[TMP5:%.*]] = call i64 @llvm.get.dynamic.area.offset.i64()
; CHECK-NEXT:    [[TMP6:%.*]] = ptrtoint ptr [[SP]] to i64
; CHECK-NEXT:    [[UNTAG_END1:%.*]] = add i64 [[TMP6]], [[TMP5]]
; CHECK-NEXT:    [[LAST_ALLOCA2:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP7:%.*]] = icmp ne i64 [[LAST_ALLOCA2]], 0
; CHECK-NEXT:    [[TMP8:%.*]] = icmp ule i64 [[LAST_ALLOCA2]], [[UNTAG_END1]]
; CHECK-NEXT:    [[TMP9:%.*]] = and i1 [[TMP7]], [[TMP8]]
; CHECK-NEXT:    [[TMP10:%.*]] = sub i64 [[UNTAG_END1]], [[LAST_ALLOCA2]]
; CHECK-NEXT:    [[UNTAG_SIZE3:%.*]] = select i1 [[TMP9]], i64 [[TMP10]], i64 0
; CHECK-NEXT:    [[TMP11:%.*]] = inttoptr i64 [[LAST_ALLOCA2]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP11]], i64 [[UNTAG_SIZE3]])
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP12:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP13:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP14:%.*]] = and i1 [[TMP12]], [[TMP13]]
; CHECK-NEXT:    [[TMP15:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP14]], i64 [[TMP15]], i64 0
; CHECK-NEXT:    [[TMP16:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP16]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  %sp = call ptr @llvm.stacksave.p0()
  %c = call i1 @cond()
  br i1 %c, label %cleanup, label %alloc

alloc:
  %vla = alloca i8, i32 %n, align 1
  call void @use(ptr %vla)
  br label %cleanup

cleanup:
  call void @llvm.stackrestore.p0(ptr %sp)
  ret void
}

; The stacksave may be executed again after the alloca is made, in which case
; the restore does not release it.
define void @stacksave_reexecuted(i32 %n) sanitize_memtag {
; CHECK-LABEL: define void @stacksave_reexecuted(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[RELEASE:.*]], label %[[EXIT:.*]]
; CHECK:       [[RELEASE]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i64 @llvm.get.dynamic.area.offset.i64()
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[SP]] to i64
; CHECK-NEXT:    [[UNTAG_END1:%.*]] = add i64 [[TMP1]], [[TMP0]]
; CHECK-NEXT:    [[LAST_ALLOCA2:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = icmp ne i64 [[LAST_ALLOCA2]], 0
; CHECK-NEXT:    [[TMP3:%.*]] = icmp ule i64 [[LAST_ALLOCA2]], [[UNTAG_END1]]
; CHECK-NEXT:    [[TMP4:%.*]] = and i1 [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = sub i64 [[UNTAG_END1]], [[LAST_ALLOCA2]]
; CHECK-NEXT:    [[UNTAG_SIZE3:%.*]] = select i1 [[TMP4]], i64 [[TMP5]], i64 0
; CHECK-NEXT:    [[TMP6:%.*]] = inttoptr i64 [[LAST_ALLOCA2]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP6]], i64 [[UNTAG_SIZE3]])
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    br label %[[MAKE:.*]]
; CHECK:       [[MAKE]]:
; CHECK-NEXT:    [[TMP7:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP8:%.*]] = mul i64 [[TMP7]], 1
; CHECK-NEXT:    [[TMP9:%.*]] = add i64 [[TMP8]], 15
; CHECK-NEXT:    [[TMP10:%.*]] = and i64 [[TMP9]], -16
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i64 [[TMP10]], align 16
; CHECK-NEXT:    [[VLA_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[VLA]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP11:%.*]] = ptrtoint ptr [[VLA]] to i64
; CHECK-NEXT:    store i64 [[TMP11]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[VLA_TAG]], i64 [[TMP10]])
; CHECK-NEXT:    call void @use(ptr [[VLA_TAG]])
; CHECK-NEXT:    [[AGAIN:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[AGAIN]], label %[[HEADER]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP12:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP13:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP14:%.*]] = and i1 [[TMP12]], [[TMP13]]
; CHECK-NEXT:    [[TMP15:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP14]], i64 [[TMP15]], i64 0
; CHECK-NEXT:    [[TMP16:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP16]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  br label %header

header:
  %sp = call ptr @llvm.stacksave.p0()
  %c = call i1 @cond()
  br i1 %c, label %release, label %exit

release:
  call void @llvm.stackrestore.p0(ptr %sp)
  br label %make

make:
  %vla = alloca i8, i32 %n, align 1
  call void @use(ptr %vla)
  %again = call i1 @cond()
  br i1 %again, label %header, label %exit

exit:
  ret void
}

; An alloca in a loop that is never released is untagged, along with the
; allocas of earlier iterations, when the function returns.
define void @unreleased_in_loop(i32 %n) sanitize_memtag {
; CHECK-LABEL: define void @unreleased_in_loop(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 15
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -16
; CHECK-NEXT:    [[BUF:%.*]] = alloca i8, i64 [[TMP3]], align 16
; CHECK-NEXT:    [[BUF_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[BUF]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[BUF]] to i64
; CHECK-NEXT:    store i64 [[TMP4]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[BUF_TAG]], i64 [[TMP3]])
; CHECK-NEXT:    call void @use(ptr [[BUF_TAG]])
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP7:%.*]] = and i1 [[TMP5]], [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP7]], i64 [[TMP8]], i64 0
; CHECK-NEXT:    [[TMP9:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP9]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %buf = alloca i8, i32 %n, align 1
  call void @use(ptr %buf)
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

