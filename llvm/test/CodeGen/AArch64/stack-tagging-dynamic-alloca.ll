; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 15
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -16
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i64 [[TMP3]], align 16
; CHECK-NEXT:    [[VLA_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[VLA]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[VLA]] to i64
; CHECK-NEXT:    store i64 [[TMP4]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[VLA_TAG]], i64 [[TMP3]])
; CHECK-NEXT:    call void @use(ptr [[VLA_TAG]])
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP7:%.*]] = and i1 [[TMP5]], [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP7]], i64 [[TMP8]], i64 0
; CHECK-NEXT:    [[TMP9:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP9]], i64 [[UNTAG_SIZE]])
