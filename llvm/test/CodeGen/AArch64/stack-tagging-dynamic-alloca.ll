; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -S -aarch64-stack-tagging -stack-tagging-use-stack-safety=0 -o - | FileCheck %s
; RUN: llc < %s -mattr=+mte -o - | FileCheck %s --check-prefix=ASM
; RUN: opt < %s -S -aarch64-stack-tagging -stack-tagging-use-stack-safety=0 \
; RUN:   -stack-tagging-dynamic-allocas=0 -o - | not grep dynamic.alloca.layout

target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "aarch64"

%struct.S = type { i32, i32, i32 }

declare void @use(ptr)
declare i1 @cond()
declare void @abort() noreturn
declare i32 @setjmp(ptr) returns_twice
declare ptr @llvm.stacksave.p0()
declare void @llvm.stackrestore.p0(ptr)
declare void @llvm.lifetime.start.p0(ptr)
declare void @llvm.lifetime.end.p0(ptr)

; The size is rounded up to the tag granule and the allocation is tagged. Its
; address is recorded, and the memory between the most recent alloca and the
; address of the slot that holds it is untagged before returning.
define void @vla(i32 %n) sanitize_memtag {
; CHECK-LABEL: define void @vla(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR4:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[N]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[TMP0]], 12
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 15
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -16
; CHECK-NEXT:    [[VLA:%.*]] = alloca i8, i64 [[TMP3]], align 16
; CHECK-NEXT:    [[VLA_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[VLA]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[VLA]] to i64
; CHECK-NEXT:    store i64 [[TMP4]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[VLA_TAG]], i64 [[TMP3]])
; CHECK-NEXT:    call void @use(ptr [[VLA_TAG]])
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP7:%.*]] = and i1 [[TMP5]], [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP7]], i64 [[TMP8]], i64 0
; CHECK-NEXT:    [[TMP9:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP9]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
;
entry:
  %vla = alloca %struct.S, i32 %n, align 4
  call void @use(ptr %vla)
  ret void
}

; A constant-size alloca outside the entry block is dynamic.
define void @const_size(i1 %c) sanitize_memtag {
; CHECK-LABEL: define void @const_size(
; CHECK-SAME: i1 [[C:%.*]]) #[[ATTR4]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DYNAMIC_ALLOCA_LAYOUT:%.*]] = alloca i64, align 16
; CHECK-NEXT:    store i64 0, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    br i1 [[C]], label %[[BODY:.*]], label %[[FAIL:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[BASETAG:%.*]] = call ptr @llvm.aarch64.irg.sp(i64 0)
; CHECK-NEXT:    [[BUF:%.*]] = alloca i8, i64 48, align 16
; CHECK-NEXT:    [[BUF_TAG:%.*]] = call ptr @llvm.aarch64.tagp.p0(ptr [[BUF]], ptr [[BASETAG]], i64 0)
; CHECK-NEXT:    [[TMP0:%.*]] = ptrtoint ptr [[BUF]] to i64
; CHECK-NEXT:    store i64 [[TMP0]], ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[BUF_TAG]], i64 48)
; CHECK-NEXT:    call void @use(ptr [[BUF_TAG]])
; CHECK-NEXT:    [[UNTAG_END:%.*]] = ptrtoint ptr [[DYNAMIC_ALLOCA_LAYOUT]] to i64
; CHECK-NEXT:    [[LAST_ALLOCA:%.*]] = load i64, ptr [[DYNAMIC_ALLOCA_LAYOUT]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = icmp ne i64 [[LAST_ALLOCA]], 0
; CHECK-NEXT:    [[TMP2:%.*]] = icmp ule i64 [[LAST_ALLOCA]], [[UNTAG_END]]
; CHECK-NEXT:    [[TMP3:%.*]] = and i1 [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = sub i64 [[UNTAG_END]], [[LAST_ALLOCA]]
; CHECK-NEXT:    [[UNTAG_SIZE:%.*]] = select i1 [[TMP3]], i64 [[TMP4]], i64 0
; CHECK-NEXT:    [[TMP5:%.*]] = inttoptr i64 [[LAST_ALLOCA]] to ptr
; CHECK-NEXT:    call void @llvm.aarch64.settag(ptr [[TMP5]], i64 [[UNTAG_SIZE]])
; CHECK-NEXT:    ret void
; CHECK:       [[FAIL]]:
; CHECK-NEXT:    call void @abort()
; CHECK-NEXT:    unreachable
;
entry:
  br i1 %c, label %body, label %fail

body:
  %buf = alloca i8, i32 40, align 1
  call void @use(ptr %buf)
  ret void

fail:
  call void @abort()
  unreachable
}

