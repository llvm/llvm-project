; CHECK-NEXT:    [[BUF:%.*]] = alloca i8, i32 0, align 1
; CHECK-NEXT:    call void @use(ptr [[BUF]])
; CHECK-NEXT:    ret void
; CHECK:       [[FAIL]]:
; CHECK-NEXT:    call void @abort()
; CHECK-NEXT:    unreachable
;
entry:
  br i1 %c, label %body, label %fail

body:
