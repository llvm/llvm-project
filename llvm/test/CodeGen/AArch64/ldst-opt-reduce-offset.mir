    STRXui $xzr, $sp, 84 :: (store (s32))
    STRXui $xzr, $sp, 83 :: (store (s32))
    STRXui $xzr, $sp, 82 :: (store (s32))
    STRXui $xzr, $sp, 81 :: (store (s32))
    STRXui $xzr, $sp, 80 :: (store (s32))
    STRXui $xzr, $sp, 79 :: (store (s32))
    STRXui $xzr, $sp, 78 :: (store (s32))
    STRXui $xzr, $sp, 77 :: (store (s32))
    STRXui $xzr, $sp, 76 :: (store (s32))
    STRXui $xzr, $sp, 75 :: (store (s32))
    STRXui $xzr, $sp, 74 :: (store (s32))
    STRXui $xzr, $sp, 73 :: (store (s32))
    STRXui $xzr, $sp, 72 :: (store (s32))
