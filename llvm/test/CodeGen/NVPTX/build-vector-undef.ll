; RUN: llc -mtriple=nvptx64 -verify-machineinstrs < %s | FileCheck %s

; Choose zero for unspecified bytes so the all-padding PRMT can constant-fold.
define i32 @pack_byte(i8 %value) {
; CHECK-LABEL: pack_byte(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<4>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b8 %r1, [pack_byte_param_0];
; CHECK-NEXT:    prmt.b32 %r2, %r1, 0, 0x3340U;
; CHECK-NEXT:    prmt.b32 %r3, %r2, 0, 0x5410U;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r3;
; CHECK-NEXT:    ret;
  %vector = insertelement <4 x i8> undef, i8 %value, i64 0
  %packed = bitcast <4 x i8> %vector to i32
  ret i32 %packed
}
