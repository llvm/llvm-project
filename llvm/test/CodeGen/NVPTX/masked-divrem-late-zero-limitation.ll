; FIXME: These disabled lanes become zero only after lowering, beyond what IR
; and DAG known bits prove when the masked operation is lowered. The DAG folds
; the lane's division to undef, and freeze(undef) is selected as a copy of an
; implicit def, so the two stores read unrelated registers. A machine-level
; frozen undef would make them consistent.

; Six nested additions exceed the known-bits depth limit; opt -O2 keeps them.
define i32 @deep_sdiv(<4 x i32> %a, <4 x i32> %b0, <4 x i32> %b1, <4 x i32> %b2, <4 x i32> %b3, <4 x i32> %b4, <4 x i32> %b5, <4 x i32> %b6, ptr %p, ptr %p2) {
; CHECK-LABEL: deep_sdiv(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<4>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [deep_sdiv_param_8];
; CHECK-NEXT:    ld.param.b64 %rd2, [deep_sdiv_param_9];
; CHECK-NEXT:    st.b32 [%rd1], %r1;
; CHECK-NEXT:    xor.b32 %r3, %r2, 85;
; CHECK-NEXT:    st.b32 [%rd2], %r3;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r1;
; CHECK-NEXT:    ret;
  %z0 = and <4 x i32> %b0, <i32 -1, i32 0, i32 -1, i32 -1>
  %z1 = and <4 x i32> %b1, <i32 -1, i32 0, i32 -1, i32 -1>
  %d1 = add <4 x i32> %z0, %z1
  %z2 = and <4 x i32> %b2, <i32 -1, i32 0, i32 -1, i32 -1>
  %d2 = add <4 x i32> %d1, %z2
  %z3 = and <4 x i32> %b3, <i32 -1, i32 0, i32 -1, i32 -1>
  %d3 = add <4 x i32> %d2, %z3
  %z4 = and <4 x i32> %b4, <i32 -1, i32 0, i32 -1, i32 -1>
  %d4 = add <4 x i32> %d3, %z4
  %z5 = and <4 x i32> %b5, <i32 -1, i32 0, i32 -1, i32 -1>
  %d5 = add <4 x i32> %d4, %z5
  %z6 = and <4 x i32> %b6, <i32 -1, i32 0, i32 -1, i32 -1>
  %d6 = add <4 x i32> %d5, %z6
  %m = icmp ne <4 x i32> %d6, zeroinitializer
  %r = call <4 x i32> @llvm.masked.sdiv.v4i32(<4 x i32> %a, <4 x i32> %d6, <4 x i1> %m)
  %f = freeze <4 x i32> %r
  %e = extractelement <4 x i32> %f, i64 1
  store i32 %e, ptr %p
  %x = xor i32 %e, 85
  store i32 %x, ptr %p2
  ret i32 %e
}

; Neither known-bits query uses a constant vector select condition per lane.
; InstCombine rewrites this to an insertelement, which is handled.
define i32 @select_sdiv(<4 x i32> %a, <4 x i32> %b, ptr %p, ptr %p2) {
; CHECK-LABEL: select_sdiv(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<4>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [select_sdiv_param_2];
; CHECK-NEXT:    ld.param.b64 %rd2, [select_sdiv_param_3];
; CHECK-NEXT:    st.b32 [%rd1], %r1;
; CHECK-NEXT:    xor.b32 %r3, %r2, 85;
; CHECK-NEXT:    st.b32 [%rd2], %r3;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r1;
; CHECK-NEXT:    ret;
  %d = select <4 x i1> <i1 false, i1 true, i1 false, i1 false>, <4 x i32> zeroinitializer, <4 x i32> %b
  %m = icmp ne <4 x i32> %d, zeroinitializer
  %r = call <4 x i32> @llvm.masked.sdiv.v4i32(<4 x i32> %a, <4 x i32> %d, <4 x i1> %m)
  %f = freeze <4 x i32> %r
  %e = extractelement <4 x i32> %f, i64 1
  store i32 %e, ptr %p
  %x = xor i32 %e, 85
  store i32 %x, ptr %p2
  ret i32 %e
}
