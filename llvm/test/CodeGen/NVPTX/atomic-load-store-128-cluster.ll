; CHECK:    ld.relaxed.sys.shared::cluster.b128 %rq1, [%rd1];
; CHECK:    mov.b128 {%rd2, %rd3}, %rq1;
  %v = load atomic i128, ptr addrspace(7) %p monotonic, align 16
  ret i128 %v
}

