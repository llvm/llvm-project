; independently of the half mode. The -nvptx-prec-divf32=1 runs select
; DIV_FULL_F32 and RCP_APPROX_F32. The afn variants exercise the approximate
; records separately from the regular divide and reciprocal records.

define float @div(float %a, float %b, float %c) {
; F32_IEEE-LABEL: div(
; F32_IEEE:    div.rn.f32 %r3, %r1, %r2;
;
; F32_FTZ-LABEL: div(
; F32_FTZ:    div.rn.ftz.f32 %r3, %r1, %r2;
;
; FULL_F32_IEEE-LABEL: div(
; FULL_F32_IEEE:    div.full.f32 %r3, %r1, %r2;
;
; FULL_F32_FTZ-LABEL: div(
; FULL_F32_FTZ:    div.full.ftz.f32 %r3, %r1, %r2;
