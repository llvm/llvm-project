; RUN: llc < %s -mcpu=sm_70 -verify-machineinstrs | FileCheck %s
; RUN: %if ptxas %{ llc < %s -mcpu=sm_70 -verify-machineinstrs | %ptxas-verify -arch=sm_70 %}

target triple = "nvptx64-nvidia-cuda"

declare i64 @llvm.ctlz.i64(i64, i1)
declare i64 @llvm.cttz.i64(i64, i1)
declare i64 @llvm.ctpop.i64(i64)
declare i64 @llvm.fshl.i64(i64, i64, i64)

; Expanding a rotate masks the shift amounts. The count is at most 63 here, so
; the shl doesn't need its mask.
define i64 @rotl_clz_at_most_63(i64 %a, i64 %b) {
; CHECK-LABEL: rotl_clz_at_most_63(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<4>;
; CHECK-NEXT:    .reg .b64 %rd<7>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [rotl_clz_at_most_63_param_0];
; CHECK-NEXT:    ld.param.b64 %rd2, [rotl_clz_at_most_63_param_1];
; CHECK-NEXT:    or.b64 %rd3, %rd2, 1;
; CHECK-NEXT:    clz.b64 %r1, %rd3;
; CHECK-NEXT:    shl.b64 %rd4, %rd1, %r1;
; CHECK-NEXT:    neg.s32 %r2, %r1;
; CHECK-NEXT:    and.b32 %r3, %r2, 63;
; CHECK-NEXT:    shr.u64 %rd5, %rd1, %r3;
; CHECK-NEXT:    or.b64 %rd6, %rd4, %rd5;
; CHECK-NEXT:    st.param.b64 [func_retval0], %rd6;
; CHECK-NEXT:    ret;
  %or = or i64 %b, 1
  %count = call i64 @llvm.ctlz.i64(i64 %or, i1 true)
  %rot = call i64 @llvm.fshl.i64(i64 %a, i64 %a, i64 %count)
  ret i64 %rot
}

; The count can be 64 here, so the mask has to stay.
define i64 @rotl_clz(i64 %a, i64 %b) {
; CHECK-LABEL: rotl_clz(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<5>;
; CHECK-NEXT:    .reg .b64 %rd<6>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [rotl_clz_param_0];
; CHECK-NEXT:    ld.param.b64 %rd2, [rotl_clz_param_1];
; CHECK-NEXT:    clz.b64 %r1, %rd2;
; CHECK-NEXT:    and.b32 %r2, %r1, 63;
; CHECK-NEXT:    shl.b64 %rd3, %rd1, %r2;
; CHECK-NEXT:    neg.s32 %r3, %r1;
; CHECK-NEXT:    and.b32 %r4, %r3, 63;
; CHECK-NEXT:    shr.u64 %rd4, %rd1, %r4;
; CHECK-NEXT:    or.b64 %rd5, %rd3, %rd4;
; CHECK-NEXT:    st.param.b64 [func_retval0], %rd5;
; CHECK-NEXT:    ret;
  %count = call i64 @llvm.ctlz.i64(i64 %b, i1 false)
  %rot = call i64 @llvm.fshl.i64(i64 %a, i64 %a, i64 %count)
  ret i64 %rot
}

define i64 @rotl_popc_at_most_63(i64 %a, i64 %b) {
