; RUN: llc < %s -mtriple=nvptx64 -verify-machineinstrs | FileCheck %s
; RUN: %if ptxas %{ llc < %s -mtriple=nvptx64 -verify-machineinstrs | %ptxas-verify %}

; Texture handles that are not loaded from a kernel parameter or a global
; must be left in a register instead of crashing NVPTXReplaceImageHandles.

target triple = "nvptx64-nvidia-cuda"

declare { float, float, float, float } @llvm.nvvm.tex.unified.1d.v4f32.s32(i64, i32)
declare i64 @get_handle()

define ptx_kernel void @handle_from_call(ptr %out, i32 %idx) {
; CHECK-LABEL: handle_from_call(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-NEXT:    .reg .b64 %rd<4>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [handle_from_call_param_0];
; CHECK-NEXT:    cvta.to.global.u64 %rd2, %rd1;
; CHECK-NEXT:    ld.param.b32 %r1, [handle_from_call_param_1];
; CHECK-NEXT:    { // callseq 0, 0
; CHECK-NEXT:    .param .b64 retval0;
; CHECK-NEXT:    call.uni (retval0), get_handle, ();
; CHECK-NEXT:    ld.param.b64 %rd3, [retval0];
; CHECK-NEXT:    } // callseq 0
; CHECK-NEXT:    tex.1d.v4.f32.s32 {%r2, %r3, %r4, %r5}, [%rd3, {%r1}];
; CHECK-NEXT:    st.global.b32 [%rd2], %r2;
; CHECK-NEXT:    ret;
  %h = call i64 @get_handle()
  %v = call { float, float, float, float } @llvm.nvvm.tex.unified.1d.v4f32.s32(i64 %h, i32 %idx)
  %r = extractvalue { float, float, float, float } %v, 0
  store float %r, ptr %out
  ret void
}

define ptx_kernel void @handle_from_phi(i1 %c, i64 %a, i64 %b, ptr %out, i32 %idx) {
; CHECK-LABEL: handle_from_phi(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<3>;
; CHECK-NEXT:    .reg .b16 %rs<3>;
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-NEXT:    .reg .b64 %rd<4>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ld.param.b8 %rs1, [handle_from_phi_param_0];
; CHECK-NEXT:    and.b16 %rs2, %rs1, 1;
; CHECK-NEXT:    setp.ne.b16 %p1, %rs2, 0;
; CHECK-NEXT:    ld.param.b32 %r1, [handle_from_phi_param_4];
; CHECK-NEXT:    ld.param.b64 %rd3, [handle_from_phi_param_1];
; CHECK-NEXT:    ld.param.b64 %rd2, [handle_from_phi_param_3];
; CHECK-NEXT:    cvta.to.global.u64 %rd1, %rd2;
; CHECK-NEXT:    not.pred %p2, %p1;
; CHECK-NEXT:    @%p2 bra $L__BB1_2;
; CHECK-NEXT:  // %bb.1: // %then
; CHECK-NEXT:    ld.param.b64 %rd3, [handle_from_phi_param_2];
; CHECK-NEXT:    st.global.b32 [%rd1], 0;
; CHECK-NEXT:  $L__BB1_2: // %join
; CHECK-NEXT:    tex.1d.v4.f32.s32 {%r2, %r3, %r4, %r5}, [%rd3, {%r1}];
; CHECK-NEXT:    st.global.b32 [%rd1], %r2;
; CHECK-NEXT:    ret;
entry:
  br i1 %c, label %then, label %join
then:
  store float 0.0, ptr %out
  br label %join
join:
  %h = phi i64 [ %a, %entry ], [ %b, %then ]
  %v = call { float, float, float, float } @llvm.nvvm.tex.unified.1d.v4f32.s32(i64 %h, i32 %idx)
  %r = extractvalue { float, float, float, float } %v, 0
  store float %r, ptr %out
  ret void
}

define ptx_kernel void @handle_from_add(i64 %a, ptr %out, i32 %idx) {
; CHECK-LABEL: handle_from_add(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-NEXT:    .reg .b64 %rd<5>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [handle_from_add_param_0];
; CHECK-NEXT:    ld.param.b64 %rd2, [handle_from_add_param_1];
; CHECK-NEXT:    cvta.to.global.u64 %rd3, %rd2;
; CHECK-NEXT:    add.s64 %rd4, %rd1, 8;
; CHECK-NEXT:    ld.param.b32 %r1, [handle_from_add_param_2];
; CHECK-NEXT:    tex.1d.v4.f32.s32 {%r2, %r3, %r4, %r5}, [%rd4, {%r1}];
; CHECK-NEXT:    st.global.b32 [%rd3], %r2;
; CHECK-NEXT:    ret;
  %h = add i64 %a, 8
  %v = call { float, float, float, float } @llvm.nvvm.tex.unified.1d.v4f32.s32(i64 %h, i32 %idx)
  %r = extractvalue { float, float, float, float } %v, 0
  store float %r, ptr %out
