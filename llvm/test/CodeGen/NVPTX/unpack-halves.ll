; CHECK-NEXT:    mov.b32 {%rs1, %rs2}, %r1;
; CHECK-NEXT:    // begin inline asm
; CHECK-NEXT:    // halves %rs1, %rs2
; CHECK-NEXT:    // end inline asm
; CHECK-NEXT:    ret;
  %lo = trunc i32 %word to i16
  %shift = lshr i32 %word, 16
  %hi = trunc i32 %shift to i16
