; PTX 8.3 supports b128 loads/stores at narrower scopes.

define i128 @load_block(ptr %p) {
; CHECK-LABEL: load_block(
; CHECK:    ld.relaxed.cta.b128 %rq1, [%rd1];
; CHECK:    mov.b128 {%rd2, %rd3}, %rq1;
  %v = load atomic i128, ptr %p syncscope("block") monotonic, align 16
  ret i128 %v
}

