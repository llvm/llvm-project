; PTX has no atom instruction for the .local state space. Local memory is
; private to a thread, so atomicrmw and cmpxchg on it are lowered to plain loads
; and stores, without fences, at every optimization level.

define i32 @cmpxchg_local_i32(ptr addrspace(5) %p, i32 %cmp, i32 %new) {
; CHECK-LABEL: cmpxchg_local_i32(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<2>;
; CHECK-NEXT:    .reg .b32 %r<5>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [cmpxchg_local_i32_param_0];
; CHECK-NEXT:    ld.local.b32 %r1, [%rd1];
; CHECK-NEXT:    ld.param.b32 %r2, [cmpxchg_local_i32_param_1];
; CHECK-NEXT:    setp.eq.b32 %p1, %r1, %r2;
; CHECK-NEXT:    ld.param.b32 %r3, [cmpxchg_local_i32_param_2];
; CHECK-NEXT:    selp.b32 %r4, %r3, %r1, %p1;
; CHECK-NEXT:    st.local.b32 [%rd1], %r4;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r1;
; CHECK-NEXT:    ret;
  %pair = cmpxchg ptr addrspace(5) %p, i32 %cmp, i32 %new monotonic monotonic, align 4
  %old = extractvalue { i32, i1 } %pair, 0
  ret i32 %old
}

