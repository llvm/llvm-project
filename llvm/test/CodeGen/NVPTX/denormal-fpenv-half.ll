; RUN: llc -mtriple=nvptx64 -mcpu=sm_80 -mattr=+ptx70 < %s | FileCheck %s

; Half inherits the default preserve-sign mode while float explicitly uses
; IEEE mode. Check both precisions in the same function.
define void @half_only_ftz(half %ha, half %hb, half %hc, float %fa, float %fb, float %fc, ptr %half_out, ptr %float_out) denormal_fpenv(preservesign, float: ieee) {
; CHECK-LABEL: half_only_ftz(
; CHECK:    add.rn.ftz.f16 %rs3, %rs1, %rs2;
; CHECK:    sub.rn.ftz.f16 %rs5, %rs3, %rs4;
; CHECK:    mul.rn.ftz.f16 %rs6, %rs5, %rs2;
; CHECK:    fma.rn.ftz.f16 %rs7, %rs6, %rs1, %rs2;
; CHECK:    add.rn.f32 %r3, %r1, %r2;
; CHECK:    sub.rn.f32 %r5, %r3, %r4;
; CHECK:    mul.rn.f32 %r6, %r5, %r2;
; CHECK:    fma.rn.f32 %r7, %r6, %r1, %r2;
  %hadd = fadd half %ha, %hb
  %hsub = fsub half %hadd, %hc
  %hmul = fmul half %hsub, %hb
  %hfma = call half @llvm.fma.f16(half %hmul, half %ha, half %hb)
  %fadd = fadd float %fa, %fb
  %fsub = fsub float %fadd, %fc
  %fmul = fmul float %fsub, %fb
  %ffma = call float @llvm.fma.f32(float %fmul, float %fa, float %fb)
  store half %hfma, ptr %half_out
  store float %ffma, ptr %float_out
  ret void
}

define <2 x half> @half_ftz_f16x2(<2 x half> %a, <2 x half> %b, <2 x half> %c) denormal_fpenv(preservesign, float: ieee) {
; CHECK-LABEL: half_ftz_f16x2(
; CHECK:    add.rn.ftz.f16x2 %r3, %r1, %r2;
; CHECK:    sub.rn.ftz.f16x2 %r5, %r3, %r4;
; CHECK:    mul.rn.ftz.f16x2 %r6, %r5, %r2;
; CHECK:    fma.rn.ftz.f16x2 %r7, %r6, %r1, %r2;
  %x = fadd <2 x half> %a, %b
  %u = fsub <2 x half> %x, %c
  %y = fmul <2 x half> %u, %b
  %z = call <2 x half> @llvm.fma.v2f16(<2 x half> %y, <2 x half> %a, <2 x half> %b)
  ret <2 x half> %z
}

