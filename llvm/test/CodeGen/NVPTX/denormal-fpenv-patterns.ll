; FMARELUInst uses a different FTZFlagFor operand from the ordinary FMA.

define half @relu_f16(half %a, half %b, half %c) {
; F16_FTZ-LABEL: relu_f16(
; F16_FTZ:    fma.rn.ftz.relu.f16 %rs4, %rs1, %rs2, %rs3;
;
; F16_IEEE-LABEL: relu_f16(
