; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=nvptx64 | FileCheck %s

; Verify that return value alignment is consistent between the callee
; (LowerReturn), the declaration (printReturnValStr), and the caller
; (LowerCall). All three should honor alignstack on the return index.

target triple = "nvptx64-nvidia-cuda"

%struct.big = type { i32, i32, i32, i32, i32 }

; alignstack(4) on the return forces align 4 everywhere: the declaration,
; the callee stores, and the caller loads all use scalar b32 ops.

define internal alignstack(4) %struct.big @internal_ret_align4() {
; CHECK-LABEL: internal_ret_align4(
; CHECK:       {
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    st.param.b32 [func_retval0+16], 5;
; CHECK-NEXT:    st.param.b32 [func_retval0+12], 4;
; CHECK-NEXT:    st.param.b32 [func_retval0+8], 3;
; CHECK-NEXT:    st.param.b32 [func_retval0+4], 2;
; CHECK-NEXT:    st.param.b32 [func_retval0], 1;
; CHECK-NEXT:    ret;
  ret %struct.big { i32 1, i32 2, i32 3, i32 4, i32 5 }
}

; The caller also reads the return value with align 4 (scalar loads).

define %struct.big @caller_align4() {
; CHECK-LABEL: caller_align4(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { // callseq 0, 0
; CHECK-NEXT:    .param .align 4 .b8 retval0[20];
; CHECK-NEXT:    call.uni (retval0), internal_ret_align4, ();
; CHECK-NEXT:    ld.param.b32 %r1, [retval0+16];
; CHECK-NEXT:    ld.param.b32 %r2, [retval0+12];
; CHECK-NEXT:    ld.param.b32 %r3, [retval0+8];
; CHECK-NEXT:    ld.param.b32 %r4, [retval0+4];
; CHECK-NEXT:    ld.param.b32 %r5, [retval0];
; CHECK-NEXT:    } // callseq 0
; CHECK-NEXT:    st.param.b32 [func_retval0+16], %r1;
; CHECK-NEXT:    st.param.b32 [func_retval0+12], %r2;
; CHECK-NEXT:    st.param.b32 [func_retval0+8], %r3;
; CHECK-NEXT:    st.param.b32 [func_retval0+4], %r4;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r5;
; CHECK-NEXT:    ret;
  %r = call %struct.big @internal_ret_align4()
  ret %struct.big %r
}

; alignstack(16) permits 128-bit vectorization. The declaration, callee
; stores, and caller loads all agree on align 16 and use a v4.b32 op for
; the first four elements.
define internal alignstack(16) %struct.big @internal_ret_align16() {
; CHECK-LABEL: internal_ret_align16(
; CHECK:         // @internal_ret_align16
; CHECK-NEXT:  {
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    st.param.b32 [func_retval0+16], 5;
; CHECK-NEXT:    st.param.v4.b32 [func_retval0], {1, 2, 3, 4};
; CHECK-NEXT:    ret;
  ret %struct.big { i32 1, i32 2, i32 3, i32 4, i32 5 }
}

define %struct.big @caller_align16() {
; CHECK-LABEL: caller_align16(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { // callseq 1, 0
; CHECK-NEXT:    .param .align 16 .b8 retval0[20];
; CHECK-NEXT:    call.uni (retval0), internal_ret_align16, ();
; CHECK-NEXT:    ld.param.b32 %r1, [retval0+16];
; CHECK-NEXT:    ld.param.v4.b32 {%r2, %r3, %r4, %r5}, [retval0];
; CHECK-NEXT:    } // callseq 1
; CHECK-NEXT:    st.param.b32 [func_retval0+16], %r1;
; CHECK-NEXT:    st.param.b32 [func_retval0+12], %r5;
; CHECK-NEXT:    st.param.b32 [func_retval0+8], %r4;
; CHECK-NEXT:    st.param.b32 [func_retval0+4], %r3;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r2;
; CHECK-NEXT:    ret;
  %r = call %struct.big @internal_ret_align16()
  ret %struct.big %r
}

; With no explicit alignstack, an internal-linkage callee gets its return
; alignment bumped to 16 by the param-align optimization, so vectorization
; still kicks in on both sides of the call.
define internal %struct.big @internal_ret_default() {
; CHECK-LABEL: internal_ret_default(
; CHECK:         // @internal_ret_default
; CHECK-NEXT:  {
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    st.param.b32 [func_retval0+16], 5;
; CHECK-NEXT:    st.param.v4.b32 [func_retval0], {1, 2, 3, 4};
; CHECK-NEXT:    ret;
  ret %struct.big { i32 1, i32 2, i32 3, i32 4, i32 5 }
}

define %struct.big @caller_default() {
; CHECK-LABEL: caller_default(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    { // callseq 2, 0
; CHECK-NEXT:    .param .align 16 .b8 retval0[20];
; CHECK-NEXT:    call.uni (retval0), internal_ret_default, ();
; CHECK-NEXT:    ld.param.b32 %r1, [retval0+16];
; CHECK-NEXT:    ld.param.v4.b32 {%r2, %r3, %r4, %r5}, [retval0];
; CHECK-NEXT:    } // callseq 2
; CHECK-NEXT:    st.param.b32 [func_retval0+16], %r1;
; CHECK-NEXT:    st.param.b32 [func_retval0+12], %r5;
; CHECK-NEXT:    st.param.b32 [func_retval0+8], %r4;
; CHECK-NEXT:    st.param.b32 [func_retval0+4], %r3;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r2;
; CHECK-NEXT:    ret;
  %r = call %struct.big @internal_ret_default()
  ret %struct.big %r
}
