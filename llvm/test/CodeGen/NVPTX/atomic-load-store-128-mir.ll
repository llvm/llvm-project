; Test both unpacked results and the memory chain feeding a following store.
define void @load_store128(ptr addrspace(1) %p, ptr addrspace(1) %q) {
; CHECK-LABEL: name: load_store128
; CHECK: bb.0 (%ir-block.0):
; CHECK-NEXT:   [[LD_i64_:%[0-9]+]]:b64 = LD_i64 0, 0, 102, 3, 64, -1, <mcsymbol load_store128_param_0>, 0, 0, $noreg :: (dereferenceable invariant load (s64), addrspace 102)
; CHECK-NEXT:   [[LD_i128_:%[0-9]+]]:b128 = LD_i128 4, 4, 1, 3, 128, -1, [[LD_i64_]], 0, 0, $noreg :: (load acquire (s128) from %ir.p, addrspace 1)
; CHECK-NEXT:   [[I128toV2I64_:%[0-9]+]]:b64, [[I128toV2I64_1:%[0-9]+]]:b64 = I128toV2I64 [[LD_i128_]]
; CHECK-NEXT:   [[LD_i64_1:%[0-9]+]]:b64 = LD_i64 0, 0, 102, 3, 64, -1, <mcsymbol load_store128_param_1>, 0, 0, $noreg :: (dereferenceable invariant load (s64), addrspace 102)
; CHECK-NEXT:   [[V2I64toI128_:%[0-9]+]]:b128 = V2I64toI128 [[I128toV2I64_]], [[I128toV2I64_1]]
; CHECK-NEXT:   ST_i128 [[V2I64toI128_]], 5, 4, 1, 128, [[LD_i64_1]], 0, 0, $noreg :: (store release (s128) into %ir.q, addrspace 1)
; CHECK-NEXT:   Return
  %v = load atomic i128, ptr addrspace(1) %p acquire, align 16
  store atomic i128 %v, ptr addrspace(1) %q release, align 16
  ret void
}

