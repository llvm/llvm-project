; The memory operations and b128 pack/unpack moves are separate instructions.
; Only the load/store carries the memory operand.

define i128 @load128(ptr addrspace(1) %p) {
; CHECK-LABEL: name: load128
; CHECK: bb.0 (%ir-block.0):
; CHECK-NEXT:   [[LD_i64_:%[0-9]+]]:b64 = LD_i64 0, 0, 102, 3, 64, -1, <mcsymbol load128_param_0>, 0, 0, $noreg :: (dereferenceable invariant load (s64), addrspace 102)
; CHECK-NEXT:   [[LD_i128_:%[0-9]+]]:b128 = LD_i128 4, 4, 1, 3, 128, -1, [[LD_i64_]], 0, 0, $noreg :: (load acquire (s128) from %ir.p, addrspace 1)
; CHECK-NEXT:   [[I128toV2I64_:%[0-9]+]]:b64, [[I128toV2I64_1:%[0-9]+]]:b64 = I128toV2I64 [[LD_i128_]]
; CHECK-NEXT:   STV_i64_v2 [[I128toV2I64_]], [[I128toV2I64_1]], 0, 0, 102, 64, <mcsymbol func_retval0>, 0, 0, $noreg :: (store (s128), addrspace 102)
; CHECK-NEXT:   Return
  %v = load atomic i128, ptr addrspace(1) %p acquire, align 16
  ret i128 %v
}

