---
name:            keep_envreg_reads
tracksRegLiveness: true
liveins:
  - { reg: '$envreg0' }
body: |
  ; CHECK-LABEL: name: keep_envreg_reads
  ; CHECK-COUNT-2: MOV_SPECIAL
  bb.0:
    liveins: $envreg0
    %0:b32 = MOV_SPECIAL $envreg0
    INLINEASM &"", sideeffect attdialect, reguse:B32, %0
    GOTO %bb.1

  bb.1:
    INLINEASM &"", sideeffect attdialect
    GOTO %bb.2

  bb.2:
    %1:b32 = MOV_SPECIAL $envreg0
    INLINEASM &"", sideeffect attdialect, reguse:B32, %1
    Return

...
---
name:            cse_ctaid_reads_locally
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: cse_ctaid_reads_locally
  ; CHECK-COUNT-1: INT_PTX_SREG_CTAID_x
  bb.0:
    %0:b32 = INT_PTX_SREG_CTAID_x
    %1:b32 = INT_PTX_SREG_CTAID_x
    INLINEASM &"", sideeffect attdialect, reguse:B32, %0
    INLINEASM &"", sideeffect attdialect, reguse:B32, %1
    Return

...
