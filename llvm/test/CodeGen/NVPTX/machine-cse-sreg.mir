# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=nvptx64 -mcpu=sm_100 -run-pass=machine-cse -o - %s | FileCheck %s
# Special-register reads are single moves, so MachineCSE must only eliminate
# them locally (or from an immediate predecessor), not across blocks.

---
name:            keep_ctaid_reads
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: keep_ctaid_reads
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[INT_PTX_SREG_CTAID_x:%[0-9]+]]:b32 = INT_PTX_SREG_CTAID_x
  ; CHECK-NEXT:   INLINEASM &"", sideeffect attdialect, reguse:B32, [[INT_PTX_SREG_CTAID_x]]
  ; CHECK-NEXT:   GOTO %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   INLINEASM &"", sideeffect attdialect
  ; CHECK-NEXT:   GOTO %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[INT_PTX_SREG_CTAID_x1:%[0-9]+]]:b32 = INT_PTX_SREG_CTAID_x
  ; CHECK-NEXT:   INLINEASM &"", sideeffect attdialect, reguse:B32, [[INT_PTX_SREG_CTAID_x1]]
  ; CHECK-NEXT:   Return
  bb.0:
    %0:b32 = INT_PTX_SREG_CTAID_x
    INLINEASM &"", sideeffect attdialect, reguse:B32, %0
    GOTO %bb.1

  bb.1:
    INLINEASM &"", sideeffect attdialect
    GOTO %bb.2

  bb.2:
    %1:b32 = INT_PTX_SREG_CTAID_x
    INLINEASM &"", sideeffect attdialect, reguse:B32, %1
    Return

...
