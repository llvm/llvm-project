; Check that sign bits survive immediate selection and that a shared constant
; can still be materialized for a register-only use.
define i32 @fns_signed_immediates(i32 %mask) {
; CHECK-LABEL: fns_signed_immediates(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<8>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b32 %r3, [fns_signed_immediates_param_0];
; CHECK-NEXT:    fns.b32 %r4, -2147483648, 31, -1;
; CHECK-NEXT:    fns.b32 %r5, %r3, 0, -1;
; CHECK-NEXT:    mov.b32 %r2, -1;
; CHECK-NEXT:    // begin inline asm
; CHECK-NEXT:    mov.b32 %r1, %r2;
; CHECK-NEXT:    // end inline asm
; CHECK-NEXT:    add.s32 %r6, %r4, %r5;
; CHECK-NEXT:    add.s32 %r7, %r6, %r1;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r7;
; CHECK-NEXT:    ret;
  %a = call i32 @llvm.nvvm.fns(i32 -2147483648, i32 31, i32 -1)
  %b = call i32 @llvm.nvvm.fns(i32 %mask, i32 0, i32 -1)
  %c = call i32 asm "mov.b32 $0, $1;", "=r,r"(i32 -1)
  %ab = add i32 %a, %b
  %abc = add i32 %ab, %c
  ret i32 %abc
}
