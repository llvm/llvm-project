  %min = call i32 @llvm.umin.i32(i32 %a, i32 %block)
  %c0 = icmp ult i32 %min, 7
  %c1 = icmp ult i32 %b, 3
  %both = and i1 %c0, %c1
  %c2 = icmp eq i32 %a, %b
  %cond = or i1 %both, %c2
  br i1 %cond, label %then, label %exit
then:
  call void asm sideeffect "// taken", ""()
  br label %exit
exit:
  ret void
}

