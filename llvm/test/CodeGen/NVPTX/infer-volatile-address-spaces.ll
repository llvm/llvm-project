; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=nvptx64-nvidia-cuda -mcpu=sm_90 -mattr=+ptx80 %s -o - | FileCheck %s
; RUN: %if ptxas %{ llc -mtriple=nvptx64-nvidia-cuda -mcpu=sm_90 -mattr=+ptx80 %s -o - | %ptxas-verify %}

; Refinement to cluster-shared space preserves volatile accesses and removes
; the conversion to a generic pointer.
define i32 @volatile_cluster(ptr addrspace(7) %p) {
; CHECK-LABEL: volatile_cluster(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [volatile_cluster_param_0];
; CHECK-NEXT:    ld.volatile.shared::cluster.b32 %r1, [%rd1];
; CHECK-NEXT:    st.volatile.shared::cluster.b32 [%rd1], %r1;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r1;
; CHECK-NEXT:    ret;
  %generic = addrspacecast ptr addrspace(7) %p to ptr
  %value = load volatile i32, ptr %generic, align 4
  store volatile i32 %value, ptr %generic, align 4
  ret i32 %value
}

; Local space does not support volatile accesses in PTX 8.0. Keep the generic
; accesses rather than lowering them to nonvolatile local instructions.
define i32 @volatile_local(ptr addrspace(5) %p) {
; CHECK-LABEL: volatile_local(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [volatile_local_param_0];
; CHECK-NEXT:    cvta.local.u64 %rd2, %rd1;
; CHECK-NEXT:    ld.volatile.b32 %r1, [%rd2];
; CHECK-NEXT:    st.volatile.b32 [%rd2], %r1;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r1;
; CHECK-NEXT:    ret;
  %generic = addrspacecast ptr addrspace(5) %p to ptr
  %value = load volatile i32, ptr %generic, align 4
  store volatile i32 %value, ptr %generic, align 4
  ret i32 %value
}
