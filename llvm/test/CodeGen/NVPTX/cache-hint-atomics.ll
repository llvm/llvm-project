; CHECK:    mov.b64 %rd2, 12345;
; CHECK:    ld.acquire.sys.global.L1::evict_first.L2::cache_hint.L2::128B.b32 %r1, [%rd1], %rd2;
; CHECK:    st.release.sys.global.L2::cache_hint.b32 [%rd1], %r2, %rd2;
