; Start at instruction selection so AtomicExpand cannot scalarize these
; operations before SelectionDAG type legalization sees them.

define <1 x i32> @add_v1i32(ptr addrspace(1) %p, <1 x i32> %v) {
; CHECK-LABEL: add_v1i32(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<3>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param::func.b64 %rd1, [add_v1i32_param_0];
; CHECK-NEXT:    ld.param::func.b32 %r1, [add_v1i32_param_1];
; CHECK-NEXT:    atom.relaxed.sys.global.add.u32 %r2, [%rd1], %r1;
; CHECK-NEXT:    st.param::func.b32 [func_retval0], %r2;
; CHECK-NEXT:    ret;
  %old = atomicrmw add ptr addrspace(1) %p, <1 x i32> %v monotonic
  ret <1 x i32> %old
}

