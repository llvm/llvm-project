; RUN: llc < %s -mtriple=nvptx64 -O0 -combiner-disabled | FileCheck %s
; RUN: %if ptxas %{ llc < %s -mtriple=nvptx64 -O0 -combiner-disabled | %ptxas-verify %}

define i32 @umulo_i32(i32 %a, i32 %b) {
; CHECK-LABEL: umulo_i32(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<2>;
; CHECK-NEXT:    .reg .b32 %r<6>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b32 %r1, [umulo_i32_param_0];
; CHECK-NEXT:    ld.param.b32 %r2, [umulo_i32_param_1];
; CHECK-NEXT:    mul.wide.u32 %rd1, %r1, %r2;
; CHECK-NEXT:    cvt.u32.u64 %r3, %rd1;
; CHECK-NEXT:    { .reg .b32 tmp; mov.b64 {tmp, %r4}, %rd1; }
; CHECK-NEXT:    setp.ne.b32 %p1, %r4, 0;
; CHECK-NEXT:    selp.b32 %r5, -1, %r3, %p1;
; CHECK-NEXT:    st.param.b32 [func_retval0], %r5;
; CHECK-NEXT:    ret;
  %res = call { i32, i1 } @llvm.umul.with.overflow.i32(i32 %a, i32 %b)
  %lo = extractvalue { i32, i1 } %res, 0
  %ov = extractvalue { i32, i1 } %res, 1
  %ret = select i1 %ov, i32 -1, i32 %lo
  ret i32 %ret
}
