# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=nvptx64 -mcpu=sm_90 -run-pass=branch-folder -enable-tail-merge -tail-merge-size=1 -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=MERGE

# Each branch can be uniform within its own incoming group of threads without
# being uniform after the groups join. Merge the tails and drop uniformity.
---
name: separate_groups
tracksRegLiveness: true
body: |
  ; MERGE-LABEL: name: separate_groups
  ; MERGE: bb.0:
  ; MERGE-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT:   [[DEF:%[0-9]+]]:b1 = IMPLICIT_DEF
  ; MERGE-NEXT:   [[DEF1:%[0-9]+]]:b1 = IMPLICIT_DEF
  ; MERGE-NEXT:   CBranch [[DEF]], %bb.2, 0
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT: bb.1:
  ; MERGE-NEXT:   successors: %bb.3(0x80000000)
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT:   INLINEASM &"// left", sideeffect attdialect
  ; MERGE-NEXT:   GOTO %bb.3
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT: bb.2:
  ; MERGE-NEXT:   successors: %bb.3(0x80000000)
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT:   INLINEASM &"// right", sideeffect attdialect
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT: bb.3:
  ; MERGE-NEXT:   successors: %bb.4(0x40000000), %bb.6(0x40000000)
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT:   CBranch [[DEF1]], %bb.6, 1
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT: bb.4:
  ; MERGE-NEXT:   successors: %bb.5(0x80000000)
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT:   INLINEASM &"// true", sideeffect attdialect
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT: bb.5:
  ; MERGE-NEXT:   Return
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT: bb.6:
  ; MERGE-NEXT:   successors: %bb.5(0x80000000)
  ; MERGE-NEXT: {{  $}}
  ; MERGE-NEXT:   INLINEASM &"// false", sideeffect attdialect
  ; MERGE-NEXT:   GOTO %bb.5
  bb.0:
    successors: %bb.1, %bb.2
    %0:b1 = IMPLICIT_DEF
    %1:b1 = IMPLICIT_DEF
    CBranch %0, %bb.2, 0
    GOTO %bb.1

  bb.1:
    successors: %bb.3, %bb.4
    INLINEASM &"// left", 1
    CBranchUni %1, %bb.3, 0
    GOTO %bb.4

  bb.2:
    successors: %bb.3, %bb.4
    INLINEASM &"// right", 1
    CBranchUni %1, %bb.3, 0
    GOTO %bb.4

  bb.3:
    INLINEASM &"// true", 1
    Return

  bb.4:
    INLINEASM &"// false", 1
    Return
...
