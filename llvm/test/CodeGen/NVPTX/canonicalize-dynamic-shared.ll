; Every unsized extern shared array starts at the dynamic shared memory base.
; Uses of @b, @c, and @constant move to @a, which takes the strongest alignment.
; Unused, sized, defined, and non-shared globals are left alone.

target triple = "nvptx64-nvidia-cuda"

@a = external addrspace(3) global [0 x i8], align 1
@b = external addrspace(3) global [0 x i32], align 16
@c = external addrspace(3) global [0 x <8 x i32>]
@unused = external addrspace(3) global [0 x i8], align 128
@sized = external addrspace(3) global [16 x i32]
@definition = addrspace(3) global [0 x i8] zeroinitializer
@constant = external addrspace(3) constant [0 x i8]
@global = external addrspace(1) global [0 x i8]

