; CHECK-NEXT:    ld.param::func.b64 %rd1, [fma_rn_param_0];
; CHECK-NEXT:    ld.param::func.b64 %rd2, [fma_rn_param_1];
; CHECK-NEXT:    ld.param::func.b64 %rd3, [fma_rn_param_2];
; CHECK-NEXT:    fma.rn.f32x2 %rd4, %rd1, %rd2, %rd3;
; CHECK-NEXT:    st.param::func.b64 [func_retval0], %rd4;
; CHECK-NEXT:    ret;
  %r = call <2 x float> @llvm.nvvm.fma.v2f32(<2 x float> %a, <2 x float> %b, <2 x float> %c, /* rnd=rn */ i32 1)
  ret <2 x float> %r
}

