; RUN: opt -S -passes='nvptx-canonicalize-dynamic-shared,function(gvn)' < %s | FileCheck %s --check-prefixes=CHECK,GVN
; RUN: opt -S -passes='nvptx-canonicalize-dynamic-shared,function(early-cse<memssa>)' < %s | FileCheck %s --check-prefixes=CHECK,CSE

; @a and @b name the same dynamic shared memory, so the store through @b may
; change what @a holds and the second load must stay.

target triple = "nvptx64-nvidia-cuda"

@a = external addrspace(3) global [0 x i32], align 4
@b = external addrspace(3) global [0 x float], align 4
@sized_a = addrspace(3) global [8 x i32] zeroinitializer
@sized_b = addrspace(3) global [8 x i32] zeroinitializer

;.
; CHECK: @a = external addrspace(3) global [0 x i32], align 4
; CHECK: @sized_a = addrspace(3) global [8 x i32] zeroinitializer
; CHECK: @sized_b = addrspace(3) global [8 x i32] zeroinitializer
;.
define i32 @overlap(i32 %v) {
; CHECK-LABEL: define i32 @overlap(
; CHECK-SAME: i32 [[V:%.*]]) {
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @a, i32 4), align 4
; CHECK-NEXT:    store i32 [[V]], ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @a, i32 4), align 4
; CHECK-NEXT:    [[R:%.*]] = sub i32 [[V]], [[OLD]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %old = load i32, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @a, i32 4)
  store i32 %v, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @b, i32 4)
  %new = load i32, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @a, i32 4)
  %r = sub i32 %new, %old
  ret i32 %r
}

; Disjoint offsets into the one allocation are still known not to overlap.
define i32 @disjoint_offsets(i32 %v) {
; GVN-LABEL: define i32 @disjoint_offsets(
; GVN-SAME: i32 [[V:%.*]]) {
; GVN-NEXT:    store i32 [[V]], ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @a, i32 4), align 4
; GVN-NEXT:    ret i32 0
;
; CSE-LABEL: define i32 @disjoint_offsets(
; CSE-SAME: i32 [[V:%.*]]) {
; CSE-NEXT:    [[OLD:%.*]] = load i32, ptr addrspace(3) @a, align 4
; CSE-NEXT:    store i32 [[V]], ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @a, i32 4), align 4
; CSE-NEXT:    ret i32 0
;
  %old = load i32, ptr addrspace(3) @a
  store i32 %v, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @b, i32 4)
  %new = load i32, ptr addrspace(3) @a
  %r = sub i32 %new, %old
  ret i32 %r
}

; Sized shared variables are distinct objects.
define i32 @sized_objects(i32 %v) {
; GVN-LABEL: define i32 @sized_objects(
; GVN-SAME: i32 [[V:%.*]]) {
; GVN-NEXT:    store i32 [[V]], ptr addrspace(3) @sized_b, align 4
; GVN-NEXT:    ret i32 0
;
; CSE-LABEL: define i32 @sized_objects(
; CSE-SAME: i32 [[V:%.*]]) {
; CSE-NEXT:    [[OLD:%.*]] = load i32, ptr addrspace(3) @sized_a, align 4
; CSE-NEXT:    store i32 [[V]], ptr addrspace(3) @sized_b, align 4
; CSE-NEXT:    ret i32 0
;
  %old = load i32, ptr addrspace(3) @sized_a
  store i32 %v, ptr addrspace(3) @sized_b
  %new = load i32, ptr addrspace(3) @sized_a
  %r = sub i32 %new, %old
  ret i32 %r
}
