# RUN: llc -mtriple=nvptx -run-pass=opt-phis -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=nvptx64 -run-pass=opt-phis -verify-machineinstrs -o - %s | FileCheck %s

---
name: test_phi_constant_same
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2

    %0:b1 = IMPLICIT_DEF
    CBranch killed %0, %bb.2, 0

  bb.1:
    successors: %bb.3

    %4:b32 = MOV_B32_i 1
    GOTO %bb.3

  bb.2:
    successors: %bb.3

    %5:b32 = MOV_B32_i 1

  bb.3:
    %6:b32 = PHI %4, %bb.1, %5, %bb.2
    ST_i32 %6, 0, 0, 101, 32, &func_retval0, 0, 0, $noreg :: (store (s32), addrspace 101)
    Return

# CHECK-LABEL: name: test_phi_constant_same
# CHECK: PHI
...

---
name: test_phi_constant_different
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2

    %0:b1 = IMPLICIT_DEF
    CBranch killed %0, %bb.2, 0

  bb.1:
    successors: %bb.3

    %4:b32 = MOV_B32_i 0
    GOTO %bb.3

  bb.2:
    successors: %bb.3

    %5:b32 = MOV_B32_i 1

  bb.3:
    %6:b32 = PHI %4, %bb.1, %5, %bb.2
    ST_i32 %6, 0, 0, 101, 32, &func_retval0, 0, 0, $noreg :: (store (s32), addrspace 101)
    Return

# CHECK-LABEL: name: test_phi_constant_different
# CHECK: PHI
...

---
name: test_phi_constant_implicit_def_not_folded
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2

    %0:b1 = IMPLICIT_DEF
    CBranch killed %0, %bb.2, 0

  bb.1:
    successors: %bb.3

    %1:b32 = MOV_B32_i 1, implicit-def dead $vrframe32
    GOTO %bb.3

  bb.2:
    successors: %bb.3

    %2:b32 = MOV_B32_i 1, implicit-def dead $vrframe32

  bb.3:
    %3:b32 = PHI %1, %bb.1, %2, %bb.2
    ST_i32 %3, 0, 0, 101, 32, &func_retval0, 0, 0, $noreg :: (store (s32), addrspace 101)
    Return

# CHECK-LABEL: name: test_phi_constant_implicit_def_not_folded
# CHECK: PHI
...

---
name: test_phi_constant_later_input_different
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2

    %0:b1 = IMPLICIT_DEF
    %1:b1 = IMPLICIT_DEF
    CBranch killed %0, %bb.2, 0

  bb.1:
    successors: %bb.4

    %2:b32 = MOV_B32_i 1
    GOTO %bb.4

  bb.2:
    successors: %bb.3, %bb.4

    %3:b32 = MOV_B32_i 1
    CBranch killed %1, %bb.4, 0

  bb.3:
    successors: %bb.4

    %4:b32 = MOV_B32_i 2

  bb.4:
    %5:b32 = PHI %2, %bb.1, %3, %bb.2, %4, %bb.3
    ST_i32 %5, 0, 0, 101, 32, &func_retval0, 0, 0, $noreg :: (store (s32), addrspace 101)
    Return

# CHECK-LABEL: name: test_phi_constant_later_input_different
# CHECK: bb.4:
# CHECK:   PHI
...

---
name: test_phi_constant_same_b64
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2

    %0:b1 = IMPLICIT_DEF
    CBranch killed %0, %bb.2, 0

  bb.1:
    successors: %bb.3

    %1:b64 = MOV_B64_i 1
    GOTO %bb.3

  bb.2:
    successors: %bb.3

    %2:b64 = MOV_B64_i 1

  bb.3:
    %3:b64 = PHI %1, %bb.1, %2, %bb.2
    ST_i64 %3, 0, 0, 101, 64, &func_retval0, 0, 0, $noreg :: (store (s64), addrspace 101)
    Return

# CHECK-LABEL: name: test_phi_constant_same_b64
# CHECK: PHI
...

---
name: test_phi_constant_single_input
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1

    %0:b32 = MOV_B32_i 1

  bb.1:
    %1:b32 = PHI %0, %bb.0
    ST_i32 %1, 0, 0, 101, 32, &func_retval0, 0, 0, $noreg :: (store (s32), addrspace 101)
    Return

# CHECK-LABEL: name: test_phi_constant_single_input
# CHECK: bb.0:
# CHECK:   [[C:%[0-9]+]]:b32 = MOV_B32_i 1
# CHECK: bb.1:
# CHECK-NOT: PHI
# CHECK:   ST_i32 [[C]]
...
