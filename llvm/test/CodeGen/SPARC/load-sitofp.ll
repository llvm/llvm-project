; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=sparc < %s | FileCheck %s
; RUN: llc -mtriple=sparcv9 < %s | FileCheck %s

;; An integer loaded only to be converted is loaded directly into an FP
;; register instead of going through the stack.

define float @load_sitofp(ptr %p) nounwind {
; CHECK-LABEL: load_sitofp:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    ld [%o0], %f0
; CHECK-NEXT:    retl
; CHECK-NEXT:    fitos %f0, %f0
  %v = load i32, ptr %p
  %r = sitofp i32 %v to float
  ret float %r
}

;; The store must stay after the load.

define float @load_store_sitofp(ptr %p) nounwind {
; CHECK-LABEL: load_store_sitofp:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    ld [%o0], %f0
; CHECK-NEXT:    fitos %f0, %f0
; CHECK-NEXT:    retl
; CHECK-NEXT:    st %g0, [%o0]
  %v = load i32, ptr %p
  store i32 0, ptr %p
  %r = sitofp i32 %v to float
  ret float %r
}

;; Integer range metadata does not apply to the FP load.

define float @load_range_sitofp(ptr %p) nounwind {
; CHECK-LABEL: load_range_sitofp:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    ld [%o0], %f0
; CHECK-NEXT:    retl
; CHECK-NEXT:    fitos %f0, %f0
  %v = load i32, ptr %p, !range !0
  %r = sitofp i32 %v to float
  ret float %r
}

!0 = !{i32 0, i32 100}
