; V9-NEXT:    save %sp, -176, %sp
; V9-NEXT:    call g
; V9-NEXT:    nop
; V9-NEXT:    ld [%i0], %i0
; V9-NEXT:    ret
; V9-NEXT:    restore %i0, 1, %o0
  call void @g()
  %v = load i32, ptr %p
  %x = add i32 %v, 1
  ret i32 %x
}

