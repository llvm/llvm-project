; V8-NEXT:    call g
; V8-NEXT:    nop
; V8-NEXT:    ld [%i0], %i0
; V8-NEXT:    ret
; V8-NEXT:    restore %i0, 1, %o0
;
; V9-LABEL: restore_boundary:
