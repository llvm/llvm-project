; V8-NEXT:    ld [%o0], %o0
; V8-NEXT:    ld [%o1], %o1
; V8-NEXT:    mov %o7, %g1
; V8-NEXT:    smul %o0, %o1, %o1
; V8-NEXT:    call ext
; V8-NEXT:    mov %g1, %o7
;
; V9-LABEL: leaf_tail_call:
; V9:       ! %bb.0:
; V9-NEXT:    ld [%o0], %o0
; V9-NEXT:    ldsw [%o1], %o1
; V9-NEXT:    mov %o7, %g1
; V9-NEXT:    sra %o0, 0, %o3
; V9-NEXT:    mulx %o3, %o1, %o1
; V9-NEXT:    call ext
; V9-NEXT:    mov %g1, %o7
;
; LEON5-LABEL: leaf_tail_call:
; LEON5:       ! %bb.0:
; LEON5-NEXT:    ld [%o0], %o0
; LEON5-NEXT:    mov %o7, %g1
; LEON5-NEXT:    ld [%o1], %o1
; LEON5-NEXT:    smul %o0, %o1, %o1
; LEON5-NEXT:    call ext
; LEON5-NEXT:    mov %g1, %o7
;
; LEON5-NOPOST-LABEL: leaf_tail_call:
; LEON5-NOPOST:       ! %bb.0:
; LEON5-NOPOST-NEXT:    ld [%o0], %o0
; LEON5-NOPOST-NEXT:    ld [%o1], %o1
; LEON5-NOPOST-NEXT:    smul %o0, %o1, %o1
; LEON5-NOPOST-NEXT:    mov %o7, %g1
; LEON5-NOPOST-NEXT:    call ext
; LEON5-NOPOST-NEXT:    mov %g1, %o7
  %x = load i32, ptr %p
  %y = load i32, ptr %q
  %z = mul i32 %x, %y
  tail call void @ext(i32 %x, i32 %z, i32 %c)
