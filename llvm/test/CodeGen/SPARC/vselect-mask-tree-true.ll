; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=sparc < %s | FileCheck %s

;; Sparc uses ZeroOrOne vector booleans. When WidenVSELECTMask rebuilds the
;; mask tree, an all-true leaf must be materialized as 1 rather than -1,
;; otherwise select(mask, 1, 0) returns -1 in the lanes coming from the
;; constant-true operand of the shuffle (issue #244589).

define <4 x i32> @shuffle_setcc_true(<4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: shuffle_setcc_true:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    ld [%sp+92], %o3
; CHECK-NEXT:    mov 1, %o1
; CHECK-NEXT:    cmp %o0, %o4
; CHECK-NEXT:    bl .LBB0_2
; CHECK-NEXT:    mov %o1, %o0
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:    mov %g0, %o0
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    cmp %o2, %o3
; CHECK-NEXT:    bl .LBB0_4
; CHECK-NEXT:    mov %o1, %o2
; CHECK-NEXT:  ! %bb.3:
; CHECK-NEXT:    mov %g0, %o2
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    retl
; CHECK-NEXT:    mov %o1, %o3
  %c = icmp slt <4 x i32> %a, %b
  %s = shufflevector <4 x i1> %c, <4 x i1> splat (i1 true), <4 x i32> <i32 0, i32 5, i32 2, i32 7>
  %r = select <4 x i1> %s, <4 x i32> splat (i32 1), <4 x i32> zeroinitializer
  ret <4 x i32> %r
}

define <4 x i32> @shuffle_setcc_true_vals(<4 x i32> %a, <4 x i32> %b, <4 x i32> %x, <4 x i32> %y) {
; CHECK-LABEL: shuffle_setcc_true_vals:
