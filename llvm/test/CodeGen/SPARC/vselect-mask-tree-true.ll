; CHECK-NEXT:    ld [%sp+92], %o1
; CHECK-NEXT:    cmp %o2, %o1
; CHECK-NEXT:    bl .LBB1_2
; CHECK-NEXT:    ld [%sp+112], %o3
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:    ba .LBB1_3
; CHECK-NEXT:    ld [%sp+124], %o2
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    ld [%sp+108], %o2
; CHECK-NEXT:  .LBB1_3:
; CHECK-NEXT:    cmp %o0, %o4
; CHECK-NEXT:    bl .LBB1_5
; CHECK-NEXT:    ld [%sp+104], %o1
; CHECK-NEXT:  ! %bb.4:
; CHECK-NEXT:    retl
; CHECK-NEXT:    ld [%sp+116], %o0
; CHECK-NEXT:  .LBB1_5:
