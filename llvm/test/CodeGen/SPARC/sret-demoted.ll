declare void @ext_void(i32)
declare void @ext_void_noargs()

;; A function whose return value was demoted to sret must not tail call a
;; function that does not use sret, otherwise the tail callee returns to
;; %o7+8 and lands on the caller's unimp.
define fp128 @ret_fp128_tail_void(i32 %a) nounwind {
; CHECK-LABEL: ret_fp128_tail_void:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    save %sp, -96, %sp
; CHECK-NEXT:    ld [%fp+64], %i1
; CHECK-NEXT:    call ext_void
; CHECK-NEXT:    mov %i0, %o0
; CHECK-NEXT:    jmp %i7+12
; CHECK-NEXT:    restore %g0, %i1, %o0
  tail call void @ext_void(i32 %a)
  ret fp128 poison
}

define fp128 @ret_fp128_tail_void_noargs() nounwind {
; CHECK-LABEL: ret_fp128_tail_void_noargs:
