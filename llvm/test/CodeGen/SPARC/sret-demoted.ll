;; Return values that don't fit in the 32-bit return registers (such as fp128
;; or a struct larger than six i32s) are demoted to a hidden sret argument
;; even though the IR function has no sret parameter. The caller then follows
;; the struct-return convention and places an unimp after the call, so the
;; callee must return to %o7+12 / %i7+12 and pass the sret pointer back in %o0.
;; See https://github.com/llvm/llvm-project/issues/232963.

define fp128 @ret_fp128() nounwind {
; LEAF-LABEL: ret_fp128:
; LEAF:       ! %bb.0:
; LEAF-NEXT:    ld [%sp+64], %o0
; LEAF-NEXT:    sethi %hi(.LCPI0_0), %o1
; LEAF-NEXT:    add %o1, %lo(.LCPI0_0), %o2
; LEAF-NEXT:    ldd [%o2+8], %f0
; LEAF-NEXT:    ldd [%o1+%lo(.LCPI0_0)], %f2
; LEAF-NEXT:    std %f0, [%o0+8]
; LEAF-NEXT:    jmp %o7+12
; LEAF-NEXT:    std %f2, [%o0]
;
; NOLEAF-LABEL: ret_fp128:
; NOLEAF:       ! %bb.0:
; NOLEAF-NEXT:    save %sp, -96, %sp
; NOLEAF-NEXT:    ld [%fp+64], %i0
; NOLEAF-NEXT:    sethi %hi(.LCPI0_0), %i1
; NOLEAF-NEXT:    add %i1, %lo(.LCPI0_0), %i2
; NOLEAF-NEXT:    ldd [%i2+8], %f0
; NOLEAF-NEXT:    ldd [%i1+%lo(.LCPI0_0)], %f2
; NOLEAF-NEXT:    std %f0, [%i0+8]
; NOLEAF-NEXT:    std %f2, [%i0]
; NOLEAF-NEXT:    jmp %i7+12
; NOLEAF-NEXT:    restore
  ret fp128 0xL00000000000000003FFF000000000000
}

define void @call_ret_fp128(ptr %p) nounwind {
; CHECK-LABEL: call_ret_fp128:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    save %sp, -112, %sp
; CHECK-NEXT:    add %fp, -16, %i1
; CHECK-NEXT:    call ret_fp128
; CHECK-NEXT:    st %i1, [%sp+64]
; CHECK-NEXT:    unimp 16
; CHECK-NEXT:    ldd [%fp+-8], %f0
; CHECK-NEXT:    ldd [%fp+-16], %f2
; CHECK-NEXT:    std %f0, [%i0+8]
; CHECK-NEXT:    std %f2, [%i0]
; CHECK-NEXT:    ret
; CHECK-NEXT:    restore
  %r = call fp128 @ret_fp128()
  store fp128 %r, ptr %p
  ret void
}

declare fp128 @ext_fp128()

