; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=sparcv9 -mattr=+vis3 -verify-machineinstrs \
; RUN:   -disable-strictnode-mutation < %s | FileCheck %s

;; The VIS3 fused negate/halve instructions are only formed from non-strict
;; operations. Constrained operations are not fused.

define float @fnadd_strict(float %a, float %b) nounwind strictfp {
; CHECK-LABEL: fnadd_strict:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    fadds %f1, %f3, %f0
; CHECK-NEXT:    retl
; CHECK-NEXT:    fnegs %f0, %f0
  %s = call float @llvm.experimental.constrained.fadd.f32(float %a, float %b, metadata !"round.dynamic", metadata !"fpexcept.strict") strictfp
  %r = fneg float %s
  ret float %r
}

define double @fnmul_strict(double %a, double %b) nounwind strictfp {
; CHECK-LABEL: fnmul_strict:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    fmuld %f0, %f2, %f0
; CHECK-NEXT:    retl
; CHECK-NEXT:    fnegd %f0, %f0
  %m = call double @llvm.experimental.constrained.fmul.f64(double %a, double %b, metadata !"round.dynamic", metadata !"fpexcept.strict") strictfp
  %r = fneg double %m
  ret double %r
}

define double @fhadd_strict(double %a, double %b) nounwind strictfp {
; CHECK-LABEL: fhadd_strict:
; CHECK:       ! %bb.0:
; CHECK-NEXT:    faddd %f0, %f2, %f0
; CHECK-NEXT:    sethi 1046528, %o0
; CHECK-NEXT:    sllx %o0, 32, %o0
; CHECK-NEXT:    movxtod %o0, %f2
; CHECK-NEXT:    retl
; CHECK-NEXT:    fmuld %f0, %f2, %f0
  %s = call double @llvm.experimental.constrained.fadd.f64(double %a, double %b, metadata !"round.dynamic", metadata !"fpexcept.strict") strictfp
  %r = call double @llvm.experimental.constrained.fmul.f64(double %s, double 0.5, metadata !"round.dynamic", metadata !"fpexcept.strict") strictfp
  ret double %r
}
