;; FP instructions implicitly use %fsr (rounding mode) and may raise FP
;; exceptions. Instructions selected from ordinary FP operations are marked
;; nofpexcept.

define float @fadd(float %a, float %b) nounwind {
; CHECK-LABEL: name: fadd
; CHECK: bb.0 (%ir-block.0):
; CHECK-NEXT:   liveins: $f1, $f3
; CHECK-NEXT: {{  $}}
; CHECK-NEXT:   [[COPY:%[0-9]+]]:fpregs = COPY $f3
; CHECK-NEXT:   [[COPY1:%[0-9]+]]:fpregs = COPY $f1
; CHECK-NEXT:   [[FADDS:%[0-9]+]]:fpregs = nofpexcept FADDS [[COPY1]], [[COPY]], implicit $fsr
; CHECK-NEXT:   $f0 = COPY [[FADDS]]
; CHECK-NEXT:   RETL 8, implicit $f0
  %r = fadd float %a, %b
  ret float %r
}

