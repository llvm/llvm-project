; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=bpfel -mcpu=v3 -verify-machineinstrs < %s | FileCheck %s

; Reg-reg ADD, OR, AND, XOR and MUL are commutable, in both the 64-bit and the
; 32-bit (alu32) forms. Each loop loads one value and folds it into one
; accumulator per operation, with the accumulator as the second operand.
; Without commuting, the two-address form would copy the accumulators and the
; loaded value in every iteration. SUB is not commutable, so its copies stay.

define i64 @add_or_and_i64(ptr %p, i64 %n) {
; CHECK-LABEL: add_or_and_i64:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    r3 = -1
; CHECK-NEXT:    r0 = 0
; CHECK-NEXT:    r5 = 0
; CHECK-NEXT:    r4 = 0
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    r6 = *(u64 *)(r1 + 0)
; CHECK-NEXT:    r3 &= r6
; CHECK-NEXT:    r4 |= r6
; CHECK-NEXT:    r0 += r6
; CHECK-NEXT:    r1 += 8
; CHECK-NEXT:    r5 += 1
; CHECK-NEXT:    if r5 < r2 goto .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    r0 ^= r4
; CHECK-NEXT:    r0 ^= r3
; CHECK-NEXT:    exit
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %add = phi i64 [ 0, %entry ], [ %add.next, %loop ]
  %or = phi i64 [ 0, %entry ], [ %or.next, %loop ]
  %and = phi i64 [ -1, %entry ], [ %and.next, %loop ]
  %a = getelementptr inbounds i64, ptr %p, i64 %i
  %v = load i64, ptr %a
  %add.next = add i64 %v, %add
  %or.next = or i64 %v, %or
  %and.next = and i64 %v, %and
  %i.next = add i64 %i, 1
  %c = icmp ult i64 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  %r0 = xor i64 %add.next, %or.next
  %r1 = xor i64 %r0, %and.next
  ret i64 %r1
}

