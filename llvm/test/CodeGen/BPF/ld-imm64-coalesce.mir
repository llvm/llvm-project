# RUN: llc -mtriple=bpfel -run-pass=register-coalescer -o - %s | FileCheck %s

# The coalescer keeps a copy of an LD_imm64 value instead of a new LD_imm64,
# unless the registers can join or the value is live across a call.

--- |
  @buf = global [1024 x i8] zeroinitializer
  @"llvm.s:0:4$0:2" = global i64 4 #0

  declare void @consume(i64)

  define void @keep_copy() { ret void }
  define void @subreg_copy() { ret void }
  define void @across_call() { ret void }
  define void @core_copy() { ret void }

  attributes #0 = { "btf_ama" }
...
---
# The first copy stays, because ADD_rr writes it while %0 is live. The second
# copy is the last use of %0, so the registers join.
# CHECK-LABEL: name: keep_copy
# CHECK:       [[LD:%[0-9]+]]:gpr = LD_imm64 @buf
# CHECK-NEXT:  {{%[0-9]+}}:gpr = COPY [[LD]]
# CHECK-NOT:   LD_imm64
# CHECK-NOT:   COPY [[LD]]
# CHECK:       RET
name: keep_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2
    %0:gpr = LD_imm64 @buf
    %1:gpr = COPY %0
    %1:gpr = ADD_rr %1, $r1
    %2:gpr = LDB %1, 0
    %3:gpr = COPY %0
    %3:gpr = ADD_rr %3, $r2
    %4:gpr = LDB %3, 0
    %4:gpr = ADD_rr %4, %2
    $r0 = COPY %4
    RET implicit $r0
...
---
# The copy is the only def of %1, so the registers join.
# CHECK-LABEL: name: subreg_copy
# CHECK-NOT:   COPY
# CHECK:       STW32 {{%[0-9]+}}.sub_32
name: subreg_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1
    %0:gpr = LD_imm64 3038287259199220266
    %1:gpr32 = COPY %0.sub_32
    STW32 %1, $r1, 8
    STD %0, $r1, 0
    RET
...
---
# %1 is live across the call, so the coalescer clones LD_imm64.
# CHECK-LABEL: name: across_call
# CHECK:       LD_imm64 @buf
# CHECK:       LD_imm64 @buf
# CHECK:       JAL @consume
name: across_call
tracksRegLiveness: true
frameInfo:
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1
    %0:gpr = COPY $r1
    %1:gpr = LD_imm64 @buf
    %2:gpr = COPY %1
    %2:gpr = ADD_rr %2, %0
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r11, implicit $r11
    $r1 = COPY %2
    JAL @consume, csr, implicit $r11, implicit $r1, implicit-def $r11
    ADJCALLSTACKUP 0, 0, implicit-def dead $r11, implicit $r11
    %3:gpr = COPY %1
    %3:gpr = ADD_rr %3, %0
    $r0 = COPY %3
    RET implicit $r0
...
---
# A CO-RE relocation global becomes a one-slot mov, so the coalescer clones it.
# CHECK-LABEL: name: core_copy
# CHECK:       LD_imm64 @"llvm.s:0:4$0:2"
# CHECK:       LD_imm64 @"llvm.s:0:4$0:2"
name: core_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1
    %0:gpr = LD_imm64 @"llvm.s:0:4$0:2"
    %1:gpr = COPY %0
    %1:gpr = ADD_rr %1, $r1
    %2:gpr = LDB %1, 0
    %3:gpr = COPY %0
    %3:gpr = ADD_rr %3, %2
    $r0 = COPY %3
    RET implicit $r0
...
