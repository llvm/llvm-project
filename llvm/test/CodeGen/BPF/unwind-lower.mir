# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=bpfel -mcpu=v4 -run-pass=bpf-unwind-lower -o - %s | FileCheck %s

# Outside an invoke, llvm.bpf.unwind.exit is unwind_exit, which returns zero
# like exit.

--- |
  define void @exit_void() uwtable {
    unreachable
  }

  define i128 @exit_pair() uwtable {
    unreachable
  }

  define void @exit_then_more() uwtable {
    unreachable
  }
...
---
name:            exit_void
body:             |
  bb.0:
    ; CHECK-LABEL: name: exit_void
    ; CHECK: $r0 = MOV_ri 0
    ; CHECK-NEXT: UNWIND_EXIT implicit $r0
    UNWIND_EXIT_PSEUDO
...
---
name:            exit_pair
body:             |
  bb.0:
    ; CHECK-LABEL: name: exit_pair
    ; CHECK: $r0 = MOV_ri 0
    ; CHECK-NEXT: $r2 = MOV_ri 0
    ; CHECK-NEXT: UNWIND_EXIT implicit $r0, implicit $r2
    UNWIND_EXIT_PSEUDO
...
---
name:            exit_then_more
body:             |
  ; CHECK-LABEL: name: exit_then_more
  ; CHECK: bb.0:
  ; CHECK-NEXT:   $r0 = MOV_ri 0
  ; CHECK-NEXT:   UNWIND_EXIT implicit $r0
  bb.0:
    successors: %bb.1

    UNWIND_EXIT_PSEUDO
    $r1 = MOV_ri 1
    JMP %bb.1

  bb.1:
    RET
...
