define i32 @memcmp_bytes() {
; CHECK-LABEL: memcmp_bytes:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    r1 = 0
; CHECK-NEXT:    r2 = buf ll
; CHECK-NEXT:    r3 = buf2 ll
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    r5 = r2
; CHECK-NEXT:    r5 += r1
; CHECK-NEXT:    r4 = r3
; CHECK-NEXT:    r4 += r1
; CHECK-NEXT:    w4 = *(u8 *)(r4 + 0)
; CHECK-NEXT:    w0 = *(u8 *)(r5 + 0)
; CHECK-NEXT:    if w0 != w4 goto .LBB0_3
; CHECK-NEXT:  # %bb.2: # %latch
; CHECK-NEXT:    # in Loop: Header=BB0_1 Depth=1
; CHECK-NEXT:    w0 = 0
; CHECK-NEXT:    r1 += 1
; CHECK-NEXT:    if r1 == 1024 goto .LBB0_4
; CHECK-NEXT:    goto .LBB0_1
; CHECK-NEXT:  .LBB0_3: # %diff
; CHECK-NEXT:    w0 -= w4
; CHECK-NEXT:  .LBB0_4: # %exit
; CHECK-NEXT:    exit
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %latch ]
  %pa = getelementptr inbounds nuw i8, ptr @buf, i64 %i
  %a = load i8, ptr %pa, align 1
  %pb = getelementptr inbounds nuw i8, ptr @buf2, i64 %i
  %b = load i8, ptr %pb, align 1
  %eq = icmp eq i8 %a, %b
  br i1 %eq, label %latch, label %diff

latch:
  %inc = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %inc, 1024
  br i1 %done, label %exit, label %loop

diff:
  %za = zext i8 %a to i32
  %zb = zext i8 %b to i32
  %sub = sub nsw i32 %za, %zb
  br label %exit

exit:
  %ret = phi i32 [ %sub, %diff ], [ 0, %latch ]
  ret i32 %ret
}

