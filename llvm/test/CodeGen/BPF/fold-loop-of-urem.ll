; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=bpfel -mcpu=v3 < %s | FileCheck %s

declare i32 @helper(i32, ptr)

; Under 4-CSR register pressure across a helper call (pointer IV, countdown IV,
; %acc, and %i all live across @helper), keeping constant i32 urem as
; magic-multiply avoids adding an unrematerializable loop-carried IV and a
; branchy select, so the magic constant is rematerialized and no stack spills
; are emitted.
define i32 @const_rem_i32_reg_pressure(i32 %N, ptr %p) nounwind {
; CHECK-LABEL: const_rem_i32_reg_pressure:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    r6 = r2
; CHECK-NEXT:    w7 = w1
; CHECK-NEXT:    w8 = 0
; CHECK-NEXT:    if w7 == 0 goto .LBB0_3
; CHECK-NEXT:  # %bb.1: # %for.body.preheader
; CHECK-NEXT:    w9 = 0
; CHECK-NEXT:  .LBB0_2: # %for.body
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    r2 = r9
; CHECK-NEXT:    r1 = 2863311531 ll
; CHECK-NEXT:    r2 *= r1
; CHECK-NEXT:    r2 >>= 33
; CHECK-NEXT:    w2 *= 3
; CHECK-NEXT:    w1 = w9
; CHECK-NEXT:    w1 -= w2
; CHECK-NEXT:    r2 = r6
; CHECK-NEXT:    call helper
; CHECK-NEXT:    w8 += w0
; CHECK-NEXT:    r6 += 1
; CHECK-NEXT:    w9 += 1
; CHECK-NEXT:    w7 += -1
; CHECK-NEXT:    if w7 == 0 goto .LBB0_3
; CHECK-NEXT:    goto .LBB0_2
; CHECK-NEXT:  .LBB0_3: # %for.cond.cleanup
; CHECK-NEXT:    w0 = w8
; CHECK-NEXT:    exit
entry:
  %cmp3.not = icmp eq i32 %N, 0
  br i1 %cmp3.not, label %for.cond.cleanup, label %for.body

for.cond.cleanup:
  %res = phi i32 [ 0, %entry ], [ %acc.next, %for.body ]
  ret i32 %res

for.body:
  %i = phi i32 [ %inc, %for.body ], [ 0, %entry ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %for.body ]
  %rem = urem i32 %i, 3
  %idx = zext i32 %i to i64
  %gep = getelementptr i8, ptr %p, i64 %idx
  %v = call i32 @helper(i32 %rem, ptr %gep)
  %acc.next = add i32 %acc, %v
  %inc = add nuw i32 %i, 1
  %exitcond.not = icmp eq i32 %inc, %N
  br i1 %exitcond.not, label %for.cond.cleanup, label %for.body
}
