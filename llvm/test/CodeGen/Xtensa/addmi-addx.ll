; An imm8_sh8 constant added to a shifted value must be selected as ADDMI.
; Selecting ADDX2/4/8 instead left the constant without a pattern to
; materialize it and instruction selection failed.

define i32 @addx2_imm(i32 %x) {
; CHECK-LABEL: addx2_imm:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  # %bb.0:
; CHECK-NEXT:    slli a8, a2, 1
; CHECK-NEXT:    addmi a2, a8, 2048
; CHECK-NEXT:    ret
  %s = shl i32 %x, 1
  %a = add i32 %s, 2048
  ret i32 %a
}

