; Windowed ABI: any SP change after ENTRY must go through MOVSP so the
; register-window save area is relocated (a plain ADD corrupts the caller
; if a window spill lands between ENTRY and the update). Over-aligned
; frames therefore realign via scratch ADD + MOVSP, computed off SP.
;
; The autogenerated CHECK lines pin the whole prologue. The MOVSP-prefixed
; lines pin the invariant those lines exist for: between ENTRY and the first
; MOVSP, SP is never written by a plain ADD/ADDI/MOVI.

declare void @use(ptr)

define void @realign64() {
; CHECK-LABEL: realign64:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  # %bb.0: # %entry
; CHECK-NEXT:    entry a1, 160
; CHECK-NEXT:    movi a8, 63
; CHECK-NEXT:    movi a9, 64
; CHECK-NEXT:    and a8, a1, a8
; CHECK-NEXT:    sub a8, a9, a8
; CHECK-NEXT:    add a8, a1, a8
; CHECK-NEXT:    movsp a1, a8
; CHECK-NEXT:    .cfi_def_cfa_offset 160
; CHECK-NEXT:    addi a10, a1, 0
; CHECK-NEXT:    l32r a8, .LCPI0_0
; CHECK-NEXT:    callx8 a8
; CHECK-NEXT:    retw.n
; MOVSP-LABEL: realign64:
; MOVSP: entry a1, 160
; MOVSP-NOT: add{{(\.n)?}} a1, a1
; MOVSP-NOT: addi a1, a1,
; MOVSP-NOT: movi a1,
; MOVSP: movsp a1, a8
; MOVSP: .cfi_def_cfa_offset 160
entry:
  %buf = alloca [64 x i8], align 64
  call void @use(ptr %buf)
  ret void
}

