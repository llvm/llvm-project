; CHECK-NEXT:    movsp a1, a8
; CHECK-NEXT:    or a8, a7, a7
; CHECK-NEXT:    or a7, a1, a1
; CHECK-NEXT:    .cfi_def_cfa a7, 160
; CHECK-NEXT:    l32i a8, a7, 160
; CHECK-NEXT:    addi a8, a8, 15
; CHECK-NEXT:    movi a9, -16
; CHECK-NEXT:    and a8, a8, a9
; CHECK-NEXT:    addi a8, a8, 31
; CHECK-NEXT:    movi a9, -32
; CHECK-NEXT:    and a8, a8, a9
; CHECK-NEXT:    sub a8, a1, a8
; CHECK-NEXT:    movsp a1, a8
; CHECK-NEXT:    or a6, a1, a1
