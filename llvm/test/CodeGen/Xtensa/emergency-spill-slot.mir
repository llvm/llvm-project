# An inline asm memory operand needs an offset that is a multiple of 4.
# A 2-byte aligned object may not get one. (e.g. short x[2] in asm("" : : "m"(x)))
---
name: inline_asm_mem
tracksRegLiveness: true
stack:
  - { id: 0, size: 2, alignment: 2 }
  - { id: 1, size: 4, alignment: 2 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-LABEL: name: inline_asm_mem
    ; CHECK: liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ENTRY $sp, 48, implicit-def $sp
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa_offset 48
    ; CHECK-NEXT: S32I killed $a8, $sp, 0 :: (store (s32) into %stack.2)
    ; CHECK-NEXT: $a8 = MOVI 6
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: INLINEASM &"", sideeffect mayload attdialect, mem:m ops:2, killed $a8, 0
    ; CHECK-NEXT: $a8 = L32I $sp, 0 :: (load (s32) from %stack.2)
    ; CHECK-NEXT: RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a7, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15
    INLINEASM &"", sideeffect mayload, mem:m ops:2, %stack.1, 0
    RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a7, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15
...

# The incoming argument at 212 is within S8I's reach, but the frame (48 bytes
# with the windowed ABI) pushes the access out of it.
---
name: store_incoming_arg
tracksRegLiveness: true
fixedStack:
  - { id: 0, offset: 212, size: 1, alignment: 4 }
stack:
  - { id: 0, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-LABEL: name: store_incoming_arg
