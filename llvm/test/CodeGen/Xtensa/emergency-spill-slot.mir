# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=xtensa -run-pass=prolog-epilog -o - %s | FileCheck %s

# All AR registers are live. If the frame offset doesn't fit in the
# instruction, we need an emergency spill slot, unless the instruction can
# use its destination register for the address.

--- |
  define void @load_far() "target-features"="+windowed" { ret void }
  define void @float_load_far() "target-features"="+windowed,+fp" { ret void }
  define void @store_byte_far() "target-features"="+windowed" { ret void }
  define void @inline_asm_mem() "target-features"="+windowed" { ret void }
  define void @store_incoming_arg() "target-features"="+windowed" { ret void }
  define void @store_incoming_arg_call0() { ret void }
...

# Check if we don't reserve a slot here. A load can use its destination register.
---
name: load_far
tracksRegLiveness: true
stack:
  - { id: 0, size: 1100, alignment: 4 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-LABEL: name: load_far
    ; CHECK: liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ENTRY $sp, 1136, implicit-def $sp
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa_offset 1136
    ; CHECK-NEXT: $a2 = MOVI 1096
    ; CHECK-NEXT: $a2 = ADD $sp, killed $a2
    ; CHECK-NEXT: $a2 = L32I killed $a2, 0
    ; CHECK-NEXT: RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a7, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15
    $a2 = L32I %stack.0, 1096
    RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a7, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15
...

# A float load can't use its destination register for the address.
---
name: float_load_far
tracksRegLiveness: true
stack:
  - { id: 0, size: 1100, alignment: 4 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-LABEL: name: float_load_far
    ; CHECK: liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ENTRY $sp, 1136, implicit-def $sp
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa_offset 1136
    ; CHECK-NEXT: S32I killed $a8, $sp, 0 :: (store (s32) into %stack.1)
    ; CHECK-NEXT: $a8 = MOVI 1100
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: $f0 = LSI killed $a8, 0
    ; CHECK-NEXT: $a8 = L32I $sp, 0 :: (load (s32) from %stack.1)
    ; CHECK-NEXT: RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a7, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15, implicit $f0
    $f0 = LSI %stack.0, 1096
    RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a7, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15, implicit $f0
...

# S8I only reaches 255 bytes.
