# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=xtensa -run-pass=prolog-epilog -o - %s | FileCheck %s

# Test that the register scavenger doesn't hoist an emergency spill above
# the stack allocation in the prologue.
--- |
  define void @call0() { ret void }
  define void @windowed() "target-features"="+windowed" { ret void }
...
---
name: call0
tracksRegLiveness: true
stack:
  - { id: 0, size: 2100, alignment: 4 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a13, $a14, $a15
    ; CHECK-LABEL: name: call0
    ; CHECK: liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a13, $a14, $a15, $a12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a8 = frame-setup MOVI 192
    ; CHECK-NEXT: $a8 = frame-setup ADDMI $a8, -2304
    ; CHECK-NEXT: $a8 = frame-setup ADD $sp, killed $a8
    ; CHECK-NEXT: $sp = frame-setup OR killed $a8, killed $a8
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 2112
    ; CHECK-NEXT: $a8 = MOVI 56
    ; CHECK-NEXT: $a8 = ADDMI $a8, 2048
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: frame-setup S32I killed $a12, killed $a8, 0 :: (store (s32) into %stack.1)
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION offset $a12, -4
    ; CHECK-NEXT: $a8 = MOVI 0
    ; CHECK-NEXT: $a9 = MOVI 0
    ; CHECK-NEXT: $a10 = MOVI 0
    ; CHECK-NEXT: $a11 = MOVI 0
    ; CHECK-NEXT: $a12 = MOVI 0
    ; CHECK-NEXT: S32I killed $a13, $sp, 0 :: (store (s32) into %stack.2)
    ; CHECK-NEXT: $a13 = MOVI 52
    ; CHECK-NEXT: $a13 = ADDMI $a13, 2048
    ; CHECK-NEXT: $a13 = ADD $sp, killed $a13
    ; CHECK-NEXT: S32I $a2, killed $a13, 0
    ; CHECK-NEXT: $a13 = L32I $sp, 0 :: (load (s32) from %stack.2)
    ; CHECK-NEXT: KILL $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-NEXT: $a8 = MOVI 56
    ; CHECK-NEXT: $a8 = ADDMI $a8, 2048
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: $a12 = L32I killed $a8, 0 :: (load (s32) from %stack.1)
    ; CHECK-NEXT: $a8 = MOVI 64
    ; CHECK-NEXT: $a8 = ADDMI $a8, 2048
    ; CHECK-NEXT: $a8 = ADD $sp, killed $a8
    ; CHECK-NEXT: $sp = OR killed $a8, killed $a8
    ; CHECK-NEXT: RET implicit $a0
    $a8 = MOVI 0
    $a9 = MOVI 0
    $a10 = MOVI 0
    $a11 = MOVI 0
    $a12 = MOVI 0
    S32I $a2, %stack.0, 2096
    KILL $a0, $a2, $a3, $a4, $a5, $a6, $a7, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    RET implicit $a0
...

# Large enough so that ENTRY doesn't allocate the entire frame.
---
name: windowed
tracksRegLiveness: true
stack:
  - { id: 0, size: 40000, alignment: 4 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7
    ; CHECK-LABEL: name: windowed
    ; CHECK: liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: frame-setup ENTRY $sp, 32, implicit-def $sp
    ; CHECK-NEXT: $a8 = frame-setup L32R %const.0
    ; CHECK-NEXT: $a8 = frame-setup SUB $sp, $a8
    ; CHECK-NEXT: $sp = frame-setup MOVSP killed $a8
    ; CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 40048
    ; CHECK-NEXT: $a8 = MOVI 0
    ; CHECK-NEXT: $a9 = MOVI 0
    ; CHECK-NEXT: $a10 = MOVI 0
    ; CHECK-NEXT: $a11 = MOVI 0
    ; CHECK-NEXT: $a12 = MOVI 0
    ; CHECK-NEXT: $a13 = MOVI 0
    ; CHECK-NEXT: $a14 = MOVI 0
    ; CHECK-NEXT: $a15 = MOVI 0
    ; CHECK-NEXT: S32I killed $a7, $sp, 0 :: (store (s32) into %stack.1)
    ; CHECK-NEXT: $a7 = MOVI 1100
    ; CHECK-NEXT: $a7 = ADD $sp, killed $a7
    ; CHECK-NEXT: S32I $a2, killed $a7, 0
    ; CHECK-NEXT: $a7 = L32I $sp, 0 :: (load (s32) from %stack.1)
