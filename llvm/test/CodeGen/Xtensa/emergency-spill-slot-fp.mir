    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: ENTRY $sp, 2144, implicit-def $sp
    ; CHECK-NEXT: $a7 = frame-setup OR $sp, $sp
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa $a7, 2144
    ; CHECK-NEXT: S32I killed $a8, $a7, 0 :: (store (s32) into %stack.1)
    ; CHECK-NEXT: $a8 = MOVI 52
    ; CHECK-NEXT: $a8 = ADDMI $a8, 2048
    ; CHECK-NEXT: $a8 = ADD $a7, killed $a8
    ; CHECK-NEXT: S32I $a2, killed $a8, 0
    ; CHECK-NEXT: $a8 = L32I $a7, 0 :: (load (s32) from %stack.1)
    ; CHECK-NEXT: RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15
    S32I $a2, %stack.0, 2096
    RETW implicit $a0, implicit $a2, implicit $a3, implicit $a4, implicit $a5, implicit $a6, implicit $a8, implicit $a9, implicit $a10, implicit $a11, implicit $a12, implicit $a13, implicit $a14, implicit $a15
...
