# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=xtensa -mattr=+windowed -run-pass=prolog-epilog \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

# All allocatable AR registers are live, so a frame offset that doesn't fit in
# the instruction needs the emergency spill slot. The frame pointer, a7, is
# equal to SP after the prologue, so the slot has to be close to SP.

--- |
  define void @store_2k() "frame-pointer"="all" { ret void }
...
---
name: store_2k
tracksRegLiveness: true
stack:
  - { id: 0, size: 2100, alignment: 4 }
body: |
  bb.0:
    liveins: $a0, $a2, $a3, $a4, $a5, $a6, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ; CHECK-LABEL: name: store_2k
