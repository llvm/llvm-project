    ; LEGAL-NEXT: [[BITCAST:%[0-9]+]]:_(<4 x i32>) = G_BITCAST [[DEF]](i128)
    ; LEGAL-NEXT: [[BITCAST1:%[0-9]+]]:_(<4 x i32>) = G_BITCAST [[DEF1]](i128)
    ; LEGAL-NEXT: [[DEF2:%[0-9]+]]:_(<8 x i32>) = IMPLICIT_DEF
    ; LEGAL-NEXT: [[INSERT_SUBVECTOR:%[0-9]+]]:_(<8 x i32>) = G_INSERT_SUBVECTOR [[DEF2]], [[BITCAST]](<4 x i32>), 0
    ; LEGAL-NEXT: [[INSERT_SUBVECTOR1:%[0-9]+]]:_(<8 x i32>) = G_INSERT_SUBVECTOR [[INSERT_SUBVECTOR]], [[BITCAST1]](<4 x i32>), 4
