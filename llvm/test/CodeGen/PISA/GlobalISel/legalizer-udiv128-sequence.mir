  bb.1..preheader3_udiv-special-cases:
    %0:reg64b(i64) = loadParam_i64 0, 0
    %1:reg64b(i64) = loadParam_i64 1, 0
    %4:_(i128) = G_CONSTANT i128 1
    %15:_(i128) = G_CONSTANT i128 0
    %22:_(i128) = G_CONSTANT i128 127
    %34:_(i128) = G_CONSTANT i128 -1
    %60:_(p3) = G_CONSTANT i32 0
    %2:_(i32) = G_INTRINSIC intrinsic(@llvm.pisa.local.size.x)
    %3:_(i128) = G_ZEXT %0(i64)
    %5:_(i128) = nuw nsw G_ADD %3, %4
    %6:_(i128) = G_ZEXT %1(i64)
    %7:_(i128) = G_UMAX %5, %6
    %8:_(i1) = G_ICMP intpred(uge), %0(i64), %1
    %9:_(i128) = G_ZEXT %8(i1)
    %10:_(i128) = nuw nsw G_ADD %9, %6
    %11:_(i128) = nsw G_SUB %7, %10
    %61:_(i32) = G_FREEZE %2
    %12:_(i128) = G_ZEXT %61(i32)
