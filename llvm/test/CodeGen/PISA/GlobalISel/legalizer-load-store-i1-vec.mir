# RUN: llc -march=pisa -run-pass=legalizer %s -o - | FileCheck %s

---
name: test_load_128
body: |
  bb.0:
    ; CHECK-LABEL: name: test_load_128
    ; CHECK: {{%[0-9]+}}:_(<4 x i32>) = G_LOAD {{%[0-9]+}}(p1) :: (load (<4 x i32>)
    %0:_(p1) = G_CONSTANT i64 0
    %1:_(<128 x i1>) = G_LOAD %0:_(p1) :: (load (<128 x i1>))
    %2:_(i32) = G_CONSTANT i32 0
    %3:_(i1) = G_EXTRACT_VECTOR_ELT %1:_(<128 x i1>), %2:_(i32)
    G_STORE %3:_(i1), %0:_(p1) :: (store (i1))
...
