name: test_store_192
body: |
  bb.0:
    ; CHECK-LABEL: name: test_store_192
    ; CHECK: G_STORE {{%[0-9]+}}(<3 x i64>), {{%[0-9]+}}(p1) :: (store (<3 x i64>)
    %0:_(p1) = G_CONSTANT i64 16
    %1:_(i1) = G_CONSTANT i1 1
    %2:_(<64 x i1>) = G_BUILD_VECTOR %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1), %1:_(i1)
    %3:_(<192 x i1>) = G_CONCAT_VECTORS %2:_(<64 x i1>), %2:_(<64 x i1>), %2:_(<64 x i1>)
    G_STORE %3:_(<192 x i1>), %0:_(p1) :: (store (<192 x i1>))
...
