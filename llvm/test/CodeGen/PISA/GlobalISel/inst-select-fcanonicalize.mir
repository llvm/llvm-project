# RUN: llc -mtriple=pisa -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

---
name: canonicalize_bf16
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: canonicalize_bf16
    ; CHECK: %1:reg16b = fmul_bf_ri %0, bfloat 1.000000e+00
    %0:reg16b(bf16) = functionParameter_i16 0
    %1:registers(bf16) = G_FCANONICALIZE %0(bf16)
    %2:reg16b(bf16) = COPY %1(bf16)
    retValue_i16_r %2(bf16)
...
---
name: canonicalize_f16
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: canonicalize_f16
    ; CHECK: %1:reg16b = fmul_hf_ri %0, half 1.000000e+00
    %0:reg16b(f16) = functionParameter_i16 0
    %1:registers(f16) = G_FCANONICALIZE %0(f16)
    %2:reg16b(f16) = COPY %1(f16)
    retValue_i16_r %2(f16)
...
