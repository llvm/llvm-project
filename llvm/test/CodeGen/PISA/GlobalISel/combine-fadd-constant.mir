# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -march=pisa -run-pass=pisa-postlegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s
---
name:            test_fadd_constant
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_fadd_constant
    ; CHECK: %res:reg32b(f32) = G_FCONSTANT float 1.000000e+00
    ; CHECK-NEXT: %ret:reg32b(i32) = G_BITCAST %res(f32)
    ; CHECK-NEXT: retValue_i32_r %ret(i32)
    %lhs:reg32b(f32) = G_FCONSTANT float 0.0
    %rhs:reg32b(f32) = G_FCONSTANT float 1.0
    %res:reg32b(f32) = G_FADD %lhs:reg32b, %rhs:reg32b
    %ret:reg32b(i32) = G_BITCAST %res(f32)
    retValue_i32_r %ret(i32)
