    %1:reg32b(i32) = functionParameter_i32 1
    %2:_(bf16) = afn G_FLDEXP %0:reg16b, %1:reg32b(i32)
    %3:reg16b(i16) = G_BITCAST %2:_(bf16)
    retValue_i16_r %3:reg16b(i16)
...

