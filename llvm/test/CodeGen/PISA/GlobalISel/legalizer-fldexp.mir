---
name:            test_afn_bfloat
tracksRegLiveness: true
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: test_afn_bfloat
    ; CHECK: %0:reg16b(bf16) = functionParameter_i16 0
    ; CHECK-NEXT: %1:reg32b(i32) = functionParameter_i32 1
    ; CHECK-NEXT: [[SITOFP:%[0-9]+]]:_(bf16) = G_SITOFP %1(i32)
    ; CHECK-NEXT: [[FEXP2_:%[0-9]+]]:_(bf16) = afn G_FEXP2 [[SITOFP]]
    ; CHECK-NEXT: [[FMUL:%[0-9]+]]:_(bf16) = afn G_FMUL %0, [[FEXP2_]]
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:reg16b(i16) = G_BITCAST [[FMUL]](bf16)
    ; CHECK-NEXT: retValue_i16_r [[COPY]](i16)
