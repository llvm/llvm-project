    %5:_(i1) = G_EXTRACT_VECTOR_ELT %2(<2 x i1>), %3(i32)
    %6:_(i1) = G_EXTRACT_VECTOR_ELT %2(<2 x i1>), %4(i32)
    %7:_(i1) = G_OR %5, %6
