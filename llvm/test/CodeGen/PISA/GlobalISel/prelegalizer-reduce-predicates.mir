    %3:_(<2 x i16>) = G_SEXT %2(<2 x i1>)
    %4:_(i32) = G_CONSTANT i32 0
    %5:_(i32) = G_CONSTANT i32 1
    %6:_(i16) = G_EXTRACT_VECTOR_ELT %3(<2 x i16>), %4(i32)
