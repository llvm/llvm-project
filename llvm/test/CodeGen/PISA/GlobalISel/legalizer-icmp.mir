    ; CHECK-NEXT: [[C11:%[0-9]+]]:_(p1) = G_CONSTANT i64 0
    ; CHECK-NEXT: G_STORE [[SELECT3]](i32), [[C11]](p1) :: (store (i32) into `ptr addrspace(1) null`, addrspace 1)
    ; CHECK-NEXT: ret
    %0:reg64b(i64) = loadParam_i64 0, 0
    %2:_(i128) = G_CONSTANT i128 0
    %1:_(i128) = G_SEXT %0(i64)
    %3:_(i1) = G_ICMP intpred(ugt), %1(i128), %2
    %6:_(i32) = G_CONSTANT i32 13
    %7:_(i32) = G_CONSTANT i32 17
    %8:_(i32) = G_SELECT %3, %6, %7
    %5:_(p1) = G_CONSTANT i64 0
    G_STORE %8(i32), %5(p1) :: (store (i32) into `ptr addrspace(1) null`, addrspace 1)
    ret
...

