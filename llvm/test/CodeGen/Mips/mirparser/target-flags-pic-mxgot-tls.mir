# RUN: llc -mtriple=mips64 -target-abi n64 -start-before=finalize-isel \
# RUN:     -stop-after=finalize-isel -relocation-model=pic -mattr=+xgot \
# RUN:     -o /dev/null %s

# A simple test to show that we can parse the target specific flags: gpoff-hi,
# gpoff-lo, tlsgd, tlsldm, dtprel-hi, dtprel-lo, got-hi, got-lo, call-hi,
# call-lo.

--- |
  @v = global i32 0, align 4
  @k = thread_local global i32 0, align 4
  @j = external thread_local global i32, align 4
  @__tls_guard = internal thread_local global i1 false, align 1
  declare extern_weak void @_ZTH1j()

  declare i32 @_Z1gi(i32 signext)

  define i32 @_Z2k1i(i32 signext %asd) {
  entry:
    %call = tail call i32 @_Z1gi(i32 signext %asd)
    %add = add nsw i32 %call, %asd
    %0 = load i32, ptr @v, align 4
    %add1 = add nsw i32 %add, %0
    %.b.i.i = load i1, ptr @__tls_guard, align 1
    br i1 %.b.i.i, label %entry._ZTW1k.exit_crit_edge, label %init.i.i

  entry._ZTW1k.exit_crit_edge:
    %.pre = load i32, ptr @k, align 4
    br label %_ZTW1k.exit

  init.i.i:
    store i1 true, ptr @__tls_guard, align 1
    %call.i.i.i = tail call i32 @_Z1gi(i32 signext 3)
    store i32 %call.i.i.i, ptr @k, align 4
    br label %_ZTW1k.exit

  _ZTW1k.exit:
    %1 = phi i32 [ %.pre, %entry._ZTW1k.exit_crit_edge ], [ %call.i.i.i, %init.i.i ]
    %add2 = add nsw i32 %add1, %1
    %cmp = icmp ne ptr @_ZTH1j, null
    br i1 %cmp, label %2, label %_ZTW1j.exit

  ; <label>:2:
    tail call void @_ZTH1j()
    br label %_ZTW1j.exit

  _ZTW1j.exit:
    %3 = load i32, ptr @j, align 4
    %add3 = add nsw i32 %add2, %3
    ret i32 %add3
  }
...
---
name:            _Z2k1i
alignment:       8
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
liveins:
  - { reg: '$r4_64', virtual-reg: '%5' }
  - { reg: '$r25_64', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        true
  stackProtector:  ''
  maxCallFrameSize: 4294967295
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  savePoint:       []
  restorePoint:    []
fixedStack:
stack:
constants:
body:             |
  bb.0.entry:
    successors: %bb.1.entry._ZTW1k.exit_crit_edge(0x7fe00000), %bb.2.init.i.i(0x00200000)
    liveins: $r4_64, $r25_64

    %57:gpr64 = LUi64 target-flags(mips-gpoff-hi) @_Z2k1i
    %58:gpr64 = DADDu %57, $r25_64
    %6:gpr64 = DADDiu %58, target-flags(mips-gpoff-lo) @_Z2k1i
    %5:gpr64 = COPY $r4_64
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %7:gpr64 = LUi64 target-flags(mips-call-hi16) @_Z1gi
    %8:gpr64 = DADDu %7, %6
    %9:gpr64 = LD %8, target-flags(mips-call-lo16) @_Z1gi :: (load (s64) from call-entry @_Z1gi)
    $r4_64 = COPY %5
    $r28_64 = COPY %6
    JALR64Pseudo %9, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %10:gpr32 = COPY $r2
    %11:gpr32 = COPY %5.sub_32
    %12:gpr32 = ADDu %10, %11
    %13:gpr64 = LUi64 target-flags(mips-got-hi16) @v
    %14:gpr64 = DADDu %13, %6
    %15:gpr64 = LD %14, target-flags(mips-got-lo16) @v :: (load (s64) from got)
    %16:gpr32 = LW %15, 0 :: (dereferenceable load (s32) from @v)
    %0:gpr32 = ADDu %12, %16
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %17:gpr64 = LUi64 target-flags(mips-call-hi16) &__tls_get_addr
    %18:gpr64 = DADDu %17, %6
    %19:gpr64 = LD %18, target-flags(mips-call-lo16) &__tls_get_addr :: (load (s64) from call-entry &__tls_get_addr)
    %20:gpr64 = DADDiu %6, target-flags(mips-tlsldm) @__tls_guard
    $r4_64 = COPY %20
    $r28_64 = COPY %6
    JALR64Pseudo %19, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2_64
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %21:gpr64 = COPY $r2_64
    %22:gpr64 = DADDiu %21, target-flags(mips-dtprel-hi) @__tls_guard
    %23:gpr32 = LBu %22, target-flags(mips-dtprel-lo) @__tls_guard :: (dereferenceable load (s8) from @__tls_guard)
    BEQ %23, $r0, %bb.2.init.i.i, implicit-def dead $r1
    B %bb.1.entry._ZTW1k.exit_crit_edge, implicit-def dead $r1

  bb.1.entry._ZTW1k.exit_crit_edge:
    successors: %bb.3._ZTW1k.exit(0x80000000)

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %39:gpr64 = LUi64 target-flags(mips-call-hi16) &__tls_get_addr
    %40:gpr64 = DADDu %39, %6
    %41:gpr64 = LD %40, target-flags(mips-call-lo16) &__tls_get_addr :: (load (s64) from call-entry &__tls_get_addr)
    %42:gpr64 = DADDiu %6, target-flags(mips-tlsgd) @k
    $r4_64 = COPY %42
    $r28_64 = COPY %6
    JALR64Pseudo %41, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2_64
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %43:gpr64 = COPY $r2_64
    %1:gpr32 = LW %43, 0 :: (dereferenceable load (s32) from @k)
    B %bb.3._ZTW1k.exit, implicit-def dead $r1

  bb.2.init.i.i:
    successors: %bb.3._ZTW1k.exit(0x80000000)

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %24:gpr64 = LUi64 target-flags(mips-call-hi16) &__tls_get_addr
    %25:gpr64 = DADDu %24, %6
    %26:gpr64 = LD %25, target-flags(mips-call-lo16) &__tls_get_addr :: (load (s64) from call-entry &__tls_get_addr)
    %27:gpr64 = DADDiu %6, target-flags(mips-tlsldm) @__tls_guard
    $r4_64 = COPY %27
    $r28_64 = COPY %6
    JALR64Pseudo %26, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2_64
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %28:gpr64 = COPY $r2_64
    %29:gpr64 = DADDiu %28, target-flags(mips-dtprel-hi) @__tls_guard
    %30:gpr32 = ADDiu $r0, 1
    SB %30, %29, target-flags(mips-dtprel-lo) @__tls_guard :: (store (s8) into @__tls_guard)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %31:gpr64 = LUi64 target-flags(mips-call-hi16) @_Z1gi
    %32:gpr64 = DADDu %31, %6
    %33:gpr64 = DADDiu $r0_64, 3
    %34:gpr64 = LD %32, target-flags(mips-call-lo16) @_Z1gi :: (load (s64) from call-entry @_Z1gi)
    $r4_64 = COPY %33
    $r28_64 = COPY %6
    JALR64Pseudo %34, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %35:gpr32 = COPY $r2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %36:gpr64 = LD %25, target-flags(mips-call-lo16) &__tls_get_addr :: (load (s64) from call-entry &__tls_get_addr)
    %37:gpr64 = DADDiu %6, target-flags(mips-tlsgd) @k
    $r4_64 = COPY %37
    $r28_64 = COPY %6
    JALR64Pseudo %36, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2_64
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %38:gpr64 = COPY $r2_64
    SW %35, %38, 0 :: (store (s32) into @k)
    %2:gpr32 = COPY %35

  bb.3._ZTW1k.exit:
    successors: %bb.4(0x40000000), %bb.5._ZTW1j.exit(0x40000000)

    %3:gpr32 = PHI %2, %bb.2.init.i.i, %1, %bb.1.entry._ZTW1k.exit_crit_edge
    %4:gpr32 = ADDu %0, %3
    %44:gpr64 = LUi64 target-flags(mips-got-hi16) @_ZTH1j
    %45:gpr64 = DADDu %44, %6
    %46:gpr64 = LD %45, target-flags(mips-got-lo16) @_ZTH1j :: (load (s64) from got)
    BEQ64 %46, $r0_64, %bb.5._ZTW1j.exit, implicit-def dead $r1
    B %bb.4, implicit-def dead $r1

  bb.4 (%ir-block.2):
    successors: %bb.5._ZTW1j.exit(0x80000000)

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %47:gpr64 = LUi64 target-flags(mips-call-hi16) @_ZTH1j
    %48:gpr64 = DADDu %47, %6
    %49:gpr64 = LD %48, target-flags(mips-call-lo16) @_ZTH1j :: (load (s64) from call-entry @_ZTH1j)
    $r28_64 = COPY %6
    JALR64Pseudo %49, csr_n64, implicit-def dead $r31, implicit $r28_64, implicit-def $r29
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29

  bb.5._ZTW1j.exit:
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $r29, implicit $r29
    %50:gpr64 = LUi64 target-flags(mips-call-hi16) &__tls_get_addr
    %51:gpr64 = DADDu %50, %6
    %52:gpr64 = LD %51, target-flags(mips-call-lo16) &__tls_get_addr :: (load (s64) from call-entry &__tls_get_addr)
    %53:gpr64 = DADDiu %6, target-flags(mips-tlsgd) @j
    $r4_64 = COPY %53
    $r28_64 = COPY %6
    JALR64Pseudo %52, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2_64
    ADJCALLSTACKUP 0, 0, implicit-def dead $r29, implicit $r29
    %54:gpr64 = COPY $r2_64
    %55:gpr32 = LW %54, 0 :: (dereferenceable load (s32) from @j)
    %56:gpr32 = ADDu %4, %55
    $r2 = COPY %56
    RetRA implicit $r2

...

