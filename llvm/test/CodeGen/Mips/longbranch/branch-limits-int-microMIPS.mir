name:            expand_BEQ_MM
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
registers:
liveins:
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  maxCallFrameSize: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  localFrameSize:  0
  savePoint:       []
  restorePoint:    []
fixedStack:
stack:
constants:
body:             |
  ; MM-LABEL: name: expand_BEQ_MM
  ; MM: bb.0 (%ir-block.0):
  ; MM:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; MM:   renamable $r1 = ANDi killed renamable $r4, 1
  ; MM:   BNEZC_MM $r1, %bb.2, implicit-def $r1
  ; MM: bb.1 (%ir-block.0):
  ; MM:   successors: %bb.3(0x80000000)
  ; MM:   J %bb.3, implicit-def $r1 {
  ; MM:     $r0 = SLL_MM $r0, 0
  ; MM:   }
  ; MM: bb.2.iftrue:
  ; MM:   successors: %bb.3(0x80000000)
  ; MM:   INLINEASM &".space 131068", sideeffect attdialect
  ; MM: bb.3.tail:
  ; MM:   JRC16_MM undef $r31
  ; PIC-LABEL: name: expand_BEQ_MM
  ; PIC: bb.0 (%ir-block.0):
  ; PIC:   successors: %bb.3(0x40000000), %bb.1(0x40000000)
  ; PIC:   renamable $r1 = ANDi killed renamable $r4, 1
  ; PIC:   BNEZC_MM $r1, %bb.3, implicit-def $r1
  ; PIC: bb.1 (%ir-block.0):
  ; PIC:   successors: %bb.2(0x80000000)
  ; PIC:   $r29 = ADDiu $r29, -8
  ; PIC:   SW $r31, $r29, 0
  ; PIC:   $r1 = LONG_BRANCH_LUi target-flags(mips-abs-hi) %bb.4, %bb.2
  ; PIC:   BAL_BR_MM %bb.2, implicit-def $r31 {
  ; PIC:     $r1 = LONG_BRANCH_ADDiu $r1, target-flags(mips-abs-lo) %bb.4, %bb.2
  ; PIC:   }
  ; PIC: bb.2 (%ir-block.0):
  ; PIC:   successors: %bb.4(0x80000000)
  ; PIC:   $r1 = ADDu $r31, $r1
  ; PIC:   $r31 = LW $r29, 0
  ; PIC:   JR $r1 {
  ; PIC:     $r29 = ADDiu $r29, 8
  ; PIC:   }
  ; PIC: bb.3.iftrue:
  ; PIC:   successors: %bb.4(0x80000000)
  ; PIC:   INLINEASM &".space 131068", sideeffect attdialect
  ; PIC: bb.4.tail:
  ; PIC:   JRC16_MM undef $r31
  bb.0 (%ir-block.0):
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r4

    renamable $r1 = ANDi killed renamable $r4, 1
    BEQ_MM killed renamable $r1, $r0, %bb.2, implicit-def $r1

  bb.1.iftrue:
    successors: %bb.2(0x80000000)

    INLINEASM &".space 131068", sideeffect attdialect

  bb.2.tail:
    PseudoReturn undef $r31

...
