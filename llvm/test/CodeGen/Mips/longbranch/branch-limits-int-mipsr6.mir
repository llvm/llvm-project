name:            expand_BEQC
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
registers:
liveins:
  - { reg: '$r4', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  maxCallFrameSize: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  localFrameSize:  0
  savePoint:       []
  restorePoint:    []
fixedStack:
stack:
constants:
body:             |
  ; R6-LABEL: name: expand_BEQC
  ; R6: bb.0 (%ir-block.0):
  ; R6:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; R6:   renamable $r1 = ANDi killed renamable $r4, 1
  ; R6:   BNEC $r1, $r0, %bb.2, implicit-def $r1
  ; R6: bb.1 (%ir-block.0):
  ; R6:   successors: %bb.3(0x80000000)
  ; R6:   BC %bb.3
  ; R6: bb.2.iftrue:
  ; R6:   successors: %bb.3(0x80000000)
  ; R6:   INLINEASM &".space 131068", sideeffect attdialect
  ; R6: bb.3.tail:
  ; R6:   JIC undef $r31, 0, implicit-def $r1
  ; PIC-LABEL: name: expand_BEQC
  ; PIC: bb.0 (%ir-block.0):
  ; PIC:   successors: %bb.3(0x40000000), %bb.1(0x40000000)
  ; PIC:   renamable $r1 = ANDi killed renamable $r4, 1
  ; PIC:   BNEC $r1, $r0, %bb.3, implicit-def $r1
  ; PIC: bb.1 (%ir-block.0):
  ; PIC:   successors: %bb.2(0x80000000)
  ; PIC:   $r29 = ADDiu $r29, -8
  ; PIC:   SW $r31, $r29, 0
  ; PIC:   $r1 = LONG_BRANCH_LUi target-flags(mips-abs-hi) %bb.4, %bb.2
  ; PIC:   $r1 = LONG_BRANCH_ADDiu $r1, target-flags(mips-abs-lo) %bb.4, %bb.2
  ; PIC:   BALC %bb.2, implicit-def $r31
  ; PIC: bb.2 (%ir-block.0):
  ; PIC:   successors: %bb.4(0x80000000)
  ; PIC:   $r1 = ADDu $r31, $r1
  ; PIC:   $r31 = LW $r29, 0
  ; PIC:   $r29 = ADDiu $r29, 8
  ; PIC:   JIC $r1, 0, implicit-def $r1
  ; PIC: bb.3.iftrue:
  ; PIC:   successors: %bb.4(0x80000000)
  ; PIC:   INLINEASM &".space 131068", sideeffect attdialect
  ; PIC: bb.4.tail:
  ; PIC:   JIC undef $r31, 0, implicit-def $r1
  bb.0 (%ir-block.0):
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r4

    renamable $r1 = ANDi killed renamable $r4, 1
    BEQC killed renamable $r1, $r0, %bb.2, implicit-def $r1

  bb.1.iftrue:
    successors: %bb.2(0x80000000)

    INLINEASM &".space 131068", sideeffect attdialect

  bb.2.tail:
    PseudoReturn undef $r31

...
