# RUN: llc -mtriple=mipsel-sony-psp -mcpu=mips2 -mattr=+single-float -filetype=obj -o /dev/null %s
# RUN: llc -mtriple=mipsel-sony-psp -mcpu=mips2 -mattr=+single-float -stop-after mips-branch-expansion -o - %s | FileCheck %s --check-prefixes=MIPS2

--- |
  define void @mflo_delay_slot_bundle_size() {
    ret void
  }
...
---
name:            mflo_delay_slot_bundle_size
alignment:       4
tracksRegLiveness: true
body:             |
  ; MIPS2-LABEL: name: mflo_delay_slot_bundle_size
  ; MIPS2: bb.0:
  ; MIPS2: BNE $r4, $r5, %bb.{{[0-9]+}}
  ; MIPS2-NEXT: $r0 = SLL $r0, 0
  ; MIPS2: J %bb.{{[0-9]+}}
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $r4, $r5
    BEQ undef $r4, undef $r5, %bb.3, implicit-def $r1

  bb.1:
    successors: %bb.2, %bb.4
    liveins: $r4, $r2
    INLINEASM &".space 131032", sideeffect attdialect
    BEQ undef $r4, undef $r2, %bb.4, implicit-def $r1

  ; MIPS2: bb.2:
  ; MIPS2: $r4 = MFLO implicit $ac0
  ; MIPS2-NEXT: $r0 = SLL $r0, 0
  ; MIPS2-NEXT: $r0 = SLL $r0, 0
  bb.2:
    successors: %bb.3, %bb.4
    liveins: $r4, $r3, $ac0
    $r4 = MFLO implicit $ac0
    renamable $ac0 = PseudoMULT $r4, $r3
    $r4 = MFLO implicit $ac0
    BEQ killed $r4, killed $r3, %bb.4, implicit-def $r1

  bb.3:
    PseudoReturn undef $r31

  bb.4:
    PseudoReturn undef $r31
...
