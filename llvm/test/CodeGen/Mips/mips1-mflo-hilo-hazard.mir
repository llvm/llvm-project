  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r2, $r4, $r5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $ac0 = PseudoMULTu $r4, $r5
  ; CHECK-NEXT:   $r3 = MFLO implicit $ac0
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit $r2, implicit $r3
  bb.0:
    successors: %bb.1
    liveins: $r4, $r5, $ac0

    $r2 = MFLO implicit $ac0

  bb.1:
    liveins: $r2, $r4, $r5

    renamable $ac0 = PseudoMULTu $r4, $r5
    $r3 = MFLO implicit $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3
...
