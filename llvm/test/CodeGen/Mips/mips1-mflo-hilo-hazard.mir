# RUN: llc -mtriple=mipsel-linux-gnu -mcpu=mips1 -run-pass=mips-branch-expansion \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

# MIPS I to MIPS IV need two instructions between an mflo or mfhi and the next
# instruction that writes HI or LO, on every path, including the instruction
# in a delay slot and the first instructions of the successors.

--- |
  define void @mflo_mthi() { ret void }
  define void @mflo_fallthrough_multu() { ret void }
  define void @mflo_branch_target_mult() { ret void }
  define void @mflo_in_delay_slot() { ret void }
...
---
name:            mflo_mthi
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $ac0

    ; CHECK-LABEL: name: mflo_mthi
    ; CHECK: liveins: $r4, $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = MFLO implicit $ac0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: MTHI $r4, implicit-def $hi0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2
    $r2 = MFLO implicit $ac0
    MTHI $r4, implicit-def $hi0
    PseudoReturn undef $r31, implicit $r2
...
