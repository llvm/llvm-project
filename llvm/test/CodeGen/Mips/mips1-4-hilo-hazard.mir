...
---
# On MIPS I, the load-delay nop counts toward the distance: no HI/LO nop.
# On MIPS II to IV, which have no load delay, one HI/LO nop.
name:            mflo_load_mult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $ac0

    ; MIPS1-LABEL: name: mflo_load_mult
    ; MIPS1: liveins: $r4, $r5, $ac0
    ; MIPS1-NEXT: {{  $}}
    ; MIPS1-NEXT: $r3 = MFLO implicit $ac0
    ; MIPS1-NEXT: $r2 = LW killed $r4, 0 {
    ; MIPS1-NEXT:   $r0 = SLL $r0, 0
    ; MIPS1-NEXT: }
    ; MIPS1-NEXT: $ac0 = PseudoMULT killed $r2, killed $r5
    ; MIPS1-NEXT: $r2 = MFLO implicit killed $ac0
    ; MIPS1-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3 {
    ; MIPS1-NEXT:   $r0 = SLL $r0, 0
    ; MIPS1-NEXT: }
    ;
    ; MIPS2-4-LABEL: name: mflo_load_mult
    ; MIPS2-4: liveins: $r4, $r5, $ac0
    ; MIPS2-4-NEXT: {{  $}}
    ; MIPS2-4-NEXT: $r3 = MFLO implicit $ac0
    ; MIPS2-4-NEXT: $r2 = LW killed $r4, 0
    ; MIPS2-4-NEXT: $r0 = SLL $r0, 0
    ; MIPS2-4-NEXT: $ac0 = PseudoMULT killed $r2, killed $r5
    ; MIPS2-4-NEXT: $r2 = MFLO implicit killed $ac0
    ; MIPS2-4-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3 {
    ; MIPS2-4-NEXT:   $r0 = SLL $r0, 0
    ; MIPS2-4-NEXT: }
    $r3 = MFLO implicit $ac0
    $r2 = LW killed $r4, 0
    $ac0 = PseudoMULT killed $r2, killed $r5
    $r2 = MFLO implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }
...
