---
# Debug and KILL instructions issue nothing and do not count: one nop.
name:            mflo_transient_between_mult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $ac0

    ; CHECK-LABEL: name: mflo_transient_between_mult
    ; CHECK: liveins: $r4, $r5, $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = MFLO implicit $ac0
    ; CHECK-NEXT: DBG_VALUE $r3, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: KILL $r4
    ; CHECK-NEXT: $r2 = ADDu $r4, $r5
    ; CHECK-NEXT: DBG_VALUE $r2, $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $ac0 = PseudoMULT killed $r2, killed $r5
    ; CHECK-NEXT: $r2 = MFLO implicit killed $ac0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r3 = MFLO implicit $ac0
    DBG_VALUE $r3, $noreg, !5, !DIExpression(), debug-location !6
    KILL $r4
    $r2 = ADDu $r4, $r5
    DBG_VALUE $r2, $noreg, !5, !DIExpression(), debug-location !6
    $ac0 = PseudoMULT killed $r2, killed $r5
    $r2 = MFLO implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }
...
---
# The register mask of a call is not a HI/LO write, and the call and its
# delay slot put the callee two instructions past the read: no nop.
name:            mflo_call
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $ac0

    ; CHECK-LABEL: name: mflo_call
    ; CHECK: liveins: $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r16 = MFLO implicit $ac0
    ; CHECK-NEXT: JAL @f, csr_o32, implicit-def dead $r31, implicit-def $r29 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r16 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r16 = MFLO implicit $ac0
    JAL @f, csr_o32, implicit-def dead $r31, implicit-def $r29 {
      $r0 = SLL $r0, 0
    }
    PseudoReturn undef $r31, implicit $r16 {
      $r0 = SLL $r0, 0
    }
...
---
# Inline assembly may write HI/LO: two nops.
name:            mflo_inlineasm
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $ac0

    ; CHECK-LABEL: name: mflo_inlineasm
    ; CHECK: liveins: $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = MFLO implicit $ac0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r2 = MFLO implicit $ac0
    INLINEASM &"", 1 /* sideeffect attdialect */
    PseudoReturn undef $r31, implicit $r2 {
      $r0 = SLL $r0, 0
    }
...
---
# Inline assembly may read HI/LO: two nops.
name:            inlineasm_mult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: inlineasm_mult
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect
