# RUN: llc -mtriple=mips -mcpu=mips1 -run-pass=mips-branch-expansion \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=CHECK,MIPS1
# RUN: llc -mtriple=mips -mcpu=mips2 -run-pass=mips-branch-expansion \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=CHECK,MIPS2-4
# RUN: llc -mtriple=mips -mcpu=mips4 -run-pass=mips-branch-expansion \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=CHECK,MIPS2-4

# On MIPS I to IV, an instruction writing HI or LO must not be issued within
# two instructions of a mfhi or mflo: if the read is restarted after an
# exception, it would read the value of the new operation.

--- |
  define void @mflo_mtlo() { ret void }
  define void @mfhi_mthi() { ret void }
  define void @mfhi_mtlohi() { ret void }
  define void @mflo_mfhi_mult() { ret void }
  define void @mflo_fallthrough_multu() { ret void }
  define void @mflo_mult_in_delay_slot() { ret void }
  define void @mflo_two_apart_mult() { ret void }
  define void @mflo_fallthrough_one_apart_mult() { ret void }
  define void @mflo_transient_between_mult() !dbg !4 { ret void }
  define void @mflo_call() { ret void }
  define void @mflo_inlineasm() { ret void }
  define void @inlineasm_mult() { ret void }
  define void @mflo_load_mult() { ret void }
  declare void @f()

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !DISubroutineType(types: !{})
  !4 = distinct !DISubprogram(name: "mflo_transient_between_mult", scope: !1, file: !1, line: 1, type: !3, unit: !0)
  !5 = !DILocalVariable(name: "x", scope: !4, file: !1, line: 1)
  !6 = !DILocation(line: 1, scope: !4)
...
---
# A write of LO right after a mflo: two nops.
name:            mflo_mtlo
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $ac0

    ; CHECK-LABEL: name: mflo_mtlo
    ; CHECK: liveins: $r4, $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = MFLO implicit $ac0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: MTLO killed $r4, implicit-def $lo0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r2 = MFLO implicit $ac0
    MTLO killed $r4, implicit-def $lo0
    PseudoReturn undef $r31, implicit $r2 {
      $r0 = SLL $r0, 0
    }
...
---
# A write of HI one instruction after a mfhi: one nop.
name:            mfhi_mthi
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $ac0

    ; CHECK-LABEL: name: mfhi_mthi
    ; CHECK: liveins: $r4, $r5, $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = MFHI implicit $ac0
    ; CHECK-NEXT: $r3 = ADDu $r4, $r5
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: MTHI killed $r4, implicit-def $hi0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r2 = MFHI implicit $ac0
    $r3 = ADDu $r4, $r5
    MTHI killed $r4, implicit-def $hi0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }
...
---
