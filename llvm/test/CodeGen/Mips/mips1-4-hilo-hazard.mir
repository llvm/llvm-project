---
# The window starts again at the second of two back-to-back reads: one nop.
name:            mflo_mfhi_mult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $ac0

    ; CHECK-LABEL: name: mflo_mfhi_mult
    ; CHECK: liveins: $r4, $r5, $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = MFLO implicit $ac0
    ; CHECK-NEXT: $r2 = MFHI implicit $ac0
    ; CHECK-NEXT: $r2 = ADDiu killed $r2, 1
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $ac0 = PseudoMULT killed $r2, killed $r5
    ; CHECK-NEXT: $r2 = MFLO implicit killed $ac0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r3 = MFLO implicit $ac0
    $r2 = MFHI implicit $ac0
    $r2 = ADDiu killed $r2, 1
    $ac0 = PseudoMULT killed $r2, killed $r5
    $r2 = MFLO implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }
...
---
# The read ends a block that falls through to the writer: two nops.
name:            mflo_fallthrough_multu
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: mflo_fallthrough_multu
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $ac0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r3 = MFLO implicit $ac0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r4, $r5, $r3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = SLL $r0, 0
  ; CHECK-NEXT:   $r0 = SLL $r0, 0
  ; CHECK-NEXT:   $ac0 = PseudoMULTu killed $r4, killed $r5
  ; CHECK-NEXT:   $r2 = MFLO implicit killed $ac0
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit $r2, implicit $r3 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  bb.0:
    successors: %bb.1
    liveins: $r4, $r5, $ac0

    $r3 = MFLO implicit $ac0

  bb.1:
    liveins: $r4, $r5, $r3

    $ac0 = PseudoMULTu killed $r4, killed $r5
    $r2 = MFLO implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }
...
---
# The writer sits in the delay slot of the branch after the read: one nop
# before the branch.
name:            mflo_mult_in_delay_slot
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: mflo_mult_in_delay_slot
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $ac0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r3 = MFLO implicit $ac0
  ; CHECK-NEXT:   $r0 = SLL $r0, 0
  ; CHECK-NEXT:   BEQ $r4, $r0, %bb.2, implicit-def $r1 {
  ; CHECK-NEXT:     $ac0 = PseudoMULT $r4, $r5
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $ac0, $r3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r2 = MFHI implicit killed $ac0
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit $r2, implicit $r3 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $ac0, $r3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r2 = MFLO implicit killed $ac0
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit $r2, implicit $r3 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5, $ac0

    $r3 = MFLO implicit $ac0
    BEQ $r4, $r0, %bb.2, implicit-def $r1 {
      $ac0 = PseudoMULT $r4, $r5
    }

  bb.1:
    liveins: $ac0, $r3

    $r2 = MFHI implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }

  bb.2:
    liveins: $ac0, $r3

    $r2 = MFLO implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2, implicit $r3 {
      $r0 = SLL $r0, 0
    }
...
---
# Two instructions stand between the read and the writer: no nop.
name:            mflo_two_apart_mult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $ac0

    ; CHECK-LABEL: name: mflo_two_apart_mult
    ; CHECK: liveins: $r4, $r5, $ac0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = MFLO implicit $ac0
    ; CHECK-NEXT: $r2 = ADDu $r4, $r5
    ; CHECK-NEXT: $r4 = ADDu $r4, $r3
    ; CHECK-NEXT: $ac0 = PseudoMULT killed $r2, killed $r4
    ; CHECK-NEXT: $r2 = MFLO implicit killed $ac0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r3 = MFLO implicit $ac0
    $r2 = ADDu $r4, $r5
    $r4 = ADDu $r4, $r3
    $ac0 = PseudoMULT killed $r2, killed $r4
    $r2 = MFLO implicit killed $ac0
    PseudoReturn undef $r31, implicit $r2 {
      $r0 = SLL $r0, 0
    }
...
---
# One instruction separates the read from the fall-through block: one nop.
name:            mflo_fallthrough_one_apart_mult
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: mflo_fallthrough_one_apart_mult
  ; CHECK: bb.0:
