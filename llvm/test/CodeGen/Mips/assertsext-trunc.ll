; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=mips64 -mcpu=mips64r2 -relocation-model=static | \
; RUN:   FileCheck %s
; RUN: llc < %s -mtriple=mips64 -mcpu=mips64r6 -relocation-model=static | \
; RUN:   FileCheck %s

; When a value is used in a different block than the one that defines it, its
; copy is given an AssertSext based on its known sign bits. Truncating such a
; value to i32 can only be done with an extract_subreg when it is known to be
; sign extended from bit 31. Otherwise, an sll is needed so that the i32 value
; is sign extended in its 64-bit register, as 32-bit comparisons rely on it.

declare void @ext()

; (trunc:i32 (AssertSext:i64 X, i32)): the extract_subreg is sufficient.
define i1 @trunc_assertsext_i32(i64 %a, i32 signext %b, i1 %c) {
; CHECK-LABEL: trunc_assertsext_i32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    daddiu $sp, $sp, -32
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    sd $ra, 24($sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd $17, 16($sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd $16, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    .cfi_offset 17, -16
; CHECK-NEXT:    .cfi_offset 16, -24
; CHECK-NEXT:    lui $1, 32768
; CHECK-NEXT:    or $17, $4, $1
; CHECK-NEXT:    sll $1, $6, 0
; CHECK-NEXT:    andi $1, $1, 1
; CHECK-NEXT:    beqz $1, .LBB0_2
; CHECK-NEXT:    move $16, $5
; CHECK-NEXT:  # %bb.1: # %then
; CHECK-NEXT:    jal ext
; CHECK-NEXT:    nop
; CHECK-NEXT:  .LBB0_2: # %exit
; CHECK-NEXT:    xor $1, $17, $16
; CHECK-NEXT:    sltiu $2, $1, 1
; CHECK-NEXT:    ld $16, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    ld $17, 16($sp) # 8-byte Folded Reload
; CHECK-NEXT:    ld $ra, 24($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    daddiu $sp, $sp, 32
entry:
  %x = or i64 %a, -2147483648
  br i1 %c, label %then, label %exit

then:
  call void @ext()
  br label %exit

exit:
  %t = trunc i64 %x to i32
  %cmp = icmp eq i32 %t, %b
  ret i1 %cmp
}

