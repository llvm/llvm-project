; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    .cfi_offset 17, -16
; CHECK-NEXT:    .cfi_offset 16, -24
; CHECK-NEXT:    lui $1, 65535
; CHECK-NEXT:    ori $1, $1, 65535
; CHECK-NEXT:    dsll $1, $1, 32
; CHECK-NEXT:    or $17, $4, $1
; CHECK-NEXT:    sll $1, $6, 0
; CHECK-NEXT:    andi $1, $1, 1
; CHECK-NEXT:    beqz $1, .LBB1_2
