# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mipsel-linux-gnu -run-pass=greedy,virt-reg-rewriter -o - %s | FileCheck %s

# Omit maxCallFrameSize so mirFileLoaded() must compute it before register allocation.
# Check that $r30 is reserved as FP for a large call frame, but available for a small one.

---
name: large_call_frame
registers:
  - { id: 0, class: gpr32, preferred-register: '$r30' }
frameInfo:
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    ; CHECK-LABEL: name: large_call_frame
    ; CHECK: renamable $r16 = ADDiu $r0, 42
    ; CHECK-NEXT: ADJCALLSTACKDOWN 40000, 0, implicit-def dead $r29, implicit $r29
    ; CHECK-NEXT: JAL &callee, csr_o32, implicit-def dead $r31, implicit-def $r29
    ; CHECK-NEXT: ADJCALLSTACKUP 40000, 0, implicit-def dead $r29, implicit $r29
    ; CHECK-NEXT: $r2 = ADDiu killed renamable $r16, 1
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = ADDiu $r0, 42
    ADJCALLSTACKDOWN 40000, 0, implicit-def dead $r29, implicit $r29
    JAL &callee, csr_o32, implicit-def dead $r31, implicit-def $r29
    ADJCALLSTACKUP 40000, 0, implicit-def dead $r29, implicit $r29
    $r2 = ADDiu %0, 1
    RetRA implicit $r2
...

---
name: small_call_frame
registers:
  - { id: 0, class: gpr32, preferred-register: '$r30' }
frameInfo:
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    ; CHECK-LABEL: name: small_call_frame
    ; CHECK: renamable $r30 = ADDiu $r0, 42
    ; CHECK-NEXT: ADJCALLSTACKDOWN 16, 0, implicit-def dead $r29, implicit $r29
    ; CHECK-NEXT: JAL &callee, csr_o32, implicit-def dead $r31, implicit-def $r29
    ; CHECK-NEXT: ADJCALLSTACKUP 16, 0, implicit-def dead $r29, implicit $r29
    ; CHECK-NEXT: $r2 = ADDiu killed renamable $r30, 1
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = ADDiu $r0, 42
    ADJCALLSTACKDOWN 16, 0, implicit-def dead $r29, implicit $r29
    JAL &callee, csr_o32, implicit-def dead $r31, implicit-def $r29
    ADJCALLSTACKUP 16, 0, implicit-def dead $r29, implicit $r29
    $r2 = ADDiu %0, 1
    RetRA implicit $r2
...
