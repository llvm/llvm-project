# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mipsel-linux-gnu -mcpu=mips1 -verify-machineinstrs \
# RUN:   -run-pass=mips-branch-expansion %s -o - | FileCheck %s

# MIPS I has no load or FPU move interlocks. An instruction that reads a
# double register must not directly follow a lwc1 or mtc1 that writes one of
# its halves.

---
name:            load_overlap
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $d0, $f2
    ; CHECK-LABEL: name: load_overlap
    ; CHECK: liveins: $r4, $d0, $f2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $f3 = LWC1 $r4, 4 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $d0 = FADD_D32 $d1, $d0, implicit $fcr31
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $d0
    $f3 = LWC1 $r4, 4
    $d0 = FADD_D32 $d1, $d0, implicit $fcr31
    PseudoReturn undef $r31, implicit $d0
...
---
name:            mtc1_overlap
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $d0, $f2
    ; CHECK-LABEL: name: mtc1_overlap
    ; CHECK: liveins: $r4, $d0, $f2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $f3 = MTC1 $r4 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $d0 = FADD_D32 $d1, $d0, implicit $fcr31
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $d0
    $f3 = MTC1 $r4
    $d0 = FADD_D32 $d1, $d0, implicit $fcr31
    PseudoReturn undef $r31, implicit $d0
...
---
name:            load_no_overlap
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $d0, $d1
    ; CHECK-LABEL: name: load_no_overlap
    ; CHECK: liveins: $r4, $d0, $d1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $f5 = LWC1 $r4, 4
    ; CHECK-NEXT: $d0 = FADD_D32 $d1, $d0, implicit $fcr31
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $d0
    $f5 = LWC1 $r4, 4
    $d0 = FADD_D32 $d1, $d0, implicit $fcr31
    PseudoReturn undef $r31, implicit $d0
...
