# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# Debug instructions must not affect register bank inference.
# RegBankSelect reports a GISel failure when mapping DBG_VALUE, so allow its
# fallback after checking the selected banks.
# Keep each DBG_VALUE after the instructions whose banks are checked.
# RUN: llc -O0 -mtriple=mipsel-linux-gnu -run-pass=reg-bank-select -global-isel-abort=0 -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target datalayout = "e-m:m-p:32:32-i8:8:32-i16:16:32-i64:64-n32-S64"
  target triple = "mipsel-unknown-linux-gnu"

  define float @direct_debug_use(ptr %p, float %a) !dbg !3 {
  entry:
    %x = load float, ptr %p, align 4
    %r = fadd float %x, %a
      #dbg_value(float %x, !6, !DIExpression(), !8)
    ret float %r
  }

  define float @debug_only_copy_use(ptr %p, float %a) !dbg !9 {
  entry:
    %x = load float, ptr %p, align 4
    %r = fadd float %x, %a
      #dbg_value(float %x, !10, !DIExpression(), !11)
    ret float %r
  }

  define void @implicit_def_debug_only() !dbg !12 {
  entry:
      #dbg_value(i32 poison, !13, !DIExpression(), !15)
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "hand", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "debug-uses.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "direct_debug_use", scope: null, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !DILocalVariable(name: "x", scope: !3, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "float", size: 32, encoding: DW_ATE_float)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
  !9 = distinct !DISubprogram(name: "debug_only_copy_use", scope: null, file: !1, line: 2, type: !4, scopeLine: 2, spFlags: DISPFlagDefinition, unit: !0)
  !10 = !DILocalVariable(name: "x", scope: !9, file: !1, line: 2, type: !7)
  !11 = !DILocation(line: 2, column: 1, scope: !9)
  !12 = distinct !DISubprogram(name: "implicit_def_debug_only", scope: null, file: !1, line: 3, type: !4, scopeLine: 3, spFlags: DISPFlagDefinition, unit: !0)
  !13 = !DILocalVariable(name: "u", scope: !12, file: !1, line: 3, type: !14)
  !14 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !15 = !DILocation(line: 3, column: 1, scope: !12)
...
---
name:            direct_debug_use
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $a0, $a1

    ; CHECK-LABEL: name: direct_debug_use
    ; CHECK: liveins: $a0, $a1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gprb(p0) = COPY $a0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gprb(s32) = COPY $a1
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:fprb(s32) = G_LOAD [[COPY]](p0) :: (load (s32) from %ir.p)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fprb(s32) = COPY [[COPY1]](s32)
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:fprb(s32) = G_FADD [[LOAD]], [[COPY2]]
    ; CHECK-NEXT: DBG_VALUE [[LOAD]](s32), $noreg, !6, !DIExpression(), debug-location !8
    ; CHECK-NEXT: $f0 = COPY [[FADD]](s32)
    ; CHECK-NEXT: RetRA implicit $f0
    %0:_(p0) = COPY $a0
    %1:_(s32) = COPY $a1
    %2:_(s32) = G_LOAD %0(p0) :: (load (s32) from %ir.p)
    %3:_(s32) = G_FADD %2, %1
    DBG_VALUE %2(s32), $noreg, !6, !DIExpression(), debug-location !8
    $f0 = COPY %3(s32)
    RetRA implicit $f0
...
---
name:            debug_only_copy_use
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.1.entry:
    liveins: $a0, $a1

    ; CHECK-LABEL: name: debug_only_copy_use
    ; CHECK: liveins: $a0, $a1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gprb(p0) = COPY $a0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gprb(s32) = COPY $a1
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:fprb(s32) = G_LOAD [[COPY]](p0) :: (load (s32) from %ir.p)
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:fprb(s32) = COPY [[COPY1]](s32)
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:fprb(s32) = G_FADD [[LOAD]], [[COPY2]]
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:fprb(s32) = COPY [[LOAD]](s32)
    ; CHECK-NEXT: DBG_VALUE [[COPY3]](s32), $noreg, !10, !DIExpression(), debug-location !11
    ; CHECK-NEXT: $f0 = COPY [[FADD]](s32)
    ; CHECK-NEXT: RetRA implicit $f0
    %0:_(p0) = COPY $a0
    %1:_(s32) = COPY $a1
    %2:_(s32) = G_LOAD %0(p0) :: (load (s32) from %ir.p)
    %3:_(s32) = G_FADD %2, %1
    %4:_(s32) = COPY %2(s32)
    DBG_VALUE %4(s32), $noreg, !10, !DIExpression(), debug-location !11
    $f0 = COPY %3(s32)
    RetRA implicit $f0
...
---
name:            implicit_def_debug_only
alignment:       4
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0.entry:
    ; CHECK-LABEL: name: implicit_def_debug_only
    ; CHECK: [[DEF:%[0-9]+]]:gprb(s32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: DBG_VALUE [[DEF]](s32), $noreg, !13, !DIExpression(), debug-location !15
    ; CHECK-NEXT: RetRA
    %0:_(s32) = G_IMPLICIT_DEF
    DBG_VALUE %0(s32), $noreg, !13, !DIExpression(), debug-location !15
    RetRA
...
