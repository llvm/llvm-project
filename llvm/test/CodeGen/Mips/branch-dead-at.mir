    $r2 = ADDiu $r0, 1
    B %bb.3, implicit-def dead $r1

  bb.2:
    successors: %bb.3(0x80000000)

    $r2 = ADDiu $r0, 2

  bb.3:
    liveins: $r2

    $r2 = ADDiu killed $r2, 3
    $r2 = ADDiu killed $r2, 4
    $r2 = ADDiu killed $r2, 5
    $r2 = ADDiu killed $r2, 6
    $r2 = ADDiu killed $r2, 7
    $r2 = ADDiu killed $r2, 8
    PseudoReturn undef $r31, implicit killed $r2
...
