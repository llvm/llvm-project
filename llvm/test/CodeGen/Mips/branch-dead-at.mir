# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips-unknown-linux-gnu -run-pass=block-placement -o - %s | FileCheck %s

# The assembler temporary clobbered by long branch expansion is dead in
# branches rebuilt after instruction selection.

---
name:            invert_cond_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: invert_cond_branch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x60000000), %bb.1(0x20000000)
  ; CHECK-NEXT:   liveins: $a0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ renamable $a0, $zero, %bb.1, implicit-def dead $at
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $v0 = ADDiu $zero, 2
  ; CHECK-NEXT:   PseudoReturn undef $ra, implicit killed $v0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $v0 = ADDiu $zero, 1
  ; CHECK-NEXT:   PseudoReturn undef $ra, implicit killed $v0
  bb.0:
    successors: %bb.2(0x60000000), %bb.1(0x20000000)
    liveins: $a0

    BNE renamable $a0, $zero, %bb.2, implicit-def dead $at
    B %bb.1, implicit-def dead $at

  bb.1:
    successors: %bb.3(0x80000000)

    $v0 = ADDiu $zero, 1
    B %bb.3, implicit-def dead $at

  bb.2:
    successors: %bb.3(0x80000000)

    $v0 = ADDiu $zero, 2

  bb.3:
    liveins: $v0

    PseudoReturn undef $ra, implicit killed $v0
...
---
name:            insert_uncond_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: insert_uncond_branch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x70000000), %bb.2(0x10000000)
  ; CHECK-NEXT:   liveins: $a0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE renamable $a0, $zero, %bb.2, implicit-def dead $at
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $v0 = ADDiu $zero, 1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $v0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $v0 = ADDiu killed $v0, 3
  ; CHECK-NEXT:   $v0 = ADDiu killed $v0, 4
  ; CHECK-NEXT:   $v0 = ADDiu killed $v0, 5
  ; CHECK-NEXT:   $v0 = ADDiu killed $v0, 6
  ; CHECK-NEXT:   $v0 = ADDiu killed $v0, 7
  ; CHECK-NEXT:   $v0 = ADDiu killed $v0, 8
  ; CHECK-NEXT:   PseudoReturn undef $ra, implicit killed $v0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $v0 = ADDiu $zero, 2
  ; CHECK-NEXT:   J %bb.3, implicit-def dead $at
  bb.0:
    successors: %bb.1(0x70000000), %bb.2(0x10000000)
    liveins: $a0

    BNE renamable $a0, $zero, %bb.2, implicit-def dead $at
    B %bb.1, implicit-def dead $at

  bb.1:
    successors: %bb.3(0x80000000)

    $v0 = ADDiu $zero, 1
    B %bb.3, implicit-def dead $at

  bb.2:
    successors: %bb.3(0x80000000)

    $v0 = ADDiu $zero, 2

  bb.3:
    liveins: $v0

    $v0 = ADDiu killed $v0, 3
    $v0 = ADDiu killed $v0, 4
    $v0 = ADDiu killed $v0, 5
    $v0 = ADDiu killed $v0, 6
    $v0 = ADDiu killed $v0, 7
    $v0 = ADDiu killed $v0, 8
    PseudoReturn undef $ra, implicit killed $v0
...
