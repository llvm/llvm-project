# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips-unknown-linux-gnu -run-pass=block-placement -o - %s | FileCheck %s

# The assembler temporary clobbered by long branch expansion is dead in
# branches rebuilt after instruction selection.

---
name:            invert_cond_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: invert_cond_branch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x60000000), %bb.1(0x20000000)
  ; CHECK-NEXT:   liveins: $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ renamable $r4, $r0, %bb.1, implicit-def dead $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r2 = ADDiu $r0, 2
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit killed $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $r2 = ADDiu $r0, 1
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit killed $r2
  bb.0:
    successors: %bb.2(0x60000000), %bb.1(0x20000000)
    liveins: $r4

    BNE renamable $r4, $r0, %bb.2, implicit-def dead $r1
    B %bb.1, implicit-def dead $r1

  bb.1:
    successors: %bb.3(0x80000000)

    $r2 = ADDiu $r0, 1
    B %bb.3, implicit-def dead $r1

  bb.2:
    successors: %bb.3(0x80000000)

    $r2 = ADDiu $r0, 2

  bb.3:
    liveins: $r2

    PseudoReturn undef $r31, implicit killed $r2
...
---
name:            insert_uncond_branch
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: insert_uncond_branch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x70000000), %bb.2(0x10000000)
  ; CHECK-NEXT:   liveins: $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE renamable $r4, $r0, %bb.2, implicit-def dead $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r2 = ADDiu $r0, 1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r2 = ADDiu killed $r2, 3
  ; CHECK-NEXT:   $r2 = ADDiu killed $r2, 4
  ; CHECK-NEXT:   $r2 = ADDiu killed $r2, 5
  ; CHECK-NEXT:   $r2 = ADDiu killed $r2, 6
  ; CHECK-NEXT:   $r2 = ADDiu killed $r2, 7
  ; CHECK-NEXT:   $r2 = ADDiu killed $r2, 8
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit killed $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r2 = ADDiu $r0, 2
  ; CHECK-NEXT:   J %bb.3, implicit-def dead $r1
  bb.0:
    successors: %bb.1(0x70000000), %bb.2(0x10000000)
    liveins: $r4

    BNE renamable $r4, $r0, %bb.2, implicit-def dead $r1
    B %bb.1, implicit-def dead $r1

  bb.1:
