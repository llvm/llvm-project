; RUN: llc < %s -mtriple=mips -mcpu=mips2 | FileCheck %s -check-prefixes=MIPS2
; RUN: llc < %s -mtriple=mips -mcpu=mips32 | FileCheck %s -check-prefixes=MIPS32

; On MIPS I to IV, an instruction writing HI or LO must not be issued within
; two instructions of a mfhi or mflo. Inline assembly is opaque, so it counts
; both as a read and as a write of HI/LO.

; A read inside inline assembly followed by a compiled multiply.
; FIXME: MIPS2 lacks the two nops before the mult.
define i32 @asm_read_then_mult(i32 %c) {
; MIPS2-LABEL: asm_read_then_mult:
; MIPS2:       # %bb.0: # %entry
; MIPS2-NEXT:    #APP
; MIPS2-NEXT:    .set push
; MIPS2-NEXT:    .set at
; MIPS2-NEXT:    .set macro
; MIPS2-NEXT:    .set reorder
; MIPS2-EMPTY:
; MIPS2-NEXT:    mflo $2
; MIPS2-EMPTY:
; MIPS2-NEXT:    .set pop
; MIPS2-NEXT:    #NO_APP
; MIPS2-NEXT:    mult $2, $4
; MIPS2-NEXT:    mflo $2
; MIPS2-NEXT:    jr $ra
; MIPS2-NEXT:    nop
;
; MIPS32-LABEL: asm_read_then_mult:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    #APP
; MIPS32-NEXT:    .set push
; MIPS32-NEXT:    .set at
; MIPS32-NEXT:    .set macro
; MIPS32-NEXT:    .set reorder
; MIPS32-EMPTY:
; MIPS32-NEXT:    mflo $2
; MIPS32-EMPTY:
; MIPS32-NEXT:    .set pop
; MIPS32-NEXT:    #NO_APP
; MIPS32-NEXT:    jr $ra
; MIPS32-NEXT:    mul $2, $2, $4
entry:
; The ~{$1} clobber keeps the output off $at, which the assembler warns about.
  %lo = call i32 asm sideeffect "mflo $0", "=r,~{$1}"()
  %m = mul i32 %lo, %c
  ret i32 %m
}

; A compiled read followed by a write inside inline assembly.
; FIXME: MIPS2 lacks the two nops before the inline assembly.
define i32 @read_then_asm_write(i32 %a, i32 %b) {
; MIPS2-LABEL: read_then_asm_write:
; MIPS2:       # %bb.0: # %entry
; MIPS2-NEXT:    multu $4, $5
; MIPS2-NEXT:    mfhi $2
; MIPS2-NEXT:    #APP
; MIPS2-NEXT:    .set push
; MIPS2-NEXT:    .set at
; MIPS2-NEXT:    .set macro
; MIPS2-NEXT:    .set reorder
; MIPS2-EMPTY:
; MIPS2-NEXT:    mtlo $5
; MIPS2-EMPTY:
; MIPS2-NEXT:    .set pop
; MIPS2-NEXT:    #NO_APP
; MIPS2-NEXT:    jr $ra
; MIPS2-NEXT:    nop
;
; MIPS32-LABEL: read_then_asm_write:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    multu $4, $5
; MIPS32-NEXT:    mfhi $2
; MIPS32-NEXT:    #APP
; MIPS32-NEXT:    .set push
; MIPS32-NEXT:    .set at
; MIPS32-NEXT:    .set macro
; MIPS32-NEXT:    .set reorder
; MIPS32-EMPTY:
; MIPS32-NEXT:    mtlo $5
; MIPS32-EMPTY:
; MIPS32-NEXT:    .set pop
; MIPS32-NEXT:    #NO_APP
; MIPS32-NEXT:    jr $ra
; MIPS32-NEXT:    nop
entry:
  %a64 = zext i32 %a to i64
  %b64 = zext i32 %b to i64
  %p = mul i64 %a64, %b64
  %h64 = lshr i64 %p, 32
  %h = trunc i64 %h64 to i32
  call void asm sideeffect "mtlo $0", "r,~{lo},~{hi}"(i32 %b)
  ret i32 %h
}

