; A MIPS16 function with inline assembly followed by a multiply gets no nop.
define i32 @asm_then_mul_mips16(i32 %a, i32 %b) #0 {
; MIPS2-LABEL: asm_then_mul_mips16:
; MIPS2:       # %bb.0: # %entry
; MIPS2-NEXT:    #APP
; MIPS2-NEXT:    #NO_APP
; MIPS2-NEXT:    mult $2, $5
; MIPS2-NEXT:    mflo $2
; MIPS2-NEXT:    jrc $ra
;
; MIPS32-LABEL: asm_then_mul_mips16:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    #APP
; MIPS32-NEXT:    #NO_APP
; MIPS32-NEXT:    mult $2, $5
; MIPS32-NEXT:    mflo $2
; MIPS32-NEXT:    jrc $ra
entry:
  %x = call i32 asm sideeffect "", "=r,r"(i32 %a)
  %m = mul i32 %x, %b
  ret i32 %m
