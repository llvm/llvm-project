; MIPS32-LABEL: read_then_asm_write_undeclared:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    multu $4, $5
; MIPS32-NEXT:    mfhi $2
; MIPS32-NEXT:    #APP
; MIPS32-NEXT:    .set push
; MIPS32-NEXT:    .set at
; MIPS32-NEXT:    .set macro
; MIPS32-NEXT:    .set reorder
