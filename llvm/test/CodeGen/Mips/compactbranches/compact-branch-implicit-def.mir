# RUN: llc -mtriple=mips64 -mcpu=mips64r6 -start-after=block-placement -o - %s | FileCheck %s

# Check that MipsHazardSchedule sees through basic blocks with transient instructions.
# The mir code in this file isn't representative of the llvm-ir.

--- |
  ; ModuleID = 'test.ll'
  source_filename = "test.c"
  target datalayout = "E-m:e-i8:8:32-i16:16:32-i64:64-n32:64-S128"
  target triple = "mips64-img-linux-gnu"

  ; Function Attrs: nounwind
  define i32 @f(i32 signext %a) {
  entry:
    %retval = alloca i32, align 4
    %a.addr = alloca i32, align 4
    store i32 %a, ptr %a.addr, align 4
    %0 = load i32, ptr %a.addr, align 4
    %cmp = icmp sgt i32 %0, 5
    br i1 %cmp, label %if.then, label %if.else

  if.then:                                          ; preds = %entry
    %1 = load i32, ptr %a.addr, align 4
    %2 = load i32, ptr %a.addr, align 4
    %add = add nsw i32 %1, %2
    store i32 %add, ptr %retval, align 4
    br label %return

  if.else:                                          ; preds = %entry
    %3 = load i32, ptr %a.addr, align 4
    %call = call i32 @g(i32 signext %3)
    store i32 %call, ptr %retval, align 4
    br label %return

  return:                                           ; preds = %if.else, %if.then
    %4 = load i32, ptr %retval, align 4
    ret i32 %4
  }

  declare i32 @g(i32 signext)

  ; Function Attrs: nounwind
  declare void @llvm.stackprotector(ptr, ptr)

  !llvm.ident = !{!0}

  !0 = !{!"clang version 4.0.0 "}

...
---
# CHECK-LABEL: f:
# CHECK: bgtzc
# CHECK-NEXT: nop
# CHECK: bltzc
# CHECK-NEXT: nop
# CHECK: blezc
name:            f
alignment:       8
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
tracksRegLiveness: true
liveins:
  - { reg: '$r4_64' }
  - { reg: '$r25_64' }
calleeSavedRegisters: [ '$r30', '$r28', '$r31', '$d12', '$d13', '$d14', '$d15',
                        '$f24', '$f25', '$f26', '$f27', '$f28', '$f29',
                        '$f30', '$f31', '$r30_64', '$f_hi24', '$f_hi25',
                        '$f_hi26', '$f_hi27', '$f_hi28', '$f_hi29', '$f_hi30',
                        '$f_hi31', '$r28_64', '$r31_64', '$r16', '$r17', '$r18',
                        '$r19', '$r20', '$r21', '$r22', '$r23', '$d24_64', '$d25_64',
                        '$d26_64', '$d27_64', '$d28_64', '$d29_64', '$d30_64',
                        '$d31_64', '$r16_64', '$r17_64', '$r18_64', '$r19_64',
                        '$r20_64', '$r21_64', '$r22_64', '$r23_64' ]
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       32
  offsetAdjustment: 0
  maxAlignment:    8
  adjustsStack:    true
  hasCalls:        true
  maxCallFrameSize: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
stack:
  - { id: 0, name: retval, offset: -28, size: 4, alignment: 4 }
  - { id: 1, name: a.addr, offset: -32, size: 4, alignment: 4 }
  - { id: 2, type: spill-slot, offset: -8, size: 8, alignment: 8, callee-saved-register: '$r31_64' }
  - { id: 3, type: spill-slot, offset: -16, size: 8, alignment: 8, callee-saved-register: '$r30_64' }
  - { id: 4, type: spill-slot, offset: -24, size: 8, alignment: 8, callee-saved-register: '$r28_64' }
body:             |
  bb.0.entry:
    successors: %bb.1.if.then(0x40000000), %bb.5.if.else(0x40000000)
    liveins: $r4_64, $r25_64, $r31_64, $r30_64, $r28_64

    $r29_64 = DADDiu $r29_64, -32
    CFI_INSTRUCTION def_cfa_offset 32
    SD killed $r31_64, $r29_64, 24 :: (store (s64) into %stack.2)
    SD killed $r30_64, $r29_64, 16 :: (store (s64) into %stack.3)
    SD killed $r28_64, $r29_64, 8 :: (store (s64) into %stack.4)
    CFI_INSTRUCTION offset $r31_64, -8
    CFI_INSTRUCTION offset $r30_64, -16
    CFI_INSTRUCTION offset $r28_64, -24
    CFI_INSTRUCTION def_cfa_register $r30_64
    $r1_64 = LUi64 @f
    $r2_64 = DADDu killed $r1_64, $r25_64
    SW $r4, $r29_64, 0 :: (store (s32) into %ir.a.addr)
    BGTZC $r4, %bb.5.if.else, implicit-def $r1

  bb.1.if.then:
    successors: %bb.6.return(0x40000000), %bb.2.if.then(0x40000000)
    liveins: $r4

    BLTZC $r4, %bb.6.return, implicit-def $r1

  bb.2.if.then:
    successors: %bb.3.if.else(0x80000000)
    $r24 = IMPLICIT_DEF

  bb.3.if.else:
    successors: %bb.6.return(0x40000000), %bb.4.if.else(0x40000000)
    liveins: $r24

    BLEZC $r24, %bb.6.return, implicit-def $r1

  bb.4.if.else:
    successors: %bb.6.return(0x80000000)
    liveins: $r24

    $r1 = LW $r29_64, 0 :: (dereferenceable load (s32) from %ir.a.addr)
    $r1 = ADDu killed $r1, $r24
    SW killed $r1, $r29_64, 4 :: (store (s32) into %ir.retval)
    J %bb.6.return, implicit-def dead $r1

  bb.5.if.else:
    successors: %bb.6.return(0x80000000)
    liveins: $r2_64

    $r28_64 = DADDiu killed $r2_64, @f
    $r4_64 = LW64 $r29_64, 0 :: (dereferenceable load (s32) from %ir.a.addr)
    $r25_64 = LD $r28_64, @g :: (load (s64) from call-entry @g)
    JALR64Pseudo $r25_64, csr_n64, implicit-def dead $r31, implicit $r4_64, implicit $r28_64, implicit-def $r29, implicit-def $r2
    SW killed $r2, $r29_64, 4 :: (store (s32) into %ir.retval)

  bb.6.return:
    $r2 = LW $r29_64, 4 :: (dereferenceable load (s32) from %ir.retval)
    $r28_64 = LD $r29_64, 8 :: (load (s64) from %stack.4)
    $r30_64 = LD $r29_64, 16 :: (load (s64) from %stack.3)
    $r31_64 = LD $r29_64, 24 :: (load (s64) from %stack.2)
    $r29_64 = DADDiu $r29_64, 32
    PseudoReturn64 $r31_64

...
