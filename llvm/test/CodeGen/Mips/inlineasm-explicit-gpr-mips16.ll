; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips -mcpu=mips32r2 -mattr=+mips16 < %s | FileCheck %s

; $0-$31 must name the GPR with that number. The i32 register class in MIPS16
; mode does not start at $0, so $2 used to come out as $4.

define i32 @gpr_mips16(i32 %a) {
; CHECK-LABEL: gpr_mips16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    move $2, $4
; CHECK-NEXT:    #APP
; CHECK-NEXT:    .set push
; CHECK-NEXT:    .set at
; CHECK-NEXT:    .set macro
; CHECK-NEXT:    .set reorder
; CHECK-EMPTY:
; CHECK-NEXT:    # $2
; CHECK-EMPTY:
; CHECK-NEXT:    .set pop
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    jrc $ra
  %r = call i32 asm sideeffect "# $0", "={$2},0"(i32 %a)
  ret i32 %r
}
