# RUN: llc -mtriple=mips64 -mcpu=mips3 -run-pass=mips-branch-expansion \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=CHECK,MIPS3
# RUN: llc -mtriple=mips64 -mcpu=mips4 -run-pass=mips-branch-expansion \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=CHECK,MIPS4

# On MIPS III and IV, a doubleword instruction writing HI or LO must not be
# issued within two instructions of a mfhi or mflo either.

--- |
  define void @mflo64_dudiv() { ret void }
  define void @mfhi64_mthi64() { ret void }
  define void @mflo64_one_apart_mtlo64() { ret void }
  define void @mflo64_dmfc1_dmult() { ret void }
...
---
# An unsigned doubleword divide pseudo right after a mflo: two nops.
name:            mflo64_dudiv
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4_64, $r5_64, $ac0_64

    ; CHECK-LABEL: name: mflo64_dudiv
    ; CHECK: liveins: $r4_64, $r5_64, $ac0_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1_64 = MFLO64 implicit $ac0_64
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $ac0_64 = PseudoDUDIV killed $r1_64, killed $r5_64
    ; CHECK-NEXT: $r2_64 = MFLO64 implicit killed $ac0_64
    ; CHECK-NEXT: PseudoReturn64 undef $r31_64, implicit killed $r2_64 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r1_64 = MFLO64 implicit $ac0_64
    $ac0_64 = PseudoDUDIV killed $r1_64, killed $r5_64
    $r2_64 = MFLO64 implicit killed $ac0_64
    PseudoReturn64 undef $r31_64, implicit killed $r2_64 {
      $r0 = SLL $r0, 0
    }
...
---
# A doubleword write of HI right after a mfhi: two nops.
name:            mfhi64_mthi64
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4_64, $ac0_64

    ; CHECK-LABEL: name: mfhi64_mthi64
    ; CHECK: liveins: $r4_64, $ac0_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2_64 = MFHI64 implicit $ac0_64
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: MTHI64 killed $r4_64, implicit-def $hi0_64
    ; CHECK-NEXT: PseudoReturn64 undef $r31_64, implicit killed $r2_64 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r2_64 = MFHI64 implicit $ac0_64
    MTHI64 killed $r4_64, implicit-def $hi0_64
    PseudoReturn64 undef $r31_64, implicit killed $r2_64 {
      $r0 = SLL $r0, 0
    }
...
---
# A doubleword write of LO one instruction after a mflo: one nop.
name:            mflo64_one_apart_mtlo64
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4_64, $r5_64, $ac0_64

    ; CHECK-LABEL: name: mflo64_one_apart_mtlo64
    ; CHECK: liveins: $r4_64, $r5_64, $ac0_64
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2_64 = MFLO64 implicit $ac0_64
    ; CHECK-NEXT: $r3_64 = DADDu $r4_64, $r5_64
    ; CHECK-NEXT: $r0 = SLL $r0, 0
    ; CHECK-NEXT: MTLO64 killed $r4_64, implicit-def $lo0_64
    ; CHECK-NEXT: PseudoReturn64 undef $r31_64, implicit killed $r2_64, implicit killed $r3_64 {
    ; CHECK-NEXT:   $r0 = SLL $r0, 0
    ; CHECK-NEXT: }
    $r2_64 = MFLO64 implicit $ac0_64
    $r3_64 = DADDu $r4_64, $r5_64
    MTLO64 killed $r4_64, implicit-def $lo0_64
    PseudoReturn64 undef $r31_64, implicit killed $r2_64, implicit killed $r3_64 {
      $r0 = SLL $r0, 0
    }
...
---
# On MIPS III, the FPU delay nop counts toward the distance: no HI/LO nop.
# On MIPS IV, which has no FPU delay, one HI/LO nop.
name:            mflo64_dmfc1_dmult
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $d12_64, $r5_64, $ac0_64

    ; MIPS3-LABEL: name: mflo64_dmfc1_dmult
    ; MIPS3: liveins: $d12_64, $r5_64, $ac0_64
    ; MIPS3-NEXT: {{  $}}
    ; MIPS3-NEXT: $r3_64 = MFLO64 implicit $ac0_64
    ; MIPS3-NEXT: $r2_64 = DMFC1 killed $d12_64 {
    ; MIPS3-NEXT:   $r0 = SLL $r0, 0
    ; MIPS3-NEXT: }
    ; MIPS3-NEXT: $ac0_64 = PseudoDMULT killed $r2_64, killed $r5_64
    ; MIPS3-NEXT: $r2_64 = MFLO64 implicit killed $ac0_64
    ; MIPS3-NEXT: PseudoReturn64 undef $r31_64, implicit $r2_64, implicit $r3_64 {
    ; MIPS3-NEXT:   $r0 = SLL $r0, 0
    ; MIPS3-NEXT: }
    ;
    ; MIPS4-LABEL: name: mflo64_dmfc1_dmult
    ; MIPS4: liveins: $d12_64, $r5_64, $ac0_64
    ; MIPS4-NEXT: {{  $}}
    ; MIPS4-NEXT: $r3_64 = MFLO64 implicit $ac0_64
    ; MIPS4-NEXT: $r2_64 = DMFC1 killed $d12_64
    ; MIPS4-NEXT: $r0 = SLL $r0, 0
    ; MIPS4-NEXT: $ac0_64 = PseudoDMULT killed $r2_64, killed $r5_64
    ; MIPS4-NEXT: $r2_64 = MFLO64 implicit killed $ac0_64
    ; MIPS4-NEXT: PseudoReturn64 undef $r31_64, implicit $r2_64, implicit $r3_64 {
    ; MIPS4-NEXT:   $r0 = SLL $r0, 0
    ; MIPS4-NEXT: }
    $r3_64 = MFLO64 implicit $ac0_64
    $r2_64 = DMFC1 killed $d12_64
    $ac0_64 = PseudoDMULT killed $r2_64, killed $r5_64
    $r2_64 = MFLO64 implicit killed $ac0_64
    PseudoReturn64 undef $r31_64, implicit $r2_64, implicit $r3_64 {
      $r0 = SLL $r0, 0
    }
...
