name: bltuc
body: |
  bb.0:
    BLTUC_NM $a0_nm, $a1_nm, 0
...
---
# CHECK-LABEL: bnec:
# CHECK: bnec $a0, $a1, 0 # encoding: [0xa4,0xa8,0x00,0x00]
name: bnec
body: |
  bb.0:
    BNEC_NM $a0_nm, $a1_nm, 0
...
---
# CHECK-LABEL: bneic:
# CHECK: bneic $a0, 5, 0 # encoding: [0x90,0xc8,0x00,0x28]
name: bneic
body: |
  bb.0:
    BNEIC_NM $a0_nm, 5, 0
...
---
# CHECK-LABEL: brsc:
# CHECK: brsc $a0 # encoding: [0x04,0x48,0x00,0x80]
name: brsc
body: |
  bb.0:
    BRSC_NM $a0_nm, 0
...
