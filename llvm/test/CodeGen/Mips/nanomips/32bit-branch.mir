...
---
# CHECK-LABEL: bltic:
# CHECK: bltic $a0, 5, 0 # encoding: [0x98,0xc8,0x00,0x28]
name: bltic
body: |
  bb.0:
    BLTIC_NM $a0_nm, 5, 0
...
---
# CHECK-LABEL: bltiuc:
# CHECK: bltiuc $a0, 5, 0 # encoding: [0x9c,0xc8,0x00,0x28]
name: bltiuc
body: |
  bb.0:
    BLTIUC_NM $a0_nm, 5, 0
...
---
# CHECK-LABEL: bltuc:
