# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 32-bit nanoMIPS control-transfer instructions (indirect
# jumps/calls, direct branches/calls, conditional branches)
#
# Since the branch and call target operands will be fully supported in the
# next upstreaming batch, they are set to 0 to allow confirming the mnemonics
# and encoding of the remaining instruction parts.
#
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- indirect jump / call (register) ---
---
# CHECK-LABEL: balrsc:
# CHECK: balrsc $ra, $5 # encoding: [0xe5,0x4b,0x00,0x80]
name: balrsc
tracksRegLiveness: false
body: |
  bb.0:
    $r31 = BALRSC_NM $r5
...
---
# CHECK-LABEL: jalrc:
# CHECK: jalrc $ra, $5 # encoding: [0xe5,0x4b,0x00,0x00]
name: jalrc
tracksRegLiveness: false
body: |
  bb.0:
    $r31 = JALRC_NM $r5
...
---
# CHECK-LABEL: jalrchb:
# CHECK: jalrc.hb $ra, $5 # encoding: [0xe5,0x4b,0x00,0x10]
name: jalrchb
tracksRegLiveness: false
body: |
  bb.0:
    $r31 = JALRCHB_NM $r5
...

# --- direct branch / call (with placeholder operands for now) ---
---
# CHECK-LABEL: balc:
# CHECK: balc 0 # encoding: [0x00,0x2a,0x00,0x00]
name: balc
tracksRegLiveness: false
body: |
  bb.0:
    BALC_NM 0
...
---
# CHECK-LABEL: bc:
# CHECK: bc 0 # encoding: [0x00,0x28,0x00,0x00]
name: bc
tracksRegLiveness: false
body: |
  bb.0:
    BC_NM 0
...
---
# CHECK-LABEL: movebalc:
# CHECK: move.balc $4, $5, 0 # encoding: [0xa0,0x08,0x00,0x00]
name: movebalc
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = MOVEBALC_NM $r5, 0
...

