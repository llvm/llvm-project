# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 32-bit nanoMIPS system and coprocessor instructions
# (system control, CP0 access, misc/ASE ops, save/restore)
#
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- system control ---
---
# CHECK-LABEL: break:
# CHECK: break 7 # encoding: [0x10,0x00,0x07,0x00]
name: break
tracksRegLiveness: false
body: |
  bb.0:
    BREAK_NM 7
...
---
# CHECK-LABEL: crc32b:
# CHECK: crc32b $4, $5 # encoding: [0x85,0x20,0xe8,0x03]
name: crc32b
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = CRC32B_NM $r4, $r5
...
---
# CHECK-LABEL: crc32cb:
# CHECK: crc32cb $4, $5 # encoding: [0x85,0x20,0xe8,0x13]
name: crc32cb
tracksRegLiveness: false
body: |
