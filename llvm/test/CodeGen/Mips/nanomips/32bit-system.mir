# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 32-bit nanoMIPS system and coprocessor instructions
# (system control, CP0 access, misc/ASE ops, save/restore)
#
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- system control ---
---
# CHECK-LABEL: break:
# CHECK: break 7 # encoding: [0x10,0x00,0x07,0x00]
name: break
body: |
  bb.0:
    BREAK_NM 7
...
---
# CHECK-LABEL: crc32b:
# CHECK: crc32b $a0, $a1 # encoding: [0x85,0x20,0xe8,0x03]
name: crc32b
body: |
  bb.0:
    $a0_nm = CRC32B_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: crc32cb:
# CHECK: crc32cb $a0, $a1 # encoding: [0x85,0x20,0xe8,0x13]
name: crc32cb
body: |
  bb.0:
    $a0_nm = CRC32CB_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: crc32ch:
# CHECK: crc32ch $a0, $a1 # encoding: [0x85,0x20,0xe8,0x17]
name: crc32ch
body: |
  bb.0:
    $a0_nm = CRC32CH_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: crc32cw:
# CHECK: crc32cw $a0, $a1 # encoding: [0x85,0x20,0xe8,0x1b]
name: crc32cw
body: |
  bb.0:
    $a0_nm = CRC32CW_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: crc32h:
# CHECK: crc32h $a0, $a1 # encoding: [0x85,0x20,0xe8,0x07]
name: crc32h
body: |
  bb.0:
    $a0_nm = CRC32H_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: crc32w:
# CHECK: crc32w $a0, $a1 # encoding: [0x85,0x20,0xe8,0x0b]
name: crc32w
body: |
  bb.0:
    $a0_nm = CRC32W_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: deret:
# CHECK: deret # encoding: [0x00,0x20,0x7f,0xe3]
name: deret
body: |
  bb.0:
    DERET_NM
...
---
# CHECK-LABEL: ehb:
# CHECK: ehb # encoding: [0x00,0x80,0x03,0xc0]
name: ehb
body: |
  bb.0:
    EHB_NM
...
---
# CHECK-LABEL: eret:
# CHECK: eret # encoding: [0x00,0x20,0x7f,0xf3]
name: eret
body: |
  bb.0:
    ERET_NM
...
---
# CHECK-LABEL: eretnc:
# CHECK: eretnc # encoding: [0x01,0x20,0x7f,0xf3]
name: eretnc
body: |
  bb.0:
    ERETNC_NM
...
---
# CHECK-LABEL: nop:
# CHECK: nop # encoding: [0x08,0x90]
name: nop
body: |
  bb.0:
    NOP_NM
...
---
# CHECK-LABEL: nop32:
# CHECK: nop32 # encoding: [0x00,0x80,0x00,0xc0]
name: nop32
body: |
  bb.0:
    NOP32_NM
...
---
# CHECK-LABEL: pause:
# CHECK: pause # encoding: [0x00,0x80,0x05,0xc0]
name: pause
body: |
  bb.0:
    PAUSE_NM
...
---
# CHECK-LABEL: sdbbp:
# CHECK: sdbbp 7 # encoding: [0x18,0x00,0x07,0x00]
name: sdbbp
body: |
  bb.0:
    SDBBP_NM 7
...
---
# CHECK-LABEL: sigrie:
# CHECK: sigrie 7 # encoding: [0x00,0x00,0x07,0x00]
name: sigrie
body: |
  bb.0:
    SIGRIE_NM 7
...
---
# CHECK-LABEL: syscall:
# CHECK: syscall 7 # encoding: [0x08,0x00,0x07,0x00]
name: syscall
body: |
  bb.0:
    SYSCALL_NM 7
...
---
# CHECK-LABEL: teq:
# CHECK: teq $a0, $a1, 0 # encoding: [0xa4,0x20,0x00,0x00]
name: teq
body: |
  bb.0:
    TEQ_NM $a0_nm, $a1_nm, 0
...
---
# CHECK-LABEL: tne:
# CHECK: tne $a0, $a1, 0 # encoding: [0xa4,0x20,0x00,0x04]
name: tne
body: |
  bb.0:
    TNE_NM $a0_nm, $a1_nm, 0
...

# --- coprocessor-0 access ---
---
# CHECK-LABEL: mfc0:
# CHECK: mfc0 $a0, $0, 0 # encoding: [0x80,0x20,0x30,0x00]
name: mfc0
body: |
  bb.0:
    $a0_nm = MFC0_NM $cop00, 0
...
---
# CHECK-LABEL: mfc0sel:
# CHECK: mfc0 $a0, $index # encoding: [0x80,0x20,0x30,0x00]
name: mfc0sel
body: |
  bb.0:
    $a0_nm = MFC0Sel_NM $cop0sel_index
...
---
# CHECK-LABEL: mfhc0:
