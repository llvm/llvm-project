name: mthc0sel
body: |
  bb.0:
    MTHC0Sel_NM $a0_nm, $cop0sel_index
...
---
# CHECK-LABEL: rdhwr:
# CHECK: rdhwr $a0, $0, 0 # encoding: [0x80,0x20,0xc0,0x01]
name: rdhwr
body: |
  bb.0:
