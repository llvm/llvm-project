# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 16-bit nanoMIPS instructions (compact ALU, moves,
# arithmetic, load/store, jumps, branches, save/restore)
#
# Since load/store and branch-target operands will be fully supported in the
# next upstreaming batch, they are set to 0 to allow confirming the mnemonics
# and encoding of the remaining instruction parts.
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- alu / logic / move ---
---
# CHECK-LABEL: addiur1sp:
# CHECK: addiu $a0, $sp, 4 # encoding: [0x41,0x72]
name: addiur1sp
body: |
  bb.0:
    $a0_nm = ADDIUR1SP_NM $sp_nm, 4
...
---
# CHECK-LABEL: addiur2:
# CHECK: addiu $a0, $a1, 4 # encoding: [0x51,0x92]
name: addiur2
body: |
  bb.0:
    $a0_nm = ADDIUR2_NM $a1_nm, 4
...
---
# CHECK-LABEL: and16:
# CHECK: and $a0, $a0, $a1 # encoding: [0x48,0x52]
name: and16
body: |
  bb.0:
    $a0_nm = AND16_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: andi16:
# CHECK: andi $a0, $a1, 3 # encoding: [0x53,0xf2]
name: andi16
body: |
  bb.0:
    $a0_nm = ANDI16_NM $a1_nm, 3
...
---
# CHECK-LABEL: break16:
# CHECK: break 3 # encoding: [0x13,0x10]
name: break16
body: |
  bb.0:
    BREAK16_NM 3
...
---
# CHECK-LABEL: li16:
# CHECK: li $a0, 5 # encoding: [0x05,0xd2]
name: li16
body: |
  bb.0:
    $a0_nm = LI16_NM 5
...
---
# CHECK-LABEL: move:
# CHECK: move $a0, $a1 # encoding: [0x85,0x10]
name: move
body: |
  bb.0:
    $a0_nm = MOVE_NM $a1_nm
...
---
# CHECK-LABEL: not16:
# CHECK: not $a0, $a1 # encoding: [0x50,0x52]
name: not16
body: |
  bb.0:
    $a0_nm = NOT16_NM $a1_nm
...
---
# CHECK-LABEL: or16:
# CHECK: or $a0, $a0, $a1 # encoding: [0x4c,0x52]
name: or16
body: |
  bb.0:
    $a0_nm = OR16_NM $a0_nm, $a1_nm
...
---
# CHECK-LABEL: sdbbp16:
# CHECK: sdbbp 3 # encoding: [0x1b,0x10]
name: sdbbp16
body: |
  bb.0:
    SDBBP16_NM 3
...
---
# CHECK-LABEL: sll16:
# CHECK: sll $a0, $a1, 3 # encoding: [0x53,0x32]
name: sll16
body: |
  bb.0:
    $a0_nm = SLL16_NM $a1_nm, 3
...
---
# CHECK-LABEL: srl16:
# CHECK: srl $a0, $a1, 3 # encoding: [0x5b,0x32]
name: srl16
body: |
  bb.0:
    $a0_nm = SRL16_NM $a1_nm, 3
...
---
# CHECK-LABEL: syscall16:
# CHECK: syscall 3 # encoding: [0x0b,0x10]
name: syscall16
body: |
  bb.0:
    SYSCALL16_NM 3
...
---
# CHECK-LABEL: xor16:
# CHECK: xor $a0, $a0, $a1 # encoding: [0x44,0x52]
name: xor16
body: |
  bb.0:
    $a0_nm = XOR16_NM $a0_nm, $a1_nm
...

# --- arithmetic ---
---
# CHECK-LABEL: addu16:
# CHECK: addu $a0, $a1, $a2 # encoding: [0x58,0xb3]
name: addu16
body: |
  bb.0:
