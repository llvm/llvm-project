...
---
# CHECK-LABEL: subu16:
# CHECK: subu $a0, $a1, $a2 # encoding: [0x59,0xb3]
name: subu16
body: |
  bb.0:
    $a0_nm = SUBu16_NM $a1_nm, $a2_nm
...

