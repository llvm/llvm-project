# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 16-bit nanoMIPS instructions (compact ALU, moves,
# arithmetic, load/store, jumps, branches, save/restore)
#
# Since branch-target operands will be fully supported in the next upstreaming
# batch, they are set to 0 to allow confirming the mnemonics and encoding of the
# remaining instruction parts.
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- alu / logic / move ---
---
# CHECK-LABEL: addiur1sp:
# CHECK: addiu $4, $sp, 4 # encoding: [0x41,0x72]
name: addiur1sp
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = ADDIUR1SP_NM $r29, 4
...
---
# CHECK-LABEL: addiur2:
# CHECK: addiu $4, $5, 4 # encoding: [0x51,0x92]
name: addiur2
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = ADDIUR2_NM $r5, 4
...
---
# CHECK-LABEL: and16:
# CHECK: and $4, $5, $4 # encoding: [0x58,0x52]
name: and16
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = AND16_NM $r5, $r4
...
---
# CHECK-LABEL: andi16:
# CHECK: andi $4, $5, 3 # encoding: [0x53,0xf2]
