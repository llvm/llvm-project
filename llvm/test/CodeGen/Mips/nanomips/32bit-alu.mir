# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 32-bit nanoMIPS ALU instructions (arithmetic, logical,
# shifts, bitfield, PC/GP-relative address computation)
#
# Since the PC/GP-relative symbol operand will be fully supported in the next
# upstreaming batch, it is set to 0 to allow confirming the mnemonics and
# encoding of the remaining instruction parts.
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- three-register (ArithLogicR32) ---
---
# CHECK-LABEL: add:
# CHECK: add $4, $5, $6 # encoding: [0xc5,0x20,0x10,0x21]
name: add
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = ADD_NM $r5, $r6
...
---
# CHECK-LABEL: addu:
# CHECK: addu $4, $5, $6 # encoding: [0xc5,0x20,0x50,0x21]
name: addu
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = ADDu_NM $r5, $r6
...
---
