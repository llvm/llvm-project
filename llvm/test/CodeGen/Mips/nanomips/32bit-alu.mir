# --- register + immediate ---
---
# CHECK-LABEL: addiu:
# CHECK: addiu $4, $5, 100 # encoding: [0x85,0x00,0x64,0x00]
name: addiu
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = ADDIU_NM $r5, 100
...
---
# addiuneg's immediate (nimm12_nm) will be fully supported in the next
# upstreaming batch. It is stored negated, so as a placeholder it is set
# to 0 here to confirm the mnemonic and the opcode and register fields.

