# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 32-bit nanoMIPS load, store and cache/prefetch/sync
# instructions
#
# Since memory offset operands will be fully supported in the next upstreaming
# batch, they are set to 0 to allow confirming the mnemonics and encoding of
# the remaining instruction parts. Base and index registers are real registers.
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- load / store ---
---
# CHECK-LABEL: lb:
# CHECK: lb $4, 0($5) # encoding: [0x85,0x84,0x00,0x00]
name: lb
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = LB_NM $r5, 0
...
---
# CHECK-LABEL: lbgp:
# CHECK: lb $4, 0($gp) # encoding: [0x80,0x44,0x00,0x00]
name: lbgp
tracksRegLiveness: false
body: |
  bb.0:
    $r4 = LBGP_NM $r28, 0
...
---
