# RUN: llc %s -mtriple=nanomips-elf -start-after=mips-branch-expansion -show-mc-encoding -o - \
# RUN:   | FileCheck %s

# Encoding tests for 32-bit nanoMIPS load, store and cache/prefetch/sync
# instructions
#
# Since the memory address operands will be fully supported in the next
# upstreaming batch, they are set to 0 to allow confirming the mnemonics and
# encoding of the remaining instruction parts.
# Encoding bytes are shown in on-disk order: each halfword is little-endian,
# more significant halfword first.

# --- load / store (with placeholder operands for now) ---
---
# CHECK-LABEL: lb:
# CHECK: lb $a0, 0 # encoding: [0x80,0x84,0x00,0x00]
name: lb
body: |
  bb.0:
    $a0_nm = LB_NM 0
...
---
# CHECK-LABEL: lbgp:
# CHECK: lb $a0, 0 # encoding: [0x80,0x44,0x00,0x00]
name: lbgp
body: |
  bb.0:
    $a0_nm = LBGP_NM 0
...
---
