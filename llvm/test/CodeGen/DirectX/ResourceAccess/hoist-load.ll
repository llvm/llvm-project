; RUN: opt -S -dxil-resource-type -dxil-resource-access -disable-verify \
; RUN:  -mtriple=dxil-pc-shadermodel6.3-library %s | FileCheck %s

; Test hoisting of a load in various patterns that could be generated by an
; InstCombine/SimplifyCFG/LICM optimization transform

@In0.str = internal unnamed_addr constant [4 x i8] c"In0\00", align 1
@In1.str = internal unnamed_addr constant [4 x i8] c"In1\00", align 1
@In2.str = internal unnamed_addr constant [4 x i8] c"In2\00", align 1

; The simple case: a two-edge phi with a direct load (no GEP).
; CHECK-LABEL: define void @hoist_load_phi(
define void @hoist_load_phi() {
entry:
  %in0 = tail call target("dx.RawBuffer", float, 1, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_f32_1_0t(i32 0, i32 0, i32 1, i32 0, ptr nonnull @In0.str)
  %in1 = tail call target("dx.RawBuffer", float, 1, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_f32_1_0t(i32 0, i32 1, i32 1, i32 0, ptr nonnull @In1.str)
  %tid = tail call i32 @llvm.dx.thread.id(i32 0)
  %cmp = icmp eq i32 %tid, 0
  br i1 %cmp, label %if.then, label %if.else

if.then:
; CHECK:      if.then:
; CHECK-NEXT:   %[[LOAD0:.*]] = call { float, i1 } @llvm.dx.resource.load.rawbuffer.f32.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in0, i32 %tid, i32 0)
; CHECK-NEXT:   %[[VAL0:.*]] = extractvalue { float, i1 } %[[LOAD0]], 0
; CHECK-NEXT:   br label %exit
  %p0 = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in0, i32 %tid)
  br label %exit

if.else:
; CHECK:      if.else:
; CHECK-NEXT:   %[[LOAD1:.*]] = call { float, i1 } @llvm.dx.resource.load.rawbuffer.f32.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in1, i32 %tid, i32 0)
; CHECK-NEXT:   %[[VAL1:.*]] = extractvalue { float, i1 } %[[LOAD1]], 0
; CHECK-NEXT:   br label %exit
  %p1 = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in1, i32 %tid)
  br label %exit

exit:
; CHECK:      exit:
; CHECK-NEXT:   %[[VAL:.*]] = phi float [ %[[VAL0]], %if.then ], [ %[[VAL1]], %if.else ]
; CHECK-NOT:    phi ptr
; CHECK-NEXT:   call void @use_float(float %[[VAL]])
  %ptr = phi ptr [ %p0, %if.then ], [ %p1, %if.else ]
  %val = load float, ptr %ptr, align 4
  call void @use_float(float %val)
  ret void
}

; A multi-edge phi as produced by a switch must hoist into every predecessor.
; CHECK-LABEL: define void @hoist_load_switch(
define void @hoist_load_switch() {
entry:
  %in0 = tail call target("dx.RawBuffer", float, 1, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_f32_1_0t(i32 0, i32 0, i32 1, i32 0, ptr nonnull @In0.str)
  %in1 = tail call target("dx.RawBuffer", float, 1, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_f32_1_0t(i32 0, i32 1, i32 1, i32 0, ptr nonnull @In1.str)
  %in2 = tail call target("dx.RawBuffer", float, 1, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_f32_1_0t(i32 0, i32 2, i32 1, i32 0, ptr nonnull @In2.str)
  %tid = tail call i32 @llvm.dx.thread.id(i32 0)
  switch i32 %tid, label %case2 [
    i32 0, label %case0
    i32 1, label %case1
  ]

case0:
; CHECK:      case0:
; CHECK-NEXT:   %[[LOAD0:.*]] = call { float, i1 } @llvm.dx.resource.load.rawbuffer.f32.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in0, i32 %tid, i32 0)
; CHECK-NEXT:   %[[VAL0:.*]] = extractvalue { float, i1 } %[[LOAD0]], 0
; CHECK-NEXT:   br label %exit
  %p0 = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in0, i32 %tid)
  br label %exit

case1:
; CHECK:      case1:
; CHECK-NEXT:   %[[LOAD1:.*]] = call { float, i1 } @llvm.dx.resource.load.rawbuffer.f32.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in1, i32 %tid, i32 0)
; CHECK-NEXT:   %[[VAL1:.*]] = extractvalue { float, i1 } %[[LOAD1]], 0
; CHECK-NEXT:   br label %exit
  %p1 = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in1, i32 %tid)
  br label %exit

case2:
; CHECK:      case2:
; CHECK-NEXT:   %[[LOAD2:.*]] = call { float, i1 } @llvm.dx.resource.load.rawbuffer.f32.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in2, i32 %tid, i32 0)
; CHECK-NEXT:   %[[VAL2:.*]] = extractvalue { float, i1 } %[[LOAD2]], 0
; CHECK-NEXT:   br label %exit
  %p2 = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_f32_1_0t(target("dx.RawBuffer", float, 1, 0) %in2, i32 %tid)
  br label %exit

exit:
; CHECK:      exit:
; CHECK-NEXT:   %[[VAL:.*]] = phi float [ %[[VAL0]], %case0 ], [ %[[VAL1]], %case1 ], [ %[[VAL2]], %case2 ]
; CHECK-NOT:    phi ptr
; CHECK-NEXT:   call void @use_float(float %[[VAL]])
  %ptr = phi ptr [ %p0, %case0 ], [ %p1, %case1 ], [ %p2, %case2 ]
  %val = load float, ptr %ptr, align 4
  call void @use_float(float %val)
  ret void
}

; A GEP chain rooted at the phi must be duplicated into each predecessor. The
; index (%idx) is defined outside the merge block, so it is reused as-is.
; CHECK-LABEL: define void @hoist_load_gep(
define void @hoist_load_gep(i32 %idx) {
entry:
  %in0 = tail call target("dx.RawBuffer", <4 x double>, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_v4f64_0_0t(i32 0, i32 0, i32 1, i32 0, ptr nonnull @In0.str)
  %in1 = tail call target("dx.RawBuffer", <4 x double>, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_v4f64_0_0t(i32 0, i32 1, i32 1, i32 0, ptr nonnull @In1.str)
  %tid = tail call i32 @llvm.dx.thread.id(i32 0)
  %cmp = icmp eq i32 %tid, 0
  br i1 %cmp, label %if.then, label %if.else

if.then:
; CHECK:      if.then:
; CHECK-NEXT:   %[[OFF0:.*]] = mul i32 %idx, 8
; CHECK-NEXT:   %[[LOAD0:.*]] = call { double, i1 } @llvm.dx.resource.load.rawbuffer.f64.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in0, i32 %tid, i32 %[[OFF0]])
; CHECK-NEXT:   %[[VAL0:.*]] = extractvalue { double, i1 } %[[LOAD0]], 0
; CHECK-NEXT:   br label %exit
  %p0 = call noundef nonnull ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in0, i32 %tid)
  br label %exit

if.else:
; CHECK:      if.else:
; CHECK-NEXT:   %[[OFF1:.*]] = mul i32 %idx, 8
; CHECK-NEXT:   %[[LOAD1:.*]] = call { double, i1 } @llvm.dx.resource.load.rawbuffer.f64.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in1, i32 %tid, i32 %[[OFF1]])
; CHECK-NEXT:   %[[VAL1:.*]] = extractvalue { double, i1 } %[[LOAD1]], 0
; CHECK-NEXT:   br label %exit
  %p1 = call noundef nonnull ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in1, i32 %tid)
  br label %exit

exit:
; CHECK:      exit:
; CHECK-NEXT:   %[[VAL:.*]] = phi double [ %[[VAL0]], %if.then ], [ %[[VAL1]], %if.else ]
; CHECK-NOT:    phi ptr
; CHECK-NEXT:   call void @use_double(double %[[VAL]])
  %ptr = phi ptr [ %p0, %if.then ], [ %p1, %if.else ]
  %gep = getelementptr double, ptr %ptr, i32 %idx
  %val = load double, ptr %gep, align 8
  call void @use_double(double %val)
  ret void
}

; The GEP index is computed in the merge block, so the computation is part of
; the pointer's def chain and must be duplicated into each predecessor.
; CHECK-LABEL: define void @hoist_load_gep_index_in_block(
define void @hoist_load_gep_index_in_block(i32 %idx) {
entry:
  %in0 = tail call target("dx.RawBuffer", <4 x double>, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_v4f64_0_0t(i32 0, i32 0, i32 1, i32 0, ptr nonnull @In0.str)
  %in1 = tail call target("dx.RawBuffer", <4 x double>, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_v4f64_0_0t(i32 0, i32 1, i32 1, i32 0, ptr nonnull @In1.str)
  %tid = tail call i32 @llvm.dx.thread.id(i32 0)
  %cmp = icmp eq i32 %tid, 0
  br i1 %cmp, label %if.then, label %if.else

if.then:
; CHECK:      if.then:
; CHECK-NEXT:   %[[IDX0:.*]] = add i32 %idx, 3
; CHECK-NEXT:   %[[OFF0:.*]] = mul i32 %[[IDX0]], 8
; CHECK-NEXT:   %[[LOAD0:.*]] = call { double, i1 } @llvm.dx.resource.load.rawbuffer.f64.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in0, i32 %tid, i32 %[[OFF0]])
; CHECK-NEXT:   %[[VAL0:.*]] = extractvalue { double, i1 } %[[LOAD0]], 0
; CHECK-NEXT:   br label %exit
  %p0 = call noundef nonnull ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in0, i32 %tid)
  br label %exit

if.else:
; CHECK:      if.else:
; CHECK-NEXT:   %[[IDX1:.*]] = add i32 %idx, 3
; CHECK-NEXT:   %[[OFF1:.*]] = mul i32 %[[IDX1]], 8
; CHECK-NEXT:   %[[LOAD1:.*]] = call { double, i1 } @llvm.dx.resource.load.rawbuffer.f64.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in1, i32 %tid, i32 %[[OFF1]])
; CHECK-NEXT:   %[[VAL1:.*]] = extractvalue { double, i1 } %[[LOAD1]], 0
; CHECK-NEXT:   br label %exit
  %p1 = call noundef nonnull ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in1, i32 %tid)
  br label %exit

exit:
; CHECK:      exit:
; CHECK-NEXT:   %[[VAL:.*]] = phi double [ %[[VAL0]], %if.then ], [ %[[VAL1]], %if.else ]
; CHECK-NOT:    phi ptr
; CHECK-NEXT:   call void @use_double(double %[[VAL]])
  %ptr = phi ptr [ %p0, %if.then ], [ %p1, %if.else ]
  %idx2 = add i32 %idx, 3
  %gep = getelementptr double, ptr %ptr, i32 %idx2
  %val = load double, ptr %gep, align 8
  call void @use_double(double %val)
  ret void
}

; The GEP index is itself a phi. Following the pointer phi's per-edge value
; naturally follows the index phi's matching per-edge value.
; CHECK-LABEL: define void @hoist_load_gep_index_phi(
define void @hoist_load_gep_index_phi(i32 %a, i32 %b) {
entry:
  %in0 = tail call target("dx.RawBuffer", <4 x double>, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_v4f64_0_0t(i32 0, i32 0, i32 1, i32 0, ptr nonnull @In0.str)
  %in1 = tail call target("dx.RawBuffer", <4 x double>, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.RawBuffer_v4f64_0_0t(i32 0, i32 1, i32 1, i32 0, ptr nonnull @In1.str)
  %tid = tail call i32 @llvm.dx.thread.id(i32 0)
  %cmp = icmp eq i32 %tid, 0
  br i1 %cmp, label %if.then, label %if.else

if.then:
; CHECK:      if.then:
; CHECK-NEXT:   %[[OFF0:.*]] = mul i32 %a, 8
; CHECK-NEXT:   %[[LOAD0:.*]] = call { double, i1 } @llvm.dx.resource.load.rawbuffer.f64.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in0, i32 %tid, i32 %[[OFF0]])
; CHECK-NEXT:   %[[VAL0:.*]] = extractvalue { double, i1 } %[[LOAD0]], 0
; CHECK-NEXT:   br label %exit
  %p0 = call noundef nonnull ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in0, i32 %tid)
  br label %exit

if.else:
; CHECK:      if.else:
; CHECK-NEXT:   %[[OFF1:.*]] = mul i32 %b, 8
; CHECK-NEXT:   %[[LOAD1:.*]] = call { double, i1 } @llvm.dx.resource.load.rawbuffer.f64.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in1, i32 %tid, i32 %[[OFF1]])
; CHECK-NEXT:   %[[VAL1:.*]] = extractvalue { double, i1 } %[[LOAD1]], 0
; CHECK-NEXT:   br label %exit
  %p1 = call noundef nonnull ptr @llvm.dx.resource.getpointer.p0.tdx.RawBuffer_v4f64_0_0t(target("dx.RawBuffer", <4 x double>, 0, 0) %in1, i32 %tid)
  br label %exit

exit:
; CHECK:      exit:
; CHECK-NEXT:   %[[VAL:.*]] = phi double [ %[[VAL0]], %if.then ], [ %[[VAL1]], %if.else ]
; CHECK-NOT:    phi ptr
; CHECK-NOT:    phi i32
; CHECK-NEXT:   call void @use_double(double %[[VAL]])
  %ptr = phi ptr [ %p0, %if.then ], [ %p1, %if.else ]
  %idxphi = phi i32 [ %a, %if.then ], [ %b, %if.else ]
  %gep = getelementptr double, ptr %ptr, i32 %idxphi
  %val = load double, ptr %gep, align 8
  call void @use_double(double %val)
  ret void
}

declare void @use_float(float)
declare void @use_double(double)
