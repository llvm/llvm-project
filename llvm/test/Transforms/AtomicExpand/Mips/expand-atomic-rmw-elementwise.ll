; MIPS uses TargetLowering's default AtomicRMW expansion, which splits
; elementwise operations into single-lane vectors.
define <2 x i32> @atomicrmw_add_elementwise(ptr %ptr, <2 x i32> %value) {
; CHECK-LABEL: define <2 x i32> @atomicrmw_add_elementwise(
; CHECK-SAME: ptr [[PTR:%.*]], <2 x i32> [[VALUE:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LO_VAL:%.*]] = shufflevector <2 x i32> [[VALUE]], <2 x i32> poison, <1 x i32> zeroinitializer
; CHECK-NEXT:    [[HI_VAL:%.*]] = shufflevector <2 x i32> [[VALUE]], <2 x i32> poison, <1 x i32> <i32 1>
; CHECK-NEXT:    [[HI_PTR:%.*]] = getelementptr inbounds <1 x i32>, ptr [[PTR]], i64 1
; CHECK-NEXT:    [[LANE_OLD:%.*]] = atomicrmw elementwise add ptr [[PTR]], <1 x i32> [[LO_VAL]] monotonic, align 8
; CHECK-NEXT:    [[LANE_OLD3:%.*]] = atomicrmw elementwise add ptr [[HI_PTR]], <1 x i32> [[HI_VAL]] monotonic, align 4
; CHECK-NEXT:    [[RESULT1:%.*]] = shufflevector <1 x i32> [[LANE_OLD]], <1 x i32> [[LANE_OLD3]], <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    ret <2 x i32> [[RESULT1]]
;
entry:
  %old = atomicrmw elementwise add ptr %ptr, <2 x i32> %value monotonic
  ret <2 x i32> %old
}

