; CHECK-NEXT:    [[TMP3:%.*]] = bitcast i32 [[TMP2]] to <1 x float>
; CHECK-NEXT:    ret <1 x float> [[TMP3]]
;
  %old = atomicrmw elementwise xchg ptr %addr, <1 x float> %val monotonic, align 4
  ret <1 x float> %old
}

