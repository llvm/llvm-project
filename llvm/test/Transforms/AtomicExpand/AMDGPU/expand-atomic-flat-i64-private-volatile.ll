; CHECK-NEXT:    br i1 [[IS_PRIVATE]], label %[[ATOMICRMW_PRIVATE:.*]], label %[[ATOMICRMW_GLOBAL:.*]]
; CHECK:       [[ATOMICRMW_PRIVATE]]:
; CHECK-NEXT:    [[TMP1:%.*]] = addrspacecast ptr [[PTR]] to ptr addrspace(5)
; CHECK-NEXT:    [[LOADED_PRIVATE:%.*]] = load volatile i64, ptr addrspace(5) [[TMP1]], align 8
; CHECK-NEXT:    [[NEW:%.*]] = add i64 [[LOADED_PRIVATE]], [[VAL]]
; CHECK-NEXT:    store volatile i64 [[NEW]], ptr addrspace(5) [[TMP1]], align 8
; CHECK-NEXT:    br label %[[ATOMICRMW_PHI:.*]]
; CHECK:       [[ATOMICRMW_GLOBAL]]:
; CHECK-NEXT:    [[TMP2:%.*]] = atomicrmw volatile add ptr [[PTR]], i64 [[VAL]] syncscope("agent") monotonic, align 8, !noalias.addrspace [[META0:![0-9]+]]
; CHECK-NEXT:    br label %[[ATOMICRMW_PHI]]
; CHECK:       [[ATOMICRMW_PHI]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i64 [ [[LOADED_PRIVATE]], %[[ATOMICRMW_PRIVATE]] ], [ [[TMP2]], %[[ATOMICRMW_GLOBAL]] ]
; CHECK-NEXT:    br label %[[ATOMICRMW_END:.*]]
; CHECK:       [[ATOMICRMW_END]]:
; CHECK-NEXT:    ret i64 [[RES]]
;
  %res = atomicrmw volatile add ptr %ptr, i64 %val syncscope("agent") monotonic
  ret i64 %res
}

