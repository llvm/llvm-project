; CHECK-NEXT:    [[NEW:%.*]] = add i32 [[TMP1]], [[V]]
; CHECK-NEXT:    store i32 [[NEW]], ptr addrspace(13) [[P]], align 4
; CHECK-NEXT:    ret i32 [[TMP1]]
;
  %r = atomicrmw add ptr addrspace(13) %p, i32 %v seq_cst
  ret i32 %r
}

