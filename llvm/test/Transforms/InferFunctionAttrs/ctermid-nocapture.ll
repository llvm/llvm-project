; RUN: opt < %s -mtriple=x86_64-unknown-linux-gnu -passes='inferattrs,function(dse)' -S | FileCheck %s
; ctermid returns its argument if not NULL, DSE removed store to %buf when it was marked nocapture
; This is a regression test checking that store is not removed
declare ptr @ctermid(ptr)
define i8 @f() {
; CHECK-LABEL: define i8 @f() {
; CHECK-NEXT:    [[BUF:%.*]] = alloca [9 x i8], align 1
; CHECK-NEXT:    [[R:%.*]] = call ptr @ctermid(ptr [[BUF]])
; CHECK-NEXT:    store i8 42, ptr [[BUF]], align 1
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[R]], align 1
; CHECK-NEXT:    ret i8 [[V]]
;
  %buf = alloca [9 x i8]
  %r = call ptr @ctermid(ptr %buf)
  store i8 42, ptr %buf
  %v = load i8, ptr %r
  ret i8 %v
}
