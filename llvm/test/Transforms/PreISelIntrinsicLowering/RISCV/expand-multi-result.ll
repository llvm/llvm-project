; Verify that multi-result scalable intrinsics (sincos, modf) are correctly
; scalarized: the struct return type must be decomposed to its scalar element
; type, not passed as a vector struct to getOrInsertDeclaration.

define { <vscale x 4 x float>, <vscale x 4 x float> } @scalable_vec_sincos_f32(<vscale x 4 x float> %input) {
; CHECK-LABEL: define { <vscale x 4 x float>, <vscale x 4 x float> } @scalable_vec_sincos_f32(
; CHECK-SAME: <vscale x 4 x float> [[INPUT:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = call i64 @llvm.vscale.i64()
; CHECK-NEXT:    [[TMP2:%.*]] = mul nuw i64 [[TMP1]], 4
; CHECK-NEXT:    br label %[[BB3:.*]]
; CHECK:       [[BB3]]:
; CHECK-NEXT:    [[TMP4:%.*]] = phi i64 [ 0, [[TMP0:%.*]] ], [ [[TMP13:%.*]], %[[BB3]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = phi <vscale x 4 x float> [ poison, [[TMP0]] ], [ [[TMP10:%.*]], %[[BB3]] ]
; CHECK-NEXT:    [[TMP6:%.*]] = phi <vscale x 4 x float> [ poison, [[TMP0]] ], [ [[TMP12:%.*]], %[[BB3]] ]
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <vscale x 4 x float> [[INPUT]], i64 [[TMP4]]
; CHECK-NEXT:    [[TMP8:%.*]] = call { float, float } @llvm.sincos.f32(float [[TMP7]])
; CHECK-NEXT:    [[TMP9:%.*]] = extractvalue { float, float } [[TMP8]], 0
; CHECK-NEXT:    [[TMP10]] = insertelement <vscale x 4 x float> [[TMP5]], float [[TMP9]], i64 [[TMP4]]
; CHECK-NEXT:    [[TMP11:%.*]] = extractvalue { float, float } [[TMP8]], 1
; CHECK-NEXT:    [[TMP12]] = insertelement <vscale x 4 x float> [[TMP6]], float [[TMP11]], i64 [[TMP4]]
; CHECK-NEXT:    [[TMP13]] = add i64 [[TMP4]], 1
; CHECK-NEXT:    [[TMP14:%.*]] = icmp eq i64 [[TMP13]], [[TMP2]]
; CHECK-NEXT:    br i1 [[TMP14]], label %[[BB15:.*]], label %[[BB3]]
; CHECK:       [[BB15]]:
; CHECK-NEXT:    [[TMP16:%.*]] = insertvalue { <vscale x 4 x float>, <vscale x 4 x float> } poison, <vscale x 4 x float> [[TMP10]], 0
; CHECK-NEXT:    [[TMP17:%.*]] = insertvalue { <vscale x 4 x float>, <vscale x 4 x float> } [[TMP16]], <vscale x 4 x float> [[TMP12]], 1
; CHECK-NEXT:    ret { <vscale x 4 x float>, <vscale x 4 x float> } [[TMP17]]
;
  %r = call { <vscale x 4 x float>, <vscale x 4 x float> } @llvm.sincos.nxv4f32(<vscale x 4 x float> %input)
  ret { <vscale x 4 x float>, <vscale x 4 x float> } %r
}

