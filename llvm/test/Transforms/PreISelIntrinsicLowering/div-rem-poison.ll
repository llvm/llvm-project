; RUN: opt -passes=pre-isel-intrinsic-lowering -S < %s | FileCheck %s

; Every call is expanded into a plain instruction with a guarded divisor.
; Replacing the divisor with 1 for the offending operands turns the division
; into x / 1 = x (or x % 1 = 0), which is a valid refinement of poison. The
; compare and the select are element-wise, so only the offending elements of a
; vector are guarded. The guarded operands are frozen, because the plain
; instruction is undefined for a poison divisor.

define i32 @sdiv_i32(i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @sdiv_i32(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = freeze i32 [[A]]
; CHECK-NEXT:    [[TMP2:%.*]] = freeze i32 [[B]]
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq i32 [[TMP2]], 0
; CHECK-NEXT:    [[TMP4:%.*]] = icmp eq i32 [[TMP1]], -2147483648
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i32 [[TMP2]], -1
; CHECK-NEXT:    [[TMP6:%.*]] = and i1 [[TMP4]], [[TMP5]]
; CHECK-NEXT:    [[TMP7:%.*]] = or i1 [[TMP3]], [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = select i1 [[TMP7]], i32 1, i32 [[TMP2]]
; CHECK-NEXT:    [[TMP9:%.*]] = sdiv i32 [[TMP1]], [[TMP8]]
; CHECK-NEXT:    ret i32 [[TMP9]]
;
  %r = call i32 @llvm.sdiv.poison.i32(i32 %a, i32 %b)
  ret i32 %r
}

