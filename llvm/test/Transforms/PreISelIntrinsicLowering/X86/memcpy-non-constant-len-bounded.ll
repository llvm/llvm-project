; CHECK-LABEL: define void @memcpy_bounded(
; CHECK-SAME: ptr [[DST:%.*]], ptr [[SRC:%.*]], i64 [[SIZE:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COND:%.*]] = icmp ult i64 [[SIZE]], 65
; CHECK-NEXT:    call void @llvm.assume(i1 [[COND]])
; CHECK-NEXT:    [[TMP0:%.*]] = sub i64 64, [[SIZE]]
; CHECK-NEXT:    [[TMP1:%.*]] = lshr i64 -1, [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[SIZE]], 0
; CHECK-NEXT:    [[TMP3:%.*]] = select i1 [[TMP2]], i64 0, i64 [[TMP1]]
; CHECK-NEXT:    [[TMP4:%.*]] = bitcast i64 [[TMP3]] to <64 x i1>
; CHECK-NEXT:    [[TMP5:%.*]] = call <64 x i8> @llvm.masked.load.v64i8.p0(ptr align 1 [[SRC]], <64 x i1> [[TMP4]], <64 x i8> poison)
; CHECK-NEXT:    call void @llvm.masked.store.v64i8.p0(<64 x i8> [[TMP5]], ptr align 1 [[DST]], <64 x i1> [[TMP4]])
; CHECK-NEXT:    ret void
;
entry:
  %cond = icmp ult i64 %size, 65
  call void @llvm.assume(i1 %cond)
  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %src, i64 %size, i1 false)
  ret void
}

