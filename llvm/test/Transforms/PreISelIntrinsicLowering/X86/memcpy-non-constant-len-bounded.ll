;; With a dominating len != 0 guard, no zero-select should be emitted.
define void @memcpy_bounded_nonzero(ptr %dst, ptr %src, i64 %size) #0 {
; CHECK-LABEL: define void @memcpy_bounded_nonzero(
; CHECK-SAME: ptr [[DST:%.*]], ptr [[SRC:%.*]], i64 [[SIZE:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COND:%.*]] = icmp ult i64 [[SIZE]], 65
; CHECK-NEXT:    call void @llvm.assume(i1 [[COND]])
; CHECK-NEXT:    [[ZERO:%.*]] = icmp eq i64 [[SIZE]], 0
; CHECK-NEXT:    br i1 [[ZERO]], label %[[EXIT:.*]], label %[[COPY:.*]]
; CHECK:       [[COPY]]:
; CHECK-NEXT:    [[TMP0:%.*]] = sub i64 64, [[SIZE]]
; CHECK-NEXT:    [[TMP1:%.*]] = lshr i64 -1, [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast i64 [[TMP1]] to <64 x i1>
; CHECK-NEXT:    [[TMP3:%.*]] = call <64 x i8> @llvm.masked.load.v64i8.p0(ptr align 1 [[SRC]], <64 x i1> [[TMP2]], <64 x i8> poison)
; CHECK-NEXT:    call void @llvm.masked.store.v64i8.p0(<64 x i8> [[TMP3]], ptr align 1 [[DST]], <64 x i1> [[TMP2]])
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cond = icmp ult i64 %size, 65
  call void @llvm.assume(i1 %cond)
  %zero = icmp eq i64 %size, 0
  br i1 %zero, label %exit, label %copy

copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %src, i64 %size, i1 false)
  br label %exit

exit:
  ret void
}

