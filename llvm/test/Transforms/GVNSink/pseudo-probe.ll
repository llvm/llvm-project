declare void @llvm.pseudoprobe(i64, i64, i32, i64)

; A pseudo probe marks the block it is in, so sinking it would attribute the
; samples of that block to another one. Sinking two probes with different
; indices would also leave a phi node as the index, which extractProbe() does
; not expect. The instructions after the probe are still sunk.

define i32 @different_indices(i1 %c, i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @different_indices(
; CHECK-SAME: i1 [[C:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    call void @llvm.pseudoprobe(i64 1234, i64 2, i32 0, i64 -1)
; CHECK-NEXT:    [[SUB0:%.*]] = sub i32 [[A]], [[B]]
; CHECK-NEXT:    br label %[[IF_END:.*]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    call void @llvm.pseudoprobe(i64 1234, i64 3, i32 0, i64 -1)
; CHECK-NEXT:    [[SUB1:%.*]] = sub i32 [[A]], [[B]]
; CHECK-NEXT:    br label %[[IF_END]]
; CHECK:       [[IF_END]]:
; CHECK-NEXT:    [[SUB1_SINK:%.*]] = phi i32 [ [[SUB1]], %[[IF_ELSE]] ], [ [[SUB0]], %[[IF_THEN]] ]
; CHECK-NEXT:    [[MUL1:%.*]] = mul i32 [[SUB1_SINK]], [[A]]
; CHECK-NEXT:    ret i32 [[MUL1]]
;
entry:
  br i1 %c, label %if.then, label %if.else

if.then:
  call void @llvm.pseudoprobe(i64 1234, i64 2, i32 0, i64 -1)
  %sub0 = sub i32 %a, %b
  %mul0 = mul i32 %sub0, %a
  br label %if.end

if.else:
  call void @llvm.pseudoprobe(i64 1234, i64 3, i32 0, i64 -1)
  %sub1 = sub i32 %a, %b
  %mul1 = mul i32 %sub1, %a
  br label %if.end

if.end:
  %phi = phi i32 [ %mul0, %if.then ], [ %mul1, %if.else ]
  ret i32 %phi
}

