; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    call void @llvm.pseudoprobe(i64 1234, i64 2, i32 0, i64 -1)
; CHECK-NEXT:    [[SUB0:%.*]] = sub i32 [[A]], [[B]]
; CHECK-NEXT:    br label %[[IF_END:.*]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    call void @llvm.pseudoprobe(i64 1234, i64 3, i32 0, i64 -1)
; CHECK-NEXT:    [[SUB1:%.*]] = sub i32 [[A]], [[B]]
; CHECK-NEXT:    br label %[[IF_END]]
; CHECK:       [[IF_END]]:
; CHECK-NEXT:    [[SUB1_SINK:%.*]] = phi i32 [ [[SUB1]], %[[IF_ELSE]] ], [ [[SUB0]], %[[IF_THEN]] ]
; CHECK-NEXT:    [[MUL1:%.*]] = mul i32 [[SUB1_SINK]], [[A]]
; CHECK-NEXT:    ret i32 [[MUL1]]
;
entry:
  br i1 %c, label %if.then, label %if.else

if.then:
  call void @llvm.pseudoprobe(i64 1234, i64 2, i32 0, i64 -1)
  %sub0 = sub i32 %a, %b
  %mul0 = mul i32 %sub0, %a
