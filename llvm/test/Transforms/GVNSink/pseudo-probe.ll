; The index of a pseudo probe is an immarg, so the two probes cannot be sunk
; into a single one taking a phi node. The instructions after them are still
; sunk.

define i32 @different_indices(i1 %c, i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @different_indices(
; CHECK-SAME: i1 [[C:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
