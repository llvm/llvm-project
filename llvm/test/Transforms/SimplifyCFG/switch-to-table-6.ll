; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals all --version 5
; RUN: opt -S -passes='simplifycfg<switch-to-lookup>' < %s | FileCheck %s

; Test converting `switch` instructions that index a global and update the read
; value into single loads from an updated table.

; Byte 1 of each element is 1, 2, 3, 4; byte 0 is 0x10, 0x20, 0x30, 0x40.
@table_i32 = internal unnamed_addr constant [4 x i32] [i32 u0x0110, i32 u0x0220, i32 u0x0330, i32 u0x0440]

;.
; CHECK: @table_i32 = internal unnamed_addr constant [4 x i32] [i32 272, i32 544, i32 816, i32 1088]
; CHECK: @switch.table.off_within_stride = private unnamed_addr constant [4 x i8] c"\0A\14\1E\00", align 1
;.
define i8 @off_within_stride(i64 %idx) {
; CHECK-LABEL: define i8 @off_within_stride(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[G:%.*]] = getelementptr inbounds i32, ptr @table_i32, i64 [[IDX]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[G]], i64 1
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [4 x i8], ptr @switch.table.off_within_stride, i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
; CHECK-NEXT:    ret i8 [[SWITCH_LOAD]]
;
entry:
  %g = getelementptr inbounds i32, ptr @table_i32, i64 %idx
  %p = getelementptr inbounds i8, ptr %g, i64 1
  %v = load i8, ptr %p
  switch i8 %v, label %d [
  i8 1, label %a
  i8 2, label %b
  i8 3, label %c
  ]
a: br label %e
b: br label %e
c: br label %e
d: br label %e
e:
  %r = phi i8 [10, %a], [20, %b], [30, %c], [0, %d]
  ret i8 %r
}
