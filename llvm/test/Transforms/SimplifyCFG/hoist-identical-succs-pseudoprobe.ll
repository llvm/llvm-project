; Distinct pseudo probes do not prevent identical successors from merging.
; Matching probes remain available for profiling after the merge.

declare void @llvm.pseudoprobe(i64, i64, i32, i64)

define void @identical_unreachable_succs(i1 %c, ptr %p) {
; CHECK-LABEL: define void @identical_unreachable_succs(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    store volatile i32 0, ptr [[P]], align 4
; CHECK-NEXT:    unreachable
;
entry:
  br i1 %c, label %a, label %b

a:
  call void @llvm.pseudoprobe(i64 1, i64 2, i32 0, i64 -1)
  store volatile i32 0, ptr %p, align 4
  unreachable

b:
  call void @llvm.pseudoprobe(i64 1, i64 3, i32 0, i64 -1)
  store volatile i32 0, ptr %p, align 4
  unreachable
}

define i32 @identical_ret_succs(i1 %c, ptr %p, i32 %v) {
; CHECK-LABEL: define i32 @identical_ret_succs(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    store volatile i32 [[V]], ptr [[P]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  br i1 %c, label %a, label %b

a:
  call void @llvm.pseudoprobe(i64 2, i64 2, i32 0, i64 -1)
  store volatile i32 %v, ptr %p, align 4
  ret i32 %v

b:
  store volatile i32 %v, ptr %p, align 4
  call void @llvm.pseudoprobe(i64 2, i64 3, i32 0, i64 -1)
  ret i32 %v
}

; Identical probes remain available for profiling after the blocks merge.
define void @identical_probes(i1 %c, ptr %p) {
