; CHECK-NEXT:      #dbg_value(i32 1, [[META6]], !DIExpression(), [[META8]])
; CHECK-NEXT:    store volatile i32 0, ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %a, label %b

a:
