; CHECK-NEXT:    call void @use(i64 [[ADD]])
; CHECK-NEXT:    [[Z:%.*]] = icmp eq i64 [[ADD]], 0
; CHECK-NEXT:    br i1 [[Z]], label [[ISZERO:%.*]], label [[NONZERO:%.*]]
