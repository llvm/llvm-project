; The premise is about the umin itself, but its operand %x also appears in
; it. The query on %x alone (%u s< %x implies %x != 0?) cannot be decided,
; so the implication must be retried on the original operands, where %x in
; [-128, 0] and %u s< %x give %u != 0.
define void @umin_signed_premise_range(i8 range(i8 -128, 1) %x) {
; CHECK-LABEL: @umin_signed_premise_range(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[U:%.*]] = call i8 @llvm.umin.i8(i8 [[X:%.*]], i8 -56)
; CHECK-NEXT:    [[P:%.*]] = icmp slt i8 [[U]], [[X]]
; CHECK-NEXT:    br i1 [[P]], label [[NONZERO:%.*]], label [[EXIT:%.*]]
; CHECK:       nonzero:
; CHECK-NEXT:    call void @sink_nonzero()
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %u = call i8 @llvm.umin.i8(i8 %x, i8 -56)
  %p = icmp slt i8 %u, %x
  br i1 %p, label %check, label %exit

check:
  %iszero = icmp eq i8 %u, 0
  br i1 %iszero, label %iszero_bb, label %nonzero

iszero_bb:
  call void @sink_zero()
  br label %exit

nonzero:
  call void @sink_nonzero()
  br label %exit

exit:
  ret void
}

