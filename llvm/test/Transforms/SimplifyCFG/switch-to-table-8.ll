; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals all --version 6
; RUN: opt -S -passes='simplifycfg<switch-to-lookup>' < %s | FileCheck %s

; Test converting `switch` instructions that index a global and update the read
; value into single loads from an updated table.

; `load` instruction have another use other than the `switch`, so under
; `optsize` we don't create a new global as the old one would stay too,
; increasing binary size.

@table_optsize_extra_use = internal constant [8 x i8] c"\00\01\02\03\00\01\02\03"

;.
; CHECK: @table_optsize_extra_use = internal constant [8 x i8] c"\00\01\02\03\00\01\02\03"
;.
define i8 @optsize_load_extra_use(i64 %idx, ptr %out) optsize {
; CHECK-LABEL: define i8 @optsize_load_extra_use(
; CHECK-SAME: i64 [[IDX:%.*]], ptr [[OUT:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr @table_optsize_extra_use, i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[GEP]], align 1
; CHECK-NEXT:    store i8 [[V]], ptr [[OUT]], align 1
; CHECK-NEXT:    switch i8 [[V]], label %[[SW_DEFAULT:.*]] [
; CHECK-NEXT:      i8 0, label %[[EXIT:.*]]
; CHECK-NEXT:      i8 1, label %[[SW_BB2:.*]]
; CHECK-NEXT:      i8 2, label %[[SW_BB3:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[SW_BB2]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[SW_BB3]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[SW_DEFAULT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i8 [ 7, %[[SW_DEFAULT]] ], [ 30, %[[SW_BB2]] ], [ 20, %[[SW_BB3]] ], [ 10, %[[ENTRY]] ]
; CHECK-NEXT:    ret i8 [[R]]
;
entry:
  %gep = getelementptr inbounds i8, ptr @table_optsize_extra_use, i64 %idx
  %v = load i8, ptr %gep
  store i8 %v, ptr %out
  switch i8 %v, label %sw.default [
  i8 0, label %sw.bb1
  i8 1, label %sw.bb2
  i8 2, label %sw.bb3
  ]

sw.bb1:
  br label %exit

sw.bb2:
  br label %exit

sw.bb3:
  br label %exit

sw.default:
  br label %exit

exit:
  %r = phi i8 [ 10, %sw.bb1 ], [ 30, %sw.bb2 ], [ 20, %sw.bb3 ], [ 7, %sw.default ]
  ret i8 %r
}
;.
; CHECK: attributes #[[ATTR0]] = { optsize }
;.
