; CHECK-SAME: ptr [[FP1:%.*]], ptr [[FP2:%.*]]) personality ptr @__gxx_personality_v0 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IT:%.*]] = invoke ptr [[FP1]]()
; CHECK-NEXT:            to label %[[LOOP:.*]] unwind label %[[LPAD:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[C:%.*]] = call i1 @use(ptr [[IT]])
; CHECK-NEXT:    br i1 [[C]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[R:%.*]] = invoke ptr [[FP2]]()
; CHECK-NEXT:            to label %[[LOOP]] unwind label %[[LPAD]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
; CHECK:       [[LPAD]]:
; CHECK-NEXT:    [[LP:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    call void @destructor()
; CHECK-NEXT:    resume { ptr, i32 } [[LP]]
;
entry:
  %it = invoke ptr %fp1()
  to label %loop unwind label %lpad

loop:
