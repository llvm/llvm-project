; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --no-generate-body-for-unused-prefixes --version 6
; RUN: opt -S -passes=simplifycfg -simplifycfg-require-and-preserve-domtree=1 -verify-dom-info < %s | FileCheck %s
; RUN: opt -S -passes=simplifycfg -simplifycfg-require-and-preserve-domtree=0 < %s | FileCheck %s
; RUN: %if asserts %{ opt -passes=simplifycfg -stats -disable-output < %s 2>&1 | FileCheck %s --check-prefix=STATS %}

; Removing the last block makes both successors of its predecessor identical.
; Revisit that predecessor without rescanning the function for each link in the
; chain. Longer chains used to exceed the iteration limit (see PR236666).
; The dependent loads prevent foldBranchToCommonDest() from speculating the
; conditions into their predecessors with the default options.

; Allow fewer iterations if the final block merging or fixpoint check improves.
; STATS: {{^ *[1-3] +}}simplifycfg - Number of SimplifyCFG iterations

define void @branch_chain(ptr %ptr) {
; CHECK-LABEL: define void @branch_chain(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    ret void
;
entry:
  %p0 = load ptr, ptr %ptr
  %v0 = load i32, ptr %p0
  %c0 = icmp eq i32 %v0, 0
  br i1 %c0, label %exit, label %bb1

bb1:
  %p1 = load ptr, ptr %ptr
  %v1 = load i32, ptr %p1
  %c1 = icmp eq i32 %v1, 0
  br i1 %c1, label %exit, label %bb2

bb2:
  %p2 = load ptr, ptr %ptr
  %v2 = load i32, ptr %p2
  %c2 = icmp eq i32 %v2, 0
  br i1 %c2, label %exit, label %bb3

bb3:
  %p3 = load ptr, ptr %ptr
  %v3 = load i32, ptr %p3
  %c3 = icmp eq i32 %v3, 0
  br i1 %c3, label %exit, label %exit

exit:
  ret void
}
