; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DOT:%.*]] = select i1 [[COND]], i32 1, i32 2
; CHECK-NEXT:    [[FP1_FP2:%.*]] = select i1 [[COND]], ptr [[FP1]], ptr [[FP2]]
; CHECK-NEXT:    call void @use(i32 [[DOT]])
; CHECK-NEXT:    call void [[FP1_FP2]](), !callees [[META2:![0-9]+]]
; CHECK-NEXT:    ret void
;
entry:
  br i1 %cond, label %then, label %else

then:
  call void @use(i32 1)
  call void %fp1(), !callees !3
  br label %end

else:
