; Hoisting or sinking replaces the instructions on both paths with a single
; instruction, which requests the PC sections of either of them.

define void @sink_first_only(i1 %c, ptr %p) {
; CHECK-LABEL: define void @sink_first_only(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[DOT:%.*]] = select i1 [[C]], i8 1, i8 2
; CHECK-NEXT:    store i8 [[DOT]], ptr [[P]], align 1, !pcsections [[META0:![0-9]+]]
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %a, label %b

a:
  store i8 1, ptr %p, align 1, !pcsections !0
  br label %end

b:
  store i8 2, ptr %p, align 1
  br label %end

end:
  ret void
}

