; Test converting `switch` instructions that index a global and update the read
; value into single loads from an updated table.

; When offset is negative or larger than the same we currently don't transform.

@table2 = internal unnamed_addr constant [4 x i8] c"\00\01\02\03"

;.
; CHECK: @table2 = internal unnamed_addr constant [4 x i8] c"\00\01\02\03"
;.
define i8 @pos_off(i64 %idx) {
; CHECK-LABEL: define i8 @pos_off(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[G:%.*]] = getelementptr inbounds i8, ptr @table2, i64 [[IDX]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[G]], i64 1
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    switch i8 [[V]], label %[[SW_DEFAULT:.*]] [
; CHECK-NEXT:      i8 1, label %[[EXIT:.*]]
; CHECK-NEXT:      i8 2, label %[[SW_BB2:.*]]
; CHECK-NEXT:      i8 3, label %[[SW_BB3:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[SW_BB2]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[SW_BB3]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[SW_DEFAULT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i8 [ 0, %[[SW_DEFAULT]] ], [ 20, %[[SW_BB2]] ], [ 30, %[[SW_BB3]] ], [ 10, %[[ENTRY]] ]
; CHECK-NEXT:    ret i8 [[R]]
;
entry:
  %g = getelementptr inbounds i8, ptr @table2, i64 %idx
  %p = getelementptr inbounds i8, ptr %g, i64 1
  %v = load i8, ptr %p
  switch i8 %v, label %sw.default [
  i8 1, label %sw.bb1
  i8 2, label %sw.bb2
  i8 3, label %sw.bb3
  ]

sw.bb1:
  br label %exit

sw.bb2:
  br label %exit

sw.bb3:
  br label %exit

sw.default:
  br label %exit

exit:
  %r = phi i8 [10, %sw.bb1], [20, %sw.bb2], [30, %sw.bb3], [0, %sw.default]
  ret i8 %r
}

