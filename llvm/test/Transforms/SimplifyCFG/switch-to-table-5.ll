; CHECK: @table2 = internal unnamed_addr constant [4 x i8] c"\00\01\02\03"
;.
define i8 @pos_off(i64 %idx) {
; CHECK-LABEL: define i8 @pos_off(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[G:%.*]] = getelementptr inbounds i8, ptr @table2, i64 [[IDX]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[G]], i64 1
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    switch i8 [[V]], label %[[D:.*]] [
; CHECK-NEXT:      i8 1, label %[[E:.*]]
; CHECK-NEXT:      i8 2, label %[[B:.*]]
; CHECK-NEXT:      i8 3, label %[[C:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[B]]:
; CHECK-NEXT:    br label %[[E]]
; CHECK:       [[C]]:
; CHECK-NEXT:    br label %[[E]]
; CHECK:       [[D]]:
; CHECK-NEXT:    br label %[[E]]
; CHECK:       [[E]]:
; CHECK-NEXT:    [[R:%.*]] = phi i8 [ 0, %[[D]] ], [ 20, %[[B]] ], [ 30, %[[C]] ], [ 10, %[[ENTRY]] ]
; CHECK-NEXT:    ret i8 [[R]]
;
entry:
  %g = getelementptr inbounds i8, ptr @table2, i64 %idx
  %p = getelementptr inbounds i8, ptr %g, i64 1
  %v = load i8, ptr %p
  switch i8 %v, label %d [
  i8 1, label %a
  i8 2, label %b
  i8 3, label %c
  ]
a: br label %e
b: br label %e
c: br label %e
d: br label %e
e:
  %r = phi i8 [10, %a], [20, %b], [30, %c], [0, %d]
  ret i8 %r
}

