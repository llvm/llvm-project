; Basic triangle+diamond pattern: three branches all store to the same address.
;
;   entry: br cond1, then, else
;   then:  store %a, ptr %p  ->  merge
;   else:  br cond2, else.then, else.else
;   else.then: store %b, ptr %p  ->  merge
;   else.else: store %c, ptr %p  ->  merge
;
; Should fold to: select + unconditional store in entry.

define void @basic(ptr %p, i1 %cond1, i1 %cond2, i8 %a, i8 %b, i8 %c) {
; CHECK-LABEL: @basic(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[STORE_SEL_INNER:%.*]] = select i1 [[COND2:%.*]], i8 [[B:%.*]], i8 [[C1:%.*]]
; CHECK-NEXT:    [[C:%.*]] = select i1 [[COND1:%.*]], i8 [[A:%.*]], i8 [[STORE_SEL_INNER]]
; CHECK-NEXT:    store i8 [[C]], ptr [[P:%.*]], align 1
; CHECK-NEXT:    ret void
;
entry:
  br i1 %cond1, label %then, label %else

then:
  store i8 %a, ptr %p
  br label %merge

else:
  br i1 %cond2, label %else.then, label %else.else

else.then:
  store i8 %b, ptr %p
  br label %merge

else.else:
  store i8 %c, ptr %p
  br label %merge

merge:
  ret void
}

