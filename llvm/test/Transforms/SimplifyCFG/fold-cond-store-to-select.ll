; GEP address computed in each branch — isSameGEPAddress matches them.
define void @gep_address(ptr %base, i64 %idx, i1 %cond1, i1 %cond2, i8 %a, i8 %b, i8 %c) {
; CHECK-LABEL: @gep_address(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[ADDR_EE:%.*]] = getelementptr i8, ptr [[BASE:%.*]], i64 [[IDX:%.*]]
; CHECK-NEXT:    [[STORE_SEL_INNER:%.*]] = select i1 [[COND2:%.*]], i8 [[B:%.*]], i8 [[C1:%.*]]
; CHECK-NEXT:    [[C:%.*]] = select i1 [[COND1:%.*]], i8 [[A:%.*]], i8 [[STORE_SEL_INNER]]
; CHECK-NEXT:    store i8 [[C]], ptr [[ADDR_EE]], align 1
; CHECK-NEXT:    ret void
;
entry:
  br i1 %cond1, label %then, label %else

then:
  %addr.then = getelementptr i8, ptr %base, i64 %idx
  store i8 %a, ptr %addr.then
  br label %merge

else:
  br i1 %cond2, label %else.then, label %else.else

else.then:
  %addr.et = getelementptr i8, ptr %base, i64 %idx
  store i8 %b, ptr %addr.et
  br label %merge

else.else:
  %addr.ee = getelementptr i8, ptr %base, i64 %idx
  store i8 %c, ptr %addr.ee
  br label %merge

merge:
  ret void
}

