; Test copying ephemeral instructions (assumes and their dependencies) into the
; successor blocks to allow folding the block into the predecessors.

declare void @fun0(i32)
declare void @fun1(i32)
declare i1 @dynamic_cond()

define void @goal(i32 %idx) {
; CHECK-LABEL: define void @goal(
; CHECK-SAME: i32 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    switch i32 [[IDX]], label %[[CALL1:.*]] [
; CHECK-NEXT:      i32 -1, label %[[DONE:.*]]
; CHECK-NEXT:      i32 0, label %[[CALL0:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[CALL0]]:
; CHECK-NEXT:    [[INRANGE1:%.*]] = icmp ult i32 [[IDX]], 2
; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE1]])
; CHECK-NEXT:    call void @fun0(i32 [[IDX]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[CALL1]]:
; CHECK-NEXT:    [[INRANGE2:%.*]] = icmp ult i32 [[IDX]], 2
; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE2]])
; CHECK-NEXT:    call void @fun1(i32 [[IDX]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
entry:
  %test = icmp eq i32 %idx, -1
  br i1 %test, label %done, label %dispatch

dispatch:
  %is0 = icmp eq i32 %idx, 0
  %inrange = icmp ult i32 %idx, 2
  call void @llvm.assume(i1 %inrange)
  br i1 %is0, label %call0, label %call1

call0:
  call void @fun0(i32 %idx)
  br label %done

call1:
  call void @fun1(i32 %idx)
  br label %done

done:
  ret void
}

; If a destination of the block with an assume has other predecessors that
; don't go through the block with the assume, don't copy the assume and don't
; fold the block into the predecessor.
define void @goal_extra_pred(i32 %idx) {
; CHECK-LABEL: define void @goal_extra_pred(
; CHECK-SAME: i32 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COND:%.*]] = call i1 @dynamic_cond()
; CHECK-NEXT:    br i1 [[COND]], label %[[CALL1:.*]], label %[[ORIGINAL_ENTRY:.*]]
; CHECK:       [[ORIGINAL_ENTRY]]:
; CHECK-NEXT:    [[TEST:%.*]] = icmp eq i32 [[IDX]], -1
; CHECK-NEXT:    br i1 [[TEST]], label %[[DONE:.*]], label %[[DISPATCH:.*]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[IS0:%.*]] = icmp eq i32 [[IDX]], 0
; CHECK-NEXT:    [[INRANGE:%.*]] = icmp ult i32 [[IDX]], 2
; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE]])
; CHECK-NEXT:    br i1 [[IS0]], label %[[CALL0:.*]], label %[[CALL1]]
; CHECK:       [[CALL0]]:
; CHECK-NEXT:    call void @fun0(i32 [[IDX]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[CALL1]]:
; CHECK-NEXT:    call void @fun1(i32 [[IDX]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
entry:
  %cond = call i1 @dynamic_cond()
  br i1 %cond, label %call1, label %original_entry

original_entry:
  %test = icmp eq i32 %idx, -1
  br i1 %test, label %done, label %dispatch

dispatch:
  %is0 = icmp eq i32 %idx, 0
  %inrange = icmp ult i32 %idx, 2
  call void @llvm.assume(i1 %inrange)
  br i1 %is0, label %call0, label %call1

call0:
  call void @fun0(i32 %idx)
  br label %done

call1:
  call void @fun1(i32 %idx)
  br label %done

done:
  ret void
}

; Same as the test above, but with debug records on duplicated instructions.
define void @goal_debug_records(i32 %idx) !dbg !2 {
; CHECK-LABEL: define void @goal_debug_records(
; CHECK-SAME: i32 [[IDX:%.*]]) !dbg [[DBG1:![0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:      #dbg_value(i32 0, [[META5:![0-9]+]], !DIExpression(), [[META6:![0-9]+]])
; CHECK-NEXT:      #dbg_value(i32 1, [[META5]], !DIExpression(), [[META6]])
; CHECK-NEXT:    switch i32 [[IDX]], label %[[CALL1:.*]] [
; CHECK-NEXT:      i32 -1, label %[[DONE:.*]]
; CHECK-NEXT:      i32 0, label %[[CALL0:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[CALL0]]:
; CHECK-NEXT:    [[INRANGE1:%.*]] = icmp ult i32 [[IDX]], 2
; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE1]])
; CHECK-NEXT:      #dbg_value(i32 6, [[META5]], !DIExpression(), [[META6]])
; CHECK-NEXT:    call void @fun0(i32 [[IDX]])
; CHECK-NEXT:      #dbg_value(i32 7, [[META5]], !DIExpression(), [[META6]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[CALL1]]:
; CHECK-NEXT:    [[INRANGE2:%.*]] = icmp ult i32 [[IDX]], 2
; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE2]])
; CHECK-NEXT:      #dbg_value(i32 8, [[META5]], !DIExpression(), [[META6]])
; CHECK-NEXT:    call void @fun1(i32 [[IDX]])
; CHECK-NEXT:      #dbg_value(i32 9, [[META5]], !DIExpression(), [[META6]])
; CHECK-NEXT:    br label %[[DONE]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
entry:
    #dbg_value(i32 0, !3, !DIExpression(), !4)
  %test = icmp eq i32 %idx, -1
    #dbg_value(i32 1, !3, !DIExpression(), !4)
  br i1 %test, label %done, label %dispatch

dispatch:
    #dbg_value(i32 2, !3, !DIExpression(), !4)
  %is0 = icmp eq i32 %idx, 0
    #dbg_value(i32 3, !3, !DIExpression(), !4)
  %inrange = icmp ult i32 %idx, 2
    #dbg_value(i32 4, !3, !DIExpression(), !4)
  call void @llvm.assume(i1 %inrange)
    #dbg_value(i32 5, !3, !DIExpression(), !4)
  br i1 %is0, label %call0, label %call1

call0:
    #dbg_value(i32 6, !3, !DIExpression(), !4)
  call void @fun0(i32 %idx)
    #dbg_value(i32 7, !3, !DIExpression(), !4)
  br label %done

call1:
    #dbg_value(i32 8, !3, !DIExpression(), !4)
  call void @fun1(i32 %idx)
    #dbg_value(i32 9, !3, !DIExpression(), !4)
  br label %done

done:
  ret void
}

