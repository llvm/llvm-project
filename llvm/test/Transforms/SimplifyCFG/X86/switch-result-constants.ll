; These constants are valid select operands, regardless of whether they can
; be used in a lookup table initializer.
;.
; CHECK: @a = external global i32
; CHECK: @b = external global i32
; CHECK: @c = external global i32
; CHECK: @d = external global i32
;.
define <vscale x 4 x i32> @select_scalable(i32 %x) {
; CHECK-LABEL: define <vscale x 4 x i32> @select_scalable(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SWITCH_SELECTCMP:%.*]] = icmp eq i32 [[X]], 1
; CHECK-NEXT:    [[SWITCH_SELECT:%.*]] = select i1 [[SWITCH_SELECTCMP]], <vscale x 4 x i32> splat (i32 7), <vscale x 4 x i32> zeroinitializer
; CHECK-NEXT:    [[SWITCH_SELECTCMP1:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    [[SWITCH_SELECT2:%.*]] = select i1 [[SWITCH_SELECTCMP1]], <vscale x 4 x i32> splat (i32 3), <vscale x 4 x i32> [[SWITCH_SELECT]]
; CHECK-NEXT:    ret <vscale x 4 x i32> [[SWITCH_SELECT2]]
;
entry:
  switch i32 %x, label %default [
  i32 0, label %case0
  i32 1, label %case1
  ]
case0:
  br label %return
case1:
  br label %return
default:
  br label %return
return:
  %r = phi <vscale x 4 x i32> [ splat (i32 3), %case0 ], [ splat (i32 7), %case1 ], [ zeroinitializer, %default ]
  ret <vscale x 4 x i32> %r
}

