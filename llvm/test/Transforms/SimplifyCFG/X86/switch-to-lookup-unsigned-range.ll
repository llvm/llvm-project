target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

; A switch only compares its condition for equality, so a lookup table can be
; laid out over the unsigned range of the case values whenever that is narrower
; than the signed one. This happens once the switch condition has been narrowed
; to the smallest type holding all case values (InstCombine does this), which
; wraps the top of a contiguous unsigned range around to the negative side of
; the narrowed type. The i4 switches below stand in for the narrowed condition.

; A contiguous unsigned range starting at zero indexes the table directly,
; rather than through an offset of the signed minimum.
;.
; CHECK: @switch.table.contiguous_from_zero = private unnamed_addr constant [10 x i8] c"\02\0C$J~\C0\15s\DF^", align 4
; CHECK: @switch.table.keep_covering_signed_range = private unnamed_addr constant [16 x i8] c"\E0_******\03\0D%K\7F\C1\16t", align 4
; CHECK: @switch.table.unsigned_range_straddles_sign_boundary = private unnamed_addr constant [8 x i8] c"\04\0E&L\80\C2\17u", align 4
; CHECK: @switch.table.unsigned_range_unreachable_default = private unnamed_addr constant [8 x i8] c"\05\0F'M\81\C3\18v", align 4
; CHECK: @switch.table.signed_range_is_narrower = private unnamed_addr constant [8 x i8] c"\06\10(N\82\C4\19w", align 4
;.
define i32 @contiguous_from_zero(i4 %c) {
; CHECK-LABEL: @contiguous_from_zero(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = zext i4 [[C:%.*]] to i64
; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [10 x i8], ptr @switch.table.contiguous_from_zero, i64 0, i64 [[TMP0]]
; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i8 [[SWITCH_LOAD]] to i32
; CHECK-NEXT:    ret i32 [[SWITCH_EXT]]
;
entry:
  switch i4 %c, label %sw.default [
  i4 0, label %sw.bb0
  i4 1, label %sw.bb1
  i4 2, label %sw.bb2
  i4 3, label %sw.bb3
  i4 4, label %sw.bb4
  i4 5, label %sw.bb5
  i4 6, label %sw.bb6
  i4 7, label %sw.bb7
  i4 -8, label %sw.bb8
  i4 -7, label %sw.bb9
  ]

sw.bb0:
  br label %return
sw.bb1:
  br label %return
sw.bb2:
  br label %return
sw.bb3:
  br label %return
sw.bb4:
  br label %return
sw.bb5:
  br label %return
sw.bb6:
  br label %return
sw.bb7:
  br label %return
sw.bb8:
  br label %return
sw.bb9:
  br label %return

sw.default:
  unreachable

return:
  %retval = phi i32 [ 2, %sw.bb0 ], [ 12, %sw.bb1 ], [ 36, %sw.bb2 ], [ 74, %sw.bb3 ], [ 126, %sw.bb4 ], [ 192, %sw.bb5 ], [ 21, %sw.bb6 ], [ 115, %sw.bb7 ], [ 223, %sw.bb8 ], [ 94, %sw.bb9 ]
  ret i32 %retval
}

