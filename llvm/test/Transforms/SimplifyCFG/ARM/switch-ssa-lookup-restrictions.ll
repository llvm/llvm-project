@a = external global [4 x i32]
@b = external global i32
@c = external global i32

; ROPI/RWPI disallow these addresses in lookup table initializers, but they can
; still be used as select operands, including the default result.
;.
; CHECK: @a = external global [4 x i32]
; CHECK: @b = external global i32
; CHECK: @c = external global i32
; CHECK: @switch.table.mixed_replacements = private unnamed_addr constant [4 x i16] [i16 1234, i16 5678, i16 15532, i16 8910], align 4
;.
define ptr @select_addresses(i32 %x) {
; CHECK-LABEL: define ptr @select_addresses(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SWITCH_SELECTCMP:%.*]] = icmp eq i32 [[X]], 1
; CHECK-NEXT:    [[SWITCH_SELECT:%.*]] = select i1 [[SWITCH_SELECTCMP]], ptr @b, ptr @c
; CHECK-NEXT:    [[SWITCH_SELECTCMP1:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    [[SWITCH_SELECT2:%.*]] = select i1 [[SWITCH_SELECTCMP1]], ptr getelementptr inbounds ([4 x i32], ptr @a, i32 0, i32 1), ptr [[SWITCH_SELECT]]
; CHECK-NEXT:    ret ptr [[SWITCH_SELECT2]]
;
entry:
  switch i32 %x, label %default [
  i32 0, label %case0
  i32 1, label %case1
  ]
case0:
  br label %return
case1:
  br label %return
default:
  br label %return
return:
  %r = phi ptr [ getelementptr inbounds ([4 x i32], ptr @a, i32 0, i32 1), %case0 ], [ @b, %case1 ], [ @c, %default ]
  ret ptr %r
}

declare void @use(ptr, i32, i8, i32)

; Each PHI gets its own replacement: a single pointer value, a linear map, a
; bitmap, and an integer lookup table. Only the last needs a global initializer.
define void @mixed_replacements(i32 %x) {
; CHECK-LABEL: define void @mixed_replacements(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ult i32 [[X]], 4
; CHECK-NEXT:    br i1 [[TMP0]], label %[[SWITCH_LOOKUP:.*]], label %[[RETURN:.*]]
; CHECK:       [[SWITCH_LOOKUP]]:
; CHECK-NEXT:    [[SWITCH_IDX_MULT:%.*]] = mul nsw i32 [[X]], 3
; CHECK-NEXT:    [[SWITCH_OFFSET:%.*]] = add nsw i32 [[SWITCH_IDX_MULT]], 3
; CHECK-NEXT:    [[SWITCH_SHIFTAMT:%.*]] = mul nuw nsw i32 [[X]], 8
; CHECK-NEXT:    [[SWITCH_DOWNSHIFT:%.*]] = lshr i32 33620483, [[SWITCH_SHIFTAMT]]
; CHECK-NEXT:    [[SWITCH_MASKED:%.*]] = trunc i32 [[SWITCH_DOWNSHIFT]] to i8
; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [4 x i16], ptr @switch.table.mixed_replacements, i32 0, i32 [[X]]
; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i16, ptr [[SWITCH_GEP]], align 2
; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i16 [[SWITCH_LOAD]] to i32
; CHECK-NEXT:    br label %[[RETURN]]
; CHECK:       [[RETURN]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ @a, %[[SWITCH_LOOKUP]] ], [ null, %[[ENTRY]] ]
; CHECK-NEXT:    [[LINEAR:%.*]] = phi i32 [ [[SWITCH_OFFSET]], %[[SWITCH_LOOKUP]] ], [ -1, %[[ENTRY]] ]
; CHECK-NEXT:    [[BITMAP:%.*]] = phi i8 [ [[SWITCH_MASKED]], %[[SWITCH_LOOKUP]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[TABLE:%.*]] = phi i32 [ [[SWITCH_EXT]], %[[SWITCH_LOOKUP]] ], [ -1, %[[ENTRY]] ]
; CHECK-NEXT:    call void @use(ptr [[P]], i32 [[LINEAR]], i8 [[BITMAP]], i32 [[TABLE]])
; CHECK-NEXT:    ret void
;
entry:
  switch i32 %x, label %default [
  i32 0, label %case0
  i32 1, label %case1
  i32 2, label %case2
  i32 3, label %case3
  ]
case0:
  br label %return
case1:
  br label %return
case2:
  br label %return
case3:
  br label %return
default:
  br label %return
return:
  %p = phi ptr [ @a, %case0 ], [ @a, %case1 ], [ @a, %case2 ], [ @a, %case3 ], [ null, %default ]
  %linear = phi i32 [ 3, %case0 ], [ 6, %case1 ], [ 9, %case2 ], [ 12, %case3 ], [ -1, %default ]
  %bitmap = phi i8 [ 3, %case0 ], [ 2, %case1 ], [ 1, %case2 ], [ 2, %case3 ], [ 0, %default ]
  %table = phi i32 [ 1234, %case0 ], [ 5678, %case1 ], [ 15532, %case2 ], [ 8910, %case3 ], [ -1, %default ]
  call void @use(ptr %p, i32 %linear, i8 %bitmap, i32 %table)
  ret void
}
