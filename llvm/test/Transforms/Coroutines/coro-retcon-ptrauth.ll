; A signed prototype makes CoroSplit sign each continuation function with the
; same schema. The address-discriminator marker 1 stands for the address of the
; coroutine storage, which is passed to the ramp and to every continuation
; function, whether or not the frame fits in it.

declare void @prototype_once(ptr, i1)
declare ptr @prototype_many(ptr, i1)
declare noalias ptr @allocate(i32)
declare void @deallocate(ptr)
declare void @use(i64)

; Yield-once, frame inline in the storage.
define ptr @once_stack(ptr %buffer, i64 %n) presplitcoroutine {
entry:
  %id = call token @llvm.coro.id.retcon.once(i32 8, i32 8, ptr %buffer, ptr ptrauth (ptr @prototype_once, i32 0, i64 3909, ptr inttoptr (i64 1 to ptr)), ptr @allocate, ptr @deallocate)
  %hdl = call ptr @llvm.coro.begin(token %id, ptr null)
  %unwind = call i1 (...) @llvm.coro.suspend.retcon.i1()
  br i1 %unwind, label %cleanup, label %resume

resume:
  call void @use(i64 %n)
  br label %cleanup

cleanup:
  call void @llvm.coro.end(ptr %hdl, i1 false, token none)
  unreachable
}

