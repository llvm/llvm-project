; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; Check that pointers into the promise that are created before coro.begin and
; used after it are recreated from the frame. SROA can produce such pointers
; when it unfolds a gep of a phi of constant indices.
; RUN: opt < %s -passes='cgscc(coro-split),simplifycfg,early-cse' -S | FileCheck %s

%promise_type = type { [64 x i8] }

define ptr @f(i1 %c) presplitcoroutine {
; CHECK-LABEL: define ptr @f(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[__PROMISE:%.*]] = alloca [[PROMISE_TYPE:%.*]], align 64
; CHECK-NEXT:    [[ID:%.*]] = call token @llvm.coro.id(i32 0, ptr null, ptr @f, ptr @f.resumers)
; CHECK-NEXT:    [[NEED_ALLOC:%.*]] = call i1 @llvm.coro.alloc(token [[ID]])
; CHECK-NEXT:    br i1 [[NEED_ALLOC]], label %[[DYN_ALLOC:.*]], label %[[CORO_BEGIN:.*]]
; CHECK:       [[DYN_ALLOC]]:
; CHECK-NEXT:    [[ALLOC:%.*]] = call ptr @malloc(i32 128)
; CHECK-NEXT:    br label %[[CORO_BEGIN]]
; CHECK:       [[CORO_BEGIN]]:
; CHECK-NEXT:    [[MEM:%.*]] = phi ptr [ [[ALLOC]], %[[DYN_ALLOC]] ], [ null, %[[ENTRY]] ]
; CHECK-NEXT:    [[HDL:%.*]] = call noalias nonnull ptr @llvm.coro.begin(token [[ID]], ptr [[MEM]])
; CHECK-NEXT:    store ptr @f.resume, ptr [[HDL]], align 8
; CHECK-NEXT:    [[TMP0:%.*]] = select i1 [[NEED_ALLOC]], ptr @f.destroy, ptr @f.cleanup
; CHECK-NEXT:    [[DESTROY_ADDR:%.*]] = getelementptr inbounds i8, ptr [[HDL]], i64 8
; CHECK-NEXT:    store ptr [[TMP0]], ptr [[DESTROY_ADDR]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i8, ptr [[HDL]], i64 64
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 64 [[TMP1]], ptr align 64 [[__PROMISE]], i64 64, i1 false)
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr inbounds i8, ptr [[TMP1]], i64 32
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i8, ptr [[TMP1]], i64 16
; CHECK-NEXT:    br i1 [[C]], label %[[STORE:.*]], label %[[STORE_FROM_B:.*]]
; CHECK:       [[STORE_FROM_B]]:
; CHECK-NEXT:    br label %[[STORE]]
; CHECK:       [[STORE]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[TMP2]], %[[STORE_FROM_B]] ], [ [[TMP3]], %[[CORO_BEGIN]] ]
; CHECK-NEXT:    store i32 1, ptr [[P]], align 4
; CHECK-NEXT:    [[INDEX_ADDR1:%.*]] = getelementptr inbounds i8, ptr [[HDL]], i64 16
; CHECK-NEXT:    store i1 false, ptr [[INDEX_ADDR1]], align 1
; CHECK-NEXT:    ret ptr [[HDL]]
;
entry:
  %__promise = alloca %promise_type, align 64
  %id = call token @llvm.coro.id(i32 0, ptr %__promise, ptr @f, ptr null)
  %need.alloc = call i1 @llvm.coro.alloc(token %id)
  %gep.a = getelementptr inbounds i8, ptr %__promise, i64 16
  %gep.b = getelementptr inbounds i8, ptr %__promise, i64 32
  br i1 %need.alloc, label %dyn.alloc, label %coro.begin

dyn.alloc:
  %size = call i32 @llvm.coro.size.i32()
  %alloc = call ptr @malloc(i32 %size)
  br label %coro.begin

coro.begin:
  %mem = phi ptr [ null, %entry ], [ %alloc, %dyn.alloc ]
  %hdl = call ptr @llvm.coro.begin(token %id, ptr %mem)
  br i1 %c, label %a, label %b

a:
  br label %store

b:
  br label %store

store:
  %p = phi ptr [ %gep.a, %a ], [ %gep.b, %b ]
  store i32 1, ptr %p, align 4
  %0 = call i8 @llvm.coro.suspend(token none, i1 false)
  switch i8 %0, label %suspend [i8 0, label %resume
  i8 1, label %cleanup]
resume:
  call void @consume(ptr %__promise)
  br label %cleanup

cleanup:
  %free.mem = call ptr @llvm.coro.free(token %id, ptr %hdl)
  call void @free(ptr %free.mem)
  br label %suspend

suspend:
  call void @llvm.coro.end(ptr %hdl, i1 false, token none)
  ret ptr %hdl
}

declare token @llvm.coro.id(i32, ptr, ptr, ptr)
declare i1 @llvm.coro.alloc(token)
declare i32 @llvm.coro.size.i32()
declare ptr @llvm.coro.begin(token, ptr)
declare i8 @llvm.coro.suspend(token, i1)
declare ptr @llvm.coro.free(token, ptr)
declare void @llvm.coro.end(ptr, i1, token)
declare noalias ptr @malloc(i32)
declare void @free(ptr)
declare void @consume(ptr)
