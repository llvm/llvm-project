define void @no_pred_prof(ptr %p, i32 %n, i32 %cond) !prof !14 {
; CHECK-LABEL: define void @no_pred_prof(
; CHECK-SAME: ptr [[P:%.*]], i32 [[N:%.*]], i32 [[COND:%.*]]) !prof [[PROF14:![0-9]+]] {
