; CHECK:       [[PH]]:
; CHECK-NEXT:    [[HCMP1:%.*]] = icmp sge i32 0, [[N]]
; CHECK-NEXT:    br i1 [[HCMP1]], label %[[EXIT:.*]], label %[[BODY_LR_PH:.*]], !prof [[PROF15:![0-9]+]]
; CHECK:       [[BODY_LR_PH]]:
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[IV2:%.*]] = phi i32 [ 0, %[[BODY_LR_PH]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[ADDR:%.*]] = getelementptr i32, ptr [[P]], i32 [[IV2]]
; CHECK-NEXT:    store i32 [[IV2]], ptr [[ADDR]], align 4
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV2]], 1
; CHECK-NEXT:    [[HCMP:%.*]] = icmp sge i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[HCMP]], label %[[HEADER_EXIT_CRIT_EDGE:.*]], label %[[BODY]], !prof [[PROF15]]
; CHECK:       [[HEADER_EXIT_CRIT_EDGE]]:
