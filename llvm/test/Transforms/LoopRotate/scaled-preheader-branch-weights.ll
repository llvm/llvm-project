entry:
  br i1 %c, label %ph, label %ret, !prof !1

ph:
  br label %header

header:
  %iv = phi i32 [ 0, %ph ], [ %next, %body ]
  %cmp = icmp slt i32 %iv, %n
  br i1 %cmp, label %body, label %exit, !prof !2

body:
  store volatile i32 %iv, ptr %p, align 4
  %next = add i32 %iv, 1
