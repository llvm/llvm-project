; Before. Entry count 100. Labels are absolute counts.
; [latch] branches back to [header].
;
;                      +------------------------+
;                      v                        |
; [entry] --100--> [header] --120--> [latch]----+
;                     |                 |
;                    40                60
;                     v                 v
;                 [exit.a]          [exit.b]
;
; header = 100 + 60 = 160
; header->latch = 160 * 3/4 = 120
; header->exit.a = 160 * 1/4 = 40
; latch->header = latch->exit.b = 120 * 1/2 = 60
;
; After. Both exits go through [guard]. The back edge stays.
; In: 40 + 60 = 100. Out: 40 + 60 = 100.
; 40 is header->exit.a. 60 is latch->exit.b.
;
;                      +------------------------+
;                      v                        |
; [entry] --100--> [header] --120--> [latch]----+
;                     |                 |
;                    40                60
;                     +--------+--------+
;                              v
;                          [guard] --40--> [exit.a]
;                             |
;                            60
;                             v
;                         [exit.b]
define void @weights(i1 %PredHeader, i1 %PredLatch) !prof !2 {
; CHECK-LABEL: define void @weights(
; CHECK-SAME: i1 [[PREDHEADER:%.*]], i1 [[PREDLATCH:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    br i1 [[PREDHEADER]], label %[[LATCH:.*]], label %[[LOOP_EXIT_GUARD:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    br i1 [[PREDLATCH]], label %[[HEADER]], label %[[LOOP_EXIT_GUARD]], !prof [[PROF2:![0-9]+]]
; CHECK:       [[EXIT_A:.*]]:
; CHECK-NEXT:    ret void
; CHECK:       [[EXIT_B:.*]]:
; CHECK-NEXT:    ret void
; CHECK:       [[LOOP_EXIT_GUARD]]:
; CHECK-NEXT:    [[GUARD_EXIT_A:%.*]] = phi i1 [ true, %[[HEADER]] ], [ false, %[[LATCH]] ]
; CHECK-NEXT:    br i1 [[GUARD_EXIT_A]], label %[[EXIT_A]], label %[[EXIT_B]], !prof [[PROF3:![0-9]+]]
;
entry:
  br label %header

header:
  br i1 %PredHeader, label %latch, label %exit.a, !prof !0

latch:
  br i1 %PredLatch, label %header, label %exit.b, !prof !1

exit.a:
  ret void

exit.b:
  ret void
}

