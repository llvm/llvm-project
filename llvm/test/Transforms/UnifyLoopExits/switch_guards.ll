; CHECK:       [[LOOP_EXIT_GUARD]]:
; CHECK-NEXT:    [[GUARD_EXIT1:%.*]] = phi i1 [ true, %[[A]] ], [ false, %[[B]] ]
; CHECK-NEXT:    br i1 [[GUARD_EXIT1]], label %[[EXIT1]], label %[[EXIT2]]
;
entry:
  br label %A

A:
  %valA = phi i32 [ 0, %entry ], [ %inc, %B ]
  br i1 %PredA, label %Exit1, label %B

B:
  %inc = add i32 %valA, 1
  br i1 %PredB, label %Exit2, label %A

Exit1:
  call void @use(i32 1)
  ret void

Exit2:
  call void @use(i32 2)
  ret void
}
