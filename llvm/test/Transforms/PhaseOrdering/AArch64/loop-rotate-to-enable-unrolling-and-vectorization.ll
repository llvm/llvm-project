; CHECK-NEXT:    br i1 [[TMP11]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP5:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N_VEC]], [[TMP2]]
; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT]], label %[[LOOP_BODY_PREHEADER]]
; CHECK:       [[LOOP_BODY_PREHEADER]]:
; CHECK-NEXT:    [[INDVARS_IV5_PH:%.*]] = phi i64 [ [[TMP0]], %[[LOOP_BODY_LR_PH]] ], [ [[TMP3]], %[[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    br label %[[LOOP_BODY:.*]]
; CHECK:       [[VECTOR_EARLY_EXIT]]:
; CHECK-NEXT:    [[FIRST_ACTIVE_LANE:%.*]] = tail call i64 @llvm.experimental.cttz.elts.i64.v16i1(<16 x i1> [[TMP9]], i1 false)
; CHECK-NEXT:    [[TMP12:%.*]] = extractelement <16 x i64> [[TMP5]], i64 [[FIRST_ACTIVE_LANE]]
