; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    [[INDVARS_IV5:%.*]] = phi i64 [ [[INDVARS_IV_NEXT]], %[[LOOP_HEADER]] ], [ [[INDVARS_IV5_PH]], %[[LOOP_BODY_PREHEADER]] ]
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nsw i64 [[INDVARS_IV5]], -1
; CHECK-NEXT:    [[IV_EXT:%.*]] = and i64 [[INDVARS_IV_NEXT]], 4294967295
; CHECK-NEXT:    [[NOTMASK:%.*]] = shl nsw i64 -1, [[IV_EXT]]
; CHECK-NEXT:    [[TMP14:%.*]] = or i64 [[NOTMASK]], [[SAT]]
; CHECK-NEXT:    [[FOUND:%.*]] = icmp eq i64 [[TMP14]], -1
; CHECK-NEXT:    br i1 [[FOUND]], label %[[EXIT_SPLIT_LOOP_EXIT]], label %[[LOOP_HEADER]]
; CHECK:       [[EXIT_SPLIT_LOOP_EXIT]]:
; CHECK-NEXT:    [[INDVARS_IV_NEXT_LCSSA:%.*]] = phi i64 [ [[TMP12]], %[[VECTOR_EARLY_EXIT]] ], [ [[INDVARS_IV_NEXT]], %[[LOOP_BODY]] ]
; CHECK-NEXT:    [[INDVARS_LE:%.*]] = trunc i64 [[INDVARS_IV_NEXT_LCSSA]] to i32
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ [[INDVARS_LE]], %[[EXIT_SPLIT_LOOP_EXIT]] ], [ 0, %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ], [ 0, %[[LOOP_HEADER]] ]
; CHECK-NEXT:    ret i32 [[RES]]
