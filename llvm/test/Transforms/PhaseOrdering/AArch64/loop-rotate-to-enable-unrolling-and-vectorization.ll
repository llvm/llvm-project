; CHECK-NEXT:    [[TMP7:%.*]] = shl nsw <16 x i64> splat (i64 -1), [[TMP6]]
; CHECK-NEXT:    [[TMP8:%.*]] = or <16 x i64> [[TMP7]], [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[DOTFR:%.*]] = freeze <16 x i64> [[TMP8]]
; CHECK-NEXT:    [[TMP9:%.*]] = icmp eq <16 x i64> [[DOTFR]], splat (i64 -1)
; CHECK-NEXT:    [[TMP10:%.*]] = bitcast <16 x i1> [[TMP9]] to i16
; CHECK-NEXT:    [[DOTNOT:%.*]] = icmp eq i16 [[TMP10]], 0
; CHECK-NEXT:    br i1 [[DOTNOT]], label %[[VECTOR_BODY_INTERIM]], label %[[VECTOR_EARLY_EXIT:.*]]
; CHECK:       [[VECTOR_BODY_INTERIM]]:
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nsw <16 x i64> [[VEC_IND]], splat (i64 -16)
