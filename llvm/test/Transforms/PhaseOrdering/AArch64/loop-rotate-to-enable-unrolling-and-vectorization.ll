entry:
  %start = add nsw i32 %n, -1
  br label %loop.header

loop.header:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
  %cmp = icmp sgt i32 %iv, 0
  br i1 %cmp, label %loop.body, label %exit

loop.body:
  %iv.ext = zext nneg i32 %iv to i64
  %shl = shl nuw i64 1, %iv.ext
  %mask = add i64 %shl, -1
  %and = and i64 %sat, %mask
  %found = icmp eq i64 %and, %mask
  br i1 %found, label %exit, label %loop.latch

loop.latch:
  %iv.next = add nsw i32 %iv, -1
  br label %loop.header

exit:
  %res = phi i32 [ 0, %loop.header ], [ %iv, %loop.body ]
  ret i32 %res
}
