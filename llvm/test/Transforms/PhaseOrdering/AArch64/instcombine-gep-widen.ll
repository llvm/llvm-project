; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -O2 -S                   | FileCheck %s
; RUN: opt < %s -passes="default<O2>" -S | FileCheck %s

; A bounds-checked little-endian i32 store lowered to four byte stores. The
; index i+3 feeds both the bounds check and the last store, so it is multi-use.
; InstCombine relaxing the single-use requirement on GEP(p, add(x, C)) for a
; constant C lets the four stores share one base GEP with constant offsets, so
; they widen to a single i32 store.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "aarch64-unknown-linux-gnu"

define void @store_le32(ptr %a, i64 %i, i64 %n, i32 %v) {
; CHECK-LABEL: define void @store_le32(
; CHECK-SAME: ptr nofree writeonly captures(none) [[A:%.*]], i64 [[I:%.*]], i64 [[N:%.*]], i32 [[V:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[I3:%.*]] = add nsw i64 [[I]], 3
; CHECK-NEXT:    [[OOB_NOT:%.*]] = icmp ult i64 [[I3]], [[N]]
; CHECK-NEXT:    br i1 [[OOB_NOT]], label %[[OK:.*]], label %[[TRAP:.*]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    tail call void @llvm.trap()
; CHECK-NEXT:    unreachable
; CHECK:       [[OK]]:
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    store i32 [[V]], ptr [[P0]], align 1
; CHECK-NEXT:    ret void
;
entry:
  %i3 = add nsw i64 %i, 3          ; <-- MULTI-USE temp: bounds check + %p3 GEP
  %oob = icmp uge i64 %i3, %n      ; use #1 of %i3 (the bounds check)
  br i1 %oob, label %trap, label %ok

trap:
  tail call void @llvm.trap()
  unreachable

ok:
  %p0 = getelementptr inbounds i8, ptr %a, i64 %i
  %b0 = trunc i32 %v to i8
  store i8 %b0, ptr %p0, align 1
  %i1 = add nsw i64 %i, 1          ; single-use: GEP fold works even pre-patch
  %p1 = getelementptr inbounds i8, ptr %a, i64 %i1
  %v1 = lshr i32 %v, 8
  %b1 = trunc i32 %v1 to i8
  store i8 %b1, ptr %p1, align 1
  %i2 = add nsw i64 %i, 2
  %p2 = getelementptr inbounds i8, ptr %a, i64 %i2
  %v2 = lshr i32 %v, 16
  %b2 = trunc i32 %v2 to i8
  store i8 %b2, ptr %p2, align 1
  %p3 = getelementptr inbounds i8, ptr %a, i64 %i3   ; use #2 of %i3
  %v3 = lshr i32 %v, 24
  %b3 = trunc i32 %v3 to i8
  store i8 %b3, ptr %p3, align 1
  ret void
}

declare void @llvm.trap()
