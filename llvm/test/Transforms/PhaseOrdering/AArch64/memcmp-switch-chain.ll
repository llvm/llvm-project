; CHECK-NEXT:      i64 7, label %[[SV_EQ_EXIT42:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[SV_EQ_EXIT]]:
; CHECK-NEXT:    [[A_DATA_I_I:%.*]] = load ptr, ptr [[S]], align 8
; CHECK-NEXT:    [[TMP0:%.*]] = load i64, ptr [[A_DATA_I_I]], align 1
; CHECK-NEXT:    [[TMP1:%.*]] = xor i64 [[TMP0]], 8386103224169493108
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[A_DATA_I_I]], i64 3
; CHECK-NEXT:    [[TMP3:%.*]] = load i64, ptr [[TMP2]], align 1
; CHECK-NEXT:    [[TMP4:%.*]] = xor i64 [[TMP3]], 7957695015158575982
; CHECK-NEXT:    [[TMP5:%.*]] = or i64 [[TMP1]], [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ne i64 [[TMP5]], 0
; CHECK-NEXT:    [[TMP7:%.*]] = zext i1 [[TMP6]] to i32
; CHECK-NEXT:    [[SPEC_SELECT51:%.*]] = sext i1 [[TMP6]] to i32
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[SV_EQ_EXIT14]]:
; CHECK-NEXT:    [[A_DATA_I_I10_PRE:%.*]] = load ptr, ptr [[S]], align 8
; CHECK-NEXT:    [[TMP8:%.*]] = load i64, ptr [[A_DATA_I_I10_PRE]], align 1
