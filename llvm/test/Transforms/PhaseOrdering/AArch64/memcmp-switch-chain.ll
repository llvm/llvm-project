; CHECK-NEXT:    [[TMP19:%.*]] = zext i1 [[TMP18]] to i32
; CHECK-NEXT:    [[EQ_I27:%.*]] = icmp eq i32 [[TMP19]], 0
; CHECK-NEXT:    [[SPEC_SELECT53:%.*]] = select i1 [[EQ_I27]], i32 2, i32 -1
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[SV_EQ_EXIT42]]:
; CHECK-NEXT:    [[A_DATA_I_I38_PRE:%.*]] = load ptr, ptr [[S]], align 8
; CHECK-NEXT:    [[TMP20:%.*]] = load i32, ptr [[A_DATA_I_I38_PRE]], align 1
; CHECK-NEXT:    [[TMP21:%.*]] = xor i32 [[TMP20]], 1734960503
; CHECK-NEXT:    [[TMP22:%.*]] = getelementptr i8, ptr [[A_DATA_I_I38_PRE]], i64 3
; CHECK-NEXT:    [[TMP23:%.*]] = load i32, ptr [[TMP22]], align 1
; CHECK-NEXT:    [[TMP24:%.*]] = xor i32 [[TMP23]], 1937008743
; CHECK-NEXT:    [[TMP25:%.*]] = or i32 [[TMP21]], [[TMP24]]
