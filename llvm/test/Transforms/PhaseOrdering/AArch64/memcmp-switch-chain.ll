; string_view(const char *s): data = s, size = strlen(s)
define linkonce_odr void @sv_from_cstr(ptr %out, ptr %str) {
  %len = call i64 @strlen(ptr %str)
  store ptr %str, ptr %out
  %size.addr = getelementptr inbounds %sv, ptr %out, i32 0, i32 1
  store i64 %len, ptr %size.addr
  ret void
}

; operator==(a, b): a.size() == b.size() && a.compare(b) == 0
define linkonce_odr i1 @sv_eq(ptr %a, ptr %b) {
entry:
  %a.size.addr = getelementptr inbounds %sv, ptr %a, i32 0, i32 1
  %a.size = load i64, ptr %a.size.addr
  %b.size.addr = getelementptr inbounds %sv, ptr %b, i32 0, i32 1
  %b.size = load i64, ptr %b.size.addr
  %same.size = icmp eq i64 %a.size, %b.size
  br i1 %same.size, label %compare, label %ret.false

compare:
  %c = call i32 @sv_compare(ptr %a, ptr %b)
  %eq = icmp eq i32 %c, 0
  ret i1 %eq

ret.false:
  ret i1 false
}

; a.compare(b), called only when the sizes match: memcmp(a.data, b.data, a.size)
define linkonce_odr i32 @sv_compare(ptr %a, ptr %b) {
  %a.data = load ptr, ptr %a
  %b.data = load ptr, ptr %b
  %a.size.addr = getelementptr inbounds %sv, ptr %a, i32 0, i32 1
  %a.size = load i64, ptr %a.size.addr
  %r = call i32 @memcmp(ptr %a.data, ptr %b.data, i64 %a.size)
  ret i32 %r
}

declare i64 @strlen(ptr)
declare i32 @memcmp(ptr, ptr, i64)
