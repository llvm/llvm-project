  %is0 = call i1 @sv_eq(ptr %s, ptr %lit0)
  br i1 %is0, label %ret0, label %check1

check1:
  call void @sv_from_cstr(ptr %lit1, ptr @.str.rotation)
  %is1 = call i1 @sv_eq(ptr %s, ptr %lit1)
  br i1 %is1, label %ret1, label %check2

check2:
  call void @sv_from_cstr(ptr %lit2, ptr @.str.scale)
  %is2 = call i1 @sv_eq(ptr %s, ptr %lit2)
  br i1 %is2, label %ret2, label %check3

check3:
  call void @sv_from_cstr(ptr %lit3, ptr @.str.weights)
  %is3 = call i1 @sv_eq(ptr %s, ptr %lit3)
  br i1 %is3, label %ret3, label %ret.none

ret0:
  ret i32 0
ret1:
