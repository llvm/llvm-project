; CHECK-NEXT:    [[TMP10:%.*]] = zext i1 [[TMP9]] to i32
; CHECK-NEXT:    [[EQ_I13:%.*]] = icmp eq i32 [[TMP10]], 0
; CHECK-NEXT:    [[SPEC_SELECT52:%.*]] = select i1 [[EQ_I13]], i32 1, i32 -1
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[SV_EQ_EXIT28]]:
; CHECK-NEXT:    [[A_DATA_I_I24_PRE:%.*]] = load ptr, ptr [[S]], align 8
; CHECK-NEXT:    [[TMP11:%.*]] = load i32, ptr [[A_DATA_I_I24_PRE]], align 1
; CHECK-NEXT:    [[TMP12:%.*]] = xor i32 [[TMP11]], 1818321779
; CHECK-NEXT:    [[TMP13:%.*]] = getelementptr i8, ptr [[A_DATA_I_I24_PRE]], i64 4
; CHECK-NEXT:    [[TMP14:%.*]] = load i8, ptr [[TMP13]], align 1
; CHECK-NEXT:    [[TMP15:%.*]] = zext i8 [[TMP14]] to i32
; CHECK-NEXT:    [[TMP16:%.*]] = xor i32 [[TMP15]], 101
; CHECK-NEXT:    [[TMP17:%.*]] = or i32 [[TMP12]], [[TMP16]]
