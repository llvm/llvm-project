; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A_SIZE_ADDR_I:%.*]] = getelementptr inbounds nuw i8, ptr [[S]], i64 8
; CHECK-NEXT:    [[A_SIZE_I:%.*]] = load i64, ptr [[A_SIZE_ADDR_I]], align 8
; CHECK-NEXT:    switch i64 [[A_SIZE_I]], label %[[COMMON_RET:.*]] [
; CHECK-NEXT:      i64 11, label %[[SV_EQ_EXIT:.*]]
; CHECK-NEXT:      i64 8, label %[[SV_EQ_EXIT14:.*]]
