; A std::string_view if-chain against literals, with the libc++ helpers
; reduced to their essentials:
;   if (s == "translation") return 0;
;   else if (s == "rotation") return 1;
;   else if (s == "scale") return 2;
;   else if (s == "weights") return 3;
;   return -1;
; SimplifyCFG turns the size checks into one switch on s.size(). Each case's
; memcmp must get that case's size as a constant so it can be expanded,
; instead of staying a library call with the runtime size.

%sv = type { ptr, i64 }

@.str.translation = private constant [12 x i8] c"translation\00"
@.str.rotation = private constant [9 x i8] c"rotation\00"
@.str.scale = private constant [6 x i8] c"scale\00"
@.str.weights = private constant [8 x i8] c"weights\00"

define i32 @chain(ptr %s) {
