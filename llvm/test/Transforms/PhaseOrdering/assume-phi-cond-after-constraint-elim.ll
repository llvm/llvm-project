; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -O3 -S %s | FileCheck %s

; The condition %cmp1 feeding the assume via %phi must be preserved by
; ConstraintElimination, so that %cmp2 can be folded to false after GVN
; forwards the stored value and the call to @do_reserve_and_handle is removed.
; See https://github.com/llvm/llvm-project/issues/213782.

declare void @do_reserve_and_handle()

define void @should_reserve_once(ptr noalias nocapture align 8 %v, i64 %len) {
; CHECK-LABEL: @should_reserve_once(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[INIT_CAP:%.*]] = load i64, ptr [[V:%.*]], align 8
; CHECK-NEXT:    [[INIT_AVAIL:%.*]] = sub i64 [[INIT_CAP]], [[LEN:%.*]]
; CHECK-NEXT:    [[NEED_GROW:%.*]] = icmp ult i64 [[INIT_AVAIL]], 3
; CHECK-NEXT:    br i1 [[NEED_GROW]], label [[JOIN:%.*]], label [[EXIT:%.*]]
; CHECK:       join:
; CHECK-NEXT:    [[TMP0:%.*]] = tail call i64 @llvm.umax.i64(i64 [[LEN]], i64 5)
; CHECK-NEXT:    [[NEW_CAP:%.*]] = add nuw i64 [[TMP0]], 3
; CHECK-NEXT:    store i64 [[NEW_CAP]], ptr [[V]], align 8
; CHECK-NEXT:    [[SUB1:%.*]] = sub i64 [[NEW_CAP]], [[LEN]]
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ugt i64 [[SUB1]], 2
; CHECK-NEXT:    tail call void @llvm.assume(i1 [[CMP1]])
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %init_cap = load i64, ptr %v, align 8
  %init_avail = sub i64 %init_cap, %len
  %need_grow = icmp ult i64 %init_avail, 3
  br i1 %need_grow, label %grow, label %join

grow:
  %len_plus_3 = add nuw i64 %len, 3
  %new_cap = tail call i64 @llvm.umax.i64(i64 %len_plus_3, i64 8)
  store i64 %new_cap, ptr %v, align 8
  %sub1 = sub i64 %new_cap, %len
  %cmp1 = icmp ugt i64 %sub1, 2
  br label %join

join:
  %phi = phi i1 [ true, %entry ], [ %cmp1, %grow ]
  tail call void @llvm.assume(i1 %phi)
  %loaded_cap = load i64, ptr %v, align 8
  %sub2 = sub i64 %loaded_cap, %len
  %cmp2 = icmp ult i64 %sub2, 3
  br i1 %cmp2, label %fail, label %exit

fail:
  tail call void @do_reserve_and_handle()
  br label %exit

exit:
  ret void
}
