; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[R]], i64 [[I2]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[GEP]], align 8
