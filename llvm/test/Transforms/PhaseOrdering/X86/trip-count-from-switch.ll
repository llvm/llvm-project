; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='default<O2>' -S %s | FileCheck %s

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

; The loop runs once or twice: the checks on n become a switch, whose default
; edge bounds the trip count, so the loop is fully unrolled, not vectorized.
; https://github.com/llvm/llvm-project/issues/235778
;
; void f(unsigned long *r, unsigned x) {
;   unsigned long n = x & 3;
;   if (n == 0)
;     return a();
;   if (n == 1)
;     return b();
;   for (unsigned long i = 0; i < n - 1; ++i)
;     r[i] += 1;
; }
define void @f(ptr noundef %r, i32 noundef %x) #0 {
; CHECK-LABEL: define void @f(
; CHECK-SAME: ptr nofree noundef captures(none) [[R:%.*]], i32 noundef [[X:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[AND:%.*]] = and i32 [[X]], 3
; CHECK-NEXT:    switch i32 [[AND]], label %[[LOOP_PREHEADER:.*]] [
; CHECK-NEXT:      i32 0, label %[[CALL_A:.*]]
; CHECK-NEXT:      i32 1, label %[[CALL_B:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[CALL_A]]:
; CHECK-NEXT:    tail call void @a()
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[CALL_B]]:
; CHECK-NEXT:    tail call void @b()
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[V1:%.*]] = load i64, ptr [[R]], align 8
; CHECK-NEXT:    [[V_INC1:%.*]] = add i64 [[V1]], 1
; CHECK-NEXT:    store i64 [[V_INC1]], ptr [[R]], align 8
; CHECK-NEXT:    [[EXITCOND_NOT:%.*]] = icmp eq i32 [[AND]], 2
; CHECK-NEXT:    br i1 [[EXITCOND_NOT]], label %[[EXIT]], label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw i8, ptr [[R]], i64 8
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[GEP]], align 8
; CHECK-NEXT:    [[V_INC:%.*]] = add i64 [[V]], 1
; CHECK-NEXT:    store i64 [[V_INC]], ptr [[GEP]], align 8
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %and = and i32 %x, 3
  %n = zext i32 %and to i64
  %is.0 = icmp eq i64 %n, 0
  br i1 %is.0, label %call.a, label %check.1

call.a:
  call void @a()
  br label %exit

check.1:
  %is.1 = icmp eq i64 %n, 1
  br i1 %is.1, label %call.b, label %loop

call.b:
  call void @b()
  br label %exit

loop:
  %i = phi i64 [ 0, %check.1 ], [ %i.next, %body ]
  %m = sub i64 %n, 1
  %cmp = icmp ult i64 %i, %m
  br i1 %cmp, label %body, label %exit

body:
  %gep = getelementptr inbounds nuw i64, ptr %r, i64 %i
  %v = load i64, ptr %gep, align 8
  %v.inc = add i64 %v, 1
  store i64 %v.inc, ptr %gep, align 8
  %i.next = add i64 %i, 1
  br label %loop

exit:
  ret void
}

declare void @a()
declare void @b()

attributes #0 = { "target-cpu"="x86-64" }
