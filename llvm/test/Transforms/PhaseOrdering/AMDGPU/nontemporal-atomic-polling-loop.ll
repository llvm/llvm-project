; Monotonic nontemporal atomic loads in polling loops are not hoisted, narrowed
; or combined by the optimization pipeline, and keep their !nontemporal hint.

define i32 @poll_word(ptr addrspace(1) %p, i32 %flag) {
; CHECK-LABEL: define i32 @poll_word(
; CHECK-SAME: ptr addrspace(1) nofree captures(none) [[P:%.*]], i32 [[FLAG:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[V:%.*]] = load atomic i64, ptr addrspace(1) [[P]] syncscope("wavefront") monotonic, align 8, !nontemporal [[META0:![0-9]+]]
; CHECK-NEXT:    [[HI64:%.*]] = lshr i64 [[V]], 32
; CHECK-NEXT:    [[HI:%.*]] = trunc nuw i64 [[HI64]] to i32
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[FLAG]], [[HI]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[LO:%.*]] = trunc i64 [[V]] to i32
; CHECK-NEXT:    ret i32 [[LO]]
;
entry:
  br label %loop

loop:
  %v = load atomic i64, ptr addrspace(1) %p syncscope("wavefront") monotonic, align 8, !nontemporal !0
  %hi64 = lshr i64 %v, 32
  %hi = trunc i64 %hi64 to i32
  %done = icmp eq i32 %hi, %flag
  br i1 %done, label %exit, label %loop

exit:
  %lo = trunc i64 %v to i32
  ret i32 %lo
}

