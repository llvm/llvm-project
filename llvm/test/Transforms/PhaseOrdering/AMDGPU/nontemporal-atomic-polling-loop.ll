loop:
  %d0 = load atomic i64, ptr addrspace(1) %datap syncscope("wavefront") monotonic, align 8, !nontemporal !0
  %f = load atomic i64, ptr addrspace(1) %flagp syncscope("wavefront") monotonic, align 8, !nontemporal !0
  %done = icmp eq i64 %f, %flag
  br i1 %done, label %exit, label %loop

exit:
  %d1 = load atomic i64, ptr addrspace(1) %datap syncscope("wavefront") monotonic, align 8, !nontemporal !0
