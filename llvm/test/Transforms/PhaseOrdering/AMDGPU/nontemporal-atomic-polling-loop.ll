; The word is spilled through a union-like local and read back in halves, as
; in source that uses a union to split data and flag. The atomic load stays a
; single 8-byte load.
define i32 @split_through_local(ptr addrspace(1) %p, i32 %flag) {
; CHECK-LABEL: define i32 @split_through_local(
; CHECK-SAME: ptr addrspace(1) nofree captures(none) [[P:%.*]], i32 [[FLAG:%.*]]) local_unnamed_addr #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[V:%.*]] = load atomic i64, ptr addrspace(1) [[P]] syncscope("wavefront") monotonic, align 8, !nontemporal [[META0]]
; CHECK-NEXT:    [[U_SROA_2_0_EXTRACT_SHIFT:%.*]] = lshr i64 [[V]], 32
; CHECK-NEXT:    [[U_SROA_2_0_EXTRACT_TRUNC:%.*]] = trunc nuw i64 [[U_SROA_2_0_EXTRACT_SHIFT]] to i32
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[FLAG]], [[U_SROA_2_0_EXTRACT_TRUNC]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[U_SROA_0_0_EXTRACT_TRUNC:%.*]] = trunc i64 [[V]] to i32
; CHECK-NEXT:    ret i32 [[U_SROA_0_0_EXTRACT_TRUNC]]
;
entry:
  %u = alloca i64, align 8, addrspace(5)
  %u.hi = getelementptr inbounds i8, ptr addrspace(5) %u, i32 4
  br label %loop

loop:
  %v = load atomic i64, ptr addrspace(1) %p syncscope("wavefront") monotonic, align 8, !nontemporal !0
  store i64 %v, ptr addrspace(5) %u, align 8
  %hi = load i32, ptr addrspace(5) %u.hi, align 4
  %done = icmp eq i32 %hi, %flag
  br i1 %done, label %exit, label %loop

exit:
  %lo = load i32, ptr addrspace(5) %u, align 8
  ret i32 %lo
}

; After the flags are seen, the line is loaded again. The second load of the
; same address is not replaced by the first.
