; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[D0:%.*]] = load atomic i64, ptr addrspace(1) [[DATAP]] syncscope("wavefront") monotonic, align 8, !nontemporal [[META0]]
; CHECK-NEXT:    [[F:%.*]] = load atomic i64, ptr addrspace(1) [[FLAGP]] syncscope("wavefront") monotonic, align 8, !nontemporal [[META0]]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[F]], [[FLAG]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[D1:%.*]] = load atomic i64, ptr addrspace(1) [[DATAP]] syncscope("wavefront") monotonic, align 8, !nontemporal [[META0]]
; CHECK-NEXT:    [[R:%.*]] = add i64 [[D1]], [[D0]]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
