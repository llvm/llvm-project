; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=tailcallelim -verify-dom-info -S | FileCheck %s

; A load of the byval argument after the self-call must see the caller's value,
; so the copy of the next iteration's value into the argument has to come after
; it.

%S = type { i32, i32 }

@g = global %S { i32 7, i32 0 }

define i32 @f(ptr byval(%S) align 4 %p, i32 %n) {
; CHECK-LABEL: define i32 @f(
; CHECK-SAME: ptr byval([[S:%.*]]) align 4 [[P:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[G:%.*]] = alloca [[S]], align 1
; CHECK-NEXT:    br label %[[TAILRECURSE:.*]]
; CHECK:       [[TAILRECURSE]]:
; CHECK-NEXT:    [[ACCUMULATOR_TR:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[S:%.*]], %[[REC:.*]] ]
; CHECK-NEXT:    [[N_TR:%.*]] = phi i32 [ [[N]], %[[ENTRY]] ], [ 0, %[[REC]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[N_TR]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[BASE:.*]], label %[[REC]]
; CHECK:       [[BASE]]:
; CHECK-NEXT:    [[BV:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[ACCUMULATOR_RET_TR:%.*]] = add i32 [[ACCUMULATOR_TR]], [[BV]]
; CHECK-NEXT:    ret i32 [[ACCUMULATOR_RET_TR]]
; CHECK:       [[REC]]:
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 1 [[G]], ptr align 1 @g, i64 8, i1 false)
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[S]] = add i32 [[ACCUMULATOR_TR]], [[V]]
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 1 [[P]], ptr align 1 [[G]], i64 8, i1 false)
; CHECK-NEXT:    br label %[[TAILRECURSE]]
;
entry:
  %c = icmp eq i32 %n, 0
  br i1 %c, label %base, label %rec

base:
  %bv = load i32, ptr %p, align 4
  ret i32 %bv

rec:
  %r = call i32 @f(ptr byval(%S) @g, i32 0)
  %v = load i32, ptr %p, align 4
  %s = add i32 %r, %v
  ret i32 %s
}

; The trailing load goes through a GEP of the byval argument.
define i32 @f_gep(ptr byval(%S) align 4 %p, i32 %n) {
; CHECK-LABEL: define i32 @f_gep(
; CHECK-SAME: ptr byval([[S:%.*]]) align 4 [[P:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[G:%.*]] = alloca [[S]], align 1
; CHECK-NEXT:    br label %[[TAILRECURSE:.*]]
; CHECK:       [[TAILRECURSE]]:
; CHECK-NEXT:    [[ACCUMULATOR_TR:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[S:%.*]], %[[REC:.*]] ]
; CHECK-NEXT:    [[N_TR:%.*]] = phi i32 [ [[N]], %[[ENTRY]] ], [ 0, %[[REC]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[N_TR]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[BASE:.*]], label %[[REC]]
; CHECK:       [[BASE]]:
; CHECK-NEXT:    [[BV:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[ACCUMULATOR_RET_TR:%.*]] = add i32 [[ACCUMULATOR_TR]], [[BV]]
; CHECK-NEXT:    ret i32 [[ACCUMULATOR_RET_TR]]
; CHECK:       [[REC]]:
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 1 [[G]], ptr align 1 @g, i64 8, i1 false)
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 4
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[S]] = add i32 [[ACCUMULATOR_TR]], [[V]]
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 1 [[P]], ptr align 1 [[G]], i64 8, i1 false)
; CHECK-NEXT:    br label %[[TAILRECURSE]]
;
entry:
  %c = icmp eq i32 %n, 0
  br i1 %c, label %base, label %rec

base:
  %bv = load i32, ptr %p, align 4
  ret i32 %bv

rec:
  %r = call i32 @f_gep(ptr byval(%S) @g, i32 0)
  %gep = getelementptr inbounds i8, ptr %p, i64 4
  %v = load i32, ptr %gep, align 4
  %s = add i32 %r, %v
  ret i32 %s
}
