; Kinds cannot be combined. Here the fmul's only user is the fneg rather than a
; return, and in general combining needs the involution to distribute over the
; binary op -- true for fneg over fmul, false over fadd.
define float @test_involution_fneg_after_accumulator(float %x) {
; CHECK-LABEL: define float @test_involution_fneg_after_accumulator(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[ISNEG:%.*]] = fcmp olt float [[X]], 1.000000e+00
; CHECK-NEXT:    br i1 [[ISNEG]], label %[[REC:.*]], label %[[BASE:.*]]
; CHECK:       [[REC]]:
; CHECK-NEXT:    [[XM:%.*]] = fadd float [[X]], -1.000000e+00
; CHECK-NEXT:    [[R:%.*]] = tail call float @test_involution_fneg_after_accumulator(float [[XM]])
; CHECK-NEXT:    [[M:%.*]] = fmul reassoc float [[R]], [[X]]
; CHECK-NEXT:    [[MN:%.*]] = fneg float [[M]]
; CHECK-NEXT:    ret float [[MN]]
; CHECK:       [[BASE]]:
; CHECK-NEXT:    ret float 1.000000e+00
;
entry:
  %isneg = fcmp olt float %x, 1.000000e+00
  br i1 %isneg, label %rec, label %base

rec:
  %xm = fadd float %x, -1.000000e+00
  %r = call float @test_involution_fneg_after_accumulator(float %xm)
  %m = fmul reassoc float %r, %x
  %mn = fneg float %m
  ret float %mn

base:
  ret float 1.000000e+00
}

