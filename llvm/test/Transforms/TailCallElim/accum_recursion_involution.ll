; CHECK:       [[DISCARD]]:
; CHECK-NEXT:    [[XS]] = fmul float [[X_TR]], 5.000000e-01
; CHECK-NEXT:    [[ACCUMULATOR_RET_TR:%.*]] = select i1 [[PARITY_TR]], float -0.000000e+00, float 0.000000e+00
; CHECK-NEXT:    [[CURRENT_RET_TR]] = select i1 [[RET_KNOWN_TR]], float [[RET_TR]], float [[ACCUMULATOR_RET_TR]]
; CHECK-NEXT:    br label %[[TAILRECURSE]]
