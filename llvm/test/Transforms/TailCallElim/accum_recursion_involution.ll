; CHECK:       [[TAILRECURSE]]:
; CHECK-NEXT:    [[PARITY_TR:%.*]] = phi i1 [ [[PARITY_TR]], %[[DISCARD:.*]] ], [ false, %[[ENTRY]] ], [ [[PARITY_FLIP_TR:%.*]], %[[NEG:.*]] ]
; CHECK-NEXT:    [[X_TR:%.*]] = phi float [ [[X]], %[[ENTRY]] ], [ [[XS:%.*]], %[[DISCARD]] ], [ [[NX:%.*]], %[[NEG]] ]
; CHECK-NEXT:    [[RET_TR:%.*]] = phi float [ poison, %[[ENTRY]] ], [ [[CURRENT_RET_TR:%.*]], %[[DISCARD]] ], [ [[RET_TR]], %[[NEG]] ]
; CHECK-NEXT:    [[RET_KNOWN_TR:%.*]] = phi i1 [ false, %[[ENTRY]] ], [ true, %[[DISCARD]] ], [ [[RET_KNOWN_TR]], %[[NEG]] ]
; CHECK-NEXT:    [[C0:%.*]] = fcmp ogt float [[X_TR]], 1.000000e+02
