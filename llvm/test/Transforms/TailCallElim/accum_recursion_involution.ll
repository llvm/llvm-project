; "Tail recursion modulo an involution": the operation on the call's result is
; not a binary associative accumulator, so its parity is folded into an i1
; instead. For fneg that needs no reassociation and no fast-math flags.

define float @test_involution_fneg_f32(float %x) {
; CHECK-LABEL: define float @test_involution_fneg_f32(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[TAILRECURSE:.*]]
; CHECK:       [[TAILRECURSE]]:
; CHECK-NEXT:    [[PARITY_TR:%.*]] = phi i1 [ false, %[[ENTRY]] ], [ [[PARITY_FLIP_TR:%.*]], %[[NEG:.*]] ]
; CHECK-NEXT:    [[X_TR:%.*]] = phi float [ [[X]], %[[ENTRY]] ], [ [[NX:%.*]], %[[NEG]] ]
; CHECK-NEXT:    [[ISNEG:%.*]] = fcmp olt float [[X_TR]], 0.000000e+00
; CHECK-NEXT:    br i1 [[ISNEG]], label %[[NEG]], label %[[BASE:.*]]
; CHECK:       [[NEG]]:
; CHECK-NEXT:    [[NX]] = fneg float [[X_TR]]
; CHECK-NEXT:    [[PARITY_FLIP_TR]] = xor i1 [[PARITY_TR]], true
; CHECK-NEXT:    br label %[[TAILRECURSE]]
; CHECK:       [[BASE]]:
; CHECK-NEXT:    [[V:%.*]] = fmul float [[X_TR]], 3.000000e+00
; CHECK-NEXT:    [[INVOLUTION_VAL_TR:%.*]] = fneg float [[V]]
; CHECK-NEXT:    [[ACCUMULATOR_RET_TR:%.*]] = select i1 [[PARITY_TR]], float [[INVOLUTION_VAL_TR]], float [[V]]
; CHECK-NEXT:    ret float [[ACCUMULATOR_RET_TR]]
;
entry:
  %isneg = fcmp olt float %x, 0.000000e+00
  br i1 %isneg, label %neg, label %base

neg:
  %nx = fneg float %x
  %r = call float @test_involution_fneg_f32(float %nx)
  %rn = fneg float %r
  ret float %rn

base:
  %v = fmul float %x, 3.000000e+00
  ret float %v
}

