; A unary accumulator recurrence `f(x) = x == 0 ? Base : g(f(x - 1))` builds a
; chain of applications of a pure unary function `g`, which a loop can compute
; by applying `g` to the accumulator once per iteration. `g` needs to be
; neither associative nor commutative.

declare i32 @pure_g(i32) readnone nounwind willreturn
declare i32 @impure_g(i32)
declare i32 @convergent_g(i32) readnone nounwind willreturn convergent

; Subtraction is neither associative nor commutative:
; int sub_const(int x) {
;   if (x == 0) return 7;
;   return sub_const(x - 1) - 3;
; }
define i32 @test_sub_const(i32 %x) {
; CHECK-LABEL: define i32 @test_sub_const(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[TAILRECURSE:.*]]
; CHECK:       [[TAILRECURSE]]:
; CHECK-NEXT:    [[ACCUMULATOR_TR:%.*]] = phi i32 [ 7, %[[ENTRY]] ], [ [[RES:%.*]], %[[IF_END:.*]] ]
; CHECK-NEXT:    [[X_TR:%.*]] = phi i32 [ [[X]], %[[ENTRY]] ], [ [[SUB:%.*]], %[[IF_END]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[X_TR]], 0
; CHECK-NEXT:    br i1 [[CMP]], label %[[BASE:.*]], label %[[IF_END]]
; CHECK:       [[BASE]]:
; CHECK-NEXT:    ret i32 [[ACCUMULATOR_TR]]
; CHECK:       [[IF_END]]:
; CHECK-NEXT:    [[SUB]] = add nsw i32 [[X_TR]], -1
; CHECK-NEXT:    [[RES]] = sub i32 [[ACCUMULATOR_TR]], 3
; CHECK-NEXT:    br label %[[TAILRECURSE]]
;
entry:
  %cmp = icmp eq i32 %x, 0
  br i1 %cmp, label %base, label %if.end

base:
  ret i32 7

if.end:
  %sub = add nsw i32 %x, -1
  %call = tail call i32 @test_sub_const(i32 %sub)
  %res = sub i32 %call, 3
  ret i32 %res
}

