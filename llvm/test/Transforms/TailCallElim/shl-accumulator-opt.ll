; Negative test: a sibling call site that discards its own recursive call and
; unconditionally returns a fixed constant must still agree with the shift
; accumulator's base case.
; int f(int x) {
;   if (x == 0) return 1;
;   if (x == 3) { f(x - 1); return 2; }
;   return f(x - 1) << 1;
; }
