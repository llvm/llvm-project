define void @pass_frameaddress() {
; CHECK-LABEL: define void @pass_frameaddress() {
; CHECK-NEXT:    [[FA:%.*]] = tail call ptr @llvm.frameaddress.p0(i32 0)
; CHECK-NEXT:    call void @callee(ptr [[FA]])
; CHECK-NEXT:    ret void
;
  %fa = call ptr @llvm.frameaddress.p0(i32 0)
  call void @callee(ptr %fa)
  ret void
}

