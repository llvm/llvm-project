; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[IN_BOUNDS:.*]] ], [ [[A]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[J:%.*]] = phi i32 [ [[J_NEXT:%.*]], %[[IN_BOUNDS]] ], [ [[C]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[ABC:%.*]] = icmp slt i32 [[J]], [[LEN]]
