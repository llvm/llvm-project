  br i1 %abc, label %ok0, label %out.of.bounds, !prof !1

ok0:
  %j1 = add nsw i32 %j, 1
  %abc1 = icmp slt i32 %j1, %len
  br i1 %abc1, label %in.bounds, label %out.of.bounds, !prof !1

in.bounds:
