define void @n_times_start_may_wrap(ptr %arr, ptr %a_len_ptr, i32 %a, i32 %c, i32 %n) {
; CHECK-LABEL: define void @n_times_start_may_wrap(
; CHECK-SAME: ptr [[ARR:%.*]], ptr [[A_LEN_PTR:%.*]], i32 [[A:%.*]], i32 [[C:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LEN:%.*]] = load i32, ptr [[A_LEN_PTR]], align 4, !range [[RNG0]]
; CHECK-NEXT:    [[GUARD:%.*]] = icmp slt i32 [[A]], [[N]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[IN_BOUNDS:.*]] ], [ [[A]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[J:%.*]] = phi i32 [ [[J_NEXT:%.*]], %[[IN_BOUNDS]] ], [ [[C]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[ABC:%.*]] = icmp slt i32 [[J]], [[LEN]]
; CHECK-NEXT:    br i1 [[ABC]], label %[[OK0:.*]], label %[[OUT_OF_BOUNDS:.*]], !prof [[PROF1]]
; CHECK:       [[OK0]]:
; CHECK-NEXT:    [[J1:%.*]] = add nsw i32 [[J]], 1
; CHECK-NEXT:    [[ABC1:%.*]] = icmp slt i32 [[J1]], [[LEN]]
; CHECK-NEXT:    br i1 [[ABC1]], label %[[IN_BOUNDS]], label %[[OUT_OF_BOUNDS]], !prof [[PROF1]]
; CHECK:       [[IN_BOUNDS]]:
; CHECK-NEXT:    [[ADDR:%.*]] = getelementptr i32, ptr [[ARR]], i32 [[I]]
; CHECK-NEXT:    store i32 0, ptr [[ADDR]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[J_NEXT]] = add nsw i32 [[J]], 4
; CHECK-NEXT:    [[NEXT:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[NEXT]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[OUT_OF_BOUNDS]]:
; CHECK-NEXT:    ret void
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %len = load i32, ptr %a_len_ptr, !range !0
  %guard = icmp slt i32 %a, %n
  br i1 %guard, label %loop, label %exit

loop:
  %i = phi i32 [ %a, %entry ], [ %i.next, %in.bounds ]
  %j = phi i32 [ %c, %entry ], [ %j.next, %in.bounds ]
