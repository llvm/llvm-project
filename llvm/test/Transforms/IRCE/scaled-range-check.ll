; CHECK:       [[OK0]]:
; CHECK-NEXT:    [[J1:%.*]] = add nsw i32 [[J]], 1
; CHECK-NEXT:    [[ABC1:%.*]] = icmp slt i32 [[J1]], [[LEN]]
; CHECK-NEXT:    br i1 [[ABC1]], label %[[IN_BOUNDS]], label %[[OUT_OF_BOUNDS]], !prof [[PROF1]]
; CHECK:       [[IN_BOUNDS]]:
; CHECK-NEXT:    [[ADDR:%.*]] = getelementptr i32, ptr [[ARR]], i32 [[I]]
; CHECK-NEXT:    store i32 0, ptr [[ADDR]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[J_NEXT]] = add nsw i32 [[J]], 4
; CHECK-NEXT:    [[NEXT:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
