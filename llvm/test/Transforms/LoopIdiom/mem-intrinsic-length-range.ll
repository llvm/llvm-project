; CHECK-NEXT:    call void @llvm.experimental.memset.pattern.p0.i32.i64(ptr align 4 [[SCEVGEP]], i32 305419896, i64 range(i64 0, 10) [[TMP1]], i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
