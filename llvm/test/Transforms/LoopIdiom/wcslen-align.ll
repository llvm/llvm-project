; Only introduce a `wcslen` call if the argument is known to be aligned to
; `alignof(wchar_t)`.

; Alignment unknown, no `wcslen`.
define i64 @align_unknown(ptr %p) {
; CHECK-LABEL: define i64 @align_unknown(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[INC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[INC]] = add i64 [[I]], 1
; CHECK-NEXT:    [[P_I:%.*]] = getelementptr i32, ptr [[P]], i64 [[I]]
; CHECK-NEXT:    [[CH:%.*]] = load i32, ptr [[P_I]], align 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[CH]], 0
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[I_LCSSA:%.*]] = phi i64 [ [[I]], %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[I_LCSSA]]
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %loop ]
  %inc = add i64 %i, 1
  %p_i = getelementptr i32, ptr %p, i64 %i
  %ch = load i32, ptr %p_i, align 1
  %cmp = icmp eq i32 %ch, 0
  br i1 %cmp, label %exit, label %loop

exit:
  ret i64 %i
}

