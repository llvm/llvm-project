; RUN: opt -passes=loop-idiom -mtriple=x86_64-unknown-linux-gnu -mattr=+popcnt -S < %s | FileCheck %s

; The trip count of the loop is the popcount of %x. These tests cover counters
; that are too narrow to hold it, or that only hold it as an unsigned value.

; An i1 counter cannot hold the popcount of an i32.
define i32 @i1_counter(i32 %x) {
; CHECK-LABEL: define i32 @i1_counter(
; CHECK-SAME: i32 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.ctpop.i32(i32 [[X]])
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[TMP0]] to i1
; CHECK-NEXT:    [[TMP2:%.*]] = icmp ne i1 [[TMP1]], false
; CHECK-NEXT:    br i1 [[TMP2]], label %[[PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[TCPHI:%.*]] = phi i1 [ [[TMP1]], %[[PREHEADER]] ], [ [[TCDEC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[X_CUR:%.*]] = phi i32 [ [[X]], %[[PREHEADER]] ], [ [[X_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CNT:%.*]] = phi i1 [ false, %[[PREHEADER]] ], [ [[CNT_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ITERS:%.*]] = phi i32 [ 0, %[[PREHEADER]] ], [ [[ITERS_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CNT_NEXT]] = add i1 [[CNT]], true
; CHECK-NEXT:    [[ITERS_NEXT]] = add i32 [[ITERS]], 1
; CHECK-NEXT:    [[X_DEC:%.*]] = add i32 [[X_CUR]], -1
; CHECK-NEXT:    [[X_NEXT]] = and i32 [[X_CUR]], [[X_DEC]]
; CHECK-NEXT:    [[TCDEC]] = sub nsw i1 [[TCPHI]], true
; CHECK-NEXT:    [[AGAIN:%.*]] = icmp ugt i1 [[TCDEC]], false
; CHECK-NEXT:    br i1 [[AGAIN]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[CNT_NEXT_LCSSA:%.*]] = phi i1 [ [[TMP1]], %[[LOOP]] ]
; CHECK-NEXT:    [[ITERS_NEXT_LCSSA:%.*]] = phi i32 [ [[ITERS_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[CNT_OUT:%.*]] = phi i1 [ false, %[[ENTRY]] ], [ [[CNT_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    [[ITERS_OUT:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ITERS_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[ITERS_OUT]]
;
entry:
  %nonzero = icmp ne i32 %x, 0
  br i1 %nonzero, label %preheader, label %exit

preheader:
  br label %loop

loop:
  %x.cur = phi i32 [ %x, %preheader ], [ %x.next, %loop ]
  %cnt = phi i1 [ 0, %preheader ], [ %cnt.next, %loop ]
  %iters = phi i32 [ 0, %preheader ], [ %iters.next, %loop ]
  %cnt.next = add i1 %cnt, 1
  %iters.next = add i32 %iters, 1
  %x.dec = add i32 %x.cur, -1
  %x.next = and i32 %x.cur, %x.dec
  %again = icmp ne i32 %x.next, 0
  br i1 %again, label %loop, label %exit

exit:
  %cnt.out = phi i1 [ 0, %entry ], [ %cnt.next, %loop ]
  %iters.out = phi i32 [ 0, %entry ], [ %iters.next, %loop ]
  ret i32 %iters.out
}

; The popcount of an i128 is at most 128, which fits an i8 only as an unsigned
; value. The latch exits on true here.
define i32 @i8_counter_i128(i128 %x) {
; CHECK-LABEL: define i32 @i8_counter_i128(
; CHECK-SAME: i128 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i128 @llvm.ctpop.i128(i128 [[X]])
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i128 [[TMP0]] to i8
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i8 [[TMP1]], 0
; CHECK-NEXT:    br i1 [[TMP2]], label %[[EXIT:.*]], label %[[PREHEADER:.*]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[TCPHI:%.*]] = phi i8 [ [[TMP1]], %[[PREHEADER]] ], [ [[TCDEC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[X_CUR:%.*]] = phi i128 [ [[X]], %[[PREHEADER]] ], [ [[X_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CNT:%.*]] = phi i8 [ 0, %[[PREHEADER]] ], [ [[CNT_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ITERS:%.*]] = phi i32 [ 0, %[[PREHEADER]] ], [ [[ITERS_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CNT_NEXT]] = add i8 [[CNT]], 1
; CHECK-NEXT:    [[ITERS_NEXT]] = add i32 [[ITERS]], 1
; CHECK-NEXT:    [[X_DEC:%.*]] = add i128 [[X_CUR]], -1
; CHECK-NEXT:    [[X_NEXT]] = and i128 [[X_CUR]], [[X_DEC]]
; CHECK-NEXT:    [[TCDEC]] = sub nsw i8 [[TCPHI]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp sle i8 [[TCDEC]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[CNT_LCSSA:%.*]] = phi i8 [ [[TMP1]], %[[LOOP]] ]
; CHECK-NEXT:    [[ITERS_LCSSA:%.*]] = phi i32 [ [[ITERS_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[CNT_OUT:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[CNT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    [[ITERS_OUT:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ITERS_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    [[CNT_EXT:%.*]] = zext i8 [[CNT_OUT]] to i32
; CHECK-NEXT:    [[RES:%.*]] = add i32 [[ITERS_OUT]], [[CNT_EXT]]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  %iszero = icmp eq i128 %x, 0
  br i1 %iszero, label %exit, label %preheader

preheader:
  br label %loop

loop:
  %x.cur = phi i128 [ %x, %preheader ], [ %x.next, %loop ]
  %cnt = phi i8 [ 0, %preheader ], [ %cnt.next, %loop ]
  %iters = phi i32 [ 0, %preheader ], [ %iters.next, %loop ]
  %cnt.next = add i8 %cnt, 1
  %iters.next = add i32 %iters, 1
  %x.dec = add i128 %x.cur, -1
  %x.next = and i128 %x.cur, %x.dec
  %done = icmp eq i128 %x.next, 0
  br i1 %done, label %exit.loopexit, label %loop

exit.loopexit:
  %cnt.lcssa = phi i8 [ %cnt.next, %loop ]
  %iters.lcssa = phi i32 [ %iters.next, %loop ]
  br label %exit

exit:
  %cnt.out = phi i8 [ 0, %entry ], [ %cnt.lcssa, %exit.loopexit ]
  %iters.out = phi i32 [ 0, %entry ], [ %iters.lcssa, %exit.loopexit ]
  %cnt.ext = zext i8 %cnt.out to i32
  %res = add i32 %iters.out, %cnt.ext
  ret i32 %res
}

; The popcount of an i256 is at most 256, which does not fit an i8 at all.
