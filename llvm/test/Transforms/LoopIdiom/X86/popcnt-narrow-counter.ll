; CHECK-NEXT:    [[TMP1:%.*]] = trunc i256 [[TMP0]] to i8
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i8 [[TMP1]], 0
; CHECK-NEXT:    br i1 [[TMP2]], label %[[EXIT:.*]], label %[[PREHEADER:.*]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[TCPHI:%.*]] = phi i8 [ [[TMP1]], %[[PREHEADER]] ], [ [[TCDEC:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[X_CUR:%.*]] = phi i256 [ [[X]], %[[PREHEADER]] ], [ [[X_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CNT:%.*]] = phi i8 [ 0, %[[PREHEADER]] ], [ [[CNT_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CNT_NEXT]] = add i8 [[CNT]], 1
; CHECK-NEXT:    [[V:%.*]] = load volatile i32, ptr [[P]], align 4
; CHECK-NEXT:    [[V_INC:%.*]] = add i32 [[V]], 1
; CHECK-NEXT:    store volatile i32 [[V_INC]], ptr [[P]], align 4
; CHECK-NEXT:    [[X_DEC:%.*]] = add i256 [[X_CUR]], -1
; CHECK-NEXT:    [[X_NEXT]] = and i256 [[X_CUR]], [[X_DEC]]
; CHECK-NEXT:    [[TCDEC]] = sub nsw i8 [[TCPHI]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp sle i8 [[TCDEC]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[CNT_LCSSA:%.*]] = phi i8 [ [[TMP1]], %[[LOOP]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[CNT_OUT:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[CNT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i8 [[CNT_OUT]]
;
entry:
  %iszero = icmp eq i256 %x, 0
  br i1 %iszero, label %exit, label %preheader

preheader:
  br label %loop

loop:
  %x.cur = phi i256 [ %x, %preheader ], [ %x.next, %loop ]
  %cnt = phi i8 [ 0, %preheader ], [ %cnt.next, %loop ]
  %cnt.next = add i8 %cnt, 1
  %v = load volatile i32, ptr %p, align 4
  %v.inc = add i32 %v, 1
  store volatile i32 %v.inc, ptr %p, align 4
  %x.dec = add i256 %x.cur, -1
  %x.next = and i256 %x.cur, %x.dec
