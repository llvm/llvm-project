; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=loop-idiom -S < %s | FileCheck %s

; With 16-bit pointers, the length is an i16, which can be narrower than the
; induction variable and than the cap on the range.
target datalayout = "e-p:16:16-i64:64-n16:32-S16"

; void i64_iv_bounded(int *p, unsigned long long start) {
;   for (unsigned long long i = start; i < 4; ++i)
;     p[i] = -1;
; }
;
; TODO: should be range(i16 0, 17) once SCEV uses loop guards.

define void @i64_iv_bounded(ptr %p, i64 %start) {
; CHECK-LABEL: define void @i64_iv_bounded(
; CHECK-SAME: ptr [[P:%.*]], i64 [[START:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult i64 [[START]], 4
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i64 [[START]] to i16
; CHECK-NEXT:    [[TMP1:%.*]] = shl i16 [[TMP0]], 2
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[P]], i16 [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = sub i16 16, [[TMP1]]
; CHECK-NEXT:    call void @llvm.memset.p0.i16(ptr align 4 [[SCEVGEP]], i8 -1, i16 range(i16 0, 21) [[TMP2]], i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[I_NEXT:%.*]], %[[LOOP]] ], [ [[START]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[I]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], 4
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp ult i64 %start, 4
  br i1 %guard, label %loop, label %exit

loop:
  %i = phi i64 [ %start, %entry ], [ %i.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %i
  store i32 -1, ptr %gep, align 4
  %i.next = add nuw nsw i64 %i, 1
  %cmp = icmp ult i64 %i.next, 4
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; The max length is 65534, so the exclusive end of the range, 65535, still fits
; in the i16 length.

define void @range_end_fits(ptr %p, i16 %start) {
; CHECK-LABEL: define void @range_end_fits(
; CHECK-SAME: ptr [[P:%.*]], i16 [[START:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[P]], i16 [[START]]
; CHECK-NEXT:    [[TMP0:%.*]] = add nuw i16 [[START]], 1
; CHECK-NEXT:    [[UMAX:%.*]] = call i16 @llvm.umax.i16(i16 [[TMP0]], i16 -2)
; CHECK-NEXT:    [[TMP1:%.*]] = sub i16 [[UMAX]], [[START]]
; CHECK-NEXT:    call void @llvm.memset.p0.i16(ptr align 1 [[SCEVGEP]], i8 0, i16 range(i16 0, -1) [[TMP1]], i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i16 [ [[START]], %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P]], i16 [[I]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i16 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i16 [[I_NEXT]], -2
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i16 [ %start, %entry ], [ %i.next, %loop ]
  %gep = getelementptr inbounds i8, ptr %p, i16 %i
  store i8 0, ptr %gep, align 1
  %i.next = add nuw i16 %i, 1
  %cmp = icmp ult i16 %i.next, 65534
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; The max length is 65536, within the cap, but it doesn't fit in the i16
; length, so no range is added.

define void @range_end_too_large(ptr %p, i16 %start) {
; CHECK-LABEL: define void @range_end_too_large(
; CHECK-SAME: ptr [[P:%.*]], i16 [[START:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[P]], i16 [[START]]
; CHECK-NEXT:    [[TMP0:%.*]] = sub i16 -1, [[START]]
; CHECK-NEXT:    call void @llvm.memset.p0.i16(ptr align 1 [[SCEVGEP]], i8 0, i16 [[TMP0]], i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i16 [ [[START]], %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P]], i16 [[I]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i16 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i16 [[I_NEXT]], -1
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i16 [ %start, %entry ], [ %i.next, %loop ]
  %gep = getelementptr inbounds i8, ptr %p, i16 %i
  store i8 0, ptr %gep, align 1
  %i.next = add nuw i16 %i, 1
  %cmp = icmp ult i16 %i.next, 65535
  br i1 %cmp, label %loop, label %exit

exit:
