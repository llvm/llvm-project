; CHECK-NEXT:    [[A:%.*]] = getelementptr inbounds [2 x i8], ptr [[P]], i64 [[I]], i64 0
; CHECK-NEXT:    [[B:%.*]] = getelementptr inbounds [2 x i8], ptr [[P]], i64 [[I]], i64 1
; CHECK-NEXT:    store i8 poison, ptr [[A]], align 1
; CHECK-NEXT:    store i8 1, ptr [[B]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ne i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %a = getelementptr inbounds [2 x i8], ptr %p, i64 %i, i64 0
  %b = getelementptr inbounds [2 x i8], ptr %p, i64 %i, i64 1
  store i8 poison, ptr %a
  store i8 1, ptr %b
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp ne i64 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

