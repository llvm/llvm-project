; CHECK-NEXT:    [[TMP2:%.*]] = phi i64 [ [[TMP3:%.*]], %[[LOOP]] ], [ [[X]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[COUNT:%.*]] = phi i64 [ [[COUNT_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[TMP3]] = lshr i64 [[TMP2]], 1
; CHECK-NEXT:    [[COUNT_NEXT]] = add i64 [[COUNT]], 1
