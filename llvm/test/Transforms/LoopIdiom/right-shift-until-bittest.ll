; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "cttz|lshr|br i1|loop.ivcheck" --version 6
; RUN: opt -passes='loop-simplify,loop-idiom' -S %s | FileCheck %s

; The low bit and zero checks guarantee that the loop finds a set bit.
define i64 @trailing_zeros(i64 %x) {
; CHECK-LABEL: define i64 @trailing_zeros(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK:    br i1 [[IS_ZERO:%.*]], [[ZERO:label %.*]], [[CHECK:label %.*]]
; CHECK:    br i1 [[IS_EVEN:%.*]], [[LOOP_PREHEADER:label %.*]], [[ODD:label %.*]]
; CHECK:    [[TMP0:%.*]] = lshr i64 [[X]], 1
; CHECK:    [[TMP1:%.*]] = call i64 @llvm.cttz.i64(i64 [[TMP0]], i1 true)
; CHECK:    [[X_CURR:%.*]] = lshr exact i64 [[X]], [[TMP1]]
; CHECK:    [[X_NEXT:%.*]] = lshr exact i64 [[X_CURR]], 1
; CHECK:    [[TMP3:%.*]] = lshr exact i64 [[TMP2:%.*]], 1
; CHECK:    [[LOOP_IVCHECK:%.*]] = icmp eq i64 [[LOOP_IV_NEXT:%.*]], [[LOOP_TRIPCOUNT:%.*]]
; CHECK:    br i1 [[LOOP_IVCHECK]], [[DONE:label %.*]], [[LOOP:label %.*]]
;
entry:
  %is.zero = icmp eq i64 %x, 0
  br i1 %is.zero, label %zero, label %check

check:
  %low = and i64 %x, 1
  %is.even = icmp eq i64 %low, 0
  br i1 %is.even, label %loop, label %odd

loop:
  %x.curr = phi i64 [ %x, %check ], [ %x.next, %loop ]
  %count = phi i64 [ 1, %check ], [ %count.next, %loop ]
  %x.next = lshr exact i64 %x.curr, 1
  %count.next = add nuw i64 %count, 1
  %bit = and i64 %x.curr, 2
  %continue = icmp eq i64 %bit, 0
  br i1 %continue, label %loop, label %done

done:
  %result = phi i64 [ %count, %loop ]
  ret i64 %result

odd:
  ret i64 0

zero:
  ret i64 64
}

; Without the nonzero precondition, the loop does not terminate for x = 0.
define i64 @may_loop_forever(i64 %x) {
; CHECK-LABEL: define i64 @may_loop_forever(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK:    [[X_NEXT:%.*]] = lshr i64 [[X_CURR:%.*]], 1
; CHECK:    br i1 [[CONTINUE:%.*]], [[LOOP:label %.*]], [[DONE:label %.*]]
;
entry:
  br label %loop

loop:
  %x.curr = phi i64 [ %x, %entry ], [ %x.next, %loop ]
  %count = phi i64 [ 0, %entry ], [ %count.next, %loop ]
  %x.next = lshr i64 %x.curr, 1
  %count.next = add i64 %count, 1
  %bit = and i64 %x.curr, 1
  %continue = icmp eq i64 %bit, 0
  br i1 %continue, label %loop, label %done

done:
  %result = phi i64 [ %count, %loop ]
  ret i64 %result
}

; Nonzero is insufficient when the tested bit is above a lower set bit.
; For x = 1, the loop can never set bit 1.
define i64 @nonzero_but_lower_bit_set(i64 %x) {
; CHECK-LABEL: define i64 @nonzero_but_lower_bit_set(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK:    br i1 [[IS_ZERO:%.*]], [[ZERO:label %.*]], [[LOOP_PREHEADER:label %.*]]
; CHECK:    [[X_NEXT:%.*]] = lshr i64 [[X_CURR:%.*]], 1
; CHECK:    br i1 [[CONTINUE:%.*]], [[LOOP:label %.*]], [[DONE:label %.*]]
;
entry:
  %is.zero = icmp eq i64 %x, 0
  br i1 %is.zero, label %zero, label %loop

loop:
  %x.curr = phi i64 [ %x, %entry ], [ %x.next, %loop ]
  %count = phi i64 [ 1, %entry ], [ %count.next, %loop ]
  %x.next = lshr i64 %x.curr, 1
  %count.next = add i64 %count, 1
  %bit = and i64 %x.curr, 2
  %continue = icmp eq i64 %bit, 0
  br i1 %continue, label %loop, label %done

done:
  ret i64 %count

zero:
  ret i64 64
}
