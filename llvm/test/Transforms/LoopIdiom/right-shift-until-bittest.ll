; The low bit and zero checks guarantee that the loop finds a set bit.
define i64 @trailing_zeros(i64 %x) {
; CHECK-LABEL: define i64 @trailing_zeros(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IS_ZERO:%.*]] = icmp eq i64 [[X]], 0
; CHECK-NEXT:    br i1 [[IS_ZERO]], label %[[ZERO:.*]], label %[[CHECK:.*]]
; CHECK:       [[CHECK]]:
; CHECK-NEXT:    [[LOW:%.*]] = and i64 [[X]], 1
; CHECK-NEXT:    [[IS_EVEN:%.*]] = icmp eq i64 [[LOW]], 0
; CHECK-NEXT:    br i1 [[IS_EVEN]], label %[[LOOP_PREHEADER:.*]], label %[[ODD:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = lshr i64 [[X]], 1
; CHECK-NEXT:    [[TMP1:%.*]] = call i64 @llvm.cttz.i64(i64 [[TMP0]], i1 true)
; CHECK-NEXT:    [[LOOP_TRIPCOUNT:%.*]] = add nuw nsw i64 [[TMP1]], 1
; CHECK-NEXT:    [[X_CURR:%.*]] = lshr exact i64 [[X]], [[TMP1]]
; CHECK-NEXT:    [[X_NEXT:%.*]] = lshr exact i64 [[X_CURR]], 1
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LOOP_IV:%.*]] = phi i64 [ 0, %[[LOOP_PREHEADER]] ], [ [[LOOP_IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP2:%.*]] = phi i64 [ [[TMP3:%.*]], %[[LOOP]] ], [ [[X]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[COUNT:%.*]] = phi i64 [ [[COUNT_NEXT:%.*]], %[[LOOP]] ], [ 1, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[TMP3]] = lshr exact i64 [[TMP2]], 1
; CHECK-NEXT:    [[COUNT_NEXT]] = add nuw i64 [[COUNT]], 1
; CHECK-NEXT:    [[BIT:%.*]] = and i64 [[TMP2]], 2
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp eq i64 [[BIT]], 0
; CHECK-NEXT:    [[LOOP_IV_NEXT]] = add nuw nsw i64 [[LOOP_IV]], 1
; CHECK-NEXT:    [[LOOP_IVCHECK:%.*]] = icmp eq i64 [[LOOP_IV_NEXT]], [[LOOP_TRIPCOUNT]]
; CHECK-NEXT:    br i1 [[LOOP_IVCHECK]], label %[[DONE:.*]], label %[[LOOP]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    [[RESULT:%.*]] = phi i64 [ [[COUNT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[RESULT]]
; CHECK:       [[ODD]]:
; CHECK-NEXT:    ret i64 0
; CHECK:       [[ZERO]]:
; CHECK-NEXT:    ret i64 64
;
entry:
  %is.zero = icmp eq i64 %x, 0
  br i1 %is.zero, label %zero, label %check

check:
  %low = and i64 %x, 1
  %is.even = icmp eq i64 %low, 0
  br i1 %is.even, label %loop, label %odd

loop:
  %x.curr = phi i64 [ %x, %check ], [ %x.next, %loop ]
  %count = phi i64 [ 1, %check ], [ %count.next, %loop ]
  %x.next = lshr exact i64 %x.curr, 1
  %count.next = add nuw i64 %count, 1
  %bit = and i64 %x.curr, 2
  %continue = icmp eq i64 %bit, 0
  br i1 %continue, label %loop, label %done

done:
  %result = phi i64 [ %count, %loop ]
  ret i64 %result

odd:
  ret i64 0

zero:
  ret i64 64
}

; Testing bit zero only requires the input to be nonzero.
