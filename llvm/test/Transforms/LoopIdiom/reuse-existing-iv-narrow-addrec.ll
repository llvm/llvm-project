; Tests for re-using existing induction variables when expanding a narrow AddRec
; of a loop that has a wider canonical induction variable.

declare void @use(i64)

; {3,+,1}<i32> can be expanded as a truncate of the existing i64 %w.
define void @narrow_addrec_wide_iv_exists(ptr %b, i64 %n) {
; CHECK-LABEL: define void @narrow_addrec_wide_iv_exists(
; CHECK-SAME: ptr [[B:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[W:%.*]] = phi i64 [ 3, %[[ENTRY]] ], [ [[W_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i64 [[W]] to i32
; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[TMP0]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = shl nuw nsw i64 [[TMP1]], 2
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP2]]
; CHECK-NEXT:    call void @use(i64 [[W]])
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[SCEVGEP]], i8 0, i64 256, i1 false)
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[K:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[K_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[T:%.*]] = trunc i64 [[W]] to i32
; CHECK-NEXT:    [[T_EXT:%.*]] = zext i32 [[T]] to i64
; CHECK-NEXT:    [[IDX:%.*]] = add i64 [[T_EXT]], [[K]]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i32, ptr [[B]], i64 [[IDX]]
; CHECK-NEXT:    [[K_NEXT]] = add nuw nsw i64 [[K]], 1
; CHECK-NEXT:    [[EC_INNER:%.*]] = icmp eq i64 [[K_NEXT]], 64
; CHECK-NEXT:    br i1 [[EC_INNER]], label %[[OUTER_LATCH]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[W_NEXT]] = add i64 [[W]], 1
; CHECK-NEXT:    [[EC_OUTER:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC_OUTER]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %w = phi i64 [ 3, %entry ], [ %w.next, %outer.latch ]
  call void @use(i64 %w)
  br label %inner

inner:
  %k = phi i64 [ 0, %outer ], [ %k.next, %inner ]
  %t = trunc i64 %w to i32
  %t.ext = zext i32 %t to i64
  %idx = add i64 %t.ext, %k
  %gep = getelementptr i32, ptr %b, i64 %idx
  store i32 0, ptr %gep, align 4
  %k.next = add nuw nsw i64 %k, 1
  %ec.inner = icmp eq i64 %k.next, 64
  br i1 %ec.inner, label %outer.latch, label %inner

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %w.next = add i64 %w, 1
  %ec.outer = icmp eq i64 %i.next, %n
  br i1 %ec.outer, label %exit, label %outer

exit:
  ret void
}

