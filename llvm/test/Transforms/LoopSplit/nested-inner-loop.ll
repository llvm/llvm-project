; RUN: opt -passes=loop-split-utils -loop-split-points=4 -S < %s | FileCheck %s

; Split the inner loop of a nest. The blocks the transform creates after the
; loop (the merged final exit, and each later partition's guard and exit) land
; inside the containing loop, so LoopInfo has to be told about them. The
; nested-loop.ll case splits the outer loop, where there is no parent to update.

define i64 @split_inner(ptr %a, i64 %n, i64 %m) {
; CHECK-LABEL: define i64 @split_inner(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[SMAX:%.*]] = call i64 @llvm.smax.i64(i64 [[M]], i64 1)
; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i64 [[SMAX]], -1
; CHECK-NEXT:    [[SMIN:%.*]] = call i64 @llvm.smin.i64(i64 [[TMP0]], i64 3)
; CHECK-NEXT:    br label %[[LS_GUARD0:.*]]
; CHECK:       [[LS_GUARD0]]:
; CHECK-NEXT:    [[O:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[O_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT4:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[ITR_CHK:%.*]] = icmp sle i64 0, [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK]], label %[[OUTER:.*]], label %[[LS_GUARD1:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[I_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ [[ACC]], %[[OUTER]] ], [ [[SUM_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 4
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[V]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[ITR_CHK1:%.*]] = icmp sle i64 [[I_NEXT]], [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK1]], label %[[INNER]], label %[[INNER_EXIT:.*]]
; CHECK:       [[INNER_EXIT]]:
; CHECK-NEXT:    br label %[[LS_GUARD1]]
; CHECK:       [[LS_GUARD1]]:
; CHECK-NEXT:    [[SUM_NEXT5:%.*]] = phi i64 [ [[SUM_NEXT]], %[[INNER_EXIT]] ], [ [[ACC]], %[[LS_GUARD0]] ]
; CHECK-NEXT:    [[ITR_CHK2:%.*]] = icmp sle i64 4, [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK2]], label %[[OUTER_LS1:.*]], label %[[LS_FINAL_EXIT:.*]]
; CHECK:       [[OUTER_LS1]]:
; CHECK-NEXT:    br label %[[INNER_LS1:.*]]
; CHECK:       [[INNER_LS1]]:
; CHECK-NEXT:    [[I_LS1:%.*]] = phi i64 [ 4, %[[OUTER_LS1]] ], [ [[I_NEXT_LS1:%.*]], %[[INNER_LS1]] ]
; CHECK-NEXT:    [[SUM_LS1:%.*]] = phi i64 [ [[SUM_NEXT5]], %[[OUTER_LS1]] ], [ [[SUM_NEXT_LS1:%.*]], %[[INNER_LS1]] ]
; CHECK-NEXT:    [[P_LS1:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[I_LS1]]
; CHECK-NEXT:    [[V_LS1:%.*]] = load i64, ptr [[P_LS1]], align 4
; CHECK-NEXT:    [[SUM_NEXT_LS1]] = add i64 [[SUM_LS1]], [[V_LS1]]
; CHECK-NEXT:    [[I_NEXT_LS1]] = add nuw nsw i64 [[I_LS1]], 1
; CHECK-NEXT:    [[ITR_CHK3:%.*]] = icmp sle i64 [[I_NEXT_LS1]], [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK3]], label %[[INNER_LS1]], label %[[LS_EXIT1:.*]]
; CHECK:       [[LS_EXIT1]]:
; CHECK-NEXT:    br label %[[LS_FINAL_EXIT]]
; CHECK:       [[LS_FINAL_EXIT]]:
; CHECK-NEXT:    [[SUM_NEXT4]] = phi i64 [ [[SUM_NEXT_LS1]], %[[LS_EXIT1]] ], [ [[SUM_NEXT5]], %[[LS_GUARD1]] ]
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[O_NEXT]] = add nuw nsw i64 [[O]], 1
; CHECK-NEXT:    [[OC:%.*]] = icmp slt i64 [[O_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OC]], label %[[LS_GUARD0]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[SUM_NEXT4]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br label %outer

outer:
  %o = phi i64 [ 0, %entry ], [ %o.next, %outer.latch ]
  %acc = phi i64 [ 0, %entry ], [ %acc.next, %outer.latch ]
  br label %inner

inner:
  %i = phi i64 [ 0, %outer ], [ %i.next, %inner ]
  %sum = phi i64 [ %acc, %outer ], [ %sum.next, %inner ]
  %p = getelementptr inbounds i64, ptr %a, i64 %i
  %v = load i64, ptr %p
  %sum.next = add i64 %sum, %v
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp slt i64 %i.next, %m
  br i1 %c, label %inner, label %inner.exit

inner.exit:
  %acc.next = phi i64 [ %sum.next, %inner ]
  br label %outer.latch

outer.latch:
  %o.next = add nuw nsw i64 %o, 1
  %oc = icmp slt i64 %o.next, %n
  br i1 %oc, label %outer, label %exit

exit:
  %r = phi i64 [ %acc.next, %outer.latch ]
  ret i64 %r
}
