; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=loop-split-utils -loop-split-points=50 -S < %s | FileCheck %s

; The live-out value is defined outside the loop and also has a use before the
; loop. Such a value is identical in every partition, so it must not be rebuilt
; per-partition; in particular the pre-loop use must not be rewritten to poison.

define i64 @outside_def_live_out(ptr %a, i64 %n, i64 %x) {
; CHECK-LABEL: define i64 @outside_def_live_out(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]], i64 [[X:%.*]]) {
; CHECK-NEXT:  [[LS_GUARD0:.*:]]
; CHECK-NEXT:    [[PRE:%.*]] = add i64 [[X]], 7
; CHECK-NEXT:    store i64 [[PRE]], ptr [[A]], align 4
; CHECK-NEXT:    [[SMAX:%.*]] = call i64 @llvm.smax.i64(i64 [[N]], i64 1)
; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i64 [[SMAX]], -1
; CHECK-NEXT:    [[SMIN:%.*]] = call i64 @llvm.smin.i64(i64 [[TMP0]], i64 49)
; CHECK-NEXT:    [[ITR_CHK:%.*]] = icmp sle i64 0, [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK]], label %[[ENTRY:.*]], label %[[LS_GUARD1:.*]]
; CHECK:       [[ENTRY]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 1
; CHECK-NEXT:    [[ITR_CHK1:%.*]] = icmp sle i64 [[IV_NEXT]], [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK1]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    br label %[[LS_GUARD1]]
; CHECK:       [[LS_GUARD1]]:
; CHECK-NEXT:    [[ITR_CHK2:%.*]] = icmp sle i64 50, [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK2]], label %[[ENTRY_LS1:.*]], label %[[LS_FINAL_EXIT:.*]]
; CHECK:       [[ENTRY_LS1]]:
; CHECK-NEXT:    br label %[[LOOP_LS1:.*]]
; CHECK:       [[LOOP_LS1]]:
; CHECK-NEXT:    [[IV_LS1:%.*]] = phi i64 [ 50, %[[ENTRY_LS1]] ], [ [[IV_NEXT_LS1:%.*]], %[[LOOP_LS1]] ]
; CHECK-NEXT:    [[IV_NEXT_LS1]] = add i64 [[IV_LS1]], 1
; CHECK-NEXT:    [[ITR_CHK3:%.*]] = icmp sle i64 [[IV_NEXT_LS1]], [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK3]], label %[[LOOP_LS1]], label %[[LS_EXIT1:.*]]
; CHECK:       [[LS_EXIT1]]:
; CHECK-NEXT:    br label %[[LS_FINAL_EXIT]]
; CHECK:       [[LS_FINAL_EXIT]]:
; CHECK-NEXT:    ret i64 [[PRE]]
;
entry:
  %pre = add i64 %x, 7
  store i64 %pre, ptr %a
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %iv.next = add i64 %iv, 1
  %ec = icmp slt i64 %iv.next, %n
  br i1 %ec, label %loop, label %exit

exit:
  %lo = phi i64 [ %pre, %loop ]
  ret i64 %lo
}
