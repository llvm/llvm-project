; A latch comparing the step value is rebuilt with an inclusive predicate, so it
; is a tautology if the induction end is the last value of the iteration
; direction: the step wraps past the bound and the test never fails. Splitting
; such a loop would produce a partition that never exits, so it is rejected.

; The induction walks every i8, so the end is 255 and the rebuilt latch would be
; the always-true `icmp ule i8 %iv.next, 255`.
define i64 @ascending_reaches_umax() {
; CHECK-LABEL: define i64 @ascending_reaches_umax() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[IVZ:%.*]] = zext i8 [[IV]] to i64
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[IVZ]]
; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ne i8 [[IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[SUM_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br label %loop

loop:
  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %ivz = zext i8 %iv to i64
  %sum.next = add i64 %sum, %ivz
  %iv.next = add i8 %iv, 1
  %c = icmp ne i8 %iv.next, 0
  br i1 %c, label %loop, label %exit

exit:
  %r = phi i64 [ %sum.next, %loop ]
  ret i64 %r
}

