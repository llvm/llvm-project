; The outer loop has no call that can fail to return, so it has no abnormal
; exits, yet its latch need not run: the inner loop spins forever when %spin is
; true. A poison or undef bound must not reach an entry guard: with poison, a
; hang in the original becomes undefined behavior after the split; with undef,
; the guard can enter a partition the original would not.
define void @inner_cycle_poison_bound(ptr %a, i64 %n, i1 %spin) {
; CHECK-LABEL: define void @inner_cycle_poison_bound(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]], i1 [[SPIN:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    br i1 [[SPIN]], label %[[INNER]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    store i64 [[IV]], ptr [[P]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i64 [[IV]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[OUTER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  br label %inner

inner:
  br i1 %spin, label %inner, label %latch

latch:
  %p = getelementptr inbounds i64, ptr %a, i64 %iv
  store i64 %iv, ptr %p
  %iv.next = add nsw i64 %iv, 1
  %c = icmp slt i64 %iv.next, %n
  br i1 %c, label %outer, label %exit

exit:
  ret void
}

