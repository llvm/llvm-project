; CHECK-NEXT:    store i32 0, ptr [[P]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[ITR_CHK1:%.*]] = icmp sle i32 [[I_NEXT]], [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK1]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[OUT]]:
