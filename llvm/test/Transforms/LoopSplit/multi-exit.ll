; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[BODY:.*]] ]
; CHECK-NEXT:    [[OOB:%.*]] = icmp sge i32 [[I]], [[LEN]]
; CHECK-NEXT:    br i1 [[OOB]], label %[[OUT:.*]], label %[[BODY]]
; CHECK:       [[BODY]]:
