; RUN: opt -passes=loop-split-utils -loop-split-points=50 -S < %s | FileCheck %s

; Partition bounds are the induction end clamped inwards, and a partition runs
; only if `start <= bound` in the iteration ordering. Both assume the induction
; moves monotonically from start to end, so a space that wraps past the type
; extreme on the way is rejected: the entry guard would read the range as empty
; and skip the body.

; %iv visits 255, 0, 1, ... 127, so start (255) is above end (127) unsigned.
define i64 @ascending_wraps_umax(ptr %a) {
; CHECK-LABEL: define i64 @ascending_wraps_umax(
; CHECK-SAME: ptr [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ -1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[A]], i8 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[VZ:%.*]] = zext i8 [[V]] to i64
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[VZ]]
; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ule i8 [[IV_NEXT]], 127
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[SUM_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br label %loop

loop:
  %iv = phi i8 [ 255, %entry ], [ %iv.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %p = getelementptr inbounds i8, ptr %a, i8 %iv
  %v = load i8, ptr %p
  %vz = zext i8 %v to i64
  %sum.next = add i64 %sum, %vz
  %iv.next = add i8 %iv, 1
  %c = icmp ule i8 %iv.next, 127
  br i1 %c, label %loop, label %exit

exit:
  %r = phi i64 [ %sum.next, %loop ]
  ret i64 %r
}

