entry:
  %ok = icmp ult i8 %n, 100
  br i1 %ok, label %ph, label %ret

ph:
  br label %loop

loop:
  %iv = phi i8 [ 0, %ph ], [ %iv.next, %loop ]
  %sum = phi i64 [ 0, %ph ], [ %sum.next, %loop ]
  %p = getelementptr inbounds i8, ptr %a, i8 %iv
