; A dominating condition keeps the start below the end, so this one still
; splits: the check does not simply reject narrow inductions.
define i64 @guarded_ordering_still_splits(ptr %a, i8 %n) {
; CHECK-LABEL: define i64 @guarded_ordering_still_splits(
; CHECK-SAME: ptr [[A:%.*]], i8 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[OK:%.*]] = icmp ult i8 [[N]], 100
; CHECK-NEXT:    br i1 [[OK]], label %[[LS_GUARD0:.*]], label %[[RET:.*]]
; CHECK:       [[LS_GUARD0]]:
; CHECK-NEXT:    [[UMAX:%.*]] = call i8 @llvm.umax.i8(i8 [[N]], i8 1)
; CHECK-NEXT:    [[TMP0:%.*]] = add i8 [[UMAX]], -1
; CHECK-NEXT:    [[UMIN:%.*]] = call i8 @llvm.umin.i8(i8 [[TMP0]], i8 49)
; CHECK-NEXT:    [[ITR_CHK:%.*]] = icmp ule i8 0, [[UMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK]], label %[[PH:.*]], label %[[LS_GUARD1:.*]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 0, %[[PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[A]], i8 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[VZ:%.*]] = zext i8 [[V]] to i64
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[VZ]]
; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
; CHECK-NEXT:    [[ITR_CHK1:%.*]] = icmp ule i8 [[IV_NEXT]], [[UMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK1]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    br label %[[LS_GUARD1]]
; CHECK:       [[LS_GUARD1]]:
; CHECK-NEXT:    [[SUM_NEXT5:%.*]] = phi i64 [ [[SUM_NEXT]], %[[EXIT]] ], [ 0, %[[LS_GUARD0]] ]
; CHECK-NEXT:    [[ITR_CHK2:%.*]] = icmp ule i8 50, [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK2]], label %[[PH_LS1:.*]], label %[[LS_FINAL_EXIT:.*]]
; CHECK:       [[PH_LS1]]:
; CHECK-NEXT:    br label %[[LOOP_LS1:.*]]
; CHECK:       [[LOOP_LS1]]:
; CHECK-NEXT:    [[IV_LS1:%.*]] = phi i8 [ 50, %[[PH_LS1]] ], [ [[IV_NEXT_LS1:%.*]], %[[LOOP_LS1]] ]
; CHECK-NEXT:    [[SUM_LS1:%.*]] = phi i64 [ [[SUM_NEXT5]], %[[PH_LS1]] ], [ [[SUM_NEXT_LS1:%.*]], %[[LOOP_LS1]] ]
; CHECK-NEXT:    [[P_LS1:%.*]] = getelementptr inbounds i8, ptr [[A]], i8 [[IV_LS1]]
; CHECK-NEXT:    [[V_LS1:%.*]] = load i8, ptr [[P_LS1]], align 1
; CHECK-NEXT:    [[VZ_LS1:%.*]] = zext i8 [[V_LS1]] to i64
; CHECK-NEXT:    [[SUM_NEXT_LS1]] = add i64 [[SUM_LS1]], [[VZ_LS1]]
; CHECK-NEXT:    [[IV_NEXT_LS1]] = add i8 [[IV_LS1]], 1
; CHECK-NEXT:    [[ITR_CHK3:%.*]] = icmp ule i8 [[IV_NEXT_LS1]], [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK3]], label %[[LOOP_LS1]], label %[[LS_EXIT1:.*]]
; CHECK:       [[LS_EXIT1]]:
; CHECK-NEXT:    br label %[[LS_FINAL_EXIT]]
; CHECK:       [[LS_FINAL_EXIT]]:
; CHECK-NEXT:    [[SUM_NEXT4:%.*]] = phi i64 [ [[SUM_NEXT_LS1]], %[[LS_EXIT1]] ], [ [[SUM_NEXT5]], %[[LS_GUARD1]] ]
; CHECK-NEXT:    br label %[[RET]]
; CHECK:       [[RET]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT4]], %[[LS_FINAL_EXIT]] ]
; CHECK-NEXT:    ret i64 [[RES]]
