; The same loop given a dedicated exit block: now it splits.
define i64 @dedicated_exit_splits(ptr %a, i64 %n, i1 %skip) {
; CHECK-LABEL: define i64 @dedicated_exit_splits(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]], i1 [[SKIP:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[SKIP]], label %[[EXIT:.*]], label %[[LS_GUARD0:.*]]
; CHECK:       [[LS_GUARD0]]:
; CHECK-NEXT:    [[SMAX:%.*]] = call i64 @llvm.smax.i64(i64 [[N]], i64 1)
; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i64 [[SMAX]], -1
; CHECK-NEXT:    [[SMIN:%.*]] = call i64 @llvm.smin.i64(i64 [[TMP0]], i64 3)
; CHECK-NEXT:    [[ITR_CHK:%.*]] = icmp sle i64 0, [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK]], label %[[PH:.*]], label %[[LS_GUARD1:.*]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 4
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[V]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[ITR_CHK1:%.*]] = icmp sle i64 [[I_NEXT]], [[SMIN]]
; CHECK-NEXT:    br i1 [[ITR_CHK1]], label %[[LOOP]], label %[[LOOPEXIT:.*]]
; CHECK:       [[LOOPEXIT]]:
; CHECK-NEXT:    br label %[[LS_GUARD1]]
; CHECK:       [[LS_GUARD1]]:
; CHECK-NEXT:    [[SUM_NEXT5:%.*]] = phi i64 [ [[SUM_NEXT]], %[[LOOPEXIT]] ], [ 0, %[[LS_GUARD0]] ]
; CHECK-NEXT:    [[ITR_CHK2:%.*]] = icmp sle i64 4, [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK2]], label %[[PH_LS1:.*]], label %[[LS_FINAL_EXIT:.*]]
; CHECK:       [[PH_LS1]]:
; CHECK-NEXT:    br label %[[LOOP_LS1:.*]]
; CHECK:       [[LOOP_LS1]]:
; CHECK-NEXT:    [[I_LS1:%.*]] = phi i64 [ 4, %[[PH_LS1]] ], [ [[I_NEXT_LS1:%.*]], %[[LOOP_LS1]] ]
; CHECK-NEXT:    [[SUM_LS1:%.*]] = phi i64 [ [[SUM_NEXT5]], %[[PH_LS1]] ], [ [[SUM_NEXT_LS1:%.*]], %[[LOOP_LS1]] ]
; CHECK-NEXT:    [[P_LS1:%.*]] = getelementptr inbounds i64, ptr [[A]], i64 [[I_LS1]]
; CHECK-NEXT:    [[V_LS1:%.*]] = load i64, ptr [[P_LS1]], align 4
; CHECK-NEXT:    [[SUM_NEXT_LS1]] = add i64 [[SUM_LS1]], [[V_LS1]]
; CHECK-NEXT:    [[I_NEXT_LS1]] = add nuw nsw i64 [[I_LS1]], 1
; CHECK-NEXT:    [[ITR_CHK3:%.*]] = icmp sle i64 [[I_NEXT_LS1]], [[TMP0]]
; CHECK-NEXT:    br i1 [[ITR_CHK3]], label %[[LOOP_LS1]], label %[[LS_EXIT1:.*]]
; CHECK:       [[LS_EXIT1]]:
; CHECK-NEXT:    br label %[[LS_FINAL_EXIT]]
; CHECK:       [[LS_FINAL_EXIT]]:
; CHECK-NEXT:    [[SUM_NEXT4:%.*]] = phi i64 [ [[SUM_NEXT_LS1]], %[[LS_EXIT1]] ], [ [[SUM_NEXT5]], %[[LS_GUARD1]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT4]], %[[LS_FINAL_EXIT]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br i1 %skip, label %exit, label %ph

ph:
  br label %loop

loop:
  %i = phi i64 [ 0, %ph ], [ %i.next, %loop ]
  %sum = phi i64 [ 0, %ph ], [ %sum.next, %loop ]
  %p = getelementptr inbounds i64, ptr %a, i64 %i
