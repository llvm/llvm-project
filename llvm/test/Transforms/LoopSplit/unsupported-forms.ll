; CHECK-LABEL: define void @token_like_exit_value(
; CHECK-SAME: ptr [[RESOURCE_PTR:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
