entry:
  br label %header

header:
  br i1 %a, label %def1, label %set

set:
  br label %def1

def1:
  %s1 = phi i32 [ 0, %header ], [ -1, %set ]
  br label %def2

def2:
  %s2 = phi i32 [ 0, %def1 ]
  br i1 %c, label %via, label %join

via:
  br label %join

join:
  %st = phi i32 [ %s2, %def2 ], [ %s1, %via ]
  switch i32 %st, label %header [
  i32 -1, label %none
  i32 0, label %found
