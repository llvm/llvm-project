; CHECK-NEXT:    br label %[[NONE]]
; CHECK:       [[JOIN_JT0]]:
; CHECK-NEXT:    [[ST_JT0:%.*]] = phi i32 [ [[S1_JT0]], %[[VIA_JT0]] ]
; CHECK-NEXT:    br label %[[FOUND]]
; CHECK:       [[NONE]]:
; CHECK-NEXT:    ret i32 0
; CHECK:       [[FOUND]]:
; CHECK-NEXT:    ret i32 1
