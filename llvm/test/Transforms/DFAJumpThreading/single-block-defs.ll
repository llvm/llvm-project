; CHECK-NEXT:    switch i32 [[ST]], label %[[HEADER]] [
; CHECK-NEXT:      i32 -1, label %[[NONE:.*]]
; CHECK-NEXT:      i32 0, label %[[FOUND:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[JOIN_JT4294967295]]:
