; https://github.com/llvm/llvm-project/issues/243052
; C++:  struct U { unsigned long w[2]; };
;       U self(U a, U b, bool c)  { a = c ? b : a; return a; }
;       U other(U a, U b, bool c) { U r = c ? b : a; return r; }

; `U r = c ? b : a;` The memcpy writes to a separate alloca %r. Rewriting %r
; splits the memcpy into loads from the select, which are then speculated, so
; every alloca is promoted.
define { i64, i64 } @select_memcpy_to_other_alloca(i64 %a0, i64 %a1, i64 %b0, i64 %b1, i1 %c) {
;
;
;
; CHECK-LABEL: define { i64, i64 } @select_memcpy_to_other_alloca(
; CHECK-SAME: i64 [[A0:%.*]], i64 [[A1:%.*]], i64 [[B0:%.*]], i64 [[B1:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:    [[R_SROA_0_0_COPYLOAD_SROA_SPECULATED:%.*]] = select i1 [[C]], i64 [[B0]], i64 [[A0]]
; CHECK-NEXT:    [[R_SROA_2_0_COPYLOAD_SROA_SPECULATED:%.*]] = select i1 [[C]], i64 [[B1]], i64 [[A1]]
; CHECK-NEXT:    [[I0:%.*]] = insertvalue { i64, i64 } poison, i64 [[R_SROA_0_0_COPYLOAD_SROA_SPECULATED]], 0
; CHECK-NEXT:    [[I1:%.*]] = insertvalue { i64, i64 } [[I0]], i64 [[R_SROA_2_0_COPYLOAD_SROA_SPECULATED]], 1
; CHECK-NEXT:    ret { i64, i64 } [[I1]]
;
  %a = alloca [16 x i8], align 8
  %b = alloca [16 x i8], align 8
  %r = alloca [16 x i8], align 8
  store i64 %a0, ptr %a, align 8
  %a.hi = getelementptr inbounds i8, ptr %a, i64 8
  store i64 %a1, ptr %a.hi, align 8
  store i64 %b0, ptr %b, align 8
  %b.hi = getelementptr inbounds i8, ptr %b, i64 8
  store i64 %b1, ptr %b.hi, align 8
  %p = select i1 %c, ptr %b, ptr %a
  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %r, ptr align 8 %p, i64 16, i1 false)
  %r0 = load i64, ptr %r, align 8
  %r.hi = getelementptr inbounds i8, ptr %r, i64 8
  %r1 = load i64, ptr %r.hi, align 8
  %i0 = insertvalue { i64, i64 } poison, i64 %r0, 0
  %i1 = insertvalue { i64, i64 } %i0, i64 %r1, 1
  ret { i64, i64 } %i1
}

