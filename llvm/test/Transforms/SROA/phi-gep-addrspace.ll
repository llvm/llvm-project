; RUN: opt -passes='sroa<modify-cfg>' -S < %s | FileCheck %s

target datalayout = "e-p:64:64-p5:32:32"

%pair = type { i32, i32 }

; PHI of generic alloca ptrs (64-bit) -> addrspacecast to AS5 (32-bit) -> GEP.
; SROA folds through the addrspacecast even when the two address spaces have
; different pointer widths.
define i32 @phi_gep_addrspace_widths(i1 %cond) {
; CHECK-LABEL: @phi_gep_addrspace_widths(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br i1 [[COND:%.*]], label [[LEFT:%.*]], label [[RIGHT:%.*]]
; CHECK:       left:
; CHECK-NEXT:    br label [[MERGE:%.*]]
; CHECK:       right:
; CHECK-NEXT:    br label [[MERGE]]
; CHECK:       merge:
; CHECK-NEXT:    [[VALUE:%.*]] = phi i32 [ 1, [[LEFT]] ], [ 3, [[RIGHT]] ]
; CHECK-NEXT:    ret i32 [[VALUE]]
;
entry:
  %alloc0 = alloca %pair, align 8
  %alloc1 = alloca %pair, align 8
  store %pair { i32 0, i32 1 }, ptr %alloc0
  store %pair { i32 2, i32 3 }, ptr %alloc1
  br i1 %cond, label %left, label %right

left:
  br label %merge

right:
  br label %merge

merge:
  %phi = phi ptr [ %alloc0, %left ], [ %alloc1, %right ]
  %cast = addrspacecast ptr %phi to ptr addrspace(5)
  %gep = getelementptr inbounds %pair, ptr addrspace(5) %cast, i32 0, i32 1
  %value = load i32, ptr addrspace(5) %gep
  ret i32 %value
}

