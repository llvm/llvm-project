; CHECK-NEXT:    store i8 [[VALUE]], ptr [[ALIAS]], align 1
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 [[DST]], ptr align 4 [[TMP]], i64 12, i1 false)
