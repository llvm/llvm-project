; CHECK-NEXT:    call void @llvm.assume(i1 [[HI]])
; CHECK-NEXT:    [[A_SROA_0_0_ARR2_SROA_STRIDE:%.*]] = mul i64 [[I]], 4
; CHECK-NEXT:    [[A_SROA_0_0_ARR2_SROA_OFFSET:%.*]] = add i64 8, [[A_SROA_0_0_ARR2_SROA_STRIDE]]
; CHECK-NEXT:    [[A_SROA_0_0_ARR2_SROA_IDX:%.*]] = getelementptr inbounds i8, ptr [[A_SROA_0]], i64 [[A_SROA_0_0_ARR2_SROA_OFFSET]]
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 [[A_SROA_0_0_ARR2_SROA_IDX]], ptr align 4 [[C:%.*]], i64 4, i1 false)
; CHECK-NEXT:    [[A_SROA_0_0_ARR2_SROA_STRIDE1:%.*]] = mul i64 [[I]], 4
; CHECK-NEXT:    [[A_SROA_0_0_ARR2_SROA_OFFSET2:%.*]] = add i64 8, [[A_SROA_0_0_ARR2_SROA_STRIDE1]]
; CHECK-NEXT:    [[A_SROA_0_0_ARR2_SROA_IDX3:%.*]] = getelementptr inbounds i8, ptr [[A_SROA_0]], i64 [[A_SROA_0_0_ARR2_SROA_OFFSET2]]
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr align 4 [[A_SROA_0_0_ARR2_SROA_IDX3]], i8 0, i64 4, i1 false)
; CHECK-NEXT:    ret i32 poison
;
entry:
  %a = alloca %struct.ArrHolder, align 4
  %lo = icmp sge i64 %i, -8
  call void @llvm.assume(i1 %lo)
  %hi = icmp slt i64 %i, -1
  call void @llvm.assume(i1 %hi)
  %arr = getelementptr inbounds %struct.ArrHolder, ptr %a, i64 0, i32 1, i64 %i
  store i32 %v, ptr %arr, align 4
  %ls = load i32, ptr %arr, align 4
  %arr2 = getelementptr inbounds i32, ptr %arr, i64 1
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %arr2, ptr align 4 %c, i64 4, i1 false)
  %arr3 = getelementptr inbounds i32, ptr %arr2, i64 4
  call void @llvm.memset.p0.i64(ptr align 4 %arr2, i8 0, i64 4, i1 false)
  ret i32 %ls
}

