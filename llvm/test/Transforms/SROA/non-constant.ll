; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
; CHECK-NEXT:    [[A_SROA_0_0_GEP_SROA_STRIDE:%.*]] = mul i64 [[I]], 1
; CHECK-NEXT:    [[A_SROA_0_0_GEP_SROA_OFFSET:%.*]] = add i64 0, [[A_SROA_0_0_GEP_SROA_STRIDE]]
; CHECK-NEXT:    [[A_SROA_0_0_GEP_SROA_IDX:%.*]] = getelementptr inbounds i8, ptr [[A_SROA_0]], i64 [[A_SROA_0_0_GEP_SROA_OFFSET]]
