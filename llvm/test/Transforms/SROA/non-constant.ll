; Check we don't do anything if a dynamic use may touch the entire alloca.
define i32 @dyn_whole_alloca_use(i64 %i, i32 %v) {
; CHECK-LABEL: @dyn_whole_alloca_use(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[A:%.*]] = alloca [8 x i32], align 4
; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[I:%.*]], 8
; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
; CHECK-NEXT:    [[I2:%.*]] = zext i32 [[V:%.*]] to i64
; CHECK-NEXT:    [[C2:%.*]] = icmp ult i64 [[I2]], 4
; CHECK-NEXT:    call void @llvm.assume(i1 [[C2]])
; CHECK-NEXT:    [[G:%.*]] = getelementptr inbounds [8 x i32], ptr [[A]], i64 0, i64 [[I2]]
; CHECK-NEXT:    store i32 [[V]], ptr [[G]], align 4
; CHECK-NEXT:    [[G1:%.*]] = getelementptr inbounds [8 x i32], ptr [[A]], i64 0, i64 [[I]]
; CHECK-NEXT:    store i32 [[V]], ptr [[G1]], align 4
; CHECK-NEXT:    [[LD:%.*]] = load i32, ptr [[G1]], align 4
; CHECK-NEXT:    [[G2:%.*]] = getelementptr inbounds [8 x i32], ptr [[A]], i64 0, i64 [[I2]]
; CHECK-NEXT:    store i32 [[V]], ptr [[G2]], align 4
; CHECK-NEXT:    ret i32 [[LD]]
;
entry:
  %a = alloca [8 x i32], align 4
  %c = icmp ult i64 %i, 8
  call void @llvm.assume(i1 %c)
  %i2 = zext i32 %v to i64
  %c2 = icmp ult i64 %i2, 4
  call void @llvm.assume(i1 %c2)
  %g0 = getelementptr inbounds [8 x i32], ptr %a, i64 0, i64 %i2
  store i32 %v, ptr %g0, align 4
  %g1 = getelementptr inbounds [8 x i32], ptr %a, i64 0, i64 %i
  store i32 %v, ptr %g1, align 4
  %ld = load i32, ptr %g1, align 4
  %g2 = getelementptr inbounds [8 x i32], ptr %a, i64 0, i64 %i2
  store i32 %v, ptr %g2, align 4
  ret i32 %ld
}
