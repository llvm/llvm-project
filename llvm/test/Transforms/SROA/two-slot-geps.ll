  store i32 %a, ptr %alloca

  %alloca.1 = getelementptr nusw i8, ptr %alloca, i64 4
  store i32 %b, ptr %alloca.1

  %gep = getelementptr nusw [2 x i32], ptr %alloca, i64 0, i64 %idx
  %v = load i32, ptr %gep

  ret i32 %v
}

