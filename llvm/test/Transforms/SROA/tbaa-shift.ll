; RUN: opt -S -passes=sroa %s | FileCheck %s

; Splitting a memcpy shifts its AA metadata. A scalar !tbaa tag describes any
; part of the access and is kept, but a tag with an aggregate access type or a
; struct path only describes the access at its original offset.

%Pair = type { double, float }

define void @scalar_old_format(ptr %src, ptr %dst) {
; CHECK-LABEL: define void @scalar_old_format(
; CHECK-SAME: ptr [[SRC:%.*]], ptr [[DST:%.*]]) {
; CHECK-NEXT:    [[TMP_SROA_0_0_COPYLOAD:%.*]] = load i64, ptr [[SRC]], align 8, !tbaa [[TBAA0:![0-9]+]]
; CHECK-NEXT:    [[TMP_SROA_2_0_SRC_SROA_IDX:%.*]] = getelementptr inbounds i8, ptr [[SRC]], i64 8
; CHECK-NEXT:    [[TMP_SROA_2_0_COPYLOAD:%.*]] = load i64, ptr [[TMP_SROA_2_0_SRC_SROA_IDX]], align 8, !tbaa [[TBAA0]]
; CHECK-NEXT:    store i64 [[TMP_SROA_0_0_COPYLOAD]], ptr [[DST]], align 8
; CHECK-NEXT:    [[DST_HI:%.*]] = getelementptr inbounds i8, ptr [[DST]], i64 8
; CHECK-NEXT:    store i64 [[TMP_SROA_2_0_COPYLOAD]], ptr [[DST_HI]], align 8
; CHECK-NEXT:    ret void
;
  %tmp = alloca [16 x i8], align 8
  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %tmp, ptr align 8 %src, i64 16, i1 false), !tbaa !2
  %lo = load i64, ptr %tmp, align 8
  %hi.ptr = getelementptr inbounds i8, ptr %tmp, i64 8
  %hi = load i64, ptr %hi.ptr, align 8
  store i64 %lo, ptr %dst, align 8
  %dst.hi = getelementptr inbounds i8, ptr %dst, i64 8
  store i64 %hi, ptr %dst.hi, align 8
  ret void
}

