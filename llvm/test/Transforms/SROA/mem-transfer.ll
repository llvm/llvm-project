; Tests of memmove where the source or destination are entirely out of bounds.
; The memmove will be removed, resulting in a final return value that's either
; poison or undef. We do each test with the order of allocas swapped as the
; order in IR determines the order in which SROA optimizes them, which causes
; different intermediate loads and stores to be generated which affects whether
; the final result is poison or undef.

define i8 @different_alloca_dest_out_of_bounds_ab(i8 %arg) {
; CHECK-LABEL: @different_alloca_dest_out_of_bounds_ab(
; CHECK-NEXT:    ret i8 poison
;
  %a = alloca [1 x i8], align 1
  %b = alloca [2 x i8], align 1
  %a.0 = getelementptr i8, ptr %a, i64 0
  %a.1 = getelementptr i8, ptr %a, i64 1
  %b.0 = getelementptr i8, ptr %b, i64 0
  %b.1 = getelementptr i8, ptr %b, i64 1
  store i8 %arg, ptr %b.0, align 1
  call void @llvm.memmove.p0.p0.i64(ptr %a.1, ptr %b.0, i64 1, i1 false)
  call void @llvm.memmove.p0.p0.i64(ptr %b.0, ptr %a.0, i64 2, i1 false)
  %ret = load i8, ptr %b.1, align 1
  ret i8 %ret
}

define i8 @different_alloca_dest_out_of_bounds_ba(i8 %arg) {
; CHECK-LABEL: @different_alloca_dest_out_of_bounds_ba(
; CHECK-NEXT:    ret i8 undef
;
  %b = alloca [2 x i8], align 1
  %a = alloca [1 x i8], align 1
  %a.0 = getelementptr i8, ptr %a, i64 0
  %a.1 = getelementptr i8, ptr %a, i64 1
