; CHECK-NEXT:    [[A_SROA_0:%.*]] = alloca i32, align 4
; CHECK-NEXT:    store volatile i32 [[ARG:%.*]], ptr [[A_SROA_0]], align 4
; CHECK-NEXT:    [[A_SROA_0_2_A_2_SROA_IDX2:%.*]] = getelementptr inbounds i8, ptr [[A_SROA_0]], i64 2
; CHECK-NEXT:    [[A_SROA_0_2_A_2_SROA_IDX3:%.*]] = getelementptr inbounds i8, ptr [[A_SROA_0]], i64 2
; CHECK-NEXT:    call void @llvm.memmove.p0.p0.i64(ptr align 2 [[A_SROA_0_2_A_2_SROA_IDX2]], ptr align 2 [[A_SROA_0_2_A_2_SROA_IDX3]], i64 4, i1 true)
; CHECK-NEXT:    [[A_SROA_0_0_A_SROA_0_0_RET:%.*]] = load volatile i32, ptr [[A_SROA_0]], align 4
; CHECK-NEXT:    ret i32 [[A_SROA_0_0_A_SROA_0_0_RET]]
;
  %a = alloca [4 x i8], align 4
  %a.0 = getelementptr i8, ptr %a, i64 0
  %a.2 = getelementptr i8, ptr %a, i64 2
