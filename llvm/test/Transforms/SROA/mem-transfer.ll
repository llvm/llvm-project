; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=sroa -S | FileCheck %s --check-prefixes=CHECK

target datalayout = "e-p:64:64:64-n8:16:32:64"

; Simple tests to make sure SROA is recognizing memmove and memcpy and handling
; them as if they were a load then a store.

define i32 @simple_memmove(i16 %arg) {
; CHECK-LABEL: @simple_memmove(
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_EXT:%.*]] = zext i16 [[ARG:%.*]] to i32
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_SHIFT:%.*]] = shl i32 [[A_SROA_3_0_INSERT_EXT]], 16
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_MASK:%.*]] = and i32 undef, 65535
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_INSERT:%.*]] = or i32 [[A_SROA_3_0_INSERT_MASK]], [[A_SROA_3_0_INSERT_SHIFT]]
; CHECK-NEXT:    [[A_SROA_0_0_INSERT_EXT:%.*]] = zext i16 [[ARG]] to i32
; CHECK-NEXT:    [[A_SROA_0_0_INSERT_MASK:%.*]] = and i32 [[A_SROA_3_0_INSERT_INSERT]], -65536
; CHECK-NEXT:    [[A_SROA_0_0_INSERT_INSERT:%.*]] = or i32 [[A_SROA_0_0_INSERT_MASK]], [[A_SROA_0_0_INSERT_EXT]]
; CHECK-NEXT:    ret i32 [[A_SROA_0_0_INSERT_INSERT]]
;
  %a = alloca [4 x i8], align 4
  %a.0 = getelementptr i8, ptr %a, i64 0
  %a.2 = getelementptr i8, ptr %a, i64 2
  store i16 %arg, ptr %a.0, align 4
  call void @llvm.memmove.p0.p0.i64(ptr %a.2, ptr %a.0, i64 2, i1 false)
  %ret = load i32, ptr %a.0, align 4
  ret i32 %ret
}

define i32 @simple_memcpy(i16 %arg) {
; CHECK-LABEL: @simple_memcpy(
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_EXT:%.*]] = zext i16 [[ARG:%.*]] to i32
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_SHIFT:%.*]] = shl i32 [[A_SROA_3_0_INSERT_EXT]], 16
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_MASK:%.*]] = and i32 undef, 65535
; CHECK-NEXT:    [[A_SROA_3_0_INSERT_INSERT:%.*]] = or i32 [[A_SROA_3_0_INSERT_MASK]], [[A_SROA_3_0_INSERT_SHIFT]]
; CHECK-NEXT:    [[A_SROA_0_0_INSERT_EXT:%.*]] = zext i16 [[ARG]] to i32
; CHECK-NEXT:    [[A_SROA_0_0_INSERT_MASK:%.*]] = and i32 [[A_SROA_3_0_INSERT_INSERT]], -65536
; CHECK-NEXT:    [[A_SROA_0_0_INSERT_INSERT:%.*]] = or i32 [[A_SROA_0_0_INSERT_MASK]], [[A_SROA_0_0_INSERT_EXT]]
; CHECK-NEXT:    ret i32 [[A_SROA_0_0_INSERT_INSERT]]
;
  %a = alloca [4 x i8], align 4
  %a.0 = getelementptr i8, ptr %a, i64 0
  %a.2 = getelementptr i8, ptr %a, i64 2
  store i16 %arg, ptr %a.0, align 4
  call void @llvm.memcpy.p0.p0.i64(ptr %a.2, ptr %a.0, i64 2, i1 false)
  %ret = load i32, ptr %a.0, align 4
  ret i32 %ret
}

; Tests of memmove with the same source and destination: should be removed if
; non-volatile, and kept if volatile.

define i32 @same_address_memmove(i32 %arg) {
; CHECK-LABEL: @same_address_memmove(
; CHECK-NEXT:    [[A_SROA_0:%.*]] = alloca i32, align 4
; CHECK-NEXT:    store volatile i32 [[ARG:%.*]], ptr [[A_SROA_0]], align 4
; CHECK-NEXT:    [[A_SROA_0_0_A_SROA_0_0_RET:%.*]] = load volatile i32, ptr [[A_SROA_0]], align 4
; CHECK-NEXT:    ret i32 [[A_SROA_0_0_A_SROA_0_0_RET]]
;
  %a = alloca [4 x i8], align 4
  %a.0 = getelementptr i8, ptr %a, i64 0
  %a.2 = getelementptr i8, ptr %a, i64 2
  store volatile i32 %arg, ptr %a.0, align 4
  call void @llvm.memmove.p0.p0.i64(ptr %a.2, ptr %a.2, i64 2, i1 false)
  %ret = load volatile i32, ptr %a.0, align 4
  ret i32 %ret
}

