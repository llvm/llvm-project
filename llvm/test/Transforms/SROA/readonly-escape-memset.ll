; The memset in the loop defines the value for the next iteration.
define i32 @memset_variable_value_loop(i8 %v, i32 %x, i32 %n) {
; CHECK-LABEL: define i32 @memset_variable_value_loop(
; CHECK-SAME: i8 [[V:%.*]], i32 [[X:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    store i32 [[X]], ptr [[A]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[X1:%.*]] = phi i32 [ [[X]], %[[ENTRY]] ], [ [[TMP4:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    call void @callee(ptr [[A]])
; CHECK-NEXT:    [[SUM_NEXT]] = add i32 [[SUM]], [[X1]]
; CHECK-NEXT:    [[TMP0:%.*]] = zext i8 [[V]] to i32
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[TMP0]], 8
; CHECK-NEXT:    [[TMP2:%.*]] = or i32 [[TMP0]], [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = shl i32 [[TMP2]], 16
; CHECK-NEXT:    [[TMP4]] = or i32 [[TMP2]], [[TMP3]]
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 [[V]], i64 4, i1 false)
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[SUM_NEXT]]
;
entry:
  %a = alloca i32, align 4
  store i32 %x, ptr %a
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  call void @callee(ptr %a)
  %l = load i32, ptr %a
  %sum.next = add i32 %sum, %l
  call void @llvm.memset.p0.i64(ptr %a, i8 %v, i64 4, i1 false)
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret i32 %sum.next
}

