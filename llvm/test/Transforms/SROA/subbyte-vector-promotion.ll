; Allocas of sub-byte element vectors are promoted as vectors of bytes.

; A <64 x i4> written whole and read back in 16-byte halves is promoted as
; <32 x b8>.
define void @i4_halves(<64 x i4> %v, ptr %out) {
; CHECK-LABEL: define void @i4_halves(
; CHECK-SAME: <64 x i4> [[V:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <64 x i4> [[V]] to <32 x b8>
; CHECK-NEXT:    [[A_SROA_0_0_VEC_EXTRACT:%.*]] = shufflevector <32 x b8> [[TMP1]], <32 x b8> poison, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <16 x b8> [[A_SROA_0_0_VEC_EXTRACT]] to <32 x i4>
; CHECK-NEXT:    [[A_SROA_0_16_VEC_EXTRACT:%.*]] = shufflevector <32 x b8> [[TMP1]], <32 x b8> poison, <16 x i32> <i32 16, i32 17, i32 18, i32 19, i32 20, i32 21, i32 22, i32 23, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
; CHECK-NEXT:    [[TMP3:%.*]] = bitcast <16 x b8> [[A_SROA_0_16_VEC_EXTRACT]] to <32 x i4>
; CHECK-NEXT:    store <32 x i4> [[TMP2]], ptr [[OUT]], align 16
; CHECK-NEXT:    [[O:%.*]] = getelementptr inbounds i8, ptr [[OUT]], i64 16
; CHECK-NEXT:    store <32 x i4> [[TMP3]], ptr [[O]], align 16
; CHECK-NEXT:    ret void
;
  %a = alloca <64 x i4>, align 64
  store <64 x i4> %v, ptr %a, align 64
  %lo = load <32 x i4>, ptr %a, align 64
  %p = getelementptr inbounds i8, ptr %a, i64 16
  %hi = load <32 x i4>, ptr %p, align 16
  store <32 x i4> %lo, ptr %out, align 16
  %o = getelementptr inbounds i8, ptr %out, i64 16
  store <32 x i4> %hi, ptr %o, align 16
  ret void
}

