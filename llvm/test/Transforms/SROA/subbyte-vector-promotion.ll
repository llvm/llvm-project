; Allocas of sub-byte element vectors are promoted as vectors of their own
; type.

; Byte 1 of a <8 x i4> is overwritten, so lanes 2 and 3 are replaced.
define void @rmw_b4_n8(ptr %in, ptr %replacement, ptr %out) {
; CHECK-LABEL: define void @rmw_b4_n8(
; CHECK-SAME: ptr [[IN:%.*]], ptr [[REPLACEMENT:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = load <8 x i4>, ptr [[IN]], align 1
; CHECK-NEXT:    [[X:%.*]] = load <2 x i4>, ptr [[REPLACEMENT]], align 1
; CHECK-NEXT:    [[A_1_VEC_EXPAND:%.*]] = shufflevector <2 x i4> [[X]], <2 x i4> poison, <8 x i32> <i32 poison, i32 poison, i32 0, i32 1, i32 poison, i32 poison, i32 poison, i32 poison>
; CHECK-NEXT:    [[A_1_VECBLEND:%.*]] = shufflevector <8 x i4> [[A_1_VEC_EXPAND]], <8 x i4> [[V]], <8 x i32> <i32 8, i32 9, i32 2, i32 3, i32 12, i32 13, i32 14, i32 15>
; CHECK-NEXT:    store <8 x i4> [[A_1_VECBLEND]], ptr [[OUT]], align 1
; CHECK-NEXT:    ret void
;
  %v = load <8 x i4>, ptr %in, align 1
  %x = load <2 x i4>, ptr %replacement, align 1
  %a = alloca <8 x i4>, align 16
  store <8 x i4> %v, ptr %a, align 16
  %p = getelementptr inbounds i8, ptr %a, i64 1
  store <2 x i4> %x, ptr %p, align 1
  %r = load <8 x i4>, ptr %a, align 16
  store <8 x i4> %r, ptr %out, align 1
  ret void
}

