; CHECK-SAME: <16 x i4> [[V:%.*]]) {
; CHECK-NEXT:    [[A_SROA_0:%.*]] = alloca <16 x i4>, align 8
; CHECK-NEXT:    store <16 x i4> [[V]], ptr [[A_SROA_0]], align 8
; CHECK-NEXT:    [[A_SROA_0_3_P_SROA_IDX1:%.*]] = getelementptr inbounds i8, ptr [[A_SROA_0]], i64 3
; CHECK-NEXT:    [[A_SROA_0_3_A_SROA_0_3_R:%.*]] = load i4, ptr [[A_SROA_0_3_P_SROA_IDX1]], align 1
; CHECK-NEXT:    ret i4 [[A_SROA_0_3_A_SROA_0_3_R]]
;
