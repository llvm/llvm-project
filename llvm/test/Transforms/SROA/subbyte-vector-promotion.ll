; A pointer copied through a <16 x b4> slot in halves and rebuilt. The byte
; elements keep the pointer bits, so the result is still the pointer.
define ptr @b4_pointer_rebuild(ptr %p) {
; CHECK-LABEL: define ptr @b4_pointer_rebuild(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = bitcast ptr [[P]] to <16 x b4>
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <16 x b4> [[V]] to <8 x b8>
; CHECK-NEXT:    [[A_SROA_0_0_VEC_EXTRACT:%.*]] = shufflevector <8 x b8> [[TMP1]], <8 x b8> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <4 x b8> [[A_SROA_0_0_VEC_EXTRACT]] to <8 x b4>
; CHECK-NEXT:    [[A_SROA_0_4_VEC_EXTRACT:%.*]] = shufflevector <8 x b8> [[TMP1]], <8 x b8> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP3:%.*]] = bitcast <4 x b8> [[A_SROA_0_4_VEC_EXTRACT]] to <8 x b4>
; CHECK-NEXT:    [[W:%.*]] = shufflevector <8 x b4> [[TMP2]], <8 x b4> [[TMP3]], <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
; CHECK-NEXT:    [[R:%.*]] = bitcast <16 x b4> [[W]] to ptr
; CHECK-NEXT:    ret ptr [[R]]
;
  %a = alloca <16 x b4>, align 8
  %v = bitcast ptr %p to <16 x b4>
  store <16 x b4> %v, ptr %a, align 8
  %lo = load <8 x b4>, ptr %a, align 8
  %hp = getelementptr inbounds i8, ptr %a, i64 4
  %hi = load <8 x b4>, ptr %hp, align 4
  %w = shufflevector <8 x b4> %lo, <8 x b4> %hi, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %r = bitcast <16 x b4> %w to ptr
  ret ptr %r
}

; Lane 0 is poison and lane 1 is %x. Both share a byte, which keeps their bits
; apart, so lane 1 of the result is still %x.
define <2 x i4> @poison_lane(i4 %x) {
; CHECK-LABEL: define <2 x i4> @poison_lane(
; CHECK-SAME: i4 [[X:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = insertelement <4 x i4> <i4 poison, i4 poison, i4 1, i4 2>, i4 [[X]], i64 1
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <4 x i4> [[V]] to <2 x b8>
; CHECK-NEXT:    [[A_SROA_0_0_VEC_EXTRACT:%.*]] = extractelement <2 x b8> [[TMP1]], i64 0
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast b8 [[A_SROA_0_0_VEC_EXTRACT]] to <2 x i4>
; CHECK-NEXT:    ret <2 x i4> [[TMP2]]
;
  %a = alloca <4 x i4>, align 2
  %v = insertelement <4 x i4> <i4 poison, i4 poison, i4 1, i4 2>, i4 %x, i64 1
  store <4 x i4> %v, ptr %a, align 2
  %l = load <2 x i4>, ptr %a, align 2
  ret <2 x i4> %l
}

