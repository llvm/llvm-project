; Values computed in the same block, mixed with a constant and a load that is
; not part of a consecutive load chain.
define void @mixed_computed_stores(ptr %ptr, ptr %other, i32 %a, float %b) {
; CHECK-LABEL: define void @mixed_computed_stores(
; CHECK-SAME: ptr [[PTR:%.*]], ptr [[OTHER:%.*]], i32 [[A:%.*]], float [[B:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i32, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[A]], 1
; CHECK-NEXT:    [[FADD:%.*]] = fadd float [[B]], 1.000000e+00
; CHECK-NEXT:    [[LD:%.*]] = load float, ptr [[OTHER]], align 4
; CHECK-NEXT:    [[VPACK:%.*]] = insertelement <4 x i32> poison, i32 [[ADD]], i32 0, !sandboxvec [[META4:![0-9]+]]
; CHECK-NEXT:    [[VCAST:%.*]] = bitcast float [[FADD]] to i32, !sandboxvec [[META4]]
; CHECK-NEXT:    [[VPACK1:%.*]] = insertelement <4 x i32> [[VPACK]], i32 [[VCAST]], i32 1, !sandboxvec [[META4]]
; CHECK-NEXT:    [[VCAST2:%.*]] = bitcast float [[LD]] to i32, !sandboxvec [[META4]]
; CHECK-NEXT:    [[VPACK3:%.*]] = insertelement <4 x i32> [[VPACK1]], i32 [[VCAST2]], i32 2, !sandboxvec [[META4]]
; CHECK-NEXT:    [[VPACK4:%.*]] = insertelement <4 x i32> [[VPACK3]], i32 42, i32 3, !sandboxvec [[META4]]
; CHECK-NEXT:    store <4 x i32> [[VPACK4]], ptr [[PTR0]], align 4, !sandboxvec [[META4]]
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i32, ptr %ptr, i32 0
  %ptr1 = getelementptr i32, ptr %ptr, i32 1
  %ptr2 = getelementptr i32, ptr %ptr, i32 2
  %add = add i32 %a, 1
  %fadd = fadd float %b, 1.0
  %ld = load float, ptr %other
  store i32 %add, ptr %ptr0
  store float %fadd, ptr %ptr1
  store float %ld, ptr %ptr2
  %ptr3 = getelementptr i32, ptr %ptr, i32 3
  store i32 42, ptr %ptr3
  ret void
}

; The second store's value is loaded from the first store's address, so the
; stores cannot be scheduled as one bundle and must not be vectorized.
define void @stores_cant_schedule(ptr %ptr, i32 %a) {
; CHECK-LABEL: define void @stores_cant_schedule(
; CHECK-SAME: ptr [[PTR:%.*]], i32 [[A:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i32, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[PTR1:%.*]] = getelementptr i32, ptr [[PTR]], i32 1
; CHECK-NEXT:    store i32 [[A]], ptr [[PTR0]], align 4, !sandboxvec [[META5:![0-9]+]]
; CHECK-NEXT:    [[LD:%.*]] = load float, ptr [[PTR0]], align 4
; CHECK-NEXT:    store float [[LD]], ptr [[PTR1]], align 4, !sandboxvec [[META5]]
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i32, ptr %ptr, i32 0
  %ptr1 = getelementptr i32, ptr %ptr, i32 1
  store i32 %a, ptr %ptr0
  %ld = load float, ptr %ptr0
  store float %ld, ptr %ptr1
  ret void
}

