; RUN: opt -passes=sandbox-vectorizer -sbvec-passes="seed-collection(enable-diff-types)<load-store-vec>" -sbvec-vec-reg-bits=1024 %s -S | FileCheck %s

target datalayout = "e-p:64:64-ni:4"

; A store chain whose values are neither loads nor constants is vectorized by
; packing the values into a vector. For a chain of mixed types each value is
; first cast to the integer lanes it occupies.

; int + float: one lane each, the float is packed with a bitcast.
define void @mixed_int_float_stores(ptr %ptr, i32 %i, float %f) {
; CHECK-LABEL: define void @mixed_int_float_stores(
; CHECK-SAME: ptr [[PTR:%.*]], i32 [[I:%.*]], float [[F:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i32, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VPACK:%.*]] = insertelement <2 x i32> poison, i32 [[I]], i32 0, !sandboxvec [[META0:![0-9]+]]
; CHECK-NEXT:    [[VCAST:%.*]] = bitcast float [[F]] to i32, !sandboxvec [[META0]]
; CHECK-NEXT:    [[VPACK1:%.*]] = insertelement <2 x i32> [[VPACK]], i32 [[VCAST]], i32 1, !sandboxvec [[META0]]
; CHECK-NEXT:    store <2 x i32> [[VPACK1]], ptr [[PTR0]], align 4, !sandboxvec [[META0]]
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i32, ptr %ptr, i32 0
  %ptr1 = getelementptr i32, ptr %ptr, i32 1
  store i32 %i, ptr %ptr0
  store float %f, ptr %ptr1
  ret void
}

; ptr + int: the pointer lane needs a ptrtoint.
define void @mixed_ptr_int_stores(ptr %ptr, ptr %p, i64 %i) {
; CHECK-LABEL: define void @mixed_ptr_int_stores(
; CHECK-SAME: ptr [[PTR:%.*]], ptr [[P:%.*]], i64 [[I:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i64, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VCAST:%.*]] = ptrtoint ptr [[P]] to i64, !sandboxvec [[META1:![0-9]+]]
; CHECK-NEXT:    [[VPACK:%.*]] = insertelement <2 x i64> poison, i64 [[VCAST]], i32 0, !sandboxvec [[META1]]
; CHECK-NEXT:    [[VPACK1:%.*]] = insertelement <2 x i64> [[VPACK]], i64 [[I]], i32 1, !sandboxvec [[META1]]
; CHECK-NEXT:    store <2 x i64> [[VPACK1]], ptr [[PTR0]], align 8, !sandboxvec [[META1]]
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i64, ptr %ptr, i32 0
  %ptr1 = getelementptr i64, ptr %ptr, i32 1
  store ptr %p, ptr %ptr0
  store i64 %i, ptr %ptr1
  ret void
}

; A double spans two i32 lanes, so it is split after a bitcast.
