; CHECK-LABEL: define void @mixed_double_int_stores(
; CHECK-SAME: ptr [[PTR:%.*]], double [[D:%.*]], i32 [[I0:%.*]], i32 [[I1:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i8, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VCAST:%.*]] = bitcast double [[D]] to <2 x i32>, !sandboxvec [[META2:![0-9]+]]
; CHECK-NEXT:    [[VPACK:%.*]] = extractelement <2 x i32> [[VCAST]], i32 0, !sandboxvec [[META2]]
; CHECK-NEXT:    [[VPACK1:%.*]] = insertelement <4 x i32> poison, i32 [[VPACK]], i32 0, !sandboxvec [[META2]]
; CHECK-NEXT:    [[VPACK2:%.*]] = extractelement <2 x i32> [[VCAST]], i32 1, !sandboxvec [[META2]]
; CHECK-NEXT:    [[VPACK3:%.*]] = insertelement <4 x i32> [[VPACK1]], i32 [[VPACK2]], i32 1, !sandboxvec [[META2]]
; CHECK-NEXT:    [[VPACK4:%.*]] = insertelement <4 x i32> [[VPACK3]], i32 [[I0]], i32 2, !sandboxvec [[META2]]
; CHECK-NEXT:    [[VPACK5:%.*]] = insertelement <4 x i32> [[VPACK4]], i32 [[I1]], i32 3, !sandboxvec [[META2]]
; CHECK-NEXT:    store <4 x i32> [[VPACK5]], ptr [[PTR0]], align 8, !sandboxvec [[META2]]
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i8, ptr %ptr, i32 0
  %ptr1 = getelementptr i8, ptr %ptr, i32 8
  %ptr2 = getelementptr i8, ptr %ptr, i32 12
  store double %d, ptr %ptr0
  store i32 %i0, ptr %ptr1
  store i32 %i1, ptr %ptr2
  ret void
}

