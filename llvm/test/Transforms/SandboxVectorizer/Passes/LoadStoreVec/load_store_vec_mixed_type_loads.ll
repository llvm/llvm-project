; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=sandbox-vectorizer -sbvec-passes="seed-collection(loads,stores,enable-diff-types)<load-store-vec>" -sbvec-vec-reg-bits=1024 %s -S | FileCheck %s

target datalayout = "e-p:64:64-ni:4"

; A load chain of mixed types is loaded as a vector of integers and each lane
; is cast back to the original type.

; int + float: one lane each, unpacked with a bitcast.
define void @mixed_int_float_loads(ptr %ptr) {
; CHECK-LABEL: define void @mixed_int_float_loads(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i32, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VECIINITL:%.*]] = load <2 x i32>, ptr [[PTR0]], align 1, !sandboxvec [[META0:![0-9]+]]
; CHECK-NEXT:    [[UNPACK:%.*]] = extractelement <2 x i32> [[VECIINITL]], i32 0, !sandboxvec [[META0]]
; CHECK-NEXT:    [[UNPACK1:%.*]] = extractelement <2 x i32> [[VECIINITL]], i32 1, !sandboxvec [[META0]]
; CHECK-NEXT:    [[VCAST:%.*]] = bitcast i32 [[UNPACK1]] to float, !sandboxvec [[META0]]
; CHECK-NEXT:    call void @use_i32_f32(i32 [[UNPACK]], float [[VCAST]])
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i32, ptr %ptr, i32 0
  %ptr1 = getelementptr i32, ptr %ptr, i32 1
  %ld0 = load i32, ptr %ptr0
  %ld1 = load float, ptr %ptr1
  call void @use_i32_f32(i32 %ld0, float %ld1)
  ret void
}

; ptr + int: the pointer lane needs an inttoptr.
define void @mixed_ptr_int_loads(ptr %ptr) {
; CHECK-LABEL: define void @mixed_ptr_int_loads(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i64, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VECIINITL:%.*]] = load <2 x i64>, ptr [[PTR0]], align 1, !sandboxvec [[META1:![0-9]+]]
; CHECK-NEXT:    [[UNPACK:%.*]] = extractelement <2 x i64> [[VECIINITL]], i32 0, !sandboxvec [[META1]]
; CHECK-NEXT:    [[VCAST:%.*]] = inttoptr i64 [[UNPACK]] to ptr, !sandboxvec [[META1]]
; CHECK-NEXT:    [[UNPACK1:%.*]] = extractelement <2 x i64> [[VECIINITL]], i32 1, !sandboxvec [[META1]]
; CHECK-NEXT:    call void @use_ptr_i64(ptr [[VCAST]], i64 [[UNPACK1]])
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i64, ptr %ptr, i32 0
  %ptr1 = getelementptr i64, ptr %ptr, i32 1
  %ld0 = load ptr, ptr %ptr0
  %ld1 = load i64, ptr %ptr1
  call void @use_ptr_i64(ptr %ld0, i64 %ld1)
  ret void
}

; A double spans two i32 lanes, so it is unpacked with a shuffle and a bitcast.
define void @mixed_double_int_loads(ptr %ptr) {
; CHECK-LABEL: define void @mixed_double_int_loads(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i8, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VECIINITL:%.*]] = load <4 x i32>, ptr [[PTR0]], align 1, !sandboxvec [[META2:![0-9]+]]
; CHECK-NEXT:    [[UNPACK:%.*]] = shufflevector <4 x i32> [[VECIINITL]], <4 x i32> poison, <2 x i32> <i32 0, i32 1>, !sandboxvec [[META2]]
; CHECK-NEXT:    [[VCAST:%.*]] = bitcast <2 x i32> [[UNPACK]] to double, !sandboxvec [[META2]]
; CHECK-NEXT:    [[UNPACK1:%.*]] = extractelement <4 x i32> [[VECIINITL]], i32 2, !sandboxvec [[META2]]
; CHECK-NEXT:    [[UNPACK2:%.*]] = extractelement <4 x i32> [[VECIINITL]], i32 3, !sandboxvec [[META2]]
; CHECK-NEXT:    call void @use_f64_i32_i32(double [[VCAST]], i32 [[UNPACK1]], i32 [[UNPACK2]])
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i8, ptr %ptr, i32 0
  %ptr1 = getelementptr i8, ptr %ptr, i32 8
  %ptr2 = getelementptr i8, ptr %ptr, i32 12
  %ld0 = load double, ptr %ptr0
  %ld1 = load i32, ptr %ptr1
  %ld2 = load i32, ptr %ptr2
  call void @use_f64_i32_i32(double %ld0, i32 %ld1, i32 %ld2)
  ret void
}

; A vector element mixed with a scalar of another type.
define void @mixed_vector_element_loads(ptr %ptr) {
; CHECK-LABEL: define void @mixed_vector_element_loads(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i8, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VECIINITL:%.*]] = load <4 x i32>, ptr [[PTR0]], align 1, !sandboxvec [[META3:![0-9]+]]
; CHECK-NEXT:    [[UNPACK:%.*]] = shufflevector <4 x i32> [[VECIINITL]], <4 x i32> poison, <2 x i32> <i32 0, i32 1>, !sandboxvec [[META3]]
; CHECK-NEXT:    [[VCAST:%.*]] = bitcast <2 x i32> [[UNPACK]] to <2 x float>, !sandboxvec [[META3]]
; CHECK-NEXT:    [[UNPACK1:%.*]] = shufflevector <4 x i32> [[VECIINITL]], <4 x i32> poison, <2 x i32> <i32 2, i32 3>, !sandboxvec [[META3]]
; CHECK-NEXT:    [[VCAST2:%.*]] = bitcast <2 x i32> [[UNPACK1]] to i64, !sandboxvec [[META3]]
; CHECK-NEXT:    call void @use_v2f32_i64(<2 x float> [[VCAST]], i64 [[VCAST2]])
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i8, ptr %ptr, i32 0
  %ptr1 = getelementptr i8, ptr %ptr, i32 8
  %ld0 = load <2 x float>, ptr %ptr0
  %ld1 = load i64, ptr %ptr1
  call void @use_v2f32_i64(<2 x float> %ld0, i64 %ld1)
  ret void
}

; Loads with no uses still merge, and emit no casts.
define void @mixed_loads_no_uses(ptr %ptr) {
; CHECK-LABEL: define void @mixed_loads_no_uses(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i32, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[VECIINITL:%.*]] = load <2 x i32>, ptr [[PTR0]], align 1, !sandboxvec [[META4:![0-9]+]]
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i32, ptr %ptr, i32 0
  %ptr1 = getelementptr i32, ptr %ptr, i32 1
  %ld0 = load i32, ptr %ptr0
  %ld1 = load float, ptr %ptr1
  ret void
}

; Non-integral pointers have no stable integer representation, so this chain is
; left alone.
define void @mixed_non_integral_ptr_loads(ptr %ptr) {
; CHECK-LABEL: define void @mixed_non_integral_ptr_loads(
; CHECK-SAME: ptr [[PTR:%.*]]) {
; CHECK-NEXT:    [[PTR0:%.*]] = getelementptr i64, ptr [[PTR]], i32 0
; CHECK-NEXT:    [[PTR1:%.*]] = getelementptr i64, ptr [[PTR]], i32 1
; CHECK-NEXT:    [[LD0:%.*]] = load ptr addrspace(4), ptr [[PTR0]], align 8, !sandboxvec [[META5:![0-9]+]]
; CHECK-NEXT:    [[LD1:%.*]] = load i64, ptr [[PTR1]], align 4, !sandboxvec [[META5]]
; CHECK-NEXT:    call void @use_p4_i64(ptr addrspace(4) [[LD0]], i64 [[LD1]])
; CHECK-NEXT:    ret void
;
  %ptr0 = getelementptr i64, ptr %ptr, i32 0
  %ptr1 = getelementptr i64, ptr %ptr, i32 1
  %ld0 = load ptr addrspace(4), ptr %ptr0
  %ld1 = load i64, ptr %ptr1
  call void @use_p4_i64(ptr addrspace(4) %ld0, i64 %ld1)
  ret void
}

declare void @use_i32_f32(i32, float)
declare void @use_ptr_i64(ptr, i64)
declare void @use_f64_i32_i32(double, i32, i32)
declare void @use_v2f32_i64(<2 x float>, i64)
declare void @use_p4_i64(ptr addrspace(4), i64)
