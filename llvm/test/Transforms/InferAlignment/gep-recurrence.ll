; CHECK:       [[PRE1]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[PRE2]]:
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi ptr [ [[DST]], %[[PRE1]] ], [ [[DST]], %[[PRE2]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    store i64 0, ptr [[IV]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = getelementptr nusw i8, ptr [[IV]], i64 128
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
