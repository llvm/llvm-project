; CHECK-NEXT:    [[SPLAT:%.*]] = shufflevector <vscale x 4 x i16> [[INSERT]], <vscale x 4 x i16> poison, <vscale x 4 x i32> zeroinitializer
; CHECK-NEXT:    [[A0:%.*]] = sdiv <vscale x 4 x i16> [[SPLAT]], [[F0]]
; CHECK-NEXT:    br i1 [[COND]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
