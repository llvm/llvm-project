; LE-NEXT:    [[TMP1:%.*]] = load <4 x i16>, ptr [[P:%.*]], align 8
; LE-NEXT:    [[TMP2:%.*]] = shufflevector <4 x i16> [[TMP1]], <4 x i16> poison, <4 x i32> <i32 1, i32 2, i32 poison, i32 poison>
; LE-NEXT:    [[R:%.*]] = bitcast <4 x i16> [[TMP2]] to <2 x i32>
