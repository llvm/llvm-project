;
; BE-LABEL: @load_insert_unaligned_offset_i32_gcd_i16(
; BE-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P:%.*]], i64 2
; BE-NEXT:    [[X:%.*]] = load i32, ptr [[GEP]], align 1
; BE-NEXT:    [[R:%.*]] = insertelement <2 x i32> poison, i32 [[X]], i64 0
; BE-NEXT:    ret <2 x i32> [[R]]
