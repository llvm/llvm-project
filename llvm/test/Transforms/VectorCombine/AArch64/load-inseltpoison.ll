; RUN: opt -passes=vector-combine -S -mtriple=aarch64-linux-gnu -mattr=+neon %s | FileCheck %s

; An i8 chunk is legal, but the AArch64 cost model rejects this transform.

define <2 x i32> @load_insert_unaligned_offset_i32_gcd_i8(ptr align 8 dereferenceable(8) %p) {
; CHECK-LABEL: @load_insert_unaligned_offset_i32_gcd_i8(
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P:%.*]], i64 1
; CHECK-NEXT:    [[X:%.*]] = load i32, ptr [[GEP]], align 1
; CHECK-NEXT:    [[R:%.*]] = insertelement <2 x i32> poison, i32 [[X]], i64 0
; CHECK-NEXT:    ret <2 x i32> [[R]]
;
  %gep = getelementptr inbounds i8, ptr %p, i64 1
  %x = load i32, ptr %gep, align 1
  %r = insertelement <2 x i32> poison, i32 %x, i64 0
  ret <2 x i32> %r
}

