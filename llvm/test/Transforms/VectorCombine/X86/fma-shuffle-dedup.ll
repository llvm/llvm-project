; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt < %s -passes=vector-combine -mtriple=x86_64-- -mcpu=x86-64-v3 -S | FileCheck %s

; Test that VectorCombine deduplicates shuffle instructions when merging
; parallel FMA chains. Before the fix, this would create 6 identical shuffles.
; After the fix, only 1 shuffle is created and reused.

define <8 x float> @fma_parallel_chains(<4 x float> %a0, <4 x float> %a1) {
; CHECK-LABEL: define <8 x float> @fma_parallel_chains(
; CHECK-SAME: <4 x float> [[A0:%.*]], <4 x float> [[A1:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[D0:%.*]] = fadd <4 x float> [[A0]], splat (float -1.000000e+00)
; CHECK-NEXT:    [[D1:%.*]] = fadd <4 x float> [[A1]], splat (float -1.000000e+00)
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x float> [[D0]], <4 x float> [[D1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP2:%.*]] = call <8 x float> @llvm.fma.v8f32(<8 x float> [[TMP1]], <8 x float> splat (float f0x3C6F4682), <8 x float> splat (float f0xBD9B8AF7))
; CHECK-NEXT:    [[TMP3:%.*]] = call <8 x float> @llvm.fma.v8f32(<8 x float> [[TMP2]], <8 x float> [[TMP1]], <8 x float> splat (float f0x3E413BC5))
; CHECK-NEXT:    [[TMP4:%.*]] = call <8 x float> @llvm.fma.v8f32(<8 x float> [[TMP3]], <8 x float> [[TMP1]], <8 x float> splat (float f0xBEA49FBF))
; CHECK-NEXT:    [[TMP5:%.*]] = call <8 x float> @llvm.fma.v8f32(<8 x float> [[TMP4]], <8 x float> [[TMP1]], <8 x float> splat (float f0x3EF18891))
; CHECK-NEXT:    [[TMP6:%.*]] = call <8 x float> @llvm.fma.v8f32(<8 x float> [[TMP5]], <8 x float> [[TMP1]], <8 x float> splat (float f0xBF385F95))
; CHECK-NEXT:    [[RES:%.*]] = call <8 x float> @llvm.fma.v8f32(<8 x float> [[TMP6]], <8 x float> [[TMP1]], <8 x float> splat (float f0x3FB8A83E))
; CHECK-NEXT:    ret <8 x float> [[RES]]
;
  ; First chain operating on %a0
  %d0 = fadd <4 x float> %a0, splat (float -1.000000e+00)
  %l0 = call <4 x float> @llvm.fma.v4f32(<4 x float> %d0, <4 x float> splat (float 0x3F8DE8D040000000), <4 x float> splat (float 0xBFB3715EE0000000))
  %l1 = call <4 x float> @llvm.fma.v4f32(<4 x float> %l0, <4 x float> %d0, <4 x float> splat (float 0x3FC82778A0000000))
  %l2 = call <4 x float> @llvm.fma.v4f32(<4 x float> %l1, <4 x float> %d0, <4 x float> splat (float 0xBFD493F7E0000000))
  %l3 = call <4 x float> @llvm.fma.v4f32(<4 x float> %l2, <4 x float> %d0, <4 x float> splat (float 0x3FDE311220000000))
  %l4 = call <4 x float> @llvm.fma.v4f32(<4 x float> %l3, <4 x float> %d0, <4 x float> splat (float 0xBFE70BF2A0000000))
  %l5 = call <4 x float> @llvm.fma.v4f32(<4 x float> %l4, <4 x float> %d0, <4 x float> splat (float 0x3FF71507C0000000))

  ; Second chain operating on %a1 (parallel to first)
  %d1 = fadd <4 x float> %a1, splat (float -1.000000e+00)
  %h0 = call <4 x float> @llvm.fma.v4f32(<4 x float> %d1, <4 x float> splat (float 0x3F8DE8D040000000), <4 x float> splat (float 0xBFB3715EE0000000))
  %h1 = call <4 x float> @llvm.fma.v4f32(<4 x float> %h0, <4 x float> %d1, <4 x float> splat (float 0x3FC82778A0000000))
  %h2 = call <4 x float> @llvm.fma.v4f32(<4 x float> %h1, <4 x float> %d1, <4 x float> splat (float 0xBFD493F7E0000000))
  %h3 = call <4 x float> @llvm.fma.v4f32(<4 x float> %h2, <4 x float> %d1, <4 x float> splat (float 0x3FDE311220000000))
  %h4 = call <4 x float> @llvm.fma.v4f32(<4 x float> %h3, <4 x float> %d1, <4 x float> splat (float 0xBFE70BF2A0000000))
  %h5 = call <4 x float> @llvm.fma.v4f32(<4 x float> %h4, <4 x float> %d1, <4 x float> splat (float 0x3FF71507C0000000))

  ; Concatenate results
  %res = shufflevector <4 x float> %l5, <4 x float> %h5, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  ret <8 x float> %res
}

; Verify that shuffle deduplication does not reuse shuffles across parallel
; blocks (block3 and block4), which would create dominance violations.
define <8 x i32> @no_shuffle_reuse_across_parallel_blocks(<4 x i32> %0, <4 x i32> %1, <4 x i32> %2, <4 x i32> %3) {
; CHECK-LABEL: define <8 x i32> @no_shuffle_reuse_across_parallel_blocks(
; CHECK-SAME: <4 x i32> [[TMP0:%.*]], <4 x i32> [[TMP1:%.*]], <4 x i32> [[TMP2:%.*]], <4 x i32> [[TMP3:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[V0:%.*]] = add <4 x i32> [[TMP0]], [[TMP1]]
; CHECK-NEXT:    br label %[[BLOCK2:.*]]
; CHECK:       [[BLOCK2]]:
; CHECK-NEXT:    [[V1:%.*]] = add <4 x i32> [[TMP2]], [[TMP3]]
; CHECK-NEXT:    br i1 true, label %[[BLOCK3:.*]], label %[[BLOCK4:.*]]
; CHECK:       [[BLOCK3]]:
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x i32> [[V0]], <4 x i32> [[V1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <4 x i32> [[V1]], <4 x i32> [[V0]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP6:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP4]], <8 x i32> [[TMP5]])
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[BLOCK4]]:
; CHECK-NEXT:    [[TMP7:%.*]] = shufflevector <4 x i32> [[V0]], <4 x i32> [[V1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP8:%.*]] = shufflevector <4 x i32> [[V1]], <4 x i32> [[V0]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP9:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP7]], <8 x i32> [[TMP8]])
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[RES:%.*]] = phi <8 x i32> [ [[TMP6]], %[[BLOCK3]] ], [ [[TMP9]], %[[BLOCK4]] ]
; CHECK-NEXT:    ret <8 x i32> [[RES]]
;
entry:
  %v0 = add <4 x i32> %0, %1
  br label %block2

block2:
  %v1 = add <4 x i32> %2, %3
  br i1 true, label %block3, label %block4

block3:
  %4 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v0, <4 x i32> %v1)
  %5 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v1, <4 x i32> %v0)
  %6 = shufflevector <4 x i32> %4, <4 x i32> %5, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  br label %end

block4:
  %7 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v0, <4 x i32> %v1)
  %8 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v1, <4 x i32> %v0)
  %9 = shufflevector <4 x i32> %7, <4 x i32> %8, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  br label %end

end:
  %res = phi <8 x i32> [ %6, %block3 ], [ %9, %block4 ]
  ret <8 x i32> %res
}

; Operands sharing a common dominating block is not by itself enough to allow
; reuse: the two candidate shuffles sit in incomparable blocks, so neither is
; usable at the other's position and each block keeps its own copy. This is
; the shape the earlier "operands share a parent block" heuristic got wrong.
define <8 x i32> @no_reuse_incomparable_blocks_common_operands(<4 x i32> %arg0, <4 x i32> %arg1, <4 x i32> %arg2, <4 x i32> %arg3) {
; CHECK-LABEL: define <8 x i32> @no_reuse_incomparable_blocks_common_operands(
; CHECK-SAME: <4 x i32> [[ARG0:%.*]], <4 x i32> [[ARG1:%.*]], <4 x i32> [[ARG2:%.*]], <4 x i32> [[ARG3:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[V0:%.*]] = add <4 x i32> [[ARG0]], [[ARG1]]
; CHECK-NEXT:    [[V1:%.*]] = add <4 x i32> [[ARG2]], [[ARG3]]
; CHECK-NEXT:    br i1 true, label %[[BLOCK2:.*]], label %[[BLOCK3:.*]]
; CHECK:       [[BLOCK2]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shufflevector <4 x i32> [[V0]], <4 x i32> [[V1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x i32> [[V1]], <4 x i32> [[V0]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP2:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP0]], <8 x i32> [[TMP1]])
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[BLOCK3]]:
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x i32> [[V0]], <4 x i32> [[V1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x i32> [[V1]], <4 x i32> [[V0]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP5:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP3]], <8 x i32> [[TMP4]])
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[RES:%.*]] = phi <8 x i32> [ [[TMP2]], %[[BLOCK2]] ], [ [[TMP5]], %[[BLOCK3]] ]
; CHECK-NEXT:    ret <8 x i32> [[RES]]
;
entry:
  %v0 = add <4 x i32> %arg0, %arg1
  %v1 = add <4 x i32> %arg2, %arg3
  br i1 true, label %block2, label %block3

block2:
  %4 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v0, <4 x i32> %v1)
  %5 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v1, <4 x i32> %v0)
  %6 = shufflevector <4 x i32> %4, <4 x i32> %5, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  br label %end

block3:
  %7 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v0, <4 x i32> %v1)
  %8 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v1, <4 x i32> %v0)
  %9 = shufflevector <4 x i32> %7, <4 x i32> %8, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  br label %end

end:
  %res = phi <8 x i32> [ %6, %block2 ], [ %9, %block3 ]
  ret <8 x i32> %res
}

; A shuffle in a dominating block is reusable from a dominated one, so %next
; picks up the pair built in %entry instead of building its own. Reuse is
; driven by dominance between the shuffles, not by where the operands live.
define <8 x i32> @reuse_across_dominating_block(<4 x i32> %arg0, <4 x i32> %arg1, <4 x i32> %arg2, <4 x i32> %arg3) {
; CHECK-LABEL: define <8 x i32> @reuse_across_dominating_block(
; CHECK-SAME: <4 x i32> [[ARG0:%.*]], <4 x i32> [[ARG1:%.*]], <4 x i32> [[ARG2:%.*]], <4 x i32> [[ARG3:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[V0:%.*]] = add <4 x i32> [[ARG0]], [[ARG1]]
; CHECK-NEXT:    [[V1:%.*]] = add <4 x i32> [[ARG2]], [[ARG3]]
; CHECK-NEXT:    [[TMP0:%.*]] = shufflevector <4 x i32> [[V0]], <4 x i32> [[V1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x i32> [[V1]], <4 x i32> [[V0]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[S1:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP0]], <8 x i32> [[TMP1]])
; CHECK-NEXT:    br label %[[NEXT:.*]]
; CHECK:       [[NEXT]]:
; CHECK-NEXT:    [[S2:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP0]], <8 x i32> [[TMP1]])
; CHECK-NEXT:    [[R:%.*]] = add <8 x i32> [[S1]], [[S2]]
; CHECK-NEXT:    ret <8 x i32> [[R]]
;
entry:
  %v0 = add <4 x i32> %arg0, %arg1
  %v1 = add <4 x i32> %arg2, %arg3
  %a = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v0, <4 x i32> %v1)
  %b = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v1, <4 x i32> %v0)
  %s1 = shufflevector <4 x i32> %a, <4 x i32> %b, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  br label %next

next:
  %c = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v0, <4 x i32> %v1)
  %d = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %v1, <4 x i32> %v0)
  %s2 = shufflevector <4 x i32> %c, <4 x i32> %d, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %r = add <8 x i32> %s1, %s2
  ret <8 x i32> %r
}

; An operand defined by a PHI must not cause the reused shuffle to be placed
; in the middle of the PHI run at the top of the block.
; Reduced from a report by @dtcxzyw on llvm/llvm-project#182768.
define <16 x float> @shuffle_operand_is_phi() {
; CHECK-LABEL: define <16 x float> @shuffle_operand_is_phi(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <8 x float> [ zeroinitializer, %[[ENTRY]] ]
; CHECK-NEXT:    [[VEC_IND58:%.*]] = phi <8 x float> [ zeroinitializer, %[[ENTRY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = shufflevector <8 x float> zeroinitializer, <8 x float> [[VEC_IND]], <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
; CHECK-NEXT:    [[TMP1:%.*]] = fsub <16 x float> zeroinitializer, [[TMP0]]
; CHECK-NEXT:    ret <16 x float> [[TMP1]]
;
entry:
  br label %vector.body

vector.body:
  %vec.ind = phi <8 x float> [ zeroinitializer, %entry ]
  %vec.ind58 = phi <8 x float> [ zeroinitializer, %entry ]
  %0 = call <8 x float> @llvm.fabs.v8f32(<8 x float> zeroinitializer)
  %1 = fsub <8 x float> zeroinitializer, %0
  %2 = call <8 x float> @llvm.fabs.v8f32(<8 x float> %vec.ind)
  %3 = fsub <8 x float> zeroinitializer, %2
  %4 = shufflevector <8 x float> %1, <8 x float> %3, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  ret <16 x float> %4
}

; An operand defined by a value-producing terminator (invoke) has no insertion
; point after it in its own block. The reused shuffle must land in the normal
; destination instead of running off the end of the defining block.
define <8 x i32> @shuffle_operand_is_invoke(<4 x i32> %b, <4 x i32> %c) personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: define <8 x i32> @shuffle_operand_is_invoke(
; CHECK-SAME: <4 x i32> [[B:%.*]], <4 x i32> [[C:%.*]]) #[[ATTR0]] personality ptr @__gxx_personality_v0 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = invoke <4 x i32> @get()
; CHECK-NEXT:            to label %[[CONT:.*]] unwind label %[[LPAD:.*]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shufflevector <4 x i32> [[A]], <4 x i32> [[A]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x i32> [[B]], <4 x i32> [[C]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[R:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP0]], <8 x i32> [[TMP1]])
; CHECK-NEXT:    ret <8 x i32> [[R]]
; CHECK:       [[LPAD]]:
; CHECK-NEXT:    [[L:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    ret <8 x i32> zeroinitializer
;
entry:
  %a = invoke <4 x i32> @get()
  to label %cont unwind label %lpad

cont:
  %x = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %a, <4 x i32> %b)
  %y = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %a, <4 x i32> %c)
  %r = shufflevector <4 x i32> %x, <4 x i32> %y, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  ret <8 x i32> %r

lpad:
  %l = landingpad { ptr, i32 }
  cleanup
  ret <8 x i32> zeroinitializer
}

; ConstantData (splats, zeroinitializer, ...) is uniqued per-context and does
; not track its users, so the reuse scan must not walk the use list of a
; constant operand.
define <8 x i32> @constant_operand_pair(<4 x i32> %a0, <4 x i32> %a1) {
; CHECK-LABEL: define <8 x i32> @constant_operand_pair(
; CHECK-SAME: <4 x i32> [[A0:%.*]], <4 x i32> [[A1:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x i32> [[A0]], <4 x i32> [[A1]], <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[R:%.*]] = call <8 x i32> @llvm.smax.v8i32(<8 x i32> [[TMP1]], <8 x i32> splat (i32 7))
; CHECK-NEXT:    ret <8 x i32> [[R]]
;
  %s0 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %a0, <4 x i32> splat (i32 7))
  %s1 = call <4 x i32> @llvm.smax.v4i32(<4 x i32> %a1, <4 x i32> splat (i32 7))
  %r = shufflevector <4 x i32> %s0, <4 x i32> %s1, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  ret <8 x i32> %r
}

declare <4 x i32> @get()
declare i32 @__gxx_personality_v0(...)
declare <8 x float> @llvm.fabs.v8f32(<8 x float>)
declare <4 x float> @llvm.fma.v4f32(<4 x float>, <4 x float>, <4 x float>)
declare <4 x i32> @llvm.smax.v4i32(<4 x i32>, <4 x i32>)
