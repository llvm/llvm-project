; CHECK-SAME: ptr [[P:%.*]], ptr noalias [[Q:%.*]], <2 x float> [[A:%.*]], <2 x float> [[B:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[P8:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 8
; CHECK-NEXT:    store <2 x float> [[A]], ptr [[P]], align 8
; CHECK-NEXT:    call void @touch(ptr [[Q]])
; CHECK-NEXT:    store <2 x float> [[B]], ptr [[P8]], align 8
; CHECK-NEXT:    ret void
;
  %p8 = getelementptr inbounds i8, ptr %p, i64 8
  store <2 x float> %a, ptr %p, align 8
  call void @touch(ptr %q)
  store <2 x float> %b, ptr %p8, align 8
  ret void
}

declare void @touch(ptr) nounwind willreturn memory(argmem: readwrite)

; Mixed vector/scalar packing is excluded even for pieces of the same vector.
define void @mixed(ptr %p, <4 x float> %x) #0 {
; CHECK-LABEL: define void @mixed(
; CHECK-SAME: ptr [[P:%.*]], <4 x float> [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[LO:%.*]] = shufflevector <4 x float> [[X]], <4 x float> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    [[V2:%.*]] = extractelement <4 x float> [[X]], i64 2
; CHECK-NEXT:    [[V3:%.*]] = extractelement <4 x float> [[X]], i64 3
; CHECK-NEXT:    [[P8:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 8
; CHECK-NEXT:    [[P12:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 12
; CHECK-NEXT:    store <2 x float> [[LO]], ptr [[P]], align 4
; CHECK-NEXT:    store float [[V2]], ptr [[P8]], align 4
; CHECK-NEXT:    store float [[V3]], ptr [[P12]], align 4
; CHECK-NEXT:    ret void
;
  %lo = shufflevector <4 x float> %x, <4 x float> poison, <2 x i32> <i32 0, i32 1>
  %v2 = extractelement <4 x float> %x, i64 2
  %v3 = extractelement <4 x float> %x, i64 3
  %p8 = getelementptr inbounds i8, ptr %p, i64 8
  %p12 = getelementptr inbounds i8, ptr %p, i64 12
  store <2 x float> %lo, ptr %p, align 4
  store float %v2, ptr %p8, align 4
  store float %v3, ptr %p12, align 4
  ret void
}

; Different vector sizes do not match the equal-vector pair fold.
define void @unequal_vectors(ptr %p, <8 x float> %x) #1 {
; CHECK-LABEL: define void @unequal_vectors(
; CHECK-SAME: ptr [[P:%.*]], <8 x float> [[X:%.*]]) #[[ATTR5:[0-9]+]] {
; CHECK-NEXT:    [[LO:%.*]] = shufflevector <8 x float> [[X]], <8 x float> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    [[HI:%.*]] = shufflevector <8 x float> [[X]], <8 x float> poison, <6 x i32> <i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
; CHECK-NEXT:    [[P8:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 8
; CHECK-NEXT:    store <2 x float> [[LO]], ptr [[P]], align 4
; CHECK-NEXT:    store <6 x float> [[HI]], ptr [[P8]], align 4
; CHECK-NEXT:    ret void
;
  %lo = shufflevector <8 x float> %x, <8 x float> poison, <2 x i32> <i32 0, i32 1>
  %hi = shufflevector <8 x float> %x, <8 x float> poison, <6 x i32> <i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %p8 = getelementptr inbounds i8, ptr %p, i64 8
  store <2 x float> %lo, ptr %p, align 4
  store <6 x float> %hi, ptr %p8, align 4
  ret void
}

; The new wide store must be revisited in the same invocation so the existing
; insert-element store fold can reduce this update to one scalar store.
define void @revisit_new_store(ptr %p, float %x) #0 {
; CHECK-LABEL: define void @revisit_new_store(
; CHECK-SAME: ptr [[P:%.*]], float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds <4 x float>, ptr [[P]], i64 0, i64 1
; CHECK-NEXT:    store float [[X]], ptr [[TMP1]], align 4
; CHECK-NEXT:    ret void
;
  %old = load <4 x float>, ptr %p, align 4
  %updated = insertelement <4 x float> %old, float %x, i32 1
  %lo = shufflevector <4 x float> %updated, <4 x float> poison, <2 x i32> <i32 0, i32 1>
  %hi = shufflevector <4 x float> %updated, <4 x float> poison, <2 x i32> <i32 2, i32 3>
  %p8 = getelementptr inbounds i8, ptr %p, i64 8
  store <2 x float> %lo, ptr %p, align 4
  store <2 x float> %hi, ptr %p8, align 4
  ret void
}

; Nontemporal metadata must keep the stores separate despite the free fold.
define void @nontemporal(ptr %p, <4 x float> %x) #0 {
; CHECK-LABEL: define void @nontemporal(
; CHECK-SAME: ptr [[P:%.*]], <4 x float> [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[LO:%.*]] = shufflevector <4 x float> [[X]], <4 x float> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    [[HI:%.*]] = shufflevector <4 x float> [[X]], <4 x float> poison, <2 x i32> <i32 2, i32 3>
; CHECK-NEXT:    [[P8:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 8
; CHECK-NEXT:    store <2 x float> [[LO]], ptr [[P]], align 4, !nontemporal [[META0:![0-9]+]]
; CHECK-NEXT:    store <2 x float> [[HI]], ptr [[P8]], align 4
; CHECK-NEXT:    ret void
;
  %lo = shufflevector <4 x float> %x, <4 x float> poison, <2 x i32> <i32 0, i32 1>
  %hi = shufflevector <4 x float> %x, <4 x float> poison, <2 x i32> <i32 2, i32 3>
  %p8 = getelementptr inbounds i8, ptr %p, i64 8
  store <2 x float> %lo, ptr %p, align 4, !nontemporal !0
  store <2 x float> %hi, ptr %p8, align 4
  ret void
}

