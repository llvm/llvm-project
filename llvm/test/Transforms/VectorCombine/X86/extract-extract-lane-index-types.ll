; RUN: opt -passes=vector-combine -S -mtriple=x86_64-- < %s | FileCheck %s

; Extracts of the same lane with different index types must count as one lane.
; Otherwise the lane is considered unextracted, the poison lanes are not all
; consumed, and the freeze is skipped.

define i8 @same_lane_different_index_types(i4 %x) {
; CHECK-LABEL: define i8 @same_lane_different_index_types(
; CHECK-SAME: i4 [[X:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = insertelement <2 x i4> poison, i4 [[X]], i64 1
; CHECK-NEXT:    [[TMP1:%.*]] = freeze <2 x i4> [[V]]
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <2 x i4> [[TMP1]] to i8
; CHECK-NEXT:    [[TMP3:%.*]] = lshr i8 [[TMP2]], 4
; CHECK-NEXT:    [[TMP4:%.*]] = lshr i8 [[TMP2]], 4
; CHECK-NEXT:    [[Z:%.*]] = zext <2 x i4> [[V]] to <2 x i8>
; CHECK-NEXT:    [[E0:%.*]] = extractelement <2 x i8> [[Z]], i32 1
; CHECK-NEXT:    [[E1:%.*]] = extractelement <2 x i8> [[Z]], i64 1
; CHECK-NEXT:    [[D0:%.*]] = udiv i8 100, [[TMP4]]
; CHECK-NEXT:    [[D1:%.*]] = udiv i8 100, [[TMP3]]
; CHECK-NEXT:    [[R:%.*]] = add i8 [[D0]], [[D1]]
; CHECK-NEXT:    ret i8 [[R]]
;
  %v = insertelement <2 x i4> poison, i4 %x, i64 1
  %z = zext <2 x i4> %v to <2 x i8>
  %e0 = extractelement <2 x i8> %z, i32 1
  %e1 = extractelement <2 x i8> %z, i64 1
  %d0 = udiv i8 100, %e0
  %d1 = udiv i8 100, %e1
  %r = add i8 %d0, %d1
  ret i8 %r
}
