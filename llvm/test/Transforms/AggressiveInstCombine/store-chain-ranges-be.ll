; Positive tests

; The first byte and the next bit are replaced. The second update takes
; its preserved bits from the first one.
define void @contiguous(ptr %p, i16 %x, i16 %y) {
; CHECK-LABEL: define void @contiguous(
; CHECK-SAME: ptr [[P:%.*]], i16 [[X:%.*]], i16 [[Y:%.*]]) {
; CHECK-NEXT:    [[OLD:%.*]] = load i16, ptr [[P]], align 1
; CHECK-NEXT:    [[KEEP_FIRST:%.*]] = and i16 [[OLD]], 255
; CHECK-NEXT:    [[INSERT_FIRST:%.*]] = and i16 [[X]], -256
; CHECK-NEXT:    [[FIRST:%.*]] = or disjoint i16 [[KEEP_FIRST]], [[INSERT_FIRST]]
; CHECK-NEXT:    [[KEEP_SECOND:%.*]] = and i16 [[FIRST]], -129
; CHECK-NEXT:    [[INSERT_SECOND:%.*]] = and i16 [[Y]], 128
; CHECK-NEXT:    [[SECOND:%.*]] = or disjoint i16 [[KEEP_SECOND]], [[INSERT_SECOND]]
; CHECK-NEXT:    store i16 [[SECOND]], ptr [[P]], align 1
; CHECK-NEXT:    ret void
;
  %old = load i16, ptr %p, align 1
  %keep.first = and i16 %old, -65281
  %insert.first = and i16 %x, 65280
  %first = or disjoint i16 %keep.first, %insert.first
  store i16 %first, ptr %p, align 1

  %keep.second = and i16 %first, -129
  %insert.second = and i16 %y, 128
  %second = or disjoint i16 %keep.second, %insert.second
  store i16 %second, ptr %p, align 1
  ret void
}

; The first nine bits in address order come from the high nine bits of %x.
