; CHECK-SAME: ptr [[P:%.*]], i16 [[X:%.*]], i16 [[SEED:%.*]]) {
; CHECK-NEXT:    [[OLD:%.*]] = load i16, ptr [[P]], align 1
; CHECK-NEXT:    [[LOW_KEEP:%.*]] = and i16 [[OLD]], 255
; CHECK-NEXT:    [[LOW_INSERT:%.*]] = and i16 [[X]], -256
; CHECK-NEXT:    [[LOW:%.*]] = or disjoint i16 [[LOW_KEEP]], [[LOW_INSERT]]
; CHECK-NEXT:    store i16 [[LOW]], ptr [[P]], align 1
; CHECK-NEXT:    store i16 [[SEED]], ptr [[P]], align 1
; CHECK-NEXT:    [[BIT_KEEP:%.*]] = and i16 [[SEED]], -129
; CHECK-NEXT:    [[BIT_INSERT:%.*]] = and i16 [[X]], 128
; CHECK-NEXT:    [[BIT:%.*]] = or disjoint i16 [[BIT_KEEP]], [[BIT_INSERT]]
; CHECK-NEXT:    [[HIGH_KEEP:%.*]] = and i16 [[BIT]], -65
; CHECK-NEXT:    [[HIGH_INSERT:%.*]] = and i16 [[X]], 64
; CHECK-NEXT:    [[HIGH:%.*]] = or disjoint i16 [[HIGH_KEEP]], [[HIGH_INSERT]]
; CHECK-NEXT:    store i16 [[HIGH]], ptr [[P]], align 1
; CHECK-NEXT:    ret void
;
  %old = load i16, ptr %p, align 1
  %low.keep = and i16 %old, 255
  %low.insert = and i16 %x, 65280
  %low = or disjoint i16 %low.keep, %low.insert
  store i16 %low, ptr %p, align 1

  %full.keep = and i16 %low, 0
  %full = or disjoint i16 %full.keep, %seed
  store i16 %full, ptr %p, align 1

  %bit.keep = and i16 %full, -129
  %bit.insert = and i16 %x, 128
  %bit = or disjoint i16 %bit.keep, %bit.insert
  store i16 %bit, ptr %p, align 1

  %high.keep = and i16 %bit, -65
  %high.insert = and i16 %x, 64
  %high = or disjoint i16 %high.keep, %high.insert
  store i16 %high, ptr %p, align 1
  ret void
}

