  %byte.keep = and i16 %old, 255
  %byte.insert = and i16 %x, -256
  %first = or disjoint i16 %byte.keep, %byte.insert
  store i16 %first, ptr %p, align 2
  store i16 %x, ptr %q, align 2
  %bit.keep = and i16 %first, -129
  %bit.insert = and i16 %x, 128
  %second = or disjoint i16 %bit.keep, %bit.insert
  store i16 %second, ptr %p, align 2
  ret void
}

; The whole-word update separates %low from the following two bit updates.
