; CHECK-NEXT:    store i8 [[NARROW]], ptr [[P]], align 1
; CHECK-NEXT:    ret void
;
  %old.word = load i16, ptr %p, align 1
  %old.high = lshr i16 %old.word, 8
  %old.byte = trunc i16 %old.high to i8

  %wide.keep = and i16 %old.word, -129
