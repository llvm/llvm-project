; CHECK-NEXT:    [[R1:%.*]] = insertvalue { float, i32 } [[R0]], i32 [[IDX]], 1
; CHECK-NEXT:    ret { float, i32 } [[R1]]
;
entry:
  %y = call float @llvm.floor.f32(float %x)
  %i = fptosi float %y to i32
  %c = icmp sgt i32 %i, %n
  br i1 %c, label %clip, label %join
clip:
  %nd = sitofp i32 %n to float
  %xc = fdiv float %nd, %inv
  %yc = call float @llvm.floor.f32(float %xc)
  br label %join
join:
  %rx = phi float [ %x, %entry ], [ %xc, %clip ]
  %ry = phi float [ %y, %entry ], [ %yc, %clip ]
  %idx = phi i32 [ %i, %entry ], [ %n, %clip ]
  %frac = fsub float %rx, %ry
  %r0 = insertvalue { float, i32 } poison, float %frac, 0
  %r1 = insertvalue { float, i32 } %r0, i32 %idx, 1
  ret { float, i32 } %r1
}
declare float @llvm.floor.f32(float)
attributes #0 = { "target-features"="+d" }
attributes #1 = { strictfp "target-features"="+d" }

define double @strict_call(double %x, i32 %n) #0 {
; CHECK-LABEL: define double @strict_call(
; CHECK-SAME: double [[X:%.*]], i32 [[N:%.*]]) #[[ATTR2]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[Y:%.*]] = call double @llvm.floor.f64(double [[X]]) #[[ATTR5:[0-9]+]]
; CHECK-NEXT:    [[I:%.*]] = fptosi double [[Y]] to i32
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[N]], [[I]]
; CHECK-NEXT:    br i1 [[C]], label %[[YES:.*]], label %[[NO:.*]]
; CHECK:       [[YES]]:
; CHECK-NEXT:    [[FRAC:%.*]] = fsub double [[X]], [[Y]]
; CHECK-NEXT:    ret double [[FRAC]]
; CHECK:       [[NO]]:
; CHECK-NEXT:    ret double 2.000000e+00
;
entry:
  %y = call double @llvm.floor.f64(double %x) #2
  %i = fptosi double %y to i32
  %c = icmp sgt i32 %i, %n
  br i1 %c, label %yes, label %no
yes:
  %frac = fsub double %x, %y
  ret double %frac
no:
