; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=aggressive-instcombine -mtriple=x86_64 -S | FileCheck %s

declare void @may_not_return() nounwind memory(none)
declare void @may_throw() willreturn memory(none)
declare void @will_return() nounwind willreturn memory(inaccessiblemem: readwrite)

; The second byte need not be dereferenceable if the call does not return.
define i16 @load_across_may_not_return(ptr %p) {
; CHECK-LABEL: @load_across_may_not_return(
; CHECK-NEXT:    [[LO:%.*]] = load i8, ptr [[P:%.*]], align 1
; CHECK-NEXT:    call void @may_not_return()
; CHECK-NEXT:    [[P1:%.*]] = getelementptr i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[HI:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    [[LO_EXT:%.*]] = zext i8 [[LO]] to i16
; CHECK-NEXT:    [[HI_EXT:%.*]] = zext i8 [[HI]] to i16
; CHECK-NEXT:    [[HI_SHL:%.*]] = shl i16 [[HI_EXT]], 8
; CHECK-NEXT:    [[R:%.*]] = or i16 [[LO_EXT]], [[HI_SHL]]
; CHECK-NEXT:    ret i16 [[R]]
;
  %lo = load i8, ptr %p, align 1
  call void @may_not_return()
  %p1 = getelementptr i8, ptr %p, i64 1
  %hi = load i8, ptr %p1, align 1
  %lo.ext = zext i8 %lo to i16
  %hi.ext = zext i8 %hi to i16
  %hi.shl = shl i16 %hi.ext, 8
  %r = or i16 %lo.ext, %hi.shl
  ret i16 %r
}

; willreturn alone does not rule out unwinding before the second load.
define i16 @load_across_may_throw(ptr %p) {
; CHECK-LABEL: @load_across_may_throw(
; CHECK-NEXT:    [[LO:%.*]] = load i8, ptr [[P:%.*]], align 1
; CHECK-NEXT:    call void @may_throw()
; CHECK-NEXT:    [[P1:%.*]] = getelementptr i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[HI:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    [[LO_EXT:%.*]] = zext i8 [[LO]] to i16
; CHECK-NEXT:    [[HI_EXT:%.*]] = zext i8 [[HI]] to i16
; CHECK-NEXT:    [[HI_SHL:%.*]] = shl i16 [[HI_EXT]], 8
; CHECK-NEXT:    [[R:%.*]] = or i16 [[LO_EXT]], [[HI_SHL]]
; CHECK-NEXT:    ret i16 [[R]]
;
  %lo = load i8, ptr %p, align 1
  call void @may_throw()
  %p1 = getelementptr i8, ptr %p, i64 1
  %hi = load i8, ptr %p1, align 1
  %lo.ext = zext i8 %lo to i16
  %hi.ext = zext i8 %hi to i16
  %hi.shl = shl i16 %hi.ext, 8
  %r = or i16 %lo.ext, %hi.shl
  ret i16 %r
}

; A call guaranteed to reach its successor must not prevent merging.
define i16 @load_across_will_return(ptr %p) {
; CHECK-LABEL: @load_across_will_return(
; CHECK-NEXT:    [[LO:%.*]] = load i16, ptr [[P:%.*]], align 1
; CHECK-NEXT:    call void @will_return()
; CHECK-NEXT:    ret i16 [[LO]]
;
  %lo = load i8, ptr %p, align 1
  call void @will_return()
  %p1 = getelementptr i8, ptr %p, i64 1
  %hi = load i8, ptr %p1, align 1
  %lo.ext = zext i8 %lo to i16
  %hi.ext = zext i8 %hi to i16
  %hi.shl = shl i16 %hi.ext, 8
  %r = or i16 %lo.ext, %hi.shl
  ret i16 %r
}

; Check the opposite order of the loads and OR operands as well.
define i16 @load_across_may_not_return_reverse(ptr %p) {
; CHECK-LABEL: @load_across_may_not_return_reverse(
; CHECK-NEXT:    [[P1:%.*]] = getelementptr i8, ptr [[P:%.*]], i64 1
; CHECK-NEXT:    [[HI:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    call void @may_not_return()
; CHECK-NEXT:    [[LO:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[LO_EXT:%.*]] = zext i8 [[LO]] to i16
; CHECK-NEXT:    [[HI_EXT:%.*]] = zext i8 [[HI]] to i16
; CHECK-NEXT:    [[HI_SHL:%.*]] = shl i16 [[HI_EXT]], 8
; CHECK-NEXT:    [[R:%.*]] = or i16 [[HI_SHL]], [[LO_EXT]]
; CHECK-NEXT:    ret i16 [[R]]
;
  %p1 = getelementptr i8, ptr %p, i64 1
  %hi = load i8, ptr %p1, align 1
  call void @may_not_return()
  %lo = load i8, ptr %p, align 1
  %lo.ext = zext i8 %lo to i16
  %hi.ext = zext i8 %hi to i16
  %hi.shl = shl i16 %hi.ext, 8
  %r = or i16 %hi.shl, %lo.ext
  ret i16 %r
}

; The check also applies when extending an already matched load chain.
define i32 @load_chain_across_may_not_return(ptr %p) {
; CHECK-LABEL: @load_chain_across_may_not_return(
; CHECK-NEXT:    [[LO:%.*]] = load i16, ptr [[P:%.*]], align 1
; CHECK-NEXT:    [[TMP1:%.*]] = zext i16 [[LO]] to i32
; CHECK-NEXT:    call void @may_not_return()
; CHECK-NEXT:    [[P2:%.*]] = getelementptr i8, ptr [[P]], i64 2
; CHECK-NEXT:    [[HI:%.*]] = load i16, ptr [[P2]], align 1
; CHECK-NEXT:    [[HI_EXT:%.*]] = zext i16 [[HI]] to i32
; CHECK-NEXT:    [[HI_SHL:%.*]] = shl i32 [[HI_EXT]], 16
; CHECK-NEXT:    [[R:%.*]] = or i32 [[TMP1]], [[HI_SHL]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %lo = load i8, ptr %p, align 1
  %p1 = getelementptr i8, ptr %p, i64 1
  %mid = load i8, ptr %p1, align 1
  call void @may_not_return()
  %p2 = getelementptr i8, ptr %p, i64 2
  %hi = load i16, ptr %p2, align 1
  %lo.ext = zext i8 %lo to i32
  %mid.ext = zext i8 %mid to i32
  %mid.shl = shl i32 %mid.ext, 8
  %lo.or = or i32 %lo.ext, %mid.shl
  %hi.ext = zext i16 %hi to i32
  %hi.shl = shl i32 %hi.ext, 16
  %r = or i32 %lo.or, %hi.shl
  ret i32 %r
}
