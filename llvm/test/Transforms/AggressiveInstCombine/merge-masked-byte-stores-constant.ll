; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='aggressive-instcombine,gvn,instcombine,dse' -S < %s | FileCheck %s

target datalayout = "e-p:64:64"

@left = global i16 0, align 2
@right = global i16 0, align 2
@go = external global i32
@done = external global i32

declare void @handoff(ptr, ptr) memory(argmem: readwrite) nounwind willreturn

; The temporary object's initializer makes its low byte constant before the
; bit swap is inlined. Its uninitialized high bits can be poison.
define void @swap_with_constant_byte(ptr noalias %a, ptr noalias %out, i16 %old) {
; CHECK-LABEL: define void @swap_with_constant_byte(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[OUT:%.*]], i16 [[OLD:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[OLD_FR:%.*]] = freeze i16 [[OLD]]
; CHECK-NEXT:    [[A_OLD:%.*]] = load i16, ptr [[A]], align 2
; CHECK-NEXT:    [[TMP0:%.*]] = and i16 [[A_OLD]], -512
; CHECK-NEXT:    [[KEEP:%.*]] = and i16 [[OLD_FR]], -512
; CHECK-NEXT:    [[TMP1:%.*]] = or disjoint i16 [[TMP0]], 260
; CHECK-NEXT:    [[TMP2:%.*]] = and i16 [[A_OLD]], 511
; CHECK-NEXT:    [[TMP3:%.*]] = or disjoint i16 [[KEEP]], [[TMP2]]
; CHECK-NEXT:    store i16 [[TMP1]], ptr [[A]], align 2
; CHECK-NEXT:    store i16 [[TMP3]], ptr [[OUT]], align 2
; CHECK-NEXT:    ret void
;
entry:
  %b = alloca i16, align 2
  %keep = and i16 %old, -512
  %initial = or disjoint i16 %keep, 260
  store i16 %initial, ptr %b, align 2
  br label %swap

swap:
  %a.old = load i16, ptr %a, align 2
  %byte = trunc i16 %a.old to i8
  store i8 4, ptr %a, align 2
  store i8 %byte, ptr %b, align 2
  %a.reload = load i16, ptr %a, align 2
  %b.reload = load i16, ptr %b, align 2
  %a.bit = and i16 %a.reload, 256
  %b.bit = and i16 %b.reload, 256
  %a.keep = and i16 %a.reload, -257
  %b.keep = and i16 %b.reload, -257
  %a.new = or disjoint i16 %a.keep, %b.bit
  %b.new = or disjoint i16 %b.keep, %a.bit
  store i16 %a.new, ptr %a, align 2
  store i16 %b.new, ptr %b, align 2
  %result = load i16, ptr %b, align 2
  store i16 %result, ptr %out, align 2
  ret void
}

; The call can synchronize with a thread that modifies @right. Its memory
; effects alone do not prove that @right retains the initializer.
define void @swap_with_shared_initializer() {
; CHECK-LABEL: define void @swap_with_shared_initializer() {
; CHECK-NEXT:    store i16 260, ptr @right, align 2
; CHECK-NEXT:    call void @handoff(ptr nonnull @go, ptr nonnull @done)
; CHECK-NEXT:    [[LEFT_ORIGINAL:%.*]] = load i16, ptr @left, align 2
; CHECK-NEXT:    [[LEFT_BYTE:%.*]] = trunc i16 [[LEFT_ORIGINAL]] to i8
; CHECK-NEXT:    store i8 4, ptr @left, align 2
; CHECK-NEXT:    store i8 [[LEFT_BYTE]], ptr @right, align 2
; CHECK-NEXT:    [[LEFT_NEW:%.*]] = load i16, ptr @left, align 2
; CHECK-NEXT:    [[RIGHT_NEW:%.*]] = load i16, ptr @right, align 2
; CHECK-NEXT:    [[LEFT_BIT:%.*]] = and i16 [[LEFT_NEW]], 256
; CHECK-NEXT:    [[RIGHT_BIT:%.*]] = and i16 [[RIGHT_NEW]], 256
; CHECK-NEXT:    [[LEFT_KEEP:%.*]] = and i16 [[LEFT_NEW]], -257
; CHECK-NEXT:    [[RIGHT_KEEP:%.*]] = and i16 [[RIGHT_NEW]], -257
; CHECK-NEXT:    [[LEFT_UPDATED:%.*]] = or disjoint i16 [[LEFT_KEEP]], [[RIGHT_BIT]]
; CHECK-NEXT:    [[RIGHT_UPDATED:%.*]] = or disjoint i16 [[RIGHT_KEEP]], [[LEFT_BIT]]
; CHECK-NEXT:    store i16 [[LEFT_UPDATED]], ptr @left, align 2
; CHECK-NEXT:    store i16 [[RIGHT_UPDATED]], ptr @right, align 2
; CHECK-NEXT:    ret void
;
  store i16 260, ptr @right, align 2
  call void @handoff(ptr @go, ptr @done)
  %left.original = load i16, ptr @left, align 2
  %left.byte = trunc i16 %left.original to i8
  store i8 4, ptr @left, align 2
  store i8 %left.byte, ptr @right, align 2
  %left.new = load i16, ptr @left, align 2
  %right.new = load i16, ptr @right, align 2
  %left.bit = and i16 %left.new, 256
  %right.bit = and i16 %right.new, 256
  %left.keep = and i16 %left.new, -257
  %right.keep = and i16 %right.new, -257
  %left.updated = or disjoint i16 %left.keep, %right.bit
  %right.updated = or disjoint i16 %right.keep, %left.bit
  store i16 %left.updated, ptr @left, align 2
  store i16 %right.updated, ptr @right, align 2
  ret void
}
