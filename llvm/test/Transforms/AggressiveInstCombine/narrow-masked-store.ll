; Both masks must be constants, even when their relationship is explicit.
define void @dynamic_masks(ptr %p, i32 %x, i32 %mask) {
; CHECK-LABEL: define void @dynamic_masks(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i32 [[MASK:%.*]]) {
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[KEEP:%.*]] = xor i32 [[MASK]], -1
; CHECK-NEXT:    [[INSERT:%.*]] = and i32 [[X]], [[MASK]]
; CHECK-NEXT:    [[CLEAR:%.*]] = and i32 [[OLD]], [[KEEP]]
; CHECK-NEXT:    [[NEW:%.*]] = or disjoint i32 [[CLEAR]], [[INSERT]]
; CHECK-NEXT:    store i32 [[NEW]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %old = load i32, ptr %p, align 4
  %keep = xor i32 %mask, -1
  %insert = and i32 %x, %mask
  %clear = and i32 %old, %keep
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr %p, align 4
  ret void
}

; A partial clobber of a preserved byte must also prevent narrowing. Byte 1 is
; preserved on both endiannesses when only the least significant byte changes.
define void @overlapping_byte_store(ptr %p, i32 %x, i8 %clobber) {
; CHECK-LABEL: define void @overlapping_byte_store(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i8 [[CLOBBER:%.*]]) {
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 1
; CHECK-NEXT:    store i8 [[CLOBBER]], ptr [[Q]], align 1
; CHECK-NEXT:    [[INSERT:%.*]] = and i32 [[X]], 255
; CHECK-NEXT:    [[CLEAR:%.*]] = and i32 [[OLD]], -256
; CHECK-NEXT:    [[NEW:%.*]] = or disjoint i32 [[CLEAR]], [[INSERT]]
; CHECK-NEXT:    store i32 [[NEW]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %old = load i32, ptr %p, align 4
  %q = getelementptr inbounds i8, ptr %p, i64 1
  store i8 %clobber, ptr %q, align 1
  %insert = and i32 %x, 255
  %clear = and i32 %old, -256
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr %p, align 4
  ret void
}

; The intervening stores are still clobbers when this pass runs alone.
define void @restored_word(ptr %p, i32 %x, i32 %clobber) {
; CHECK-LABEL: define void @restored_word(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i32 [[CLOBBER:%.*]]) {
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    store i32 [[CLOBBER]], ptr [[P]], align 4
; CHECK-NEXT:    store i32 [[OLD]], ptr [[P]], align 4
; CHECK-NEXT:    [[INSERT:%.*]] = and i32 [[X]], 255
; CHECK-NEXT:    [[CLEAR:%.*]] = and i32 [[OLD]], -256
; CHECK-NEXT:    [[NEW:%.*]] = or disjoint i32 [[CLEAR]], [[INSERT]]
; CHECK-NEXT:    store i32 [[NEW]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %old = load i32, ptr %p, align 4
  store i32 %clobber, ptr %p, align 4
  store i32 %old, ptr %p, align 4
  %insert = and i32 %x, 255
  %clear = and i32 %old, -256
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr %p, align 4
  ret void
}

declare void @read_only(ptr) memory(read)

; A read-only call does not clobber the word. It need not be nounwind: the
; replacement store stays after the call, so an exception bypasses either store.
define void @read_only_call(ptr %p, i32 %x) {
; LE-LABEL: define void @read_only_call(
; LE-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; LE-NEXT:    call void @read_only(ptr [[P]])
; LE-NEXT:    [[TMP1:%.*]] = trunc i32 [[X]] to i8
; LE-NEXT:    store i8 [[TMP1]], ptr [[P]], align 4
; LE-NEXT:    ret void
;
; BE-LABEL: define void @read_only_call(
; BE-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; BE-NEXT:    call void @read_only(ptr [[P]])
; BE-NEXT:    [[TMP1:%.*]] = trunc i32 [[X]] to i8
; BE-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[P]], i64 3
; BE-NEXT:    store i8 [[TMP1]], ptr [[TMP2]], align 1
; BE-NEXT:    ret void
;
  %old = load i32, ptr %p, align 4
  call void @read_only(ptr %p)
  %insert = and i32 %x, 255
  %clear = and i32 %old, -256
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr %p, align 4
  ret void
}

; MemorySSA can skip a provably non-overlapping store.
define void @nonoverlapping_store(ptr %p, i32 %x, i32 %other) {
; LE-LABEL: define void @nonoverlapping_store(
; LE-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i32 [[OTHER:%.*]]) {
; LE-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 4
; LE-NEXT:    store i32 [[OTHER]], ptr [[Q]], align 4
; LE-NEXT:    [[TMP1:%.*]] = trunc i32 [[X]] to i8
; LE-NEXT:    store i8 [[TMP1]], ptr [[P]], align 4
; LE-NEXT:    ret void
;
; BE-LABEL: define void @nonoverlapping_store(
; BE-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i32 [[OTHER:%.*]]) {
; BE-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 4
; BE-NEXT:    store i32 [[OTHER]], ptr [[Q]], align 4
; BE-NEXT:    [[TMP1:%.*]] = trunc i32 [[X]] to i8
; BE-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[P]], i64 3
; BE-NEXT:    store i8 [[TMP1]], ptr [[TMP2]], align 1
; BE-NEXT:    ret void
;
  %old = load i32, ptr %p, align 4
  %q = getelementptr inbounds i8, ptr %p, i64 4
  store i32 %other, ptr %q, align 4
  %insert = and i32 %x, 255
  %clear = and i32 %old, -256
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr %p, align 4
  ret void
}

; The byte GEP preserves the address space and does not strengthen alignment.
define void @address_space(ptr addrspace(1) %p, i32 %x) {
; LE-LABEL: define void @address_space(
; LE-SAME: ptr addrspace(1) [[P:%.*]], i32 [[X:%.*]]) {
; LE-NEXT:    [[TMP1:%.*]] = lshr i32 [[X]], 16
; LE-NEXT:    [[TMP2:%.*]] = trunc i32 [[TMP1]] to i8
; LE-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr addrspace(1) [[P]], i64 2
; LE-NEXT:    store i8 [[TMP2]], ptr addrspace(1) [[TMP3]], align 1
; LE-NEXT:    ret void
;
; BE-LABEL: define void @address_space(
; BE-SAME: ptr addrspace(1) [[P:%.*]], i32 [[X:%.*]]) {
; BE-NEXT:    [[TMP1:%.*]] = lshr i32 [[X]], 16
; BE-NEXT:    [[TMP2:%.*]] = trunc i32 [[TMP1]] to i8
; BE-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr addrspace(1) [[P]], i64 1
; BE-NEXT:    store i8 [[TMP2]], ptr addrspace(1) [[TMP3]], align 1
; BE-NEXT:    ret void
;
  %old = load i32, ptr addrspace(1) %p, align 1
  %insert = and i32 %x, 16711680
  %clear = and i32 %old, -16711681
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr addrspace(1) %p, align 1
  ret void
}

; Select the tbaa.struct field at the new byte address, preserve alias scopes,
; and discard the old whole-word tbaa.struct description.
define void @aa_metadata(ptr %p, i32 %x) {
; LE-LABEL: define void @aa_metadata(
; LE-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; LE-NEXT:    [[TMP1:%.*]] = lshr i32 [[X]], 16
; LE-NEXT:    [[TMP2:%.*]] = trunc i32 [[TMP1]] to i8
; LE-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[P]], i64 2
; LE-NEXT:    store i8 [[TMP2]], ptr [[TMP3]], align 2, !tbaa [[BYTE2_TBAA0:![0-9]+]], !alias.scope [[META3:![0-9]+]], !noalias [[META6:![0-9]+]], !llvm.access.group [[ACC_GRP8:![0-9]+]]
; LE-NEXT:    ret void
;
; BE-LABEL: define void @aa_metadata(
; BE-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; BE-NEXT:    [[TMP1:%.*]] = lshr i32 [[X]], 16
; BE-NEXT:    [[TMP2:%.*]] = trunc i32 [[TMP1]] to i8
; BE-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[P]], i64 1
; BE-NEXT:    store i8 [[TMP2]], ptr [[TMP3]], align 1, !tbaa [[BYTE1_TBAA0:![0-9]+]], !alias.scope [[META3:![0-9]+]], !noalias [[META6:![0-9]+]], !llvm.access.group [[ACC_GRP8:![0-9]+]]
; BE-NEXT:    ret void
;
  %old = load i32, ptr %p, align 4
  %insert = and i32 %x, 16711680
  %clear = and i32 %old, -16711681
  %new = or disjoint i32 %clear, %insert
  store i32 %new, ptr %p, align 4, !tbaa.struct !0, !alias.scope !10, !noalias !13, !llvm.access.group !15
  ret void
}

; The old word is also used by the branch, as in glslang.
define void @cross_block_live_load(ptr %p, i16 %x) {
; LE-LABEL: define void @cross_block_live_load(
; LE-SAME: ptr [[P:%.*]], i16 [[X:%.*]]) {
; LE-NEXT:  [[ENTRY:.*:]]
; LE-NEXT:    [[OLD:%.*]] = load i16, ptr [[P]], align 2
; LE-NEXT:    [[NEEDS_UPDATE:%.*]] = icmp uge i16 [[OLD]], -256
; LE-NEXT:    br i1 [[NEEDS_UPDATE]], label %[[UPDATE:.*]], label %[[EXIT:.*]]
; LE:       [[UPDATE]]:
; LE-NEXT:    [[TMP0:%.*]] = lshr i16 [[X]], 8
; LE-NEXT:    [[TMP1:%.*]] = trunc i16 [[TMP0]] to i8
; LE-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[P]], i64 1
; LE-NEXT:    store i8 [[TMP1]], ptr [[TMP2]], align 1
; LE-NEXT:    br label %[[EXIT]]
; LE:       [[EXIT]]:
; LE-NEXT:    ret void
;
; BE-LABEL: define void @cross_block_live_load(
; BE-SAME: ptr [[P:%.*]], i16 [[X:%.*]]) {
; BE-NEXT:  [[ENTRY:.*:]]
; BE-NEXT:    [[OLD:%.*]] = load i16, ptr [[P]], align 2
; BE-NEXT:    [[NEEDS_UPDATE:%.*]] = icmp uge i16 [[OLD]], -256
; BE-NEXT:    br i1 [[NEEDS_UPDATE]], label %[[UPDATE:.*]], label %[[EXIT:.*]]
; BE:       [[UPDATE]]:
; BE-NEXT:    [[TMP0:%.*]] = lshr i16 [[X]], 8
; BE-NEXT:    [[TMP1:%.*]] = trunc i16 [[TMP0]] to i8
; BE-NEXT:    store i8 [[TMP1]], ptr [[P]], align 2
; BE-NEXT:    br label %[[EXIT]]
; BE:       [[EXIT]]:
; BE-NEXT:    ret void
;
entry:
  %old = load i16, ptr %p, align 2
  %needs.update = icmp uge i16 %old, -256
  br i1 %needs.update, label %update, label %exit

update:
  %insert = and i16 %x, -256
  %keep = and i16 %old, 255
  %merged = or disjoint i16 %insert, %keep
  store i16 %merged, ptr %p, align 2
  br label %exit

exit:
  ret void
}

; A single clobbering path is enough to make narrowing unsafe.
define void @clobber_on_one_path(ptr %p, i32 %x, i1 %c) {
; CHECK-LABEL: define void @clobber_on_one_path(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    br i1 [[C]], label %[[CLOBBER:.*]], label %[[UPDATE:.*]]
; CHECK:       [[CLOBBER]]:
; CHECK-NEXT:    [[CLOBBER_PTR:%.*]] = getelementptr i8, ptr [[P]], i64 1
; CHECK-NEXT:    store i8 0, ptr [[CLOBBER_PTR]], align 1
; CHECK-NEXT:    br label %[[UPDATE]]
; CHECK:       [[UPDATE]]:
; CHECK-NEXT:    [[INSERT:%.*]] = and i32 [[X]], -16777216
; CHECK-NEXT:    [[KEEP:%.*]] = and i32 [[OLD]], 16777215
; CHECK-NEXT:    [[MERGED:%.*]] = or disjoint i32 [[INSERT]], [[KEEP]]
; CHECK-NEXT:    store i32 [[MERGED]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %old = load i32, ptr %p, align 4
  br i1 %c, label %clobber, label %update

clobber:
  %clobber.ptr = getelementptr i8, ptr %p, i64 1
  store i8 0, ptr %clobber.ptr, align 1
  br label %update

update:
  %insert = and i32 %x, -16777216
  %keep = and i32 %old, 16777215
  %merged = or disjoint i32 %insert, %keep
  store i32 %merged, ptr %p, align 4
  ret void
}

; The second iteration restores the original value of the clobbered byte.
define void @clobber_on_backedge(ptr %p, i32 %x) {
; CHECK-LABEL: define void @clobber_on_backedge(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    br label %[[UPDATE:.*]]
; CHECK:       [[UPDATE]]:
; CHECK-NEXT:    [[AGAIN:%.*]] = phi i1 [ true, %[[ENTRY]] ], [ false, %[[CLOBBER:.*]] ]
; CHECK-NEXT:    [[INSERT:%.*]] = and i32 [[X]], -16777216
; CHECK-NEXT:    [[KEEP:%.*]] = and i32 [[OLD]], 16777215
; CHECK-NEXT:    [[MERGED:%.*]] = or disjoint i32 [[INSERT]], [[KEEP]]
; CHECK-NEXT:    store i32 [[MERGED]], ptr [[P]], align 4
; CHECK-NEXT:    br i1 [[AGAIN]], label %[[CLOBBER]], label %[[EXIT:.*]]
; CHECK:       [[CLOBBER]]:
; CHECK-NEXT:    [[CLOBBER_PTR:%.*]] = getelementptr i8, ptr [[P]], i64 1
; CHECK-NEXT:    store i8 0, ptr [[CLOBBER_PTR]], align 1
; CHECK-NEXT:    br label %[[UPDATE]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %old = load i32, ptr %p, align 4
  br label %update

update:
  %again = phi i1 [ true, %entry ], [ false, %clobber ]
  %insert = and i32 %x, -16777216
  %keep = and i32 %old, 16777215
  %merged = or disjoint i32 %insert, %keep
  store i32 %merged, ptr %p, align 4
  br i1 %again, label %clobber, label %exit

clobber:
  %clobber.ptr = getelementptr i8, ptr %p, i64 1
  store i8 0, ptr %clobber.ptr, align 1
  br label %update

exit:
  ret void
}

