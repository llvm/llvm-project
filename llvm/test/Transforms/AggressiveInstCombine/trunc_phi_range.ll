; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=aggressive-instcombine -S | FileCheck %s

target datalayout = "e-m:e-i64:64-i128:128-n8:16:32:64-S128"

; Binary search over std::views::iota(first, last), as libstdc++ emits it with
; a 128-bit difference type. %len starts below 2^64 and only shrinks, and the
; loop only continues while %len.next > 0. The assumes bound it to [0, 100].
define i64 @iota_lower_bound(ptr %data, i64 %first, i64 %last, i64 %value) {
;
; CHECK-LABEL: @iota_lower_bound(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[C1:%.*]] = icmp ule i64 [[FIRST:%.*]], [[LAST:%.*]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[C1]])
; CHECK-NEXT:    [[C2:%.*]] = icmp ult i64 [[LAST]], 101
; CHECK-NEXT:    call void @llvm.assume(i1 [[C2]])
; CHECK-NEXT:    [[NONEMPTY:%.*]] = icmp ugt i64 [[LAST]], [[FIRST]]
; CHECK-NEXT:    br i1 [[NONEMPTY]], label [[PH:%.*]], label [[EXIT:%.*]]
; CHECK:       ph:
; CHECK-NEXT:    [[D:%.*]] = sub nuw nsw i64 [[LAST]], [[FIRST]]
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[LEN:%.*]] = phi i64 [ [[D]], [[PH]] ], [ [[LEN_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[LO:%.*]] = phi i64 [ [[FIRST]], [[PH]] ], [ [[LO_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[HALF64:%.*]] = lshr i64 [[LEN]], 1
; CHECK-NEXT:    [[MID:%.*]] = add i64 [[LO]], [[HALF64]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds nuw i64, ptr [[DATA:%.*]], i64 [[MID]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    [[LT:%.*]] = icmp ult i64 [[V]], [[VALUE:%.*]]
; CHECK-NEXT:    [[MID1:%.*]] = add i64 [[MID]], 1
; CHECK-NEXT:    [[NHALF:%.*]] = xor i64 [[HALF64]], -1
; CHECK-NEXT:    [[REST:%.*]] = add i64 [[LEN]], [[NHALF]]
; CHECK-NEXT:    [[LO_NEXT]] = select i1 [[LT]], i64 [[MID1]], i64 [[LO]]
; CHECK-NEXT:    [[LEN_NEXT]] = select i1 [[LT]], i64 [[REST]], i64 [[HALF64]]
; CHECK-NEXT:    [[CONT:%.*]] = icmp sgt i64 [[LEN_NEXT]], 0
; CHECK-NEXT:    br i1 [[CONT]], label [[LOOP]], label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[FIRST]], [[ENTRY:%.*]] ], [ [[LO_NEXT]], [[LOOP]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  %c1 = icmp ule i64 %first, %last
  call void @llvm.assume(i1 %c1)
  %c2 = icmp ult i64 %last, 101
  call void @llvm.assume(i1 %c2)
  %nonempty = icmp ugt i64 %last, %first
  br i1 %nonempty, label %ph, label %exit

ph:
  %d = sub nuw nsw i64 %last, %first
  %len0 = zext nneg i64 %d to i128
  br label %loop

loop:
  %len = phi i128 [ %len0, %ph ], [ %len.next, %loop ]
  %lo = phi i64 [ %first, %ph ], [ %lo.next, %loop ]
  %half = lshr i128 %len, 1
  %half64 = trunc i128 %half to i64
  %mid = add i64 %lo, %half64
  %p = getelementptr inbounds nuw i64, ptr %data, i64 %mid
  %v = load i64, ptr %p, align 8
  %lt = icmp ult i64 %v, %value
  %mid1 = add i64 %mid, 1
  %nhalf = xor i128 %half, -1
  %rest = add nsw i128 %len, %nhalf
  %lo.next = select i1 %lt, i64 %mid1, i64 %lo
  %len.next = select i1 %lt, i128 %rest, i128 %half
  %cont = icmp sgt i128 %len.next, 0
  br i1 %cont, label %loop, label %exit

exit:
  %r = phi i64 [ %first, %entry ], [ %lo.next, %loop ]
  ret i64 %r
}

; The same loop without the assumes. %len stays below 2^64, but %len.next
; ranges over [-2^63, 2^64 - 2], so `icmp sgt` cannot be done in i64.
define i64 @iota_lower_bound_unbounded(ptr %data, i64 %first, i64 %last, i64 %value) {
;
; CHECK-LABEL: @iota_lower_bound_unbounded(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[NONEMPTY:%.*]] = icmp ugt i64 [[LAST:%.*]], [[FIRST:%.*]]
; CHECK-NEXT:    br i1 [[NONEMPTY]], label [[PH:%.*]], label [[EXIT:%.*]]
; CHECK:       ph:
; CHECK-NEXT:    [[D:%.*]] = sub nuw i64 [[LAST]], [[FIRST]]
; CHECK-NEXT:    [[LEN0:%.*]] = zext i64 [[D]] to i128
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[LEN:%.*]] = phi i128 [ [[LEN0]], [[PH]] ], [ [[LEN_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[LO:%.*]] = phi i64 [ [[FIRST]], [[PH]] ], [ [[LO_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[HALF:%.*]] = lshr i128 [[LEN]], 1
; CHECK-NEXT:    [[HALF64:%.*]] = trunc i128 [[HALF]] to i64
; CHECK-NEXT:    [[MID:%.*]] = add i64 [[LO]], [[HALF64]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds nuw i64, ptr [[DATA:%.*]], i64 [[MID]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    [[LT:%.*]] = icmp ult i64 [[V]], [[VALUE:%.*]]
; CHECK-NEXT:    [[MID1:%.*]] = add i64 [[MID]], 1
; CHECK-NEXT:    [[NHALF:%.*]] = xor i128 [[HALF]], -1
; CHECK-NEXT:    [[REST:%.*]] = add nsw i128 [[LEN]], [[NHALF]]
; CHECK-NEXT:    [[LO_NEXT]] = select i1 [[LT]], i64 [[MID1]], i64 [[LO]]
; CHECK-NEXT:    [[LEN_NEXT]] = select i1 [[LT]], i128 [[REST]], i128 [[HALF]]
; CHECK-NEXT:    [[CONT:%.*]] = icmp sgt i128 [[LEN_NEXT]], 0
; CHECK-NEXT:    br i1 [[CONT]], label [[LOOP]], label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[FIRST]], [[ENTRY:%.*]] ], [ [[LO_NEXT]], [[LOOP]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  %nonempty = icmp ugt i64 %last, %first
  br i1 %nonempty, label %ph, label %exit

ph:
  %d = sub nuw i64 %last, %first
  %len0 = zext i64 %d to i128
  br label %loop

loop:
  %len = phi i128 [ %len0, %ph ], [ %len.next, %loop ]
  %lo = phi i64 [ %first, %ph ], [ %lo.next, %loop ]
  %half = lshr i128 %len, 1
  %half64 = trunc i128 %half to i64
  %mid = add i64 %lo, %half64
  %p = getelementptr inbounds nuw i64, ptr %data, i64 %mid
  %v = load i64, ptr %p, align 8
  %lt = icmp ult i64 %v, %value
  %mid1 = add i64 %mid, 1
  %nhalf = xor i128 %half, -1
  %rest = add nsw i128 %len, %nhalf
  %lo.next = select i1 %lt, i64 %mid1, i64 %lo
  %len.next = select i1 %lt, i128 %rest, i128 %half
  %cont = icmp sgt i128 %len.next, 0
  br i1 %cont, label %loop, label %exit

exit:
  %r = phi i64 [ %first, %entry ], [ %lo.next, %loop ]
  ret i64 %r
}

; Count-down loop. Known bits lose the leading zeros at the add, but the
; ranges show that %i stays in [0, 999] and %i.next in [-1, 998].
define i64 @countdown_loop(i64 %n) {
; CHECK-LABEL: @countdown_loop(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[SMALL:%.*]] = icmp ult i64 [[N:%.*]], 1000
; CHECK-NEXT:    call void @llvm.assume(i1 [[SMALL]])
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[N]], [[ENTRY:%.*]] ], [ [[I_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i64 [ 0, [[ENTRY]] ], [ [[ACC_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[T:%.*]] = lshr i64 [[I]], 1
; CHECK-NEXT:    [[ACC_NEXT]] = add i64 [[ACC]], [[T]]
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], -1
; CHECK-NEXT:    [[CONT:%.*]] = icmp sgt i64 [[I_NEXT]], 0
; CHECK-NEXT:    br i1 [[CONT]], label [[LOOP]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret i64 [[ACC_NEXT]]
;
entry:
  %small = icmp ult i64 %n, 1000
  call void @llvm.assume(i1 %small)
  %i0 = zext i64 %n to i128
  br label %loop

loop:
  %i = phi i128 [ %i0, %entry ], [ %i.next, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc.next, %loop ]
  %half = lshr i128 %i, 1
  %t = trunc i128 %half to i64
  %acc.next = add i64 %acc, %t
  %i.next = add nsw i128 %i, -1
  %cont = icmp sgt i128 %i.next, 0
  br i1 %cont, label %loop, label %exit

exit:
  ret i64 %acc.next
}

; Negative test: %len grows, so the ranges do not reach a fixed point and the
; lshr operand is not known to fit in i64.
define i64 @growing_loop(i64 %n, i128 %limit) {
;
; CHECK-LABEL: @growing_loop(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[LEN0:%.*]] = zext i64 [[N:%.*]] to i128
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[LEN:%.*]] = phi i128 [ [[LEN0]], [[ENTRY:%.*]] ], [ [[LEN_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[LEN_NEXT]] = add i128 [[LEN]], 1
; CHECK-NEXT:    [[HALF:%.*]] = lshr i128 [[LEN_NEXT]], 1
; CHECK-NEXT:    [[T:%.*]] = trunc i128 [[HALF]] to i64
; CHECK-NEXT:    [[CONT:%.*]] = icmp ult i128 [[LEN_NEXT]], [[LIMIT:%.*]]
; CHECK-NEXT:    br i1 [[CONT]], label [[LOOP]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret i64 [[T]]
;
entry:
  %len0 = zext i64 %n to i128
  br label %loop

loop:
  %len = phi i128 [ %len0, %entry ], [ %len.next, %loop ]
  %len.next = add i128 %len, 1
  %half = lshr i128 %len.next, 1
  %t = trunc i128 %half to i64
  %cont = icmp ult i128 %len.next, %limit
  br i1 %cont, label %loop, label %exit

exit:
  ret i64 %t
}

; Negative test: the back-edge condition is on another value, so %len.next
; can be negative and the lshr operand does not fit in i64.
define i64 @backedge_condition_on_other_value(ptr %data, i64 %first, i64 %last, i1 %c) {
;
; CHECK-LABEL: @backedge_condition_on_other_value(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[D:%.*]] = sub nuw i64 [[LAST:%.*]], [[FIRST:%.*]]
; CHECK-NEXT:    [[LEN0:%.*]] = zext i64 [[D]] to i128
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[LEN:%.*]] = phi i128 [ [[LEN0]], [[ENTRY:%.*]] ], [ [[LEN_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[HALF:%.*]] = lshr i128 [[LEN]], 1
; CHECK-NEXT:    [[HALF64:%.*]] = trunc i128 [[HALF]] to i64
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds nuw i64, ptr [[DATA:%.*]], i64 [[HALF64]]
; CHECK-NEXT:    store i64 0, ptr [[P]], align 8
; CHECK-NEXT:    [[NHALF:%.*]] = xor i128 [[HALF]], -1
; CHECK-NEXT:    [[LEN_NEXT]] = add nsw i128 [[LEN]], [[NHALF]]
; CHECK-NEXT:    br i1 [[C:%.*]], label [[LOOP]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret i64 [[HALF64]]
;
entry:
  %d = sub nuw i64 %last, %first
  %len0 = zext i64 %d to i128
  br label %loop

loop:
  %len = phi i128 [ %len0, %entry ], [ %len.next, %loop ]
  %half = lshr i128 %len, 1
  %half64 = trunc i128 %half to i64
  %p = getelementptr inbounds nuw i64, ptr %data, i64 %half64
  store i64 0, ptr %p, align 8
  %nhalf = xor i128 %half, -1
  %len.next = add nsw i128 %len, %nhalf
  br i1 %c, label %loop, label %exit

exit:
  ret i64 %half64
}



declare void @llvm.assume(i1)
