; Negative test: vector icmp users are not narrowed.
define <2 x i1> @icmp_vector(<2 x i32> %x, ptr %out) {
; CHECK-LABEL: @icmp_vector(
; CHECK-NEXT:    [[Z:%.*]] = zext <2 x i32> [[X:%.*]] to <2 x i64>
; CHECK-NEXT:    [[M:%.*]] = and <2 x i64> [[Z]], splat (i64 255)
; CHECK-NEXT:    [[B:%.*]] = add <2 x i64> [[M]], splat (i64 1)
; CHECK-NEXT:    [[T:%.*]] = trunc <2 x i64> [[B]] to <2 x i32>
; CHECK-NEXT:    store <2 x i32> [[T]], ptr [[OUT:%.*]], align 8
; CHECK-NEXT:    [[C:%.*]] = icmp ult <2 x i64> [[B]], splat (i64 100)
; CHECK-NEXT:    ret <2 x i1> [[C]]
;
  %z = zext <2 x i32> %x to <2 x i64>
  %m = and <2 x i64> %z, splat (i64 255)
  %b = add <2 x i64> %m, splat (i64 1)
  %t = trunc <2 x i64> %b to <2 x i32>
  store <2 x i32> %t, ptr %out, align 8
  %c = icmp ult <2 x i64> %b, splat (i64 100)
  ret <2 x i1> %c
}
