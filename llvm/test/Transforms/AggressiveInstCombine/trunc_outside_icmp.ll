; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=aggressive-instcombine -S | FileCheck %s

target datalayout = "e-m:e-i64:64-n8:16:32:64-S128"

; %b is in [1, 256], so the icmp users fit in i32 and are narrowed with the
; graph.

define i1 @icmp_unsigned(i32 %x, ptr %out) {
; CHECK-LABEL: @icmp_unsigned(
; CHECK-NEXT:    [[M:%.*]] = and i32 [[X:%.*]], 255
; CHECK-NEXT:    [[T:%.*]] = add i32 [[M]], 1
; CHECK-NEXT:    store i32 [[T]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[T]], 100
; CHECK-NEXT:    ret i1 [[C]]
;
  %z = zext i32 %x to i64
  %m = and i64 %z, 255
  %b = add i64 %m, 1
  %t = trunc i64 %b to i32
  store i32 %t, ptr %out, align 4
  %c = icmp ult i64 %b, 100
  ret i1 %c
}

