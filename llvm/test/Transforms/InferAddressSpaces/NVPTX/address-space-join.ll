  call void @llvm.assume(i1 %is_shared)
  %cg = addrspacecast ptr addrspace(7) %cluster to ptr
  %p = select i1 %cond, ptr %cg, ptr %local
  %value = load i32, ptr %p, align 4
  ret i32 %value
