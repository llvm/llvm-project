; The assumed operand space can be more specific than the user's join.
define i32 @predicated_select(ptr %local, ptr addrspace(7) %cluster, i1 %cond) {
; CHECK-LABEL: define i32 @predicated_select(
; CHECK-SAME: ptr [[LOCAL:%.*]], ptr addrspace(7) [[CLUSTER:%.*]], i1 [[COND:%.*]]) {
; CHECK-NEXT:    [[IS_SHARED:%.*]] = call i1 @llvm.nvvm.isspacep.shared(ptr [[LOCAL]])
; CHECK-NEXT:    call void @llvm.assume(i1 [[IS_SHARED]])
; CHECK-NEXT:    [[TMP1:%.*]] = addrspacecast ptr [[LOCAL]] to ptr addrspace(7)
; CHECK-NEXT:    [[P:%.*]] = select i1 [[COND]], ptr addrspace(7) [[CLUSTER]], ptr addrspace(7) [[TMP1]]
; CHECK-NEXT:    [[VALUE:%.*]] = load i32, ptr addrspace(7) [[P]], align 4
; CHECK-NEXT:    ret i32 [[VALUE]]
;
