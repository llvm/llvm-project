; Volatile loads and stores can use global, CTA-shared, and cluster-shared
; pointers directly.
define i32 @volatile_global(ptr addrspace(1) %p) {
; CHECK-LABEL: define i32 @volatile_global(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[VALUE:%.*]] = load volatile i32, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    store volatile i32 [[VALUE]], ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    ret i32 [[VALUE]]
;
  %generic = addrspacecast ptr addrspace(1) %p to ptr
  %value = load volatile i32, ptr %generic, align 4
  store volatile i32 %value, ptr %generic, align 4
  ret i32 %value
}

