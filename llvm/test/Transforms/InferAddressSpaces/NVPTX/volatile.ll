; Nonvolatile users still benefit from local address space inference even when
; volatile users require a generic pointer to the same object.
define i32 @mixed_local(ptr addrspace(5) %p) {
; CHECK-LABEL: define i32 @mixed_local(
; CHECK-SAME: ptr addrspace(5) [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[GENERIC:%.*]] = addrspacecast ptr addrspace(5) [[P]] to ptr
; CHECK-NEXT:    [[VOLATILE:%.*]] = load volatile i32, ptr [[GENERIC]], align 4
; CHECK-NEXT:    [[ORDINARY:%.*]] = load i32, ptr addrspace(5) [[P]], align 4
; CHECK-NEXT:    store volatile i32 [[ORDINARY]], ptr [[GENERIC]], align 4
; CHECK-NEXT:    store i32 [[VOLATILE]], ptr addrspace(5) [[P]], align 4
; CHECK-NEXT:    ret i32 [[ORDINARY]]
;
  %generic = addrspacecast ptr addrspace(5) %p to ptr
  %volatile = load volatile i32, ptr %generic, align 4
  %ordinary = load i32, ptr %generic, align 4
  store volatile i32 %ordinary, ptr %generic, align 4
  store i32 %volatile, ptr %generic, align 4
  ret i32 %ordinary
}

; The hook only accepts loads and stores, not volatile read-modify-write
; operations, even when the destination address space supports volatile loads.
define i32 @volatile_atomicrmw_shared(ptr addrspace(3) %p) {
; CHECK-LABEL: define i32 @volatile_atomicrmw_shared(
; CHECK-SAME: ptr addrspace(3) [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[GENERIC:%.*]] = addrspacecast ptr addrspace(3) [[P]] to ptr
; CHECK-NEXT:    [[VALUE:%.*]] = atomicrmw volatile add ptr [[GENERIC]], i32 1 syncscope("cta") seq_cst, align 4
; CHECK-NEXT:    ret i32 [[VALUE]]
;
  %generic = addrspacecast ptr addrspace(3) %p to ptr
  %value = atomicrmw volatile add ptr %generic, i32 1 syncscope("cta") seq_cst, align 4
  ret i32 %value
}

