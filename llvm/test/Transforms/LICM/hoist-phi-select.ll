declare void @use(i64)

; The phi has an invariant condition and invariant incoming values,
; so it should be converted to a select and hoisted
define void @hoist_phi_as_select(ptr %p, i64 %l, i64 %n) {
; CHECK-LABEL: define void @hoist_phi_as_select(
; CHECK-SAME: ptr [[P:%.*]], i64 [[L:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[AND:%.*]] = and i64 [[L]], 4
; CHECK-NEXT:    [[COND:%.*]] = icmp eq i64 [[AND]], 0
; CHECK-NEXT:    [[SUB:%.*]] = add i64 [[L]], -4
; CHECK-NEXT:    [[AVAIL_SEL:%.*]] = select i1 [[COND]], i64 [[L]], i64 [[SUB]]
; CHECK-NEXT:    [[OFF:%.*]] = add i64 [[AVAIL_SEL]], -2
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 [[OFF]]
; CHECK-NEXT:    [[SH:%.*]] = shl i64 [[OFF]], 3
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[END:.*]] ]
; CHECK-NEXT:    br i1 [[COND]], label %[[END]], label %[[THEN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[LD:%.*]] = load i16, ptr [[GEP]], align 1
; CHECK-NEXT:    [[EXT:%.*]] = zext i16 [[LD]] to i64
; CHECK-NEXT:    [[VAL:%.*]] = shl i64 [[EXT]], [[SH]]
; CHECK-NEXT:    call void @use(i64 [[VAL]])
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %and = and i64 %l, 4
  %cond = icmp eq i64 %and, 0
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %end ]
  br i1 %cond, label %end, label %then

then:
  %sub = add i64 %l, -4
  br label %end

end:
  %avail = phi i64 [ %l, %loop ], [ %sub, %then ]
  %off = add i64 %avail, -2
  %gep = getelementptr inbounds i8, ptr %p, i64 %off
  %ld = load i16, ptr %gep, align 1
  %ext = zext i16 %ld to i64
  %sh = shl i64 %off, 3
  %val = shl i64 %ext, %sh
  call void @use(i64 %val)
  %i.next = add i64 %i, 1
  %cmp = icmp ult i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

