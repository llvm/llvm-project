; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[I_NEXT:%.*]], [[THEN:%.*]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[I]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[C]], label [[THEN]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    store i32 [[R]], ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    br label [[LOOP]]
; CHECK:       else:
; CHECK-NEXT:    ret i32 0
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %then ]
  %c = icmp eq i32 %i, %n
  br i1 %c, label %then, label %else

then:
  %r = call i32 @llvm.sdiv.poison.i32(i32 %x, i32 %d)
  store i32 %r, ptr %p
  %i.next = add i32 %i, 1
  br label %loop

else:
  ret i32 0
}

