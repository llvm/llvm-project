; RUN: opt < %s -passes=licm -verify-memoryssa -S | FileCheck %s
target datalayout = "e-p:32:32:32-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:32:64-f32:32:32-f64:32:64-v64:64:64-v128:128:128-a0:0:64-f80:128:128"
target triple = "i386-apple-darwin10.0"

; PR4775
; LICM shouldn't sink the alloca out of the entry block, even though
; it's not used until after the loop.
define i32 @main() nounwind {
; CHECK-LABEL: define i32 @main(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[RESULT_I:%.*]] = alloca i32, align 4
; CHECK-NEXT:    br label %[[WHILE_COND:.*]]
; CHECK:       [[WHILE_COND]]:
; CHECK-NEXT:    [[CALL:%.*]] = call i32 @bar() #[[ATTR0]]
; CHECK-NEXT:    [[TOBOOL:%.*]] = icmp eq i32 [[CALL]], 0
; CHECK-NEXT:    br i1 [[TOBOOL]], label %[[WHILE_END:.*]], label %[[WHILE_COND]]
; CHECK:       [[WHILE_END]]:
; CHECK-NEXT:    store volatile i32 0, ptr [[RESULT_I]], align 4
; CHECK-NEXT:    [[TMP_I:%.*]] = load volatile i32, ptr [[RESULT_I]], align 4
; CHECK-NEXT:    ret i32 0
;
entry:
  %result.i = alloca i32, align 4                 ; <ptr> [#uses=2]
  br label %while.cond

while.cond:                                       ; preds = %while.cond, %entry
  %call = call i32 @bar() nounwind                ; <i32> [#uses=1]
  %tobool = icmp eq i32 %call, 0                  ; <i1> [#uses=1]
  br i1 %tobool, label %while.end, label %while.cond

while.end:                                        ; preds = %while.cond
  store volatile i32 0, ptr %result.i
  %tmp.i = load volatile i32, ptr %result.i           ; <i32> [#uses=0]
  ret i32 0
}
declare i32 @bar()

; <rdar://problem/10352360>
; LICM shouldn't sink the first alloca between the stacksave and stackrestore
; intrinsics.
declare ptr @a(...)
declare ptr @llvm.stacksave() nounwind
declare void @llvm.stackrestore(ptr) nounwind
define void @h(i64 %n) nounwind uwtable ssp {
; CHECK-LABEL: define void @h(
; CHECK-SAME: i64 [[N:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[VLA:%.*]] = alloca ptr, i64 [[N]], align 16
; CHECK-NEXT:    [[SAVEDSTACK:%.*]] = call ptr @llvm.stacksave.p0() #[[ATTR0]]
; CHECK-NEXT:    [[VLA_I:%.*]] = alloca ptr, i64 [[N]], align 16
; CHECK-NEXT:    br label %[[FOR_BODY_I:.*]]
; CHECK:       [[FOR_BODY_I]]:
; CHECK-NEXT:    [[INDVARS_IV37_I:%.*]] = phi i64 [ [[INDVARS_IV_NEXT38_I:%.*]], %[[FOR_BODY_I]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[CALL_I:%.*]] = call ptr (...) @a() #[[ATTR0]]
; CHECK-NEXT:    [[ARRAYIDX_I:%.*]] = getelementptr inbounds ptr, ptr [[VLA_I]], i64 [[INDVARS_IV37_I]]
; CHECK-NEXT:    store ptr [[CALL_I]], ptr [[ARRAYIDX_I]], align 8
; CHECK-NEXT:    [[INDVARS_IV_NEXT38_I]] = add i64 [[INDVARS_IV37_I]], 1
; CHECK-NEXT:    [[EXITCOND5:%.*]] = icmp eq i64 [[INDVARS_IV_NEXT38_I]], [[N]]
; CHECK-NEXT:    br i1 [[EXITCOND5]], label %[[G_EXIT:.*]], label %[[FOR_BODY_I]]
; CHECK:       [[G_EXIT]]:
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SAVEDSTACK]]) #[[ATTR0]]
; CHECK-NEXT:    [[CALL1:%.*]] = call ptr (...) @a(ptr [[VLA]]) #[[ATTR0]]
; CHECK-NEXT:    ret void
;
entry:
  %vla = alloca ptr, i64 %n, align 16
  %savedstack = call ptr @llvm.stacksave() nounwind
  %vla.i = alloca ptr, i64 %n, align 16
  br label %for.body.i

for.body.i:
  %indvars.iv37.i = phi i64 [ %indvars.iv.next38.i, %for.body.i ], [ 0, %entry ]
  %call.i = call ptr (...) @a() nounwind
  %arrayidx.i = getelementptr inbounds ptr, ptr %vla.i, i64 %indvars.iv37.i
  store ptr %call.i, ptr %arrayidx.i, align 8
  %indvars.iv.next38.i = add i64 %indvars.iv37.i, 1
  %exitcond5 = icmp eq i64 %indvars.iv.next38.i, %n
  br i1 %exitcond5, label %g.exit, label %for.body.i

g.exit:
  call void @llvm.stackrestore(ptr %savedstack) nounwind
  %call1 = call ptr (...) @a(ptr %vla) nounwind
  ret void
}
