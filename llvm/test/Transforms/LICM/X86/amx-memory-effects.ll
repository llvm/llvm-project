; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=licm < %s | FileCheck %s

; AMX intrinsics access the tile state (target_mem0) and, for the memory
; operations, only the memory reached through their pointer argument. Loads of
; loop-invariant values are therefore hoisted out of loops of tile loads and
; dot products, but not out of loops of tile stores, which may write them.

target triple = "x86_64-unknown-linux-gnu"

define void @hoist_across_tile_loads(ptr %base, ptr %cfg, i64 %n) {
; CHECK-LABEL: define void @hoist_across_tile_loads(
; CHECK-SAME: ptr [[BASE:%.*]], ptr [[CFG:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[STEP:%.*]] = load i64, ptr [[CFG]], align 8
; CHECK-NEXT:    [[STRIDE_ADDR:%.*]] = getelementptr inbounds i8, ptr [[CFG]], i64 8
; CHECK-NEXT:    [[STRIDE:%.*]] = load i64, ptr [[STRIDE_ADDR]], align 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[OFF:%.*]] = mul i64 [[I]], [[STEP]]
; CHECK-NEXT:    [[SRC:%.*]] = getelementptr inbounds i8, ptr [[BASE]], i64 [[OFF]]
; CHECK-NEXT:    call void @llvm.x86.tileloadd64(i8 0, ptr [[SRC]], i64 [[STRIDE]])
; CHECK-NEXT:    call void @llvm.x86.tileloaddt164(i8 1, ptr [[SRC]], i64 [[STRIDE]])
; CHECK-NEXT:    [[I_NEXT]] = add nuw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %step = load i64, ptr %cfg, align 8
  %stride.addr = getelementptr inbounds i8, ptr %cfg, i64 8
  %stride = load i64, ptr %stride.addr, align 8
  %off = mul i64 %i, %step
  %src = getelementptr inbounds i8, ptr %base, i64 %off
  call void @llvm.x86.tileloadd64(i8 0, ptr %src, i64 %stride)
  call void @llvm.x86.tileloaddt164(i8 1, ptr %src, i64 %stride)
  %i.next = add nuw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

define i64 @hoist_across_dot_products(ptr %k.addr, i64 %n) {
; CHECK-LABEL: define i64 @hoist_across_dot_products(
; CHECK-SAME: ptr [[K_ADDR:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[K:%.*]] = load i64, ptr [[K_ADDR]], align 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    call void @llvm.x86.tdpbssd(i8 0, i8 1, i8 2)
; CHECK-NEXT:    call void @llvm.x86.tilezero(i8 3)
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[K]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[SUM_NEXT_LCSSA:%.*]] = phi i64 [ [[SUM_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i64 [[SUM_NEXT_LCSSA]]
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %sum = phi i64 [ 0, %entry ], [ %sum.next, %loop ]
  %k = load i64, ptr %k.addr, align 8
  call void @llvm.x86.tdpbssd(i8 0, i8 1, i8 2)
  call void @llvm.x86.tilezero(i8 3)
  %sum.next = add i64 %sum, %k
  %i.next = add nuw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret i64 %sum.next
}

define void @no_hoist_across_tile_stores(ptr %base, ptr %cfg, i64 %n) {
; CHECK-LABEL: define void @no_hoist_across_tile_stores(
; CHECK-SAME: ptr [[BASE:%.*]], ptr [[CFG:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[STRIDE_ADDR:%.*]] = getelementptr inbounds i8, ptr [[CFG]], i64 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[STEP:%.*]] = load i64, ptr [[CFG]], align 8
; CHECK-NEXT:    [[STRIDE:%.*]] = load i64, ptr [[STRIDE_ADDR]], align 8
; CHECK-NEXT:    [[OFF:%.*]] = mul i64 [[I]], [[STEP]]
; CHECK-NEXT:    [[DST:%.*]] = getelementptr inbounds i8, ptr [[BASE]], i64 [[OFF]]
; CHECK-NEXT:    call void @llvm.x86.tilestored64(i8 0, ptr [[DST]], i64 [[STRIDE]])
; CHECK-NEXT:    [[I_NEXT]] = add nuw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %step = load i64, ptr %cfg, align 8
  %stride.addr = getelementptr inbounds i8, ptr %cfg, i64 8
  %stride = load i64, ptr %stride.addr, align 8
  %off = mul i64 %i, %step
  %dst = getelementptr inbounds i8, ptr %base, i64 %off
  call void @llvm.x86.tilestored64(i8 0, ptr %dst, i64 %stride)
  %i.next = add nuw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

declare void @llvm.x86.tileloadd64(i8 immarg, ptr, i64)
declare void @llvm.x86.tileloaddt164(i8 immarg, ptr, i64)
declare void @llvm.x86.tilestored64(i8 immarg, ptr, i64)
declare void @llvm.x86.tdpbssd(i8 immarg, i8 immarg, i8 immarg)
declare void @llvm.x86.tilezero(i8 immarg)
