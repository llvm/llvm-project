; RUN: opt -mtriple=amdgpu12.50-amd-amdhsa -passes='loop-mssa(licm)' -S < %s | FileCheck %s

; A prefetch in the loop does not clobber the memory it prefetches, so the
; invariant load is hoisted.

define float @global_prefetch_same_ptr(ptr addrspace(1) %p, i32 %n) {
; CHECK-LABEL: define float @global_prefetch_same_ptr(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[X:%.*]] = load float, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi float [ 0.000000e+00, %[[ENTRY]] ], [ [[ACC_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    call void @llvm.amdgcn.global.prefetch(ptr addrspace(1) [[P]], i32 8)
; CHECK-NEXT:    [[ACC_NEXT]] = fadd float [[ACC]], [[X]]
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ACC_NEXT_LCSSA:%.*]] = phi float [ [[ACC_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret float [[ACC_NEXT_LCSSA]]
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi float [ 0.0, %entry ], [ %acc.next, %loop ]
  %x = load float, ptr addrspace(1) %p
  call void @llvm.amdgcn.global.prefetch(ptr addrspace(1) %p, i32 8)
  %acc.next = fadd float %acc, %x
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret float %acc.next
}
