; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -mtriple=aarch64 -passes=typepromotion,verify -S %s -o - | FileCheck %s

target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"

; The promoted operand is zero extended, so samesign must be dropped.
define i32 @samesign_ule(i8 %a) {
; CHECK-LABEL: define i32 @samesign_ule(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = zext i8 [[A]] to i32
; CHECK-NEXT:    [[S:%.*]] = sub i32 [[TMP0]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ule i32 [[S]], 200
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[E:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    ret i32 1
; CHECK:       [[E]]:
; CHECK-NEXT:    ret i32 2
;
entry:
  %s = sub i8 %a, 1
  %c = icmp samesign ule i8 %s, 200
  br i1 %c, label %t, label %e
t:
  ret i32 1
e:
  ret i32 2
}
