; CHECK-NEXT:    br i1 [[OK]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ [[TMP0]], %[[ENTRY]] ], [ [[TMP2:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[ADDRESS:%.*]] = getelementptr [8 x i8], ptr [[EDGES]], i64 [[IDX]]
; CHECK-NEXT:    [[NEXT_PTR:%.*]] = getelementptr i8, ptr [[ADDRESS]], i64 2
; CHECK-NEXT:    [[VALUE_PTR:%.*]] = getelementptr i8, ptr [[ADDRESS]], i64 4
; CHECK-NEXT:    [[VALUE:%.*]] = load i16, ptr [[VALUE_PTR]], align 2
; CHECK-NEXT:    [[VALUE_WIDE:%.*]] = sext i16 [[VALUE]] to i32
; CHECK-NEXT:    [[SUM_NEXT]] = add i32 [[SUM]], [[VALUE_WIDE]]
; CHECK-NEXT:    [[NEXT:%.*]] = load i16, ptr [[NEXT_PTR]], align 2
; CHECK-NEXT:    [[TMP2]] = zext i16 [[NEXT]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = trunc i64 [[TMP2]] to i16
