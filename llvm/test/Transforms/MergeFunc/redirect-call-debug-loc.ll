  %w = add i32 %v, 1, !dbg !10
  ret i32 %w, !dbg !10
}

define linkonce_odr i32 @g_odr(ptr %p) {
  %v = load i32, ptr %p
  %w = add i32 %v, 1
  ret i32 %w
}

