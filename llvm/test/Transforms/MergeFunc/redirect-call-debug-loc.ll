; A call to a function without debug info need not have a location. If it is
; redirected to an equal function with debug info, and the caller has debug
; info, it needs one.

define i32 @f(ptr %p) !dbg !5 {
; CHECK-LABEL: define i32 @f(
; CHECK-SAME: ptr [[P:%.*]]) !dbg [[DBG3:![0-9]+]] {
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4, !dbg [[DBG6:![0-9]+]]
; CHECK-NEXT:    ret i32 [[V]], !dbg [[DBG6]]
;
  %v = load i32, ptr %p, !dbg !6
  ret i32 %v, !dbg !6
}

; The direct callers of @g are redirected to @f.
define internal i32 @g(ptr %p) {
  %v = load i32, ptr %p
  ret i32 %v
}

; The address of @g_unnamed_addr is not significant, so all its uses are
; replaced with @f.
define internal i32 @g_unnamed_addr(ptr %p) unnamed_addr {
  %v = load i32, ptr %p
  ret i32 %v
}

; The shared body of the linkonce_odr functions @f_odr and @g_odr becomes a
; private function, and the direct callers of @g_odr are redirected to it.
define linkonce_odr i32 @f_odr(ptr %p) !dbg !9 {
