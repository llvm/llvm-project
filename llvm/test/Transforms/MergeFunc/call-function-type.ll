; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=mergefunc -S < %s | FileCheck %s

; Functions whose calls differ only in the called function type must not be
; merged.

define void @call_fixed(ptr %f, i32 %x, double %y) {
; CHECK-LABEL: define void @call_fixed(
; CHECK-SAME: ptr [[F:%.*]], i32 [[X:%.*]], double [[Y:%.*]]) {
; CHECK-NEXT:    call void [[F]](i32 [[X]], double [[Y]])
; CHECK-NEXT:    ret void
;
  call void (i32, double) %f(i32 %x, double %y)
  ret void
}

define void @call_varargs(ptr %f, i32 %x, double %y) {
; CHECK-LABEL: define void @call_varargs(
; CHECK-SAME: ptr [[F:%.*]], i32 [[X:%.*]], double [[Y:%.*]]) {
; CHECK-NEXT:    call void (i32, ...) [[F]](i32 [[X]], double [[Y]])
; CHECK-NEXT:    ret void
;
  call void (i32, ...) %f(i32 %x, double %y)
  ret void
}
