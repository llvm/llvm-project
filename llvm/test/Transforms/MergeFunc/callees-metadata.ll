; RUN: opt -passes=mergefunc -S < %s | FileCheck %s --implicit-check-not='!callees'

; Merging two functions keeps the body of one of them. If their indirect calls
; allow different callees, that body would apply its own callee set to the
; callers of both functions.

declare void @a()
declare void @b()

define void @calls_a(ptr %fp) {
  call void %fp(), !callees !0
  ret void
}

define void @calls_b(ptr %fp) {
  call void %fp(), !callees !1
  ret void
}

define void @calls_unknown(ptr %fp) {
  call void %fp()
  ret void
}

; Identical callee lists still allow merging.
define void @also_calls_a(ptr %fp) {
  call void %fp(), !callees !0
  ret void
}

; A null operand is left behind when a listed function is deleted.
define void @deleted_first(ptr %fp) {
  call void %fp(), !callees !2
  ret void
}

define void @deleted_last(ptr %fp) {
  call void %fp(), !callees !3
  ret void
}

!0 = !{ptr @a}
!1 = !{ptr @b}
!2 = !{null, ptr @a}
!3 = !{ptr @a, null}
