  %v = load i32, ptr %p, align 4, !tbaa !4
  ret i32 %v
}

define internal i32 @load_internal(ptr %p) {
  %v = load i32, ptr %p, align 4, !tbaa !5
  ret i32 %v
}

define i16 @load_one_sided(ptr %p) {
