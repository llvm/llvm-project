; The AMDGPU prefetch intrinsics only read the memory they prefetch, so a load
; after a prefetch can reuse an earlier load of the same address.

define float @global_prefetch(ptr addrspace(1) %p) {
; CHECK-LABEL: define float @global_prefetch(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = load float, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    call void @llvm.amdgcn.global.prefetch(ptr addrspace(1) [[P]], i32 8)
; CHECK-NEXT:    [[C:%.*]] = fadd float [[A]], [[A]]
; CHECK-NEXT:    ret float [[C]]
;
  %a = load float, ptr addrspace(1) %p
  call void @llvm.amdgcn.global.prefetch(ptr addrspace(1) %p, i32 8)
  %b = load float, ptr addrspace(1) %p
  %c = fadd float %a, %b
  ret float %c
}

