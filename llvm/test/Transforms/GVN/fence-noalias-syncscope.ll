; CHECK-NEXT:    fence syncscope("singlethread") acq_rel
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[V1]], [[V1]]
; CHECK-NEXT:    ret i32 [[SUM]]
;
  %v1 = load i32, ptr %p
  fence syncscope("singlethread") acq_rel
  %v2 = load i32, ptr %p
  %sum = add i32 %v1, %v2
