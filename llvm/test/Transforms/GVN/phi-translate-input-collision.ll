; RUN: opt -passes=gvn -S %s | FileCheck %s

; Across the backedge, %i translates to %im1, which is also the untranslated
; second index of %p.sub. The second index must still be translated to
; %im1 - 1, so %p.sub must not be forwarded from the load of %p.diag.

define double @f(ptr %H) {
; CHECK-LABEL: define double @f(
; CHECK-SAME: ptr [[H:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[P_32:%.*]] = getelementptr [4 x [4 x double]], ptr [[H]], i64 0, i64 3, i64 2
; CHECK-NEXT:    [[H32:%.*]] = load double, ptr [[P_32]], align 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 3, %[[ENTRY]] ], [ [[IM1:%.*]], %[[BODY:.*]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ [[H32]], %[[ENTRY]] ], [ [[ACC_NEXT:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I]], 0
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[BODY]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[IM1]] = add nsw i64 [[I]], -1
; CHECK-NEXT:    [[P_SUB:%.*]] = getelementptr [4 x [4 x double]], ptr [[H]], i64 0, i64 [[I]], i64 [[IM1]]
; CHECK-NEXT:    [[SUB:%.*]] = load double, ptr [[P_SUB]], align 8
; CHECK-NEXT:    [[P_DIAG:%.*]] = getelementptr [4 x [4 x double]], ptr [[H]], i64 0, i64 [[IM1]], i64 [[IM1]]
; CHECK-NEXT:    [[DIAG:%.*]] = load double, ptr [[P_DIAG]], align 8
; CHECK-NEXT:    [[T:%.*]] = fadd double [[SUB]], [[DIAG]]
; CHECK-NEXT:    [[ACC_NEXT]] = fadd double [[ACC]], [[T]]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret double [[ACC]]
;
entry:
  %p.32 = getelementptr [4 x [4 x double]], ptr %H, i64 0, i64 3, i64 2
  %h32 = load double, ptr %p.32, align 8
  br label %loop

loop:
  %i = phi i64 [ 3, %entry ], [ %im1, %body ]
  %acc = phi double [ %h32, %entry ], [ %acc.next, %body ]
  %done = icmp eq i64 %i, 0
  br i1 %done, label %exit, label %body

body:
  %im1 = add nsw i64 %i, -1
  %p.sub = getelementptr [4 x [4 x double]], ptr %H, i64 0, i64 %i, i64 %im1
  %sub = load double, ptr %p.sub, align 8
  %p.diag = getelementptr [4 x [4 x double]], ptr %H, i64 0, i64 %im1, i64 %im1
  %diag = load double, ptr %p.diag, align 8
  %t = fadd double %sub, %diag
  %acc.next = fadd double %acc, %t
  br label %loop

exit:
  ret double %acc
}
