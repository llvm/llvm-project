; Scalar PRE inserts a copy of an instruction into a predecessor, replacing
; each operand with that predecessor's leader for the operand's value number.
; Value numbering ignores poison-generating flags, so the leader can have
; stronger flags than the operand it replaces. Make sure they are dropped.

; https://github.com/llvm/llvm-project/issues/233091
define i64 @gep_inbounds_leader(i1 %c, i64 %idx) {
; CHECK-LABEL: define i64 @gep_inbounds_leader(
; CHECK-SAME: i1 [[C:%.*]], i64 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[PA:.*]], label %[[PB:.*]]
; CHECK:       [[PA]]:
; CHECK-NEXT:    [[GA:%.*]] = getelementptr i8, ptr null, i64 [[IDX]]
; CHECK-NEXT:    [[RA:%.*]] = ptrtoint ptr [[GA]] to i64
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[PB]]:
; CHECK-NEXT:    [[GB:%.*]] = getelementptr i8, ptr null, i64 [[IDX]]
; CHECK-NEXT:    [[DOTPRE:%.*]] = ptrtoint ptr [[GB]] to i64
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[R_PRE_PHI:%.*]] = phi i64 [ [[DOTPRE]], %[[PB]] ], [ [[RA]], %[[PA]] ]
; CHECK-NEXT:    [[G:%.*]] = getelementptr i8, ptr null, i64 [[IDX]]
; CHECK-NEXT:    ret i64 [[R_PRE_PHI]]
;
entry:
  br i1 %c, label %pA, label %pB

pA:
  %ga = getelementptr i8, ptr null, i64 %idx
  %ra = ptrtoint ptr %ga to i64
  br label %join

pB:
  %gb = getelementptr inbounds i8, ptr null, i64 %idx
  br label %join

join:
  %g = getelementptr i8, ptr null, i64 %idx
  %r = ptrtoint ptr %g to i64
  ret i64 %r
}

define i32 @icmp_samesign_leader(i1 %c, i32 %x, i32 %y) {
; CHECK-LABEL: define i32 @icmp_samesign_leader(
; CHECK-SAME: i1 [[C:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[PA:.*]], label %[[PB:.*]]
; CHECK:       [[PA]]:
; CHECK-NEXT:    [[CA:%.*]] = icmp ult i32 [[X]], [[Y]]
; CHECK-NEXT:    [[RA:%.*]] = zext i1 [[CA]] to i32
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[PB]]:
; CHECK-NEXT:    [[CB:%.*]] = icmp ult i32 [[X]], [[Y]]
; CHECK-NEXT:    [[DOTPRE:%.*]] = zext i1 [[CB]] to i32
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[R_PRE_PHI:%.*]] = phi i32 [ [[DOTPRE]], %[[PB]] ], [ [[RA]], %[[PA]] ]
; CHECK-NEXT:    [[CC:%.*]] = icmp ult i32 [[X]], [[Y]]
; CHECK-NEXT:    ret i32 [[R_PRE_PHI]]
;
entry:
  br i1 %c, label %pA, label %pB

pA:
  %ca = icmp ult i32 %x, %y
  %ra = zext i1 %ca to i32
  br label %join

pB:
  %cb = icmp samesign ult i32 %x, %y
  br label %join

join:
  %cc = icmp ult i32 %x, %y
