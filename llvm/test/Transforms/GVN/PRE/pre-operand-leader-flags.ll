; On the edge from %pB the phi is exactly %b, so %b keeps its flags.
define float @phi_operand_keeps_leader_flags(i1 %c, float %x) {
; CHECK-LABEL: define float @phi_operand_keeps_leader_flags(
; CHECK-SAME: i1 [[C:%.*]], float [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[PA:.*]], label %[[PB:.*]]
; CHECK:       [[PA]]:
; CHECK-NEXT:    [[A:%.*]] = fadd float [[X]], 1.000000e+00
; CHECK-NEXT:    [[RA:%.*]] = fmul float [[A]], 2.000000e+00
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[PB]]:
; CHECK-NEXT:    [[B:%.*]] = fadd fast float [[X]], 3.000000e+00
; CHECK-NEXT:    [[DOTPRE:%.*]] = fmul float [[B]], 2.000000e+00
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[R_PRE_PHI:%.*]] = phi float [ [[DOTPRE]], %[[PB]] ], [ [[RA]], %[[PA]] ]
; CHECK-NEXT:    [[P:%.*]] = phi float [ [[A]], %[[PA]] ], [ [[B]], %[[PB]] ]
; CHECK-NEXT:    ret float [[R_PRE_PHI]]
;
entry:
  br i1 %c, label %pA, label %pB

pA:
  %a = fadd float %x, 1.0
  %ra = fmul float %a, 2.0
  br label %join

pB:
  %b = fadd fast float %x, 3.0
