; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -mtriple=nvptx64-nvidia-cuda -aa-pipeline=basic-aa,nvptx-aa -passes=gvn -enable-load-pre=true -S %s | FileCheck %s
;
; Post-argument-lowering IR. A cheap parameter load is partially available at
; join. PRE must not split missing -> join to move the load out of join.
; this is a profitability test, not a speculation-legality test.
; Before the fix, GVN creates missing.join_crit_edge and replaces %again with
; a PHI. The checks below require the parameter load to remain in join.

target datalayout = "e-p:64:64-i64:64-n16:32:64"
target triple = "nvptx64-nvidia-cuda"

define ptx_kernel void @param_load_pre(
; CHECK-LABEL: define ptx_kernel void @param_load_pre(
; CHECK-SAME: ptr addrspace(101) readonly byval([32 x i8]) align 16 [[PARAMS:%.*]], ptr addrspace(1) [[OUT:%.*]], i1 [[TAKE_AVAILABLE:%.*]], i1 [[TAKE_JOIN:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "", "l"(ptr addrspace(101) [[PARAMS]]) #[[ATTR0:[0-9]+]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr addrspace(101) [[PARAMS]], i64 16
; CHECK-NEXT:    br i1 [[TAKE_AVAILABLE]], label %[[AVAILABLE:.*]], label %[[MISSING:.*]]
; CHECK:       [[AVAILABLE]]:
; CHECK-NEXT:    [[FIRST:%.*]] = load i32, ptr addrspace(101) [[P]], align 16
; CHECK-NEXT:    [[POSITIVE:%.*]] = icmp sgt i32 [[FIRST]], 0
; CHECK-NEXT:    br i1 [[POSITIVE]], label %[[JOIN:.*]], label %[[EXIT:.*]]
; CHECK:       [[MISSING]]:
; CHECK-NEXT:    br i1 [[TAKE_JOIN]], label %[[JOIN]], label %[[EXIT]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    call void asm sideeffect "", "~{memory}"() #[[ATTR0]]
; CHECK-NEXT:    [[AGAIN:%.*]] = load i32, ptr addrspace(101) [[P]], align 16
; CHECK-NEXT:    store i32 [[AGAIN]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
  ptr addrspace(101) readonly byval([32 x i8]) align 16 %params,
  ptr addrspace(1) %out, i1 %take_available, i1 %take_join) {
entry:
  call void asm sideeffect "", "l"(ptr addrspace(101) %params) nounwind
  %p = getelementptr inbounds i8, ptr addrspace(101) %params, i64 16
  br i1 %take_available, label %available, label %missing

available:
  %first = load i32, ptr addrspace(101) %p, align 16
  %positive = icmp sgt i32 %first, 0
  br i1 %positive, label %join, label %exit

missing:
  br i1 %take_join, label %join, label %exit

join:
  call void asm sideeffect "", "~{memory}"() nounwind
  %again = load i32, ptr addrspace(101) %p, align 16
  store i32 %again, ptr addrspace(1) %out, align 4
  br label %exit

exit:
  ret void
}
