; Scalar PRE reuses a predecessor's leader for a value number. Value numbering
; ignores poison-generating flags, so the leader can be built from
; instructions with stronger flags than the instruction it stands in for, even
; arbitrarily deep in its defining chain. The stronger flags are dropped so
; that the inserted phi is not more poisonous than the value it replaces.

; https://github.com/llvm/llvm-project/issues/241590

; The original reproducer: the leader %ra is built from an inbounds GEP, while
; %r is built from a plain GEP.
define i64 @gep_inbounds_leader(i1 %c, i64 %idx) {
; CHECK-LABEL: define i64 @gep_inbounds_leader(
; CHECK-SAME: i1 [[C:%.*]], i64 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[PA:.*]], label %[[PB:.*]]
; CHECK:       [[PA]]:
; CHECK-NEXT:    [[GA:%.*]] = getelementptr i8, ptr null, i64 [[IDX]]
; CHECK-NEXT:    [[RA:%.*]] = ptrtoint ptr [[GA]] to i64
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[PB]]:
; CHECK-NEXT:    [[GB:%.*]] = getelementptr i8, ptr null, i64 [[IDX]]
; CHECK-NEXT:    [[DOTPRE:%.*]] = ptrtoint ptr [[GB]] to i64
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[R_PRE_PHI:%.*]] = phi i64 [ [[DOTPRE]], %[[PB]] ], [ [[RA]], %[[PA]] ]
; CHECK-NEXT:    [[G:%.*]] = getelementptr i8, ptr null, i64 [[IDX]]
; CHECK-NEXT:    ret i64 [[R_PRE_PHI]]
;
entry:
  br i1 %c, label %pA, label %pB

pA:
  %ga = getelementptr inbounds i8, ptr null, i64 %idx
  %ra = ptrtoint ptr %ga to i64
  br label %join

pB:
  %gb = getelementptr i8, ptr null, i64 %idx
  br label %join

join:
  %g = getelementptr i8, ptr null, i64 %idx
  %r = ptrtoint ptr %g to i64
  ret i64 %r
}

