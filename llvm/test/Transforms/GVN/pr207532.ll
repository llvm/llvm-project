; Forwarding a b64 store to a ptr load must not create an invalid bitcast.

@g = external global i32

define ptr @forward_byte_store_to_ptr_load() {
; CHECK-LABEL: define ptr @forward_byte_store_to_ptr_load() {
; CHECK-NEXT:    [[A:%.*]] = alloca ptr, align 8
; CHECK-NEXT:    store b64 bitcast (ptr @g to b64), ptr [[A]], align 8
; CHECK-NEXT:    ret ptr @g
