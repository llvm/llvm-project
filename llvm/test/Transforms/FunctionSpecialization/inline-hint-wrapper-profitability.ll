; An inlinehint function called with a unique constant signature inside of a
; forwarding wrapper expresses a preference to inline a function after
; profitable simplification. Allow a specialization which meets the ordinary
; code-size requirement and leaves a small residual without also requiring
; independent latency savings.

define i32 @hinted_true(i32 %x) {
  %result = call i32 @hinted(i1 true, i32 %x)
  ret i32 %result
}

define i32 @hinted_false(i32 %x) {
  %result = call i32 @hinted(i1 false, i32 %x)
  ret i32 %result
}

define i32 @plain_true(i32 %x) {
  %result = call i32 @plain(i1 true, i32 %x)
  ret i32 %result
}

define i32 @plain_false(i32 %x) {
  %result = call i32 @plain(i1 false, i32 %x)
  ret i32 %result
}

define internal i32 @hinted(i1 %flag, i32 %x) inlinehint {
  br i1 %flag, label %then, label %else
then:
  %a = call i32 @use_a(i32 %x)
  br label %exit
else:
  %b = call i32 @use_b(i32 %x)
  br label %exit
exit:
  %result = phi i32 [ %a, %then ], [ %b, %else ]
  ret i32 %result
}

define internal i32 @plain(i1 %flag, i32 %x) {
  br i1 %flag, label %then, label %else
then:
  %a = call i32 @use_a(i32 %x)
  br label %exit
else:
  %b = call i32 @use_b(i32 %x)
  br label %exit
exit:
  %result = phi i32 [ %a, %then ], [ %b, %else ]
  ret i32 %result
}

declare i32 @use_a(i32)
declare i32 @use_b(i32)

; Forwarding a void result is also supported.
define void @void_true(i32 %x) {
  call void @void_target(i1 true, i32 %x)
  ret void
}

define void @void_false(i32 %x) {
  call void @void_target(i1 false, i32 %x)
  ret void
}

define internal void @void_target(i1 %flag, i32 %x) inlinehint {
  %value = add i32 %x, 1
  br i1 %flag, label %then, label %else
then:
  call void @consume_a(i32 %value)
  br label %exit
else:
  call void @consume_b(i32 %value)
  br label %exit
exit:
  ret void
}

declare void @consume_a(i32)
declare void @consume_b(i32)
