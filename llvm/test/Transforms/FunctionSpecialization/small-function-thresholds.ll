; Exercise the two minimum savings checks independently. A zero minimum allows
; all candidates, while a 20% minimum must reject both zero savings and 12.5%
; savings. Savings of exactly 25% must still pass a 25% minimum.
; The callees have external linkage so IPSCCP cannot propagate their constant
; arguments before function specialization evaluates their profitability.
define i32 @caller(i32 %x) {
entry:
  %zero = call i32 @zero_savings(i32 1, i32 %x)
  %fractional = call i32 @fractional_savings(i32 1, i32 %x)
  %exact = call i32 @exact_savings(i32 1, i32 %x)
  %branch = call i32 @branch_savings(i1 true, i32 %x)
  %sum0 = add i32 %zero, %fractional
  %sum1 = add i32 %exact, %branch
  %sum = add i32 %sum0, %sum1
  ret i32 %sum
}

; FuncSize = 2, CodeSizeSavings = 0, LatencySavings = 0. A 20% minimum
; requires 0.4 units of savings, which must not be rounded down to zero.
; Only the ZERO-MIN run should specialize this function.
define i32 @zero_savings(i32 %x, i32 %y) {
entry:
  %add = add i32 %x, %y
  ret i32 %add
}

; FuncSize = 8, CodeSizeSavings = 1, LatencySavings = 1. Only %constant
; folds, saving 12.5% for both metrics. A 20% minimum requires 1.6 units of
; savings, which must not be rounded down to one.
; Only the ZERO-MIN run should specialize this function.
define i32 @fractional_savings(i32 %x, i32 %y) {
entry:
  %constant = add i32 %x, 1
  %a = add i32 %constant, %y
  %b = xor i32 %a, 2
  %c = add i32 %b, %y
  %d = xor i32 %c, 3
  %e = add i32 %d, %y
  %f = xor i32 %e, 4
  ret i32 %f
}

; FuncSize = 4, CodeSizeSavings = 1, LatencySavings = 1. These savings are
; exactly 25%, so every run should specialize this function, including EXACT-MIN.
; This guards against changing the rejection comparisons from < to <=.
define i32 @exact_savings(i32 %x, i32 %y) {
entry:
  %constant = add i32 %x, 1
  %a = add i32 %constant, %y
  %b = xor i32 %a, 2
  ret i32 %b
}

; FuncSize = 8, CodeSizeSavings = 4 (50%), LatencySavings = 1 (12.5%).
; Eliminating the else block passes the code-size minimum, but folding just
; the entry branch does not meet a 20% latency minimum. The ZERO-MIN and CODESIZE
; runs should specialize this function; LATENCY and EXACT-MIN should reject it.
define i32 @branch_savings(i1 %flag, i32 %x) {
entry:
  br i1 %flag, label %then, label %else

then:
  %a = call i32 @use_a(i32 %x)
  br label %exit

else:
  %b = call i32 @use_b(i32 %x)
  br label %exit

exit:
  %result = phi i32 [ %a, %then ], [ %b, %else ]
  ret i32 %result
}

