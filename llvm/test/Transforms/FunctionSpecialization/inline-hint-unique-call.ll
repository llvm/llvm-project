; Two calls share the true signature; the false signature is still unique.
define i32 @shared_first(i32 %x) {
  %result = call i32 @shared(i1 true, i32 %x)
  ret i32 %result
}

define i32 @shared_second(i32 %x) {
  %result = call i32 @shared(i1 true, i32 %x)
  ret i32 %result
}

define i32 @shared_different(i32 %x) {
  %result = call i32 @shared(i1 false, i32 %x)
  ret i32 %result
}

; An unreachable call does not prevent the unique-call proof for the false
; signature. Its argument has no lattice value because SCCP never visited it.
define i32 @shared_unreachable(i32 %x) {
entry:
  ret i32 %x

dead:
  %flag = icmp eq i32 %x, 0
  %result = call i32 @shared(i1 %flag, i32 %x)
  ret i32 %result
}

; An unknown argument could match either constant signature after propagation.
define i32 @unknown_true(i32 %x) {
  %result = call i32 @unknown(i1 true, i32 %x)
  ret i32 %result
}

define i32 @unknown_false(i32 %x) {
  %result = call i32 @unknown(i1 false, i32 %x)
  ret i32 %result
}

define i32 @unknown_dynamic(i1 %flag, i32 %x) {
  %result = call i32 @unknown(i1 %flag, i32 %x)
  ret i32 %result
}

; Discovery skips the minsize call, but it could still use the true clone.
define i32 @skipped_regular(i32 %x) {
  %result = call i32 @skipped(i1 true, i32 %x)
  ret i32 %result
}

define i32 @skipped_minsize(i32 %x) {
  %result = call i32 @skipped(i1 true, i32 %x) minsize
  ret i32 %result
}

define i32 @skipped_different(i32 %x) {
  %result = call i32 @skipped(i1 false, i32 %x)
  ret i32 %result
}

; An escaping address prevents the unique-call proof.
@escaped_address = global ptr @escaping

define i32 @escaping_true(i32 %x) {
  %result = call i32 @escaping(i1 true, i32 %x)
  ret i32 %result
}

define i32 @escaping_false(i32 %x) {
  %result = call i32 @escaping(i1 false, i32 %x)
  ret i32 %result
}

; Inspect individual uses: a call can use the function as both its callee and
; an ordinary argument. The argument use prevents the unique-call proof.
define i32 @operand_true(i32 %x) {
  %result = call i32 @operand_target(i1 true, ptr @operand_target, i32 %x)
  ret i32 %result
}

define i32 @operand_false(i32 %x) {
  %result = call i32 @operand_target(i1 false, ptr @operand_target, i32 %x)
  ret i32 %result
}

; A recursive call is another possible user of the true specialization.
define i32 @recursive_true(i32 %x) {
  %result = call i32 @recursive_target(i1 true, i32 %x)
  ret i32 %result
}

define i32 @recursive_false(i32 %x) {
  %result = call i32 @recursive_target(i1 false, i32 %x)
  ret i32 %result
}

; Even though @joint_other_mode has an unknown argument, we can still prove that
; the @joint_true signature could not match based on the second argument;
; the @joint_false signature could still match, however.
define i32 @joint_true(i32 %x) {
  %result = call i32 @joint(i1 true, i1 true, i32 %x)
  ret i32 %result
}

define i32 @joint_false(i32 %x) {
  %result = call i32 @joint(i1 false, i1 false, i32 %x)
  ret i32 %result
}

define i32 @joint_other_mode(i1 %flag, i32 %x) {
  %result = call i32 @joint(i1 %flag, i1 false, i32 %x)
  ret i32 %result
}

