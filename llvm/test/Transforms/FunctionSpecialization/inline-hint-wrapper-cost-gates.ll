; Inlinehint and a unique forwarding wrapper only waive the latency requirement.
; A residual below the minimum function size can use the exception; equality
; cannot. Ordinary latency profitability still works without the exception.
; The code-size-saving gate and module clone budget remain in force.

; RESIDUAL should specialize via the inlinehint wrapper cost model.
; BOUNDARY should not specialize due to the residual not meeting the minimum size
;          threshold.
; LATENCY should specialize, despite the residual not meeting the minimum size
;         threshold, because the latency threshold is met.
; CODESIZE should not specialize because the codesize threshold is not met.
; BUDGET should not specialize because the clone budget is exceeded.

define i32 @true_wrapper(i32 %x) {
  %result = call i32 @target(i1 true, i32 %x)
  ret i32 %result
}

define i32 @false_wrapper(i32 %x) {
  %result = call i32 @target(i1 false, i32 %x)
  ret i32 %result
}

define internal i32 @target(i1 %flag, i32 %x) inlinehint {
  br i1 %flag, label %then, label %else
then:
  %a = call i32 @use_a(i32 %x)
  br label %exit
else:
  %b = call i32 @use_b(i32 %x)
  br label %exit
exit:
  %result = phi i32 [ %a, %then ], [ %b, %else ]
  ret i32 %result
}

declare i32 @use_a(i32)
declare i32 @use_b(i32)
