; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='gvn-hoist,dse' -S < %s | FileCheck %s

; The stores to %slot are hoisted into entry past the stores to %retval, which
; do not alias %slot. The MemoryPhi in end must keep the store to %retval in
; else as its incoming access from else, otherwise DSE (which reuses the
; MemorySSA preserved by GVNHoist) would delete that store as dead.

define i16 @hoistStorePastNoAliasStore(double %err, i1 %c) {
; CHECK-LABEL: define i16 @hoistStorePastNoAliasStore(
; CHECK-SAME: double [[ERR:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[RETVAL:%.*]] = alloca i16, align 2
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[CMP1:%.*]] = fcmp ole double [[ERR]], 5.000000e-05
; CHECK-NEXT:    [[CONV1:%.*]] = zext i1 [[CMP1]] to i16
; CHECK-NEXT:    store i16 [[CONV1]], ptr [[RETVAL]], align 2
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    [[CMP2:%.*]] = fcmp ole double [[ERR]], 5.000000e-06
; CHECK-NEXT:    [[CONV2:%.*]] = zext i1 [[CMP2]] to i16
; CHECK-NEXT:    store i16 [[CONV2]], ptr [[RETVAL]], align 2
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[R:%.*]] = load i16, ptr [[RETVAL]], align 2
; CHECK-NEXT:    ret i16 [[R]]
;
entry:
  %retval = alloca i16, align 2
  %slot = alloca i32, align 4
  br i1 %c, label %then, label %else

then:
  %cmp1 = fcmp ole double %err, 5.000000e-05
  %conv1 = zext i1 %cmp1 to i16
  store i16 %conv1, ptr %retval, align 2
  store i32 1, ptr %slot, align 4
  br label %end

else:
  %cmp2 = fcmp ole double %err, 5.000000e-06
  %conv2 = zext i1 %cmp2 to i16
  store i16 %conv2, ptr %retval, align 2
  store i32 1, ptr %slot, align 4
  br label %end

end:
  %r = load i16, ptr %retval, align 2
  ret i16 %r
}
