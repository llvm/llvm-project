; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals all --version 6
; RUN: opt < %s -passes=indirectbr-expand -S | FileCheck %s
;
; REQUIRES: x86-registered-target
;
; PHIs in indirectbr successors must be updated when the indirectbr is
; replaced (https://github.com/llvm/llvm-project/issues/63042).

target triple = "x86_64-unknown-linux-gnu"

@multiple.targets = constant [2 x ptr] [ptr blockaddress(@multiple, %dest), ptr blockaddress(@multiple, %latch)]

;.
; CHECK: @multiple.targets = constant [2 x ptr] [ptr inttoptr (i64 1 to ptr), ptr inttoptr (i64 2 to ptr)]
;.
define i32 @duplicate_successor(i1 %c) #0 {
; A single indirectbr that lists %bb twice: the switch reaches %bb once, so
; the two PHI entries from %entry become one.
; CHECK-LABEL: define i32 @duplicate_successor(
; CHECK-SAME: i1 [[C:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A:%.*]] = select i1 [[C]], ptr inttoptr (i64 1 to ptr), ptr inttoptr (i64 2 to ptr)
; CHECK-NEXT:    [[A_SWITCH_CAST:%.*]] = ptrtoint ptr [[A]] to i64
; CHECK-NEXT:    switch i64 [[A_SWITCH_CAST]], label %[[BB:.*]] [
; CHECK-NEXT:      i64 2, label %[[OTHER:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ 7, %[[ENTRY]] ]
; CHECK-NEXT:    ret i32 [[P]]
; CHECK:       [[OTHER]]:
; CHECK-NEXT:    ret i32 1
;
entry:
  %a = select i1 %c, ptr blockaddress(@duplicate_successor, %bb), ptr blockaddress(@duplicate_successor, %other)
  indirectbr ptr %a, [label %bb, label %bb, label %other]

bb:
  %p = phi i32 [ 7, %entry ], [ 7, %entry ]
  ret i32 %p

other:
  ret i32 1
}

define i32 @no_address_taken(ptr %a) #0 {
; No block address is taken, so the indirectbr becomes unreachable and %bb
; loses its predecessor; the PHI must not keep entries for %entry.
; CHECK-LABEL: define i32 @no_address_taken(
; CHECK-SAME: ptr [[A:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB:.*:]]
; CHECK-NEXT:    ret i32 poison
;
entry:
  indirectbr ptr %a, [label %bb, label %bb]

bb:
  %p = phi i32 [ 7, %entry ], [ 7, %entry ]
  ret i32 %p
}

define i8 @multiple(i32 %i, i32 %j) #0 {
; Two indirectbrs with different incoming values for the same PHI (the
; reproducer from #63042): the value must be selected in the switch block.
; CHECK-LABEL: define i8 @multiple(
; CHECK-SAME: i32 [[I:%.*]], i32 [[J:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TARGET0_PTR:%.*]] = getelementptr [2 x ptr], ptr @multiple.targets, i32 0, i32 [[I]]
; CHECK-NEXT:    [[TARGET0:%.*]] = load ptr, ptr [[TARGET0_PTR]], align 8
; CHECK-NEXT:    [[TARGET0_SWITCH_CAST:%.*]] = ptrtoint ptr [[TARGET0]] to i64
; CHECK-NEXT:    br label %[[SWITCH_BB:.*]]
; CHECK:       [[DEST:.*]]:
; CHECK-NEXT:    [[V:%.*]] = phi i8 [ [[V_SWITCH:%.*]], %[[SWITCH_BB]] ]
; CHECK-NEXT:    ret i8 [[V]]
; CHECK:       [[LATCH:.*]]:
; CHECK-NEXT:    [[TARGET1_PTR:%.*]] = getelementptr [2 x ptr], ptr @multiple.targets, i32 0, i32 [[J]]
; CHECK-NEXT:    [[TARGET1:%.*]] = load ptr, ptr [[TARGET1_PTR]], align 8
; CHECK-NEXT:    [[TARGET1_SWITCH_CAST:%.*]] = ptrtoint ptr [[TARGET1]] to i64
; CHECK-NEXT:    br label %[[SWITCH_BB]]
; CHECK:       [[SWITCH_BB]]:
; CHECK-NEXT:    [[V_SWITCH]] = phi i8 [ 1, %[[ENTRY]] ], [ 2, %[[LATCH]] ]
; CHECK-NEXT:    [[SWITCH_VALUE_PHI:%.*]] = phi i64 [ [[TARGET0_SWITCH_CAST]], %[[ENTRY]] ], [ [[TARGET1_SWITCH_CAST]], %[[LATCH]] ]
; CHECK-NEXT:    switch i64 [[SWITCH_VALUE_PHI]], label %[[DEST]] [
; CHECK-NEXT:      i64 2, label %[[LATCH]]
; CHECK-NEXT:    ]
;
entry:
  %target0.ptr = getelementptr [2 x ptr], ptr @multiple.targets, i32 0, i32 %i
  %target0 = load ptr, ptr %target0.ptr
  indirectbr ptr %target0, [label %dest, label %latch]

dest:
  %v = phi i8 [ 2, %latch ], [ 1, %entry ]
  ret i8 %v

latch:
  %target1.ptr = getelementptr [2 x ptr], ptr @multiple.targets, i32 0, i32 %j
  %target1 = load ptr, ptr %target1.ptr
  indirectbr ptr %target1, [label %dest, label %latch]
}

attributes #0 = { "target-features"="+retpoline" }
