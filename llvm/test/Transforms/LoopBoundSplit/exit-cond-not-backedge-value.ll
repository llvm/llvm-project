; RUN: opt -passes=loop-bound-split -S < %s | FileCheck %s

; The exit condition tests %x, a recurrence of this loop that no header PHI
; takes from the latch. Whether the post-loop runs is decided on the exit value
; of such a PHI, so the loop must not be split. LoopBoundSplit used to crash
; here, passing a null value to the check in the post-loop preheader.

declare void @f1()
declare void @f2()

define void @exit_cond_not_backedge_value(i32 %n) {
; CHECK-LABEL: define void @exit_cond_not_backedge_value(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[I]], 42
; CHECK-NEXT:    br i1 [[C]], label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    call void @f1()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    call void @f2()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[X:%.*]] = add nsw i32 [[I]], 2
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[X]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %c = icmp slt i32 %i, 42
  br i1 %c, label %if.then, label %if.else

if.then:
  call void @f1()
  br label %latch

if.else:
  call void @f2()
  br label %latch

latch:
  %i.next = add nsw i32 %i, 1
  %x = add nsw i32 %i, 2
  %cmp = icmp slt i32 %x, %n
  br i1 %cmp, label %header, label %exit

exit:
  ret void
}
