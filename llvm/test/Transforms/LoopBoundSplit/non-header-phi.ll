; RUN: opt -passes=loop-bound-split -S < %s | FileCheck %s

; SCEV reports a recurrence of this loop for %p as well, because a single-entry
; PHI just forwards the SCEV of its operand. %p is not the header PHI, so it
; has no value coming from the latch and must not be treated as the induction
; variable.

declare void @f1()
declare void @f2()

define void @non_header_phi(i32 %k) {
; CHECK-LABEL: define void @non_header_phi(
; CHECK-SAME: i32 [[K:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[I]], %[[HEADER]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[P]], 42
; CHECK-NEXT:    br i1 [[C]], label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    call void @f1()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    call void @f2()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_NEXT]], [[K]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  br label %body

body:
  %p = phi i32 [ %i, %header ]
  %c = icmp slt i32 %p, 42
  br i1 %c, label %if.then, label %if.else

if.then:
  call void @f1()
  br label %latch

if.else:
  call void @f2()
  br label %latch

latch:
  %i.next = add nsw i32 %i, 1
  %cmp = icmp slt i32 %i.next, %k
  br i1 %cmp, label %header, label %exit

exit:
  ret void
}
