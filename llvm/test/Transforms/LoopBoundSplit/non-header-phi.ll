; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=loop-bound-split -S < %s | FileCheck %s

; SCEV reports a recurrence of this loop for %p as well, because a single-entry
; PHI just forwards the SCEV of its operand. %p is not the header PHI, so it
; has no value coming from the latch.

declare void @f1()
declare void @f2()

; The split condition only needs the recurrence, so %p is split on like %i.
define void @split_cond_non_header_phi(i32 %n) {
; CHECK-LABEL: define void @split_cond_non_header_phi(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[ENTRY_SPLIT:.*]]
; CHECK:       [[ENTRY_SPLIT]]:
; CHECK-NEXT:    [[SMAX:%.*]] = call i32 @llvm.smax.i32(i32 [[N]], i32 0)
; CHECK-NEXT:    [[NEW_BOUND:%.*]] = call i32 @llvm.smin.i32(i32 [[SMAX]], i32 42)
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY_SPLIT]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I]], [[NEW_BOUND]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[BODY:.*]], label %[[ENTRY_SPLIT_SPLIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[I]], %[[HEADER]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[P]], 42
; CHECK-NEXT:    br i1 true, label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    call void @f1()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    call void @f2()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    br label %[[HEADER]]
; CHECK:       [[ENTRY_SPLIT_SPLIT]]:
; CHECK-NEXT:    [[I_LCSSA:%.*]] = phi i32 [ [[I]], %[[HEADER]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ne i32 [[I_LCSSA]], [[N]]
; CHECK-NEXT:    br i1 [[TMP0]], label %[[HEADER_SPLIT_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[HEADER_SPLIT_PREHEADER]]:
; CHECK-NEXT:    br label %[[HEADER_SPLIT:.*]]
; CHECK:       [[HEADER_SPLIT]]:
; CHECK-NEXT:    [[I_SPLIT:%.*]] = phi i32 [ [[I_NEXT_SPLIT:%.*]], %[[LATCH_SPLIT:.*]] ], [ [[I_LCSSA]], %[[HEADER_SPLIT_PREHEADER]] ]
; CHECK-NEXT:    [[CMP_SPLIT:%.*]] = icmp slt i32 [[I_SPLIT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP_SPLIT]], label %[[BODY_SPLIT:.*]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[BODY_SPLIT]]:
; CHECK-NEXT:    [[P_SPLIT:%.*]] = phi i32 [ [[I_SPLIT]], %[[HEADER_SPLIT]] ]
; CHECK-NEXT:    [[C_SPLIT:%.*]] = icmp slt i32 [[P_SPLIT]], 42
; CHECK-NEXT:    br i1 false, label %[[IF_THEN_SPLIT:.*]], label %[[IF_ELSE_SPLIT:.*]]
; CHECK:       [[IF_ELSE_SPLIT]]:
; CHECK-NEXT:    call void @f2()
; CHECK-NEXT:    br label %[[LATCH_SPLIT]]
; CHECK:       [[IF_THEN_SPLIT]]:
; CHECK-NEXT:    call void @f1()
; CHECK-NEXT:    br label %[[LATCH_SPLIT]]
; CHECK:       [[LATCH_SPLIT]]:
; CHECK-NEXT:    [[I_NEXT_SPLIT]] = add nsw i32 [[I_SPLIT]], 1
; CHECK-NEXT:    br label %[[HEADER_SPLIT]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %cmp = icmp slt i32 %i, %n
  br i1 %cmp, label %body, label %exit

body:
  %p = phi i32 [ %i, %header ]
  %c = icmp slt i32 %p, 42
  br i1 %c, label %if.then, label %if.else

if.then:
  call void @f1()
  br label %latch

if.else:
  call void @f2()
  br label %latch

latch:
  %i.next = add nsw i32 %i, 1
  br label %header

exit:
  ret void
}

; The exit condition tests %p, but whether the post-loop runs is decided on the
; exit value of the header PHI that takes the tested value from the latch, and
; %i takes %i.next. The loop must not be split.
define void @exit_cond_non_header_phi(i32 %n) {
; CHECK-LABEL: define void @exit_cond_non_header_phi(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[I]], 42
; CHECK-NEXT:    br i1 [[C]], label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    call void @f1()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    call void @f2()
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[I_NEXT]], %[[IF_THEN]] ], [ [[I_NEXT]], %[[IF_ELSE]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[P]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %header

header:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %i.next = add nsw i32 %i, 1
  %c = icmp slt i32 %i, 42
  br i1 %c, label %if.then, label %if.else

if.then:
  call void @f1()
  br label %latch

if.else:
  call void @f2()
  br label %latch

latch:
  %p = phi i32 [ %i.next, %if.then ], [ %i.next, %if.else ]
  %cmp = icmp slt i32 %p, %n
  br i1 %cmp, label %header, label %exit

exit:
  ret void
}
