; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=loop-bound-split -S < %s | FileCheck %s

; Reduced from https://github.com/llvm/llvm-project/issues/61655

; The exit condition of %second.inner compares %iv, which is a recurrence of
; the *other* inner loop %first.inner. LoopBoundSplit used to assume that an
; add-recurrence operand of the condition belongs to the loop being processed,
; and crashed while looking up the value coming from that loop's latch.

define i8 @addrec_of_sibling_loop() {
; CHECK-LABEL: define i8 @addrec_of_sibling_loop() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER_LOOPEXIT:.*]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    br label %[[FIRST_INNER:.*]]
; CHECK:       [[FIRST_INNER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 0, %[[OUTER_HEADER]] ], [ [[IV_NEXT:%.*]], %[[FIRST_INNER]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
; CHECK-NEXT:    br i1 false, label %[[FIRST_INNER]], label %[[SECOND_INNER_PREHEADER:.*]]
; CHECK:       [[SECOND_INNER_PREHEADER]]:
; CHECK-NEXT:    [[IV_LCSSA:%.*]] = phi i8 [ [[IV]], %[[FIRST_INNER]] ]
; CHECK-NEXT:    br label %[[SECOND_INNER:.*]]
; CHECK:       [[SECOND_INNER]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp sle i8 [[IV_LCSSA]], 0
; CHECK-NEXT:    br i1 [[CMP]], label %[[SECOND_INNER]], label %[[OUTER_HEADER_LOOPEXIT]]
;
entry:
  br label %outer.header

outer.header:
  br label %first.inner

first.inner:
  %iv = phi i8 [ 0, %outer.header ], [ %iv.next, %first.inner ]
  %iv.next = add i8 %iv, 1
  br i1 false, label %first.inner, label %second.inner

second.inner:
  %cmp = icmp sle i8 %iv, 0
  br i1 %cmp, label %second.inner, label %outer.header
}
