; RUN: opt -S -mtriple=x86_64-unknown-linux-gnu -passes=separate-const-offset-from-gep < %s | FileCheck %s

; The nuw/nsw flags on an add hold at the width of the add, which says nothing
; about wrapping at the width of a truncation applied to its result.  A
; sext/zext above such a truncation must therefore not be distributed into the
; operands of the add.

; zext i64 (trunc i8 (add nuw i32 A, B)) wraps modulo 256, so the constant 1
; must stay inside the truncation.  For A = 251 and B = 5 the index is 0, while
; distributing the casts would give 251 + 5 = 256.
define ptr addrspace(1) @zext_of_lossy_trunc(ptr addrspace(1) %p, i8 %a, i64 %iv) {
; CHECK-LABEL: define ptr addrspace(1) @zext_of_lossy_trunc(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i8 [[A:%.*]], i64 [[IV:%.*]]) {
; CHECK-NEXT:    [[AZ:%.*]] = zext i8 [[A]] to i32
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[AZ]] to i8
; CHECK-NEXT:    [[TMP2:%.*]] = zext nneg i8 [[TMP1]] to i64
; CHECK-NEXT:    [[T:%.*]] = trunc i64 [[IV]] to i8
; CHECK-NEXT:    [[TZ:%.*]] = zext i8 [[T]] to i32
; CHECK-NEXT:    [[SUM8:%.*]] = trunc i32 [[TZ]] to i8
; CHECK-NEXT:    [[IDX:%.*]] = zext nneg i8 [[SUM8]] to i64
; CHECK-NEXT:    [[SUM2:%.*]] = add i64 [[TMP2]], [[IDX]]
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr inbounds i32, ptr addrspace(1) [[P]], i64 [[SUM2]]
; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[TMP7]], i64 4
; CHECK-NEXT:    ret ptr addrspace(1) [[Q]]
;
  %iv.next = add nuw nsw i64 %iv, 1
  %t = trunc i64 %iv.next to i8
  %az = zext i8 %a to i32
  %tz = zext i8 %t to i32
  %sum = add nuw nsw i32 %az, %tz
  %sum8 = trunc i32 %sum to i8
  %idx = zext nneg i8 %sum8 to i64
  %q = getelementptr inbounds i32, ptr addrspace(1) %p, i64 %idx
  ret ptr addrspace(1) %q
}

; Same shape, but masking keeps the sum below 256, so the truncation loses
; nothing and the constant can still be hoisted.
define ptr addrspace(1) @zext_of_lossless_trunc(ptr addrspace(1) %p, i32 %x) {
; CHECK-LABEL: define ptr addrspace(1) @zext_of_lossless_trunc(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = and i32 [[X]], 15
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[A]] to i8
; CHECK-NEXT:    [[TMP2:%.*]] = zext nneg i8 [[TMP1]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i32, ptr addrspace(1) [[P]], i64 [[TMP2]]
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[TMP3]], i64 12
; CHECK-NEXT:    ret ptr addrspace(1) [[Q2]]
;
  %a = and i32 %x, 15
  %sum = add nuw nsw i32 %a, 3
  %sum8 = trunc i32 %sum to i8
  %idx = zext nneg i8 %sum8 to i64
  %q = getelementptr inbounds i32, ptr addrspace(1) %p, i64 %idx
  ret ptr addrspace(1) %q
}

; sext additionally needs the sign bit of the narrow value to be clear.  Here
; the sum reaches 130, so sext i8 of the truncation is negative and the
; constant must stay inside the truncation.
define ptr addrspace(1) @sext_of_lossy_trunc(ptr addrspace(1) %p, i32 %x) {
; CHECK-LABEL: define ptr addrspace(1) @sext_of_lossy_trunc(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = and i32 [[X]], 127
; CHECK-NEXT:    [[SUM8:%.*]] = trunc i32 [[A]] to i8
; CHECK-NEXT:    [[IDX:%.*]] = sext i8 [[SUM8]] to i64
; CHECK-NEXT:    [[Q:%.*]] = getelementptr i32, ptr addrspace(1) [[P]], i64 [[IDX]]
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr i8, ptr addrspace(1) [[Q]], i64 12
; CHECK-NEXT:    ret ptr addrspace(1) [[Q2]]
;
  %a = and i32 %x, 127
  %sum = add nuw nsw i32 %a, 3
  %sum8 = trunc i32 %sum to i8
  %idx = sext i8 %sum8 to i64
  %q = getelementptr i32, ptr addrspace(1) %p, i64 %idx
  ret ptr addrspace(1) %q
}

; With the sign bit clear both sext and zext reproduce the wider value, so the
; constant can be hoisted out of a sext'ed truncation as well.
define ptr addrspace(1) @sext_of_lossless_trunc(ptr addrspace(1) %p, i32 %x) {
; CHECK-LABEL: define ptr addrspace(1) @sext_of_lossless_trunc(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = and i32 [[X]], 63
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[A]] to i8
; CHECK-NEXT:    [[TMP2:%.*]] = sext i8 [[TMP1]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i32, ptr addrspace(1) [[P]], i64 [[TMP2]]
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr i8, ptr addrspace(1) [[TMP3]], i64 12
; CHECK-NEXT:    ret ptr addrspace(1) [[Q2]]
;
  %a = and i32 %x, 63
  %sum = add nuw nsw i32 %a, 3
  %sum8 = trunc i32 %sum to i8
  %idx = sext i8 %sum8 to i64
  %q = getelementptr i32, ptr addrspace(1) %p, i64 %idx
  ret ptr addrspace(1) %q
}

; A truncation with no extension above it still distributes over the add,
; because truncation is exact in modular arithmetic.
define ptr addrspace(1) @bare_trunc(ptr addrspace(1) %p, i128 %i) {
; CHECK-LABEL: define ptr addrspace(1) @bare_trunc(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], i128 [[I:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i128 [[I]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i32, ptr addrspace(1) [[P]], i64 [[TMP1]]
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr i8, ptr addrspace(1) [[TMP2]], i64 4
; CHECK-NEXT:    ret ptr addrspace(1) [[Q2]]
;
  %idx = add i128 %i, 1
  %idx.conv = trunc i128 %idx to i64
  %q = getelementptr i32, ptr addrspace(1) %p, i64 %idx.conv
  ret ptr addrspace(1) %q
}
