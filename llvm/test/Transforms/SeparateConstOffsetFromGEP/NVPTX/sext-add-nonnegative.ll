; A nonnegative sum of two negative operands may have signed overflow.
; For x = 0, the original index is 0, but distributing sext would give -256.
define ptr @negative_operands(ptr %base, i8 %x) {
; CHECK-LABEL: define ptr @negative_operands(
; CHECK-SAME: ptr [[BASE:%.*]], i8 [[X:%.*]]) {
; CHECK-NEXT:    [[NEGATIVE:%.*]] = or i8 [[X]], -128
; CHECK-NEXT:    [[SUM:%.*]] = add i8 [[NEGATIVE]], -128
; CHECK-NEXT:    [[INDEX:%.*]] = sext i8 [[SUM]] to i64
; CHECK-NEXT:    [[P:%.*]] = getelementptr i8, ptr [[BASE]], i64 [[INDEX]]
; CHECK-NEXT:    ret ptr [[P]]
;
  %negative = or i8 %x, -128
  %sum = add i8 %negative, -128
  %index = sext i8 %sum to i64
  %p = getelementptr i8, ptr %base, i64 %index
  ret ptr %p
}

