; RUN: opt -mtriple=nvptx64-nvidia-cuda -S -passes=separate-const-offset-from-gep < %s | FileCheck %s

; These tests cover where the pass places the instructions it creates rather
; than which offsets it splits out.

; The index is computed in %entry but used by a GEP in a successor block. The
; rebuilt "add" belongs in %entry, next to the tid values it reads, rather than
; in %if.then.
define void @rebuild_at_def_across_blocks(ptr %out, i32 %in, i1 %cond) {
; CHECK-LABEL: define void @rebuild_at_def_across_blocks(
; CHECK-SAME: ptr [[OUT:%.*]], i32 [[IN:%.*]], i1 [[COND:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TIDX:%.*]] = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
; CHECK-NEXT:    [[TIDY:%.*]] = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.y()
; CHECK-NEXT:    [[EXTX:%.*]] = sext i32 [[TIDX]] to i64
; CHECK-NEXT:    [[EXTY:%.*]] = sext i32 [[TIDY]] to i64
; CHECK-NEXT:    [[ADD12:%.*]] = add i64 [[EXTX]], [[EXTY]]
; CHECK-NEXT:    br i1 [[COND]], label %[[IF_THEN:.*]], label %[[IF_END:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[ADD12]]
; CHECK-NEXT:    [[GEP3:%.*]] = getelementptr inbounds i8, ptr [[TMP0]], i64 200
; CHECK-NEXT:    store i32 [[IN]], ptr [[GEP3]], align 4
; CHECK-NEXT:    br label %[[IF_END]]
; CHECK:       [[IF_END]]:
; CHECK-NEXT:    ret void
;
entry:
  %tidx = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
  %tidy = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.y()
  %extx = sext i32 %tidx to i64
  %exty = sext i32 %tidy to i64
  %add0 = add nuw nsw i64 %extx, 50
  %add1 = add nuw nsw i64 %add0, %exty
  br i1 %cond, label %if.then, label %if.end

if.then:
  %gep = getelementptr inbounds i32, ptr %out, i64 %add1
  store i32 %in, ptr %gep
  br label %if.end

if.end:
  ret void
}

; As above, but starting from a narrow index, which is widened by a cast
; before the offset is split out. The cast is distributed onto the leaves of
; the rebuilt chain, leaving two sexts and an add, all of which stay in
