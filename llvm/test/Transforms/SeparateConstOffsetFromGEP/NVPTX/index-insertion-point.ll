; Within a single block the rebuilt index still goes next to the original index
; definition rather than immediately before the GEP.
define ptr @rebuild_at_def_same_block(ptr %out, i32 %x, i32 %y) {
; CHECK-LABEL: define ptr @rebuild_at_def_same_block(
; CHECK-SAME: ptr [[OUT:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[EXTX:%.*]] = sext i32 [[X]] to i64
; CHECK-NEXT:    [[EXTY:%.*]] = sext i32 [[Y]] to i64
; CHECK-NEXT:    [[ADD12:%.*]] = add i64 [[EXTX]], [[EXTY]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[OUT]], align 8
; CHECK-NEXT:    store i64 [[V]], ptr [[OUT]], align 8
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr i64, ptr [[OUT]], i64 [[ADD12]]
; CHECK-NEXT:    [[GEP3:%.*]] = getelementptr i8, ptr [[TMP0]], i64 400
; CHECK-NEXT:    ret ptr [[GEP3]]
;
entry:
  %extx = sext i32 %x to i64
  %exty = sext i32 %y to i64
  %add0 = add nuw nsw i64 %extx, 50
  %add1 = add nuw nsw i64 %add0, %exty
  %v = load i64, ptr %out
  store i64 %v, ptr %out
  %gep = getelementptr inbounds i64, ptr %out, i64 %add1
  ret ptr %gep
}

; The index is a PHI node, whose definition point is the first insertion point
; of its block. The cast is placed after both PHIs, and in particular not
; between them.
define void @insert_after_phis(ptr %out, i32 %in) {
; CHECK-LABEL: define void @insert_after_phis(
; CHECK-SAME: ptr [[OUT:%.*]], i32 [[IN:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_BODY:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[INC_I:%.*]], %[[LOOP_BODY]] ]
; CHECK-NEXT:    [[J:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[INC_J:%.*]], %[[LOOP_BODY]] ]
; CHECK-NEXT:    [[IDXPROM:%.*]] = sext i32 [[I]] to i64
; CHECK-NEXT:    store i32 [[J]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[IDXPROM]]
; CHECK-NEXT:    store i32 [[IN]], ptr [[GEP]], align 4
; CHECK-NEXT:    [[INC_I]] = add i32 [[I]], 1
; CHECK-NEXT:    [[INC_J]] = add i32 [[J]], 2
; CHECK-NEXT:    [[COND:%.*]] = icmp ne i32 [[INC_J]], 10
; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP_BODY]], label %[[LOOP_EXIT:.*]]
; CHECK:       [[LOOP_EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.body

loop.body:
  %i = phi i32 [ 0, %entry ], [ %inc.i, %loop.body ]
  %j = phi i32 [ 0, %entry ], [ %inc.j, %loop.body ]
  store i32 %j, ptr %out
  %gep = getelementptr inbounds i32, ptr %out, i32 %i
  store i32 %in, ptr %gep
  %inc.i = add i32 %i, 1
  %inc.j = add i32 %j, 2
  %cond = icmp ne i32 %inc.j, 10
  br i1 %cond, label %loop.body, label %loop.exit

loop.exit:
  ret void
}

