; CHECK-NEXT:    [[TIDY:%.*]] = tail call i32 @llvm.nvvm.read.ptx.sreg.tid.y()
; CHECK-NEXT:    [[TMP0:%.*]] = sext i32 [[TIDY]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = sext i32 [[TIDX]] to i64
; CHECK-NEXT:    [[ADD12:%.*]] = add i64 [[TMP1]], [[TMP0]]
