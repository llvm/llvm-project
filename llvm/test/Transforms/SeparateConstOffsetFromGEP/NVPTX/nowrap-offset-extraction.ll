; With a stride of two, a wrapped index would violate the original GEP's
; no-signed-wrap multiplication. Preserve the flags on defined executions.
define ptr @scaled_index_wrap(ptr %p, i64 %x) {
; CHECK-LABEL: define ptr @scaled_index_wrap(
; CHECK-SAME: ptr [[P:%.*]], i64 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = and i64 [[X]], 9223372036854775807
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i16, ptr [[P]], i64 [[A]]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr inbounds i8, ptr [[TMP1]], i64 4
; CHECK-NEXT:    ret ptr [[GEP1]]
;
  %a = and i64 %x, 9223372036854775807
  %idx = add i64 %a, 2
  %gep = getelementptr inbounds i16, ptr %p, i64 %idx
  ret ptr %gep
}

