; RUN: opt -S -mtriple=nvptx64-nvidia-cuda -passes=separate-const-offset-from-gep -verify-each < %s | FileCheck %s

; Nonnegative split pieces do not imply a nonnegative original index. For
; %a = INT_MAX, %idx is INT_MIN + 1 and the original GEP moves backwards.
define ptr @byte_index_wrap(ptr %p, i64 %x) {
; CHECK-LABEL: define ptr @byte_index_wrap(
; CHECK-SAME: ptr [[P:%.*]], i64 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = and i64 [[X]], 9223372036854775807
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[P]], i64 [[A]]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr i8, ptr [[TMP1]], i64 2
; CHECK-NEXT:    ret ptr [[GEP1]]
;
  %a = and i64 %x, 9223372036854775807
  %idx = add i64 %a, 2
  %gep = getelementptr inbounds i8, ptr %p, i64 %idx
  ret ptr %gep
}

