; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=separate-const-offset-from-gep -verify-each < %s | FileCheck %s

target triple = "nvptx-nvidia-cuda"

; The two constants sum to INT_MAX modulo 2^32. Extracting that positive
; offset must not preserve inbounds: the original index can be negative even
; though the remaining lshr is nonnegative.
define i1 @two_negative_constants(ptr %p, i32 %x) {
; CHECK-LABEL: define i1 @two_negative_constants(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[LSHR:%.*]] = lshr i32 [[X]], 1
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[P]], i32 [[LSHR]]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr i8, ptr [[TMP1]], i32 2147483647
; CHECK-NEXT:    [[C:%.*]] = icmp ult ptr [[GEP1]], [[P]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %lshr = lshr i32 %x, 1
  %a = add i32 %lshr, -1
  %idx = add i32 %a, -2147483648
  %gep = getelementptr inbounds i8, ptr %p, i32 %idx
  %c = icmp ult ptr %gep, %p
  ret i1 %c
}

; The same expression with the constants combined. A single extracted offset
; can also wrap the original index, so this needs the same flag checks.
define i1 @combined_positive_constant(ptr %p, i32 %x) {
; CHECK-LABEL: define i1 @combined_positive_constant(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[LSHR:%.*]] = lshr i32 [[X]], 1
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[P]], i32 [[LSHR]]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr i8, ptr [[TMP1]], i32 2147483647
; CHECK-NEXT:    [[C:%.*]] = icmp ult ptr [[GEP1]], [[P]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %lshr = lshr i32 %x, 1
  %idx = add i32 %lshr, 2147483647
  %gep = getelementptr inbounds i8, ptr %p, i32 %idx
  %c = icmp ult ptr %gep, %p
  ret i1 %c
}
