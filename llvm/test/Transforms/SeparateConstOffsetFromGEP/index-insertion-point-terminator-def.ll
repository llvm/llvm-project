; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes="separate-const-offset-from-gep<lower-gep>" < %s | FileCheck %s

; An index defined by a terminator has no definition point in its own block.
; For an invoke the result is only available in the normal destination, and for
; a callbr it is available in several successors at once, so there is no single
; dominating point after the definition. In both cases the index must not be
; rebuilt after the defining terminator.
;
; lower-gep is used so that the extractor runs without depending on the
; target's addressing modes.

declare i32 @get_i32()
declare i64 @get_i64()
declare i32 @__gxx_personality_v0(...)

; The "idxprom" cast extending %idx to the index type belongs in the normal
; destination of the invoke, not after the invoke itself.
define ptr @invoke_index_cast(ptr %p) personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: define ptr @invoke_index_cast(
; CHECK-SAME: ptr [[P:%.*]]) personality ptr @__gxx_personality_v0 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IDX:%.*]] = invoke i32 @get_i32()
; CHECK-NEXT:            to label %[[CONT:.*]] unwind label %[[LPAD:.*]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[IDXPROM:%.*]] = sext i32 [[IDX]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = shl i64 [[IDXPROM]], 5
; CHECK-NEXT:    [[UGLYGEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    [[UGLYGEP2:%.*]] = getelementptr i8, ptr [[UGLYGEP]], i64 20
; CHECK-NEXT:    ret ptr [[UGLYGEP2]]
; CHECK:       [[LPAD]]:
; CHECK-NEXT:    [[PAD:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    ret ptr null
;
entry:
  %idx = invoke i32 @get_i32()
  to label %cont unwind label %lpad

cont:
  %gep = getelementptr [8 x i32], ptr %p, i32 %idx, i32 5
  ret ptr %gep

lpad:
  %pad = landingpad { ptr, i32 }
  cleanup
  ret ptr null
}

; %idx already has the index type, so no cast is needed, but the constant index
; makes the extractor run over %idx as well.
define ptr @invoke_index_extract(ptr %p) personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: define ptr @invoke_index_extract(
; CHECK-SAME: ptr [[P:%.*]]) personality ptr @__gxx_personality_v0 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IDX:%.*]] = invoke i64 @get_i64()
; CHECK-NEXT:            to label %[[CONT:.*]] unwind label %[[LPAD:.*]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shl i64 [[IDX]], 5
; CHECK-NEXT:    [[UGLYGEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    [[UGLYGEP1:%.*]] = getelementptr i8, ptr [[UGLYGEP]], i64 20
; CHECK-NEXT:    ret ptr [[UGLYGEP1]]
; CHECK:       [[LPAD]]:
; CHECK-NEXT:    [[PAD:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    ret ptr null
;
entry:
  %idx = invoke i64 @get_i64()
  to label %cont unwind label %lpad

cont:
  %gep = getelementptr [8 x i32], ptr %p, i64 %idx, i64 5
  ret ptr %gep

lpad:
  %pad = landingpad { ptr, i32 }
  cleanup
  ret ptr null
}

; A callbr result is live in both successors, so the index is rebuilt before
; the GEP instead.
define ptr @callbr_index(ptr %p) {
; CHECK-LABEL: define ptr @callbr_index(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IDX:%.*]] = callbr i32 asm "", "=r,!i"()
; CHECK-NEXT:            to label %[[DIRECT:.*]] [label %[[INDIRECT:.*]]]
; CHECK:       [[DIRECT]]:
; CHECK-NEXT:    ret ptr null
; CHECK:       [[INDIRECT]]:
; CHECK-NEXT:    [[IDXPROM:%.*]] = sext i32 [[IDX]] to i64
; CHECK-NEXT:    [[TMP0:%.*]] = shl i64 [[IDXPROM]], 5
; CHECK-NEXT:    [[UGLYGEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[TMP0]]
; CHECK-NEXT:    [[UGLYGEP2:%.*]] = getelementptr i8, ptr [[UGLYGEP]], i64 20
; CHECK-NEXT:    ret ptr [[UGLYGEP2]]
;
entry:
  %idx = callbr i32 asm "", "=r,!i"()
  to label %direct [label %indirect]

direct:
  ret ptr null

indirect:
  %gep = getelementptr [8 x i32], ptr %p, i32 %idx, i32 5
  ret ptr %gep
}
