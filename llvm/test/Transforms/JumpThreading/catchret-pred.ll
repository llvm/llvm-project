; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=jump-threading -S < %s | FileCheck %s
;
; The conditional branch on the phi in %merge must not be duplicated into the
; catchpad block: a catch funclet's only exit is its catchret. Doing so
; replaced the catchret with the branch; WinEHPrepare then turned the
; funclet's terminators into unreachable and the handler executed int 3.
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc"

@typeinfo = external global i8

declare void @may_throw(i32)
declare i32 @__CxxFrameHandler3(...)

define i32 @run(i32 %n) personality ptr @__CxxFrameHandler3 {
; CHECK-LABEL: define i32 @run(
; CHECK-SAME: i32 [[N:%.*]]) personality ptr @__CxxFrameHandler3 {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[BAD:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[BAD_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[BAD]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    invoke void @may_throw(i32 [[I]])
; CHECK-NEXT:            to label %[[MERGE:.*]] unwind label %[[DISPATCH:.*]]
; CHECK:       [[DISPATCH]]:
; CHECK-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[CATCH:.*]]] unwind to caller
; CHECK:       [[CATCH]]:
; CHECK-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr @typeinfo, i32 8, ptr null]
; CHECK-NEXT:    catchret from [[CP]] to label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[OK:%.*]] = phi i1 [ false, %[[CATCH]] ], [ true, %[[BODY]] ]
; CHECK-NEXT:    [[ODD:%.*]] = trunc i32 [[I]] to i1
; CHECK-NEXT:    [[MISMATCH:%.*]] = xor i1 [[OK]], [[ODD]]
; CHECK-NEXT:    br i1 [[MISMATCH]], label %[[LATCH]], label %[[RECORD:.*]]
; CHECK:       [[RECORD]]:
; CHECK-NEXT:    [[BAD_INC:%.*]] = add nsw i32 [[BAD]], 1
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[BAD_NEXT]] = phi i32 [ [[BAD_INC]], %[[RECORD]] ], [ [[BAD]], %[[MERGE]] ]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  br label %loop

loop:
  %bad = phi i32 [ 0, %entry ], [ %bad.next, %latch ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %cmp = icmp slt i32 %i, %n
  br i1 %cmp, label %body, label %exit

exit:
  ret i32 %bad

body:
  invoke void @may_throw(i32 %i)
  to label %merge unwind label %dispatch

dispatch:
  %cs = catchswitch within none [label %catch] unwind to caller

catch:
  %cp = catchpad within %cs [ptr @typeinfo, i32 8, ptr null]
  catchret from %cp to label %merge

merge:
  %ok = phi i1 [ false, %catch ], [ true, %body ]
  %odd = trunc i32 %i to i1
  %mismatch = xor i1 %ok, %odd
  br i1 %mismatch, label %latch, label %record

record:
  %bad.inc = add nsw i32 %bad, 1
  br label %latch

latch:
  %bad.next = phi i32 [ %bad.inc, %record ], [ %bad, %merge ]
  %i.next = add nuw nsw i32 %i, 1
  br label %loop
}
