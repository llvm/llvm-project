; RUN: opt -S -mtriple=amdgcn-amd-amdpal -passes=jump-threading < %s | FileCheck %s

; On a target with branch divergence, JumpThreading only threads uniform
; branches.

declare void @f(i32)

; The latch re-tests the condition of the loop header. It is known to be true on
; the path through %then, so that path is threaded to %exit and the call in
; %then is no longer in the loop.
define amdgpu_cs void @latch_uniform(i32 inreg %n) {
; CHECK-LABEL: define amdgpu_cs void @latch_uniform(
; CHECK-SAME: i32 inreg [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[I]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    call void @f(i32 1)
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %c = icmp eq i32 %i, %n
  br i1 %c, label %then, label %else

then:
  call void @f(i32 0)
  br label %latch

else:
  call void @f(i32 1)
  br label %latch

latch:
  %i.next = add i32 %i, 1
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

