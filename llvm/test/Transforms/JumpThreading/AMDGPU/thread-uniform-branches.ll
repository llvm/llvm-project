; %p is not known in %bb, but it is on each edge into %pred, so %pred is
; duplicated together with its branch to thread the branch in %bb.
define amdgpu_cs void @two_bbs_uniform(i1 inreg %c1, i1 inreg %c2) {
; CHECK-LABEL: define amdgpu_cs void @two_bbs_uniform(
; CHECK-SAME: i1 inreg [[C1:%.*]], i1 inreg [[C2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C1]], label %[[PRED_THREAD:.*]], label %[[PRED:.*]]
; CHECK:       [[PRED]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    br i1 [[C2]], label %[[BB_TRUE:.*]], label %[[EXIT:.*]]
; CHECK:       [[PRED_THREAD]]:
; CHECK-NEXT:    br i1 [[C2]], label %[[BB_FALSE:.*]], label %[[EXIT]]
; CHECK:       [[BB_TRUE]]:
; CHECK-NEXT:    [[P2:%.*]] = phi i32 [ 0, %[[PRED]] ]
; CHECK-NEXT:    call void @f(i32 1)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[BB_FALSE]]:
; CHECK-NEXT:    call void @f(i32 2)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c1, label %pred, label %then

then:
  call void @f(i32 0)
  br label %pred

pred:
  %p = phi i32 [ 0, %then ], [ 1, %entry ]
  br i1 %c2, label %bb, label %exit

bb:
  %c3 = icmp eq i32 %p, 0
  br i1 %c3, label %bb.true, label %bb.false

bb.true:
  call void @f(i32 1)
  br label %exit

bb.false:
  call void @f(i32 2)
  br label %exit

exit:
  ret void
}

