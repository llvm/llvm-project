define amdgpu_cs void @branch_on_xor(i1 inreg %d, i1 inreg %c, i1 inreg %y, i32 inreg %x) {
; CHECK-LABEL: define amdgpu_cs void @branch_on_xor(
; CHECK-SAME: i1 inreg [[D:%.*]], i1 inreg [[C:%.*]], i1 inreg [[Y:%.*]], i32 inreg [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[D]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br i1 [[C]], label %[[THEN_TRUE:.*]], label %[[MERGE:.*]]
; CHECK:       [[THEN_TRUE]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    call void @f(i32 1)
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ 0, %[[THEN]] ], [ 1, %[[THEN_TRUE]] ], [ [[X]], %[[ELSE]] ]
; CHECK-NEXT:    [[B:%.*]] = xor i1 [[C]], [[Y]]
; CHECK-NEXT:    br i1 [[B]], label %[[MERGE_TRUE:.*]], label %[[MERGE_FALSE:.*]]
; CHECK:       [[MERGE_TRUE]]:
; CHECK-NEXT:    call void @f(i32 [[P]])
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[MERGE_FALSE]]:
; CHECK-NEXT:    call void @f(i32 2)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %d, label %then, label %else

then:
  br i1 %c, label %then.true, label %merge

then.true:
  call void @f(i32 0)
  br label %merge

else:
  call void @f(i32 1)
  br label %merge

merge:
  %p = phi i32 [ 0, %then ], [ 1, %then.true ], [ %x, %else ]
  %b = xor i1 %c, %y
  br i1 %b, label %merge.true, label %merge.false

merge.true:
  call void @f(i32 %p)
  br label %exit

merge.false:
  call void @f(i32 2)
  br label %exit

exit:
  ret void
}

; The branch on %b is implied by the branch on %a and is folded.
define amdgpu_cs void @implied_cond_uniform(i32 inreg %x) {
; CHECK-LABEL: define amdgpu_cs void @implied_cond_uniform(
; CHECK-SAME: i32 inreg [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    br i1 [[A]], label %[[THEN_TRUE:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN_TRUE]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    call void @f(i32 1)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %a = icmp eq i32 %x, 0
  br i1 %a, label %then, label %exit

then:
  call void @f(i32 0)
  %b = icmp ult i32 %x, 1
  br i1 %b, label %then.true, label %exit

then.true:
  call void @f(i32 1)
  br label %exit

exit:
  ret void
}

; %x is divergent, so the branch on %b is divergent and is left alone.
define amdgpu_cs void @implied_cond_divergent(i32 %x) {
; CHECK-LABEL: define amdgpu_cs void @implied_cond_divergent(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    br i1 [[A]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    [[B:%.*]] = icmp ult i32 [[X]], 1
; CHECK-NEXT:    br i1 [[B]], label %[[THEN_TRUE:.*]], label %[[EXIT]]
; CHECK:       [[THEN_TRUE]]:
; CHECK-NEXT:    call void @f(i32 1)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %a = icmp eq i32 %x, 0
  br i1 %a, label %then, label %exit

then:
  call void @f(i32 0)
  %b = icmp ult i32 %x, 1
  br i1 %b, label %then.true, label %exit

then.true:
  call void @f(i32 1)
  br label %exit

exit:
  ret void
}

; Partially redundant loads are not replaced by a PHI on targets with branch
; divergence.
define amdgpu_cs void @load_pre(i1 inreg %c, ptr addrspace(1) inreg %p) {
; CHECK-LABEL: define amdgpu_cs void @load_pre(
; CHECK-SAME: i1 inreg [[C:%.*]], ptr addrspace(1) inreg [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i32 1, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[V]], 0
; CHECK-NEXT:    br i1 [[CMP]], label %[[MERGE_TRUE:.*]], label %[[EXIT:.*]]
; CHECK:       [[MERGE_TRUE]]:
; CHECK-NEXT:    call void @f(i32 1)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %then, label %else

then:
  store i32 1, ptr addrspace(1) %p
  br label %merge

else:
  call void @f(i32 0)
  br label %merge

merge:
  %v = load i32, ptr addrspace(1) %p
  %cmp = icmp eq i32 %v, 0
  br i1 %cmp, label %merge.true, label %exit

merge.true:
  call void @f(i32 1)
  br label %exit

exit:
  ret void
}

; The select feeds the branch in %merge, so it is unfolded and threaded when that
; branch is uniform.
define amdgpu_cs void @unfold_select_uniform(i1 inreg %c1, i1 inreg %c2, i32 inreg %x, i32 inreg %y) {
; CHECK-LABEL: define amdgpu_cs void @unfold_select_uniform(
; CHECK-SAME: i1 inreg [[C1:%.*]], i1 inreg [[C2:%.*]], i32 inreg [[X:%.*]], i32 inreg [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[MERGE:.*]], label %[[THEN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br i1 [[C2]], label %[[MERGE_TRUE:.*]], label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[X]], %[[THEN]] ], [ [[Y]], %[[ENTRY]] ]
; CHECK-NEXT:    [[C3:%.*]] = icmp eq i32 [[P]], 0
; CHECK-NEXT:    br i1 [[C3]], label %[[MERGE_TRUE]], label %[[EXIT:.*]]
; CHECK:       [[MERGE_TRUE]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c1, label %merge, label %then

then:
  %sel = select i1 %c2, i32 0, i32 %x
  br label %merge

merge:
  %p = phi i32 [ %sel, %then ], [ %y, %entry ]
  %c3 = icmp eq i32 %p, 0
  br i1 %c3, label %merge.true, label %exit

merge.true:
  call void @f(i32 0)
  br label %exit

exit:
  ret void
}

; The branch in %merge is divergent, so the select is not unfolded.
define amdgpu_cs void @unfold_select_divergent(i1 %c1, i1 %c2, i32 %x, i32 %y) {
; CHECK-LABEL: define amdgpu_cs void @unfold_select_divergent(
; CHECK-SAME: i1 [[C1:%.*]], i1 [[C2:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[MERGE:.*]], label %[[THEN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[C2]], i32 0, i32 [[X]]
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[SEL]], %[[THEN]] ], [ [[Y]], %[[ENTRY]] ]
; CHECK-NEXT:    [[C3:%.*]] = icmp eq i32 [[P]], 0
; CHECK-NEXT:    br i1 [[C3]], label %[[MERGE_TRUE:.*]], label %[[EXIT:.*]]
; CHECK:       [[MERGE_TRUE]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c1, label %merge, label %then

then:
  %sel = select i1 %c2, i32 0, i32 %x
  br label %merge

merge:
  %p = phi i32 [ %sel, %then ], [ %y, %entry ]
  %c3 = icmp eq i32 %p, 0
  br i1 %c3, label %merge.true, label %exit

merge.true:
  call void @f(i32 0)
  br label %exit

exit:
  ret void
}

; The select becomes a branch on its uniform condition, which is threaded.
define amdgpu_cs i32 @unfold_select_in_curr_bb_uniform(i1 inreg %c1, i1 inreg %c2, i32 inreg %x) {
; CHECK-LABEL: define amdgpu_cs i32 @unfold_select_in_curr_bb_uniform(
; CHECK-SAME: i1 inreg [[C1:%.*]], i1 inreg [[C2:%.*]], i32 inreg [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[MERGE_THREAD:.*]], label %[[MERGE:.*]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[COND_FR:%.*]] = freeze i1 [[C2]]
; CHECK-NEXT:    br i1 [[COND_FR]], label %[[BB0:.*]], label %[[MERGE_THREAD]]
; CHECK:       [[BB0]]:
; CHECK-NEXT:    br label %[[MERGE_THREAD]]
; CHECK:       [[MERGE_THREAD]]:
; CHECK-NEXT:    [[TMP1:%.*]] = phi i32 [ [[X]], %[[BB0]] ], [ 42, %[[MERGE]] ], [ 42, %[[ENTRY]] ]
; CHECK-NEXT:    ret i32 [[TMP1]]
;
entry:
  br i1 %c1, label %merge, label %then

then:
  br label %merge

merge:
  %p = phi i1 [ %c2, %then ], [ false, %entry ]
  %sel = select i1 %p, i32 %x, i32 42
  ret i32 %sel
}

; The select condition is divergent, so the select is not unfolded.
define amdgpu_cs i32 @unfold_select_in_curr_bb_divergent(i1 inreg %c1, i1 %c2, i32 inreg %x) {
; CHECK-LABEL: define amdgpu_cs i32 @unfold_select_in_curr_bb_divergent(
; CHECK-SAME: i1 inreg [[C1:%.*]], i1 [[C2:%.*]], i32 inreg [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[MERGE:.*]], label %[[THEN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi i1 [ [[C2]], %[[THEN]] ], [ false, %[[ENTRY]] ]
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[P]], i32 [[X]], i32 42
; CHECK-NEXT:    ret i32 [[SEL]]
;
entry:
  br i1 %c1, label %merge, label %then

then:
  br label %merge

merge:
  %p = phi i1 [ %c2, %then ], [ false, %entry ]
  %sel = select i1 %p, i32 %x, i32 42
  ret i32 %sel
}
