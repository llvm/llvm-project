; The select feeds the branch in %merge, so it is unfolded and threaded when that
; branch is uniform.
define amdgpu_cs void @unfold_select_uniform(i1 inreg %c1, i1 inreg %c2, i32 inreg %x, i32 inreg %y) {
; CHECK-LABEL: define amdgpu_cs void @unfold_select_uniform(
; CHECK-SAME: i1 inreg [[C1:%.*]], i1 inreg [[C2:%.*]], i32 inreg [[X:%.*]], i32 inreg [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[MERGE:.*]], label %[[THEN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br i1 [[C2]], label %[[MERGE_TRUE:.*]], label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[X]], %[[THEN]] ], [ [[Y]], %[[ENTRY]] ]
; CHECK-NEXT:    [[C3:%.*]] = icmp eq i32 [[P]], 0
; CHECK-NEXT:    br i1 [[C3]], label %[[MERGE_TRUE]], label %[[EXIT:.*]]
; CHECK:       [[MERGE_TRUE]]:
; CHECK-NEXT:    call void @f(i32 0)
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c1, label %merge, label %then

then:
  %sel = select i1 %c2, i32 0, i32 %x
  br label %merge

merge:
  %p = phi i32 [ %sel, %then ], [ %y, %entry ]
  %c3 = icmp eq i32 %p, 0
  br i1 %c3, label %merge.true, label %exit

merge.true:
  call void @f(i32 0)
  br label %exit

exit:
  ret void
}

