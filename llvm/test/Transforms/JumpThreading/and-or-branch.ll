; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=jump-threading,instcombine %s | FileCheck %s

declare void @f()
declare void @g()
declare i1 @get_value()

; The guard is true on %b.path. Duplicating the branch lets InstCombine
; eliminate the guard on both paths.
; https://github.com/llvm/llvm-project/issues/236700
define i32 @branch_on_and(i1 noundef %cond, i1 noundef %a, i1 noundef %b) {
; CHECK-LABEL: define i32 @branch_on_and(
; CHECK-SAME: i1 noundef [[COND:%.*]], i1 noundef [[A:%.*]], i1 noundef [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[COND]], label %[[JOIN:.*]], label %[[B_PATH:.*]]
; CHECK:       [[B_PATH]]:
; CHECK-NEXT:    call void @g()
; CHECK-NEXT:    br i1 [[B]], label %[[YES:.*]], label %[[NO:.*]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    br i1 [[A]], label %[[YES]], label %[[NO]]
; CHECK:       [[YES]]:
; CHECK-NEXT:    ret i32 0
; CHECK:       [[NO]]:
; CHECK-NEXT:    ret i32 1
;
entry:
  br i1 %cond, label %a.path, label %b.path

a.path:
  call void @f()
  br label %join

b.path:
  call void @g()
  br label %join

join:
  %p = phi i1 [ %a, %a.path ], [ %b, %b.path ]
  %not_cond = xor i1 %cond, true
  %guard = or i1 %not_cond, %a
  %guarded_p = and i1 %p, %guard
  br i1 %guarded_p, label %yes, label %no

yes:
  ret i32 0

no:
  ret i32 1
}

define i32 @branch_on_or(i1 %cond, i1 %flag) {
; CHECK-LABEL: define i32 @branch_on_or(
; CHECK-SAME: i1 [[COND:%.*]], i1 [[FLAG:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[COND]], label %[[A_PATH:.*]], label %[[JOIN:.*]]
; CHECK:       [[A_PATH]]:
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    br i1 [[FLAG]], label %[[YES:.*]], label %[[NO:.*]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[VALUE:%.*]] = call i1 @get_value()
; CHECK-NEXT:    [[EITHER:%.*]] = or i1 [[VALUE]], [[FLAG]]
; CHECK-NEXT:    br i1 [[EITHER]], label %[[YES]], label %[[NO]]
; CHECK:       [[YES]]:
; CHECK-NEXT:    ret i32 0
; CHECK:       [[NO]]:
; CHECK-NEXT:    ret i32 1
;
entry:
  br i1 %cond, label %a.path, label %b.path

a.path:
  call void @f()
  br label %join

b.path:
  %value = call i1 @get_value()
  br label %join

join:
  %p = phi i1 [ false, %a.path ], [ %value, %b.path ]
  %either = or i1 %p, %flag
  br i1 %either, label %yes, label %no

yes:
  ret i32 0

no:
  ret i32 1
}
