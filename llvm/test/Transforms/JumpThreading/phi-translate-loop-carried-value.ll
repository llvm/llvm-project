; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 4
; RUN: opt < %s -passes=jump-threading -S | FileCheck %s

; origin: https://github.com/llvm/llvm-project/issues/226049
;
; The value a loop phi takes on a back edge is the one computed by the
; *previous* iteration.  Here %l.ac feeds %k.check for the edge coming from %ac,
; while the %lc operand of the compare is computed from the *current* iteration
; of %l.  Folding "icmp slt %l.ac, add %l.ac, C" to false conflates the two and
; used to make jump threading route the back edge straight to %exit, dropping
; the loop exit test entirely.

@k = global i64 0
@l = global i64 0
@o = global i16 0

define void @f(i16 %z) {
; CHECK-LABEL: define void @f(
; CHECK-SAME: i16 [[Z:%.*]]) {
; CHECK-NEXT:  body.pre:
; CHECK-NEXT:    [[M0:%.*]] = load i16, ptr @o, align 2
; CHECK-NEXT:    [[K0:%.*]] = load i64, ptr @k, align 4
; CHECK-NEXT:    br label [[CHECK:%.*]]
; CHECK:       ac:
; CHECK-NEXT:    store i64 [[L:%.*]], ptr @k, align 4
; CHECK-NEXT:    [[D:%.*]] = icmp slt i16 [[M2:%.*]], 0
; CHECK-NEXT:    br i1 [[D]], label [[CHECK]], label [[EXIT:%.*]]
; CHECK:       check:
; CHECK-NEXT:    [[K:%.*]] = phi i64 [ [[K0]], [[BODY_PRE:%.*]] ], [ [[L]], [[AC:%.*]] ]
; CHECK-NEXT:    [[M:%.*]] = phi i16 [ [[M0]], [[BODY_PRE]] ], [ [[M2]], [[AC]] ]
; CHECK-NEXT:    [[M2]] = add i16 [[M]], [[Z]]
; CHECK-NEXT:    [[L]] = add nsw i64 [[K]], 934368895
; CHECK-NEXT:    store i64 [[L]], ptr @l, align 4
; CHECK-NEXT:    [[LC:%.*]] = add nsw i64 [[L]], -675898237
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[K]], [[LC]]
; CHECK-NEXT:    br i1 [[C]], label [[AC]], label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    store i16 [[M2]], ptr @o, align 2
; CHECK-NEXT:    ret void
;
entry:
  %m0 = load i16, ptr @o
  br i1 false, label %ac.pre, label %body.pre

body.pre:
  %k0 = load i64, ptr @k
  br label %body

ac.pre:
  %l0 = load i64, ptr @l
  br label %ac

body:
  %k = phi i64 [ %k0, %body.pre ], [ %l.ac, %ac ]
  %m = phi i16 [ %m0, %body.pre ], [ %m.ac, %ac ]
  %m2 = add i16 %m, %z
  %l = add nsw i64 %k, 934368895
  store i64 %l, ptr @l
  br label %check

ac:
  %l.ac = phi i64 [ %l0, %ac.pre ], [ %l.check, %check ]
  %m.ac = phi i16 [ %m0, %ac.pre ], [ %m.check, %check ]
  store i64 %l.ac, ptr @k
  %d = icmp slt i16 %m.ac, 0
  br i1 %d, label %body, label %check

check:
  %l.check = phi i64 [ %l.ac, %ac ], [ %l, %body ]
  %k.check = phi i64 [ %l.ac, %ac ], [ %k, %body ]
  %m.check = phi i16 [ %m.ac, %ac ], [ %m2, %body ]
  %lc = add nsw i64 %l.check, -675898237
  %c = icmp slt i64 %k.check, %lc
  br i1 %c, label %ac, label %exit

exit:
  store i16 %m.check, ptr @o
  ret void
}
