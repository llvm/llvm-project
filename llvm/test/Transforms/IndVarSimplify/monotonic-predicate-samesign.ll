; A samesign compare of an IV with a loop-invariant value may be poison on
; loop entry, when the operands have different signs. That says nothing
; about the compare on later iterations.

declare void @use(i1)

; %iv samesign >u %inv is monotonic, because %iv increments with nuw.
; The check may only change from false to true.
; We have these guards:
;  %inv <s 0
;  %start >s %inv
; So %start samesign >u %inv is true:
;   if %start <s 0  - it is true,
;   if %start >=s 0 - it is poison.
; But it is not enough to fold %cmp to true.
; Picking true for the poison on entry says nothing about %cmp on
; later iterations.
; We actually need %start >u %inv on entry. The guards don't prove that.
; E.g. for %start = -3, %inv = -5, %cmp is true.
; But for %start = 127, %inv = -5, %start samesign >u %inv is poison,
; and %cmp is false when %iv reaches -128, and then it becomes true
; when %iv is -4.
define void @samesign_ugt_signed_guard(i8 %start, i8 %inv, i8 %n) {
; CHECK-LABEL: define void @samesign_ugt_signed_guard(
; CHECK-SAME: i8 [[START:%.*]], i8 [[INV:%.*]], i8 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[INV_NEG:%.*]] = icmp slt i8 [[INV]], 0
; CHECK-NEXT:    [[START_GT:%.*]] = icmp sgt i8 [[START]], [[INV]]
; CHECK-NEXT:    [[GUARD:%.*]] = and i1 [[INV_NEG]], [[START_GT]]
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ], [ [[START]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[IV_NEG:%.*]] = icmp slt i8 [[IV]], 0
; CHECK-NEXT:    br i1 [[IV_NEG]], label %[[CHECK:.*]], label %[[LATCH]]
; CHECK:       [[CHECK]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ugt i8 [[IV]], [[INV]]
; CHECK-NEXT:    call void @use(i1 [[CMP]])
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i8 [[IV]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i8 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %inv.neg = icmp slt i8 %inv, 0
  %start.gt = icmp sgt i8 %start, %inv
  %guard = and i1 %inv.neg, %start.gt
  br i1 %guard, label %loop, label %exit
