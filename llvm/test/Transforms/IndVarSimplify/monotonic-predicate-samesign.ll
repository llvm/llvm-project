  %iv = phi i8 [ %start, %entry ], [ %iv.next, %latch ]
  %iv.neg = icmp slt i8 %iv, 0
  br i1 %iv.neg, label %check, label %latch
check:
  %cmp = icmp samesign ugt i8 %iv, %inv
  call void @use(i1 %cmp)
  br label %latch
latch:
  %iv.next = add nuw i8 %iv, 1
  %done = icmp eq i8 %iv.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

