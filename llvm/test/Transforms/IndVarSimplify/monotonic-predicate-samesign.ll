; RUN: opt -passes=indvars -S < %s | FileCheck %s

; s >s inv does not make %c true on every iteration: with s = 3 and inv = -5,
; %c is false on the last iteration, where %iv = INT_MIN.
define i32 @samesign_ugt_signed_guard(i32 %s, i32 %inv) {
; CHECK-LABEL: define i32 @samesign_ugt_signed_guard(
; CHECK-SAME: i32 [[S:%.*]], i32 [[INV:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[G:%.*]] = icmp sgt i32 [[S]], [[INV]]
; CHECK-NEXT:    br i1 [[G]], label %[[LOOP_PREHEADER:.*]], label %[[BAIL:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ [[S]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp samesign ugt i32 [[IV]], [[INV]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV]], -2147483648
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[C_LCSSA:%.*]] = phi i1 [ [[C]], %[[LOOP]] ]
; CHECK-NEXT:    [[R:%.*]] = zext i1 [[C_LCSSA]] to i32
; CHECK-NEXT:    ret i32 [[R]]
; CHECK:       [[BAIL]]:
; CHECK-NEXT:    ret i32 7
;
entry:
  %g = icmp sgt i32 %s, %inv
  br i1 %g, label %loop, label %bail
loop:
  %iv = phi i32 [ %s, %entry ], [ %iv.next, %loop ]
  %c = icmp samesign ugt i32 %iv, %inv
  %iv.next = add nuw i32 %iv, 1
  %ec = icmp eq i32 %iv, u0x80000000
  br i1 %ec, label %exit, label %loop
exit:
  %r = zext i1 %c to i32
  ret i32 %r
bail:
  ret i32 7
}

