; RUN: opt -passes='loop(indvars)' -verify-each -S < %s | FileCheck %s --implicit-check-not='mul ' --implicit-check-not='or disjoint'

; Reuse the exit value by replacing its disjoint or with an add. Without reuse,
; SCEVExpander emits a multiply chain:
;
;   %0 = mul i24 %hi, 257
;   %1 = add i24 %0, 513
;
; Reduced from Transforms/PhaseOrdering/reuse-disjoint-or-exit-value.ll at the
; inner loop's indvars invocation. Keep the outer recurrence: without it,
; re-expansion only needs a trunc and an add and is cheaper than reuse.
;
; Check that indvars reuses %hi.trunc without a multiply. The phase-ordering
; test covers the subsequent folding and sinking of the reused chain.
; The inner-loop exit rewrite replaces an or in the containing outer loop.

define i1 @reuse_disjoint_or_exit_value(i32 %itr) {
; CHECK-LABEL: define i1 @reuse_disjoint_or_exit_value(
; CHECK-SAME: i32 [[ITR:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[OUTER_CMP:%.*]] = icmp eq i32 [[ITR]], 0
; CHECK-NEXT:    br label %[[SPLIT:.*]]
; CHECK:       [[SPLIT]]:
; CHECK-NEXT:    [[HI:%.*]] = phi i24 [ 0, %[[ENTRY]] ], [ [[HI_TRUNC:%.*]], %[[OUTER_LOOPEXIT:.*]] ]
; CHECK-NEXT:    br label %[[INNER_LATCH:.*]]
; CHECK:       [[INNER_LATCH]]:
; CHECK-NEXT:    br i1 false, label %[[INNER_LATCH]], label %[[OUTER_LOOPEXIT]]
; CHECK:       [[OUTER_LOOPEXIT]]:
; CHECK-NEXT:    [[OR:%.*]] = add i24 [[HI]], 1
; CHECK-NEXT:    [[OR_EXT:%.*]] = zext i24 [[OR]] to i32
; CHECK-NEXT:    [[STEP:%.*]] = add nuw nsw i32 [[OR_EXT]], 1
; CHECK-NEXT:    [[STEP_HI:%.*]] = shl i32 [[STEP]], 8
; CHECK-NEXT:    [[COMBINED:%.*]] = add i32 [[STEP_HI]], [[OR_EXT]]
; CHECK-NEXT:    [[HI_TRUNC]] = trunc i32 [[COMBINED]] to i24
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i24 [[HI]] to i8
; CHECK-NEXT:    [[TMP1:%.*]] = add i8 [[TMP0]], 2
; CHECK-NEXT:    br i1 [[OUTER_CMP]], label %[[SPLIT]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[LO_LCSSA:%.*]] = phi i8 [ [[TMP1]], %[[OUTER_LOOPEXIT]] ]
; CHECK-NEXT:    [[RES:%.*]] = icmp eq i8 [[LO_LCSSA]], 0
; CHECK-NEXT:    ret i1 [[RES]]
;
entry:
  %outer.cmp = icmp eq i32 %itr, 0
  br label %split

split:                                            ; preds = %entry, %outer.loopexit
  %hi = phi i24 [ 0, %entry ], [ %hi.next.lcssa, %outer.loopexit ]
  %or = or disjoint i24 %hi, 1
  %or.ext = zext i24 %or to i32
  %step = add nuw nsw i32 %or.ext, 1
  %step.hi = shl i32 %step, 8
  %lo.trunc = trunc i32 %step to i8
  %combined = add i32 %step.hi, %or.ext
  %hi.trunc = trunc i32 %combined to i24
  br label %inner.latch

inner.latch:                                      ; preds = %inner.latch, %split
  %hi.next = phi i24 [ %hi.trunc, %inner.latch ], [ 0, %split ]
  %lo.next = phi i8 [ %lo.trunc, %inner.latch ], [ 0, %split ]
  %inner.cmp = phi i1 [ false, %inner.latch ], [ true, %split ]
  br i1 %inner.cmp, label %inner.latch, label %outer.loopexit

outer.loopexit:                                   ; preds = %inner.latch
  %hi.next.lcssa = phi i24 [ %hi.next, %inner.latch ]
  %lo.next.lcssa = phi i8 [ %lo.next, %inner.latch ]
  br i1 %outer.cmp, label %split, label %exit

exit:                                             ; preds = %outer.loopexit
  %lo.lcssa = phi i8 [ %lo.next.lcssa, %outer.loopexit ]
  %res = icmp eq i8 %lo.lcssa, 0
  ret i1 %res
}

; Reusing %scaled for the first exit phi replaces %or inside the loop. The
; second phi's saved expansion point is that same or, which must remain in
; the IR until both expansions finish. %scaled.copy puts the first expansion
; point after %scaled so it can be reused without hoisting out of the loop.
define i64 @replaced_insertion_point(i64 %left, i64 %right, i1 %again) {
; CHECK-LABEL: define i64 @replaced_insertion_point(
; CHECK-SAME: i64 [[LEFT:%.*]], i64 [[RIGHT:%.*]], i1 [[AGAIN:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[OR:%.*]] = add i64 [[LEFT]], [[RIGHT]]
; CHECK-NEXT:    [[SCALED:%.*]] = shl i64 [[OR]], 2
; CHECK-NEXT:    br i1 [[AGAIN]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[SCALED_LCSSA:%.*]] = phi i64 [ [[SCALED]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[RIGHT]], [[LEFT]]
; CHECK-NEXT:    [[RES:%.*]] = add i64 [[SCALED_LCSSA]], [[TMP0]]
; CHECK-NEXT:    ret i64 [[RES]]
;
entry:
  br label %loop

loop:
  %or = or disjoint i64 %left, %right
  %scaled = shl i64 %or, 2
  %scaled.copy = add i64 %scaled, 0
  br i1 %again, label %loop, label %exit

exit:
  %scaled.lcssa = phi i64 [ %scaled.copy, %loop ]
  %or.lcssa = phi i64 [ %or, %loop ]
  %res = add i64 %scaled.lcssa, %or.lcssa
  ret i64 %res
}

; Rewriting the inner loop's exit value reuses %scaled and replaces an or
; outside that loop. Keep the or's replacement in the outer header with a
; volatile store, even after the exit-value computation is sunk.
define i64 @replace_outer_or(ptr %out, i64 %left, i64 %right, i1 %outer.again) {
; CHECK-LABEL: define i64 @replace_outer_or(
; CHECK-SAME: ptr [[OUT:%.*]], i64 [[LEFT:%.*]], i64 [[RIGHT:%.*]], i1 [[OUTER_AGAIN:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[OR:%.*]] = add i64 [[LEFT]], [[RIGHT]]
; CHECK-NEXT:    store volatile i64 [[OR]], ptr [[OUT]], align 4
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    br i1 false, label %[[INNER]], label %[[OUTER_LATCH:.*]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    br i1 [[OUTER_AGAIN]], label %[[OUTER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[RIGHT]], [[LEFT]]
; CHECK-NEXT:    [[TMP1:%.*]] = shl i64 [[TMP0]], 2
; CHECK-NEXT:    ret i64 [[TMP1]]
;
entry:
  br label %outer

outer:
  %or = or disjoint i64 %left, %right
  %scaled = shl i64 %or, 2
  store volatile i64 %or, ptr %out
  br label %inner

inner:
  %value = phi i64 [ 0, %outer ], [ %scaled, %inner ]
  %inner.again = phi i1 [ true, %outer ], [ false, %inner ]
  br i1 %inner.again, label %inner, label %outer.latch

outer.latch:
  %value.lcssa = phi i64 [ %value, %inner ]
  br i1 %outer.again, label %outer, label %exit

exit:
  %res = phi i64 [ %value.lcssa, %outer.latch ]
  ret i64 %res
}
