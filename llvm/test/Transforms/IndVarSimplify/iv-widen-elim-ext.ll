  br label %loop
loop:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
  %idx = add nsw i32 %iv, -32
  %idx.ext = zext nneg i32 %idx to i64
  call void @use(i64 %idx.ext)
  %iv.sext = sext i32 %iv to i64
  call void @use(i64 %iv.sext)
