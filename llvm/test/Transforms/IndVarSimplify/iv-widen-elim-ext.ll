; %M may be negative, so %add3 = %i.02 + %M may be negative, and
; zext(%add3) != sext(%add3). So the trunc of the wide add and the zext
; can't be eliminated.
define void @foo3_neg(ptr %p, i32 %M) {
; CHECK-LABEL: @foo3_neg(
; CHECK-NEXT:  entry:
