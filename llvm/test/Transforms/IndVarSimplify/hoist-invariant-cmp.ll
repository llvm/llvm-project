define i64 @hoist_invariant_cmp(ptr %p, i64 %n, i64 %start) {
; CHECK-LABEL: define i64 @hoist_invariant_cmp(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i64 [[START:%.*]]) {
