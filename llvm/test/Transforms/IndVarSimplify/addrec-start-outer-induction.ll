; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=indvars -S < %s | FileCheck %s

target datalayout = "e-m:e-i64:64-n32:64-S128"

declare void @use(i1)
declare i1 @cond()

; %a and %b start at the outer IVs %oa and %ob. %oa <s %ob holds on entry to
; the outer loop and on its backedge, so it holds on every outer iteration,
; and %a <s %b holds on every inner iteration.
; TODO: %c can be folded to true.
define void @outer_latch_induction(i32 %x, i32 %y) {
; CHECK-LABEL: define void @outer_latch_induction(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[G:%.*]] = icmp slt i32 [[X]], [[Y]]
; CHECK-NEXT:    br i1 [[G]], label %[[OUTER_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_PREHEADER]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[OA:%.*]] = phi i32 [ [[OA_NEXT:%.*]], %[[OUTER_LATCH:.*]] ], [ [[X]], %[[OUTER_PREHEADER]] ]
; CHECK-NEXT:    [[OB:%.*]] = phi i32 [ [[OB_NEXT:%.*]], %[[OUTER_LATCH]] ], [ [[Y]], %[[OUTER_PREHEADER]] ]
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[A:%.*]] = phi i32 [ [[OA]], %[[OUTER]] ], [ [[A_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[B:%.*]] = phi i32 [ [[OB]], %[[OUTER]] ], [ [[B_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[A]], [[B]]
; CHECK-NEXT:    call void @use(i1 [[C]])
; CHECK-NEXT:    [[A_NEXT]] = add nsw i32 [[A]], 1
; CHECK-NEXT:    [[B_NEXT]] = add nsw i32 [[B]], 1
; CHECK-NEXT:    [[IE:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[IE]], label %[[INNER]], label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[OA_NEXT]] = add nsw i32 [[OA]], 1
; CHECK-NEXT:    [[OB_NEXT]] = add nsw i32 [[OB]], 1
; CHECK-NEXT:    [[OC:%.*]] = icmp slt i32 [[OA_NEXT]], [[OB_NEXT]]
; CHECK-NEXT:    [[OX:%.*]] = call i1 @cond()
; CHECK-NEXT:    [[OE:%.*]] = and i1 [[OC]], [[OX]]
; CHECK-NEXT:    br i1 [[OE]], label %[[OUTER]], label %[[EXIT_LOOPEXIT:.*]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %g = icmp slt i32 %x, %y
  br i1 %g, label %outer, label %exit
outer:
  %oa = phi i32 [ %x, %entry ], [ %oa.next, %outer.latch ]
  %ob = phi i32 [ %y, %entry ], [ %ob.next, %outer.latch ]
  br label %inner
inner:
  %a = phi i32 [ %oa, %outer ], [ %a.next, %inner ]
  %b = phi i32 [ %ob, %outer ], [ %b.next, %inner ]
  %c = icmp slt i32 %a, %b
  call void @use(i1 %c)
  %a.next = add nsw i32 %a, 1
  %b.next = add nsw i32 %b, 1
  %ie = call i1 @cond()
  br i1 %ie, label %inner, label %outer.latch
outer.latch:
  %oa.next = add nsw i32 %oa, 1
  %ob.next = add nsw i32 %ob, 1
  %oc = icmp slt i32 %oa.next, %ob.next
  %ox = call i1 @cond()
  %oe = and i1 %oc, %ox
  br i1 %oe, label %outer, label %exit
exit:
  ret void
}
