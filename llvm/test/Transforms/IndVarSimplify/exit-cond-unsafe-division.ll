; CHECK-NEXT:    [[M:%.*]] = mul i64 [[IV]], [[IV]]
; CHECK-NEXT:    [[B:%.*]] = add i64 [[M]], [[N]]
; CHECK-NEXT:    [[C_0:%.*]] = icmp slt i64 [[IV]], [[B]]
; CHECK-NEXT:    br i1 [[C_0]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[D:%.*]] = urem i64 42, [[N]]
