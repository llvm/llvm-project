; CHECK-NEXT:    br i1 [[C_1]], label %[[EXIT]], label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[P:%.*]] = phi i64 [ 1, %[[LOOP_HEADER]] ], [ 0, %[[LOOP_LATCH]] ]
; CHECK-NEXT:    ret i64 [[P]]
;
entry:
