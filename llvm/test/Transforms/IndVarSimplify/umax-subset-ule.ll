; RUN: opt -passes=indvars -S < %s | FileCheck %s

declare void @side_effect()

; TODO: umax(a, b) u<= umax(a, b, c) is trivially true, so the header exit is
; unreachable and IndVarSimplify replaces its branch condition with true.
define void @umax_subset_ule_folded(i32 %n, i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: @umax_subset_ule_folded(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LATCH:%.*]] ]
; CHECK-NEXT:    [[M1:%.*]] = call i32 @llvm.umax.i32(i32 [[A:%.*]], i32 [[B:%.*]])
; CHECK-NEXT:    [[TMP:%.*]] = call i32 @llvm.umax.i32(i32 [[A]], i32 [[C:%.*]])
; CHECK-NEXT:    [[M2:%.*]] = call i32 @llvm.umax.i32(i32 [[TMP]], i32 [[B]])
; CHECK-NEXT:    [[INV_COND:%.*]] = icmp ule i32 [[M1]], [[M2]]
; CHECK-NEXT:    br i1 [[INV_COND]], label [[LATCH]], label [[EXIT:%.*]]
; CHECK:       latch:
; CHECK-NEXT:    call void @side_effect()
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
; CHECK-NEXT:    [[EXIT_CMP:%.*]] = icmp ult i32 [[IV_NEXT]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[EXIT_CMP]], label [[LOOP]], label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %m1 = call i32 @llvm.umax.i32(i32 %a, i32 %b)
  %tmp = call i32 @llvm.umax.i32(i32 %a, i32 %c)
  %m2 = call i32 @llvm.umax.i32(i32 %tmp, i32 %b)
  %inv.cond = icmp ule i32 %m1, %m2
  br i1 %inv.cond, label %latch, label %exit
latch:
  call void @side_effect()
  %iv.next = add nuw i32 %iv, 1
  %exit.cmp = icmp ult i32 %iv.next, %n
  br i1 %exit.cmp, label %loop, label %exit
exit:
  ret void
}

; Negative test: umax(a, c) is NOT a subset of umax(a, b), so the compare must
; remain and the exit branch is preserved.
