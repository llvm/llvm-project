; IndVars replaces a compare of an IV with a loop-invariant value by its value
; on loop entry, if:
;  - Monotonicity: once the compare is true, it stays true.
;  - Backedge guard: the backedge is taken only if the compare is true.
; If the compare may be poison, both must hold for the same picks of its
; poison values.

declare void @use(i1)

; %cmp must not be replaced with %start samesign >u %inv.
; E.g. for %start = 127, %inv = -1, %cmp is poison at %iv = 127, and false at
; %iv = -128.
; Monotonicity: needs the poison at %iv = 127 to be picked false, because
; %cmp is false on the next iteration.
; Backedge guard: needs it to be picked true, because the backedge is taken at
; %iv = 127.
define void @samesign_ugt_signed_latch(i8 %start, i8 %inv) {
; CHECK-LABEL: define void @samesign_ugt_signed_latch(
; CHECK-SAME: i8 [[START:%.*]], i8 [[INV:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ugt i8 [[IV]], [[INV]]
; CHECK-NEXT:    call void @use(i1 [[CMP]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i8 [[IV]], 1
; CHECK-NEXT:    [[LATCH_COND:%.*]] = icmp sgt i8 [[IV]], [[INV]]
; CHECK-NEXT:    br i1 [[LATCH_COND]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %iv = phi i8 [ %start, %entry ], [ %iv.next, %loop ]
  %cmp = icmp samesign ugt i8 %iv, %inv
  call void @use(i1 %cmp)
  %iv.next = add nuw i8 %iv, 1
  %latch.cond = icmp sgt i8 %iv, %inv
  br i1 %latch.cond, label %loop, label %exit
exit:
  ret void
}

; %cmp can be replaced with %start samesign >u %inv.
; Backedge guard: the latch is %iv >u %inv, so when the backedge is taken, %cmp
; is true or poison.
; Monotonicity: once %iv >u %inv is true, it stays true, because %iv only grows
; (nuw). So once the backedge is taken, %cmp stays true or poison.
; %start samesign >u %inv is poison only if %start <s 0 <=s %inv. Then %iv
; stays negative (nuw), so %cmp is poison on every iteration too.
define void @samesign_ugt_unsigned_latch(i8 %start, i8 %inv) {
; CHECK-LABEL: define void @samesign_ugt_unsigned_latch(
; CHECK-SAME: i8 [[START:%.*]], i8 [[INV:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ugt i8 [[START]], [[INV]]
; CHECK-NEXT:    call void @use(i1 [[CMP]])
; CHECK-NEXT:    [[LATCH_COND:%.*]] = icmp ugt i8 [[START]], [[INV]]
; CHECK-NEXT:    br i1 [[LATCH_COND]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %iv = phi i8 [ %start, %entry ], [ %iv.next, %loop ]
  %cmp = icmp samesign ugt i8 %iv, %inv
  call void @use(i1 %cmp)
  %iv.next = add nuw i8 %iv, 1
  %latch.cond = icmp ugt i8 %iv, %inv
  br i1 %latch.cond, label %loop, label %exit
exit:
  ret void
}

