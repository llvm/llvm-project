; The udiv in the step is only executed when %iv < %n, so the IV must not be
; widened by expanding the step in the loop header.
define void @udiv_step_may_trap(i32 %n) {
; CHECK-LABEL: define void @udiv_step_may_trap(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[E:%.*]] = sext i32 [[IV]] to i64
; CHECK-NEXT:    [[ACC_NEXT:%.*]] = or i64 0, [[E]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LATCH]], label %[[EXIT:.*]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[STEP:%.*]] = udiv i32 1, [[N]]
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], [[STEP]]
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %e = sext i32 %iv to i64
  %acc.next = or i64 0, %e
  %cmp = icmp slt i32 %iv, %n
  br i1 %cmp, label %latch, label %exit

latch:
  %step = udiv i32 1, %n
  %iv.next = add nsw i32 %iv, %step
  br label %loop

exit:
  ret void
}

