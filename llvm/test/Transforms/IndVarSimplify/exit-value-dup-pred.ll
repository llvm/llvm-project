; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes='loop(indvars),verify' -S | FileCheck %s

; An exit block reached by two edges from the same predecessor (a switch with
; two cases branching to the same successor) has PHI nodes that list that
; predecessor twice. All entries for a repeated predecessor must hold the same
; value, so rewriting the exit value has to update both of them.
; See https://github.com/llvm/llvm-project/issues/221878

define void @dup_exit_pred() {
; CHECK-LABEL: define void @dup_exit_pred() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ [[AND2_LCSSA:%.*]], %[[EXIT:.*]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i8 [[IV]] to i1
; CHECK-NEXT:    [[TMP1:%.*]] = zext i1 [[TMP0]] to i8
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[AND1:%.*]] = and i8 [[IV]], 1
; CHECK-NEXT:    switch i8 0, label %[[INNER]] [
; CHECK-NEXT:      i8 5, label %[[EXIT]]
; CHECK-NEXT:      i8 7, label %[[EXIT]]
; CHECK-NEXT:    ]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[AND2_LCSSA]] = phi i8 [ [[AND1]], %[[INNER]] ], [ [[AND1]], %[[INNER]] ]
; CHECK-NEXT:    [[LCSSA:%.*]] = phi i8 [ [[TMP1]], %[[INNER]] ], [ [[TMP1]], %[[INNER]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i8 0, [[LCSSA]]
; CHECK-NEXT:    br label %[[OUTER]]
;
entry:
  br label %outer

outer:
  %iv = phi i8 [ %and2, %exit ], [ 0, %entry ]
  br label %inner

inner:
  %and1 = and i8 %iv, 1
  %and2 = and i8 %iv, 1
  switch i8 0, label %inner [
  i8 5, label %exit
  i8 7, label %exit
  ]

exit:
  %lcssa = phi i8 [ %and1, %inner ], [ %and1, %inner ]
  %cmp = icmp ne i8 0, %lcssa
  br label %outer
}
