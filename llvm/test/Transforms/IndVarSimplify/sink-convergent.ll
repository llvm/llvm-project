; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[C:%.*]] = call i32 @readnone_op(i32 [[A]])
; CHECK-NEXT:    ret i32 [[C]]
;
entry:
  %c = call i32 @readnone_op(i32 %a)
  br label %loop

loop:
  %cond = call i1 @cond()
  br i1 %cond, label %loop, label %exit

exit:
