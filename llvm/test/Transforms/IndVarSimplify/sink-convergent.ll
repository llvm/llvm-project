; A convergent call that is not used in the loop must stay in the preheader.
; Sinking it to the exit block would move it across the loop's exit branches.
define i32 @no_sink_convergent(i32 %a) {
; CHECK-LABEL: define i32 @no_sink_convergent(
; CHECK-SAME: i32 [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C:%.*]] = call i32 @convergent_op(i32 [[A]])
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[COND:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[C]]
;
entry:
  %c = call i32 @convergent_op(i32 %a)
  br label %loop

loop:
  %cond = call i1 @cond()
  br i1 %cond, label %loop, label %exit

exit:
  ret i32 %c
}

