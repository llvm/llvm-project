; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=indvars -S < %s | FileCheck %s

target datalayout = "e-m:e-i64:64-n8:16:32:64-S128"

declare void @use()

; if (start >=s 32)
;   for (int64_t i = start; i <= 9999; i++)
; The exit is rewritten to i + 1 == smax(start, 9999) + 1.
define void @lftr_smax_bound(i64 %start) {
; CHECK-LABEL: define void @lftr_smax_bound(
; CHECK-SAME: i64 [[START:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[GUARD:%.*]] = icmp sge i64 [[START]], 32
; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[SMAX:%.*]] = call i64 @llvm.smax.i64(i64 [[START]], i64 9999)
; CHECK-NEXT:    [[TMP0:%.*]] = add nuw i64 [[SMAX]], 1
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ [[START]], %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    call void @use()
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp eq i64 [[IV_NEXT]], [[TMP0]]
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %guard = icmp sge i64 %start, 32
  br i1 %guard, label %loop, label %exit
loop:
  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
  call void @use()
  %iv.next = add nuw nsw i64 %iv, 1
  %done = icmp sgt i64 %iv, 9998
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
