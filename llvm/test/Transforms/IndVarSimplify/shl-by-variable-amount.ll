; RUN: opt -passes=indvars -S < %s | FileCheck %s

; The exit value of %shl is (%n * 2^%v). Expanding a power of two that feeds a
; multiply must recover the single shift the expression was created from,
; rather than materializing `shl 1, %v` and multiplying by it.

define i32 @exit_value_of_shift(i32 %n, i32 %v) {
; CHECK-LABEL: define i32 @exit_value_of_shift(
; CHECK-SAME: i32 [[N:%.*]], i32 [[V:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = shl i32 [[N]], [[V]]
; CHECK-NEXT:    ret i32 [[TMP0]]
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %shl = shl i32 %iv, %v
  %iv.next = add nuw nsw i32 %iv, 1
  %c = icmp ugt i32 %iv.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret i32 %shl
}
