; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=indvars < %s | FileCheck %s

; Check that NSW is not restored on the wide increment when the narrow IV is
; only congruent to the wide IV via truncation.
; https://github.com/llvm/llvm-project/issues/237702

target triple = "aarch64-unknown-linux-gnu"

@g = global i32 0

; The wide IV starts at its signed maximum, so the wide increment wraps in the
; first iteration while the narrow increment does not.
define void @trunc_congruent_wide_at_smax() {
; CHECK-LABEL: define void @trunc_congruent_wide_at_smax() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[W:%.*]] = phi i16 [ 32767, %[[ENTRY]] ], [ [[W_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[N:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[N_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[INDVARS1:%.*]] = trunc i16 [[W]] to i8
; CHECK-NEXT:    [[Z:%.*]] = icmp eq i8 [[INDVARS1]], 0
; CHECK-NEXT:    br i1 [[Z]], label %[[HIT:.*]], label %[[LATCH]]
; CHECK:       [[HIT]]:
; CHECK-NEXT:    store i32 42, ptr @g, align 4
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[W_NEXT]] = add nuw i16 [[W]], 1
; CHECK-NEXT:    [[N_NEXT]] = add nuw nsw i32 [[N]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[N_NEXT]], 2
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %w = phi i16 [ 32767, %entry ], [ %w.next, %latch ]
  %i = phi i8 [ -1, %entry ], [ %i.next, %latch ]
  %n = phi i32 [ 0, %entry ], [ %n.next, %latch ]
  %z = icmp eq i8 %i, 0
  br i1 %z, label %hit, label %latch

hit:
  store i32 42, ptr @g
  br label %latch

latch:
  %w.next = add nsw i16 %w, 1
  %i.next = add nsw i8 %i, 1
  %n.next = add i32 %n, 1
  %c = icmp eq i32 %n.next, 2
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

; The wide IV steps by 513 (0x201) and the narrow IV by 1: their low 8 bits
; agree, but the wide increment wraps (signed) in iteration 64, while the narrow
; increment does not wrap within the 100 iterations.
define void @trunc_congruent_step_mismatch() {
; CHECK-LABEL: define void @trunc_congruent_step_mismatch() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[W:%.*]] = phi i16 [ 0, %[[ENTRY]] ], [ [[W_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[N:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[N_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[INDVARS1:%.*]] = trunc i16 [[W]] to i8
; CHECK-NEXT:    [[Z:%.*]] = icmp eq i8 [[INDVARS1]], 5
; CHECK-NEXT:    br i1 [[Z]], label %[[HIT:.*]], label %[[LATCH]]
; CHECK:       [[HIT]]:
; CHECK-NEXT:    store i32 42, ptr @g, align 4
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[W_NEXT]] = add nuw i16 [[W]], 513
; CHECK-NEXT:    [[N_NEXT]] = add nuw nsw i32 [[N]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[N_NEXT]], 100
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %w = phi i16 [ 0, %entry ], [ %w.next, %latch ]
  %i = phi i8 [ 0, %entry ], [ %i.next, %latch ]
  %n = phi i32 [ 0, %entry ], [ %n.next, %latch ]
  %z = icmp eq i8 %i, 5
  br i1 %z, label %hit, label %latch

hit:
  store i32 42, ptr @g
  br label %latch

latch:
  %w.next = add nsw i16 %w, 513
  %i.next = add nsw i8 %i, 1
  %n.next = add i32 %n, 1
  %c = icmp eq i32 %n.next, 100
  br i1 %c, label %exit, label %loop

exit:
  ret void
}
