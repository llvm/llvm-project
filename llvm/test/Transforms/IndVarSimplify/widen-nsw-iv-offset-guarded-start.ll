; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %c = icmp sge i32 %start, 32
  br i1 %c, label %loop, label %exit
loop:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
  %idx = add nsw i32 %iv, -32
  %idx.ext = zext i32 %idx to i64
