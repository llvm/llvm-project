; RUN: opt -passes=indvars -S %s | FileCheck %s

declare void @use(i64)

; The exit values of %x and %y share (-1 + %n) * %b. Only %x is a nuw
; recurrence, so only its copy has the use flag <u nuw>. The multiply should
; be expanded once.
define void @flagged_first(i64 %n, i64 %a, i64 %c, i64 %b) {
; CHECK-LABEL: define void @flagged_first(
; CHECK-SAME: i64 [[N:%.*]], i64 [[A:%.*]], i64 [[C:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[N]], -1
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[B]], [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = add nuw i64 [[A]], [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = add i64 [[C]], [[TMP1]]
; CHECK-NEXT:    call void @use(i64 [[TMP2]])
; CHECK-NEXT:    call void @use(i64 [[TMP3]])
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %x = phi i64 [ %a, %entry ], [ %x.next, %loop ]
  %y = phi i64 [ %c, %entry ], [ %y.next, %loop ]
  %x.next = add nuw i64 %x, %b
  %y.next = add i64 %y, %b
  %iv.next = add nuw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  %x.lcssa = phi i64 [ %x, %loop ]
  %y.lcssa = phi i64 [ %y, %loop ]
  call void @use(i64 %x.lcssa)
  call void @use(i64 %y.lcssa)
  ret void
}

