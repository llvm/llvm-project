; start >=s 0 >=s nonpos.
define void @exit_invariant_nonpos(i32 %start, ptr %p, ptr %q) {
; CHECK-LABEL: define void @exit_invariant_nonpos(
; CHECK-SAME: i32 [[START:%.*]], ptr [[P:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LEN:%.*]] = load i32, ptr [[P]], align 4, !range [[RNG0]]
; CHECK-NEXT:    [[NONPOS:%.*]] = load i32, ptr [[Q]], align 4, !range [[RNG2:![0-9]+]]
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[START]], [[LEN]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[LATCH:.*]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[LT:%.*]] = icmp slt i32 [[START]], [[NONPOS]]
; CHECK-NEXT:    br i1 [[LT]], label %[[EXIT_LOOPEXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    call void @side()
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp ne i32 [[I_NEXT]], 100
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[LOOP]], label %[[EXIT_LOOPEXIT]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %len = load i32, ptr %p, !range !0
  %nonpos = load i32, ptr %q, !range !2
  %c = icmp ult i32 %start, %len
  br i1 %c, label %loop, label %exit
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %lt = icmp slt i32 %start, %nonpos
  br i1 %lt, label %exit, label %latch
latch:
  call void @side()
  %i.next = add nuw nsw i32 %i, 1
  %ec = icmp ult i32 %i.next, 100
  br i1 %ec, label %loop, label %exit
exit:
  ret void
}

; len is non-negative only because of a dominating guard.
define void @exit_invariant_len_guarded(i32 %start, i32 %len) {
; CHECK-LABEL: define void @exit_invariant_len_guarded(
; CHECK-SAME: i32 [[START:%.*]], i32 [[LEN:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LEN_OK:%.*]] = icmp ult i32 [[LEN]], 1000
; CHECK-NEXT:    br i1 [[LEN_OK]], label %[[PRE:.*]], label %[[EXIT:.*]]
; CHECK:       [[PRE]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[START]], [[LEN]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[LATCH:.*]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i32 [[START]], 0
; CHECK-NEXT:    br i1 [[NEG]], label %[[EXIT_LOOPEXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    call void @side()
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp ne i32 [[I_NEXT]], 100
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[LOOP]], label %[[EXIT_LOOPEXIT]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %len.ok = icmp ult i32 %len, 1000
  br i1 %len.ok, label %pre, label %exit
pre:
  %c = icmp ult i32 %start, %len
  br i1 %c, label %loop, label %exit
loop:
  %i = phi i32 [ 0, %pre ], [ %i.next, %latch ]
  %neg = icmp slt i32 %start, 0
  br i1 %neg, label %exit, label %latch
latch:
  call void @side()
  %i.next = add nuw nsw i32 %i, 1
  %ec = icmp ult i32 %i.next, 100
  br i1 %ec, label %loop, label %exit
exit:
  ret void
}

