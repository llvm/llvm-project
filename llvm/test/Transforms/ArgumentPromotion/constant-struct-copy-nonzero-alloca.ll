; CHECK-NEXT:    [[FIELD0:%.*]] = load i32, ptr addrspace(1) [[DESCRIPTOR]], align 4
; CHECK-NEXT:    [[FIELD1_PTR:%.*]] = getelementptr i8, ptr addrspace(1) [[DESCRIPTOR]], i64 4
; CHECK-NEXT:    [[FIELD1:%.*]] = load i32, ptr addrspace(1) [[FIELD1_PTR]], align 4
; CHECK-NEXT:    [[FIELD2_PTR:%.*]] = getelementptr i8, ptr addrspace(1) [[DESCRIPTOR]], i64 8
; CHECK-NEXT:    [[FIELD2:%.*]] = load i32, ptr addrspace(1) [[FIELD2_PTR]], align 4
; CHECK-NEXT:    [[SUM01:%.*]] = add i32 [[FIELD0]], [[FIELD1]]
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[SUM01]], [[FIELD2]]
; CHECK-NEXT:    ret i32 [[SUM]]
;
entry:
  store i32 99, ptr addrspace(1) %other, align 4
  %field0 = load i32, ptr addrspace(1) %descriptor, align 4
  %field1.ptr = getelementptr i8, ptr addrspace(1) %descriptor, i64 4
  %field1 = load i32, ptr addrspace(1) %field1.ptr, align 4
  %field2.ptr = getelementptr i8, ptr addrspace(1) %descriptor, i64 8
  %field2 = load i32, ptr addrspace(1) %field2.ptr, align 4
  %sum01 = add i32 %field0, %field1
  %sum = add i32 %sum01, %field2
