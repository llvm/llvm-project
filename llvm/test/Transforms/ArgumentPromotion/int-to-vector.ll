; The most common vector type among the immediate bitcasts of the argument,
; the call operands, the returned values and the call results wins: the two
; <4 x i32> bitcasts outvote the one <4 x float>.
define internal i128 @vote(i128 %v) {
; CHECK-LABEL: define internal <4 x i32> @vote(
; CHECK-SAME: <4 x i32> [[V_RETYPED:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = bitcast <4 x i32> [[V_RETYPED]] to i128
; CHECK-NEXT:    [[A:%.*]] = bitcast i128 [[V]] to <4 x i32>
; CHECK-NEXT:    [[B:%.*]] = bitcast i128 [[V]] to <4 x i32>
; CHECK-NEXT:    [[F:%.*]] = bitcast i128 [[V]] to <4 x float>
; CHECK-NEXT:    store <4 x i32> [[A]], ptr @gi, align 16
; CHECK-NEXT:    store <4 x i32> [[B]], ptr @gi, align 16
; CHECK-NEXT:    store <4 x float> [[F]], ptr @g, align 16
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[V]] to <4 x i32>
; CHECK-NEXT:    ret <4 x i32> [[TMP1]]
;
  %a = bitcast i128 %v to <4 x i32>
  %b = bitcast i128 %v to <4 x i32>
  %f = bitcast i128 %v to <4 x float>
  store <4 x i32> %a, ptr @gi
  store <4 x i32> %b, ptr @gi
  store <4 x float> %f, ptr @g
  ret i128 %v
}

define void @call_vote(ptr %p, ptr %q) {
; CHECK-LABEL: define void @call_vote(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = load i128, ptr [[P]], align 16
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[V]] to <4 x i32>
