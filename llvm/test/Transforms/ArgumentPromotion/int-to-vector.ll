; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=argpromotion -S < %s | FileCheck %s
; REQUIRES: aarch64-registered-target

; Integer arguments and return values of local functions that are not used as
; integers are retyped to a vector when the target keeps the integer in several
; registers but the vector in one.
;
; Relevant for example on AArch64 because AAPCS64 forces vector unions to i128
; (which would use x0/x1 instead of a vector register):
;
; typedef union {
;   __float4 v;
;   struct { float x, y, z, w; } parts;
; } float4;
;
; static float4 scale(float4 a, float s) {
;   return (float4){ .v = a.v * s };
; }

target triple = "aarch64-unknown-linux-gnu"

@g = global <4 x float> zeroinitializer
@gi = global <4 x i32> zeroinitializer
@fp = global ptr @address_taken

; The argument and the return value are vectors in disguise.
define internal i128 @scale(i128 %v, float %s) {
; CHECK-LABEL: define internal <4 x float> @scale(
; CHECK-SAME: <4 x float> [[V_RETYPED:%.*]], float [[S:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = bitcast <4 x float> [[V_RETYPED]] to i128
; CHECK-NEXT:    [[F:%.*]] = bitcast i128 [[V]] to <4 x float>
; CHECK-NEXT:    [[I:%.*]] = insertelement <4 x float> poison, float [[S]], i64 0
; CHECK-NEXT:    [[B:%.*]] = shufflevector <4 x float> [[I]], <4 x float> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[M:%.*]] = fmul <4 x float> [[F]], [[B]]
; CHECK-NEXT:    [[R:%.*]] = bitcast <4 x float> [[M]] to i128
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[R]] to <4 x float>
; CHECK-NEXT:    ret <4 x float> [[TMP1]]
;
  %f = bitcast i128 %v to <4 x float>
  %i = insertelement <4 x float> poison, float %s, i64 0
  %b = shufflevector <4 x float> %i, <4 x float> poison, <4 x i32> zeroinitializer
  %m = fmul <4 x float> %f, %b
  %r = bitcast <4 x float> %m to i128
  ret i128 %r
}

define <4 x float> @call_scale(<4 x float> %x) {
; CHECK-LABEL: define <4 x float> @call_scale(
; CHECK-SAME: <4 x float> [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = bitcast <4 x float> [[X]] to i128
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[A]] to <4 x float>
; CHECK-NEXT:    [[C:%.*]] = call <4 x float> @scale(<4 x float> [[TMP1]], float 2.000000e+00)
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <4 x float> [[C]] to i128
; CHECK-NEXT:    [[D:%.*]] = bitcast i128 [[TMP2]] to <4 x float>
; CHECK-NEXT:    ret <4 x float> [[D]]
;
  %a = bitcast <4 x float> %x to i128
  %c = call i128 @scale(i128 %a, float 2.0)
  %d = bitcast i128 %c to <4 x float>
  ret <4 x float> %d
}

; No bitcast of the value is needed: it is read lane by lane (lshr, trunc), and
; only the lanes are bitcast. Lane reads are not integer arithmetic.
define internal float @lanes(i128 %v) {
; CHECK-LABEL: define internal float @lanes(
; CHECK-SAME: <2 x i64> [[V_RETYPED:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = bitcast <2 x i64> [[V_RETYPED]] to i128
; CHECK-NEXT:    [[T0:%.*]] = trunc i128 [[V]] to i32
; CHECK-NEXT:    [[F0:%.*]] = bitcast i32 [[T0]] to float
; CHECK-NEXT:    [[S:%.*]] = lshr i128 [[V]], 64
; CHECK-NEXT:    [[T2:%.*]] = trunc i128 [[S]] to i32
; CHECK-NEXT:    [[F2:%.*]] = bitcast i32 [[T2]] to float
; CHECK-NEXT:    [[R:%.*]] = fadd float [[F0]], [[F2]]
; CHECK-NEXT:    ret float [[R]]
;
  %t0 = trunc i128 %v to i32
  %f0 = bitcast i32 %t0 to float
  %s = lshr i128 %v, 64
  %t2 = trunc i128 %s to i32
  %f2 = bitcast i32 %t2 to float
  %r = fadd float %f0, %f2
  ret float %r
}

define float @call_lanes(ptr %p) {
; CHECK-LABEL: define float @call_lanes(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = load i128, ptr [[P]], align 16
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[V]] to <2 x i64>
; CHECK-NEXT:    [[R:%.*]] = call float @lanes(<2 x i64> [[TMP1]])
; CHECK-NEXT:    ret float [[R]]
;
  %v = load i128, ptr %p
  %r = call float @lanes(i128 %v)
  ret float %r
}

; The other direction: the returned value is built from lanes (zext, shl, or),
; and is never bitcast either.
define internal i128 @build_lanes(float %x, float %y) {
; CHECK-LABEL: define internal <2 x i64> @build_lanes(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[BX:%.*]] = bitcast float [[X]] to i32
; CHECK-NEXT:    [[BY:%.*]] = bitcast float [[Y]] to i32
; CHECK-NEXT:    [[ZX:%.*]] = zext i32 [[BX]] to i128
; CHECK-NEXT:    [[ZY:%.*]] = zext i32 [[BY]] to i128
; CHECK-NEXT:    [[SY:%.*]] = shl i128 [[ZY]], 64
; CHECK-NEXT:    [[R:%.*]] = or disjoint i128 [[ZX]], [[SY]]
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[R]] to <2 x i64>
; CHECK-NEXT:    ret <2 x i64> [[TMP1]]
;
  %bx = bitcast float %x to i32
  %by = bitcast float %y to i32
  %zx = zext i32 %bx to i128
  %zy = zext i32 %by to i128
  %sy = shl i128 %zy, 64
  %r = or disjoint i128 %zx, %sy
  ret i128 %r
}

define void @call_build_lanes(float %x, float %y, ptr %q) {
; CHECK-LABEL: define void @call_build_lanes(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = call <2 x i64> @build_lanes(float [[X]], float [[Y]])
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <2 x i64> [[R]] to i128
; CHECK-NEXT:    store i128 [[TMP1]], ptr [[Q]], align 16
; CHECK-NEXT:    ret void
;
  %r = call i128 @build_lanes(float %x, float %y)
  store i128 %r, ptr %q
  ret void
}

