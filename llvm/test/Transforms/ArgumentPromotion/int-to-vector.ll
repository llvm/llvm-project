; Every returned value counts: one is loaded, the other is bitcast from a
; vector, which decides the type.
define internal i128 @two_returns(i1 %c, ptr %p, <4 x float> %x) {
; CHECK-LABEL: define internal <4 x float> @two_returns(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]], <4 x float> [[X:%.*]]) {
; CHECK-NEXT:    br i1 [[C]], label %[[A:.*]], label %[[B:.*]]
; CHECK:       [[A]]:
; CHECK-NEXT:    [[L:%.*]] = load i128, ptr [[P]], align 16
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[L]] to <4 x float>
; CHECK-NEXT:    ret <4 x float> [[TMP1]]
; CHECK:       [[B]]:
; CHECK-NEXT:    [[R:%.*]] = bitcast <4 x float> [[X]] to i128
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast i128 [[R]] to <4 x float>
; CHECK-NEXT:    ret <4 x float> [[TMP2]]
;
  br i1 %c, label %a, label %b
a:
  %l = load i128, ptr %p
  ret i128 %l
b:
  %r = bitcast <4 x float> %x to i128
  ret i128 %r
}

define void @call_two_returns(i1 %c, ptr %p, <4 x float> %x, ptr %q) {
