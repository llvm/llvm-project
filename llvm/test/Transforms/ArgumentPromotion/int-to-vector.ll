; Self-recursion.
define internal i128 @rec(i128 %v, i32 %n) {
; CHECK-LABEL: define internal <2 x i64> @rec(
; CHECK-SAME: <2 x i64> [[V_RETYPED:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = bitcast <2 x i64> [[V_RETYPED]] to i128
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[N]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[DONE:.*]], label %[[MORE:.*]]
; CHECK:       [[MORE]]:
; CHECK-NEXT:    [[N1:%.*]] = sub i32 [[N]], 1
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i128 [[V]] to <2 x i64>
; CHECK-NEXT:    [[R:%.*]] = call <2 x i64> @rec(<2 x i64> [[TMP1]], i32 [[N1]])
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <2 x i64> [[R]] to i128
; CHECK-NEXT:    [[TMP3:%.*]] = bitcast i128 [[TMP2]] to <2 x i64>
; CHECK-NEXT:    ret <2 x i64> [[TMP3]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    [[TMP4:%.*]] = bitcast i128 [[V]] to <2 x i64>
; CHECK-NEXT:    ret <2 x i64> [[TMP4]]
;
  %c = icmp eq i32 %n, 0
  br i1 %c, label %done, label %more
more:
