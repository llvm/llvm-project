; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --function-signature --scrub-attributes
; RUN: opt < %s -passes=argpromotion -verify-each -S | FileCheck %s

@observed = global i32 0

; sret does not imply noalias. The load must remain after the store when
; both arguments point to the same object.
define internal void @sret_first(ptr sret(i32) %out, ptr %in) {
; CHECK-LABEL: define {{[^@]+}}@sret_first
; CHECK-SAME: (ptr [[OUT:%.*]], ptr [[IN:%.*]]) {
; CHECK-NEXT:    store i32 1, ptr [[OUT]], align 4
; CHECK-NEXT:    [[VALUE:%.*]] = load i32, ptr [[IN]], align 4
; CHECK-NEXT:    store i32 [[VALUE]], ptr @observed, align 4
; CHECK-NEXT:    ret void
;
  store i32 1, ptr %out, align 4
  %value = load i32, ptr %in, align 4
  store i32 %value, ptr @observed, align 4
  ret void
}

define void @call_sret_first(ptr %p) {
; CHECK-LABEL: define {{[^@]+}}@call_sret_first
; CHECK-SAME: (ptr [[P:%.*]]) {
; CHECK-NEXT:    call void @sret_first(ptr [[P]], ptr [[P]])
; CHECK-NEXT:    ret void
;
  call void @sret_first(ptr sret(i32) %p, ptr %p)
  ret void
}

; Also check the case where the sret argument is visited after the input.
define internal void @sret_last(ptr %in, ptr sret(i32) %out) {
; CHECK-LABEL: define {{[^@]+}}@sret_last
; CHECK-SAME: (ptr [[IN:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    store i32 1, ptr [[OUT]], align 4
; CHECK-NEXT:    [[VALUE:%.*]] = load i32, ptr [[IN]], align 4
; CHECK-NEXT:    store i32 [[VALUE]], ptr @observed, align 4
; CHECK-NEXT:    ret void
;
  store i32 1, ptr %out, align 4
  %value = load i32, ptr %in, align 4
  store i32 %value, ptr @observed, align 4
  ret void
}

define void @call_sret_last(ptr %p) {
; CHECK-LABEL: define {{[^@]+}}@call_sret_last
; CHECK-SAME: (ptr [[P:%.*]]) {
; CHECK-NEXT:    call void @sret_last(ptr [[P]], ptr [[P]])
; CHECK-NEXT:    ret void
;
  call void @sret_last(ptr %p, ptr sret(i32) %p)
  ret void
}

; An explicit noalias attribute must be preserved, and still allows promotion.
define internal void @sret_noalias(ptr noalias sret(i32) %out, ptr %in) {
; CHECK-LABEL: define {{[^@]+}}@sret_noalias
; CHECK-SAME: (ptr noalias [[OUT:%.*]], i32 [[IN_0_VAL:%.*]]) {
; CHECK-NEXT:    store i32 1, ptr [[OUT]], align 4
; CHECK-NEXT:    store i32 [[IN_0_VAL]], ptr @observed, align 4
; CHECK-NEXT:    ret void
;
  store i32 1, ptr %out, align 4
  %value = load i32, ptr %in, align 4
  store i32 %value, ptr @observed, align 4
  ret void
}

define void @call_sret_noalias(ptr noalias %out, ptr %in) {
; CHECK-LABEL: define {{[^@]+}}@call_sret_noalias
; CHECK-SAME: (ptr noalias [[OUT:%.*]], ptr [[IN:%.*]]) {
; CHECK-NEXT:    [[IN_VAL:%.*]] = load i32, ptr [[IN]], align 4
; CHECK-NEXT:    call void @sret_noalias(ptr noalias [[OUT]], i32 [[IN_VAL]])
; CHECK-NEXT:    ret void
;
  call void @sret_noalias(ptr noalias sret(i32) %out, ptr %in)
  ret void
}
