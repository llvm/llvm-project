; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=newgvn -S | FileCheck %s

; @g must not be a "constant" global: canReplacePointersIfEqual() treats
; dereferenceable constant globals as always replaceable.
@g = global i32 0, align 4

; Reproducer from issue #234099. On the 'yes' edge %p (noalias) is known equal
; to @g; NewGVN must not replace the store through %p with a store through @g,
; as that changes provenance and breaks the noalias contract.
define i32 @f(ptr noalias %p) noinline {
; CHECK-LABEL: define i32 @f(
; CHECK-SAME: ptr noalias [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    store i32 1, ptr [[P]], align 4
; CHECK-NEXT:    [[EQ:%.*]] = icmp eq ptr [[P]], @g
; CHECK-NEXT:    br i1 [[EQ]], label %[[YES:.*]], label %[[JOIN:.*]]
; CHECK:       [[YES]]:
; CHECK-NEXT:    call void asm sideeffect "", ""()
; CHECK-NEXT:    store i32 2, ptr [[P]], align 4
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  store i32 1, ptr %p, align 4
  %eq = icmp eq ptr %p, @g
  br i1 %eq, label %yes, label %join

yes:
  call void asm sideeffect "", ""()
  store i32 2, ptr %p, align 4
  br label %join

join:
  %v = load i32, ptr %p, align 4
  ret i32 %v
}
