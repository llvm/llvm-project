; A debug record does not keep a global alive, and refers to poison once the
; value it described is erased.

@str = internal constant i32 6

define i32 @debug_value(ptr %p) !dbg !4 {
; CHECK-LABEL: define i32 @debug_value(
; CHECK-SAME: ptr [[P:%.*]]) !dbg [[DBG3:![0-9]+]] {
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:      #dbg_value(i32 poison, [[META6:![0-9]+]], !DIExpression(), [[META8:![0-9]+]])
; CHECK-NEXT:    ret i32 [[V]]
;
  %v = load i32, ptr %p, align 4
  %lim = load i32, ptr @str, align 4
    #dbg_value(i32 %lim, !7, !DIExpression(), !9)
  %cmp = icmp ne i32 %v, %lim
  call void @llvm.assume(i1 %cmp)
  ret i32 %v
}

declare void @llvm.assume(i1)

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!3}

!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
!1 = !DIFile(filename: "t.c", directory: "/")
!3 = !{i32 2, !"Debug Info Version", i32 3}
!4 = distinct !DISubprogram(name: "debug_value", scope: !1, file: !1, type: !5, unit: !0, spFlags: DISPFlagDefinition)
!5 = !DISubroutineType(types: !6)
!6 = !{}
!7 = !DILocalVariable(name: "lim", scope: !4, file: !1, type: !8)
!8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
!9 = !DILocation(line: 1, scope: !4)
;.
