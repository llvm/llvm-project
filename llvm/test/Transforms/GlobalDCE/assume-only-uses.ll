; CHECK-SAME: ptr [[P:%.*]], i16 [[I:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds [2 x i32], ptr @checked, i16 0, i16 [[I]]
; CHECK-NEXT:    [[LIM:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i32 [[V]], [[LIM]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[CONT:.*]], label %[[HANDLER:.*]]
; CHECK:       [[HANDLER]]:
; CHECK-NEXT:    call void @report()
; CHECK-NEXT:    br label %[[CONT]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    call void @llvm.assume(i1 [[CMP]])
; CHECK-NEXT:    ret i32 [[V]]
;
