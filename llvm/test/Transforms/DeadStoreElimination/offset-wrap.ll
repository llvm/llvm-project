; %k == %d + 1 due to wrapping: the i64 store does not overwrite the first byte
; of the i32 store, which must be kept.
define void @wrap(ptr %b) {
; CHECK-LABEL: define void @wrap(
; CHECK-SAME: ptr [[B:%.*]]) {
; CHECK-NEXT:    [[D:%.*]] = getelementptr i8, ptr [[B]], i8 127
; CHECK-NEXT:    [[K:%.*]] = getelementptr i8, ptr [[B]], i8 -128
; CHECK-NEXT:    store i32 1, ptr [[D]], align 1
; CHECK-NEXT:    store i64 2, ptr [[K]], align 1
; CHECK-NEXT:    ret void
;
  %d = getelementptr i8, ptr %b, i8 127
  %k = getelementptr i8, ptr %b, i8 -128
  store i32 1, ptr %d, align 1
  store i64 2, ptr %k, align 1
  ret void
}

; %k == %d + 1 due to wrapping: the store to %d clobbers %k, so the last store
; is not redundant with the first one.
define i32 @wrap_not_redundant(ptr %b) {
; CHECK-LABEL: define i32 @wrap_not_redundant(
