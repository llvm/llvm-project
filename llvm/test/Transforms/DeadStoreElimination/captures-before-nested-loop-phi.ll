; CHECK-NEXT:    [[DATA_OUTER:%.*]] = phi ptr [ [[DATA]], %[[ENTRY]] ], [ [[DATA_NEXT_LCSSA:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr [[PP]], align 8
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[IV_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[DATA_INNER:%.*]] = phi ptr [ [[DATA_OUTER]], %[[OUTER]] ], [ [[DATA_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[BUF_GEP:%.*]] = getelementptr inbounds i8, ptr [[BUF]], i64 [[IV]]
; CHECK-NEXT:    [[L:%.*]] = load i8, ptr [[DATA_INNER]], align 1
; CHECK-NEXT:    store i8 [[L]], ptr [[BUF_GEP]], align 1
; CHECK-NEXT:    [[DATA_GEP:%.*]] = getelementptr inbounds i8, ptr [[DATA_INNER]], i64 1
; CHECK-NEXT:    [[DATA_NEXT]] = select i1 [[C]], ptr [[DATA_GEP]], ptr [[P]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 16
; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER_LATCH]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[DATA_NEXT_LCSSA]] = phi ptr [ [[DATA_NEXT]], %[[INNER]] ]
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw i64 [[OUTER_IV]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i64 [[OUTER_IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    call void @escape(ptr [[BUF]])
; CHECK-NEXT:    ret void
;
entry:
  %buf = alloca [16 x i8]
  br label %outer

outer:
  %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
  %data.outer = phi ptr [ %data, %entry ], [ %data.next.lcssa, %outer.latch ]
  %p = load ptr, ptr %pp
  br label %inner

inner:
  %iv = phi i64 [ 0, %outer ], [ %iv.next, %inner ]
  %data.inner = phi ptr [ %data.outer, %outer ], [ %data.next, %inner ]
  %buf.gep = getelementptr inbounds i8, ptr %buf, i64 %iv
  store i8 0, ptr %buf.gep
  %l = load i8, ptr %data.inner
  store i8 %l, ptr %buf.gep
  %data.gep = getelementptr inbounds i8, ptr %data.inner, i64 1
  %data.next = select i1 %c, ptr %data.gep, ptr %p
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, 16
  br i1 %ec, label %outer.latch, label %inner

outer.latch:
  %data.next.lcssa = phi ptr [ %data.next, %inner ]
  %outer.iv.next = add nuw i64 %outer.iv, 1
  %outer.ec = icmp eq i64 %outer.iv.next, %n
  br i1 %outer.ec, label %exit, label %outer

exit:
  call void @escape(ptr %buf)
  ret void
}

