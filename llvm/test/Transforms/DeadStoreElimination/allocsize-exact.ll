; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=dse -S %s | FileCheck %s

; An `allocsize` that is not `exact` is a lower bound for the size of what the
; function returns. A store of that many bytes then does not overwrite the
; whole object, so stores to other parts of it have to stay.

declare noalias ptr @alloc_at_least(i64) allocsize(0)
declare noalias ptr @alloc_exact(i64) allocsize(0, exact)
declare void @use(ptr)

; The allocator may keep a header in front of the pointer that it returns.
define ptr @at_least_store_before(i64 %x) {
; CHECK-LABEL: define ptr @at_least_store_before(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = call ptr @alloc_at_least(i64 8)
; CHECK-NEXT:    [[HEADER:%.*]] = getelementptr i8, ptr [[P]], i64 -8
; CHECK-NEXT:    store i64 [[X]], ptr [[HEADER]], align 4
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    call void @use(ptr [[P]])
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @alloc_at_least(i64 8)
  %header = getelementptr i8, ptr %p, i64 -8
  store i64 %x, ptr %header
  store i64 1, ptr %p
  call void @use(ptr %p)
  ret ptr %p
}

; The allocator may return more memory than the lower bound.
define ptr @at_least_store_after(i64 %x) {
; CHECK-LABEL: define ptr @at_least_store_after(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = call ptr @alloc_at_least(i64 8)
; CHECK-NEXT:    [[TAIL:%.*]] = getelementptr i8, ptr [[P]], i64 8
; CHECK-NEXT:    store i64 [[X]], ptr [[TAIL]], align 4
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    call void @use(ptr [[P]])
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @alloc_at_least(i64 8)
  %tail = getelementptr i8, ptr %p, i64 8
  store i64 %x, ptr %tail
  store i64 1, ptr %p
  call void @use(ptr %p)
  ret ptr %p
}

; A store to the same bytes is dead either way.
define ptr @at_least_store_same(i64 %x) {
; CHECK-LABEL: define ptr @at_least_store_same(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = call ptr @alloc_at_least(i64 8)
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    call void @use(ptr [[P]])
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @alloc_at_least(i64 8)
  store i64 %x, ptr %p
  store i64 1, ptr %p
  call void @use(ptr %p)
  ret ptr %p
}

; With an exact size, there is nothing outside of the 8 bytes to store to.
define ptr @exact_store_before(i64 %x) {
; CHECK-LABEL: define ptr @exact_store_before(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = call ptr @alloc_exact(i64 8)
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    call void @use(ptr [[P]])
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @alloc_exact(i64 8)
  %header = getelementptr i8, ptr %p, i64 -8
  store i64 %x, ptr %header
  store i64 1, ptr %p
  call void @use(ptr %p)
  ret ptr %p
}

define ptr @exact_store_after(i64 %x) {
; CHECK-LABEL: define ptr @exact_store_after(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = call ptr @alloc_exact(i64 8)
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    call void @use(ptr [[P]])
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @alloc_exact(i64 8)
  %tail = getelementptr i8, ptr %p, i64 8
  store i64 %x, ptr %tail
  store i64 1, ptr %p
  call void @use(ptr %p)
  ret ptr %p
}

; The attribute of the call site decides.
define ptr @exact_at_call_site(i64 %x) {
; CHECK-LABEL: define ptr @exact_at_call_site(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = call ptr @alloc_at_least(i64 8) #[[ATTR1:[0-9]+]]
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    call void @use(ptr [[P]])
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @alloc_at_least(i64 8) allocsize(0, exact)
  %header = getelementptr i8, ptr %p, i64 -8
  store i64 %x, ptr %header
  store i64 1, ptr %p
  call void @use(ptr %p)
  ret ptr %p
}
