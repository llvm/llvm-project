; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], float [[V:%.*]]) {
; CHECK-NEXT:    store float [[V]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    ret void
;
  store float %v, ptr addrspace(3) @lds, align 4
  store float %v, ptr addrspace(1) %out, align 4
  ret void
}

