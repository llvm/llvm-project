@flag = addrspace(3) global i32 poison, align 4
@glob = addrspace(1) global [4 x float] poison, align 16

declare void @llvm.memset.p3.i64(ptr addrspace(3) writeonly captures(none), i8, i64, i1 immarg)
declare void @llvm.amdgcn.s.barrier()
declare void @reads_lds()

