# NOTE: Do not autogenerate
#
# A deep outer-IV operand chain. The epilogue operand classifier walks the
# chain iteratively, so a chain of 300000 additions must not exhaust the
# stack. split-file provides a generator, the K=3 module that generator must
# reproduce, and a runner that sets the child stack to exactly 8 MiB before
# exec'ing opt, so a recursion depth that outgrows that stack fails here
# rather than depending on the host's stack limit. The generated shape is the
# bound_context_nofact_trunc test case plus K dependent additions in the outer
# header, where %c{K-1} feeds the epilogue's uitofp feeding the stored fmul, so
# the chain reaches no address and no loop condition. The candidate stays
# RuntimeBound, so the feature-on module must equal the feature-off module.
#
# REQUIRES: system-linux
#
# RUN: rm -rf %t && split-file %s %t
# RUN: %python %t/generate-runtime-chain.py 3 > %t/k3.ll
# RUN: diff -u %t/deep-k3.ll %t/k3.ll
# RUN: %python %t/generate-runtime-chain.py 300000 > %t/k300000.ll
# RUN: %python %t/bounded-stack.py opt -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -disable-output %t/k3.ll
# RUN: %python %t/bounded-stack.py opt -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -disable-output %t/k300000.ll
# Feature-on preparation at both K reports K rematerialized definitions; the
# plan is then declined as RuntimeBound.
# RUN: %python %t/bounded-stack.py opt -S -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -loop-interchange-outer-epilogue-fission=false %t/k3.ll -o %t/k3.off.ll
# RUN: %python %t/bounded-stack.py opt -S -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -loop-interchange-outer-epilogue-fission -loop-interchange-print-prepared-plan %t/k3.ll -o %t/k3.on.ll 2> %t/k3.on.stderr
# RUN: diff -u %t/k3.off.ll %t/k3.on.ll
# RUN: FileCheck %s --check-prefix=K3 --input-file=%t/k3.on.stderr --implicit-check-not='loop-interchange:'
# RUN: FileCheck %s --check-prefix=NO-MARKER --input-file=%t/k3.on.ll --implicit-check-not='.lver' --implicit-check-not='!alias.scope' --implicit-check-not='!noalias'
# RUN: %python %t/bounded-stack.py opt -S -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -loop-interchange-outer-epilogue-fission=false %t/k300000.ll -o %t/k300000.off.ll
# RUN: %python %t/bounded-stack.py opt -S -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -loop-interchange-outer-epilogue-fission -loop-interchange-print-prepared-plan %t/k300000.ll -o %t/k300000.on.ll 2> %t/k300000.on.stderr
# RUN: diff -u %t/k300000.off.ll %t/k300000.on.ll
# RUN: FileCheck %s --check-prefix=K300000 --input-file=%t/k300000.on.stderr --implicit-check-not='loop-interchange:'
# RUN: FileCheck %s --check-prefix=NO-MARKER --input-file=%t/k300000.on.ll --implicit-check-not='.lver' --implicit-check-not='!alias.scope' --implicit-check-not='!noalias'
# RUN: %if asserts %{ %python %t/bounded-stack.py opt -passes=loop-interchange -cache-line-size=64 -loop-interchange-profitabilities=instorder,vectorize -verify-each -loop-interchange-outer-epilogue-fission -loop-interchange-print-prepared-plan -debug-only=loop-interchange -disable-output %t/k3.ll 2>&1 | FileCheck %s --check-prefix=K3-DEBUG %}
