# K3-DEBUG: loop-interchange: discovered a closed outer-loop epilogue in function 'deep_runtime_nofact' with 1 path block(s), 5 instruction(s), and 3 rematerialized loop-local definition(s).
#
#--- generate-runtime-chain.py
#!/usr/bin/env python3
import argparse


def positive_int(value):
    result = int(value)
    if result < 1:
        raise argparse.ArgumentTypeError("chain length must be positive")
    return result


parser = argparse.ArgumentParser()
parser.add_argument("length", type=positive_int)
args = parser.parse_args()

print('target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"')
print("""
define void @deep_runtime_nofact(ptr noalias dereferenceable(128) %A, ptr noalias %R, i64 %n) {
entry:
  %m7 = and i64 %n, 7
  %nn = add nuw nsw i64 %m7, 1
  %nn32 = trunc i64 %nn to i32
  %hi = icmp ne i32 %nn32, 12345
  br i1 %hi, label %outer.ph, label %done
outer.ph:
  br label %outer.header
outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %chk.i = phi double [ 0.000000e+00, %outer.ph ], [ %chk.next, %outer.latch ]""")
for index in range(args.length):
    operand = "%i" if index == 0 else f"%c{index - 1}"
    print(f"  %c{index} = add i64 {operand}, 1")
print(f"""  %col = getelementptr inbounds [4 x double], ptr %A, i64 0, i64 %i
  br label %inner.header
inner.header:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner.header ]
  %chk.j = phi double [ %chk.i, %outer.header ], [ %chk.next.j, %inner.header ]
  %idx = getelementptr inbounds [4 x double], ptr %col, i64 %j, i64 0
  %v = load double, ptr %idx, align 8
  %chk.next.j = fadd reassoc double %chk.j, %v
  %j.next = add i64 %j, 1
  %j.ec = icmp eq i64 %j.next, 4
  br i1 %j.ec, label %epilogue, label %inner.header
epilogue:
  %chk.next = phi double [ %chk.next.j, %inner.header ]
  %ddiag = getelementptr inbounds [4 x double], ptr %A, i64 %i, i64 %i
  %dval = load double, ptr %ddiag, align 8
  %deep.fp = uitofp i64 %c{args.length - 1} to double
  %dnew = fmul double %dval, %deep.fp
  store double %dnew, ptr %ddiag, align 8
  br label %outer.latch
outer.latch:
  %i.next = add i64 %i, 1
  %i.ec = icmp eq i64 %i.next, %nn
  br i1 %i.ec, label %exit, label %outer.header
exit:
  %chk.res = phi double [ %chk.next, %outer.latch ]
  store double %chk.res, ptr %R, align 8
  br label %done
done:
  ret void
}}""")
#--- bounded-stack.py
#!/usr/bin/env python3
"""Exec a tool under an 8 MiB child stack with core dumps disabled.

Both the soft and the hard stack limit are set, so nothing downstream can
raise the limit back. Every step is confirmed by re-reading the limit, and any
step that cannot be taken fails the run with a message instead of silently
measuring a different stack.
"""
import os
import resource
import sys

STACK_BYTES = 8 * 1024 * 1024


def fail(message):
    sys.stderr.write("bounded-stack: " + message + "\n")
    sys.exit(2)


def set_limit(which, name, limits):
    try:
        resource.setrlimit(which, limits)
    except (ValueError, OSError) as error:
        fail("cannot set %s to %s: %s" % (name, limits, error))
    actual = resource.getrlimit(which)
    if tuple(actual) != limits:
        fail("%s reads back as %s, expected %s" % (name, tuple(actual), limits))


if len(sys.argv) < 2:
    fail("usage: bounded-stack.py TOOL [ARGUMENT ...]")

set_limit(resource.RLIMIT_STACK, "RLIMIT_STACK", (STACK_BYTES, STACK_BYTES))
set_limit(resource.RLIMIT_CORE, "RLIMIT_CORE", (0, 0))

try:
    os.execvp(sys.argv[1], sys.argv[1:])
except OSError as error:
    fail("cannot exec %s: %s" % (sys.argv[1], error))
fail("exec of %s returned" % sys.argv[1])
#--- deep-k3.ll
target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

define void @deep_runtime_nofact(ptr noalias dereferenceable(128) %A, ptr noalias %R, i64 %n) {
entry:
  %m7 = and i64 %n, 7
  %nn = add nuw nsw i64 %m7, 1
  %nn32 = trunc i64 %nn to i32
  %hi = icmp ne i32 %nn32, 12345
  br i1 %hi, label %outer.ph, label %done
outer.ph:
  br label %outer.header
outer.header:
  %i = phi i64 [ 0, %outer.ph ], [ %i.next, %outer.latch ]
  %chk.i = phi double [ 0.000000e+00, %outer.ph ], [ %chk.next, %outer.latch ]
  %c0 = add i64 %i, 1
  %c1 = add i64 %c0, 1
  %c2 = add i64 %c1, 1
  %col = getelementptr inbounds [4 x double], ptr %A, i64 0, i64 %i
  br label %inner.header
inner.header:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner.header ]
  %chk.j = phi double [ %chk.i, %outer.header ], [ %chk.next.j, %inner.header ]
  %idx = getelementptr inbounds [4 x double], ptr %col, i64 %j, i64 0
  %v = load double, ptr %idx, align 8
  %chk.next.j = fadd reassoc double %chk.j, %v
  %j.next = add i64 %j, 1
  %j.ec = icmp eq i64 %j.next, 4
  br i1 %j.ec, label %epilogue, label %inner.header
epilogue:
  %chk.next = phi double [ %chk.next.j, %inner.header ]
  %ddiag = getelementptr inbounds [4 x double], ptr %A, i64 %i, i64 %i
  %dval = load double, ptr %ddiag, align 8
  %deep.fp = uitofp i64 %c2 to double
  %dnew = fmul double %dval, %deep.fp
  store double %dnew, ptr %ddiag, align 8
  br label %outer.latch
outer.latch:
  %i.next = add i64 %i, 1
  %i.ec = icmp eq i64 %i.next, %nn
  br i1 %i.ec, label %exit, label %outer.header
exit:
  %chk.res = phi double [ %chk.next, %outer.latch ]
  store double %chk.res, ptr %R, align 8
  br label %done
done:
  ret void
}
