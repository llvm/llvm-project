; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=loop-interchange -loop-interchange-profitabilities=ignore \
; RUN:     -verify-dom-info -verify-loop-info -verify-loop-lcssa -S | FileCheck %s

; After interchanging the innermost and the middle loop, an lcssa phi in the new
; inner latch feeds the latch's exit condition. Interchanging the (new) middle
; and outermost loop would clone that condition and leave the lcssa phi with a
; stale incoming block, producing invalid IR. Make sure the second interchange
; is rejected instead of crashing, even though the outermost latch has a single
; predecessor.

define void @t(i32 %b) {
; CHECK-LABEL: define void @t(
; CHECK-SAME: i32 [[B:%.*]]) {
; CHECK-NEXT:  [[MID_HEADER:.*]]:
; CHECK-NEXT:    [[MWIDE:%.*]] = zext i32 [[B]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = add nsw i64 [[MWIDE]], -1
; CHECK-NEXT:    br label %[[INNER_HEADER:.*]]
; CHECK:       [[INNER_HEADER]]:
; CHECK-NEXT:    [[INTERCHANGE_IV4:%.*]] = phi i64 [ [[INTERCHANGE_IV_NEXT5:%.*]], %[[OUTER_LATCH:.*]] ], [ 0, %[[MID_HEADER]] ]
; CHECK-NEXT:    br label %[[MID_HEADER_PREHEADER:.*]]
; CHECK:       [[MID_HEADER_PREHEADER]]:
; CHECK-NEXT:    [[INTERCHANGE_IV:%.*]] = phi i64 [ [[INTERCHANGE_IV_NEXT:%.*]], %[[MID_LATCH1:.*]] ], [ 0, %[[INNER_HEADER]] ]
; CHECK-NEXT:    br label %[[MID_LATCH:.*]]
; CHECK:       [[MID_LATCH]]:
; CHECK-NEXT:    [[INTERCHANGE_IV10:%.*]] = phi i64 [ [[INTERCHANGE_IV_NEXT11:%.*]], %[[MID_LATCH]] ], [ 0, %[[MID_HEADER_PREHEADER]] ]
; CHECK-NEXT:    [[INTERCHANGE_IV_NEXT11]] = add i64 [[INTERCHANGE_IV10]], 1
; CHECK-NEXT:    [[INTERCHANGE_EXITCOND12:%.*]] = icmp eq i64 [[INTERCHANGE_IV10]], 99
; CHECK-NEXT:    br i1 [[INTERCHANGE_EXITCOND12]], label %[[MID_LATCH1]], label %[[MID_LATCH]]
; CHECK:       [[MID_LATCH1]]:
; CHECK-NEXT:    [[INTERCHANGE_IV_NEXT]] = add i64 [[INTERCHANGE_IV]], 1
; CHECK-NEXT:    [[INTERCHANGE_EXITCOND:%.*]] = icmp eq i64 [[INTERCHANGE_IV]], 99
; CHECK-NEXT:    br i1 [[INTERCHANGE_EXITCOND]], label %[[OUTER_LATCH]], label %[[MID_HEADER_PREHEADER]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[INTERCHANGE_IV_NEXT5]] = add i64 [[INTERCHANGE_IV4]], 1
; CHECK-NEXT:    [[INTERCHANGE_EXITCOND6:%.*]] = icmp eq i64 [[INTERCHANGE_IV4]], [[TMP1]]
; CHECK-NEXT:    br i1 [[INTERCHANGE_EXITCOND6]], label %[[EXIT:.*]], label %[[INNER_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  br label %mid.header

mid.header:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %mid.latch ]
  %mwide = zext i32 %b to i64                 ; non-induction value, middle-loop invariant
  br label %inner.header

inner.header:
  %k = phi i64 [ 0, %mid.header ], [ %k.next, %inner.header ]
  %k.next = add nsw i64 %k, 1
  %ec.k = icmp eq i64 %k.next, %mwide         ; inner exit uses the middle-header value
  br i1 %ec.k, label %mid.latch, label %inner.header

mid.latch:
  %j.next = add nsw i64 %j, 1
  %ec.j = icmp eq i64 %j.next, 100
  br i1 %ec.j, label %outer.latch, label %mid.header

outer.latch:
  %i.next = add nsw i64 %i, 1
  %ec.i = icmp eq i64 %i.next, 100
  br i1 %ec.i, label %exit, label %outer.header

exit:
  ret void
}
