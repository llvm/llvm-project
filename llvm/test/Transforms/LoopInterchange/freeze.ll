; CHECK-NEXT:    [[LATCH_BIT:%.*]] = freeze i1 poison
; CHECK-NEXT:    [[I_EC:%.*]] = icmp eq i64 [[I_NEXT]], 4
; CHECK-NEXT:    br i1 [[I_EC]], label %[[EXIT:.*]], label %[[OUTER_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[EXIT_OUT:%.*]] = phi i1 [ [[EXIT_BIT_LCSSA]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[LATCH_OUT:%.*]] = phi i1 [ [[LATCH_BIT]], %[[OUTER_LATCH]] ]
