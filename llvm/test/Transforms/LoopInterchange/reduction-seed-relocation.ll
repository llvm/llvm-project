; CHECK-NEXT:    [[ADD_LCSSA_LCSSA:%.*]] = phi i64 [ [[ADD_LCSSA:%.*]], [[FOR_BODY8_SPLIT:%.*]] ]
; CHECK-NEXT:    [[ADD14:%.*]] = add nsw i64 [[ADD_LCSSA_LCSSA]], [[TOTAL_031]]
; CHECK-NEXT:    br label [[FOR_INC15]]
; CHECK:       for.cond.cleanup7:
