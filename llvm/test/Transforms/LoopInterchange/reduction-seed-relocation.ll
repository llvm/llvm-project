for.cond5.preheader:                              ; preds = %if.then, %for.cond.cleanup7
  %j.030 = phi i64 [ 0, %if.then ], [ %inc12, %for.cond.cleanup7 ]
  %acc.029 = phi i64 [ %mul, %if.then ], [ %add, %for.cond.cleanup7 ]
