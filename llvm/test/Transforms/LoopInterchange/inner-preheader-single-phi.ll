; RUN: opt -passes=loop-interchange -loop-interchange-profitabilities=ignore \
; RUN:     -S %s | FileCheck %s
; Loop-interchange pass doesn't crash if the inner loop preheader has PHI nodes.


define void @f(ptr %A) {
; CHECK-LABEL: define void @f(
; CHECK-SAME: ptr [[A:%.*]]) {
; CHECK-NEXT:  [[INNER_PH:.*]]:
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[I_INC:%.*]], %[[OUTER_LATCH:.*]] ], [ 0, %[[INNER_PH]] ]
; CHECK-NEXT:    br label %[[OUTER_HEADER_PREHEADER:.*]]
; CHECK:       [[OUTER_HEADER_PREHEADER]]:
; CHECK-NEXT:    [[P:%.*]] = phi i64 [ 42, %[[INNER]] ]
; CHECK-NEXT:    br label %[[OUTER_BODY:.*]]
; CHECK:       [[OUTER_BODY]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ [[TMP0:%.*]], %[[OUTER_BODY]] ], [ 0, %[[OUTER_HEADER_PREHEADER]] ]
; CHECK-NEXT:    [[TMP0]] = add i64 [[J]], 1
; CHECK-NEXT:    [[INTERCHANGE_EXITCOND3:%.*]] = icmp eq i64 [[J]], 9
; CHECK-NEXT:    br i1 [[INTERCHANGE_EXITCOND3]], label %[[OUTER_BODY1:.*]], label %[[OUTER_BODY]]
; CHECK:       [[OUTER_BODY1]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_INC]] = add i64 [[I]], 1
; CHECK-NEXT:    [[INTERCHANGE_EXITCOND:%.*]] = icmp eq i64 [[I]], 9
; CHECK-NEXT:    br i1 [[INTERCHANGE_EXITCOND]], label %[[EXIT:.*]], label %[[INNER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.inc, %outer.latch ]
  br label %inner.ph

inner.ph:
  %p = phi i64 [ 42, %outer.header ]
  br label %inner

inner:
  %j = phi i64 [ 0, %inner.ph ], [ %j.inc, %inner ]
  %j.inc = add i64 %j, 1
  %ec.j = icmp eq i64 %j.inc, 10
  br i1 %ec.j, label %outer.body, label %inner

outer.body:
  br label %outer.latch

outer.latch:
  %i.inc = add i64 %i, 1
  %ec.i = icmp eq i64 %i.inc, 10
  br i1 %ec.i, label %exit, label %outer.header

exit:
  ret void
}
