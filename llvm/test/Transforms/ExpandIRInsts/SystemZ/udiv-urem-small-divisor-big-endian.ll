; RUN: opt -S -mtriple=s390x-- -expand-ir-insts -expand-div-rem-bits 128 < %s | FileCheck %s
; RUN: opt -S -mtriple=s390x-- -passes='require<libcall-lowering-info>,expand-ir-insts' -expand-div-rem-bits 128 < %s | FileCheck %s

; On big-endian targets the most significant limb of the dividend is stored
; first, so the limb loop walks the stack slot from index 0 upwards.

define i160 @udiv_i160_by_100(i160 %x) {
; CHECK-LABEL: @udiv_i160_by_100(
; CHECK-NEXT:    [[DIVIDEND_SLOT:%.*]] = alloca i160, align 8
; CHECK-NEXT:    [[QUOTIENT_SLOT:%.*]] = alloca i160, align 8
; CHECK-NEXT:    store i160 [[X:%.*]], ptr [[DIVIDEND_SLOT]], align 8
; CHECK-NEXT:    br label [[UDIVREM_LIMB_LOOP:%.*]]
; CHECK:       udivrem-limb-loop:
; CHECK-NEXT:    [[LIMBS_REMAINING:%.*]] = phi i64 [ 5, [[TMP0:%.*]] ], [ [[LIMB_IDX:%.*]], [[UDIVREM_LIMB_LOOP]] ]
; CHECK-NEXT:    [[REM:%.*]] = phi i64 [ 0, [[TMP0]] ], [ [[REM_NEXT:%.*]], [[UDIVREM_LIMB_LOOP]] ]
; CHECK-NEXT:    [[LIMB_IDX]] = sub nuw nsw i64 [[LIMBS_REMAINING]], 1
; CHECK-NEXT:    [[SLOT_IDX:%.*]] = sub nuw nsw i64 4, [[LIMB_IDX]]
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i32, ptr [[DIVIDEND_SLOT]], i64 [[SLOT_IDX]]
; CHECK-NEXT:    [[LIMB:%.*]] = load i32, ptr [[TMP1]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = shl i64 [[REM]], 32
; CHECK-NEXT:    [[TMP3:%.*]] = zext i32 [[LIMB]] to i64
; CHECK-NEXT:    [[ACC:%.*]] = or i64 [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[Q_LIMB:%.*]] = udiv i64 [[ACC]], 100
; CHECK-NEXT:    [[TMP4:%.*]] = mul i64 [[Q_LIMB]], 100
; CHECK-NEXT:    [[REM_NEXT]] = sub i64 [[ACC]], [[TMP4]]
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr inbounds i32, ptr [[QUOTIENT_SLOT]], i64 [[SLOT_IDX]]
; CHECK-NEXT:    [[TMP6:%.*]] = trunc i64 [[Q_LIMB]] to i32
; CHECK-NEXT:    store i32 [[TMP6]], ptr [[TMP5]], align 4
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[LIMB_IDX]], 0
; CHECK-NEXT:    br i1 [[DONE]], label [[UDIVREM_LIMB_EXIT:%.*]], label [[UDIVREM_LIMB_LOOP]], !prof [[PROF0:![0-9]+]]
; CHECK:       udivrem-limb-exit:
; CHECK-NEXT:    [[R:%.*]] = load i160, ptr [[QUOTIENT_SLOT]], align 8
; CHECK-NEXT:    ret i160 [[R]]
;
  %r = udiv i160 %x, 100
  ret i160 %r
}

