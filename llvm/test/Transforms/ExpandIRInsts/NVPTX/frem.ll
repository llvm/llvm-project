; afn selects the straight-line approximation. Its division does not inherit
; afn, and the aggregate fast flag selects the same expansion.
define float @frem_afn(float %x, float %y) {
; CHECK-LABEL: define float @frem_afn(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fdiv float [[X]], [[Y]]
; CHECK-NEXT:    [[TMP2:%.*]] = call float @llvm.trunc.f32(float [[TMP1]])
; CHECK-NEXT:    [[TMP3:%.*]] = fneg float [[TMP2]]
; CHECK-NEXT:    [[R:%.*]] = call float @llvm.fma.f32(float [[TMP3]], float [[Y]], float [[X]])
; CHECK-NEXT:    ret float [[R]]
;
  %r = frem afn float %x, %y
  ret float %r
}

define float @frem_fast(float %x, float %y) {
; CHECK-LABEL: define float @frem_fast(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fdiv float [[X]], [[Y]]
; CHECK-NEXT:    [[TMP2:%.*]] = call float @llvm.trunc.f32(float [[TMP1]])
; CHECK-NEXT:    [[TMP3:%.*]] = fneg float [[TMP2]]
; CHECK-NEXT:    [[R:%.*]] = call float @llvm.fma.f32(float [[TMP3]], float [[Y]], float [[X]])
; CHECK-NEXT:    ret float [[R]]
;
  %r = frem fast float %x, %y
  ret float %r
}

; The approximate half expansion stays in half before legalization, including
; the quotient rounding before truncation. Legalizing the FMA to a wider type
; cannot recover precision already lost in that quotient.
define half @frem_f16_afn(half %x, half %y) {
; CHECK-LABEL: define half @frem_f16_afn(
; CHECK-SAME: half [[X:%.*]], half [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fdiv half [[X]], [[Y]]
; CHECK-NEXT:    [[TMP2:%.*]] = call half @llvm.trunc.f16(half [[TMP1]])
; CHECK-NEXT:    [[TMP3:%.*]] = fneg half [[TMP2]]
; CHECK-NEXT:    [[R:%.*]] = call half @llvm.fma.f16(half [[TMP3]], half [[Y]], half [[X]])
; CHECK-NEXT:    ret half [[R]]
;
  %r = frem afn half %x, %y
  ret half %r
}

define bfloat @frem_bf16_afn(bfloat %x, bfloat %y) {
; CHECK-LABEL: define bfloat @frem_bf16_afn(
