; The stack slots go to the entry block even when the division is elsewhere,
; and phis in the successors of the split block are updated.
define i256 @udiv_i256_by_7_in_loop(ptr %p, i64 %n) {
; CHECK-LABEL: @udiv_i256_by_7_in_loop(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[DIVIDEND_SLOT:%.*]] = alloca i256, align 16
; CHECK-NEXT:    [[QUOTIENT_SLOT:%.*]] = alloca i256, align 16
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[I_NEXT:%.*]], [[UDIVREM_LIMB_EXIT:%.*]] ]
; CHECK-NEXT:    [[PREV:%.*]] = phi i256 [ 0, [[ENTRY]] ], [ [[Q:%.*]], [[UDIVREM_LIMB_EXIT]] ]
; CHECK-NEXT:    [[V:%.*]] = load i256, ptr [[P:%.*]], align 16
; CHECK-NEXT:    store i256 [[V]], ptr [[DIVIDEND_SLOT]], align 16
; CHECK-NEXT:    br label [[UDIVREM_LIMB_LOOP:%.*]]
; CHECK:       udivrem-limb-loop:
; CHECK-NEXT:    [[LIMBS_REMAINING:%.*]] = phi i64 [ 8, [[LOOP]] ], [ [[LIMB_IDX:%.*]], [[UDIVREM_LIMB_LOOP]] ]
; CHECK-NEXT:    [[REM:%.*]] = phi i64 [ 0, [[LOOP]] ], [ [[REM_NEXT:%.*]], [[UDIVREM_LIMB_LOOP]] ]
; CHECK-NEXT:    [[LIMB_IDX]] = sub nuw nsw i64 [[LIMBS_REMAINING]], 1
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i32, ptr [[DIVIDEND_SLOT]], i64 [[LIMB_IDX]]
; CHECK-NEXT:    [[LIMB:%.*]] = load i32, ptr [[TMP0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = shl i64 [[REM]], 32
; CHECK-NEXT:    [[TMP2:%.*]] = zext i32 [[LIMB]] to i64
; CHECK-NEXT:    [[ACC:%.*]] = or i64 [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[Q_LIMB:%.*]] = udiv i64 [[ACC]], 7
; CHECK-NEXT:    [[TMP3:%.*]] = mul i64 [[Q_LIMB]], 7
; CHECK-NEXT:    [[REM_NEXT]] = sub i64 [[ACC]], [[TMP3]]
; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr inbounds i32, ptr [[QUOTIENT_SLOT]], i64 [[LIMB_IDX]]
; CHECK-NEXT:    [[TMP5:%.*]] = trunc i64 [[Q_LIMB]] to i32
; CHECK-NEXT:    store i32 [[TMP5]], ptr [[TMP4]], align 4
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[LIMB_IDX]], 0
; CHECK-NEXT:    br i1 [[DONE]], label [[UDIVREM_LIMB_EXIT]], label [[UDIVREM_LIMB_LOOP]], !prof [[PROF0]]
; CHECK:       udivrem-limb-exit:
; CHECK-NEXT:    [[Q]] = load i256, ptr [[QUOTIENT_SLOT]], align 16
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[I_NEXT]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[C]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    [[SUM:%.*]] = add i256 [[Q]], [[PREV]]
; CHECK-NEXT:    ret i256 [[SUM]]
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %prev = phi i256 [ 0, %entry ], [ %q, %loop ]
  %v = load i256, ptr %p
  %q = udiv i256 %v, 7
  %i.next = add i64 %i, 1
  %c = icmp eq i64 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  %sum = add i256 %q, %prev
  ret i256 %sum
}
