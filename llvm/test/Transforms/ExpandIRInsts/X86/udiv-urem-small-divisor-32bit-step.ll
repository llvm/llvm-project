; When only 32-bit division is legal, the limb expansion uses 16-bit limbs
; with 32-bit arithmetic.

define i64 @udiv_i64_by_7(i64 %x) {
; CHECK-LABEL: @udiv_i64_by_7(
; CHECK-NEXT:    [[DIVIDEND_SLOT:%.*]] = alloca i64, align 8
; CHECK-NEXT:    [[QUOTIENT_SLOT:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 [[X:%.*]], ptr [[DIVIDEND_SLOT]], align 8
; CHECK-NEXT:    br label [[UDIVREM_LIMB_LOOP:%.*]]
; CHECK:       udivrem-limb-loop:
; CHECK-NEXT:    [[LIMBS_REMAINING:%.*]] = phi i64 [ 4, [[TMP0:%.*]] ], [ [[LIMB_IDX:%.*]], [[UDIVREM_LIMB_LOOP]] ]
; CHECK-NEXT:    [[REM:%.*]] = phi i32 [ 0, [[TMP0]] ], [ [[REM_NEXT:%.*]], [[UDIVREM_LIMB_LOOP]] ]
; CHECK-NEXT:    [[LIMB_IDX]] = sub nuw nsw i64 [[LIMBS_REMAINING]], 1
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr inbounds i16, ptr [[DIVIDEND_SLOT]], i64 [[LIMB_IDX]]
; CHECK-NEXT:    [[LIMB:%.*]] = load i16, ptr [[TMP1]], align 2
; CHECK-NEXT:    [[TMP2:%.*]] = shl i32 [[REM]], 16
; CHECK-NEXT:    [[TMP3:%.*]] = zext i16 [[LIMB]] to i32
; CHECK-NEXT:    [[ACC:%.*]] = or i32 [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[Q_LIMB:%.*]] = udiv i32 [[ACC]], 7
; CHECK-NEXT:    [[TMP4:%.*]] = mul i32 [[Q_LIMB]], 7
; CHECK-NEXT:    [[REM_NEXT]] = sub i32 [[ACC]], [[TMP4]]
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr inbounds i16, ptr [[QUOTIENT_SLOT]], i64 [[LIMB_IDX]]
; CHECK-NEXT:    [[TMP6:%.*]] = trunc i32 [[Q_LIMB]] to i16
; CHECK-NEXT:    store i16 [[TMP6]], ptr [[TMP5]], align 2
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[LIMB_IDX]], 0
; CHECK-NEXT:    br i1 [[DONE]], label [[UDIVREM_LIMB_EXIT:%.*]], label [[UDIVREM_LIMB_LOOP]], !prof [[PROF0:![0-9]+]]
; CHECK:       udivrem-limb-exit:
; CHECK-NEXT:    [[R:%.*]] = load i64, ptr [[QUOTIENT_SLOT]], align 8
; CHECK-NEXT:    ret i64 [[R]]
;
  %r = udiv i64 %x, 7
  ret i64 %r
}

