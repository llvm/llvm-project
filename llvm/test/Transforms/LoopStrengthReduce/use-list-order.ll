; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=loop-reduce -S | FileCheck %s

; Check that LSR produces the same output regardless of SSA use-list order:
; @f and @f_flipped are identical except for the uselistorder directive,
; which has no semantic effect. Both candidate solutions for the two call
; argument groups (an IV starting at 1 with a "+1" add, or an IV starting at
; 2 with a "-1" add) have exactly equal cost, and the winner used to be
; decided by whichever the use-list walk enumerated first.

target datalayout = "n32:64"

declare i64 @get(i32)

define i64 @f(i32 %n) {
; CHECK-LABEL: define i64 @f(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[FOR_COND:.*]]
; CHECK:       [[FOR_COND]]:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi i32 [ [[LSR_IV_NEXT2:%.*]], %[[LATCH:.*]] ], [ 1, %[[ENTRY]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[LATCH]] ], [ 2, %[[ENTRY]] ]
; CHECK-NEXT:    [[EXIT_CMP:%.*]] = icmp ult i32 [[LSR_IV1]], [[N]]
; CHECK-NEXT:    br i1 [[EXIT_CMP]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 0
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[RA:%.*]] = tail call i64 @get(i32 [[LSR_IV1]])
; CHECK-NEXT:    [[RB:%.*]] = tail call i64 @get(i32 [[LSR_IV]])
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[RA]], [[RB]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[SWAP:.*]], label %[[LATCH]]
; CHECK:       [[SWAP]]:
; CHECK-NEXT:    [[RC:%.*]] = tail call i64 @get(i32 [[LSR_IV1]])
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV]], 1
; CHECK-NEXT:    [[LSR_IV_NEXT2]] = add nuw i32 [[LSR_IV1]], 1
; CHECK-NEXT:    br label %[[FOR_COND]]
;
entry:
  br label %for_cond

for_cond:
  %iv32 = phi i32 [ %iv32.next, %latch ], [ 0, %entry ]
  %i.plus.1 = add i32 %iv32, 1
  %exit.cmp = icmp ult i32 %i.plus.1, %n
  br i1 %exit.cmp, label %body, label %exit

exit:
  ret i64 0

body:
  %ra = tail call i64 @get(i32 %i.plus.1)
  %i.plus.2 = add i32 %iv32, 2
  %rb = tail call i64 @get(i32 %i.plus.2)
  %cmp = icmp ult i64 %ra, %rb
  br i1 %cmp, label %swap, label %latch

swap:
  %rc = tail call i64 @get(i32 %i.plus.1)
  br label %latch

latch:
  %iv32.next = add nuw nsw i32 %iv32, 1
  br label %for_cond
}

define i64 @f_flipped(i32 %n) {
; CHECK-LABEL: define i64 @f_flipped(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[FOR_COND:.*]]
; CHECK:       [[FOR_COND]]:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi i32 [ [[LSR_IV_NEXT2:%.*]], %[[LATCH:.*]] ], [ 1, %[[ENTRY]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[LATCH]] ], [ 2, %[[ENTRY]] ]
; CHECK-NEXT:    [[EXIT_CMP:%.*]] = icmp ult i32 [[LSR_IV1]], [[N]]
; CHECK-NEXT:    br i1 [[EXIT_CMP]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 0
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[RA:%.*]] = tail call i64 @get(i32 [[LSR_IV1]])
; CHECK-NEXT:    [[RB:%.*]] = tail call i64 @get(i32 [[LSR_IV]])
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[RA]], [[RB]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[SWAP:.*]], label %[[LATCH]]
; CHECK:       [[SWAP]]:
; CHECK-NEXT:    [[RC:%.*]] = tail call i64 @get(i32 [[LSR_IV1]])
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV]], 1
; CHECK-NEXT:    [[LSR_IV_NEXT2]] = add nuw i32 [[LSR_IV1]], 1
; CHECK-NEXT:    br label %[[FOR_COND]]
;
entry:
  br label %for_cond

for_cond:
  %iv32 = phi i32 [ %iv32.next, %latch ], [ 0, %entry ]
  %i.plus.1 = add i32 %iv32, 1
  %exit.cmp = icmp ult i32 %i.plus.1, %n
  br i1 %exit.cmp, label %body, label %exit

exit:
  ret i64 0

body:
  %ra = tail call i64 @get(i32 %i.plus.1)
  %i.plus.2 = add i32 %iv32, 2
  %rb = tail call i64 @get(i32 %i.plus.2)
  %cmp = icmp ult i64 %ra, %rb
  br i1 %cmp, label %swap, label %latch

swap:
  %rc = tail call i64 @get(i32 %i.plus.1)
  br label %latch

latch:
  %iv32.next = add nuw nsw i32 %iv32, 1
  br label %for_cond
  uselistorder i32 %iv32, { 0, 2, 1 }
}
