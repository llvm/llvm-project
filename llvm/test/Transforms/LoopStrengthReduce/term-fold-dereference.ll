; The pointer may visit null on iterations that skip the store.
define void @conditional_store(ptr %a, i32 %n, i1 %do_store) {
; CHECK-LABEL: @conditional_store(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[A:%.*]], [[ENTRY:%.*]] ], [ [[P_NEXT:%.*]], [[LATCH:%.*]] ]
; CHECK-NEXT:    [[COUNT:%.*]] = phi i32 [ [[N:%.*]], [[ENTRY]] ], [ [[COUNT_NEXT:%.*]], [[LATCH]] ]
; CHECK-NEXT:    br i1 [[DO_STORE:%.*]], label [[ACCESS:%.*]], label [[LATCH]]
; CHECK:       access:
; CHECK-NEXT:    store i8 1, ptr [[P]], align 2
; CHECK-NEXT:    br label [[LATCH]]
; CHECK:       latch:
; CHECK-NEXT:    [[P_NEXT]] = getelementptr i8, ptr [[P]], i32 2
; CHECK-NEXT:    [[COUNT_NEXT]] = add i32 [[COUNT]], -1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[COUNT_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %p = phi ptr [ %a, %entry ], [ %p.next, %latch ]
  %count = phi i32 [ %n, %entry ], [ %count.next, %latch ]
  br i1 %do_store, label %access, label %latch
access:
  store i8 1, ptr %p, align 2
  br label %latch
latch:
  %p.next = getelementptr i8, ptr %p, i32 2
  %count.next = add i32 %count, -1
  %done = icmp eq i32 %count.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

