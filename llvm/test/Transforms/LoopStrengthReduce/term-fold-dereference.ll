; Reduced inner loop from CoreMark's matrix_mul_matrix_bitextract (issue #163757).
; Only the contiguous pointer has a constant stride. Use it to eliminate the
; otherwise dead countdown IV, even though neither GEP has nowrap flags.
define i32 @coremark_inner(ptr %a, ptr %b, i32 %n, i32 %stride) {
; CHECK-LABEL: @coremark_inner(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = shl i32 [[N:%.*]], 1
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[A:%.*]], i32 [[TMP0]]
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[PA:%.*]] = phi ptr [ [[A]], [[ENTRY:%.*]] ], [ [[PA_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[PB:%.*]] = phi ptr [ [[B:%.*]], [[ENTRY]] ], [ [[PB_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, [[ENTRY]] ], [ [[SUM_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[AV:%.*]] = load i16, ptr [[PA]], align 2
; CHECK-NEXT:    [[BV:%.*]] = load i16, ptr [[PB]], align 2
; CHECK-NEXT:    [[AZ:%.*]] = zext i16 [[AV]] to i32
; CHECK-NEXT:    [[BZ:%.*]] = zext i16 [[BV]] to i32
; CHECK-NEXT:    [[PRODUCT:%.*]] = mul nuw i32 [[AZ]], [[BZ]]
; CHECK-NEXT:    [[SHIFT1:%.*]] = lshr i32 [[PRODUCT]], 2
; CHECK-NEXT:    [[BITS1:%.*]] = and i32 [[SHIFT1]], 15
; CHECK-NEXT:    [[SHIFT2:%.*]] = lshr i32 [[PRODUCT]], 5
; CHECK-NEXT:    [[BITS2:%.*]] = and i32 [[SHIFT2]], 127
; CHECK-NEXT:    [[TERM:%.*]] = mul nuw nsw i32 [[BITS1]], [[BITS2]]
; CHECK-NEXT:    [[SUM_NEXT]] = add i32 [[SUM]], [[TERM]]
; CHECK-NEXT:    [[PB_NEXT]] = getelementptr i8, ptr [[PB]], i32 [[STRIDE:%.*]]
; CHECK-NEXT:    [[PA_NEXT]] = getelementptr i8, ptr [[PA]], i32 2
; CHECK-NEXT:    [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND:%.*]] = icmp eq ptr [[PA_NEXT]], [[SCEVGEP]]
; CHECK-NEXT:    br i1 [[LSR_FOLD_TERM_COND_REPLACED_TERM_COND]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    [[SUM_NEXT_LCSSA:%.*]] = phi i32 [ [[SUM_NEXT]], [[LOOP]] ]
; CHECK-NEXT:    ret i32 [[SUM_NEXT_LCSSA]]
;
entry:
  br label %loop
loop:
  %pa = phi ptr [ %a, %entry ], [ %pa.next, %loop ]
  %pb = phi ptr [ %b, %entry ], [ %pb.next, %loop ]
  %count = phi i32 [ %n, %entry ], [ %count.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %av = load i16, ptr %pa, align 2
  %bv = load i16, ptr %pb, align 2
  %az = zext i16 %av to i32
  %bz = zext i16 %bv to i32
  %product = mul nuw i32 %az, %bz
  %shift1 = lshr i32 %product, 2
  %bits1 = and i32 %shift1, 15
  %shift2 = lshr i32 %product, 5
  %bits2 = and i32 %shift2, 127
  %term = mul nuw nsw i32 %bits1, %bits2
  %sum.next = add i32 %sum, %term
  %count.next = add i32 %count, -1
  %pb.next = getelementptr i8, ptr %pb, i32 %stride
  %pa.next = getelementptr i8, ptr %pa, i32 2
  %done = icmp eq i32 %count.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %sum.next
}

