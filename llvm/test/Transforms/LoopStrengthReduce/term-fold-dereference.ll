  store volatile i8 1, ptr %p, align 2
  %p.next = getelementptr i8, ptr %p, i32 2
  %count.next = add i32 %count, -1
  %done = icmp eq i32 %count.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

; With null valid, the pointer can repeat before the wider counter finishes.
define void @wide_count_null_is_valid(ptr %a, i128 %n, i1 %do_store) null_pointer_is_valid {
; CHECK-LABEL: @wide_count_null_is_valid(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[A:%.*]], [[ENTRY:%.*]] ], [ [[P_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[COUNT:%.*]] = phi i128 [ [[N:%.*]], [[ENTRY]] ], [ [[COUNT_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    store i8 1, ptr [[P]], align 2
; CHECK-NEXT:    [[P_NEXT]] = getelementptr i8, ptr [[P]], i32 2
; CHECK-NEXT:    [[COUNT_NEXT]] = add i128 [[COUNT]], -1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i128 [[COUNT_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %p = phi ptr [ %a, %entry ], [ %p.next, %loop ]
  %count = phi i128 [ %n, %entry ], [ %count.next, %loop ]
  store i8 1, ptr %p, align 2
  %p.next = getelementptr i8, ptr %p, i32 2
  %count.next = add i128 %count, -1
  %done = icmp eq i128 %count.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
