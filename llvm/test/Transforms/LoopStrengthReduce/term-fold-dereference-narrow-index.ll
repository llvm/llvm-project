; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=loop-term-fold -S < %s | FileCheck %s

; The unchanged high pointer bits can prevent the recurrence from visiting null.
target datalayout = "e-p:64:64:64:32"

define void @narrow_pointer_index(ptr %a, i32 %n) {
; CHECK-LABEL: @narrow_pointer_index(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[A:%.*]], [[ENTRY:%.*]] ], [ [[P_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[COUNT:%.*]] = phi i32 [ [[N:%.*]], [[ENTRY]] ], [ [[COUNT_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    store i8 1, ptr [[P]], align 2
; CHECK-NEXT:    [[P_NEXT]] = getelementptr i8, ptr [[P]], i32 2
; CHECK-NEXT:    [[COUNT_NEXT]] = add i32 [[COUNT]], -1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[COUNT_NEXT]], 0
; CHECK-NEXT:    br i1 [[DONE]], label [[EXIT:%.*]], label [[LOOP]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %p = phi ptr [ %a, %entry ], [ %p.next, %loop ]
  %count = phi i32 [ %n, %entry ], [ %count.next, %loop ]
  store i8 1, ptr %p, align 2
  %p.next = getelementptr i8, ptr %p, i32 2
  %count.next = add i32 %count, -1
  %done = icmp eq i32 %count.next, 0
  br i1 %done, label %exit, label %loop
exit:
  ret void
}
