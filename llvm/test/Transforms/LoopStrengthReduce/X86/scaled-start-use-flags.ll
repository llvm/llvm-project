; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
