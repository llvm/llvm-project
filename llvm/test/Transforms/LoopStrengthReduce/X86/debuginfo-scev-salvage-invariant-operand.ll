; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64 -O2 < %s | FileCheck %s
; RUN: opt -strip-debug < %s | llc -mtriple=x86_64 -O2 | FileCheck %s

; The debug value in %loop uses %inv, which is defined outside the loop.
; Computing a SCEV for it only to salvage the debug value registers %inv in
; ScalarEvolution, and LSR then reuses it when it expands %inv + %iv, which
; made the code depend on the presence of the debug record.

define i64 @test(i32 %a, i32 %b) {
; CHECK-LABEL: test:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    # kill: def $esi killed $esi def $rsi
; CHECK-NEXT:    # kill: def $edi killed $edi def $rdi
; CHECK-NEXT:    leal (%rsi,%rdi), %eax
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addl %edi, %eax
; CHECK-NEXT:    testl %esi, %esi
; CHECK-NEXT:    js .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    retq
entry:
  %inv = add i32 %a, %b
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = add i32 %inv, %iv
  %use = or i32 0, %sum
    #dbg_value(i32 %inv, !4, !DIExpression(), !5)
  %iv.next = add i32 %iv, %a
  %cmp = icmp slt i32 %b, 0
  br i1 %cmp, label %loop, label %exit

exit:
  ret i64 0
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2}

!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
!1 = !DIFile(filename: "t.c", directory: "/")
!2 = !{i32 2, !"Debug Info Version", i32 3}
!3 = distinct !DISubprogram(name: "test", scope: !1, file: !1, line: 1, type: !6, spFlags: DISPFlagDefinition, unit: !0)
!4 = !DILocalVariable(name: "x", scope: !3, file: !1, line: 2, type: !7)
!5 = !DILocation(line: 2, scope: !3)
!6 = !DISubroutineType(types: !{})
!7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
