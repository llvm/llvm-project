entry:
  store i8 0, ptr @h, align 1
  %0 = load i32, ptr @j, align 4
  %tobool.i = icmp eq i32 %0, 0
  %1 = load i32, ptr @d, align 4
  %cmp3 = icmp sgt i32 %1, -1
  %.lobit = lshr i32 %1, 31
  %.lobit.not = xor i32 %.lobit, 1
  br label %for.body

for.body:                                         ; preds = %entry, %fn3.exit
