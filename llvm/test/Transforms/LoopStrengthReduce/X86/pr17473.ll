; CHECK-NEXT:    [[TMP4:%.*]] = add i32 [[LSR_IV_NEXT2]], -1
; CHECK-NEXT:    [[LSR_IV_NEXT:%.*]] = add nsw i32 [[CONV7]], [[TMP4]]
