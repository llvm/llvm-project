; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -O2 < %s | FileCheck %s
; RUN: opt -strip-debug < %s | llc -O2 | FileCheck %s

; Salvaging the debug value in %loop3 must not query ScalarEvolution about
; loops that LSR has not reduced yet. Such queries made the expansion of
; %loop2's induction variables depend on the presence of the debug record.

target triple = "x86_64-unknown-linux-gnu"

define void @test(i1 %c) {
; CHECK-LABEL: test:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop1
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    testb $1, %dil
; CHECK-NEXT:    jne .LBB0_1
; CHECK-NEXT:  # %bb.2: # %loop2.preheader
; CHECK-NEXT:    movzbl %dil, %eax
; CHECK-NEXT:    andl $1, %eax
; CHECK-NEXT:    movq $0, (,%rax,8)
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_3: # %loop3
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    jmp .LBB0_3
entry:
  %c.i64 = zext i1 %c to i64
  br label %loop1

loop1:
  %iv1 = phi i64 [ %c.i64, %entry ], [ 0, %loop1 ]
  br i1 %c, label %loop1, label %loop2.preheader

loop2.preheader:
  %c.i16 = zext i1 %c to i16
  %c.i32 = zext i1 %c to i32
  br label %loop2

loop2:
  %idx = phi i32 [ %c.i32, %loop2.preheader ], [ %idx.next, %loop2 ]
  %iv2 = phi i16 [ %c.i16, %loop2.preheader ], [ %iv2.next, %loop2 ]
  %idx.ext = sext i32 %idx to i64
  %gep = getelementptr [8 x i8], ptr null, i64 %idx.ext
  store i64 0, ptr %gep, align 8
  %iv2.next = add i16 %iv2, 1
  %idx.next = zext i16 %iv2.next to i32
  br i1 false, label %loop2, label %loop3

loop3:
    #dbg_value(i64 0, !4, !DIExpression(), !5)
  br label %loop3
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2}

!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
!1 = !DIFile(filename: "t.c", directory: "")
!2 = !{i32 2, !"Debug Info Version", i32 3}
!3 = distinct !DISubprogram(name: "test", scope: !1, file: !1, type: !6, spFlags: DISPFlagDefinition, unit: !0)
!4 = !DILocalVariable(name: "i", scope: !3, file: !1)
!5 = !DILocation(line: 0, scope: !3)
!6 = !DISubroutineType(types: !{})
