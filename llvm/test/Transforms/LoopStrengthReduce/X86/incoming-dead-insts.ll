; CHECK-NEXT:    [[EARLY_COND:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[EARLY_COND]], label %[[LOOP_LATCH]], label %[[LOOP_HEADER_EXIT_CRIT_EDGE:.*]]
; CHECK:       [[LOOP_LATCH]]:
