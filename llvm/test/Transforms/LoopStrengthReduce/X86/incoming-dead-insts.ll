;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %iv2 = phi i64 [ 2, %entry ], [ %iv2.next, %loop.latch ]
  %iv2.next = add nuw nsw i64 %iv2, 1
  %early.cond = call i1 @cond()
  br i1 %early.cond, label %loop.latch, label %exit

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %exit.cond = icmp eq i64 %iv.next, %n
  br i1 %exit.cond, label %exit, label %loop.header

