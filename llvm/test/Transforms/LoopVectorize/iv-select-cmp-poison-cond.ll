; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --version 6
; RUN: opt -p loop-vectorize -force-vector-width=2 -force-vector-interleave=1 -S %s | FileCheck %s

; The condition of the find-last select may be poison in some iterations, as
; long as a later iteration selects the IV. It must be frozen before the
; selected IVs of all lanes are combined by a min/max reduction.
; See https://github.com/llvm/llvm-project/issues/233119.
define i32 @select_iv_poison_cond(ptr %a) {
; CHECK-LABEL: define i32 @select_iv_poison_cond(
; CHECK-SAME: ptr [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <2 x i8>, ptr [[A]], align 1
; CHECK-NEXT:    [[TMP0:%.*]] = icmp slt <2 x i8> [[WIDE_LOAD]], zeroinitializer
; CHECK-NEXT:    [[TMP1:%.*]] = freeze <2 x i1> [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = select <2 x i1> [[TMP1]], <2 x i32> <i32 0, i32 1>, <2 x i32> splat (i32 -2147483648)
; CHECK-NEXT:    br label %[[MIDDLE_BLOCK:.*]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[TMP3:%.*]] = call i32 @llvm.vector.reduce.smax.v2i32(<2 x i32> [[TMP2]])
; CHECK-NEXT:    [[TMP4:%.*]] = icmp ne i32 [[TMP3]], -2147483648
; CHECK-NEXT:    [[TMP5:%.*]] = select i1 [[TMP4]], i32 [[TMP3]], i32 -1
; CHECK-NEXT:    br label %[[DONE:.*]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret i32 [[TMP5]]
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %rdx = phi i32 [ -1, %entry ], [ %sel, %loop ]
  %gep = getelementptr inbounds nuw i8, ptr %a, i32 %iv
  %val = load i8, ptr %gep, align 1
  %cond = icmp slt i8 %val, 0
  %sel = select i1 %cond, i32 %iv, i32 %rdx
  %iv.next = add nuw nsw i32 %iv, 1
  %exit = icmp eq i32 %iv.next, 2
  br i1 %exit, label %done, label %loop

done:
  ret i32 %sel
}
