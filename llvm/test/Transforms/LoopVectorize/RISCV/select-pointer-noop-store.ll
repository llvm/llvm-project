; CHECK-NEXT:    [[CV:%.*]] = load float, ptr [[GEP_C]], align 4
; CHECK-NEXT:    [[COND:%.*]] = fcmp une float [[CV]], 0.000000e+00
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[COND]], ptr [[P]], ptr [[Q]]
; CHECK-NEXT:    [[GEP_SEL:%.*]] = getelementptr inbounds float, ptr [[SEL]], i64 [[IV]]
