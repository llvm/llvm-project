; The store is predicated on a different condition than the load, so they are
; in different blocks with different masks.
define void @select_ptr_load_store_predicated_store(ptr noalias %q, ptr noalias readonly %p, ptr noalias readonly %c, ptr noalias readonly %d, i64 %n) {
; CHECK-LABEL: define void @select_ptr_load_store_predicated_store(
; CHECK-SAME: ptr noalias [[Q:%.*]], ptr noalias readonly [[P:%.*]], ptr noalias readonly [[C:%.*]], ptr noalias readonly [[D:%.*]], i64 [[N:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[GEP_C:%.*]] = getelementptr inbounds float, ptr [[C]], i64 [[IV]]
; CHECK-NEXT:    [[CV:%.*]] = load float, ptr [[GEP_C]], align 4
; CHECK-NEXT:    [[COND:%.*]] = fcmp une float [[CV]], 0.000000e+00
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[COND]], ptr [[P]], ptr [[Q]]
; CHECK-NEXT:    [[GEP_SEL:%.*]] = getelementptr inbounds float, ptr [[SEL]], i64 [[IV]]
; CHECK-NEXT:    [[V:%.*]] = load float, ptr [[GEP_SEL]], align 4
; CHECK-NEXT:    [[GEP_D:%.*]] = getelementptr inbounds i32, ptr [[D]], i64 [[IV]]
; CHECK-NEXT:    [[DV:%.*]] = load i32, ptr [[GEP_D]], align 4
; CHECK-NEXT:    [[COND_D:%.*]] = icmp ne i32 [[DV]], 0
; CHECK-NEXT:    br i1 [[COND_D]], label %[[THEN:.*]], label %[[LATCH]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[GEP_Q:%.*]] = getelementptr inbounds float, ptr [[Q]], i64 [[IV]]
; CHECK-NEXT:    store float [[V]], ptr [[GEP_Q]], align 4
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %gep.c = getelementptr inbounds float, ptr %c, i64 %iv
  %cv = load float, ptr %gep.c, align 4
  %cond = fcmp une float %cv, 0.000000e+00
  %sel = select i1 %cond, ptr %p, ptr %q
  %gep.sel = getelementptr inbounds float, ptr %sel, i64 %iv
  %v = load float, ptr %gep.sel, align 4
  %gep.d = getelementptr inbounds i32, ptr %d, i64 %iv
  %dv = load i32, ptr %gep.d, align 4
  %cond.d = icmp ne i32 %dv, 0
  br i1 %cond.d, label %then, label %latch

then:
  %gep.q = getelementptr inbounds float, ptr %q, i64 %iv
  store float %v, ptr %gep.q, align 4
  br label %latch

latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

