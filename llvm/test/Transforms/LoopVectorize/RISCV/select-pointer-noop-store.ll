  %cv2 = load float, ptr %gep.c2, align 4
  %cond2 = fcmp une float %cv2, 0.000000e+00
  %sel.inner = select i1 %cond2, ptr %r, ptr %q
  %sel = select i1 %cond1, ptr %p, ptr %sel.inner
  %gep.sel = getelementptr inbounds float, ptr %sel, i64 %iv
  %v = load float, ptr %gep.sel, align 4
  %gep.q = getelementptr inbounds float, ptr %q, i64 %iv
  store float %v, ptr %gep.q, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
