  br i1 %c, label %loop, label %exit

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %offset = mul i64 %iv, 3
  %gep.src = getelementptr inbounds i32, ptr %src.start, i64 %offset
