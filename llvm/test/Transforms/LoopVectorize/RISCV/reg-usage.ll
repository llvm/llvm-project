  %0 = load i64, ptr %ptr.0, align 8
  %ptr.1 = getelementptr i8, ptr %base.1, i64 %iv
  %1 = load i64, ptr %ptr.1, align 8
  %red.0.next = tail call i64 @llvm.smin.i64(i64 %0, i64 %red.0)
