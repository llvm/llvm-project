  %red.0 = phi i64 [ 0, %entry ], [ %red.0.next, %loop.body ]
  %red.1 = phi i64 [ 0, %entry ], [ %red.1.next, %loop.body ]
  %red.2 = phi i64 [ 0, %entry ], [ %red.2.next, %loop.body ]
  %red.3 = phi i64 [ 0, %entry ], [ %red.3.next, %loop.body ]
