; RUN: opt -passes=loop-vectorize -mtriple=riscv64 -mattr=+v -S %s | FileCheck %s

; Test case for https://github.com/llvm/llvm-project/issues/243698.
;
; The i128 live-out requires extracting the last lane of a vector of i128.
; For scalable VFs, <vscale x N x i128> cannot be legalized on RVV (the element
; type is wider than ELEN), so getTypeLegalizationCost returns an invalid cost
; with a scalar MVT. getVectorInstrCost used to treat that as a scalarized
; fixed-length vector and crashed on cast<FixedVectorType>. It must instead
; return an invalid cost, so that scalable VFs are rejected for this loop.

define i128 @live_out_i128_early_exit(i1 %c, i32 %v, i128 %inv) {
; CHECK-LABEL: define i128 @live_out_i128_early_exit(
; CHECK-SAME: i1 [[C:%.*]], i32 [[V:%.*]], i128 [[INV:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i32> poison, i32 [[V]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i32> [[BROADCAST_SPLATINSERT]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <4 x i1> poison, i1 [[C]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <4 x i1> [[BROADCAST_SPLATINSERT1]], <4 x i1> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i32 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY_INTERIM:.*]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i32> [ <i32 1, i32 2, i32 3, i32 4>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY_INTERIM]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ugt <4 x i32> [[BROADCAST_SPLAT]], [[VEC_IND]]
; CHECK-NEXT:    [[TMP1:%.*]] = or <4 x i1> [[BROADCAST_SPLAT2]], [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = xor <4 x i1> [[TMP1]], splat (i1 true)
; CHECK-NEXT:    [[TMP3:%.*]] = freeze <4 x i1> [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = call i1 @llvm.vector.reduce.or.v4i1(<4 x i1> [[TMP3]])
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i32 [[INDEX]], 4
; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i32 [[INDEX_NEXT]], 12
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <4 x i32> [[VEC_IND]], splat (i32 4)
; CHECK-NEXT:    br i1 [[TMP4]], label %[[VECTOR_EARLY_EXIT:.*]], label %[[VECTOR_BODY_INTERIM]]
; CHECK:       [[VECTOR_BODY_INTERIM]]:
; CHECK-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[SCALAR_PH:.*]]
; CHECK:       [[VECTOR_EARLY_EXIT]]:
; CHECK-NEXT:    br label %[[EARLY_EXIT:.*]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 13, %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp ugt i32 [[V]], [[IV]]
; CHECK-NEXT:    [[OR_COND:%.*]] = or i1 [[C]], [[CMP]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    br i1 [[OR_COND]], label %[[LOOP_LATCH]], label %[[EARLY_EXIT]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[INV_PHI:%.*]] = phi i128 [ [[INV]], %[[LOOP_HEADER]] ]
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], 16
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP_HEADER]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       [[EARLY_EXIT]]:
; CHECK-NEXT:    ret i128 [[INV]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[INV_PHI_LCSSA:%.*]] = phi i128 [ [[INV_PHI]], %[[LOOP_LATCH]] ]
; CHECK-NEXT:    ret i128 [[INV_PHI_LCSSA]]
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i32 [ 1, %entry ], [ %iv.next, %loop.latch ]
  %cmp = icmp ugt i32 %v, %iv
  %or.cond = or i1 %c, %cmp
  %iv.next = add nuw nsw i32 %iv, 1
  br i1 %or.cond, label %loop.latch, label %early.exit

loop.latch:
  %inv.phi = phi i128 [ %inv, %loop.header ]
  %ec = icmp eq i32 %iv.next, 16
  br i1 %ec, label %exit, label %loop.header

early.exit:
  ret i128 %inv

exit:
  ret i128 %inv.phi
}
