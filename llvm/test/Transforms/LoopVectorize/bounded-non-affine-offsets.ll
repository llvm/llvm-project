; RUN: opt -passes=loop-vectorize -force-vector-width=4 -S %s | FileCheck %s

; Test for loads from a lookup table indexed by a loaded byte.
define void @lut_i8_index(ptr %dst, ptr %src, ptr %lut, i64 %n) {
; CHECK-LABEL: define void @lut_i8_index(
; CHECK-SAME: ptr [[DST:%.*]], ptr [[SRC:%.*]], ptr [[LUT:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[SCALAR_PH:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP_SRC:%.*]] = getelementptr inbounds nuw i8, ptr [[SRC]], i64 [[IV]]
; CHECK-NEXT:    [[L_SRC:%.*]] = load i8, ptr [[GEP_SRC]], align 1
; CHECK-NEXT:    [[IDX:%.*]] = zext i8 [[L_SRC]] to i64
; CHECK-NEXT:    [[GEP_LUT:%.*]] = getelementptr inbounds nuw float, ptr [[LUT]], i64 [[IDX]]
; CHECK-NEXT:    [[L_LUT:%.*]] = load float, ptr [[GEP_LUT]], align 4
; CHECK-NEXT:    [[GEP_DST:%.*]] = getelementptr inbounds nuw float, ptr [[DST]], i64 [[IV]]
; CHECK-NEXT:    store float [[L_LUT]], ptr [[GEP_DST]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.src = getelementptr inbounds nuw i8, ptr %src, i64 %iv
  %l.src = load i8, ptr %gep.src, align 1
  %idx = zext i8 %l.src to i64
  %gep.lut = getelementptr inbounds nuw float, ptr %lut, i64 %idx
  %l.lut = load float, ptr %gep.lut, align 4
  %gep.dst = getelementptr inbounds nuw float, ptr %dst, i64 %iv
  store float %l.lut, ptr %gep.dst, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
