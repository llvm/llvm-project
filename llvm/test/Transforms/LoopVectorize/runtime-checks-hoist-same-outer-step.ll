; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[X:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[X_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[I:%.*]] = add nuw nsw i64 [[ROW]], [[X]]
; CHECK-NEXT:    [[GEP_SRC:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[I]]
; CHECK-NEXT:    [[L_SRC:%.*]] = load i32, ptr [[GEP_SRC]], align 4
; CHECK-NEXT:    [[GEP_DST:%.*]] = getelementptr inbounds i32, ptr [[DST]], i64 [[I]]
; CHECK-NEXT:    [[L_DST:%.*]] = load i32, ptr [[GEP_DST]], align 4
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[L_DST]], [[L_SRC]]
; CHECK-NEXT:    store i32 [[ADD]], ptr [[GEP_DST]], align 4
; CHECK-NEXT:    [[X_NEXT]] = add nuw nsw i64 [[X]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[X_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER_LATCH]], label %[[INNER]], !llvm.loop [[LOOP25:![0-9]+]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[Y_NEXT]] = add nuw nsw i64 [[Y]], 1
; CHECK-NEXT:    [[GEP_FLAG:%.*]] = getelementptr inbounds i8, ptr [[FLAGS]], i64 [[Y]]
; CHECK-NEXT:    [[FLAG:%.*]] = load i8, ptr [[GEP_FLAG]], align 1
; CHECK-NEXT:    [[EC_OUTER:%.*]] = icmp eq i8 [[FLAG]], 0
; CHECK-NEXT:    br i1 [[EC_OUTER]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %y = phi i64 [ 0, %entry ], [ %y.next, %outer.latch ]
  %row = mul nuw nsw i64 %y, %n
  br label %inner

inner:
  %x = phi i64 [ 0, %outer ], [ %x.next, %inner ]
  %i = add nuw nsw i64 %row, %x
  %gep.src = getelementptr inbounds i32, ptr %src, i64 %i
  %l.src = load i32, ptr %gep.src, align 4
  %gep.dst = getelementptr inbounds i32, ptr %dst, i64 %i
  %l.dst = load i32, ptr %gep.dst, align 4
  %add = add i32 %l.dst, %l.src
  store i32 %add, ptr %gep.dst, align 4
  %x.next = add nuw nsw i64 %x, 1
  %ec = icmp eq i64 %x.next, %n
  br i1 %ec, label %outer.latch, label %inner

outer.latch:
  %y.next = add nuw nsw i64 %y, 1
  %gep.flag = getelementptr inbounds i8, ptr %flags, i64 %y
  %flag = load i8, ptr %gep.flag, align 1
  %ec.outer = icmp eq i8 %flag, 0
  br i1 %ec.outer, label %exit, label %outer

exit:
  ret void
}

