entry:
  %null_check = icmp eq i64 %length, 0
  br i1 %null_check, label %exit, label %preheader

preheader:
  call void @llvm.assume(i1 true) [ "dereferenceable"(ptr %ptr, i64 %length) ]
  %start = sub i64 %length, 1
  br label %loop

loop:
  %iv = phi i64 [ %iv.next, %latch ], [ %start, %preheader ]
  %element_gep = getelementptr i8, ptr %ptr, i64 %iv
  %element = load i8, ptr %element_gep, align 1
  %found_check = icmp eq i8 %element, 0
  br i1 %found_check, label %exit, label %latch

latch:
  %iv.next = add i64 %iv, -1
  %range_check = icmp ne i64 %iv, 0
  br i1 %range_check, label %loop, label %exit

exit:
  ret ptr null
}
