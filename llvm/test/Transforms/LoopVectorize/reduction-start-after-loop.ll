; CHECK-NEXT:    [[X:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[X_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[RDX:%.*]] = phi i32 [ [[BC_MERGE_RDX]], %[[SCALAR_PH]] ], [ [[RDX_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[X]]
; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[RDX_NEXT]] = or i32 [[RDX]], [[L]]
; CHECK-NEXT:    [[X_NEXT]] = add nuw nsw i64 [[X]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[X_NEXT]], [[W]]
; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER_LATCH]], label %[[LOOP]], !llvm.loop [[LOOP5:![0-9]+]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[RDX_NEXT_LCSSA]] = phi i32 [ [[RDX_NEXT]], %[[LOOP]] ], [ [[TMP5]], %[[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    [[Y_NEXT]] = add nuw nsw i64 [[Y]], 1
; CHECK-NEXT:    [[EC_OUTER:%.*]] = icmp eq i64 [[Y_NEXT]], [[H]]
; CHECK-NEXT:    br i1 [[EC_OUTER]], label %[[EXIT:.*]], label %[[OUTER]]
