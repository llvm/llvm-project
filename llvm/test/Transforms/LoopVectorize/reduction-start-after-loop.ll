; CHECK-NEXT:    [[RES:%.*]] = sub i32 [[RDX_ADD_NEXT_LCSSA]], [[RDX_XOR_NEXT_LCSSA]]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  %start = load i32, ptr %p.start, align 4
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %rdx.add = phi i32 [ %start, %entry ], [ %rdx.add.next, %loop ]
  %rdx.xor = phi i32 [ %start, %entry ], [ %rdx.xor.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep, align 4
  %rdx.add.next = add i32 %rdx.add, %l
  %rdx.xor.next = xor i32 %rdx.xor, %l
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop, !llvm.loop !0

exit:
  %res = sub i32 %rdx.add.next, %rdx.xor.next
  ret i32 %res
}

; Interleaving only (VF 1, IC 2).
define i32 @add_interleave_only_loaded_start(ptr %a, i64 %n, ptr %p.start) {
; CHECK-LABEL: define i32 @add_interleave_only_loaded_start(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]], ptr [[P_START:%.*]]) {
