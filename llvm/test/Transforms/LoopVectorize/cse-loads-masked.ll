  %r2 = load i32, ptr %gep.a, align 4
  %gep.c = getelementptr inbounds i32, ptr %cond, i64 %iv
  %c = load i32, ptr %gep.c, align 4
  %cmp = icmp ne i32 %c, 0
  br i1 %cmp, label %if, label %latch
if:
