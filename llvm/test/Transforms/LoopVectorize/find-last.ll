; CHECK-NEXT:    [[TMP5:%.*]] = icmp slt <4 x i32> [[WIDE_MASKED_LOAD]], zeroinitializer
; CHECK-NEXT:    [[TMP6:%.*]] = freeze <4 x i1> [[TMP3]]
