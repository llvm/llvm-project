; CHECK-NEXT:    EMIT vp<%index.next> = add vp<%index>, ir<8>
; CHECK-NEXT:    EMIT vp<[[VP2:%[0-9]+]]> = icmp eq vp<%index.next>, ir<1180591620717411303432>
; CHECK-NEXT:    EMIT branch-on-cond vp<[[VP2]]>
