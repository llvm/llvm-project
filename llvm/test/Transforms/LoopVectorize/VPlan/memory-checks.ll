  store i32 %l, ptr %gep.b, align 4
  %iv.2.next = add nuw nsw i64 %iv.2, 1
  %ec.2 = icmp eq i64 %iv.2.next, %n
  br i1 %ec.2, label %exit, label %loop.2

exit:
  ret void
}

declare void @use(i64)
