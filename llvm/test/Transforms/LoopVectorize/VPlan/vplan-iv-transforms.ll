; CHECK-NEXT:    vp<[[VP15:%[0-9]+]]> = DERIVED-IV ir<0> + vp<[[VP14]]> * ir<4>
; CHECK-NEXT:    vp<[[VP16:%[0-9]+]]> = DERIVED-IV ir<%n> + vp<[[VP14]]> * ir<-1>
; CHECK-NEXT:  Successor(s): ir-bb<exit>
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<exit>:
; CHECK-NEXT:    IR   %res.x = phi i32 [ %x.next, %loop.header ], [ %x.latch, %loop.latch ] (extra operands: vp<[[VP4]]> from middle.block, vp<[[VP15]]> from vector.early.exit)
; CHECK-NEXT:    IR   %res.cnt = phi i32 [ %cnt.next, %loop.header ], [ 0, %loop.latch ] (extra operands: ir<0> from middle.block, vp<[[VP16]]> from vector.early.exit)
; CHECK-NEXT:    IR   store i32 %res.cnt, ptr %count.out, align 4
; CHECK-NEXT:  No successors
; CHECK-EMPTY:
; CHECK-NEXT:  scalar.ph:
; CHECK-NEXT:    EMIT-SCALAR vp<%bc.resume.val> = phi [ vp<[[VP3]]>, middle.block ], [ ir<%n>, ir-bb<entry> ]
; CHECK-NEXT:    EMIT-SCALAR vp<%bc.resume.val>.1 = phi [ vp<[[VP4]]>, middle.block ], [ ir<0>, ir-bb<entry> ]
; CHECK-NEXT:  Successor(s): ir-bb<loop.header>
; CHECK-EMPTY:
; CHECK-NEXT:  ir-bb<loop.header>:
; CHECK-NEXT:    IR   %cnt = phi i32 [ %n, %entry ], [ %cnt.latch, %loop.latch ] (extra operand: vp<%bc.resume.val> from scalar.ph)
; CHECK-NEXT:    IR   %x = phi i32 [ 0, %entry ], [ %x.latch, %loop.latch ] (extra operand: vp<%bc.resume.val>.1 from scalar.ph)
; CHECK-NEXT:    IR   %x.next = add nsw i32 %x, 4
; CHECK-NEXT:    IR   %cnt.next = add nsw i32 %cnt, -1
; CHECK-NEXT:    IR   %c = icmp slt i32 %x.next, %w
; CHECK-NEXT:  No successors
; CHECK-NEXT:  }
;
entry:
  br label %loop.header

loop.header:
  %cnt = phi i32 [ %n, %entry ], [ %cnt.latch, %loop.latch ]
  %x = phi i32 [ 0, %entry ], [ %x.latch, %loop.latch ]
  %x.next = add nsw i32 %x, 4
  %cnt.next = add nsw i32 %cnt, -1
  %c = icmp slt i32 %x.next, %w
  br i1 %c, label %loop.latch, label %exit

loop.latch:
  %x.latch = phi i32 [ %x.next, %loop.header ]
  %cnt.latch = phi i32 [ %cnt.next, %loop.header ]
  %ec = icmp eq i32 %cnt.latch, 0
  br i1 %ec, label %exit, label %loop.header

exit:
  %res.x = phi i32 [ %x.next, %loop.header ], [ %x.latch, %loop.latch ]
  %res.cnt = phi i32 [ %cnt.next, %loop.header ], [ 0, %loop.latch ]
  store i32 %res.cnt, ptr %count.out, align 4
  ret i32 %res.x
}
