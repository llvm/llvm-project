; ALM-NEXT:    IR   %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
; ALM-NEXT:    IR   %x = load i32, ptr %gep.a, align 4
; ALM-NEXT:    IR   %s = add i32 %x, %prev
; ALM-NEXT:    IR   %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
; ALM-NEXT:    IR   store i32 %s, ptr %gep.b, align 4
; ALM-NEXT:    IR   %iv.next = add nuw nsw i64 %iv, 1
; ALM-NEXT:    IR   %ec = icmp eq i64 %iv.next, %n
; ALM-NEXT:  No successors
; ALM-NEXT:  }
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %prev = phi i32 [ 0, %entry ], [ %x, %loop ]
  %gep.a = getelementptr inbounds i32, ptr %a, i64 %iv
  %x = load i32, ptr %gep.a
  %s = add i32 %x, %prev
  %gep.b = getelementptr inbounds i32, ptr %b, i64 %iv
  store i32 %s, ptr %gep.b
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %prev
}
