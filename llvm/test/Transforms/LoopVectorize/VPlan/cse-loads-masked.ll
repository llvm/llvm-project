; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 \
; RUN:     -force-target-supports-masked-memory-ops -disable-output \
; RUN:     -vplan-print-after="printFinalVPlan$" %s 2>&1 | FileCheck %s
