; CHECK-NEXT:      CLONE ir<%gep.0> = getelementptr inbounds ir<%src>, ir<%t>, ir<0>
; CHECK-NEXT:      CLONE ir<%gep.1> = getelementptr inbounds ir<%src>, ir<%t>, ir<1>
; CHECK-NEXT:      INTERLEAVE-GROUP with factor 2, ir<%gep.0>
