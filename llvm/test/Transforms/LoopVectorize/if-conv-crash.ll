target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"

define fastcc void @DD_dump() {
; CHECK-LABEL: define fastcc void @DD_dump() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 true, label %[[LOR_LHS_FALSE:.*]], label %[[IF_END25:.*]]
; CHECK:       [[LOR_LHS_FALSE]]:
; CHECK-NEXT:    br i1 false, label %[[IF_END21:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    br i1 false, label %[[NUM_Q_EXIT:.*]], label %[[WHILE_BODY_I_PREHEADER:.*]]
; CHECK:       [[WHILE_BODY_I_PREHEADER]]:
; CHECK-NEXT:    br label %[[WHILE_BODY_I:.*]]
; CHECK:       [[WHILE_BODY_I]]:
; CHECK-NEXT:    switch i8 0, label %[[IF_END_I:.*]] [
; CHECK-NEXT:      i8 39, label %[[IF_THEN_I:.*]]
; CHECK-NEXT:      i8 92, label %[[IF_THEN_I]]
; CHECK-NEXT:    ]
; CHECK:       [[IF_THEN_I]]:
; CHECK-NEXT:    br label %[[IF_END_I]]
; CHECK:       [[IF_END_I]]:
; CHECK-NEXT:    br i1 false, label %[[NUM_Q_EXIT_LOOPEXIT:.*]], label %[[WHILE_BODY_I]]
; CHECK:       [[NUM_Q_EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[NUM_Q_EXIT]]
; CHECK:       [[NUM_Q_EXIT]]:
; CHECK-NEXT:    unreachable
; CHECK:       [[IF_END21]]:
; CHECK-NEXT:    unreachable
; CHECK:       [[IF_END25]]:
; CHECK-NEXT:    ret void
;
entry:
  br i1 true, label %lor.lhs.false, label %if.end25

lor.lhs.false:
  br i1 false, label %if.end21, label %if.else

if.else:
  br i1 false, label %num_q.exit, label %while.body.i.preheader

while.body.i.preheader:
  br label %while.body.i

while.body.i:
  switch i8 0, label %if.end.i [
  i8 39, label %if.then.i
  i8 92, label %if.then.i
  ]

if.then.i:
  br label %if.end.i

if.end.i:
  br i1 false, label %num_q.exit, label %while.body.i

num_q.exit:
  unreachable

if.end21:
  unreachable

if.end25:
  ret void
}

; PR15990
; We can have basic blocks with single entry PHI nodes.
define void @single_entry_phi(ptr %a, ptr %b) {
; CHECK-LABEL: define void @single_entry_phi(
; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[FOR_COND1_PREHEADER:.*]]
; CHECK:       [[FOR_COND1_PREHEADER]]:
; CHECK-NEXT:    [[INC10:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[INC:%.*]], %[[FOR_END:.*]] ]
; CHECK-NEXT:    br label %[[FOR_END]]
; CHECK:       [[FOR_END]]:
; CHECK-NEXT:    [[MALICIOUS_PHI:%.*]] = phi i32 [ 0, %[[FOR_COND1_PREHEADER]] ]
; CHECK-NEXT:    [[INC]] = add nsw i32 [[INC10]], 1
; CHECK-NEXT:    [[TOBOOL:%.*]] = icmp eq i32 [[INC]], 0
; CHECK-NEXT:    br i1 [[TOBOOL]], label %[[FOR_COND_FOR_END5:.*]], label %[[FOR_COND1_PREHEADER]]
; CHECK:       [[FOR_COND_FOR_END5]]:
; CHECK-NEXT:    [[AND_LCSSA:%.*]] = phi i32 [ [[MALICIOUS_PHI]], %[[FOR_END]] ]
; CHECK-NEXT:    store i32 [[AND_LCSSA]], ptr [[A]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br label %for.cond1.preheader

for.cond1.preheader:
  %inc10 = phi i32 [ 0, %entry ], [ %inc, %for.end ]
  br label %for.end

for.end:
  %malicious.phi = phi i32 [ 0, %for.cond1.preheader ]
  %inc = add nsw i32 %inc10, 1
  %tobool = icmp eq i32 %inc, 0
  br i1 %tobool, label %for.cond.for.end5, label %for.cond1.preheader

for.cond.for.end5:
  %and.lcssa = phi i32 [ %malicious.phi, %for.end ]
  store i32 %and.lcssa, ptr %a, align 4
  ret void
}
