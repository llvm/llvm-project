entry:
  br label %loop

loop:
  %iv = phi i32 [ %n, %entry ], [ %iv.next, %loop ]
  %ptr = getelementptr inbounds i32, ptr %a, i32 %iv
  store i32 %iv, ptr %ptr, align 4
  %iv.next = sub nsw i32 %iv, 1
  %cmp = icmp sgt i32 %iv.next, 0
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

