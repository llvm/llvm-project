; A shift by a variable amount may be reused for an expression that models it
; as a multiply by a power of two, because expanding that model emits a shift
; by the same amount. It may not be reused once the shift has cancelled out of
; the expression, since what remains expands to something that is not poison.
;
; %x and %v are noundef in both tests so that the shift is the only possible
; source of poison. Without that the poison walk stops at %x, a possibly-poison
; value absent from the expression, and never judges the shift at all, which
; would leave these passing while testing nothing.

; %t is ((%x << %v) + %a1 + %a2) - (%x << %v), so its SCEV is (%a1 + %a2) and no
; power of two survives. %t is the only value with that SCEV, so expanding the
; induction step tries to reuse it, and must be refused: %t is poison for a
; large %v where (%a1 + %a2) is not.
define void @step_where_shift_cancels(ptr %p, i64 noundef %x, i64 noundef %v, i64 %a1, i64 %a2, i64 %n) {
; CHECK-LABEL: define void @step_where_shift_cancels(
; CHECK-SAME: ptr [[P:%.*]], i64 noundef [[X:%.*]], i64 noundef [[V:%.*]], i64 [[A1:%.*]], i64 [[A2:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[S:%.*]] = shl i64 [[X]], [[V]]
; CHECK-NEXT:    [[P1:%.*]] = add i64 [[S]], [[A1]]
; CHECK-NEXT:    [[P2:%.*]] = add i64 [[P1]], [[A2]]
; CHECK-NEXT:    [[T:%.*]] = sub i64 [[P2]], [[S]]
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[A2]], [[A1]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP1:%.*]] = and i64 [[N]], 3
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = mul i64 [[N_VEC]], [[TMP0]]
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[TMP0]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP3:%.*]] = mul <4 x i64> <i64 0, i64 1, i64 2, i64 3>, [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP4:%.*]] = shl i64 [[TMP0]], 2
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <4 x i64> poison, i64 [[TMP4]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT1]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ [[TMP3]], %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY]] ]
