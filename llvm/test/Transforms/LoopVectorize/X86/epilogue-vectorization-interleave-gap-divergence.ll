  %gep1 = getelementptr inbounds nuw i8, ptr %gep, i64 1
  %l1 = load i8, ptr %gep1, align 1
  %c1 = zext i8 %l1 to i32
  %mul = mul nuw nsw i32 %c1, %c0
  %add = add nuw nsw i32 %mul, %sum
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %for.body

exit:
  ret i32 %add
