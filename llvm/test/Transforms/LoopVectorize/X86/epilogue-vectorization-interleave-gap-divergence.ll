entry:
  br label %for.body

for.body:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %for.body ]
  %sum = phi i32 [ 0, %entry ], [ %add, %for.body ]
  %gep = getelementptr inbounds nuw [3 x i8], ptr %p, i64 %iv
  %l0 = load i8, ptr %gep, align 1
