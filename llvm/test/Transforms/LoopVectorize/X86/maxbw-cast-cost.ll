; MAXBW-NEXT:    [[ADD:%.*]] = add i16 [[LA]], [[LB]]
; MAXBW-NEXT:    [[GC:%.*]] = getelementptr inbounds i16, ptr [[C]], i64 [[IV]]
; MAXBW-NEXT:    store i16 [[ADD]], ptr [[GC]], align 2
