entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %ga = getelementptr inbounds i16, ptr %a, i64 %iv
  %la = load i16, ptr %ga
  %gb = getelementptr inbounds i16, ptr %b, i64 %iv
  %lb = load i16, ptr %gb
  %add = add i16 %la, %lb
