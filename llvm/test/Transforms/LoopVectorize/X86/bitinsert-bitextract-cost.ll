; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --filter "Found an estimated cost of [0-9]+ for VF [0-9]+ For instruction:\s*%x = bit" --filter "Cost of [0-9]+ for VF [0-9]+: (REPLICATE|CLONE) ir<%x> = bit" --version 6
; REQUIRES: asserts
; RUN: opt -passes=loop-vectorize -S -mattr=+avx2 --debug-only=loop-vectorize --disable-output < %s 2>&1 | FileCheck %s

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

; A replicated bitextract costs one scalar op per lane plus the lane
; extracts and inserts.
define void @bitextract_varying_src(ptr noalias %dst, ptr noalias %src, i64 %n) {
; CHECK-LABEL: 'bitextract_varying_src'
; CHECK:  LV: Found an estimated cost of 1 for VF 1 For instruction: %x = bitextract i8, b16 %b, i32 8
; CHECK:  Cost of 4 for VF 2: REPLICATE ir<%x> = bitextract ir<%b>, ir<8>
; CHECK:  Cost of 8 for VF 4: REPLICATE ir<%x> = bitextract ir<%b>, ir<8>
; CHECK:  Cost of 16 for VF 8: REPLICATE ir<%x> = bitextract ir<%b>, ir<8>
; CHECK:  Cost of 32 for VF 16: REPLICATE ir<%x> = bitextract ir<%b>, ir<8>
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.src = getelementptr inbounds b16, ptr %src, i64 %iv
  %b = load b16, ptr %gep.src, align 2
  %x = bitextract i8, b16 %b, i32 8
  %gep.dst = getelementptr inbounds i8, ptr %dst, i64 %iv
  store i8 %x, ptr %gep.dst, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; A bitextract of a loop-invariant value is a single scalar, so it costs one
; scalar op at every VF.
define void @bitextract_uniform_src(ptr noalias %dst, ptr noalias %src, i64 %n) {
; CHECK-LABEL: 'bitextract_uniform_src'
; CHECK:  LV: Found an estimated cost of 1 for VF 1 For instruction: %x = bitextract i8, b16 %b, i32 0
; CHECK:  Cost of 1 for VF 2: CLONE ir<%x> = bitextract ir<%b>, ir<0>
; CHECK:  Cost of 1 for VF 4: CLONE ir<%x> = bitextract ir<%b>, ir<0>
; CHECK:  Cost of 1 for VF 8: CLONE ir<%x> = bitextract ir<%b>, ir<0>
; CHECK:  Cost of 1 for VF 16: CLONE ir<%x> = bitextract ir<%b>, ir<0>
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %b = load b16, ptr %src, align 2
  %x = bitextract i8, b16 %b, i32 0
  %gep.dst = getelementptr inbounds i8, ptr %dst, i64 %iv
  store i8 %x, ptr %gep.dst, align 1
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; A replicated bitinsert costs one scalar op per lane plus the lane
; extracts and inserts.
define void @bitinsert_varying_base(ptr noalias %dst, ptr noalias %src, i8 %v, i64 %n) {
; CHECK-LABEL: 'bitinsert_varying_base'
; CHECK:  LV: Found an estimated cost of 1 for VF 1 For instruction: %x = bitinsert b16 %b, i8 %v, i32 8
; CHECK:  Cost of 4 for VF 2: REPLICATE ir<%x> = bitinsert ir<%b>, ir<%v>, ir<8>
; CHECK:  Cost of 8 for VF 4: REPLICATE ir<%x> = bitinsert ir<%b>, ir<%v>, ir<8>
; CHECK:  Cost of 16 for VF 8: REPLICATE ir<%x> = bitinsert ir<%b>, ir<%v>, ir<8>
; CHECK:  Cost of 33 for VF 16: REPLICATE ir<%x> = bitinsert ir<%b>, ir<%v>, ir<8>
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.src = getelementptr inbounds b16, ptr %src, i64 %iv
  %b = load b16, ptr %gep.src, align 2
  %x = bitinsert b16 %b, i8 %v, i32 8
  %gep.dst = getelementptr inbounds b16, ptr %dst, i64 %iv
  store b16 %x, ptr %gep.dst, align 2
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
