; REQUIRES: asserts
target triple = "x86_64-unknown-linux-gnu"

; i16 dot products on targets without VNNI.

; Without VNNI, the signed i16 dot product is a PMADDWD and an ADD.
define i32 @dot_s16s16(ptr readonly %a, ptr readonly %b) {
; SSE2-LABEL: 'dot_s16s16'
; SSE2:  Cost of 2 for VF 8: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
; SSE2:  Cost of 2 for VF 8: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
;
; AVX1-LABEL: 'dot_s16s16'
; AVX1:  Cost of 8 for VF 16: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
; AVX1:  Cost of 8 for VF 16: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
;
; AVX2-LABEL: 'dot_s16s16'
; AVX2:  Cost of 2 for VF 16: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
; AVX2:  Cost of 2 for VF 16: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
;
; AVX512BW-LABEL: 'dot_s16s16'
; AVX512BW:  Cost of 2 for VF 32: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
; AVX512BW:  Cost of 2 for VF 32: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %sum = phi i32 [ 0, %entry ], [ %sum.next, %loop ]
  %gep.a = getelementptr inbounds i16, ptr %a, i64 %iv
  %load.a = load i16, ptr %gep.a, align 1
  %ext.a = sext i16 %load.a to i32
  %gep.b = getelementptr inbounds i16, ptr %b, i64 %iv
  %load.b = load i16, ptr %gep.b, align 1
  %ext.b = sext i16 %load.b to i32
  %mul = mul nsw i32 %ext.a, %ext.b
  %sum.next = add nsw i32 %sum, %mul
  %iv.next = add nuw nsw i64 %iv, 1
  %exitcond = icmp eq i64 %iv.next, 1024
  br i1 %exitcond, label %exit, label %loop

exit:
  ret i32 %sum.next
}

; PMADDWD can't multiply unsigned i16 elements.
define i32 @dot_u16u16(ptr readonly %a, ptr readonly %b) {
; SSE2-LABEL: 'dot_u16u16'
; SSE2:  Cost of 2 for VF 8: WIDEN ir<%sum.next> = add ir<%sum>, ir<%mul>
