target triple = "x86_64-unknown-linux-gnu"

; The load is strided, so it is scalarized and each <VF x i16> is built from VF
; loaded scalars. Pre-SSE41, LowerBuildVectorv8i16 builds a vector of more than
; 4 elements with MOVD+PUNPCK rather than PINSRW.
define i16 @count_nonzero_strided(ptr %p, i64 %n) {
; SSE2-LABEL: 'count_nonzero_strided'
; SSE2:  LV: Scalar loop costs: 6.
; SSE2:  Cost of 4 for VF 2: REPLICATE ir<%x> = load vp<%next.gep>
; SSE2:  Cost for VF 2: 11 (Estimated cost per lane: 5.5)
; SSE2:  Cost of 8 for VF 4: REPLICATE ir<%x> = load vp<%next.gep>
; SSE2:  Cost for VF 4: 15 (Estimated cost per lane: 3.75)
; SSE2:  Cost of 16 for VF 8: REPLICATE ir<%x> = load vp<%next.gep>
; SSE2:  Cost for VF 8: 23 (Estimated cost per lane: 2.88)
; SSE2:  LV: Selecting VF: 8.
;
; SSE41-LABEL: 'count_nonzero_strided'
; SSE41:  LV: Scalar loop costs: 6.
; SSE41:  Cost of 4 for VF 2: REPLICATE ir<%x> = load vp<%next.gep>
; SSE41:  Cost for VF 2: 11 (Estimated cost per lane: 5.5)
; SSE41:  Cost of 8 for VF 4: REPLICATE ir<%x> = load vp<%next.gep>
; SSE41:  Cost for VF 4: 15 (Estimated cost per lane: 3.75)
; SSE41:  Cost of 16 for VF 8: REPLICATE ir<%x> = load vp<%next.gep>
; SSE41:  Cost for VF 8: 23 (Estimated cost per lane: 2.88)
; SSE41:  LV: Selecting VF: 8.
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %ptr = phi ptr [ %p, %entry ], [ %ptr.next, %loop ]
  %acc = phi i16 [ 0, %entry ], [ %acc.next, %loop ]
  %x = load i16, ptr %ptr, align 2
  %nz = icmp ne i16 %x, 0
  %z = zext i1 %nz to i16
  %acc.next = add i16 %acc, %z
  %ptr.next = getelementptr inbounds i8, ptr %ptr, i64 32
  %i.next = add nuw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret i16 %acc.next
}
