; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --filter-out-after "Selecting VF" --filter "LV: Scalar loop costs" --filter "Cost of [0-9]+ for VF [0-9]+: REPLICATE ir<%x> = load" --filter "Cost for VF [0-9]+:" --filter "LV: Selecting VF" --version 6
; RUN: opt -passes=loop-vectorize -mattr=+sse2 -S --debug-only=loop-vectorize --disable-output < %s 2>&1 | FileCheck %s --check-prefix=SSE2
; RUN: opt -passes=loop-vectorize -mattr=+sse4.1 -S --debug-only=loop-vectorize --disable-output < %s 2>&1 | FileCheck %s --check-prefix=SSE41
