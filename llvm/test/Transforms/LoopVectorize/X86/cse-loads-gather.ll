  %gep.a1 = getelementptr inbounds i32, ptr %a, i64 %idx1
  %gep.a2 = getelementptr inbounds i32, ptr %a, i64 %idx2
  %x = load i32, ptr %gep.a1, align 4
  %y = load i32, ptr %gep.a2, align 4
  %sum = add i32 %x, %y
  %gep.o = getelementptr inbounds i32, ptr %out, i64 %iv
  store i32 %sum, ptr %gep.o, align 4
