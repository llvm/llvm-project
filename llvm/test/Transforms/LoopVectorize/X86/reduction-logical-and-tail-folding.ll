; CHECK-NEXT:    [[TMP15:%.*]] = freeze <4 x i1> [[TMP13]]
; CHECK-NEXT:    [[TMP16:%.*]] = freeze <4 x i1> [[TMP14]]
; CHECK-NEXT:    [[BIN_RDX:%.*]] = and <4 x i1> [[TMP16]], [[TMP15]]
; CHECK-NEXT:    [[RDX_NEXT_LCSSA:%.*]] = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> [[BIN_RDX]])
; CHECK-NEXT:    br label %[[EXIT1:.*]]
; CHECK:       [[EXIT1]]:
; CHECK-NEXT:    ret i1 [[RDX_NEXT_LCSSA]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %rdx = phi i1 [ true, %entry ], [ %rdx.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i64 %iv
  %v = load i32, ptr %gep, align 4
  %lo = icmp sgt i32 %v, 0
  %hi = icmp slt i32 %v, 10
  %and = and i1 %rdx, %hi
  %rdx.next = select i1 %lo, i1 %and, i1 false
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i1 %rdx.next
}
;.
; CHECK: [[LOOP0]] = distinct !{[[LOOP0]], [[META1:![0-9]+]], [[META2:![0-9]+]]}
