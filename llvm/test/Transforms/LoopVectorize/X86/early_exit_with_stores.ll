  %l = load i16, ptr %gep.src
  %c = icmp sgt i16 %l, 500
  br i1 %c, label %exit, label %loop.latch

loop.latch:
  %off.0 = shl i64 %iv, 1
  %gep.dst.0 = getelementptr i16, ptr %dst, i64 %off.0
