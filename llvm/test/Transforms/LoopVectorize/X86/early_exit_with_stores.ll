; CHECK-NEXT:    [[TMP22:%.*]] = getelementptr i16, ptr [[DST]], i64 [[TMP18]]
; CHECK-NEXT:    [[TMP23:%.*]] = getelementptr i16, ptr [[DST]], i64 [[TMP19]]
; CHECK-NEXT:    store i16 2, ptr [[TMP20]], align 2
