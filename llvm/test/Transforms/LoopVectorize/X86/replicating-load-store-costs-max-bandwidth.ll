then:
  %cmp.x = icmp slt i32 %x, %val
  %select.ptr = select i1 %cmp.x, ptr %ptr2, ptr %ptr3
  br label %merge.and.store

else:
  br i1 %cond, label %merge.and.store, label %loop.latch

merge.and.store:
