; RUN: opt -passes='loop-vectorize,verify<scalar-evolution>' -S %s | FileCheck %s

target triple = "x86_64-unknown-linux-gnu"

; Make sure ScalarEvolution invalidates enclosing loops when vectorizing an
; inner loop removes blocks shared with an outer loop.
define void @invalidate_outer_loop_scev_on_inner_vectorization() {
; CHECK-LABEL: @invalidate_outer_loop_scev_on_inner_vectorization(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[OUTER_HEADER:%.*]]
; CHECK:       outer.header.loopexit:
; CHECK-NEXT:    br label [[OUTER_HEADER]]
; CHECK:       outer.header:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[OUTER_IV_NEXT:%.*]], [[OUTER_HEADER_LOOPEXIT:%.*]] ]
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add i32 [[OUTER_IV]], 1
; CHECK-NEXT:    br label [[INNER_HEADER:%.*]]
; CHECK:       inner.header:
; CHECK-NEXT:    [[INNER_IV:%.*]] = phi i64 [ 250231, [[OUTER_HEADER]] ], [ [[INNER_IV_NEXT:%.*]], [[INNER_LATCH:%.*]] ]
; CHECK-NEXT:    [[TRUNC:%.*]] = trunc i64 [[INNER_IV]] to i32
; CHECK-NEXT:    [[EARLY_COND_1:%.*]] = icmp ult i32 [[TRUNC]], 1
; CHECK-NEXT:    br i1 [[EARLY_COND_1]], label [[INNER_BODY:%.*]], label [[EXIT_1:%.*]]
; CHECK:       inner.body:
; CHECK-NEXT:    [[EARLY_COND_2:%.*]] = icmp eq i32 0, [[OUTER_IV]]
; CHECK-NEXT:    br i1 [[EARLY_COND_2]], label [[EXIT_2:%.*]], label [[INNER_LATCH]]
; CHECK:       inner.latch:
; CHECK-NEXT:    [[INNER_IV_NEXT]] = add i64 [[INNER_IV]], -1
; CHECK-NEXT:    [[LATCH_COND:%.*]] = icmp ult i64 [[INNER_IV]], 250217
; CHECK-NEXT:    br i1 [[LATCH_COND]], label [[OUTER_HEADER_LOOPEXIT]], label [[INNER_HEADER]]
; CHECK:       exit.1:
; CHECK-NEXT:    ret void
; CHECK:       exit.2:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer.header

outer.header:
  %outer.iv = phi i32 [ 0, %entry ], [ %outer.iv.next, %inner.latch ]
  %outer.iv.next = add i32 %outer.iv, 1
  br label %inner.header

inner.header:
  %inner.iv = phi i64 [ 250231, %outer.header ], [ %inner.iv.next, %inner.latch ]
  %trunc = trunc i64 %inner.iv to i32
  %early.cond.1 = icmp ult i32 %trunc, 1
  br i1 %early.cond.1, label %inner.body, label %exit.1

inner.body:
  %early.cond.2 = icmp eq i32 0, %outer.iv
  br i1 %early.cond.2, label %exit.2, label %inner.latch

inner.latch:
  %inner.iv.next = add i64 %inner.iv, -1
  %latch.cond = icmp ult i64 %inner.iv, 250217
  br i1 %latch.cond, label %outer.header, label %inner.header

exit.1:
  ret void

exit.2:
  ret void
}
