; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <2 x ptr> [[BROADCAST_SPLATINSERT]], <2 x ptr> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <2 x i64> [ <i64 0, i64 1>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_PHI:%.*]] = phi <2 x i32> [ zeroinitializer, %[[VECTOR_PH]] ], [ [[TMP13:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = shl nuw nsw i64 [[INDEX]], 3
; CHECK-NEXT:    [[TMP2:%.*]] = call i64 @llvm.smax.i64(i64 [[TMP1]], i64 0)
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i8, ptr [[PP]], i64 [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = load ptr, ptr [[TMP3]], align 8
; CHECK-NEXT:    [[WIDE_GEP:%.*]] = getelementptr i8, ptr [[TMP4]], i64 64
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <2 x ptr> poison, ptr [[WIDE_GEP]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <2 x ptr> [[BROADCAST_SPLATINSERT1]], <2 x ptr> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP5:%.*]] = and <2 x i64> [[VEC_IND]], splat (i64 3)
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ult <2 x i64> [[TMP5]], splat (i64 2)
; CHECK-NEXT:    [[PREDPHI:%.*]] = select <2 x i1> [[TMP6]], <2 x ptr> [[BROADCAST_SPLAT2]], <2 x ptr> [[BROADCAST_SPLAT]]
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <2 x ptr> [[PREDPHI]], i64 0
; CHECK-NEXT:    [[TMP8:%.*]] = load i32, ptr [[TMP7]], align 4
; CHECK-NEXT:    [[TMP9:%.*]] = extractelement <2 x ptr> [[PREDPHI]], i64 1
; CHECK-NEXT:    [[TMP10:%.*]] = load i32, ptr [[TMP9]], align 4
; CHECK-NEXT:    [[TMP11:%.*]] = insertelement <2 x i32> poison, i32 [[TMP8]], i64 0
; CHECK-NEXT:    [[TMP12:%.*]] = insertelement <2 x i32> [[TMP11]], i32 [[TMP10]], i64 1
; CHECK-NEXT:    [[TMP13]] = add <2 x i32> [[VEC_PHI]], [[TMP12]]
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 2
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <2 x i64> [[VEC_IND]], splat (i64 2)
; CHECK-NEXT:    [[TMP14:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP14]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[TMP15:%.*]] = call i32 @llvm.vector.reduce.add.v2i32(<2 x i32> [[TMP13]])
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], [[EXIT:label %.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %red = phi i32 [ 0, %entry ], [ %red.next, %loop.latch ]
  %shl = shl nuw nsw i64 %iv, 3
  %idx = call i64 @llvm.smax.i64(i64 %shl, i64 0)
  %gep.pp = getelementptr inbounds i8, ptr %pp, i64 %idx
  %l.ptr = load ptr, ptr %gep.pp, align 8
  %gep.l.ptr = getelementptr i8, ptr %l.ptr, i64 64
  %and = and i64 %iv, 3
  %c.0 = icmp eq i64 %and, 0
  br i1 %c.0, label %then.0, label %else.0

then.0:
  br label %merge.0

else.0:
  br label %merge.0

merge.0:
  %ptr.0 = phi ptr [ %gep.l.ptr, %then.0 ], [ %gep.l.ptr, %else.0 ]
  %c.1 = icmp ult i64 %and, 2
  br i1 %c.1, label %then.1, label %loop.latch

then.1:
  br label %loop.latch

loop.latch:
  %ptr.1 = phi ptr [ %ptr.0, %then.1 ], [ %a, %merge.0 ]
  %l = load i32, ptr %ptr.1, align 4
  %red.next = add i32 %red, %l
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop.header

exit:
  ret i32 %red.next
}
