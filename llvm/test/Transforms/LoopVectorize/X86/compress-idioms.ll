; CHECK-ZNVER4-NEXT:    [[SRC_PTR:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[IDX]]
; CHECK-ZNVER4-NEXT:    [[LOAD_SRC:%.*]] = load i32, ptr [[SRC_PTR]], align 4
; CHECK-ZNVER4-NEXT:    store i32 [[LOAD_SRC]], ptr [[DST_PTR]], align 4
