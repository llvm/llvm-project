@g128 = global [128 x float] zeroinitializer

; out[i] = tab[idx[i]] with a uint8 index: the gathered table is checked
; against %out over [%tab, %tab + 1024).
define void @gather_u8(ptr %out, ptr %tab, ptr %idx, i64 %n) {
; CHECK-LABEL: define void @gather_u8(
; CHECK-SAME: ptr [[OUT:%.*]], ptr [[TAB:%.*]], ptr [[IDX:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[SCALAR_PH:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP_IDX:%.*]] = getelementptr inbounds i8, ptr [[IDX]], i64 [[IV]]
; CHECK-NEXT:    [[K:%.*]] = load i8, ptr [[GEP_IDX]], align 1
; CHECK-NEXT:    [[K_EXT:%.*]] = zext i8 [[K]] to i64
; CHECK-NEXT:    [[GEP_TAB:%.*]] = getelementptr inbounds float, ptr [[TAB]], i64 [[K_EXT]]
; CHECK-NEXT:    [[V:%.*]] = load float, ptr [[GEP_TAB]], align 4
; CHECK-NEXT:    [[GEP_OUT:%.*]] = getelementptr inbounds float, ptr [[OUT]], i64 [[IV]]
; CHECK-NEXT:    store float [[V]], ptr [[GEP_OUT]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %gep.idx = getelementptr inbounds i8, ptr %idx, i64 %iv
  %k = load i8, ptr %gep.idx, align 1
  %k.ext = zext i8 %k to i64
  %gep.tab = getelementptr inbounds float, ptr %tab, i64 %k.ext
  %v = load float, ptr %gep.tab, align 4
  %gep.out = getelementptr inbounds float, ptr %out, i64 %iv
  store float %v, ptr %gep.out, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

