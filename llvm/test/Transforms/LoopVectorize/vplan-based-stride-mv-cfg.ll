; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals none --version 6

; Test "outer" CFG connecting different vector loops in presence of VPlan-based
; unit-stride multiversioning/speculation.

; Epilogue vectorization isn't supported with VPlan-based stride multiversioning
; yet - we're vectorizing without vector epilogue.
;
; RUN: opt < %s -p loop-vectorize -force-vector-width=4 -S \
; RUN:     -epilogue-vectorization-force-VF=2 \
; RUN:     -enable-mem-access-versioning=false -enable-vplan-based-stride-mv 2>&1 | FileCheck %s --check-prefix VECTOR-EPILOGUE

define void @basic(ptr noalias %p.out, ptr %p, i64 %stride, i64 %n) {
; VECTOR-EPILOGUE-LABEL: define void @basic(
; VECTOR-EPILOGUE-SAME: ptr noalias [[P_OUT:%.*]], ptr [[P:%.*]], i64 [[STRIDE:%.*]], i64 [[N:%.*]]) {
; VECTOR-EPILOGUE-NEXT:  [[ENTRY:.*]]:
; VECTOR-EPILOGUE-NEXT:    [[TMP0:%.*]] = call i64 @llvm.smax.i64(i64 [[N]], i64 1)
; VECTOR-EPILOGUE-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[TMP0]], 4
; VECTOR-EPILOGUE-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[STRIDES_CHECK:.*]]
; VECTOR-EPILOGUE:       [[STRIDES_CHECK]]:
; VECTOR-EPILOGUE-NEXT:    [[TMP1:%.*]] = icmp ne i64 [[STRIDE]], 1
; VECTOR-EPILOGUE-NEXT:    br i1 [[TMP1]], label %[[SCALAR_PH]], label %[[VECTOR_PH:.*]]
; VECTOR-EPILOGUE:       [[VECTOR_PH]]:
; VECTOR-EPILOGUE-NEXT:    [[TMP2:%.*]] = and i64 [[TMP0]], 3
; VECTOR-EPILOGUE-NEXT:    [[N_VEC:%.*]] = sub i64 [[TMP0]], [[TMP2]]
; VECTOR-EPILOGUE-NEXT:    br label %[[VECTOR_BODY:.*]]
; VECTOR-EPILOGUE:       [[VECTOR_BODY]]:
; VECTOR-EPILOGUE-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; VECTOR-EPILOGUE-NEXT:    [[TMP3:%.*]] = getelementptr i64, ptr [[P]], i64 [[INDEX]]
; VECTOR-EPILOGUE-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i64>, ptr [[TMP3]], align 8
; VECTOR-EPILOGUE-NEXT:    [[TMP4:%.*]] = getelementptr i64, ptr [[P_OUT]], i64 [[INDEX]]
; VECTOR-EPILOGUE-NEXT:    store <4 x i64> [[WIDE_LOAD]], ptr [[TMP4]], align 8
; VECTOR-EPILOGUE-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; VECTOR-EPILOGUE-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; VECTOR-EPILOGUE-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; VECTOR-EPILOGUE:       [[MIDDLE_BLOCK]]:
; VECTOR-EPILOGUE-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[TMP0]], [[N_VEC]]
; VECTOR-EPILOGUE-NEXT:    br i1 [[CMP_N]], label %[[EXIT:.*]], label %[[SCALAR_PH]]
; VECTOR-EPILOGUE:       [[SCALAR_PH]]:
; VECTOR-EPILOGUE-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ], [ 0, %[[STRIDES_CHECK]] ]
; VECTOR-EPILOGUE-NEXT:    br label %[[HEADER:.*]]
; VECTOR-EPILOGUE:       [[HEADER]]:
; VECTOR-EPILOGUE-NEXT:    [[IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[HEADER]] ]
; VECTOR-EPILOGUE-NEXT:    [[IV_NEXT]] = add nsw i64 [[IV]], 1
; VECTOR-EPILOGUE-NEXT:    [[IDX:%.*]] = mul i64 [[IV]], [[STRIDE]]
; VECTOR-EPILOGUE-NEXT:    [[GEP_LD:%.*]] = getelementptr i64, ptr [[P]], i64 [[IDX]]
; VECTOR-EPILOGUE-NEXT:    [[LD:%.*]] = load i64, ptr [[GEP_LD]], align 8
; VECTOR-EPILOGUE-NEXT:    [[GEP_ST:%.*]] = getelementptr i64, ptr [[P_OUT]], i64 [[IV]]
; VECTOR-EPILOGUE-NEXT:    store i64 [[LD]], ptr [[GEP_ST]], align 8
; VECTOR-EPILOGUE-NEXT:    [[EXITCOND:%.*]] = icmp slt i64 [[IV_NEXT]], [[N]]
; VECTOR-EPILOGUE-NEXT:    br i1 [[EXITCOND]], label %[[HEADER]], label %[[EXIT]], !llvm.loop [[LOOP3:![0-9]+]]
; VECTOR-EPILOGUE:       [[EXIT]]:
; VECTOR-EPILOGUE-NEXT:    ret void
;
entry:
  br label %header

header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %header ]
  %iv.next = add nsw i64 %iv, 1

  %idx = mul i64 %iv, %stride

  %gep.ld = getelementptr i64, ptr %p, i64 %idx
  %ld = load i64, ptr %gep.ld, align 8

  %gep.st = getelementptr i64, ptr %p.out, i64 %iv
  store i64 %ld, ptr %gep.st, align 8

  %exitcond = icmp slt i64 %iv.next, %n
  br i1 %exitcond, label %header, label %exit

exit:
  ret void
}
