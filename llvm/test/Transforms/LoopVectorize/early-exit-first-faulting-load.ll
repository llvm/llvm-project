entry:
  br label %for.body

for.body:
  %iv = phi i64 [ 0, %entry ], [ %inc, %for.inc ]
  %arrayidx2 = getelementptr [8 x i8], ptr %0, i64 %iv
  %3 = load i64, ptr %arrayidx2, align 8
  %cmp3 = icmp eq i64 %3, 0
  br i1 %cmp3, label %land.lhs.true, label %for.inc

land.lhs.true:
  %arrayidx3 = getelementptr [8 x i8], ptr %1, i64 %iv
  %4 = load i64, ptr %arrayidx3, align 8
  %cmp4 = icmp eq i64 %4, 0
  br i1 %cmp4, label %for.inc, label %cleanup.loopexit

for.inc:
  %inc = add i64 %iv, 1
  %cmp.not = icmp ugt i64 %iv, %net
  br i1 %cmp.not, label %cleanup.loopexit, label %for.body

cleanup.loopexit:
  ret i64 0
}


