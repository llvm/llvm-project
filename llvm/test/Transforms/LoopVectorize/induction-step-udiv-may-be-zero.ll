; CHECK-NEXT:    [[COND:%.*]] = icmp ult i32 [[I]], [[N]]
; CHECK-NEXT:    br i1 [[COND]], label %[[BODY]], label %[[EXIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[Q:%.*]] = udiv i32 1, [[N]]
; CHECK-NEXT:    [[NEXT]] = add i32 [[ACC]], [[Q]]
; CHECK-NEXT:    [[INC]] = add i32 [[I]], 1
; CHECK-NEXT:    br label %[[LOOP]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ACC_LCSSA:%.*]] = phi i32 [ [[ACC]], %[[LOOP]] ]
; CHECK-NEXT:    ret i32 [[ACC_LCSSA]]
