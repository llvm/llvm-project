; CHECK-NEXT:    [[TMP32:%.*]] = load i32, ptr [[TMP26]], align 4
; CHECK-NEXT:    [[TMP33:%.*]] = load i32, ptr [[TMP28]], align 4
; CHECK-NEXT:    [[TMP34:%.*]] = load i32, ptr [[TMP30]], align 4
; CHECK-NEXT:    [[TMP35:%.*]] = insertelement <4 x i32> poison, i32 [[TMP31]], i32 0
