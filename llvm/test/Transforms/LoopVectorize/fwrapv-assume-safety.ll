; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @llvm.smax.i32(i32 [[U]], i32 [[TMP0]])
; CHECK-NEXT:    [[TMP2:%.*]] = sub i32 [[TMP1]], [[L]]
