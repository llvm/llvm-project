; Request a scalable VF without masked stores. Scalar bailout allows widening
; the store instead of falling back to a fixed VF.
define void @store_in_header(ptr noalias %a, ptr align 2 dereferenceable(40) %pred) {
; CHECK-LABEL: define void @store_in_header(
