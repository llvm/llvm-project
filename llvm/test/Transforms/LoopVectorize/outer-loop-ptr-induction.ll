  store i64 %outer.iv, ptr %inner.ptr, align 8
  %inner.ptr.next = getelementptr inbounds i64, ptr %inner.ptr, i64 1
  %inner.iv.next = add nuw nsw i64 %inner.iv, 1
  %inner.ec = icmp eq i64 %inner.iv.next, 8
