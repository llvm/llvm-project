; The pointer IV is used inside the inner loop, and the value of the pointer IV
; phi in the last iteration is used after the loop.
define ptr @ptr_iv_used_in_inner_and_live_out(ptr noalias %dst, ptr noalias %src, i64 %n) {
; CHECK-LABEL: define ptr @ptr_iv_used_in_inner_and_live_out(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[OUTER_IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[OUTER_IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[PTR_IV:%.*]] = phi ptr [ [[SRC]], %[[ENTRY]] ], [ [[PTR_IV_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[INNER_IV:%.*]] = phi i64 [ 0, %[[OUTER_HEADER]] ], [ [[INNER_IV_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i64 [ 0, %[[OUTER_HEADER]] ], [ [[SUM_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[GEP_SRC:%.*]] = getelementptr inbounds i64, ptr [[PTR_IV]], i64 [[INNER_IV]]
; CHECK-NEXT:    [[L:%.*]] = load i64, ptr [[GEP_SRC]], align 8
; CHECK-NEXT:    [[SUM_NEXT]] = add i64 [[SUM]], [[L]]
; CHECK-NEXT:    [[INNER_IV_NEXT]] = add nuw nsw i64 [[INNER_IV]], 1
; CHECK-NEXT:    [[INNER_EC:%.*]] = icmp eq i64 [[INNER_IV_NEXT]], 8
; CHECK-NEXT:    br i1 [[INNER_EC]], label %[[OUTER_LATCH]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[SUM_NEXT_LCSSA:%.*]] = phi i64 [ [[SUM_NEXT]], %[[INNER]] ]
; CHECK-NEXT:    [[GEP_DST:%.*]] = getelementptr inbounds i64, ptr [[DST]], i64 [[OUTER_IV]]
; CHECK-NEXT:    store i64 [[SUM_NEXT_LCSSA]], ptr [[GEP_DST]], align 8
; CHECK-NEXT:    [[PTR_IV_NEXT]] = getelementptr inbounds i64, ptr [[PTR_IV]], i64 8
; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw nsw i64 [[OUTER_IV]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i64 [[OUTER_IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER_HEADER]], !llvm.loop [[LOOP0]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[PTR_IV_LCSSA:%.*]] = phi ptr [ [[PTR_IV]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    ret ptr [[PTR_IV_LCSSA]]
;
entry:
  br label %outer.header

outer.header:
  %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
  %ptr.iv = phi ptr [ %src, %entry ], [ %ptr.iv.next, %outer.latch ]
  br label %inner

inner:
  %inner.iv = phi i64 [ 0, %outer.header ], [ %inner.iv.next, %inner ]
  %sum = phi i64 [ 0, %outer.header ], [ %sum.next, %inner ]
  %gep.src = getelementptr inbounds i64, ptr %ptr.iv, i64 %inner.iv
  %l = load i64, ptr %gep.src, align 8
  %sum.next = add i64 %sum, %l
  %inner.iv.next = add nuw nsw i64 %inner.iv, 1
  %inner.ec = icmp eq i64 %inner.iv.next, 8
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %gep.dst = getelementptr inbounds i64, ptr %dst, i64 %outer.iv
  store i64 %sum.next, ptr %gep.dst, align 8
  %ptr.iv.next = getelementptr inbounds i64, ptr %ptr.iv, i64 8
  %outer.iv.next = add nuw nsw i64 %outer.iv, 1
  %outer.ec = icmp eq i64 %outer.iv.next, %n
  br i1 %outer.ec, label %exit, label %outer.header, !llvm.loop !0

exit:
  %ptr.iv.lcssa = phi ptr [ %ptr.iv, %outer.latch ]
  ret ptr %ptr.iv.lcssa
}

