; CHECK-NEXT:    store <4 x i32> [[TMP0]], ptr [[TMP2]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i64, ptr [[B]], i64 [[INDEX]]
; CHECK-NEXT:    store <4 x i64> [[TMP1]], ptr [[TMP3]], align 8
