; CHECK-NEXT:    [[DONE:%.*]] = icmp uge i32 [[INC]], 64
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP6:![0-9]+]]
