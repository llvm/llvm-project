; CHECK:       "3":
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ 0, %"3.lr.ph" ], [ [[INDVARS_IV_NEXT:%.*]], %"3" ]
; CHECK-NEXT:    [[TMP2:%.*]] = shl nsw i64 [[INDVARS_IV]], 2
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i8, ptr [[ARR]], i64 [[TMP2]]
; CHECK-NEXT:    store float [[VALUE]], ptr [[TMP3]], align 4
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add i64 [[INDVARS_IV]], [[TMP1]]
; CHECK-NEXT:    [[TMP4:%.*]] = trunc i64 [[INDVARS_IV_NEXT]] to i32
; CHECK-NEXT:    [[TMP5:%.*]] = icmp slt i32 [[TMP4]], [[_N]]
