; The backedge-taken count of the outer loop is only computable assuming the
; narrow induction %outer.iv does not wrap. The vector loop must be guarded by
; a runtime check of that assumption.
; FIXME: The runtime check is missing.
define void @outer_loop_needs_scev_predicate(ptr %dst, i32 %n) {
; CHECK-LABEL: define void @outer_loop_needs_scev_predicate(
; CHECK-SAME: ptr [[DST:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.umax.i32(i32 [[N]], i32 1)
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i32 [[TMP0]], 4
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], [[SCALAR_PH:label %.*]], label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[TMP1:%.*]] = and i32 [[TMP0]], 3
; CHECK-NEXT:    [[N_VEC:%.*]] = sub i32 [[TMP0]], [[TMP1]]
; CHECK-NEXT:    [[TMP2:%.*]] = trunc i32 [[N_VEC]] to i16
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
;
entry:
  br label %outer.header

outer.header:
  %outer.iv = phi i16 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
  %outer.iv.ext = zext i16 %outer.iv to i64
  %gep = getelementptr inbounds i32, ptr %dst, i64 %outer.iv.ext
  br label %inner

inner:
  %iv = phi i64 [ 0, %outer.header ], [ %iv.next, %inner ]
  store i32 0, ptr %gep, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %inner.ec = icmp eq i64 %iv.next, 8
  br i1 %inner.ec, label %outer.latch, label %inner

outer.latch:
  %outer.iv.next = add i16 %outer.iv, 1
  %outer.iv.next.ext = zext i16 %outer.iv.next to i32
  %outer.ec = icmp ult i32 %outer.iv.next.ext, %n
  br i1 %outer.ec, label %outer.header, label %exit, !llvm.loop !0

exit:
  ret void
}

