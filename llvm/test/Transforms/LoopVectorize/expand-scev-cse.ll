entry:
  br label %outer

outer:
  %iv.outer = phi i64 [ %iv.outer.next, %outer.latch ], [ 0, %entry ]
  br label %inner0

inner0:
  %iv0 = phi i64 [ %iv0.next, %inner0 ], [ %iv.outer, %outer ]
  %p0 = getelementptr float, ptr %dst, i64 %iv0
  store float 1.000000e+00, ptr %p0, align 4
  %iv0.next = add nuw nsw i64 %iv0, 1
