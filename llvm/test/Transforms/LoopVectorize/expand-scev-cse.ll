  %iv1 = phi i64 [ %iv1.next, %inner1 ], [ %iv.outer, %inner0 ]
  %p1 = getelementptr float, ptr %dst, i64 %iv1
  store float 2.000000e+00, ptr %p1, align 4
  %iv1.next = add nuw nsw i64 %iv1, 1
