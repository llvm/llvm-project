  %gep.src = getelementptr inbounds float, ptr %src, i64 %iv
  %l = load float, ptr %gep.src, align 4
  %c = fcmp ogt float %l, 2.0
  br i1 %c, label %then, label %loop.latch

then:
  %mul = fmul fast float %red, %l
  br label %loop.latch

loop.latch:
