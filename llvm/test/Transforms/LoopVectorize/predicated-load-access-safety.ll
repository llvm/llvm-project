; CHECK-NEXT:    [[TMP30:%.*]] = load i32, ptr [[TMP7]], align 16
; CHECK-NEXT:    [[TMP31:%.*]] = insertelement <4 x i32> poison, i32 [[TMP27]], i64 0
; CHECK-NEXT:    [[TMP32:%.*]] = insertelement <4 x i32> [[TMP31]], i32 [[TMP28]], i64 1
