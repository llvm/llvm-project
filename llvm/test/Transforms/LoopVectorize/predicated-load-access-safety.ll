; Existing scalable accesses must not establish safety for predicated loads.
; The loop remains unvectorized because its vector-valued loads cannot be widened.
define void @scalable_accesses(ptr %src, ptr %dst, i64 %n) {
; CHECK-LABEL: define void @scalable_accesses(
; CHECK-SAME: ptr [[SRC:%.*]], ptr [[DST:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr <vscale x 2 x i64>, ptr [[SRC]], i64 [[IV]]
; CHECK-NEXT:    [[OUT:%.*]] = getelementptr <vscale x 2 x i64>, ptr [[DST]], i64 [[IV]]
; CHECK-NEXT:    [[WIDE:%.*]] = load <vscale x 2 x i64>, ptr [[P]], align 8
; CHECK-NEXT:    store <vscale x 2 x i64> [[WIDE]], ptr [[OUT]], align 8
; CHECK-NEXT:    [[GUARD:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[KEEP:%.*]] = icmp ne i32 [[GUARD]], 0
; CHECK-NEXT:    br i1 [[KEEP]], label %[[READ:.*]], label %[[LOOP_LATCH]]
; CHECK:       [[READ]]:
; CHECK-NEXT:    [[VALUE:%.*]] = load <vscale x 2 x i32>, ptr [[P]], align 4
; CHECK-NEXT:    store <vscale x 2 x i32> [[VALUE]], ptr [[OUT]], align 4
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i64 [[IV]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %p = getelementptr <vscale x 2 x i64>, ptr %src, i64 %iv
  %out = getelementptr <vscale x 2 x i64>, ptr %dst, i64 %iv
  %wide = load <vscale x 2 x i64>, ptr %p, align 8
  store <vscale x 2 x i64> %wide, ptr %out, align 8
  %guard = load i32, ptr %p, align 4
  %keep = icmp ne i32 %guard, 0
  br i1 %keep, label %read, label %loop.latch

read:
  %value = load <vscale x 2 x i32>, ptr %p, align 4
  store <vscale x 2 x i32> %value, ptr %out, align 4
  br label %loop.latch

loop.latch:
  %iv.next = add nuw i64 %iv, 1
  %done = icmp eq i64 %iv.next, %n
  br i1 %done, label %exit, label %loop.header

exit:
  ret void
}
