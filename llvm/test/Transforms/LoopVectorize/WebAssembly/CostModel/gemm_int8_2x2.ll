  %lhs1 = load i8, ptr %lhs1.ptr, align 1
  %lhs1.ext = sext i8 %lhs1 to i32
  %rhs1.ptr = getelementptr inbounds nuw i8, ptr %rhs.ptr, i32 1
  %rhs1 = load i8, ptr %rhs1.ptr, align 1
  %rhs1.ext = sext i8 %rhs1 to i32
  %mul1 = mul nsw i32 %rhs1.ext, %lhs1.ext
  %sum0.next = add nsw i32 %sum0.half, %mul1
  %lhs2.ptr = getelementptr inbounds nuw i8, ptr %lhs.ptr, i32 2
  %lhs2 = load i8, ptr %lhs2.ptr, align 1
  %lhs2.ext = sext i8 %lhs2 to i32
  %mul2 = mul nsw i32 %lhs2.ext, %rhs0.ext
  %sum1.half = add nsw i32 %mul2, %sum1
  %lhs3.ptr = getelementptr inbounds nuw i8, ptr %lhs.ptr, i32 3
  %lhs3 = load i8, ptr %lhs3.ptr, align 1
  %lhs3.ext = sext i8 %lhs3 to i32
  %mul3 = mul nsw i32 %lhs3.ext, %rhs1.ext
  %sum1.next = add nsw i32 %sum1.half, %mul3
  %rhs2.ptr = getelementptr inbounds nuw i8, ptr %rhs.ptr, i32 2
  %rhs2 = load i8, ptr %rhs2.ptr, align 1
  %rhs2.ext = sext i8 %rhs2 to i32
  %mul4 = mul nsw i32 %rhs2.ext, %lhs0.ext
  %sum2.half = add nsw i32 %mul4, %sum2
  %rhs3.ptr = getelementptr inbounds nuw i8, ptr %rhs.ptr, i32 3
  %rhs3 = load i8, ptr %rhs3.ptr, align 1
  %rhs3.ext = sext i8 %rhs3 to i32
  %mul5 = mul nsw i32 %rhs3.ext, %lhs1.ext
  %sum2.next = add nsw i32 %sum2.half, %mul5
  %mul6 = mul nsw i32 %rhs2.ext, %lhs2.ext
  %sum3.half = add nsw i32 %mul6, %sum3
  %mul7 = mul nsw i32 %rhs3.ext, %lhs3.ext
  %sum3.next = add nsw i32 %sum3.half, %mul7
  %lhs.next = getelementptr inbounds nuw i8, ptr %lhs.ptr, i32 4
  %rhs.next = getelementptr inbounds nuw i8, ptr %rhs.ptr, i32 4
