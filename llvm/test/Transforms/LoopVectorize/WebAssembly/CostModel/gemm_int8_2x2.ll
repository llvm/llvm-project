loop:
  %iv = phi i32 [ %iv.next, %loop ], [ 0, %entry ]
  %lhs.ptr = phi ptr [ %lhs.next, %loop ], [ %lhs, %entry ]
  %rhs.ptr = phi ptr [ %rhs.next, %loop ], [ %rhs, %entry ]
  %sum0 = phi i32 [ %sum0.next, %loop ], [ %acc0, %entry ]
  %sum1 = phi i32 [ %sum1.next, %loop ], [ %acc1, %entry ]
  %sum2 = phi i32 [ %sum2.next, %loop ], [ %acc2, %entry ]
  %sum3 = phi i32 [ %sum3.next, %loop ], [ %acc3, %entry ]
  %lhs0 = load i8, ptr %lhs.ptr, align 1
  %lhs0.ext = sext i8 %lhs0 to i32
  %rhs0 = load i8, ptr %rhs.ptr, align 1
  %rhs0.ext = sext i8 %rhs0 to i32
  %mul0 = mul nsw i32 %rhs0.ext, %lhs0.ext
  %sum0.half = add nsw i32 %mul0, %sum0
