; The select computing the final value of an any-of reduction.
define i32 @anyof_reduction(ptr %a, i64 %n) !prof !0 {
; CHECK-LABEL: define i32 @anyof_reduction(
; CHECK-SAME: ptr [[A:%.*]], i64 [[N:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK:  [[ENTRY:.*:]]
; CHECK:    br i1 [[MIN_ITERS_CHECK:%.*]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; CHECK:  [[VECTOR_PH]]:
; CHECK:  [[VECTOR_BODY:.*]]:
; CHECK:    br i1 [[TMP4:%.*]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP1:![0-9]+]]
; CHECK:  [[MIDDLE_BLOCK]]:
; CHECK:    [[RDX_SELECT:%.*]] = select i1 [[TMP6:%.*]], i32 1, i32 0
; CHECK:    br i1 [[CMP_N:%.*]], label %[[EXIT:.*]], label %[[SCALAR_PH]]
; CHECK:  [[SCALAR_PH]]:
; CHECK:  [[LOOP:.*]]:
; CHECK:    [[RES_NEXT:%.*]] = select i1 [[C:%.*]], i32 1, i32 [[RES:%.*]]
; CHECK:    br i1 [[EC:%.*]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP4:![0-9]+]]
; CHECK:  [[EXIT]]:
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %res = phi i32 [ 0, %entry ], [ %res.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %a, i64 %iv
  %l = load i32, ptr %gep, align 4
  %c = icmp eq i32 %l, 42
  %res.next = select i1 %c, i32 1, i32 %res
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret i32 %res.next
}

