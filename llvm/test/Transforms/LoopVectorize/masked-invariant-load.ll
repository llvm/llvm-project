; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[INV]], align 4
; CHECK-NEXT:    [[IDX:%.*]] = trunc i64 [[I]] to i32
; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[V]], [[IDX]]
