; Loop-invariant dbg_values in the loop body are kept in the vector loop.
define void @invariant_fragments(ptr noalias %out, i64 %left, i64 %right) !dbg !4 {
; CHECK-LABEL: define void @invariant_fragments(
; CHECK-SAME: ptr noalias [[OUT:%.*]], i64 [[LEFT:%.*]], i64 [[RIGHT:%.*]]) !dbg [[DBG3:![0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[MASK:%.*]] = or i64 [[LEFT]], [[RIGHT]], !dbg [[DBG6:![0-9]+]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]], !dbg [[DBG6]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[MASK]], i64 0
; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]], !dbg [[DBG6]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX1:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ], !dbg [[DBG7:![0-9]+]]
; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ <i64 0, i64 1, i64 2, i64 3>, %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:      #dbg_value(i64 [[MASK]], [[META8:![0-9]+]], !DIExpression(DW_OP_LLVM_fragment, 0, 64), [[DBG7]])
; CHECK-NEXT:      #dbg_value(i64 32, [[META8]], !DIExpression(DW_OP_LLVM_fragment, 64, 64), [[DBG7]])
; CHECK-NEXT:    [[TMP0:%.*]] = lshr <4 x i64> [[BROADCAST_SPLAT]], [[VEC_IND]], !dbg [[DBG7]]
; CHECK-NEXT:    [[TMP1:%.*]] = and <4 x i64> [[TMP0]], splat (i64 1), !dbg [[DBG7]]
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i64, ptr [[OUT]], i64 [[INDEX1]], !dbg [[DBG7]]
; CHECK-NEXT:    store <4 x i64> [[TMP1]], ptr [[TMP2]], align 8, !dbg [[DBG7]]
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX1]], 4, !dbg [[DBG7]]
; CHECK-NEXT:    [[VEC_IND_NEXT]] = add nuw nsw <4 x i64> [[VEC_IND]], splat (i64 4)
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq i64 [[INDEX_NEXT]], 32, !dbg [[DBG7]]
; CHECK-NEXT:    br i1 [[TMP3]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !dbg [[DBG7]], !llvm.loop [[LOOP11:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[EXIT:.*]], !dbg [[DBG7]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void, !dbg [[DBG7]]
;
entry:
  %mask = or i64 %left, %right, !dbg !10
  br label %loop, !dbg !10

loop:
  %index = phi i64 [ 0, %entry ], [ %next, %loop ]
    #dbg_value(i64 %mask, !8, !DIExpression(DW_OP_LLVM_fragment, 0, 64), !11)
    #dbg_value(i64 32, !8, !DIExpression(DW_OP_LLVM_fragment, 64, 64), !11)
  %shifted = lshr i64 %mask, %index, !dbg !11
  %bit = and i64 %shifted, 1, !dbg !11
  %element = getelementptr i64, ptr %out, i64 %index, !dbg !11
  store i64 %bit, ptr %element, align 8, !dbg !11
  %next = add nuw nsw i64 %index, 1, !dbg !11
  %again = icmp ult i64 %next, 32, !dbg !11
  br i1 %again, label %loop, label %exit, !dbg !11

exit:
  ret void, !dbg !11
}

