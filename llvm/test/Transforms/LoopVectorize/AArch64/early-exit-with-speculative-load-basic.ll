define i32 @masked_index_broadcast(ptr %a, i64 %n) {
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %add = add i64 %iv, %n
  %cmp = icmp ugt i64 %add, 0
  br i1 %cmp, label %loop.latch, label %body

body:
  %idx = and i64 %add, 4294967295
  %gep = getelementptr [8 x i8], ptr %a, i64 %idx
  %l = load i64, ptr %gep, align 8
  %c = icmp eq i64 %l, 0
  br i1 %c, label %loop.latch, label %early.exit

loop.latch:
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv, %n
  br i1 %ec, label %exit, label %loop.header

early.exit:
  ret i32 1

exit:
  ret i32 0
}

