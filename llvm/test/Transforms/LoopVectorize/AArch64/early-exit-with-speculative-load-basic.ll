exit:
  %res = phi i64 [ %iv, %loop.header ], [ -1, %loop.latch ]
  ret i64 %res
}

define ptr @address_live_out(ptr %p, i64 %n) {
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep = getelementptr i8, ptr %p, i64 %iv
  %l = load i8, ptr %gep, align 1
  %c = icmp eq i8 %l, 0
  br i1 %c, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
