  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %res = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %iv, i64 1)
  %sum = extractvalue { i64, i1 } %res, 0
