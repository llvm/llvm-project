  %res = call { i64, i1 } @llvm.umul.with.overflow.i64(i64 %iv, i64 2)
  %mul = extractvalue { i64, i1 } %res, 0
  %ov = extractvalue { i64, i1 } %res, 1
  %ov.ext = zext i1 %ov to i32
  %gep.b = getelementptr i32, ptr %b, i64 %iv
  store i32 %ov.ext, ptr %gep.b
  %gep.a.0 = getelementptr i32, ptr %a, i64 %mul
  %l.0 = load i32, ptr %gep.a.0
  %mul.1 = add i64 %mul, 1
  %gep.a.1 = getelementptr i32, ptr %a, i64 %mul.1
  %l.1 = load i32, ptr %gep.a.1
  %sum = add i32 %l.0, %l.1
  %gep.c = getelementptr i32, ptr %c, i64 %iv
  store i32 %sum, ptr %gep.c
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

