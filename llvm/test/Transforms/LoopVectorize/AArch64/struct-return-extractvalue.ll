loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %res = call { i64, i1 } @llvm.umul.with.overflow.i64(i64 %n, i64 3)
  %mul = extractvalue { i64, i1 } %res, 0
