entry:
  br label %for.body

for.body:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %for.inc ]
  %sum = phi i32 [ 0, %entry ], [ %sum.1, %for.inc ]
  %arrayidx = getelementptr inbounds nuw i8, ptr %cond, i64 %iv
  %c = load i8, ptr %arrayidx, align 1
  %tobool.not = icmp eq i8 %c, 0
  br i1 %tobool.not, label %for.inc, label %if.then

if.then:
  %arrayidx2 = getelementptr inbounds nuw i8, ptr %a, i64 %iv
  %load.a = load i8, ptr %arrayidx2, align 1
  %arrayidx4 = getelementptr inbounds nuw i8, ptr %b, i64 %iv
  %load.b = load i8, ptr %arrayidx4, align 1
  %ext.a = zext i8 %load.a to i32
  %ext.b = zext i8 %load.b to i32
  %mul = mul nuw nsw i32 %ext.a, %ext.b
  %add = add nsw i32 %sum, %mul
  br label %for.inc

for.inc:
  %sum.1 = phi i32 [ %add, %if.then ], [ %sum, %for.body ]
  %iv.next = add nuw nsw i64 %iv, 1
  %exitcond.not = icmp eq i64 %iv.next, %N
  br i1 %exitcond.not, label %exit, label %for.body

exit:
  ret i32 %sum.1
}

