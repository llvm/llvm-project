; CHECK-NEXT:    [[IV_TWICE:%.*]] = shl nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[A_IV:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV_TWICE]]
; CHECK-NEXT:    [[L1:%.*]] = load i32, ptr [[A_IV]], align 4
