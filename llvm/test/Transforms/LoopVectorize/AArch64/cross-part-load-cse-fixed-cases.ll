; The scalar loop has a separate latch, but VPlan places the matching loads in
; its single vector-loop block. The VPlan structural check therefore accepts
; the loop and the redundancy raises the interleave count to 2.
define void @multi_block(ptr noalias %a, ptr noalias %c, i64 %n) {
; CHECK-LABEL: define void @multi_block(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[C:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call i64 @llvm.smax.i64(i64 [[N]], i64 1)
