entry:
  br label %loop

loop:
  %iv = phi i64 [0, %entry], [%iv.next, %loop]
  %gep = getelementptr i64, ptr %b, i64 %iv
  %x = load i64, ptr %gep
  %r = call range(i64 0, 100) i64 @foo(i64 noundef range(i64 0, 50) %x) #0
  %a.gep = getelementptr i64, ptr %a, i64 %iv
  store i64 %r, ptr %a.gep
