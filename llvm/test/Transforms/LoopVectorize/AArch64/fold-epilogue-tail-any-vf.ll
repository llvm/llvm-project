; CHECK-NEXT:    [[TMP11:%.*]] = sub i32 [[ST]], [[INDEX]]
; CHECK-NEXT:    [[TMP12:%.*]] = getelementptr inbounds i32, ptr [[A]], i32 [[TMP11]]
; CHECK-NEXT:    [[TMP13:%.*]] = zext i32 [[TMP9]] to i64
