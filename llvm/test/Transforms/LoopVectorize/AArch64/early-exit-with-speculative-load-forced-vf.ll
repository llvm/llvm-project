; CHECK-NEXT:    [[TMP5:%.*]] = freeze <4 x i32> [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq <4 x i32> [[TMP5]], splat (i32 42)
; CHECK-NEXT:    [[TMP7:%.*]] = freeze <4 x i1> [[TMP6]]
