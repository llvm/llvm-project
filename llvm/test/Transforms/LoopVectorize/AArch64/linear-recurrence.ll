; CHECK-NEXT:    [[H1:%.*]] = phi i32 [ [[BC_MERGE_RDX]], %[[SCALAR_PH]] ], [ [[H_NEXT1:%.*]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr inbounds i32, ptr [[S]], i64 [[I]]
