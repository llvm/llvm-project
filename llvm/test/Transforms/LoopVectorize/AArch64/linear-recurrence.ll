; CHECK-NEXT:    [[MUL:%.*]] = mul <4 x i32> [[WIDE_LOAD]], <i32 29791, i32 961, i32 31, i32 1>
; CHECK-NEXT:    [[RDX:%.*]] = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> [[MUL]])
; CHECK-NEXT:    [[SCALED:%.*]] = mul i32 [[H]], 923521
; CHECK-NEXT:    [[H_NEXT]] = add i32 [[SCALED]], [[RDX]]
