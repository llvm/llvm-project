; CHECK-NEXT:    [[H:%.*]] = phi i32 [ 0, %[[VECTOR_PH]] ], [ [[H_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[S]], i64 [[INDEX]]
