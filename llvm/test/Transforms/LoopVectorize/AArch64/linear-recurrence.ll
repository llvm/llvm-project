; CHECK-NEXT:    [[H_NEXT1]] = add i32 [[LD]], [[MUL1]]
; CHECK-NEXT:    [[I_NEXT]] = add nsw i64 [[I]], 1
; CHECK-NEXT:    [[CMP1:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
