; CHECK-NEXT:    store double [[SIN0]], ptr [[TMP3]], align 8
; CHECK-NEXT:    [[SRC_1:%.*]] = getelementptr inbounds { double, double }, ptr [[SRC]], i64 [[IV]], i32 1
; CHECK-NEXT:    [[X1:%.*]] = load double, ptr [[SRC_1]], align 8
