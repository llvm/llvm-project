; RUN: opt -p loop-vectorize -mattr=+sve -S %s | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; A scalable VF cannot provide the power-of-2 byte count required by the
; @llvm.can.load.speculatively check, so a fixed VF is used.

define i64 @find_first_eq_const(ptr %A, i64 %n) {
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %gep.A = getelementptr inbounds i8, ptr %A, i64 %iv
  %ld.A = load i8, ptr %gep.A, align 1
  %cmp = icmp eq i8 %ld.A, 42
  br i1 %cmp, label %early.exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ne i64 %iv.next, %n
  br i1 %ec, label %loop.header, label %exit

early.exit:
  ret i64 %iv

exit:
  ret i64 -1
}

