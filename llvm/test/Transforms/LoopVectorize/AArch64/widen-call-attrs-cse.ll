; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s

target triple = "aarch64-unknown-linux-gnu"

; Identical widened calls in both branches are CSE'd. Only attributes present on
; both calls must be kept on the surviving call.
define void @cse_intersects_attrs(ptr noalias %src, ptr noalias %c, ptr noalias %out) {
; CHECK-LABEL: define void @cse_intersects_attrs(
; CHECK-SAME: ptr noalias [[SRC:%.*]], ptr noalias [[C:%.*]], ptr noalias [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[VECTOR_PH:.*]]
; CHECK:       [[VECTOR_PH]]:
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr float, ptr [[SRC]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x float>, ptr [[TMP0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i32, ptr [[C]], i64 [[INDEX]]
; CHECK-NEXT:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP1]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq <4 x i32> [[WIDE_LOAD1]], zeroinitializer
; CHECK-NEXT:    [[TMP3:%.*]] = call nofpclass(nan) <4 x float> @vec_sin(<4 x float> [[WIDE_LOAD]])
; CHECK-NEXT:    [[TMP4:%.*]] = fadd <4 x float> [[TMP3]], splat (float 1.000000e+00)
; CHECK-NEXT:    [[PREDPHI:%.*]] = select <4 x i1> [[TMP2]], <4 x float> [[TMP3]], <4 x float> [[TMP4]]
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr float, ptr [[OUT]], i64 [[INDEX]]
; CHECK-NEXT:    store <4 x float> [[PREDPHI]], ptr [[TMP5]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq i64 [[INDEX_NEXT]], 1024
; CHECK-NEXT:    br i1 [[TMP6]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %s.gep = getelementptr float, ptr %src, i64 %iv
  %x = load float, ptr %s.gep
  %c.gep = getelementptr i32, ptr %c, i64 %iv
  %cv = load i32, ptr %c.gep
  %cond = icmp eq i32 %cv, 0
  br i1 %cond, label %then, label %else

then:
  %s1 = call nofpclass(nan) float @llvm.sin.f32(float %x) #0
  br label %loop.latch

else:
  %s2 = call nofpclass(nan inf) float @llvm.sin.f32(float %x) #0
  %s2.add = fadd float %s2, 1.0
  br label %loop.latch

loop.latch:
  %res = phi float [ %s1, %then ], [ %s2.add, %else ]
  %o.gep = getelementptr float, ptr %out, i64 %iv
  store float %res, ptr %o.gep
  %iv.next = add i64 %iv, 1
  %done = icmp eq i64 %iv.next, 1024
  br i1 %done, label %exit, label %loop.header

exit:
  ret void
}

declare float @llvm.sin.f32(float)

declare <4 x float> @vec_sin(<4 x float>)

attributes #0 = { "vector-function-abi-variant"="_ZGV_LLVM_N4v_llvm.sin.f32(vec_sin)" }
