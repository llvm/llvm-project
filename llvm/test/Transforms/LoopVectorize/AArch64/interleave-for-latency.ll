entry:
  br label %loop

loop:
  %iv = phi i64 [ %iv.next, %loop ], [ 0, %entry ]
  %src0 = getelementptr inbounds nuw i16, ptr %src, i64 %iv
  %src1 = getelementptr inbounds nuw i16, ptr %src0, i64 1
  %val0 = load i16, ptr %src0, align 2
  %val1 = load i16, ptr %src1, align 2
  %add0 = add i16 %val0, %argval
  %add1 = add i16 %val1, %argval
  %dst0 = getelementptr inbounds nuw i16, ptr %dst, i64 %iv
  %dst1 = getelementptr inbounds nuw i16, ptr %dst0, i64 1
  store i16 %add0, ptr %dst0, align 2
  store i16 %add1, ptr %dst1, align 2
  %iv.next = add nuw i64 %iv, 2
  %cmp = icmp ult i64 %iv.next, 1024
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

