entry:
  br label %loop

loop:
  %iv = phi i64 [ %iv.next, %loop ], [ 0, %entry ]
  %src0 = getelementptr inbounds nuw i32, ptr %src, i64 %iv
  %src1 = getelementptr inbounds nuw i32, ptr %src0, i64 1
  %val0 = load i32, ptr %src0, align 4
  %val1 = load i32, ptr %src1, align 4
  %add0 = add i32 %val0, %argval
  %add1 = add i32 %val1, %argval
  %dst0 = getelementptr inbounds nuw i32, ptr %dst, i64 %iv
  %dst1 = getelementptr inbounds nuw i32, ptr %dst0, i64 1
  store i32 %add0, ptr %dst0, align 4
  store i32 %add1, ptr %dst1, align 4
  %iv.next = add nuw i64 %iv, 2
  %cmp = icmp ult i64 %iv.next, 1024
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
