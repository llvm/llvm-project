; CHECK-NEXT:    [[A_IV_PLUS_4:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV_PLUS_4]]
; CHECK-NEXT:    [[L2:%.*]] = load i32, ptr [[A_IV_PLUS_4]], align 4
; CHECK-NEXT:    [[IV_PLUS_8:%.*]] = add nuw nsw i64 [[IV]], 8
; CHECK-NEXT:    [[A_IV_PLUS_8:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IV_PLUS_8]]
; CHECK-NEXT:    [[L3:%.*]] = load i32, ptr [[A_IV_PLUS_8]], align 4
; CHECK-NEXT:    [[SUM_1:%.*]] = add i32 [[L1]], [[L2]]
