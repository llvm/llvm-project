; CHECK-NEXT:    [[TMP37:%.*]] = extractelement <4 x i16> [[TMP30]], i64 2
; CHECK-NEXT:    store i16 [[TMP37]], ptr [[TMP33]], align 4
; CHECK-NEXT:    [[TMP38:%.*]] = extractelement <4 x i16> [[TMP30]], i64 3
; CHECK-NEXT:    store i16 [[TMP38]], ptr [[TMP34]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
; CHECK-NEXT:    [[TMP39:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[TMP39]], label [[MIDDLE_BLOCK:%.*]], label [[VECTOR_BODY]], !llvm.loop [[LOOP6:![0-9]+]]
; CHECK:       middle.block:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], label [[EXIT_LOOPEXIT:%.*]], label [[SCALAR_PH]]
; CHECK:       scalar.ph:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], [[MIDDLE_BLOCK]] ], [ 0, [[PREHEADER]] ], [ 0, [[VECTOR_SCEVCHECK]] ]
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], [[SCALAR_PH]] ], [ [[NEXT:%.*]], [[MERGE:%.*]] ]
; CHECK-NEXT:    [[XP:%.*]] = getelementptr float, ptr [[XR]], i64 [[IV]]
; CHECK-NEXT:    [[X:%.*]] = load float, ptr [[XP]], align 4
; CHECK-NEXT:    [[KEEP:%.*]] = fcmp oge float [[X]], [[THRESHOLD]]
; CHECK-NEXT:    br i1 [[KEEP]], label [[READ:%.*]], label [[MERGE]]
; CHECK:       read:
; CHECK-NEXT:    [[LOAD_PTR:%.*]] = getelementptr i32, ptr [[IX]], i64 [[IV]]
; CHECK-NEXT:    [[OLD:%.*]] = load i32, ptr [[LOAD_PTR]], align 4
; CHECK-NEXT:    br label [[MERGE]]
; CHECK:       merge:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[OLD]], [[READ]] ], [ 0, [[LOOP]] ]
; CHECK-NEXT:    [[TRUNC:%.*]] = trunc i32 [[V]] to i16
; CHECK-NEXT:    [[STORE_PTR:%.*]] = getelementptr i32, ptr [[IX]], i64 [[IV]]
; CHECK-NEXT:    store i16 [[TRUNC]], ptr [[STORE_PTR]], align 4
; CHECK-NEXT:    [[NEXT]] = add nuw i64 [[IV]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label [[EXIT_LOOPEXIT]], label [[LOOP]], !llvm.loop [[LOOP7:![0-9]+]]
; CHECK:       exit.loopexit:
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %empty = icmp eq i64 %n, 0
  br i1 %empty, label %exit, label %preheader
preheader:
  br label %loop
loop:
  %iv = phi i64 [ 0, %preheader ], [ %next, %merge ]
  %xp = getelementptr float, ptr %xr, i64 %iv
  %x = load float, ptr %xp, align 4
  %keep = fcmp oge float %x, %threshold
  br i1 %keep, label %read, label %merge
read:
  %load.ptr = getelementptr i32, ptr %ix, i64 %iv
  %old = load i32, ptr %load.ptr, align 4
  br label %merge
merge:
  %v = phi i32 [ %old, %read ], [ 0, %loop ]
  %trunc = trunc i32 %v to i16
  %store.ptr = getelementptr i32, ptr %ix, i64 %iv
  store i16 %trunc, ptr %store.ptr, align 4
  %next = add nuw i64 %iv, 1
  %done = icmp eq i64 %next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

