; CHECK-NEXT:    [[LFLAGS:%.*]] = load i32, ptr [[GFLAGS]], align 4
; CHECK-NEXT:    [[CFLAGS:%.*]] = icmp ne i32 [[LFLAGS]], 0
; CHECK-NEXT:    br i1 [[CFLAGS]], label %[[GUARDED:.*]], label %[[MERGE:.*]]
; CHECK:       [[GUARDED]]:
; CHECK-NEXT:    [[GB:%.*]] = getelementptr inbounds [1024 x i32], ptr @GB, i64 0, i64 [[IV]]
; CHECK-NEXT:    [[LB:%.*]] = load i32, ptr [[GB]], align 4
; CHECK-NEXT:    [[SUM:%.*]] = add nsw i32 [[LB]], 1
; CHECK-NEXT:    [[GA:%.*]] = getelementptr inbounds [1024 x i32], ptr @GA, i64 0, i64 [[IV]]
; CHECK-NEXT:    store i32 [[SUM]], ptr [[GA]], align 4
; CHECK-NEXT:    br label %[[MERGE]]
