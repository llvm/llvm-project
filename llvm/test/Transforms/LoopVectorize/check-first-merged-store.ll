; RUN: opt -S < %s -p loop-vectorize -force-vector-width=4 -enable-check-first-early-exit-vectorization | FileCheck %s

@GA = global [1024 x i32] zeroinitializer
@GB = global [1024 x i32] zeroinitializer
@Gflags = global [1024 x i32] zeroinitializer
