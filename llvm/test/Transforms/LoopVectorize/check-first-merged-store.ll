; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[IV_NEXT]], 1024
; CHECK-NEXT:    br i1 [[DONE]], label %[[RET_LOOPEXIT:.*]], label %[[FOR_BODY]]
