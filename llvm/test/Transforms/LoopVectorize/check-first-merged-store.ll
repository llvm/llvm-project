entry:
  br label %for.body

for.body:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %gflags = getelementptr inbounds [1024 x i32], ptr @Gflags, i64 0, i64 %iv
  %lflags = load i32, ptr %gflags, align 4
  %cflags = icmp ne i32 %lflags, 0
  br i1 %cflags, label %guarded, label %merge

guarded:                                          ; 1 predecessor: for.body
  %gb = getelementptr inbounds [1024 x i32], ptr @GB, i64 0, i64 %iv
  %lb = load i32, ptr %gb, align 4
  %sum = add nsw i32 %lb, 1
  %ga = getelementptr inbounds [1024 x i32], ptr @GA, i64 0, i64 %iv
  store i32 %sum, ptr %ga, align 4
