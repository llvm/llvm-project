entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %end = add nsw i64 %i, %M
  br label %inner.body

inner.body:
  %j = phi i64 [ %i, %outer.header ], [ %j.next, %inner.body ]
  %s = phi float [ 0.000000e+00, %outer.header ], [ %s.next, %inner.body ]
  %B.ptr = getelementptr inbounds float, ptr %B, i64 %j
  %B.val = load float, ptr %B.ptr, align 4
  %s.next = fadd float %s, %B.val
  %j.next = add nsw i64 %j, 1
  %j.cmp = icmp eq i64 %j.next, %end
