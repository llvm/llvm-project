entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %rdx = phi i32 [ 1, %entry ], [ %rdx.next, %loop ]
  %gep = getelementptr i32, ptr %p, i32 %iv
  %x = load i32, ptr %gep
  %c = icmp eq i32 %x, 0
  %rdx.next = select i1 %c, i32 1, i32 %rdx
  %iv.next = add i32 %iv, 1
  %ec = icmp eq i32 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  %ret = phi i32 [ %rdx.next, %loop ]
  ret i32 %ret
