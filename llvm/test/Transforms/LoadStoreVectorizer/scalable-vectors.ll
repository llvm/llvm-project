; RUN: opt -S -passes=load-store-vectorizer %s | FileCheck %s

; Loads and stores of scalable vectors are skipped instead of crashing.

define <vscale x 4 x i32> @load_scalable(ptr %p) {
; CHECK-LABEL: define <vscale x 4 x i32> @load_scalable(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[RES:%.*]] = load <vscale x 4 x i32>, ptr [[P]], align 16
; CHECK-NEXT:    ret <vscale x 4 x i32> [[RES]]
;
  %res = load <vscale x 4 x i32>, ptr %p, align 16
  ret <vscale x 4 x i32> %res
}

define void @store_scalable(ptr %p, <vscale x 4 x i32> %v) {
; CHECK-LABEL: define void @store_scalable(
; CHECK-SAME: ptr [[P:%.*]], <vscale x 4 x i32> [[V:%.*]]) {
; CHECK-NEXT:    store <vscale x 4 x i32> [[V]], ptr [[P]], align 16
; CHECK-NEXT:    ret void
;
  store <vscale x 4 x i32> %v, ptr %p, align 16
  ret void
}

; The fixed-width loads are still vectorized.
define <vscale x 4 x i32> @load_scalable_and_fixed(ptr %p, ptr %q) {
; CHECK-LABEL: define <vscale x 4 x i32> @load_scalable_and_fixed(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x i32>, ptr [[P]], align 8
; CHECK-NEXT:    [[A1:%.*]] = extractelement <2 x i32> [[TMP1]], i64 0
; CHECK-NEXT:    [[B2:%.*]] = extractelement <2 x i32> [[TMP1]], i64 1
; CHECK-NEXT:    [[S:%.*]] = load <vscale x 4 x i32>, ptr [[P]], align 16
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x i32> poison, i32 [[A1]], i64 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <2 x i32> [[TMP2]], i32 [[B2]], i64 1
; CHECK-NEXT:    store <2 x i32> [[TMP3]], ptr [[Q]], align 8
; CHECK-NEXT:    ret <vscale x 4 x i32> [[S]]
;
  %p1 = getelementptr i32, ptr %p, i64 1
  %a = load i32, ptr %p, align 8
  %s = load <vscale x 4 x i32>, ptr %p, align 16
  %b = load i32, ptr %p1, align 4
  store i32 %a, ptr %q, align 8
  %q1 = getelementptr i32, ptr %q, i64 1
  store i32 %b, ptr %q1
  ret <vscale x 4 x i32> %s
}
