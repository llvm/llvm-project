; SCEV reports the index difference modulo the narrow pre-extension width. The
; first no-wrap proof accepts that difference whenever it is signed-less-equal
; than OpB's constant operand, which does not establish that extending the two
; indices preserves the difference.

; The nuw add is defined only when %idx is zero, so the zero-extended indices
; differ by 255 and the accesses are 1020 bytes apart. The narrow difference has
; the bit pattern of -1, and reading it as signed makes them look adjacent.
define i32 @zext_difference_not_preserved(ptr %base, i32 %x, i32 %y) {
; CHECK-LABEL: define i32 @zext_difference_not_preserved(
; CHECK-SAME: ptr [[BASE:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[MUL:%.*]] = shl i32 [[Y]], 1
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[MUL]], [[X]]
; CHECK-NEXT:    [[IDX:%.*]] = trunc i32 [[SUM]] to i8
; CHECK-NEXT:    [[NEXT:%.*]] = add nuw i8 [[IDX]], -1
; CHECK-NEXT:    [[EXTB:%.*]] = zext i8 [[IDX]] to i64
; CHECK-NEXT:    [[EXTB1:%.*]] = zext i8 [[NEXT]] to i64
; CHECK-NEXT:    [[PB:%.*]] = getelementptr i32, ptr [[BASE]], i64 [[EXTB]]
; CHECK-NEXT:    [[PB1:%.*]] = getelementptr i32, ptr [[BASE]], i64 [[EXTB1]]
; CHECK-NEXT:    [[VA2:%.*]] = load i32, ptr [[PB]], align 4
; CHECK-NEXT:    [[VB1:%.*]] = load i32, ptr [[PB1]], align 8
; CHECK-NEXT:    [[R:%.*]] = add i32 [[VA2]], [[VB1]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %mul = shl i32 %y, 1
  %sum = add i32 %mul, %x
  %idx = trunc i32 %sum to i8
  %next = add nuw i8 %idx, -1
  %exta = zext i8 %idx to i64
  %extb = zext i8 %next to i64
  %pa = getelementptr i32, ptr %base, i64 %exta
  %pb = getelementptr i32, ptr %base, i64 %extb
  %va = load i32, ptr %pa, align 4
  %vb = load i32, ptr %pb, align 8
  %r = add i32 %va, %vb
  ret i32 %r
}

