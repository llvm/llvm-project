; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; The invariant this file protects: a pointer is never recovered out of a byte
; lane. --implicit-check-not enforces that over the whole output, in addition
; to the autogenerated per-function assertions.
; RUN: opt -passes=load-store-vectorizer -S < %s | FileCheck %s \
; RUN:   --implicit-check-not="bitcast <{{[0-9]+}} x b{{[0-9]+}}> {{.*}} to ptr" \
; RUN:   --implicit-check-not="bitcast b{{[0-9]+}} {{.*}} to ptr"

target datalayout = "e-p:64:64-p3:32:32"

; A chain that would be given a byte-typed lane must not also contain a
; pointer, because recovering the pointer needs a `bitcast <N x bM> to ptr`
; which codegen does not yet handle. Such a chain is regrouped by scalar size
; instead, with pointers kept apart.

; Mixed chain containing a pointer: no b<N> lane is formed, but the two
; same-sized non-pointer elements still vectorize together.
define void @mixed_with_ptr(ptr align 32 %p) {
; CHECK-LABEL: define void @mixed_with_ptr(
; CHECK-SAME: ptr align 32 [[P:%.*]]) {
; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr [[P]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i32>, ptr [[G0]], align 32
; CHECK-NEXT:    [[A1:%.*]] = shufflevector <4 x i32> [[TMP1]], <4 x i32> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <2 x i32> [[A1]] to i64
; CHECK-NEXT:    [[TMP3:%.*]] = inttoptr i64 [[TMP2]] to ptr
; CHECK-NEXT:    [[B2:%.*]] = extractelement <4 x i32> [[TMP1]], i32 2
; CHECK-NEXT:    [[C3:%.*]] = extractelement <4 x i32> [[TMP1]], i32 3
; CHECK-NEXT:    [[TMP4:%.*]] = bitcast i32 [[C3]] to float
; CHECK-NEXT:    ret void
;
  %g0 = getelementptr i8, ptr %p, i64 0
  %g8 = getelementptr i8, ptr %p, i64 8
  %g12 = getelementptr i8, ptr %p, i64 12
  %a = load ptr, ptr %g0, align 32
  %b = load i32, ptr %g8, align 8
  %c = load float, ptr %g12, align 4
  ret void
}

; Pointer first: the guard must trigger regardless of where the pointer sits.
define void @ptr_first(ptr align 32 %p) {
; CHECK-LABEL: define void @ptr_first(
; CHECK-SAME: ptr align 32 [[P:%.*]]) {
; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr [[P]], i64 0
; CHECK-NEXT:    [[G8:%.*]] = getelementptr i8, ptr [[P]], i64 8
; CHECK-NEXT:    [[A:%.*]] = load ptr, ptr [[G0]], align 32
; CHECK-NEXT:    [[B:%.*]] = load i16, ptr [[G8]], align 8
; CHECK-NEXT:    ret void
;
  %g0 = getelementptr i8, ptr %p, i64 0
  %g8 = getelementptr i8, ptr %p, i64 8
  %a = load ptr, ptr %g0, align 32
  %b = load i16, ptr %g8, align 8
  ret void
}

; Pointers of different address spaces are themselves a mixed chain: they must
; not be merged through byte lanes either.
define void @mixed_ptr_addrspaces(ptr addrspace(3) align 32 %p) {
; CHECK-LABEL: define void @mixed_ptr_addrspaces(
; CHECK-SAME: ptr addrspace(3) align 32 [[P:%.*]]) {
; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr addrspace(3) [[P]], i64 0
; CHECK-NEXT:    [[G8:%.*]] = getelementptr i8, ptr addrspace(3) [[P]], i64 8
; CHECK-NEXT:    [[A:%.*]] = load ptr addrspace(3), ptr addrspace(3) [[G0]], align 32
; CHECK-NEXT:    [[B:%.*]] = load ptr, ptr addrspace(3) [[G8]], align 8
; CHECK-NEXT:    ret void
;
  %g0 = getelementptr i8, ptr addrspace(3) %p, i64 0
  %g8 = getelementptr i8, ptr addrspace(3) %p, i64 8
  %a = load ptr addrspace(3), ptr addrspace(3) %g0, align 32
  %b = load ptr, ptr addrspace(3) %g8, align 8
  ret void
}

; POSITIVE CONTROL: a homogeneous pointer chain keeps `ptr` as its element
; type and must still vectorize.
define void @homogeneous_ptr(ptr align 32 %p) {
; CHECK-LABEL: define void @homogeneous_ptr(
; CHECK-SAME: ptr align 32 [[P:%.*]]) {
; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr [[P]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x ptr>, ptr [[G0]], align 32
; CHECK-NEXT:    [[A1:%.*]] = extractelement <2 x ptr> [[TMP1]], i32 0
; CHECK-NEXT:    [[B2:%.*]] = extractelement <2 x ptr> [[TMP1]], i32 1
; CHECK-NEXT:    ret void
;
  %g0 = getelementptr i8, ptr %p, i64 0
  %g8 = getelementptr i8, ptr %p, i64 8
  %a = load ptr, ptr %g0, align 32
  %b = load ptr, ptr %g8, align 8
  ret void
}

; POSITIVE CONTROL: a mixed chain with no pointer still gets byte lanes, so
; the guard has not disabled mixed-type vectorization generally.
define void @mixed_no_ptr(ptr align 32 %p) {
; CHECK-LABEL: define void @mixed_no_ptr(
; CHECK-SAME: ptr align 32 [[P:%.*]]) {
; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr [[P]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x b16>, ptr [[G0]], align 32
; CHECK-NEXT:    [[A1:%.*]] = shufflevector <4 x b16> [[TMP1]], <4 x b16> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    [[TMP2:%.*]] = bitcast <2 x b16> [[A1]] to i32
; CHECK-NEXT:    [[B2:%.*]] = shufflevector <4 x b16> [[TMP1]], <4 x b16> poison, <2 x i32> <i32 2, i32 3>
; CHECK-NEXT:    [[TMP3:%.*]] = bitcast <2 x b16> [[B2]] to <2 x i16>
; CHECK-NEXT:    ret void
;
  %g0 = getelementptr i8, ptr %p, i64 0
  %g4 = getelementptr i8, ptr %p, i64 4
  %a = load i32, ptr %g0, align 32
  %b = load <2 x i16>, ptr %g4, align 4
  ret void
}
