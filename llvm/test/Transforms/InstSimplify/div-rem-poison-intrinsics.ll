; CHECK-NEXT:    ret i8 poison
;
  %r = call i8 @llvm.urem.poison.i8(i8 %x, i8 poison)
  ret i8 %r
}

; A divisor that is zero in every lane makes every lane of the result poison.
; Unlike the div/rem instructions this is not undefined behavior, so the
; dividend does not have to be a constant.

define i8 @zero_divisor(i8 %x) {
; CHECK-LABEL: @zero_divisor(
; CHECK-NEXT:    ret i8 poison
;
  %r = call i8 @llvm.sdiv.poison.i8(i8 %x, i8 0)
  ret i8 %r
}

define <4 x i32> @zero_divisor_splat(<4 x i32> %x) {
; CHECK-LABEL: @zero_divisor_splat(
; CHECK-NEXT:    ret <4 x i32> poison
;
  %r = call <4 x i32> @llvm.sdiv.poison.v4i32(<4 x i32> %x, <4 x i32> zeroinitializer)
  ret <4 x i32> %r
}

define <4 x i32> @zero_divisor_all_lanes_zero_or_poison(<4 x i32> %x) {
