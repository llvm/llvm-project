; A poison operand makes the result poison.

define i8 @poison_dividend(i8 %x) {
; CHECK-LABEL: @poison_dividend(
; CHECK-NEXT:    ret i8 poison
;
  %r = call i8 @llvm.sdiv.poison.i8(i8 poison, i8 %x)
