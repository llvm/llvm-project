; Constant folding of the div/rem intrinsics that yield poison instead of
; undefined behavior.

declare i13 @llvm.sdiv.poison.i13(i13, i13)
declare i32 @llvm.sdiv.poison.i32(i32, i32)
declare i32 @llvm.udiv.poison.i32(i32, i32)
declare i32 @llvm.srem.poison.i32(i32, i32)
declare i32 @llvm.urem.poison.i32(i32, i32)
declare <4 x i32> @llvm.sdiv.poison.v4i32(<4 x i32>, <4 x i32>)
declare <4 x i32> @llvm.urem.poison.v4i32(<4 x i32>, <4 x i32>)
declare <4 x i64> @llvm.srem.poison.v4i64(<4 x i64>, <4 x i64>)

define i32 @sdiv(i32 %x) {
; CHECK-LABEL: @sdiv(
; CHECK-NEXT:    ret i32 -3
;
  %r = call i32 @llvm.sdiv.poison.i32(i32 7, i32 -2)
  ret i32 %r
}

define i32 @sdiv_min_by_one(i32 %x) {
; CHECK-LABEL: @sdiv_min_by_one(
; CHECK-NEXT:    ret i32 -2147483648
;
  %r = call i32 @llvm.sdiv.poison.i32(i32 -2147483648, i32 1)
  ret i32 %r
}

; INT_MIN / -1 is poison rather than undefined behavior.

define i32 @sdiv_min_div_minus_one(i32 %x) {
; CHECK-LABEL: @sdiv_min_div_minus_one(
; CHECK-NEXT:    ret i32 poison
;
  %r = call i32 @llvm.sdiv.poison.i32(i32 -2147483648, i32 -1)
  ret i32 %r
}

; Division by zero is poison rather than undefined behavior.

define i32 @sdiv_by_zero(i32 %x) {
; CHECK-LABEL: @sdiv_by_zero(
; CHECK-NEXT:    ret i32 poison
;
  %r = call i32 @llvm.sdiv.poison.i32(i32 5, i32 0)
  ret i32 %r
}

