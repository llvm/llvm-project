define i32 @udiv_by_zero(i32 %x) {
; CHECK-LABEL: @udiv_by_zero(
; CHECK-NEXT:    ret i32 poison
;
  %r = call i32 @llvm.udiv.poison.i32(i32 5, i32 0)
