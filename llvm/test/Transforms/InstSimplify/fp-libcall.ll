; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=instsimplify < %s -S | FileCheck %s

; Check that the known floating-point classes of a libcall with an equivalent
; intrinsic reach the fcmp folds. Libcall availability is target specific, so
; these tests use an explicit triple. instsimplify does not replace a libcall
; with its intrinsic, so these only pass if the libcall itself is recognized.
;
; Libcalls sorted alphabetically

target triple = "x86_64-unknown-linux-gnu"

declare float @coshf(float)
declare float @expf(float)
declare float @fabsf(float)
declare float @powf(float, float)
declare float @sqrtf(float)

define i1 @coshf_ole_zero(float %x) {
; CHECK-LABEL: define i1 @coshf_ole_zero(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @coshf(float [[X]])
; CHECK-NEXT:    ret i1 false
;
  %call = call float @coshf(float %x)
  %cmp = fcmp ole float %call, 0.0
  ret i1 %cmp
}

define i1 @expf_uno__no_nan(float nofpclass(nan) %x) {
; CHECK-LABEL: define i1 @expf_uno__no_nan(
; CHECK-SAME: float nofpclass(nan) [[X:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @expf(float [[X]])
; CHECK-NEXT:    ret i1 false
;
  %call = call float @expf(float %x)
  %cmp = fcmp uno float %call, 0.0
  ret i1 %cmp
}

define i1 @fabsf_uge_zero(float %x) {
; CHECK-LABEL: define i1 @fabsf_uge_zero(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @fabsf(float [[X]])
; CHECK-NEXT:    ret i1 true
;
  %call = call float @fabsf(float %x)
  %cmp = fcmp uge float %call, 0.0
  ret i1 %cmp
}

define i1 @sqrtf_olt_zero(float %x) {
; CHECK-LABEL: define i1 @sqrtf_olt_zero(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @sqrtf(float [[X]])
; CHECK-NEXT:    ret i1 false
;
  %call = call float @sqrtf(float %x)
  %cmp = fcmp olt float %call, 0.0
  ret i1 %cmp
}

; Negative test: sqrt(x) can be NaN if x can be a non-zero negative.
define i1 @sqrtf_uno__no_nan_inf(float nofpclass(nan inf) %x) {
; CHECK-LABEL: define i1 @sqrtf_uno__no_nan_inf(
; CHECK-SAME: float nofpclass(nan inf) [[X:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @sqrtf(float [[X]])
; CHECK-NEXT:    [[CMP:%.*]] = fcmp uno float [[CALL]], 0.000000e+00
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %call = call float @sqrtf(float %x)
  %cmp = fcmp uno float %call, 0.0
  ret i1 %cmp
}

define i1 @powf_uge_zero__non_negative(float nofpclass(inf nzero nsub nnorm) %x, float nofpclass(inf nzero nsub nnorm) %y) {
; CHECK-LABEL: define i1 @powf_uge_zero__non_negative(
; CHECK-SAME: float nofpclass(inf nzero nsub nnorm) [[X:%.*]], float nofpclass(inf nzero nsub nnorm) [[Y:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @powf(float [[X]], float [[Y]])
; CHECK-NEXT:    ret i1 true
;
  %call = call float @powf(float %x, float %y)
  %cmp = fcmp uge float %call, 0.0
  ret i1 %cmp
}
