; Composing the binary operator's ranges, the range of the result is [-5, 50].
; The result straddles zero, which known bits cannot describe.

define i1 @range_mul(i32 range(i32 -1, 11) %x) {
; CHECK-LABEL: define i1 @range_mul(
; CHECK-SAME: i32 range(i32 -1, 11) [[X:%.*]]) {
; CHECK-NEXT:    ret i1 true
;
  %m = mul i32 %x, 5
  %c = icmp slt i32 %m, 51
  ret i1 %c
}

