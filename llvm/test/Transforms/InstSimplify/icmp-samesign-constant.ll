; A samesign compare with a constant RHS is poison unless the LHS has the same
; sign as the constant, so it folds when the compare is tautological over that
; half of the range.

define i1 @sge_zero(i8 %x) {
; CHECK-LABEL: define i1 @sge_zero(
; CHECK-SAME: i8 [[X:%.*]]) {
; CHECK-NEXT:    ret i1 true
;
  %cmp = icmp samesign sge i8 %x, 0
  ret i1 %cmp
}

