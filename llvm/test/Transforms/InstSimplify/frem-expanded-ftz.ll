; Check that the denormal flushing behaviour of constant folding of FRem
; matches the denorm-flushing behaviour of the ExpandIRInsts frem expansions.
; The cases for regular inputs (non-NaN, non-zero, non-infinite) are:
;  1: |X_FTZ| <  |Y_FTZ| --> return un-flushed X
;  2: |X_FTZ| == |Y_FTZ| --> return 0.0 with the same sign as X
;  3: |X_FTZ| >  |Y_FTZ| --> compute the remainder and flush denormal output
; Comparisons use input-flushed values, but case 1 returns the original X.
;
; Also check that the afn version correctly mimics the precision and denormal
; behaviour of the ExpandIRInsts afn FRem expansion fma(-trunc(X / Y), Y, X)
; rather than the more precise one.

; A small dividend bypasses arithmetic and retains its original subnormal value.
define float @preservesign_small() denormal_fpenv(float: preservesign) {
; CHECK-LABEL: define float @preservesign_small(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    ret float -1.401300e-45
;
  %r = frem float f0x80000001, 2.0
  ret float %r
}

; A subnormal divisor flushed to zero produces NaN.
define float @preservesign_subnormal_divisor() denormal_fpenv(float: preservesign) {
; CHECK-LABEL: define float @preservesign_subnormal_divisor(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    ret float +qnan
;
  %r = frem float f0x00800000, f0x00400000
  ret float %r
}

; Both inputs flush to zero, so the zero-divisor case overrides equal magnitudes.
define float @preservesign_both_subnormal() denormal_fpenv(float: preservesign) {
; CHECK-LABEL: define float @preservesign_both_subnormal(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    ret float +qnan
;
  %r = frem float f0x00000001, f0x00000002
  ret float %r
}

; The afn expansion has no dividend bypass, so the subnormal input is flushed.
define float @preservesign_approx() denormal_fpenv(float: preservesign) {
; CHECK-LABEL: define float @preservesign_approx(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    ret float 0.000000e+00
;
  %r = frem afn float f0x80000001, 2.0
  ret float %r
}

