; https://github.com/llvm/llvm-project/issues/231089
; The offset is at most 3, so end > 4 implies size > 1, including for a
; wrapping add without nuw or nsw.
define i1 @bounded_addend(i32 noundef %address, i32 noundef %size) {
; CHECK-LABEL: @bounded_addend(
; CHECK-NEXT:    [[OFFSET:%.*]] = and i32 [[ADDRESS:%.*]], 3
; CHECK-NEXT:    [[END:%.*]] = add i32 [[OFFSET]], [[SIZE:%.*]]
; CHECK-NEXT:    [[CROSSES_WORD:%.*]] = icmp ugt i32 [[END]], 4
; CHECK-NEXT:    ret i1 [[CROSSES_WORD]]
;
  %offset = and i32 %address, 3
  %end = add i32 %offset, %size
  %crosses_word = icmp ugt i32 %end, 4
  %large_enough = icmp ugt i32 %size, 1
  %both = and i1 %crosses_word, %large_enough
  ret i1 %both
}

