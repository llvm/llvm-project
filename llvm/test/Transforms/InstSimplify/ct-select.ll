; Negative test: must NOT fold when the condition operand is not a constant.
; InstSimplify deliberately does not run value analyses (known-bits, range) on
; the condition to derive a fold, so a plain runtime %c keeps the ct.select.
define i32 @ct_select_runtime_cond_no_fold(i1 %c, i32 %x, i32 %y) {
; CHECK-LABEL: @ct_select_runtime_cond_no_fold(
; CHECK-NEXT:    [[R:%.*]] = call i32 @llvm.ct.select.i32(i1 [[C:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]])
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @llvm.ct.select.i32(i1 %c, i32 %x, i32 %y)
  ret i32 %r
}

