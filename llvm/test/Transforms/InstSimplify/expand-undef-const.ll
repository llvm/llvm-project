; Keep the use block before the defs block so InstSimplify visits the final and
; before folding its operands. The result must be -2, not -1.
define i8 @and_or_xor_undef_constant_mask() {
; CHECK-LABEL: define i8 @and_or_xor_undef_constant_mask() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[DEFS:.*]]
