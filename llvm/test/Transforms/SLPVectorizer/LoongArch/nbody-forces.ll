; RUN: opt < %s -passes=slp-vectorizer -S -mtriple=loongarch64 -mattr=+lsx | FileCheck %s

;; Reduced from the rustc-perf nbody runtime benchmark. The {x, y} lanes of the
;; force accumulation are vectorized; f and d are scalars splatted with a
;; single vreplvei, and lane 0 of the {dx*dx, dy*dy} vector is extracted for
;; free.

define void @forces(ptr noalias %out, ptr noalias %p, double %gm, ptr noalias %pos, ptr noalias %mass, i64 %n) {
; CHECK-LABEL: define void @forces(
; CHECK-SAME: ptr noalias [[OUT:%.*]], ptr noalias [[P:%.*]], double [[GM:%.*]], ptr noalias [[POS:%.*]], ptr noalias [[MASS:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x double>, ptr [[P]], align 8
; CHECK-NEXT:    [[P_Z:%.*]] = getelementptr inbounds nuw i8, ptr [[P]], i64 16
; CHECK-NEXT:    [[PZ:%.*]] = load double, ptr [[P_Z]], align 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[FZ:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[FZ_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = phi <2 x double> [ zeroinitializer, %[[ENTRY]] ], [ [[TMP13:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds nuw [24 x i8], ptr [[POS]], i64 [[I]]
; CHECK-NEXT:    [[MP:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[MASS]], i64 [[I]]
; CHECK-NEXT:    [[M:%.*]] = load double, ptr [[MP]], align 8
; CHECK-NEXT:    [[Q_Z:%.*]] = getelementptr inbounds nuw i8, ptr [[Q]], i64 16
; CHECK-NEXT:    [[QZ:%.*]] = load double, ptr [[Q_Z]], align 8
; CHECK-NEXT:    [[DZ:%.*]] = fsub double [[PZ]], [[QZ]]
; CHECK-NEXT:    [[DZ2:%.*]] = fmul double [[DZ]], [[DZ]]
; CHECK-NEXT:    [[GMM:%.*]] = fmul double [[GM]], [[M]]
; CHECK-NEXT:    [[TMP2:%.*]] = load <2 x double>, ptr [[Q]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = fsub <2 x double> [[TMP0]], [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = fmul <2 x double> [[TMP3]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = extractelement <2 x double> [[TMP4]], i64 0
; CHECK-NEXT:    [[TMP6:%.*]] = extractelement <2 x double> [[TMP4]], i64 1
; CHECK-NEXT:    [[DXY:%.*]] = fadd double [[TMP5]], [[TMP6]]
; CHECK-NEXT:    [[D:%.*]] = fadd double [[DXY]], [[DZ2]]
; CHECK-NEXT:    [[F:%.*]] = fdiv double [[GMM]], [[D]]
; CHECK-NEXT:    [[TMP7:%.*]] = insertelement <2 x double> poison, double [[F]], i64 0
; CHECK-NEXT:    [[TMP8:%.*]] = shufflevector <2 x double> [[TMP7]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP9:%.*]] = fmul <2 x double> [[TMP3]], [[TMP8]]
; CHECK-NEXT:    [[TMP10:%.*]] = insertelement <2 x double> poison, double [[D]], i64 0
; CHECK-NEXT:    [[TMP11:%.*]] = shufflevector <2 x double> [[TMP10]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP12:%.*]] = fdiv <2 x double> [[TMP9]], [[TMP11]]
; CHECK-NEXT:    [[TZ:%.*]] = fmul double [[DZ]], [[F]]
; CHECK-NEXT:    [[AZ:%.*]] = fdiv double [[TZ]], [[D]]
; CHECK-NEXT:    [[TMP13]] = fadd <2 x double> [[TMP1]], [[TMP12]]
; CHECK-NEXT:    [[FZ_NEXT]] = fadd double [[FZ]], [[AZ]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    store <2 x double> [[TMP13]], ptr [[OUT]], align 8
; CHECK-NEXT:    [[OUT_Z:%.*]] = getelementptr inbounds nuw i8, ptr [[OUT]], i64 16
; CHECK-NEXT:    store double [[FZ_NEXT]], ptr [[OUT_Z]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %px = load double, ptr %p, align 8
  %p.y = getelementptr inbounds nuw i8, ptr %p, i64 8
  %py = load double, ptr %p.y, align 8
  %p.z = getelementptr inbounds nuw i8, ptr %p, i64 16
  %pz = load double, ptr %p.z, align 8
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %fx = phi double [ 0.000000e+00, %entry ], [ %fx.next, %loop ]
  %fy = phi double [ 0.000000e+00, %entry ], [ %fy.next, %loop ]
  %fz = phi double [ 0.000000e+00, %entry ], [ %fz.next, %loop ]
  %q = getelementptr inbounds nuw [24 x i8], ptr %pos, i64 %i
  %mp = getelementptr inbounds nuw [8 x i8], ptr %mass, i64 %i
  %m = load double, ptr %mp, align 8
  %qx = load double, ptr %q, align 8
  %dx = fsub double %px, %qx
  %q.y = getelementptr inbounds nuw i8, ptr %q, i64 8
  %qy = load double, ptr %q.y, align 8
  %dy = fsub double %py, %qy
  %q.z = getelementptr inbounds nuw i8, ptr %q, i64 16
  %qz = load double, ptr %q.z, align 8
  %dz = fsub double %pz, %qz
  %dx2 = fmul double %dx, %dx
  %dy2 = fmul double %dy, %dy
  %dxy = fadd double %dx2, %dy2
  %dz2 = fmul double %dz, %dz
  %d = fadd double %dxy, %dz2
  %gmm = fmul double %gm, %m
  %f = fdiv double %gmm, %d
  %tx = fmul double %dx, %f
  %ax = fdiv double %tx, %d
  %ty = fmul double %dy, %f
  %ay = fdiv double %ty, %d
  %tz = fmul double %dz, %f
  %az = fdiv double %tz, %d
  %fx.next = fadd double %fx, %ax
  %fy.next = fadd double %fy, %ay
  %fz.next = fadd double %fz, %az
  %i.next = add nuw i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  store double %fx.next, ptr %out, align 8
  %out.y = getelementptr inbounds nuw i8, ptr %out, i64 8
  store double %fy.next, ptr %out.y, align 8
  %out.z = getelementptr inbounds nuw i8, ptr %out, i64 16
  store double %fz.next, ptr %out.z, align 8
  ret void
}
