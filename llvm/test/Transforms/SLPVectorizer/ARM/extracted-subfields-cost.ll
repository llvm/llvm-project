; YAML-NEXT:  - Treshold:        '0'
define i16 @sum4_zext_fields(ptr %p) {
; CHECK-LABEL: define i16 @sum4_zext_fields(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0]] {
