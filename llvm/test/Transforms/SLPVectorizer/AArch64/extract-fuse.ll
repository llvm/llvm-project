; The fmul and fadd should later get fused into flma by element, though that's
; irrelevant for SLP and it should judge this profitable just based on the fmul.
define void @test_fma(ptr %p, ptr %q, float %arg1, float %arg2) {
; CHECK-LABEL: define void @test_fma(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], float [[ARG1:%.*]], float [[ARG2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x float>, ptr [[P]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = fadd <2 x float> [[TMP0]], splat (float 5.000000e+00)
; CHECK-NEXT:    [[TMP2:%.*]] = extractelement <2 x float> [[TMP1]], i64 1
; CHECK-NEXT:    [[MUL:%.*]] = fmul contract float [[ARG1]], [[TMP2]]
; CHECK-NEXT:    [[ADD:%.*]] = fadd contract float [[ARG2]], [[MUL]]
; CHECK-NEXT:    [[TMP3:%.*]] = extractelement <2 x float> [[TMP1]], i64 0
; CHECK-NEXT:    store float [[TMP3]], ptr [[P]], align 4
; CHECK-NEXT:    store float [[ADD]], ptr [[Q]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %p.4 = getelementptr i8, ptr %p, i64 4
  %val0 = load float, ptr %p, align 4
  %val1 = load float, ptr %p.4, align 4
  %add0 = fadd float %val0, 5.0
  %add1 = fadd float %val1, 5.0
  %mul = fmul contract float %arg1, %add1
  %add = fadd contract float %arg2, %mul
  store float %add0, ptr %p, align 4
  store float %add, ptr %q, align 4
  ret void
}

