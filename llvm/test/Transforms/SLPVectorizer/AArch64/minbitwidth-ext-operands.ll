; Preserve the i16 arithmetic when a later operand raises MaxBitWidth.
; For input0 = 0 and mask0 = 65536, i16 wrapping gives 0; widening gives 65536.
define void @keep_original_width(i8 %input0, i8 %input1, i32 %mask0, i32 %mask1, ptr %out) {
; CHECK-LABEL: define void @keep_original_width(
; CHECK-SAME: i8 [[INPUT0:%.*]], i8 [[INPUT1:%.*]], i32 [[MASK0:%.*]], i32 [[MASK1:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x i8> poison, i8 [[INPUT0]], i64 0
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x i8> [[TMP1]], i8 [[INPUT1]], i64 1
; CHECK-NEXT:    [[X:%.*]] = zext <2 x i8> [[TMP2]] to <2 x i16>
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <2 x i32> poison, i32 [[MASK0]], i64 0
; CHECK-NEXT:    [[TMP5:%.*]] = insertelement <2 x i32> [[TMP4]], i32 [[MASK1]], i64 1
; CHECK-NEXT:    [[HI:%.*]] = or <2 x i16> [[X]], splat (i16 -32768)
; CHECK-NEXT:    [[SUM:%.*]] = add <2 x i16> [[HI]], splat (i16 -32768)
; CHECK-NEXT:    [[EXT:%.*]] = zext <2 x i16> [[SUM]] to <2 x i32>
; CHECK-NEXT:    [[TMP9:%.*]] = and <2 x i32> [[EXT]], [[TMP5]]
; CHECK-NEXT:    store <2 x i32> [[TMP9]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
  %input_ext0 = zext i8 %input0 to i16
  %or0 = or i16 %input_ext0, -32768
  %added0 = add i16 %or0, -32768
  %added_ext0 = zext i16 %added0 to i64
  %mask_ext0 = zext i32 %mask0 to i64
  %masked0 = and i64 %added_ext0, %mask_ext0
  %result0 = trunc i64 %masked0 to i32

  %input_ext1 = zext i8 %input1 to i16
  %or1 = or i16 %input_ext1, -32768
  %added1 = add i16 %or1, -32768
  %added_ext1 = zext i16 %added1 to i64
  %mask_ext1 = zext i32 %mask1 to i64
  %masked1 = and i64 %added_ext1, %mask_ext1
  %result1 = trunc i64 %masked1 to i32

  store i32 %result0, ptr %out, align 4
  %out1 = getelementptr i32, ptr %out, i64 1
  store i32 %result1, ptr %out1, align 4
  ret void
}

