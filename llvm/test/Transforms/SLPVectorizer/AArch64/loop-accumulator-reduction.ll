  %d03 = fmul fast double %l2, %c8
  %d = fadd fast double %d02, %d03
  %e = fadd fast double %a, %b
  %f = fadd fast double %d, %a
  %sa = fmul double %a, %a
  %t1 = fadd fast double %sa, %acc
  %sb = fmul double %b, %b
  %t2 = fadd fast double %t1, %sb
  %sd = fmul double %d, %d
  %t3 = fadd fast double %t2, %sd
  %se = fmul double %e, %e
  %t4 = fadd fast double %t3, %se
  %sf = fmul double %f, %f
  %sum = fadd fast double %t4, %sf
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %loop ]
  ret double %res
}
