; The accumulator phi has two entries for the preheader (switch with two
; edges): a single insert of the initial value is shared by both entries.
define double @dup_preheader_edges(ptr %p, i64 %n, double %init, i32 %sw) {
; CHECK-LABEL: define double @dup_preheader_edges(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], double [[INIT:%.*]], i32 [[SW:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    switch i32 [[SW]], label %[[LOOP:.*]] [
; CHECK-NEXT:      i32 1, label %[[LOOP]]
; CHECK-NEXT:    ]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ [[INIT]], %[[ENTRY]] ], [ [[INIT]], %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP2]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = phi double [ [[OP_RDX]], %[[LOOP]] ]
; CHECK-NEXT:    ret double [[TMP1]]
;
entry:
  switch i32 %sw, label %loop [ i32 1, label %loop ]

loop:
  %iv = phi i64 [ 1, %entry ], [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ %init, %entry ], [ %init, %entry ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %loop ]
  ret double %res
}

; The exit phi has two entries for the entry block carrying the bypass value.
; The bypass value never went through the reduction operations and stays
; exact: the scalar phi keeps it and it is selected past the final reduction.
define double @dup_exit_edges_bypass(ptr %p, i64 %n, double %y, i32 %sw) {
; CHECK-LABEL: define double @dup_exit_edges_bypass(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], double [[Y:%.*]], i32 [[SW:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    switch i32 [[SW]], label %[[LOOP:.*]] [
; CHECK-NEXT:      i32 1, label %[[EXIT:.*]]
; CHECK-NEXT:      i32 2, label %[[EXIT]]
; CHECK-NEXT:    ]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP2]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = phi double [ [[OP_RDX]], %[[LOOP]] ], [ [[Y]], %[[ENTRY]] ], [ [[Y]], %[[ENTRY]] ]
; CHECK-NEXT:    ret double [[TMP1]]
;
entry:
  switch i32 %sw, label %loop [ i32 1, label %exit
  i32 2, label %exit ]

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 0.0, %entry ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %loop ], [ %y, %entry ], [ %y, %entry ]
  ret double %res
}

; fmax with nnan ninf: the in-loop identity is the largest finite value. The
; bypass value (which may be NaN) is selected past the final reduction, so the
; reduction keeps the flags.
define double @fmax_bypass(ptr %p, i64 %n, double %y, i1 %c) {
; CHECK-LABEL: define double @fmax_bypass(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], double [[Y:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[C2:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[M3:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[L3:%.*]] = call nnan ninf double @llvm.vector.reduce.fmax.v4f64(<4 x double> [[TMP0]])
; CHECK-NEXT:    [[M3]] = call nnan ninf double @llvm.maxnum.f64(double [[L3]], double [[C2]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[SLPRDX_SEL:%.*]] = phi double [ [[M3]], %[[LOOP]] ], [ [[Y]], %[[ENTRY]] ]
; CHECK-NEXT:    ret double [[SLPRDX_SEL]]
;
entry:
  br i1 %c, label %loop, label %exit

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 0.0, %entry ], [ %m3, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %c0 = call nnan ninf double @llvm.maxnum.f64(double %l0, double %acc)
  %c1 = call nnan ninf double @llvm.maxnum.f64(double %l1, double %c0)
  %c2 = call nnan ninf double @llvm.maxnum.f64(double %l2, double %c1)
  %m3 = call nnan ninf double @llvm.maxnum.f64(double %l3, double %c2)
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %m3, %loop ], [ %y, %entry ]
  ret double %res
}

; An in-loop value leaves the loop through the exit phi on an early exit: it
; is selected past the final reduction.
define double @early_exit_in_loop_value(ptr %p, i64 %n) {
; CHECK-LABEL: define double @early_exit_in_loop_value(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP3]], [[ACC]]
; CHECK-NEXT:    [[TMP1:%.*]] = extractelement <4 x double> [[TMP0]], i64 0
; CHECK-NEXT:    [[EC:%.*]] = fcmp ogt double [[TMP1]], 1.000000e+10
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi double [ [[OP_RDX]], %[[LATCH]] ], [ [[TMP1]], %[[LOOP]] ]
; CHECK-NEXT:    ret double [[TMP2]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %latch ]
  %acc = phi double [ 0.0, %entry ], [ %sum, %latch ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %ec = fcmp ogt double %l0, 1.0e10
  br i1 %ec, label %exit, label %latch

latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %latch ], [ %l0, %loop ]
  ret double %res
}

; The exit block is a loop (self-loop) not containing the reduction loop: the
; final reduction would be repeated on every iteration of it, so no vector
; accumulator.
define double @selfloop_exit_block(ptr %p, i64 %n, ptr %q) {
; CHECK-LABEL: define double @selfloop_exit_block(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP2]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = phi double [ [[OP_RDX]], %[[LOOP]] ], [ [[TMP1]], %[[EXIT]] ]
; CHECK-NEXT:    [[U:%.*]] = phi double [ 0.000000e+00, %[[LOOP]] ], [ [[TMP1]], %[[EXIT]] ]
; CHECK-NEXT:    [[K:%.*]] = phi i64 [ 0, %[[LOOP]] ], [ [[K_NEXT:%.*]], %[[EXIT]] ]
; CHECK-NEXT:    [[K_NEXT]] = add i64 [[K]], 1
; CHECK-NEXT:    store double [[U]], ptr [[Q]], align 8
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[K_NEXT]], 8
; CHECK-NEXT:    br i1 [[C]], label %[[DONE:.*]], label %[[EXIT]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret double [[TMP1]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 0.0, %entry ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %loop ], [ %res, %exit ]
  %u = phi double [ 0.0, %loop ], [ %res, %exit ]
  %k = phi i64 [ 0, %loop ], [ %k.next, %exit ]
  %k.next = add i64 %k, 1
  store double %u, ptr %q, align 8
  %c = icmp eq i64 %k.next, 8
  br i1 %c, label %done, label %exit

done:
  ret double %res
}

