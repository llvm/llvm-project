  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  invoke void @f() to label %loop unwind label %cs

cs:
  %e = phi double [ %sum, %loop ]
  %cs1 = catchswitch within none [label %handler] unwind to caller

handler:
  %cp = catchpad within %cs1 [ptr null, i32 64, ptr null]
  catchret from %cp to label %ret

ret:
  ret double %e
}

; The accumulator phi is used twice by the reduction (doubled on every
; iteration): not an accumulator.
define double @acc_used_twice(ptr %p, i64 %n) {
; CHECK-LABEL: define double @acc_used_twice(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 1.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = fmul reassoc nnan ninf nsz arcp afn double [[ACC]], 2.000000e+00
; CHECK-NEXT:    [[TMP2:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi double [ [[OP_RDX]], %[[LOOP]] ]
; CHECK-NEXT:    ret double [[RES]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 1.0, %entry ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %a2 = fadd fast double %acc, %acc
  %t0 = fadd fast double %l0, %a2
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %loop ]
  ret double %res
}

; The root is also the backedge value of another header phi: no vector
; accumulator.
define double @second_header_phi(ptr %p, i64 %n) {
; CHECK-LABEL: define double @second_header_phi(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[PREV:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP1]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi double [ [[PREV]], %[[LOOP]] ]
; CHECK-NEXT:    ret double [[RES]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 0.0, %entry ], [ %sum, %loop ]
  %prev = phi double [ 0.0, %entry ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %prev, %loop ]
  ret double %res
}

; The exit phi is the header phi of a following loop that keeps accumulating
; into the same value: the final reduction would be repeated on every
; iteration of that loop, so no vector accumulator for the first loop.
define double @two_loops_same_acc(ptr %p, ptr %q, i64 %n, i64 %m) {
; CHECK-LABEL: define double @two_loops_same_acc(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP1]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP2:.*]], label %[[LOOP1]]
; CHECK:       [[LOOP2]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[LOOP1]] ], [ [[J_NEXT:%.*]], %[[LOOP2]] ]
; CHECK-NEXT:    [[ACC2:%.*]] = phi double [ [[OP_RDX]], %[[LOOP1]] ], [ [[SUM2:%.*]], %[[LOOP2]] ]
; CHECK-NEXT:    [[Q0:%.*]] = getelementptr double, ptr [[Q]], i64 [[J]]
; CHECK-NEXT:    [[V0:%.*]] = load double, ptr [[Q0]], align 8
; CHECK-NEXT:    [[SUM2]] = fadd fast double [[ACC2]], [[V0]]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[CMP2:%.*]] = icmp eq i64 [[J_NEXT]], [[M]]
; CHECK-NEXT:    br i1 [[CMP2]], label %[[EXIT:.*]], label %[[LOOP2]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret double [[SUM2]]
;
entry:
  br label %loop1

loop1:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop1 ]
  %acc = phi double [ 0.0, %entry ], [ %sum, %loop1 ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %loop2, label %loop1

loop2:
  %j = phi i64 [ 0, %loop1 ], [ %j.next, %loop2 ]
  %acc2 = phi double [ %sum, %loop1 ], [ %sum2, %loop2 ]
  %q0 = getelementptr double, ptr %q, i64 %j
  %v0 = load double, ptr %q0, align 8
  %sum2 = fadd fast double %acc2, %v0
  %j.next = add nuw nsw i64 %j, 1
  %cmp2 = icmp eq i64 %j.next, %m
  br i1 %cmp2, label %exit, label %loop2

exit:
  ret double %sum2
}

; The bypass value of the exit phi comes from the latch of a sibling loop:
; nothing is emitted there, the value is selected past the final reduction.
define double @bypass_from_sibling_loop(ptr %p, ptr %q, i64 %n, i64 %m, i1 %c) {
; CHECK-LABEL: define double @bypass_from_sibling_loop(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP:.*]], label %[[LOOP2:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP1]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[LOOP2]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[LOOP2]] ]
; CHECK-NEXT:    [[ACC2:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[SUM2:%.*]], %[[LOOP2]] ]
; CHECK-NEXT:    [[Q0:%.*]] = getelementptr double, ptr [[Q]], i64 [[J]]
; CHECK-NEXT:    [[V0:%.*]] = load double, ptr [[Q0]], align 8
; CHECK-NEXT:    [[SUM2]] = fadd fast double [[ACC2]], [[V0]]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[CMP2:%.*]] = icmp eq i64 [[J_NEXT]], [[M]]
; CHECK-NEXT:    br i1 [[CMP2]], label %[[EXIT]], label %[[LOOP2]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi double [ [[OP_RDX]], %[[LOOP]] ], [ [[SUM2]], %[[LOOP2]] ]
; CHECK-NEXT:    ret double [[RES]]
;
entry:
  br i1 %c, label %loop, label %loop2

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 0.0, %entry ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

loop2:
  %j = phi i64 [ 0, %entry ], [ %j.next, %loop2 ]
  %acc2 = phi double [ 0.0, %entry ], [ %sum2, %loop2 ]
  %q0 = getelementptr double, ptr %q, i64 %j
  %v0 = load double, ptr %q0, align 8
  %sum2 = fadd fast double %acc2, %v0
  %j.next = add nuw nsw i64 %j, 1
  %cmp2 = icmp eq i64 %j.next, %m
  br i1 %cmp2, label %exit, label %loop2

exit:
  %res = phi double [ %sum, %loop ], [ %sum2, %loop2 ]
  ret double %res
}
