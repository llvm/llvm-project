  %d = fadd fast double %d02, %d03
  %e = fadd fast double %a, %b
  %f = fadd fast double %d, %a
  %sa = fmul double %a, %a
  %t1 = fadd fast double %sa, %acc
  %sb = fmul double %b, %b
  %t2 = fadd fast double %t1, %sb
  %sd = fmul double %d, %d
  %t3 = fadd fast double %t2, %sd
  %se = fmul double %e, %e
  %t4 = fadd fast double %t3, %se
  %sf = fmul double %f, %f
  %sum = fadd fast double %t4, %sf
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %sum, %loop ]
  ret double %res
}

; Loop-carried fmax reduction with nnan only: the identity constant is
; defined via getReductionIdentity, no nsz required.
define double @loop_acc_fmax(ptr %p, i64 %n) {
; CHECK-LABEL: define double @loop_acc_fmax(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[C2:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[M3:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[L3:%.*]] = call nnan double @llvm.vector.reduce.fmax.v4f64(<4 x double> [[TMP0]])
; CHECK-NEXT:    [[M3]] = call nnan double @llvm.maxnum.f64(double [[L3]], double [[C2]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi double [ [[M3]], %[[LOOP]] ]
; CHECK-NEXT:    ret double [[TMP2]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 1, %entry ], [ %iv.next, %loop ]
  %acc = phi double [ 0.000000e+00, %entry ], [ %m3, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %c0 = call nnan double @llvm.maxnum.f64(double %l0, double %acc)
  %c1 = call nnan double @llvm.maxnum.f64(double %l1, double %c0)
  %c2 = call nnan double @llvm.maxnum.f64(double %l2, double %c1)
  %m3 = call nnan double @llvm.maxnum.f64(double %l3, double %c2)
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, %n
  br i1 %cmp, label %exit, label %loop

exit:
  %res = phi double [ %m3, %loop ]
  ret double %res
}

