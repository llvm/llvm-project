  %add = fadd fast float %7, %ax0.069
  %arrayidx3 = getelementptr inbounds nuw i8, ptr %arrayidx, i64 8
  %8 = load float, ptr %arrayidx3, align 4
  %add5 = fadd fast float %8, %ax1.070
  %arrayidx8 = getelementptr inbounds nuw i8, ptr %arrayidx, i64 16
  %9 = load float, ptr %arrayidx8, align 4
  %add10 = fadd fast float %9, %ax2.071
  %arrayidx13 = getelementptr inbounds nuw i8, ptr %arrayidx, i64 24
  %10 = load float, ptr %arrayidx13, align 4
  %add15 = fadd fast float %10, %ax3.072
  %y = getelementptr inbounds nuw i8, ptr %arrayidx, i64 4
  %11 = load float, ptr %y, align 4
  %add18 = fadd fast float %11, %ay0.073
  %y22 = getelementptr inbounds nuw i8, ptr %arrayidx, i64 12
  %12 = load float, ptr %y22, align 4
  %add23 = fadd fast float %12, %ay1.074
  %y27 = getelementptr inbounds nuw i8, ptr %arrayidx, i64 20
