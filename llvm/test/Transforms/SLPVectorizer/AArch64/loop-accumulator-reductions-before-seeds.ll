  %ay0.073 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add18, %for.body ]
  %ax3.072 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add15, %for.body ]
  %ax2.071 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add10, %for.body ]
  %ax1.070 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add5, %for.body ]
  %ax0.069 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add, %for.body ]
  %arrayidx = getelementptr inbounds nuw [8 x i8], ptr %p, i64 %indvars.iv
