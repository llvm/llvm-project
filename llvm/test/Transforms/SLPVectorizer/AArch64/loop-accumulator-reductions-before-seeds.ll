; The accumulators, loaded with a stride, stay vectorized across the streams by
; the stores of the reduced values.

define void @aos_accumulators(ptr %p, i32 %n, ptr %out) {
; CHECK-LABEL: define void @aos_accumulators(
; CHECK-SAME: ptr [[P:%.*]], i32 [[N:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[CMP68:%.*]] = icmp sgt i32 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP68]], label %[[FOR_BODY_PREHEADER:.*]], label %[[FOR_COND_CLEANUP:.*]]
; CHECK:       [[FOR_BODY_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = zext nneg i32 [[N]] to i64
; CHECK-NEXT:    br label %[[FOR_BODY:.*]]
; CHECK:       [[FOR_COND_CLEANUP_LOOPEXIT:.*]]:
; CHECK-NEXT:    [[TMP1:%.*]] = fadd fast <2 x float> [[TMP14:%.*]], [[TMP13:%.*]]
; CHECK-NEXT:    [[TMP2:%.*]] = fadd fast <2 x float> [[TMP1]], [[TMP15:%.*]]
; CHECK-NEXT:    [[TMP3:%.*]] = fadd fast <2 x float> [[TMP2]], [[TMP16:%.*]]
; CHECK-NEXT:    br label %[[FOR_COND_CLEANUP]]
; CHECK:       [[FOR_COND_CLEANUP]]:
; CHECK-NEXT:    [[TMP4:%.*]] = phi <2 x float> [ zeroinitializer, %[[ENTRY]] ], [ [[TMP3]], %[[FOR_COND_CLEANUP_LOOPEXIT]] ]
; CHECK-NEXT:    store <2 x float> [[TMP4]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ 0, %[[FOR_BODY_PREHEADER]] ], [ [[INDVARS_IV_NEXT:%.*]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = phi <2 x float> [ zeroinitializer, %[[FOR_BODY_PREHEADER]] ], [ [[TMP14]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[TMP6:%.*]] = phi <2 x float> [ zeroinitializer, %[[FOR_BODY_PREHEADER]] ], [ [[TMP13]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[TMP7:%.*]] = phi <2 x float> [ zeroinitializer, %[[FOR_BODY_PREHEADER]] ], [ [[TMP15]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[TMP8:%.*]] = phi <2 x float> [ zeroinitializer, %[[FOR_BODY_PREHEADER]] ], [ [[TMP16]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[P]], i64 [[INDVARS_IV]]
; CHECK-NEXT:    [[ARRAYIDX3:%.*]] = getelementptr inbounds nuw i8, ptr [[ARRAYIDX]], i64 8
; CHECK-NEXT:    [[ARRAYIDX8:%.*]] = getelementptr inbounds nuw i8, ptr [[ARRAYIDX]], i64 16
; CHECK-NEXT:    [[ARRAYIDX13:%.*]] = getelementptr inbounds nuw i8, ptr [[ARRAYIDX]], i64 24
; CHECK-NEXT:    [[TMP9:%.*]] = load <2 x float>, ptr [[ARRAYIDX]], align 4
; CHECK-NEXT:    [[TMP10:%.*]] = load <2 x float>, ptr [[ARRAYIDX3]], align 4
; CHECK-NEXT:    [[TMP11:%.*]] = load <2 x float>, ptr [[ARRAYIDX8]], align 4
; CHECK-NEXT:    [[TMP12:%.*]] = load <2 x float>, ptr [[ARRAYIDX13]], align 4
; CHECK-NEXT:    [[TMP13]] = fadd fast <2 x float> [[TMP9]], [[TMP6]]
; CHECK-NEXT:    [[TMP14]] = fadd fast <2 x float> [[TMP10]], [[TMP5]]
; CHECK-NEXT:    [[TMP15]] = fadd fast <2 x float> [[TMP11]], [[TMP7]]
; CHECK-NEXT:    [[TMP16]] = fadd fast <2 x float> [[TMP12]], [[TMP8]]
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV]], 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ult i64 [[INDVARS_IV_NEXT]], [[TMP0]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[FOR_BODY]], label %[[FOR_COND_CLEANUP_LOOPEXIT]]
;
entry:
  %cmp68 = icmp sgt i32 %n, 0
  br i1 %cmp68, label %for.body.preheader, label %for.cond.cleanup

for.body.preheader:                               ; preds = %entry
  %0 = zext nneg i32 %n to i64
  br label %for.body

for.cond.cleanup.loopexit:                        ; preds = %for.body
  %1 = fadd fast float %add5, %add
  %2 = fadd fast float %1, %add10
  %3 = fadd fast float %2, %add15
  %4 = fadd fast float %add23, %add18
  %5 = fadd fast float %4, %add28
  %6 = fadd fast float %5, %add33
  br label %for.cond.cleanup

