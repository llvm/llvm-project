  %add28 = fadd fast float %13, %ay2.075
  %y32 = getelementptr inbounds nuw i8, ptr %arrayidx, i64 28
  %14 = load float, ptr %y32, align 4
  %add33 = fadd fast float %14, %ay3.076
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 4
  %cmp = icmp samesign ult i64 %indvars.iv.next, %0
