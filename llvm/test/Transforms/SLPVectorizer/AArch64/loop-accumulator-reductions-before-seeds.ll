  %add37 = phi float [ 0.000000e+00, %entry ], [ %3, %for.cond.cleanup.loopexit ]
  %add41 = phi float [ 0.000000e+00, %entry ], [ %6, %for.cond.cleanup.loopexit ]
  store float %add37, ptr %out, align 4
  %arrayidx42 = getelementptr inbounds nuw i8, ptr %out, i64 4
  store float %add41, ptr %arrayidx42, align 4
  ret void

for.body:                                         ; preds = %for.body.preheader, %for.body
  %indvars.iv = phi i64 [ 0, %for.body.preheader ], [ %indvars.iv.next, %for.body ]
  %ay3.076 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add33, %for.body ]
  %ay2.075 = phi float [ 0.000000e+00, %for.body.preheader ], [ %add28, %for.body ]
