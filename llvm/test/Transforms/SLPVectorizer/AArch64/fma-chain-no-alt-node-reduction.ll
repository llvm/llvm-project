accum:
  %di = load double, ptr %densi, align 8
  %di1 = fadd fast double %di, %rsq
  store double %di1, ptr %densi, align 8
  br label %latch

latch:
  %iv.next = add nsw i64 %iv, 1
  %c.next = add nsw i64 %c, -1
  %cont = icmp sgt i64 %c, 1
  br i1 %cont, label %loop, label %exit

