define double @test(double %a, <2 x double> %v0, <2 x double> %v1) {
; CHECK-LABEL: define double @test(
; CHECK-SAME: double [[A:%.*]], <2 x double> [[V0:%.*]], <2 x double> [[V1:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[E1:%.*]] = extractelement <2 x double> [[V1]], i64 1
; CHECK-NEXT:    [[M0:%.*]] = fmul double [[A]], [[E1]]
; CHECK-NEXT:    [[E0:%.*]] = extractelement <2 x double> [[V1]], i64 0
; CHECK-NEXT:    [[M1:%.*]] = fmul double [[E0]], 0.000000e+00
; CHECK-NEXT:    [[R:%.*]] = fadd reassoc double [[M0]], [[M1]]
; CHECK-NEXT:    [[X0:%.*]] = extractelement <2 x double> [[V0]], i64 1
; CHECK-NEXT:    [[X1:%.*]] = fmul double [[X0]], [[E1]]
; CHECK-NEXT:    [[SUM:%.*]] = fadd double [[R]], [[X1]]
; CHECK-NEXT:    [[RES:%.*]] = fsub double [[E0]], [[SUM]]
; CHECK-NEXT:    ret double [[RES]]
;
  %e1 = extractelement <2 x double> %v1, i64 1
  %m0 = fmul double %a, %e1
  %e0 = extractelement <2 x double> %v1, i64 0
  %m1 = fmul double %e0, 0.000000e+00
  %r = fadd reassoc double %m0, %m1
  %x0 = extractelement <2 x double> %v0, i64 1
  %x1 = fmul double %x0, %e1
  %sum = fadd double %r, %x1
  %res = fsub double %e0, %sum
  ret double %res
}

