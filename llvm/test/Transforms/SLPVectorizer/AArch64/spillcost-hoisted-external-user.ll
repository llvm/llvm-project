; The multiplies are scheduled above their external user before the call, so
; their 256-bit vector is live across the call.

define double @test(double %x) {
; CHECK-LABEL: define double @test(
; CHECK-SAME: double [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <4 x double> <double 0.000000e+00, double poison, double 0.000000e+00, double 1.000000e+00>, double [[X]], i64 1
; CHECK-NEXT:    [[TMP1:%.*]] = fmul <4 x double> [[TMP0]], <double 0.000000e+00, double 0.000000e+00, double 0.000000e+00, double 1.000000e+00>
; CHECK-NEXT:    [[M0:%.*]] = extractelement <4 x double> [[TMP1]], i64 0
; CHECK-NEXT:    [[M0_USE:%.*]] = fmul double [[M0]], 0.000000e+00
; CHECK-NEXT:    call void @use(double [[M0_USE]])
; CHECK-NEXT:    [[TMP3:%.*]] = fmul <4 x double> zeroinitializer, [[TMP1]]
; CHECK-NEXT:    [[A2:%.*]] = call reassoc double @llvm.vector.reduce.fadd.v4f64(double -0.000000e+00, <4 x double> [[TMP3]])
; CHECK-NEXT:    ret double [[A2]]
;
entry:
  %m0 = fmul double 0.000000e+00, 0.000000e+00
  %m0.use = fmul double %m0, 0.000000e+00
  call void @use(double %m0.use)
  %m1 = fmul double %x, 0.000000e+00
  %r0 = fmul contract double %m0, 0.000000e+00
  %r1 = fmul double %m1, 0.000000e+00
  %a0 = fadd reassoc contract double %r0, %r1
  %m2 = fmul double 0.000000e+00, 0.000000e+00
  %r2 = fmul double %m2, 0.000000e+00
  %a1 = fadd reassoc double %a0, %r2
  %a2 = fadd reassoc double %a1, 0.000000e+00
  ret double %a2
}

; The multiplies feeding the phis are scheduled above their external user, so
; their vector is live across the call until the backedge.

define void @loop(double %x, double %y) {
; CHECK-LABEL: define void @loop(
; CHECK-SAME: double [[X:%.*]], double [[Y:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P0:%.*]] = phi double [ [[X]], %[[ENTRY]] ], [ [[N0:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P1:%.*]] = phi double [ [[Y]], %[[ENTRY]] ], [ [[N1:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[A0:%.*]] = fadd double [[P0]], 1.000000e+00
; CHECK-NEXT:    [[N0]] = fmul double [[A0]], 3.000000e+00
; CHECK-NEXT:    [[U:%.*]] = fmul double [[N0]], 7.000000e+00
; CHECK-NEXT:    call void @use(double [[U]])
; CHECK-NEXT:    [[A1:%.*]] = fadd double [[P1]], 2.000000e+00
; CHECK-NEXT:    [[N1]] = fmul double [[A1]], 5.000000e+00
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[I_NEXT]], 100
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %p0 = phi double [ %x, %entry ], [ %n0, %loop ]
  %p1 = phi double [ %y, %entry ], [ %n1, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %a0 = fadd double %p0, 1.000000e+00
  %n0 = fmul double %a0, 3.000000e+00
  %u = fmul double %n0, 7.000000e+00
  call void @use(double %u)
  %a1 = fadd double %p1, 2.000000e+00
  %n1 = fmul double %a1, 5.000000e+00
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, 100
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

declare void @use(double)
