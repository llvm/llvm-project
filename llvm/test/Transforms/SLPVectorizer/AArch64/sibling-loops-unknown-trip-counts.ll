; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x i32>, ptr [[G0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <2 x i32> [[TMP0]], <i32 3, i32 5>
