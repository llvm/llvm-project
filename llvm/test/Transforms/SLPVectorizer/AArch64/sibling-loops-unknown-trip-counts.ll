; CHECK:       [[TAIL_LOOP]]:
; CHECK-NEXT:    [[TA:%.*]] = phi i32 [ [[TA_NEXT:%.*]], %[[TAIL_LOOP]] ], [ [[TMP4]], %[[TAIL_PH]] ]
; CHECK-NEXT:    [[TB:%.*]] = phi i32 [ [[TB_NEXT:%.*]], %[[TAIL_LOOP]] ], [ [[TMP5]], %[[TAIL_PH]] ]
; CHECK-NEXT:    [[Z0:%.*]] = zext i8 [[X0]] to i32
; CHECK-NEXT:    [[TB_NEXT]] = or i32 [[TB]], [[Z0]]
; CHECK-NEXT:    [[Z1:%.*]] = zext i8 [[X1]] to i32
; CHECK-NEXT:    [[TA_NEXT]] = or i32 [[TA]], [[Z1]]
; CHECK-NEXT:    br i1 [[C2]], label %[[EXIT:.*]], label %[[TAIL_LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP10:%.*]] = urem i32 [[TA_NEXT]], 65521
; CHECK-NEXT:    [[TMP11:%.*]] = urem i32 [[TB_NEXT]], 65521
; CHECK-NEXT:    [[RES:%.*]] = or i32 [[TMP10]], [[TMP11]]
; CHECK-NEXT:    ret i32 [[RES]]
