; CHECK-NEXT:    [[I0:%.*]] = fptosi double [[TMP6]] to i32
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <2 x double> [[TMP3]], i64 1
; CHECK-NEXT:    [[I1:%.*]] = fptosi double [[TMP7]] to i32
