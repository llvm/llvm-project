entry:
  br label %main.loop

main.loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %main.loop ]
  %g0 = getelementptr inbounds i32, ptr %in, i64 %iv
  %g1 = getelementptr inbounds i32, ptr %g0, i64 1
  %l0 = load i32, ptr %g0, align 4
  %l1 = load i32, ptr %g1, align 4
  %a0 = add i32 %l0, 3
  %a1 = add i32 %l1, 5
  %m0 = mul i32 %a0, 17
  %m1 = mul i32 %a1, 19
  %r0 = xor i32 %m0, 7
  %r1 = xor i32 %m1, 11
  %iv.next = add nuw nsw i64 %iv, 2
