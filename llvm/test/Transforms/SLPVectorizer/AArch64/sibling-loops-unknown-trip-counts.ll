define i32 @outer_backedge_reduction(ptr %p, ptr %q, i1 %c1, i1 %c2, i1 %c3) {
; CHECK-LABEL: define i32 @outer_backedge_reduction(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i1 [[C3:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = phi <2 x i32> [ zeroinitializer, %[[ENTRY]] ], [ [[TMP9:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[Q1:%.*]] = getelementptr inbounds nuw i8, ptr [[Q]], i64 1
; CHECK-NEXT:    [[Y0:%.*]] = load i8, ptr [[Q]], align 1
; CHECK-NEXT:    [[Y1:%.*]] = load i8, ptr [[Q1]], align 1
; CHECK-NEXT:    [[YZ0:%.*]] = zext i8 [[Y0]] to i32
; CHECK-NEXT:    [[YZ1:%.*]] = zext i8 [[Y1]] to i32
; CHECK-NEXT:    [[TMP10:%.*]] = extractelement <2 x i32> [[TMP0]], i64 0
; CHECK-NEXT:    [[OA1:%.*]] = or i32 [[TMP10]], [[YZ0]]
; CHECK-NEXT:    [[TMP11:%.*]] = extractelement <2 x i32> [[TMP0]], i64 1
; CHECK-NEXT:    [[OB1:%.*]] = or i32 [[TMP11]], [[YZ1]]
; CHECK-NEXT:    br label %[[MAIN_LOOP:.*]]
; CHECK:       [[MAIN_LOOP]]:
; CHECK-NEXT:    [[TMP1:%.*]] = phi <2 x i32> [ zeroinitializer, %[[OUTER_HEADER]] ], [ [[TMP3:%.*]], %[[MAIN_LOOP]] ]
; CHECK-NEXT:    [[TMP2:%.*]] = or <2 x i32> [[TMP1]], splat (i32 1)
; CHECK-NEXT:    [[TMP3]] = urem <2 x i32> [[TMP2]], splat (i32 65521)
; CHECK-NEXT:    br i1 [[C1]], label %[[TAIL_PH:.*]], label %[[MAIN_LOOP]]
; CHECK:       [[TAIL_PH]]:
; CHECK-NEXT:    [[TMP4:%.*]] = load <2 x i8>, ptr [[P]], align 1
; CHECK-NEXT:    br label %[[TAIL_LOOP:.*]]
; CHECK:       [[TAIL_LOOP]]:
; CHECK-NEXT:    [[TMP5:%.*]] = phi <2 x i32> [ [[TMP8:%.*]], %[[TAIL_LOOP]] ], [ [[TMP3]], %[[TAIL_PH]] ]
; CHECK-NEXT:    [[TMP6:%.*]] = zext <2 x i8> [[TMP4]] to <2 x i32>
; CHECK-NEXT:    [[TMP7:%.*]] = shufflevector <2 x i32> [[TMP6]], <2 x i32> poison, <2 x i32> <i32 1, i32 0>
; CHECK-NEXT:    [[TMP8]] = or <2 x i32> [[TMP5]], [[TMP7]]
; CHECK-NEXT:    br i1 [[C2]], label %[[OUTER_LATCH]], label %[[TAIL_LOOP]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[TMP9]] = urem <2 x i32> [[TMP8]], splat (i32 65521)
; CHECK-NEXT:    br i1 [[C3]], label %[[OUTER_HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[OP_RDX1:%.*]] = or i32 [[OA1]], [[OB1]]
; CHECK-NEXT:    ret i32 [[OP_RDX1]]
;
entry:
  br label %outer.header

outer.header:
  %oa = phi i32 [ 0, %entry ], [ %ta.rem, %outer.latch ]
  %ob = phi i32 [ 0, %entry ], [ %tb.rem, %outer.latch ]
  %q1 = getelementptr inbounds nuw i8, ptr %q, i64 1
  %y0 = load i8, ptr %q, align 1
  %y1 = load i8, ptr %q1, align 1
  %yz0 = zext i8 %y0 to i32
  %yz1 = zext i8 %y1 to i32
  %oa1 = or i32 %oa, %yz0
  %ob1 = or i32 %ob, %yz1
  br label %main.loop

main.loop:
  %a = phi i32 [ 0, %outer.header ], [ %a.rem, %main.loop ]
  %b = phi i32 [ 0, %outer.header ], [ %b.rem, %main.loop ]
  %b.or = or i32 %b, 1
  %b.rem = urem i32 %b.or, 65521
  %a.or = or i32 %a, 1
  %a.rem = urem i32 %a.or, 65521
  br i1 %c1, label %tail.ph, label %main.loop

tail.ph:
  %p1 = getelementptr inbounds nuw i8, ptr %p, i64 1
  %x0 = load i8, ptr %p, align 1
  %x1 = load i8, ptr %p1, align 1
  br label %tail.loop

tail.loop:
  %ta = phi i32 [ %ta.next, %tail.loop ], [ %a.rem, %tail.ph ]
  %tb = phi i32 [ %tb.next, %tail.loop ], [ %b.rem, %tail.ph ]
  %z0 = zext i8 %x0 to i32
  %tb.next = or i32 %tb, %z0
  %z1 = zext i8 %x1 to i32
  %ta.next = or i32 %ta, %z1
  br i1 %c2, label %outer.latch, label %tail.loop

outer.latch:
  %ta.rem = urem i32 %ta.next, 65521
  %tb.rem = urem i32 %tb.next, 65521
  br i1 %c3, label %outer.header, label %exit

exit:
  %res = or i32 %oa1, %ob1
  ret i32 %res
}

; The FMA candidate in the tail loop is deferred by the PHI in the exit block.
; The retry of the exit block defers it again.
define double @fma_phi_incoming(ptr %p, ptr %in, ptr %out, i1 %c0, i1 %c1, i1 %c2) {
; CHECK-LABEL: define double @fma_phi_incoming(
; CHECK-SAME: ptr [[P:%.*]], ptr [[IN:%.*]], ptr [[OUT:%.*]], i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C0]], label %[[MAIN_LOOP:.*]], label %[[EXIT:.*]]
; CHECK:       [[MAIN_LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[MAIN_LOOP]] ]
; CHECK-NEXT:    [[G0:%.*]] = getelementptr inbounds double, ptr [[IN]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x double>, ptr [[G0]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = fadd <2 x double> [[TMP0]], <double 1.000000e+00, double 2.000000e+00>
; CHECK-NEXT:    [[TMP2:%.*]] = fsub <2 x double> [[TMP1]], <double 3.500000e+00, double 4.500000e+00>
; CHECK-NEXT:    [[TMP3:%.*]] = fmul <2 x double> [[TMP2]], <double 7.000000e+00, double 1.100000e+01>
; CHECK-NEXT:    [[TMP4:%.*]] = fmul contract <2 x double> [[TMP3]], <double 3.000000e+00, double 5.000000e+00>
; CHECK-NEXT:    [[TMP5:%.*]] = call reassoc contract double @llvm.vector.reduce.fadd.v2f64(double -0.000000e+00, <2 x double> [[TMP4]])
; CHECK-NEXT:    store double [[TMP5]], ptr [[OUT]], align 8
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 2
; CHECK-NEXT:    br i1 [[C1]], label %[[TAIL_PH:.*]], label %[[MAIN_LOOP]]
; CHECK:       [[TAIL_PH]]:
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds nuw i8, ptr [[P]], i64 1
; CHECK-NEXT:    [[X0:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[X1:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    [[FX0:%.*]] = sitofp i8 [[X0]] to double
; CHECK-NEXT:    [[FX1:%.*]] = sitofp i8 [[X1]] to double
; CHECK-NEXT:    [[TMP6:%.*]] = extractelement <2 x double> [[TMP3]], i64 0
; CHECK-NEXT:    [[TMP7:%.*]] = extractelement <2 x double> [[TMP3]], i64 1
; CHECK-NEXT:    br label %[[TAIL_LOOP:.*]]
; CHECK:       [[TAIL_LOOP]]:
; CHECK-NEXT:    [[TA:%.*]] = phi double [ [[TA_NEXT:%.*]], %[[TAIL_LOOP]] ], [ [[TMP6]], %[[TAIL_PH]] ]
; CHECK-NEXT:    [[TB:%.*]] = phi double [ [[TB_NEXT:%.*]], %[[TAIL_LOOP]] ], [ [[TMP7]], %[[TAIL_PH]] ]
; CHECK-NEXT:    [[TA_NEXT]] = fadd double [[TA]], [[FX0]]
; CHECK-NEXT:    [[TB_NEXT]] = fadd double [[TB]], [[FX1]]
; CHECK-NEXT:    [[TM0:%.*]] = fmul contract double [[TA_NEXT]], 3.000000e+00
; CHECK-NEXT:    [[TM1:%.*]] = fmul contract double [[TB_NEXT]], 5.000000e+00
; CHECK-NEXT:    [[TR:%.*]] = fadd contract double [[TM0]], [[TM1]]
; CHECK-NEXT:    br i1 [[C2]], label %[[EXIT]], label %[[TAIL_LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[TR]], %[[TAIL_LOOP]] ]
; CHECK-NEXT:    ret double [[RES]]
;
entry:
  br i1 %c0, label %main.loop, label %exit

main.loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %main.loop ]
  %g0 = getelementptr inbounds double, ptr %in, i64 %iv
  %g1 = getelementptr inbounds double, ptr %g0, i64 1
  %l0 = load double, ptr %g0, align 8
  %l1 = load double, ptr %g1, align 8
  %a0 = fadd double %l0, 1.0
  %a1 = fadd double %l1, 2.0
  %a0b = fsub double %a0, 3.5
  %a1b = fsub double %a1, 4.5
  %b0 = fmul double %a0b, 7.0
  %b1 = fmul double %a1b, 11.0
  %m0 = fmul contract double %b0, 3.0
  %m1 = fmul contract double %b1, 5.0
  %r = fadd contract double %m0, %m1
  store double %r, ptr %out, align 8
  %iv.next = add nuw nsw i64 %iv, 2
  br i1 %c1, label %tail.ph, label %main.loop

tail.ph:
  %p1 = getelementptr inbounds nuw i8, ptr %p, i64 1
  %x0 = load i8, ptr %p, align 1
  %x1 = load i8, ptr %p1, align 1
  %fx0 = sitofp i8 %x0 to double
  %fx1 = sitofp i8 %x1 to double
  br label %tail.loop

tail.loop:
  %ta = phi double [ %ta.next, %tail.loop ], [ %b0, %tail.ph ]
  %tb = phi double [ %tb.next, %tail.loop ], [ %b1, %tail.ph ]
  %ta.next = fadd double %ta, %fx0
  %tb.next = fadd double %tb, %fx1
  %tm0 = fmul contract double %ta.next, 3.0
  %tm1 = fmul contract double %tb.next, 5.0
  %tr = fadd contract double %tm0, %tm1
  br i1 %c2, label %exit, label %tail.loop

exit:
  %res = phi double [ 0.0, %entry ], [ %tr, %tail.loop ]
  ret double %res
}

; The subtree with the operands, gathered from the sibling loop, is trimmed from
; the vectorized tree and still waits for the sibling loop.
define i32 @trimmed_subtree_in_exit(ptr %p, ptr %q0, ptr %q1, ptr %q2, ptr %q3, ptr %base, ptr %out1, ptr %out2, i1 %c1, i1 %c2) {
; CHECK-LABEL: define i32 @trimmed_subtree_in_exit(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q0:%.*]], ptr [[Q1:%.*]], ptr [[Q2:%.*]], ptr [[Q3:%.*]], ptr [[BASE:%.*]], ptr [[OUT1:%.*]], ptr [[OUT2:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[MAIN_LOOP:.*]]
; CHECK:       [[MAIN_LOOP]]:
; CHECK-NEXT:    [[TMP0:%.*]] = phi <2 x i32> [ zeroinitializer, %[[ENTRY]] ], [ [[TMP2:%.*]], %[[MAIN_LOOP]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = or <2 x i32> [[TMP0]], splat (i32 1)
; CHECK-NEXT:    [[TMP2]] = urem <2 x i32> [[TMP1]], splat (i32 65521)
; CHECK-NEXT:    br i1 [[C1]], label %[[TAIL_PH:.*]], label %[[MAIN_LOOP]]
; CHECK:       [[TAIL_PH]]:
; CHECK-NEXT:    [[TMP3:%.*]] = extractelement <2 x i32> [[TMP2]], i64 0
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <2 x i32> [[TMP2]], i64 1
; CHECK-NEXT:    br label %[[TAIL_LOOP:.*]]
; CHECK:       [[TAIL_LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[TAIL_PH]] ], [ [[IV_NEXT:%.*]], %[[TAIL_LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds nuw i8, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds nuw i8, ptr [[P0]], i64 1
; CHECK-NEXT:    [[X0:%.*]] = load i8, ptr [[P0]], align 1
; CHECK-NEXT:    [[X1:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    [[Z0:%.*]] = zext i8 [[X0]] to i32
; CHECK-NEXT:    [[TB_0:%.*]] = or i32 [[TMP4]], [[Z0]]
; CHECK-NEXT:    [[TB_NEXT:%.*]] = xor i32 [[TB_0]], 17
; CHECK-NEXT:    [[Z1:%.*]] = zext i8 [[X1]] to i32
; CHECK-NEXT:    [[TA_0:%.*]] = or i32 [[TMP3]], [[Z1]]
; CHECK-NEXT:    [[TA_NEXT:%.*]] = xor i32 [[TA_0]], 19
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 2
; CHECK-NEXT:    br i1 [[C2]], label %[[EXIT:.*]], label %[[TAIL_LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP28:%.*]] = add i32 [[TA_NEXT]], 31
; CHECK-NEXT:    [[TMP29:%.*]] = add i32 [[TB_NEXT]], 37
; CHECK-NEXT:    [[TMP9:%.*]] = load <2 x i32>, ptr [[Q0]], align 4
; CHECK-NEXT:    [[TMP10:%.*]] = load <2 x i32>, ptr [[Q1]], align 4
; CHECK-NEXT:    [[TMP11:%.*]] = load <2 x i32>, ptr [[Q2]], align 4
; CHECK-NEXT:    [[TMP12:%.*]] = load <2 x i32>, ptr [[Q3]], align 4
; CHECK-NEXT:    [[TMP13:%.*]] = add <2 x i32> [[TMP9]], <i32 1, i32 2>
; CHECK-NEXT:    [[TMP14:%.*]] = sub <2 x i32> [[TMP10]], <i32 3, i32 4>
; CHECK-NEXT:    [[TMP15:%.*]] = xor <2 x i32> [[TMP11]], <i32 5, i32 6>
; CHECK-NEXT:    [[TMP16:%.*]] = add <2 x i32> [[TMP12]], <i32 7, i32 8>
; CHECK-NEXT:    [[TMP17:%.*]] = sub <2 x i32> [[TMP13]], <i32 11, i32 13>
; CHECK-NEXT:    [[TMP18:%.*]] = xor <2 x i32> [[TMP17]], <i32 3, i32 5>
; CHECK-NEXT:    [[TMP19:%.*]] = add <2 x i32> [[TMP14]], <i32 7, i32 11>
; CHECK-NEXT:    [[TMP20:%.*]] = sub <2 x i32> [[TMP15]], <i32 13, i32 17>
; CHECK-NEXT:    [[TMP21:%.*]] = xor <2 x i32> [[TMP16]], <i32 19, i32 23>
; CHECK-NEXT:    [[TMP22:%.*]] = xor <2 x i32> [[TMP18]], [[TMP19]]
; CHECK-NEXT:    [[TMP23:%.*]] = add <2 x i32> [[TMP20]], [[TMP21]]
; CHECK-NEXT:    [[TMP24:%.*]] = sub <2 x i32> [[TMP22]], [[TMP23]]
; CHECK-NEXT:    [[TMP30:%.*]] = insertelement <2 x i32> poison, i32 [[TMP28]], i64 0
; CHECK-NEXT:    [[TMP8:%.*]] = insertelement <2 x i32> [[TMP30]], i32 [[TMP29]], i64 1
; CHECK-NEXT:    [[TMP25:%.*]] = xor <2 x i32> [[TMP24]], [[TMP8]]
; CHECK-NEXT:    [[TMP26:%.*]] = extractelement <2 x i32> [[TMP25]], i64 0
; CHECK-NEXT:    [[G0:%.*]] = getelementptr inbounds i32, ptr [[BASE]], i32 [[TMP26]]
; CHECK-NEXT:    [[TMP27:%.*]] = extractelement <2 x i32> [[TMP25]], i64 1
; CHECK-NEXT:    [[G1:%.*]] = getelementptr inbounds i32, ptr [[BASE]], i32 [[TMP27]]
; CHECK-NEXT:    [[V0:%.*]] = load i32, ptr [[G0]], align 4
; CHECK-NEXT:    [[V1:%.*]] = load i32, ptr [[G1]], align 4
; CHECK-NEXT:    [[RES:%.*]] = add i32 [[V0]], [[V1]]
; CHECK-NEXT:    [[Z:%.*]] = zext i32 [[TMP28]] to i64
; CHECK-NEXT:    store volatile i64 [[Z]], ptr [[OUT1]], align 8
; CHECK-NEXT:    [[T:%.*]] = trunc i32 [[TMP29]] to i16
; CHECK-NEXT:    store volatile i16 [[T]], ptr [[OUT2]], align 2
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  br label %main.loop

main.loop:
  %a = phi i32 [ 0, %entry ], [ %a.rem, %main.loop ]
  %b = phi i32 [ 0, %entry ], [ %b.rem, %main.loop ]
  %b.or = or i32 %b, 1
  %b.rem = urem i32 %b.or, 65521
  %a.or = or i32 %a, 1
  %a.rem = urem i32 %a.or, 65521
  br i1 %c1, label %tail.ph, label %main.loop

tail.ph:
  br label %tail.loop

tail.loop:
  %iv = phi i64 [ 0, %tail.ph ], [ %iv.next, %tail.loop ]
  %p0 = getelementptr inbounds nuw i8, ptr %p, i64 %iv
  %p1 = getelementptr inbounds nuw i8, ptr %p0, i64 1
  %x0 = load i8, ptr %p0, align 1
  %x1 = load i8, ptr %p1, align 1
  %z0 = zext i8 %x0 to i32
  %tb.0 = or i32 %b.rem, %z0
  %tb.next = xor i32 %tb.0, 17
  %z1 = zext i8 %x1 to i32
  %ta.0 = or i32 %a.rem, %z1
  %ta.next = xor i32 %ta.0, 19
  %iv.next = add nuw nsw i64 %iv, 2
  br i1 %c2, label %exit, label %tail.loop

exit:
  %q0p = getelementptr inbounds i32, ptr %q0, i64 1
  %q1p = getelementptr inbounds i32, ptr %q1, i64 1
  %q2p = getelementptr inbounds i32, ptr %q2, i64 1
  %q3p = getelementptr inbounds i32, ptr %q3, i64 1
  %l00 = load i32, ptr %q0, align 4
  %l01 = load i32, ptr %q0p, align 4
  %l10 = load i32, ptr %q1, align 4
  %l11 = load i32, ptr %q1p, align 4
  %l20 = load i32, ptr %q2, align 4
  %l21 = load i32, ptr %q2p, align 4
  %l30 = load i32, ptr %q3, align 4
  %l31 = load i32, ptr %q3p, align 4
  %r00 = add i32 %l00, 1
  %r01 = add i32 %l01, 2
  %r10 = sub i32 %l10, 3
  %r11 = sub i32 %l11, 4
  %r20 = xor i32 %l20, 5
  %r21 = xor i32 %l21, 6
  %r30 = add i32 %l30, 7
  %r31 = add i32 %l31, 8
  %r00b = sub i32 %r00, 11
  %r01b = sub i32 %r01, 13
  %s00 = xor i32 %r00b, 3
  %s01 = xor i32 %r01b, 5
  %s10 = add i32 %r10, 7
  %s11 = add i32 %r11, 11
  %s20 = sub i32 %r20, 13
  %s21 = sub i32 %r21, 17
  %s30 = xor i32 %r30, 19
  %s31 = xor i32 %r31, 23
  %t00 = xor i32 %s00, %s10
  %t01 = xor i32 %s01, %s11
  %t10 = add i32 %s20, %s30
  %t11 = add i32 %s21, %s31
  %u0 = sub i32 %t00, %t10
  %u1 = sub i32 %t01, %t11
  %ta.e = add i32 %ta.next, 31
  %tb.e = add i32 %tb.next, 37
  %c0 = xor i32 %u0, %ta.e
  %c1v = xor i32 %u1, %tb.e
  %g0 = getelementptr inbounds i32, ptr %base, i32 %c0
  %g1 = getelementptr inbounds i32, ptr %base, i32 %c1v
  %v0 = load i32, ptr %g0, align 4
  %v1 = load i32, ptr %g1, align 4
  %res = add i32 %v0, %v1
  %z = zext i32 %ta.e to i64
  store volatile i64 %z, ptr %out1, align 8
  %t = trunc i32 %tb.e to i16
  store volatile i16 %t, ptr %out2, align 2
  ret i32 %res
}

; The retried store tree goes before the FMA candidate, so the scalar fma stays.
define double @fma_preempt_order(ptr %p, ptr %out, double %x0, double %x1, i1 %c1, i1 %c2) {
; CHECK-LABEL: define double @fma_preempt_order(
; CHECK-SAME: ptr [[P:%.*]], ptr [[OUT:%.*]], double [[X0:%.*]], double [[X1:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[MAIN_LOOP:.*]]
; CHECK:       [[MAIN_LOOP]]:
; CHECK-NEXT:    [[TMP0:%.*]] = phi <2 x i32> [ zeroinitializer, %[[ENTRY]] ], [ [[TMP2:%.*]], %[[MAIN_LOOP]] ]
; CHECK-NEXT:    [[TMP1:%.*]] = or <2 x i32> [[TMP0]], splat (i32 1)
; CHECK-NEXT:    [[TMP2]] = urem <2 x i32> [[TMP1]], splat (i32 65521)
; CHECK-NEXT:    br i1 [[C1]], label %[[TAIL_PH:.*]], label %[[MAIN_LOOP]]
; CHECK:       [[TAIL_PH]]:
; CHECK-NEXT:    [[TMP3:%.*]] = load <2 x i8>, ptr [[P]], align 1
; CHECK-NEXT:    br label %[[TAIL_LOOP:.*]]
; CHECK:       [[TAIL_LOOP]]:
; CHECK-NEXT:    [[TMP4:%.*]] = phi <2 x i32> [ [[TMP7:%.*]], %[[TAIL_LOOP]] ], [ [[TMP2]], %[[TAIL_PH]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = zext <2 x i8> [[TMP3]] to <2 x i32>
; CHECK-NEXT:    [[TMP6:%.*]] = shufflevector <2 x i32> [[TMP5]], <2 x i32> poison, <2 x i32> <i32 1, i32 0>
; CHECK-NEXT:    [[TMP7]] = or <2 x i32> [[TMP4]], [[TMP6]]
; CHECK-NEXT:    br i1 [[C2]], label %[[EXIT:.*]], label %[[TAIL_LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP8:%.*]] = urem <2 x i32> [[TMP7]], splat (i32 65521)
; CHECK-NEXT:    [[TMP9:%.*]] = sitofp <2 x i32> [[TMP8]] to <2 x double>
; CHECK-NEXT:    [[TMP13:%.*]] = insertelement <2 x double> poison, double [[X0]], i64 0
; CHECK-NEXT:    [[TMP14:%.*]] = insertelement <2 x double> [[TMP13]], double [[X1]], i64 1
; CHECK-NEXT:    [[TMP12:%.*]] = fmul contract <2 x double> [[TMP9]], [[TMP14]]
; CHECK-NEXT:    [[F:%.*]] = call reassoc contract double @llvm.vector.reduce.fadd.v2f64(double -0.000000e+00, <2 x double> [[TMP12]])
; CHECK-NEXT:    [[TMP10:%.*]] = extractelement <2 x double> [[TMP9]], i64 0
; CHECK-NEXT:    [[D2:%.*]] = fadd double [[TMP10]], 1.000000e+00
; CHECK-NEXT:    [[TMP11:%.*]] = extractelement <2 x double> [[TMP9]], i64 1
; CHECK-NEXT:    [[D3:%.*]] = fadd double [[TMP11]], 2.000000e+00
; CHECK-NEXT:    [[O1:%.*]] = getelementptr inbounds double, ptr [[OUT]], i64 1
; CHECK-NEXT:    [[O2:%.*]] = getelementptr inbounds double, ptr [[OUT]], i64 2
