; CHECK-NEXT:    store double [[TMP10]], ptr [[OUT]], align 8
; CHECK-NEXT:    store double [[TMP11]], ptr [[O1]], align 8
; CHECK-NEXT:    store double [[D2]], ptr [[O2]], align 8
; CHECK-NEXT:    store double [[D3]], ptr [[O3]], align 8
; CHECK-NEXT:    ret double [[F]]
;
entry:
  br label %main.loop

main.loop:
  %a = phi i32 [ 0, %entry ], [ %a.rem, %main.loop ]
  %b = phi i32 [ 0, %entry ], [ %b.rem, %main.loop ]
  %b.or = or i32 %b, 1
  %b.rem = urem i32 %b.or, 65521
  %a.or = or i32 %a, 1
  %a.rem = urem i32 %a.or, 65521
  br i1 %c1, label %tail.ph, label %main.loop

tail.ph:
  %p1 = getelementptr inbounds nuw i8, ptr %p, i64 1
  %b0 = load i8, ptr %p, align 1
  %b1 = load i8, ptr %p1, align 1
  br label %tail.loop

tail.loop:
  %ta = phi i32 [ %ta.next, %tail.loop ], [ %a.rem, %tail.ph ]
  %tb = phi i32 [ %tb.next, %tail.loop ], [ %b.rem, %tail.ph ]
  %z0 = zext i8 %b0 to i32
  %tb.next = or i32 %tb, %z0
  %z1 = zext i8 %b1 to i32
  %ta.next = or i32 %ta, %z1
  br i1 %c2, label %exit, label %tail.loop

exit:
  %ta.rem = urem i32 %ta.next, 65521
  %tb.rem = urem i32 %tb.next, 65521
  %d0 = sitofp i32 %ta.rem to double
  %d1 = sitofp i32 %tb.rem to double
  %m0 = fmul contract double %d0, %x0
  %m1 = fmul contract double %d1, %x1
  %f = fadd contract double %m0, %m1
  %d2 = fadd double %d0, 1.0
  %d3 = fadd double %d1, 2.0
  %o1 = getelementptr inbounds double, ptr %out, i64 1
  %o2 = getelementptr inbounds double, ptr %out, i64 2
  %o3 = getelementptr inbounds double, ptr %out, i64 3
  store double %d0, ptr %out, align 8
  store double %d1, ptr %o1, align 8
  store double %d2, ptr %o2, align 8
  store double %d3, ptr %o3, align 8
  ret double %f
}
