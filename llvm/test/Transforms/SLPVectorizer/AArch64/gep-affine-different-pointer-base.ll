; RUN: opt -S -passes='function(loop-load-elim,lcssa,slp-vectorizer)' -mtriple=aarch64-unknown-linux-gnu < %s | FileCheck %s

; SCEV of %gep2 is computed before LCSSA formation and is based on null, while
; SCEV of %gep1 is based on the LCSSA merge phi, so their difference cannot be
; computed.

define void @test(i1 %c) {
; CHECK-LABEL: define void @test(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[BASE:%.*]] = getelementptr i8, ptr null, i64 16
; CHECK-NEXT:    br i1 [[C]], label %[[LATCH:.*]], label %[[EXIT1:.*]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    br i1 false, label %[[OUTER]], label %[[EXIT2:.*]]
; CHECK:       [[EXIT1]]:
; CHECK-NEXT:    [[BASE_LCSSA:%.*]] = phi ptr [ [[BASE]], %[[OUTER]] ]
; CHECK-NEXT:    br label %[[PH:.*]]
; CHECK:       [[EXIT2]]:
; CHECK-NEXT:    [[BASE_LCSSA1:%.*]] = phi ptr [ [[BASE]], %[[LATCH]] ]
; CHECK-NEXT:    br label %[[PH]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    [[BASE2:%.*]] = phi ptr [ [[BASE_LCSSA1]], %[[EXIT2]] ], [ [[BASE_LCSSA]], %[[EXIT1]] ]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr [4 x i8], ptr [[BASE2]], i64 [[IV]]
; CHECK-NEXT:    [[GEP2:%.*]] = getelementptr [4 x i8], ptr [[BASE2]], i64 [[IV]]
; CHECK-NEXT:    [[GEP3:%.*]] = getelementptr i8, ptr [[GEP2]], i64 4
; CHECK-NEXT:    [[LOAD:%.*]] = load i32, ptr [[GEP3]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[CMP]], label %[[END:.*]], label %[[LOOP]]
; CHECK:       [[END]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %base = getelementptr i8, ptr null, i64 16
  br i1 %c, label %latch, label %exit1

latch:
  br i1 false, label %outer, label %exit2

exit1:
  br label %ph

exit2:
  br label %ph

ph:
  br label %loop

loop:
  %iv = phi i64 [ 0, %ph ], [ %iv.next, %loop ]
  %gep1 = getelementptr [4 x i8], ptr %base, i64 %iv
  %gep2 = getelementptr [4 x i8], ptr %base, i64 %iv
  %gep3 = getelementptr i8, ptr %gep2, i64 4
  %load = load i32, ptr %gep3, align 4
  %iv.next = add i64 %iv, 1
  %cmp = icmp eq i64 %iv.next, 0
  br i1 %cmp, label %end, label %loop

end:
  ret void
}
