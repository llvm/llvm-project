; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=slp-vectorizer -S -mtriple=aarch64 < %s | FileCheck %s

; FIXME: we should keep the scalar form here.
; The scalar shifts fold into the ANDs, while vectorizing requires an explicit
; non-uniform vector shift plus vector construction.

define void @folded_shift_logicals(ptr %out, i64 %x, i64 %mask) {
; CHECK-LABEL: define void @folded_shift_logicals(
; CHECK-SAME: ptr [[OUT:%.*]], i64 [[X:%.*]], i64 [[MASK:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x i64> poison, i64 [[X]], i64 0
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x i64> [[TMP1]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP3:%.*]] = lshr <4 x i64> [[TMP2]], <i64 1, i64 8, i64 9, i64 7>
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <4 x i64> poison, i64 [[MASK]], i64 0
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <4 x i64> [[TMP4]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP6:%.*]] = and <4 x i64> [[TMP3]], [[TMP5]]
; CHECK-NEXT:    store <4 x i64> [[TMP6]], ptr [[OUT]], align 8
; CHECK-NEXT:    ret void
;
  %s0 = lshr i64 %x, 1
  %r0 = and i64 %s0, %mask
  %s1 = lshr i64 %x, 8
  %r1 = and i64 %s1, %mask
  %s2 = lshr i64 %x, 9
  %r2 = and i64 %s2, %mask
  %s3 = lshr i64 %x, 7
  %r3 = and i64 %s3, %mask
  %p1 = getelementptr i64, ptr %out, i64 1
  %p2 = getelementptr i64, ptr %out, i64 2
  %p3 = getelementptr i64, ptr %out, i64 3
  store i64 %r0, ptr %out, align 8
  store i64 %r1, ptr %p1, align 8
  store i64 %r2, ptr %p2, align 8
  store i64 %r3, ptr %p3, align 8
  ret void
}
