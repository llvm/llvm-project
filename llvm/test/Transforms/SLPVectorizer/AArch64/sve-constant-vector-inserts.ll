; CHECK-NEXT:    [[TMP6:%.*]] = fmul fast <4 x double> [[TMP4]], [[TMP5]]
; CHECK-NEXT:    [[MUL6:%.*]] = call reassoc nsz double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP6]])
