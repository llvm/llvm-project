; The VF=2 instruction-count check must not count a splat that every user
; folds into an indexed FMLA (fmla v0.2d, v1.2d, v2.d[0]). The two Horner
; chains of a rational approximation in x^2 share the splat of %x2.

define double @horner_pair(double %x) {
; CHECK-LABEL: define double @horner_pair(
; CHECK-SAME: double [[X:%.*]]) {
; CHECK-NEXT:    [[X2:%.*]] = fmul double [[X]], [[X]]
; CHECK-NEXT:    [[P0:%.*]] = fmul contract double [[X2]], f0x3F023DE10DFDF709
; CHECK-NEXT:    [[P1:%.*]] = fadd contract double [[P0]], f0x3F49EFE07501B288
; CHECK-NEXT:    [[P2:%.*]] = fmul contract double [[X2]], [[P1]]
; CHECK-NEXT:    [[P3:%.*]] = fadd contract double [[P2]], f0xBFA48228B5688F3B
; CHECK-NEXT:    [[P4:%.*]] = fmul contract double [[X2]], [[P3]]
; CHECK-NEXT:    [[P5:%.*]] = fadd contract double [[P4]], f0x3FC9C1550E884455
; CHECK-NEXT:    [[Q0:%.*]] = fmul contract double [[X2]], f0x3FB3B8C5B12E9282
; CHECK-NEXT:    [[Q1:%.*]] = fadd contract double [[Q0]], f0xBFE6066C1B8D0159
; CHECK-NEXT:    [[Q2:%.*]] = fmul contract double [[X2]], [[Q1]]
; CHECK-NEXT:    [[Q3:%.*]] = fadd contract double [[Q2]], f0x40002AE59C598AC8
; CHECK-NEXT:    [[Q4:%.*]] = fmul contract double [[X2]], [[Q3]]
; CHECK-NEXT:    [[Q5:%.*]] = fadd contract double [[Q4]], 1.000000e+00
; CHECK-NEXT:    [[R:%.*]] = fdiv double [[P5]], [[Q5]]
; CHECK-NEXT:    ret double [[R]]
;
  %x2 = fmul double %x, %x
  %p0 = fmul contract double %x2, 0x3F023DE10DFDF709
  %p1 = fadd contract double %p0, 0x3F49EFE07501B288
  %p2 = fmul contract double %x2, %p1
  %p3 = fadd contract double %p2, 0xBFA48228B5688F3B
  %p4 = fmul contract double %x2, %p3
  %p5 = fadd contract double %p4, 0x3FC9C1550E884455
  %q0 = fmul contract double %x2, 0x3FB3B8C5B12E9282
  %q1 = fadd contract double %q0, 0xBFE6066C1B8D0159
  %q2 = fmul contract double %x2, %q1
  %q3 = fadd contract double %q2, 0x40002AE59C598AC8
  %q4 = fmul contract double %x2, %q3
  %q5 = fadd contract double %q4, 1.000000e+00
  %r = fdiv double %p5, %q5
  ret double %r
}

