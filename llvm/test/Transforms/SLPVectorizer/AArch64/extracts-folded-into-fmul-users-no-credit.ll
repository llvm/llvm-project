  %vptr = getelementptr <2 x double>, ptr %vp, i64 %i
  %v = load <2 x double>, ptr %vptr, align 16
  %sptr = getelementptr double, ptr %sp, i64 %i
  %s = load double, ptr %sptr, align 8
  %e0 = extractelement <2 x double> %v, i64 0
  %e1 = extractelement <2 x double> %v, i64 1
  %m0 = fmul fast double %e0, %a
  %m1 = fmul fast double %e1, %b
  %m2 = fmul fast double %s, %c
  %r0 = fadd fast double %m0, %m1
  %r = fadd fast double %r0, %m2
  %u0 = fmul fast double %e0, %s
  %u1 = fmul fast double %e1, %d
