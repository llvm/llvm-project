; The splat subtree for the zexts is not worth keeping: the splat gathers are
; cheaper as plain insertion sequences, and the paired arithmetic must still
; be vectorized.

define i32 @test1(ptr %p, ptr %q, i32 %seed) {
; CHECK-LABEL: define i32 @test1(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i32 [[SEED:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
