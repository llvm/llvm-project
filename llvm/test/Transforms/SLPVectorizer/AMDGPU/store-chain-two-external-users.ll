; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[TMP12:%.*]] = phi <2 x i32> [ [[TMP1]], %[[BB0]] ], [ [[TMP5]], %[[BB1]] ], [ [[TMP9]], %[[BB2]] ]
; CHECK-NEXT:    [[TMP13:%.*]] = phi <2 x i32> [ [[TMP3]], %[[BB0]] ], [ [[TMP7]], %[[BB1]] ], [ [[TMP11]], %[[BB2]] ]
