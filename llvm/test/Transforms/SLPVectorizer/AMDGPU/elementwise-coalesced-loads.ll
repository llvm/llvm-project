; Four zero extended bytes are inserted into a vector that is stored, inside a
; loop of 16 iterations. The byte loads coalesce, and the load saving that never
; materializes is cancelled in every iteration, so the loop body stays scalar.
define void @zext4_bv_loop(ptr addrspace(1) %a, ptr addrspace(1) %out) {
; CHECK-LABEL: define void @zext4_bv_loop(
; CHECK-SAME: ptr addrspace(1) [[A:%.*]], ptr addrspace(1) [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[OFF:%.*]] = shl i64 [[I]], 2
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[A]], i64 [[OFF]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i8>, ptr addrspace(1) [[P0]], align 4
; CHECK-NEXT:    [[V3:%.*]] = zext <4 x i8> [[TMP0]] to <4 x i32>
; CHECK-NEXT:    [[PO:%.*]] = getelementptr inbounds <4 x i32>, ptr addrspace(1) [[OUT]], i64 [[I]]
; CHECK-NEXT:    store <4 x i32> [[V3]], ptr addrspace(1) [[PO]], align 16
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[I_NEXT]], 16
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %off = shl i64 %i, 2
  %p0 = getelementptr inbounds i8, ptr addrspace(1) %a, i64 %off
  %p1 = getelementptr inbounds i8, ptr addrspace(1) %p0, i64 1
  %p2 = getelementptr inbounds i8, ptr addrspace(1) %p0, i64 2
  %p3 = getelementptr inbounds i8, ptr addrspace(1) %p0, i64 3
  %l0 = load i8, ptr addrspace(1) %p0, align 4
  %l1 = load i8, ptr addrspace(1) %p1, align 1
  %l2 = load i8, ptr addrspace(1) %p2, align 2
  %l3 = load i8, ptr addrspace(1) %p3, align 1
  %x0 = zext i8 %l0 to i32
  %x1 = zext i8 %l1 to i32
  %x2 = zext i8 %l2 to i32
  %x3 = zext i8 %l3 to i32
  %v0 = insertelement <4 x i32> poison, i32 %x0, i32 0
  %v1 = insertelement <4 x i32> %v0, i32 %x1, i32 1
  %v2 = insertelement <4 x i32> %v1, i32 %x2, i32 2
  %v3 = insertelement <4 x i32> %v2, i32 %x3, i32 3
  %po = getelementptr inbounds <4 x i32>, ptr addrspace(1) %out, i64 %i
  store <4 x i32> %v3, ptr addrspace(1) %po, align 16
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp ult i64 %i.next, 16
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

