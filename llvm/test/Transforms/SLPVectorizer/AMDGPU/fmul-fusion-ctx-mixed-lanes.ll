; RUN: opt -S -mtriple=amdgpu9.42-amd-amdhsa -passes=slp-vectorizer < %s | FileCheck %s

; gfx942 has no packed f64 ALU, so a scalar fmul that feeds a fusable fadd is
; free. The vector fmul must not get that discount from the context of lane 0
; alone. In mixed_lanes the fmuls in lanes 1-3 have a second use and do not
; fuse, so the vector fmul is not free and the reduction must stay scalar.

define double @mixed_lanes(ptr noalias %e, ptr %a, ptr %b) {
; CHECK-LABEL: define double @mixed_lanes(
; CHECK-SAME: ptr noalias [[E:%.*]], ptr [[A:%.*]], ptr [[B:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x double>, ptr [[A]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = load <4 x double>, ptr [[B]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = fmul reassoc contract <4 x double> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[M1:%.*]] = extractelement <4 x double> [[TMP3]], i64 1
; CHECK-NEXT:    store double [[M1]], ptr [[E]], align 8
; CHECK-NEXT:    [[E2:%.*]] = getelementptr inbounds double, ptr [[E]], i64 1
; CHECK-NEXT:    [[M2:%.*]] = extractelement <4 x double> [[TMP3]], i64 2
; CHECK-NEXT:    store double [[M2]], ptr [[E2]], align 8
; CHECK-NEXT:    [[E3:%.*]] = getelementptr inbounds double, ptr [[E]], i64 2
; CHECK-NEXT:    [[M3:%.*]] = extractelement <4 x double> [[TMP3]], i64 3
; CHECK-NEXT:    store double [[M3]], ptr [[E3]], align 8
; CHECK-NEXT:    [[S3:%.*]] = call reassoc contract double @llvm.vector.reduce.fadd.v4f64(double -0.000000e+00, <4 x double> [[TMP3]])
; CHECK-NEXT:    ret double [[S3]]
;
  %a0 = load double, ptr %a
  %b0 = load double, ptr %b
  %ap1 = getelementptr inbounds double, ptr %a, i64 1
  %bp1 = getelementptr inbounds double, ptr %b, i64 1
  %a1 = load double, ptr %ap1
  %b1 = load double, ptr %bp1
  %ap2 = getelementptr inbounds double, ptr %a, i64 2
  %bp2 = getelementptr inbounds double, ptr %b, i64 2
  %a2 = load double, ptr %ap2
  %b2 = load double, ptr %bp2
  %ap3 = getelementptr inbounds double, ptr %a, i64 3
  %bp3 = getelementptr inbounds double, ptr %b, i64 3
  %a3 = load double, ptr %ap3
  %b3 = load double, ptr %bp3
  %m0 = fmul reassoc contract double %a0, %b0
  %m1 = fmul reassoc contract double %a1, %b1
  %m2 = fmul reassoc contract double %a2, %b2
  %m3 = fmul reassoc contract double %a3, %b3
  store double %m1, ptr %e
  %e2 = getelementptr inbounds double, ptr %e, i64 1
  store double %m2, ptr %e2
  %e3 = getelementptr inbounds double, ptr %e, i64 2
  store double %m3, ptr %e3
  %s1 = fadd reassoc contract double %m0, %m1
  %s2 = fadd reassoc contract double %s1, %m2
  %s3 = fadd reassoc contract double %s2, %m3
  ret double %s3
}
