; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -passes=slp-vectorizer -slp-threshold=1 %s | FileCheck %s

; A computed value is splatted into a packed fmul. When every user of the value
; is a lane of the vectorized tree, no scalar copy of it stays live and the
; splat costs nothing extra. The two fmuls must not be counted as two scalar
; users. The threshold of 1 makes the one unit of cost decide.
define void @two_in_tree_users(ptr addrspace(1) %out, float %a, float %b, float %x0, float %x1) {
; CHECK-LABEL: define void @two_in_tree_users(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], float [[A:%.*]], float [[B:%.*]], float [[X0:%.*]], float [[X1:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[S:%.*]] = fadd float [[A]], [[B]]
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x float> poison, float [[X0]], i64 0
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x float> [[TMP1]], float [[X1]], i64 1
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <2 x float> poison, float [[S]], i64 0
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <2 x float> [[TMP3]], <2 x float> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP5:%.*]] = fmul <2 x float> [[TMP2]], [[TMP4]]
; CHECK-NEXT:    store <2 x float> [[TMP5]], ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    ret void
;
  %s = fadd float %a, %b
  %r0 = fmul float %x0, %s
  %r1 = fmul float %x1, %s
  store float %r0, ptr addrspace(1) %out, align 8
  %p = getelementptr float, ptr addrspace(1) %out, i32 1
  store float %r1, ptr addrspace(1) %p, align 4
  ret void
}

; The value is also stored as a scalar outside the tree, so the splat has to
; move it and the tree is not profitable at this threshold.
define void @one_external_user(ptr addrspace(1) %out, ptr addrspace(1) %o2, float %a, float %b, float %x0, float %x1) {
; CHECK-LABEL: define void @one_external_user(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], ptr addrspace(1) [[O2:%.*]], float [[A:%.*]], float [[B:%.*]], float [[X0:%.*]], float [[X1:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[S:%.*]] = fadd float [[A]], [[B]]
; CHECK-NEXT:    [[R0:%.*]] = fmul float [[X0]], [[S]]
; CHECK-NEXT:    [[R1:%.*]] = fmul float [[X1]], [[S]]
; CHECK-NEXT:    store float [[R0]], ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    [[P:%.*]] = getelementptr float, ptr addrspace(1) [[OUT]], i32 1
; CHECK-NEXT:    store float [[R1]], ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    store float [[S]], ptr addrspace(1) [[O2]], align 4
; CHECK-NEXT:    ret void
;
  %s = fadd float %a, %b
  %r0 = fmul float %x0, %s
  %r1 = fmul float %x1, %s
  store float %r0, ptr addrspace(1) %out, align 8
  %p = getelementptr float, ptr addrspace(1) %out, i32 1
  store float %r1, ptr addrspace(1) %p, align 4
  store float %s, ptr addrspace(1) %o2, align 4
  ret void
}
