; An alternate [fmul | fadd] node is emitted as a full vector fmul, a full
; vector fadd and a lane-select shuffle. The vector fmul only feeds the
; shuffle, so it cannot fuse into an fma even though the scalar fmul in lane 0
; feeds an fsub. Its cost must not get the fmul+fadd fusion discount.

; YAML-LABEL: Name:            StoresVectorized
; YAML-NEXT:  Function:        alt_fmul_fadd{{$}}
; YAML-NEXT:  Args:
; YAML-NEXT:    - String:          'Stores SLP vectorized with cost '
; YAML-NEXT:    - Cost:            '-1'

define void @alt_fmul_fadd(float %a0, float %a1, float %b0, float %b1, float %c0, float %c1, ptr addrspace(1) %out) {
; CHECK-LABEL: @alt_fmul_fadd(
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x float> poison, float [[A0:%.*]], i64 0
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x float> [[TMP1]], float [[A1:%.*]], i64 1
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <2 x float> poison, float [[B0:%.*]], i64 0
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <2 x float> [[TMP3]], float [[B1:%.*]], i64 1
; CHECK-NEXT:    [[TMP5:%.*]] = fmul contract <2 x float> [[TMP2]], [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = fadd contract <2 x float> [[TMP2]], [[TMP4]]
; CHECK-NEXT:    [[TMP7:%.*]] = shufflevector <2 x float> [[TMP5]], <2 x float> [[TMP6]], <2 x i32> <i32 0, i32 3>
; CHECK-NEXT:    [[TMP8:%.*]] = insertelement <2 x float> poison, float [[C0:%.*]], i64 0
; CHECK-NEXT:    [[TMP9:%.*]] = insertelement <2 x float> [[TMP8]], float [[C1:%.*]], i64 1
; CHECK-NEXT:    [[TMP10:%.*]] = fsub contract <2 x float> [[TMP7]], [[TMP9]]
; CHECK-NEXT:    store <2 x float> [[TMP10]], ptr addrspace(1) [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
  %m0 = fmul contract float %a0, %b0
  %s1 = fadd contract float %a1, %b1
  %r0 = fsub contract float %m0, %c0
  %r1 = fsub contract float %s1, %c1
  store float %r0, ptr addrspace(1) %out, align 4
  %out1 = getelementptr inbounds float, ptr addrspace(1) %out, i64 1
  store float %r1, ptr addrspace(1) %out1, align 4
  ret void
}

; YAML-LABEL: Name:            StoresVectorized
; YAML-NEXT:  Function:        alt_fmul_fadd_loads{{$}}
; YAML-NEXT:  Args:
; YAML-NEXT:    - String:          'Stores SLP vectorized with cost '
; YAML-NEXT:    - Cost:            '-4'

define void @alt_fmul_fadd_loads(ptr addrspace(1) %pa, ptr addrspace(1) %pb, ptr addrspace(1) %pc, ptr addrspace(1) %out) {
; CHECK-LABEL: @alt_fmul_fadd_loads(
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x float>, ptr addrspace(1) [[PA:%.*]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = load <2 x float>, ptr addrspace(1) [[PB:%.*]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = load <2 x float>, ptr addrspace(1) [[PC:%.*]], align 4
; CHECK-NEXT:    [[TMP4:%.*]] = fmul contract <2 x float> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[TMP5:%.*]] = fadd contract <2 x float> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[TMP6:%.*]] = shufflevector <2 x float> [[TMP4]], <2 x float> [[TMP5]], <2 x i32> <i32 0, i32 3>
; CHECK-NEXT:    [[TMP7:%.*]] = fsub contract <2 x float> [[TMP6]], [[TMP3]]
; CHECK-NEXT:    store <2 x float> [[TMP7]], ptr addrspace(1) [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
  %a0 = load float, ptr addrspace(1) %pa, align 4
  %pa1 = getelementptr inbounds float, ptr addrspace(1) %pa, i64 1
  %a1 = load float, ptr addrspace(1) %pa1, align 4
  %b0 = load float, ptr addrspace(1) %pb, align 4
  %pb1 = getelementptr inbounds float, ptr addrspace(1) %pb, i64 1
  %b1 = load float, ptr addrspace(1) %pb1, align 4
  %c0 = load float, ptr addrspace(1) %pc, align 4
  %pc1 = getelementptr inbounds float, ptr addrspace(1) %pc, i64 1
  %c1 = load float, ptr addrspace(1) %pc1, align 4
  %m0 = fmul contract float %a0, %b0
  %s1 = fadd contract float %a1, %b1
  %r0 = fsub contract float %m0, %c0
  %r1 = fsub contract float %s1, %c1
  store float %r0, ptr addrspace(1) %out, align 4
  %out1 = getelementptr inbounds float, ptr addrspace(1) %out, i64 1
  store float %r1, ptr addrspace(1) %out1, align 4
  ret void
}
