  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %off = shl i32 %i, 2
  %pa0 = getelementptr inbounds i8, ptr addrspace(1) %a, i32 %off
  %la0 = load i8, ptr addrspace(1) %pa0, align 1
  %xa0 = zext i8 %la0 to i32
  %pa1 = getelementptr inbounds i8, ptr addrspace(1) %pa0, i32 1
  %la1 = load i8, ptr addrspace(1) %pa1, align 1
  %xa1 = zext i8 %la1 to i32
