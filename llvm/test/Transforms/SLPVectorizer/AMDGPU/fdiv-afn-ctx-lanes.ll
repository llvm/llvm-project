; CHECK-NEXT:    [[TMP3:%.*]] = load <2 x float>, ptr [[A]], align 4
; CHECK-NEXT:    [[TMP4:%.*]] = load <2 x float>, ptr [[B]], align 4
; CHECK-NEXT:    [[TMP5:%.*]] = fdiv <2 x float> [[TMP3]], [[TMP4]]
