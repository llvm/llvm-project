  %idx1 = getelementptr inbounds i8, ptr %idx, i64 8
  %b = load i64, ptr %idx1, align 8
  %x0 = xor i64 %a, 1234
  %x1 = xor i64 %b, 1234
  %i0 = and i64 %x0, 1023
  %i1 = and i64 %x1, 1023
