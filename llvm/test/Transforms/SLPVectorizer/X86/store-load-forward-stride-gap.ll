; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=slp-vectorizer -S -mtriple=x86_64-- -mcpu=znver5 | FileCheck %s

; The loop stride is 6 i32s (24 bytes) and the widened store is 16 bytes, so
; successive stores do not tile memory. The load A[i-6..i-3] is exactly the
; previous iteration's store. Forwarding succeeds, and the chain stays <4 x i32>.
define void @stride_gap_exact(ptr noalias %A, i64 %n) {
; CHECK-LABEL: define void @stride_gap_exact(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[LI0:%.*]] = add i64 [[I]], -6
; CHECK-NEXT:    [[LP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[LI0]]
; CHECK-NEXT:    [[SP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[LP0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[TMP0]], <i32 1, i32 2, i32 3, i32 4>
; CHECK-NEXT:    store <4 x i32> [[TMP1]], ptr [[SP0]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 6
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %li0 = add i64 %i, -6
  %lp0 = getelementptr inbounds i32, ptr %A, i64 %li0
  %li1 = add i64 %i, -5
  %lp1 = getelementptr inbounds i32, ptr %A, i64 %li1
  %li2 = add i64 %i, -4
  %lp2 = getelementptr inbounds i32, ptr %A, i64 %li2
  %li3 = add i64 %i, -3
  %lp3 = getelementptr inbounds i32, ptr %A, i64 %li3
  %l0 = load i32, ptr %lp0, align 4
  %l1 = load i32, ptr %lp1, align 4
  %l2 = load i32, ptr %lp2, align 4
  %l3 = load i32, ptr %lp3, align 4
  %v0 = add i32 %l0, 1
  %v1 = add i32 %l1, 2
  %v2 = add i32 %l2, 3
  %v3 = add i32 %l3, 4
  %si1 = add i64 %i, 1
  %si2 = add i64 %i, 2
  %si3 = add i64 %i, 3
  %sp0 = getelementptr inbounds i32, ptr %A, i64 %i
  %sp1 = getelementptr inbounds i32, ptr %A, i64 %si1
  %sp2 = getelementptr inbounds i32, ptr %A, i64 %si2
  %sp3 = getelementptr inbounds i32, ptr %A, i64 %si3
  store i32 %v0, ptr %sp0, align 4
  store i32 %v1, ptr %sp1, align 4
  store i32 %v2, ptr %sp2, align 4
  store i32 %v3, ptr %sp3, align 4
  %i.next = add nuw nsw i64 %i, 6
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

