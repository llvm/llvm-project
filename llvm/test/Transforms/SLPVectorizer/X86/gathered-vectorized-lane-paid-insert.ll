; RUN: opt -passes=slp-vectorizer -S -mtriple=x86_64-unknown-linux-gnu -mcpu=skylake -pass-remarks-output=%t < %s | FileCheck %s
; RUN: FileCheck --input-file=%t --check-prefix=COST %s

; The operand gather takes lane 0 from the vectorized loads and the other
; lanes are constants, so the lane 0 insert is not into a poison vector and
; is paid.

; COST:      --- !Passed
; COST-NEXT: Pass:            slp-vectorizer
; COST-NEXT: Name:            StoresVectorized
; COST-NEXT: Function:        lane_and_constants
; COST:        - Cost:            '-8'

define void @lane_and_constants(ptr noalias %a, ptr noalias %out) {
; CHECK-LABEL: define void @lane_and_constants(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[OUT:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x float>, ptr [[A]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x float> <float poison, float 2.000000e+00, float 3.000000e+00, float 4.000000e+00>, <4 x float> [[TMP1]], <4 x i32> <i32 7, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[TMP3:%.*]] = fmul <4 x float> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    store <4 x float> [[TMP3]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
  %p1 = getelementptr float, ptr %a, i64 1
  %p2 = getelementptr float, ptr %a, i64 2
  %p3 = getelementptr float, ptr %a, i64 3
  %a0 = load float, ptr %a, align 4
  %a1 = load float, ptr %p1, align 4
  %a2 = load float, ptr %p2, align 4
  %a3 = load float, ptr %p3, align 4
  %m0 = fmul float %a0, %a3
  %m1 = fmul float %a1, 2.0
  %m2 = fmul float %a2, 3.0
  %m3 = fmul float %a3, 4.0
  %o1 = getelementptr float, ptr %out, i64 1
  %o2 = getelementptr float, ptr %out, i64 2
  %o3 = getelementptr float, ptr %out, i64 3
  store float %m0, ptr %out, align 4
  store float %m1, ptr %o1, align 4
  store float %m2, ptr %o2, align 4
  store float %m3, ptr %o3, align 4
  ret void
}
