; load 20 bytes behind the 16-byte <4 x i32> store at A[i] (20 % 16 = 4 ->
; misaligned, the 16-byte load overruns into the next widened store), a genuine
; forwarding conflict.
define void @stlf_profitable(ptr noalias %A, i64 %n) {
