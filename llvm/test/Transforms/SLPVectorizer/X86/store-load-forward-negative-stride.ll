; Widened load/store pairs in loops with a descending induction variable.

define void @negative_stride_no_conflict(ptr noalias %A, i64 %n) {
; CHECK-LABEL: define void @negative_stride_no_conflict(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[FOR_BODY:.*]]
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 64, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[BM16:%.*]] = add i64 [[I]], -16
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[BM16]]
; CHECK-NEXT:    [[S0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[P0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[TMP0]], splat (i32 1)
; CHECK-NEXT:    [[TMP2:%.*]] = trunc <4 x i32> [[TMP1]] to <4 x i8>
; CHECK-NEXT:    store <4 x i8> [[TMP2]], ptr [[S0]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nsw i64 [[I]], -16
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[FOR_BODY]], label %[[FOR_END:.*]]
; CHECK:       [[FOR_END]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %for.body

for.body:
  %i = phi i64 [ 64, %entry ], [ %i.next, %for.body ]
  %bm16 = add i64 %i, -16
  %bm12 = add i64 %i, -12
  %bm8 = add i64 %i, -8
  %bm4 = add i64 %i, -4
  %p0 = getelementptr inbounds i8, ptr %A, i64 %bm16
  %p1 = getelementptr inbounds i8, ptr %A, i64 %bm12
  %p2 = getelementptr inbounds i8, ptr %A, i64 %bm8
  %p3 = getelementptr inbounds i8, ptr %A, i64 %bm4
  %l0 = load i32, ptr %p0, align 4
  %l1 = load i32, ptr %p1, align 4
  %l2 = load i32, ptr %p2, align 4
  %l3 = load i32, ptr %p3, align 4
  %a0 = add i32 %l0, 1
  %a1 = add i32 %l1, 1
  %a2 = add i32 %l2, 1
  %a3 = add i32 %l3, 1
  %t0 = trunc i32 %a0 to i8
  %t1 = trunc i32 %a1 to i8
  %t2 = trunc i32 %a2 to i8
  %t3 = trunc i32 %a3 to i8
  %i1 = add i64 %i, 1
  %i2 = add i64 %i, 2
  %i3 = add i64 %i, 3
  %s0 = getelementptr inbounds i8, ptr %A, i64 %i
  %s1 = getelementptr inbounds i8, ptr %A, i64 %i1
  %s2 = getelementptr inbounds i8, ptr %A, i64 %i2
  %s3 = getelementptr inbounds i8, ptr %A, i64 %i3
  store i8 %t0, ptr %s0, align 1
  store i8 %t1, ptr %s1, align 1
  store i8 %t2, ptr %s2, align 1
  store i8 %t3, ptr %s3, align 1
  %i.next = add nsw i64 %i, -16
  %cmp = icmp sgt i64 %i.next, %n
  br i1 %cmp, label %for.body, label %for.end

for.end:
  ret void
}

; Descending loop: the store A[i..i+3] moves down 16 bytes per iteration, so
; the bytes written by earlier iterations lie above it. The <4 x i32> load
; A[i+6..i+9] straddles the windows stored one and two iterations ago
; (A[i+4..i+7] and A[i+8..i+11]), the mirror image of an ascending loop loading
; A[i-6..i-3]. Vectorization is rejected.
define void @negative_stride_conflict_above(ptr noalias %a, i64 %n) {
; CHECK-LABEL: define void @negative_stride_conflict_above(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[N]], %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[L0P:%.*]] = add i64 [[I]], 6
; CHECK-NEXT:    [[G0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[L0P]]
; CHECK-NEXT:    [[S0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[G0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[TMP0]], <i32 1, i32 2, i32 3, i32 4>
; CHECK-NEXT:    store <4 x i32> [[TMP1]], ptr [[S0]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], -4
; CHECK-NEXT:    [[C:%.*]] = icmp sgt i64 [[I_NEXT]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %i = phi i64 [ %n, %entry ], [ %i.next, %loop ]
  %l0p = add i64 %i, 6
  %l1p = add i64 %i, 7
  %l2p = add i64 %i, 8
  %l3p = add i64 %i, 9
  %g0 = getelementptr inbounds i32, ptr %a, i64 %l0p
  %g1 = getelementptr inbounds i32, ptr %a, i64 %l1p
  %g2 = getelementptr inbounds i32, ptr %a, i64 %l2p
  %g3 = getelementptr inbounds i32, ptr %a, i64 %l3p
  %x0 = load i32, ptr %g0, align 4
  %x1 = load i32, ptr %g1, align 4
  %x2 = load i32, ptr %g2, align 4
  %x3 = load i32, ptr %g3, align 4
  %y0 = add i32 %x0, 1
  %y1 = add i32 %x1, 2
  %y2 = add i32 %x2, 3
  %y3 = add i32 %x3, 4
  %i1 = add i64 %i, 1
  %i2 = add i64 %i, 2
  %i3 = add i64 %i, 3
  %s0 = getelementptr inbounds i32, ptr %a, i64 %i
  %s1 = getelementptr inbounds i32, ptr %a, i64 %i1
  %s2 = getelementptr inbounds i32, ptr %a, i64 %i2
  %s3 = getelementptr inbounds i32, ptr %a, i64 %i3
  store i32 %y0, ptr %s0, align 4
  store i32 %y1, ptr %s1, align 4
  store i32 %y2, ptr %s2, align 4
  store i32 %y3, ptr %s3, align 4
  %i.next = add i64 %i, -4
  %c = icmp sgt i64 %i.next, 0
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

