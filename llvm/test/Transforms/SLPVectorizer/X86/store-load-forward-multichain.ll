; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=slp-vectorizer -S -slp-max-reg-size=128 -mtriple=x86_64-- \
; RUN:   -mcpu=znver5 < %s | FileCheck %s

; Two independent store chains to A[i..i+3] and A[i+4..i+7], and a widened
; backward load A[i-5..i-2] feeding a third chain to Out[i..i+3].

define void @stlf_multichain(ptr noalias %A, ptr noalias %Out, i64 %n) {
; CHECK-LABEL: define void @stlf_multichain(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[OUT:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 8, %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[LM5:%.*]] = add i64 [[I]], -5
; CHECK-NEXT:    [[LP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[LM5]]
; CHECK-NEXT:    [[O0:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[I]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[LP0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = xor <4 x i32> [[TMP0]], <i32 17, i32 19, i32 23, i32 29>
; CHECK-NEXT:    [[TMP2:%.*]] = mul <4 x i32> [[TMP1]], <i32 3, i32 5, i32 7, i32 9>
; CHECK-NEXT:    [[TMP3:%.*]] = add <4 x i32> [[TMP2]], <i32 31, i32 37, i32 41, i32 43>
; CHECK-NEXT:    [[TMP4:%.*]] = xor <4 x i32> [[TMP3]], <i32 47, i32 53, i32 59, i32 61>
; CHECK-NEXT:    store <4 x i32> [[TMP4]], ptr [[O0]], align 4
; CHECK-NEXT:    [[I4:%.*]] = add nuw nsw i64 [[I]], 4
; CHECK-NEXT:    [[I8:%.*]] = add nuw nsw i64 [[I]], 8
; CHECK-NEXT:    [[O4:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[I4]]
; CHECK-NEXT:    [[O8:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[I8]]
; CHECK-NEXT:    store <4 x i32> <i32 1, i32 2, i32 3, i32 4>, ptr [[O4]], align 4
; CHECK-NEXT:    store <4 x i32> <i32 5, i32 6, i32 7, i32 8>, ptr [[O8]], align 4
; CHECK-NEXT:    [[A0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    store <4 x i32> <i32 111, i32 222, i32 333, i32 444>, ptr [[A0]], align 4
; CHECK-NEXT:    [[B0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I4]]
; CHECK-NEXT:    store <4 x i32> <i32 555, i32 666, i32 777, i32 888>, ptr [[B0]], align 4
; CHECK-NEXT:    [[NEXT]] = add nuw nsw i64 [[I]], 8
; CHECK-NEXT:    [[DONE:%.*]] = icmp uge i64 [[NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 8, %entry ], [ %next, %loop ]

  %lm5 = add i64 %i, -5
  %lm4 = add i64 %i, -4
  %lm3 = add i64 %i, -3
  %lm2 = add i64 %i, -2
  %lp0 = getelementptr inbounds i32, ptr %A, i64 %lm5
  %lp1 = getelementptr inbounds i32, ptr %A, i64 %lm4
  %lp2 = getelementptr inbounds i32, ptr %A, i64 %lm3
  %lp3 = getelementptr inbounds i32, ptr %A, i64 %lm2
  %l0 = load i32, ptr %lp0, align 4
  %l1 = load i32, ptr %lp1, align 4
  %l2 = load i32, ptr %lp2, align 4
  %l3 = load i32, ptr %lp3, align 4

  ; Chain of ops on the loaded values profitable enough to widen the load
  ; despite the hazard-for-load STLF charge it pays on its own.
  %u0 = xor i32 %l0, 17
  %u1 = xor i32 %l1, 19
  %u2 = xor i32 %l2, 23
  %u3 = xor i32 %l3, 29
  %x0 = mul i32 %u0, 3
  %x1 = mul i32 %u1, 5
  %x2 = mul i32 %u2, 7
  %x3 = mul i32 %u3, 9
  %y0 = add i32 %x0, 31
  %y1 = add i32 %x1, 37
  %y2 = add i32 %x2, 41
  %y3 = add i32 %x3, 43
  %z0 = xor i32 %y0, 47
  %z1 = xor i32 %y1, 53
  %z2 = xor i32 %y2, 59
  %z3 = xor i32 %y3, 61

  %i1 = add nuw nsw i64 %i, 1
  %i2 = add nuw nsw i64 %i, 2
  %i3 = add nuw nsw i64 %i, 3
  %o0 = getelementptr inbounds i32, ptr %Out, i64 %i
  %o1 = getelementptr inbounds i32, ptr %Out, i64 %i1
  %o2 = getelementptr inbounds i32, ptr %Out, i64 %i2
  %o3 = getelementptr inbounds i32, ptr %Out, i64 %i3
  store i32 %z0, ptr %o0, align 4
  store i32 %z1, ptr %o1, align 4
  store i32 %z2, ptr %o2, align 4
  store i32 %z3, ptr %o3, align 4

  ; Unrelated constants to Out[i+4..i+11]. They make the Out store group longer
  ; than the A group, so SLP (which visits longer store groups first) commits
  ; the widened load before it costs chains A and B.
  %i4 = add nuw nsw i64 %i, 4
  %i5 = add nuw nsw i64 %i, 5
  %i6 = add nuw nsw i64 %i, 6
  %i7 = add nuw nsw i64 %i, 7
  %i8 = add nuw nsw i64 %i, 8
  %i9 = add nuw nsw i64 %i, 9
  %i10 = add nuw nsw i64 %i, 10
  %i11 = add nuw nsw i64 %i, 11
  %o4 = getelementptr inbounds i32, ptr %Out, i64 %i4
  %o5 = getelementptr inbounds i32, ptr %Out, i64 %i5
  %o6 = getelementptr inbounds i32, ptr %Out, i64 %i6
  %o7 = getelementptr inbounds i32, ptr %Out, i64 %i7
  %o8 = getelementptr inbounds i32, ptr %Out, i64 %i8
  %o9 = getelementptr inbounds i32, ptr %Out, i64 %i9
  %o10 = getelementptr inbounds i32, ptr %Out, i64 %i10
  %o11 = getelementptr inbounds i32, ptr %Out, i64 %i11
  store i32 1, ptr %o4, align 4
  store i32 2, ptr %o5, align 4
  store i32 3, ptr %o6, align 4
  store i32 4, ptr %o7, align 4
  store i32 5, ptr %o8, align 4
  store i32 6, ptr %o9, align 4
  store i32 7, ptr %o10, align 4
  store i32 8, ptr %o11, align 4

  ; Chain A: A[i..i+3], constants unrelated to the loaded/computed values.
  %a0 = getelementptr inbounds i32, ptr %A, i64 %i
  %a1 = getelementptr inbounds i32, ptr %A, i64 %i1
  %a2 = getelementptr inbounds i32, ptr %A, i64 %i2
  %a3 = getelementptr inbounds i32, ptr %A, i64 %i3
  store i32 111, ptr %a0, align 4
  store i32 222, ptr %a1, align 4
  store i32 333, ptr %a2, align 4
  store i32 444, ptr %a3, align 4

  ; Chain B: A[i+4..i+7], also unrelated constants.
  %b0 = getelementptr inbounds i32, ptr %A, i64 %i4
  %b1 = getelementptr inbounds i32, ptr %A, i64 %i5
  %b2 = getelementptr inbounds i32, ptr %A, i64 %i6
  %b3 = getelementptr inbounds i32, ptr %A, i64 %i7
  store i32 555, ptr %b0, align 4
  store i32 666, ptr %b1, align 4
  store i32 777, ptr %b2, align 4
  store i32 888, ptr %b3, align 4

  %next = add nuw nsw i64 %i, 8
  %done = icmp uge i64 %next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}
