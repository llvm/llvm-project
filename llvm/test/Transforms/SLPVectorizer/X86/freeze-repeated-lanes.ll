; RUN: opt -passes=slp-vectorizer -S -mtriple=x86_64-unknown-linux-gnu -mcpu=x86-64-v3 -slp-threshold=-1000 < %s | FileCheck %s

; A freeze, repeated in several lanes, is a single value: the vector freeze
; freezes the lanes independently, so the repeated lanes must be packed before
; the freeze.

define <4 x i32> @buildvector(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: define <4 x i32> @buildvector(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]], i32 [[Z:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x i32> poison, i32 [[X]], i64 0
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <4 x i32> [[TMP1]], i32 [[Y]], i64 2
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <4 x i32> [[TMP2]], i32 [[Z]], i64 3
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x i32> [[TMP3]], <4 x i32> poison, <4 x i32> <i32 0, i32 0, i32 2, i32 3>
; CHECK-NEXT:    [[TMP5:%.*]] = freeze <4 x i32> [[TMP4]]
; CHECK-NEXT:    ret <4 x i32> [[TMP5]]
;
  %fr = freeze i32 %x
  %fy = freeze i32 %y
  %fz = freeze i32 %z
  %i0 = insertelement <4 x i32> poison, i32 %fr, i32 0
  %i1 = insertelement <4 x i32> %i0, i32 %fr, i32 1
  %i2 = insertelement <4 x i32> %i1, i32 %fy, i32 2
  %i3 = insertelement <4 x i32> %i2, i32 %fz, i32 3
  ret <4 x i32> %i3
}

define i32 @or_of_selects(ptr %a, i32 %x) {
; CHECK-LABEL: define i32 @or_of_selects(
; CHECK-SAME: ptr [[A:%.*]], i32 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x i32> <i32 4, i32 poison, i32 poison, i32 poison>, i32 [[X]], i64 1
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x i32> [[TMP1]], <4 x i32> poison, <4 x i32> <i32 0, i32 1, i32 1, i32 1>
; CHECK-NEXT:    [[TMP3:%.*]] = freeze <4 x i32> [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = load <4 x i32>, ptr [[A]], align 4
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <4 x i32> <i32 poison, i32 4, i32 100, i32 5>, <4 x i32> [[TMP3]], <4 x i32> <i32 5, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ult <4 x i32> [[TMP5]], [[TMP3]]
; CHECK-NEXT:    [[TMP7:%.*]] = icmp eq <4 x i32> [[TMP5]], [[TMP3]]
; CHECK-NEXT:    [[TMP8:%.*]] = shufflevector <4 x i1> [[TMP6]], <4 x i1> [[TMP7]], <4 x i32> <i32 0, i32 5, i32 2, i32 7>
; CHECK-NEXT:    [[TMP9:%.*]] = select <4 x i1> [[TMP8]], <4 x i32> [[TMP4]], <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP10:%.*]] = call i32 @llvm.vector.reduce.or.v4i32(<4 x i32> [[TMP9]])
; CHECK-NEXT:    ret i32 [[TMP10]]
;
  %fr = freeze i32 %x
  %v0 = load i32, ptr %a, align 4
  %p1 = getelementptr inbounds nuw i8, ptr %a, i64 4
  %v1 = load i32, ptr %p1, align 4
  %p2 = getelementptr inbounds nuw i8, ptr %a, i64 8
  %v2 = load i32, ptr %p2, align 4
  %p3 = getelementptr inbounds nuw i8, ptr %a, i64 12
  %v3 = load i32, ptr %p3, align 4
  %c0 = icmp ult i32 %fr, 4
  %c1 = icmp eq i32 %fr, 4
  %c2 = icmp ugt i32 %fr, 100
  %c3 = icmp eq i32 %fr, 5
  %l0 = select i1 %c0, i32 %v0, i32 0
  %l1 = select i1 %c1, i32 %v1, i32 0
  %l2 = select i1 %c2, i32 %v2, i32 0
  %l3 = select i1 %c3, i32 %v3, i32 0
  %o1 = or i32 %l0, %l1
  %o2 = or i32 %o1, %l2
  %o3 = or i32 %o2, %l3
  ret i32 %o3
}

