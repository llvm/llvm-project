; NOPENALTY-NEXT:    [[BACK_IDX:%.*]] = sub i64 [[I]], 1
; NOPENALTY-NEXT:    [[BACK_GEP:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[BACK_IDX]]
; NOPENALTY-NEXT:    [[T:%.*]] = load i32, ptr [[BACK_GEP]], align 4
