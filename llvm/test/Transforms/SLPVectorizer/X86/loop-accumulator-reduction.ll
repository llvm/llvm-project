  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, 64
