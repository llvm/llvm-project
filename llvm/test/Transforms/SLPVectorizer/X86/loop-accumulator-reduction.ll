; Inner-loop accumulator initialized by an outer-loop phi that consumes the
; result: the final reduction and the insert of the initial value would be on
; the loop-carried chain of the outer loop, so no vector accumulator.
define double @nested_loops(ptr %p, i64 %n, i64 %m) {
;
; CHECK-LABEL: define double @nested_loops(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[OACC:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[TMP1:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 1, %[[OUTER]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi double [ [[OACC]], %[[OUTER]] ], [ [[OP_RDX:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr double, ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x double>, ptr [[P0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = call fast double @llvm.vector.reduce.fadd.v4f64(double 0.000000e+00, <4 x double> [[TMP0]])
; CHECK-NEXT:    [[OP_RDX]] = fadd fast double [[TMP2]], [[ACC]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV]], 64
; CHECK-NEXT:    br i1 [[CMP]], label %[[OUTER_LATCH]], label %[[LOOP]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[TMP1]] = phi double [ [[OP_RDX]], %[[LOOP]] ]
; CHECK-NEXT:    [[J_NEXT]] = add i64 [[J]], 1
; CHECK-NEXT:    [[OC:%.*]] = icmp eq i64 [[J_NEXT]], [[M]]
; CHECK-NEXT:    br i1 [[OC]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret double [[TMP1]]
;
entry:
  br label %outer

outer:
  %j = phi i64 [ 0, %entry ], [ %j.next, %outer.latch ]
  %oacc = phi double [ 0.0, %entry ], [ %e, %outer.latch ]
  br label %loop

loop:
  %iv = phi i64 [ 1, %outer ], [ %iv.next, %loop ]
  %acc = phi double [ %oacc, %outer ], [ %sum, %loop ]
  %p0 = getelementptr double, ptr %p, i64 %iv
  %l0 = load double, ptr %p0, align 8
  %p1 = getelementptr double, ptr %p0, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p0, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p0, i64 3
  %l3 = load double, ptr %p3, align 8
  %t0 = fadd fast double %l0, %acc
  %t1 = fadd fast double %t0, %l1
  %t2 = fadd fast double %t1, %l2
  %sum = fadd fast double %t2, %l3
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv, 64
  br i1 %cmp, label %outer.latch, label %loop

outer.latch:
  %e = phi double [ %sum, %loop ]
  %j.next = add i64 %j, 1
  %oc = icmp eq i64 %j.next, %m
  br i1 %oc, label %exit, label %outer

exit:
  ret double %e
}

