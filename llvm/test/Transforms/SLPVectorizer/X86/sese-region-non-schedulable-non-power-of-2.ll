; The stored values are in different blocks of the region, the stores are
; vectorized together, the values are vectorized in the region entry.
define void @chain(ptr %p, ptr %q, i1 %c) {
; CHECK-LABEL: define void @chain(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[X0:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 1
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x i32>, ptr [[P1]], align 4
; CHECK-NEXT:    br label %[[BB:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[A0:%.*]] = add i32 [[X0]], 1
; CHECK-NEXT:    br i1 [[C]], label %[[SIDE:.*]], label %[[MID:.*]]
; CHECK:       [[SIDE]]:
; CHECK-NEXT:    call void @foo()
; CHECK-NEXT:    br label %[[MID]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    [[TMP1:%.*]] = add <2 x i32> [[TMP0]], <i32 2, i32 3>
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    store i32 [[A0]], ptr [[Q]], align 4
; CHECK-NEXT:    [[Q1:%.*]] = getelementptr inbounds i32, ptr [[Q]], i64 1
; CHECK-NEXT:    store <2 x i32> [[TMP1]], ptr [[Q1]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %x0 = load i32, ptr %p, align 4
  %p1 = getelementptr inbounds i32, ptr %p, i64 1
  %x1 = load i32, ptr %p1, align 4
  %p2 = getelementptr inbounds i32, ptr %p, i64 2
  %x2 = load i32, ptr %p2, align 4
  br label %bb

bb:
  %a0 = add i32 %x0, 1
  br i1 %c, label %side, label %mid

side:
  call void @foo()
  br label %mid

mid:
  %a1 = add i32 %x1, 2
  %a2 = add i32 %x2, 3
  br label %exit

exit:
  store i32 %a0, ptr %q, align 4
  %q1 = getelementptr inbounds i32, ptr %q, i64 1
  store i32 %a1, ptr %q1, align 4
  %q2 = getelementptr inbounds i32, ptr %q, i64 2
  store i32 %a2, ptr %q2, align 4
  ret void
}

