; With REVEC, two <8 x i16> loads 48 bytes apart form a masked <32 x i16> load
; (64 bytes) that feeds a <16 x i16> store 160 bytes above it. A loop step of
; 96 bytes never re-reads the stored bytes; a step of 32 bytes does.

define void @revec_compress_no_reread(ptr %in, i64 %n) {
; CHECK-LABEL: define void @revec_compress_no_reread(
; CHECK-SAME: ptr [[IN:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[OFF:%.*]] = mul i64 [[I]], 96
; CHECK-NEXT:    [[BASE:%.*]] = getelementptr i8, ptr [[IN]], i64 [[OFF]]
; CHECK-NEXT:    [[L0_P:%.*]] = getelementptr i8, ptr [[BASE]], i64 0
; CHECK-NEXT:    [[S0_P:%.*]] = getelementptr i8, ptr [[BASE]], i64 160
; CHECK-NEXT:    [[TMP0:%.*]] = call <32 x i16> @llvm.masked.load.v32i16.p0(ptr align 2 [[L0_P]], <32 x i1> <i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 false, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true, i1 true>, <32 x i16> poison)
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <32 x i16> [[TMP0]], <32 x i16> poison, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
; CHECK-NEXT:    [[TMP2:%.*]] = or <16 x i16> zeroinitializer, [[TMP1]]
; CHECK-NEXT:    store <16 x i16> [[TMP2]], ptr [[S0_P]], align 2
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %off = mul i64 %i, 96
  %base = getelementptr i8, ptr %in, i64 %off
  %l0.p = getelementptr i8, ptr %base, i64 0
  %l1.p = getelementptr i8, ptr %base, i64 48
  %l0 = load <8 x i16>, ptr %l0.p, align 2
  %l1 = load <8 x i16>, ptr %l1.p, align 2
  %e0 = sext <8 x i16> %l0 to <8 x i32>
  %e1 = sext <8 x i16> %l1 to <8 x i32>
  %o0 = or <8 x i32> zeroinitializer, %e0
  %o1 = or <8 x i32> zeroinitializer, %e1
  %t0 = trunc <8 x i32> %o0 to <8 x i16>
  %t1 = trunc <8 x i32> %o1 to <8 x i16>
  %s0.p = getelementptr i8, ptr %base, i64 160
  %s1.p = getelementptr i8, ptr %base, i64 176
  store <8 x i16> %t0, ptr %s0.p, align 2
  store <8 x i16> %t1, ptr %s1.p, align 2
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

