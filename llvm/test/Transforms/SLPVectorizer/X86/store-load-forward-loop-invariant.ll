target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

; Same widened-load-crosses-store-window shape as
; store-load-forward-widened-load.ll (D=16, L=16, V=4), but every address here
; is a *constant* offset from the loop-invariant pointer %A, not an induction
; variable: the loads and store never move relative to each other across
; iterations. Since they do not overlap in one iteration (D=16 >= L=16), they
; never will in any other iteration either, so this is not a real forwarding
; hazard and SLP must widen the store even with the STLF check on.
define void @loop_invariant_no_conflict(ptr noalias %A, i64 %n) {
; CHECK-LABEL: define void @loop_invariant_no_conflict(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 -16
; CHECK-NEXT:    br label %[[FOR_BODY:.*]]
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[S0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 0
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[P0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[TMP0]], splat (i32 1)
; CHECK-NEXT:    [[TMP2:%.*]] = trunc <4 x i32> [[TMP1]] to <4 x i8>
; CHECK-NEXT:    store <4 x i8> [[TMP2]], ptr [[S0]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[FOR_BODY]], label %[[FOR_END:.*]]
; CHECK:       [[FOR_END]]:
; CHECK-NEXT:    ret void
;
entry:
  %p0 = getelementptr inbounds i8, ptr %A, i64 -16
  %p1 = getelementptr inbounds i8, ptr %A, i64 -12
  %p2 = getelementptr inbounds i8, ptr %A, i64 -8
  %p3 = getelementptr inbounds i8, ptr %A, i64 -4
  br label %for.body

for.body:
  %i = phi i64 [ 0, %entry ], [ %i.next, %for.body ]
  %l0 = load i32, ptr %p0, align 4
  %l1 = load i32, ptr %p1, align 4
  %l2 = load i32, ptr %p2, align 4
  %l3 = load i32, ptr %p3, align 4
  %a0 = add i32 %l0, 1
  %a1 = add i32 %l1, 1
  %a2 = add i32 %l2, 1
  %a3 = add i32 %l3, 1
  %t0 = trunc i32 %a0 to i8
  %t1 = trunc i32 %a1 to i8
  %t2 = trunc i32 %a2 to i8
  %t3 = trunc i32 %a3 to i8
  %s0 = getelementptr inbounds i8, ptr %A, i64 0
  %s1 = getelementptr inbounds i8, ptr %A, i64 1
  %s2 = getelementptr inbounds i8, ptr %A, i64 2
  %s3 = getelementptr inbounds i8, ptr %A, i64 3
  store i8 %t0, ptr %s0, align 1
  store i8 %t1, ptr %s1, align 1
  store i8 %t2, ptr %s2, align 1
  store i8 %t3, ptr %s3, align 1
  %i.next = add nuw nsw i64 %i, 1
  %cmp = icmp slt i64 %i.next, %n
  br i1 %cmp, label %for.body, label %for.end

for.end:
  ret void
}
