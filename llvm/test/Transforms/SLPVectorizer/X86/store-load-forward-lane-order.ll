; RUN: opt < %s -passes=slp-vectorizer -S -mtriple=x86_64-- -mcpu=znver5 | FileCheck %s

; The store A[i+2..i+5] overlaps only the upper half of the load A[i..i+3].
; Lane 0 of that load is before the store, so an anchor check misses the
; hazard. The overlapping lanes are after the store: the widened load would
; be emitted below the store and straddle it. The upper and lower halves
; must stay separate. The upper <2 x i32> is contained in the store, so it
; still forwards.
define void @low_lane_before_overlap_after(ptr noalias %A, ptr noalias %B, i64 %n) {
; CHECK-LABEL: define void @low_lane_before_overlap_after(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[I2:%.*]] = add i64 [[I]], 2
; CHECK-NEXT:    [[S2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I2]]
; CHECK-NEXT:    store <4 x i32> <i32 1, i32 2, i32 3, i32 4>, ptr [[S2]], align 4
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I2]]
; CHECK-NEXT:    [[B0:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 [[I]]
; CHECK-NEXT:    [[B2:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 [[I2]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x i32>, ptr [[P0]], align 4
; CHECK-NEXT:    store <2 x i32> [[TMP0]], ptr [[B0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x i32>, ptr [[P2]], align 4
; CHECK-NEXT:    store <2 x i32> [[TMP1]], ptr [[B2]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 32
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %p0 = getelementptr inbounds i32, ptr %A, i64 %i
  %i1 = add i64 %i, 1
  %p1 = getelementptr inbounds i32, ptr %A, i64 %i1
  %l0 = load i32, ptr %p0, align 4
  %l1 = load i32, ptr %p1, align 4
  %i2 = add i64 %i, 2
  %i3 = add i64 %i, 3
  %i4 = add i64 %i, 4
  %i5 = add i64 %i, 5
  %s2 = getelementptr inbounds i32, ptr %A, i64 %i2
  %s3 = getelementptr inbounds i32, ptr %A, i64 %i3
  %s4 = getelementptr inbounds i32, ptr %A, i64 %i4
  %s5 = getelementptr inbounds i32, ptr %A, i64 %i5
  store i32 1, ptr %s2, align 4
  store i32 2, ptr %s3, align 4
  store i32 3, ptr %s4, align 4
  store i32 4, ptr %s5, align 4
  %p2 = getelementptr inbounds i32, ptr %A, i64 %i2
  %p3 = getelementptr inbounds i32, ptr %A, i64 %i3
  %l2 = load i32, ptr %p2, align 4
  %l3 = load i32, ptr %p3, align 4
  %b0 = getelementptr inbounds i32, ptr %B, i64 %i
  %b1 = getelementptr inbounds i32, ptr %B, i64 %i1
  %b2 = getelementptr inbounds i32, ptr %B, i64 %i2
  %b3 = getelementptr inbounds i32, ptr %B, i64 %i3
  store i32 %l0, ptr %b0, align 4
  store i32 %l1, ptr %b1, align 4
  store i32 %l2, ptr %b2, align 4
  store i32 %l3, ptr %b3, align 4
