; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 64, %entry ], [ %i.next, %loop ]
  %sb = shl i64 %i, 2
  %lb0 = add i64 %sb, -18
  %lb1 = add i64 %sb, -16
  %lb2 = add i64 %sb, -14
  %lb3 = add i64 %sb, -12
