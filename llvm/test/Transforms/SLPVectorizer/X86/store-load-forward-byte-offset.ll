  %l1 = load i16, ptr %lp1, align 2
  %l2 = load i16, ptr %lp2, align 2
  %l3 = load i16, ptr %lp3, align 2
  %z0 = zext i16 %l0 to i32
  %z1 = zext i16 %l1 to i32
  %z2 = zext i16 %l2 to i32
  %z3 = zext i16 %l3 to i32
  %v0 = add i32 %z0, 1
  %v1 = add i32 %z1, 2
  %v2 = add i32 %z2, 3
  %v3 = add i32 %z3, 4
  %s1 = add i64 %sb, 4
  %s2 = add i64 %sb, 8
  %s3 = add i64 %sb, 12
  %sp0 = getelementptr inbounds i8, ptr %A, i64 %sb
  %sp1 = getelementptr inbounds i8, ptr %A, i64 %s1
  %sp2 = getelementptr inbounds i8, ptr %A, i64 %s2
