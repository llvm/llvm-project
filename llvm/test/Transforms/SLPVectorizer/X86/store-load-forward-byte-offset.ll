; CHECK-NEXT:    [[S:%.*]] = insertvalue { <2 x i32>, <2 x i32> } [[S0]], <2 x i32> [[V1]], 1
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
