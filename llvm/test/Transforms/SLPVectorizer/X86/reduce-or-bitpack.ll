; The or reduction packs per-lane byte fields of the result; model as a
; bitcast of the repacked fields instead of shl/and/reduce.or.

define i32 @shl_and_pack(i32 %x) {
; CHECK-LABEL: define i32 @shl_and_pack(
; CHECK-SAME: i32 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <4 x i32> poison, i32 [[X]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x i32> [[TMP0]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP2:%.*]] = lshr <4 x i32> [[TMP1]], <i32 0, i32 8, i32 16, i32 24>
; CHECK-NEXT:    [[TMP3:%.*]] = and <4 x i32> [[TMP2]], <i32 255, i32 255, i32 255, i32 -1>
; CHECK-NEXT:    [[TMP4:%.*]] = shl nuw <4 x i32> [[TMP3]], <i32 0, i32 8, i32 16, i32 24>
; CHECK-NEXT:    [[TMP6:%.*]] = call i32 @llvm.vector.reduce.or.v4i32(<4 x i32> [[TMP4]])
; CHECK-NEXT:    ret i32 [[TMP6]]
;
entry:
  %b0 = and i32 %x, 255
  %s1 = lshr i32 %x, 8
  %b1 = and i32 %s1, 255
  %z1 = shl nuw i32 %b1, 8
  %s2 = lshr i32 %x, 16
  %b2 = and i32 %s2, 255
  %z2 = shl nuw i32 %b2, 16
  %s3 = lshr i32 %x, 24
  %z3 = shl nuw i32 %s3, 24
  %r0 = or i32 %b0, %z1
  %r1 = or i32 %r0, %z2
  %r2 = or i32 %r1, %z3
  ret i32 %r2
}

; Overlapping fields: not a plain concatenation, must not fold.

define i32 @neg_overlap(i32 %x, i32 %y) {
; CHECK-LABEL: define i32 @neg_overlap(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[B0:%.*]] = and i32 [[X]], 255
