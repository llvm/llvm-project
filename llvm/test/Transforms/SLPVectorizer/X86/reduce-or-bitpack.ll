; CHECK-NEXT:    [[S2:%.*]] = lshr i32 [[X]], 16
; CHECK-NEXT:    [[B2:%.*]] = and i32 [[S2]], 255
; CHECK-NEXT:    [[Z2:%.*]] = shl nuw i32 [[B2]], 16
; CHECK-NEXT:    [[S3:%.*]] = lshr i32 [[X]], 24
; CHECK-NEXT:    [[Z3:%.*]] = shl nuw i32 [[S3]], 24
; CHECK-NEXT:    [[R0:%.*]] = or i32 [[B0]], [[C0]]
; CHECK-NEXT:    [[R1:%.*]] = or i32 [[R0]], [[Z2]]
; CHECK-NEXT:    [[R2:%.*]] = or i32 [[R1]], [[Z3]]
; CHECK-NEXT:    ret i32 [[R2]]
;
entry:
  %b0 = and i32 %x, 255
  %c0 = and i32 %y, 255
  %s2 = lshr i32 %x, 16
  %b2 = and i32 %s2, 255
  %z2 = shl nuw i32 %b2, 16
  %s3 = lshr i32 %x, 24
  %z3 = shl nuw i32 %s3, 24
  %r0 = or i32 %b0, %c0
  %r1 = or i32 %r0, %z2
  %r2 = or i32 %r1, %z3
  ret i32 %r2
}

