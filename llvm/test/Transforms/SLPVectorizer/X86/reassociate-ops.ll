;
entry:
  %idxA1 = getelementptr inbounds i32, ptr %Aarray, i64 1
  %idxB1 = getelementptr inbounds i32, ptr %Barray, i64 1
  %idxC1 = getelementptr inbounds i32, ptr %Carray, i64 1
