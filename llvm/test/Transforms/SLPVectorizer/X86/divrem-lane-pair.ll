; stays scalar and uses the extracts of its operands.
define void @urem_udiv_scheduled_after_uses(i32 %x0, i32 %x1, i32 %x2, i32 %x3, i32 %y0, i32 %y1, i32 %y2, i32 %y3, ptr %r, ptr %q, ptr %out) {
