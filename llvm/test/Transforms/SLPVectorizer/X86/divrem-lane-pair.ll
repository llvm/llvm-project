; CHECK-NEXT:    [[TMP2:%.*]] = phi <4 x i32> [ [[TMP0]], %[[ENTRY]] ], [ [[TMP0]], %[[ENTRY]] ]
; CHECK-NEXT:    [[TMP3:%.*]] = phi <4 x i32> [ [[TMP1]], %[[ENTRY]] ], [ [[TMP1]], %[[ENTRY]] ]
; CHECK-NEXT:    [[PR0:%.*]] = getelementptr inbounds i32, ptr [[R]], i64 0
; CHECK-NEXT:    [[TMP4:%.*]] = urem <4 x i32> [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = udiv <4 x i32> [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[D0:%.*]] = extractelement <4 x i32> [[TMP5]], i64 0
; CHECK-NEXT:    store <4 x i32> [[TMP4]], ptr [[PR0]], align 4
; CHECK-NEXT:    store i32 [[D0]], ptr [[Q]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %pa0 = getelementptr inbounds i32, ptr %p, i64 0
  %la0 = load i32, ptr %pa0, align 4
  %pb0 = getelementptr inbounds i32, ptr %p, i64 4
  %lb0 = load i32, ptr %pb0, align 4
  %pa1 = getelementptr inbounds i32, ptr %p, i64 1
  %la1 = load i32, ptr %pa1, align 4
  %pb1 = getelementptr inbounds i32, ptr %p, i64 5
  %lb1 = load i32, ptr %pb1, align 4
  %pa2 = getelementptr inbounds i32, ptr %p, i64 2
  %la2 = load i32, ptr %pa2, align 4
  %pb2 = getelementptr inbounds i32, ptr %p, i64 6
  %lb2 = load i32, ptr %pb2, align 4
  %pa3 = getelementptr inbounds i32, ptr %p, i64 3
  %la3 = load i32, ptr %pa3, align 4
  %pb3 = getelementptr inbounds i32, ptr %p, i64 7
  %lb3 = load i32, ptr %pb3, align 4
  br i1 %c, label %bb, label %bb

bb:
  %a0 = phi i32 [ %la0, %entry ], [ %la0, %entry ]
  %b0 = phi i32 [ %lb0, %entry ], [ %lb0, %entry ]
  %a1 = phi i32 [ %la1, %entry ], [ %la1, %entry ]
  %b1 = phi i32 [ %lb1, %entry ], [ %lb1, %entry ]
  %a2 = phi i32 [ %la2, %entry ], [ %la2, %entry ]
  %b2 = phi i32 [ %lb2, %entry ], [ %lb2, %entry ]
  %a3 = phi i32 [ %la3, %entry ], [ %la3, %entry ]
  %b3 = phi i32 [ %lb3, %entry ], [ %lb3, %entry ]
  %r0 = urem i32 %a0, %b0
  %r1 = urem i32 %a1, %b1
  %r2 = urem i32 %a2, %b2
  %r3 = urem i32 %a3, %b3
  %pr0 = getelementptr inbounds i32, ptr %r, i64 0
  store i32 %r0, ptr %pr0, align 4
  %pr1 = getelementptr inbounds i32, ptr %r, i64 1
  store i32 %r1, ptr %pr1, align 4
  %pr2 = getelementptr inbounds i32, ptr %r, i64 2
  store i32 %r2, ptr %pr2, align 4
  %pr3 = getelementptr inbounds i32, ptr %r, i64 3
  store i32 %r3, ptr %pr3, align 4
  %d0 = udiv i32 %a0, %b0
  store i32 %d0, ptr %q, align 4
  ret void
}

; The operands are arguments, the remainders are not scheduled.
define void @urem_udiv_arg_operands(i32 %a0, i32 %b0, i32 %a1, i32 %b1, i32 %a2, i32 %b2, i32 %a3, i32 %b3, ptr %r, ptr %q) {
; CHECK-LABEL: define void @urem_udiv_arg_operands(
