  %a1 = load i32, ptr %pa1, align 4
  %pa2 = getelementptr inbounds i32, ptr %a, i64 2
  %a2 = load i32, ptr %pa2, align 4
  %pa3 = getelementptr inbounds i32, ptr %a, i64 3
  %a3 = load i32, ptr %pa3, align 4
  %r0 = urem i32 %a0, 7
  %r1 = urem i32 %a1, 7
