; CHECK-NEXT:    [[TMP6:%.*]] = insertelement <4 x i32> [[TMP5]], i32 [[B2]], i64 2
; CHECK-NEXT:    [[TMP7:%.*]] = insertelement <4 x i32> [[TMP6]], i32 [[B3]], i64 3
; CHECK-NEXT:    [[TMP8:%.*]] = urem <4 x i32> [[TMP3]], [[TMP7]]
; CHECK-NEXT:    [[TMP9:%.*]] = udiv <4 x i32> [[TMP3]], [[TMP7]]
; CHECK-NEXT:    [[D0:%.*]] = extractelement <4 x i32> [[TMP9]], i64 0
; CHECK-NEXT:    store <4 x i32> [[TMP8]], ptr [[PR0]], align 4
; CHECK-NEXT:    store i32 [[D0]], ptr [[Q]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %r0 = urem i32 %a0, %b0
  %r1 = urem i32 %a1, %b1
  %r2 = urem i32 %a2, %b2
  %r3 = urem i32 %a3, %b3
  %pr0 = getelementptr inbounds i32, ptr %r, i64 0
  store i32 %r0, ptr %pr0, align 4
  %pr1 = getelementptr inbounds i32, ptr %r, i64 1
  store i32 %r1, ptr %pr1, align 4
  %pr2 = getelementptr inbounds i32, ptr %r, i64 2
  store i32 %r2, ptr %pr2, align 4
  %pr3 = getelementptr inbounds i32, ptr %r, i64 3
  store i32 %r3, ptr %pr3, align 4
  %d0 = udiv i32 %a0, %b0
  store i32 %d0, ptr %q, align 4
