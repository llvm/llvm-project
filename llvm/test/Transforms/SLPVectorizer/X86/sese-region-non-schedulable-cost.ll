  %a1p = getelementptr inbounds i32, ptr %inA, i64 1
  %l1 = load i32, ptr %a1p, align 4
  %a2p = getelementptr inbounds i32, ptr %inA, i64 2
  %l2 = load i32, ptr %a2p, align 4
  %a3p = getelementptr inbounds i32, ptr %inA, i64 3
  %l3 = load i32, ptr %a3p, align 4
  %m0 = load i32, ptr %inB, align 4
  %b1p = getelementptr inbounds i32, ptr %inB, i64 1
  %m1 = load i32, ptr %b1p, align 4
  %b2p = getelementptr inbounds i32, ptr %inB, i64 2
  %m2 = load i32, ptr %b2p, align 4
  %b3p = getelementptr inbounds i32, ptr %inB, i64 3
  %m3 = load i32, ptr %b3p, align 4
  %p0 = mul i32 %l0, %m0
  %p1 = mul i32 %l1, %m1
  %p2 = mul i32 %l2, %m2
  %p3 = mul i32 %l3, %m3
  %q0 = mul i32 %p0, 17
  %q1 = mul i32 %p1, 19
  %q2 = mul i32 %p2, 23
  %q3 = mul i32 %p3, 29
  %cl0 = icmp ne i32 %l0, 0
  call void @llvm.assume(i1 %cl0)
  %cl1 = icmp ne i32 %l1, 0
  call void @llvm.assume(i1 %cl1)
  %cl2 = icmp ne i32 %l2, 0
  call void @llvm.assume(i1 %cl2)
  %cl3 = icmp ne i32 %l3, 0
  call void @llvm.assume(i1 %cl3)
  %cm0 = icmp ne i32 %m0, 0
  call void @llvm.assume(i1 %cm0)
  %cm1 = icmp ne i32 %m1, 0
  call void @llvm.assume(i1 %cm1)
  %cm2 = icmp ne i32 %m2, 0
  call void @llvm.assume(i1 %cm2)
  %cm3 = icmp ne i32 %m3, 0
  call void @llvm.assume(i1 %cm3)
  %cp0 = icmp ne i32 %p0, 0
  call void @llvm.assume(i1 %cp0)
  %cp1 = icmp ne i32 %p1, 0
  call void @llvm.assume(i1 %cp1)
  %cp2 = icmp ne i32 %p2, 0
  call void @llvm.assume(i1 %cp2)
  %cp3 = icmp ne i32 %p3, 0
  call void @llvm.assume(i1 %cp3)
  %cq0 = icmp ne i32 %q0, 0
  call void @llvm.assume(i1 %cq0)
  %cq1 = icmp ne i32 %q1, 0
  call void @llvm.assume(i1 %cq1)
  %cq2 = icmp ne i32 %q2, 0
  call void @llvm.assume(i1 %cq2)
  %cq3 = icmp ne i32 %q3, 0
  call void @llvm.assume(i1 %cq3)
  br label %bb

bb:
  %r0 = add i32 %q0, 3
  br i1 %c_hot, label %then, label %ret0, !prof !0

then:
  %r1 = add i32 %q1, 5
  %r2 = add i32 %q2, 7
  %r3 = add i32 %q3, 9
  br i1 %c_cold, label %cold_use, label %hot_ret, !prof !1

cold_use:
  %h0 = add i32 %l0, %m0
  %h1 = mul i32 %h0, %p0
  %h2 = xor i32 %h1, %q0
  %h3 = sub i32 %h2, %l1
  %h4 = mul i32 %h3, %m1
  %h5 = add i32 %h4, %p1
  %h6 = xor i32 %h5, %q1
  %h7 = sub i32 %h6, %l2
  %h8 = mul i32 %h7, %m2
  %h9 = add i32 %h8, %p2
  %h10 = xor i32 %h9, %q2
  %h11 = sub i32 %h10, %l3
  %h12 = mul i32 %h11, %m3
  %h13 = add i32 %h12, %p3
  %h14 = xor i32 %h13, %q3
  store i32 %r0, ptr %out, align 4
  %o1 = getelementptr inbounds i32, ptr %out, i64 1
  store i32 %r1, ptr %o1, align 4
  %o2 = getelementptr inbounds i32, ptr %out, i64 2
  store i32 %r2, ptr %o2, align 4
  %o3 = getelementptr inbounds i32, ptr %out, i64 3
  store i32 %r3, ptr %o3, align 4
  ret i32 %h14

hot_ret:
  ret i32 0

ret0:
  ret i32 0
}

; The lanes in %then are not control equivalent to %bb, the region with the
; operands in %pred is not formed.
define void @hot_operand_trim(ptr %in, ptr %in0, ptr %in1, ptr %in2, ptr %in3,
; CHECK-LABEL: define void @hot_operand_trim(
; CHECK-SAME: ptr [[IN:%.*]], ptr [[IN0:%.*]], ptr [[IN1:%.*]], ptr [[IN2:%.*]], ptr [[IN3:%.*]], ptr [[HOT_OUT:%.*]], ptr [[OUT:%.*]], i32 [[K:%.*]], i1 [[C_COLD:%.*]], i1 [[C_THEN:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[PRED:.*:]]
; CHECK-NEXT:    [[I2:%.*]] = getelementptr inbounds i32, ptr [[IN]], i64 2
; CHECK-NEXT:    [[L2:%.*]] = load i32, ptr [[I2]], align 4
; CHECK-NEXT:    [[I3:%.*]] = getelementptr inbounds i32, ptr [[IN]], i64 3
; CHECK-NEXT:    [[L3:%.*]] = load i32, ptr [[I3]], align 4
; CHECK-NEXT:    [[B2:%.*]] = add i32 [[L2]], 17
; CHECK-NEXT:    [[B3:%.*]] = add i32 [[L3]], 19
; CHECK-NEXT:    [[R0:%.*]] = load i32, ptr [[IN0]], align 4
; CHECK-NEXT:    [[R1:%.*]] = load i32, ptr [[IN1]], align 4
; CHECK-NEXT:    [[R2:%.*]] = load i32, ptr [[IN2]], align 4
; CHECK-NEXT:    [[R3:%.*]] = load i32, ptr [[IN3]], align 4
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x i32>, ptr [[IN]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <2 x i32> [[TMP0]], <i32 11, i32 13>
; CHECK-NEXT:    [[P0:%.*]] = add i32 [[R0]], [[K]]
; CHECK-NEXT:    [[P1:%.*]] = add i32 [[R1]], [[K]]
; CHECK-NEXT:    [[P2:%.*]] = add i32 [[R2]], [[K]]
; CHECK-NEXT:    [[P3:%.*]] = add i32 [[R3]], [[K]]
; CHECK-NEXT:    store i32 [[P0]], ptr [[HOT_OUT]], align 4
; CHECK-NEXT:    br i1 [[C_COLD]], label %[[BB:.*]], label %[[RET:.*]], !prof [[PROF1]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x i32> poison, i32 [[P0]], i64 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <2 x i32> [[TMP2]], i32 [[P1]], i64 1
; CHECK-NEXT:    [[TMP4:%.*]] = xor <2 x i32> [[TMP1]], [[TMP3]]
; CHECK-NEXT:    br i1 [[C_THEN]], label %[[THEN:.*]], label %[[RET]], !prof [[PROF0]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[A2:%.*]] = xor i32 [[B2]], [[P2]]
; CHECK-NEXT:    [[A3:%.*]] = xor i32 [[B3]], [[P3]]
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    store <2 x i32> [[TMP4]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[O2:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 2
; CHECK-NEXT:    store i32 [[A2]], ptr [[O2]], align 4
; CHECK-NEXT:    [[O3:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 3
; CHECK-NEXT:    store i32 [[A3]], ptr [[O3]], align 4
; CHECK-NEXT:    ret void
; CHECK:       [[RET]]:
; CHECK-NEXT:    ret void
;
  ptr %hot_out, ptr %out, i32 %k, i1 %c_cold,
  i1 %c_then) {
pred:
  %l0 = load i32, ptr %in, align 4
  %i1 = getelementptr inbounds i32, ptr %in, i64 1
  %l1 = load i32, ptr %i1, align 4
  %i2 = getelementptr inbounds i32, ptr %in, i64 2
  %l2 = load i32, ptr %i2, align 4
  %i3 = getelementptr inbounds i32, ptr %in, i64 3
  %l3 = load i32, ptr %i3, align 4
  %b0 = add i32 %l0, 11
  %b1 = add i32 %l1, 13
  %b2 = add i32 %l2, 17
  %b3 = add i32 %l3, 19
  %r0 = load i32, ptr %in0, align 4
  %r1 = load i32, ptr %in1, align 4
  %r2 = load i32, ptr %in2, align 4
  %r3 = load i32, ptr %in3, align 4
  %p0 = add i32 %r0, %k
  %p1 = add i32 %r1, %k
  %p2 = add i32 %r2, %k
  %p3 = add i32 %r3, %k
  store i32 %p0, ptr %hot_out, align 4
  br i1 %c_cold, label %bb, label %ret, !prof !1

bb:
  %a0 = xor i32 %b0, %p0
  %a1 = xor i32 %b1, %p1
  br i1 %c_then, label %then, label %ret, !prof !0

then:
  %a2 = xor i32 %b2, %p2
  %a3 = xor i32 %b3, %p3
  br label %exit

exit:
  store i32 %a0, ptr %out, align 4
  %o1 = getelementptr inbounds i32, ptr %out, i64 1
  store i32 %a1, ptr %o1, align 4
  %o2 = getelementptr inbounds i32, ptr %out, i64 2
  store i32 %a2, ptr %o2, align 4
  %o3 = getelementptr inbounds i32, ptr %out, i64 3
  store i32 %a3, ptr %o3, align 4
  ret void

ret:
  ret void
}

; The lanes in %likely are not control equivalent to %bb, the region in the
; loop with the large trip count is not formed.
define i32 @large_trip_count_extracts(ptr noalias %in, ptr noalias %out, i1 %c_hot) {
; CHECK-LABEL: define i32 @large_trip_count_extracts(
; CHECK-SAME: ptr noalias [[IN:%.*]], ptr noalias [[OUT:%.*]], i1 [[C_HOT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[ACC_O:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ACC_I_OUT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[J_NEXT:%.*]], %[[INNER_LATCH:.*]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i32 [ [[ACC_O]], %[[OUTER]] ], [ [[ACC_NEXT:%.*]], %[[INNER_LATCH]] ]
; CHECK-NEXT:    [[IDX:%.*]] = add i64 [[I]], [[J]]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i32, ptr [[IN]], i64 [[IDX]]
; CHECK-NEXT:    [[L0:%.*]] = load i32, ptr [[P0]], align 4
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds i32, ptr [[P0]], i64 1
; CHECK-NEXT:    [[L1:%.*]] = load i32, ptr [[P1]], align 4
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds i32, ptr [[P0]], i64 2
; CHECK-NEXT:    [[L2:%.*]] = load i32, ptr [[P2]], align 4
; CHECK-NEXT:    [[P3:%.*]] = getelementptr inbounds i32, ptr [[P0]], i64 3
; CHECK-NEXT:    [[L3:%.*]] = load i32, ptr [[P3]], align 4
; CHECK-NEXT:    br label %[[BB:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[A0:%.*]] = mul i32 [[L0]], 3
; CHECK-NEXT:    [[A1:%.*]] = mul i32 [[L1]], 5
; CHECK-NEXT:    br i1 [[C_HOT]], label %[[LIKELY:.*]], label %[[INNER_LATCH]], !prof [[PROF5:![0-9]+]]
; CHECK:       [[LIKELY]]:
; CHECK-NEXT:    [[A2:%.*]] = mul i32 [[L2]], 7
; CHECK-NEXT:    [[A3:%.*]] = mul i32 [[L3]], 9
; CHECK-NEXT:    br label %[[USE:.*]]
; CHECK:       [[USE]]:
; CHECK-NEXT:    [[B0:%.*]] = mul i32 [[A0]], 11
; CHECK-NEXT:    [[B1:%.*]] = mul i32 [[A1]], 13
; CHECK-NEXT:    [[B2:%.*]] = mul i32 [[A2]], 17
; CHECK-NEXT:    [[B3:%.*]] = mul i32 [[A3]], 19
; CHECK-NEXT:    [[H0:%.*]] = add i32 [[ACC]], [[A0]]
; CHECK-NEXT:    [[H1:%.*]] = mul i32 [[H0]], [[A1]]
; CHECK-NEXT:    [[H2:%.*]] = xor i32 [[H1]], [[A2]]
; CHECK-NEXT:    [[H3:%.*]] = sub i32 [[H2]], [[A3]]
; CHECK-NEXT:    [[H4:%.*]] = add i32 [[H3]], [[L0]]
; CHECK-NEXT:    [[H5:%.*]] = mul i32 [[H4]], [[L1]]
; CHECK-NEXT:    [[H6:%.*]] = xor i32 [[H5]], [[L2]]
; CHECK-NEXT:    [[H7:%.*]] = sub i32 [[H6]], [[L3]]
; CHECK-NEXT:    [[H8:%.*]] = add i32 [[H7]], [[B0]]
; CHECK-NEXT:    [[H9:%.*]] = mul i32 [[H8]], [[B1]]
; CHECK-NEXT:    [[H10:%.*]] = xor i32 [[H9]], [[B2]]
; CHECK-NEXT:    [[H11:%.*]] = sub i32 [[H10]], [[B3]]
; CHECK-NEXT:    [[Q0:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[IDX]]
; CHECK-NEXT:    store i32 [[B0]], ptr [[Q0]], align 4
; CHECK-NEXT:    [[Q1:%.*]] = getelementptr inbounds i32, ptr [[Q0]], i64 1
; CHECK-NEXT:    store i32 [[B1]], ptr [[Q1]], align 4
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr inbounds i32, ptr [[Q0]], i64 2
; CHECK-NEXT:    store i32 [[B2]], ptr [[Q2]], align 4
; CHECK-NEXT:    [[Q3:%.*]] = getelementptr inbounds i32, ptr [[Q0]], i64 3
; CHECK-NEXT:    store i32 [[B3]], ptr [[Q3]], align 4
; CHECK-NEXT:    br label %[[INNER_LATCH]]
; CHECK:       [[INNER_LATCH]]:
; CHECK-NEXT:    [[ACC_NEXT]] = phi i32 [ [[ACC]], %[[BB]] ], [ [[H11]], %[[USE]] ]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_DONE:%.*]] = icmp eq i64 [[J_NEXT]], 100000
; CHECK-NEXT:    br i1 [[J_DONE]], label %[[OUTER_LATCH]], label %[[INNER]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[ACC_I_OUT]] = phi i32 [ [[ACC_NEXT]], %[[INNER_LATCH]] ]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I_DONE:%.*]] = icmp eq i64 [[I_NEXT]], 100000
; CHECK-NEXT:    br i1 [[I_DONE]], label %[[EXIT:.*]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[ACC_I_OUT]]
;
entry:
  br label %outer

outer:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %acc.o = phi i32 [ 0, %entry ], [ %acc.i.out, %outer.latch ]
  br label %inner

inner:
  %j = phi i64 [ 0, %outer ], [ %j.next, %inner.latch ]
  %acc = phi i32 [ %acc.o, %outer ], [ %acc.next, %inner.latch ]
  %idx = add i64 %i, %j
  %p0 = getelementptr inbounds i32, ptr %in, i64 %idx
  %l0 = load i32, ptr %p0, align 4
  %p1 = getelementptr inbounds i32, ptr %p0, i64 1
  %l1 = load i32, ptr %p1, align 4
  %p2 = getelementptr inbounds i32, ptr %p0, i64 2
  %l2 = load i32, ptr %p2, align 4
  %p3 = getelementptr inbounds i32, ptr %p0, i64 3
  %l3 = load i32, ptr %p3, align 4
  br label %bb

bb:
  %a0 = mul i32 %l0, 3
  %a1 = mul i32 %l1, 5
  br i1 %c_hot, label %likely, label %inner.latch, !prof !5

likely:
  %a2 = mul i32 %l2, 7
  %a3 = mul i32 %l3, 9
  br label %use

use:
  %b0 = mul i32 %a0, 11
  %b1 = mul i32 %a1, 13
  %b2 = mul i32 %a2, 17
  %b3 = mul i32 %a3, 19
  %h0 = add i32 %acc, %a0
  %h1 = mul i32 %h0, %a1
  %h2 = xor i32 %h1, %a2
  %h3 = sub i32 %h2, %a3
  %h4 = add i32 %h3, %l0
  %h5 = mul i32 %h4, %l1
  %h6 = xor i32 %h5, %l2
  %h7 = sub i32 %h6, %l3
  %h8 = add i32 %h7, %b0
  %h9 = mul i32 %h8, %b1
  %h10 = xor i32 %h9, %b2
  %h11 = sub i32 %h10, %b3
  %q0 = getelementptr inbounds i32, ptr %out, i64 %idx
  store i32 %b0, ptr %q0, align 4
  %q1 = getelementptr inbounds i32, ptr %q0, i64 1
  store i32 %b1, ptr %q1, align 4
  %q2 = getelementptr inbounds i32, ptr %q0, i64 2
  store i32 %b2, ptr %q2, align 4
  %q3 = getelementptr inbounds i32, ptr %q0, i64 3
  store i32 %b3, ptr %q3, align 4
  br label %inner.latch

inner.latch:
  %acc.next = phi i32 [ %acc, %bb ], [ %h11, %use ]
  %j.next = add nuw nsw i64 %j, 1
  %j.done = icmp eq i64 %j.next, 100000
  br i1 %j.done, label %outer.latch, label %inner

outer.latch:
  %acc.i.out = phi i32 [ %acc.next, %inner.latch ]
  %i.next = add nuw nsw i64 %i, 1
  %i.done = icmp eq i64 %i.next, 100000
  br i1 %i.done, label %exit, label %outer

exit:
  ret i32 %acc.i.out
}

