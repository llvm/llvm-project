  ret void
}

; Flag propagation for the merged-inputs transform: the four fmul lanes carry
; different fast-math flags ("fast" and "nnan ninf"), while the four fadd sums
; feeding them are uniformly "fast".
define void @merge_fmf_mixed_user(ptr %A, ptr %Out) {
; CHECK-LABEL: @merge_fmf_mixed_user(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[P4:%.*]] = getelementptr float, ptr [[A:%.*]], i64 4
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x float>, ptr [[A]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x float>, ptr [[P4]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = fadd fast <4 x float> [[TMP0]], [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x float> [[TMP2]], <4 x float> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x float> [[TMP2]], <4 x float> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP5:%.*]] = fmul nnan ninf <4 x float> [[TMP3]], [[TMP4]]
; CHECK-NEXT:    store <4 x float> [[TMP5]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load float, ptr %A
  %p1 = getelementptr float, ptr %A, i64 1
  %a1 = load float, ptr %p1
  %p2 = getelementptr float, ptr %A, i64 2
  %a2 = load float, ptr %p2
  %p3 = getelementptr float, ptr %A, i64 3
  %a3 = load float, ptr %p3
  %p4 = getelementptr float, ptr %A, i64 4
  %a4 = load float, ptr %p4
  %p5 = getelementptr float, ptr %A, i64 5
  %a5 = load float, ptr %p5
  %p6 = getelementptr float, ptr %A, i64 6
  %a6 = load float, ptr %p6
  %p7 = getelementptr float, ptr %A, i64 7
  %a7 = load float, ptr %p7

  %s0 = fadd fast float %a0, %a4
  %s1 = fadd fast float %a1, %a5
  %s2 = fadd fast float %a2, %a6
  %s3 = fadd fast float %a3, %a7

  %m0 = fmul fast float %s0, %s2
  %m1 = fmul fast float %s1, %s3
  %m2 = fmul nnan ninf float %s0, %s3
  %m3 = fmul nnan ninf float %s1, %s2

  store float %m0, ptr %Out
  %q1 = getelementptr float, ptr %Out, i64 1
  store float %m1, ptr %q1
  %q2 = getelementptr float, ptr %Out, i64 2
  store float %m2, ptr %q2
  %q3 = getelementptr float, ptr %Out, i64 3
  store float %m3, ptr %q3
  ret void
}

; Flag propagation for the merged-inputs transform: integer wrap flags. Two mul
; lanes carry "nsw nuw" and two carry only "nsw", while the four add sums
; feeding them uniformly carry both.
define void @merge_int_wrap_mixed_user(ptr %A, ptr %Out) {
; CHECK-LABEL: @merge_int_wrap_mixed_user(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[P4:%.*]] = getelementptr i32, ptr [[A:%.*]], i64 4
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[A]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i32>, ptr [[P4]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = add nuw nsw <4 x i32> [[TMP0]], [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x i32> [[TMP2]], <4 x i32> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x i32> [[TMP2]], <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP5:%.*]] = mul nsw <4 x i32> [[TMP3]], [[TMP4]]
; CHECK-NEXT:    store <4 x i32> [[TMP5]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load i32, ptr %A
  %p1 = getelementptr i32, ptr %A, i64 1
  %a1 = load i32, ptr %p1
  %p2 = getelementptr i32, ptr %A, i64 2
  %a2 = load i32, ptr %p2
  %p3 = getelementptr i32, ptr %A, i64 3
  %a3 = load i32, ptr %p3
  %p4 = getelementptr i32, ptr %A, i64 4
  %a4 = load i32, ptr %p4
  %p5 = getelementptr i32, ptr %A, i64 5
  %a5 = load i32, ptr %p5
  %p6 = getelementptr i32, ptr %A, i64 6
  %a6 = load i32, ptr %p6
  %p7 = getelementptr i32, ptr %A, i64 7
  %a7 = load i32, ptr %p7

  %s0 = add nsw nuw i32 %a0, %a4
  %s1 = add nsw nuw i32 %a1, %a5
  %s2 = add nsw nuw i32 %a2, %a6
  %s3 = add nsw nuw i32 %a3, %a7

  %m0 = mul nsw nuw i32 %s0, %s2
  %m1 = mul nsw nuw i32 %s1, %s3
  %m2 = mul nsw i32 %s0, %s3
  %m3 = mul nsw i32 %s1, %s2

  store i32 %m0, ptr %Out
  %q1 = getelementptr i32, ptr %Out, i64 1
  store i32 %m1, ptr %q1
  %q2 = getelementptr i32, ptr %Out, i64 2
  store i32 %m2, ptr %q2
  %q3 = getelementptr i32, ptr %Out, i64 3
  store i32 %m3, ptr %q3
  ret void
}

; The merged node is reordered, so the recorded input columns have to follow
; the reorder along with the operands; otherwise the shuffle masks describe
; the pre-reorder lanes and the stores get the wrong products.
define void @merge_reorder_load(ptr %A, ptr %Out) {
; CHECK-LABEL: @merge_reorder_load(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x float>, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x float> [[TMP0]], <4 x float> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x float> [[TMP0]], <4 x float> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP3:%.*]] = fmul <4 x float> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x float> [[TMP3]], <4 x float> poison, <4 x i32> <i32 1, i32 0, i32 3, i32 2>
; CHECK-NEXT:    store <4 x float> [[TMP4]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load float, ptr %A
  %p1 = getelementptr float, ptr %A, i64 1
  %a1 = load float, ptr %p1
  %p2 = getelementptr float, ptr %A, i64 2
  %a2 = load float, ptr %p2
  %p3 = getelementptr float, ptr %A, i64 3
  %a3 = load float, ptr %p3
  %m0 = fmul float %a1, %a3
  %m1 = fmul float %a0, %a2
  %m2 = fmul float %a1, %a2
  %m3 = fmul float %a0, %a3
  store float %m0, ptr %Out
  %q1 = getelementptr float, ptr %Out, i64 1
  store float %m1, ptr %q1
  %q2 = getelementptr float, ptr %Out, i64 2
  store float %m2, ptr %q2
  %q3 = getelementptr float, ptr %Out, i64 3
  store float %m3, ptr %q3
  ret void
}

; The shl demotion checker reads the shift amounts from input column 1, which
; a merged node holds in its recorded columns rather than in operand 1.
define void @merge_shl_minbw(ptr %A, ptr %Out) {
; CHECK-LABEL: @merge_shl_minbw(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i8>, ptr [[A:%.*]], align 1
; CHECK-NEXT:    [[TMP1:%.*]] = zext <4 x i8> [[TMP0]] to <4 x i32>
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x i32> [[TMP1]], <4 x i32> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x i32> [[TMP1]], <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP4:%.*]] = shl <4 x i32> [[TMP2]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = trunc <4 x i32> [[TMP4]] to <4 x i8>
; CHECK-NEXT:    store <4 x i8> [[TMP5]], ptr [[OUT:%.*]], align 1
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load i8, ptr %A
  %p1 = getelementptr i8, ptr %A, i64 1
  %a1 = load i8, ptr %p1
  %p2 = getelementptr i8, ptr %A, i64 2
  %a2 = load i8, ptr %p2
  %p3 = getelementptr i8, ptr %A, i64 3
  %a3 = load i8, ptr %p3
  %z0 = zext i8 %a0 to i32
  %z1 = zext i8 %a1 to i32
  %z2 = zext i8 %a2 to i32
  %z3 = zext i8 %a3 to i32
  %m0 = shl i32 %z0, %z2
  %m1 = shl i32 %z1, %z3
  %m2 = shl i32 %z0, %z3
  %m3 = shl i32 %z1, %z2
  %t0 = trunc i32 %m0 to i8
  %t1 = trunc i32 %m1 to i8
  %t2 = trunc i32 %m2 to i8
  %t3 = trunc i32 %m3 to i8
  store i8 %t0, ptr %Out
  %q1 = getelementptr i8, ptr %Out, i64 1
  store i8 %t1, ptr %q1
  %q2 = getelementptr i8, ptr %Out, i64 2
  store i8 %t2, ptr %q2
  %q3 = getelementptr i8, ptr %Out, i64 3
  store i8 %t3, ptr %q3
  ret void
}

; The pool can be any node kind that feeds a binary operator. A select pool
; is costed with its compare condition's predicate.
define void @merge_select_pool(ptr %A, ptr %B, ptr %Out) {
; CHECK-LABEL: @merge_select_pool(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i32>, ptr [[B:%.*]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq <4 x i32> [[TMP0]], zeroinitializer
; CHECK-NEXT:    [[TMP3:%.*]] = select <4 x i1> [[TMP2]], <4 x i32> [[TMP1]], <4 x i32> [[TMP0]]
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x i32> [[TMP3]], <4 x i32> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <4 x i32> [[TMP3]], <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP6:%.*]] = mul <4 x i32> [[TMP4]], [[TMP5]]
; CHECK-NEXT:    store <4 x i32> [[TMP6]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load i32, ptr %A
  %pa1 = getelementptr i32, ptr %A, i64 1
  %a1 = load i32, ptr %pa1
  %pa2 = getelementptr i32, ptr %A, i64 2
  %a2 = load i32, ptr %pa2
  %pa3 = getelementptr i32, ptr %A, i64 3
  %a3 = load i32, ptr %pa3
  %b0 = load i32, ptr %B
  %pb1 = getelementptr i32, ptr %B, i64 1
  %b1 = load i32, ptr %pb1
  %pb2 = getelementptr i32, ptr %B, i64 2
  %b2 = load i32, ptr %pb2
  %pb3 = getelementptr i32, ptr %B, i64 3
  %b3 = load i32, ptr %pb3

  %c0 = icmp eq i32 %a0, 0
  %c1 = icmp eq i32 %a1, 0
  %c2 = icmp eq i32 %a2, 0
  %c3 = icmp eq i32 %a3, 0
  %s0 = select i1 %c0, i32 %b0, i32 %a0
  %s1 = select i1 %c1, i32 %b1, i32 %a1
  %s2 = select i1 %c2, i32 %b2, i32 %a2
  %s3 = select i1 %c3, i32 %b3, i32 %a3

  %m0 = mul i32 %s0, %s2
  %m1 = mul i32 %s1, %s3
  %m2 = mul i32 %s0, %s3
  %m3 = mul i32 %s1, %s2

  store i32 %m0, ptr %Out
  %q1 = getelementptr i32, ptr %Out, i64 1
  store i32 %m1, ptr %q1
  %q2 = getelementptr i32, ptr %Out, i64 2
  store i32 %m2, ptr %q2
  %q3 = getelementptr i32, ptr %Out, i64 3
  store i32 %m3, ptr %q3
  ret void
}

; A compare pool yields i1 lanes, merged under an i1 xor.
define void @merge_cmp_pool(ptr %A, ptr %B, ptr %Out) {
; CHECK-LABEL: @merge_cmp_pool(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i32>, ptr [[B:%.*]], align 4
; CHECK-NEXT:    [[TMP2:%.*]] = icmp slt <4 x i32> [[TMP0]], [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x i1> [[TMP2]], <4 x i1> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP4:%.*]] = shufflevector <4 x i1> [[TMP2]], <4 x i1> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP5:%.*]] = xor <4 x i1> [[TMP3]], [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = zext <4 x i1> [[TMP5]] to <4 x i32>
; CHECK-NEXT:    store <4 x i32> [[TMP6]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load i32, ptr %A
  %pa1 = getelementptr i32, ptr %A, i64 1
  %a1 = load i32, ptr %pa1
  %pa2 = getelementptr i32, ptr %A, i64 2
  %a2 = load i32, ptr %pa2
  %pa3 = getelementptr i32, ptr %A, i64 3
  %a3 = load i32, ptr %pa3
  %b0 = load i32, ptr %B
  %pb1 = getelementptr i32, ptr %B, i64 1
  %b1 = load i32, ptr %pb1
  %pb2 = getelementptr i32, ptr %B, i64 2
  %b2 = load i32, ptr %pb2
  %pb3 = getelementptr i32, ptr %B, i64 3
  %b3 = load i32, ptr %pb3

  %c0 = icmp slt i32 %a0, %b0
  %c1 = icmp slt i32 %a1, %b1
  %c2 = icmp slt i32 %a2, %b2
  %c3 = icmp slt i32 %a3, %b3

  %x0 = xor i1 %c0, %c2
  %x1 = xor i1 %c1, %c3
  %x2 = xor i1 %c0, %c3
  %x3 = xor i1 %c1, %c2

  %z0 = zext i1 %x0 to i32
  %z1 = zext i1 %x1 to i32
  %z2 = zext i1 %x2 to i32
  %z3 = zext i1 %x3 to i32
  store i32 %z0, ptr %Out
  %q1 = getelementptr i32, ptr %Out, i64 1
  store i32 %z1, ptr %q1
  %q2 = getelementptr i32, ptr %Out, i64 2
  store i32 %z2, ptr %q2
  %q3 = getelementptr i32, ptr %Out, i64 3
  store i32 %z3, ptr %q3
  ret void
}

; An intrinsic call pool is costed as the cheaper of the vector intrinsic and
; the vector library call.
define void @merge_call_pool(ptr %A, ptr %Out) {
; CHECK-LABEL: @merge_call_pool(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x float>, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = call <4 x float> @llvm.sqrt.v4f32(<4 x float> [[TMP0]])
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x float> [[TMP1]], <4 x float> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x float> [[TMP1]], <4 x float> poison, <4 x i32> <i32 2, i32 3, i32 3, i32 2>
; CHECK-NEXT:    [[TMP4:%.*]] = fmul <4 x float> [[TMP2]], [[TMP3]]
; CHECK-NEXT:    store <4 x float> [[TMP4]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load float, ptr %A
  %p1 = getelementptr float, ptr %A, i64 1
  %a1 = load float, ptr %p1
  %p2 = getelementptr float, ptr %A, i64 2
  %a2 = load float, ptr %p2
  %p3 = getelementptr float, ptr %A, i64 3
  %a3 = load float, ptr %p3

  %s0 = call float @llvm.sqrt.f32(float %a0)
  %s1 = call float @llvm.sqrt.f32(float %a1)
  %s2 = call float @llvm.sqrt.f32(float %a2)
  %s3 = call float @llvm.sqrt.f32(float %a3)

  %m0 = fmul float %s0, %s2
  %m1 = fmul float %s1, %s3
  %m2 = fmul float %s0, %s3
  %m3 = fmul float %s1, %s2

  store float %m0, ptr %Out
  %q1 = getelementptr float, ptr %Out, i64 1
  store float %m1, ptr %q1
  %q2 = getelementptr float, ptr %Out, i64 2
  store float %m2, ptr %q2
  %q3 = getelementptr float, ptr %Out, i64 3
  store float %m3, ptr %q3
  ret void
}

