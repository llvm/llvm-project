; Negative: a freeze pool costs nothing either way, so both shapes pay the
; same two permutes and the natural one is kept.
define void @no_merge_freeze_pool(ptr %A, ptr %Out) {
; CHECK-LABEL: @no_merge_freeze_pool(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[P2:%.*]] = getelementptr float, ptr [[A:%.*]], i64 2
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x float>, ptr [[A]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <2 x float> [[TMP0]], <2 x float> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP2:%.*]] = load <2 x float>, ptr [[P2]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <2 x float> [[TMP2]], <2 x float> poison, <4 x i32> <i32 0, i32 1, i32 1, i32 0>
; CHECK-NEXT:    [[TMP4:%.*]] = freeze <4 x float> [[TMP1]]
; CHECK-NEXT:    [[TMP5:%.*]] = freeze <4 x float> [[TMP3]]
; CHECK-NEXT:    [[TMP6:%.*]] = fmul <4 x float> [[TMP4]], [[TMP5]]
; CHECK-NEXT:    store <4 x float> [[TMP6]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load float, ptr %A
  %p1 = getelementptr float, ptr %A, i64 1
  %a1 = load float, ptr %p1
  %p2 = getelementptr float, ptr %A, i64 2
  %a2 = load float, ptr %p2
  %p3 = getelementptr float, ptr %A, i64 3
  %a3 = load float, ptr %p3

  %s0 = freeze float %a0
  %s1 = freeze float %a1
  %s2 = freeze float %a2
  %s3 = freeze float %a3

  %m0 = fmul float %s0, %s2
  %m1 = fmul float %s1, %s3
  %m2 = fmul float %s0, %s3
  %m3 = fmul float %s1, %s2

  store float %m0, ptr %Out
  %q1 = getelementptr float, ptr %Out, i64 1
  store float %m1, ptr %q1
  %q2 = getelementptr float, ptr %Out, i64 2
  store float %m2, ptr %q2
  %q3 = getelementptr float, ptr %Out, i64 3
  store float %m3, ptr %q3
  ret void
}

; Negative: the pool {a0, a2, a4, a6} is a strided load set. Querying its state
; postpones it as a gathered load; the rejected merge must not leave that
; postponement behind for the natural operand node.
define void @no_merge_strided_pool(ptr %A, ptr %Out) {
; CHECK-LABEL: @no_merge_strided_pool(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[A0:%.*]] = load float, ptr [[A:%.*]], align 4
; CHECK-NEXT:    [[P2:%.*]] = getelementptr float, ptr [[A]], i64 2
; CHECK-NEXT:    [[A2:%.*]] = load float, ptr [[P2]], align 4
; CHECK-NEXT:    [[P4:%.*]] = getelementptr float, ptr [[A]], i64 4
; CHECK-NEXT:    [[A4:%.*]] = load float, ptr [[P4]], align 4
; CHECK-NEXT:    [[P6:%.*]] = getelementptr float, ptr [[A]], i64 6
; CHECK-NEXT:    [[A6:%.*]] = load float, ptr [[P6]], align 4
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <4 x float> poison, float [[A0]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <4 x float> [[TMP0]], float [[A2]], i64 1
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x float> [[TMP1]], <4 x float> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <4 x float> poison, float [[A4]], i64 0
; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <4 x float> [[TMP3]], float [[A6]], i64 1
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <4 x float> [[TMP4]], <4 x float> poison, <4 x i32> <i32 0, i32 1, i32 1, i32 0>
; CHECK-NEXT:    [[TMP6:%.*]] = fmul <4 x float> [[TMP2]], [[TMP5]]
; CHECK-NEXT:    store <4 x float> [[TMP6]], ptr [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load float, ptr %A
  %p2 = getelementptr float, ptr %A, i64 2
  %a2 = load float, ptr %p2
  %p4 = getelementptr float, ptr %A, i64 4
  %a4 = load float, ptr %p4
  %p6 = getelementptr float, ptr %A, i64 6
  %a6 = load float, ptr %p6

  %m0 = fmul float %a0, %a4
  %m1 = fmul float %a2, %a6
  %m2 = fmul float %a0, %a6
  %m3 = fmul float %a2, %a4

  store float %m0, ptr %Out
  %q1 = getelementptr float, ptr %Out, i64 1
  store float %m1, ptr %q1
  %q2 = getelementptr float, ptr %Out, i64 2
  store float %m2, ptr %q2
  %q3 = getelementptr float, ptr %Out, i64 3
  store float %m3, ptr %q3
  ret void
}
