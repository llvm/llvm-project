declare i32 @llvm.umin.i32(i32, i32)
declare i32 @llvm.umax.i32(i32, i32)

; NPOT vectorization makes the three reduction inputs a legal vector, but the
; reduction is not profitable in isolation. Account for the consecutive store
; bundle that consumes both the inputs and the result.
define void @three_values_and_reduction(ptr %p, i32 %scale) {
; CHECK-LABEL: define void @three_values_and_reduction(
; CHECK: %[[LOAD:.*]] = load <3 x i8>, ptr %p
; CHECK: %[[MIN:.*]] = call <3 x i32> @llvm.umin.v3i32
; CHECK: %[[MAX:.*]] = call i32 @llvm.vector.reduce.umax.v3i32(<3 x i32> %[[MIN]])
; CHECK: %[[EXT:.*]] = shufflevector <3 x i32> %[[MIN]], <3 x i32> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 poison>
; CHECK: %[[INS:.*]] = insertelement <4 x i32> %[[EXT]], i32 %[[MAX]], i64 3
; CHECK: %[[TRUNC:.*]] = trunc <4 x i32> %[[INS]] to <4 x i8>
; CHECK: store <4 x i8> %[[TRUNC]], ptr %p
entry:
  %l0 = load i8, ptr %p
  %z0 = zext i8 %l0 to i32
  %m0 = mul i32 %z0, %scale
  %s0 = lshr i32 %m0, 15
  %n0 = call i32 @llvm.umin.i32(i32 %s0, i32 255)
  %t0 = trunc i32 %n0 to i8
  store i8 %t0, ptr %p
  %p1 = getelementptr i8, ptr %p, i64 1
  %l1 = load i8, ptr %p1
  %z1 = zext i8 %l1 to i32
  %m1 = mul i32 %z1, %scale
  %s1 = lshr i32 %m1, 15
  %n1 = call i32 @llvm.umin.i32(i32 %s1, i32 255)
  %t1 = trunc i32 %n1 to i8
  store i8 %t1, ptr %p1
  %p2 = getelementptr i8, ptr %p, i64 2
  %l2 = load i8, ptr %p2
  %z2 = zext i8 %l2 to i32
  %m2 = mul i32 %z2, %scale
  %s2 = lshr i32 %m2, 15
  %n2 = call i32 @llvm.umin.i32(i32 %s2, i32 255)
  %t2 = trunc i32 %n2 to i8
  store i8 %t2, ptr %p2
  %max1 = call i32 @llvm.umax.i32(i32 %n1, i32 %n2)
  %max0 = call i32 @llvm.umax.i32(i32 %n0, i32 %max1)
  %ta = trunc i32 %max0 to i8
  %p3 = getelementptr i8, ptr %p, i64 3
  store i8 %ta, ptr %p3
  ret void
}

; A gap in the sink bundle prevents combined profitability from being used.
define void @nonconsecutive_sinks(ptr %p, i32 %x0, i32 %x1, i32 %x2) {
; CHECK-LABEL: define void @nonconsecutive_sinks(
; CHECK-NOT: call i32 @llvm.vector.reduce
entry:
  %p1 = getelementptr i8, ptr %p, i64 1
  %p2 = getelementptr i8, ptr %p, i64 2
  %p4 = getelementptr i8, ptr %p, i64 4
  %n0 = call i32 @llvm.umin.i32(i32 %x0, i32 255)
  %n1 = call i32 @llvm.umin.i32(i32 %x1, i32 255)
  %n2 = call i32 @llvm.umin.i32(i32 %x2, i32 255)
  %t0 = trunc i32 %n0 to i8
  %t1 = trunc i32 %n1 to i8
  %t2 = trunc i32 %n2 to i8
  store i8 %t0, ptr %p
  store i8 %t1, ptr %p1
  store i8 %t2, ptr %p2
  %max1 = call i32 @llvm.umax.i32(i32 %n1, i32 %n2)
  %max0 = call i32 @llvm.umax.i32(i32 %n0, i32 %max1)
  %ta = trunc i32 %max0 to i8
  store i8 %ta, ptr %p4
  ret void
}
