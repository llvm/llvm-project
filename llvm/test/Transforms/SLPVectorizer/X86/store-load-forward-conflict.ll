; STLF-OFF-NEXT:    [[GEP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; STLF-OFF-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[P0]], align 4
