; CHECK-NEXT:    [[TMP3:%.*]] = add nsw <4 x i32> [[TMP2]], <i32 1, i32 2, i32 3, i32 4>
; CHECK-NEXT:    store <4 x i32> [[TMP3]], ptr [[A]], align 4
; CHECK-NEXT:    ret void
