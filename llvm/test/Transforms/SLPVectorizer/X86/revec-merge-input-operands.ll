; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -S -mtriple=x86_64-unknown-linux -mcpu=znver4 -passes=slp-vectorizer -slp-revec < %s | FileCheck %s

; Under -slp-revec the element type of a bundle can itself be a vector, which
; the merged-inputs cost model cannot widen to a plain vector type. Check that
; merging bails out instead of asserting.
define void @merge_revec(ptr %A, ptr %Out) {
; CHECK-LABEL: @merge_revec(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[P2:%.*]] = getelementptr <2 x float>, ptr [[A:%.*]], i64 2
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x float>, ptr [[A]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x float> [[TMP0]], <4 x float> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[TMP2:%.*]] = load <4 x float>, ptr [[P2]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <4 x float> [[TMP2]], <4 x float> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 2, i32 3, i32 0, i32 1>
; CHECK-NEXT:    [[TMP4:%.*]] = fmul <8 x float> [[TMP1]], [[TMP3]]
; CHECK-NEXT:    store <8 x float> [[TMP4]], ptr [[OUT:%.*]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %a0 = load <2 x float>, ptr %A
  %p1 = getelementptr <2 x float>, ptr %A, i64 1
  %a1 = load <2 x float>, ptr %p1
  %p2 = getelementptr <2 x float>, ptr %A, i64 2
  %a2 = load <2 x float>, ptr %p2
  %p3 = getelementptr <2 x float>, ptr %A, i64 3
  %a3 = load <2 x float>, ptr %p3
  %m0 = fmul <2 x float> %a0, %a2
  %m1 = fmul <2 x float> %a1, %a3
  %m2 = fmul <2 x float> %a0, %a3
  %m3 = fmul <2 x float> %a1, %a2
  store <2 x float> %m0, ptr %Out
  %q1 = getelementptr <2 x float>, ptr %Out, i64 1
  store <2 x float> %m1, ptr %q1
  %q2 = getelementptr <2 x float>, ptr %Out, i64 2
  store <2 x float> %m2, ptr %q2
  %q3 = getelementptr <2 x float>, ptr %Out, i64 3
  store <2 x float> %m3, ptr %q3
  ret void
}
