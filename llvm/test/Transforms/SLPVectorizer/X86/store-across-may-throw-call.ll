declare void @may_throw(i32)
declare void @may_throw_readnone(i32) readnone
declare void @no_throw(i32) nounwind

@g = global [2 x double] zeroinitializer

; The store to %p is observable by the caller if @may_throw unwinds, so it
; must not be sunk past the call.
define void @noalias_arg_store_across_may_throw(ptr noalias %p, ptr noalias %q, i32 %k) {
; CHECK-LABEL: @noalias_arg_store_across_may_throw(
; CHECK-NEXT:    call void @may_throw(i32 [[K:%.*]])
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x double>, ptr [[Q:%.*]], align 8
; CHECK-NEXT:    store <2 x double> [[TMP1]], ptr [[P:%.*]], align 8
; CHECK-NEXT:    ret void
;
  %q1 = getelementptr inbounds i8, ptr %q, i64 8
  %a = load double, ptr %q, align 8
  %b = load double, ptr %q1, align 8
  %p1 = getelementptr inbounds i8, ptr %p, i64 8
  store double %a, ptr %p, align 8
  call void @may_throw(i32 %k)
  store double %b, ptr %p1, align 8
  ret void
}

; Both stores precede the call, so the combined store can stay ahead of it.
define void @noalias_arg_stores_before_may_throw(ptr noalias %p, ptr noalias %q, i32 %k) {
; CHECK-LABEL: @noalias_arg_stores_before_may_throw(
