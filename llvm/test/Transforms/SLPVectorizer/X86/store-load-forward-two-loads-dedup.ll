; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; REQUIRES: asserts
; RUN: opt < %s -passes=slp-vectorizer -S \
; RUN:   -mtriple=x86_64-- -mcpu=znver5 -store-load-forwarding-conflict-cost=12 \
; RUN:   | FileCheck %s
; RUN: opt < %s -passes=slp-vectorizer -disable-output \
; RUN:   -mtriple=x86_64-- -mcpu=znver5 -store-load-forwarding-conflict-cost=12 \
; RUN:   -stats 2>&1 | FileCheck %s --check-prefix=STATS

;
; ONE widened store conflicts with TWO genuinely distinct widened backward
; loads (A[i-5..i-2] and A[i-21..i-18], different LoadInst objects, different
; addresses). A per-load model must charge for BOTH -- these are two separate
; load events, not the same load re-checked twice, so the cross-tree waiver
; (keyed by LoadInst*) must not conflate them. This guards the multi-load
; collection added to findStoreLoadForwardingConflict (collect every
; conflicting load, not just the first) against silently dropping a second,
; distinct hazard.
;
; At this exact penalty (12), two independent charges (24) outweigh the
; natural vectorization savings and the store correctly stays scalar; if the
; two distinct loads were wrongly deduped down to a single charge (12), the
; tree would incorrectly still look profitable and widen (see the sibling
; store-load-forward-multichain-dedup.ll test for the "only pay once"
; direction of this same dedup logic, where the shared load legitimately
; collapses to one charge).
;
; STATS-NOT: {{[0-9]+}} SLP - Number of store-to-load forwarding hazard charges
;
define void @stlf_two_distinct_loads_one_store(ptr noalias %A, i64 %n) {
; CHECK-LABEL: define void @stlf_two_distinct_loads_one_store(
; CHECK-SAME: ptr noalias [[A:%.*]], i64 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 32, %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[AM5:%.*]] = add i64 [[I]], -5
; CHECK-NEXT:    [[AM4:%.*]] = add i64 [[I]], -4
; CHECK-NEXT:    [[AM3:%.*]] = add i64 [[I]], -3
; CHECK-NEXT:    [[AM2:%.*]] = add i64 [[I]], -2
; CHECK-NEXT:    [[AP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[AM5]]
; CHECK-NEXT:    [[AP1:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[AM4]]
; CHECK-NEXT:    [[AP2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[AM3]]
; CHECK-NEXT:    [[AP3:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[AM2]]
; CHECK-NEXT:    [[A0:%.*]] = load i32, ptr [[AP0]], align 4
; CHECK-NEXT:    [[A1:%.*]] = load i32, ptr [[AP1]], align 4
; CHECK-NEXT:    [[A2:%.*]] = load i32, ptr [[AP2]], align 4
; CHECK-NEXT:    [[A3:%.*]] = load i32, ptr [[AP3]], align 4
; CHECK-NEXT:    [[BM21:%.*]] = add i64 [[I]], -21
; CHECK-NEXT:    [[BM20:%.*]] = add i64 [[I]], -20
; CHECK-NEXT:    [[BM19:%.*]] = add i64 [[I]], -19
; CHECK-NEXT:    [[BM18:%.*]] = add i64 [[I]], -18
; CHECK-NEXT:    [[BP0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[BM21]]
; CHECK-NEXT:    [[BP1:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[BM20]]
; CHECK-NEXT:    [[BP2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[BM19]]
; CHECK-NEXT:    [[BP3:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[BM18]]
; CHECK-NEXT:    [[B0:%.*]] = load i32, ptr [[BP0]], align 4
; CHECK-NEXT:    [[B1:%.*]] = load i32, ptr [[BP1]], align 4
; CHECK-NEXT:    [[B2:%.*]] = load i32, ptr [[BP2]], align 4
; CHECK-NEXT:    [[B3:%.*]] = load i32, ptr [[BP3]], align 4
; CHECK-NEXT:    [[V0:%.*]] = add i32 [[A0]], [[B0]]
; CHECK-NEXT:    [[V1:%.*]] = add i32 [[A1]], [[B1]]
; CHECK-NEXT:    [[V2:%.*]] = add i32 [[A2]], [[B2]]
; CHECK-NEXT:    [[V3:%.*]] = add i32 [[A3]], [[B3]]
; CHECK-NEXT:    [[I1:%.*]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[I2:%.*]] = add nuw nsw i64 [[I]], 2
; CHECK-NEXT:    [[I3:%.*]] = add nuw nsw i64 [[I]], 3
; CHECK-NEXT:    [[Q0:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[Q1:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I1]]
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I2]]
; CHECK-NEXT:    [[Q3:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I3]]
; CHECK-NEXT:    store i32 [[V0]], ptr [[Q0]], align 4
; CHECK-NEXT:    store i32 [[V1]], ptr [[Q1]], align 4
; CHECK-NEXT:    store i32 [[V2]], ptr [[Q2]], align 4
; CHECK-NEXT:    store i32 [[V3]], ptr [[Q3]], align 4
; CHECK-NEXT:    [[NEXT]] = add nuw nsw i64 [[I]], 4
; CHECK-NEXT:    [[DONE:%.*]] = icmp uge i64 [[NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 32, %entry ], [ %next, %loop ]

  %am5 = add i64 %i, -5
  %am4 = add i64 %i, -4
  %am3 = add i64 %i, -3
  %am2 = add i64 %i, -2
  %ap0 = getelementptr inbounds i32, ptr %A, i64 %am5
  %ap1 = getelementptr inbounds i32, ptr %A, i64 %am4
  %ap2 = getelementptr inbounds i32, ptr %A, i64 %am3
  %ap3 = getelementptr inbounds i32, ptr %A, i64 %am2
  %a0 = load i32, ptr %ap0, align 4
  %a1 = load i32, ptr %ap1, align 4
  %a2 = load i32, ptr %ap2, align 4
  %a3 = load i32, ptr %ap3, align 4

  %bm21 = add i64 %i, -21
  %bm20 = add i64 %i, -20
  %bm19 = add i64 %i, -19
  %bm18 = add i64 %i, -18
  %bp0 = getelementptr inbounds i32, ptr %A, i64 %bm21
  %bp1 = getelementptr inbounds i32, ptr %A, i64 %bm20
  %bp2 = getelementptr inbounds i32, ptr %A, i64 %bm19
  %bp3 = getelementptr inbounds i32, ptr %A, i64 %bm18
  %b0 = load i32, ptr %bp0, align 4
  %b1 = load i32, ptr %bp1, align 4
  %b2 = load i32, ptr %bp2, align 4
  %b3 = load i32, ptr %bp3, align 4

  %v0 = add i32 %a0, %b0
  %v1 = add i32 %a1, %b1
  %v2 = add i32 %a2, %b2
  %v3 = add i32 %a3, %b3

  %i1 = add nuw nsw i64 %i, 1
  %i2 = add nuw nsw i64 %i, 2
  %i3 = add nuw nsw i64 %i, 3
  %q0 = getelementptr inbounds i32, ptr %A, i64 %i
  %q1 = getelementptr inbounds i32, ptr %A, i64 %i1
  %q2 = getelementptr inbounds i32, ptr %A, i64 %i2
  %q3 = getelementptr inbounds i32, ptr %A, i64 %i3
  store i32 %v0, ptr %q0, align 4
  store i32 %v1, ptr %q1, align 4
  store i32 %v2, ptr %q2, align 4
  store i32 %v3, ptr %q3, align 4

  %next = add nuw nsw i64 %i, 4
  %done = icmp uge i64 %next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}
