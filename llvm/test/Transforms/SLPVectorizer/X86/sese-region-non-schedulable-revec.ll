; The vector adds are in different blocks of the region, their vector is
; emitted in the region entry, the lane used in %side is extracted there.
define void @chain(ptr %p, ptr %q, i1 %c, i1 %d) {
; CHECK-LABEL: define void @chain(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C:%.*]], i1 [[D:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[P]], align 4
; CHECK-NEXT:    br label %[[BB:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[TMP0]], <i32 1, i32 2, i32 3, i32 4>
; CHECK-NEXT:    br i1 [[C]], label %[[SIDE:.*]], label %[[MID:.*]]
; CHECK:       [[SIDE]]:
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x i32> [[TMP1]], <4 x i32> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    call void @foo(<2 x i32> [[TMP2]])
; CHECK-NEXT:    br label %[[MID]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    store <4 x i32> [[TMP1]], ptr [[Q]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %x0 = load <2 x i32>, ptr %p, align 4
  %p1 = getelementptr inbounds <2 x i32>, ptr %p, i64 1
  %x1 = load <2 x i32>, ptr %p1, align 4
  br label %bb

bb:
  %a0 = add <2 x i32> %x0, <i32 1, i32 2>
  br i1 %c, label %side, label %mid

side:
  call void @foo(<2 x i32> %a0)
  br label %mid

mid:
  %a1 = add <2 x i32> %x1, <i32 3, i32 4>
  br label %exit

exit:
  store <2 x i32> %a0, ptr %q, align 4
  %q1 = getelementptr inbounds <2 x i32>, ptr %q, i64 1
  store <2 x i32> %a1, ptr %q1, align 4
  ret void
}

; The lane from %then is speculated in %bb.
define void @phi_operands(ptr %p, ptr %q, i1 %c, <2 x i32> %y) {
; CHECK-LABEL: define void @phi_operands(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C:%.*]], <2 x i32> [[Y:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[P]], align 4
; CHECK-NEXT:    br label %[[BB:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <2 x i32> [[Y]], <2 x i32> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
; CHECK-NEXT:    [[TMP2:%.*]] = call <4 x i32> @llvm.smax.v4i32(<4 x i32> [[TMP0]], <4 x i32> [[TMP1]])
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP3:%.*]] = phi <4 x i32> [ [[TMP2]], %[[THEN]] ], [ zeroinitializer, %[[BB]] ]
; CHECK-NEXT:    store <4 x i32> [[TMP3]], ptr [[Q]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %x0 = load <2 x i32>, ptr %p, align 4
  %p1 = getelementptr inbounds <2 x i32>, ptr %p, i64 1
  %x1 = load <2 x i32>, ptr %p1, align 4
  br label %bb

bb:
  %a0 = call <2 x i32> @llvm.smax.v2i32(<2 x i32> %x0, <2 x i32> %y)
  br i1 %c, label %then, label %exit

then:
  %a1 = call <2 x i32> @llvm.smax.v2i32(<2 x i32> %x1, <2 x i32> %y)
  br label %exit

exit:
  %r0 = phi <2 x i32> [ %a0, %then ], [ zeroinitializer, %bb ]
  %r1 = phi <2 x i32> [ %a1, %then ], [ zeroinitializer, %bb ]
  store <2 x i32> %r0, ptr %q, align 4
  %q1 = getelementptr inbounds <2 x i32>, ptr %q, i64 1
  store <2 x i32> %r1, ptr %q1, align 4
  ret void
}

