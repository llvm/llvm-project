; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <5 x i32> [[TMP0]], <5 x i32> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 4>
; CHECK-NEXT:    [[TMP2:%.*]] = add <4 x i32> [[TMP1]], splat (i32 1)
