; The compares are vectorized in the region entry.
define void @cmps(ptr %p, ptr %q, i1 %c, i32 %y) {
; CHECK-LABEL: define void @cmps(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[P]], align 4
; CHECK-NEXT:    br label %[[BB:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x i32> [[TMP0]], <4 x i32> poison, <2 x i32> <i32 0, i32 1>
; CHECK-NEXT:    [[TMP9:%.*]] = insertelement <2 x i32> poison, i32 [[Y]], i64 0
; CHECK-NEXT:    [[TMP10:%.*]] = shufflevector <2 x i32> [[TMP9]], <2 x i32> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP11:%.*]] = icmp slt <2 x i32> [[TMP1]], [[TMP10]]
; CHECK-NEXT:    br i1 [[C]], label %[[SIDE:.*]], label %[[MID:.*]]
; CHECK:       [[SIDE]]:
; CHECK-NEXT:    call void @foo()
; CHECK-NEXT:    br label %[[MID]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <4 x i32> [[TMP0]], <4 x i32> poison, <2 x i32> <i32 2, i32 3>
; CHECK-NEXT:    [[TMP6:%.*]] = icmp slt <2 x i32> [[TMP5]], [[TMP10]]
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP7:%.*]] = shufflevector <2 x i1> [[TMP11]], <2 x i1> poison, <4 x i32> <i32 0, i32 1, i32 poison, i32 poison>
; CHECK-NEXT:    [[TMP8:%.*]] = shufflevector <2 x i1> [[TMP6]], <2 x i1> poison, <4 x i32> <i32 0, i32 1, i32 poison, i32 poison>
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <2 x i1> [[TMP11]], <2 x i1> [[TMP6]], <4 x i32> <i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <2 x i32> [[TMP10]], <2 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP4:%.*]] = select <4 x i1> [[TMP3]], <4 x i32> [[TMP0]], <4 x i32> [[TMP2]]
; CHECK-NEXT:    store <4 x i32> [[TMP4]], ptr [[Q]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %x0 = load i32, ptr %p, align 4
  %p1 = getelementptr inbounds i32, ptr %p, i64 1
  %x1 = load i32, ptr %p1, align 4
  %p2 = getelementptr inbounds i32, ptr %p, i64 2
  %x2 = load i32, ptr %p2, align 4
  %p3 = getelementptr inbounds i32, ptr %p, i64 3
  %x3 = load i32, ptr %p3, align 4
  br label %bb

bb:
  %c0 = icmp slt i32 %x0, %y
  %c1 = icmp slt i32 %x1, %y
  br i1 %c, label %side, label %mid

side:
  call void @foo()
  br label %mid

mid:
  %c2 = icmp slt i32 %x2, %y
  %c3 = icmp slt i32 %x3, %y
  br label %exit

exit:
  %s0 = select i1 %c0, i32 %x0, i32 %y
  %s1 = select i1 %c1, i32 %x1, i32 %y
  %s2 = select i1 %c2, i32 %x2, i32 %y
  %s3 = select i1 %c3, i32 %x3, i32 %y
  store i32 %s0, ptr %q, align 4
  %q1 = getelementptr inbounds i32, ptr %q, i64 1
  store i32 %s1, ptr %q1, align 4
  %q2 = getelementptr inbounds i32, ptr %q, i64 2
  store i32 %s2, ptr %q2, align 4
  %q3 = getelementptr inbounds i32, ptr %q, i64 3
  store i32 %s3, ptr %q3, align 4
  ret void
}

; The GEPs are speculated.
define void @geps(ptr %p, ptr %q, i1 %c) {
; CHECK-LABEL: define void @geps(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x ptr>, ptr [[P]], align 8
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds ptr, ptr [[P]], i64 2
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x ptr>, ptr [[P2]], align 8
; CHECK-NEXT:    br label %[[BB:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr inbounds i32, <2 x ptr> [[TMP0]], <2 x i64> <i64 4, i64 0>
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr inbounds i32, <2 x ptr> [[TMP1]], <2 x i64> <i64 4, i64 0>
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr inbounds i32, <2 x ptr> [[TMP2]], <2 x i64> <i64 0, i64 4>
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr inbounds i32, <2 x ptr> [[TMP3]], <2 x i64> <i64 0, i64 4>
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP4:%.*]] = phi <2 x ptr> [ [[TMP6]], %[[THEN]] ], [ splat (ptr null), %[[BB]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = phi <2 x ptr> [ [[TMP7]], %[[THEN]] ], [ splat (ptr null), %[[BB]] ]
; CHECK-NEXT:    store <2 x ptr> [[TMP4]], ptr [[Q]], align 8
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr inbounds ptr, ptr [[Q]], i64 2
; CHECK-NEXT:    store <2 x ptr> [[TMP5]], ptr [[Q2]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %x0 = load ptr, ptr %p, align 8
  %p1 = getelementptr inbounds ptr, ptr %p, i64 1
  %x1 = load ptr, ptr %p1, align 8
  %p2 = getelementptr inbounds ptr, ptr %p, i64 2
  %x2 = load ptr, ptr %p2, align 8
  %p3 = getelementptr inbounds ptr, ptr %p, i64 3
  %x3 = load ptr, ptr %p3, align 8
  br label %bb

bb:
  %g0 = getelementptr inbounds i32, ptr %x0, i64 4
  %g2 = getelementptr inbounds i32, ptr %x2, i64 4
  br i1 %c, label %then, label %exit

then:
  %g1 = getelementptr inbounds i32, ptr %x1, i64 4
  %g3 = getelementptr inbounds i32, ptr %x3, i64 4
  br label %exit

exit:
  %r0 = phi ptr [ %g0, %then ], [ null, %bb ]
  %r1 = phi ptr [ %g1, %then ], [ null, %bb ]
  %r2 = phi ptr [ %g2, %then ], [ null, %bb ]
  %r3 = phi ptr [ %g3, %then ], [ null, %bb ]
  store ptr %r0, ptr %q, align 8
  %q1 = getelementptr inbounds ptr, ptr %q, i64 1
  store ptr %r1, ptr %q1, align 8
  %q2 = getelementptr inbounds ptr, ptr %q, i64 2
  store ptr %r2, ptr %q2, align 8
  %q3 = getelementptr inbounds ptr, ptr %q, i64 3
  store ptr %r3, ptr %q3, align 8
  ret void
}

