; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=slp-vectorizer -mtriple=x86_64-unknown-linux-gnu -S < %s | FileCheck %s

@d = external global [0 x i8]

; SLP vectorizes the two adjacent i32 stores and introduces a <2 x i32> load that
; overlaps the scalar i32 load of the same element (used by the select). That
; scalar load must be extracted from the vector load, not re-loaded, otherwise it
; leaves a redundant overlapping memory access (llvm#205978).
define { i64, i32 } @e() {
; CHECK-LABEL: define { i64, i32 } @e() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[B:%.*]] = load i64, ptr getelementptr inbounds (i8, ptr @d, i64 16), align 16
; CHECK-NEXT:    store i64 [[B]], ptr @d, align 16
; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x i32>, ptr getelementptr inbounds (i8, ptr @d, i64 24), align 8
; CHECK-NEXT:    store <2 x i32> [[TMP0]], ptr getelementptr inbounds (i8, ptr @d, i64 8), align 8
; CHECK-NEXT:    [[TOBOOL:%.*]] = icmp eq i64 [[B]], 0
; CHECK-NEXT:    [[RB:%.*]] = select i1 [[TOBOOL]], i64 3, i64 [[B]]
; CHECK-NEXT:    [[TMP1:%.*]] = extractelement <2 x i32> [[TMP0]], i64 0
; CHECK-NEXT:    [[RC:%.*]] = select i1 [[TOBOOL]], i32 9, i32 [[TMP1]]
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { i64, i32 } poison, i64 [[RB]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { i64, i32 } [[R0]], i32 [[RC]], 1
; CHECK-NEXT:    ret { i64, i32 } [[R1]]
;
entry:
  %b   = load i64, ptr getelementptr inbounds (i8, ptr @d, i64 16), align 16
  %c   = load i32, ptr getelementptr inbounds (i8, ptr @d, i64 24), align 8
  %pad = load i32, ptr getelementptr inbounds (i8, ptr @d, i64 28), align 4
  store i64 %b,   ptr @d, align 16
  store i32 %c,   ptr getelementptr inbounds (i8, ptr @d, i64 8), align 8
  store i32 %pad, ptr getelementptr inbounds (i8, ptr @d, i64 12), align 4
  %tobool = icmp eq i64 %b, 0
  %rb = select i1 %tobool, i64 3, i64 %b
  %rc = select i1 %tobool, i32 9, i32 %c
  %r0 = insertvalue { i64, i32 } poison, i64 %rb, 0
  %r1 = insertvalue { i64, i32 } %r0, i32 %rc, 1
  ret { i64, i32 } %r1
}
