  %a0i = load double, ptr %a0i.p, align 8
  %a2r = load double, ptr %a2p, align 8
  %a2i = load double, ptr %a2i.p, align 8
  %er = load double, ptr %ep, align 8
  %ei = load double, ptr %ei.p, align 8
  %m1 = fmul fast double %er, %a2r
  %m2 = fmul fast double %er, %a2i
  %m3 = fmul fast double %ei, %a2r
  %im = fadd fast double %m3, %m2
  %m4 = fmul fast double %ei, %a2i
  %re = fsub fast double %m1, %m4
  %hr = fadd fast double %re, %a0r
