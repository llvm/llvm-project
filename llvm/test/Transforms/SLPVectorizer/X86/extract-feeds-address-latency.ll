  store i32 %i_next, ptr %i_ptr
  %j_is_zero = icmp eq i32 %j, 0
  %j_minus_1 = add i32 %j, -1
  %j_next = select i1 %j_is_zero, i32 %size_minus_1, i32 %j_minus_1
  %j_next_z = zext i32 %j_next to i64
  %seed_j_ptr = getelementptr inbounds i32, ptr %seed, i64 %j_next_z
