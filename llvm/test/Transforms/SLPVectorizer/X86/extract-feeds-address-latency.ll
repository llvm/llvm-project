; AVX2-NEXT:    [[I_NEXT:%.*]] = select i1 [[I_IS_ZERO]], i32 [[SIZE_MINUS_1]], i32 [[I_MINUS_1]]
; AVX2-NEXT:    [[I_NEXT_Z:%.*]] = zext i32 [[I_NEXT]] to i64
