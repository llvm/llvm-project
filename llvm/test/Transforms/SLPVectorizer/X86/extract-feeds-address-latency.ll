; The vectorized select results are extracted to drive the seed indices, so the
; extracts sit on the critical path to the loads. Vectorizing is not profitable
; once the extraction latency is accounted for.

define void @circular_index_update(ptr noalias %state, ptr noalias %seed, i32 %size) {
; AVX2-LABEL: @circular_index_update(
; AVX2-NEXT:  entry:
