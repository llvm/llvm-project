  %j = load i32, ptr %j_ptr
  %size_minus_1 = add i32 %size, -1
  %i_is_zero = icmp eq i32 %i, 0
  %i_minus_1 = add i32 %i, -1
  %i_next = select i1 %i_is_zero, i32 %size_minus_1, i32 %i_minus_1
  %i_next_z = zext i32 %i_next to i64
  %seed_i_ptr = getelementptr inbounds i32, ptr %seed, i64 %i_next_z
