; AVX512-NEXT:    [[I_NEXT_Z:%.*]] = zext i32 [[I_NEXT]] to i64
; AVX512-NEXT:    [[SEED_I_PTR:%.*]] = getelementptr inbounds i32, ptr [[SEED:%.*]], i64 [[I_NEXT_Z]]
