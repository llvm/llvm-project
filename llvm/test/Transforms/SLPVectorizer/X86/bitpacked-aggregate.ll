; CHECK-NEXT:    [[Z0:%.*]] = zext i32 [[TMP3]] to i64
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <2 x i32> [[TMP2]], i64 1
; CHECK-NEXT:    [[Z1:%.*]] = zext i32 [[TMP4]] to i64
; CHECK-NEXT:    [[S1:%.*]] = shl nuw i64 [[Z1]], 32
; CHECK-NEXT:    [[W0:%.*]] = or disjoint i64 [[S1]], [[Z0]]
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[X]], i64 16
; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds i8, ptr [[Y]], i64 16
; CHECK-NEXT:    [[TMP5:%.*]] = load i32, ptr [[P]], align 1
; CHECK-NEXT:    [[TMP6:%.*]] = zext i32 [[TMP5]] to i64
; CHECK-NEXT:    [[A0:%.*]] = insertvalue { i64, i64 } poison, i64 [[W0]], 0
; CHECK-NEXT:    [[A1:%.*]] = insertvalue { i64, i64 } [[A0]], i64 [[TMP6]], 1
; CHECK-NEXT:    ret { i64, i64 } [[A1]]
;
entry:
  %x1.p = getelementptr inbounds i32, ptr %x, i64 1
  %y1.p = getelementptr inbounds i32, ptr %y, i64 1
  %x0 = load i32, ptr %x, align 4
  %x1 = load i32, ptr %x1.p, align 4
  %y0 = load i32, ptr %y, align 4
  %y1 = load i32, ptr %y1.p, align 4
  %m0 = call i32 @llvm.smin.i32(i32 %x0, i32 %y0)
  %m1 = call i32 @llvm.smin.i32(i32 %x1, i32 %y1)
  %z0 = zext i32 %m0 to i64
  %z1 = zext i32 %m1 to i64
  %s1 = shl nuw i64 %z1, 32
  %w0 = or disjoint i64 %s1, %z0
  %p = getelementptr inbounds i8, ptr %x, i64 16
  %q = getelementptr inbounds i8, ptr %y, i64 16
  %b0 = load i8, ptr %p, align 1
  %b1.p = getelementptr inbounds i8, ptr %p, i64 1
  %b1 = load i8, ptr %b1.p, align 1
  %b2.p = getelementptr inbounds i8, ptr %p, i64 2
  %b2 = load i8, ptr %b2.p, align 1
  %b3.p = getelementptr inbounds i8, ptr %p, i64 3
  %b3 = load i8, ptr %b3.p, align 1
  %e0 = zext i8 %b0 to i64
  %e1 = zext i8 %b1 to i64
  %e2 = zext i8 %b2 to i64
  %e3 = zext i8 %b3 to i64
  %t1 = shl nuw nsw i64 %e1, 8
  %t2 = shl nuw nsw i64 %e2, 16
  %t3 = shl nuw nsw i64 %e3, 24
  %u0 = or disjoint i64 %t1, %e0
  %u1 = or disjoint i64 %u0, %t2
  %w1 = or disjoint i64 %u1, %t3
  %a0 = insertvalue { i64, i64 } poison, i64 %w0, 0
  %a1 = insertvalue { i64, i64 } %a0, i64 %w1, 1
  ret { i64, i64 } %a1
}

; A field is shared between the packs.
define { i64, i64 } @shared_field(ptr %x, ptr %y) {
; CHECK-LABEL: @shared_field(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[X1_P:%.*]] = getelementptr inbounds i32, ptr [[X:%.*]], i64 1
; CHECK-NEXT:    [[Y1_P:%.*]] = getelementptr inbounds i32, ptr [[Y:%.*]], i64 1
