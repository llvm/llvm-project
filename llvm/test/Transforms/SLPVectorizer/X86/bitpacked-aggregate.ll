; CHECK-NEXT:    [[X1:%.*]] = load i32, ptr [[X1_P]], align 4
; CHECK-NEXT:    [[Y0:%.*]] = load i32, ptr [[Y]], align 4
; CHECK-NEXT:    [[Y1:%.*]] = load i32, ptr [[Y1_P]], align 4
; CHECK-NEXT:    [[M0:%.*]] = call i32 @llvm.smin.i32(i32 [[X0]], i32 [[Y0]])
; CHECK-NEXT:    [[M1:%.*]] = call i32 @llvm.smin.i32(i32 [[X1]], i32 [[Y1]])
; CHECK-NEXT:    [[Z0:%.*]] = zext i32 [[M0]] to i64
; CHECK-NEXT:    [[Z1:%.*]] = zext i32 [[M1]] to i64
; CHECK-NEXT:    [[S1:%.*]] = shl nuw i64 [[Z1]], 32
; CHECK-NEXT:    [[W0:%.*]] = or disjoint i64 [[S1]], [[Z0]]
; CHECK-NEXT:    [[W1:%.*]] = or disjoint i64 [[S1]], [[Z1]]
; CHECK-NEXT:    [[A0:%.*]] = insertvalue { i64, i64 } poison, i64 [[W0]], 0
; CHECK-NEXT:    [[A1:%.*]] = insertvalue { i64, i64 } [[A0]], i64 [[W1]], 1
; CHECK-NEXT:    ret { i64, i64 } [[A1]]
;
entry:
  %x1.p = getelementptr inbounds i32, ptr %x, i64 1
  %y1.p = getelementptr inbounds i32, ptr %y, i64 1
  %x0 = load i32, ptr %x, align 4
  %x1 = load i32, ptr %x1.p, align 4
  %y0 = load i32, ptr %y, align 4
  %y1 = load i32, ptr %y1.p, align 4
  %m0 = call i32 @llvm.smin.i32(i32 %x0, i32 %y0)
  %m1 = call i32 @llvm.smin.i32(i32 %x1, i32 %y1)
  %z0 = zext i32 %m0 to i64
  %z1 = zext i32 %m1 to i64
  %s1 = shl nuw i64 %z1, 32
  %w0 = or disjoint i64 %s1, %z0
  %w1 = or disjoint i64 %s1, %z1
  %a0 = insertvalue { i64, i64 } poison, i64 %w0, 0
  %a1 = insertvalue { i64, i64 } %a0, i64 %w1, 1
  ret { i64, i64 } %a1
}

