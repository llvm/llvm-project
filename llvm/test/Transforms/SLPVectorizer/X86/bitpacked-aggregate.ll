; CHECK-NEXT:    [[TMP8:%.*]] = zext <2 x i32> [[TMP4]] to <2 x i64>
; CHECK-NEXT:    [[TMP9:%.*]] = zext <2 x i32> [[TMP7]] to <2 x i64>
; CHECK-NEXT:    [[TMP10:%.*]] = shl nuw <2 x i64> [[TMP9]], splat (i64 32)
; CHECK-NEXT:    [[TMP11:%.*]] = or disjoint <2 x i64> [[TMP10]], [[TMP8]]
; CHECK-NEXT:    [[TMP12:%.*]] = extractelement <2 x i64> [[TMP10]], i64 1
; CHECK-NEXT:    store i64 [[TMP12]], ptr [[P:%.*]], align 8
; CHECK-NEXT:    [[TMP13:%.*]] = extractelement <2 x i64> [[TMP11]], i64 0
; CHECK-NEXT:    [[A0:%.*]] = insertvalue { i64, i64 } poison, i64 [[TMP13]], 0
; CHECK-NEXT:    [[TMP14:%.*]] = extractelement <2 x i64> [[TMP11]], i64 1
; CHECK-NEXT:    [[A1:%.*]] = insertvalue { i64, i64 } [[A0]], i64 [[TMP14]], 1
; CHECK-NEXT:    ret { i64, i64 } [[A1]]
;
entry:
  %x1.p = getelementptr inbounds i32, ptr %x, i64 1
  %x2.p = getelementptr inbounds i32, ptr %x, i64 2
  %x3.p = getelementptr inbounds i32, ptr %x, i64 3
  %y1.p = getelementptr inbounds i32, ptr %y, i64 1
  %y2.p = getelementptr inbounds i32, ptr %y, i64 2
  %y3.p = getelementptr inbounds i32, ptr %y, i64 3
  %x0 = load i32, ptr %x, align 4
  %x1 = load i32, ptr %x1.p, align 4
  %x2 = load i32, ptr %x2.p, align 4
  %x3 = load i32, ptr %x3.p, align 4
  %y0 = load i32, ptr %y, align 4
  %y1 = load i32, ptr %y1.p, align 4
  %y2 = load i32, ptr %y2.p, align 4
  %y3 = load i32, ptr %y3.p, align 4
  %m0 = call i32 @llvm.smin.i32(i32 %x0, i32 %y0)
  %m1 = call i32 @llvm.smin.i32(i32 %x1, i32 %y1)
  %m2 = call i32 @llvm.smin.i32(i32 %x2, i32 %y2)
  %m3 = call i32 @llvm.smin.i32(i32 %x3, i32 %y3)
  %z0 = zext i32 %m0 to i64
  %z1 = zext i32 %m1 to i64
  %z2 = zext i32 %m2 to i64
  %z3 = zext i32 %m3 to i64
  %s1 = shl nuw i64 %z1, 32
  %s3 = shl nuw i64 %z3, 32
  %w0 = or disjoint i64 %s1, %z0
  %w1 = or disjoint i64 %s3, %z2
  store i64 %s3, ptr %p, align 8
  %a0 = insertvalue { i64, i64 } poison, i64 %w0, 0
  %a1 = insertvalue { i64, i64 } %a0, i64 %w1, 1
  ret { i64, i64 } %a1
}

