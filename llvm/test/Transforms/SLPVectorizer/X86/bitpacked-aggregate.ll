; Extra use of a pack instruction.
define { i64, i64 } @extra_use(ptr %x, ptr %y, ptr %p) {
; CHECK-LABEL: @extra_use(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[X:%.*]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i32>, ptr [[Y:%.*]], align 4
