entry:
  %x1.p = getelementptr inbounds i32, ptr %x, i64 1
  %x2.p = getelementptr inbounds i32, ptr %x, i64 2
  %x3.p = getelementptr inbounds i32, ptr %x, i64 3
  %x0 = load i32, ptr %x, align 4
  %x1 = load i32, ptr %x1.p, align 4
