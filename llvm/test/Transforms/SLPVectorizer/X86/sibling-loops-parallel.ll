; The operands, gathered from the sibling loop, have a poison lane.
define void @poison_lane_root(ptr %dst, ptr %src, i64 %n, i64 %m, i32 %sel) {
; CHECK-LABEL: define void @poison_lane_root(
; CHECK-SAME: ptr [[DST:%.*]], ptr [[SRC:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i32 [[SEL:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    switch i32 [[SEL]], label %[[LOOP_C:.*]] [
; CHECK-NEXT:      i32 0, label %[[LOOP_A:.*]]
; CHECK-NEXT:      i32 1, label %[[LOOP_B:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[LOOP_A]]:
; CHECK-NEXT:    [[JA:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[JA_NEXT:%.*]], %[[LOOP_A]] ]
; CHECK-NEXT:    [[PA0:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[JA]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x i32>, ptr [[PA0]], align 4
; CHECK-NEXT:    [[TMP1:%.*]] = add <4 x i32> [[TMP0]], <i32 1, i32 2, i32 3, i32 4>
; CHECK-NEXT:    [[JA_NEXT]] = add i64 [[JA]], 1
; CHECK-NEXT:    [[CA:%.*]] = icmp ult i64 [[JA_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CA]], label %[[LOOP_A]], label %[[MERGE:.*]]
; CHECK:       [[LOOP_B]]:
; CHECK-NEXT:    [[JB:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[JB_NEXT:%.*]], %[[LOOP_B]] ]
; CHECK-NEXT:    [[PB0:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[JB]]
; CHECK-NEXT:    [[TMP2:%.*]] = load <4 x i32>, ptr [[PB0]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = add <4 x i32> [[TMP2]], <i32 5, i32 6, i32 7, i32 8>
; CHECK-NEXT:    [[JB_NEXT]] = add i64 [[JB]], 1
; CHECK-NEXT:    [[CB:%.*]] = icmp ult i64 [[JB_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CB]], label %[[LOOP_B]], label %[[MERGE]]
; CHECK:       [[LOOP_C]]:
; CHECK-NEXT:    [[JC:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[JC_NEXT:%.*]], %[[LOOP_C]] ]
; CHECK-NEXT:    [[PC0:%.*]] = getelementptr inbounds i32, ptr [[SRC]], i64 [[JC]]
; CHECK-NEXT:    [[PC1:%.*]] = getelementptr inbounds i32, ptr [[PC0]], i64 1
; CHECK-NEXT:    [[PC2:%.*]] = getelementptr inbounds i32, ptr [[PC0]], i64 2
; CHECK-NEXT:    [[LC1:%.*]] = load i32, ptr [[PC1]], align 4
; CHECK-NEXT:    [[MC1:%.*]] = mul i32 [[LC1]], 17
; CHECK-NEXT:    [[XC1:%.*]] = xor i32 [[MC1]], 31
; CHECK-NEXT:    [[VC1:%.*]] = add i32 [[XC1]], 9
; CHECK-NEXT:    [[TMP4:%.*]] = load <2 x i32>, ptr [[PC2]], align 4
; CHECK-NEXT:    [[TMP5:%.*]] = mul <2 x i32> [[TMP4]], <i32 19, i32 23>
; CHECK-NEXT:    [[TMP6:%.*]] = xor <2 x i32> [[TMP5]], <i32 37, i32 41>
; CHECK-NEXT:    [[TMP7:%.*]] = add <2 x i32> [[TMP6]], <i32 10, i32 11>
; CHECK-NEXT:    [[JC_NEXT]] = add i64 [[JC]], 1
; CHECK-NEXT:    [[CC:%.*]] = icmp ult i64 [[JC_NEXT]], [[M]]
; CHECK-NEXT:    [[TMP8:%.*]] = insertelement <4 x i32> poison, i32 [[VC1]], i64 1
; CHECK-NEXT:    [[TMP9:%.*]] = shufflevector <2 x i32> [[TMP7]], <2 x i32> poison, <4 x i32> <i32 0, i32 1, i32 poison, i32 poison>
; CHECK-NEXT:    [[TMP10:%.*]] = shufflevector <4 x i32> [[TMP8]], <4 x i32> [[TMP9]], <4 x i32> <i32 poison, i32 1, i32 4, i32 5>
; CHECK-NEXT:    br i1 [[CC]], label %[[LOOP_C]], label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[TMP11:%.*]] = phi <4 x i32> [ [[TMP1]], %[[LOOP_A]] ], [ [[TMP3]], %[[LOOP_B]] ], [ [[TMP10]], %[[LOOP_C]] ]
; CHECK-NEXT:    [[G0:%.*]] = getelementptr inbounds i32, ptr [[DST]], i64 0
; CHECK-NEXT:    store <4 x i32> [[TMP11]], ptr [[G0]], align 4
; CHECK-NEXT:    ret void
;
entry:
  switch i32 %sel, label %loop.c [
  i32 0, label %loop.a
  i32 1, label %loop.b
  ]

loop.a:
  %ja = phi i64 [ 0, %entry ], [ %ja.next, %loop.a ]
  %pa0 = getelementptr inbounds i32, ptr %src, i64 %ja
  %pa1 = getelementptr inbounds i32, ptr %pa0, i64 1
  %pa2 = getelementptr inbounds i32, ptr %pa0, i64 2
  %pa3 = getelementptr inbounds i32, ptr %pa0, i64 3
  %la0 = load i32, ptr %pa0, align 4
  %la1 = load i32, ptr %pa1, align 4
  %la2 = load i32, ptr %pa2, align 4
  %la3 = load i32, ptr %pa3, align 4
  %va0 = add i32 %la0, 1
  %va1 = add i32 %la1, 2
  %va2 = add i32 %la2, 3
  %va3 = add i32 %la3, 4
  %ja.next = add i64 %ja, 1
  %ca = icmp ult i64 %ja.next, %n
  br i1 %ca, label %loop.a, label %merge

loop.b:
  %jb = phi i64 [ 0, %entry ], [ %jb.next, %loop.b ]
  %pb0 = getelementptr inbounds i32, ptr %src, i64 %jb
  %pb1 = getelementptr inbounds i32, ptr %pb0, i64 1
  %pb2 = getelementptr inbounds i32, ptr %pb0, i64 2
  %pb3 = getelementptr inbounds i32, ptr %pb0, i64 3
  %lb0 = load i32, ptr %pb0, align 4
  %lb1 = load i32, ptr %pb1, align 4
  %lb2 = load i32, ptr %pb2, align 4
  %lb3 = load i32, ptr %pb3, align 4
  %vb0 = add i32 %lb0, 5
  %vb1 = add i32 %lb1, 6
  %vb2 = add i32 %lb2, 7
  %vb3 = add i32 %lb3, 8
  %jb.next = add i64 %jb, 1
  %cb = icmp ult i64 %jb.next, %n
  br i1 %cb, label %loop.b, label %merge

loop.c:
  %jc = phi i64 [ 0, %entry ], [ %jc.next, %loop.c ]
  %pc0 = getelementptr inbounds i32, ptr %src, i64 %jc
  %pc1 = getelementptr inbounds i32, ptr %pc0, i64 1
  %pc2 = getelementptr inbounds i32, ptr %pc0, i64 2
  %pc3 = getelementptr inbounds i32, ptr %pc0, i64 3
  %lc1 = load i32, ptr %pc1, align 4
  %lc2 = load i32, ptr %pc2, align 4
  %lc3 = load i32, ptr %pc3, align 4
  %mc1 = mul i32 %lc1, 17
  %mc2 = mul i32 %lc2, 19
  %mc3 = mul i32 %lc3, 23
  %xc1 = xor i32 %mc1, 31
  %xc2 = xor i32 %mc2, 37
  %xc3 = xor i32 %mc3, 41
  %vc1 = add i32 %xc1, 9
  %vc2 = add i32 %xc2, 10
  %vc3 = add i32 %xc3, 11
  %jc.next = add i64 %jc, 1
  %cc = icmp ult i64 %jc.next, %m
  br i1 %cc, label %loop.c, label %merge

merge:
  %p0 = phi i32 [ %va0, %loop.a ], [ %vb0, %loop.b ], [ poison, %loop.c ]
  %p1 = phi i32 [ %va1, %loop.a ], [ %vb1, %loop.b ], [ %vc1, %loop.c ]
  %p2 = phi i32 [ %va2, %loop.a ], [ %vb2, %loop.b ], [ %vc2, %loop.c ]
  %p3 = phi i32 [ %va3, %loop.a ], [ %vb3, %loop.b ], [ %vc3, %loop.c ]
  %g0 = getelementptr inbounds i32, ptr %dst, i64 0
  %g1 = getelementptr inbounds i32, ptr %dst, i64 1
  %g2 = getelementptr inbounds i32, ptr %dst, i64 2
  %g3 = getelementptr inbounds i32, ptr %dst, i64 3
  store i32 %p0, ptr %g0, align 4
  store i32 %p1, ptr %g1, align 4
  store i32 %p2, ptr %g2, align 4
  store i32 %p3, ptr %g3, align 4
  ret void
}

; The tree in the merge block gathers the values of the two-block sibling
; loop. The root of these values waits for the loop header, which stores
; the wider vector.
define void @multiblock_sibling_root(ptr noalias %dst, ptr noalias %src, ptr noalias %outc, i64 %n, i64 %m, i32 %sel) {
; CHECK-LABEL: define void @multiblock_sibling_root(
; CHECK-SAME: ptr noalias [[DST:%.*]], ptr noalias [[SRC:%.*]], ptr noalias [[OUTC:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i32 [[SEL:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    switch i32 [[SEL]], label %[[LOOP_C_HDR:.*]] [
; CHECK-NEXT:      i32 0, label %[[LOOP_A:.*]]
; CHECK-NEXT:      i32 1, label %[[LOOP_B:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[LOOP_A]]:
; CHECK-NEXT:    [[JA:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[JA_NEXT:%.*]], %[[LOOP_A]] ]
; CHECK-NEXT:    [[DA:%.*]] = sitofp i64 [[JA]] to double
; CHECK-NEXT:    [[VA0:%.*]] = fmul double [[DA]], 2.000000e+00
; CHECK-NEXT:    [[VA1:%.*]] = fmul double [[DA]], 3.000000e+00
; CHECK-NEXT:    [[JA_NEXT]] = add i64 [[JA]], 1
; CHECK-NEXT:    [[CA:%.*]] = icmp ult i64 [[JA_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CA]], label %[[LOOP_A]], label %[[MERGE:.*]]
; CHECK:       [[LOOP_B]]:
; CHECK-NEXT:    [[JB:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[JB_NEXT:%.*]], %[[LOOP_B]] ]
; CHECK-NEXT:    [[DB:%.*]] = sitofp i64 [[JB]] to double
; CHECK-NEXT:    [[VB0:%.*]] = fmul double [[DB]], 5.000000e+00
; CHECK-NEXT:    [[VB1:%.*]] = fmul double [[DB]], 7.000000e+00
; CHECK-NEXT:    [[JB_NEXT]] = add i64 [[JB]], 1
; CHECK-NEXT:    [[CB:%.*]] = icmp ult i64 [[JB_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CB]], label %[[LOOP_B]], label %[[MERGE]]
; CHECK:       [[LOOP_C_HDR]]:
; CHECK-NEXT:    [[JC:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[JC_NEXT:%.*]], %[[LOOP_C_LATCH:.*]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = phi <4 x double> [ zeroinitializer, %[[ENTRY]] ], [ [[TMP4:%.*]], %[[LOOP_C_LATCH]] ]
; CHECK-NEXT:    [[OC0:%.*]] = getelementptr inbounds double, ptr [[OUTC]], i64 [[JC]]
; CHECK-NEXT:    store <4 x double> [[TMP0]], ptr [[OC0]], align 8
; CHECK-NEXT:    br label %[[LOOP_C_LATCH]]
; CHECK:       [[LOOP_C_LATCH]]:
; CHECK-NEXT:    [[PC0:%.*]] = getelementptr inbounds double, ptr [[SRC]], i64 [[JC]]
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x double>, ptr [[PC0]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = fmul <4 x double> [[TMP1]], <double 1.700000e+01, double 1.900000e+01, double 2.300000e+01, double 2.900000e+01>
; CHECK-NEXT:    [[TMP3:%.*]] = fadd <4 x double> [[TMP2]], <double 3.100000e+01, double 3.700000e+01, double 4.100000e+01, double 4.300000e+01>
; CHECK-NEXT:    [[TMP4]] = fsub <4 x double> [[TMP3]], <double 3.000000e+00, double 5.000000e+00, double 7.000000e+00, double 1.100000e+01>
; CHECK-NEXT:    [[JC_NEXT]] = add i64 [[JC]], 1
; CHECK-NEXT:    [[CC:%.*]] = icmp ult i64 [[JC_NEXT]], [[M]]
; CHECK-NEXT:    [[TMP5:%.*]] = extractelement <4 x double> [[TMP4]], i64 0
; CHECK-NEXT:    [[TMP6:%.*]] = extractelement <4 x double> [[TMP4]], i64 1
; CHECK-NEXT:    br i1 [[CC]], label %[[LOOP_C_HDR]], label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P0:%.*]] = phi double [ [[VA0]], %[[LOOP_A]] ], [ [[VB0]], %[[LOOP_B]] ], [ [[TMP5]], %[[LOOP_C_LATCH]] ]
; CHECK-NEXT:    [[P1:%.*]] = phi double [ [[VA1]], %[[LOOP_A]] ], [ [[VB1]], %[[LOOP_B]] ], [ [[TMP6]], %[[LOOP_C_LATCH]] ]
; CHECK-NEXT:    [[G0:%.*]] = getelementptr inbounds double, ptr [[DST]], i64 0
; CHECK-NEXT:    [[G1:%.*]] = getelementptr inbounds double, ptr [[DST]], i64 1
; CHECK-NEXT:    store double [[P0]], ptr [[G0]], align 8
; CHECK-NEXT:    store double [[P1]], ptr [[G1]], align 8
; CHECK-NEXT:    ret void
;
entry:
  switch i32 %sel, label %loop.c.hdr [
  i32 0, label %loop.a
  i32 1, label %loop.b
  ]

loop.a:
  %ja = phi i64 [ 0, %entry ], [ %ja.next, %loop.a ]
  %da = sitofp i64 %ja to double
  %va0 = fmul double %da, 2.0
  %va1 = fmul double %da, 3.0
  %ja.next = add i64 %ja, 1
  %ca = icmp ult i64 %ja.next, %n
  br i1 %ca, label %loop.a, label %merge

loop.b:
  %jb = phi i64 [ 0, %entry ], [ %jb.next, %loop.b ]
  %db = sitofp i64 %jb to double
  %vb0 = fmul double %db, 5.0
  %vb1 = fmul double %db, 7.0
  %jb.next = add i64 %jb, 1
  %cb = icmp ult i64 %jb.next, %n
  br i1 %cb, label %loop.b, label %merge

loop.c.hdr:
  %jc = phi i64 [ 0, %entry ], [ %jc.next, %loop.c.latch ]
  %h0 = phi double [ 0.0, %entry ], [ %vc0, %loop.c.latch ]
  %h1 = phi double [ 0.0, %entry ], [ %vc1, %loop.c.latch ]
  %h2 = phi double [ 0.0, %entry ], [ %vc2, %loop.c.latch ]
  %h3 = phi double [ 0.0, %entry ], [ %vc3, %loop.c.latch ]
  %oc0 = getelementptr inbounds double, ptr %outc, i64 %jc
  %oc1 = getelementptr inbounds double, ptr %oc0, i64 1
  %oc2 = getelementptr inbounds double, ptr %oc0, i64 2
  %oc3 = getelementptr inbounds double, ptr %oc0, i64 3
  store double %h0, ptr %oc0, align 8
  store double %h1, ptr %oc1, align 8
  store double %h2, ptr %oc2, align 8
  store double %h3, ptr %oc3, align 8
  br label %loop.c.latch

loop.c.latch:
  %pc0 = getelementptr inbounds double, ptr %src, i64 %jc
  %pc1 = getelementptr inbounds double, ptr %pc0, i64 1
  %pc2 = getelementptr inbounds double, ptr %pc0, i64 2
  %pc3 = getelementptr inbounds double, ptr %pc0, i64 3
  %lc0 = load double, ptr %pc0, align 8
  %lc1 = load double, ptr %pc1, align 8
  %lc2 = load double, ptr %pc2, align 8
  %lc3 = load double, ptr %pc3, align 8
  %mc0 = fmul double %lc0, 17.0
  %mc1 = fmul double %lc1, 19.0
  %mc2 = fmul double %lc2, 23.0
  %mc3 = fmul double %lc3, 29.0
  %xc0 = fadd double %mc0, 31.0
  %xc1 = fadd double %mc1, 37.0
  %xc2 = fadd double %mc2, 41.0
  %xc3 = fadd double %mc3, 43.0
  %vc0 = fsub double %xc0, 3.0
  %vc1 = fsub double %xc1, 5.0
  %vc2 = fsub double %xc2, 7.0
  %vc3 = fsub double %xc3, 11.0
  %jc.next = add i64 %jc, 1
  %cc = icmp ult i64 %jc.next, %m
  br i1 %cc, label %loop.c.hdr, label %merge

merge:
  %p0 = phi double [ %va0, %loop.a ], [ %vb0, %loop.b ], [ %vc0, %loop.c.latch ]
  %p1 = phi double [ %va1, %loop.a ], [ %vb1, %loop.b ], [ %vc1, %loop.c.latch ]
  %g0 = getelementptr inbounds double, ptr %dst, i64 0
  %g1 = getelementptr inbounds double, ptr %dst, i64 1
