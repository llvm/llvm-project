  %p7 = getelementptr double, ptr %p, i64 7
  %l7 = load double, ptr %p7, align 8
  %c1 = fadd reassoc double %l0, %l1
  %c2 = fadd reassoc double %c1, %l2
  %c3 = fadd reassoc double %c2, %l3
