; Reassociation is enough to vectorize fadd reductions, nsz is not required.

define double @reassoc_only(ptr %p) {
; CHECK-LABEL: define double @reassoc_only(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load <8 x double>, ptr [[P]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call reassoc double @llvm.vector.reduce.fadd.v8f64(double -0.000000e+00, <8 x double> [[TMP0]])
; CHECK-NEXT:    ret double [[TMP1]]
;
entry:
  %l0 = load double, ptr %p, align 8
  %p1 = getelementptr double, ptr %p, i64 1
  %l1 = load double, ptr %p1, align 8
  %p2 = getelementptr double, ptr %p, i64 2
  %l2 = load double, ptr %p2, align 8
  %p3 = getelementptr double, ptr %p, i64 3
  %l3 = load double, ptr %p3, align 8
