  %l3 = load i32, ptr getelementptr inbounds nuw (i8, ptr @in, i64 12), align 4
  %a3 = add i32 %l3, %x
  %m3 = or disjoint i32 %a3, 1024
  store i32 %m3, ptr getelementptr inbounds nuw (i8, ptr @out, i64 12), align 4
