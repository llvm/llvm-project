; RUN: opt < %s -passes=slp-vectorizer -mtriple=riscv64 -mattr=+v -S -slp-threshold=-100 | FileCheck %s

; Compressed interleaved load created during initial tree creation
; may get shuffled during reordering, so that it not longer is counted
; as a compressed load during costing

define void @test() {
; CHECK-LABEL: define void @test(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[RANGE_TMP:%.*]] = alloca ptr, i64 5, align 8
; CHECK-NEXT:    [[TMP0:%.*]] = load <4 x ptr>, ptr [[RANGE_TMP]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = shufflevector <4 x ptr> [[TMP0]], <4 x ptr> poison, <2 x i32> <i32 3, i32 0>
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi <2 x ptr> [ [[TMP1]], %[[ENTRY]] ], [ [[TMP4:%.*]], %[[INCREMENT:.*]] ]
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <2 x ptr> [[TMP2]], <2 x ptr> <ptr null, ptr poison>, <2 x i32> <i32 2, i32 1>
; CHECK-NEXT:    br label %[[INCREMENT]]
; CHECK:       [[INCREMENT]]:
; CHECK-NEXT:    [[TMP4]] = phi <2 x ptr> [ [[TMP3]], %[[LOOP]] ]
; CHECK-NEXT:    [[NEXT_BEGIN:%.*]] = extractelement <2 x ptr> [[TMP4]], i64 1
; CHECK-NEXT:    [[IS_END:%.*]] = load i1, ptr [[NEXT_BEGIN]], align 1
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  %range_tmp = alloca ptr, i64 5
  %begin_ptr = load ptr, ptr %range_tmp
  %end_addr = getelementptr i8, ptr %range_tmp, i64 24
  %end_ptr = load ptr, ptr %end_addr
  br label %loop

loop:
  %end = phi ptr [ %end_ptr, %entry ], [ %next_end, %increment ]
  %begin = phi ptr [ %begin_ptr, %entry ], [ %next_begin, %increment ]
  br label %increment

increment:
  %next_end = phi ptr [ null, %loop ]
  %next_begin = phi ptr [ %begin, %loop ]
  %is_end = load i1, ptr %next_begin
  br label %loop
}
