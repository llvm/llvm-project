; CHECK-NEXT:    [[X1:%.*]] = xor i32 [[L1]], [[L0]]
; CHECK-NEXT:    [[SHR_1:%.*]] = lshr i64 [[XOR]], 16
; CHECK-NEXT:    [[AND_1:%.*]] = and i64 [[SHR_1]], 255
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 2048), i64 [[AND_1]]
; CHECK-NEXT:    [[L2:%.*]] = load i32, ptr [[P2]], align 4
; CHECK-NEXT:    [[X2:%.*]] = xor i32 [[L2]], [[X1]]
; CHECK-NEXT:    [[SHR_2:%.*]] = lshr i64 [[XOR]], 24
; CHECK-NEXT:    [[AND_2:%.*]] = and i64 [[SHR_2]], 255
; CHECK-NEXT:    [[P3:%.*]] = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 3072), i64 [[AND_2]]
; CHECK-NEXT:    [[L3:%.*]] = load i32, ptr [[P3]], align 4
