  %shr = lshr i64 %xor, 8
  %and1 = and i64 %shr, 255
  %p1 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 1024), i64 %and1
  %l1 = load i32, ptr %p1, align 4
