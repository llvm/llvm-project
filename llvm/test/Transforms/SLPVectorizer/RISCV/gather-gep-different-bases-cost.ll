; CHECK-NEXT:    [[CRC0:%.*]] = phi i32 [ [[CRC]], %[[ENTRY]] ], [ [[TMP7:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[WORDS_P:%.*]] = phi ptr [ [[WORDS]], %[[ENTRY]] ], [ [[WORDS_NEXT:%.*]], %[[LOOP]] ]
