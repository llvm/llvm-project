; computed from the scaled indices and the bases, it is not folded into the
; indexed load.

@tbl = external constant [8 x [256 x i32]]

define i32 @crc_loop(ptr %words, i32 %crc) {
; CHECK-LABEL: define i32 @crc_loop(
; CHECK-SAME: ptr [[WORDS:%.*]], i32 [[CRC:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CRC0:%.*]] = phi i32 [ [[CRC]], %[[ENTRY]] ], [ [[TMP7:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[WORDS_P:%.*]] = phi ptr [ [[WORDS]], %[[ENTRY]] ], [ [[WORDS_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[CONV:%.*]] = zext i32 [[CRC0]] to i64
; CHECK-NEXT:    [[W:%.*]] = load i64, ptr [[WORDS_P]], align 8
; CHECK-NEXT:    [[XOR:%.*]] = xor i64 [[W]], [[CONV]]
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <8 x i64> poison, i64 [[XOR]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <8 x i64> [[TMP0]], i64 [[W]], i64 1
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <8 x i64> [[TMP1]], <8 x i64> poison, <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 1, i32 1, i32 1, i32 1>
; CHECK-NEXT:    [[TMP3:%.*]] = lshr <8 x i64> [[TMP2]], <i64 8, i64 0, i64 16, i64 24, i64 32, i64 40, i64 48, i64 56>
; CHECK-NEXT:    [[TMP4:%.*]] = and <8 x i64> [[TMP3]], <i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 -1>
; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr inbounds nuw [4 x i8], <8 x ptr> <ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 1024), ptr @tbl, ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 2048), ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 3072), ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 4096), ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 5120), ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 6144), ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 7168)>, <8 x i64> [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = call <8 x i32> @llvm.masked.gather.v8i32.v8p0(<8 x ptr> align 4 [[TMP5]], <8 x i1> splat (i1 true), <8 x i32> poison)
; CHECK-NEXT:    [[TMP7]] = call i32 @llvm.vector.reduce.xor.v8i32(<8 x i32> [[TMP6]])
; CHECK-NEXT:    [[WORDS_NEXT]] = getelementptr inbounds nuw i8, ptr [[WORDS_P]], i64 8
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[IV_NEXT]], 1024
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[TMP7]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %crc0 = phi i32 [ %crc, %entry ], [ %x7, %loop ]
  %words.p = phi ptr [ %words, %entry ], [ %words.next, %loop ]
  %conv = zext i32 %crc0 to i64
  %w = load i64, ptr %words.p, align 8
  %xor = xor i64 %w, %conv
  %and = and i64 %xor, 255
  %p0 = getelementptr inbounds nuw [4 x i8], ptr @tbl, i64 %and
  %l0 = load i32, ptr %p0, align 4
  %shr = lshr i64 %xor, 8
  %and1 = and i64 %shr, 255
  %p1 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 1024), i64 %and1
  %l1 = load i32, ptr %p1, align 4
  %x1 = xor i32 %l1, %l0
  %shr.1 = lshr i64 %xor, 16
  %and.1 = and i64 %shr.1, 255
  %p2 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 2048), i64 %and.1
  %l2 = load i32, ptr %p2, align 4
  %x2 = xor i32 %l2, %x1
  %shr.2 = lshr i64 %xor, 24
  %and.2 = and i64 %shr.2, 255
  %p3 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 3072), i64 %and.2
  %l3 = load i32, ptr %p3, align 4
  %x3 = xor i32 %l3, %x2
  %shr.3 = lshr i64 %w, 32
  %and.3 = and i64 %shr.3, 255
  %p4 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 4096), i64 %and.3
  %l4 = load i32, ptr %p4, align 4
  %x4 = xor i32 %l4, %x3
  %shr.4 = lshr i64 %w, 40
  %and.4 = and i64 %shr.4, 255
  %p5 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 5120), i64 %and.4
  %l5 = load i32, ptr %p5, align 4
  %x5 = xor i32 %l5, %x4
  %shr.5 = lshr i64 %w, 48
  %and.5 = and i64 %shr.5, 255
  %p6 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 6144), i64 %and.5
  %l6 = load i32, ptr %p6, align 4
  %x6 = xor i32 %l6, %x5
  %shr.6 = lshr i64 %w, 56
  %p7 = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 7168), i64 %shr.6
  %l7 = load i32, ptr %p7, align 4
  %x7 = xor i32 %l7, %x6
  %words.next = getelementptr inbounds nuw i8, ptr %words.p, i64 8
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp eq i64 %iv.next, 1024
  br i1 %cmp, label %exit, label %loop

exit:
  ret i32 %x7
}
