; CHECK-NEXT:    [[SHR_3:%.*]] = lshr i64 [[W]], 32
; CHECK-NEXT:    [[AND_3:%.*]] = and i64 [[SHR_3]], 255
; CHECK-NEXT:    [[P4:%.*]] = getelementptr inbounds nuw [4 x i8], ptr getelementptr inbounds nuw (i8, ptr @tbl, i64 4096), i64 [[AND_3]]
; CHECK-NEXT:    [[L4:%.*]] = load i32, ptr [[P4]], align 4
; CHECK-NEXT:    [[X4:%.*]] = xor i32 [[L4]], [[X3]]
; CHECK-NEXT:    [[SHR_4:%.*]] = lshr i64 [[W]], 40
