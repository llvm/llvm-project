; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -mtriple=riscv64 -mattr=+v,+zvl256b -passes=slp-vectorizer -S -slp-revec -pass-remarks-output=%t %s | FileCheck %s
; RUN: FileCheck %s --check-prefix=REMARK --input-file=%t

; The compress shuffle emitted for a masked load of vector scalars uses the
; compress mask expanded to the individual elements, so its cost has to be
; computed with that mask. Costed with the unexpanded mask, the <24 x i8> to
; <16 x i8> shuffle looked like a <2 x i8> shuffle and the masked load plus
; compress made the tree look profitable, when it is cheaper to keep the two
; <8 x i8> loads, adds and stores as they are.

; REMARK:      Name: NotBeneficial
; REMARK-NEXT: Function: widened_strided_add
; REMARK-NEXT: Args:
; REMARK-NEXT:   - String: 'List vectorization was possible but not beneficial with cost '
; REMARK-NEXT:   - Cost: '0'
; REMARK-NEXT:   - String: ' >= '
; REMARK-NEXT:   - Treshold: '0'
define void @widened_strided_add(ptr %in, ptr %out) {
; CHECK-LABEL: define void @widened_strided_add(
; CHECK-SAME: ptr [[IN:%.*]], ptr [[OUT:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IN1:%.*]] = getelementptr i8, ptr [[IN]], i64 16
; CHECK-NEXT:    [[L0:%.*]] = load <8 x i8>, ptr [[IN]], align 2
; CHECK-NEXT:    [[L1:%.*]] = load <8 x i8>, ptr [[IN1]], align 2
; CHECK-NEXT:    [[A0:%.*]] = add <8 x i8> [[L0]], splat (i8 5)
; CHECK-NEXT:    [[A1:%.*]] = add <8 x i8> [[L1]], splat (i8 5)
; CHECK-NEXT:    [[OUT1:%.*]] = getelementptr i8, ptr [[OUT]], i64 8
; CHECK-NEXT:    store <8 x i8> [[A0]], ptr [[OUT]], align 2
; CHECK-NEXT:    store <8 x i8> [[A1]], ptr [[OUT1]], align 2
; CHECK-NEXT:    ret void
;
entry:
  %in1 = getelementptr i8, ptr %in, i64 16
  %l0 = load <8 x i8>, ptr %in, align 2
  %l1 = load <8 x i8>, ptr %in1, align 2
  %a0 = add <8 x i8> %l0, splat (i8 5)
  %a1 = add <8 x i8> %l1, splat (i8 5)
  %out1 = getelementptr i8, ptr %out, i64 8
  store <8 x i8> %a0, ptr %out, align 2
  store <8 x i8> %a1, ptr %out1, align 2
  ret void
}
