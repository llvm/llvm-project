; Element-wise multiply-high built from extract/insert element should be
; vectorized into a vector smulh/umulh when only the P extension is available.

define <2 x i16> @smulh_v2i16(<2 x i16> %a, <2 x i16> %b) {
; CHECK-LABEL: define <2 x i16> @smulh_v2i16(
; CHECK-SAME: <2 x i16> [[A:%.*]], <2 x i16> [[B:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[TMP1:%.*]] = call <2 x i16> @llvm.smulh.v2i16(<2 x i16> [[A]], <2 x i16> [[B]])
; CHECK-NEXT:    ret <2 x i16> [[TMP1]]
;
  %a0 = extractelement <2 x i16> %a, i32 0
  %b0 = extractelement <2 x i16> %b, i32 0
  %m0 = call i16 @llvm.smulh.i16(i16 %a0, i16 %b0)
  %v0 = insertelement <2 x i16> poison, i16 %m0, i32 0
  %a1 = extractelement <2 x i16> %a, i32 1
  %b1 = extractelement <2 x i16> %b, i32 1
  %m1 = call i16 @llvm.smulh.i16(i16 %a1, i16 %b1)
  %res = insertelement <2 x i16> %v0, i16 %m1, i32 1
  ret <2 x i16> %res
}

