; Open-coded form: (sext a * sext b) >> 16, as emitted by clang for
; result[i] = ((int)a[i] * (int)b[i]) >> 16.
define <2 x i16> @smulh_v2i16_opencoded(<2 x i16> %a, <2 x i16> %b) {
; CHECK-LABEL: define <2 x i16> @smulh_v2i16_opencoded(
; CHECK-SAME: <2 x i16> [[A:%.*]], <2 x i16> [[B:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP1:%.*]] = sext <2 x i16> [[A]] to <2 x i32>
; CHECK-NEXT:    [[TMP2:%.*]] = sext <2 x i16> [[B]] to <2 x i32>
; CHECK-NEXT:    [[TMP3:%.*]] = mul nsw <2 x i32> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = lshr <2 x i32> [[TMP3]], splat (i32 16)
; CHECK-NEXT:    [[TMP5:%.*]] = trunc <2 x i32> [[TMP4]] to <2 x i16>
; CHECK-NEXT:    ret <2 x i16> [[TMP5]]
;
  %a0 = extractelement <2 x i16> %a, i32 0
  %b0 = extractelement <2 x i16> %b, i32 0
  %a0e = sext i16 %a0 to i32
  %b0e = sext i16 %b0 to i32
  %p0 = mul nsw i32 %a0e, %b0e
  %s0 = lshr i32 %p0, 16
  %t0 = trunc i32 %s0 to i16
  %v0 = insertelement <2 x i16> poison, i16 %t0, i32 0
  %a1 = extractelement <2 x i16> %a, i32 1
  %b1 = extractelement <2 x i16> %b, i32 1
  %a1e = sext i16 %a1 to i32
  %b1e = sext i16 %b1 to i32
  %p1 = mul nsw i32 %a1e, %b1e
  %s1 = lshr i32 %p1, 16
  %t1 = trunc i32 %s1 to i16
  %res = insertelement <2 x i16> %v0, i16 %t1, i32 1
  ret <2 x i16> %res
}

