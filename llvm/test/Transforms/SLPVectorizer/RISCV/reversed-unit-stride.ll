; RUN: opt -mtriple=riscv64 -mattr=+m,+v -passes=slp-vectorizer -S -slp-enable-strided-stores < %s | FileCheck %s

; With MaxVectorCoalesceElts = 1, reversing the lanes and using a unit-stride
; store is cheaper than a negative-stride store.
define void @reversed_unit_stride(ptr noalias %pl, ptr noalias %ps) {
; CHECK-LABEL: define void @reversed_unit_stride(
; CHECK-SAME: ptr noalias [[PL:%.*]], ptr noalias [[PS:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[TMP1:%.*]] = load <4 x i8>, ptr [[PL]], align 1
; CHECK-NEXT:    [[TMP2:%.*]] = shufflevector <4 x i8> [[TMP1]], <4 x i8> poison, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
; CHECK-NEXT:    store <4 x i8> [[TMP2]], ptr [[PS]], align 1
; CHECK-NEXT:    ret void
;
  %gl1 = getelementptr inbounds i8, ptr %pl, i64 1
  %gl2 = getelementptr inbounds i8, ptr %pl, i64 2
  %gl3 = getelementptr inbounds i8, ptr %pl, i64 3
  %l0 = load i8, ptr %pl, align 1
  %l1 = load i8, ptr %gl1, align 1
  %l2 = load i8, ptr %gl2, align 1
  %l3 = load i8, ptr %gl3, align 1
  %gs1 = getelementptr inbounds i8, ptr %ps, i64 1
  %gs2 = getelementptr inbounds i8, ptr %ps, i64 2
  %gs3 = getelementptr inbounds i8, ptr %ps, i64 3
  store i8 %l0, ptr %gs3, align 1
  store i8 %l1, ptr %gs2, align 1
  store i8 %l2, ptr %gs1, align 1
  store i8 %l3, ptr %ps, align 1
  ret void
}
