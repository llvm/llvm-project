define void @f32x2_phi_store(ptr addrspace(1) %x, ptr addrspace(3) %scratch, i1 %cond) {
; CHECK-LABEL: @f32x2_phi_store(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br i1 [[COND:%.*]], label [[THEN:%.*]], label [[JOIN:%.*]]
; CHECK:       then:
; CHECK-NEXT:    [[V:%.*]] = load <2 x float>, ptr addrspace(1) [[X:%.*]], align 8
; CHECK-NEXT:    br label [[JOIN]]
; CHECK:       join:
; CHECK-NEXT:    [[PHI:%.*]] = phi <2 x float> [ [[V]], [[THEN]] ], [ zeroinitializer, [[ENTRY:%.*]] ]
; CHECK-NEXT:    store <2 x float> [[PHI]], ptr addrspace(3) [[SCRATCH:%.*]], align 8
; CHECK-NEXT:    ret void
;
entry:
  br i1 %cond, label %then, label %join

then:
  %v = load <2 x float>, ptr addrspace(1) %x, align 8
  %v0 = extractelement <2 x float> %v, i32 0
  %v1 = extractelement <2 x float> %v, i32 1
  br label %join

join:
  %p0 = phi float [ %v0, %then ], [ 0.0, %entry ]
  %p1 = phi float [ %v1, %then ], [ 0.0, %entry ]
  %i0 = insertelement <2 x float> poison, float %p0, i32 0
  %i1 = insertelement <2 x float> %i0, float %p1, i32 1
  store <2 x float> %i1, ptr addrspace(3) %scratch, align 8
  ret void
}

