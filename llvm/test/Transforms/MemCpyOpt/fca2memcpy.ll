define void @loop_memoryphi(ptr %a, ptr %b) {
; CHECK-LABEL: @loop_memoryphi(
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    call void @llvm.memmove.p0.p0.i64(ptr align 8 [[B:%.*]], ptr align 8 [[A:%.*]], i64 16, i1 false)
; CHECK-NEXT:    br label [[LOOP]]
;
  br label %loop

loop:
  %v = load { i64, i64 }, ptr %a
  store { i64, i64 } %v, ptr %b
  br label %loop
}

; There are multiple instructions that can clobber the source memory here.
; We can move the dest write past the store to %ptr.24, but not the memcpy.
; Make sure we don't perform fca2memcpy conversion in this case.
define void @multiple_clobbering(ptr %ptr, ptr %ptr.copy) {
; CHECK-LABEL: @multiple_clobbering(
; CHECK-NEXT:    [[PTR_8:%.*]] = getelementptr inbounds nuw i8, ptr [[PTR:%.*]], i64 8
; CHECK-NEXT:    [[PTR_24:%.*]] = getelementptr inbounds nuw i8, ptr [[PTR]], i64 24
; CHECK-NEXT:    [[PTR_32:%.*]] = getelementptr inbounds nuw i8, ptr [[PTR]], i64 32
; CHECK-NEXT:    [[PTR_COPY_8:%.*]] = getelementptr inbounds nuw i8, ptr [[PTR_COPY:%.*]], i64 8
; CHECK-NEXT:    [[STRUCT:%.*]] = load { i32, i64 }, ptr [[PTR_COPY_8]], align 8
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr [[PTR_8]], ptr [[PTR_32]], i64 12, i1 false)
; CHECK-NEXT:    store i64 1, ptr [[PTR_24]], align 8
; CHECK-NEXT:    store { i32, i64 } [[STRUCT]], ptr [[PTR_32]], align 8
; CHECK-NEXT:    ret void
;
  %ptr.8 = getelementptr inbounds nuw i8, ptr %ptr, i64 8
  %ptr.24 = getelementptr inbounds nuw i8, ptr %ptr, i64 24
  %ptr.32 = getelementptr inbounds nuw i8, ptr %ptr, i64 32
  %ptr.copy.8 = getelementptr inbounds nuw i8, ptr %ptr.copy, i64 8
  %struct = load { i32, i64 }, ptr %ptr.copy.8, align 8
  call void @llvm.memcpy.p0.p0.i64(ptr %ptr.8, ptr %ptr.32, i64 12, i1 false)
  store i64 1, ptr %ptr.24, align 8
  store { i32, i64 } %struct, ptr %ptr.32, align 8
  ret void
}

declare void @call()

@g = global [1 x i8] zeroinitializer

declare void @exit(i32) noreturn
declare void @noreturn_nounwind() noreturn nounwind
declare void @nounwind_only() nounwind
declare void @willreturn_only() willreturn
declare void @nounwind_willreturn() nounwind willreturn

; The insertion point itself must transfer execution to its successor. Hoisting
; this unreachable store above exit would introduce an out-of-bounds write.
define i32 @main() {
; CHECK-LABEL: @main(
; CHECK-NEXT:    [[BUFFER:%.*]] = alloca [1 x i8], align 1
; CHECK-NEXT:    [[VALUE:%.*]] = load [1 x i8], ptr @g, align 1
; CHECK-NEXT:    call void @exit(i32 0)
; CHECK-NEXT:    [[END:%.*]] = getelementptr i8, ptr [[BUFFER]], i64 1
; CHECK-NEXT:    store [1 x i8] [[VALUE]], ptr [[END]], align 1
; CHECK-NEXT:    ret i32 0
;
  %buffer = alloca [1 x i8]
  %value = load [1 x i8], ptr @g
  call void @exit(i32 0)
  %end = getelementptr i8, ptr %buffer, i64 1
  store [1 x i8] %value, ptr %end
  ret i32 0
}

; Check the insertion point even when there are no intervening instructions.
define void @no_hoist_noreturn_nounwind() {
; CHECK-LABEL: @no_hoist_noreturn_nounwind(
; CHECK-NEXT:    [[BUFFER:%.*]] = alloca [1 x i8], align 1
; CHECK-NEXT:    [[VALUE:%.*]] = load [1 x i8], ptr @g, align 1
; CHECK-NEXT:    call void @noreturn_nounwind()
; CHECK-NEXT:    store [1 x i8] [[VALUE]], ptr [[BUFFER]], align 1
; CHECK-NEXT:    ret void
;
  %buffer = alloca [1 x i8]
  %value = load [1 x i8], ptr @g
  call void @noreturn_nounwind()
  store [1 x i8] %value, ptr %buffer
  ret void
}

; nounwind alone does not guarantee that the call returns.
define void @no_hoist_may_not_return() {
; CHECK-LABEL: @no_hoist_may_not_return(
; CHECK-NEXT:    [[BUFFER:%.*]] = alloca [2 x i8], align 1
; CHECK-NEXT:    [[VALUE:%.*]] = load [1 x i8], ptr @g, align 1
; CHECK-NEXT:    call void @nounwind_only()
; CHECK-NEXT:    [[END:%.*]] = getelementptr i8, ptr [[BUFFER]], i64 1
; CHECK-NEXT:    store [1 x i8] [[VALUE]], ptr [[END]], align 1
; CHECK-NEXT:    ret void
;
  %buffer = alloca [2 x i8]
  %value = load [1 x i8], ptr @g
  call void @nounwind_only()
  %end = getelementptr i8, ptr %buffer, i64 1
  store [1 x i8] %value, ptr %end
  ret void
}

; willreturn alone does not guarantee that the call cannot unwind.
define void @no_hoist_may_throw() {
; CHECK-LABEL: @no_hoist_may_throw(
