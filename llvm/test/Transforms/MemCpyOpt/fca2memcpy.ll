; Safe hoisting still moves both the address computation and the copy.
define void @hoist_nounwind_willreturn() {
; CHECK-LABEL: @hoist_nounwind_willreturn(
; CHECK-NEXT:    [[BUFFER:%.*]] = alloca [2 x i8], align 1
; CHECK-NEXT:    [[END:%.*]] = getelementptr i8, ptr [[BUFFER]], i64 1
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 1 [[END]], ptr align 1 @g, i64 1, i1 false)
; CHECK-NEXT:    call void @nounwind_willreturn()
; CHECK-NEXT:    ret void
;
  %buffer = alloca [2 x i8]
  %value = load [1 x i8], ptr @g
  call void @nounwind_willreturn()
  %end = getelementptr i8, ptr %buffer, i64 1
  store [1 x i8] %value, ptr %end
  ret void
}
