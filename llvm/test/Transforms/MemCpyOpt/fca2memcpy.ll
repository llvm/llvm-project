; CHECK-LABEL: @copy(
; CHECK-NEXT:    call void @llvm.memmove.p0.p0.i64(ptr align 8 [[DST:%.*]], ptr align 8 [[SRC:%.*]], i64 16, i1 false)
; CHECK-NEXT:    ret void
;
  %1 = load %S, ptr %src
  store %S %1, ptr %dst
  ret void
}

