; Ensure the replacement of one pointer with another is subject to the approximations of
; canReplacePointersInUseIfEqual(). In the following cases, replacing a pointer with an
; inttoptr constant (which may have non-existent provenance), or with a global ptr (whose
; provenance is confined to the bounds of its object) would be an invalid refinement.

@g = global i64 0

define ptr @assume_ptr_equality(ptr %x) {
; CHECK-LABEL: define ptr @assume_ptr_equality(
; CHECK-SAME: ptr [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[X]], inttoptr (i64 12345678 to ptr)
; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
; CHECK-NEXT:    ret ptr [[X]]
;
entry:
  %c = icmp eq ptr %x, inttoptr (i64 12345678 to ptr)
  call void @llvm.assume(i1 %c)
  ret ptr %x
}

define ptr @assume_ptr_equality_return_value(ptr %p) {
; CHECK-LABEL: define ptr @assume_ptr_equality_return_value(
