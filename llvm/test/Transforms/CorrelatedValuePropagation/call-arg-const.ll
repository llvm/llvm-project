; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=correlated-propagation -S | FileCheck %s

declare i32 @memcmp(ptr, ptr, i64)
declare void @use(i64)
declare void @use1(i1)

@str8 = private constant [8 x i8] c"rotation"
@str5 = private constant [5 x i8] c"scale"

; The size is known in each case, as in an if-chain of std::string_view
; compares that SimplifyCFG turned into a switch on the length.
define i32 @memcmp_switch(ptr %p, i64 %len) {
; CHECK-LABEL: @memcmp_switch(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    switch i64 [[LEN:%.*]], label [[EXIT:%.*]] [
; CHECK-NEXT:      i64 8, label [[CASE8:%.*]]
; CHECK-NEXT:      i64 5, label [[CASE5:%.*]]
; CHECK-NEXT:    ]
; CHECK:       case8:
; CHECK-NEXT:    [[C8:%.*]] = call i32 @memcmp(ptr [[P:%.*]], ptr @str8, i64 8)
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       case5:
; CHECK-NEXT:    [[C5:%.*]] = call i32 @memcmp(ptr [[P]], ptr @str5, i64 5)
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ -1, [[ENTRY:%.*]] ], [ [[C8]], [[CASE8]] ], [ [[C5]], [[CASE5]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  switch i64 %len, label %exit [
  i64 8, label %case8
  i64 5, label %case5
  ]

case8:
  %c8 = call i32 @memcmp(ptr %p, ptr @str8, i64 %len)
  br label %exit

case5:
  %c5 = call i32 @memcmp(ptr %p, ptr @str5, i64 %len)
  br label %exit

exit:
  %r = phi i32 [ -1, %entry ], [ %c8, %case8 ], [ %c5, %case5 ]
  ret i32 %r
}

define void @arg_eq(i64 %x) {
; CHECK-LABEL: @arg_eq(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[X:%.*]], 42
; CHECK-NEXT:    br i1 [[CMP]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    call void @use(i64 42)
; CHECK-NEXT:    ret void
; CHECK:       else:
; CHECK-NEXT:    call void @use(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  %cmp = icmp eq i64 %x, 42
  br i1 %cmp, label %then, label %else

then:
  call void @use(i64 %x)
  ret void

else:
  call void @use(i64 %x)
  ret void
}

; Negative test: only a range is known, not a single value.
define void @arg_range(i64 %x) {
; CHECK-LABEL: @arg_range(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[X:%.*]], 2
; CHECK-NEXT:    br i1 [[CMP]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    call void @use(i64 [[X]])
; CHECK-NEXT:    ret void
; CHECK:       else:
; CHECK-NEXT:    ret void
;
entry:
  %cmp = icmp ult i64 %x, 2
  br i1 %cmp, label %then, label %else

then:
  call void @use(i64 %x)
  ret void

else:
  ret void
}

; The compare is unknown where it is defined, but known at the call.
define void @arg_cmp(i64 %x) {
; CHECK-LABEL: @arg_cmp(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[X:%.*]], 5
; CHECK-NEXT:    [[BIG:%.*]] = icmp ugt i64 [[X]], 10
; CHECK-NEXT:    br i1 [[BIG]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    call void @use1(i1 true)
; CHECK-NEXT:    ret void
; CHECK:       else:
; CHECK-NEXT:    call void @use1(i1 [[C]])
; CHECK-NEXT:    ret void
;
entry:
  %c = icmp ugt i64 %x, 5
  %big = icmp ugt i64 %x, 10
  br i1 %big, label %then, label %else

then:
  call void @use1(i1 %c)
  ret void

else:
  call void @use1(i1 %c)
  ret void
}

