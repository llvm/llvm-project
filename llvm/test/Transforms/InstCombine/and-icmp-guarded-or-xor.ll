; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult i32 [[A]], 19
; CHECK-NEXT:    [[BITS:%.*]] = or i32 [[A]], [[B]]
; CHECK-NEXT:    [[TEST:%.*]] = icmp sgt i32 [[BITS]], -273
; CHECK-NEXT:    [[RESULT:%.*]] = and i1 [[GUARD]], [[TEST]]
; CHECK-NEXT:    ret i1 [[RESULT]]
;
  %guard = icmp ult i32 %a, 19
  %bits = or i32 %a, %b
  %test = icmp sgt i32 %bits, -273
  %result = and i1 %guard, %test
  ret i1 %result
}

