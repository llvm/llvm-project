  %bits = xor <2 x i32> %a, %b
  %test = icmp slt <2 x i32> %bits, splat (i32 -256)
  %result = select <2 x i1> %guard, <2 x i1> %test, <2 x i1> zeroinitializer
  ret <2 x i1> %result
}

