; CHECK-SAME: <2 x i32> [[A:%.*]], <2 x i32> [[B:%.*]]) {
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult <2 x i32> [[A]], splat (i32 19)
; CHECK-NEXT:    [[TMP1:%.*]] = icmp slt <2 x i32> [[B]], splat (i32 -256)
; CHECK-NEXT:    [[RESULT:%.*]] = select <2 x i1> [[GUARD]], <2 x i1> [[TMP1]], <2 x i1> zeroinitializer
; CHECK-NEXT:    ret <2 x i1> [[RESULT]]
;
