define i1 @or_disjoint(i32 %a, i32 %b) {
; CHECK-LABEL: define i1 @or_disjoint(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult i32 [[A]], 19
; CHECK-NEXT:    [[TMP1:%.*]] = icmp ult i32 [[B]], 256
; CHECK-NEXT:    [[RESULT:%.*]] = and i1 [[GUARD]], [[TMP1]]
; CHECK-NEXT:    ret i1 [[RESULT]]
;
  %guard = icmp ult i32 %a, 19
  %bits = or disjoint i32 %a, %b
  %test = icmp ult i32 %bits, 256
  %result = and i1 %guard, %test
  ret i1 %result
}

define i1 @logical_reverse_ult(i32 %a, i32 %b) {
; CHECK-LABEL: define i1 @logical_reverse_ult(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[GUARD:%.*]] = icmp ult i32 [[A]], 19
; CHECK-NEXT:    [[TMP1:%.*]] = icmp ult i32 [[B]], 256
; CHECK-NEXT:    [[RESULT:%.*]] = and i1 [[TMP1]], [[GUARD]]
; CHECK-NEXT:    ret i1 [[RESULT]]
;
  %guard = icmp ult i32 %a, 19
  %bits = xor i32 %a, %b
  %test = icmp ult i32 %bits, 256
  %result = select i1 %test, i1 %guard, i1 false
  ret i1 %result
}

; A defined negative A makes the guard poison. The original test may be false,
; suppressing that poison, even when comparing B directly would return true.
define i1 @logical_reverse_samesign_guard(i32 %a, i32 %b) {
; CHECK-LABEL: define i1 @logical_reverse_samesign_guard(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[GUARD:%.*]] = icmp samesign ult i32 [[A]], 19
; CHECK-NEXT:    [[BITS:%.*]] = xor i32 [[A]], [[B]]
; CHECK-NEXT:    [[TEST:%.*]] = icmp ult i32 [[BITS]], 256
; CHECK-NEXT:    [[RESULT:%.*]] = select i1 [[TEST]], i1 [[GUARD]], i1 false
; CHECK-NEXT:    ret i1 [[RESULT]]
;
  %guard = icmp samesign ult i32 %a, 19
  %bits = xor i32 %a, %b
  %test = icmp ult i32 %bits, 256
  %result = select i1 %test, i1 %guard, i1 false
  ret i1 %result
}

