; CHECK-NEXT:    [[OR:%.*]] = or i33 [[SHR]], [[X]]
; CHECK-NEXT:    [[AND:%.*]] = and i33 [[OR]], 32767
; CHECK-NEXT:    ret i33 [[AND]]
;
  %sub = sub i33 32767, %x
  %shr = lshr i33 %sub, 17
  %or = or i33 %shr, %x
