; Boundary where the X u< 1<<ShAmt bound coincides with C+1 (i33, S=16,
; ShAmt=16): X u< 2^16 == C+1 means X u<= C always, so umin(X, C) collapses
; to X. Validates the fold's boundary behavior even though the umin is trivial.
define i33 @umin_tight_boundary_i33(i33 range(i33 0, 65536) %x) {
; CHECK-LABEL: define i33 @umin_tight_boundary_i33(
; CHECK-SAME: i33 range(i33 0, 65536) [[X:%.*]]) {
; CHECK-NEXT:    ret i33 [[X]]
;
  %sub = sub i33 65535, %x
  %shr = lshr i33 %sub, 16
  %or = or i33 %shr, %x
  %and = and i33 %or, 65535
  ret i33 %and
}

