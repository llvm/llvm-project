; Negative cases

; S > ShAmt: C=0xFFFF (S=16), ShAmt=15, so S u<= ShAmt fails. sub(C, X) can be
; as large as C = 0xFFFF >= 1<<ShAmt, so the shift is nonzero for X u<= C and
; the "below-mask" case produces X | 1 instead of X.
define i32 @neg_past_boundary(i32 range(i32 0, 32768) %x) {
; CHECK-LABEL: define i32 @neg_past_boundary(
; CHECK-SAME: i32 range(i32 0, 32768) [[X:%.*]]) {
; CHECK-NEXT:    [[OR:%.*]] = or i32 [[X]], 1
; CHECK-NEXT:    ret i32 [[OR]]
;
  %sub = sub i32 65535, %x
  %shr = lshr i32 %sub, 15
  %or = or i32 %shr, %x
  %and = and i32 %or, 65535
  ret i32 %and
}

