;===----------------------------------------------------------------------===;
; Positive tests: X is known to have enough sign bits, so X << C2 can't wrap.
;===----------------------------------------------------------------------===;

; X = sext i8 -> at least 25 sign bits. 20 >= 2 << 3 (16).
define i32 @test_smax_shl_sext_known(i8 %a) {
; CHECK-LABEL: define i32 @test_smax_shl_sext_known(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.smax.i8(i8 [[A]], i8 2)
; CHECK-NEXT:    [[INNER:%.*]] = zext nneg i8 [[TMP1]] to i32
; CHECK-NEXT:    [[SHIFT:%.*]] = shl nuw nsw i32 [[INNER]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.smax.i32(i32 [[SHIFT]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %x = sext i8 %a to i32
  %inner = call i32 @llvm.smax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.smax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

; Boundary: C3 == C1 << C2 (16 == 2 << 3), X known.
define i32 @test_smax_shl_exact_bound(i8 %a) {
; CHECK-LABEL: define i32 @test_smax_shl_exact_bound(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.smax.i8(i8 [[A]], i8 2)
; CHECK-NEXT:    [[INNER:%.*]] = zext nneg i8 [[TMP1]] to i32
; CHECK-NEXT:    [[SHIFT:%.*]] = shl nuw nsw i32 [[INNER]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.smax.i32(i32 [[SHIFT]], i32 16)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %x = sext i8 %a to i32
  %inner = call i32 @llvm.smax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.smax.i32(i32 %shift, i32 16)
  ret i32 %outer
}

; Negative constants. Same constants as the miscompile test below
; (C1 = -1, C2 = 1, C3 = -2), but X = ashr i8 by 4 has 5 sign bits
; (range [-8, 7]), so the fold is safe.
define i8 @test_smax_shl_negative_consts_known(i8 %a) {
; CHECK-LABEL: define i8 @test_smax_shl_negative_consts_known(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = ashr i8 [[A]], 4
; CHECK-NEXT:    [[INNER:%.*]] = call i8 @llvm.smax.i8(i8 [[X]], i8 -1)
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i8 [[INNER]], 1
; CHECK-NEXT:    [[OUTER:%.*]] = call i8 @llvm.smax.i8(i8 [[SHIFT]], i8 -2)
; CHECK-NEXT:    ret i8 [[OUTER]]
;
  %x = ashr i8 %a, 4
  %inner = call i8 @llvm.smax.i8(i8 %x, i8 -1)
  %shift = shl i8 %inner, 1
  %outer = call i8 @llvm.smax.i8(i8 %shift, i8 -2)
  ret i8 %outer
}

; Guard boundary (inside): X has 5 sign bits, C2 = 4 -> 4 < 5, fold fires.
; C1 << C2 = -16, C3 = -16. Worst case X = -8 -> -128, still fits.
define i8 @test_smax_shl_signbits_boundary_fires(i8 %a) {
; CHECK-LABEL: define i8 @test_smax_shl_signbits_boundary_fires(
; CHECK-SAME: i8 [[A:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = ashr i8 [[A]], 4
