; Signed overflow in C1 << C2 (0x40000000 << 1 = 2^31).
define i32 @test_smax_shl_overflow(i32 %x) {
; CHECK-LABEL: @test_smax_shl_overflow(
; CHECK-NEXT:    ret i32 10
;
  %inner = call i32 @llvm.smax.i32(i32 %x, i32 1073741824)
  %shift = shl i32 %inner, 1
  %outer = call i32 @llvm.smax.i32(i32 %shift, i32 10)
  ret i32 %outer
}

