;===----------------------------------------------------------------------===;
; Positive tests: X has enough known sign bits (via ashr), so X << C2 cannot wrap.
; No sext is used, preventing earlier cast-narrowing passes from interfering.
;===----------------------------------------------------------------------===;

; X = ashr i32 by 24 -> 25 sign bits. C2 = 3 < 25. 20 >= 2 << 3 (16).
define i32 @test_smax_shl_ashr_known(i32 %a) {
; CHECK-LABEL: @test_smax_shl_ashr_known(
; CHECK-NEXT:    [[TMP1:%.*]] = ashr i32 [[A:%.*]], 21
; CHECK-NEXT:    [[TMP2:%.*]] = and i32 [[TMP1]], -8
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.smax.i32(i32 [[TMP2]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %x = ashr i32 %a, 24
  %inner = call i32 @llvm.smax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.smax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

; Boundary: C3 == C1 << C2 (16 == 2 << 3), X known.
define i32 @test_smax_shl_exact_bound(i32 %a) {
; CHECK-LABEL: @test_smax_shl_exact_bound(
; CHECK-NEXT:    [[TMP1:%.*]] = ashr i32 [[A:%.*]], 21
; CHECK-NEXT:    [[TMP2:%.*]] = and i32 [[TMP1]], -8
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.smax.i32(i32 [[TMP2]], i32 16)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %x = ashr i32 %a, 24
  %inner = call i32 @llvm.smax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.smax.i32(i32 %shift, i32 16)
  ret i32 %outer
}

; Negative constants: C1 = -1, C2 = 1, C3 = -2.
; X = ashr i8 by 4 has 5 sign bits (range [-8, 7]), so the fold is safe.
define i8 @test_smax_shl_negative_consts_known(i8 %a) {
; CHECK-LABEL: @test_smax_shl_negative_consts_known(
; CHECK-NEXT:    [[TMP1:%.*]] = ashr i8 [[A:%.*]], 3
; CHECK-NEXT:    [[TMP2:%.*]] = and i8 [[TMP1]], -2
; CHECK-NEXT:    [[OUTER:%.*]] = call i8 @llvm.smax.i8(i8 [[TMP2]], i8 -2)
; CHECK-NEXT:    ret i8 [[OUTER]]
;
  %x = ashr i8 %a, 4
  %inner = call i8 @llvm.smax.i8(i8 %x, i8 -1)
  %shift = shl i8 %inner, 1
  %outer = call i8 @llvm.smax.i8(i8 %shift, i8 -2)
  ret i8 %outer
}

; Guard boundary (inside): X has 5 sign bits, C2 = 4 -> 4 < 5, fold fires.
; C1 << C2 = -16, C3 = -16.
define i8 @test_smax_shl_signbits_boundary_fires(i8 %a) {
; CHECK-LABEL: @test_smax_shl_signbits_boundary_fires(
; CHECK-NEXT:    [[X:%.*]] = and i8 [[A:%.*]], -16
; CHECK-NEXT:    [[OUTER:%.*]] = call i8 @llvm.smax.i8(i8 [[X]], i8 -16)
; CHECK-NEXT:    ret i8 [[OUTER]]
;
  %x = ashr i8 %a, 4
  %inner = call i8 @llvm.smax.i8(i8 %x, i8 -1)
  %shift = shl i8 %inner, 4
  %outer = call i8 @llvm.smax.i8(i8 %shift, i8 -16)
  ret i8 %outer
}

; Commuted operands (m_c_SMax on both smax calls).
define i32 @test_smax_shl_commuted(i32 %a) {
; CHECK-LABEL: @test_smax_shl_commuted(
; CHECK-NEXT:    [[TMP1:%.*]] = ashr i32 [[A:%.*]], 21
; CHECK-NEXT:    [[TMP2:%.*]] = and i32 [[TMP1]], -8
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.smax.i32(i32 [[TMP2]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %x = ashr i32 %a, 24
  %inner = call i32 @llvm.smax.i32(i32 2, i32 %x)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.smax.i32(i32 20, i32 %shift)
  ret i32 %outer
}

; Vector splat with known sign bits via vector ashr.
define <2 x i32> @test_smax_shl_vector_known(<2 x i32> %a) {
; CHECK-LABEL: @test_smax_shl_vector_known(
; CHECK-NEXT:    [[TMP1:%.*]] = ashr <2 x i32> [[A:%.*]], splat (i32 21)
; CHECK-NEXT:    [[TMP2:%.*]] = and <2 x i32> [[TMP1]], splat (i32 -8)
; CHECK-NEXT:    [[OUTER:%.*]] = call <2 x i32> @llvm.smax.v2i32(<2 x i32> [[TMP2]], <2 x i32> splat (i32 20))
; CHECK-NEXT:    ret <2 x i32> [[OUTER]]
;
  %x = ashr <2 x i32> %a, <i32 24, i32 24>
  %inner = call <2 x i32> @llvm.smax.v2i32(<2 x i32> %x, <2 x i32> <i32 2, i32 2>)
  %shift = shl <2 x i32> %inner, <i32 3, i32 3>
  %outer = call <2 x i32> @llvm.smax.v2i32(<2 x i32> %shift, <2 x i32> <i32 20, i32 20>)
  ret <2 x i32> %outer
}

