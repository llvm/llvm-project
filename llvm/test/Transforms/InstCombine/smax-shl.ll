; CHECK-NEXT:    [[SHIFT:%.*]] = shl i8 [[INNER]], 4
; CHECK-NEXT:    [[OUTER:%.*]] = call i8 @llvm.smax.i8(i8 [[SHIFT]], i8 -16)
; CHECK-NEXT:    ret i8 [[OUTER]]
;
  %x = ashr i8 %a, 4
  %inner = call i8 @llvm.smax.i8(i8 %x, i8 -1)
  %shift = shl i8 %inner, 4
  %outer = call i8 @llvm.smax.i8(i8 %shift, i8 -16)
  ret i8 %outer
}

