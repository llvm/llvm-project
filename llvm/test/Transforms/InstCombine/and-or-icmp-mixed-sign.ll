; CHECK-SAME: i8 [[X:%.*]], i8 [[Y:%.*]]) {
; CHECK-NEXT:    [[ULT:%.*]] = icmp sgt i8 [[X]], -1
; CHECK-NEXT:    [[SGE:%.*]] = icmp slt i8 [[Y]], 0
; CHECK-NEXT:    [[R:%.*]] = and i1 [[ULT]], [[SGE]]
; CHECK-NEXT:    ret i1 [[R]]
;
