; Integer min/max have no NaN behaviour and must still fold.
define i32 @smax_still_folds(i32 %x, i32 %y) {
; CHECK-LABEL: @smax_still_folds(
; CHECK-NEXT:    [[M:%.*]] = call i32 @llvm.smax.i32(i32 [[X:%.*]], i32 [[Y:%.*]])
; CHECK-NEXT:    ret i32 [[M]]
;
