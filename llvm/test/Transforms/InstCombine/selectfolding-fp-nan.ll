; CHECK-NEXT:    [[M:%.*]] = select i1 [[C1]], float 1.000000e+00, float [[B]]
; CHECK-NEXT:    [[C2:%.*]] = fcmp ogt float [[M]], 1.000000e+00
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C2]], float [[M]], float 1.000000e+00
; CHECK-NEXT:    ret float [[R]]
;
  %c1 = fcmp ogt float 1.0, %b
  %m = select i1 %c1, float 1.0, float %b
