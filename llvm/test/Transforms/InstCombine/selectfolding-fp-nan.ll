; ---------------------------------------------------------------------------
; nnan. A select-only nnan on the outer select does NOT make a NaN in %m
; poison (the select returns 1.0, which is not NaN), so folding would be a
; miscompile (Alive2 counterexample: %x = NaN, source 1.0, target NaN).
; ---------------------------------------------------------------------------

define float @nnan_outer_select_only(float %x) {
; CHECK-LABEL: @nnan_outer_select_only(
; CHECK-NEXT:    [[C1_INV:%.*]] = fcmp ole float [[X:%.*]], 1.000000e+00
; CHECK-NEXT:    [[M:%.*]] = select i1 [[C1_INV]], float 1.000000e+00, float [[X]]
; CHECK-NEXT:    [[C2:%.*]] = fcmp ogt float [[M]], 1.000000e+00
; CHECK-NEXT:    [[R:%.*]] = select nnan i1 [[C2]], float [[M]], float 1.000000e+00
; CHECK-NEXT:    ret float [[R]]
;
  %c1 = fcmp ugt float %x, 1.0
  %m = select i1 %c1, float %x, float 1.0
  %c2 = fcmp ogt float %m, 1.0
  %r = select nnan i1 %c2, float %m, float 1.0
  ret float %r
}

