; Folding a pair with different behaviour turns a defined result (1.0) into NaN.

; Same NaN behaviour: the outer select is redundant and must still be removed.

define float @max_other_other(float %x) {
; CHECK-LABEL: @max_other_other(
; CHECK-NEXT:    [[C1:%.*]] = fcmp ogt float [[X:%.*]], 1.000000e+00
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C1]], float [[X]], float 1.000000e+00
; CHECK-NEXT:    ret float [[R]]
;
  %c1 = fcmp ogt float %x, 1.0
  %m = select i1 %c1, float %x, float 1.0
  %c2 = fcmp ogt float %m, 1.0
  %r = select i1 %c2, float %m, float 1.0
  ret float %r
}

