; CHECK-NEXT:    [[TMP1:%.*]] = atomicrmw add ptr [[A]], i64 [[ADD]] monotonic, align 8
; CHECK-NEXT:    ret i64 [[TMP1]]
;
  %add = add i64 %n, 1
  call void @use(i64 %add)
  %1 = atomicrmw add ptr %a, i64 %add monotonic
  ret i64 %1
}

