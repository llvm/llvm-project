; CHECK-NEXT:    [[B_VAL:%.*]] = load i32, ptr [[B]], align 8
; CHECK-NEXT:    ret i32 [[B_VAL]]
;
entry:
  %sel = select i1 %f, ptr %a, ptr %b
  %l = load i32, ptr %sel, align 8
