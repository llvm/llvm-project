; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -mtriple=x86_64-unknown-unknown -S | FileCheck %s

; Tests for lib/Analysis/ValueTracking.cpp's computeKnownBits handling of the
; x86.bmi.bextr / x86.tbm.bextri intrinsics. The source operand is
; intentionally not a plain ConstantInt so that X86TTIImpl::instCombineIntrinsic's
; dedicated bextr/bextri combine (which only fires for a fully-constant source)
; cannot fold the call itself -- these tests isolate the generic known-bits
; extraction added to computeKnownBitsFromOperator.

declare i32 @llvm.x86.bmi.bextr.32(i32, i32)
declare i64 @llvm.x86.bmi.bextr.64(i64, i64)
declare i32 @llvm.x86.tbm.bextri.u32(i32, i32)
declare i64 @llvm.x86.tbm.bextri.u64(i64, i64)

define i32 @bextr32_extract_all_known_one(i32 %a) {
; CHECK-LABEL: @bextr32_extract_all_known_one(
; CHECK-NEXT:    ret i32 255
;
  %aa = or i32 %a, 4080
  %r = tail call i32 @llvm.x86.bmi.bextr.32(i32 %aa, i32 2052)
  %and = and i32 %r, 255
  ret i32 %and
}

define i64 @bextr64_extract_all_known_one(i64 %a) {
; CHECK-LABEL: @bextr64_extract_all_known_one(
; CHECK-NEXT:    ret i64 255
;
  %aa = or i64 %a, 4080
  %r = tail call i64 @llvm.x86.bmi.bextr.64(i64 %aa, i64 2052)
  %and = and i64 %r, 255
  ret i64 %and
}

define i32 @bextri32_extract_mixed_known_bits(i32 %a) {
; CHECK-LABEL: @bextri32_extract_mixed_known_bits(
; CHECK-NEXT:    ret i32 3840
;
  %aa = shl i32 %a, 4
  %aaa = or i32 %aa, 3840
  %r = tail call i32 @llvm.x86.tbm.bextri.u32(i32 %aaa, i32 3072)
  %and = and i32 %r, 3840
  ret i32 %and
}

define i32 @bextri32_extract_mixed_known_bits_zero_part(i32 %a) {
; CHECK-LABEL: @bextri32_extract_mixed_known_bits_zero_part(
; CHECK-NEXT:    ret i32 0
;
  %aa = shl i32 %a, 4
  %aaa = or i32 %aa, 3840
  %r = tail call i32 @llvm.x86.tbm.bextri.u32(i32 %aaa, i32 3072)
  %and = and i32 %r, 15
  ret i32 %and
}

define i64 @bextri64_extract_mixed_known_bits(i64 %a) {
; CHECK-LABEL: @bextri64_extract_mixed_known_bits(
; CHECK-NEXT:    ret i64 3840
;
  %aa = shl i64 %a, 4
  %aaa = or i64 %aa, 3840
  %r = tail call i64 @llvm.x86.tbm.bextri.u64(i64 %aaa, i64 3072)
  %and = and i64 %r, 3840
  ret i64 %and
}

; shift (30) + length (10) exceeds the bit width (32), but shift alone is
; still in range, so X86TTIImpl::instCombineIntrinsic's own zero-fold
; (which only checks "shift >= bitwidth") does not fire here. Nothing should
; be known about the result, so the `and` must not be folded away.
define i32 @bextri32_out_of_range_not_folded(i32 %a) {
; CHECK-LABEL: @bextri32_out_of_range_not_folded(
; CHECK-NEXT:    [[AA:%.*]] = or i32 [[A:%.*]], 4080
; CHECK-NEXT:    [[R:%.*]] = tail call i32 @llvm.x86.tbm.bextri.u32(i32 [[AA]], i32 2590)
; CHECK-NEXT:    [[AND:%.*]] = and i32 [[R]], 5
; CHECK-NEXT:    ret i32 [[AND]]
;
  %aa = or i32 %a, 4080
  %r = tail call i32 @llvm.x86.tbm.bextri.u32(i32 %aa, i32 2590)
  %and = and i32 %r, 5
  ret i32 %and
}

define i64 @bextr64_out_of_range_not_folded(i64 %a) {
; CHECK-LABEL: @bextr64_out_of_range_not_folded(
; CHECK-NEXT:    [[AA:%.*]] = or i64 [[A:%.*]], 4080
; CHECK-NEXT:    [[R:%.*]] = tail call i64 @llvm.x86.bmi.bextr.64(i64 [[AA]], i64 2620)
; CHECK-NEXT:    [[AND:%.*]] = and i64 [[R]], 5
; CHECK-NEXT:    ret i64 [[AND]]
;
  %aa = or i64 %a, 4080
  %r = tail call i64 @llvm.x86.bmi.bextr.64(i64 %aa, i64 2620)
  %and = and i64 %r, 5
  ret i64 %and
}
