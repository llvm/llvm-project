; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; Reduced from libc++ basic_string short-string optimization.
; The low bit of the header word distinguishes heap-allocated (bit0=1) from
; inline (bit0=0). The trunc to i1 checks whether to deallocate, and the phi
; also feeds the capacity mask (and i64 %hdr, -2). Because the phi has multiple
; uses, InstCombine does not push the trunc through it, so it misses that
; the trunc result is simply !%is.short (the branch condition).

declare void @_ZdlPvm(ptr, i64)
declare noalias nonnull ptr @_Znwm(i64)

define void @trunc_multiuse_phi(i64 %len, ptr %buf, ptr %src) {
; CHECK-LABEL: @trunc_multiuse_phi(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[IS_SHORT:%.*]] = icmp ugt i64 [[LEN:%.*]], 22
; CHECK-NEXT:    br i1 [[IS_SHORT]], label [[SHORT:%.*]], label [[LONG:%.*]]
; CHECK:       short:
; CHECK-NEXT:    [[HDR_SHORT:%.*]] = shl nuw nsw i64 [[LEN]], 1
; CHECK-NEXT:    br label [[MERGE:%.*]]
; CHECK:       long:
; CHECK-NEXT:    [[CAP_RAW:%.*]] = and i64 [[LEN]], -16
; CHECK-NEXT:    [[CAP:%.*]] = add nuw i64 [[CAP_RAW]], 16
; CHECK-NEXT:    [[HEAP:%.*]] = call noalias ptr @_Znwm(i64 [[CAP]])
; CHECK-NEXT:    br label [[MERGE]]
; CHECK:       merge:
; CHECK-NEXT:    [[CAP_MASK:%.*]] = phi i64 [ [[HDR_SHORT]], [[LONG]] ], [ [[CAP]], [[SHORT]] ]
; CHECK-NEXT:    [[DATA:%.*]] = phi ptr [ [[BUF:%.*]], [[LONG]] ], [ [[HEAP]], [[SHORT]] ]
; CHECK-NEXT:    br i1 [[IS_SHORT]], label [[DO_FREE:%.*]], label [[DONE:%.*]]
; CHECK:       do.free:
; CHECK-NEXT:    call void @_ZdlPvm(ptr [[DATA]], i64 [[CAP_MASK]])
; CHECK-NEXT:    br label [[DONE]]
; CHECK:       done:
; CHECK-NEXT:    ret void
;
entry:
  %is.short = icmp ult i64 %len, 23
  br i1 %is.short, label %short, label %long

short:
  %hdr.short = shl nuw nsw i64 %len, 1
  br label %merge

long:
  %cap.raw = and i64 %len, -16
  %cap = add nuw i64 %cap.raw, 16
  %heap = call noalias ptr @_Znwm(i64 %cap)
  %hdr.long = or disjoint i64 %cap, 1
  br label %merge

merge:
  %hdr = phi i64 [ %hdr.short, %short ], [ %hdr.long, %long ]
  %data = phi ptr [ %buf, %short ], [ %heap, %long ]
  %is.heap = trunc i64 %hdr to i1
  br i1 %is.heap, label %do.free, label %done

do.free:
  %cap.mask = and i64 %hdr, -2
  call void @_ZdlPvm(ptr %data, i64 %cap.mask)
  br label %done

done:
  ret void
}
