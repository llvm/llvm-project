; RUN: opt -p instcombine -mtriple=riscv64 -S %s | FileCheck %s

; ValueTracking recognizes a read of the RISC-V vlenb CSR (which holds VLEN/8)
; via llvm.read_register / llvm.read_volatile_register and derives both its
; value range and the fact that it is a power of two.
;
; RVV requires VLEN to be a power of two in [32, 65536] (Zvl32b is the smallest
; vector extension), so VLENB is in [4, 8192] regardless of any attribute. When
; the function carries a vscale_range attribute the subtarget's VLEN is a
; multiple of RVVBitsPerBlock (64), so VLENB = vscale * RVVBytesPerBlock gives a
; tighter range.

;------------------------------------------------------------------------------
; Architectural bounds (no vscale_range attribute, e.g. Zvl32b with VLENB == 4).
;------------------------------------------------------------------------------

; VLENB >= 4 always holds, so this folds to true.
define i64 @vlenb_uge_arch_min() {
; CHECK-LABEL: define i64 @vlenb_uge_arch_min() {
; CHECK-NEXT:    ret i64 1
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp uge i64 %v, 4
  %z = zext i1 %c to i64
  ret i64 %z
}

; VLENB may be as small as 4 (Zvl32b), so >= 8 must NOT fold.
define i64 @vlenb_uge_arch_min_no_fold() {
; CHECK-LABEL: define i64 @vlenb_uge_arch_min_no_fold() {
; CHECK-NEXT:    [[V:%.*]] = call i64 @llvm.read_register.i64(metadata [[META0:![0-9]+]])
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[V]], 7
; CHECK-NEXT:    [[Z:%.*]] = zext i1 [[C]] to i64
; CHECK-NEXT:    ret i64 [[Z]]
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp uge i64 %v, 8
  %z = zext i1 %c to i64
  ret i64 %z
}

; VLENB <= 8192 always holds, so > 8192 folds to false.
define i64 @vlenb_ugt_arch_max() {
; CHECK-LABEL: define i64 @vlenb_ugt_arch_max() {
; CHECK-NEXT:    ret i64 0
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp ugt i64 %v, 8192
  %z = zext i1 %c to i64
  ret i64 %z
}

;------------------------------------------------------------------------------
; vscale_range attribute tightens the range.
;------------------------------------------------------------------------------

; +v implies vscale >= 2, i.e. VLENB >= 16, so this folds to true.
define i64 @vlenb_uge_min_v() vscale_range(2,1024) {
; CHECK-LABEL: define i64 @vlenb_uge_min_v(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    ret i64 1
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp uge i64 %v, 16
  %z = zext i1 %c to i64
  ret i64 %z
}

; +v still allows VLENB == 16, so >= 64 must NOT fold.
define i64 @vlenb_uge_mid_v128() vscale_range(2,1024) {
; CHECK-LABEL: define i64 @vlenb_uge_mid_v128(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    [[V:%.*]] = call i64 @llvm.read_register.i64(metadata [[META0]])
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[V]], 63
; CHECK-NEXT:    [[Z:%.*]] = zext i1 [[C]] to i64
; CHECK-NEXT:    ret i64 [[Z]]
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp uge i64 %v, 64
  %z = zext i1 %c to i64
  ret i64 %z
}

; zvl512b implies vscale >= 8, i.e. VLENB >= 64, so >= 64 folds to true.
define i64 @vlenb_uge_mid_v512() vscale_range(8,1024) {
; CHECK-LABEL: define i64 @vlenb_uge_mid_v512(
; CHECK-SAME: ) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    ret i64 1
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp uge i64 %v, 64
  %z = zext i1 %c to i64
  ret i64 %z
}

; The upper bound from vscale_range also folds out-of-range compares.
define i64 @vlenb_ugt_max_v() vscale_range(2,1024) {
; CHECK-LABEL: define i64 @vlenb_ugt_max_v(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    ret i64 0
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %c = icmp ugt i64 %v, 8192
  %z = zext i1 %c to i64
  ret i64 %z
}

; The i32-typed read behaves the same way.
define i32 @vlenb_i32_uge_min_v() vscale_range(2,1024) {
; CHECK-LABEL: define i32 @vlenb_i32_uge_min_v(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    ret i32 1
;
  %v = call i32 @llvm.read_register.i32(metadata !0)
  %c = icmp uge i32 %v, 16
  %z = zext i1 %c to i32
  ret i32 %z
}

; read_volatile_register of vlenb gets the same range treatment.
define i64 @vlenb_volatile_uge_min_v() vscale_range(2,1024) {
; CHECK-LABEL: define i64 @vlenb_volatile_uge_min_v(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    [[V:%.*]] = call i64 @llvm.read_volatile_register.i64(metadata [[META0]])
; CHECK-NEXT:    ret i64 1
;
  %v = call i64 @llvm.read_volatile_register.i64(metadata !0)
  %c = icmp uge i64 %v, 16
  %z = zext i1 %c to i64
  ret i64 %z
}

;------------------------------------------------------------------------------
; Power-of-two facts (independent of any attribute).
;------------------------------------------------------------------------------

; VLENB is a power of two, so v & (v - 1) folds to 0.
define i64 @vlenb_is_pow2() {
; CHECK-LABEL: define i64 @vlenb_is_pow2() {
; CHECK-NEXT:    ret i64 0
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %m1 = sub i64 %v, 1
  %a = and i64 %v, %m1
  ret i64 %a
}

; VLENB is a power of two, so urem by it lowers to a mask.
define i64 @vlenb_urem_pow2(i64 %x) {
; CHECK-LABEL: define i64 @vlenb_urem_pow2(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = call i64 @llvm.read_register.i64(metadata [[META0]])
; CHECK-NEXT:    [[TMP1:%.*]] = add nsw i64 [[V]], -1
; CHECK-NEXT:    [[R:%.*]] = and i64 [[X]], [[TMP1]]
; CHECK-NEXT:    ret i64 [[R]]
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %r = urem i64 %x, %v
  ret i64 %r
}

; VLENB is a power of two, so udiv by it lowers to a shift.
define i64 @vlenb_udiv_pow2(i64 %x) {
; CHECK-LABEL: define i64 @vlenb_udiv_pow2(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = call i64 @llvm.read_register.i64(metadata [[META0]])
; CHECK-NEXT:    [[TMP1:%.*]] = call range(i64 0, 65) i64 @llvm.cttz.i64(i64 [[V]], i1 true)
; CHECK-NEXT:    [[D1:%.*]] = lshr i64 [[X]], [[TMP1]]
; CHECK-NEXT:    ret i64 [[D1]]
;
  %v = call i64 @llvm.read_register.i64(metadata !0)
  %d = udiv i64 %x, %v
  ret i64 %d
}

;------------------------------------------------------------------------------
; Negative cases.
;------------------------------------------------------------------------------

; A read of a different register must not be treated as vlenb.
define i64 @not_vlenb_uge_min() vscale_range(2,1024) {
; CHECK-LABEL: define i64 @not_vlenb_uge_min(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    [[V:%.*]] = call i64 @llvm.read_register.i64(metadata [[META1:![0-9]+]])
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[V]], 15
; CHECK-NEXT:    [[Z:%.*]] = zext i1 [[C]] to i64
; CHECK-NEXT:    ret i64 [[Z]]
;
  %v = call i64 @llvm.read_register.i64(metadata !1)
  %c = icmp uge i64 %v, 16
  %z = zext i1 %c to i64
  ret i64 %z
}

!0 = !{!"vlenb"}
!1 = !{!"x1"}
