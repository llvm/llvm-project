; CHECK-NEXT:    ret i1 false
;
  %neg = fneg float %x ; -x
  %res = fmul float %neg, %x ; (-x) * x
  %r = call i1 @llvm.is.fpclass.f32(float %res, i32 896)
  ret i1 %r
}

; test for x * (-x)
define i1 @fmul_neg_not_pos_commutative(float %x) {
