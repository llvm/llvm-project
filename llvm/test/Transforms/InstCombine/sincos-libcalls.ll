; CHECK-NEXT:    [[R:%.*]] = fadd double [[S]], [[C]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x)
  call void @effect()
  %c = call double @cos(double %x)
  %r = fadd double %s, %c
  ret double %r
}

