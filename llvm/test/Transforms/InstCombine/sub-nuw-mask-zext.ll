; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[X]] to i16
; CHECK-NEXT:    [[TMP2:%.*]] = sub nuw i16 [[TMP1]], [[REM]]
; CHECK-NEXT:    [[R:%.*]] = zext i16 [[TMP2]] to i32
