; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; A 32-bit pointer index type on a 64-bit pointer: the GEP sign-extends the
; index to the pointer width. Splitting GEP(p, add(x, y)) into
; GEP(GEP(p, x), y) is only sound when the add is nsw, because otherwise
; sext(x + y) != sext(x) + sext(y) once x + y signed-overflows. These are
; single-use adds (no constant addend), so they exercise the original fold,
; which previously split unconditionally and miscompiled.

target datalayout = "p:64:64:64:32"

; Original single-use case, no nsw: previously split and miscompiled
; (e.g. x = 0x7fffffff, y = 1). Must NOT split now.
define ptr @single_use_no_nsw(ptr %p, i32 %x, i32 %y) {
; CHECK-LABEL: define ptr @single_use_no_nsw(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[IDX:%.*]] = add i32 [[X]], [[Y]]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr [4 x i8], ptr [[P]], i32 [[IDX]]
; CHECK-NEXT:    ret ptr [[GEP]]
;
  %idx = add i32 %x, %y
  %gep = getelementptr i32, ptr %p, i32 %idx
  ret ptr %gep
}

; Single-use with nsw: the split is sound, so it still fires.
define ptr @single_use_nsw(ptr %p, i32 %x, i32 %y) {
; CHECK-LABEL: define ptr @single_use_nsw(
; CHECK-SAME: ptr [[P:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr [4 x i8], ptr [[P]], i32 [[X]]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr [4 x i8], ptr [[TMP1]], i32 [[Y]]
; CHECK-NEXT:    ret ptr [[GEP]]
;
  %idx = add nsw i32 %x, %y
  %gep = getelementptr i32, ptr %p, i32 %idx
  ret ptr %gep
}
