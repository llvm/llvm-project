; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; Make sure we do not assert in foldICmpWithZextOrSext when an icmp samesign
; ule/uge of a sext cannot be canonicalized to ugt/ult.
; https://github.com/llvm/llvm-project/issues/216058

define i1 @samesign_ule_sext_i16_smax(i16 %x) {
; CHECK-LABEL: @samesign_ule_sext_i16_smax(
; CHECK-NEXT:    [[E:%.*]] = sext i16 [[X:%.*]] to i32
; CHECK-NEXT:    [[C:%.*]] = icmp samesign ule i32 [[E]], 2147483647
; CHECK-NEXT:    ret i1 [[C]]
;
  %e = sext i16 %x to i32
  %c = icmp samesign ule i32 %e, 2147483647
  ret i1 %c
}

define i1 @samesign_uge_sext_i16_smin(i16 %x) {
; CHECK-LABEL: @samesign_uge_sext_i16_smin(
; CHECK-NEXT:    [[E:%.*]] = sext i16 [[X:%.*]] to i32
; CHECK-NEXT:    [[C:%.*]] = icmp samesign uge i32 [[E]], -2147483648
; CHECK-NEXT:    ret i1 [[C]]
;
  %e = sext i16 %x to i32
  %c = icmp samesign uge i32 %e, -2147483648
  ret i1 %c
}

; icmp ult/ugt of a sext with a constant not representable in the source type.
define i1 @ult_sext_i16_unrepresentable(i16 %x) {
; CHECK-LABEL: @ult_sext_i16_unrepresentable(
; CHECK-NEXT:    [[C:%.*]] = icmp sgt i16 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[C]]
;
  %e = sext i16 %x to i32
  %c = icmp ult i32 %e, 32768
  ret i1 %c
}

define i1 @ugt_sext_i16_unrepresentable(i16 %x) {
; CHECK-LABEL: @ugt_sext_i16_unrepresentable(
; CHECK-NEXT:    [[C:%.*]] = icmp slt i16 [[X:%.*]], 0
; CHECK-NEXT:    ret i1 [[C]]
;
  %e = sext i16 %x to i32
  %c = icmp ugt i32 %e, 32768
  ret i1 %c
}

; Reduced from the C reproducer in issue 216058.
define i1 @pr216058(i16 %b, i16 %h) {
; CHECK-LABEL: @pr216058(
; CHECK-NEXT:    [[E:%.*]] = sext i16 [[B:%.*]] to i32
; CHECK-NEXT:    [[F:%.*]] = sext i16 [[H:%.*]] to i32
; CHECK-NEXT:    [[SUB:%.*]] = sub i32 2147483647, [[F]]
; CHECK-NEXT:    [[CMP1:%.*]] = icmp sgt i16 [[B]], 0
; CHECK-NEXT:    [[CMP2:%.*]] = icmp slt i32 [[SUB]], [[E]]
; CHECK-NEXT:    [[R:%.*]] = and i1 [[CMP1]], [[CMP2]]
; CHECK-NEXT:    ret i1 [[R]]
;
  %e = sext i16 %b to i32
  %f = sext i16 %h to i32
  %sub = sub i32 2147483647, %f
  %cmp1 = icmp sgt i32 %e, 0
  %cmp2 = icmp sgt i32 %e, %sub
  %r = and i1 %cmp1, %cmp2
  ret i1 %r
}
