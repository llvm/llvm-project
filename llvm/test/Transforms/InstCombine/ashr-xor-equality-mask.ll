; https://github.com/llvm/llvm-project/issues/227763
define i32 @xor_eq_mask(i8 %x) {
; CHECK-LABEL: define i32 @xor_eq_mask(
; CHECK-SAME: i8 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq i8 [[X]], 3
; CHECK-NEXT:    [[MASK:%.*]] = sext i1 [[TMP0]] to i32
; CHECK-NEXT:    ret i32 [[MASK]]
;
entry:
  %xor = xor i8 %x, 3
  %zext = zext i8 %xor to i32
  %sub = add nsw i32 %zext, -1
  %mask = ashr i32 %sub, 31
  ret i32 %mask
}

