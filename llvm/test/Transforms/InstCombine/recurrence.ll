  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %step = call i32 @get_step()
  %iv.next = add nsw i32 %iv, %step
  %c = icmp sge i32 %step, 0
  br i1 %c, label %exit, label %latch

latch:
