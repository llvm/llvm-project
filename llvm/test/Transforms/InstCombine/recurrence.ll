; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[STEP]], -1
; CHECK-NEXT:    br i1 [[C]], label [[EXIT:%.*]], label [[LATCH]]
; CHECK:       latch:
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], [[STEP]]
; CHECK-NEXT:    br label [[LOOP]]
; CHECK:       exit:
