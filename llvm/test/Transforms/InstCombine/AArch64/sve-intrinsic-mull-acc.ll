; RUN: opt -S -passes=instcombine < %s | FileCheck %s

target triple = "aarch64"

; Tests for the instCombineSVEMultiplyAccumulateLong combine.
; It is type-agnostic, so test for <vscale x 4 x i32> only.

define <vscale x 4 x i32> @smlalb_from_add_smullb(<vscale x 4 x i32> %acc, <vscale x 8 x i16> %a, <vscale x 8 x i16> %b) {
; CHECK-LABEL: @smlalb_from_add_smullb(
; CHECK-NEXT:    [[R:%.*]] = call <vscale x 4 x i32> @llvm.aarch64.sve.smlalb.nxv4i32(<vscale x 4 x i32> [[ACC:%.*]], <vscale x 8 x i16> [[A:%.*]], <vscale x 8 x i16> [[B:%.*]])
; CHECK-NEXT:    ret <vscale x 4 x i32> [[R]]
;
  %mul = call <vscale x 4 x i32> @llvm.aarch64.sve.smullb.nxv4i32(<vscale x 8 x i16> %a, <vscale x 8 x i16> %b)
  %r = add <vscale x 4 x i32> %mul, %acc
  ret <vscale x 4 x i32> %r
}

