; bfloat has fewer significand bits than half but a larger exponent range, so
; bfloat operands can not be narrowed to half: converting them to half would
; overflow to infinity.

define half @fadd_bfloat_to_half(bfloat %a, bfloat %b) {
; CHECK-LABEL: define half @fadd_bfloat_to_half(
; CHECK-SAME: bfloat [[A:%.*]], bfloat [[B:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = fpext bfloat [[A]] to double
; CHECK-NEXT:    [[Y:%.*]] = fpext bfloat [[B]] to double
; CHECK-NEXT:    [[SUM:%.*]] = fadd double [[X]], [[Y]]
; CHECK-NEXT:    [[R:%.*]] = fptrunc double [[SUM]] to half
; CHECK-NEXT:    ret half [[R]]
;
  %x = fpext bfloat %a to double
  %y = fpext bfloat %b to double
  %sum = fadd double %x, %y
  %r = fptrunc double %sum to half
  ret half %r
}

