; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    call void @use(i64 [[V]])
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
