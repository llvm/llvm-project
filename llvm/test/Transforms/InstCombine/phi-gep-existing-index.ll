  %p0 = getelementptr i8, ptr %a, i64 8
  br label %loop

loop:
  %p = phi ptr [ %p0, %entry ], [ %p.next, %loop ]
  %i = phi i64 [ 2, %entry ], [ %i.next, %loop ]
  %v = load i64, ptr %p, align 8
  call void @use(i64 %v)
  %i.next = add nuw nsw i64 %i, 1
  %p.next = getelementptr i64, ptr %a, i64 %i.next
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

; Only one of three predecessors disagrees with the index PHI.
define i64 @three_preds_one_mismatch(ptr %a, i64 %k, i32 %sw) {
; CHECK-LABEL: define i64 @three_preds_one_mismatch(
; CHECK-SAME: ptr [[A:%.*]], i64 [[K:%.*]], i32 [[SW:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    switch i32 [[SW]], label %[[C0:.*]] [
; CHECK-NEXT:      i32 1, label %[[C1:.*]]
; CHECK-NEXT:      i32 2, label %[[CV:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[C0]]:
; CHECK-NEXT:    [[P_0:%.*]] = getelementptr i8, ptr [[A]], i64 8
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[C1]]:
; CHECK-NEXT:    [[P_1:%.*]] = getelementptr i8, ptr [[A]], i64 16
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[CV]]:
; CHECK-NEXT:    [[P_V:%.*]] = getelementptr [8 x i8], ptr [[A]], i64 [[K]]
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[P_0]], %[[C0]] ], [ [[P_1]], %[[C1]] ], [ [[P_V]], %[[CV]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 1, %[[C0]] ], [ 3, %[[C1]] ], [ [[K]], %[[CV]] ]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    [[R:%.*]] = add i64 [[V]], [[I]]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  switch i32 %sw, label %c0 [ i32 1, label %c1
  i32 2, label %cv ]

c0:
  %p.0 = getelementptr i8, ptr %a, i64 8
  br label %merge

c1:
  %p.1 = getelementptr i8, ptr %a, i64 16
  br label %merge

cv:
  %p.v = getelementptr i64, ptr %a, i64 %k
  br label %merge

merge:
  %p = phi ptr [ %p.0, %c0 ], [ %p.1, %c1 ], [ %p.v, %cv ]
  %i = phi i64 [ 1, %c0 ], [ 3, %c1 ], [ %k, %cv ]
  %v = load i64, ptr %p, align 8
  %r = add i64 %v, %i
  ret i64 %r
}

