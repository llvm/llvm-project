; The index of a GEP of a type other than i8 counts elements, not bytes, so it
; cannot be rescaled to the units of the other GEP's element type.
define i64 @different_element_type(ptr %a, i64 %i, i64 %n) {
; CHECK-LABEL: define i64 @different_element_type(
; CHECK-SAME: ptr [[A:%.*]], i64 [[I:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[G0:%.*]] = getelementptr [2 x i8], ptr [[A]], i64 [[I]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[G0]], %[[ENTRY]] ], [ [[G1:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ [[I]], %[[ENTRY]] ], [ 2, %[[LATCH]] ]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 4
; CHECK-NEXT:    [[R:%.*]] = add i64 [[V]], [[IDX]]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[R]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[G1]] = getelementptr i8, ptr [[A]], i64 16
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  %g0 = getelementptr [2 x i8], ptr %a, i64 %i
  br label %loop

loop:
  %p = phi ptr [ %g0, %entry ], [ %g1, %latch ]
  %idx = phi i64 [ %i, %entry ], [ 2, %latch ]
  %v = load i64, ptr %p
  %r = add i64 %v, %idx
  %c = icmp eq i64 %r, 0
  br i1 %c, label %exit, label %latch

latch:
  %g1 = getelementptr %U, ptr %a, i64 4
  br label %loop

exit:
  ret i64 %r
}
