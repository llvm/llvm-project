; A constant GEP in the latch is visited after the PHI, before it is
; canonicalized to i8, so its index still counts i32 elements. 8 i32s are 32
; bytes: the index PHI starting at 1 element of 8 bytes does not match it.
define void @latch_const_gep_not_i8_mismatch(ptr %a, i64 %k, i64 %n) {
; CHECK-LABEL: define void @latch_const_gep_not_i8_mismatch(
; CHECK-SAME: ptr [[A:%.*]], i64 [[K:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[P0:%.*]] = getelementptr [8 x i8], ptr [[A]], i64 [[K]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi ptr [ [[P0]], %[[ENTRY]] ], [ [[P_LAT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[K]], %[[ENTRY]] ], [ 1, %[[LOOP]] ]
; CHECK-NEXT:    [[CNT:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[CNT_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    call void @use(i64 [[V]])
; CHECK-NEXT:    call void @use(i64 [[I]])
; CHECK-NEXT:    [[CNT_NEXT]] = add i64 [[CNT]], 1
; CHECK-NEXT:    [[P_LAT]] = getelementptr i8, ptr [[A]], i64 32
; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[CNT_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %p0 = getelementptr i64, ptr %a, i64 %k
  br label %loop

loop:
  %p = phi ptr [ %p0, %entry ], [ %p.lat, %loop ]
  %i = phi i64 [ %k, %entry ], [ 1, %loop ]
  %cnt = phi i64 [ 0, %entry ], [ %cnt.next, %loop ]
  %v = load i64, ptr %p, align 8
  call void @use(i64 %v)
  call void @use(i64 %i)
  %cnt.next = add i64 %cnt, 1
  %p.lat = getelementptr i32, ptr %a, i64 8
  %c = icmp slt i64 %cnt.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

