; A PHI of GEPs of the same base folds into one GEP of a PHI of the indices.
; Constant GEPs are canonicalized to i8, so they disagree on the source element
; type with the variable GEPs, and a constant index is normally not merged with
; a variable one. Both are fine when a PHI of the indices already exists.

declare void @use(i64)
declare void @use_ptr(ptr)

%U = type { i8, i8, i8, i8 }

;; Folds.

; Loop-carried pointer with a constant start: the start is an i8 GEP after
; canonicalization, the index PHI starts at the matching element index.
define void @const_i8_and_variable_gep(ptr %a) {
; CHECK-LABEL: define void @const_i8_and_variable_gep(
; CHECK-SAME: ptr [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 1, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr [8 x i8], ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[V]], 0
; CHECK-NEXT:    [[I_NEXT]] = select i1 [[C]], i64 0, i64 [[I]]
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  %p0 = getelementptr [8 x i8], ptr %a, i64 1
  br label %loop

loop:
  %p = phi ptr [ %p0, %entry ], [ %p.next, %loop ]
  %i = phi i64 [ 1, %entry ], [ %i.next, %loop ]
  %v = load i64, ptr %p, align 8
  %c = icmp ult i64 %v, 1
  %i.next = select i1 %c, i64 0, i64 %i
  %p.next = getelementptr [8 x i8], ptr %a, i64 %i.next
  br label %loop
}

