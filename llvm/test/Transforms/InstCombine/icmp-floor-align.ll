; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=instcombine -S < %s | FileCheck %s
;
; (X - (X urem D)) is D*(X/D), a multiple of D. A multiple of D is u> C for any
; C in [0, D) exactly when X u>= D, and u< C for any C in (0, D] exactly when
; X u< D.
;   icmp ugt (sub X, (urem X, D)), C --> icmp ugt X, D-1   for C u< D
;   icmp ult (sub X, (urem X, D)), C --> icmp ult X, D     for 0 u< C u<= D

; UGT form, canonical, non-power-of-2 divisor (C == D-1).
define i1 @floor_ugt_48(i64 %x) {
; CHECK-LABEL: @floor_ugt_48(
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[X:%.*]], 47
; CHECK-NEXT:    ret i1 [[C]]
;
  %r = urem i64 %x, 48
  %s = sub nuw i64 %x, %r
  %c = icmp ugt i64 %s, 47
  ret i1 %c
}

; UGE form, non-power-of-2 divisor (canonicalized to ugt C-1, then folds).
define i1 @floor_uge_48(i64 %x) {
; CHECK-LABEL: @floor_uge_48(
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[X:%.*]], 47
; CHECK-NEXT:    ret i1 [[C]]
;
  %r = urem i64 %x, 48
  %s = sub i64 %x, %r
  %c = icmp uge i64 %s, 48
  ret i1 %c
}

; Real bounded_ptr shape: (x / C) * C u>= C via mul/udiv (uge); InstCombine
; canonicalizes this to the sub/urem form first, then the fold applies.
define i1 @floor_mul_udiv_uge_48(i32 %x) {
; CHECK-LABEL: @floor_mul_udiv_uge_48(
; CHECK-NEXT:    [[X_FR:%.*]] = freeze i32 [[X:%.*]]
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[X_FR]], 47
; CHECK-NEXT:    ret i1 [[C]]
;
  %d = udiv i32 %x, 48
  %m = mul nuw i32 %d, 48
  %c = icmp uge i32 %m, 48
  ret i1 %c
}

