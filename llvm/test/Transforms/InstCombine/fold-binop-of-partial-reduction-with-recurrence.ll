  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %vec.phi0 = phi <2 x i64> [ zeroinitializer, %entry ], [ %partial.reduce0, %loop ]
  %vec.phi1 = phi <2 x i64> [ zeroinitializer, %entry ], [ %partial.reduce1, %loop ]
  %partial.reduce0 = tail call <2 x i64> @llvm.vector.partial.reduce.add(<2 x i64> %vec.phi0, <2 x i64> splat (i64 24))
  %partial.reduce1 = tail call <2 x i64> @llvm.vector.partial.reduce.add(<2 x i64> %vec.phi1, <2 x i64> splat (i64 24))
  %iv.next = add nuw i64 %iv, 4
  %exit.cond = icmp eq i64 %iv.next, %n
  br i1 %exit.cond, label %exit, label %loop

exit:
  %bin.rdx = xor <2 x i64> %partial.reduce1, %partial.reduce0
  %final.rdx = tail call i64 @llvm.vector.reduce.add(<2 x i64> %bin.rdx)
  ret i64 %final.rdx
}
