; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='instcombine<verify-fixpoint>' -S %s | FileCheck %s

; Tests a tricky case in foldCmpLoadFromIndexedGlobal: when the comparison
; result cannot be encoded in a machine integer, if we still generate the
; masking instructions for the index, the output gets simplified by other
; instcombines, and then we add the masking again in the next iteration,
; causing a verify-fixpoint failure.

target datalayout = "p:32:32"

@g = constant [40 x i16] [i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0, i16 1, i16 0]

define i1 @test(i32 %x) {
; CHECK-LABEL: define i1 @test(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = getelementptr [2 x i8], ptr @g, i32 [[X]]
; CHECK-NEXT:    [[V:%.*]] = load i16, ptr [[P]], align 2
; CHECK-NEXT:    [[C:%.*]] = icmp eq i16 [[V]], 1
; CHECK-NEXT:    ret i1 [[C]]
;
  %p = getelementptr [40 x i16], ptr @g, i32 0, i32 %x
  %v = load i16, ptr %p
  %c = icmp eq i16 %v, 1
  ret i1 %c
}
