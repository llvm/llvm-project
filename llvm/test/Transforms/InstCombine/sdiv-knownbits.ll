; Division by zero is UB, so sdiv uses the lowest unknown bit of the
; denominator as the minimum non-zero denominator when it may be zero.
; Each test masks the quotient with its known high bits, so it folds to a
; constant only if the quotient range is tight enough.

; i8, denominator 0b0???????, numerator in [-128, -16] (exact):
; minimum denominator 1, quotient in [-128, -1].
define i8 @sdiv_exact_denom_0b0_______(i8 %a, i8 %x) {
; CHECK-LABEL: define i8 @sdiv_exact_denom_0b0_______(
; CHECK-SAME: i8 [[A:%.*]], i8 [[X:%.*]]) {
; CHECK-NEXT:    ret i8 -128
;
  %n = and i8 %a, -16
  %n.neg = or i8 %n, -128
  %d = and i8 %x, 127
  %r = sdiv exact i8 %n.neg, %d
  %m = and i8 %r, -128
  ret i8 %m
}

