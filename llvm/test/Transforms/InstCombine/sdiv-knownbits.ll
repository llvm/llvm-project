; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; The denominator has the pattern 0b??00, so it can be {0, 4, 8, 12}.
; Division by zero is UB, so the minimum non-zero denominator is 4.
; The numerator is a negative multiple of 16 in the range [-128, -16].
; Therefore, the result is in the range [-32, -1], so the top three
; bits are always set and the final 'and' can be removed.
define i8 @sdiv_maybe_zero_denominator(i8 %a, i8 %x) {
; CHECK-LABEL: define i8 @sdiv_maybe_zero_denominator(
; CHECK-SAME: i8 [[A:%.*]], i8 [[X:%.*]]) {
; CHECK-NEXT:    ret i8 -32
;
  %n = and i8 %a, -16
  %n.neg = or i8 %n, -128
  %d = and i8 %x, 12
  %r = sdiv i8 %n.neg, %d
  %m = and i8 %r, -32
  ret i8 %m
}
