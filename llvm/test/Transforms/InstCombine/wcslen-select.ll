; Verify that wcslen calls over selects and phis of constant string literals
; are folded to selects/phis of the corresponding constant lengths.

; RUN: opt < %s -passes=instcombine -S | FileCheck %s

@s0 = private unnamed_addr constant [3 x i32] [i32 111, i32 107, i32 0]
@s1 = private unnamed_addr constant [8 x i32] [i32 109, i32 105, i32 115, i32 115, i32 105, i32 110, i32 103, i32 0]
@s2 = private unnamed_addr constant [10 x i32] [i32 99, i32 97, i32 110, i32 99, i32 101, i32 108, i32 108, i32 101, i32 100, i32 0]
@sx = external global [0 x i32]

declare i64 @wcslen(ptr)

; wcslen(x ? @s0 : @s1) -> x ? 2 : 7
define i64 @fold_wcslen_select(i1 %c) {
; CHECK-LABEL: define i64 @fold_wcslen_select(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:    [[L:%.*]] = select i1 [[C]], i64 2, i64 7
; CHECK-NEXT:    ret i64 [[L]]
;
  %s = select i1 %c, ptr @s0, ptr @s1
  %l = call i64 @wcslen(ptr %s)
  ret i64 %l
}

; wcslen(c1 ? @s0 : c2 ? @s1 : @s2) -> c1 ? 2 : c2 ? 7 : 9
define i64 @fold_wcslen_nested_select(i1 %c1, i1 %c2) {
; CHECK-LABEL: define i64 @fold_wcslen_nested_select(
; CHECK-SAME: i1 [[C1:%.*]], i1 [[C2:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = select i1 [[C2]], i64 7, i64 9
; CHECK-NEXT:    [[L:%.*]] = select i1 [[C1]], i64 2, i64 [[TMP1]]
; CHECK-NEXT:    ret i64 [[L]]
;
  %inner = select i1 %c2, ptr @s1, ptr @s2
  %sel = select i1 %c1, ptr @s0, ptr %inner
  %l = call i64 @wcslen(ptr %sel)
  ret i64 %l
}

; wcslen(phi over @s0..@s2) -> phi over the constant lengths
define i64 @fold_wcslen_phi(i32 %x) {
; CHECK-LABEL: define i64 @fold_wcslen_phi(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[IDX:%.*]] = and i32 [[X]], 3
; CHECK-NEXT:    switch i32 [[IDX]], label %[[CASE0:.*]] [
; CHECK-NEXT:      i32 1, label %[[CASE1:.*]]
; CHECK-NEXT:      i32 2, label %[[CASE2:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[CASE0]]:
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[CASE1]]:
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[CASE2]]:
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[L:%.*]] = phi i64 [ 2, %[[CASE0]] ], [ 7, %[[CASE1]] ], [ 9, %[[CASE2]] ]
; CHECK-NEXT:    ret i64 [[L]]
;
entry:
  %idx = and i32 %x, 3
  switch i32 %idx, label %case0 [
  i32 1, label %case1
  i32 2, label %case2
  ]
case0:
  br label %join
case1:
  br label %join
case2:
  br label %join
join:
  %p = phi ptr [ @s0, %case0 ], [ @s1, %case1 ], [ @s2, %case2 ]
  %l = call i64 @wcslen(ptr %p)
  ret i64 %l
}

