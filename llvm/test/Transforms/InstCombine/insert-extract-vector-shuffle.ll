; Insert chains of variable-index extracts that llvm.vector.shuffle can express:
; lane i is src[idx[i]].

define <4 x i32> @chain(<4 x i32> %src, <4 x i32> %idx) {
; CHECK-LABEL: define <4 x i32> @chain(
; CHECK-SAME: <4 x i32> [[SRC:%.*]], <4 x i32> [[IDX:%.*]]) {
; CHECK-NEXT:    [[V3:%.*]] = call <4 x i32> @llvm.vector.shuffle.v4i32.v4i32(<4 x i32> [[SRC]], <4 x i32> [[IDX]])
; CHECK-NEXT:    ret <4 x i32> [[V3]]
;
  %i0 = extractelement <4 x i32> %idx, i64 0
  %e0 = extractelement <4 x i32> %src, i32 %i0
  %v0 = insertelement <4 x i32> poison, i32 %e0, i64 0
  %i1 = extractelement <4 x i32> %idx, i64 1
  %e1 = extractelement <4 x i32> %src, i32 %i1
  %v1 = insertelement <4 x i32> %v0, i32 %e1, i64 1
  %i2 = extractelement <4 x i32> %idx, i64 2
  %e2 = extractelement <4 x i32> %src, i32 %i2
  %v2 = insertelement <4 x i32> %v1, i32 %e2, i64 2
  %i3 = extractelement <4 x i32> %idx, i64 3
  %e3 = extractelement <4 x i32> %src, i32 %i3
  %v3 = insertelement <4 x i32> %v2, i32 %e3, i64 3
  ret <4 x i32> %v3
}

