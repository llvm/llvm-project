; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -S -passes=instcombine -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

; Two errno-writing libcalls on the same argument can be fused into a single
; sincos call: the results are the same, and since nothing between the two
; calls can observe or modify errno, the (identical) errno write of the two
; calls cannot be observed to move or merge. The attribute set of the original
; sin/cos calls is `memory(errnomem: write)`; the fused sincos call must model
; that it also writes through its result pointers.

attributes #0 = { nounwind willreturn memory(errnomem: write) }

define double @fuse_sin_cos(double %x) {
; CHECK-LABEL: @fuse_sin_cos(
; CHECK-NEXT:    [[SINCOS_SIN:%.*]] = alloca double, align 8
; CHECK-NEXT:    [[SINCOS_COS:%.*]] = alloca double, align 8
; CHECK-NEXT:    call void @sincos(double [[X:%.*]], ptr nonnull [[SINCOS_SIN]], ptr nonnull [[SINCOS_COS]])
; CHECK-NEXT:    [[SIN:%.*]] = load double, ptr [[SINCOS_SIN]], align 8
; CHECK-NEXT:    [[COS:%.*]] = load double, ptr [[SINCOS_COS]], align 8
; CHECK-NEXT:    [[R:%.*]] = fadd double [[SIN]], [[COS]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0
  %c = call double @cos(double %x) #0
  %r = fadd double %s, %c
  ret double %r
}

define float @fuse_sinf_cosf(float %x) {
; CHECK-LABEL: @fuse_sinf_cosf(
; CHECK-NEXT:    [[SINCOS_SIN:%.*]] = alloca float, align 4
; CHECK-NEXT:    [[SINCOS_COS:%.*]] = alloca float, align 4
; CHECK-NEXT:    call void @sincosf(float [[X:%.*]], ptr nonnull [[SINCOS_SIN]], ptr nonnull [[SINCOS_COS]])
; CHECK-NEXT:    [[SIN:%.*]] = load float, ptr [[SINCOS_SIN]], align 4
; CHECK-NEXT:    [[COS:%.*]] = load float, ptr [[SINCOS_COS]], align 4
; CHECK-NEXT:    [[R:%.*]] = fadd float [[SIN]], [[COS]]
; CHECK-NEXT:    ret float [[R]]
;
  %s = call float @sinf(float %x) #0
  %c = call float @cosf(float %x) #0
  %r = fadd float %s, %c
  ret float %r
}

; The pair in reverse order is also fused.
define double @fuse_cos_sin(double %x) {
; CHECK-LABEL: @fuse_cos_sin(
; CHECK-NEXT:    [[SINCOS_SIN:%.*]] = alloca double, align 8
; CHECK-NEXT:    [[SINCOS_COS:%.*]] = alloca double, align 8
; CHECK-NEXT:    call void @sincos(double [[X:%.*]], ptr nonnull [[SINCOS_SIN]], ptr nonnull [[SINCOS_COS]])
; CHECK-NEXT:    [[SIN:%.*]] = load double, ptr [[SINCOS_SIN]], align 8
; CHECK-NEXT:    [[COS:%.*]] = load double, ptr [[SINCOS_COS]], align 8
; CHECK-NEXT:    [[R:%.*]] = fadd double [[SIN]], [[COS]]
; CHECK-NEXT:    ret double [[R]]
;
  %c = call double @cos(double %x) #0
  %s = call double @sin(double %x) #0
  %r = fadd double %s, %c
  ret double %r
}

; A memory-accessing instruction between the two calls may observe or modify
; errno, so there is no fusion.
define i32 @intervening_load(double %x, ptr %p) {
; CHECK-LABEL: @intervening_load(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR0:[0-9]+]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[C:%.*]] = call double @cos(double [[X]]) #[[ATTR0]]
; CHECK-NEXT:    [[R:%.*]] = fcmp une double [[S]], [[C]]
; CHECK-NEXT:    [[Z:%.*]] = zext i1 [[R]] to i32
; CHECK-NEXT:    [[O:%.*]] = add i32 [[V]], [[Z]]
; CHECK-NEXT:    ret i32 [[O]]
;
  %s = call double @sin(double %x) #0
  %v = load i32, ptr %p
  %c = call double @cos(double %x) #0
  %r = fcmp une double %s, %c
  %z = zext i1 %r to i32
  %o = add i32 %v, %z
  ret i32 %o
}

; A store to memory local to the function (e.g. the temporary of a
; std::complex construction) cannot access errno, so the pair is fused.
define double @intervening_alloca_store(double %x) {
; CHECK-LABEL: @intervening_alloca_store(
; CHECK-NEXT:    [[SINCOS_SIN:%.*]] = alloca double, align 8
; CHECK-NEXT:    [[SINCOS_COS:%.*]] = alloca double, align 8
; CHECK-NEXT:    call void @sincos(double [[X:%.*]], ptr nonnull [[SINCOS_SIN]], ptr nonnull [[SINCOS_COS]])
; CHECK-NEXT:    [[SIN:%.*]] = load double, ptr [[SINCOS_SIN]], align 8
; CHECK-NEXT:    [[COS:%.*]] = load double, ptr [[SINCOS_COS]], align 8
; CHECK-NEXT:    [[R:%.*]] = fadd double [[SIN]], [[COS]]
; CHECK-NEXT:    ret double [[R]]
;
  %slot = alloca double
  %s = call double @sin(double %x) #0
  store double %s, ptr %slot
  %c = call double @cos(double %x) #0
  %r = fadd double %s, %c
  ret double %r
}

; A store to a global may modify errno, so there is no fusion.
@unknown_global = global i32 0

define double @intervening_global_store(double %x) {
; CHECK-LABEL: @intervening_global_store(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR0]]
; CHECK-NEXT:    store i32 7, ptr @unknown_global, align 4
; CHECK-NEXT:    [[C:%.*]] = call double @cos(double [[X]]) #[[ATTR0]]
; CHECK-NEXT:    [[R:%.*]] = fadd double [[S]], [[C]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0
  store i32 7, ptr @unknown_global
  %c = call double @cos(double %x) #0
  %r = fadd double %s, %c
  ret double %r
}

; nobuiltin calls are not libcalls.
define double @nobuiltin(double %x) {
; CHECK-LABEL: @nobuiltin(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR2:[0-9]+]]
; CHECK-NEXT:    [[C:%.*]] = call double @cos(double [[X]]) #[[ATTR2]]
; CHECK-NEXT:    [[R:%.*]] = fadd double [[S]], [[C]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0 nobuiltin
  %c = call double @cos(double %x) #0 nobuiltin
  %r = fadd double %s, %c
  ret double %r
}

; A single call has no pair.
define double @no_pair(double %x) {
; CHECK-LABEL: @no_pair(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR0]]
; CHECK-NEXT:    ret double [[S]]
;
  %s = call double @sin(double %x) #0
  ret double %s
}

; The generated sincos declarations must model both the writes through the
; result pointers and the errno write, even though the sin/cos calls only write
; errno. (Copying the sin/cos memory attribute would make the loads read
; uninitialized memory.)

; A strictfp call must not be fused into a call that is not strictfp.
define double @strictfp_pair(double %x) {
; CHECK-LABEL: @strictfp_pair(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR0]]
; CHECK-NEXT:    [[C:%.*]] = call double @cos(double [[X]]) #[[ATTR3:[0-9]+]]
; CHECK-NEXT:    [[R:%.*]] = fadd double [[S]], [[C]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0
  %c = call double @cos(double %x) #0 strictfp
  %r = fadd double %s, %c
  ret double %r
}

; Different arguments are not a pair.
define double @different_args(double %x, double %y) {
; CHECK-LABEL: @different_args(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR0]]
; CHECK-NEXT:    [[C:%.*]] = call double @cos(double [[Y:%.*]]) #[[ATTR0]]
; CHECK-NEXT:    [[R:%.*]] = fadd double [[S]], [[C]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0
  %c = call double @cos(double %y) #0
  %r = fadd double %s, %c
  ret double %r
}

; A call between the two calls may access errno, so there is no fusion.
define double @intervening_call(double %x) {
; CHECK-LABEL: @intervening_call(
; CHECK-NEXT:    [[S:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR0]]
; CHECK-NEXT:    call void @opaque()
; CHECK-NEXT:    [[C:%.*]] = call double @cos(double [[X]]) #[[ATTR0]]
; CHECK-NEXT:    [[R:%.*]] = fadd double [[S]], [[C]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0
  call void @opaque()
  %c = call double @cos(double %x) #0
  %r = fadd double %s, %c
  ret double %r
}

; Only one side marked nobuiltin: no fusion.
define double @one_sided_nobuiltin(double %x) {
; CHECK-LABEL: @one_sided_nobuiltin(
; CHECK-NEXT:    [[SIN:%.*]] = call double @sin(double [[X:%.*]]) #[[ATTR2]]
; CHECK-NEXT:    [[COS:%.*]] = call double @cos(double [[X]]) #[[ATTR0]]
; CHECK-NEXT:    [[R:%.*]] = fadd double [[SIN]], [[COS]]
; CHECK-NEXT:    ret double [[R]]
;
  %s = call double @sin(double %x) #0 nobuiltin
  %c = call double @cos(double %x) #0
  %r = fadd double %s, %c
  ret double %r
}

declare void @opaque()

declare double @sin(double) #0
declare double @cos(double) #0
declare float @sinf(float) #0
declare float @cosf(float) #0

; The fused sincos declaration must model writes through both result pointers
; (argmem: readwrite) in addition to the errno write; copying the
; memory(errnomem: write) attribute from the sin/cos calls would leave the
; loads above reading uninitialized memory.
; CHECK: declare void @sincos(double, ptr, ptr) #[[SINCOSATTR:[0-9]+]]
; CHECK: attributes #[[SINCOSATTR]] = { nounwind willreturn memory(argmem: readwrite, errnomem: write) }
