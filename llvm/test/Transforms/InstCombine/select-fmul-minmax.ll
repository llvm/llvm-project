; Fold a select between X and X * C, controlled by the sign of X, to a min/max.

define float @olt_c_gt_one(float %x) {
; CHECK-LABEL: @olt_c_gt_one(
; CHECK-NEXT:    [[MUL:%.*]] = fmul float [[X:%.*]], 3.000000e+00
; CHECK-NEXT:    [[SEL:%.*]] = call float @llvm.maxnum.f32(float [[X]], float [[MUL]])
; CHECK-NEXT:    ret float [[SEL]]
;
  %cmp = fcmp olt float %x, 0.0
  %mul = fmul float %x, 3.0
  %sel = select i1 %cmp, float %x, float %mul
  ret float %sel
}

