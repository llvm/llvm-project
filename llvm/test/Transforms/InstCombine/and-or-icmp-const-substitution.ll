; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=instcombine -S | FileCheck %s
define i1 @src(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: define i1 @src(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]], i32 [[Z:%.*]]) {
; CHECK-NEXT:    [[ZERO:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    [[EQUAL:%.*]] = icmp eq i32 [[Y]], [[Z]]
; CHECK-NEXT:    [[BOTH:%.*]] = and i1 [[ZERO]], [[EQUAL]]
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %zero = icmp eq i32 %x, 0
  %sum = add i32 %x, %y
  %equal = icmp eq i32 %sum, %z
  %both = and i1 %zero, %equal
  ret i1 %both
}


; Do not substitute %x = 9 into the shift: that would introduce poison
; on lanes where %x != 9 and the original result could be non-poison.
define <2 x i1> @shl_poison_substitution(<2 x i8> %x, <2 x i8> %y, <2 x i8> %z) {
; CHECK-LABEL: define <2 x i1> @shl_poison_substitution(
; CHECK-SAME: <2 x i8> [[X:%.*]], <2 x i8> [[Y:%.*]], <2 x i8> [[Z:%.*]]) {
; CHECK-NEXT:    [[C1:%.*]] = icmp eq <2 x i8> [[X]], splat (i8 9)
; CHECK-NEXT:    [[SH:%.*]] = shl <2 x i8> [[Y]], [[X]]
; CHECK-NEXT:    [[C2:%.*]] = icmp eq <2 x i8> [[SH]], [[Z]]
; CHECK-NEXT:    [[BOTH:%.*]] = and <2 x i1> [[C1]], [[C2]]
; CHECK-NEXT:    ret <2 x i1> [[BOTH]]
;
  %c1 = icmp eq <2 x i8> %x, splat (i8 9)
  %sh = shl <2 x i8> %y, %x
  %c2 = icmp eq <2 x i8> %sh, %z
  %both = and <2 x i1> %c1, %c2
  ret <2 x i1> %both
}
