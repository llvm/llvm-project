; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; sext(binop nsw (trunc nsw X), C) is the same operation on X when X already
; has the destination type. Rebuilding that expression without nsw becomes a
; shl/ashr pair, which SCEV cannot treat as a non-wrapping recurrence.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

declare void @use32(i32)

define i64 @sext_add_nsw_of_trunc_nsw(i64 %x) {
; CHECK-LABEL: define i64 @sext_add_nsw_of_trunc_nsw(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = add nsw i64 [[X]], 1
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i64 %x to i32
  %s = add nsw i32 %t, 1
  %e = sext i32 %s to i64
  ret i64 %e
}

define i64 @sext_sub_nsw_of_trunc_nsw(i64 %x) {
; CHECK-LABEL: define i64 @sext_sub_nsw_of_trunc_nsw(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = add nsw i64 [[X]], -1
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i64 %x to i32
  %s = sub nsw i32 %t, 1
  %e = sext i32 %s to i64
  ret i64 %e
}

define i64 @sext_sub_nsw_of_two_trunc_nsw(i64 %x, i64 %y) {
; CHECK-LABEL: define i64 @sext_sub_nsw_of_two_trunc_nsw(
; CHECK-SAME: i64 [[X:%.*]], i64 [[Y:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = sub nsw i64 [[X]], [[Y]]
; CHECK-NEXT:    ret i64 [[E]]
;
  %tx = trunc nsw i64 %x to i32
  %ty = trunc nsw i64 %y to i32
  %s = sub nsw i32 %tx, %ty
  %e = sext i32 %s to i64
  ret i64 %e
}

define i64 @sext_mul_nsw_of_trunc_nsw(i64 %x) {
; CHECK-LABEL: define i64 @sext_mul_nsw_of_trunc_nsw(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = mul nsw i64 [[X]], 3
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i64 %x to i32
  %s = mul nsw i32 %t, 3
  %e = sext i32 %s to i64
  ret i64 %e
}

define i64 @sext_add_nsw_constant_on_lhs(i64 %x) {
; CHECK-LABEL: define i64 @sext_add_nsw_constant_on_lhs(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = add nsw i64 [[X]], -5
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i64 %x to i32
  %s = add nsw i32 -5, %t
  %e = sext i32 %s to i64
  ret i64 %e
}

define <2 x i64> @sext_add_nsw_of_trunc_nsw_vec(<2 x i64> %x) {
; CHECK-LABEL: define <2 x i64> @sext_add_nsw_of_trunc_nsw_vec(
; CHECK-SAME: <2 x i64> [[X:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = add nsw <2 x i64> [[X]], splat (i64 1)
; CHECK-NEXT:    ret <2 x i64> [[E]]
;
  %t = trunc nsw <2 x i64> %x to <2 x i32>
  %s = add nsw <2 x i32> %t, splat (i32 1)
  %e = sext <2 x i32> %s to <2 x i64>
  ret <2 x i64> %e
}

define i64 @sext_add_nsw_of_trunc_nsw_extra_use(i64 %x) {
; CHECK-LABEL: define i64 @sext_add_nsw_of_trunc_nsw_extra_use(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[T:%.*]] = trunc nsw i64 [[X]] to i32
; CHECK-NEXT:    call void @use32(i32 [[T]])
; CHECK-NEXT:    [[E:%.*]] = add nsw i64 [[X]], 1
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i64 %x to i32
  call void @use32(i32 %t)
  %s = add nsw i32 %t, 1
  %e = sext i32 %s to i64
  ret i64 %e
}

; Negative: trunc without nsw does not prove that %x fits in i32.

define i64 @sext_add_nsw_of_trunc_without_nsw(i64 %x) {
; CHECK-LABEL: define i64 @sext_add_nsw_of_trunc_without_nsw(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = shl i64 [[X]], 32
; CHECK-NEXT:    [[SEXT:%.*]] = add i64 [[S]], 4294967296
; CHECK-NEXT:    [[E:%.*]] = ashr exact i64 [[SEXT]], 32
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc i64 %x to i32
  %s = add nsw i32 %t, 1
  %e = sext i32 %s to i64
  ret i64 %e
}

; Negative: the narrow add may wrap, so the wide add is not equivalent.

define i64 @sext_add_of_trunc_nsw_without_nsw(i64 %x) {
; CHECK-LABEL: define i64 @sext_add_of_trunc_nsw_without_nsw(
; CHECK-SAME: i64 [[X:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = shl i64 [[X]], 32
; CHECK-NEXT:    [[SEXT:%.*]] = add i64 [[S]], 4294967296
; CHECK-NEXT:    [[E:%.*]] = ashr exact i64 [[SEXT]], 32
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i64 %x to i32
  %s = add i32 %t, 1
  %e = sext i32 %s to i64
  ret i64 %e
}

; Negative: the truncated value is wider than the sext result.

define i64 @sext_add_nsw_trunc_nsw_wider_source(i128 %x) {
; CHECK-LABEL: define i64 @sext_add_nsw_trunc_nsw_wider_source(
; CHECK-SAME: i128 [[X:%.*]]) {
; CHECK-NEXT:    [[T:%.*]] = trunc nsw i128 [[X]] to i64
; CHECK-NEXT:    [[S:%.*]] = shl i64 [[T]], 32
; CHECK-NEXT:    [[SEXT:%.*]] = add i64 [[S]], 4294967296
; CHECK-NEXT:    [[E:%.*]] = ashr exact i64 [[SEXT]], 32
; CHECK-NEXT:    ret i64 [[E]]
;
  %t = trunc nsw i128 %x to i32
  %s = add nsw i32 %t, 1
  %e = sext i32 %s to i64
  ret i64 %e
}
