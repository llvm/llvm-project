define i64 @zext_of_sext_or(i16 %arg) {
; CHECK-LABEL: define i64 @zext_of_sext_or(
; CHECK-SAME: i16 [[ARG:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
