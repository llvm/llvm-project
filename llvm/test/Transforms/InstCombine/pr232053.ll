; Make sure we don't crash on an i1 compare whose operands are both constants
; but can't be constant folded to a ConstantInt (PR #232053).

@g = global i32 0

define i1 @icmp_slt_i1_two_constants() {
; CHECK-LABEL: define i1 @icmp_slt_i1_two_constants() {
; CHECK-NEXT:    ret i1 ptrtoint (ptr @g to i1)
;
  %cmp = icmp slt i1 ptrtoint (ptr @g to i1), false
  ret i1 %cmp
}

define i1 @icmp_ult_i1_two_constants() {
; CHECK-LABEL: define i1 @icmp_ult_i1_two_constants() {
; CHECK-NEXT:    ret i1 xor (i1 ptrtoint (ptr @g to i1), i1 true)
;
  %cmp = icmp ult i1 ptrtoint (ptr @g to i1), true
  ret i1 %cmp
}
