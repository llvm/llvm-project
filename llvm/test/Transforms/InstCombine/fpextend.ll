; CHECK-NEXT:    call void @use_i32(i32 [[I]])
; CHECK-NEXT:    [[X:%.*]] = uitofp i32 [[I]] to float
; CHECK-NEXT:    call void @use_f32(float [[X]])
; CHECK-NEXT:    [[R:%.*]] = uitofp i32 [[I]] to double
; CHECK-NEXT:    ret double [[R]]
;
  %i = fptoui float %f to i32
