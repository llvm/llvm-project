; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

declare <8 x i8> @llvm.bitreverse.v8i8(<8 x i8>)

; Fold bitreverse.v8i8(bitcast(i64 X)) with single bitcast-to-i64 user
; into bitreverse.i64(bswap.i64(X)) to avoid GPR<=>vector register crossings.
define i64 @bitreverse_v8i8_to_i64(i64 %x) {
; CHECK-LABEL: @bitreverse_v8i8_to_i64(
; CHECK-NEXT:    [[TMP1:%.*]] = call i64 @llvm.bswap.i64(i64 [[X:%.*]])
; CHECK-NEXT:    [[TMP2:%.*]] = call i64 @llvm.bitreverse.i64(i64 [[TMP1]])
; CHECK-NEXT:    ret i64 [[TMP2]]
;
  %1 = bitcast i64 %x to <8 x i8>
  %2 = call <8 x i8> @llvm.bitreverse.v8i8(<8 x i8> %1)
  %3 = bitcast <8 x i8> %2 to i64
  ret i64 %3
}

; Negative test: multiple uses should NOT fold
define i64 @bitreverse_v8i8_to_i64_multiuse(i64 %x, ptr %p) {
; CHECK-LABEL: @bitreverse_v8i8_to_i64_multiuse(
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i64 [[X:%.*]] to <8 x i8>
; CHECK-NEXT:    [[TMP2:%.*]] = call <8 x i8> @llvm.bitreverse.v8i8(<8 x i8> [[TMP1]])
; CHECK-NEXT:    store <8 x i8> [[TMP2]], ptr [[P:%.*]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = bitcast <8 x i8> [[TMP2]] to i64
; CHECK-NEXT:    ret i64 [[TMP3]]
;
  %1 = bitcast i64 %x to <8 x i8>
  %2 = call <8 x i8> @llvm.bitreverse.v8i8(<8 x i8> %1)
  store <8 x i8> %2, ptr %p
  %3 = bitcast <8 x i8> %2 to i64
  ret i64 %3
}
