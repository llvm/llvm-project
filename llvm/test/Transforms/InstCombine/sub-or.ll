; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; Positive test: C is smax
define i32 @test_smax(i32 %x) {
; CHECK-LABEL: @test_smax(
; CHECK-NEXT:    [[SUB:%.*]] = and i32 [[X:%.*]], -2147483648
; CHECK-NEXT:    ret i32 [[SUB]]
;
  %or = or i32 %x, 2147483647
  %sub = sub i32 2147483647, %or
  ret i32 %sub
}

; Positive test: C is all ones (-1)
define i32 @test_allones(i32 %x) {
; CHECK-LABEL: @test_allones(
; CHECK-NEXT:    ret i32 0
;
  %or = or i32 %x, -1
  %sub = sub i32 -1, %or
  ret i32 %sub
}

; Positive test: vector splat of smax
define <2 x i32> @test_smax_vec(<2 x i32> %x) {
; CHECK-LABEL: @test_smax_vec(
; CHECK-NEXT:    [[SUB:%.*]] = and <2 x i32> [[X:%.*]], splat (i32 -2147483648)
; CHECK-NEXT:    ret <2 x i32> [[SUB]]
;
  %or = or <2 x i32> %x, <i32 2147483647, i32 2147483647>
  %sub = sub <2 x i32> <i32 2147483647, i32 2147483647>, %or
  ret <2 x i32> %sub
}

; Negative test: C is neither smax nor -1 (e.g., umax / -2)
define i32 @test_not_smax_or_allones(i32 %x) {
; CHECK-LABEL: @test_not_smax_or_allones(
; CHECK-NEXT:    [[OR:%.*]] = or i32 [[X:%.*]], -2
; CHECK-NEXT:    [[SUB:%.*]] = sub nsw i32 -2, [[OR]]
; CHECK-NEXT:    ret i32 [[SUB]]
;
  %or = or i32 %x, -2
  %sub = sub i32 -2, %or
  ret i32 %sub
}

; Negative test: the or operand does not match the sub operand
define i32 @test_mismatch(i32 %x) {
; CHECK-LABEL: @test_mismatch(
; CHECK-NEXT:    [[TMP1:%.*]] = and i32 [[X:%.*]], -2147483648
; CHECK-NEXT:    [[SUB:%.*]] = xor i32 [[TMP1]], -2147483648
; CHECK-NEXT:    ret i32 [[SUB]]
;
  %or = or i32 %x, 2147483647
  %sub = sub i32 -1, %or
  ret i32 %sub
}

; Negative test: multiple uses of the or (should still fold, but verify the 'or' sticks around)
define i32 @test_multi_use(i32 %x) {
; CHECK-LABEL: @test_multi_use(
; CHECK-NEXT:    [[OR:%.*]] = or i32 [[X:%.*]], 2147483647
; CHECK-NEXT:    call void @use(i32 [[OR]])
; CHECK-NEXT:    [[SUB:%.*]] = and i32 [[X]], -2147483648
; CHECK-NEXT:    ret i32 [[SUB]]
;
  %or = or i32 %x, 2147483647
  call void @use(i32 %or)
  %sub = sub i32 2147483647, %or
  ret i32 %sub
}

declare void @use(i32)
