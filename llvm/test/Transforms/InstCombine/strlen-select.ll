; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    switch i32 [[X]], label %[[CASE2:.*]] [
; CHECK-NEXT:      i32 0, label %[[CASE0:.*]]
; CHECK-NEXT:      i32 1, label %[[CASE1:.*]]
; CHECK-NEXT:    ]
; CHECK:       [[CASE0]]:
; CHECK-NEXT:    br label %[[MID:.*]]
; CHECK:       [[CASE1]]:
; CHECK-NEXT:    br label %[[MID]]
; CHECK:       [[CASE2]]:
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    [[TMP0:%.*]] = phi i64 [ 2, %[[CASE0]] ], [ 7, %[[CASE1]] ]
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[L:%.*]] = phi i64 [ [[TMP0]], %[[MID]] ], [ 9, %[[CASE2]] ]
; CHECK-NEXT:    ret i64 [[L]]
;
entry:
  switch i32 %x, label %case2 [
  i32 0, label %case0
  i32 1, label %case1
  ]
case0:
  br label %mid
case1:
  br label %mid
case2:
