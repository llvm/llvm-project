; CHECK-NEXT:    [[RB:%.*]] = mul nuw nsw i32 [[R]], 3
; CHECK-NEXT:    [[MASKED:%.*]] = and i32 [[RB]], 32
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[QB]], [[MASKED]]
; CHECK-NEXT:    ret i32 [[SUM]]
;
  %q = lshr i32 %x, 4
  %r = and i32 %x, 15
  %qb = mul i32 %q, 48
  %rb = mul i32 %r, 3
  %masked = and i32 %rb, 32
  %sum = add i32 %qb, %masked
  ret i32 %sum
}
