; The signed forms additionally return poison for the signed minimum divided
; by -1, so the divisor must also not be -1, or the dividend must be neither
; the signed minimum nor poison. A constant divisor has a known zero bit, and
; a dividend whose sign bit is known zero is not the signed minimum.

define i32 @sdiv_poison_constant_divisor(i32 %x) {
; CHECK-LABEL: @sdiv_poison_constant_divisor(
; CHECK-NEXT:    [[R:%.*]] = sdiv i32 [[X:%.*]], 7
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @llvm.sdiv.poison.i32(i32 %x, i32 7)
  ret i32 %r
}

