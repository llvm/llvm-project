; CHECK-NEXT:    [[OR:%.*]] = or i32 [[D:%.*]], 1
; CHECK-NEXT:    [[R:%.*]] = sdiv i32 [[SH]], [[OR]]
; CHECK-NEXT:    ret i32 [[R]]
;
