; CHECK-LABEL: @udiv_poison_constant_divisor(
; CHECK-NEXT:    [[R:%.*]] = udiv i32 [[X:%.*]], 7
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @llvm.udiv.poison.i32(i32 %x, i32 7)
  ret i32 %r
}

