  %result = uitofp nneg <2 x i16> %masked to <2 x half>
  %ret0 = insertvalue { <2 x half>, <2 x i16> } poison, <2 x half> %result, 0
  %ret1 = insertvalue { <2 x half>, <2 x i16> } %ret0, <2 x i16> %masked, 1
  ret { <2 x half>, <2 x i16> } %ret1
}

