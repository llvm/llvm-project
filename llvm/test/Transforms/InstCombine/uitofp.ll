; CHECK-NEXT:    [[MASKED:%.*]] = and <2 x i16> [[TRUNC]], splat (i16 255)
; CHECK-NEXT:    [[RESULT:%.*]] = uitofp nneg <2 x i16> [[MASKED]] to <2 x half>
; CHECK-NEXT:    [[RET0:%.*]] = insertvalue { <2 x half>, <2 x i16> } poison, <2 x half> [[RESULT]], 0
; CHECK-NEXT:    [[RET1:%.*]] = insertvalue { <2 x half>, <2 x i16> } [[RET0]], <2 x i16> [[MASKED]], 1
; CHECK-NEXT:    ret { <2 x half>, <2 x i16> } [[RET1]]
;
