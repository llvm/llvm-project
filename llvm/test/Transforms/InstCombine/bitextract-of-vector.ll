; The bitextract only reads from a bitcast once the phi simplifies, which
; happens after its bitcast user is visited.
define void @v2i64_from_v4i64_loop(<4 x i64> %v, i1 %cond) {
; LE-LABEL: define void @v2i64_from_v4i64_loop(
; LE-SAME: <4 x i64> [[V:%.*]], i1 [[COND:%.*]]) {
; LE-NEXT:  [[ENTRY:.*:]]
; LE-NEXT:    br label %[[LOOP:.*]]
; LE:       [[LOOP]]:
; LE-NEXT:    [[TMP0:%.*]] = shufflevector <4 x i64> [[V]], <4 x i64> poison, <2 x i32> <i32 2, i32 3>
; LE-NEXT:    call void @use_v2i64(<2 x i64> [[TMP0]])
; LE-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[EXIT:.*]]
; LE:       [[EXIT]]:
; LE-NEXT:    ret void
;
; BE-LABEL: define void @v2i64_from_v4i64_loop(
; BE-SAME: <4 x i64> [[V:%.*]], i1 [[COND:%.*]]) {
; BE-NEXT:  [[ENTRY:.*:]]
; BE-NEXT:    br label %[[LOOP:.*]]
; BE:       [[LOOP]]:
; BE-NEXT:    [[TMP0:%.*]] = shufflevector <4 x i64> [[V]], <4 x i64> poison, <2 x i32> <i32 0, i32 1>
; BE-NEXT:    call void @use_v2i64(<2 x i64> [[TMP0]])
; BE-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[EXIT:.*]]
; BE:       [[EXIT]]:
; BE-NEXT:    ret void
;
entry:
  %b = bitcast <4 x i64> %v to b256
  br label %loop

loop:
  %p = phi b256 [ %b, %entry ], [ %next, %loop ]
  %e = bitextract b128, b256 %p, i32 128
  %r = bitcast b128 %e to <2 x i64>
  call void @use_v2i64(<2 x i64> %r)
  %next = select i1 true, b256 %b, b256 poison
  br i1 %cond, label %loop, label %exit

exit:
  ret void
}

