declare void @use(i64)

define i64 @test_add_and_add_multiuse(i64 %x) {
; CHECK-LABEL: @test_add_and_add_multiuse(
; CHECK-NEXT:    [[A:%.*]] = add i64 [[X:%.*]], -8
; CHECK-NEXT:    call void @use(i64 [[A]])
; CHECK-NEXT:    [[R:%.*]] = and i64 [[X]], -8
