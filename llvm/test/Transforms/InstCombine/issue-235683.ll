  %m = and i32 %a, -8
  %r = add i32 %m, 24
  ret i32 %r
}

; Positive: non-power-of-two mask where (16 & -12) == 16 -> folds to (x & -12)
define i32 @test_add_and_add_non_pow2_mask(i32 %x) {
