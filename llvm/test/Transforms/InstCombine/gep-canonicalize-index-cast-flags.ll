; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=instcombine < %s | FileCheck %s

; In this test the index type is narrower/wider than the GEP index operand.
; When foldDependentIVs creates a new GEP via IRBuilder, the index is
; truncated/extended to the index type. The truncation should keep the no-wrap
; information implied by the GEP flags (nusw -> trunc nsw, nuw -> trunc nuw),
; just like InstCombine's own GEP index canonicalization does.
; When extending we can use zext nneg if the GEP flags are nusw+nuw.

target datalayout = "e-p:64:64:64:32"

declare void @use(ptr)

define void @dependent_iv_inbounds(ptr %start, i64 %n) {
; CHECK-LABEL: define void @dependent_iv_inbounds(
; CHECK-SAME: ptr [[START:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV2:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV2_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = trunc nsw i64 [[IV2]] to i32
; CHECK-NEXT:    [[IV:%.*]] = getelementptr inbounds i8, ptr [[START]], i32 [[TMP0]]
; CHECK-NEXT:    call void @use(ptr [[IV]])
; CHECK-NEXT:    [[IV2_NEXT]] = add i64 [[IV2]], 4
; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[IV2_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %iv = phi ptr [ %start, %entry ], [ %iv.next, %loop ]
  %iv2 = phi i64 [ 0, %entry ], [ %iv2.next, %loop ]
  call void @use(ptr %iv)
  %iv2.next = add i64 %iv2, 4
  %iv.next = getelementptr inbounds i8, ptr %start, i64 %iv2.next
  %c = icmp ult i64 %iv2.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

