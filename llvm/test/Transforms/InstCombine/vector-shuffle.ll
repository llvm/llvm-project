; Mask indices are in [0, 2), so source lanes 2-3 are never selected.
define <4 x i32> @demanded_src_hi_unused(i32 %v0, i32 %v1, i32 %v2, i32 %v3, <4 x i32> %mask) {
; CHECK-LABEL: define <4 x i32> @demanded_src_hi_unused(
; CHECK-SAME: i32 [[V0:%.*]], i32 [[V1:%.*]], i32 [[V2:%.*]], i32 [[V3:%.*]], <4 x i32> [[MASK:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = insertelement <4 x i32> poison, i32 [[V0]], i64 0
; CHECK-NEXT:    [[B:%.*]] = insertelement <4 x i32> [[A]], i32 [[V1]], i64 1
; CHECK-NEXT:    [[SM:%.*]] = and <4 x i32> [[MASK]], splat (i32 1)
; CHECK-NEXT:    [[RES:%.*]] = call <4 x i32> @llvm.vector.shuffle.v4i32.v4i32(<4 x i32> [[B]], <4 x i32> [[SM]])
; CHECK-NEXT:    ret <4 x i32> [[RES]]
;
  %a = insertelement <4 x i32> poison, i32 %v0, i64 0
  %b = insertelement <4 x i32> %a, i32 %v1, i64 1
  %c = insertelement <4 x i32> %b, i32 %v2, i64 2
  %d = insertelement <4 x i32> %c, i32 %v3, i64 3
  %sm = and <4 x i32> %mask, splat(i32 1)
  %res = call <4 x i32> @llvm.vector.shuffle.v4i32.v4i32(<4 x i32> %d, <4 x i32> %sm)
  ret <4 x i32> %res
}

