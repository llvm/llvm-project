; The known-bits folds of select arms are limited to scalars.
define <2 x i32> @vector(<2 x i32> %x) {
; CHECK-LABEL: @vector(
; CHECK-NEXT:    [[S:%.*]] = lshr <2 x i32> [[X:%.*]], splat (i32 23)
; CHECK-NEXT:    [[A:%.*]] = and <2 x i32> [[S]], splat (i32 255)
; CHECK-NEXT:    [[C1:%.*]] = icmp slt <2 x i32> [[X]], zeroinitializer
; CHECK-NEXT:    [[R:%.*]] = select <2 x i1> [[C1]], <2 x i32> [[A]], <2 x i32> [[S]]
; CHECK-NEXT:    ret <2 x i32> [[R]]
;
  %s = lshr <2 x i32> %x, splat (i32 23)
  %c = icmp sgt <2 x i32> %x, splat (i32 -1)
  %a = and <2 x i32> %s, splat (i32 255)
  %r = select <2 x i1> %c, <2 x i32> %s, <2 x i32> %a
  ret <2 x i32> %r
}

