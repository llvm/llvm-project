; If the condition (or its inverse) implies that X has no bits outside M,
; the arms X and (and X, M) are equal wherever it holds, so the select is
; the arm it does not choose there.

define i32 @shift_of_nonnegative(i32 %x) {
; CHECK-LABEL: @shift_of_nonnegative(
; CHECK-NEXT:    [[S:%.*]] = lshr i32 [[X:%.*]], 23
; CHECK-NEXT:    [[A:%.*]] = and i32 [[S]], 255
; CHECK-NEXT:    [[C1:%.*]] = icmp slt i32 [[X]], 0
; CHECK-NEXT:    [[R:%.*]] = select i1 [[C1]], i32 [[A]], i32 [[S]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %s = lshr i32 %x, 23
  %c = icmp sgt i32 %x, -1
  %a = and i32 %s, 255
  %r = select i1 %c, i32 %s, i32 %a
  ret i32 %r
}

