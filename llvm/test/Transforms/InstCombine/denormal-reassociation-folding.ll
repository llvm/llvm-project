; Verify that a constant fold performed while reassociating ordinary fadd
; instructions observes the enclosing function's denormal environment.

define float @reassociate_fadd(float %x, float %y) denormal_fpenv(float: preservesign) {
; CHECK-LABEL: define float @reassociate_fadd(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[RESULT:%.*]] = fadd fast float [[X]], [[Y]]
; CHECK-NEXT:    ret float [[RESULT]]
;
  %x.add = fadd fast float %x, f0x00000001
  %y.add = fadd fast float %y, f0x00000001
  %result = fadd fast float %x.add, %y.add
  ret float %result
}

; Reassociate folds this pair directly through ConstantFoldBinaryOpOperands.
; The output is a denormal before FTZ, so preservesign must produce zero.
define float @reassociate_output_ftz(float %x, float %y) denormal_fpenv(float: preservesign|ieee) {
; CHECK-LABEL: define float @reassociate_output_ftz(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[Y_ADD:%.*]] = fadd fast float [[X]], [[Y]]
; CHECK-NEXT:    ret float [[Y_ADD]]
;
  %x.add = fadd fast float %x, f0x00800000
  %y.add = fadd fast float %y, f0x807FFFFF
  %result = fadd fast float %x.add, %y.add
  ret float %result
}

