; Factorization creates (C1 + C2) / X. With input FTZ, the subnormal C2 is
; zero and the folded numerator is the normal C1 value.
define float @factor_fdiv_input_ftz(float %x) denormal_fpenv(float: ieee|preservesign) {
; CHECK-LABEL: define float @factor_fdiv_input_ftz(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR3:[0-9]+]] {
