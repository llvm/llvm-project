; RUN: opt -passes=instcombine -S < %s | FileCheck %s

; A logical and short-circuits the poison lane of %cmp2 when %cmp1 is false.
; Folding it to %cmp2 would expose that poison.
define <2 x i1> @logical_and_poison_rhs(<2 x i8> %x) {
;
; CHECK-LABEL: define <2 x i1> @logical_and_poison_rhs(
; CHECK-SAME: <2 x i8> [[X:%.*]]) {
; CHECK-NEXT:    [[AND1:%.*]] = and <2 x i8> [[X]], splat (i8 12)
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ne <2 x i8> [[AND1]], zeroinitializer
; CHECK-NEXT:    [[AND2:%.*]] = and <2 x i8> [[X]], splat (i8 15)
; CHECK-NEXT:    [[CMP2:%.*]] = icmp eq <2 x i8> [[AND2]], <i8 8, i8 poison>
; CHECK-NEXT:    [[R:%.*]] = select <2 x i1> [[CMP1]], <2 x i1> [[CMP2]], <2 x i1> zeroinitializer
; CHECK-NEXT:    ret <2 x i1> [[R]]
;
  %and1 = and <2 x i8> %x, splat (i8 12)
  %cmp1 = icmp ne <2 x i8> %and1, zeroinitializer
  %and2 = and <2 x i8> %x, splat (i8 15)
  %cmp2 = icmp eq <2 x i8> %and2, <i8 8, i8 poison>
  %r = select <2 x i1> %cmp1, <2 x i1> %cmp2, <2 x i1> zeroinitializer
  ret <2 x i1> %r
}

; The same pattern as a logical or.
define <2 x i1> @logical_or_poison_rhs(<2 x i8> %x) {
;
; CHECK-LABEL: define <2 x i1> @logical_or_poison_rhs(
; CHECK-SAME: <2 x i8> [[X:%.*]]) {
; CHECK-NEXT:    [[C1:%.*]] = icmp eq <2 x i8> [[X]], zeroinitializer
; CHECK-NEXT:    [[T:%.*]] = trunc <2 x i8> [[X]] to <2 x i3>
; CHECK-NEXT:    [[C2:%.*]] = icmp ne <2 x i3> [[T]], <i3 poison, i3 -2>
; CHECK-NEXT:    [[R:%.*]] = select <2 x i1> [[C1]], <2 x i1> splat (i1 true), <2 x i1> [[C2]]
; CHECK-NEXT:    ret <2 x i1> [[R]]
;
  %c1 = icmp eq <2 x i8> %x, zeroinitializer
  %t = trunc <2 x i8> %x to <2 x i3>
  %c2 = icmp ne <2 x i3> %t, <i3 poison, i3 -2>
  %r = select <2 x i1> %c1, <2 x i1> splat (i1 true), <2 x i1> %c2
  ret <2 x i1> %r
}

