; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=instcombine -S %s | FileCheck %s

; StackColoring may give two allocas with disjoint lifetimes the same stack
; slot, so their addresses may be equal at run time even though the objects
; never coexist.  Addresses can escape and be compared outside both lifetimes,
; so the pointer comparison must not be folded to false when we cannot prove
; the two objects coexist (https://github.com/llvm/llvm-project/issues/45725).

declare void @llvm.lifetime.start.p0(ptr)
declare void @llvm.lifetime.end.p0(ptr)
declare void @use(ptr)

@g = external global [16 x i8]

; Two allocas with disjoint lifetimes: addresses may coincide after stack
; coloring merges them; must not fold.
define i1 @disjoint_lifetimes() {
; CHECK-LABEL: @disjoint_lifetimes(
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    [[B:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[A]])
; CHECK-NEXT:    call void @use(ptr nonnull [[A]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[A]])
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[B]])
; CHECK-NEXT:    call void @use(ptr nonnull [[B]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[B]])
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq ptr [[A]], [[B]]
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %a = alloca [16 x i8], align 16
  %b = alloca [16 x i8], align 16
  call void @llvm.lifetime.start.p0(ptr %a)
  call void @use(ptr %a)
  call void @llvm.lifetime.end.p0(ptr %a)
  call void @llvm.lifetime.start.p0(ptr %b)
  call void @use(ptr %b)
  call void @llvm.lifetime.end.p0(ptr %b)
  %cmp = icmp eq ptr %a, %b
  ret i1 %cmp
}

; Same as above, but with the addresses escaped via ptrtoint and compared as
; integers; the equality must survive there as well.
define i1 @disjoint_lifetimes_ptrtoint() {
; CHECK-LABEL: @disjoint_lifetimes_ptrtoint(
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    [[B:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[A]])
; CHECK-NEXT:    call void @use(ptr nonnull [[A]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[A]])
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[B]])
; CHECK-NEXT:    call void @use(ptr nonnull [[B]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[B]])
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq ptr [[A]], [[B]]
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %a = alloca [16 x i8], align 16
  %b = alloca [16 x i8], align 16
  call void @llvm.lifetime.start.p0(ptr %a)
  call void @use(ptr %a)
  call void @llvm.lifetime.end.p0(ptr %a)
  call void @llvm.lifetime.start.p0(ptr %b)
  call void @use(ptr %b)
  call void @llvm.lifetime.end.p0(ptr %b)
  %ai = ptrtoint ptr %a to i64
  %bi = ptrtoint ptr %b to i64
  %cmp = icmp eq i64 %ai, %bi
  ret i1 %cmp
}

; One alloca without lifetime intrinsics is live for the whole function and
; never merged; the two objects provably coexist while the marked one is
; live, so folding is sound.
define i1 @one_unmarked() {
; CHECK-LABEL: @one_unmarked(
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    [[B:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[B]])
; CHECK-NEXT:    call void @use(ptr nonnull [[A]])
; CHECK-NEXT:    call void @use(ptr nonnull [[B]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[B]])
; CHECK-NEXT:    ret i1 false
;
  %a = alloca [16 x i8], align 16
  %b = alloca [16 x i8], align 16
  call void @llvm.lifetime.start.p0(ptr %b)
  call void @use(ptr %a)
  call void @use(ptr %b)
  call void @llvm.lifetime.end.p0(ptr %b)
  %cmp = icmp eq ptr %a, %b
  ret i1 %cmp
}

; Two allocas without lifetime intrinsics are both live for the whole
; function; folding is sound.
define i1 @no_lifetimes() {
; CHECK-LABEL: @no_lifetimes(
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    [[B:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    call void @use(ptr nonnull [[A]])
; CHECK-NEXT:    call void @use(ptr nonnull [[B]])
; CHECK-NEXT:    ret i1 false
;
  %a = alloca [16 x i8], align 16
  %b = alloca [16 x i8], align 16
  call void @use(ptr %a)
  call void @use(ptr %b)
  %cmp = icmp eq ptr %a, %b
  ret i1 %cmp
}

; A global variable never shares storage with an alloca, even a marked one.
define i1 @marked_alloca_vs_global() {
; CHECK-LABEL: @marked_alloca_vs_global(
; CHECK-NEXT:    [[A:%.*]] = alloca [16 x i8], align 16
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr nonnull [[A]])
; CHECK-NEXT:    call void @use(ptr nonnull [[A]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr nonnull [[A]])
; CHECK-NEXT:    ret i1 false
;
  %a = alloca [16 x i8], align 16
  call void @llvm.lifetime.start.p0(ptr %a)
  call void @use(ptr %a)
  call void @llvm.lifetime.end.p0(ptr %a)
  %cmp = icmp eq ptr %a, @g
  ret i1 %cmp
}
