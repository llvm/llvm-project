; https://github.com/llvm/llvm-project/issues/244434
; Inlined strcmp("-", s) == 0.
define i1 @strcmp_dash_eq_zero(ptr %s) {
; CHECK-LABEL: define i1 @strcmp_dash_eq_zero(
; CHECK-SAME: ptr [[S:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C0:%.*]] = load i8, ptr [[S]], align 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[C0]], 45
; CHECK-NEXT:    br i1 [[CMP]], label %[[NEXT:.*]], label %[[EXIT:.*]]
; CHECK:       [[NEXT]]:
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds nuw i8, ptr [[S]], i64 1
; CHECK-NEXT:    [[C1:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq i8 [[C1]], 0
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i1 [ false, %[[ENTRY]] ], [ [[TMP0]], %[[NEXT]] ]
; CHECK-NEXT:    ret i1 [[RES]]
;
entry:
  %c0 = load i8, ptr %s, align 1
  %z0 = zext i8 %c0 to i32
  %r0 = sub nsw i32 45, %z0
  %cmp = icmp eq i8 %c0, 45
  br i1 %cmp, label %next, label %exit

next:
  %p1 = getelementptr inbounds nuw i8, ptr %s, i64 1
  %c1 = load i8, ptr %p1, align 1
  %z1 = zext i8 %c1 to i32
  %r1 = sub nsw i32 0, %z1
  br label %exit

exit:
  %r = phi i32 [ %r0, %entry ], [ %r1, %next ]
  %res = icmp eq i32 %r, 0
  ret i1 %res
}

