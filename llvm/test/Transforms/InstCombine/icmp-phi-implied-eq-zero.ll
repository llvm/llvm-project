; General form: C2 == zext(C1), non-zero C3.
define i1 @general_c3_nonzero(i8 %a, ptr %p) {
; CHECK-LABEL: define i1 @general_c3_nonzero(
; CHECK-SAME: i8 [[A:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[CMP_NOT:%.*]] = icmp eq i8 [[A]], 97
; CHECK-NEXT:    br i1 [[CMP_NOT]], label %[[NEXT:.*]], label %[[EXIT:.*]]
; CHECK:       [[NEXT]]:
; CHECK-NEXT:    [[B:%.*]] = load i8, ptr [[P]], align 1
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ne i8 [[B]], 7
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i1 [ true, %[[ENTRY]] ], [ [[TMP0]], %[[NEXT]] ]
; CHECK-NEXT:    ret i1 [[RES]]
;
entry:
  %za = zext i8 %a to i32
  %r0 = sub i32 97, %za
  %cmp = icmp ne i8 %a, 97
  br i1 %cmp, label %exit, label %next

next:
  %b = load i8, ptr %p, align 1
  %zb = zext i8 %b to i32
  %r1 = sub i32 7, %zb
  br label %exit

exit:
  %r = phi i32 [ %r0, %entry ], [ %r1, %next ]
  %res = icmp ne i32 %r, 0
  ret i1 %res
}

