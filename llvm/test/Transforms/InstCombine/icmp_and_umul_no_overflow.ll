; !umul_overflow(x, K) && (x * K <u C) --> x <u ceil(C / K)

define i1 @umul_no_overflow_and_ult_const(i32 %x) {
;
; CHECK-LABEL: define i1 @umul_no_overflow_and_ult_const(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = icmp ult i32 [[X]], 14
; CHECK-NEXT:    ret i1 [[R]]
;
  %m = call { i32, i1 } @llvm.umul.with.overflow.i32(i32 %x, i32 3)
  %ov = extractvalue { i32, i1 } %m, 1
  %p = extractvalue { i32, i1 } %m, 0
  %lt = icmp ult i32 %p, 41
  %no = xor i1 %ov, true
  %r = and i1 %lt, %no
  ret i1 %r
}

