; Basic test: !overflow(x * 3) && (x * 3 < 41) -> x < ceil(41/3) = x < 14
define i1 @umul_no_overflow_and_less_than_basic(i32 %x) {
; CHECK-LABEL: define i1 @umul_no_overflow_and_less_than_basic(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[R:%.*]] = icmp ult i32 [[X]], 14
; CHECK-NEXT:    ret i1 [[R]]
;
  %m = call {i32, i1} @llvm.umul.with.overflow.i32(i32 %x, i32 3)
  %ov = extractvalue {i32, i1} %m, 1
  %p = extractvalue {i32, i1} %m, 0
  %lt = icmp ult i32 %p, 41
  %noov = xor i1 %ov, true
  %r = and i1 %lt, %noov
  ret i1 %r
}

