; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; If we branch on (a & b) == 0, we know a and b have no common bits set
; on the true path. InstCombine can use this to fold an add into an or disjoint.

define i32 @test_br(i32 %b, i32 %c) {
; CHECK-LABEL: @test_br(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[AND:%.*]] = and i32 [[C:%.*]], [[B:%.*]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[AND]], 0
; CHECK-NEXT:    br i1 [[CMP]], label [[TRUE:%.*]], label [[FALSE:%.*]]
; CHECK:       true:
; CHECK-NEXT:    [[ADD:%.*]] = or disjoint i32 [[C]], [[B]]
; CHECK-NEXT:    ret i32 [[ADD]]
; CHECK:       false:
; CHECK-NEXT:    ret i32 0
;
entry:
  %and = and i32 %c, %b
  %cmp = icmp eq i32 %and, 0
  br i1 %cmp, label %true, label %false

true:
  %add = add i32 %c, %b
  ret i32 %add

false:
  ret i32 0
}
