; CHECK-NEXT:    call void @use_i8(i8 [[LOWBIT]])
; CHECK-NEXT:    [[R:%.*]] = icmp ne i8 [[LOWBIT]], 1
; CHECK-NEXT:    ret i1 [[R]]
;
  %neg = sub i8 0, %x
  %lowbit = and i8 %x, %neg
  call void @use_i8(i8 %lowbit)
  %r = icmp ne i8 %lowbit, 1
