; Context-sensitive non-zero proofs: llvm.assume and dominating branch.

declare void @llvm.assume(i1)

define i1 @icmp_eq_udiv_assume(i32 %x, i32 %y) {
; CHECK-LABEL: define i1 @icmp_eq_udiv_assume(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[NZ:%.*]] = icmp ne i32 [[X]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[NZ]])
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[Y]], 1
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %nz = icmp ne i32 %x, 0
  call void @llvm.assume(i1 %nz)
  %div = udiv i32 %x, %y
  %cmp = icmp eq i32 %div, %x
  ret i1 %cmp
}

define i1 @icmp_eq_udiv_dominating_branch(i32 %x, i32 %y) {
; CHECK-LABEL: define i1 @icmp_eq_udiv_dominating_branch(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[NZ_NOT:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    br i1 [[NZ_NOT]], label %[[ELSE:.*]], label %[[THEN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[Y]], 1
; CHECK-NEXT:    ret i1 [[CMP]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %nz = icmp ne i32 %x, 0
  br i1 %nz, label %then, label %else

then:
  %div = udiv i32 %x, %y
  %cmp = icmp eq i32 %div, %x
  ret i1 %cmp

else:
  ret i1 false
}

