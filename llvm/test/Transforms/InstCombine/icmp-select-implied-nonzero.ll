; CHECK-NEXT:    [[OV:%.*]] = icmp ult <2 x i64> [[ADD]], [[SIZE]]
; CHECK-NEXT:    [[MIN:%.*]] = call <2 x i64> @llvm.umin.v2i64(<2 x i64> [[ADD]], <2 x i64> splat (i64 9223372036854775807))
; CHECK-NEXT:    [[LEN:%.*]] = select <2 x i1> [[OV]], <2 x i64> splat (i64 9223372036854775807), <2 x i64> [[MIN]]
; CHECK-NEXT:    call void @usev(<2 x i64> [[LEN]])
; CHECK-NEXT:    [[R:%.*]] = icmp ne <2 x i64> [[LEN]], zeroinitializer
; CHECK-NEXT:    ret <2 x i1> [[R]]
;
  %max = call <2 x i64> @llvm.umax.v2i64(<2 x i64> %size, <2 x i64> splat (i64 1))
  %add = add <2 x i64> %max, %size
  %ov = icmp ult <2 x i64> %add, %size
  %min = call <2 x i64> @llvm.umin.v2i64(<2 x i64> %add, <2 x i64> splat (i64 9223372036854775807))
  %len = select <2 x i1> %ov, <2 x i64> splat (i64 9223372036854775807), <2 x i64> %min
  call void @usev(<2 x i64> %len)
  %r = icmp ne <2 x i64> %len, zeroinitializer
  ret <2 x i1> %r
}

; The premise can also come from an assume rather than a select or a branch.
define i1 @check_len_assume(i64 %size) {
