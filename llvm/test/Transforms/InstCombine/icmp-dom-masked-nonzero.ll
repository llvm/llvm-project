; Keep these cases small and loop-free for translation validation.

define i1 @masked_nonzero_superset(i8 %x) {
; CHECK-LABEL: @masked_nonzero_superset(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[NARROW:%.*]] = and i8 [[X:%.*]], 3
; CHECK-NEXT:    [[COND_NOT:%.*]] = icmp eq i8 [[NARROW]], 0
; CHECK-NEXT:    br i1 [[COND_NOT]], label [[EXIT:%.*]], label [[TAKEN:%.*]]
; CHECK:       taken:
; CHECK-NEXT:    ret i1 true
; CHECK:       exit:
; CHECK-NEXT:    ret i1 false
;
entry:
  %narrow = and i8 %x, 3
  %cond = icmp ne i8 %narrow, 0
  br i1 %cond, label %taken, label %exit

taken:
  %wide = and i8 %x, 7
  %cmp = icmp ne i8 %wide, 0
  ret i1 %cmp

exit:
  ret i1 false
}

