; CHECK-NEXT:    [[G2:%.*]] = getelementptr inbounds nuw i8, ptr [[P]], i64 [[TMP1]]
; CHECK-NEXT:    ret ptr [[G2]]
;
  %m = mul i64 %x, 3
  %g1 = getelementptr inbounds nuw double, ptr %p, i64 %m
  %g2 = getelementptr inbounds nuw double, ptr %g1, i64 %x
  ret ptr %g2
}

