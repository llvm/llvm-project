; CHECK-SAME: ptr [[P:%.*]], i64 [[X:%.*]]) {
; CHECK-NEXT:    [[G1:%.*]] = getelementptr inbounds [8 x i8], ptr [[P]], i64 [[X]]
; CHECK-NEXT:    call void @use(ptr [[G1]])
; CHECK-NEXT:    [[G2:%.*]] = getelementptr inbounds [8 x i8], ptr [[G1]], i64 [[X]]
; CHECK-NEXT:    ret ptr [[G2]]
;
