; (P == A ? X : Def) + (P == B ? Y : 0) --> P == A ? X : (Def + (P == B ? Y : 0))
; P == A and P == B cannot both be true.
define i32 @add_selects_exclusive_conds(i32 %p, i32 %x, i32 %y, i32 %def) {
; CHECK-LABEL: define i32 @add_selects_exclusive_conds(
; CHECK-SAME: i32 [[P:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]], i32 [[DEF:%.*]]) {
; CHECK-NEXT:    [[C0:%.*]] = icmp eq i32 [[P]], 288
; CHECK-NEXT:    [[C1:%.*]] = icmp eq i32 [[P]], 128
; CHECK-NEXT:    [[SEL1:%.*]] = select i1 [[C1]], i32 [[Y]], i32 0
; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[DEF]], [[SEL1]]
; CHECK-NEXT:    [[SUM:%.*]] = select i1 [[C0]], i32 [[X]], i32 [[TMP1]]
; CHECK-NEXT:    ret i32 [[SUM]]
;
  %c0 = icmp eq i32 %p, 288
  %sel0 = select i1 %c0, i32 %x, i32 %def
  %c1 = icmp eq i32 %p, 128
  %sel1 = select i1 %c1, i32 %y, i32 0
  %sum = add i32 %sel0, %sel1
  ret i32 %sum
}

