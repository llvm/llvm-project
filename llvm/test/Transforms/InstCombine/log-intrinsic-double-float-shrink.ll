; Logarithm intrinsics have an overloaded float version regardless of libc names.
define float @log_shrink(float %x) {
; CHECK-LABEL: define float @log_shrink(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:    [[TRUNC:%.*]] = call fast float @llvm.log.f32(float [[X]])
; CHECK-NEXT:    ret float [[TRUNC]]
;
  %ext = fpext float %x to double
  %log = call fast double @llvm.log.f64(double %ext)
  %trunc = fptrunc double %log to float
  ret float %trunc
}

