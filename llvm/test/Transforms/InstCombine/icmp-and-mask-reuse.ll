; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i64 [[NARROW]], 62
; CHECK-NEXT:    ret i1 [[CMP]]
;
entry:
  br i1 %c, label %then, label %exit

then:
  %wide = and i64 %x, 63
