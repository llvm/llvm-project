; (X & C) == C is equivalent to (X & M) u>= C, and (X & C) != C to
; (X & M) u< C, when C is a subset of M and M - C is a low-bit mask.
; If X & M is already computed, comparing it saves an instruction.

define i1 @ne_reuse_i64(i64 %x, ptr %p) {
; CHECK-LABEL: define i1 @ne_reuse_i64(
; CHECK-SAME: i64 [[X:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:    [[WIDE:%.*]] = and i64 [[X]], 63
; CHECK-NEXT:    store i64 [[WIDE]], ptr [[P]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ult i64 [[WIDE]], 62
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %wide = and i64 %x, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  %cmp = icmp ne i64 %narrow, 62
  ret i1 %cmp
}

define i1 @eq_reuse_i64(i64 %x, ptr %p) {
; CHECK-LABEL: define i1 @eq_reuse_i64(
; CHECK-SAME: i64 [[X:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:    [[WIDE:%.*]] = and i64 [[X]], 63
; CHECK-NEXT:    store i64 [[WIDE]], ptr [[P]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ugt i64 [[WIDE]], 61
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %wide = and i64 %x, 63
  store i64 %wide, ptr %p
  %narrow = and i64 %x, 62
  %cmp = icmp eq i64 %narrow, 62
  ret i1 %cmp
}

