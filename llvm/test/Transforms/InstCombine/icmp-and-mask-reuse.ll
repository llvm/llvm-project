; CHECK-SAME: i64 [[X:%.*]], ptr [[P:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[WIDE:%.*]] = and i64 [[X]], 63
; CHECK-NEXT:    store i64 [[WIDE]], ptr [[P]], align 4
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
