; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; REQUIRES: aarch64-registered-target
; RUN: opt -S -mtriple=aarch64-unknown-linux-gnu -passes=inferattrs,instcombine %s | FileCheck %s --check-prefixes=CHECK,STRONG
; RUN: opt -S -mtriple=aarch64-unknown-unknown -passes=inferattrs,instcombine %s | FileCheck %s --check-prefixes=CHECK,WEAK

; The STRONG run is a target whose C library guarantees alignof(max_align_t)
; (16) for every size, so inferattrs puts align 16 on the malloc/calloc
; declaration.
;
; The WEAK run assumes no C library, so only the C23 / WG14 N2293 guarantee
; holds: the result is aligned for any scalar type that fits in the
; requested size. instcombine adds that alignment to constant-size calls.

declare ptr @malloc(i64)
declare ptr @calloc(i64, i64)

; bool src() { return (uintptr_t)malloc(1) % alignof(max_align_t) == 0; }
; bool tgt() { return true; }
; Folds only in the STRONG run. With weak alignment malloc(1) may be only
; 1-aligned, so the WEAK run must not fold it.
define i1 @malloc_1_mask_15() {
; STRONG-LABEL: define i1 @malloc_1_mask_15() {
; STRONG-NEXT:    ret i1 true
;
; WEAK-LABEL: define i1 @malloc_1_mask_15() {
; WEAK-NEXT:    [[P:%.*]] = call dereferenceable_or_null(1) ptr @malloc(i64 1)
; WEAK-NEXT:    [[I:%.*]] = ptrtoint ptr [[P]] to i64
; WEAK-NEXT:    [[R:%.*]] = and i64 [[I]], 15
; WEAK-NEXT:    [[Z:%.*]] = icmp eq i64 [[R]], 0
; WEAK-NEXT:    ret i1 [[Z]]
;
  %p = call ptr @malloc(i64 1)
  %i = ptrtoint ptr %p to i64
  %r = and i64 %i, 15
  %z = icmp eq i64 %r, 0
  ret i1 %z
}

; Folds in both runs: the STRONG run has align 16 from the declaration, and in
; the WEAK run an 8-byte type fits in 8 bytes, so the call gets align 8.
define i1 @malloc_8_mask_7() {
; CHECK-LABEL: define i1 @malloc_8_mask_7() {
; CHECK-NEXT:    ret i1 true
;
  %p = call ptr @malloc(i64 8)
  %i = ptrtoint ptr %p to i64
  %r = and i64 %i, 7
  %z = icmp eq i64 %r, 0
  ret i1 %z
}

; The WEAK run adds align 2: only char and short fit in 3 bytes, so 4 is not
; guaranteed. The STRONG run adds nothing, the declaration already has align 16.
define ptr @malloc_3() {
; STRONG-LABEL: define ptr @malloc_3() {
; STRONG-NEXT:    [[P:%.*]] = call dereferenceable_or_null(3) ptr @malloc(i64 3)
; STRONG-NEXT:    ret ptr [[P]]
