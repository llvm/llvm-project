; WEAK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @malloc(i64 3)
  ret ptr %p
}

; Larger than any scalar type considered: the WEAK run stops at align 8, the
; alignment of the largest integer type (i64).
define ptr @malloc_24() {
; STRONG-LABEL: define ptr @malloc_24() {
; STRONG-NEXT:    [[P:%.*]] = call dereferenceable_or_null(24) ptr @malloc(i64 24)
; STRONG-NEXT:    ret ptr [[P]]
;
; WEAK-LABEL: define ptr @malloc_24() {
; WEAK-NEXT:    [[P:%.*]] = call align 8 dereferenceable_or_null(24) ptr @malloc(i64 24)
; WEAK-NEXT:    ret ptr [[P]]
;
  %p = call ptr @malloc(i64 24)
  ret ptr %p
}

; calloc(2, 4) allocates 8 bytes, so the WEAK run adds align 8.
define ptr @calloc_2x4() {
; STRONG-LABEL: define ptr @calloc_2x4() {
; STRONG-NEXT:    [[P:%.*]] = call dereferenceable_or_null(8) ptr @calloc(i64 2, i64 4)
; STRONG-NEXT:    ret ptr [[P]]
