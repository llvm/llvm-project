; An existing, stronger align must not be weakened: both runs keep align 16.
define ptr @malloc_8_already_aligned() {
; CHECK-LABEL: define ptr @malloc_8_already_aligned() {
; CHECK-NEXT:    [[P:%.*]] = call align 16 dereferenceable_or_null(8) ptr @malloc(i64 8)
; CHECK-NEXT:    ret ptr [[P]]
;
  %p = call align 16 ptr @malloc(i64 8)
  ret ptr %p
}
