;===----------------------------------------------------------------------===;
; Positive tests: C3 >= C1 << C2 and shift does not overflow.
;===----------------------------------------------------------------------===;

; Basic positive test: 20 >= 2 << 3 (16).
define i32 @test_umax_shl_basic(i32 %x) {
; CHECK-LABEL: @test_umax_shl_basic(
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[X:%.*]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[TMP1]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

; Boundary condition: C3 == C1 << C2 (16 == 2 << 3).
define i32 @test_umax_shl_exact_bound(i32 %x) {
; CHECK-LABEL: @test_umax_shl_exact_bound(
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[X:%.*]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[TMP1]], i32 16)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 16)
  ret i32 %outer
}

; Smaller bit-width (i8): 60 >= 5 << 3 (40).
define i8 @test_umax_shl_i8(i8 %x) {
; CHECK-LABEL: @test_umax_shl_i8(
; CHECK-NEXT:    [[TMP1:%.*]] = shl i8 [[X:%.*]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i8 @llvm.umax.i8(i8 [[TMP1]], i8 60)
; CHECK-NEXT:    ret i8 [[OUTER]]
;
  %inner = call i8 @llvm.umax.i8(i8 %x, i8 5)
  %shift = shl i8 %inner, 3
  %outer = call i8 @llvm.umax.i8(i8 %shift, i8 60)
  ret i8 %outer
}

; Commuted operands: verifies m_c_UMax on both inner and outer calls.
define i32 @test_umax_shl_commuted(i32 %x) {
; CHECK-LABEL: @test_umax_shl_commuted(
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[X:%.*]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[TMP1]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 2, i32 %x)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 20, i32 %shift)
  ret i32 %outer
}

; Vector splat test.
define <2 x i32> @test_umax_shl_vector(<2 x i32> %x) {
; CHECK-LABEL: @test_umax_shl_vector(
; CHECK-NEXT:    [[TMP1:%.*]] = shl <2 x i32> [[X:%.*]], splat (i32 3)
; CHECK-NEXT:    [[OUTER:%.*]] = call <2 x i32> @llvm.umax.v2i32(<2 x i32> [[TMP1]], <2 x i32> splat (i32 20))
; CHECK-NEXT:    ret <2 x i32> [[OUTER]]
;
  %inner = call <2 x i32> @llvm.umax.v2i32(<2 x i32> %x, <2 x i32> <i32 2, i32 2>)
  %shift = shl <2 x i32> %inner, <i32 3, i32 3>
  %outer = call <2 x i32> @llvm.umax.v2i32(<2 x i32> %shift, <2 x i32> <i32 20, i32 20>)
  ret <2 x i32> %outer
}

