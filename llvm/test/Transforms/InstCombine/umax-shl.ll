; CHECK-LABEL: @test_umax_shl_negative_smaller_c3(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 10)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 10)
  ret i32 %outer
}

; Unsigned overflow: 0x80000000 << 1 overflows 32-bit int: fold must NOT fire.
define i32 @test_umax_shl_overflow(i32 %x) {
; CHECK-LABEL: @test_umax_shl_overflow(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 -2147483648)
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 1
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 10)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2147483648)
  %shift = shl i32 %inner, 1
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 10)
  ret i32 %outer
}

; Shift amount >= bit-width (32 >= 32): undefined behavior, fold must NOT fire.
define i32 @test_umax_shl_shift_ge_bitwidth(i32 %x) {
; CHECK-LABEL: @test_umax_shl_shift_ge_bitwidth(
; CHECK-NEXT:    ret i32 poison
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 32
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

;===----------------------------------------------------------------------===;
; Multi-use tests: Only OneUse checks block the fold.
;===----------------------------------------------------------------------===;

; %inner has an extra user: fold must NOT fire.
define i32 @test_umax_shl_multiuse_inner(i32 %x, ptr %p) {
; CHECK-LABEL: @test_umax_shl_multiuse_inner(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
; CHECK-NEXT:    store i32 [[INNER]], ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  store i32 %inner, ptr %p, align 4
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

; %shift has an extra user: fold must NOT fire.
define i32 @test_umax_shl_multiuse_shift(i32 %x, ptr %p) {
; CHECK-LABEL: @test_umax_shl_multiuse_shift(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 3
; CHECK-NEXT:    store i32 [[SHIFT]], ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  store i32 %shift, ptr %p, align 4
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

