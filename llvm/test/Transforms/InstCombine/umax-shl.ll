; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; Positive test: 20 >= 2 << 3 (16), inner umax should be eliminated
define i32 @test_umax_shl_basic(i32 %x) {
; CHECK-LABEL: @test_umax_shl_basic(
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[X:%.*]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[TMP1]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

; Boundary test: C3 == C1 << C2 (16 == 2 << 3)
define i32 @test_umax_shl_exact_bound(i32 %x) {
; CHECK-LABEL: @test_umax_shl_exact_bound(
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[X:%.*]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[TMP1]], i32 16)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 16)
  ret i32 %outer
}

; Negative test: C3 < C1 << C2 (10 < 16), fold must NOT fire
define i32 @test_umax_shl_negative_smaller_c3(i32 %x) {
; CHECK-LABEL: @test_umax_shl_negative_smaller_c3(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 10)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 10)
  ret i32 %outer
}

; Negative test: Overflow in C1 << C2 (0x80000000 << 1 overflows), fold must NOT fire
define i32 @test_umax_shl_overflow(i32 %x) {
; CHECK-LABEL: @test_umax_shl_overflow(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 -2147483648)
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 1
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 10)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2147483648)
  %shift = shl i32 %inner, 1
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 10)
  ret i32 %outer
}

; Multi-use test: %inner has an extra user, fold must NOT fire to avoid extra shift instructions
define i32 @test_umax_shl_multiuse(i32 %x, ptr %p) {
; CHECK-LABEL: @test_umax_shl_multiuse(
; CHECK-NEXT:    [[INNER:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
; CHECK-NEXT:    store i32 [[INNER]], ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[SHIFT:%.*]] = shl i32 [[INNER]], 3
; CHECK-NEXT:    [[OUTER:%.*]] = call i32 @llvm.umax.i32(i32 [[SHIFT]], i32 20)
; CHECK-NEXT:    ret i32 [[OUTER]]
;
  %inner = call i32 @llvm.umax.i32(i32 %x, i32 2)
  store i32 %inner, ptr %p
  %shift = shl i32 %inner, 3
  %outer = call i32 @llvm.umax.i32(i32 %shift, i32 20)
  ret i32 %outer
}

