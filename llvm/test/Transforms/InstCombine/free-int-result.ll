; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=instcombine -S < %s | FileCheck %s

; Test elision of free functions that return an integer.

declare noalias ptr @my_alloc(ptr, i32) allockind("alloc,uninitialized") allocsize(1) "alloc-family"="my_alloc"
declare i32 @my_free(ptr, ptr allocptr) allockind("free") "alloc-family"="my_alloc"

; A used result of an elided free is replaced with 0.
define i32 @free_result_used(ptr %heap) {
; CHECK-LABEL: define i32 @free_result_used(
; CHECK-SAME: ptr [[HEAP:%.*]]) {
; CHECK-NEXT:    ret i32 0
;
  %p = call ptr @my_alloc(ptr %heap, i32 16)
  store i32 1, ptr %p, align 4
  %r = call i32 @my_free(ptr %heap, ptr %p)
  ret i32 %r
}

; A free of null is only removed if its result is unused.
define i32 @free_null(ptr %heap) {
; CHECK-LABEL: define i32 @free_null(
; CHECK-SAME: ptr [[HEAP:%.*]]) {
; CHECK-NEXT:    [[USED:%.*]] = call i32 @my_free(ptr [[HEAP]], ptr null)
; CHECK-NEXT:    ret i32 [[USED]]
;
  %unused = call i32 @my_free(ptr %heap, ptr null)
  %used = call i32 @my_free(ptr %heap, ptr null)
  ret i32 %used
}
