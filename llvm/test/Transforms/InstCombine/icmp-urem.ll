; The fold does not require the urem to have one use.

declare void @use_i32(i32)

define i1 @icmp_eq_urem_dividend_extra_use(i32 %x, i32 %y) {
; CHECK-LABEL: define i1 @icmp_eq_urem_dividend_extra_use(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[REM:%.*]] = urem i32 [[X]], [[Y]]
; CHECK-NEXT:    call void @use_i32(i32 [[REM]])
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[REM]], [[X]]
; CHECK-NEXT:    ret i1 [[CMP]]
;
  %rem = urem i32 %x, %y
  call void @use_i32(i32 %rem)
  %cmp = icmp eq i32 %rem, %x
  ret i1 %cmp
}

; Preserve the umax simplification after replacing the comparison.

declare i64 @llvm.umax.i64(i64, i64)

define i64 @icmp_eq_urem_dividend_umax(i64 %x, i64 %y) {
; CHECK-LABEL: define i64 @icmp_eq_urem_dividend_umax(
; CHECK-SAME: i64 [[X:%.*]], i64 [[Y:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[REM:%.*]] = urem i64 [[X]], [[Y]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i64 [[X]], [[REM]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[EXIT:.*]], label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[SUB:%.*]] = sub nuw i64 [[X]], [[REM]]
; CHECK-NEXT:    ret i64 [[SUB]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 0
;
entry:
  %rem = urem i64 %x, %y
  %sub = sub nuw i64 %x, %rem
  %cmp = icmp eq i64 %x, %rem
  br i1 %cmp, label %exit, label %body

body:
  %umax = call i64 @llvm.umax.i64(i64 %sub, i64 1)
  ret i64 %umax

exit:
  ret i64 0
}

