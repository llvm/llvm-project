; Both incoming edges imply the compare is false. The test->merge edge is only
; taken when (or %left, %right) == 0, i.e. both are zero.
define i1 @src_or_is_zero(i1 %cond, i64 %left, i64 %right) {
; CHECK-LABEL: define i1 @src_or_is_zero(
; CHECK-NOT: icmp sgt
; CHECK: ret i1 false
;
entry:
  br i1 %cond, label %test, label %merge

test:
  %bits = or i64 %left, %right
  %both_zero = icmp eq i64 %bits, 0
  br i1 %both_zero, label %merge, label %exit

merge:
  %value = phi i64 [ %left, %entry ], [ %right, %test ]
  %cmp = icmp sgt i64 %value, %left
  br label %exit

exit:
  %result = phi i1 [ false, %test ], [ %cmp, %merge ]
  ret i1 %result
}

; Same edge facts as above, but for smin: the test->merge edge implies
; %right is zero, so smin folds to zero on both edges.
define i32 @smin_via_or_is_zero(i1 %cond, i32 %left, i32 %right) {
; CHECK-LABEL: define i32 @smin_via_or_is_zero(
; CHECK-NOT: llvm.smin
