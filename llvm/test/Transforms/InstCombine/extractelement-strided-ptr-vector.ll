  %v1 = insertelement <4 x ptr> %v0, ptr %g1, i64 1
  %v2 = insertelement <4 x ptr> %v1, ptr %g2, i64 2
  %v3 = insertelement <4 x ptr> %v2, ptr %g3, i64 3
