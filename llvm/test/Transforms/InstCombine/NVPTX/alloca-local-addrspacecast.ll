; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=instcombine -S %s | FileCheck %s

target triple = "nvptx64-nvidia-cuda"

@table = private unnamed_addr constant [8 x i32] [i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8], align 4

; The alloca and the global share the generic pointer type. The cast to
; local memory requires the stack copy.
define i32 @load_local_copy(i64 %index) {
; CHECK-LABEL: define i32 @load_local_copy(
; CHECK-SAME: i64 [[INDEX:%.*]]) {
; CHECK-NEXT:    [[ELEMENT:%.*]] = getelementptr inbounds [4 x i8], ptr @table, i64 [[INDEX]]
; CHECK-NEXT:    [[LOCAL:%.*]] = addrspacecast ptr [[ELEMENT]] to ptr addrspace(5)
; CHECK-NEXT:    [[VALUE:%.*]] = load i32, ptr addrspace(5) [[LOCAL]], align 4
; CHECK-NEXT:    ret i32 [[VALUE]]
;
  %buffer = alloca [8 x i32], align 4
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %buffer, ptr align 4 @table, i64 32, i1 false)
  %element = getelementptr inbounds [8 x i32], ptr %buffer, i64 0, i64 %index
  %local = addrspacecast ptr %element to ptr addrspace(5)
  %value = load i32, ptr addrspace(5) %local, align 4
  ret i32 %value
}

define i32 @load_generic_copy(i64 %index) {
; CHECK-LABEL: define i32 @load_generic_copy(
; CHECK-SAME: i64 [[INDEX:%.*]]) {
; CHECK-NEXT:    [[ELEMENT:%.*]] = getelementptr inbounds [4 x i8], ptr @table, i64 [[INDEX]]
; CHECK-NEXT:    [[VALUE:%.*]] = load i32, ptr [[ELEMENT]], align 4
; CHECK-NEXT:    ret i32 [[VALUE]]
;
  %buffer = alloca [8 x i32], align 4
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %buffer, ptr align 4 @table, i64 32, i1 false)
  %element = getelementptr inbounds [8 x i32], ptr %buffer, i64 0, i64 %index
  %value = load i32, ptr %element, align 4
  ret i32 %value
}
