declare i32 @memcmp(ptr addrspace(1), ptr addrspace(1), i64)
declare i32 @sprintf(ptr addrspace(1), ptr addrspace(1), ...)
declare i32 @fprintf(ptr addrspace(1), ptr addrspace(1), ...)
declare i32 @printf(ptr addrspace(1), ...)
declare i32 @fputs(ptr addrspace(1), ptr addrspace(1))
declare ptr addrspace(1) @__strcpy_chk(ptr addrspace(1), ptr addrspace(2), i64)
declare ptr addrspace(1) @__stpcpy_chk(ptr addrspace(1), ptr addrspace(2), i64)
declare ptr addrspace(1) @__strncpy_chk(ptr addrspace(1), ptr addrspace(2), i64, i64)
