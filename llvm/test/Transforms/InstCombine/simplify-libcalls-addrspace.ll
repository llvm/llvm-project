declare i64 @__strlcat_chk(ptr addrspace(1), ptr addrspace(2), i64, i64)
declare i32 @__snprintf_chk(ptr addrspace(1), i64, i32, i64, ptr addrspace(2), ...)
declare i32 @__sprintf_chk(ptr addrspace(1), i32, i64, ptr addrspace(1), ...)
