; CHECK-NEXT:    [[STRLEN:%.*]] = call i64 @strlen(ptr addrspace(1) noundef [[B]])
; CHECK-NEXT:    [[STRNCMP:%.*]] = call i32 @strncmp(ptr addrspace(1) [[A]], ptr addrspace(1) [[B]], i64 [[STRLEN]])
