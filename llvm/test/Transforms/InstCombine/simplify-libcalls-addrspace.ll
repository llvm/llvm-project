define ptr addrspace(1) @strchr_to_strlen(ptr addrspace(1) %s) {
; CHECK-LABEL: define ptr addrspace(1) @strchr_to_strlen(
; CHECK-SAME: ptr addrspace(1) [[S:%.*]]) {
; CHECK-NEXT:    [[STRLEN:%.*]] = call i64 @strlen(ptr addrspace(1) noundef [[S]])
; CHECK-NEXT:    [[STRCHR:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[S]], i64 [[STRLEN]]
; CHECK-NEXT:    ret ptr addrspace(1) [[STRCHR]]
;
  %r = call ptr addrspace(1) @strchr(ptr addrspace(1) %s, i32 0)
  ret ptr addrspace(1) %r
}

