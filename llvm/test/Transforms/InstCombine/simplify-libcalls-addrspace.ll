; RUN: opt -passes=instcombine -S < %s | FileCheck %s

; Test that library calls emitted by SimplifyLibCalls use the address spaces of
; the pointers they are passed.

target datalayout = "e-p1:64:64-p2:64:64"
target triple = "x86_64-unknown-linux-gnu"

@str = private addrspace(1) constant [4 x i8] c"abc\00"
@fmt_s = private addrspace(1) constant [3 x i8] c"%s\00"
@fmt_s_nl = private addrspace(1) constant [4 x i8] c"%s\0A\00"

