; CHECK:       [[END]]:
; CHECK-NEXT:    [[R:%.*]] = phi i1 [ false, [[TMP0:%.*]] ], [ [[CMP2]], %[[RHS]] ]
; CHECK-NEXT:    ret i1 [[R]]
;
  %call1 = call i32 @memcmp(ptr %x, ptr %y, i64 1)
  %cmp1 = icmp eq i32 %call1, 0
  br i1 %cmp1, label %rhs, label %end

rhs:
  %call2 = call i32 @memcmp(ptr %y, ptr %x, i64 2)
