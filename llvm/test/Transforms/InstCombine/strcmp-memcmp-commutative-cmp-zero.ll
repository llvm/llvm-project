; CHECK-NEXT:    [[CALL1:%.*]] = call i32 @strcmp(ptr noundef nonnull dereferenceable(1) [[X]], ptr noundef nonnull dereferenceable(1) [[Y]])
; CHECK-NEXT:    ret i1 true
;
