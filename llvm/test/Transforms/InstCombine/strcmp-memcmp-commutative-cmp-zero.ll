; CHECK-NEXT:    br i1 [[CMP1]], label %[[RHS:.*]], label %[[END:.*]]
; CHECK:       [[RHS]]:
; CHECK-NEXT:    [[CALL2:%.*]] = call i32 @memcmp(ptr noundef nonnull dereferenceable(2) [[Y]], ptr noundef nonnull dereferenceable(2) [[X]], i64 2)
; CHECK-NEXT:    [[CMP2:%.*]] = icmp eq i32 [[CALL2]], 0
