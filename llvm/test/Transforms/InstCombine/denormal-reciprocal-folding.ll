; 1 / 2^127 is exactly representable as a subnormal and survives IEEE input
; and output handling.
define float @ieee(float %x) denormal_fpenv(float: ieee) {
; CHECK-LABEL: define float @ieee(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = fmul arcp float [[X]], f0x00400000
; CHECK-NEXT:    ret float [[R]]
;
  %r = fdiv arcp float %x, f0x7F000000
  ret float %r
}

; Flushing the reciprocal to zero would turn (2^127 / 2^127) = 1 into 0.
define float @output_ftz(float %x) denormal_fpenv(float: preservesign|ieee) {
; CHECK-LABEL: define float @output_ftz(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = fdiv arcp float [[X]], f0x7F000000
; CHECK-NEXT:    ret float [[R]]
;
  %r = fdiv arcp float %x, f0x7F000000
  ret float %r
}

; IEEE output handling preserves the reciprocal, but the replacement multiply
; would flush it as an input. The original divisor is normal and does not flush.
define float @input_ftz(float %x) denormal_fpenv(float: ieee|preservesign) {
; CHECK-LABEL: define float @input_ftz(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = fdiv arcp float [[X]], f0x7F000000
; CHECK-NEXT:    ret float [[R]]
;
  %r = fdiv arcp float %x, f0x7F000000
  ret float %r
}

