; The product is in [1, 128], even when it does not fit signed i8.
define i8 @negative_mul_i8(i8 %a, i8 %b) {
; CHECK-LABEL: @negative_mul_i8(
; CHECK-NEXT:    [[X:%.*]] = or i8 [[A:%.*]], -16
; CHECK-NEXT:    [[Y:%.*]] = or i8 [[B:%.*]], -8
; CHECK-NEXT:    [[MUL:%.*]] = mul i8 [[X]], [[Y]]
; CHECK-NEXT:    [[R:%.*]] = and i8 [[MUL]], -128
; CHECK-NEXT:    ret i8 [[R]]
;
  %x = or i8 %a, -16
  %y = or i8 %b, -8
  %mul = mul i8 %x, %y
  %r = and i8 %mul, -128
  ret i8 %r
}

; The product is in [-112, -1], so all bits above bit six are one.
define i8 @mixed_sign_mul_i8(i8 %a, i8 %b) {
; CHECK-LABEL: @mixed_sign_mul_i8(
; CHECK-NEXT:    ret i8 -1
;
  %x = or i8 %a, -16
  %t = and i8 %b, 7
  %y = or i8 %t, 1
  %mul = mul i8 %x, %y
  %r = or i8 %mul, 127
  ret i8 %r
}

