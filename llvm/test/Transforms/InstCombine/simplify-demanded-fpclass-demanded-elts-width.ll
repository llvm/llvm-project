; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=instcombine < %s | FileCheck %s

; The demanded-elements mask given to an operand must be built from the
; operand's type, not forwarded from the result. A narrower result mask reaching
; a wider constant-vector operand indexes DemandedElts out of range and asserts
; in APInt. The first three cases crashed before the fix; the rest cover the
; other lane-count-changing sites. All fold identically with and without it.

; extractelement: 1-bit scalar-entry mask reaching a wider vector operand.
; %v has two uses so the extracts aren't scalarized before the fpclass folds.
define float @extractelement_scalar_use_of_constant_vector(<2 x float> %x, float %y) {
; CHECK-LABEL: define float @extractelement_scalar_use_of_constant_vector(
; CHECK-SAME: <2 x float> [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = fadd <2 x float> [[X]], <float 1.000000e+00, float 2.000000e+00>
; CHECK-NEXT:    [[E0:%.*]] = extractelement <2 x float> [[V]], i64 0
; CHECK-NEXT:    [[E1:%.*]] = extractelement <2 x float> [[V]], i64 1
; CHECK-NEXT:    [[M:%.*]] = fmul float [[E0]], [[Y]]
; CHECK-NEXT:    [[M2:%.*]] = fmul float [[M]], [[E1]]
; CHECK-NEXT:    ret float [[M2]]
;
  %v = fadd <2 x float> %x, <float 1.0, float 2.0>
  %e0 = extractelement <2 x float> %v, i32 0
  %e1 = extractelement <2 x float> %v, i32 1
  %m = fmul float %e0, %y
  %m2 = fmul float %m, %e1
  ret float %m2
}

; shufflevector, narrowing: 2-lane result feeding a 4-lane operand.
define <2 x float> @shufflevector_narrowing_constant_vector(<4 x float> %x, <2 x float> %y) {
; CHECK-LABEL: define <2 x float> @shufflevector_narrowing_constant_vector(
; CHECK-SAME: <4 x float> [[X:%.*]], <2 x float> [[Y:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = fadd <4 x float> [[X]], <float 1.000000e+00, float poison, float poison, float 4.000000e+00>
; CHECK-NEXT:    [[S:%.*]] = shufflevector <4 x float> [[V]], <4 x float> poison, <2 x i32> <i32 0, i32 3>
; CHECK-NEXT:    [[M:%.*]] = fmul <2 x float> [[S]], [[Y]]
; CHECK-NEXT:    ret <2 x float> [[M]]
;
  %v = fadd <4 x float> %x, <float 1.0, float 2.0, float 3.0, float 4.0>
  %s = shufflevector <4 x float> %v, <4 x float> %v, <2 x i32> <i32 0, i32 3>
  %m = fmul <2 x float> %s, %y
  ret <2 x float> %m
}

; insertvalue: 1-bit aggregate-return mask reaching a <2 x float> element.
define nofpclass(nan) { <2 x float> } @insertvalue_vector_element(<2 x float> %x, { <2 x float> } %in) {
; CHECK-LABEL: define nofpclass(nan) { <2 x float> } @insertvalue_vector_element(
; CHECK-SAME: <2 x float> [[X:%.*]], { <2 x float> } [[IN:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = fadd nnan <2 x float> [[X]], <float 1.000000e+00, float 2.000000e+00>
; CHECK-NEXT:    [[AGG:%.*]] = insertvalue { <2 x float> } [[IN]], <2 x float> [[V]], 0
; CHECK-NEXT:    ret { <2 x float> } [[AGG]]
;
  %v = fadd <2 x float> %x, <float 1.0, float 2.0>
  %agg = insertvalue { <2 x float> } %in, <2 x float> %v, 0
  ret { <2 x float> } %agg
}

; shufflevector, widening: mask wider than the operand (mirror direction).
define <4 x float> @shufflevector_widening_constant_vector(<2 x float> %x, <4 x float> %y) {
; CHECK-LABEL: define <4 x float> @shufflevector_widening_constant_vector(
; CHECK-SAME: <2 x float> [[X:%.*]], <4 x float> [[Y:%.*]]) {
; CHECK-NEXT:    [[V:%.*]] = fadd <2 x float> [[X]], <float 1.000000e+00, float 2.000000e+00>
; CHECK-NEXT:    [[S:%.*]] = shufflevector <2 x float> [[V]], <2 x float> poison, <4 x i32> <i32 0, i32 1, i32 1, i32 0>
; CHECK-NEXT:    [[M:%.*]] = fmul <4 x float> [[S]], [[Y]]
; CHECK-NEXT:    ret <4 x float> [[M]]
;
  %v = fadd <2 x float> %x, <float 1.0, float 2.0>
  %s = shufflevector <2 x float> %v, <2 x float> %v, <4 x i32> <i32 0, i32 1, i32 1, i32 0>
  %m = fmul <4 x float> %s, %y
  ret <4 x float> %m
}

; insertelement: scalar inserted operand.
define <2 x float> @insertelement_scalar_operand(<2 x float> %x, float %s, <2 x float> %y) {
; CHECK-LABEL: define <2 x float> @insertelement_scalar_operand(
; CHECK-SAME: <2 x float> [[X:%.*]], float [[S:%.*]], <2 x float> [[Y:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = fadd float [[S]], 1.000000e+00
; CHECK-NEXT:    [[V:%.*]] = insertelement <2 x float> [[X]], float [[A]], i64 0
; CHECK-NEXT:    [[M:%.*]] = fmul <2 x float> [[V]], [[Y]]
; CHECK-NEXT:    ret <2 x float> [[M]]
;
  %a = fadd float %s, 1.0
  %v = insertelement <2 x float> %x, float %a, i32 0
  %m = fmul <2 x float> %v, %y
  ret <2 x float> %m
}

; extractvalue: vector out of an aggregate.
define <2 x float> @extractvalue_vector_from_aggregate({ <2 x float> } %agg, <2 x float> %y) {
; CHECK-LABEL: define <2 x float> @extractvalue_vector_from_aggregate(
; CHECK-SAME: { <2 x float> } [[AGG:%.*]], <2 x float> [[Y:%.*]]) {
; CHECK-NEXT:    [[E:%.*]] = extractvalue { <2 x float> } [[AGG]], 0
; CHECK-NEXT:    [[M:%.*]] = fmul <2 x float> [[E]], [[Y]]
; CHECK-NEXT:    ret <2 x float> [[M]]
;
  %e = extractvalue { <2 x float> } %agg, 0
  %m = fmul <2 x float> %e, %y
  ret <2 x float> %m
}
