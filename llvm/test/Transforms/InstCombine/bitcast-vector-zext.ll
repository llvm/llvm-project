; Find the scalar through a shuffle that widens the vector with zeros.
define i64 @shuffle_first(i16 %x) {
; LE-LABEL: @shuffle_first(
; LE-NEXT:    [[R:%.*]] = zext i16 [[X:%.*]] to i64
; LE-NEXT:    ret i64 [[R]]
;
; BE-LABEL: @shuffle_first(
; BE-NEXT:    [[V:%.*]] = insertelement <2 x i16> poison, i16 [[X:%.*]], i64 0
; BE-NEXT:    [[S:%.*]] = shufflevector <2 x i16> [[V]], <2 x i16> <i16 0, i16 poison>, <4 x i32> <i32 0, i32 2, i32 2, i32 2>
; BE-NEXT:    [[R:%.*]] = bitcast <4 x i16> [[S]] to i64
; BE-NEXT:    ret i64 [[R]]
;
  %v = insertelement <2 x i16> zeroinitializer, i16 %x, i32 0
  %s = shufflevector <2 x i16> %v, <2 x i16> zeroinitializer, <4 x i32> <i32 0, i32 2, i32 2, i32 2>
  %r = bitcast <4 x i16> %s to i64
  ret i64 %r
}

