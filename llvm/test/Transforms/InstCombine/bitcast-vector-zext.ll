define i64 @multiuse(i32 %x) {
; LE-LABEL: @multiuse(
; LE-NEXT:    [[V:%.*]] = insertelement <2 x i32> <i32 poison, i32 0>, i32 [[X:%.*]], i64 0
; LE-NEXT:    call void @use(<2 x i32> [[V]])
; LE-NEXT:    [[R:%.*]] = zext i32 [[X]] to i64
; LE-NEXT:    ret i64 [[R]]
;
; BE-LABEL: @multiuse(
; BE-NEXT:    [[V:%.*]] = insertelement <2 x i32> <i32 poison, i32 0>, i32 [[X:%.*]], i64 0
; BE-NEXT:    call void @use(<2 x i32> [[V]])
; BE-NEXT:    [[R:%.*]] = bitcast <2 x i32> [[V]] to i64
; BE-NEXT:    ret i64 [[R]]
;
  %v = insertelement <2 x i32> zeroinitializer, i32 %x, i32 0
  call void @use(<2 x i32> %v)
  %r = bitcast <2 x i32> %v to i64
  ret i64 %r
}

