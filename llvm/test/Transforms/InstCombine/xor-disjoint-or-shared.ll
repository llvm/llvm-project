; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

; Tests for reassociating xor X, (or disjoint P, C) --> xor (xor X, P), C
; so that a shared X ^ P is exposed.

declare void @use(i32)

; Positive: the example from the issue. x ^ phase is shared by all three
; results once the disjoint ors are reassociated.
define { i32, i32, i32 } @shared_xor(i32 %x, i32 %y) {
; CHECK-LABEL: @shared_xor(
; CHECK-NEXT:    [[PHASE:%.*]] = and i32 [[Y:%.*]], 48
; CHECK-NEXT:    [[BASE:%.*]] = xor i32 [[X:%.*]], [[PHASE]]
; CHECK-NEXT:    [[V4:%.*]] = xor i32 [[BASE]], 4
; CHECK-NEXT:    [[V8:%.*]] = xor i32 [[BASE]], 8
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { i32, i32, i32 } poison, i32 [[BASE]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { i32, i32, i32 } [[R0]], i32 [[V4]], 1
; CHECK-NEXT:    [[R2:%.*]] = insertvalue { i32, i32, i32 } [[R1]], i32 [[V8]], 2
; CHECK-NEXT:    ret { i32, i32, i32 } [[R2]]
;
  %phase = and i32 %y, 48
  %base = xor i32 %x, %phase
  %p4 = or disjoint i32 %phase, 4
  %v4 = xor i32 %x, %p4
  %p8 = or disjoint i32 %phase, 8
  %v8 = xor i32 %x, %p8
  %r0 = insertvalue { i32, i32, i32 } poison, i32 %base, 0
  %r1 = insertvalue { i32, i32, i32 } %r0, i32 %v4, 1
  %r2 = insertvalue { i32, i32, i32 } %r1, i32 %v8, 2
  ret { i32, i32, i32 } %r2
}

; Positive: operands of the outer xor commuted.
define { i32, i32 } @shared_xor_commuted(i32 %x, i32 %y) {
; CHECK-LABEL: @shared_xor_commuted(
; CHECK-NEXT:    [[PHASE:%.*]] = and i32 [[Y:%.*]], 48
; CHECK-NEXT:    [[BASE:%.*]] = xor i32 [[PHASE]], [[X:%.*]]
; CHECK-NEXT:    [[V4:%.*]] = xor i32 [[BASE]], 4
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { i32, i32 } poison, i32 [[BASE]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { i32, i32 } [[R0]], i32 [[V4]], 1
; CHECK-NEXT:    ret { i32, i32 } [[R1]]
;
  %phase = and i32 %y, 48
  %base = xor i32 %phase, %x
  %p4 = or disjoint i32 %phase, 4
  %v4 = xor i32 %p4, %x
  %r0 = insertvalue { i32, i32 } poison, i32 %base, 0
  %r1 = insertvalue { i32, i32 } %r0, i32 %v4, 1
  ret { i32, i32 } %r1
}

; Positive: vector with a splat constant.
define { <2 x i32>, <2 x i32> } @shared_xor_vec(<2 x i32> %x, <2 x i32> %y) {
; CHECK-LABEL: @shared_xor_vec(
; CHECK-NEXT:    [[PHASE:%.*]] = and <2 x i32> [[Y:%.*]], splat (i32 48)
; CHECK-NEXT:    [[BASE:%.*]] = xor <2 x i32> [[X:%.*]], [[PHASE]]
; CHECK-NEXT:    [[V4:%.*]] = xor <2 x i32> [[BASE]], splat (i32 4)
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { <2 x i32>, <2 x i32> } poison, <2 x i32> [[BASE]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { <2 x i32>, <2 x i32> } [[R0]], <2 x i32> [[V4]], 1
; CHECK-NEXT:    ret { <2 x i32>, <2 x i32> } [[R1]]
;
  %phase = and <2 x i32> %y, splat (i32 48)
  %base = xor <2 x i32> %x, %phase
  %p4 = or disjoint <2 x i32> %phase, splat (i32 4)
  %v4 = xor <2 x i32> %x, %p4
  %r0 = insertvalue { <2 x i32>, <2 x i32> } poison, <2 x i32> %base, 0
  %r1 = insertvalue { <2 x i32>, <2 x i32> } %r0, <2 x i32> %v4, 1
  ret { <2 x i32>, <2 x i32> } %r1
}

; Negative: the or has another use, so it can't be removed and the
; rewrite would add an instruction.
define { i32, i32 } @shared_xor_multiuse_or(i32 %x, i32 %y) {
; CHECK-LABEL: @shared_xor_multiuse_or(
; CHECK-NEXT:    [[PHASE:%.*]] = and i32 [[Y:%.*]], 48
; CHECK-NEXT:    [[BASE:%.*]] = xor i32 [[X:%.*]], [[PHASE]]
; CHECK-NEXT:    [[P4:%.*]] = or disjoint i32 [[PHASE]], 4
; CHECK-NEXT:    call void @use(i32 [[P4]])
; CHECK-NEXT:    [[V4:%.*]] = xor i32 [[X]], [[P4]]
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { i32, i32 } poison, i32 [[BASE]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { i32, i32 } [[R0]], i32 [[V4]], 1
; CHECK-NEXT:    ret { i32, i32 } [[R1]]
;
  %phase = and i32 %y, 48
  %base = xor i32 %x, %phase
  %p4 = or disjoint i32 %phase, 4
  call void @use(i32 %p4)
  %v4 = xor i32 %x, %p4
  %r0 = insertvalue { i32, i32 } poison, i32 %base, 0
  %r1 = insertvalue { i32, i32 } %r0, i32 %v4, 1
  ret { i32, i32 } %r1
}

; Negative: the or is not known disjoint (%a may already have bit 2 set),
; so or is not equivalent to xor.
define { i32, i32 } @shared_xor_not_disjoint(i32 %x, i32 %a) {
; CHECK-LABEL: @shared_xor_not_disjoint(
; CHECK-NEXT:    [[BASE:%.*]] = xor i32 [[X:%.*]], [[A:%.*]]
; CHECK-NEXT:    [[P4:%.*]] = or i32 [[A]], 4
; CHECK-NEXT:    [[V4:%.*]] = xor i32 [[X]], [[P4]]
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { i32, i32 } poison, i32 [[BASE]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { i32, i32 } [[R0]], i32 [[V4]], 1
; CHECK-NEXT:    ret { i32, i32 } [[R1]]
;
  %base = xor i32 %x, %a
  %p4 = or i32 %a, 4
  %v4 = xor i32 %x, %p4
  %r0 = insertvalue { i32, i32 } poison, i32 %base, 0
  %r1 = insertvalue { i32, i32 } %r0, i32 %v4, 1
  ret { i32, i32 } %r1
}

; Negative: the or operand is not a constant.
define { i32, i32 } @shared_xor_or_not_constant(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: @shared_xor_or_not_constant(
; CHECK-NEXT:    [[PHASE:%.*]] = and i32 [[Y:%.*]], 48
; CHECK-NEXT:    [[ZLOW:%.*]] = and i32 [[Z:%.*]], 3
; CHECK-NEXT:    [[BASE:%.*]] = xor i32 [[X:%.*]], [[PHASE]]
; CHECK-NEXT:    [[P:%.*]] = or disjoint i32 [[PHASE]], [[ZLOW]]
; CHECK-NEXT:    [[V:%.*]] = xor i32 [[X]], [[P]]
; CHECK-NEXT:    [[R0:%.*]] = insertvalue { i32, i32 } poison, i32 [[BASE]], 0
; CHECK-NEXT:    [[R1:%.*]] = insertvalue { i32, i32 } [[R0]], i32 [[V]], 1
; CHECK-NEXT:    ret { i32, i32 } [[R1]]
;
  %phase = and i32 %y, 48
  %zlow = and i32 %z, 3
  %base = xor i32 %x, %phase
  %p = or disjoint i32 %phase, %zlow
  %v = xor i32 %x, %p
  %r0 = insertvalue { i32, i32 } poison, i32 %base, 0
  %r1 = insertvalue { i32, i32 } %r0, i32 %v, 1
  ret { i32, i32 } %r1
}

; No shared xor exists. Documents what the fold does when there is nothing
; to share (it reassociates if it canonicalizes unconditionally, and leaves
; the code alone if it only fires when x ^ phase already exists).
define i32 @no_shared_xor(i32 %x, i32 %y) {
; CHECK-LABEL: @no_shared_xor(
; CHECK-NEXT:    [[PHASE:%.*]] = and i32 [[Y:%.*]], 48
; CHECK-NEXT:    [[P4:%.*]] = or disjoint i32 [[PHASE]], 4
; CHECK-NEXT:    [[V4:%.*]] = xor i32 [[X:%.*]], [[P4]]
; CHECK-NEXT:    ret i32 [[V4]]
;
  %phase = and i32 %y, 48
  %p4 = or disjoint i32 %phase, 4
  %v4 = xor i32 %x, %p4
  ret i32 %v4
}
