; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instcombine -S | FileCheck %s

declare void @use(i1)
declare void @use_i8(i8)

; Issue #230800: only -1 is in {-1,0,1} with bit 7 and bit 0 set.
define i1 @range_and_mask_single(i8 %x) {
; CHECK-LABEL: @range_and_mask_single(
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %offset = add i8 %x, 1
  %in_range = icmp ult i8 %offset, 3
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %in_range, %bits
  ret i1 %both
}

; Operands commuted.
define i1 @range_and_mask_commuted(i8 %x) {
; CHECK-LABEL: @range_and_mask_commuted(
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %offset = add i8 %x, 1
  %in_range = icmp ult i8 %offset, 3
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %bits, %in_range
  ret i1 %both
}

; Logical and must be handled too (poison-safe).
define i1 @range_and_mask_logical(i8 %x) {
; CHECK-LABEL: @range_and_mask_logical(
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %offset = add i8 %x, 1
  %in_range = icmp ult i8 %offset, 3
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = select i1 %in_range, i1 %bits, i1 false
  ret i1 %both
}

; Logical and commuted.
define i1 @range_and_mask_logical_commuted(i8 %x) {
; CHECK-LABEL: @range_and_mask_logical_commuted(
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %offset = add i8 %x, 1
  %in_range = icmp ult i8 %offset, 3
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = select i1 %bits, i1 %in_range, i1 false
  ret i1 %both
}

; nsw on the add does not matter.
define i1 @range_and_mask_nsw(i8 %x) {
; CHECK-LABEL: @range_and_mask_nsw(
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %offset = add nsw i8 %x, 1
  %in_range = icmp ult i8 %offset, 3
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %in_range, %bits
  ret i1 %both
}

; No offset: x in {0,1,2} can never have bit 7 set, so the result is false.
define i1 @range_and_mask_empty(i8 %x) {
; CHECK-LABEL: @range_and_mask_empty(
; CHECK-NEXT:    ret i1 false
;
  %in_range = icmp ult i8 %x, 3
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %in_range, %bits
  ret i1 %both
}

