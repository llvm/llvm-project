; Range check is a negated-power-of-2 mask: (x & -2) == -2 means x in {-2, -1}.
; Combined with (x & 0x81) == 0x81, only -1 satisfies both.
define i1 @range_neg_pow2_and_mask_single(i8 %x) {
; CHECK-LABEL: @range_neg_pow2_and_mask_single(
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X:%.*]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %range_masked = and i8 %x, -2
  %range = icmp eq i8 %range_masked, -2
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %range, %bits
  ret i1 %both
}

; Range check is a negated-power-of-2 mask: (x & -2) == 0 means x in {0, 1}.
; Combined with (x & 0x81) == 0x81, intersection is empty (false).
define i1 @range_neg_pow2_and_mask_empty(i8 %x) {
; CHECK-LABEL: @range_neg_pow2_and_mask_empty(
; CHECK-NEXT:    ret i1 false
;
  %range_masked = and i8 %x, -2
  %range = icmp eq i8 %range_masked, 0
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %range, %bits
  ret i1 %both
}

; Extra use on the negated-power-of-2 masked range check:
; matchExactRangeCheck requires m_OneUse for (x & NegPow2), so this does not fold.
define i1 @range_neg_pow2_and_mask_multi_use(i8 %x) {
; CHECK-LABEL: @range_neg_pow2_and_mask_multi_use(
; CHECK-NEXT:    [[RANGE_MASKED:%.*]] = and i8 [[X:%.*]], -2
; CHECK-NEXT:    call void @use_i8(i8 [[RANGE_MASKED]])
; CHECK-NEXT:    [[BOTH:%.*]] = icmp eq i8 [[X]], -1
; CHECK-NEXT:    ret i1 [[BOTH]]
;
  %range_masked = and i8 %x, -2
  call void @use_i8(i8 %range_masked)
  %range = icmp eq i8 %range_masked, -2
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %range, %bits
  ret i1 %both
}

; Candidate 130 is in Loose [129, 256), but does not satisfy (130 & 0x81) == 0x81.
; Regression test: existing constant-equality fold handles this case.
define i1 @range_and_mask_candidate_fails_mask(i8 %x) {
; CHECK-LABEL: @range_and_mask_candidate_fails_mask(
; CHECK-NEXT:    ret i1 false
;
  %offset = add i8 %x, -130
  %in_range = icmp ult i8 %offset, 1
  %masked = and i8 %x, -127
  %bits = icmp eq i8 %masked, -127
  %both = and i1 %in_range, %bits
  ret i1 %both
}

