; Test that sext is converted to zext for conditional-increment induction
; variables where the IV starts at 0, only increments by 1 with nsw, and
; is provably non-negative.

; A while loop with conditional increment.
; %i.07 starts at 0, conditionally increments by 1 (nsw), so it's always
; non-negative. The sext should become zext nneg.
define void @conditional_incr_sext(ptr noundef writeonly %out, i32 noundef %max_out, ptr noundef readonly %list) {
; CHECK-LABEL: @conditional_incr_sext(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[TMP0:%.*]] = load ptr, ptr [[LIST:%.*]], align 8
; CHECK-NEXT:    [[TOBOOL_NOT6:%.*]] = icmp eq ptr [[TMP0]], null
; CHECK-NEXT:    br i1 [[TOBOOL_NOT6]], label [[WHILE_END:%.*]], label [[WHILE_BODY:%.*]]
; CHECK:       while.body:
; CHECK-NEXT:    [[TMP1:%.*]] = phi ptr [ [[TMP2:%.*]], [[CLEANUP:%.*]] ], [ [[TMP0]], [[ENTRY:%.*]] ]
; CHECK-NEXT:    [[INCDEC_PTR8_PN:%.*]] = phi ptr [ [[INCDEC_PTR8:%.*]], [[CLEANUP]] ], [ [[LIST]], [[ENTRY]] ]
; CHECK-NEXT:    [[I_07:%.*]] = phi i32 [ [[I_2:%.*]], [[CLEANUP]] ], [ 0, [[ENTRY]] ]
; CHECK-NEXT:    [[INCDEC_PTR8]] = getelementptr inbounds nuw i8, ptr [[INCDEC_PTR8_PN]], i64 8
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_07]], [[MAX_OUT:%.*]]
; CHECK-NEXT:    br i1 [[CMP]], label [[IF_THEN:%.*]], label [[CLEANUP]]
; CHECK:       if.then:
; CHECK-NEXT:    [[INC:%.*]] = add nuw nsw i32 [[I_07]], 1
; CHECK-NEXT:    [[IDXPROM:%.*]] = zext nneg i32 [[I_07]] to i64
; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[OUT:%.*]], i64 [[IDXPROM]]
; CHECK-NEXT:    store ptr [[TMP1]], ptr [[ARRAYIDX]], align 8
; CHECK-NEXT:    br label [[CLEANUP]]
; CHECK:       cleanup:
; CHECK-NEXT:    [[I_2]] = phi i32 [ [[I_07]], [[WHILE_BODY]] ], [ [[INC]], [[IF_THEN]] ]
; CHECK-NEXT:    [[TMP2]] = load ptr, ptr [[INCDEC_PTR8]], align 8
; CHECK-NEXT:    [[TOBOOL_NOT:%.*]] = icmp eq ptr [[TMP2]], null
; CHECK-NEXT:    br i1 [[TOBOOL_NOT]], label [[WHILE_END]], label [[WHILE_BODY]]
; CHECK:       while.end:
; CHECK-NEXT:    ret void
;
entry:
  %0 = load ptr, ptr %list, align 8
  %tobool.not6 = icmp eq ptr %0, null
  br i1 %tobool.not6, label %while.end, label %while.body

while.body:
  %1 = phi ptr [ %2, %cleanup ], [ %0, %entry ]
  %incdec.ptr8.pn = phi ptr [ %incdec.ptr8, %cleanup ], [ %list, %entry ]
  %i.07 = phi i32 [ %i.2, %cleanup ], [ 0, %entry ]
  %incdec.ptr8 = getelementptr inbounds nuw i8, ptr %incdec.ptr8.pn, i64 8
  %cmp = icmp slt i32 %i.07, %max_out
  br i1 %cmp, label %if.then, label %cleanup

if.then:
  %inc = add nsw i32 %i.07, 1
  %idxprom = sext i32 %i.07 to i64
  %arrayidx = getelementptr inbounds [8 x i8], ptr %out, i64 %idxprom
  store ptr %1, ptr %arrayidx, align 8
  br label %cleanup

cleanup:
  %i.2 = phi i32 [ %i.07, %while.body ], [ %inc, %if.then ]
  %2 = load ptr, ptr %incdec.ptr8, align 8
  %tobool.not = icmp eq ptr %2, null
  br i1 %tobool.not, label %while.end, label %while.body

while.end:
  ret void
}

