; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=loop-deletion < %s | FileCheck %s

; A token-like value cannot be used by a PHI node, so LCSSA form does not
; report it as live out of the loop. Deleting the loop would leave the use in
; %exit dangling.

declare void @f() convergent
declare token @llvm.experimental.convergence.anchor()

define i32 @live_out_token(i32 %n) {
; CHECK-LABEL: define i32 @live_out_token(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TOK:%.*]] = call token @llvm.experimental.convergence.anchor()
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp eq i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    call void @f() [ "convergencectrl"(token [[TOK]]) ]
; CHECK-NEXT:    ret i32 0
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %tok = call token @llvm.experimental.convergence.anchor()
  %iv.next = add nsw i32 %iv, 1
  %exitcond = icmp eq i32 %iv.next, %n
  br i1 %exitcond, label %exit, label %loop

exit:
  call void @f() [ "convergencectrl"(token %tok) ]
  ret i32 0
}

; The token is only used inside the loop, so the loop can still be deleted.

define i32 @token_used_in_loop(i32 %n) {
; CHECK-LABEL: define i32 @token_used_in_loop(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 0
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %tok = call token @llvm.experimental.convergence.anchor()
  %iv.next = add nsw i32 %iv, 1
  %exitcond = icmp eq i32 %iv.next, %n
  br i1 %exitcond, label %exit, label %loop

exit:
  ret i32 0
}

; The use is in an unreachable block, so the loop looks dead. Deleting it would
; set the operand of the convergencectrl bundle to a token poison, which no
; convergence control intrinsic produced.

define i32 @unreachable_token_use(i32 %n) {
; CHECK-LABEL: define i32 @unreachable_token_use(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TOK:%.*]] = call token @llvm.experimental.convergence.anchor()
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp eq i32 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EXITCOND]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 0
; CHECK:       [[DEAD:.*:]]
; CHECK-NEXT:    call void @f() [ "convergencectrl"(token [[TOK]]) ]
; CHECK-NEXT:    ret i32 0
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %tok = call token @llvm.experimental.convergence.anchor()
  %iv.next = add nsw i32 %iv, 1
  %exitcond = icmp eq i32 %iv.next, %n
  br i1 %exitcond, label %exit, label %loop

exit:
  ret i32 0

dead:
  call void @f() [ "convergencectrl"(token %tok) ]
  ret i32 0
}
