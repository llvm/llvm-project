; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=loop-deletion -S | FileCheck %s

; Each loop has an invariant exit condition, so SCEV cannot bound its trip
; count and deletion depends on assuming that the loop is finite.

declare void @llvm.assume(i1)

; Not finite by assumption, so the loop must stay.
define void @unknown_tripcount_no_assumption(i32 %a, i32 %b) {
; CHECK-LABEL: define void @unknown_tripcount_no_assumption(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[FOR_COND:.*]]
; CHECK:       [[FOR_COND]]:
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[A]], [[B]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[FOR_BODY:.*]], label %[[FOR_END:.*]]
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    br label %[[FOR_COND]]
; CHECK:       [[FOR_END]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %for.cond
for.cond:
  %cmp = icmp slt i32 %a, %b
  br i1 %cmp, label %for.body, label %for.end
for.body:
  br label %for.cond
for.end:
  ret void
}

; willreturn makes the loop finite by assumption.
define void @unknown_tripcount_willreturn(i32 %a, i32 %b) willreturn {
; CHECK-LABEL: define void @unknown_tripcount_willreturn(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[FOR_END:.*]]
; CHECK:       [[FOR_END]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %for.cond
for.cond:
  %cmp = icmp slt i32 %a, %b
  br i1 %cmp, label %for.body, label %for.end
for.body:
  br label %for.cond
for.end:
  ret void
}

; llvm.assume is droppable, so it is not a side effect.
define void @unknown_tripcount_mustprogress_fn_assume(i32 %a, i32 %b) mustprogress {
; CHECK-LABEL: define void @unknown_tripcount_mustprogress_fn_assume(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[FOR_END:.*]]
; CHECK:       [[FOR_END]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %for.cond
for.cond:
  %cmp = icmp slt i32 %a, %b
  br i1 %cmp, label %for.body, label %for.end
for.body:
  call void @llvm.assume(i1 %cmp)
  br label %for.cond
for.end:
  ret void
}

; Same, with llvm.loop.mustprogress metadata instead.
define void @unknown_tripcount_mustprogress_md_assume(i32 %a, i32 %b) {
; CHECK-LABEL: define void @unknown_tripcount_mustprogress_md_assume(
; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[FOR_COND:.*]]
; CHECK:       [[FOR_COND]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %for.cond
for.cond:
  %cmp = icmp slt i32 %a, %b
  br i1 %cmp, label %for.body, label %for.end
for.body:
  call void @llvm.assume(i1 %cmp)
  br label %for.cond, !llvm.loop !0
for.end:
  ret void
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.mustprogress"}
