define i64 @udiv_possibly_poison_short_dividend(i32 %a, i64 %b) {
; CHECK-LABEL: define i64 @udiv_possibly_poison_short_dividend(
; CHECK-SAME: i32 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[AZ:%.*]] = zext i32 [[A]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = icmp uge i64 [[AZ]], [[B]]
; CHECK-NEXT:    [[TMP5:%.*]] = freeze i1 [[TMP1]]
; CHECK-NEXT:    br i1 [[TMP5]], label %[[BB6:.*]], label %[[BB11:.*]]
; CHECK:       [[BB6]]:
; CHECK-NEXT:    [[TMP7:%.*]] = trunc i64 [[B]] to i32
; CHECK-NEXT:    [[TMP8:%.*]] = trunc i64 [[AZ]] to i32
; CHECK-NEXT:    [[TMP9:%.*]] = call i32 @llvm.udiv.poison.i32(i32 [[TMP8]], i32 [[TMP7]])
; CHECK-NEXT:    [[TMP10:%.*]] = zext i32 [[TMP9]] to i64
; CHECK-NEXT:    br label %[[BB11]]
; CHECK:       [[BB11]]:
; CHECK-NEXT:    [[TMP13:%.*]] = phi i64 [ [[TMP10]], %[[BB6]] ], [ 0, [[TMP0:%.*]] ]
; CHECK-NEXT:    ret i64 [[TMP13]]
;
  %az = zext i32 %a to i64
  %d = call i64 @llvm.udiv.poison.i64(i64 %az, i64 %b)
  ret i64 %d
}

; Proven-defined conditions do not need freezes.
define i64 @udiv_noundef(i64 noundef %a, i64 noundef %b) {
; CHECK-LABEL: define i64 @udiv_noundef(
; CHECK-SAME: i64 noundef [[A:%.*]], i64 noundef [[B:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = or i64 [[A]], [[B]]
; CHECK-NEXT:    [[TMP2:%.*]] = and i64 [[TMP1]], -4294967296
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq i64 [[TMP2]], 0
; CHECK-NEXT:    br i1 [[TMP3]], label %[[BB4:.*]], label %[[BB9:.*]]
; CHECK:       [[BB4]]:
; CHECK-NEXT:    [[TMP5:%.*]] = trunc i64 [[B]] to i32
; CHECK-NEXT:    [[TMP6:%.*]] = trunc i64 [[A]] to i32
; CHECK-NEXT:    [[TMP7:%.*]] = call i32 @llvm.udiv.poison.i32(i32 [[TMP6]], i32 [[TMP5]])
; CHECK-NEXT:    [[TMP8:%.*]] = zext i32 [[TMP7]] to i64
; CHECK-NEXT:    br label %[[DOTSPLIT:.*]]
; CHECK:       [[BB9]]:
; CHECK-NEXT:    [[TMP10:%.*]] = call i64 @llvm.udiv.poison.i64(i64 [[A]], i64 [[B]])
; CHECK-NEXT:    br label %[[DOTSPLIT]]
; CHECK:       [[DOTSPLIT]]:
; CHECK-NEXT:    [[TMP11:%.*]] = phi i64 [ [[TMP8]], %[[BB4]] ], [ [[TMP10]], %[[BB9]] ]
; CHECK-NEXT:    ret i64 [[TMP11]]
;
  %d = call i64 @llvm.udiv.poison.i64(i64 %a, i64 %b)
  ret i64 %d
}

; Identical operands still only need a condition freeze.
define i64 @udiv_same_operand(i64 %a) {
; CHECK-LABEL: define i64 @udiv_same_operand(
; CHECK-SAME: i64 [[A:%.*]]) {
; CHECK-NEXT:    [[TMP2:%.*]] = or i64 [[A]], [[A]]
; CHECK-NEXT:    [[TMP3:%.*]] = and i64 [[TMP2]], -4294967296
; CHECK-NEXT:    [[TMP5:%.*]] = freeze i64 [[TMP3]]
; CHECK-NEXT:    [[TMP4:%.*]] = icmp eq i64 [[TMP5]], 0
; CHECK-NEXT:    br i1 [[TMP4]], label %[[BB5:.*]], label %[[BB10:.*]]
; CHECK:       [[BB5]]:
; CHECK-NEXT:    [[TMP6:%.*]] = trunc i64 [[A]] to i32
; CHECK-NEXT:    [[TMP7:%.*]] = trunc i64 [[A]] to i32
; CHECK-NEXT:    [[TMP8:%.*]] = call i32 @llvm.udiv.poison.i32(i32 [[TMP7]], i32 [[TMP6]])
; CHECK-NEXT:    [[TMP9:%.*]] = zext i32 [[TMP8]] to i64
; CHECK-NEXT:    br label %[[DOTSPLIT:.*]]
; CHECK:       [[BB10]]:
; CHECK-NEXT:    [[TMP11:%.*]] = call i64 @llvm.udiv.poison.i64(i64 [[A]], i64 [[A]])
; CHECK-NEXT:    br label %[[DOTSPLIT]]
; CHECK:       [[DOTSPLIT]]:
; CHECK-NEXT:    [[TMP12:%.*]] = phi i64 [ [[TMP9]], %[[BB5]] ], [ [[TMP11]], %[[BB10]] ]
; CHECK-NEXT:    ret i64 [[TMP12]]
;
  %d = call i64 @llvm.udiv.poison.i64(i64 %a, i64 %a)
  ret i64 %d
}

