; A masked possibly-poison dividend must not introduce a long division.
define i64 @udiv_masked_short_dividend(i64 %a, i64 %b) {
; CHECK-LABEL: define i64 @udiv_masked_short_dividend(
; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[SHORT:%.*]] = and i64 [[A]], 4294967295
; CHECK-NEXT:    [[TMP1:%.*]] = icmp uge i64 [[SHORT]], [[B]]
; CHECK-NEXT:    [[TMP2:%.*]] = freeze i1 [[TMP1]]
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB3:.*]], label %[[DOTSPLIT:.*]]
; CHECK:       [[BB3]]:
; CHECK-NEXT:    [[TMP4:%.*]] = trunc i64 [[B]] to i32
; CHECK-NEXT:    [[TMP5:%.*]] = trunc i64 [[SHORT]] to i32
; CHECK-NEXT:    [[TMP6:%.*]] = call i32 @llvm.udiv.poison.i32(i32 [[TMP5]], i32 [[TMP4]])
; CHECK-NEXT:    [[TMP7:%.*]] = zext i32 [[TMP6]] to i64
; CHECK-NEXT:    br label %[[DOTSPLIT]]
; CHECK:       [[DOTSPLIT]]:
; CHECK-NEXT:    [[TMP8:%.*]] = phi i64 [ [[TMP7]], %[[BB3]] ], [ 0, [[TMP0:%.*]] ]
; CHECK-NEXT:    ret i64 [[TMP8]]
;
  %short = and i64 %a, 4294967295
  %d = call i64 @llvm.udiv.poison.i64(i64 %short, i64 %b)
  ret i64 %d
}

; The no-division path must keep the original, possibly-poison dividend.
define i64 @urem_possibly_poison_short_dividend(i32 %a, i64 %b) {
; CHECK-LABEL: define i64 @urem_possibly_poison_short_dividend(
; CHECK-SAME: i32 [[A:%.*]], i64 [[B:%.*]]) {
; CHECK-NEXT:    [[AZ:%.*]] = zext i32 [[A]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = icmp uge i64 [[AZ]], [[B]]
; CHECK-NEXT:    [[TMP2:%.*]] = freeze i1 [[TMP1]]
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB3:.*]], label %[[DOTSPLIT:.*]]
; CHECK:       [[BB3]]:
; CHECK-NEXT:    [[TMP4:%.*]] = trunc i64 [[B]] to i32
; CHECK-NEXT:    [[TMP5:%.*]] = trunc i64 [[AZ]] to i32
; CHECK-NEXT:    [[TMP6:%.*]] = call i32 @llvm.urem.poison.i32(i32 [[TMP5]], i32 [[TMP4]])
; CHECK-NEXT:    [[TMP7:%.*]] = zext i32 [[TMP6]] to i64
; CHECK-NEXT:    br label %[[DOTSPLIT]]
; CHECK:       [[DOTSPLIT]]:
; CHECK-NEXT:    [[TMP8:%.*]] = phi i64 [ [[TMP7]], %[[BB3]] ], [ [[AZ]], [[TMP0:%.*]] ]
; CHECK-NEXT:    ret i64 [[TMP8]]
;
  %az = zext i32 %a to i64
  %r = call i64 @llvm.urem.poison.i64(i64 %az, i64 %b)
  ret i64 %r
}

; A short-dividend comparison of defined operands needs no freeze.
define i64 @udiv_short_dividend_noundef(i32 noundef %a, i64 noundef %b) {
; CHECK-LABEL: define i64 @udiv_short_dividend_noundef(
; CHECK-SAME: i32 noundef [[A:%.*]], i64 noundef [[B:%.*]]) {
; CHECK-NEXT:    [[AZ:%.*]] = zext i32 [[A]] to i64
; CHECK-NEXT:    [[TMP1:%.*]] = icmp uge i64 [[AZ]], [[B]]
; CHECK-NEXT:    br i1 [[TMP1]], label %[[BB2:.*]], label %[[DOTSPLIT:.*]]
; CHECK:       [[BB2]]:
; CHECK-NEXT:    [[TMP3:%.*]] = trunc i64 [[B]] to i32
; CHECK-NEXT:    [[TMP4:%.*]] = trunc i64 [[AZ]] to i32
; CHECK-NEXT:    [[TMP5:%.*]] = call i32 @llvm.udiv.poison.i32(i32 [[TMP4]], i32 [[TMP3]])
; CHECK-NEXT:    [[TMP6:%.*]] = zext i32 [[TMP5]] to i64
; CHECK-NEXT:    br label %[[DOTSPLIT]]
; CHECK:       [[DOTSPLIT]]:
; CHECK-NEXT:    [[TMP7:%.*]] = phi i64 [ [[TMP6]], %[[BB2]] ], [ 0, [[TMP0:%.*]] ]
; CHECK-NEXT:    ret i64 [[TMP7]]
;
  %az = zext i32 %a to i64
  %d = call i64 @llvm.udiv.poison.i64(i64 %az, i64 %b)
  ret i64 %d
}

