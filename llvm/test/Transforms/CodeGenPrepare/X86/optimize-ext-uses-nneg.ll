; RUN: opt -S -passes='require<profile-summary>,function(codegenprepare)' -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

; optimizeExtUses rewrites uses of %id outside the extension's block to read
; trunc(%z). That's only correct where %z isn't poison, and here zext nneg only
; holds behind the sign check, which is itself one of the rewritten uses. Make
; sure nneg is dropped.

define i64 @drop_nneg_same_block(ptr %p, i1 %c) {
; CHECK-LABEL: define i64 @drop_nneg_same_block(
; CHECK-SAME: ptr [[P:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[ID:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[Z:%.*]] = zext i32 [[ID]] to i64
; CHECK-NEXT:    br i1 [[C]], label %[[TEST:.*]], label %[[EXIT:.*]]
; CHECK:       [[TEST]]:
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i64 [[Z]] to i32
; CHECK-NEXT:    [[NONNEG:%.*]] = icmp sgt i32 [[TMP0]], -1
; CHECK-NEXT:    br i1 [[NONNEG]], label %[[DIRECT:.*]], label %[[EXIT]]
; CHECK:       [[DIRECT]]:
; CHECK-NEXT:    ret i64 [[Z]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 -1
;
entry:
  %id = load i32, ptr %p, align 4
  %z = zext nneg i32 %id to i64
  br i1 %c, label %test, label %exit

test:
  %nonneg = icmp sgt i32 %id, -1
  br i1 %nonneg, label %direct, label %exit

direct:
  ret i64 %z

exit:
  ret i64 -1
}

