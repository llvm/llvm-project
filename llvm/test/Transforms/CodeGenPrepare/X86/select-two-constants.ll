; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='require<profile-summary>,function(codegenprepare)' -S < %s | FileCheck %s

target triple = "x86_64-unknown-unknown"

; Selects of two constants, most of them with branch weights, alone and next
; to other selects on the same condition. CodeGenPrepare leaves a select of two
; constants that starts a group of selects on the same condition as a select.

@g = external global i8

define i32 @select_consts(i32 %a) {
; CHECK-LABEL: define i32 @select_consts(
; CHECK-SAME: i32 [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[A]], 10
; CHECK-NEXT:    [[S:%.*]] = select i1 [[C]], i32 7, i32 5, !prof [[PROF0:![0-9]+]]
; CHECK-NEXT:    ret i32 [[S]]
;
entry:
  %c = icmp ugt i32 %a, 10
  %s = select i1 %c, i32 7, i32 5, !prof !0
  ret i32 %s
}

; A null pointer and the address of a global.
define ptr @select_null_global(i32 %a) {
; CHECK-LABEL: define ptr @select_null_global(
; CHECK-SAME: i32 [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[A]], 10
; CHECK-NEXT:    [[S:%.*]] = select i1 [[C]], ptr null, ptr @g, !prof [[PROF0]]
; CHECK-NEXT:    ret ptr [[S]]
;
entry:
  %c = icmp ugt i32 %a, 10
  %s = select i1 %c, ptr null, ptr @g, !prof !0
  ret ptr %s
}

; A select of two constants follows another select on the same condition. It
; joins the group of that select and becomes a phi.
define i32 @select_then_consts(i32 %a, i32 %p, i32 %q, ptr %o) {
; CHECK-LABEL: define i32 @select_then_consts(
; CHECK-SAME: i32 [[A:%.*]], i32 [[P:%.*]], i32 [[Q:%.*]], ptr [[O:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[V_FROZEN:%.*]] = freeze i32 [[A]]
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[V_FROZEN]], 10
; CHECK-NEXT:    br i1 [[C]], label %[[SELECT_END:.*]], label %[[SELECT_FALSE:.*]], !prof [[PROF0]]
; CHECK:       [[SELECT_FALSE]]:
; CHECK-NEXT:    br label %[[SELECT_END]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[P]], %[[ENTRY]] ], [ [[Q]], %[[SELECT_FALSE]] ]
; CHECK-NEXT:    [[K:%.*]] = phi i32 [ 7, %[[ENTRY]] ], [ 5, %[[SELECT_FALSE]] ]
; CHECK-NEXT:    store i32 [[K]], ptr [[O]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  %c = icmp ugt i32 %a, 10
  %v = select i1 %c, i32 %p, i32 %q, !prof !0
  %k = select i1 %c, i32 7, i32 5
  store i32 %k, ptr %o
  ret i32 %v
}

; A select of two constants comes before another select on the same condition.
; The select of two constants is left alone, and the other select starts its
; own group and becomes a branch.
define i32 @consts_then_select(i32 %a, i32 %p, i32 %q, ptr %o) {
; CHECK-LABEL: define i32 @consts_then_select(
; CHECK-SAME: i32 [[A:%.*]], i32 [[P:%.*]], i32 [[Q:%.*]], ptr [[O:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[A]], 10
; CHECK-NEXT:    [[K:%.*]] = select i1 [[C]], i32 7, i32 5, !prof [[PROF0]]
; CHECK-NEXT:    [[V_FROZEN:%.*]] = freeze i1 [[C]]
; CHECK-NEXT:    br i1 [[V_FROZEN]], label %[[SELECT_END:.*]], label %[[SELECT_FALSE:.*]], !prof [[PROF0]]
; CHECK:       [[SELECT_FALSE]]:
; CHECK-NEXT:    br label %[[SELECT_END]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[P]], %[[ENTRY]] ], [ [[Q]], %[[SELECT_FALSE]] ]
; CHECK-NEXT:    store i32 [[K]], ptr [[O]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  %c = icmp ugt i32 %a, 10
  %k = select i1 %c, i32 7, i32 5, !prof !0
  %v = select i1 %c, i32 %p, i32 %q, !prof !0
  store i32 %k, ptr %o
  ret i32 %v
}

; A select of two constants between two other selects on the same condition.
; All three are in the group of the first select, so they become phis of one
; branch.
define void @select_consts_select(i32 %a, i32 %p, i32 %q, ptr %o) {
; CHECK-LABEL: define void @select_consts_select(
; CHECK-SAME: i32 [[A:%.*]], i32 [[P:%.*]], i32 [[Q:%.*]], ptr [[O:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[V_FROZEN:%.*]] = freeze i32 [[A]]
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[V_FROZEN]], 10
; CHECK-NEXT:    br i1 [[C]], label %[[SELECT_END:.*]], label %[[SELECT_FALSE:.*]], !prof [[PROF0]]
; CHECK:       [[SELECT_FALSE]]:
; CHECK-NEXT:    br label %[[SELECT_END]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[P]], %[[ENTRY]] ], [ [[Q]], %[[SELECT_FALSE]] ]
; CHECK-NEXT:    [[K:%.*]] = phi i32 [ 7, %[[ENTRY]] ], [ 5, %[[SELECT_FALSE]] ]
; CHECK-NEXT:    [[W:%.*]] = phi i32 [ [[Q]], %[[ENTRY]] ], [ [[P]], %[[SELECT_FALSE]] ]
; CHECK-NEXT:    store i32 [[V]], ptr [[O]], align 4
; CHECK-NEXT:    [[O1:%.*]] = getelementptr i32, ptr [[O]], i64 1
; CHECK-NEXT:    store i32 [[K]], ptr [[O1]], align 4
; CHECK-NEXT:    [[O2:%.*]] = getelementptr i32, ptr [[O]], i64 2
; CHECK-NEXT:    store i32 [[W]], ptr [[O2]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %c = icmp ugt i32 %a, 10
  %v = select i1 %c, i32 %p, i32 %q, !prof !0
  %k = select i1 %c, i32 7, i32 5, !prof !0
  %w = select i1 %c, i32 %q, i32 %p, !prof !0
  store i32 %v, ptr %o
  %o1 = getelementptr i32, ptr %o, i64 1
  store i32 %k, ptr %o1
  %o2 = getelementptr i32, ptr %o, i64 2
  store i32 %w, ptr %o2
  ret void
}

; An unpredictable select of two constants comes before a select on the same
; condition with branch weights. The select of two constants is left alone, so
; its !unpredictable does not apply to the other select, which becomes a branch.
define i32 @unpredictable_consts_then_select(i32 %a, i32 %p, i32 %q, ptr %o) {
; CHECK-LABEL: define i32 @unpredictable_consts_then_select(
; CHECK-SAME: i32 [[A:%.*]], i32 [[P:%.*]], i32 [[Q:%.*]], ptr [[O:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[A]], 10
; CHECK-NEXT:    [[K:%.*]] = select i1 [[C]], i32 7, i32 5, !unpredictable [[META1:![0-9]+]]
; CHECK-NEXT:    [[V_FROZEN:%.*]] = freeze i1 [[C]]
; CHECK-NEXT:    br i1 [[V_FROZEN]], label %[[SELECT_END:.*]], label %[[SELECT_FALSE:.*]], !prof [[PROF0]]
; CHECK:       [[SELECT_FALSE]]:
; CHECK-NEXT:    br label %[[SELECT_END]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[P]], %[[ENTRY]] ], [ [[Q]], %[[SELECT_FALSE]] ]
; CHECK-NEXT:    store i32 [[K]], ptr [[O]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  %c = icmp ugt i32 %a, 10
  %k = select i1 %c, i32 7, i32 5, !unpredictable !1
  %v = select i1 %c, i32 %p, i32 %q, !prof !0
  store i32 %k, ptr %o
  ret i32 %v
}

; The other order: a select with branch weights comes before an unpredictable
; select of two constants on the same condition. The first select decides for
; both, and its branch weights win over the !unpredictable.
define i32 @select_then_unpredictable_consts(i32 %a, i32 %p, i32 %q, ptr %o) {
; CHECK-LABEL: define i32 @select_then_unpredictable_consts(
; CHECK-SAME: i32 [[A:%.*]], i32 [[P:%.*]], i32 [[Q:%.*]], ptr [[O:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[V_FROZEN:%.*]] = freeze i32 [[A]]
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[V_FROZEN]], 10
; CHECK-NEXT:    br i1 [[C]], label %[[SELECT_END:.*]], label %[[SELECT_FALSE:.*]], !prof [[PROF0]]
; CHECK:       [[SELECT_FALSE]]:
; CHECK-NEXT:    br label %[[SELECT_END]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[V:%.*]] = phi i32 [ [[P]], %[[ENTRY]] ], [ [[Q]], %[[SELECT_FALSE]] ]
; CHECK-NEXT:    [[K:%.*]] = phi i32 [ 7, %[[ENTRY]] ], [ 5, %[[SELECT_FALSE]] ]
; CHECK-NEXT:    store i32 [[K]], ptr [[O]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  %c = icmp ugt i32 %a, 10
  %v = select i1 %c, i32 %p, i32 %q, !prof !0
  %k = select i1 %c, i32 7, i32 5, !unpredictable !1
  store i32 %k, ptr %o
  ret i32 %v
}

