; CHECK-NEXT:    [[C2:%.*]] = icmp ult i256 [[X]], [[Y]]
; CHECK-NEXT:    [[OR:%.*]] = select i1 [[C1]], i1 true, i1 [[C2]], !prof [[PROF0]]
; CHECK-NEXT:    br i1 [[OR]], label %[[T:.*]], label %[[F:.*]], !prof [[PROF0]]
; CHECK:       [[T]]:
; CHECK-NEXT:    ret i32 1
; CHECK:       [[F]]:
; CHECK-NEXT:    ret i32 0
;
