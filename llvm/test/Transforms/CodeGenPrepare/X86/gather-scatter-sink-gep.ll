; RUN: opt -S -passes='require<profile-summary>,function(codegenprepare)' < %s | FileCheck %s

; Check that the GEPs computing the address of a gather/scatter are sunk into
; its block when they are defined in another one, so that SelectionDAG can fold
; a scalar base and a vector index into the addressing mode.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

; Loop-invariant GEP hoisted out of the loop by LICM.
define void @hoisted_gep(ptr %p, ptr %q, i64 %n) {
; CHECK-LABEL: define void @hoisted_gep(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[V:%.*]] = getelementptr [12 x i8], ptr [[P]], <8 x i64> <i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7>
; CHECK-NEXT:    [[G:%.*]] = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 [[V]], <8 x i1> splat (i1 true), <8 x float> poison)
; CHECK-NEXT:    [[QI:%.*]] = getelementptr <8 x float>, ptr [[Q]], i64 [[I]]
; CHECK-NEXT:    store <8 x float> [[G]], ptr [[QI]], align 32
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %v = getelementptr [12 x i8], ptr %p, <8 x i64> <i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7>
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %g = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %v, <8 x i1> splat (i1 true), <8 x float> poison)
  %qi = getelementptr <8 x float>, ptr %q, i64 %i
  store <8 x float> %g, ptr %qi
  %i.next = add i64 %i, 1
  %c = icmp eq i64 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

