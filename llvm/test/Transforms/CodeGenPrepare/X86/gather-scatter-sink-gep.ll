  %p.ins = insertelement <8 x ptr> poison, ptr %p, i64 0
  %p.splat = shufflevector <8 x ptr> %p.ins, <8 x ptr> poison, <8 x i32> zeroinitializer
  %off.ins = insertelement <8 x i64> poison, i64 %off, i64 0
  %off.splat = shufflevector <8 x i64> %off.ins, <8 x i64> poison, <8 x i32> zeroinitializer
  %v = getelementptr [12 x i8], <8 x ptr> %p.splat, <8 x i64> %idx
  %f = getelementptr i8, <8 x ptr> %v, <8 x i64> %off.splat
  %g = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %f, <8 x i1> %m, <8 x float> poison)
  ret <8 x float> %g
}

; Negative test: the root of the GEP chain is neither a scalar nor a splat, so
; there is no uniform base to expose and nothing is sunk.
define void @non_uniform_root(<8 x ptr> %ptrs, ptr %q, i64 %n) {
; CHECK-LABEL: define void @non_uniform_root(
; CHECK-SAME: <8 x ptr> [[PTRS:%.*]], ptr [[Q:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[F:%.*]] = getelementptr i8, <8 x ptr> [[PTRS]], i64 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[G:%.*]] = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 [[F]], <8 x i1> splat (i1 true), <8 x float> poison)
; CHECK-NEXT:    [[QI:%.*]] = getelementptr <8 x float>, ptr [[Q]], i64 [[I]]
; CHECK-NEXT:    store <8 x float> [[G]], ptr [[QI]], align 32
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %f = getelementptr i8, <8 x ptr> %ptrs, i64 4
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %g = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %f, <8 x i1> splat (i1 true), <8 x float> poison)
  %qi = getelementptr <8 x float>, ptr %q, i64 %i
  store <8 x float> %g, ptr %qi
  %i.next = add i64 %i, 1
  %c = icmp eq i64 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

; The hoisted GEP has another use, so it is kept. The gather and the scatter
; share the GEP sunk into their block.
define void @hoisted_gep_other_use(ptr %p, <4 x i64> %idx, ptr %out, <4 x i1> %m, i1 %cond) {
; CHECK-LABEL: define void @hoisted_gep_other_use(
; CHECK-SAME: ptr [[P:%.*]], <4 x i64> [[IDX:%.*]], ptr [[OUT:%.*]], <4 x i1> [[M:%.*]], i1 [[COND:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[V:%.*]] = getelementptr [12 x i8], ptr [[P]], <4 x i64> [[IDX]]
; CHECK-NEXT:    [[F:%.*]] = getelementptr i8, <4 x ptr> [[V]], i64 4
; CHECK-NEXT:    store <4 x ptr> [[F]], ptr [[OUT]], align 32
; CHECK-NEXT:    br i1 [[COND]], label %[[ACCESS:.*]], label %[[EXIT:.*]]
; CHECK:       [[ACCESS]]:
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr i8, ptr [[P]], i64 4
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr [12 x i8], ptr [[TMP0]], <4 x i64> [[IDX]]
; CHECK-NEXT:    [[A:%.*]] = call <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr> align 4 [[TMP1]], <4 x i1> [[M]], <4 x i32> poison)
; CHECK-NEXT:    [[A1:%.*]] = add <4 x i32> [[A]], splat (i32 1)
; CHECK-NEXT:    call void @llvm.masked.scatter.v4i32.v4p0(<4 x i32> [[A1]], <4 x ptr> align 4 [[TMP1]], <4 x i1> [[M]])
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %v = getelementptr [12 x i8], ptr %p, <4 x i64> %idx
  %f = getelementptr i8, <4 x ptr> %v, i64 4
  store <4 x ptr> %f, ptr %out
  br i1 %cond, label %access, label %exit

access:
  %a = call <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr> align 4 %f, <4 x i1> %m, <4 x i32> poison)
  %a1 = add <4 x i32> %a, splat (i32 1)
  call void @llvm.masked.scatter.v4i32.v4p0(<4 x i32> %a1, <4 x ptr> align 4 %f, <4 x i1> %m)
  br label %exit

exit:
  ret void
}

; The GEP is sunk into each block accessing it.
define <4 x i32> @multiple_access_blocks(ptr %p, <4 x i64> %idx, <4 x i1> %m, i1 %cond) {
; CHECK-LABEL: define <4 x i32> @multiple_access_blocks(
; CHECK-SAME: ptr [[P:%.*]], <4 x i64> [[IDX:%.*]], <4 x i1> [[M:%.*]], i1 [[COND:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[COND]], label %[[LEFT:.*]], label %[[RIGHT:.*]]
; CHECK:       [[LEFT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = getelementptr i32, ptr [[P]], <4 x i64> [[IDX]]
; CHECK-NEXT:    [[A:%.*]] = call <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr> align 4 [[TMP0]], <4 x i1> [[M]], <4 x i32> poison)
; CHECK-NEXT:    ret <4 x i32> [[A]]
; CHECK:       [[RIGHT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i32, ptr [[P]], <4 x i64> [[IDX]]
; CHECK-NEXT:    [[B:%.*]] = call <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr> align 4 [[TMP1]], <4 x i1> [[M]], <4 x i32> zeroinitializer)
; CHECK-NEXT:    ret <4 x i32> [[B]]
;
entry:
  %v = getelementptr i32, ptr %p, <4 x i64> %idx
  br i1 %cond, label %left, label %right

left:
  %a = call <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr> align 4 %v, <4 x i1> %m, <4 x i32> poison)
  ret <4 x i32> %a

right:
  %b = call <4 x i32> @llvm.masked.gather.v4i32.v4p0(<4 x ptr> align 4 %v, <4 x i1> %m, <4 x i32> zeroinitializer)
  ret <4 x i32> %b
}
