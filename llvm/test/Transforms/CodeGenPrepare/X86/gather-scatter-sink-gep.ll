; Same-block nested GEP: no sinking needed, but the constant offset is still
; folded into the scalar base.
define <8 x float> @local_nested_gep(ptr %p, <8 x i32> %idx, <8 x i1> %m) {
; CHECK-LABEL: define <8 x float> @local_nested_gep(
; CHECK-SAME: ptr [[P:%.*]], <8 x i32> [[IDX:%.*]], <8 x i1> [[M:%.*]]) {
; CHECK-NEXT:    [[EXT:%.*]] = sext <8 x i32> [[IDX]] to <8 x i64>
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[P]], i64 8
; CHECK-NEXT:    [[F:%.*]] = getelementptr [12 x i8], ptr [[TMP1]], <8 x i64> [[EXT]]
; CHECK-NEXT:    [[G:%.*]] = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 [[F]], <8 x i1> [[M]], <8 x float> poison)
; CHECK-NEXT:    ret <8 x float> [[G]]
;
  %ext = sext <8 x i32> %idx to <8 x i64>
  %v = getelementptr inbounds [12 x i8], ptr %p, <8 x i64> %ext
  %f = getelementptr inbounds i8, <8 x ptr> %v, i64 8
  %g = call <8 x float> @llvm.masked.gather.v8f32.v8p0(<8 x ptr> align 4 %f, <8 x i1> %m, <8 x float> poison)
  ret <8 x float> %g
}

