; Address sinking may reuse an IV increment as the combined index, but the
; increment is only known to dominate the memory instruction, not the new
; phis and selects, which are inserted at the original ones. The combination
; must be rejected in that case.
; https://github.com/llvm/llvm-project/issues/226709

define i64 @select_version(ptr %p, i1 %c0, i1 %c1) {
; CHECK-LABEL: define i64 @select_version(
; CHECK-SAME: ptr [[P:%.*]], i1 [[C0:%.*]], i1 [[C1:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[A:%.*]] = getelementptr [8 x i8], ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[B:%.*]] = getelementptr i8, ptr [[A]], i64 -8
; CHECK-NEXT:    [[C:%.*]] = getelementptr [8 x i8], ptr [[P]], i64 -2
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[C0]], ptr [[B]], ptr [[C]]
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 1
; CHECK-NEXT:    br i1 [[C1]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[SEL]], align 8
; CHECK-NEXT:    ret i64 [[V]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %a = getelementptr [8 x i8], ptr %p, i64 %iv
  %b = getelementptr i8, ptr %a, i64 -8
  %c = getelementptr [8 x i8], ptr %p, i64 -2
  %sel = select i1 %c0, ptr %b, ptr %c
  %iv.next = add i64 %iv, 1
  br i1 %c1, label %exit, label %loop

exit:
  %v = load i64, ptr %sel, align 8
  ret i64 %v
}

; The new phi gets %iv.next as the incoming value from %if.then, where it is
; not available yet.
define i64 @phi_version(ptr %p, i1 %c0, i1 %c1) {
; CHECK-LABEL: define i64 @phi_version(
; CHECK-SAME: ptr [[P:%.*]], i1 [[C0:%.*]], i1 [[C1:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    br i1 [[C0]], label %[[IF_THEN:.*]], label %[[IF_ELSE:.*]]
; CHECK:       [[IF_THEN]]:
; CHECK-NEXT:    [[A:%.*]] = getelementptr [8 x i8], ptr [[P]], i64 [[IV]]
; CHECK-NEXT:    [[B:%.*]] = getelementptr i8, ptr [[A]], i64 -8
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[IF_ELSE]]:
; CHECK-NEXT:    [[C:%.*]] = getelementptr [8 x i8], ptr [[P]], i64 -2
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[PH:%.*]] = phi ptr [ [[B]], %[[IF_THEN]] ], [ [[C]], %[[IF_ELSE]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add i64 [[IV]], 1
; CHECK-NEXT:    br i1 [[C1]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[PH]], align 8
; CHECK-NEXT:    ret i64 [[V]]
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  br i1 %c0, label %if.then, label %if.else

if.then:
  %a = getelementptr [8 x i8], ptr %p, i64 %iv
  %b = getelementptr i8, ptr %a, i64 -8
  br label %latch

if.else:
  %c = getelementptr [8 x i8], ptr %p, i64 -2
  br label %latch

latch:
  %ph = phi ptr [ %b, %if.then ], [ %c, %if.else ]
  %iv.next = add i64 %iv, 1
  br i1 %c1, label %exit, label %loop

exit:
  %v = load i64, ptr %ph, align 8
  ret i64 %v
}

