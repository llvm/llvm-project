; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -S -mtriple=x86_64 -disable-simplify-libcalls -codegenprepare < %s | FileCheck %s
target datalayout = "e-m:o-i64:64-f80:128-n8:16:32:64-S128"

; A "nobuiltin" call to a __memset_chk that is defined in the module must not
; be folded to llvm.memset. The PR23093 workaround only applies to calls that
; may resolve to a libc function that is unavailable at link time; here the
; callee has a definition in the module which need not implement the fortified
; libc semantics.
; https://github.com/llvm/llvm-project/issues/237871

@dst = global [8 x i8] zeroinitializer

define internal ptr @__memset_chk(ptr %s, i32 %c, i64 %n, i64 %size) {
  ret ptr null
}

define i32 @main() {
; CHECK-LABEL: @main(
; CHECK-NEXT:    [[P:%.*]] = call ptr @__memset_chk(ptr @dst, i32 0, i64 1, i64 -1) #[[ATTR:.*]]
; CHECK-NEXT:    [[EQ:%.*]] = icmp eq ptr [[P]], @dst
; CHECK-NEXT:    [[R:%.*]] = zext i1 [[EQ]] to i32
; CHECK-NEXT:    ret i32 [[R]]
;
  %p = call ptr @__memset_chk(ptr @dst, i32 0, i64 1, i64 -1) nobuiltin
  %eq = icmp eq ptr %p, @dst
  %r = zext i1 %eq to i32
  ret i32 %r
}

; CHECK: attributes #[[ATTR]] = { nobuiltin }
