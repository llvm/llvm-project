; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='require<profile-summary>,function(codegenprepare)' -S < %s | FileCheck %s

target triple = "x86_64-unknown-unknown"

; In unreachable code, the selects of a group can use themselves or each other
; in a cycle. Turning them into a branch must not loop forever. The branch
; weights make the selects predictable, so that they become a branch.

define i32 @self_use() {
; CHECK-LABEL: define i32 @self_use() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    ret i32 0
; CHECK:       [[SELECT_FALSE:.*]]:
; CHECK-NEXT:    br label %[[SELECT_END:.*]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 7, 0
; CHECK-NEXT:    br i1 [[C]], label %[[SELECT_END]], label %[[SELECT_FALSE]], !prof [[PROF0:![0-9]+]]
;
entry:
  ret i32 0

loop:
  %c = icmp eq i32 %x, 0
  %x = select i1 %c, i32 %x, i32 7, !prof !0
  br label %loop
}

define i32 @use_each_other(i32 %a) {
; CHECK-LABEL: define i32 @use_each_other(
; CHECK-SAME: i32 [[A:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    ret i32 0
; CHECK:       [[SELECT_FALSE:.*]]:
; CHECK-NEXT:    br label %[[SELECT_END:.*]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[X:%.*]] = phi i32 [ 8, %[[SELECT_END]] ], [ 7, %[[SELECT_FALSE]] ]
; CHECK-NEXT:    [[X_FROZEN:%.*]] = freeze i32 [[A]]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[X_FROZEN]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[SELECT_END]], label %[[SELECT_FALSE]], !prof [[PROF0]]
;
entry:
  ret i32 0

loop:
  %c = icmp eq i32 %a, 0
  %x = select i1 %c, i32 %y, i32 7, !prof !0
  %y = select i1 %c, i32 %x, i32 8, !prof !0
  br label %loop
}

; A select of the group is sunk into the new block before the phis are built.
define <4 x i64> @sunk(i1 %c, <4 x i64> %p, <4 x i64> %q, <4 x i64> %b) {
; CHECK-LABEL: define <4 x i64> @sunk(
; CHECK-SAME: i1 [[C:%.*]], <4 x i64> [[P:%.*]], <4 x i64> [[Q:%.*]], <4 x i64> [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[X_FROZEN:%.*]] = freeze i1 [[C]]
; CHECK-NEXT:    br i1 [[X_FROZEN]], label %[[SELECT_TRUE_SINK:.*]], label %[[SELECT_END:.*]], !prof [[PROF0]]
; CHECK:       [[SELECT_TRUE_SINK]]:
; CHECK-NEXT:    br label %[[SELECT_END]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[X:%.*]] = phi <4 x i64> [ [[P]], %[[SELECT_TRUE_SINK]] ], [ [[Q]], %[[ENTRY]] ]
; CHECK-NEXT:    [[Y:%.*]] = phi <4 x i64> [ [[P]], %[[SELECT_TRUE_SINK]] ], [ [[B]], %[[ENTRY]] ]
; CHECK-NEXT:    ret <4 x i64> [[Y]]
;
entry:
  %x = select i1 %c, <4 x i64> %p, <4 x i64> %q, !prof !0
  %y = select i1 %c, <4 x i64> %x, <4 x i64> %b, !prof !0
  ret <4 x i64> %y
}

; The same in a cycle in unreachable code.
define <4 x i64> @sunk_cycle(i1 %c, <4 x i64> %q) {
; CHECK-LABEL: define <4 x i64> @sunk_cycle(
; CHECK-SAME: i1 [[C:%.*]], <4 x i64> [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    ret <4 x i64> zeroinitializer
; CHECK:       [[SELECT_TRUE_SINK:.*]]:
; CHECK-NEXT:    br label %[[SELECT_END:.*]]
; CHECK:       [[SELECT_END]]:
; CHECK-NEXT:    [[X_FROZEN:%.*]] = freeze i1 [[C]]
; CHECK-NEXT:    br i1 [[X_FROZEN]], label %[[SELECT_TRUE_SINK]], label %[[SELECT_END]], !prof [[PROF0]]
;
entry:
  ret <4 x i64> zeroinitializer

loop:
  %x = select i1 %c, <4 x i64> %y, <4 x i64> %q, !prof !0
  %y = select i1 %c, <4 x i64> %x, <4 x i64> %x, !prof !0
  br label %loop
}

!0 = !{!"branch_weights", i32 2000, i32 1}
