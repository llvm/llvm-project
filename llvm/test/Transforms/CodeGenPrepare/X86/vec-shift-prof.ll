; When a shift by a select of splats is hoisted above the select, the new select
; keeps the profile metadata of the original one.

define <4 x i32> @shl_by_select_of_splats(<4 x i32> %x, i1 %c, i32 %a, i32 %b) {
; CHECK-LABEL: define <4 x i32> @shl_by_select_of_splats(
; CHECK-SAME: <4 x i32> [[X:%.*]], i1 [[C:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[IA:%.*]] = insertelement <4 x i32> poison, i32 [[A]], i64 0
; CHECK-NEXT:    [[SA:%.*]] = shufflevector <4 x i32> [[IA]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[IB:%.*]] = insertelement <4 x i32> poison, i32 [[B]], i64 0
; CHECK-NEXT:    [[SB:%.*]] = shufflevector <4 x i32> [[IB]], <4 x i32> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[C]], <4 x i32> [[SA]], <4 x i32> [[SB]], !prof [[PROF0:![0-9]+]]
; CHECK-NEXT:    [[TMP1:%.*]] = shl <4 x i32> [[X]], [[SA]]
; CHECK-NEXT:    [[TMP2:%.*]] = shl <4 x i32> [[X]], [[SB]]
; CHECK-NEXT:    [[TMP3:%.*]] = select i1 [[C]], <4 x i32> [[TMP1]], <4 x i32> [[TMP2]], !prof [[PROF0]]
; CHECK-NEXT:    ret <4 x i32> [[TMP3]]
;
  %ia = insertelement <4 x i32> poison, i32 %a, i64 0
  %sa = shufflevector <4 x i32> %ia, <4 x i32> poison, <4 x i32> zeroinitializer
  %ib = insertelement <4 x i32> poison, i32 %b, i64 0
  %sb = shufflevector <4 x i32> %ib, <4 x i32> poison, <4 x i32> zeroinitializer
  %sel = select i1 %c, <4 x i32> %sa, <4 x i32> %sb, !prof !0
  %shl = shl <4 x i32> %x, %sel
  ret <4 x i32> %shl
}

