; CHECK:       [[REDUCTION]]:
; CHECK-NEXT:    [[BC:%.*]] = bitcast <vscale x 1 x i64> [[A]] to <vscale x 2 x i32>
; CHECK-NEXT:    ret <vscale x 2 x i32> [[BC]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret <vscale x 2 x i32> zeroinitializer
;
entry:
  br i1 %cond, label %reduction, label %exit

reduction:
