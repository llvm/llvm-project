; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='require<profile-summary>,function(codegenprepare)' -S -mtriple=riscv64 -mattr=+v < %s | FileCheck %s

; Simplified from the following vectorized early exit loop:
;
; short a[1024];
; long find(void) {
;   for (long i = 0; i < 1024; i++)
;     if (a[i] > 500)
;       return i;
;   return -1;
; }
;
; The compare for an early exit is also used after the loop to find the exiting
; lane, and shouldn't need to be recomputed there.
define i64 @dont_sink_vector_compare_into_exit(ptr %a) {
;
; CHECK-LABEL: define i64 @dont_sink_vector_compare_into_exit(
; CHECK-SAME: ptr [[A:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[VSCALE:%.*]] = call i64 @llvm.vscale.i64()
; CHECK-NEXT:    [[VF:%.*]] = mul nuw i64 [[VSCALE]], 8
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SRC:%.*]] = getelementptr inbounds i16, ptr [[A]], i64 [[IV]]
; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <vscale x 8 x i16>, ptr [[SRC]], align 16
; CHECK-NEXT:    [[COND:%.*]] = icmp sgt <vscale x 8 x i16> [[WIDE_LOAD]], splat (i16 500)
; CHECK-NEXT:    [[ANY:%.*]] = call i1 @llvm.vector.reduce.or.nxv8i1(<vscale x 8 x i1> [[COND]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw i64 [[IV]], [[VF]]
; CHECK-NEXT:    [[EXIT_COND:%.*]] = icmp eq i64 [[IV_NEXT]], 1024
; CHECK-NEXT:    [[DONE:%.*]] = or i1 [[ANY]], [[EXIT_COND]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[FIRST:%.*]] = call i64 @llvm.experimental.cttz.elts.i64.nxv8i1(<vscale x 8 x i1> [[COND]], i1 false)
; CHECK-NEXT:    [[RES:%.*]] = add i64 [[IV]], [[FIRST]]
; CHECK-NEXT:    ret i64 [[RES]]
;
entry:
  %vscale = call i64 @llvm.vscale()
  %vf = mul nuw i64 %vscale, 8
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %src = getelementptr inbounds i16, ptr %a, i64 %iv
  %wide.load = load <vscale x 8 x i16>, ptr %src
  %cond = icmp sgt <vscale x 8 x i16> %wide.load, splat (i16 500)
  %any = call i1 @llvm.vector.reduce.or(<vscale x 8 x i1> %cond)
  %iv.next = add nuw i64 %iv, %vf
  %exit.cond = icmp eq i64 %iv.next, 1024
  %done = or i1 %any, %exit.cond
  br i1 %done, label %exit, label %loop

exit:
  %first = call i64 @llvm.experimental.cttz.elts(<vscale x 8 x i1> %cond, i1 false)
  %res = add i64 %iv, %first
  ret i64 %res
}
