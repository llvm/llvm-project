; RUN: opt -mtriple riscv32 -mattr=+v -passes='require<profile-summary>,function(codegenprepare)' -S %s | FileCheck %s

; Test case to make sure we don't crash with 32-bit pointers after #226197.

define void @init_array_of_ptrs_to_structs(ptr noalias %arc_ptrs, ptr %arc_new, i32 %num_arcs) {
; CHECK-LABEL: define void @init_array_of_ptrs_to_structs(
; CHECK-SAME: ptr noalias [[ARC_PTRS:%.*]], ptr [[ARC_NEW:%.*]], i32 [[NUM_ARCS:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[VSCALE:%.*]] = tail call i32 @llvm.vscale.i32()
; CHECK-NEXT:    [[STEP:%.*]] = shl nuw nsw i32 [[VSCALE]], 2
; CHECK-NEXT:    [[DOTNOT:%.*]] = sub nsw i32 0, [[STEP]]
; CHECK-NEXT:    [[N_VEC:%.*]] = and i32 [[DOTNOT]], [[NUM_ARCS]]
; CHECK-NEXT:    [[SV:%.*]] = tail call <vscale x 4 x i32> @llvm.stepvector.nxv4i32()
; CHECK-NEXT:    [[TMP0:%.*]] = mul <vscale x 4 x i32> [[SV]], splat (i32 72)
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[ARC_NEW]], <vscale x 4 x i32> [[TMP0]]
; CHECK-NEXT:    [[TMP2:%.*]] = mul i32 [[STEP]], 72
; CHECK-NEXT:    [[DOTSPLATINSERT:%.*]] = insertelement <vscale x 4 x i32> poison, i32 [[TMP2]], i64 0
; CHECK-NEXT:    [[DOTSPLAT:%.*]] = shufflevector <vscale x 4 x i32> [[DOTSPLATINSERT]], <vscale x 4 x i32> poison, <vscale x 4 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
; CHECK:       [[VECTOR_BODY]]:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VEC_LSR_PHI:%.*]] = phi <vscale x 4 x ptr> [ [[TMP1]], %[[ENTRY]] ], [ [[TMP3:%.*]], %[[VECTOR_BODY]] ]
; CHECK-NEXT:    [[WIDE_GEP:%.*]] = getelementptr inbounds nuw [72 x i8], ptr [[ARC_NEW]], <vscale x 4 x i32> poison
; CHECK-NEXT:    [[ADDR:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[ARC_PTRS]], i32 [[INDEX]]
; CHECK-NEXT:    store <vscale x 4 x ptr> [[VEC_LSR_PHI]], ptr [[ADDR]], align 4
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i32 [[INDEX]], [[STEP]]
; CHECK-NEXT:    [[TMP3]] = getelementptr i8, <vscale x 4 x ptr> [[VEC_LSR_PHI]], <vscale x 4 x i32> [[DOTSPLAT]]
; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[INDEX_NEXT]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]]
; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    ret void
;
entry:
  %vscale = tail call i32 @llvm.vscale.i32()
  %step = shl nuw nsw i32 %vscale, 2
  %.not = sub nsw i32 0, %step
  %n.vec = and i32 %.not, %num_arcs
  %sv = tail call <vscale x 4 x i32> @llvm.stepvector.nxv4i32()
  %broadcast.splatinsert = insertelement <vscale x 4 x i32> poison, i32 %step, i64 0
  %broadcast.splat = shufflevector <vscale x 4 x i32> %broadcast.splatinsert, <vscale x 4 x i32> poison, <vscale x 4 x i32> zeroinitializer
  br label %vector.body

vector.body:
  %index = phi i32 [ 0, %entry ], [ %index.next, %vector.body ]
  %vec.ind = phi <vscale x 4 x i32> [ %sv, %entry ], [ %vec.ind.next, %vector.body ]
  %wide.gep = getelementptr inbounds nuw [72 x i8], ptr %arc_new, <vscale x 4 x i32> %vec.ind
  %addr = getelementptr inbounds nuw [4 x i8], ptr %arc_ptrs, i32 %index
  store <vscale x 4 x ptr> %wide.gep, ptr %addr, align 4
  %index.next = add nuw i32 %index, %step
  %vec.ind.next = add nuw nsw <vscale x 4 x i32> %vec.ind, %broadcast.splat
  %cmp = icmp eq i32 %index.next, %n.vec
  br i1 %cmp, label %middle.block, label %vector.body

middle.block:
  ret void
}
