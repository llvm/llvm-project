; Test extracting a value from an aggregate type followed by a bitcast.
define <2 x i32> @test_aggregate_src({ i64, i64 } %agg) {
; CHECK-LABEL: define <2 x i32> @test_aggregate_src(
; CHECK-SAME: { i64, i64 } [[AGG:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[VAL:%.*]] = extractvalue { i64, i64 } [[AGG]], 0
; CHECK-NEXT:    [[ISZERO:%.*]] = icmp eq i64 [[VAL]], 0
; CHECK-NEXT:    br i1 [[ISZERO]], label %[[EXIT:.*]], label %[[REDUCTION:.*]]
; CHECK:       [[REDUCTION]]:
; CHECK-NEXT:    [[BC:%.*]] = bitcast i64 [[VAL]] to <2 x i32>
; CHECK-NEXT:    ret <2 x i32> [[BC]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret <2 x i32> zeroinitializer
;
entry:
  %val = extractvalue { i64, i64 } %agg, 0
  %iszero = icmp eq i64 %val, 0
  br i1 %iszero, label %exit, label %reduction

reduction:
  %bc = bitcast i64 %val to <2 x i32>
  ret <2 x i32> %bc

exit:
  ret <2 x i32> zeroinitializer
}
