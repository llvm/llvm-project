; CHECK-NEXT:    [[TMP1:%.*]] = icmp slt i32 [[A]], [[B]]
; CHECK-NEXT:    br i1 [[TMP1]], label %[[LESS:.*]], label %[[CMP_NEXT:.*]], !prof [[PROF0:![0-9]+]]
; CHECK:       [[CMP_NEXT]]:
; CHECK-NEXT:    [[TMP2:%.*]] = icmp sgt i32 [[A]], [[B]]
; CHECK-NEXT:    br i1 [[TMP2]], label %[[GREATER:.*]], label %[[EQUAL:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:       [[EQUAL]]:
; CHECK-NEXT:    call void @equal()
; CHECK-NEXT:    ret void
; CHECK:       [[GREATER]]:
; CHECK-NEXT:    call void @greater()
; CHECK-NEXT:    ret void
; CHECK:       [[LESS]]:
