; The trap exit of the inner loop also exits the outer loop. After unswitching
; the invariant condition of the inner loop, the outer loop needs a dedicated
; exit block for the new edge from the inner loop's preheader.
define void @partial_unswitch_exits_parent(ptr %p, i64 %n, i64 %m) {
; CHECK-LABEL: define void @partial_unswitch_exits_parent(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i64 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i64 [[I]], 0
; CHECK-NEXT:    [[NEG_FR:%.*]] = freeze i1 [[NEG]]
; CHECK-NEXT:    br i1 [[NEG_FR]], label %[[TRAP_SPLIT:.*]], label %[[OUTER_HEADER_SPLIT:.*]]
; CHECK:       [[OUTER_HEADER_SPLIT]]:
; CHECK-NEXT:    br label %[[INNER_HEADER:.*]]
; CHECK:       [[INNER_HEADER]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER_HEADER_SPLIT]] ], [ [[J_NEXT:%.*]], %[[INNER_LATCH:.*]] ]
; CHECK-NEXT:    [[OOB:%.*]] = icmp uge i64 [[J]], [[M]]
; CHECK-NEXT:    [[C:%.*]] = or i1 false, [[OOB]]
; CHECK-NEXT:    br i1 [[C]], label %[[TRAP:.*]], label %[[INNER_LATCH]]
; CHECK:       [[INNER_LATCH]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[J]]
; CHECK-NEXT:    store i64 [[I]], ptr [[GEP]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[INNER_EC:%.*]] = icmp ult i64 [[J_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[INNER_EC]], label %[[INNER_HEADER]], label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[OUTER_HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    br label %[[TRAP_SPLIT1:.*]]
; CHECK:       [[TRAP_SPLIT]]:
; CHECK-NEXT:    br label %[[TRAP_SPLIT1]]
; CHECK:       [[TRAP_SPLIT1]]:
; CHECK-NEXT:    call void @llvm.trap()
; CHECK-NEXT:    unreachable
;
entry:
  br label %outer.header

outer.header:
  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
  %neg = icmp slt i64 %i, 0
  br label %inner.header

inner.header:
  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner.latch ]
  %oob = icmp uge i64 %j, %m
  %c = or i1 %neg, %oob
  br i1 %c, label %trap, label %inner.latch

inner.latch:
  %gep = getelementptr inbounds i64, ptr %p, i64 %j
  store i64 %i, ptr %gep
  %j.next = add nuw nsw i64 %j, 1
  %inner.ec = icmp ult i64 %j.next, %n
  br i1 %inner.ec, label %inner.header, label %outer.latch

outer.latch:
  %i.next = add nuw nsw i64 %i, 1
  %outer.ec = icmp ult i64 %i.next, %n
  br i1 %outer.ec, label %outer.header, label %exit

exit:
  ret void

trap:
  call void @llvm.trap()
  unreachable
}

