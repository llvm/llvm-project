; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='loop-mssa(simple-loop-unswitch)' -verify-memoryssa -S < %s | FileCheck %s

; Both successors of the invariant branch are the loop latch. Redirecting one
; of them to the latch exit must not be attempted, since the edge to the latch
; would remain and the DomTree delete update would be invalid.
; https://github.com/llvm/llvm-project/issues/238304

define i16 @both_succs_latch(i1 %c) {
; CHECK-LABEL: define i16 @both_succs_latch(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[EXIT:.*]]:
; CHECK-NEXT:    ret i16 0
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    br i1 [[C]], label %[[LATCH:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    br i1 false, label %[[HEADER]], label %[[EXIT]]
;
entry:
  br label %header

exit:
  ret i16 0

header:
  br i1 %c, label %latch, label %latch

latch:
  br i1 false, label %header, label %exit
}
