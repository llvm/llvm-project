%LayerData = type { [589824 x i16], [384 x i16], [147456 x i16] }

; Round 1 hoists %li (and its operands %l, %idx) to %header as the basis of %o.
; Round 2 picks %g as the basis of %l, which now sits in %header ahead of where
; %g would be hoisted to. %l must keep its own computation and %g must stay in
; %gain.
define void @hoisted_cand(ptr addrspace(1) %model, i64 %sum, i1 %c0, i1 %c1, i32 %n, ptr addrspace(1) %out) {
; CHECK-LABEL: define void @hoisted_cand(
; CHECK-SAME: ptr addrspace(1) [[MODEL:%.*]], i64 [[SUM:%.*]], i1 [[C0:%.*]], i1 [[C1:%.*]], i32 [[N:%.*]], ptr addrspace(1) [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    [[LAYER:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[LAYER_NEXT:%.*]], %[[JOIN:.*]] ]
; CHECK-NEXT:    [[IDX:%.*]] = zext i32 [[LAYER]] to i64
; CHECK-NEXT:    [[L:%.*]] = getelementptr [[LAYERDATA:%.*]], ptr addrspace(1) [[MODEL]], i64 [[IDX]]
; CHECK-NEXT:    [[LI:%.*]] = getelementptr i16, ptr addrspace(1) [[L]], i64 [[SUM]]
; CHECK-NEXT:    br i1 [[C0]], label %[[A:.*]], label %[[JOIN]]
; CHECK:       [[A]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[WIN:.*]], label %[[GAIN:.*]]
; CHECK:       [[GAIN]]:
; CHECK-NEXT:    [[IDX_G:%.*]] = zext i32 [[LAYER]] to i64
; CHECK-NEXT:    [[G:%.*]] = getelementptr [[LAYERDATA]], ptr addrspace(1) [[MODEL]], i64 [[IDX_G]], i32 1, i64 0
; CHECK-NEXT:    store volatile ptr addrspace(1) [[G]], ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    br label %[[WIN]]
; CHECK:       [[WIN]]:
; CHECK-NEXT:    store volatile ptr addrspace(1) [[LI]], ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[O:%.*]] = getelementptr i8, ptr addrspace(1) [[LI]], i64 1180416
; CHECK-NEXT:    store volatile ptr addrspace(1) [[O]], ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    [[LAYER_NEXT]] = add nuw i32 [[LAYER]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i32 [[LAYER_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[HEADER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %header
header:
  %layer = phi i32 [ 0, %entry ], [ %layer.next, %join ]
  br i1 %c0, label %a, label %join
a:
  br i1 %c1, label %win, label %gain
gain:
  %idx.g = zext i32 %layer to i64
  %g = getelementptr %LayerData, ptr addrspace(1) %model, i64 %idx.g, i32 1, i64 0
  store volatile ptr addrspace(1) %g, ptr addrspace(1) %out
  br label %win
win:
  %idx = zext i32 %layer to i64
  %l = getelementptr %LayerData, ptr addrspace(1) %model, i64 %idx
  %li = getelementptr i16, ptr addrspace(1) %l, i64 %sum
  store volatile ptr addrspace(1) %li, ptr addrspace(1) %out
  br label %join
join:
  %idx.o = zext i32 %layer to i64
  %o = getelementptr %LayerData, ptr addrspace(1) %model, i64 %idx.o, i32 2, i64 %sum
  store volatile ptr addrspace(1) %o, ptr addrspace(1) %out
  %layer.next = add nuw i32 %layer, 1
  %cmp = icmp ult i32 %layer.next, %n
  br i1 %cmp, label %header, label %exit
exit:
  ret void
}

