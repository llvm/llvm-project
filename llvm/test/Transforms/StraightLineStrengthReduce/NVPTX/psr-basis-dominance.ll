; Straight-line reduction: %idx folds to 0, so %l
; and %g share the same base and index. Round 1 hoists %li, %l, %idx to the
; entry block as the basis of %e; round 2 must not make %g the basis of %l.
define ptr addrspace(1) @hoisted_cand_entry(ptr addrspace(1) %model, i64 %sum, i1 %c0, i1 %c1) {
; CHECK-LABEL: define ptr addrspace(1) @hoisted_cand_entry(
