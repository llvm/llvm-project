; The bump is a multiple of the stride.
;
; foo(b * s);
; foo((b + 2) * s);
; foo((b + 4) * s);
;   =>
; mul0 = b * s;
; bump = s * 2;
; mul1 = mul0 + bump; // GVN ensures mul1 and mul2 use the same bump.
; mul2 = mul1 + bump;
define void @slsr3(i32 %b, i32 %s) {
; CHECK-LABEL: define void @slsr3(
; CHECK-SAME: i32 [[B:%.*]], i32 [[S:%.*]]) {
; CHECK-NEXT:    [[MUL0:%.*]] = mul i32 [[B]], [[S]]
; CHECK-NEXT:    call void @foo(i32 [[MUL0]])
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[S]], 1
; CHECK-NEXT:    [[MUL1:%.*]] = add i32 [[MUL0]], [[TMP1]]
; CHECK-NEXT:    call void @foo(i32 [[MUL1]])
; CHECK-NEXT:    [[MUL2:%.*]] = add i32 [[MUL1]], [[TMP1]]
; CHECK-NEXT:    call void @foo(i32 [[MUL2]])
; CHECK-NEXT:    ret void
;
  %mul0 = mul i32 %b, %s
  call void @foo(i32 %mul0)

  %b1 = add i32 %b, 2
  %mul1 = mul i32 %b1, %s
  call void @foo(i32 %mul1)

  %b2 = add i32 %b, 4
  %mul2 = mul i32 %b2, %s
  call void @foo(i32 %mul2)

  ret void
}

; Do not rewrite a candidate if its potential basis does not dominate it.
;
; if (cond)
;   foo(a * b);
; foo((a + 1) * b);
define void @not_dominate(i1 %cond, i32 %a, i32 %b) {
; CHECK-LABEL: define void @not_dominate(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A1:%.*]] = add i32 [[A]], 1
; CHECK-NEXT:    br i1 [[COND]], label %[[THEN:.*]], label %[[MERGE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[MUL0:%.*]] = mul i32 [[A]], [[B]]
; CHECK-NEXT:    call void @foo(i32 [[MUL0]])
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[MUL1:%.*]] = mul i32 [[A1]], [[B]]
; CHECK-NEXT:    call void @foo(i32 [[MUL1]])
; CHECK-NEXT:    ret void
;
entry:
  %a1 = add i32 %a, 1
  br i1 %cond, label %then, label %merge

then:
  %mul0 = mul i32 %a, %b
  call void @foo(i32 %mul0)
  br label %merge

merge:
  %mul1 = mul i32 %a1, %b
  call void @foo(i32 %mul1)
  ret void
}

