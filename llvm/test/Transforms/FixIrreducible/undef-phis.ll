; When every value moved into the new PHI in the guard block is undef, the PHI
; is replaced by undef, not by poison.

; https://github.com/llvm/llvm-project/issues/235378
; The only value of %p moved into the guard block is undef from %entry.
define i32 @moved_undef(i1 %c, i1 %d) {
; CHECK-LABEL: define i32 @moved_undef(
; CHECK-SAME: i1 [[C:%.*]], i1 [[D:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C_INV:%.*]] = xor i1 [[C]], true
; CHECK-NEXT:    br label %[[IRR_GUARD:.*]]
; CHECK:       [[A:.*]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ 0, %[[B:.*]] ], [ undef, %[[IRR_GUARD]] ]
; CHECK-NEXT:    br i1 [[D]], label %[[EXIT:.*]], label %[[IRR_GUARD]]
; CHECK:       [[B]]:
; CHECK-NEXT:    br label %[[A]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[Z:%.*]] = and i32 [[P]], 0
; CHECK-NEXT:    ret i32 [[Z]]
; CHECK:       [[IRR_GUARD]]:
; CHECK-NEXT:    [[GUARD_B:%.*]] = phi i1 [ true, %[[A]] ], [ [[C_INV]], %[[ENTRY]] ]
; CHECK-NEXT:    br i1 [[GUARD_B]], label %[[B]], label %[[A]]
;
entry:
  br i1 %c, label %a, label %b

a:
  %p = phi i32 [ undef, %entry ], [ 0, %b ]
  br i1 %d, label %exit, label %b

b:
  br label %a

exit:
  %z = and i32 %p, 0
  ret i32 %z
}

; %a is the header of the irreducible cycle {a, b} and has a self-loop, which
; is redirected through the guard block. Every value of %p is undef.
define i32 @self_loop_moved_undef(i1 %c, i1 %d, i1 %e) {
; CHECK-LABEL: define i32 @self_loop_moved_undef(
; CHECK-SAME: i1 [[C:%.*]], i1 [[D:%.*]], i1 [[E:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C_INV:%.*]] = xor i1 [[C]], true
; CHECK-NEXT:    br label %[[IRR_GUARD:.*]]
; CHECK:       [[A:.*]]:
; CHECK-NEXT:    br i1 [[D]], label %[[IRR_GUARD]], label %[[A2:.*]]
; CHECK:       [[A2]]:
; CHECK-NEXT:    br i1 [[E]], label %[[B:.*]], label %[[EXIT:.*]]
; CHECK:       [[B]]:
; CHECK-NEXT:    br label %[[IRR_GUARD]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[Z:%.*]] = and i32 [[P_MOVED:%.*]], 0
; CHECK-NEXT:    ret i32 [[Z]]
; CHECK:       [[IRR_GUARD]]:
; CHECK-NEXT:    [[P_MOVED]] = phi i32 [ undef, %[[B]] ], [ [[P_MOVED]], %[[A]] ], [ undef, %[[ENTRY]] ]
; CHECK-NEXT:    [[GUARD_A:%.*]] = phi i1 [ true, %[[B]] ], [ true, %[[A]] ], [ [[C_INV]], %[[ENTRY]] ]
; CHECK-NEXT:    br i1 [[GUARD_A]], label %[[A]], label %[[B]]
;
entry:
