  %L.phi = phi i32 [ %X, %entry ], [ %R.phi, %right ]
  %L = add i32 %L.phi, 1
  br i1 %PredLeft, label %right, label %exit

right:
  %R.phi = phi i32 [ %Y, %entry ], [ %L, %left ]
  br i1 %PredRight, label %left, label %exit

exit:
  %Z = phi i32 [ %L, %left ], [ %R.phi, %right ]
  ret i32 %Z
}
