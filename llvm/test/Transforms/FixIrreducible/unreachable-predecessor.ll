define void @unreachable_predecessor_ssa(i1 %c, i32 %seed, ptr %out) {
; CHECK-LABEL: define void @unreachable_predecessor_ssa(
; CHECK-SAME: i1 [[C:%.*]], i32 [[SEED:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C_INV:%.*]] = xor i1 [[C]], true
; CHECK-NEXT:    br label %[[IRR_GUARD:.*]]
; CHECK:       [[A:.*]]:
; CHECK-NEXT:    [[X:%.*]] = add i32 [[SEED]], 1
; CHECK-NEXT:    br label %[[D:.*]]
; CHECK:       [[D]]:
; CHECK-NEXT:    store i32 [[X]], ptr [[OUT]], align 4
; CHECK-NEXT:    br label %[[IRR_GUARD]]
; CHECK:       [[B:.*]]:
; CHECK-NEXT:    br label %[[A]]
; CHECK:       [[DEAD:.*]]:
; CHECK-NEXT:    br i1 [[C]], label %[[IRR_GUARD]], label %[[D]]
; CHECK:       [[IRR_GUARD]]:
; CHECK-NEXT:    [[GUARD_B:%.*]] = phi i1 [ true, %[[D]] ], [ [[C_INV]], %[[ENTRY]] ], [ false, %[[DEAD]] ]
; CHECK-NEXT:    br i1 [[GUARD_B]], label %[[B]], label %[[A]]
;
entry:
  br i1 %c, label %a, label %b
a:
  %x = add i32 %seed, 1
  br label %d
d:
  store i32 %x, ptr %out
  br label %b
b:
