; RUN: opt < %s -passes=fix-irreducible -S | FileCheck %s

; FixIrreducible redirects only the internal edges to the cycle header through
; the new guard block, not the internal edges to other cycle entries. A block
; can have both kinds of edge. Only the PHI entries for the redirected edges
; move to the guard block.

; In the cycle {b2, b5} with header b2, b5 -> b2 is redirected but the
; self-loop b5 -> b5 is not, so %p5 keeps its entry for %b5.
define void @self_loop_not_redirected(i1 %c0, i1 %c1, i32 %x, ptr addrspace(1) %out) {
; CHECK-LABEL: define void @self_loop_not_redirected(
; CHECK-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i32 [[X:%.*]], ptr addrspace(1) [[OUT:%.*]]) {
; CHECK-NEXT:  [[B0:.*]]:
; CHECK-NEXT:    [[C0_INV:%.*]] = xor i1 [[C0]], true
; CHECK-NEXT:    br label %[[IRR_GUARD:.*]]
; CHECK:       [[B2:.*]]:
; CHECK-NEXT:    br label %[[B5:.*]]
; CHECK:       [[B5]]:
; CHECK-NEXT:    [[P5:%.*]] = phi i32 [ [[P5_NEXT:%.*]], %[[B5]] ], [ 1, %[[B2]] ], [ [[P5_MOVED:%.*]], %[[IRR_GUARD]] ]
; CHECK-NEXT:    [[P5_NEXT]] = add i32 [[P5]], 1
; CHECK-NEXT:    store volatile i32 [[P5_NEXT]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    br i1 [[C1]], label %[[IRR_GUARD]], label %[[B5]]
; CHECK:       [[IRR_GUARD]]:
; CHECK-NEXT:    [[P5_MOVED]] = phi i32 [ poison, %[[B5]] ], [ [[X]], %[[B0]] ]
; CHECK-NEXT:    [[GUARD_B2:%.*]] = phi i1 [ true, %[[B5]] ], [ [[C0_INV]], %[[B0]] ]
; CHECK-NEXT:    br i1 [[GUARD_B2]], label %[[B2]], label %[[B5]]
;
b0:
  br i1 %c0, label %b5, label %b2

b2:
  br label %b5

b5:
  %p5 = phi i32 [ %p5.next, %b5 ], [ 1, %b2 ], [ %x, %b0 ]
  %p5.next = add i32 %p5, 1
  store volatile i32 %p5.next, ptr addrspace(1) %out
  br i1 %c1, label %b2, label %b5
}

; In the cycle {b1, b2, b3} with header b2, b3 -> b2 is redirected but
; b3 -> b1 is not, so %x keeps its entry for %b3.
define void @non_header_entry(i1 %c0, i1 %c1, i1 %c2, i1 %c3, ptr %out) {
; CHECK-LABEL: define void @non_header_entry(
; CHECK-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i1 [[C3:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C2_INV:%.*]] = xor i1 [[C2]], true
; CHECK-NEXT:    [[C0_INV:%.*]] = xor i1 [[C0]], true
; CHECK-NEXT:    br label %[[IRR_GUARD:.*]]
; CHECK:       [[B1:.*]]:
; CHECK-NEXT:    [[X:%.*]] = phi i32 [ 3, %[[B3:.*]] ], [ [[X_MOVED2:%.*]], %[[IRR_GUARD1:.*]] ]
; CHECK-NEXT:    store volatile i32 [[X]], ptr [[OUT]], align 4
; CHECK-NEXT:    br i1 [[C1]], label %[[IRR_GUARD1]], label %[[EXIT:.*]]
; CHECK:       [[B2:.*]]:
; CHECK-NEXT:    br label %[[IRR_GUARD1]]
; CHECK:       [[B3]]:
; CHECK-NEXT:    br i1 [[C3]], label %[[B1]], label %[[IRR_GUARD]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
; CHECK:       [[IRR_GUARD]]:
; CHECK-NEXT:    [[X_MOVED:%.*]] = phi i32 [ poison, %[[B3]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[GUARD_B2:%.*]] = phi i1 [ true, %[[B3]] ], [ [[C0_INV]], %[[ENTRY]] ]
; CHECK-NEXT:    br i1 [[GUARD_B2]], label %[[B2]], label %[[IRR_GUARD1]]
; CHECK:       [[IRR_GUARD1]]:
; CHECK-NEXT:    [[X_MOVED2]] = phi i32 [ poison, %[[B1]] ], [ 2, %[[B2]] ], [ [[X_MOVED]], %[[IRR_GUARD]] ]
; CHECK-NEXT:    [[GUARD_B3:%.*]] = phi i1 [ true, %[[B1]] ], [ [[C2_INV]], %[[B2]] ], [ false, %[[IRR_GUARD]] ]
; CHECK-NEXT:    br i1 [[GUARD_B3]], label %[[B3]], label %[[B1]]
;
entry:
  br i1 %c0, label %b1, label %b2

b1:
  %x = phi i32 [ 0, %entry ], [ 2, %b2 ], [ 3, %b3 ]
  store volatile i32 %x, ptr %out
  br i1 %c1, label %b3, label %exit

b2:
  br i1 %c2, label %b1, label %b3

b3:
  br i1 %c3, label %b1, label %b2

exit:
  ret void
}
