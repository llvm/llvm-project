; Before. Entry count 100. Labels are absolute counts.
; right branches back to left. Both exits are the same block.
;
;                     +----------------------------+
;                     v                            |
; [entry] --25--> [left] --80--+                   |
;    |              |          v                   |
;    |              v          |                   |
;    |           [exit]        |                   |
;    +-------------75-----> [right]----------------+
;                              |
;                              v
;                           [exit]
;
; entry->left  = 100 * 10/40 = 25
; entry->right = 100 * 30/40 = 75
; left->right scales to 80
;
; After. One [left]. entry's two edges and left->right are redirected
; through [guard]. right->left is not, so it still targets [left].
; Both exits stay and are the same block.
; In: 100 + 80 = 180. Out: 155 + 25 = 180.
; 155 = 75 + 80 to right. 25 is entry->left. 80 is left->guard.
;
;                                   +-----------------+
;                                   v                 |
; [entry] --100--> [guard] --25--> [left]             |
;                     | ^           |  |              |
;                     | |           |  |              |
;                     | +----80-----+  |              |
;                    155             [exit]           |
;                     |                               |
;                     v                               |
;                  [right]----------------------------+
;                     |
;                     v
;                  [exit]
define void @weights(i1 %PredEntry, i1 %PredLeft, i1 %PredRight) !prof !3 {
; CHECK-LABEL: define void @weights(
; CHECK-SAME: i1 [[PREDENTRY:%.*]], i1 [[PREDLEFT:%.*]], i1 [[PREDRIGHT:%.*]]) !prof [[PROF0:![0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[PREDENTRY_INV:%.*]] = xor i1 [[PREDENTRY]], true
; CHECK-NEXT:    br label %[[IRR_GUARD:.*]]
; CHECK:       [[LEFT:.*]]:
; CHECK-NEXT:    br i1 [[PREDLEFT]], label %[[IRR_GUARD]], label %[[EXIT:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:       [[RIGHT:.*]]:
; CHECK-NEXT:    br i1 [[PREDRIGHT]], label %[[LEFT]], label %[[EXIT]], !prof [[PROF2:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
; CHECK:       [[IRR_GUARD]]:
; CHECK-NEXT:    [[GUARD_RIGHT:%.*]] = phi i1 [ true, %[[LEFT]] ], [ [[PREDENTRY_INV]], %[[ENTRY]] ]
; CHECK-NEXT:    br i1 [[GUARD_RIGHT]], label %[[RIGHT]], label %[[LEFT]], !prof [[PROF3:![0-9]+]]
;
entry:
  br i1 %PredEntry, label %left, label %right, !prof !0

left:
  br i1 %PredLeft, label %right, label %exit, !prof !1

right:
  br i1 %PredRight, label %left, label %exit, !prof !2

exit:
  ret void
}

