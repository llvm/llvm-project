; RUN: opt %s -passes='function(scalarizer<load-store>,dce)' -S | FileCheck %s

; Test that a phi whose incoming value is an insertelement with an
; out-of-bounds index doesn't crash the scalarizer.
define <2 x i32> @phi_oob_insertelement() {
; CHECK-LABEL: define <2 x i32> @phi_oob_insertelement() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    br label %[[LOOP]]
;
entry:
  br label %loop

loop:
  %p = phi <2 x i32> [ zeroinitializer, %entry ], [ %ins, %loop ]
  %ins = insertelement <2 x i32> zeroinitializer, i32 0, i32 2
  br label %loop
}
