; RUN: opt < %s -passes=globalopt -S | FileCheck %s

; The alignment of the store of the allocation's address into the global is not
; an access to the allocation, so it should not affect the new global's
; alignment.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@g = internal global ptr null

;.
; CHECK: @g.body = internal unnamed_addr global [8 x i8] undef{{$}}
;.
define void @init() {
; CHECK-LABEL: define void @init() local_unnamed_addr {
; CHECK-NEXT:    ret void
;
  %m = call noalias ptr @malloc(i64 8)
  store ptr %m, ptr @g, align 32
  ret void
}

define void @store(i8 %c) {
; CHECK-LABEL: define void @store(
; CHECK-SAME: i8 [[C:%.*]]) local_unnamed_addr {
; CHECK-NEXT:    store i8 [[C]], ptr @g.body, align 1
; CHECK-NEXT:    ret void
;
  %p = load ptr, ptr @g, align 8
  store i8 %c, ptr %p, align 1
  ret void
}

define i8 @load(i64 %i) {
; CHECK-LABEL: define i8 @load(
; CHECK-SAME: i64 [[I:%.*]]) local_unnamed_addr {
; CHECK-NEXT:    [[Q:%.*]] = getelementptr i8, ptr @g.body, i64 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i8, ptr [[Q]], align 1
; CHECK-NEXT:    ret i8 [[V]]
;
  %p = load ptr, ptr @g, align 8
  %q = getelementptr i8, ptr %p, i64 %i
  %v = load i8, ptr %q, align 1
  ret i8 %v
}

declare noalias ptr @malloc(i64) allockind("alloc,uninitialized") allocsize(0)
