  { i32, ptr, ptr } { i32 65535, ptr @ctor_exact_fit_nonzero_offset, ptr null },
  { i32, ptr, ptr } { i32 65535, ptr @ctor_one_byte_overflow, ptr null },
  { i32, ptr, ptr } { i32 65535, ptr @ctor_scalable_load, ptr null }
]

