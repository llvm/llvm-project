target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

%top = type <{ { i32, i32 }, i64 }>

; 1. Straddling 8-byte load at non-zero offset (Offset = 4 in 8-byte member) -> Must bail out
@g1 = global %top zeroinitializer
@r1 = global i64 0
@r1_ok = global i64 0

; 2. Straddling 8-byte load at zero offset (Offset = 0 in mutated 4-byte i32 member) -> Must bail out
@g2 = global %top zeroinitializer
@r2 = global i64 0

; 3. Exact-fit 4-byte load at non-zero offset (Offset = 4 in 8-byte member, 4 bytes remaining) -> Must fold!
@g3 = global %top zeroinitializer
@r3_exact = global i32 99
@r3_second = global i64 0

; 4. Partial 4-byte load at Offset = 6 (only 2 bytes left in 8-byte member) -> Must bail out
@g4 = global %top zeroinitializer
@r4 = global i32 0

; 5. Scalable vector load from a fixed-size aggregate member -> Must bail out
@g5 = global %top zeroinitializer
@r5 = global i32 0

