; CHECK-NEXT:    ret <8 x float> [[V]]
;
  %p = load ptr, ptr @aligned, align 8
  %v = load <8 x float>, ptr %p, align 32
  ret <8 x float> %v
}

define void @init_unaligned() {
; CHECK-LABEL: define void @init_unaligned() local_unnamed_addr {
