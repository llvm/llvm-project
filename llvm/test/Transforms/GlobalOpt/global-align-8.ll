; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals all --version 6
; RUN: opt < %s -passes=globalopt -S | FileCheck %s

; Accesses through PHIs and address space casts of the pointers loaded from the
; global should also be considered for the new global's alignment.
; FIXME: The new globals are not aligned to 16, which makes the stores UB.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@phi = internal global ptr null
@ascast = internal global ptr null

;.
; CHECK: @phi.body = internal unnamed_addr global [16 x i8] undef
; CHECK: @ascast.body = internal unnamed_addr global [16 x i8] undef
;.
define void @init() {
; CHECK-LABEL: define void @init() local_unnamed_addr {
; CHECK-NEXT:    ret void
;
  %m1 = call noalias ptr @malloc(i64 16)
  store ptr %m1, ptr @phi, align 8
  %m2 = call noalias ptr @malloc(i64 16)
  store ptr %m2, ptr @ascast, align 8
  ret void
}

define void @store_phi(<4 x i32> %v, i1 %c) {
; CHECK-LABEL: define void @store_phi(
; CHECK-SAME: <4 x i32> [[V:%.*]], i1 [[C:%.*]]) local_unnamed_addr {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[END:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    store <4 x i32> [[V]], ptr @phi.body, align 16
; CHECK-NEXT:    ret void
;
entry:
  %p1 = load ptr, ptr @phi, align 8
  br i1 %c, label %then, label %end
then:
  %p2 = load ptr, ptr @phi, align 8
  br label %end
end:
  %p = phi ptr [ %p1, %entry ], [ %p2, %then ]
  store <4 x i32> %v, ptr %p, align 16
  ret void
}

define void @store_ascast(<4 x i32> %v) {
; CHECK-LABEL: define void @store_ascast(
; CHECK-SAME: <4 x i32> [[V:%.*]]) local_unnamed_addr {
; CHECK-NEXT:    store <4 x i32> [[V]], ptr addrspace(1) addrspacecast (ptr @ascast.body to ptr addrspace(1)), align 16
; CHECK-NEXT:    ret void
;
  %p = load ptr, ptr @ascast, align 8
  %q = addrspacecast ptr %p to ptr addrspace(1)
  store <4 x i32> %v, ptr addrspace(1) %q, align 16
  ret void
}

define i8 @load(i64 %i) {
; CHECK-LABEL: define i8 @load(
; CHECK-SAME: i64 [[I:%.*]]) local_unnamed_addr {
; CHECK-NEXT:    [[Q1:%.*]] = getelementptr i8, ptr @phi.body, i64 [[I]]
; CHECK-NEXT:    [[V1:%.*]] = load i8, ptr [[Q1]], align 1
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr i8, ptr @ascast.body, i64 [[I]]
; CHECK-NEXT:    [[V2:%.*]] = load i8, ptr [[Q2]], align 1
; CHECK-NEXT:    [[V:%.*]] = add i8 [[V1]], [[V2]]
; CHECK-NEXT:    ret i8 [[V]]
;
  %p1 = load ptr, ptr @phi, align 8
  %q1 = getelementptr i8, ptr %p1, i64 %i
  %v1 = load i8, ptr %q1, align 1
  %p2 = load ptr, ptr @ascast, align 8
  %q2 = getelementptr i8, ptr %p2, i64 %i
  %v2 = load i8, ptr %q2, align 1
  %v = add i8 %v1, %v2
  ret i8 %v
}

declare noalias ptr @malloc(i64) allockind("alloc,uninitialized") allocsize(0)
