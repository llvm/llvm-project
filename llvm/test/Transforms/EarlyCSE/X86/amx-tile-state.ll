; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes='early-cse<memssa>' < %s | FileCheck %s

; The AMX intrinsics model the tile registers and configuration as target_mem0.
; Two reads of a tile row with no tile write in between are one read; a tile
; load or dot product in between is a write, so both reads stay. Ordinary memory
; that a tile operation doesn't write is still forwarded across it.

target triple = "x86_64-unknown-linux-gnu"

define <16 x i32> @cse_row_reads(i32 %row) {
; CHECK-LABEL: define <16 x i32> @cse_row_reads(
; CHECK-SAME: i32 [[ROW:%.*]]) {
; CHECK-NEXT:    [[B:%.*]] = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 [[ROW]])
; CHECK-NEXT:    [[R:%.*]] = add <16 x i32> [[B]], [[B]]
; CHECK-NEXT:    ret <16 x i32> [[R]]
;
  %a = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 %row)
  %b = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 %row)
  %r = add <16 x i32> %a, %b
  ret <16 x i32> %r
}

define <16 x i32> @no_cse_across_tile_load(ptr %p, i32 %row) {
; CHECK-LABEL: define <16 x i32> @no_cse_across_tile_load(
; CHECK-SAME: ptr [[P:%.*]], i32 [[ROW:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 [[ROW]])
; CHECK-NEXT:    call void @llvm.x86.tileloadd64(i8 0, ptr [[P]], i64 64)
; CHECK-NEXT:    [[B:%.*]] = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 [[ROW]])
; CHECK-NEXT:    [[R:%.*]] = add <16 x i32> [[A]], [[B]]
; CHECK-NEXT:    ret <16 x i32> [[R]]
;
  %a = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 %row)
  call void @llvm.x86.tileloadd64(i8 0, ptr %p, i64 64)
  %b = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 %row)
  %r = add <16 x i32> %a, %b
  ret <16 x i32> %r
}

define <16 x i32> @no_cse_across_dot_product(i32 %row) {
; CHECK-LABEL: define <16 x i32> @no_cse_across_dot_product(
; CHECK-SAME: i32 [[ROW:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 [[ROW]])
; CHECK-NEXT:    call void @llvm.x86.tdpbssd(i8 0, i8 1, i8 2)
; CHECK-NEXT:    [[B:%.*]] = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 [[ROW]])
; CHECK-NEXT:    [[R:%.*]] = add <16 x i32> [[A]], [[B]]
; CHECK-NEXT:    ret <16 x i32> [[R]]
;
  %a = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 %row)
  call void @llvm.x86.tdpbssd(i8 0, i8 1, i8 2)
  %b = call <16 x i32> @llvm.x86.tilemovrow(i8 0, i32 %row)
  %r = add <16 x i32> %a, %b
  ret <16 x i32> %r
}

define i64 @forward_across_tile_load(ptr %p, ptr %q) {
; CHECK-LABEL: define i64 @forward_across_tile_load(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:    store i64 42, ptr [[Q]], align 8
; CHECK-NEXT:    call void @llvm.x86.tileloadd64(i8 0, ptr [[P]], i64 64)
; CHECK-NEXT:    ret i64 42
;
  store i64 42, ptr %q, align 8
  call void @llvm.x86.tileloadd64(i8 0, ptr %p, i64 64)
  %v = load i64, ptr %q, align 8
  ret i64 %v
}

define i64 @no_forward_across_tile_store(ptr %p, ptr %q) {
; CHECK-LABEL: define i64 @no_forward_across_tile_store(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
; CHECK-NEXT:    store i64 42, ptr [[Q]], align 8
; CHECK-NEXT:    call void @llvm.x86.tilestored64(i8 0, ptr [[P]], i64 64)
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[Q]], align 8
; CHECK-NEXT:    ret i64 [[V]]
;
  store i64 42, ptr %q, align 8
  call void @llvm.x86.tilestored64(i8 0, ptr %p, i64 64)
  %v = load i64, ptr %q, align 8
  ret i64 %v
}

declare <16 x i32> @llvm.x86.tilemovrow(i8 immarg, i32)
declare void @llvm.x86.tileloadd64(i8 immarg, ptr, i64)
declare void @llvm.x86.tilestored64(i8 immarg, ptr, i64)
declare void @llvm.x86.tdpbssd(i8 immarg, i8 immarg, i8 immarg)
