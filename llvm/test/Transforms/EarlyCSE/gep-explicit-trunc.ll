; CHECK-NEXT:    [[MASKED:%.*]] = zext i32 [[IDX]] to i64
; CHECK-NEXT:    [[DSTIDX:%.*]] = add i32 [[DISTANCE]], [[IDX]]
; CHECK-NEXT:    [[DSTIDX64:%.*]] = zext i32 [[DSTIDX]] to i64
; CHECK-NEXT:    [[SRC:%.*]] = getelementptr inbounds [24 x i8], ptr [[BASE]], i64 [[MASKED]], i64 8
; CHECK-NEXT:    [[DST:%.*]] = getelementptr inbounds [24 x i8], ptr [[BASE]], i64 [[DSTIDX64]], i64 8
; CHECK-NEXT:    [[A:%.*]] = load i8, ptr [[SRC]], align 1
; CHECK-NEXT:    [[LO:%.*]] = and i8 [[A]], 63
; CHECK-NEXT:    [[B:%.*]] = load i8, ptr [[DST]], align 1
; CHECK-NEXT:    [[HI:%.*]] = and i8 [[B]], -64
