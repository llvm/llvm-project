; PR #239541: the Else path may carry a real value, not just poison.
; Encountering %w must reject the candidate, including the earlier poison
; input. Value and condition PHIs are aligned here, so the failure specifically
; tests the real-value check rather than a mismatched PHI chain.
define i64 @real_else_input(i1 %c0, i1 %c1, i32 %a, i64 %x, i64 %w) {
; CHECK-LABEL: define i64 @real_else_input(
; CHECK-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i32 [[A:%.*]], i64 [[X:%.*]], i64 [[W:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C0]], label %[[FLOW:.*]], label %[[CHECK:.*]]
; CHECK:       [[CHECK]]:
; CHECK-NEXT:    br i1 [[C1]], label %[[THEN:.*]], label %[[REJECT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[FLOW]]
; CHECK:       [[REJECT]]:
; CHECK-NEXT:    br label %[[FLOW]]
; CHECK:       [[FLOW]]:
; CHECK-NEXT:    [[V:%.*]] = phi i64 [ poison, %[[ENTRY]] ], [ [[X]], %[[THEN]] ], [ [[W]], %[[REJECT]] ]
; CHECK-NEXT:    [[TAKE_ELSE:%.*]] = phi i1 [ true, %[[ENTRY]] ], [ false, %[[THEN]] ], [ true, %[[REJECT]] ]
; CHECK-NEXT:    br i1 [[TAKE_ELSE]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[V]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br i1 %c0, label %flow, label %check
check:
  br i1 %c1, label %then, label %reject
then:
  br label %flow
reject:
  br label %flow
flow:
  %v = phi i64 [ poison, %entry ], [ %x, %then ], [ %w, %reject ]
  %take_else = phi i1 [ true, %entry ], [ false, %then ], [ true, %reject ]
  br i1 %take_else, label %else, label %merge
else:
  %e = zext i32 %a to i64
  br label %merge
merge:
  %r = phi i64 [ %v, %flow ], [ %e, %else ]
  ret i64 %r
}
