; PR #149744: a zero-cost PHI cannot be moved like an ordinary instruction.
; Its incoming blocks describe edges into Else, not edges into a hoist block.
define i64 @phi_else_value(i1 %c, i64 %a, i64 %x) {
; CHECK-LABEL: define i64 @phi_else_value(
; CHECK-SAME: i1 [[C:%.*]], i64 [[A:%.*]], i64 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[FLOW:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[FLOW]]
; CHECK:       [[FLOW]]:
; CHECK-NEXT:    [[V:%.*]] = phi i64 [ [[X]], %[[THEN]] ], [ poison, %[[ENTRY]] ]
; CHECK-NEXT:    [[TAKE_ELSE:%.*]] = phi i1 [ false, %[[THEN]] ], [ true, %[[ENTRY]] ]
; CHECK-NEXT:    br i1 [[TAKE_ELSE]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    [[E:%.*]] = phi i64 [ [[A]], %[[FLOW]] ]
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[V]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br i1 %c, label %then, label %flow
then:
  br label %flow
flow:
  %v = phi i64 [ %x, %then ], [ poison, %entry ]
  %take_else = phi i1 [ false, %then ], [ true, %entry ]
  br i1 %take_else, label %else, label %merge
else:
  %e = phi i64 [ %a, %flow ]
  br label %merge
merge:
  %r = phi i64 [ %v, %flow ], [ %e, %else ]
  ret i64 %r
}

; PR #183792: an additional Merge predecessor is outside the triangle.
; Use a cast here so shuffle exclusion cannot hide a missing CFG guard.
define i64 @extra_merge_predecessor(i1 %bypass, i1 %c, i32 %a, i64 %x) {
; CHECK-LABEL: define i64 @extra_merge_predecessor(
; CHECK-SAME: i1 [[BYPASS:%.*]], i1 [[C:%.*]], i32 [[A:%.*]], i64 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[BYPASS]], label %[[EXTRA:.*]], label %[[PREP:.*]]
; CHECK:       [[PREP]]:
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[FLOW:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    br label %[[FLOW]]
; CHECK:       [[FLOW]]:
; CHECK-NEXT:    [[V:%.*]] = phi i64 [ [[X]], %[[THEN]] ], [ poison, %[[PREP]] ]
; CHECK-NEXT:    [[TAKE_ELSE:%.*]] = phi i1 [ false, %[[THEN]] ], [ true, %[[PREP]] ]
; CHECK-NEXT:    br i1 [[TAKE_ELSE]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[EXTRA]]:
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[V]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ], [ 7, %[[EXTRA]] ]
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  br i1 %bypass, label %extra, label %prep
prep:
  br i1 %c, label %then, label %flow
then:
  br label %flow
flow:
  %v = phi i64 [ %x, %then ], [ poison, %prep ]
  %take_else = phi i1 [ false, %then ], [ true, %prep ]
  br i1 %take_else, label %else, label %merge
else:
  %e = zext i32 %a to i64
  br label %merge
extra:
