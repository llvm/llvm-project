; Static allocas that are only used by a region that never returns move into
; the outlined function, regardless of lifetime markers: the region runs at
; most once per call of the parent function.

declare void @cold_fmt(ptr) cold noreturn
declare void @cold_log(ptr) cold
declare void @fmt_u32(ptr)
declare void @fmt_i32(ptr)
declare void @use(ptr)
declare i32 @setjmp(ptr) returns_twice

@g = global i32 0

; As in a formatting panic: the arguments are written to the stack, and
; formatting reads them through a pointer (with lifetime.start but no
; lifetime.end before unreachable). The two outlined functions only differ in a
; constant, so GlobalMergeFunc and MergeFunctions merge them.
define i32 @mono_u32(i32 %x) {
entry:
  %arg_buf = alloca [2 x ptr], align 8
  %fmt_buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  ret i32 %x

cold:
  call void @llvm.lifetime.start.p0(ptr nonnull %arg_buf)
  call void @llvm.lifetime.start.p0(ptr nonnull %fmt_buf)
  store ptr @fmt_u32, ptr %arg_buf, align 8
  store ptr %arg_buf, ptr %fmt_buf, align 8
  call void @cold_fmt(ptr nonnull %fmt_buf)
  unreachable
}

define i32 @mono_i32(i32 %x) {
entry:
  %arg_buf = alloca [2 x ptr], align 8
  %fmt_buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  ret i32 %x

cold:
  call void @llvm.lifetime.start.p0(ptr nonnull %arg_buf)
  call void @llvm.lifetime.start.p0(ptr nonnull %fmt_buf)
  store ptr @fmt_i32, ptr %arg_buf, align 8
  store ptr %arg_buf, ptr %fmt_buf, align 8
  call void @cold_fmt(ptr nonnull %fmt_buf)
  unreachable
}

; %buf has no lifetime intrinsics at all and is only used in the non-returning
; cold block, so it moves into the outlined function.
define i32 @no_lifetime_markers(i32 %x) {
entry:
  %buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  ret i32 %x

cold:
  store ptr @fmt_u32, ptr %buf, align 8
  call void @cold_fmt(ptr nonnull %buf)
  unreachable
}

; %buf has lifetime markers in the entry and hot return blocks, but its only
; real uses are in the non-returning cold block: %buf moves into the outlined
; function and its outer lifetime markers are erased.
define i32 @outer_lifetime_markers(i32 %x) {
entry:
  %buf = alloca [2 x ptr], align 8
  call void @llvm.lifetime.start.p0(ptr nonnull %buf)
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  call void @llvm.lifetime.end.p0(ptr nonnull %buf)
  ret i32 %x

cold:
  store ptr @fmt_u32, ptr %buf, align 8
  call void @cold_fmt(ptr nonnull %buf)
  unreachable
}

; Multi-block cold diamond whose internal edges stay in the region and whose
; exit ends in unreachable: %buf moves into the outlined function.
define i32 @multi_block_noreturn(i32 %x, i1 %c2) {
entry:
  %buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold.entry

hot:
  ret i32 %x

cold.entry:
  br i1 %c2, label %cold.a, label %cold.b

cold.a:
  store ptr @fmt_u32, ptr %buf, align 8
  br label %cold.end

cold.b:
  store ptr @fmt_i32, ptr %buf, align 8
  br label %cold.end

cold.end:
  call void @cold_fmt(ptr nonnull %buf)
  unreachable
}

; Multi-block cold region where one branch returns to %hot: control can leave
; the region, so %buf (without lifetime markers) must stay in the caller.
define i32 @multi_block_may_return(i32 %x, i1 %c2) {
entry:
  %buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold.entry

hot:
  ret i32 %x

cold.entry:
  store ptr @fmt_u32, ptr %buf, align 8
  call void @cold_log(ptr nonnull %buf)
  br i1 %c2, label %cold.abort, label %hot

cold.abort:
  call void @cold_fmt(ptr nonnull %buf)
  unreachable
}

; Dynamic allocas are not static entry-block stack slots, so %dyn stays in the
; caller even though the cold block never returns.
define i32 @dynamic_alloca(i32 %x, i64 %n) {
entry:
  %dyn = alloca i8, i64 %n, align 1
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  ret i32 %x

cold:
  store i8 42, ptr %dyn, align 1
  call void @cold_fmt(ptr nonnull %dyn)
  unreachable
}

; %buf is also used on the hot path, so it stays.
define i32 @used_on_hot_path(i32 %x) {
entry:
  %buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  call void @use(ptr %buf)
  ret i32 %x

cold:
  store ptr @fmt_u32, ptr %buf, align 8
  store i32 1, ptr @g, align 4
  store i32 2, ptr @g, align 4
  call void @cold_fmt(ptr nonnull %buf)
  unreachable
}

; The function may continue after a longjmp from the region, so %buf stays.
define i32 @calls_setjmp(i32 %x, ptr %env) {
entry:
  %buf = alloca [2 x ptr], align 8
  %r = call i32 @setjmp(ptr %env)
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  ret i32 %x

cold:
  store ptr @fmt_u32, ptr %buf, align 8
  store i32 1, ptr @g, align 4
  store i32 2, ptr @g, align 4
  call void @cold_fmt(ptr nonnull %buf)
  unreachable
}
