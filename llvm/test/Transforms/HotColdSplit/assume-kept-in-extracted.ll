; Check that an assumption whose operands are available in the extracted
; function moves with the extracted code.
define void @kept(i32 %x, i1 %c) {
entry:
  br i1 %c, label %cold, label %exit

cold:
  %cmp = icmp ult i32 %x, 64
  call void @llvm.assume(i1 %cmp)
  call void @sink(i32 %x)
  call void @cold()
  br label %exit

exit:
  ret void
}

; Check that an assumption with an operand bundle on an input is kept.
define void @kept_bundle(ptr %p, i1 %c) {
entry:
  br i1 %c, label %cold, label %exit

cold:
  call void @llvm.assume(i1 true) [ "align"(ptr %p, i64 16) ]
  call void @sinkp(ptr %p)
  call void @cold()
  br label %exit

exit:
  ret void
}

; Check that an assumption is dropped rather than adding an input for a value
; that only it uses.
define void @dropped(i32 %x, i1 %c) {
entry:
  %cmp = icmp ult i32 %x, 64
  br i1 %c, label %cold, label %exit

cold:
  call void @llvm.assume(i1 %cmp)
  call void @cold()
  br label %exit

exit:
  ret void
}

; Check that an assumption on an alloca sunk into the extracted function is
; kept.
define void @kept_sunk_alloca(i1 %c) {
entry:
  %a = alloca i32, align 16
  br i1 %c, label %cold, label %exit

cold:
  call void @llvm.lifetime.start.p0(ptr %a)
  call void @llvm.assume(i1 true) [ "align"(ptr %a, i64 16) ]
  call void @sinkp(ptr %a)
  call void @llvm.lifetime.end.p0(ptr %a)
  call void @cold()
  br label %exit

exit:
  ret void
}

