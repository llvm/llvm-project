; Allocas that CodeExtractor moves into the outlined function are not counted
; as inputs by the cost model.

declare void @cold_use(ptr, ptr, ptr) cold
declare void @cold_fmt(ptr) cold noreturn
declare void @cold_fmt2(ptr, ptr) cold noreturn
declare void @fmt_u32(ptr)
declare void @fmt_i32(ptr)
declare void @hot()

; %a, %b and %c live in the cold block only, according to their lifetime
; markers. They are not passed to the outlined function, which then takes two
; arguments instead of five, the maximum being four.
define void @lifetime_markers(i32 %x, i32 %y) {
entry:
  %a = alloca i32
  %b = alloca i32
  %c = alloca i32
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %exit, label %cold

cold:
  call void @llvm.lifetime.start.p0(ptr %a)
  call void @llvm.lifetime.start.p0(ptr %b)
  call void @llvm.lifetime.start.p0(ptr %c)
  store i32 %x, ptr %a
  store i32 %y, ptr %b
  %sum = add i32 %x, %y
  store i32 %sum, ptr %c
  call void @cold_use(ptr %a, ptr %b, ptr %c)
  call void @llvm.lifetime.end.p0(ptr %a)
  call void @llvm.lifetime.end.p0(ptr %b)
  call void @llvm.lifetime.end.p0(ptr %c)
  br label %exit

exit:
  call void @hot()
  ret void
}

; As in a formatting panic, the buffers are only used by a region that never
; returns, so CodeExtractor moves them into the outlined function, which takes
; no argument (penalty 1 < benefit 4, instead of penalty 5 >= benefit 4).
define i32 @noreturn_region(i32 %x) {
entry:
  %arg_buf = alloca [2 x ptr], align 8
  %fmt_buf = alloca [2 x ptr], align 8
  %ok = icmp ne i32 %x, 0
  br i1 %ok, label %hot, label %cold

hot:
  ret i32 %x

cold:
  call void @llvm.lifetime.start.p0(ptr nonnull %arg_buf)
  call void @llvm.lifetime.start.p0(ptr nonnull %fmt_buf)
  store ptr @fmt_u32, ptr %arg_buf, align 8
  store ptr %arg_buf, ptr %fmt_buf, align 8
  call void @cold_fmt(ptr nonnull %fmt_buf)
  unreachable
}

; Two independent non-returning cold regions in the same function: %arg1/%fmt1
; sink into .cold.1 and %arg2/%fmt2 sink into .cold.2 without being charged as
; inputs, while %shared (used by both cold regions) stays in the caller and is
; counted and passed as an input to each outlined function.
define i32 @two_noreturn_regions(i32 %x, i32 %y) {
entry:
  %shared = alloca i32, align 4
  %arg1 = alloca [2 x ptr], align 8
  %fmt1 = alloca [2 x ptr], align 8
  %arg2 = alloca [2 x ptr], align 8
  %fmt2 = alloca [2 x ptr], align 8
  %bad1 = icmp sgt i32 %x, %y
  br i1 %bad1, label %cold1, label %check2

check2:
  %bad2 = icmp eq i32 %y, 0
  br i1 %bad2, label %cold2, label %hot

hot:
  %res = sdiv i32 %x, %y
  ret i32 %res

cold1:
  store i32 %x, ptr %shared, align 4
  store ptr @fmt_u32, ptr %arg1, align 8
  store ptr %arg1, ptr %fmt1, align 8
  call void @cold_fmt2(ptr nonnull %fmt1, ptr nonnull %shared)
  unreachable

cold2:
  store i32 %y, ptr %shared, align 4
  store ptr @fmt_i32, ptr %arg2, align 8
  store ptr %arg2, ptr %fmt2, align 8
  call void @cold_fmt2(ptr nonnull %fmt2, ptr nonnull %shared)
  unreachable
}
