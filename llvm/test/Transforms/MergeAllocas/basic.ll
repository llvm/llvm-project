; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=merge-allocas -S | FileCheck %s

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

; A maximal run of adjacent, constant-size, non-entry-block allocas merges
; into one alloca plus one constant-offset getelementptr per original
; alloca -- see https://github.com/llvm/llvm-project/issues/1334.
define void @basic(i1 %c) {
; CHECK-LABEL: @basic(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[MERGED_ALLOCA:%.*]] = alloca i8, i64 16, align 4
; CHECK-NEXT:    [[B_MERGED:%.*]] = getelementptr inbounds i8, ptr [[MERGED_ALLOCA]], i64 4
; CHECK-NEXT:    [[C_MERGED:%.*]] = getelementptr inbounds i8, ptr [[MERGED_ALLOCA]], i64 8
; CHECK-NEXT:    [[D_MERGED:%.*]] = getelementptr inbounds i8, ptr [[MERGED_ALLOCA]], i64 12
; CHECK-NEXT:    store i32 1, ptr [[MERGED_ALLOCA]], align 4
; CHECK-NEXT:    store i32 1, ptr [[B_MERGED]], align 4
; CHECK-NEXT:    store i32 1, ptr [[C_MERGED]], align 4
; CHECK-NEXT:    store i32 1, ptr [[D_MERGED]], align 4
; CHECK-NEXT:    call void @test(ptr [[MERGED_ALLOCA]], ptr [[B_MERGED]], ptr [[C_MERGED]], ptr [[D_MERGED]])
; CHECK-NEXT:    br i1 [[C:%.*]], label [[NEXT]], label [[OUT:%.*]]
; CHECK:       out:
; CHECK-NEXT:    ret void
;
entry:
  br label %next

next:
  %a = alloca i32
  %b = alloca i32
  %c1 = alloca i32
  %d = alloca i32
  store i32 1, ptr %a
  store i32 1, ptr %b
  store i32 1, ptr %c1
  store i32 1, ptr %d
  call void @test(ptr %a, ptr %b, ptr %c1, ptr %d)
  br i1 %c, label %next, label %out

out:
  ret void
}

; Different per-alloca alignments get struct-style padding, and the merged
; buffer's own alignment is the max of every element's.
define void @alignment_padding() {
; CHECK-LABEL: @alignment_padding(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[MERGED_ALLOCA:%.*]] = alloca i8, i64 16, align 8
; CHECK-NEXT:    [[BYTE_MERGED:%.*]] = getelementptr inbounds i8, ptr [[MERGED_ALLOCA]], i64 1
; CHECK-NEXT:    [[DOUBLE_MERGED:%.*]] = getelementptr inbounds i8, ptr [[MERGED_ALLOCA]], i64 8
; CHECK-NEXT:    call void @use_i8(ptr [[MERGED_ALLOCA]])
; CHECK-NEXT:    call void @use_i8(ptr [[BYTE_MERGED]])
; CHECK-NEXT:    call void @use_double(ptr [[DOUBLE_MERGED]])
; CHECK-NEXT:    br label [[NEXT]]
;
entry:
  br label %next

next:
  %first = alloca i8
  %byte = alloca i8
  %double1 = alloca double
  call void @use_i8(ptr %first)
  call void @use_i8(ptr %byte)
  call void @use_double(ptr %double1)
  br label %next
}

; A single alloca (nothing to merge with) is left alone even when it would
; otherwise be a candidate.
define void @lone_alloca_untouched() {
; CHECK-LABEL: @lone_alloca_untouched(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    call void @use_i32(ptr [[A]])
; CHECK-NEXT:    br label [[NEXT]]
;
entry:
  br label %next

next:
  %a = alloca i32
  call void @use_i32(ptr %a)
  br label %next
}

; Entry-block allocas are already free (AllocaInst::isStaticAlloca()) --
; merging them has nothing to gain and isn't attempted.
define void @entry_block_allocas_untouched() {
; CHECK-LABEL: @entry_block_allocas_untouched(
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    [[B:%.*]] = alloca i32, align 4
; CHECK-NEXT:    call void @test32(ptr [[A]], ptr [[B]])
; CHECK-NEXT:    ret void
;
  %a = alloca i32
  %b = alloca i32
  call void @test32(ptr %a, ptr %b)
  ret void
}

; A non-alloca instruction between two allocas breaks adjacency: merging
; stays conservative rather than reasoning about whether hoisting the
; second alloca's storage earlier is safe across it (e.g. it could be an
; llvm.stacksave, or inline asm reading the stack pointer directly).
define void @non_adjacent_allocas_untouched() {
; CHECK-LABEL: @non_adjacent_allocas_untouched(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    call void @use_i32(ptr [[A]])
; CHECK-NEXT:    [[B:%.*]] = alloca i32, align 4
; CHECK-NEXT:    call void @use_i32(ptr [[B]])
; CHECK-NEXT:    br label [[NEXT]]
;
entry:
  br label %next

next:
  %a = alloca i32
  call void @use_i32(ptr %a)
  %b = alloca i32
  call void @use_i32(ptr %b)
  br label %next
}

; A variable-length array's size isn't a compile-time constant, so it can't
; contribute a fixed offset within a merged buffer -- it (and only it)
; stays out of the run.
define void @vla_breaks_run(i32 %n) {
; CHECK-LABEL: @vla_breaks_run(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[NEXT:%.*]]
; CHECK:       next:
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    [[VLA:%.*]] = alloca i32, i32 [[N:%.*]], align 4
; CHECK-NEXT:    [[B:%.*]] = alloca i32, align 4
; CHECK-NEXT:    call void @test32(ptr [[A]], ptr [[B]])
; CHECK-NEXT:    call void @use_i32(ptr [[VLA]])
; CHECK-NEXT:    br label [[NEXT]]
;
entry:
  br label %next

next:
  %a = alloca i32
  %vla = alloca i32, i32 %n
  %b = alloca i32
  call void @test32(ptr %a, ptr %b)
  call void @use_i32(ptr %vla)
  br label %next
}

declare void @test(ptr, ptr, ptr, ptr)
declare void @test32(ptr, ptr)
declare void @use_i8(ptr)
declare void @use_i32(ptr)
declare void @use_double(ptr)
