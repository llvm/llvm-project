; CHECK:       [[T]]:
; CHECK-NEXT:    br label %[[M:.*]]
; CHECK:       [[F]]:
; CHECK-NEXT:    br label %[[M]]
; CHECK:       [[M]]:
; CHECK-NEXT:    [[P:%.*]] = phi { i32, i32 } [ { i32 3, i32 4 }, %[[T]] ], [ { i32 3, i32 5 }, %[[F]] ]
; CHECK-NEXT:    [[FR:%.*]] = freeze { i32, i32 } [[P]]
; CHECK-NEXT:    [[B:%.*]] = extractvalue { i32, i32 } [[FR]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i32 [[B]], 6
; CHECK-NEXT:    [[R:%.*]] = zext i1 [[CMP]] to i32
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
