; Folds that are only valid under the fast-math flags of the instruction being
; visited must take those flags into account, even if the other operand is
; overdefined.

define float @fmul_zero_nnan_nsz(float %a) {
; CHECK-LABEL: define float @fmul_zero_nnan_nsz(
; CHECK-SAME: float [[A:%.*]]) {
; CHECK-NEXT:    ret float 0.000000e+00
;
  %r = fmul nnan nsz float %a, 0.000000e+00
  ret float %r
}

