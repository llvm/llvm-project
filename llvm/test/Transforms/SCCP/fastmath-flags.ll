; frem reaches simplifyFRemInst through the same overload. Mirrors the
; simplifyFRemInst coverage in InstSimplify/fast-math.ll, but with the folds
; driven by the solver's lattice rather than by simplifyInstruction.

define double @frem_poszero_nnan(double %a) {
; CHECK-LABEL: define double @frem_poszero_nnan(
; CHECK-SAME: double [[A:%.*]]) {
; CHECK-NEXT:    ret double 0.000000e+00
;
  %r = frem nnan double 0.000000e+00, %a
  ret double %r
}

; nsz is not necessary - the frem result always has the sign of the dividend.
define double @frem_negzero_nnan(double %a) {
; CHECK-LABEL: define double @frem_negzero_nnan(
; CHECK-SAME: double [[A:%.*]]) {
; CHECK-NEXT:    ret double -0.000000e+00
;
  %r = frem nnan double -0.000000e+00, %a
  ret double %r
}

; A poison element in the dividend still yields a full zero constant.
define <2 x double> @frem_poszero_nnan_vec_poison(<2 x double> %a) {
; CHECK-LABEL: define <2 x double> @frem_poszero_nnan_vec_poison(
