; %p is NaN when only the bb2 -> exit edge has been marked executable, which
; with 'nnan' makes %r poison. Once bb1 -> exit is executable as well, %p is
; overdefined and %r folds to 0.0. Make sure the lattice value for %r does not
; go from poison to a constant.
define float @fmul_nan_then_overdefined(float %a, i1 %bc) {
; CHECK-LABEL: define float @fmul_nan_then_overdefined(
; CHECK-SAME: float [[A:%.*]], i1 [[BC:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[BC]], label %[[BB1:.*]], label %[[BB2:.*]]
; CHECK:       [[BB1]]:
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[BB2]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[P:%.*]] = phi float [ [[A]], %[[BB1]] ], [ +qnan, %[[BB2]] ]
; CHECK-NEXT:    [[R:%.*]] = fmul nnan nsz float [[P]], 0.000000e+00
; CHECK-NEXT:    ret float [[R]]
;
entry:
  br i1 %bc, label %bb1, label %bb2

bb1:
  br label %exit

bb2:
  br label %exit

exit:
  %p = phi float [ %a, %bb1 ], [ 0x7FF8000000000000, %bb2 ]
  %r = fmul nnan nsz float %p, 0.000000e+00
  ret float %r
}
