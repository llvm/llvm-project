; CHECK-NEXT:    ret <2 x double> zeroinitializer
;
  %r = frem nnan <2 x double> <double 0.000000e+00, double poison>, %a
  ret <2 x double> %r
}

define <2 x double> @frem_negzero_nnan_vec_poison(<2 x double> %a) {
