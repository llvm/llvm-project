  %s = select i1 true, { i32, i32 } %i1, { i32, i32 } zeroinitializer
  ret { i32, i32 } %s
}

; Only element 0 of the selected operand is known; element 1 is overdefined.
; The select itself cannot be folded, but the extractvalue of element 0 can.
