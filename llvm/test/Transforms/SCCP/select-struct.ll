; CHECK-NEXT:    [[E1:%.*]] = extractvalue { i32, i32 } [[S]], 1
; CHECK-NEXT:    call void @use(i32 [[E1]])
; CHECK-NEXT:    ret i32 42
;
  %call = call { i32, i32 } @get_pair()
  %ins = insertvalue { i32, i32 } %call, i32 42, 0
  %s = select i1 true, { i32, i32 } %ins, { i32, i32 } zeroinitializer
  %e0 = extractvalue { i32, i32 } %s, 0
  %e1 = extractvalue { i32, i32 } %s, 1
  call void @use(i32 %e1)
  ret i32 %e0
}

