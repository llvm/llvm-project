; CHECK-NEXT:    br i1 [[EXIT]], label %[[OUT:.*]], label %[[LOOP]]
; CHECK:       [[OUT]]:
; CHECK-NEXT:    ret { i32, i32 } { i32 1, i32 2 }
;
entry:
  br label %loop

loop:
  %p = phi { i32, i32 } [ { i32 1, i32 2 }, %entry ], [ %s, %loop ]
  %s = select i1 true, { i32, i32 } %p, { i32, i32 } { i32 3, i32 4 }
  br i1 %exit, label %out, label %loop

out:
