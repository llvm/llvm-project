; CHECK-NEXT:    [[REM_RECOMPOSED:%.*]] = call i32 @llvm.srem.poison.i32(i32 [[X]], i32 [[Y]])
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[E:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    [[MUL:%.*]] = mul i32 [[DIV]], [[Y]]
; CHECK-NEXT:    ret i32 [[REM_RECOMPOSED]]
; CHECK:       [[E]]:
; CHECK-NEXT:    ret i32 [[DIV]]
;
entry:
  %div = call i32 @llvm.sdiv.poison.i32(i32 %x, i32 %y)
  br i1 %c, label %t, label %e
t:
  %mul = mul i32 %div, %y
  %rem = sub i32 %x, %mul
  ret i32 %rem
e:
  ret i32 %div
}

declare i32 @llvm.sdiv.poison.i32(i32, i32)
declare i32 @llvm.srem.poison.i32(i32, i32)
declare i64 @llvm.udiv.poison.i64(i64, i64)
declare i64 @llvm.urem.poison.i64(i64, i64)
declare <2 x i32> @llvm.sdiv.poison.v2i32(<2 x i32>, <2 x i32>)
declare <2 x i32> @llvm.srem.poison.v2i32(<2 x i32>, <2 x i32>)

declare i32 @llvm.udiv.poison.i32(i32, i32)
declare i32 @llvm.urem.poison.i32(i32, i32)
