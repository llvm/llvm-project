; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=objc-arc -S < %s | FileCheck %s

; objc_claimAutoreleasedReturnValue returns a +1 object, like
; objc_retainAutoreleasedReturnValue; it only differs in not requiring the
; marker instruction after the call. Check how the ARC optimizer handles it,
; both as a standalone call and as the operand of the
; "clang.arc.attachedcall" operand bundle.

target datalayout = "e-p:64:64:64"

declare void @llvm.objc.release(ptr)
declare ptr @llvm.objc.autoreleaseReturnValue(ptr)
declare ptr @llvm.objc.claimAutoreleasedReturnValue(ptr)
declare void @llvm.objc.clang.arc.noop.use(...)

declare ptr @returner()
declare void @use_pointer(ptr)

; An inlined autoreleaseRV and a claimRV cancel out.
define ptr @elide_with_claimRV(ptr %x) nounwind {
; CHECK-LABEL: define ptr @elide_with_claimRV(
; CHECK-SAME: ptr [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    ret ptr [[X]]
;
entry:
  %b = call ptr @llvm.objc.autoreleaseReturnValue(ptr %x) nounwind
  %c = call ptr @llvm.objc.claimAutoreleasedReturnValue(ptr %b) nounwind
  ret ptr %c
}

; Convert claimRV to objc_retain if its argument is not a return value.
define void @claimRV_not_return_value(ptr %p) {
; CHECK-LABEL: define void @claimRV_not_return_value(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = tail call ptr @llvm.objc.retain(ptr [[P]]) #[[ATTR0]]
; CHECK-NEXT:    ret void
;
  call ptr @llvm.objc.claimAutoreleasedReturnValue(ptr %p)
  ret void
}

; Convert claimRV to objc_retain if it doesn't immediately follow the call.
define void @claimRV_not_adjacent() {
; CHECK-LABEL: define void @claimRV_not_adjacent() {
; CHECK-NEXT:    [[P:%.*]] = call ptr @returner()
; CHECK-NEXT:    call void @use_pointer(ptr [[P]])
; CHECK-NEXT:    [[TMP1:%.*]] = tail call ptr @llvm.objc.retain(ptr [[P]]) #[[ATTR0]]
; CHECK-NEXT:    ret void
;
  %p = call ptr @returner()
  call void @use_pointer(ptr %p)
  call ptr @llvm.objc.claimAutoreleasedReturnValue(ptr %p)
  ret void
}

; Keep a claimRV that immediately follows the call, and don't pair it with the
; release.
define void @claimRV_adjacent() {
; CHECK-LABEL: define void @claimRV_adjacent() {
; CHECK-NEXT:    [[P:%.*]] = call ptr @returner()
; CHECK-NEXT:    [[C:%.*]] = tail call ptr @llvm.objc.claimAutoreleasedReturnValue(ptr [[P]]) #[[ATTR0]]
; CHECK-NEXT:    call void @use_pointer(ptr [[P]])
; CHECK-NEXT:    call void @llvm.objc.release(ptr [[P]]) #[[ATTR0]]
; CHECK-NEXT:    ret void
;
  %p = call ptr @returner()
  %c = call ptr @llvm.objc.claimAutoreleasedReturnValue(ptr %p)
  call void @use_pointer(ptr %p)
  call void @llvm.objc.release(ptr %p)
  ret void
}

; Remove the attached claimRV and the autoreleaseRV if the call is a tail call.
define ptr @bundled_claimRV_tail_call() {
; CHECK-LABEL: define ptr @bundled_claimRV_tail_call() {
; CHECK-NEXT:    [[TMP1:%.*]] = tail call ptr @returner()
; CHECK-NEXT:    ret ptr [[TMP1]]
;
  %call = tail call ptr @returner() [ "clang.arc.attachedcall"(ptr @llvm.objc.claimAutoreleasedReturnValue) ]
  call void (...) @llvm.objc.clang.arc.noop.use(ptr %call)
  %1 = call ptr @llvm.objc.autoreleaseReturnValue(ptr %call)
  ret ptr %1
}

; Otherwise keep both, and don't turn the autoreleaseRV into an autorelease.
define ptr @bundled_claimRV_no_tail_call() {
; CHECK-LABEL: define ptr @bundled_claimRV_no_tail_call() {
; CHECK-NEXT:    [[CALL:%.*]] = call ptr @returner() [ "clang.arc.attachedcall"(ptr @llvm.objc.claimAutoreleasedReturnValue) ]
; CHECK-NEXT:    call void (...) @llvm.objc.clang.arc.noop.use(ptr [[CALL]])
; CHECK-NEXT:    [[TMP1:%.*]] = tail call ptr @llvm.objc.autoreleaseReturnValue(ptr [[CALL]]) #[[ATTR0]]
; CHECK-NEXT:    ret ptr [[TMP1]]
;
  %call = call ptr @returner() [ "clang.arc.attachedcall"(ptr @llvm.objc.claimAutoreleasedReturnValue) ]
  call void (...) @llvm.objc.clang.arc.noop.use(ptr %call)
  %1 = call ptr @llvm.objc.autoreleaseReturnValue(ptr %call)
  ret ptr %1
}
