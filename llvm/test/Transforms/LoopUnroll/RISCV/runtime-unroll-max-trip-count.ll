; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -S -passes=loop-unroll -mattr=+no-default-unroll,+zbb | FileCheck %s

; Regression test: when a loop has a small MaxTripCount and falls through to
; runtime unrolling, the unroll count should be based on DefaultUnrollRuntimeCount
; (not MaxTripCount). Previously, a quirk would seed the selected count with
; MaxTripCount (5) before the power-of-two reduction, yielding count 2 (5 >> 1).
; Now the count starts at DefaultUnrollRuntimeCount (8) and reduces to 4
; (8 >> 1).
;
; This test uses RISC-V because we need a target that sets UP.Force = true
; (via RISCVTTIImpl::getUnrollingPreferences) to trigger the bug.

target triple = "riscv64-unknown-linux-gnu"

define void @test(i32 %start, ptr %p) {
; CHECK-LABEL: @test(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[END:%.*]] = add i32 [[START:%.*]], 5
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[P:%.*]], i32 [[START]]
; CHECK-NEXT:    [[V:%.*]] = load volatile i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[B25:%.*]] = call i32 @llvm.bswap.i32(i32 [[V]])
; CHECK-NEXT:    store volatile i32 [[B25]], ptr [[GEP]], align 4
; CHECK-NEXT:    [[IV_NEXT:%.*]] = add nuw i32 [[START]], 1
; CHECK-NEXT:    [[CMP_3:%.*]] = icmp ult i32 [[IV_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[CMP_3]], label [[LOOP_1:%.*]], label [[EXIT:%.*]]
; CHECK:       loop.1:
; CHECK-NEXT:    [[GEP_1:%.*]] = getelementptr inbounds i32, ptr [[P]], i32 [[IV_NEXT]]
; CHECK-NEXT:    [[V_1:%.*]] = load volatile i32, ptr [[GEP_1]], align 4
; CHECK-NEXT:    [[B4_1:%.*]] = call i32 @llvm.bswap.i32(i32 [[V_1]])
; CHECK-NEXT:    store volatile i32 [[B4_1]], ptr [[GEP_1]], align 4
; CHECK-NEXT:    [[IV_NEXT_1:%.*]] = add nuw i32 [[START]], 2
; CHECK-NEXT:    [[GEP_2:%.*]] = getelementptr inbounds i32, ptr [[P]], i32 [[IV_NEXT_1]]
; CHECK-NEXT:    [[V_2:%.*]] = load volatile i32, ptr [[GEP_2]], align 4
; CHECK-NEXT:    [[B4_2:%.*]] = call i32 @llvm.bswap.i32(i32 [[V_2]])
; CHECK-NEXT:    store volatile i32 [[B4_2]], ptr [[GEP_2]], align 4
; CHECK-NEXT:    [[IV_NEXT_2:%.*]] = add nuw i32 [[START]], 3
; CHECK-NEXT:    [[GEP_3:%.*]] = getelementptr inbounds i32, ptr [[P]], i32 [[IV_NEXT_2]]
; CHECK-NEXT:    [[V_3:%.*]] = load volatile i32, ptr [[GEP_3]], align 4
; CHECK-NEXT:    [[B4_3:%.*]] = call i32 @llvm.bswap.i32(i32 [[V_3]])
; CHECK-NEXT:    store volatile i32 [[B4_3]], ptr [[GEP_3]], align 4
; CHECK-NEXT:    [[IV_NEXT_3:%.*]] = add nuw i32 [[START]], 4
; CHECK-NEXT:    [[GEP_4:%.*]] = getelementptr inbounds i32, ptr [[P]], i32 [[IV_NEXT_3]]
; CHECK-NEXT:    [[V_4:%.*]] = load volatile i32, ptr [[GEP_4]], align 4
; CHECK-NEXT:    [[B4_4:%.*]] = call i32 @llvm.bswap.i32(i32 [[V_4]])
; CHECK-NEXT:    store volatile i32 [[B4_4]], ptr [[GEP_4]], align 4
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %end = add i32 %start, 5
  br label %loop

loop:
  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i32 %iv
  %v = load volatile i32, ptr %gep
  %b0 = call i32 @llvm.bswap.i32(i32 %v)
  %b1 = call i32 @llvm.bswap.i32(i32 %b0)
  %b2 = call i32 @llvm.bswap.i32(i32 %b1)
  %b3 = call i32 @llvm.bswap.i32(i32 %b2)
  %b4 = call i32 @llvm.bswap.i32(i32 %b3)
  store volatile i32 %b4, ptr %gep
  %iv.next = add nuw i32 %iv, 1
  %cmp = icmp ult i32 %iv.next, %end
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
