; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='loop-unroll<O3>' -S %s | FileCheck %s

; Regression test for https://github.com/llvm/llvm-project/issues/231037
;
; The loop below has no exit block (it is an infinite loop) and contains a
; min/max intrinsic. countToEliminateCompares() used to set DesiredPeelCountLast
; to the front peel count (NewPeelCount) in the compare-elimination success
; path, without checking canPeelLastIteration(). When the front peel was then
; blocked by the already-peeled-count limit (DesiredPeelCount + AlreadyPeeled >
; UnrollPeelMaxCount), computePeelCount() fell through to the PeelLast path and
; called peelLoop() with PeelLast=true, PeelCount>1 and canPeelLastIteration()
; false, tripping the assertion:
;   "when peeling the last iteration, the loop must be supported and can only
;    peel a single iteration"

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define i8 @f() {
; CHECK-LABEL: define i8 @f() {
; CHECK-NEXT:  [[DOTCRITEDGE:.*]]:
; CHECK-NEXT:    br label %[[DOTLR_PH8:.*]]
; CHECK:       [[DOTLOOPEXIT:.*]]:
; CHECK-NEXT:    [[INDVARS_IV_NEXT:%.*]] = add nsw i64 [[INDVARS_IV:%.*]], 1
; CHECK-NEXT:    br label %[[DOTLR_PH8]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       [[DOTLR_PH8]]:
; CHECK-NEXT:    [[INDVARS_IV]] = phi i64 [ [[INDVARS_IV_NEXT]], %[[DOTLOOPEXIT]] ], [ 1, %[[DOTCRITEDGE]] ]
; CHECK-NEXT:    [[DOTNOT123:%.*]] = icmp ult i64 [[INDVARS_IV]], 3
; CHECK-NEXT:    br i1 [[DOTNOT123]], label %[[DOTLOOPEXIT]], label %[[DOTLR_PH_PREHEADER:.*]]
; CHECK:       [[DOTLR_PH_PREHEADER]]:
; CHECK-NEXT:    [[UMIN:%.*]] = call i64 @llvm.umin.i64(i64 [[INDVARS_IV]], i64 8)
; CHECK-NEXT:    br label %[[DOTLOOPEXIT]]
;
.critedge:
  br label %.lr.ph8

.loopexit:                                        ; preds = %.lr.ph.preheader, %.lr.ph8
  %indvars.iv.next = add nsw i64 %indvars.iv, 1
  br label %.lr.ph8, !llvm.loop !0

.lr.ph8:                                          ; preds = %.loopexit, %.critedge
  %indvars.iv = phi i64 [ %indvars.iv.next, %.loopexit ], [ 1, %.critedge ]
  %.not123 = icmp ult i64 %indvars.iv, 3
  br i1 %.not123, label %.loopexit, label %.lr.ph.preheader

.lr.ph.preheader:                                 ; preds = %.lr.ph8
  %umin = call i64 @llvm.umin.i64(i64 %indvars.iv, i64 8)
  br label %.loopexit
}

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare i64 @llvm.umin.i64(i64, i64) #0

attributes #0 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.peeled.count", i32 1}
;.
; CHECK: [[LOOP0]] = distinct !{[[LOOP0]], [[META1:![0-9]+]]}
; CHECK: [[META1]] = !{!"llvm.loop.peeled.count", i32 1}
;.
