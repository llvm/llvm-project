;
entry:
  %cmp = icmp sgt i32 %num_elements, 0
  br i1 %cmp, label %preheader, label %exit

preheader:
  br label %loop

loop:
  %i = phi i32 [ 0, %preheader ], [ %i.next, %loop ]
  %j = phi i32 [ %start, %preheader ], [%j.next, %loop ]
  %j.next = add nuw nsw i32 %j, 1
  %gep = getelementptr inbounds i32, ptr %p, i32 %i
  store i32 %j.next, ptr %gep, align 4
  %i.next = add nuw nsw i32 %i, 1
  %ec = icmp ne i32 %i.next, %num_elements
  br i1 %ec, label %loop, label %exit, !llvm.loop !0
exit:
  ret void
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.unroll.count", i32 5}
!2 = distinct !{!2, !1}
