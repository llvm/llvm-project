; This loop runs at most 6 times, and - because %n + 6 may wrap - either 6 or 1
; times (MaxOrZero), never in between, so the option does not affect it. It is
; fully unrolled in both runs.
define i32 @max_or_zero(i32 %n, ptr %p) {
; CHECK-LABEL: @max_or_zero(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[END:%.*]] = add i32 [[N:%.*]], 6
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    store i32 [[N]], ptr [[P:%.*]], align 4
; CHECK-NEXT:    [[I_NEXT:%.*]] = add i32 [[N]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[I_NEXT]], [[END]]
; CHECK-NEXT:    br i1 [[C]], label [[LOOP_1:%.*]], label [[EXIT:%.*]]
; CHECK:       loop.1:
; CHECK-NEXT:    store i32 [[I_NEXT]], ptr [[P]], align 4
; CHECK-NEXT:    [[I_NEXT_1:%.*]] = add i32 [[N]], 2
; CHECK-NEXT:    store i32 [[I_NEXT_1]], ptr [[P]], align 4
; CHECK-NEXT:    [[I_NEXT_2:%.*]] = add i32 [[N]], 3
; CHECK-NEXT:    store i32 [[I_NEXT_2]], ptr [[P]], align 4
; CHECK-NEXT:    [[I_NEXT_3:%.*]] = add i32 [[N]], 4
; CHECK-NEXT:    store i32 [[I_NEXT_3]], ptr [[P]], align 4
; CHECK-NEXT:    [[I_NEXT_4:%.*]] = add i32 [[N]], 5
; CHECK-NEXT:    store i32 [[I_NEXT_4]], ptr [[P]], align 4
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    [[I_LCSSA:%.*]] = phi i32 [ [[N]], [[LOOP]] ], [ [[I_NEXT_4]], [[LOOP_1]] ]
; CHECK-NEXT:    ret i32 [[I_LCSSA]]
;
entry:
  %end = add i32 %n, 6
  br label %loop

loop:
  %i = phi i32 [ %n, %entry ], [ %i.next, %loop ]
  store i32 %i, ptr %p
  %i.next = add i32 %i, 1
  %c = icmp ult i32 %i.next, %end
  br i1 %c, label %loop, label %exit

exit:
  ret i32 %i
}

