; RUN: opt < %s -S -passes=loop-unroll -unroll-threshold=20 | FileCheck %s

; Invariant floating-point computations are not SCEVable, but like
; SCEV-invariant values they only have to be computed once after unrolling.
define double @test_fp(double %a, double %b) {
; CHECK-LABEL: define double @test_fp(
; CHECK-SAME: double [[A:%.*]], double [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[FOR_BODY:.*]]
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    [[ADD:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL:%.*]] = fmul double [[ADD]], [[B]]
; CHECK-NEXT:    [[DIV:%.*]] = fdiv double [[MUL]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT:%.*]] = fadd double 0.000000e+00, [[DIV]]
; CHECK-NEXT:    [[ADD_1:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_1:%.*]] = fmul double [[ADD_1]], [[B]]
; CHECK-NEXT:    [[DIV_1:%.*]] = fdiv double [[MUL_1]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_1:%.*]] = fadd double [[SUM_NEXT]], [[DIV_1]]
; CHECK-NEXT:    [[ADD_2:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_2:%.*]] = fmul double [[ADD_2]], [[B]]
; CHECK-NEXT:    [[DIV_2:%.*]] = fdiv double [[MUL_2]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_2:%.*]] = fadd double [[SUM_NEXT_1]], [[DIV_2]]
; CHECK-NEXT:    [[ADD_3:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_3:%.*]] = fmul double [[ADD_3]], [[B]]
; CHECK-NEXT:    [[DIV_3:%.*]] = fdiv double [[MUL_3]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_3:%.*]] = fadd double [[SUM_NEXT_2]], [[DIV_3]]
; CHECK-NEXT:    [[ADD_4:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_4:%.*]] = fmul double [[ADD_4]], [[B]]
; CHECK-NEXT:    [[DIV_4:%.*]] = fdiv double [[MUL_4]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_4:%.*]] = fadd double [[SUM_NEXT_3]], [[DIV_4]]
; CHECK-NEXT:    [[ADD_5:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_5:%.*]] = fmul double [[ADD_5]], [[B]]
; CHECK-NEXT:    [[DIV_5:%.*]] = fdiv double [[MUL_5]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_5:%.*]] = fadd double [[SUM_NEXT_4]], [[DIV_5]]
; CHECK-NEXT:    [[ADD_6:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_6:%.*]] = fmul double [[ADD_6]], [[B]]
; CHECK-NEXT:    [[DIV_6:%.*]] = fdiv double [[MUL_6]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_6:%.*]] = fadd double [[SUM_NEXT_5]], [[DIV_6]]
; CHECK-NEXT:    [[ADD_7:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_7:%.*]] = fmul double [[ADD_7]], [[B]]
; CHECK-NEXT:    [[DIV_7:%.*]] = fdiv double [[MUL_7]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_7:%.*]] = fadd double [[SUM_NEXT_6]], [[DIV_7]]
; CHECK-NEXT:    [[ADD_8:%.*]] = fadd double [[A]], [[B]]
; CHECK-NEXT:    [[MUL_8:%.*]] = fmul double [[ADD_8]], [[B]]
; CHECK-NEXT:    [[DIV_8:%.*]] = fdiv double [[MUL_8]], [[A]]
; CHECK-NEXT:    [[SUM_NEXT_8:%.*]] = fadd double [[SUM_NEXT_7]], [[DIV_8]]
; CHECK-NEXT:    ret double [[SUM_NEXT_8]]
;
entry:
  br label %for.body

for.body:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %for.body ]
  %sum = phi double [ 0.0, %entry ], [ %sum.next, %for.body ]
  %add = fadd double %a, %b
  %mul = fmul double %add, %b
  %div = fdiv double %mul, %a
  %sum.next = fadd double %sum, %div
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 9
  br i1 %cmp, label %for.body, label %for.exit

for.exit:
  ret double %sum.next
}

; A computation depending on a load inside the loop is not invariant.
define double @test_fp_load(ptr %p, double %b) {
; CHECK-LABEL: define double @test_fp_load(
; CHECK-SAME: ptr [[P:%.*]], double [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[FOR_BODY:.*]]
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi double [ 0.000000e+00, %[[ENTRY]] ], [ [[SUM_NEXT:%.*]], %[[FOR_BODY]] ]
; CHECK-NEXT:    [[LD:%.*]] = load double, ptr [[P]], align 8
; CHECK-NEXT:    [[ADD:%.*]] = fadd double [[LD]], [[B]]
; CHECK-NEXT:    [[MUL:%.*]] = fmul double [[ADD]], [[B]]
; CHECK-NEXT:    [[DIV:%.*]] = fdiv double [[MUL]], [[LD]]
; CHECK-NEXT:    [[SUM_NEXT]] = fadd double [[SUM]], [[DIV]]
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[IV_NEXT]], 9
; CHECK-NEXT:    br i1 [[CMP]], label %[[FOR_BODY]], label %[[FOR_EXIT:.*]]
; CHECK:       [[FOR_EXIT]]:
; CHECK-NEXT:    [[SUM_NEXT_LCSSA:%.*]] = phi double [ [[SUM_NEXT]], %[[FOR_BODY]] ]
; CHECK-NEXT:    ret double [[SUM_NEXT_LCSSA]]
;
entry:
  br label %for.body

for.body:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %for.body ]
  %sum = phi double [ 0.0, %entry ], [ %sum.next, %for.body ]
  %ld = load double, ptr %p
  %add = fadd double %ld, %b
  %mul = fmul double %add, %b
  %div = fdiv double %mul, %ld
  %sum.next = fadd double %sum, %div
  %iv.next = add nuw nsw i64 %iv, 1
  %cmp = icmp ult i64 %iv.next, 9
  br i1 %cmp, label %for.body, label %for.exit

for.exit:
  ret double %sum.next
}
