  %31 = call <8 x i32> @llvm.vector.partial.reduce.add.v8i32.v8i32(<8 x i32> %7, <8 x i32> %27)
  %32 = call <8 x i32> @llvm.vector.partial.reduce.add.v8i32.v8i32(<8 x i32> %8, <8 x i32> %28)
