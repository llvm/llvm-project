  %w = load i8, ptr %w.ptr, align 1
  %out.i = getelementptr inbounds i8, ptr %out, i32 %i
  store i8 %w, ptr %out.i, align 1

  %p.next = getelementptr inbounds i8, ptr %p, i64 3
  %i.next = add i32 %i, 1
  %cond = icmp ne i32 %i.next, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret void
}

