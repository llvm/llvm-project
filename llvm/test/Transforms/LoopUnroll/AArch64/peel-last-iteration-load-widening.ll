entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %a = phi ptr [ %pa, %entry ], [ %a.next, %latch ]
  %b = phi ptr [ %pb, %entry ], [ %b.next, %latch ]
  %a1 = getelementptr inbounds i8, ptr %a, i64 1
  %a2 = getelementptr inbounds i8, ptr %a, i64 2
