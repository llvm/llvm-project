latch:
  %a.next = getelementptr inbounds i8, ptr %a, i64 3
  %b.next = getelementptr inbounds i8, ptr %b, i64 3
  %i.next = add i32 %i, 1
  %cond = icmp ne i32 %i.next, %n
  br i1 %cond, label %loop, label %exit

exit:
