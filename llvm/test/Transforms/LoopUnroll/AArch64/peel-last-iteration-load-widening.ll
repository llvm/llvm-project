  %av1 = load i8, ptr %a1, align 1
  %av2 = load i8, ptr %a2, align 1
  %as1 = add i8 %av0, %av1
  %as2 = add i8 %as1, %av2
  store i8 %as2, ptr %dst, align 1
  br i1 %c0, label %then, label %latch

then:
  %b1 = getelementptr inbounds i8, ptr %b, i64 1
  %b2 = getelementptr inbounds i8, ptr %b, i64 2
  %bv0 = load i8, ptr %b, align 1
