  %v = phi i64 [ %v0, %entry ], [ %v.shr, %loop ]
  %v.shr = lshr i64 %v, 7
  %i.next = add i32 %i, 1
  %cmp = icmp ne i64 %v.shr, 0
  br i1 %cmp, label %loop, label %exit

exit:
  %i.lcssa = phi i32 [ %i, %loop ]
  ret i32 %i.lcssa
}
