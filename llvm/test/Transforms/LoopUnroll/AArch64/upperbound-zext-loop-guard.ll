; RUN: opt -S -passes=loop-unroll -mtriple=aarch64 < %s | FileCheck %s

; The trip count is zext(-8 + %n), and the guards bound it from above, so the
; loop is fully unrolled by its upper bound. The guards contradict each other
; (%n <= 15 and %n - 8 >=u 8), so the loop is dead and any upper bound is sound.

define void @zext_neg_const_add_guarded(i32 %n) {
; CHECK-LABEL: define void @zext_neg_const_add_guarded(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LE:%.*]] = icmp sle i32 [[N]], 15
; CHECK-NEXT:    [[GT:%.*]] = icmp sgt i32 [[N]], 7
; CHECK-NEXT:    [[IN_RANGE:%.*]] = and i1 [[LE]], [[GT]]
; CHECK-NEXT:    br i1 [[IN_RANGE]], label %[[LOOP_GUARD:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_GUARD]]:
; CHECK-NEXT:    [[SUB:%.*]] = add i32 [[N]], -8
; CHECK-NEXT:    [[SMALL:%.*]] = icmp ult i32 [[SUB]], 8
; CHECK-NEXT:    br i1 [[SMALL]], label %[[EXIT]], label %[[LOOP_PREHEADER:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP_BODY:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    [[WIDE_SUB:%.*]] = zext i32 [[SUB]] to i64
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 1, [[WIDE_SUB]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP_BODY_1:.*]]
; CHECK:       [[LOOP_BODY_1]]:
; CHECK-NEXT:    [[WIDE_SUB_1:%.*]] = zext i32 [[SUB]] to i64
; CHECK-NEXT:    [[EC_1:%.*]] = icmp eq i64 2, [[WIDE_SUB_1]]
; CHECK-NEXT:    br i1 [[EC_1]], label %[[EXIT_LOOPEXIT]], label %[[LOOP_BODY_2:.*]]
; CHECK:       [[LOOP_BODY_2]]:
; CHECK-NEXT:    [[WIDE_SUB_2:%.*]] = zext i32 [[SUB]] to i64
; CHECK-NEXT:    [[EC_2:%.*]] = icmp eq i64 3, [[WIDE_SUB_2]]
; CHECK-NEXT:    br i1 [[EC_2]], label %[[EXIT_LOOPEXIT]], label %[[LOOP_BODY_3:.*]]
; CHECK:       [[LOOP_BODY_3]]:
; CHECK-NEXT:    [[WIDE_SUB_3:%.*]] = zext i32 [[SUB]] to i64
; CHECK-NEXT:    [[EC_3:%.*]] = icmp eq i64 4, [[WIDE_SUB_3]]
; CHECK-NEXT:    br i1 [[EC_3]], label %[[EXIT_LOOPEXIT]], label %[[LOOP_BODY_4:.*]]
; CHECK:       [[LOOP_BODY_4]]:
; CHECK-NEXT:    [[WIDE_SUB_4:%.*]] = zext i32 [[SUB]] to i64
; CHECK-NEXT:    [[EC_4:%.*]] = icmp eq i64 5, [[WIDE_SUB_4]]
; CHECK-NEXT:    br i1 [[EC_4]], label %[[EXIT_LOOPEXIT]], label %[[LOOP_BODY_5:.*]]
; CHECK:       [[LOOP_BODY_5]]:
; CHECK-NEXT:    [[WIDE_SUB_5:%.*]] = zext i32 [[SUB]] to i64
; CHECK-NEXT:    [[EC_5:%.*]] = icmp eq i64 6, [[WIDE_SUB_5]]
; CHECK-NEXT:    br i1 [[EC_5]], label %[[EXIT_LOOPEXIT]], label %[[LOOP_BODY_6:.*]]
; CHECK:       [[LOOP_BODY_6]]:
; CHECK-NEXT:    br label %[[EXIT_LOOPEXIT]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %le = icmp sle i32 %n, 15
  %gt = icmp sgt i32 %n, 7
  %in.range = and i1 %le, %gt
  br i1 %in.range, label %loop.guard, label %exit

loop.guard:
  %sub = add i32 %n, -8
  %small = icmp ult i32 %sub, 8
  br i1 %small, label %exit, label %loop.preheader

loop.preheader:
  br label %loop.body

loop.body:
  %iv = phi i64 [ 0, %loop.preheader ], [ %iv.next, %loop.body ]
  %iv.next = add i64 %iv, 1
  %wide.sub = zext i32 %sub to i64
  %ec = icmp eq i64 %iv.next, %wide.sub
  br i1 %ec, label %exit, label %loop.body

exit:
  ret void
}
