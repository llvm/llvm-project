; When the scopes declared in the loop are cloned into a clone of their
; disjoint-scope domain, the scopes of that domain that have no declaration in
; the loop (for instance, because InstCombine removed it) must be moved into the
; cloned domain as well. Otherwise, the !alias.scope list {!b, !c} would be
; split across the two domains, which would make the unrolled store noalias
; with any access that has !noalias {!c:It1}.
define void @undeclared_scope_in_cloned_domain(ptr %p) {
; CHECK-LABEL: define void @undeclared_scope_in_cloned_domain(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0:![0-9]+]])
; CHECK-NEXT:    store i32 0, ptr [[P]], align 4, !alias.scope [[META3:![0-9]+]]
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META5:![0-9]+]])
; CHECK-NEXT:    store i32 0, ptr [[P]], align 4, !alias.scope [[META8:![0-9]+]]
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  call void @llvm.experimental.noalias.scope.decl(metadata !3)
  store i32 0, ptr %p, !alias.scope !4
  %i.next = add nuw nsw i32 %i, 1
  %cmp = icmp ult i32 %i.next, 2
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

