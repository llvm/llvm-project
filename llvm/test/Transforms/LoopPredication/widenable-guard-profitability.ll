define i32 @widenable_branch_above_loop(ptr %array.a, i32 %length.a, ptr %array.b, i32 %length.b, i32 %n, i1 %cond) {
; CHECK-LABEL: define i32 @widenable_branch_above_loop(
; CHECK-SAME: ptr [[ARRAY_A:%.*]], i32 [[LENGTH_A:%.*]], ptr [[ARRAY_B:%.*]], i32 [[LENGTH_B:%.*]], i32 [[N:%.*]], i1 [[COND:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[WIDENABLE_COND_ENTRY:%.*]] = call i1 @llvm.experimental.widenable.condition()
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.usub.sat.i32(i32 [[N]], i32 1)
; CHECK-NEXT:    [[UMIN:%.*]] = call i32 @llvm.umin.i32(i32 [[LENGTH_B]], i32 [[TMP0]])
; CHECK-NEXT:    [[TMP1:%.*]] = icmp ugt i32 [[LENGTH_B]], [[UMIN]]
; CHECK-NEXT:    [[TMP2:%.*]] = freeze i1 [[TMP1]]
; CHECK-NEXT:    [[TMP3:%.*]] = and i1 [[TMP2]], [[COND]]
; CHECK-NEXT:    [[GUARD_COND_ENTRY:%.*]] = and i1 [[TMP3]], [[WIDENABLE_COND_ENTRY]]
; CHECK-NEXT:    br i1 [[GUARD_COND_ENTRY]], label %[[LOOP_PREHEADER:.*]], label %[[DEOPT_ENTRY:.*]], !prof [[PROF0]]
; CHECK:       [[DEOPT_ENTRY]]:
; CHECK-NEXT:    [[DEOPTCALL_ENTRY:%.*]] = call i32 (...) @llvm.experimental.deoptimize.i32(i32 8) [ "deopt"() ]
; CHECK-NEXT:    ret i32 [[DEOPTCALL_ENTRY]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP4:%.*]] = icmp ule i32 [[N]], [[LENGTH_A]]
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ult i32 0, [[LENGTH_A]]
; CHECK-NEXT:    [[TMP6:%.*]] = and i1 [[TMP5]], [[TMP4]]
; CHECK-NEXT:    [[TMP7:%.*]] = freeze i1 [[TMP6]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LOOP_ACC:%.*]] = phi i32 [ [[LOOP_ACC_NEXT:%.*]], %[[IN_BOUNDS_B:.*]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[IN_BOUNDS_B]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[WITHIN_BOUNDS_A:%.*]] = icmp ult i32 [[I]], [[LENGTH_A]]
; CHECK-NEXT:    [[WIDENABLE_COND_A:%.*]] = call i1 @llvm.experimental.widenable.condition()
; CHECK-NEXT:    [[TMP8:%.*]] = and i1 [[TMP7]], true
; CHECK-NEXT:    br i1 [[TMP8]], label %[[GUARDED_A:.*]], label %[[DEOPT_A:.*]], !prof [[PROF0]]
; CHECK:       [[DEOPT_A]]:
; CHECK-NEXT:    [[DEOPTCALL_A:%.*]] = call i32 (...) @llvm.experimental.deoptimize.i32(i32 9) [ "deopt"() ]
; CHECK-NEXT:    ret i32 [[DEOPTCALL_A]]
; CHECK:       [[GUARDED_A]]:
; CHECK-NEXT:    call void @llvm.assume(i1 [[WITHIN_BOUNDS_A]])
; CHECK-NEXT:    [[WITHIN_BOUNDS_B:%.*]] = icmp ult i32 [[I]], [[LENGTH_B]]
; CHECK-NEXT:    br i1 true, label %[[IN_BOUNDS_B]], label %[[DEOPT_B:.*]], !prof [[PROF3]]
; CHECK:       [[DEOPT_B]]:
; CHECK-NEXT:    [[DEOPTCALL_B:%.*]] = call i32 (...) @llvm.experimental.deoptimize.i32(i32 10) [ "deopt"() ]
; CHECK-NEXT:    ret i32 [[DEOPTCALL_B]]
; CHECK:       [[IN_BOUNDS_B]]:
; CHECK-NEXT:    [[I_I64:%.*]] = zext i32 [[I]] to i64
; CHECK-NEXT:    [[ARRAY_A_I_PTR:%.*]] = getelementptr inbounds i32, ptr [[ARRAY_A]], i64 [[I_I64]]
; CHECK-NEXT:    [[ARRAY_A_I:%.*]] = load i32, ptr [[ARRAY_A_I_PTR]], align 4
; CHECK-NEXT:    [[ARRAY_B_I_PTR:%.*]] = getelementptr inbounds i32, ptr [[ARRAY_B]], i64 [[I_I64]]
; CHECK-NEXT:    [[ARRAY_B_I:%.*]] = load i32, ptr [[ARRAY_B_I_PTR]], align 4
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[ARRAY_A_I]], [[ARRAY_B_I]]
; CHECK-NEXT:    [[LOOP_ACC_NEXT]] = add i32 [[LOOP_ACC]], [[SUM]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i32 [[I]], 1
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CONTINUE]], label %[[LOOP]], label %[[EXIT:.*]], !prof [[PROF1]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[LOOP_ACC_NEXT_LCSSA:%.*]] = phi i32 [ [[LOOP_ACC_NEXT]], %[[IN_BOUNDS_B]] ]
; CHECK-NEXT:    ret i32 [[LOOP_ACC_NEXT_LCSSA]]
;
entry:
  %widenable_cond.entry = call i1 @llvm.experimental.widenable.condition()
  %guard_cond.entry = and i1 %cond, %widenable_cond.entry
  br i1 %guard_cond.entry, label %loop.preheader, label %deopt.entry, !prof !0

deopt.entry:
  %deoptcall.entry = call i32 (...) @llvm.experimental.deoptimize.i32(i32 8) [ "deopt"() ]
  ret i32 %deoptcall.entry

loop.preheader:
  br label %loop

loop:
  %loop.acc = phi i32 [ %loop.acc.next, %in.bounds.b ], [ 0, %loop.preheader ]
  %i = phi i32 [ %i.next, %in.bounds.b ], [ 0, %loop.preheader ]
  %within.bounds.a = icmp ult i32 %i, %length.a
  %widenable_cond.a = call i1 @llvm.experimental.widenable.condition()
  %guard_cond.a = and i1 %within.bounds.a, %widenable_cond.a
  br i1 %guard_cond.a, label %guarded.a, label %deopt.a, !prof !0

deopt.a:
  %deoptcall.a = call i32 (...) @llvm.experimental.deoptimize.i32(i32 9) [ "deopt"() ]
  ret i32 %deoptcall.a

guarded.a:
  %within.bounds.b = icmp ult i32 %i, %length.b
  br i1 %within.bounds.b, label %in.bounds.b, label %deopt.b, !prof !3

deopt.b:
  %deoptcall.b = call i32 (...) @llvm.experimental.deoptimize.i32(i32 10) [ "deopt"() ]
  ret i32 %deoptcall.b

in.bounds.b:
  %i.i64 = zext i32 %i to i64
  %array.a.i.ptr = getelementptr inbounds i32, ptr %array.a, i64 %i.i64
  %array.a.i = load i32, ptr %array.a.i.ptr, align 4
  %array.b.i.ptr = getelementptr inbounds i32, ptr %array.b, i64 %i.i64
  %array.b.i = load i32, ptr %array.b.i.ptr, align 4
  %sum = add i32 %array.a.i, %array.b.i
  %loop.acc.next = add i32 %loop.acc, %sum
  %i.next = add nuw i32 %i, 1
  %continue = icmp ult i32 %i.next, %n
  br i1 %continue, label %loop, label %exit, !prof !1

exit:
  ret i32 %loop.acc.next
}

; A guard intrinsic and a guard expressed as a widenable branch. Both guards
; are predicated.
define i32 @guard_intrinsic_and_widenable_guard(ptr %array.a, i32 %length.a, ptr %array.b, i32 %length.b, i32 %n) {
; CHECK-LABEL: define i32 @guard_intrinsic_and_widenable_guard(
; CHECK-SAME: ptr [[ARRAY_A:%.*]], i32 [[LENGTH_A:%.*]], ptr [[ARRAY_B:%.*]], i32 [[LENGTH_B:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ZERO_TRIP:%.*]] = icmp eq i32 [[N]], 0
; CHECK-NEXT:    br i1 [[ZERO_TRIP]], label %[[EXIT:.*]], label %[[LOOP_PREHEADER:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ule i32 [[N]], [[LENGTH_A]]
; CHECK-NEXT:    [[TMP1:%.*]] = icmp ult i32 0, [[LENGTH_A]]
; CHECK-NEXT:    [[TMP2:%.*]] = and i1 [[TMP1]], [[TMP0]]
; CHECK-NEXT:    [[TMP3:%.*]] = freeze i1 [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = icmp ule i32 [[N]], [[LENGTH_B]]
; CHECK-NEXT:    [[TMP5:%.*]] = icmp ult i32 0, [[LENGTH_B]]
; CHECK-NEXT:    [[TMP6:%.*]] = and i1 [[TMP5]], [[TMP4]]
; CHECK-NEXT:    [[TMP7:%.*]] = freeze i1 [[TMP6]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LOOP_ACC:%.*]] = phi i32 [ [[LOOP_ACC_NEXT:%.*]], %[[GUARDED_B:.*]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[GUARDED_B]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[WITHIN_BOUNDS_A:%.*]] = icmp ult i32 [[I]], [[LENGTH_A]]
; CHECK-NEXT:    call void (i1, ...) @llvm.experimental.guard(i1 [[TMP3]], i32 9) [ "deopt"() ]
; CHECK-NEXT:    call void @llvm.assume(i1 [[WITHIN_BOUNDS_A]])
; CHECK-NEXT:    [[WITHIN_BOUNDS_B:%.*]] = icmp ult i32 [[I]], [[LENGTH_B]]
; CHECK-NEXT:    [[WIDENABLE_COND_B:%.*]] = call i1 @llvm.experimental.widenable.condition()
; CHECK-NEXT:    [[TMP8:%.*]] = and i1 [[TMP7]], [[WIDENABLE_COND_B]]
; CHECK-NEXT:    br i1 [[TMP8]], label %[[GUARDED_B]], label %[[DEOPT_B:.*]], !prof [[PROF0]]
; CHECK:       [[DEOPT_B]]:
; CHECK-NEXT:    [[DEOPTCALL_B:%.*]] = call i32 (...) @llvm.experimental.deoptimize.i32(i32 10) [ "deopt"() ]
; CHECK-NEXT:    ret i32 [[DEOPTCALL_B]]
; CHECK:       [[GUARDED_B]]:
; CHECK-NEXT:    call void @llvm.assume(i1 [[WITHIN_BOUNDS_B]])
; CHECK-NEXT:    [[I_I64:%.*]] = zext i32 [[I]] to i64
; CHECK-NEXT:    [[ARRAY_A_I_PTR:%.*]] = getelementptr inbounds i32, ptr [[ARRAY_A]], i64 [[I_I64]]
; CHECK-NEXT:    [[ARRAY_A_I:%.*]] = load i32, ptr [[ARRAY_A_I_PTR]], align 4
; CHECK-NEXT:    [[ARRAY_B_I_PTR:%.*]] = getelementptr inbounds i32, ptr [[ARRAY_B]], i64 [[I_I64]]
; CHECK-NEXT:    [[ARRAY_B_I:%.*]] = load i32, ptr [[ARRAY_B_I_PTR]], align 4
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[ARRAY_A_I]], [[ARRAY_B_I]]
; CHECK-NEXT:    [[LOOP_ACC_NEXT]] = add i32 [[LOOP_ACC]], [[SUM]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i32 [[I]], 1
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CONTINUE]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]], !prof [[PROF1]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[LOOP_ACC_NEXT_LCSSA:%.*]] = phi i32 [ [[LOOP_ACC_NEXT]], %[[GUARDED_B]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RESULT:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[LOOP_ACC_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[RESULT]]
;
entry:
  %zero.trip = icmp eq i32 %n, 0
  br i1 %zero.trip, label %exit, label %loop.preheader

loop.preheader:
  br label %loop

loop:
  %loop.acc = phi i32 [ %loop.acc.next, %guarded.b ], [ 0, %loop.preheader ]
  %i = phi i32 [ %i.next, %guarded.b ], [ 0, %loop.preheader ]
  %within.bounds.a = icmp ult i32 %i, %length.a
  call void (i1, ...) @llvm.experimental.guard(i1 %within.bounds.a, i32 9) [ "deopt"() ]
  %within.bounds.b = icmp ult i32 %i, %length.b
  %widenable_cond.b = call i1 @llvm.experimental.widenable.condition()
  %guard_cond.b = and i1 %within.bounds.b, %widenable_cond.b
  br i1 %guard_cond.b, label %guarded.b, label %deopt.b, !prof !0

deopt.b:
  %deoptcall.b = call i32 (...) @llvm.experimental.deoptimize.i32(i32 10) [ "deopt"() ]
  ret i32 %deoptcall.b

guarded.b:
  %i.i64 = zext i32 %i to i64
  %array.a.i.ptr = getelementptr inbounds i32, ptr %array.a, i64 %i.i64
  %array.a.i = load i32, ptr %array.a.i.ptr, align 4
  %array.b.i.ptr = getelementptr inbounds i32, ptr %array.b, i64 %i.i64
  %array.b.i = load i32, ptr %array.b.i.ptr, align 4
  %sum = add i32 %array.a.i, %array.b.i
  %loop.acc.next = add i32 %loop.acc, %sum
  %i.next = add nuw i32 %i, 1
  %continue = icmp ult i32 %i.next, %n
  br i1 %continue, label %loop, label %exit, !prof !1

exit:
  %result = phi i32 [ 0, %entry ], [ %loop.acc.next, %guarded.b ]
  ret i32 %result
}

; A guard and an early exit to a non-deopt block with weights {1, 1048576}, i.e.
; ~9.5e-7, more than twice the latch exit. The guard is not predicated.
define i32 @rare_early_exit(ptr %array, i32 %length, i32 %n, i32 %key) {
; CHECK-LABEL: define i32 @rare_early_exit(
; CHECK-SAME: ptr [[ARRAY:%.*]], i32 [[LENGTH:%.*]], i32 [[N:%.*]], i32 [[KEY:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ZERO_TRIP:%.*]] = icmp eq i32 [[N]], 0
; CHECK-NEXT:    br i1 [[ZERO_TRIP]], label %[[EXIT:.*]], label %[[LOOP_PREHEADER:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[LOOP_ACC:%.*]] = phi i32 [ [[LOOP_ACC_NEXT:%.*]], %[[LATCH:.*]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[LATCH]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[WITHIN_BOUNDS:%.*]] = icmp ult i32 [[I]], [[LENGTH]]
; CHECK-NEXT:    [[WIDENABLE_COND:%.*]] = call i1 @llvm.experimental.widenable.condition()
; CHECK-NEXT:    [[GUARD_COND:%.*]] = and i1 [[WITHIN_BOUNDS]], [[WIDENABLE_COND]]
; CHECK-NEXT:    br i1 [[GUARD_COND]], label %[[GUARDED:.*]], label %[[DEOPT:.*]], !prof [[PROF0]]
; CHECK:       [[DEOPT]]:
; CHECK-NEXT:    [[DEOPTCALL:%.*]] = call i32 (...) @llvm.experimental.deoptimize.i32(i32 9) [ "deopt"() ]
; CHECK-NEXT:    ret i32 [[DEOPTCALL]]
; CHECK:       [[GUARDED]]:
; CHECK-NEXT:    [[I_I64:%.*]] = zext i32 [[I]] to i64
; CHECK-NEXT:    [[ARRAY_I_PTR:%.*]] = getelementptr inbounds i32, ptr [[ARRAY]], i64 [[I_I64]]
; CHECK-NEXT:    [[ARRAY_I:%.*]] = load i32, ptr [[ARRAY_I_PTR]], align 4
; CHECK-NEXT:    [[FOUND:%.*]] = icmp eq i32 [[ARRAY_I]], [[KEY]]
; CHECK-NEXT:    br i1 [[FOUND]], label %[[EARLY_EXIT:.*]], label %[[LATCH]], !prof [[PROF4:![0-9]+]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[LOOP_ACC_NEXT]] = add i32 [[LOOP_ACC]], [[ARRAY_I]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw i32 [[I]], 1
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CONTINUE]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]], !prof [[PROF1]]
; CHECK:       [[EARLY_EXIT]]:
; CHECK-NEXT:    ret i32 -1
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    [[LOOP_ACC_NEXT_LCSSA:%.*]] = phi i32 [ [[LOOP_ACC_NEXT]], %[[LATCH]] ]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RESULT:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[LOOP_ACC_NEXT_LCSSA]], %[[EXIT_LOOPEXIT]] ]
; CHECK-NEXT:    ret i32 [[RESULT]]
;
entry:
  %zero.trip = icmp eq i32 %n, 0
  br i1 %zero.trip, label %exit, label %loop.preheader

loop.preheader:
  br label %loop

loop:
  %loop.acc = phi i32 [ %loop.acc.next, %latch ], [ 0, %loop.preheader ]
  %i = phi i32 [ %i.next, %latch ], [ 0, %loop.preheader ]
  %within.bounds = icmp ult i32 %i, %length
  %widenable_cond = call i1 @llvm.experimental.widenable.condition()
  %guard_cond = and i1 %within.bounds, %widenable_cond
  br i1 %guard_cond, label %guarded, label %deopt, !prof !0

deopt:
  %deoptcall = call i32 (...) @llvm.experimental.deoptimize.i32(i32 9) [ "deopt"() ]
  ret i32 %deoptcall

guarded:
  %i.i64 = zext i32 %i to i64
  %array.i.ptr = getelementptr inbounds i32, ptr %array, i64 %i.i64
  %array.i = load i32, ptr %array.i.ptr, align 4
  %found = icmp eq i32 %array.i, %key
  br i1 %found, label %early.exit, label %latch, !prof !4

latch:
  %loop.acc.next = add i32 %loop.acc, %array.i
  %i.next = add nuw i32 %i, 1
  %continue = icmp ult i32 %i.next, %n
  br i1 %continue, label %loop, label %exit, !prof !1

early.exit:
  ret i32 -1

exit:
  %result = phi i32 [ 0, %entry ], [ %loop.acc.next, %latch ]
  ret i32 %result
}

