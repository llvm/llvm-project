  br label %early.exit.deopt

early.exit.deopt:
  %deoptcall.early = call i32 (...) @llvm.experimental.deoptimize.i32(i32 11) [ "deopt"() ]
  ret i32 %deoptcall.early

exit:
  %result = phi i32 [ 0, %entry ], [ %loop.acc.next, %latch ]
  ret i32 %result
}

