; CHECK-NEXT:    store i32 [[L_LVER_ORIG]], ptr [[GEP_B_LVER_ORIG]], align 4
; CHECK-NEXT:    [[IV_NEXT_LVER_ORIG]] = add nuw nsw i64 [[IV_LVER_ORIG]], 1
