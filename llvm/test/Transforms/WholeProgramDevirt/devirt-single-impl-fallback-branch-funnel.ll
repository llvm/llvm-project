; CHECK-NEXT:    [[VPTR:%.*]] = load ptr, ptr [[P]], align 8
; CHECK-NEXT:    [[VTABLE:%.*]] = load ptr, ptr [[VPTR]], align 8
; CHECK-NEXT:    [[TMP0:%.*]] = call i1 @llvm.type.test(ptr [[VTABLE]], metadata !"_ZTS1A")
; CHECK-NEXT:    call void @llvm.assume(i1 [[TMP0]])
; CHECK-NEXT:    [[FPTR:%.*]] = load ptr, ptr [[VTABLE]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = icmp eq ptr [[FPTR]], @_ZN1A1fEv
; CHECK-NEXT:    br i1 [[TMP1]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF3:![0-9]+]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
