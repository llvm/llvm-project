; Check whether the type.test intrinsic is removed after devirtualization when
; the fallback mode is used for WPD.

target datalayout = "e-p:64:64"
target triple = "x86_64-unknown-linux-gnu"

; CHECK: remark: <unknown>:0:0: single-impl: devirtualized a call to _ZN1A1fEv

%struct.A = type { ptr }

@_ZTV1A = linkonce_odr hidden constant { [3 x ptr] } { [3 x ptr] [ptr null, ptr null, ptr @_ZN1A1fEv] }, !type !0, !vcall_visibility !1

define i32 @test(ptr %p) {
; CHECK-LABEL: define i32 @test(
; CHECK-SAME: ptr [[P:%.*]]) !guid [[META2:![0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load ptr, ptr [[P]], align 8
; CHECK-NEXT:    [[VTABLE:%.*]] = load ptr, ptr [[TMP0]], align 8
; CHECK-NEXT:    br i1 true, label %[[CONT:.*]], label %[[TRAP:.*]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2)
; CHECK-NEXT:    unreachable
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[VTABLE]], i32 0
; CHECK-NEXT:    [[TMP2:%.*]] = load ptr, ptr [[TMP1]], align 8
; CHECK-NEXT:    [[TMP4:%.*]] = icmp eq ptr [[TMP2]], @_ZN1A1fEv
; CHECK-NEXT:    br i1 [[TMP4]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF3:![0-9]+]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
; CHECK-NEXT:    [[CALL:%.*]] = call i32 @_ZN1A1fEv(ptr [[TMP0]])
; CHECK-NEXT:    br label %[[IF_END_ICP:.*]]
; CHECK:       [[IF_FALSE_ORIG_INDIRECT]]:
; CHECK-NEXT:    [[CALL1:%.*]] = call i32 [[TMP2]](ptr [[TMP0]])
; CHECK-NEXT:    br label %[[IF_END_ICP]]
; CHECK:       [[IF_END_ICP]]:
; CHECK-NEXT:    [[TMP6:%.*]] = phi i32 [ [[CALL1]], %[[IF_FALSE_ORIG_INDIRECT]] ], [ [[CALL]], %[[IF_TRUE_DIRECT_TARG]] ]
; CHECK-NEXT:    ret i32 [[TMP6]]
;
entry:
  %0 = load ptr, ptr %p
  %vtable = load ptr, ptr %0
  %1 = call { ptr, i1 } @llvm.type.checked.load(ptr %vtable, i32 0, metadata !"_ZTS1A")
  %2 = extractvalue { ptr, i1 } %1, 1
  br i1 %2, label %cont, label %trap

trap:
  call void @llvm.ubsantrap(i8 2)
  unreachable

cont:
  %3 = extractvalue { ptr, i1 } %1, 0
  %call = call i32 %3(ptr %0)
  ret i32 %call
}

declare i32 @_ZN1A1fEv(ptr %this)

declare { ptr, i1 } @llvm.type.checked.load(ptr, i32, metadata)
declare void @llvm.ubsantrap(i8 immarg)

!0 = !{i64 16, !"_ZTS1A"}
!1 = !{i64 1}
;.
