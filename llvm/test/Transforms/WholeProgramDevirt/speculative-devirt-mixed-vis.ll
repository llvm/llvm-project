; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=wholeprogramdevirt -devirtualize-speculatively -pass-remarks=wholeprogramdevirt %s 2>&1 | FileCheck %s

; Check that speculative and non-speculative single-impl devirtualization
; work correctly together based on vcall_visibilities.

target datalayout = "e-p:64:64"
target triple = "x86_64-unknown-linux-gnu"

; CHECK: remark: <unknown>:0:0: single-impl: devirtualized a call to _ZN1A1fEv
; CHECK: remark: <unknown>:0:0: single-impl: devirtualized a call to _ZN1B1fEv

%struct.A = type { ptr }
%struct.B = type { ptr }

@_ZTV1A = linkonce_odr hidden constant { [3 x ptr] } { [3 x ptr] [ptr null, ptr null, ptr @_ZN1A1fEv] }, !type !0, !vcall_visibility !2
@_ZTV1B = linkonce_odr hidden constant { [3 x ptr] } { [3 x ptr] [ptr null, ptr null, ptr @_ZN1B1fEv] }, !type !1, !vcall_visibility !3

define i32 @test_speculative(ptr %p) {
; CHECK-LABEL: define i32 @test_speculative(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load ptr, ptr [[P]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call i1 @llvm.public.type.test(ptr [[TMP0]], metadata !"_ZTS1A")
; CHECK-NEXT:    call void @llvm.assume(i1 [[TMP1]])
; CHECK-NEXT:    [[TMP2:%.*]] = load ptr, ptr [[TMP0]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = icmp eq ptr [[TMP2]], @_ZN1A1fEv
; CHECK-NEXT:    br i1 [[TMP3]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF2:![0-9]+]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
; CHECK-NEXT:    [[TMP4:%.*]] = call i32 @_ZN1A1fEv(ptr [[P]])
; CHECK-NEXT:    br label %[[IF_END_ICP:.*]]
; CHECK:       [[IF_FALSE_ORIG_INDIRECT]]:
; CHECK-NEXT:    [[TMP5:%.*]] = call i32 [[TMP2]](ptr [[P]])
; CHECK-NEXT:    br label %[[IF_END_ICP]]
; CHECK:       [[IF_END_ICP]]:
; CHECK-NEXT:    [[TMP6:%.*]] = phi i32 [ [[TMP5]], %[[IF_FALSE_ORIG_INDIRECT]] ], [ [[TMP4]], %[[IF_TRUE_DIRECT_TARG]] ]
; CHECK-NEXT:    ret i32 [[TMP6]]
;
entry:
  %2 = load ptr, ptr %p
  %3 = call i1 @llvm.public.type.test(ptr %2, metadata !"_ZTS1A") ; public vcall_visibility
  call void @llvm.assume(i1 %3)
  %4 = load ptr, ptr %2
  %5 = call i32 %4(ptr %p)
  ret i32 %5
}

define i32 @test_non_speculative(ptr %p) {
; CHECK-LABEL: define i32 @test_non_speculative(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load ptr, ptr [[P]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = call i1 @llvm.public.type.test(ptr [[TMP0]], metadata !"_ZTS1B")
; CHECK-NEXT:    call void @llvm.assume(i1 [[TMP1]])
; CHECK-NEXT:    [[TMP2:%.*]] = load ptr, ptr [[TMP0]], align 8
; CHECK-NEXT:    [[TMP3:%.*]] = call i32 @_ZN1B1fEv(ptr [[P]])
; CHECK-NEXT:    ret i32 [[TMP3]]
;
entry:
  %2 = load ptr, ptr %p
  %3 = call i1 @llvm.public.type.test(ptr %2, metadata !"_ZTS1B") ; hidden vcall_visibility
  call void @llvm.assume(i1 %3)
  %4 = load ptr, ptr %2
  %5 = call i32 %4(ptr %p)
  ret i32 %5
}

declare i32 @_ZN1A1fEv(ptr %this)
declare i32 @_ZN1B1fEv(ptr %this)

!0 = !{i64 16, !"_ZTS1A"}
!1 = !{i64 16, !"_ZTS1B"}
!2 = !{i64 0}
!3 = !{i64 1}
;.
