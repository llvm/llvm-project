;; Check that no stack protector is inserted for functions with
;; "stack-protector-layout-only", whether one is required by a buffer
;; (sspstrong) or unconditionally (sspreq).
; REQUIRES: x86-registered-target
; RUN: opt -mtriple=x86_64-pc-linux-gnu -passes='require<libcall-lowering-info>,stack-protector' -S -o - %s | FileCheck %s

declare void @use(ptr)

define void @layout_only_strong() sspstrong "stack-protector-layout-only" {
; CHECK-LABEL: define void @layout_only_strong(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[BUF:%.*]] = alloca [16 x i8], align 1
; CHECK-NEXT:    call void @use(ptr [[BUF]])
; CHECK-NEXT:    ret void
;
  %buf = alloca [16 x i8], align 1
  call void @use(ptr %buf)
  ret void
}

define void @layout_only_req() sspreq "stack-protector-layout-only" {
; CHECK-LABEL: define void @layout_only_req(
; CHECK-SAME: ) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    ret void
;
  ret void
}

