; CHECK64-NEXT:    [[J_NEXT]] = add i32 [[J]], 1
; CHECK64-NEXT:    [[J_CMP:%.*]] = icmp ult i32 [[J_NEXT]], 2
; CHECK64-NEXT:    br i1 [[J_CMP]], label %[[INNER]], label %[[OUTER_LATCH]]
