; CHECK64-NEXT:    [[CMP3:%.*]] = icmp ult i32 0, [[N]]
; CHECK64-NEXT:    br i1 [[CMP3]], label %[[FOR_OUTER_PREHEADER:.*]], label %[[FOR_END:.*]]
; CHECK64:       [[FOR_OUTER_PREHEADER]]:
; CHECK64-NEXT:    br label %[[FOR_INNER_PREHEADER:.*]]
; CHECK64:       [[FOR_INNER_PREHEADER]]:
; CHECK64-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[FOR_OUTER_PREHEADER]] ], [ [[INC2:%.*]], %[[FOR_OUTER:.*]] ]
; CHECK64-NEXT:    [[X:%.*]] = load i32, ptr @c, align 4
; CHECK64-NEXT:    br label %[[FOR_INNER:.*]]
; CHECK64:       [[FOR_INNER]]:
; CHECK64-NEXT:    [[J:%.*]] = phi i32 [ 0, %[[FOR_INNER_PREHEADER]] ], [ [[INC1:%.*]], %[[FOR_INNER]] ]
; CHECK64-NEXT:    [[MUL:%.*]] = mul i32 [[I]], [[N]]
; CHECK64-NEXT:    [[GEP:%.*]] = getelementptr inbounds i32, ptr [[A]], i32 [[MUL]]
; CHECK64-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds i32, ptr [[GEP]], i32 [[J]]
; CHECK64-NEXT:    store i32 [[X]], ptr [[ARRAYIDX]], align 4
; CHECK64-NEXT:    [[INC1]] = add nuw i32 [[J]], 1
; CHECK64-NEXT:    [[CMP2:%.*]] = icmp ult i32 [[INC1]], [[N]]
; CHECK64-NEXT:    br i1 [[CMP2]], label %[[FOR_INNER]], label %[[FOR_OUTER]]
; CHECK64:       [[FOR_OUTER]]:
; CHECK64-NEXT:    [[INC2]] = add i32 [[I]], 1
; CHECK64-NEXT:    [[CMP1:%.*]] = icmp ult i32 [[INC2]], [[N]]
; CHECK64-NEXT:    br i1 [[CMP1]], label %[[FOR_INNER_PREHEADER]], label %[[FOR_END_LOOPEXIT:.*]]
; CHECK64:       [[FOR_END_LOOPEXIT]]:
; CHECK64-NEXT:    br label %[[FOR_END]]
; CHECK64:       [[FOR_END]]:
; CHECK64-NEXT:    ret void
