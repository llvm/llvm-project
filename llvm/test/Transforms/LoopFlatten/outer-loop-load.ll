; CHECK32-NEXT:    [[CMP1:%.*]] = icmp ult i32 [[INC2]], [[N]]
; CHECK32-NEXT:    br i1 [[CMP1]], label %[[FOR_INNER_PREHEADER]], label %[[FOR_END_LOOPEXIT:.*]]
; CHECK32:       [[FOR_END_LOOPEXIT]]:
