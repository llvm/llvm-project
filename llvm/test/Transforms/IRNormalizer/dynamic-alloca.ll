; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -S -passes='normalize<no-rename-all>' -verify-each < %s | FileCheck %s

; An llvm.stackrestore frees the allocas made after its llvm.stacksave, and no
; SSA edge ties an alloca to either intrinsic. Reordering must not move an
; alloca down across either one.

declare void @use(ptr)
declare void @inalloca_callee(ptr inalloca(i32))

; Regression test for https://github.com/llvm/llvm-project/issues/237782.
; If %a sinks below the llvm.stacksave, the llvm.stackrestore frees it and %b
; reuses its memory, so the load reads 7 instead of 42.
define i32 @variable_size_alloca(i32 %n) {
; CHECK-LABEL: define i32 @variable_size_alloca(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[BB64766:.*:]]
; CHECK-NEXT:    [[A:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    store i32 42, ptr [[A]], align 4
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[B:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    store i32 7, ptr [[B]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %a = alloca i32, i32 %n, align 4
  %sp = call ptr @llvm.stacksave.p0()
  store i32 42, ptr %a, align 4
  call void @llvm.stackrestore.p0(ptr %sp)
  %b = alloca i32, i32 %n, align 4
  store i32 7, ptr %b, align 4
  %v = load i32, ptr %a, align 4
  ret i32 %v
}

; Outside the entry block, an alloca is dynamic even when its size is fixed.
define i32 @fixed_size_alloca_outside_entry() {
; CHECK-LABEL: define i32 @fixed_size_alloca_outside_entry() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    store i32 42, ptr [[A]], align 4
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[B:%.*]] = alloca i32, align 4
; CHECK-NEXT:    store i32 7, ptr [[B]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  br label %body

body:
  %a = alloca i32, align 4
  %sp = call ptr @llvm.stacksave.p0()
  store i32 42, ptr %a, align 4
  call void @llvm.stackrestore.p0(ptr %sp)
  %b = alloca i32, align 4
  store i32 7, ptr %b, align 4
  %v = load i32, ptr %a, align 4
  ret i32 %v
}

; An inalloca alloca is never static, even in the entry block with a fixed size.
define i32 @inalloca_alloca() {
; CHECK-LABEL: define i32 @inalloca_alloca() {
; CHECK-NEXT:  [[BB32326:.*:]]
; CHECK-NEXT:    call void @use(ptr null)
; CHECK-NEXT:    [[A:%.*]] = alloca inalloca i32, align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    store i32 42, ptr [[A]], align 4
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    call void @inalloca_callee(ptr inalloca(i32) [[A]])
; CHECK-NEXT:    ret i32 [[V]]
;
  call void @use(ptr null)
  %a = alloca inalloca i32, align 4
  %sp = call ptr @llvm.stacksave.p0()
  store i32 42, ptr %a, align 4
  call void @llvm.stackrestore.p0(ptr %sp)
  %v = load i32, ptr %a, align 4
  call void @inalloca_callee(ptr inalloca(i32) %a)
  ret i32 %v
}

; The alloca has no user in its block, so it would otherwise sink to the end of
; the block, past the llvm.stacksave. The llvm.stackrestore is in the successor.
define i32 @user_in_successor(i32 %n) {
; CHECK-LABEL: define i32 @user_in_successor(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[A:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    store i32 42, ptr [[A]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[A]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  %a = alloca i32, i32 %n, align 4
  %sp = call ptr @llvm.stacksave.p0()
  br label %exit

exit:
  call void @llvm.stackrestore.p0(ptr %sp)
  store i32 42, ptr %a, align 4
  %v = load i32, ptr %a, align 4
  ret i32 %v
}

; The size computation may still sink, but only as far as the alloca.
define void @size_operand_stays_above_alloca(i32 %n) {
; CHECK-LABEL: define void @size_operand_stays_above_alloca(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[BB69501:.*:]]
; CHECK-NEXT:    call void @use(ptr null)
; CHECK-NEXT:    [[SIZE:%.*]] = mul i32 [[N]], 2
; CHECK-NEXT:    [[A:%.*]] = alloca i32, i32 [[SIZE]], align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    call void @use(ptr [[A]])
; CHECK-NEXT:    ret void
;
  %size = mul i32 %n, 2
  call void @use(ptr null)
  %a = alloca i32, i32 %size, align 4
  %sp = call ptr @llvm.stacksave.p0()
  call void @llvm.stackrestore.p0(ptr %sp)
  call void @use(ptr %a)
  ret void
}

; Sinking %a past the llvm.stackrestore that should free it would grow the stack
; on every iteration of the loop. Taking its address after the llvm.stackrestore
; is fine, as long as nothing dereferences it.
define i64 @alloca_stays_above_stackrestore(i32 %n, i1 %c) {
; CHECK-LABEL: define i64 @alloca_stays_above_stackrestore(
; CHECK-SAME: i32 [[N:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    [[A:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    br label %[[LATCH:.*]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[P:%.*]] = ptrtoint ptr [[A]] to i64
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 [[P]]
;
entry:
  br label %loop

loop:
  %sp = call ptr @llvm.stacksave.p0()
  %a = alloca i32, i32 %n, align 4
  call void @llvm.stackrestore.p0(ptr %sp)
  br label %latch

latch:
  %p = ptrtoint ptr %a to i64
  br i1 %c, label %loop, label %exit

exit:
  ret i64 %p
}

; An inalloca argument must be the most recent live stack allocation at its
; call.
define void @inalloca_stays_most_recent(i32 %n) {
; CHECK-LABEL: define void @inalloca_stays_most_recent(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[BB17390:.*:]]
; CHECK-NEXT:    [[V:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    [[ARGS:%.*]] = alloca inalloca i32, align 4
; CHECK-NEXT:    store i32 1, ptr [[ARGS]], align 4
; CHECK-NEXT:    store i32 2, ptr [[V]], align 4
; CHECK-NEXT:    call void @inalloca_callee(ptr inalloca(i32) [[ARGS]])
; CHECK-NEXT:    ret void
;
  %v = alloca i32, i32 %n, align 4
  %args = alloca inalloca i32, align 4
  store i32 1, ptr %args, align 4
  store i32 2, ptr %v, align 4
  call void @inalloca_callee(ptr inalloca(i32) %args)
  ret void
}

; The first instruction keeps %x out of the leading allocas of the entry block.
; It still has to stay above the llvm.stacksave.
define i32 @static_alloca_after_convergence_entry(i32 %n) convergent {
; CHECK-LABEL: define i32 @static_alloca_after_convergence_entry(
; CHECK-SAME: i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[BB64766:.*:]]
; CHECK-NEXT:    [[T:%.*]] = call token @llvm.experimental.convergence.entry()
; CHECK-NEXT:    [[X:%.*]] = alloca i32, align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    store i32 42, ptr [[X]], align 4
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[B:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    store i32 7, ptr [[B]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[X]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %t = call token @llvm.experimental.convergence.entry()
  %x = alloca i32, align 4
  %sp = call ptr @llvm.stacksave.p0()
  store i32 42, ptr %x, align 4
  call void @llvm.stackrestore.p0(ptr %sp)
  %b = alloca i32, i32 %n, align 4
  store i32 7, ptr %b, align 4
  %v = load i32, ptr %x, align 4
  ret i32 %v
}

; A static alloca can join the leading allocas of the entry block, which only
; moves it up and extends its lifetime.
define i32 @static_alloca_moves_up(i32 %n) {
; CHECK-LABEL: define i32 @static_alloca_moves_up(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[BB10466:.*:]]
; CHECK-NEXT:    [[X:%.*]] = alloca i32, align 4
; CHECK-NEXT:    call void @use(ptr null)
; CHECK-NEXT:    [[A:%.*]] = alloca i32, i32 [[N]], align 4
; CHECK-NEXT:    [[SP:%.*]] = call ptr @llvm.stacksave.p0()
; CHECK-NEXT:    store i32 42, ptr [[X]], align 4
; CHECK-NEXT:    store i32 1, ptr [[A]], align 4
; CHECK-NEXT:    call void @llvm.stackrestore.p0(ptr [[SP]])
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[X]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  call void @use(ptr null)
  %a = alloca i32, i32 %n, align 4
  %x = alloca i32, align 4
  %sp = call ptr @llvm.stacksave.p0()
  store i32 42, ptr %x, align 4
  store i32 1, ptr %a, align 4
  call void @llvm.stackrestore.p0(ptr %sp)
  %v = load i32, ptr %x, align 4
  ret i32 %v
}

define void @static_alloca_below_stacksave_moves_up() {
