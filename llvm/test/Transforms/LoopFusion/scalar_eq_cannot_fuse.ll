; Negative tests: the scalar EQ dependence change must not fuse these patterns.
; Both loops must survive as separate loops, so each function keeps two
; backedges and the first loop still exits into the second loop's preheader.

; Loop 1 stores A[i]; loop 2 loads A[i + 1], a forward loop-carried dependence.

; C Code
;
;;  for (long int i = 0; i < n; i++)
;;    A[i] = w0;
;;  for (long int i = 0; i < n; i++)
;;    A[i] = A[i + 1];

define void @store_then_load_next(ptr noalias nocapture %A, i64 %n, float %w0) {
; CHECK-LABEL: define void @store_then_load_next(
; CHECK-SAME: ptr noalias captures(none) [[A:%.*]], i64 [[N:%.*]], float [[W0:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    [[I1:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I1_NEXT:%.*]], %[[LOOP1_LATCH:.*]] ]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[I1]]
; CHECK-NEXT:    store float [[W0]], ptr [[GEP1]], align 4
; CHECK-NEXT:    br label %[[LOOP1_LATCH]]
; CHECK:       [[LOOP1_LATCH]]:
; CHECK-NEXT:    [[I1_NEXT]] = add nuw nsw i64 [[I1]], 1
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ult i64 [[I1_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP1]], label %[[LOOP1]], label %[[LOOP2_PREHEADER:.*]]
; CHECK:       [[LOOP2_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP2:.*]]
; CHECK:       [[LOOP2]]:
; CHECK-NEXT:    [[I2:%.*]] = phi i64 [ 0, %[[LOOP2_PREHEADER]] ], [ [[I2_NEXT:%.*]], %[[LOOP2_LATCH:.*]] ]
; CHECK-NEXT:    [[NEXT:%.*]] = add nuw nsw i64 [[I2]], 1
; CHECK-NEXT:    [[GEP2:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[NEXT]]
; CHECK-NEXT:    [[V:%.*]] = load float, ptr [[GEP2]], align 4
; CHECK-NEXT:    [[GEP3:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[I2]]
; CHECK-NEXT:    store float [[V]], ptr [[GEP3]], align 4
; CHECK-NEXT:    br label %[[LOOP2_LATCH]]
; CHECK:       [[LOOP2_LATCH]]:
; CHECK-NEXT:    [[I2_NEXT]] = add nuw nsw i64 [[I2]], 1
; CHECK-NEXT:    [[CMP2:%.*]] = icmp ult i64 [[I2_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP2]], label %[[LOOP2]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop1

loop1:
  %i1 = phi i64 [ 0, %entry ], [ %i1.next, %loop1.latch ]
  %gep1 = getelementptr inbounds float, ptr %A, i64 %i1
  store float %w0, ptr %gep1, align 4
  br label %loop1.latch

loop1.latch:
  %i1.next = add nuw nsw i64 %i1, 1
  %cmp1 = icmp ult i64 %i1.next, %n
  br i1 %cmp1, label %loop1, label %loop2.preheader

loop2.preheader:
  br label %loop2

loop2:
  %i2 = phi i64 [ 0, %loop2.preheader ], [ %i2.next, %loop2.latch ]
  %next = add nuw nsw i64 %i2, 1
  %gep2 = getelementptr inbounds float, ptr %A, i64 %next
  %v = load float, ptr %gep2, align 4
  %gep3 = getelementptr inbounds float, ptr %A, i64 %i2
  store float %v, ptr %gep3, align 4
  br label %loop2.latch

loop2.latch:
  %i2.next = add nuw nsw i64 %i2, 1
  %cmp2 = icmp ult i64 %i2.next, %n
  br i1 %cmp2, label %loop2, label %exit

exit:
  ret void
}

; Cross-pointer store-then-accumulate without noalias on the output pointer.

; C Code
