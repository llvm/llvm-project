; Loop fusion checks the dependences of every pair of memory accesses in the
; two loops. Accesses that share a pointer up to a constant offset are grouped,
; and pairs from the same groups with the same offset difference reuse one
; dependence check.

; The first loop writes A[4i .. 4i+3], the second reads A[4i .. 4i+3]. Of the 16
; store/load pairs only 7 offset differences are distinct, so 9 checks are
; answered from an equivalent pair. All dependences are same-iteration, so the
; loops are fused.
define void @same_iteration(ptr noalias %A, ptr noalias %B) {
;
; CHECK-LABEL: define void @same_iteration(
; CHECK-SAME: ptr noalias [[A:%.*]], ptr noalias [[B:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[LOOP1]] ]
; CHECK-NEXT:    [[OFF:%.*]] = shl nuw nsw i64 [[I]], 4
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[OFF]]
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds i8, ptr [[P0]], i64 4
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds i8, ptr [[P0]], i64 8
; CHECK-NEXT:    [[P3:%.*]] = getelementptr inbounds i8, ptr [[P0]], i64 12
; CHECK-NEXT:    [[V:%.*]] = trunc i64 [[I]] to i32
; CHECK-NEXT:    store i32 [[V]], ptr [[P0]], align 4
; CHECK-NEXT:    store i32 1, ptr [[P1]], align 4
; CHECK-NEXT:    store i32 2, ptr [[P2]], align 4
; CHECK-NEXT:    store i32 3, ptr [[P3]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[C1:%.*]] = icmp ne i64 [[I_NEXT]], 100
; CHECK-NEXT:    [[OFF2:%.*]] = shl nuw nsw i64 [[J]], 4
; CHECK-NEXT:    [[Q0:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 [[OFF2]]
; CHECK-NEXT:    [[Q1:%.*]] = getelementptr inbounds i8, ptr [[Q0]], i64 4
; CHECK-NEXT:    [[Q2:%.*]] = getelementptr inbounds i8, ptr [[Q0]], i64 8
; CHECK-NEXT:    [[Q3:%.*]] = getelementptr inbounds i8, ptr [[Q0]], i64 12
; CHECK-NEXT:    [[L0:%.*]] = load i32, ptr [[Q0]], align 4
; CHECK-NEXT:    [[L1:%.*]] = load i32, ptr [[Q1]], align 4
; CHECK-NEXT:    [[L2:%.*]] = load i32, ptr [[Q2]], align 4
; CHECK-NEXT:    [[L3:%.*]] = load i32, ptr [[Q3]], align 4
; CHECK-NEXT:    [[S0:%.*]] = add i32 [[L0]], [[L1]]
; CHECK-NEXT:    [[S1:%.*]] = add i32 [[L2]], [[L3]]
; CHECK-NEXT:    [[S:%.*]] = add i32 [[S0]], [[S1]]
; CHECK-NEXT:    [[DST:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 [[J]]
; CHECK-NEXT:    store i32 [[S]], ptr [[DST]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[C2:%.*]] = icmp ne i64 [[J_NEXT]], 100
; CHECK-NEXT:    br i1 [[C2]], label %[[LOOP1]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop1

loop1:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop1 ]
  %off = shl nuw nsw i64 %i, 4
  %p0 = getelementptr inbounds i8, ptr %A, i64 %off
  %p1 = getelementptr inbounds i8, ptr %p0, i64 4
  %p2 = getelementptr inbounds i8, ptr %p0, i64 8
  %p3 = getelementptr inbounds i8, ptr %p0, i64 12
  %v = trunc i64 %i to i32
  store i32 %v, ptr %p0, align 4
  store i32 1, ptr %p1, align 4
  store i32 2, ptr %p2, align 4
  store i32 3, ptr %p3, align 4
  %i.next = add nuw nsw i64 %i, 1
  %c1 = icmp ne i64 %i.next, 100
  br i1 %c1, label %loop1, label %loop2.ph

loop2.ph:
  br label %loop2

loop2:
  %j = phi i64 [ 0, %loop2.ph ], [ %j.next, %loop2 ]
  %off2 = shl nuw nsw i64 %j, 4
  %q0 = getelementptr inbounds i8, ptr %A, i64 %off2
  %q1 = getelementptr inbounds i8, ptr %q0, i64 4
  %q2 = getelementptr inbounds i8, ptr %q0, i64 8
  %q3 = getelementptr inbounds i8, ptr %q0, i64 12
  %l0 = load i32, ptr %q0, align 4
  %l1 = load i32, ptr %q1, align 4
  %l2 = load i32, ptr %q2, align 4
  %l3 = load i32, ptr %q3, align 4
  %s0 = add i32 %l0, %l1
  %s1 = add i32 %l2, %l3
  %s = add i32 %s0, %s1
  %dst = getelementptr inbounds i32, ptr %B, i64 %j
  store i32 %s, ptr %dst, align 4
  %j.next = add nuw nsw i64 %j, 1
  %c2 = icmp ne i64 %j.next, 100
  br i1 %c2, label %loop2, label %exit

exit:
  ret void
}

