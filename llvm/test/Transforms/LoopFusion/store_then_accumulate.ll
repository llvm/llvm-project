; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=loop-simplify,loop-fusion < %s | FileCheck %s

; Two adjacent loops: store then read-modify-write on the same array element.
; The same-iteration flow dependence is preserved by fusion, since the first
; loop's body is placed before the second loop's body.

; C Code
;
;;  for (long int i = 0; i < n; i++)
;;    hist[i] = A[i];
;;  for (long int i = 0; i < n; i++)
;;    hist[i] += C[i];

define void @store_then_accumulate(ptr noalias %hist, ptr %A, ptr %C, i64 %n) {
; CHECK-LABEL: define void @store_then_accumulate(
; CHECK-SAME: ptr noalias [[HIST:%.*]], ptr [[A:%.*]], ptr [[C:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP1:.*]]
; CHECK:       [[LOOP1]]:
; CHECK-NEXT:    [[I1:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I1_NEXT:%.*]], %[[LOOP2_LATCH:.*]] ]
; CHECK-NEXT:    [[I2:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I2_NEXT:%.*]], %[[LOOP2_LATCH]] ]
; CHECK-NEXT:    [[A_GEP:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[I1]]
; CHECK-NEXT:    [[A_VAL:%.*]] = load float, ptr [[A_GEP]], align 4
; CHECK-NEXT:    [[H1_GEP:%.*]] = getelementptr inbounds float, ptr [[HIST]], i64 [[I1]]
; CHECK-NEXT:    store float [[A_VAL]], ptr [[H1_GEP]], align 4
; CHECK-NEXT:    br label %[[LOOP1_LATCH:.*]]
; CHECK:       [[LOOP1_LATCH]]:
; CHECK-NEXT:    [[C_GEP:%.*]] = getelementptr inbounds float, ptr [[C]], i64 [[I2]]
; CHECK-NEXT:    [[C_VAL:%.*]] = load float, ptr [[C_GEP]], align 4
; CHECK-NEXT:    [[H2_GEP:%.*]] = getelementptr inbounds float, ptr [[HIST]], i64 [[I2]]
; CHECK-NEXT:    [[OLD2:%.*]] = load float, ptr [[H2_GEP]], align 4
; CHECK-NEXT:    [[SUM2:%.*]] = fadd float [[OLD2]], [[C_VAL]]
; CHECK-NEXT:    store float [[SUM2]], ptr [[H2_GEP]], align 4
; CHECK-NEXT:    br label %[[LOOP2_LATCH]]
; CHECK:       [[LOOP2_LATCH]]:
; CHECK-NEXT:    [[I1_NEXT]] = add nuw nsw i64 [[I1]], 1
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ult i64 [[I1_NEXT]], [[N]]
; CHECK-NEXT:    [[I2_NEXT]] = add nuw nsw i64 [[I2]], 1
; CHECK-NEXT:    [[CMP2:%.*]] = icmp ult i64 [[I2_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP2]], label %[[LOOP1]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop1

loop1:
  %i1 = phi i64 [ 0, %entry ], [ %i1.next, %loop1.latch ]
  %a.gep = getelementptr inbounds float, ptr %A, i64 %i1
  %a.val = load float, ptr %a.gep, align 4
  %h1.gep = getelementptr inbounds float, ptr %hist, i64 %i1
  store float %a.val, ptr %h1.gep, align 4
  br label %loop1.latch

loop1.latch:
  %i1.next = add nuw nsw i64 %i1, 1
  %cmp1 = icmp ult i64 %i1.next, %n
  br i1 %cmp1, label %loop1, label %loop2.preheader

loop2.preheader:
  br label %loop2

loop2:
  %i2 = phi i64 [ 0, %loop2.preheader ], [ %i2.next, %loop2.latch ]
  %c.gep = getelementptr inbounds float, ptr %C, i64 %i2
  %c.val = load float, ptr %c.gep, align 4
  %h2.gep = getelementptr inbounds float, ptr %hist, i64 %i2
  %old2 = load float, ptr %h2.gep, align 4
  %sum2 = fadd float %old2, %c.val
  store float %sum2, ptr %h2.gep, align 4
  br label %loop2.latch

loop2.latch:
  %i2.next = add nuw nsw i64 %i2, 1
  %cmp2 = icmp ult i64 %i2.next, %n
  br i1 %cmp2, label %loop2, label %exit

exit:
  ret void
}
