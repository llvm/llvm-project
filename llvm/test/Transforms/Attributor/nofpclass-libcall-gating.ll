; Cases where the callee is not known to be the library function, so no
; deduction may be made from it.

target triple = "x86_64-unknown-linux-gnu"

declare float @sqrtf(float)
declare float @expf(float)
declare float @tanf(double)
declare float @llvm.fabs.f32(float)
declare double @llvm.fabs.f64(double)

; A nobuiltin callsite is not known to call the library function.
define float @ret_sqrtf__nobuiltin_callsite(float nofpclass(nan inf zero sub nnorm) %arg) {
; CHECK-LABEL: define float @ret_sqrtf__nobuiltin_callsite(
; CHECK-SAME: float nofpclass(nan inf zero sub nnorm) [[ARG:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @sqrtf(float nofpclass(nan inf zero sub nnorm) [[ARG]]) #[[ATTR3:[0-9]+]]
; CHECK-NEXT:    ret float [[CALL]]
;
  %call = call float @sqrtf(float %arg) nobuiltin
  ret float %call
}

; sqrtf is marked as unavailable for this function by -fno-builtin-sqrtf.
define float @ret_sqrtf__no_builtin_sqrtf(float nofpclass(nan inf zero sub nnorm) %arg) #0 {
; CHECK-LABEL: define float @ret_sqrtf__no_builtin_sqrtf(
; CHECK-SAME: float nofpclass(nan inf zero sub nnorm) [[ARG:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[CALL:%.*]] = call float @sqrtf(float nofpclass(nan inf zero sub nnorm) [[ARG]])
; CHECK-NEXT:    ret float [[CALL]]
;
  %call = call float @sqrtf(float %arg)
  ret float %call
}

; The real cosh would also rule out pzero and psub.
define internal double @cosh(double %arg) {
; CHECK-LABEL: define internal nofpclass(ninf nzero nsub nnorm) double @cosh(
; CHECK-SAME: double nofpclass(nan inf) [[ARG:%.*]]) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    [[RESULT:%.*]] = call nofpclass(ninf nzero nsub nnorm) double @llvm.fabs.f64(double nofpclass(nan inf) [[ARG]]) #[[ATTR4:[0-9]+]]
; CHECK-NEXT:    ret double [[RESULT]]
;
  %result = call double @llvm.fabs.f64(double %arg)
  ret double %result
}

define double @ret_cosh__local_linkage(double nofpclass(nan inf) %arg) {
; CHECK-LABEL: define nofpclass(ninf nzero nsub nnorm) double @ret_cosh__local_linkage(
; CHECK-SAME: double nofpclass(nan inf) [[ARG:%.*]]) #[[ATTR2]] {
; CHECK-NEXT:    [[CALL:%.*]] = call nofpclass(ninf nzero nsub nnorm) double @cosh(double nofpclass(nan inf) [[ARG]]) #[[ATTR5:[0-9]+]]
; CHECK-NEXT:    ret double [[CALL]]
;
  %call = call double @cosh(double %arg)
  ret double %call
}

; tanf is declared with a prototype that is not valid for the libcall.
define float @ret_tanf__invalid_prototype(double %arg) {
; CHECK-LABEL: define float @ret_tanf__invalid_prototype(
; CHECK-SAME: double [[ARG:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @tanf(double [[ARG]])
; CHECK-NEXT:    ret float [[CALL]]
;
  %call = call float @tanf(double %arg)
  ret float %call
}

; The callsite does not match the prototype of expf, so the callee is not a
; known function.
define float @ret_expf__mistyped_callsite__wrong_arg_count(float nofpclass(nan inf) %arg) {
; CHECK-LABEL: define float @ret_expf__mistyped_callsite__wrong_arg_count(
; CHECK-SAME: float nofpclass(nan inf) [[ARG:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @expf(float nofpclass(nan inf) [[ARG]], float nofpclass(nan inf) [[ARG]])
; CHECK-NEXT:    ret float [[CALL]]
;
  %call = call float @expf(float %arg, float %arg)
  ret float %call
}

define double @ret_expf__mistyped_callsite__wrong_type(float nofpclass(nan inf) %arg) {
; CHECK-LABEL: define double @ret_expf__mistyped_callsite__wrong_type(
; CHECK-SAME: float nofpclass(nan inf) [[ARG:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call double @expf(float nofpclass(nan inf) [[ARG]])
; CHECK-NEXT:    ret double [[CALL]]
;
  %call = call double @expf(float %arg)
  ret double %call
}

; An alias is not a function, so the callee of the call is not a known
; function. coshf would have reported nofpclass(nan ninf zero sub nnorm) here.
define internal float @coshf_impl(float %arg) {
; CHECK-LABEL: define internal nofpclass(ninf nzero nsub nnorm) float @coshf_impl(
; CHECK-SAME: float [[ARG:%.*]]) #[[ATTR2]] {
; CHECK-NEXT:    [[CALL:%.*]] = call nofpclass(ninf nzero nsub nnorm) float @llvm.fabs.f32(float [[ARG]]) #[[ATTR4]]
; CHECK-NEXT:    ret float [[CALL]]
;
  %call = call float @llvm.fabs.f32(float %arg)
  ret float %call
}

@coshf = alias float (float), ptr @coshf_impl

define float @ret_coshf__alias(float nofpclass(nan inf) %arg) {
; CHECK-LABEL: define float @ret_coshf__alias(
; CHECK-SAME: float nofpclass(nan inf) [[ARG:%.*]]) {
; CHECK-NEXT:    [[CALL:%.*]] = call float @coshf(float nofpclass(nan inf) [[ARG]])
; CHECK-NEXT:    ret float [[CALL]]
;
  %call = call float @coshf(float %arg)
  ret float %call
}

attributes #0 = { "no-builtin-sqrtf" }
