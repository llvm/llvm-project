; Storing the writable argument into an alloca writes memory, so the
; function is not readnone, but it only accesses local memory, so
; AAMemoryLocation deduces memory(none). The writable attribute conflicts with
; that and must be dropped.

define void @store_to_alloca(ptr writable %p) {
; TUNIT-LABEL: define void @store_to_alloca(
; TUNIT-SAME: ptr nofree readnone captures(none) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; TUNIT-NEXT:    [[A:%.*]] = alloca ptr, align 8
; TUNIT-NEXT:    ret void
;
; LIGHT-LABEL: define void @store_to_alloca(
; LIGHT-SAME: ptr nofree writeonly captures(none) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; LIGHT-NEXT:    [[A:%.*]] = alloca ptr, align 8
; LIGHT-NEXT:    store ptr [[P]], ptr [[A]], align 8
; LIGHT-NEXT:    ret void
;
  %a = alloca ptr, align 8
  store ptr %p, ptr %a, align 8
  ret void
}

