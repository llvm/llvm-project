; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=attributor %s | FileCheck %s
; RUN: opt -S -passes=attributor-cgscc %s | FileCheck %s
; RUN: opt -S -passes=attributor-light %s | FileCheck %s

; AAMemoryLocation ignores stack memory, so storing %p into an alloca still
; gives memory(none), which conflicts with writable. The pointer is read back,
; so %p is not inferred readnone (which would drop writable on its own). The
; unknown load offset keeps the full Attributor from forwarding the load, so
; all modes give the same output.

define i1 @store_to_alloca_load_unknown_offset(ptr writable %p, i64 %m) {
; CHECK-LABEL: define i1 @store_to_alloca_load_unknown_offset(
; CHECK-SAME: ptr nofree [[P:%.*]], i64 [[M:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[A:%.*]] = alloca [4 x ptr], align 8
; CHECK-NEXT:    store ptr [[P]], ptr [[A]], align 8
; CHECK-NEXT:    [[H:%.*]] = getelementptr ptr, ptr [[A]], i64 [[M]]
; CHECK-NEXT:    [[L:%.*]] = load ptr, ptr [[H]], align 8
; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[L]], null
; CHECK-NEXT:    ret i1 [[C]]
;
  %a = alloca [4 x ptr], align 8
  store ptr %p, ptr %a, align 8
  %h = getelementptr ptr, ptr %a, i64 %m
  %l = load ptr, ptr %h, align 8
  %c = icmp eq ptr %l, null
  ret i1 %c
}
