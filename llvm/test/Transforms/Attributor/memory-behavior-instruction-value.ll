; The loaded pointer %q is written through, so the loads through it are not
; invariant. That the load defining %q does not write memory says nothing
; about accesses through %q.

define i32 @load_store_through_loaded_pointer(ptr %p) {
; CHECK-LABEL: define noundef i32 @load_store_through_loaded_pointer(
; CHECK-SAME: ptr nofree noundef nonnull readonly align 8 captures(none) dereferenceable(8) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[Q:%.*]] = load ptr, ptr [[P]], align 8
; CHECK-NEXT:    [[F:%.*]] = getelementptr i8, ptr [[Q]], i64 128
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[F]], align 8
; CHECK-NEXT:    store i32 [[V]], ptr [[F]], align 8
; CHECK-NEXT:    ret i32 0
;
  %q = load ptr, ptr %p, align 8
  %f = getelementptr i8, ptr %q, i64 128
  %v = load i32, ptr %f, align 8
  store i32 %v, ptr %f, align 8
  ret i32 0
}

; Same for a pointer produced by inttoptr, which does not access memory itself.
define i64 @load_store_through_inttoptr(i64 %address, i1 %update) {
; CHECK-LABEL: define i64 @load_store_through_inttoptr(
; CHECK-SAME: i64 [[ADDRESS:%.*]], i1 noundef [[UPDATE:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[P:%.*]] = inttoptr i64 [[ADDRESS]] to ptr
; CHECK-NEXT:    store i64 1, ptr [[P]], align 1
; CHECK-NEXT:    br i1 [[UPDATE]], label %[[WRITE:.*]], label %[[EXIT:.*]]
; CHECK:       [[WRITE]]:
; CHECK-NEXT:    [[OLD:%.*]] = load i64, ptr [[P]], align 1
; CHECK-NEXT:    [[NEXT:%.*]] = add i64 [[OLD]], 1
; CHECK-NEXT:    store i64 [[NEXT]], ptr [[P]], align 1
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RESULT:%.*]] = load i64, ptr [[P]], align 1
; CHECK-NEXT:    ret i64 [[RESULT]]
;
entry:
  %p = inttoptr i64 %address to ptr
  store i64 1, ptr %p, align 1
  br i1 %update, label %write, label %exit

write:
  %old = load i64, ptr %p, align 1
  %next = add i64 %old, 1
  store i64 %next, ptr %p, align 1
  br label %exit

exit:
  %result = load i64, ptr %p, align 1
  ret i64 %result
}

