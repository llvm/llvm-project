; RUN: opt -S -passes=attributor < %s | FileCheck %s

; A tail call cannot access allocas of the caller, so the tail marker must be
; dropped when the allocation it uses is moved to the stack. Otherwise the
; load after the call can be forwarded from the store before it.

declare noalias ptr @malloc(i64) allockind("alloc,uninitialized") allocsize(0) "alloc-family"="malloc"
declare void @free(ptr) allockind("free") "alloc-family"="malloc"
declare void @write_ptr(ptr nocapture) nounwind willreturn nosync

define i32 @tail_call_uses_h2s() {
; CHECK-LABEL: define i32 @tail_call_uses_h2s() {
; CHECK-NEXT:    [[P_H2S:%.*]] = alloca i8, i64 4, align 1
; CHECK-NEXT:    store i32 0, ptr [[P_H2S]], align 4
; CHECK-NEXT:    call void @write_ptr(ptr noundef captures(none) [[P_H2S]]) #[[ATTR3:[0-9]+]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P_H2S]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %p = tail call noalias ptr @malloc(i64 4)
  store i32 0, ptr %p
  tail call void @write_ptr(ptr %p)
  %v = load i32, ptr %p
  tail call void @free(ptr %p)
  ret i32 %v
}
