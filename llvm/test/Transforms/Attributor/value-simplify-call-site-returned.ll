; RUN: opt -passes=attributor -S < %s | FileCheck %s

; @select_ptr returns one of its arguments, so the result of a call can only be
; one of the pointers passed at that call. The load in @caller_local only reads
; the allocas of @caller_local and folds to 1, even though @caller_unknown
; passes an unknown pointer to @select_ptr.

define internal ptr @select_ptr(i1 %cond, ptr %a, ptr %b) {
; CHECK-LABEL: define internal ptr @select_ptr(
; CHECK-SAME: i1 [[COND:%.*]], ptr noalias nofree noundef nonnull readnone align 4 dereferenceable(4) [[A:%.*]], ptr noalias nofree readnone [[B:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[COND]], ptr [[A]], ptr [[B]]
; CHECK-NEXT:    ret ptr [[SEL]]
;
  %sel = select i1 %cond, ptr %a, ptr %b
  ret ptr %sel
}

define i32 @caller_local(i1 %cond) {
; CHECK-LABEL: define noundef i32 @caller_local(
; CHECK-SAME: i1 [[COND:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    ret i32 1
;
  %a = alloca i32
  %b = alloca i32
  store i32 1, ptr %a
  store i32 1, ptr %b
  %ptr = call ptr @select_ptr(i1 %cond, ptr %a, ptr %b)
  %val = load i32, ptr %ptr
  ret i32 %val
}

define i32 @caller_unknown(i1 %cond, ptr %p) {
; CHECK-LABEL: define i32 @caller_unknown(
; CHECK-SAME: i1 [[COND:%.*]], ptr nofree readonly captures(none) [[P:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
; CHECK-NEXT:    store i32 1, ptr [[A]], align 4
; CHECK-NEXT:    [[PTR:%.*]] = call ptr @select_ptr(i1 [[COND]], ptr noalias nofree noundef nonnull readnone align 4 dereferenceable(4) [[A]], ptr noalias nofree readnone [[P]]) #[[ATTR2:[0-9]+]]
; CHECK-NEXT:    [[VAL:%.*]] = load i32, ptr [[PTR]], align 4
; CHECK-NEXT:    ret i32 [[VAL]]
;
  %a = alloca i32
  store i32 1, ptr %a
  %ptr = call ptr @select_ptr(i1 %cond, ptr %a, ptr %p)
  %val = load i32, ptr %ptr
  ret i32 %val
}
