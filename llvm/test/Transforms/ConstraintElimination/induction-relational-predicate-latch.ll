; Negative test: the loop exits with iv.next == n + 1, so the exit-block fact
; iv.next u<= n must not be derived.
define void @neg_no_exit_block_fact(i64 %n, i64 %z, i1 %header.ec) {
; CHECK-LABEL: define void @neg_no_exit_block_fact(
; CHECK-SAME: i64 [[N:%.*]], i64 [[Z:%.*]], i1 [[HEADER_EC:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[PRE_0:%.*]] = icmp ult i64 [[N]], 100
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE_0]])
; CHECK-NEXT:    [[PRE_1:%.*]] = icmp ugt i64 [[N]], 5
; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE_1]])
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    br i1 [[HEADER_EC]], label %[[EXIT:.*]], label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ule i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_HEADER]], label %[[LOOP_EXIT:.*]]
; CHECK:       [[LOOP_EXIT]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[Z]], 3
; CHECK-NEXT:    call void @use(i1 [[C]])
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %pre.0 = icmp ult i64 %n, 100
  call void @llvm.assume(i1 %pre.0)
  %pre.1 = icmp ugt i64 %n, 5
  call void @llvm.assume(i1 %pre.1)
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
  br i1 %header.ec, label %exit, label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp ule i64 %iv.next, %n
  br i1 %ec, label %loop.header, label %loop.exit

loop.exit:
  %c = icmp ult i64 %z, 3
  call void @use(i1 %c)
  br label %exit

exit:
  ret void
}

