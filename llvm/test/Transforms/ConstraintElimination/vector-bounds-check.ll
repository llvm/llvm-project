; Canonical unrotated loop with std::vector::size() bound.
define void @test_vector_size_unrotated(ptr %begin, ptr %end) {
; CHECK-LABEL: define void @test_vector_size_unrotated(
; CHECK-SAME: ptr [[BEGIN:%.*]], ptr [[END:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[SUB_PTR_LHS:%.*]] = ptrtoint ptr [[END]] to i64
; CHECK-NEXT:    [[SUB_PTR_RHS:%.*]] = ptrtoint ptr [[BEGIN]] to i64
; CHECK-NEXT:    [[SUB_PTR_SUB:%.*]] = sub i64 [[SUB_PTR_LHS]], [[SUB_PTR_RHS]]
; CHECK-NEXT:    [[SIZE:%.*]] = ashr exact i64 [[SUB_PTR_SUB]], 2
; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
; CHECK:       [[LOOP_HEADER]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_INC:.*]] ]
; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i64 [[IV]], [[SIZE]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    call void @use(i1 false)
; CHECK-NEXT:    br label %[[LOOP_INC]]
; CHECK:       [[LOOP_INC]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP_HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %sub.ptr.lhs = ptrtoint ptr %end to i64
  %sub.ptr.rhs = ptrtoint ptr %begin to i64
  %sub.ptr.sub = sub i64 %sub.ptr.lhs, %sub.ptr.rhs
  %size = ashr exact i64 %sub.ptr.sub, 2
  br label %loop.header

loop.header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.inc ]
  %cmp = icmp ne i64 %iv, %size
  br i1 %cmp, label %loop.body, label %exit

loop.body:
  %check.ult = icmp ult i64 %iv, %size
  call void @use(i1 %check.ult)
  %check.uge = icmp uge i64 %iv, %size
  call void @use(i1 %check.uge)
  br label %loop.inc

loop.inc:
  %iv.next = add nuw nsw i64 %iv, 1
  br label %loop.header

exit:
  ret void
}

