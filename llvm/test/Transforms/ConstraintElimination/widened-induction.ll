  %check = icmp ult i64 %inner.zext, %outer
  call void @use(i1 %check)
  br label %inner.latch

inner.latch:
  %inner.next = add nuw nsw i32 %inner, 1
  br label %inner.header

outer.latch:
  %outer.next = add nuw nsw i64 %outer, 1
  br label %outer.header

exit:
  ret void
}
