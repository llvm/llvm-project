; CHECK-SAME: i64 [[VEC_SIZE:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
; CHECK-NEXT:    [[I_ZEXT:%.*]] = zext i32 [[I]] to i64
; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i64 [[I_ZEXT]], [[VEC_SIZE]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_BODY]]:
; CHECK-NEXT:    call void @use(i1 true)
; CHECK-NEXT:    br label %[[LOOP_LATCH]]
; CHECK:       [[LOOP_LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %iv.next, %loop.latch ]
  %i.zext = zext i32 %i to i64
  %cmp = icmp ne i64 %i.zext, %vec_size
  br i1 %cmp, label %loop.body, label %exit

loop.body:
  %check = icmp ult i64 %i.zext, %vec_size
  call void @use(i1 %check)
  br label %loop.latch

loop.latch:
  %iv.next = add nuw nsw i32 %i, 1
  br label %loop

exit:
  ret void
}

