; walks that use list and would previously query dominance for the unparented
; user, deriving a null block and tripping the dominator-tree assertion. Make
; sure such users are skipped instead of crashing.

define void @overflow_result_used_by_unparented_bound_expr() {
; CHECK-LABEL: define void @overflow_result_used_by_unparented_bound_expr() {
; CHECK-NEXT:    [[TMP1:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 0, i64 0)
; CHECK-NEXT:    [[TMP2:%.*]] = extractvalue { i64, i1 } [[TMP1]], 0
; CHECK-NEXT:    [[TMP3:%.*]] = extractvalue { i64, i1 } [[TMP1]], 1
; CHECK-NEXT:    br i1 [[TMP3]], label %[[BB8:.*]], label %[[BB4:.*]]
; CHECK:       [[BB4]]:
; CHECK-NEXT:    [[TMP5:%.*]] = icmp sgt i64 [[TMP2]], 0
; CHECK-NEXT:    call void @llvm.assume(i1 [[TMP5]])
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr inbounds [8 x i8], ptr null, i64 [[TMP2]]
; CHECK-NEXT:    [[TMP7:%.*]] = load i64, ptr [[TMP6]], align 8
; CHECK-NEXT:    br label %[[BB9:.*]]
; CHECK:       [[BB8]]:
; CHECK-NEXT:    unreachable
; CHECK:       [[BB9]]:
; CHECK-NEXT:    [[TMP10:%.*]] = phi i64 [ 0, %[[BB4]] ], [ [[TMP11:%.*]], %[[BB9]] ]
; CHECK-NEXT:    [[TMP11]] = add i64 [[TMP10]], 1
; CHECK-NEXT:    br i1 false, label %[[BB12:.*]], label %[[BB9]]
; CHECK:       [[BB12]]:
; CHECK-NEXT:    ret void
;
  %1 = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 0, i64 0)
  %2 = extractvalue { i64, i1 } %1, 0
  %3 = extractvalue { i64, i1 } %1, 1
