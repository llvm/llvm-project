  call void @llvm.assume(i1 %n.nz)
  %ge = icmp uge i64 %z, %y
  call void @llvm.assume(i1 %ge)
  %d = sub i64 %z, %y
  %q = udiv i64 %d, %n
  %a = add i64 %q, %y
  %c = icmp ule i64 %a, %z
  ret i1 %c
}

