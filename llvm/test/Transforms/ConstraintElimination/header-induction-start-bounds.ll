; CHECK-NEXT:    [[PV:%.*]] = phi ptr [ [[P]], %[[ENTRY]] ], [ [[PV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[MUST_NOT_FOLD:%.*]] = icmp uge ptr [[PV]], [[P]]
; CHECK-NEXT:    call void @use(i1 [[MUST_NOT_FOLD]])
; CHECK-NEXT:    [[PV_NEXT]] = getelementptr nusw i8, ptr [[PV]], i64 -1
; CHECK-NEXT:    [[EC:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %pv = phi ptr [ %p, %entry ], [ %pv.next, %loop ]
  %must.not.fold = icmp uge ptr %pv, %p
  call void @use(i1 %must.not.fold)
  %pv.next = getelementptr nusw i8, ptr %pv, i64 -1
  %ec = call i1 @cond()
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

