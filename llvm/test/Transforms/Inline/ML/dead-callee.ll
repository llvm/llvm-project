; RUN: opt -passes=inliner-ml-advisor-release -mlgo-model=_test_inc -S < %s | FileCheck %s
; RUN: %if have_mlir_lowering %{ opt -passes=inliner-ml-advisor-release -mlgo-model=_test_mlir -S < %s | FileCheck %s %}
; RUN: %if llvm_inliner_model_autogenerated %{ opt -passes=inliner-ml-advisor-release -S < %s | FileCheck %s %}

; Check that our accounting works when a function in a non-trivial SCC is dead.

; CHECK: define void @f
; CHECK-NOT: @g

define void @f() {
    call void @g()
    ret void
}

define internal void @g() {
    call void @f()
    ret void
}
