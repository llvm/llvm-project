; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; Tests for the simplifications done on the inlined region before the next call
; site of the same caller is analyzed (simplifyInlinedRegion). The simplifier
; only runs when another call site follows, which is why we need a call after
; the inlined one in each caller.

; RUN: opt < %s -passes=inline -inline-threshold=50 -S | FileCheck %s

declare void @opaque(i64)

define void @trailing() {
; CHECK-LABEL: define void @trailing() {
; CHECK-NEXT:    ret void
;
  ret void
}

define void @init_const(ptr %p) {
; CHECK-LABEL: define void @init_const(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 5, ptr [[TMP]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP]], align 4
; CHECK-NEXT:    [[X:%.*]] = add i64 [[V]], 1
; CHECK-NEXT:    store i64 [[X]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %tmp = alloca i64
  store i64 5, ptr %tmp
  %v = load i64, ptr %tmp
  %x = add i64 %v, 1
  store i64 %x, ptr %p
  ret void
}

; The load is forwarded from the store in the same block and the add folds, so
; the caller ends up storing the constant 6.
define void @forward_and_fold(ptr %this) {
; CHECK-LABEL: define void @forward_and_fold(
; CHECK-SAME: ptr [[THIS:%.*]]) {
; CHECK-NEXT:    [[TMP_I:%.*]] = alloca i64, align 8
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr [[TMP_I]])
; CHECK-NEXT:    store i64 5, ptr [[TMP_I]], align 4
; CHECK-NEXT:    [[X_I:%.*]] = add i64 5, 1
; CHECK-NEXT:    store i64 6, ptr [[THIS]], align 4
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    ret void
;
  call void @init_const(ptr %this)
  call void @trailing()
  ret void
}

define void @init_branch(ptr %p) {
; CHECK-LABEL: define void @init_branch(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 0, ptr [[TMP]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP]], align 4
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[V]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    ret void
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    store i64 2, ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %tmp = alloca i64
  store i64 0, ptr %tmp
  %v = load i64, ptr %tmp
  %c = icmp eq i64 %v, 0
  br i1 %c, label %then, label %else

then:
  store i64 1, ptr %p
  ret void

else:
  store i64 2, ptr %p
  ret void
}

; The branch condition folds to true, so the else arm becomes unreachable.
define void @fold_branch_cut_dead_arm(ptr %this) {
; CHECK-LABEL: define void @fold_branch_cut_dead_arm(
; CHECK-SAME: ptr [[THIS:%.*]]) {
; CHECK-NEXT:    [[TMP_I:%.*]] = alloca i64, align 8
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr [[TMP_I]])
; CHECK-NEXT:    store i64 0, ptr [[TMP_I]], align 4
; CHECK-NEXT:    [[C_I:%.*]] = icmp eq i64 0, 0
; CHECK-NEXT:    br label %[[THEN_I:.*]]
; CHECK:       [[THEN_I]]:
; CHECK-NEXT:    store i64 1, ptr [[THIS]], align 4
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    br label %[[INIT_BRANCH_EXIT:.*]]
; CHECK:       [[ELSE_I:.*:]]
; CHECK-NEXT:    store i64 2, ptr [[THIS]], align 4
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    unreachable
; CHECK:       [[INIT_BRANCH_EXIT]]:
; CHECK-NEXT:    ret void
;
  call void @init_branch(ptr %this)
  call void @trailing()
  ret void
}

define i64 @callee(ptr %p, i64 %n) {
; CHECK-LABEL: define i64 @callee(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SIZE:%.*]] = load i64, ptr [[P]], align 4
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[SIZE]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[EMPTY:.*]], label %[[SLOW:.*]]
; CHECK:       [[EMPTY]]:
; CHECK-NEXT:    ret i64 0
; CHECK:       [[SLOW]]:
; CHECK-NEXT:    [[A1:%.*]] = add i64 [[N]], 1
; CHECK-NEXT:    [[A2:%.*]] = mul i64 [[A1]], [[N]]
; CHECK-NEXT:    [[A3:%.*]] = xor i64 [[A2]], [[A1]]
; CHECK-NEXT:    call void @opaque(i64 [[A3]])
; CHECK-NEXT:    [[A4:%.*]] = add i64 [[A3]], 7
; CHECK-NEXT:    call void @opaque(i64 [[A4]])
; CHECK-NEXT:    [[A5:%.*]] = mul i64 [[A4]], [[A3]]
; CHECK-NEXT:    call void @opaque(i64 [[A5]])
; CHECK-NEXT:    [[A6:%.*]] = xor i64 [[A5]], [[A4]]
; CHECK-NEXT:    ret i64 [[A6]]
;
entry:
  %size = load i64, ptr %p
  %c = icmp eq i64 %size, 0
  br i1 %c, label %empty, label %slow

empty:
  ret i64 0

slow:
  %a1 = add i64 %n, 1
  %a2 = mul i64 %a1, %n
  %a3 = xor i64 %a2, %a1
  call void @opaque(i64 %a3)
  %a4 = add i64 %a3, 7
  call void @opaque(i64 %a4)
  %a5 = mul i64 %a4, %a3
  call void @opaque(i64 %a5)
  %a6 = xor i64 %a5, %a4
  ret i64 %a6
}

define void @init_via_tmp(ptr %p) {
; CHECK-LABEL: define void @init_via_tmp(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 0, ptr [[TMP]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP]], align 4
; CHECK-NEXT:    store i64 [[V]], ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %tmp = alloca i64
  store i64 0, ptr %tmp
  %v = load i64, ptr %tmp
  store i64 %v, ptr %p
  ret void
}

; After @init_via_tmp is inlined, the stored value is the result of a load. The
; simplifier forwards it to the constant 0, so the cost model sees a constant
; reaching store and @callee is inlined.
define i64 @init_then_callee_inlined(ptr %this, i64 %n) {
; CHECK-LABEL: define i64 @init_then_callee_inlined(
; CHECK-SAME: ptr [[THIS:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:    [[TMP_I:%.*]] = alloca i64, align 8
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr [[TMP_I]])
; CHECK-NEXT:    store i64 0, ptr [[TMP_I]], align 4
; CHECK-NEXT:    store i64 0, ptr [[THIS]], align 4
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    [[SIZE_I:%.*]] = load i64, ptr [[THIS]], align 4
; CHECK-NEXT:    [[C_I:%.*]] = icmp eq i64 [[SIZE_I]], 0
; CHECK-NEXT:    br i1 [[C_I]], label %[[EMPTY_I:.*]], label %[[SLOW_I:.*]]
; CHECK:       [[EMPTY_I]]:
; CHECK-NEXT:    br label %[[CALLEE_EXIT:.*]]
; CHECK:       [[SLOW_I]]:
; CHECK-NEXT:    [[A1_I:%.*]] = add i64 [[N]], 1
; CHECK-NEXT:    [[A2_I:%.*]] = mul i64 [[A1_I]], [[N]]
; CHECK-NEXT:    [[A3_I:%.*]] = xor i64 [[A2_I]], [[A1_I]]
; CHECK-NEXT:    call void @opaque(i64 [[A3_I]])
; CHECK-NEXT:    [[A4_I:%.*]] = add i64 [[A3_I]], 7
; CHECK-NEXT:    call void @opaque(i64 [[A4_I]])
; CHECK-NEXT:    [[A5_I:%.*]] = mul i64 [[A4_I]], [[A3_I]]
; CHECK-NEXT:    call void @opaque(i64 [[A5_I]])
; CHECK-NEXT:    [[A6_I:%.*]] = xor i64 [[A5_I]], [[A4_I]]
; CHECK-NEXT:    br label %[[CALLEE_EXIT]]
; CHECK:       [[CALLEE_EXIT]]:
; CHECK-NEXT:    [[R1:%.*]] = phi i64 [ 0, %[[EMPTY_I]] ], [ [[A6_I]], %[[SLOW_I]] ]
; CHECK-NEXT:    ret i64 [[R1]]
;
  call void @init_via_tmp(ptr %this)
  %r = call i64 @callee(ptr %this, i64 %n)
  ret i64 %r
}

define void @dead_target(ptr %p) {
; CHECK-LABEL: define void @dead_target(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    call void @opaque(i64 1)
; CHECK-NEXT:    call void @opaque(i64 2)
; CHECK-NEXT:    call void @opaque(i64 3)
; CHECK-NEXT:    store i64 9, ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  call void @opaque(i64 1)
  call void @opaque(i64 2)
  call void @opaque(i64 3)
  store i64 9, ptr %p
  ret void
}

define void @init_dead_call(ptr %p) {
; CHECK-LABEL: define void @init_dead_call(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 0, ptr [[TMP]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP]], align 4
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[V]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i64 0, ptr [[P]], align 4
; CHECK-NEXT:    ret void
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    call void @dead_target(ptr [[P]])
; CHECK-NEXT:    ret void
;
  %tmp = alloca i64
  store i64 0, ptr %tmp
  %v = load i64, ptr %tmp
  %c = icmp eq i64 %v, 0
  br i1 %c, label %then, label %else

then:
  store i64 0, ptr %p
  ret void

else:
  call void @dead_target(ptr %p)
  ret void
}

; The else arm is cut after the branch folds, but the call to @dead_target in it
; is still in the inliner's worklist. This must not crash or break the IR.
define void @dead_call_site_in_cut_arm(ptr %this) {
; CHECK-LABEL: define void @dead_call_site_in_cut_arm(
; CHECK-SAME: ptr [[THIS:%.*]]) {
; CHECK-NEXT:    [[TMP_I:%.*]] = alloca i64, align 8
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr [[TMP_I]])
; CHECK-NEXT:    store i64 0, ptr [[TMP_I]], align 4
; CHECK-NEXT:    [[C_I:%.*]] = icmp eq i64 0, 0
; CHECK-NEXT:    br label %[[THEN_I:.*]]
; CHECK:       [[THEN_I]]:
; CHECK-NEXT:    store i64 0, ptr [[THIS]], align 4
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    br label %[[INIT_DEAD_CALL_EXIT:.*]]
; CHECK:       [[ELSE_I:.*:]]
; CHECK-NEXT:    call void @dead_target(ptr [[THIS]])
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    unreachable
; CHECK:       [[INIT_DEAD_CALL_EXIT]]:
; CHECK-NEXT:    ret void
;
  call void @init_dead_call(ptr %this)
  call void @trailing()
  ret void
}

define void @simplifies_inlined_region_only(ptr %this, ptr %out) {
; CHECK-LABEL: define void @simplifies_inlined_region_only(
; CHECK-SAME: ptr [[THIS:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP_I:%.*]] = alloca i64, align 8
; CHECK-NEXT:    [[TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    [[EXIT_TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 5, ptr [[TMP]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP]], align 4
; CHECK-NEXT:    store i64 [[V]], ptr [[OUT]], align 4
; CHECK-NEXT:    br label %[[MID:.*]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    call void @llvm.lifetime.start.p0(ptr [[TMP_I]])
; CHECK-NEXT:    store i64 5, ptr [[TMP_I]], align 4
; CHECK-NEXT:    [[X_I:%.*]] = add i64 5, 1
; CHECK-NEXT:    store i64 6, ptr [[THIS]], align 4
; CHECK-NEXT:    call void @llvm.lifetime.end.p0(ptr [[TMP_I]])
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    store i64 5, ptr [[EXIT_TMP]], align 4
; CHECK-NEXT:    [[EXIT_V:%.*]] = load i64, ptr [[EXIT_TMP]], align 4
; CHECK-NEXT:    store i64 [[EXIT_V]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %tmp = alloca i64
  %exit_tmp = alloca i64
  store i64 5, ptr %tmp
  %v = load i64, ptr %tmp
  store i64 %v, ptr %out
  br label %mid

mid:
  call void @init_const(ptr %this)
  call void @trailing()
  br label %exit

exit:
  store i64 5, ptr %exit_tmp
  %exit_v = load i64, ptr %exit_tmp
  store i64 %exit_v, ptr %out
  ret void
}
