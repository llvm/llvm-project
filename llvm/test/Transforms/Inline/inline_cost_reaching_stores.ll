; The branch folds once the load from %tmp is forwarded. That cuts
; the else arm, so the second call site, which is in a join block, now has a
; single predecessor and the walk reaches the store.
define void @init_diamond(ptr %p) {
; CHECK-LABEL: define void @init_diamond(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP:%.*]] = alloca i64, align 8
; CHECK-NEXT:    store i64 0, ptr [[TMP]], align 4
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[TMP]], align 4
; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[V]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i64 0, ptr [[P]], align 4
; CHECK-NEXT:    ret void
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    store i64 1, ptr [[P]], align 4
; CHECK-NEXT:    ret void
;
  %tmp = alloca i64
  store i64 0, ptr %tmp
  %v = load i64, ptr %tmp
  %c = icmp eq i64 %v, 0
  br i1 %c, label %then, label %else

then:
  store i64 0, ptr %p
  ret void

else:
  store i64 1, ptr %p
  ret void
}

