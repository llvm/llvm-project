; CHECK-NEXT:    invoke void [[FPTR]]() #[[ATTR13:[0-9]+]]
; CHECK-NEXT:            to label [[NORMAL_RETURN:%.*]] unwind label [[UNWIND_CLEANUP:%.*]]
; CHECK:       normal_return:
; CHECK-NEXT:    ret void
; CHECK:       unwind_cleanup:
; CHECK-NEXT:    [[EH_INFO:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    resume { ptr, i32 } [[EH_INFO]]
