; Each callee loads %i1, stores to %i2 and loads %i1 again. The sibling tags
; of %i1 and %i2 say that they do not alias, so the second load is replaced
; with the first one within each inlined copy. The callers pass %s as %i1 of
; the first call and as %i2 of the second one, and %q of the first call may be
; %p of the second one.

; A uniqued root is shared by the inlined copies, so the store to %q in the
; first copy does not alias the load of %p in the second copy, and the load is
; replaced with %v0.
define internal i32 @callee_uniqued(ptr %i1, ptr %i2) {
  %v1 = load i32, ptr %i1, !tbaa !3
  store i32 0, ptr %i2, !tbaa !5
  %v2 = load i32, ptr %i1, !tbaa !3
  %r = add i32 %v1, %v2
  ret i32 %r
}

