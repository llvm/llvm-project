; RUN: opt -mtriple=amdgpu11.00 -S -passes='structurizecfg<skip-uniform-regions>' %s | FileCheck %s

; The region tree puts the latches of %header other than %A in a sub-region
; header => A, which is structurized as a loop of its own, nested inside the
; loop closed by %A. The outer loop must get its own header so that
; UniformityInfo sees the nesting: lanes leave the inner loop on different
; iterations, so %u and the branch in %A are divergent. @self_loop is the same
; as @latch_block after CodeGenPrepare has removed the empty latch block.

define amdgpu_kernel void @latch_block(ptr addrspace(1) %p, ptr addrspace(1) %out) {
; CHECK-LABEL: define amdgpu_kernel void @latch_block(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], ptr addrspace(1) [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TID:%.*]] = call i32 @llvm.amdgcn.workitem.id.x()
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    br label %[[HEADER1:.*]]
; CHECK:       [[HEADER1]]:
; CHECK-NEXT:    [[U:%.*]] = load volatile i32, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    [[D:%.*]] = icmp ult i32 [[U]], [[TID]]
; CHECK-NEXT:    br i1 [[D]], label %[[B:.*]], label %[[FLOW:.*]]
; CHECK:       [[B]]:
; CHECK-NEXT:    store volatile i32 0, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    br label %[[FLOW]]
; CHECK:       [[FLOW]]:
; CHECK-NEXT:    [[TMP0:%.*]] = phi i1 [ false, %[[B]] ], [ true, %[[HEADER1]] ]
; CHECK-NEXT:    br i1 [[TMP0]], label %[[A:.*]], label %[[HEADER1]]
; CHECK:       [[A]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[U]], 100
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i32, ptr addrspace(1) [[OUT]], i32 [[TID]]
; CHECK-NEXT:    store i32 [[U]], ptr addrspace(1) [[GEP]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  br label %header

header:
  %u = load volatile i32, ptr addrspace(1) %p
  %d = icmp ult i32 %u, %tid
  br i1 %d, label %B, label %A

B:
  store volatile i32 0, ptr addrspace(1) %p
  br label %header

A:
  %c = icmp ugt i32 %u, 100
  br i1 %c, label %exit, label %header

exit:
  %gep = getelementptr i32, ptr addrspace(1) %out, i32 %tid
  store i32 %u, ptr addrspace(1) %gep
  ret void
}

define amdgpu_kernel void @self_loop(ptr addrspace(1) %p, ptr addrspace(1) %out) {
; CHECK-LABEL: define amdgpu_kernel void @self_loop(
; CHECK-SAME: ptr addrspace(1) [[P:%.*]], ptr addrspace(1) [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TID:%.*]] = call i32 @llvm.amdgcn.workitem.id.x()
; CHECK-NEXT:    br label %[[HEADER:.*]]
; CHECK:       [[HEADER]]:
; CHECK-NEXT:    br label %[[HEADER1:.*]]
; CHECK:       [[HEADER1]]:
; CHECK-NEXT:    [[U:%.*]] = load volatile i32, ptr addrspace(1) [[P]], align 4
; CHECK-NEXT:    [[D:%.*]] = icmp uge i32 [[U]], [[TID]]
; CHECK-NEXT:    br i1 [[D]], label %[[A:.*]], label %[[HEADER1]]
; CHECK:       [[A]]:
; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[U]], 100
; CHECK-NEXT:    br i1 [[C]], label %[[EXIT:.*]], label %[[HEADER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i32, ptr addrspace(1) [[OUT]], i32 [[TID]]
; CHECK-NEXT:    store i32 [[U]], ptr addrspace(1) [[GEP]], align 4
; CHECK-NEXT:    ret void
;
entry:
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  br label %header

header:
