; A uniform loop around a sub-region containing a divergent if. The loop body
; has a second uniform branch that jumps to the exit of the sub-region.
define amdgpu_cs void @uniform_loop_around_nonuniform_subregion(i32 inreg %n, i32 inreg %u, i32 %v, ptr addrspace(1) %out) {
; CHECK-LABEL: @uniform_loop_around_nonuniform_subregion(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[I_INC:%.*]], [[LATCH:%.*]] ]
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[I]], [[U:%.*]]
; CHECK-NEXT:    br i1 [[C]], label [[DIV:%.*]], label [[OTHER:%.*]], !structurizecfg.uniform [[META0]]
; CHECK:       div:
; CHECK-NEXT:    [[D:%.*]] = icmp eq i32 [[V:%.*]], [[I]]
; CHECK-NEXT:    br i1 [[D]], label [[DIV_THEN:%.*]], label [[FLOW:%.*]]
; CHECK:       div.then:
; CHECK-NEXT:    store i32 [[I]], ptr addrspace(1) [[OUT:%.*]], align 4
; CHECK-NEXT:    br label [[FLOW]]
; CHECK:       Flow:
; CHECK-NEXT:    br label [[DIV_END:%.*]]
; CHECK:       div.end:
; CHECK-NEXT:    store i32 3, ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    br label [[LATCH]], !structurizecfg.uniform [[META0]]
; CHECK:       other:
; CHECK-NEXT:    [[E:%.*]] = icmp eq i32 [[I]], 7
; CHECK-NEXT:    br i1 [[E]], label [[DIV_END]], label [[LATCH]], !structurizecfg.uniform [[META0]]
; CHECK:       latch:
; CHECK-NEXT:    [[I_INC]] = add i32 [[I]], 1
; CHECK-NEXT:    [[CONT:%.*]] = icmp ult i32 [[I_INC]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[CONT]], label [[LOOP]], label [[EXIT:%.*]], !structurizecfg.uniform [[META0]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.inc, %latch ]
  %c = icmp eq i32 %i, %u
  br i1 %c, label %div, label %other

div:
  %d = icmp eq i32 %v, %i
  br i1 %d, label %div.then, label %div.end

div.then:
  store i32 %i, ptr addrspace(1) %out
  br label %div.end

div.end:
