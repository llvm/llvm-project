; CFG-NEXT:    br i1 [[R3_INV]], label %[[CHECK4:.*]], label %[[FLOW2:.*]]
; CFG:       [[FLOW1]]:
; CFG-NEXT:    [[TMP2]] = phi i64 [ [[TMP4:%.*]], %[[FLOW2]] ], [ poison, %[[CHECK2]] ]
; CFG-NEXT:    [[TMP3]] = phi i1 [ [[TMP5:%.*]], %[[FLOW2]] ], [ [[R2]], %[[CHECK2]] ]
; CFG-NEXT:    br label %[[FLOW]]
; CFG:       [[CHECK4]]:
; CFG-NEXT:    br i1 [[R4_INV]], label %[[THEN:.*]], label %[[FLOW3:.*]]
; CFG:       [[FLOW2]]:
; CFG-NEXT:    [[TMP4]] = phi i64 [ [[TMP6:%.*]], %[[FLOW3]] ], [ poison, %[[CHECK3]] ]
; CFG-NEXT:    [[TMP5]] = phi i1 [ [[TMP7:%.*]], %[[FLOW3]] ], [ [[R3]], %[[CHECK3]] ]
; CFG-NEXT:    br label %[[FLOW1]]
; CFG:       [[THEN]]:
; CFG-NEXT:    [[MODIFIED:%.*]] = zext i32 [[C]] to i64
; CFG-NEXT:    br label %[[FLOW3]]
; CFG:       [[FLOW3]]:
; CFG-NEXT:    [[TMP6]] = phi i64 [ [[MODIFIED]], %[[THEN]] ], [ poison, %[[CHECK4]] ]
; CFG-NEXT:    [[TMP7]] = phi i1 [ false, %[[THEN]] ], [ true, %[[CHECK4]] ]
; CFG-NEXT:    br label %[[FLOW2]]
; CFG:       [[ELSE]]:
; CFG-NEXT:    [[UNCHANGED_A:%.*]] = zext i32 [[A]] to i64
; CFG-NEXT:    [[UNCHANGED_B:%.*]] = zext i32 [[B]] to i64
; CFG-NEXT:    br label %[[MERGE]]
; CFG:       [[MERGE]]:
; CFG-NEXT:    [[TMP0:%.*]] = phi i64 [ [[TMP8]], %[[FLOW]] ], [ [[UNCHANGED_A]], %[[ELSE]] ]
; CFG-NEXT:    [[SECOND:%.*]] = phi i64 [ [[TMP8]], %[[FLOW]] ], [ [[UNCHANGED_B]], %[[ELSE]] ]
; CFG-NEXT:    [[V0:%.*]] = insertvalue { i64, i64 } poison, i64 [[TMP0]], 0
; CFG-NEXT:    [[V1:%.*]] = insertvalue { i64, i64 } [[V0]], i64 [[SECOND]], 1
; CFG-NEXT:    ret { i64, i64 } [[V1]]
;
; OPT-LABEL: define { i64, i64 } @shared_computed_value(
; OPT-SAME: i1 [[R1:%.*]], i1 [[R2:%.*]], i1 [[R3:%.*]], i1 [[R4:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i32 [[C:%.*]]) {
; OPT-NEXT:  [[ENTRY:.*]]:
; OPT-NEXT:    [[R4_INV:%.*]] = xor i1 [[R4]], true
; OPT-NEXT:    [[R3_INV:%.*]] = xor i1 [[R3]], true
; OPT-NEXT:    [[R2_INV:%.*]] = xor i1 [[R2]], true
; OPT-NEXT:    [[R1_INV:%.*]] = xor i1 [[R1]], true
; OPT-NEXT:    [[UNCHANGED_A:%.*]] = zext i32 [[A]] to i64
; OPT-NEXT:    br i1 [[R1_INV]], label %[[CHECK2:.*]], label %[[FLOW:.*]]
; OPT:       [[CHECK2]]:
; OPT-NEXT:    br i1 [[R2_INV]], label %[[CHECK3:.*]], label %[[FLOW1:.*]]
; OPT:       [[FLOW]]:
; OPT-NEXT:    [[TMP0:%.*]] = phi i64 [ [[TMP2:%.*]], %[[FLOW1]] ], [ [[UNCHANGED_A]], %[[ENTRY]] ]
; OPT-NEXT:    [[TMP1:%.*]] = phi i1 [ [[TMP3:%.*]], %[[FLOW1]] ], [ [[R1]], %[[ENTRY]] ]
; OPT-NEXT:    br i1 [[TMP1]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; OPT:       [[CHECK3]]:
; OPT-NEXT:    br i1 [[R3_INV]], label %[[CHECK4:.*]], label %[[FLOW2:.*]]
; OPT:       [[FLOW1]]:
; OPT-NEXT:    [[TMP2]] = phi i64 [ [[TMP4:%.*]], %[[FLOW2]] ], [ [[UNCHANGED_A]], %[[CHECK2]] ]
; OPT-NEXT:    [[TMP3]] = phi i1 [ [[TMP5:%.*]], %[[FLOW2]] ], [ [[R2]], %[[CHECK2]] ]
; OPT-NEXT:    br label %[[FLOW]]
; OPT:       [[CHECK4]]:
; OPT-NEXT:    br i1 [[R4_INV]], label %[[THEN:.*]], label %[[FLOW3:.*]]
; OPT:       [[FLOW2]]:
; OPT-NEXT:    [[TMP4]] = phi i64 [ [[TMP6:%.*]], %[[FLOW3]] ], [ [[UNCHANGED_A]], %[[CHECK3]] ]
; OPT-NEXT:    [[TMP5]] = phi i1 [ [[TMP7:%.*]], %[[FLOW3]] ], [ [[R3]], %[[CHECK3]] ]
; OPT-NEXT:    br label %[[FLOW1]]
; OPT:       [[THEN]]:
; OPT-NEXT:    [[MODIFIED:%.*]] = zext i32 [[C]] to i64
; OPT-NEXT:    br label %[[FLOW3]]
; OPT:       [[FLOW3]]:
; OPT-NEXT:    [[TMP6]] = phi i64 [ [[MODIFIED]], %[[THEN]] ], [ [[UNCHANGED_A]], %[[CHECK4]] ]
; OPT-NEXT:    [[TMP7]] = phi i1 [ false, %[[THEN]] ], [ true, %[[CHECK4]] ]
; OPT-NEXT:    br label %[[FLOW2]]
; OPT:       [[ELSE]]:
; OPT-NEXT:    [[UNCHANGED_B:%.*]] = zext i32 [[B]] to i64
; OPT-NEXT:    br label %[[MERGE]]
; OPT:       [[MERGE]]:
