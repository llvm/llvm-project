entry:
  br i1 %r1, label %else, label %check2

check2:
  br i1 %r2, label %else, label %check3

check3:
  br i1 %r3, label %else, label %check4

check4:
  br i1 %r4, label %else, label %then

then:
  %modified = zext i32 %c to i64
  br label %merge

else:
  %unchanged.a = zext i32 %a to i64
  %unchanged.b = zext i32 %b to i64
  br label %merge

merge:
  %first = phi i64 [ %modified, %then ], [ %unchanged.a, %else ]
  %second = phi i64 [ %modified, %then ], [ %unchanged.b, %else ]
  %v0 = insertvalue { i64, i64 } poison, i64 %first, 0
  %v1 = insertvalue { i64, i64 } %v0, i64 %second, 1
  ret { i64, i64 } %v1
}

; A Then PHI can give a generated Flow PHI a real value on a path to Else.
; For c0=false, c1=false, c2=true, the result must be zext(a), not w.
; Filling only poison inputs cannot make that shared Flow value equal to e.
; The follow-up pass must reject this candidate without hoisting or filling
; its shallow poison input. Keep the original Merge Else arm carrying e.
define i64 @then_phi_reaches_else(i1 %c0, i1 %c1, i1 %c2, i64 %x, i64 %w, i32 %a) {
; CFG-LABEL: define i64 @then_phi_reaches_else(
; CFG-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i64 [[X:%.*]], i64 [[W:%.*]], i32 [[A:%.*]]) {
; CFG-NEXT:  [[ENTRY:.*]]:
; CFG-NEXT:    [[C2_INV:%.*]] = xor i1 [[C2]], true
; CFG-NEXT:    [[C1_INV:%.*]] = xor i1 [[C1]], true
; CFG-NEXT:    [[C0_INV:%.*]] = xor i1 [[C0]], true
; CFG-NEXT:    br i1 [[C0_INV]], label %[[BB1:.*]], label %[[FLOW:.*]]
; CFG:       [[BB1]]:
; CFG-NEXT:    br i1 [[C1_INV]], label %[[BB2:.*]], label %[[FLOW1:.*]]
; CFG:       [[FLOW]]:
; CFG-NEXT:    [[TMP0:%.*]] = phi i64 [ [[TMP2:%.*]], %[[FLOW2:.*]] ], [ poison, %[[ENTRY]] ]
; CFG-NEXT:    [[TMP1:%.*]] = phi i1 [ [[TMP5:%.*]], %[[FLOW2]] ], [ true, %[[ENTRY]] ]
; CFG-NEXT:    br i1 [[TMP1]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; CFG:       [[BB2]]:
; CFG-NEXT:    br label %[[FLOW1]]
; CFG:       [[FLOW1]]:
; CFG-NEXT:    [[TMP2]] = phi i64 [ [[W]], %[[BB2]] ], [ [[X]], %[[BB1]] ]
; CFG-NEXT:    [[TMP3:%.*]] = phi i1 [ true, %[[BB2]] ], [ false, %[[BB1]] ]
; CFG-NEXT:    [[TMP4:%.*]] = phi i1 [ [[C2_INV]], %[[BB2]] ], [ [[C1]], %[[BB1]] ]
; CFG-NEXT:    br i1 [[TMP4]], label %[[THEN:.*]], label %[[FLOW2]]
; CFG:       [[THEN]]:
; CFG-NEXT:    br label %[[FLOW2]]
; CFG:       [[FLOW2]]:
; CFG-NEXT:    [[TMP5]] = phi i1 [ false, %[[THEN]] ], [ [[TMP3]], %[[FLOW1]] ]
; CFG-NEXT:    br label %[[FLOW]]
; CFG:       [[ELSE]]:
; CFG-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; CFG-NEXT:    br label %[[MERGE]]
; CFG:       [[MERGE]]:
; CFG-NEXT:    [[R:%.*]] = phi i64 [ [[TMP0]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; CFG-NEXT:    ret i64 [[R]]
;
; OPT-LABEL: define i64 @then_phi_reaches_else(
; OPT-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i64 [[X:%.*]], i64 [[W:%.*]], i32 [[A:%.*]]) {
; OPT-NEXT:  [[ENTRY:.*]]:
; OPT-NEXT:    [[C2_INV:%.*]] = xor i1 [[C2]], true
; OPT-NEXT:    [[C1_INV:%.*]] = xor i1 [[C1]], true
; OPT-NEXT:    [[C0_INV:%.*]] = xor i1 [[C0]], true
; OPT-NEXT:    br i1 [[C0_INV]], label %[[CHECK_THEN:.*]], label %[[FLOW:.*]]
; OPT:       [[CHECK_THEN]]:
; OPT-NEXT:    br i1 [[C1_INV]], label %[[CHECK_ELSE:.*]], label %[[FLOW1:.*]]
; OPT:       [[FLOW]]:
; OPT-NEXT:    [[TMP0:%.*]] = phi i64 [ [[TMP2:%.*]], %[[FLOW2:.*]] ], [ poison, %[[ENTRY]] ]
; OPT-NEXT:    [[TMP1:%.*]] = phi i1 [ [[TMP5:%.*]], %[[FLOW2]] ], [ true, %[[ENTRY]] ]
; OPT-NEXT:    br i1 [[TMP1]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; OPT:       [[CHECK_ELSE]]:
; OPT-NEXT:    br label %[[FLOW1]]
; OPT:       [[FLOW1]]:
; OPT-NEXT:    [[TMP2]] = phi i64 [ [[W]], %[[CHECK_ELSE]] ], [ [[X]], %[[CHECK_THEN]] ]
; OPT-NEXT:    [[TMP3:%.*]] = phi i1 [ true, %[[CHECK_ELSE]] ], [ false, %[[CHECK_THEN]] ]
; OPT-NEXT:    [[TMP4:%.*]] = phi i1 [ [[C2_INV]], %[[CHECK_ELSE]] ], [ [[C1]], %[[CHECK_THEN]] ]
; OPT-NEXT:    br i1 [[TMP4]], label %[[THEN:.*]], label %[[FLOW2]]
; OPT:       [[THEN]]:
; OPT-NEXT:    br label %[[FLOW2]]
; OPT:       [[FLOW2]]:
; OPT-NEXT:    [[TMP5]] = phi i1 [ false, %[[THEN]] ], [ [[TMP3]], %[[FLOW1]] ]
; OPT-NEXT:    br label %[[FLOW]]
; OPT:       [[ELSE]]:
; OPT-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; OPT-NEXT:    br label %[[MERGE]]
; OPT:       [[MERGE]]:
; OPT-NEXT:    [[R:%.*]] = phi i64 [ [[TMP0]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; OPT-NEXT:    ret i64 [[R]]
;
; FOLD-LABEL: define i64 @then_phi_reaches_else(
; FOLD-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i64 [[X:%.*]], i64 [[W:%.*]], i32 [[A:%.*]]) {
; FOLD-NEXT:  [[ENTRY:.*:]]
; FOLD-NEXT:    [[C2_INV:%.*]] = xor i1 [[C2]], true
; FOLD-NEXT:    [[SPEC_SELECT:%.*]] = select i1 [[C1]], i64 [[X]], i64 [[W]]
; FOLD-NEXT:    [[SPEC_SELECT3:%.*]] = select i1 [[C1]], i1 true, i1 [[C2_INV]]
; FOLD-NEXT:    [[TMP0:%.*]] = xor i1 [[C1]], true
; FOLD-NEXT:    [[TMP1:%.*]] = select i1 [[SPEC_SELECT3]], i1 false, i1 [[TMP0]]
; FOLD-NEXT:    [[TMP2:%.*]] = select i1 [[C0]], i64 poison, i64 [[SPEC_SELECT]]
; FOLD-NEXT:    [[TMP3:%.*]] = select i1 [[C0]], i1 true, i1 [[TMP1]]
; FOLD-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; FOLD-NEXT:    [[SPEC_SELECT4:%.*]] = select i1 [[TMP3]], i64 [[E]], i64 [[TMP2]]
; FOLD-NEXT:    ret i64 [[SPEC_SELECT4]]
;
entry:
  br i1 %c0, label %else, label %check_then

check_then:
  br i1 %c1, label %then, label %check_else

check_else:
  br i1 %c2, label %else, label %then

then:
  %t = phi i64 [ %x, %check_then ], [ %w, %check_else ]
  br label %merge

else:
  %e = zext i32 %a to i64
  br label %merge

merge:
  %r = phi i64 [ %t, %then ], [ %e, %else ]
  ret i64 %r
}

; One Else instruction feeds two results with different Then values. Here
; SSA reconstruction simplifies the value PHIs to the dominating arguments,
; leaving no Flow value PHI to reuse. The follow-up pass keeps both Else arms.
; HoistZeroCostConditionalValues/AMDGPU/triangles.ll covers sharing when the PHIs remain.
define { i64, i64 } @shared_else_instruction(i1 %choose_else, i32 %a, i64 %x, i64 %w) {
; CFG-LABEL: define { i64, i64 } @shared_else_instruction(
; CFG-SAME: i1 [[CHOOSE_ELSE:%.*]], i32 [[A:%.*]], i64 [[X:%.*]], i64 [[W:%.*]]) {
; CFG-NEXT:  [[ENTRY:.*]]:
; CFG-NEXT:    [[CHOOSE_ELSE_INV:%.*]] = xor i1 [[CHOOSE_ELSE]], true
; CFG-NEXT:    br i1 [[CHOOSE_ELSE_INV]], label %[[THEN:.*]], label %[[FLOW:.*]]
; CFG:       [[THEN]]:
; CFG-NEXT:    br label %[[FLOW]]
; CFG:       [[FLOW]]:
; CFG-NEXT:    [[TMP2:%.*]] = phi i1 [ false, %[[THEN]] ], [ true, %[[ENTRY]] ]
; CFG-NEXT:    br i1 [[TMP2]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; CFG:       [[ELSE]]:
; CFG-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; CFG-NEXT:    br label %[[MERGE]]
; CFG:       [[MERGE]]:
; CFG-NEXT:    [[TMP1:%.*]] = phi i64 [ [[X]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; CFG-NEXT:    [[TMP0:%.*]] = phi i64 [ [[W]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; CFG-NEXT:    [[V0:%.*]] = insertvalue { i64, i64 } poison, i64 [[TMP1]], 0
; CFG-NEXT:    [[V1:%.*]] = insertvalue { i64, i64 } [[V0]], i64 [[TMP0]], 1
; CFG-NEXT:    ret { i64, i64 } [[V1]]
;
; OPT-LABEL: define { i64, i64 } @shared_else_instruction(
; OPT-SAME: i1 [[CHOOSE_ELSE:%.*]], i32 [[A:%.*]], i64 [[X:%.*]], i64 [[W:%.*]]) {
; OPT-NEXT:  [[ENTRY:.*]]:
; OPT-NEXT:    [[CHOOSE_ELSE_INV:%.*]] = xor i1 [[CHOOSE_ELSE]], true
; OPT-NEXT:    br i1 [[CHOOSE_ELSE_INV]], label %[[THEN:.*]], label %[[FLOW:.*]]
; OPT:       [[THEN]]:
; OPT-NEXT:    br label %[[FLOW]]
; OPT:       [[FLOW]]:
; OPT-NEXT:    [[TMP0:%.*]] = phi i1 [ false, %[[THEN]] ], [ true, %[[ENTRY]] ]
; OPT-NEXT:    br i1 [[TMP0]], label %[[ELSE:.*]], label %[[MERGE:.*]]
; OPT:       [[ELSE]]:
; OPT-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; OPT-NEXT:    br label %[[MERGE]]
; OPT:       [[MERGE]]:
; OPT-NEXT:    [[R0:%.*]] = phi i64 [ [[X]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; OPT-NEXT:    [[R1:%.*]] = phi i64 [ [[W]], %[[FLOW]] ], [ [[E]], %[[ELSE]] ]
; OPT-NEXT:    [[V0:%.*]] = insertvalue { i64, i64 } poison, i64 [[R0]], 0
; OPT-NEXT:    [[V1:%.*]] = insertvalue { i64, i64 } [[V0]], i64 [[R1]], 1
; OPT-NEXT:    ret { i64, i64 } [[V1]]
;
; FOLD-LABEL: define { i64, i64 } @shared_else_instruction(
; FOLD-SAME: i1 [[CHOOSE_ELSE:%.*]], i32 [[A:%.*]], i64 [[X:%.*]], i64 [[W:%.*]]) {
; FOLD-NEXT:  [[ENTRY:.*:]]
; FOLD-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; FOLD-NEXT:    [[SPEC_SELECT1:%.*]] = select i1 [[CHOOSE_ELSE]], i64 [[E]], i64 [[X]]
; FOLD-NEXT:    [[SPEC_SELECT:%.*]] = select i1 [[CHOOSE_ELSE]], i64 [[E]], i64 [[W]]
; FOLD-NEXT:    [[V0:%.*]] = insertvalue { i64, i64 } poison, i64 [[SPEC_SELECT1]], 0
; FOLD-NEXT:    [[V1:%.*]] = insertvalue { i64, i64 } [[V0]], i64 [[SPEC_SELECT]], 1
; FOLD-NEXT:    ret { i64, i64 } [[V1]]
;
entry:
  br i1 %choose_else, label %else, label %then
then:
  br label %merge
else:
  %e = zext i32 %a to i64
  br label %merge
merge:
  %r0 = phi i64 [ %x, %then ], [ %e, %else ]
  %r1 = phi i64 [ %w, %then ], [ %e, %else ]
  %v0 = insertvalue { i64, i64 } poison, i64 %r0, 0
  %v1 = insertvalue { i64, i64 } %v0, i64 %r1, 1
  ret { i64, i64 } %v1
}

; Else also has an input from Outside, and Merge is not the region exit.
; Structurization redirects Else through a Flow block before the original
; Merge. The follow-up pass uses only the resulting CFG and skips this case
; when its value and condition PHIs do not match. Outside -> Exit returns 7.
define i64 @side_entry(i1 %c0, i1 %c1, i1 %c2, i32 %a, i64 %x) {
; CFG-LABEL: define i64 @side_entry(
; CFG-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i32 [[A:%.*]], i64 [[X:%.*]]) {
; CFG-NEXT:  [[ENTRY:.*]]:
; CFG-NEXT:    [[C0_INV:%.*]] = xor i1 [[C0]], true
; CFG-NEXT:    br i1 [[C0_INV]], label %[[CHOOSE_THEN:.*]], label %[[FLOW:.*]]
; CFG:       [[CHOOSE_THEN]]:
; CFG-NEXT:    br i1 [[C1]], label %[[THEN:.*]], label %[[FLOW1:.*]]
; CFG:       [[FLOW1]]:
; CFG-NEXT:    [[TMP0:%.*]] = phi i64 [ [[T:%.*]], %[[THEN]] ], [ poison, %[[CHOOSE_THEN]] ]
; CFG-NEXT:    [[TMP1:%.*]] = phi i1 [ true, %[[THEN]] ], [ false, %[[CHOOSE_THEN]] ]
; CFG-NEXT:    [[TMP2:%.*]] = phi i1 [ false, %[[THEN]] ], [ true, %[[CHOOSE_THEN]] ]
; CFG-NEXT:    br label %[[FLOW]]
; CFG:       [[OUTSIDE:.*]]:
; CFG-NEXT:    br label %[[FLOW2:.*]]
; CFG:       [[FLOW]]:
; CFG-NEXT:    [[TMP3:%.*]] = phi i64 [ [[TMP0]], %[[FLOW1]] ], [ poison, %[[ENTRY]] ]
; CFG-NEXT:    [[TMP4:%.*]] = phi i1 [ [[TMP1]], %[[FLOW1]] ], [ false, %[[ENTRY]] ]
; CFG-NEXT:    [[TMP5:%.*]] = phi i1 [ [[TMP2]], %[[FLOW1]] ], [ false, %[[ENTRY]] ]
; CFG-NEXT:    [[TMP6:%.*]] = phi i1 [ false, %[[FLOW1]] ], [ true, %[[ENTRY]] ]
; CFG-NEXT:    br i1 [[TMP6]], label %[[OUTSIDE]], label %[[FLOW2]]
; CFG:       [[THEN]]:
; CFG-NEXT:    [[T]] = add i64 [[X]], 1
; CFG-NEXT:    br label %[[FLOW1]]
; CFG:       [[FLOW2]]:
; CFG-NEXT:    [[TMP7:%.*]] = phi i64 [ 7, %[[OUTSIDE]] ], [ [[TMP3]], %[[FLOW]] ]
; CFG-NEXT:    [[TMP8:%.*]] = phi i1 [ [[C2]], %[[OUTSIDE]] ], [ [[TMP5]], %[[FLOW]] ]
; CFG-NEXT:    br i1 [[TMP8]], label %[[ELSE:.*]], label %[[FLOW3:.*]]
; CFG:       [[ELSE]]:
; CFG-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; CFG-NEXT:    br label %[[FLOW3]]
; CFG:       [[FLOW3]]:
; CFG-NEXT:    [[Z:%.*]] = phi i64 [ [[E]], %[[ELSE]] ], [ [[TMP7]], %[[FLOW2]] ]
; CFG-NEXT:    [[TMP10:%.*]] = phi i1 [ true, %[[ELSE]] ], [ [[TMP4]], %[[FLOW2]] ]
; CFG-NEXT:    br i1 [[TMP10]], label %[[MERGE:.*]], label %[[EXIT:.*]]
; CFG:       [[MERGE]]:
; CFG-NEXT:    br label %[[EXIT]]
; CFG:       [[EXIT]]:
; CFG-NEXT:    ret i64 [[Z]]
;
; OPT-LABEL: define i64 @side_entry(
; OPT-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i32 [[A:%.*]], i64 [[X:%.*]]) {
; OPT-NEXT:  [[ENTRY:.*]]:
; OPT-NEXT:    [[C0_INV:%.*]] = xor i1 [[C0]], true
; OPT-NEXT:    br i1 [[C0_INV]], label %[[CHOOSE_THEN:.*]], label %[[FLOW:.*]]
; OPT:       [[CHOOSE_THEN]]:
; OPT-NEXT:    br i1 [[C1]], label %[[THEN:.*]], label %[[FLOW1:.*]]
; OPT:       [[FLOW1]]:
; OPT-NEXT:    [[TMP0:%.*]] = phi i64 [ [[T:%.*]], %[[THEN]] ], [ poison, %[[CHOOSE_THEN]] ]
; OPT-NEXT:    [[TMP1:%.*]] = phi i1 [ true, %[[THEN]] ], [ false, %[[CHOOSE_THEN]] ]
; OPT-NEXT:    [[TMP2:%.*]] = phi i1 [ false, %[[THEN]] ], [ true, %[[CHOOSE_THEN]] ]
; OPT-NEXT:    br label %[[FLOW]]
; OPT:       [[OUTSIDE:.*]]:
; OPT-NEXT:    br label %[[FLOW2:.*]]
; OPT:       [[FLOW]]:
; OPT-NEXT:    [[TMP3:%.*]] = phi i64 [ [[TMP0]], %[[FLOW1]] ], [ poison, %[[ENTRY]] ]
; OPT-NEXT:    [[TMP4:%.*]] = phi i1 [ [[TMP1]], %[[FLOW1]] ], [ false, %[[ENTRY]] ]
; OPT-NEXT:    [[TMP5:%.*]] = phi i1 [ [[TMP2]], %[[FLOW1]] ], [ false, %[[ENTRY]] ]
; OPT-NEXT:    [[TMP6:%.*]] = phi i1 [ false, %[[FLOW1]] ], [ true, %[[ENTRY]] ]
; OPT-NEXT:    br i1 [[TMP6]], label %[[OUTSIDE]], label %[[FLOW2]]
; OPT:       [[THEN]]:
; OPT-NEXT:    [[T]] = add i64 [[X]], 1
; OPT-NEXT:    br label %[[FLOW1]]
; OPT:       [[FLOW2]]:
; OPT-NEXT:    [[TMP7:%.*]] = phi i64 [ 7, %[[OUTSIDE]] ], [ [[TMP3]], %[[FLOW]] ]
; OPT-NEXT:    [[TMP8:%.*]] = phi i1 [ [[C2]], %[[OUTSIDE]] ], [ [[TMP5]], %[[FLOW]] ]
; OPT-NEXT:    br i1 [[TMP8]], label %[[ELSE:.*]], label %[[FLOW3:.*]]
; OPT:       [[ELSE]]:
; OPT-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; OPT-NEXT:    br label %[[FLOW3]]
; OPT:       [[FLOW3]]:
; OPT-NEXT:    [[TMP9:%.*]] = phi i64 [ [[E]], %[[ELSE]] ], [ [[TMP7]], %[[FLOW2]] ]
; OPT-NEXT:    [[TMP10:%.*]] = phi i1 [ true, %[[ELSE]] ], [ [[TMP4]], %[[FLOW2]] ]
; OPT-NEXT:    br i1 [[TMP10]], label %[[MERGE:.*]], label %[[EXIT:.*]]
; OPT:       [[MERGE]]:
; OPT-NEXT:    br label %[[EXIT]]
; OPT:       [[EXIT]]:
; OPT-NEXT:    ret i64 [[TMP9]]
;
; FOLD-LABEL: define i64 @side_entry(
; FOLD-SAME: i1 [[C0:%.*]], i1 [[C1:%.*]], i1 [[C2:%.*]], i32 [[A:%.*]], i64 [[X:%.*]]) {
; FOLD-NEXT:  [[ENTRY:.*:]]
; FOLD-NEXT:    [[T:%.*]] = add i64 [[X]], 1
; FOLD-NEXT:    [[SPEC_SELECT:%.*]] = select i1 [[C1]], i64 [[T]], i64 poison
; FOLD-NEXT:    [[TMP0:%.*]] = xor i1 [[C1]], true
; FOLD-NEXT:    [[TMP1:%.*]] = select i1 [[C0]], i64 poison, i64 [[SPEC_SELECT]]
; FOLD-NEXT:    [[TMP2:%.*]] = select i1 [[C0]], i1 false, i1 [[C1]]
; FOLD-NEXT:    [[TMP3:%.*]] = select i1 [[C0]], i1 false, i1 [[TMP0]]
; FOLD-NEXT:    [[SPEC_SELECT4:%.*]] = select i1 [[C0]], i64 7, i64 [[TMP1]]
; FOLD-NEXT:    [[SPEC_SELECT5:%.*]] = select i1 [[C0]], i1 [[C2]], i1 [[TMP3]]
; FOLD-NEXT:    [[E:%.*]] = zext i32 [[A]] to i64
; FOLD-NEXT:    [[TMP4:%.*]] = select i1 [[SPEC_SELECT5]], i64 [[E]], i64 [[SPEC_SELECT4]]
; FOLD-NEXT:    [[TMP5:%.*]] = select i1 [[SPEC_SELECT5]], i1 true, i1 [[TMP2]]
; FOLD-NEXT:    ret i64 [[TMP4]]
;
entry:
  br i1 %c0, label %outside, label %choose_then
choose_then:
  br i1 %c1, label %then, label %else
outside:
  br i1 %c2, label %else, label %exit
then:
  %t = add i64 %x, 1
  br label %merge
else:
  %e = zext i32 %a to i64
  br label %merge
merge:
  %r = phi i64 [ %t, %then ], [ %e, %else ]
  br label %exit
exit:
  %z = phi i64 [ %r, %merge ], [ 7, %outside ]
  ret i64 %z
}
