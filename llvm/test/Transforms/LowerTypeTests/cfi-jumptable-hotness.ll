; Group h_: verifies that a function with the 'hot' attribute wins (INT64_MAX)
; over a function with a high entry count (1000) and no 'hot' attribute.
define void @h_cold() cold !type !8 !type !2 {
  ret void
}

define void @h_normal() !type !8 !type !2 {
  ret void
}

define void @h_count1000() !prof !5 !type !8 !type !2 {
  ret void
}

define void @h_hot() hot !type !8 !type !2 {
  ret void
}

; Group j_: verifies that BFI CFG block execution count (10000 in loop block)
; wins over a function with a flat CFG and high entry count (1000).
define void @j_cold() cold !type !9 !type !2 {
  ret void
}

define void @j_normal() !type !9 !type !2 {
  ret void
}

define void @j_count1000() !prof !5 !type !9 !type !2 {
  ret void
}

define void @j_cfg_hot() !prof !3 !type !9 !type !2 {
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %next, %loop ]
  %next = add i32 %i, 1
  %cond = icmp slt i32 %next, 1000
  br i1 %cond, label %loop, label %exit, !prof !10

exit:
  ret void
}

