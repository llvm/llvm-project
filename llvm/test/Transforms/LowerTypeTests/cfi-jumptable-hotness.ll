; Tests that functions in a jump table are reordered according to hotness priorities:
; 1. (Highest priority) Within each strict type / fragment, hotter functions are placed later.
;    Hotness is computed as the maximum execution count across entry and basic blocks,
;    with 'hot' attribute boosting to INT64_MAX:
;    Expected hotness order for functions in this test:
;    - cold / unannotated (count 0): 0
;    - unannotated (count 10): 10
;    - cold (count 42): 42
;    - unannotated (count 100): 100
;    - unannotated (count 1000): 1000
;    - cfg hot (entry count 10, loop block count 10000): 10000
;    - hot (count 0 / 500 / 1000): INT64_MAX
; 2. (High priority) Across fragments, the fragment with the globally hottest function
;    is placed at the very end of the jump table (so the globally hottest function is
;    the last entry in .cfi.jumptable).
; 3. (Best effort) Each strict type's members remain contiguous (lowered to range checks, no holes).

target datalayout = "e-p:64:64"

; Pass functions in arbitrary / scrambled order to verify that hotness sorting
; is independent of input declaration order.
@0 = private unnamed_addr constant [22 x ptr] [
  ptr @f_hot_count1000,
  ptr @h_hot,
  ptr @f_cold,
  ptr @g_hot_count500,
  ptr @j_cfg_hot,
  ptr @f_count100,
  ptr @h_cold,
  ptr @g_cold,
  ptr @f_cold_count42,
  ptr @j_normal,
  ptr @g_normal,
  ptr @h_count1000,
  ptr @f_normal,
  ptr @g_count10,
  ptr @j_count1000,
  ptr @g_cold_count42,
  ptr @f_count10,
  ptr @h_normal,
  ptr @g_count100,
  ptr @j_cold,
  ptr @f_hot,
  ptr @g_hot
], align 16

