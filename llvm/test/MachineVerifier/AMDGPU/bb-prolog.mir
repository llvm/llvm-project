# RUN: not --crash llc -mtriple=amdgpu9.00 -verify-machineinstrs -run-pass=none -filetype=null %s 2>&1 | FileCheck %s

# Block prolog instructions must form a block prefix, only preceded by PHIs,
# labels, debug instructions and pseudo probes.

# CHECK-NOT: Bad machine code
# CHECK: *** Bad machine code: Block prolog instruction after non-prolog instruction ***
# CHECK-NEXT: - function: bad
# CHECK-NEXT: - basic block: %bb.0
# CHECK-NEXT: - instruction: %1:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64
# CHECK-NEXT: First non-prolog instruction: %0:sreg_64 = COPY $sgpr0_sgpr1
# CHECK-NOT: Bad machine code

---
name: good
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = COPY $sgpr0_sgpr1
    S_BRANCH %bb.1

  bb.1:
    %1:sreg_64 = PHI %0, %bb.0
    DBG_VALUE
    PSEUDO_PROBE 1, 1, 0, 0
    %2:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 %1, implicit-def $exec, implicit-def $scc, implicit $exec
    DBG_VALUE
    $exec = bb-prolog S_OR_B64 $exec, %2, implicit-def $scc
    S_ENDPGM 0
...

---
name: bad
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = bb-prolog S_OR_SAVEEXEC_B64 %0, implicit-def $exec, implicit-def $scc, implicit $exec
    S_ENDPGM 0, implicit %1
...
