# RUN: not --crash llc -mtriple=amdgpu9.00 -run-pass=none -filetype=null %s 2>&1 | FileCheck %s

# CHECK: *** Bad machine code: Using an undefined physical register ***
# CHECK: - instruction: GLOBAL_STORE_DWORDX2 $vgpr0_vgpr1, $vgpr2_vgpr3, 0, 0, implicit $exec
# CHECK-NEXT: - operand 1: $vgpr2_vgpr3
# CHECK: LLVM ERROR: Found 1 machine code errors.

---
name: bundle_read_before_partial_def
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1

    BUNDLE implicit-def $vgpr2, implicit $vgpr0_vgpr1, implicit $exec, implicit $vgpr2_vgpr3 {
      GLOBAL_STORE_DWORDX2 $vgpr0_vgpr1, $vgpr2_vgpr3, 0, 0, implicit $exec
      $vgpr2 = IMPLICIT_DEF
    }
    S_ENDPGM 0
...
