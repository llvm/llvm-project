# RUN: not --crash llc -mtriple=amdgpu12.50 -run-pass=none -verify-machineinstrs -o /dev/null %s 2>&1 | FileCheck --implicit-check-not="Bad machine code" %s

# Read-only source registers cannot be written. Writes to null are allowed.

---
name: write_read_only_register
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $sgpr1, $sgpr2_sgpr3

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_flat_scratch_base_lo = COPY $sgpr0
    $src_flat_scratch_base_lo = COPY $sgpr0

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_flat_scratch_base = COPY $sgpr2_sgpr3
    $src_flat_scratch_base = COPY $sgpr2_sgpr3

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_shared_base_lo = COPY $sgpr0
    $src_shared_base_lo = COPY $sgpr0

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_shared_base_lo_lo16 = COPY $sgpr1_lo16
    $src_shared_base_lo_lo16 = COPY $sgpr1_lo16

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_scc = COPY $sgpr0
    $src_scc = COPY $sgpr0

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_vccz = COPY $sgpr0
    $src_vccz = COPY $sgpr0

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_execz = COPY $sgpr0
    $src_execz = COPY $sgpr0

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_pops_exiting_wave_id = COPY $sgpr0
    $src_pops_exiting_wave_id = COPY $sgpr0

    ; CHECK: *** Bad machine code: Illegal write to read-only register ***
    ; CHECK: - instruction: $src_scc = S_MOV_B32 0
    ; CHECK: *** Bad machine code: Illegal physical register for instruction ***
    ; CHECK: - instruction: $src_scc = S_MOV_B32 0
    $src_scc = S_MOV_B32 0

    $sgpr_null = COPY $sgpr0
    $sgpr_null64 = COPY $sgpr2_sgpr3
    S_ENDPGM 0
...
