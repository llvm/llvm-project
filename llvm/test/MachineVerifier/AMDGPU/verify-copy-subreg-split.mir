# RUN: not --crash llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=none -filetype=null %s 2>&1 | FileCheck -implicit-check-not="Bad machine code" %s
# gfx942 expands this into a single V_MOV_B64, so it needs no subregisters.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -run-pass=none -filetype=null %s 2>&1 | FileCheck -check-prefix=GFX942 -implicit-check-not="Bad machine code" %s

# src_shared_base has no addressable high half, so the copy cannot be split.

# CHECK: *** Bad machine code: cannot decompose copy into subregister moves ***
# GFX942: name: illegal_aperture_reg_copy

---
name: illegal_aperture_reg_copy
# isSSA: false is required, the COPY check only runs after SSA.
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    renamable $vgpr0_vgpr1 = COPY $src_shared_base
    S_ENDPGM 0, implicit $vgpr0_vgpr1
...

# $pc_reg belongs to no register class, so it has no base class to query.

---
name: copy_reg_without_base_class
isSSA: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    $pc_reg = COPY $sgpr0_sgpr1
    S_ENDPGM 0
...
