# RUN: not --crash llc -mtriple=x86_64 -run-pass=none -filetype=null %s 2>&1 | FileCheck %s -implicit-check-not="Bad machine code"
# REQUIRES: x86-registered-target

---
name: test_freeze
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi

    %0:gr32 = COPY $edi
    %1:gr32 = FREEZE %0

    ; CHECK: Bad machine code: FREEZE operands must be registers
    ; CHECK: - instruction: %2:gr32 = FREEZE 0
    %2:gr32 = FREEZE 0

    ; CHECK: Bad machine code: FREEZE operands must be registers
    ; CHECK: - instruction: FREEZE 0, %0:gr32
    ; CHECK: Bad machine code: Explicit definition must be a register
    ; CHECK: - instruction: FREEZE 0, %0:gr32
    FREEZE 0, %0
...
