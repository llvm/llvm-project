# RUN: not --crash llc -mtriple=x86_64-- -run-pass=none -filetype=null %s 2>&1 | FileCheck %s

# A virtual register that is used but never defined, and is not a block
# argument, must still be reported. This guards that the block-argument def
# exemption is narrow.
# CHECK: *** Bad machine code: Reading virtual register without a def ***
# CHECK-NEXT: - function:    no_def_errors
---
name: no_def_errors
tracksRegLiveness: true
body: |
  bb.0:
    RET64 %0:gr32
...
