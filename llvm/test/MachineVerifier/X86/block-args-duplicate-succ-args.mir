# RUN: not --crash llc -mtriple=x86_64-- -run-pass=none -filetype=null %s 2>&1 | FileCheck %s

# A predecessor must supply at most one SUCC_ARGS per successor.
# CHECK: *** Bad machine code: Multiple SUCC_ARGS for the same successor ***
---
name: duplicate_succ_args
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32ri 1
    SUCC_ARGS %bb.1, %0
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    arguments: %1:gr32
    RET64 %1
...
