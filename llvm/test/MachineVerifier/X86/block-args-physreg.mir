# RUN: not --crash llc -mtriple=x86_64-- -run-pass=none -filetype=null %s 2>&1 | FileCheck %s

# A block argument must be a virtual register, not a physical one.
# CHECK: *** Bad machine code: Block argument must be a virtual register ***
# CHECK-NEXT: - function:    physreg_block_arg
---
name: physreg_block_arg
tracksRegLiveness: true
body: |
  bb.0:
    arguments: $eax
    RET64 $eax
...
