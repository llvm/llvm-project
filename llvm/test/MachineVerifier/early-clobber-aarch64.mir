# RUN: not --crash llc -mtriple=aarch64 -run-pass=none -filetype=null %s 2>&1 | FileCheck %s --implicit-check-not="Bad machine code"
# REQUIRES: aarch64-registered-target

# OK: Physical register overlaps, including aliases, are not checked.
---
name: stxrw_physreg
body: |
  bb.0:
    liveins: $x0, $w2

    early-clobber $w2 = STXRW $w2, $x0
    early-clobber $w0 = STXRW $w2, $x0
    RET_ReallyLR implicit $w0
...

# OK: An undef input does not read the early-clobbered lane.
---
name: stxrw_undef
isSSA: false
body: |
  bb.0:
    liveins: $x0, $w2_w3

    %0:gpr64sp = COPY $x0
    %1:wseqpairsclass = COPY $w2_w3
    early-clobber %1.sube32:wseqpairsclass = STXRW undef %1.sube32, %0
    $w0 = COPY %1.sube32
    RET_ReallyLR implicit $w0
...

# NOK: An untied input cannot read the lane defined by an early-clobber output.
---
name: stxrw_vreg
isSSA: false
body: |
  bb.0:
    liveins: $x0, $w2_w3

    %0:gpr64sp = COPY $x0
    %1:wseqpairsclass = COPY $w2_w3

    ; CHECK: Bad machine code: Early-clobber def overlaps an untied input
    ; CHECK: - instruction: early-clobber %1.sube32:wseqpairsclass = STXRW %1.sube32:wseqpairsclass, %0:gpr64sp
    ; CHECK: - operand 1: {{ *}}%1.sube32:wseqpairsclass
    early-clobber %1.sube32:wseqpairsclass = STXRW %1.sube32, %0
    dead %2:wseqpairsclass = COPY %1
    $w0 = COPY %1.sube32
    RET_ReallyLR implicit $w0
...
