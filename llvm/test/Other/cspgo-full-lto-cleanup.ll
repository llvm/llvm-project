; CS profile loading splits the loop backedge. Clean up before InstCombine can
; sink the decrement into that block and prevent it from being removed.
; Disable unrolling through the pipeline option so the first loop has no
; loop metadata that would prevent removal of the split backedge.

define i32 @loop(ptr %a, i32 %n) {
; CHECK-LABEL: define i32 @loop(
; CHECK-SAME: ptr nofree readonly captures(none) [[A:%.*]], i32 [[N:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] !prof [[PROF29:![0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[N]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ACC:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[IDX:%.*]] = sext i32 [[I]] to i64
; CHECK-NEXT:    [[P:%.*]] = getelementptr [4 x i8], ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[ACC]] = add i32 [[V]], [[SUM]]
; CHECK-NEXT:    [[NEXT]] = add nsw i32 [[I]], -8
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp sgt i32 [[I]], 8
; CHECK-NEXT:    br i1 [[CONTINUE]], label %[[BODY]], label %[[EXIT:.*]], !prof [[PROF30:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ACC_LCSSA:%.*]] = phi i32 [ [[ACC]], %[[BODY]] ]
; CHECK-NEXT:    ret i32 [[ACC_LCSSA]]
;
entry:
  br label %body
body:
  %i = phi i32 [ %n, %entry ], [ %next, %body ]
  %sum = phi i32 [ 0, %entry ], [ %acc, %body ]
  %idx = sext i32 %i to i64
  %p = getelementptr i32, ptr %a, i64 %idx
  %v = load i32, ptr %p, align 4
  %acc = add i32 %v, %sum
  %next = add nsw i32 %i, -8
  %continue = icmp sgt i32 %i, 8
  br i1 %continue, label %body, label %exit
exit:
  ret i32 %acc
}

; Non-debug loop metadata prevents folding the split backedge. Preserve the
; unroll hint when cleanup cannot remove the block.
define i32 @loop_with_metadata(ptr %a, i32 %n) {
; CHECK-LABEL: define i32 @loop_with_metadata(
; CHECK-SAME: ptr nofree readonly captures(none) [[A:%.*]], i32 [[N:%.*]]) local_unnamed_addr #[[ATTR0]] !prof [[PROF29]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[N]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[BODY_BODY_CRIT_EDGE:.*]] ]
; CHECK-NEXT:    [[SUM:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ACC:%.*]], %[[BODY_BODY_CRIT_EDGE]] ]
; CHECK-NEXT:    [[IDX:%.*]] = sext i32 [[I]] to i64
; CHECK-NEXT:    [[P:%.*]] = getelementptr [4 x i8], ptr [[A]], i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[ACC]] = add i32 [[V]], [[SUM]]
; CHECK-NEXT:    [[CONTINUE:%.*]] = icmp sgt i32 [[I]], 8
; CHECK-NEXT:    br i1 [[CONTINUE]], label %[[BODY_BODY_CRIT_EDGE]], label %[[EXIT:.*]], !prof [[PROF30]], !llvm.loop [[LOOP31:![0-9]+]]
; CHECK:       [[BODY_BODY_CRIT_EDGE]]:
; CHECK-NEXT:    [[NEXT]] = add nsw i32 [[I]], -8
; CHECK-NEXT:    br label %[[BODY]], !llvm.loop [[LOOP31]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ACC_LCSSA:%.*]] = phi i32 [ [[ACC]], %[[BODY]] ]
; CHECK-NEXT:    ret i32 [[ACC_LCSSA]]
;
entry:
  br label %body
body:
  %i = phi i32 [ %n, %entry ], [ %next, %body ]
  %sum = phi i32 [ 0, %entry ], [ %acc, %body ]
  %idx = sext i32 %i to i64
  %p = getelementptr i32, ptr %a, i64 %idx
  %v = load i32, ptr %p, align 4
  %acc = add i32 %v, %sum
  %next = add nsw i32 %i, -8
  %continue = icmp sgt i32 %i, 8
  br i1 %continue, label %body, label %exit, !llvm.loop !0
exit:
  ret i32 %acc
}

!0 = distinct !{!0, !1}
!1 = !{!"llvm.loop.unroll.disable"}
