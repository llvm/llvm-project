; RUN: llvm-dis < %s.bc | FileCheck %s

; Materializing a single function out of a lazily loaded module has to upgrade
; it as well: no module-wide pass runs in that case. That is how the clang
; bitcode-linking flow imports functions -- getOwningLazyBitcodeModule plus
; IRMover materializing each imported function -- so exercise it with
; llvm-link --only-needed, which takes the same path. Note that llvm-extract
; would NOT do: it reads the whole module and upgrades either way.
; RUN: llvm-link --only-needed %S/Inputs/atomic-metadata-upgrade-caller.ll \
; RUN:   %s.bc -S -o - | FileCheck %s --check-prefix=LAZY

; LAZY-LABEL: @upgraded(
; LAZY: atomicrmw fadd ptr %p, float %v seq_cst, align 4, !atomic.ignore.denormal.mode !{{[0-9]+}}

; The bitcode fixture was generated by an llvm-as predating the rename of
; !amdgpu.ignore.denormal.mode to !atomic.ignore.denormal.mode, so it still
; carries a METADATA_KIND record for the old name. It deliberately is not
; regenerated from this file: a current llvm-as upgrades while parsing, so an
; llvm-as based test would never reach the bitcode reader at all. The IR the
; fixture was built from is reproduced at the bottom.

; CHECK-LABEL: @upgraded(
; CHECK: atomicrmw fadd ptr %p, float %v seq_cst, align 4, !atomic.ignore.denormal.mode !{{[0-9]+}}

; CHECK-LABEL: @upgraded_fmax(
; CHECK: atomicrmw fmax ptr %p, float %v seq_cst, align 4, !atomic.ignore.denormal.mode !{{[0-9]+}}

; Only atomicrmw ever carried the metadata, so the old name survives untouched
; on anything else.

; CHECK-LABEL: @not_an_atomicrmw(
; CHECK: load float, ptr %p, align 4, !amdgpu.ignore.denormal.mode !{{[0-9]+}}

; define void @upgraded(ptr %p, float %v) {
;   %r = atomicrmw fadd ptr %p, float %v seq_cst, !amdgpu.ignore.denormal.mode !0
;   ret void
; }
;
; define void @upgraded_fmax(ptr %p, float %v) {
;   %r = atomicrmw fmax ptr %p, float %v seq_cst, !amdgpu.ignore.denormal.mode !0
;   ret void
; }
;
; define float @not_an_atomicrmw(ptr %p) {
;   %v = load float, ptr %p, !amdgpu.ignore.denormal.mode !0
;   ret float %v
; }
;
; !0 = !{}
