# RUN: llc -mtriple=x86_64-unknown-linux-gnu -start-before=register-coalescer \
# RUN:   -stop-after=virt-reg-rewriter %s -o - \
# RUN:   | FileCheck %s --implicit-check-not=DBG_

# LiveDebugVariables records SlotIndexes during register allocation and uses
# them afterwards to re-insert debug instructions. Passes in between can erase
# the instructions those indexes name, and canonicalizeIndexes() repairs such
# stale indexes to the closest preceding live instruction. Each function below
# reaches it by a different route. Check that each debug instruction still comes
# out once, in the right place.
#
# The input starts before the register coalescer rather than at register
# allocation because the allocator's decisions depend on the gaps the coalescer
# leaves in the SlotIndex numbering, which MIR does not preserve.
#
# See also DebugInfo/MIR/AArch64/live-debug-vars-stale-slotindexes.mir.

--- |
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"

  define i32 @yyparse(ptr %add.ptr132, i16 %arg, i16 %arg1, i1 %cmp.not, i1 %cmp8) !dbg !5 {
  entry:
      #dbg_label(!9, !10)
    br label %if.end

  if.then:                                          ; preds = %yystack.backedge
    ret i32 0

  if.end:                                           ; preds = %yystack.backedge, %entry
    %yystate.01028 = phi i16 [ 0, %entry ], [ %arg, %yystack.backedge ]
    store i16 %yystate.01028, ptr null, align 2
    br i1 %cmp8, label %if.then10, label %if.end15

  if.then10:                                        ; preds = %if.end
    %call = tail call i32 null()
    br label %if.end15

  if.end15:                                         ; preds = %if.then10, %if.end
    tail call void @llvm.memcpy.p0.p0.i64(ptr align 4294967296 null, ptr align 1 %add.ptr132, i64 1, i1 false)
    %0 = zext i16 %arg1 to i32
    switch i32 %0, label %yystack.backedge [
      i32 2, label %sw.bb162
      i32 4, label %sw.bb164
    ]

  yystack.backedge:                                 ; preds = %if.end15
    br i1 %cmp.not, label %if.end, label %if.then

  sw.bb162:                                         ; preds = %if.end15
    ret i32 0

  sw.bb164:                                         ; preds = %if.end15
    ret i32 0
  }

  define fastcc i32 @accumulate_fit(ptr %flr, ptr %mdct, i32 %x0, i32 %x1, ptr %a, i32 %n, ptr %info, i64 %i.0141) !dbg !11 {
  entry:
      #dbg_value(i64 0, !12, !DIExpression(), !14)
    %conv = sext i32 %x0 to i64
    br label %for.body

  for.body:                                         ; preds = %if.then13, %if.else, %entry
    %y2b.0151 = phi i64 [ 0, %entry ], [ %y2b.0151, %if.then13 ], [ %add31, %if.else ]
    %x2b.0150 = phi i64 [ 0, %entry ], [ %x2b.0150, %if.then13 ], [ %add28, %if.else ]
    %yb.0149 = phi i64 [ 0, %entry ], [ %yb.0149, %if.then13 ], [ %add26, %if.else ]
    %xb.0148 = phi i64 [ 0, %entry ], [ %xb.0148, %if.then13 ], [ %add24, %if.else ]
    %na.0147 = phi i64 [ 0, %entry ], [ %inc, %if.then13 ], [ %na.0147, %if.else ]
    %xya.0146 = phi i64 [ 0, %entry ], [ %add23, %if.then13 ], [ %xya.0146, %if.else ]
    %y2a.0145 = phi i64 [ 0, %entry ], [ %add20, %if.then13 ], [ %y2a.0145, %if.else ]
    %x2a.0144 = phi i64 [ 0, %entry ], [ %add17, %if.then13 ], [ %x2a.0144, %if.else ]
    %i.01412 = phi i64 [ %conv, %entry ], [ 0, %if.then13 ], [ 0, %if.else ]
    %add.ptr = getelementptr [4 x i8], ptr %flr, i64 %i.01412
    %i = load float, ptr %add.ptr, align 4
    %conv.i = fptosi float %i to i32
    %arrayidx = getelementptr [4 x i8], ptr %mdct, i64 %i.01412
    %i1 = load float, ptr %arrayidx, align 4
    %i2 = load float, ptr %info, align 4
    %add = fadd float %i1, %i2
    %i3 = tail call i32 @llvm.umin.i32(i32 %conv.i, i32 1)
    %mul273 = mul i64 %i.0141, %i.0141
    %cmp11 = fcmp ult float %add, 0.000000e+00
    br i1 %cmp11, label %if.else, label %if.then13

  if.then13:                                        ; preds = %for.body
    %add17 = or i64 %x2a.0144, %mul273
    %add20 = or i64 %y2a.0145, 1
    %add23 = or i64 1, %xya.0146
    %inc = or i64 %na.0147, 1
    br label %for.body

  if.else:                                          ; preds = %for.body
    %add24 = or i64 %xb.0148, %i.0141
    %conv25 = zext i32 %i3 to i64
    %add26 = or i64 %yb.0149, %conv25
    %add28 = or i64 %x2b.0150, 1
    %add31 = or i64 %y2b.0151, %i.0141
    br label %for.body
  }

  !llvm.dbg.cu = !{!0, !2}
  !llvm.module.flags = !{!4}

  !0 = distinct !DICompileUnit(language: DW_LANG_C89, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "cdecl.c", directory: "/")
  !2 = distinct !DICompileUnit(language: DW_LANG_C11, file: !3, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !3 = !DIFile(filename: "oggenc.c", directory: "/")
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "yyparse", scope: !6, file: !6, line: 1022, type: !7, scopeLine: 1022, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !6 = !DIFile(filename: "cdgram.y", directory: "/")
  !7 = !DISubroutineType(types: !8)
  !8 = !{}
  !9 = !DILabel(scope: !5, name: "yystack", file: !6, line: 1038, column: 2)
  !10 = !DILocation(line: 1038, column: 2, scope: !5)
  !11 = distinct !DISubprogram(name: "accumulate_fit", scope: !3, file: !3, line: 1, type: !7, scopeLine: 1, spFlags: DISPFlagLocalToUnit | DISPFlagDefinition | DISPFlagOptimized, unit: !2)
  !12 = !DILocalVariable(name: "xa", scope: !11, file: !3, line: 2, type: !13)
  !13 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !14 = !DILocation(line: 0, scope: !11)
...
# The DBG_LABEL in bb.0.entry. UserLabel::loc records the index of the
# instruction before it, which after coalescing is the MOV32r0 defining %11.
# Greedy rematerializes the MOV32r0 next to the CALL64r in bb.3.if.then10 and
# erases the original. Check that loc is canonicalized to the COPY of $rdi
# before it, so that the DBG_LABEL is still emitted between that COPY and the
# MOVZX32rr16.
#
# Reduced from MultiSource/Benchmarks/Prolangs-C/cdecl built at -O2 -g.

# CHECK-LABEL: name: yyparse
# CHECK:       bb.0.entry:
# CHECK:       = COPY $rdi
# CHECK-NEXT:  DBG_LABEL !{{[0-9]+}}
# CHECK-NEXT:  MOVZX32rr16

---
name:            yyparse
alignment:       1
tracksRegLiveness: true
debugInstrRef:   true
liveins:
  - { reg: '$rdi', virtual-reg: '%1' }
  - { reg: '$esi', virtual-reg: '%2' }
  - { reg: '$edx', virtual-reg: '%3' }
  - { reg: '$ecx', virtual-reg: '%4' }
  - { reg: '$r8d', virtual-reg: '%5' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    liveins: $rdi, $esi, $edx, $ecx, $r8d

    %5:gr32 = COPY $r8d
    %4:gr32 = COPY $ecx
    %3:gr32 = COPY $edx
    %2:gr32 = COPY $esi
    %1:gr64 = COPY $rdi
    %9:gr8 = COPY %5.sub_8bit
    %8:gr8 = COPY %4.sub_8bit
    %7:gr16 = COPY %3.sub_16bit
    %6:gr16 = COPY %2.sub_16bit
    %11:gr32 = MOV32r0 implicit-def dead $eflags
    %10:gr16 = COPY %11.sub_16bit
    DBG_LABEL !9, debug-location !10
    %15:gr32 = MOVZX32rr16 %7
    %22:gr16 = COPY %10
    JMP_1 %bb.2

  bb.1.if.then:
    $eax = MOV32r0 implicit-def dead $eflags
    RET 0, $eax

  bb.2.if.end:
    successors: %bb.3, %bb.4

    %0:gr16 = COPY %22
    MOV16mr $noreg, 1, $noreg, 0, $noreg, %0 :: (store (s16) into `ptr null`)
    TEST8ri %9, 1, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.3

  bb.3.if.then10:
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %13:gr64 = SUBREG_TO_REG %11, %subreg.sub_32bit
    CALL64r %13, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def dead $eax
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp

  bb.4.if.end15:
    successors: %bb.7(0x03e0f83e), %bb.5(0x7c1f07c2)

    %16:gr8 = MOV8rm %1, 1, $noreg, 0, $noreg :: (load (s8) from %ir.add.ptr132)
    MOV8mr $noreg, 1, $noreg, 0, $noreg, %16 :: (store (s8) into `ptr null`, align 4294967296)
    CMP16ri %7, 2, implicit-def $eflags
    JCC_1 %bb.7, 4, implicit $eflags
    JMP_1 %bb.5

  bb.5.if.end15:
    successors: %bb.8(0x04000000), %bb.6(0x7c000000)

    CMP32ri %15, 4, implicit-def $eflags
    JCC_1 %bb.8, 4, implicit $eflags
    JMP_1 %bb.6

  bb.6.yystack.backedge:
    successors: %bb.2(0x7c000000), %bb.1(0x04000000)

    TEST8ri %8, 1, implicit-def $eflags
    %22:gr16 = COPY %6
    JCC_1 %bb.2, 5, implicit $eflags
    JMP_1 %bb.1

  bb.7.sw.bb162:
    $eax = MOV32r0 implicit-def dead $eflags
    RET 0, $eax

  bb.8.sw.bb164:
    $eax = MOV32r0 implicit-def dead $eflags
    RET 0, $eax
...
# The DBG_VALUE in bb.0.entry. In instruction referencing mode it is unlinked
# during register allocation, and StashedDebugInstrs records the index of the
# instruction before it, the load of %26, to re-insert it after. Greedy
# rematerializes that load next to its use, the ADDSSrm in bb.1.for.body, and
# erases the original. Check that the index is canonicalized to the load of %27
# before it, so that the DBG_VALUE is still emitted between that load and the
# MOVSX64rr32.
#
# Reduced from MultiSource/Applications/oggenc built at -O2 -g.

# CHECK-LABEL: name: accumulate_fit
# CHECK:       bb.0.entry:
# CHECK:       = MOV64rm %fixed-stack.1, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.1)
# CHECK-NEXT:  DBG_VALUE 0, $noreg, !{{[0-9]+}}, !DIExpression()
# CHECK-NEXT:  MOVSX64rr32

---
name:            accumulate_fit
alignment:       1
tracksRegLiveness: true
debugInstrRef:   true
liveins:
  - { reg: '$rdi', virtual-reg: '%20' }
  - { reg: '$rsi', virtual-reg: '%21' }
  - { reg: '$edx', virtual-reg: '%22' }
frameInfo:
  maxAlignment:    8
  framePointerPolicy: none
fixedStack:
  - { id: 0, offset: 8, size: 8, alignment: 8, isImmutable: true }
  - { id: 1, size: 8, alignment: 16, isImmutable: true }
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    liveins: $rdi, $rsi, $edx

    %22:gr32 = COPY $edx
    %21:gr64 = COPY $rsi
    %20:gr64 = COPY $rdi
    %27:gr64 = MOV64rm %fixed-stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.0)
    %26:gr64 = MOV64rm %fixed-stack.1, 1, $noreg, 0, $noreg :: (load (s64) from %fixed-stack.1, align 16)
    DBG_VALUE 0, $noreg, !12, !DIExpression(), debug-location !14
    %0:gr64 = MOVSX64rr32 %22
    %29:gr32 = MOV32r0 implicit-def dead $eflags
    %28:gr64 = SUBREG_TO_REG %29, %subreg.sub_32bit
    %34:gr32 = MOV32ri 1
    %11:gr64 = COPY %27
    %11:gr64 = IMUL64rr %11, %11, implicit-def dead $eflags
    %35:fr32 = FsFLD0SS
    %42:gr64 = COPY %28
    %43:gr64 = COPY %28
    %44:gr64 = COPY %28
    %45:gr64 = COPY %28
    %46:gr64 = COPY %28
    %47:gr64 = COPY %28
    %48:gr64 = COPY %28
    %49:gr64 = COPY %28
    %50:gr64_nosp = COPY %0

  bb.1.for.body:
    %9:gr64_nosp = COPY %50
    %8:gr64 = COPY %49
    %7:gr64 = COPY %48
    %6:gr64 = COPY %47
    %5:gr64 = COPY %46
    %4:gr64 = COPY %45
    %3:gr64 = COPY %44
    %2:gr64 = COPY %43
    %1:gr64 = COPY %42
    %30:gr32 = nofpexcept CVTTSS2SIrm %20, 4, %9, 0, $noreg, implicit $mxcsr :: (load (s32) from %ir.add.ptr)
    %31:fr32 = MOVSSrm_alt %21, 4, %9, 0, $noreg :: (load (s32) from %ir.arrayidx)
    %32:fr32 = COPY %31
    %32:fr32 = nofpexcept ADDSSrm %32, %26, 1, $noreg, 0, $noreg, implicit $mxcsr :: (load (s32) from %ir.info)
    CMP32ri %30, 1, implicit-def $eflags
    %10:gr32 = COPY %30
    %10:gr32 = CMOV32rr %10, %34, 3, implicit $eflags
    nofpexcept UCOMISSrr %32, %35, implicit-def $eflags, implicit $mxcsr
    JCC_1 %bb.3, 2, implicit $eflags
    JMP_1 %bb.2

  bb.2.if.then13:
    %12:gr64 = COPY %8
    %12:gr64 = OR64rr %12, %11, implicit-def dead $eflags
    %13:gr64 = COPY %7
    %13:gr64 = OR64ri32 %13, 1, implicit-def dead $eflags
    %14:gr64 = COPY %6
    %14:gr64 = OR64ri32 %14, 1, implicit-def dead $eflags
    %15:gr64 = COPY %5
    %15:gr64 = OR64ri32 %15, 1, implicit-def dead $eflags
    %36:gr64 = SUBREG_TO_REG %29, %subreg.sub_32bit
    %42:gr64 = COPY %1
    %43:gr64 = COPY %2
    %44:gr64 = COPY %3
    %45:gr64 = COPY %4
    %46:gr64 = COPY %15
    %47:gr64 = COPY %14
    %48:gr64 = COPY %13
    %49:gr64 = COPY %12
    %50:gr64_nosp = COPY %36
    JMP_1 %bb.1

  bb.3.if.else:
    %16:gr64 = COPY %4
    %16:gr64 = OR64rr %16, %27, implicit-def dead $eflags
    %39:gr32 = MOV32rr %10
    %40:gr64 = SUBREG_TO_REG %39, %subreg.sub_32bit
    %17:gr64 = COPY %3
    %17:gr64 = OR64rr %17, %40, implicit-def dead $eflags
    %18:gr64 = COPY %2
    %18:gr64 = OR64ri32 %18, 1, implicit-def dead $eflags
    %19:gr64 = COPY %1
    %19:gr64 = OR64rr %19, %27, implicit-def dead $eflags
    %38:gr64 = SUBREG_TO_REG %29, %subreg.sub_32bit
    %42:gr64 = COPY %19
    %43:gr64 = COPY %18
    %44:gr64 = COPY %17
    %45:gr64 = COPY %16
    %46:gr64 = COPY %5
    %47:gr64 = COPY %6
    %48:gr64 = COPY %7
    %49:gr64 = COPY %8
    %50:gr64_nosp = COPY %38
    JMP_1 %bb.1
...
