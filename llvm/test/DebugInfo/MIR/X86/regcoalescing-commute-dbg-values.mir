# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-unknown %s -o - -run-pass=register-coalescer | FileCheck %s

# The copy %0 = COPY %1 is removed by commuting the ADD so that it defines %0
# directly. Only the value of %1 defined by the ADD moves to %0; DBG_VALUEs
# reading other values of %1 must keep referring to %1.

--- |
  define i32 @commute() !dbg !3 {
    ret i32 0
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "commute", scope: !1, file: !1, line: 1, type: !4, unit: !0, spFlags: DISPFlagDefinition)
  !4 = !DISubroutineType(types: !5)
  !5 = !{null}
  !6 = !DILocalVariable(name: "before", scope: !3, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DILocalVariable(name: "sum", scope: !3, file: !1, line: 1, type: !7)
  !9 = !DILocalVariable(name: "aftercopy", scope: !3, file: !1, line: 1, type: !7)
  !10 = !DILocalVariable(name: "later", scope: !3, file: !1, line: 1, type: !7)
  !11 = !DILocation(line: 1, scope: !3)
...
---
name: commute
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: commute
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi, $esi, $edx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY $edx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   DBG_VALUE [[COPY1]], $noreg, !6, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   DBG_VALUE [[COPY]], $noreg, !8, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   DBG_VALUE [[COPY1]], $noreg, !9, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = MOV32rm $rip, 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   DBG_VALUE [[COPY1]], $noreg, !10, !DIExpression(), debug-location !DILocation(line: 1, scope: !3)
  ; CHECK-NEXT:   TEST32rr [[COPY2]], [[COPY2]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $eax = COPY [[COPY]]
  ; CHECK-NEXT:   $ecx = COPY [[COPY1]]
  ; CHECK-NEXT:   RET 0, $eax, $ecx
  bb.0:
    liveins: $edi, $esi, $edx

    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = COPY $edx

  bb.1:
    DBG_VALUE %1, $noreg, !6, !DIExpression(), debug-location !11
    %1:gr32 = ADD32rr %1, killed %0, implicit-def dead $eflags
    DBG_VALUE %1, $noreg, !8, !DIExpression(), debug-location !11
    %0:gr32 = COPY %1
    DBG_VALUE %1, $noreg, !9, !DIExpression(), debug-location !11
    %1:gr32 = MOV32rm $rip, 1, $noreg, 0, $noreg
    DBG_VALUE %1, $noreg, !10, !DIExpression(), debug-location !11
    TEST32rr %2, %2, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags

  bb.2:
    $eax = COPY %0
    $ecx = COPY %1
    RET 0, $eax, $ecx
...
