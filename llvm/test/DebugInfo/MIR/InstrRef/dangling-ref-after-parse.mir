# RUN: llc -mtriple=x86_64-- -run-pass x86-fixup-bw-insts,live-debug-values %s -o - \
# RUN:   | FileCheck %s
#
# The DBG_INSTR_REF refers to instruction 2, which no longer exists, so the
# variable has no location. The fixup pass rewrites the MOV16rm with a new
# number; that number must not be 2, or the reference would resolve to the
# rewritten load.
#
# FIXME: The rewrite reuses 2, so the variable gets the load's value.

# CHECK:      DBG_INSTR_REF {{![0-9]+}}, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(2, 0)
# CHECK-NEXT: DBG_VALUE_LIST {{![0-9]+}}, !DIExpression(DW_OP_LLVM_arg, 0), $eax,
--- |
  define i16 @test(ptr %p) !dbg !5 {
    ret i16 0, !dbg !10
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4}
  !0 = distinct !DICompileUnit(language: DW_LANG_C_plus_plus, file: !1, producer: "", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "foo.cpp", directory: ".")
  !2 = !DIBasicType(name: "short", size: 16, encoding: DW_ATE_signed)
  !3 = !{i32 2, !"Dwarf Version", i32 4}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = distinct !DISubprogram(name: "test", scope: !1, file: !1, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !8)
  !6 = !DISubroutineType(types: !7)
  !7 = !{!2}
  !8 = !{!9}
  !9 = !DILocalVariable(name: "x", scope: !5, file: !1, line: 2, type: !2)
  !10 = !DILocation(line: 2, scope: !5)
...
---
name:            test
debugInstrRef:   true
body:             |
  bb.0:
    liveins: $rdi
    $ax = MOV16rm killed $rdi, 1, $noreg, 0, $noreg, debug-instr-number 1, debug-location !10
    DBG_INSTR_REF !9, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(2, 0), debug-location !10
    RET64 $ax, debug-location !10
...
