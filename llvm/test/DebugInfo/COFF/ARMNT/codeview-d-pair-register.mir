# This test checks that a variable in an ARM D-register pair, which has no codeview number,
# does not abort codeview emission.
#
# RUN: llc %s -mtriple=thumbv7-unknown-windows-msvc -filetype=obj -o %t --start-after=unpack-mi-bundles
# RUN: llvm-readobj --codeview %t | FileCheck %s \
# RUN:   --implicit-check-not="D1_D2" --implicit-check-not="ARM_ND1 (" --implicit-check-not="ARM_ND2 ("
#
# CodeView numbers the core and status registers and S0-S31, D0-D31 and Q0-Q15, but it has no
# number for a register tuple such as D1_D2; the location is dropped and the variable reports as
# optimized out. Before this was handled, emission reached
# report_fatal_error("unknown codeview register D1_D2") and the whole object was lost.
#
# 'qreg' is the control: it differs from 'dpair' only in being representable, so it must keep a
# real def range, proving mappable registers are undisturbed.
#
# The negatives are --implicit-check-not rather than CHECK-NOT directives: an implicit not applies
# to the entire input at every position, where a CHECK-NOT only covers the span between the
# directives bracketing it.
#
# This is a MIR test, started after unpack-mi-bundles, because the point is the physical register
# assignment: run from IR the allocator need not choose a D-pair and the test would pass vacuously.

#      CHECK:   VarName: qreg
# CHECK-NEXT: }
# CHECK-NEXT: DefRangeRegisterSym {
# CHECK-NEXT:   Kind: S_DEFRANGE_REGISTER (0x1141)
# CHECK-NEXT:   Register: ARM_NQ1 (0x191)

#      CHECK:   Flags [ (0x100)
# CHECK-NEXT:     IsOptimizedOut (0x100)
# CHECK-NEXT:   ]
# CHECK-NEXT:   VarName: dpair

# Nothing may name the tuple, nor substitute one half of it -- a wrong location is worse than
# none. A mappable D or Q register is emitted under its own codeview name, never decomposed into
# D halves, so neither ARM_ND1 nor ARM_ND2 can appear for a legitimate reason here.

--- |
  target datalayout = "e-m:w-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
  target triple = "thumbv7-unknown-windows-msvc19.33.0"

  define dso_local arm_aapcs_vfpcc void @f(ptr readonly %0, ptr %1) #0 !dbg !25 {
    %3 = getelementptr inbounds i16, ptr %0, i32 8, !dbg !41
    %4 = load <8 x i16>, ptr %3, align 2, !dbg !41
    %5 = shufflevector <8 x i16> %4, <8 x i16> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>, !dbg !43
    %6 = load <8 x i16>, ptr %0, align 2, !dbg !44
    %7 = shufflevector <8 x i16> %6, <8 x i16> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>, !dbg !43
    %8 = shufflevector <4 x i16> %7, <4 x i16> %5, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>, !dbg !43
    tail call void @llvm.arm.neon.vst1.p0.v8i16(ptr %1, <8 x i16> %8, i32 2), !dbg !43
    ret void, !dbg !47
  }

  declare void @llvm.arm.neon.vst1.p0.v8i16(ptr, <8 x i16>, i32) #1

  attributes #0 = { nounwind uwtable "frame-pointer"="all" "target-cpu"="cortex-a9" "target-features"="+armv7-a,+d32,+dsp,+fp16,+fp64,+neon,+thumb-mode,+vfp2,+vfp2sp,+vfp3,+vfp3d16,+vfp3d16sp,+vfp3sp" }
  attributes #1 = { nounwind }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!17, !18, !19, !20, !21, !22}

  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, retainedTypes: !2, splitDebugInlining: false, nameTableKind: None)
  !1 = !DIFile(filename: "test.c", directory: ".")
  !2 = !{!3}
  !3 = !DIDerivedType(tag: DW_TAG_typedef, name: "int16x8_t", file: !4, line: 26, baseType: !5)
  !4 = !DIFile(filename: "arm_vector_types.h", directory: ".")
  !5 = !DICompositeType(tag: DW_TAG_array_type, baseType: !6, size: 128, flags: DIFlagVector, elements: !9)
  !6 = !DIDerivedType(tag: DW_TAG_typedef, name: "int16_t", file: !7, line: 19, baseType: !8)
  !7 = !DIFile(filename: "stdint.h", directory: ".")
  !8 = !DIBasicType(name: "short", size: 16, encoding: DW_ATE_signed)
  !9 = !{!10}
  !10 = !DISubrange(count: 8)
  !17 = !{i32 2, !"CodeView", i32 1}
  !18 = !{i32 2, !"Debug Info Version", i32 3}
  !19 = !{i32 1, !"wchar_size", i32 2}
  !20 = !{i32 1, !"min_enum_size", i32 4}
  !21 = !{i32 7, !"uwtable", i32 2}
  !22 = !{i32 7, !"frame-pointer", i32 2}
  !25 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 2, type: !26, scopeLine: 2, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !31)
  !26 = !DISubroutineType(types: !27)
  !27 = !{null, !28, !30}
  !28 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !29, size: 32)
  !29 = !DIDerivedType(tag: DW_TAG_const_type, baseType: !8)
  !30 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !8, size: 32)
  !31 = !{!34, !38}
  !34 = !DILocalVariable(name: "qreg", scope: !35, file: !1, line: 3, type: !3)
  !35 = distinct !DILexicalBlock(scope: !25, file: !1, line: 3)
  !38 = !DILocalVariable(name: "dpair", scope: !39, file: !1, line: 3, type: !3)
  !39 = distinct !DILexicalBlock(scope: !35, file: !1, line: 3)
  !41 = !DILocation(line: 3, scope: !39)
  !43 = !DILocation(line: 3, scope: !35)
  !44 = !DILocation(line: 3, scope: !39)
  !45 = !DILocation(line: 0, scope: !39)
  !46 = !DILocation(line: 0, scope: !35)
  !47 = !DILocation(line: 5, scope: !25)
...
---
name:            f
alignment:       2
tracksRegLiveness: true
tracksDebugUserValues: true
liveins:
  - { reg: '$r0' }
  - { reg: '$r1' }
frameInfo:
  maxAlignment:    1
machineFunctionInfo:
  isLRSpilled:     false
body:             |
  bb.0 (%ir-block.2):
    liveins: $r0, $r1

    $d1_d2, $r0 = VLD1q16wb_fixed killed renamable $r0, 0, 14 /* CC::al */, $noreg, implicit-def $d1_d2_d3, debug-location !44 :: (load (s128) from %ir.0, align 2)
    DBG_VALUE $d1_d2, $noreg, !38, !DIExpression(), debug-location !45
    renamable $r0, dead $cpsr = tADDi8 killed renamable $r0, 8, 14 /* CC::al */, $noreg
    $d3 = VLD1d16 killed renamable $r0, 0, 14 /* CC::al */, $noreg, implicit killed $d1_d2_d3, implicit-def $d1_d2_d3, debug-location !43 :: (load (s64) from %ir.3 + 8, align 2)
    DBG_VALUE $q1, $noreg, !34, !DIExpression(), debug-location !46
    VST1q16 killed $r1, 0, $q1, 14 /* CC::al */, $noreg, implicit killed $d1_d2_d3, debug-location !43 :: (store (s128) into %ir.1, align 2)
    tBX_RET 14 /* CC::al */, $noreg, debug-location !47
...
