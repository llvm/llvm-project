# RUN: llc -mtriple=aarch64-linux-gnu -O0 -run-pass=reg-bank-select -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s --check-prefix=RBS
# RUN: llc -mtriple=aarch64-linux-gnu -O0 -run-pass=reg-bank-select,instruction-select \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ISEL

# A DBG_VALUE can refer to a register that nothing defines. It still gets a
# register bank, and then a register class, so that no generic virtual register
# is left after instruction selection.

--- |
  define void @foo() !dbg !4 { ret void }

  !llvm.module.flags = !{!0}
  !llvm.dbg.cu = !{!1}
  !0 = !{i32 2, !"Debug Info Version", i32 3}
  !1 = distinct !DICompileUnit(language: DW_LANG_C11, file: !2, emissionKind: FullDebug)
  !2 = !DIFile(filename: "t.c", directory: "/")
  !3 = !DISubroutineType(types: !{null})
  !4 = distinct !DISubprogram(name: "foo", scope: !2, file: !2, type: !3, spFlags: DISPFlagDefinition, unit: !1)
  !5 = !DILocalVariable(name: "m", scope: !4, file: !2)
  !6 = !DILocation(line: 1, scope: !4)
...

# RBS-LABEL:  name: foo
# RBS:        DBG_VALUE %0:gpr(i32), $noreg
# ISEL-LABEL: name: foo
# ISEL:       DBG_VALUE %0:gpr32, $noreg
---
name:            foo
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    DBG_VALUE %0:_(i32), $noreg, !5, !DIExpression(), debug-location !6
    RET_ReallyLR
...
