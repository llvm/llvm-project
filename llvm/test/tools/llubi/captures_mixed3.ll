; RUN: not llubi --verbose < %s 2>&1 | FileCheck %s
; Test that the other-location copy and the return-value copy of the same
; capture never share provenance. Both copies are read-only here, but they
; still have different tags.

target datalayout = "e-p:64:64:64"

; Recombining bits from two pointers is valid only when they share the same
; provenance.
define ptr @mix_pointer(ptr %pa, ptr %pb) {
  %ba = bitcast ptr %pa to <2 x b32>
  %bb = bitcast ptr %pb to <2 x b32>
  %bc = shufflevector <2 x b32> %ba, <2 x b32> %bb, <2 x i32> <i32 0, i32 3>
  %pc = bitcast <2 x b32> %bc to ptr
  ret ptr %pc
}

@g = global ptr null

define ptr @capture_both(ptr captures(read_provenance) %a) {
  store ptr %a, ptr @g
  ret ptr %a
}

define void @main() {
  %p = alloca i32
  %ret = call ptr @capture_both(ptr %p)
  %mem = load ptr, ptr @g
  ; The two read-only provenances are distinct, so mixing their bits yields a
  ; nullary pointer and the store is immediate UB.
  %mixed = call ptr @mix_pointer(ptr %ret, ptr %mem)
  store i32 0, ptr %mixed
  ret void
}
