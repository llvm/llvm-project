@a = global [4 x i32] [i32 0, i32 1, i32 2, i32 3]
@c = constant [4 x i32] [i32 0, i32 1, i32 2, i32 3]

define void @main() {
  %ptrs = getelementptr i32, ptr @a, <4 x i64> <i64 3, i64 0, i64 2, i64 1>
  call void @llvm.vp.scatter(<4 x i32> <i32 10, i32 11, i32 12, i32 13>, <4 x ptr> %ptrs, <4 x i1> <i1 true, i1 false, i1 true, i1 true>, i32 3)
  %after_partial = load <4 x i32>, ptr @a, align 4

  ; Lanes at or past %evl are disabled even if their mask lane is poison.
  call void @llvm.vp.scatter(<4 x i32> splat (i32 20), <4 x ptr> %ptrs, <4 x i1> <i1 true, i1 poison, i1 poison, i1 poison>, i32 1)
  %after_poison_tail = load <4 x i32>, ptr @a, align 4

  ; Disabled lanes are not accessed, so constant memory is fine.
  %ptrs_c = getelementptr i32, ptr @c, <4 x i64> <i64 0, i64 1, i64 2, i64 3>
  call void @llvm.vp.scatter(<4 x i32> poison, <4 x ptr> %ptrs_c, <4 x i1> splat (i1 true), i32 0)

  %step = call <vscale x 2 x i64> @llvm.stepvector()
  %ptrs_scalable = getelementptr i32, ptr @a, <vscale x 2 x i64> %step
  call void @llvm.vp.scatter(<vscale x 2 x i32> splat (i32 30), <vscale x 2 x ptr> %ptrs_scalable, <vscale x 2 x i1> splat (i1 true), i32 3)
  %after_scalable = load <4 x i32>, ptr @a, align 4
  ret void
}
