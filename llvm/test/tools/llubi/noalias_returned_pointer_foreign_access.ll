; After an inner return, its pointer still conflicts with an outer foreign alias.

define ptr @identity(ptr noalias %p) {
  ret ptr %p
}

define void @escaped_bad_outer(ptr noalias %p, ptr %raw) {
  %q = call ptr @identity(ptr %p)
  store i32 1, ptr %q
  store i32 2, ptr %raw
  ret void
}

define void @main() {
  %a = alloca i32
  call void @escaped_bad_outer(ptr %a, ptr %a)
  ret void
}

