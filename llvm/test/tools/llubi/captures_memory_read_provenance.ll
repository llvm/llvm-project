; RUN: not llubi --verbose < %s 2>&1 | FileCheck %s
; Test that read_provenance captured through memory survives the call, while
; writes through the stored copy are forbidden.

@g = global ptr null

define void @capture_read_provenance(ptr captures(read_provenance) %p) {
  store ptr %p, ptr @g
  ret void
}

define void @main() {
  %p = alloca i32
  store i32 0, ptr %p
  call void @capture_read_provenance(ptr %p)
  %q = load ptr, ptr @g
  ; Reading through the stored copy is allowed.
  %v = load i32, ptr %q
  ; Writing through the stored copy is immediate UB.
  store i32 1, ptr %q
  ret void
}
