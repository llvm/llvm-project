; A foreign memset is a write, even though it does not use ExecutorBase::store.

declare void @llvm.memset.inline.p0.i64(ptr, i8, i64, i1)

define void @memset_bad(ptr noalias %p, ptr %raw) {
  store i32 1, ptr %p
  call void @llvm.memset.inline.p0.i64(ptr %raw, i8 0, i64 4, i1 false)
  ret void
}

define void @main() {
  %a = alloca i32
  call void @memset_bad(ptr %a, ptr %a)
  ret void
}

