; RUN: llubi --verbose < %s 2>&1 | FileCheck %s

target datalayout = "e-p:52:64"

@g = global i8 0

; The pointer is padded with 4 bits. Make sure we use the tag with correct bitwidth to recover
; the provenance.

define void @main() {
  %p = alloca ptr
  store ptr @g, ptr %p
  %q = load ptr, ptr %p
  load i8, ptr %q
  ret void
}
