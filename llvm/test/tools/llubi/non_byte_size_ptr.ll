; CHECK-NEXT:   store ptr @g, ptr %p, align 8
; CHECK-NEXT:   %q = load ptr, ptr %p, align 8 => ptr 0x8 [@g]
; CHECK-NEXT:   %1 = load i8, ptr %q, align 1 => i8 0
; CHECK-NEXT:   ret void
; CHECK-NEXT: Exiting function: main
