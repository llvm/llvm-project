; NOTE: Assertions have been autogenerated by utils/update_llubi_test_checks.py UTC_ARGS: --version 6
; RUN: llubi --verbose < %s 2>&1 | FileCheck %s

target datalayout = "e-p:52:64"

@g = global i8 0

; The pointer is padded with 4 bits. Make sure we use the tag with correct bitwidth to recover
; the provenance.

define void @main() {
  %p = alloca ptr
  store ptr @g, ptr %p
  %q = load ptr, ptr %p
  load i8, ptr %q

  ; Make sure the padding bits written by the pointer store stay clean zero
  ; when the memory is loaded as a non-byte-sized byte type.
  %bytes = load b52, ptr %p
  %q2 = bitcast b52 %bytes to ptr
  ret void
}
