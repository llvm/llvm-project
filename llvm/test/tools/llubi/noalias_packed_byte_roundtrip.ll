; A bit-preserving cast through packed bytes must preserve the pointer
; provenance, including its noalias node.
define void @roundtrip(ptr noalias %p) {
  %v0 = insertelement <3 x ptr> poison, ptr %p, i32 0
  %v1 = insertelement <3 x ptr> %v0, ptr %p, i32 1
  %v2 = insertelement <3 x ptr> %v1, ptr %p, i32 2
  %bits = bitcast <3 x ptr> %v2 to <64 x b3>
  %restored = bitcast <64 x b3> %bits to <3 x ptr>
  %p2 = extractelement <3 x ptr> %restored, i32 0
  store i32 1, ptr %p
  store i32 2, ptr %p2
  ret void
}

define void @main() {
  %a = alloca i32
  call void @roundtrip(ptr %a)
  ret void
}
