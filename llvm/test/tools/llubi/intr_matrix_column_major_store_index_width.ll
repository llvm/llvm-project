; NOTE: Assertions have been autogenerated by utils/update_llubi_test_checks.py UTC_ARGS: --version 6
; RUN: llubi --verbose < %s 2>&1 | FileCheck %s

; The stride is compared to the number of rows before it is truncated to the
; 32-bit index type, so the columns overlap.
target datalayout = "p:64:64:64:32"

@a = global [4 x i32] zeroinitializer

define void @main() {
  call void @llvm.matrix.column.major.store.v4i32.i64(<4 x i32> <i32 1, i32 2, i32 3, i32 4>, ptr align 4 @a, i64 4294967297, i1 false, i32 2, i32 2)
  %after = load <4 x i32>, ptr @a, align 4
  ret void
}
; CHECK: Entering function: main
; CHECK-NEXT:   call void @llvm.matrix.column.major.store.v4i32.i64(<4 x i32> <i32 1, i32 2, i32 3, i32 4>, ptr align 4 @a, i64 4294967297, i1 false, i32 2, i32 2)
; CHECK-NEXT:   %after = load <4 x i32>, ptr @a, align 4 => { i32 1, i32 3, i32 4, i32 0 }
; CHECK-NEXT:   ret void
; CHECK-NEXT: Exiting function: main
