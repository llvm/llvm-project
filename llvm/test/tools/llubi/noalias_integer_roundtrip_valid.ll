; A ptrtoint exposes the protected provenance. Resolve its node only when the
; reconstructed wildcard pointer is accessed, without tracking integer values.
define void @roundtrip(ptr noalias %p) {
  store i32 1, ptr %p
  %bits = ptrtoint ptr %p to i64
  %roundtrip = inttoptr i64 %bits to ptr
  store i32 2, ptr %roundtrip
  ret void
}

define void @main() {
  %a = alloca i32
  call void @roundtrip(ptr %a)
  ret void
}
