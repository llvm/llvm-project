@a = global [8 x i32] zeroinitializer
@b = global [129 x i8] zeroinitializer
@f = global [2 x x86_fp80] zeroinitializer
@c = global [4 x i8] zeroinitializer

define void @main() {
  ; Elements between columns are not touched.
  call void @llvm.matrix.column.major.store.v4i32.i32(<4 x i32> <i32 10, i32 11, i32 12, i32 13>, ptr align 4 @a, i32 5, i1 false, i32 2, i32 2)
  %after_stride = load <8 x i32>, ptr @a, align 4

  ; The stride is unsigned.
  call void @llvm.matrix.column.major.store.v2i8.i8(<2 x i8> <i8 1, i8 2>, ptr @b, i8 128, i1 false, i32 1, i32 2)
  %b_0 = load i8, ptr @b
  %p_128 = getelementptr i8, ptr @b, i64 128
  %b_128 = load i8, ptr %p_128

  ; Columns are a multiple of the alloc size apart.
  call void @llvm.matrix.column.major.store.v2f80.i64(<2 x x86_fp80> <x86_fp80 0xK3FFF8000000000000000, x86_fp80 0xK40008000000000000000>, ptr @f, i64 1, i1 false, i32 1, i32 2)
  %after_fp80 = load [2 x x86_fp80], ptr @f

  ; Each column is stored as a <Rows x i1> vector.
  call void @llvm.matrix.column.major.store.v4i1.i64(<4 x i1> <i1 true, i1 true, i1 false, i1 true>, ptr @c, i64 2, i1 false, i32 2, i32 2)
  %after_i1 = load <4 x i8>, ptr @c, align 1
  ret void
}
