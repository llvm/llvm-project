; RUN: llubi --verbose < %s 2>&1 | FileCheck %s
; Test that capture attributes that do not drop provenance reuse the original
; provenance and its tag. This includes the default, captures(provenance),
; captures(address, provenance), and captures of the full provenance through
; the return value. All cases are covered in one run because none of them has
; UB.

target datalayout = "e-p:64:64:64"

; Recombining bits from two pointers is valid only when they share the same
; provenance.
define ptr @mix_pointer(ptr %pa, ptr %pb) {
  %ba = bitcast ptr %pa to <2 x b32>
  %bb = bitcast ptr %pb to <2 x b32>
  %bc = shufflevector <2 x b32> %ba, <2 x b32> %bb, <2 x i32> <i32 0, i32 3>
  %pc = bitcast <2 x b32> %bc to ptr
  ret ptr %pc
}

define ptr @identity(ptr %a) {
  ret ptr %a
}

define ptr @identity_provenance(ptr captures(provenance) %a) {
  ret ptr %a
}

define ptr @identity_ret_provenance(ptr captures(ret: address, provenance) %a) {
  ret ptr %a
}

@g = global ptr null

define void @captured_by_mem(ptr captures(address, provenance) %a) {
  store ptr %a, ptr @g
  ret void
}

define void @captured_by_mem_provenance(ptr captures(provenance) %a) {
  store ptr %a, ptr @g
  ret void
}

define void @main() {
  %p1 = alloca i32
  ; The default captures attribute does not create a new provenance identity
  ; for the returned copy.
  %p2 = call ptr @identity(ptr %p1)
  %mixed_return = call ptr @mix_pointer(ptr %p1, ptr %p2)
  store i32 0, ptr %mixed_return

  ; captures(provenance) also reuses the original tag for the returned copy.
  %p3 = call ptr @identity_provenance(ptr %p1)
  %mixed_provenance = call ptr @mix_pointer(ptr %p1, ptr %p3)
  store i32 1, ptr %mixed_provenance

  ; A full-provenance return capture recovers the original tag as well.
  %p4 = call ptr @identity_ret_provenance(ptr %p1)
  %mixed_ret_provenance = call ptr @mix_pointer(ptr %p1, ptr %p4)
  store i32 2, ptr %mixed_ret_provenance

  ; The stored copy also keeps the same provenance identity.
  call void @captured_by_mem(ptr %p1)
  %p5 = load ptr, ptr @g
  %mixed_mem = call ptr @mix_pointer(ptr %p1, ptr %p5)
  store i32 3, ptr %mixed_mem

  ; captures(provenance) also keeps the stored copy's tag.
  call void @captured_by_mem_provenance(ptr %p1)
  %p6 = load ptr, ptr @g
  %mixed_mem_provenance = call ptr @mix_pointer(ptr %p1, ptr %p6)
  store i32 4, ptr %mixed_mem_provenance
  ret void
}
