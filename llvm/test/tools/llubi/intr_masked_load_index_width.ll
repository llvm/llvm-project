; RUN: llubi --verbose < %s 2>&1 | FileCheck %s

; Lane addresses wrap around the 32-bit index space, not the 64-bit pointer.
target datalayout = "p:64:64:64:32"

@a = global [4 x i32] [i32 0, i32 1, i32 2, i32 3]

define void @main() {
  %rev = getelementptr i32, ptr @a, i32 -3
  %load_rev = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 %rev, <4 x i1> <i1 false, i1 false, i1 false, i1 true>, <4 x i32> splat (i32 -1))
  ret void
}
; CHECK: Entering function: main
; CHECK-NEXT:   %rev = getelementptr i32, ptr @a, i32 -3 => ptr 0xFFFFFFFC [@a + 4294967284]
; CHECK-NEXT:   %load_rev = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 %rev, <4 x i1> <i1 false, i1 false, i1 false, i1 true>, <4 x i32> splat (i32 -1)) => { i32 -1, i32 -1, i32 -1, i32 0 }
; CHECK-NEXT:   ret void
; CHECK-NEXT: Exiting function: main
