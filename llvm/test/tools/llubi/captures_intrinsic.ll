; Test that capture attributes are applied to calls that do not create an
; interpreter frame, such as intrinsic and declaration calls.

define void @main() {
  %p = alloca i32
  store i32 0, ptr %p
  ; The call site declares captures(read_provenance), so the returned pointer
  ; is a derived copy with read-only provenance.
  %q = call ptr @llvm.ssa.copy.p0(ptr captures(read_provenance) %p)
  ; Reading through the read-only copy succeeds.
  %v = load i32, ptr %q
  ; Writing through the read-only copy is immediate UB.
  store i32 1, ptr %q
  ret void
}
