  %after_partial = load <8 x i32>, ptr @a, align 4

  ; The stride is signed.
  %end = getelementptr i32, ptr @a, i64 7
  call void @llvm.experimental.vp.strided.store(<4 x i32> <i32 10, i32 11, i32 12, i32 13>, ptr %end, i64 -4, <4 x i1> splat (i1 true), i32 4)
  %after_reverse = load <8 x i32>, ptr @a, align 4

  ; With a zero stride the lanes are stored in order, so the last one wins.
  %p1 = getelementptr i32, ptr @a, i64 1
  call void @llvm.experimental.vp.strided.store(<4 x i32> <i32 20, i32 21, i32 22, i32 23>, ptr %p1, i64 0, <4 x i1> splat (i1 true), i32 4)
  %after_splat = load <8 x i32>, ptr @a, align 4

  ; Lanes at or past %evl are disabled even if their mask lane is poison.
  call void @llvm.experimental.vp.strided.store(<4 x i32> splat (i32 30), ptr %end, i64 4, <4 x i1> <i1 true, i1 poison, i1 poison, i1 poison>, i32 1)
  %after_poison_tail = load <8 x i32>, ptr @a, align 4

  ; Disabled lanes are not accessed, so constant memory is fine.
  call void @llvm.experimental.vp.strided.store(<4 x i32> poison, ptr @c, i64 4, <4 x i1> splat (i1 true), i32 0)

  call void @llvm.experimental.vp.strided.store(<vscale x 2 x i32> splat (i32 40), ptr @a, i64 8, <vscale x 2 x i1> splat (i1 true), i32 3)
  %after_scalable = load <8 x i32>, ptr @a, align 4

  ; Lane 0 is stored to the base pointer even if the stride is poison.
  call void @llvm.experimental.vp.strided.store(<4 x i32> splat (i32 50), ptr @a, i64 poison, <4 x i1> splat (i1 true), i32 1)
  %after_poison_stride = load <8 x i32>, ptr @a, align 4

  ; Without an align attribute only the base pointer needs the ABI alignment of
  ; i32, so the other lanes may be misaligned.
  call void @llvm.experimental.vp.strided.store(<4 x i32> <i32 -1, i32 0, i32 -1, i32 0>, ptr @a, i64 2, <4 x i1> splat (i1 true), i32 2)
  %after_misaligned = load <8 x i32>, ptr @a, align 4
  ret void
}
