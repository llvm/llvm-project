@a = global [4 x i32] [i32 0, i32 1, i32 2, i32 3]
@b = global [2 x ptr] [ptr @a, ptr null]

define void @main() {
  %load = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 @a, <4 x i1> <i1 true, i1 false, i1 true, i1 false>, <4 x i32> <i32 -1, i32 -2, i32 -3, i32 poison>)
  %load_all = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 @a, <4 x i1> splat (i1 true), <4 x i32> poison)

  ; Only enabled lanes are accessed and need to be in bounds.
  %tail = getelementptr i32, ptr @a, i64 2
  %load_tail = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 %tail, <4 x i1> <i1 true, i1 true, i1 false, i1 false>, <4 x i32> splat (i32 -1))
  %load_none = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 poison, <4 x i1> zeroinitializer, <4 x i32> splat (i32 -1))
  %misaligned = getelementptr i32, ptr @a, i64 1
  %load_none_misaligned = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 8 %misaligned, <4 x i1> zeroinitializer, <4 x i32> splat (i32 -1))

  ; The address of masked-off lanes may wrap around the address space, as for
  ; a reversed vector access starting before the first element.
  %rev = getelementptr i32, ptr @a, i64 -3
  %load_rev = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr align 4 %rev, <4 x i1> <i1 false, i1 false, i1 false, i1 true>, <4 x i32> splat (i32 -1))

  %load_ptr = call <2 x ptr> @llvm.masked.load.v2p0.p0(ptr align 8 @b, <2 x i1> <i1 true, i1 false>, <2 x ptr> zeroinitializer)
  %ptr = extractelement <2 x ptr> %load_ptr, i64 0
  %deref = load i32, ptr %ptr

  %step = call <vscale x 2 x i32> @llvm.stepvector.nxv2i32()
  %mask = icmp ult <vscale x 2 x i32> %step, splat (i32 3)
  %load_scalable = call <vscale x 2 x i32> @llvm.masked.load.nxv2i32.p0(ptr align 4 @a, <vscale x 2 x i1> %mask, <vscale x 2 x i32> splat (i32 -1))
  ret void
}
