; RUN: not llubi --verbose < %s 2>&1 | FileCheck %s
; Test how capture restrictions compose across nested calls. The restrictions
; are applied to the whole provenance tree derived from an argument.

; g() captures(read_provenance) and returns its argument directly. Inside g the
; argument still has full provenance.
define ptr @g(ptr captures(read_provenance) %a) {
  ; %a has full provenance here.
  store i32 0, ptr %a
  ret ptr %a
}

; keep() captures(provenance) and returns g's result. It must not widen the
; read_provenance captured by g.
define ptr @keep(ptr captures(provenance) %a) {
  ; %a has full provenance here.
  store i32 0, ptr %a
  %r = call ptr @g(ptr %a)
  %v = load i32, ptr %r
  ret ptr %r
}

; recover_ret() captures the full provenance through its return value, but g
; already removed write access. Recovery must not add it back.
define ptr @recover_ret(ptr captures(ret: provenance) %a) {
  ; %a has full provenance here.
  store i32 0, ptr %a
  %r = call ptr @g(ptr %a)
  ret ptr %r
}

; narrow() captures(none) and returns g's result. Inside narrow, g's result is
; read-only and the load succeeds. When narrow returns, captures(none) narrows
; the whole subtree to nullary provenance.
define ptr @narrow(ptr captures(none) %a) {
  ; %a has full provenance here.
  store i32 0, ptr %a
  %r = call ptr @g(ptr %a)
  %v = load i32, ptr %r
  ret ptr %r
}

define void @main() {
  %p = alloca i32
  store i32 0, ptr %p
  ; keep() preserves g's read_provenance, so this load succeeds.
  %p_keep = call ptr @keep(ptr %p)
  %v1 = load i32, ptr %p_keep
  ; The returned pointer stays read-only because g removed write access.
  %p_recover = call ptr @recover_ret(ptr %p)
  %v2 = load i32, ptr %p_recover
  ; narrow() removes provenance from g's result, so this load is immediate UB.
  %p_narrow = call ptr @narrow(ptr %p)
  %v3 = load i32, ptr %p_narrow
  ret void
}
