; RUN: not llubi --verbose < %s 2>&1 | FileCheck %s
; Test that capture restrictions are propagated through memory to the whole
; provenance subtree derived from an argument.

@mem = global ptr null

; g() captures(read_provenance) and stores its argument into @mem. Inside g the
; argument still has full provenance.
define void @g(ptr captures(read_provenance) %a) {
  ; %a has full provenance here.
  store i32 0, ptr %a
  store ptr %a, ptr @mem
  ret void
}

; f() captures(none), calls g, and loads the copy stored in @mem. The load
; succeeds because the stored copy still has read_provenance. When f returns,
; captures(none) narrows the whole subtree, including the stored copy and the
; returned copy.
define ptr @f(ptr captures(none) %a) {
  ; %a has full provenance here.
  store i32 0, ptr %a
  call void @g(ptr %a)
  ; %res has only read_provenance.
  %res = load ptr, ptr @mem
  %v = load i32, ptr %res
  ret ptr %res
}

define void @main() {
  %p = alloca i32
  ; captures(none) on f removes provenance from the whole subtree, so this load
  ; is immediate UB.
  %p2 = call ptr @f(ptr %p)
  %v = load i32, ptr %p2
  ret void
}
