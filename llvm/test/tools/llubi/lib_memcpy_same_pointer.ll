; Unlike llvm.memcpy, the C memcpy also considers equal source and destination
; ranges to overlap, which is undefined behavior.

declare ptr @memcpy(ptr, ptr, i64)

define void @main() {
  %buf = alloca [4 x i8], align 1
  call ptr @memcpy(ptr %buf, ptr %buf, i64 2)
  ret void
}
