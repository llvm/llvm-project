; RUN: not llubi --verbose < %s 2>&1 | FileCheck %s

declare ptr @malloc(i64)
declare void @free(ptr)

; Make sure non-dereferencing operations on a freed pointer are well-defined.
define void @main() {
  %slot = alloca ptr
  %p = call ptr @malloc(i64 2)
  store ptr %p, ptr %slot
  call void @free(ptr %p)
  %q = load ptr, ptr %slot
  %r = getelementptr inbounds i8, ptr %q, i64 1
  %c = icmp eq ptr %r, %r
  call void @llvm.assume(i1 %c)
  ret void
}
