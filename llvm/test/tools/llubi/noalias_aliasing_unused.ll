; argument unused. LLVM noalias does not perform Rust's implicit retag reads,
; so identical arguments are allowed when only one is accessed, regardless
; of argument order. Protector removal must also succeed.

define void @write_first(ptr noalias %x, ptr noalias %y) {
  store i32 1, ptr %x
  ret void
}

define void @write_second(ptr noalias %x, ptr noalias %y) {
  store i32 2, ptr %y
  ret void
}

define void @main() {
  %a = alloca i32
  store i32 0, ptr %a
  %first = select i1 true, ptr @write_first, ptr null
