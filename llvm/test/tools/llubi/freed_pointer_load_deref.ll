; RUN: not llubi --verbose < %s 2>&1 | FileCheck %s

declare ptr @malloc(i64)
declare void @free(ptr)

; Make sure that dereferencing a pointer loaded from memory after free is UB.
define void @main() {
  %slot = alloca ptr
  %p = call ptr @malloc(i64 2)
  store ptr %p, ptr %slot
  call void @free(ptr %p)
  %q = load ptr, ptr %slot
  store i8 0, ptr %q
  ret void
}
