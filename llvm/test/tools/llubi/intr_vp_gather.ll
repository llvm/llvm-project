  %gather_none = call <4 x i32> @llvm.vp.gather(<4 x ptr> <ptr poison, ptr null, ptr poison, ptr null>, <4 x i1> splat (i1 true), i32 0)

  %step = call <vscale x 2 x i64> @llvm.stepvector()
  %ptrs_scalable = getelementptr i32, ptr @a, <vscale x 2 x i64> %step
  %gather_scalable = call <vscale x 2 x i32> @llvm.vp.gather(<vscale x 2 x ptr> %ptrs_scalable, <vscale x 2 x i1> splat (i1 true), i32 3)
  ret void
}
