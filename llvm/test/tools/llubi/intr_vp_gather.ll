@a = global [4 x i32] [i32 0, i32 1, i32 2, i32 3]

define void @main() {
  %ptrs = getelementptr i32, ptr @a, <4 x i64> <i64 3, i64 0, i64 2, i64 1>
  %gather_all = call <4 x i32> @llvm.vp.gather(<4 x ptr> %ptrs, <4 x i1> splat (i1 true), i32 4)
  %gather_evl = call <4 x i32> @llvm.vp.gather(<4 x ptr> %ptrs, <4 x i1> splat (i1 true), i32 2)
  %gather_mask = call <4 x i32> @llvm.vp.gather(<4 x ptr> %ptrs, <4 x i1> <i1 true, i1 false, i1 true, i1 true>, i32 3)

  ; Lanes at or past %evl are disabled even if their mask lane is poison, so
  ; their pointers may be poison, null, out of bounds or misaligned.
