; RUN: llubi --verbose --vscale=2 < %s 2>&1 | FileCheck %s

@a = global [4 x i32] [i32 0, i32 1, i32 2, i32 3], align 16
@c = constant [4 x i32] [i32 0, i32 1, i32 2, i32 3], align 16

define void @main() {
  call void @llvm.vp.store(<4 x i32> <i32 10, i32 11, i32 12, i32 13>, ptr @a, <4 x i1> <i1 true, i1 false, i1 true, i1 true>, i32 3)
  %after_partial = load <4 x i32>, ptr @a

  ; Lanes at or past %evl are disabled even if their mask lane is poison.
  call void @llvm.vp.store(<4 x i32> splat (i32 20), ptr @a, <4 x i1> <i1 true, i1 poison, i1 poison, i1 poison>, i32 1)
  %after_poison_tail = load <4 x i32>, ptr @a

  ; Disabled lanes are not accessed, so constant memory is fine.
  call void @llvm.vp.store(<4 x i32> poison, ptr @c, <4 x i1> splat (i1 true), i32 0)

  call void @llvm.vp.store(<vscale x 2 x i32> splat (i32 30), ptr @a, <vscale x 2 x i1> splat (i1 true), i32 3)
  %after_scalable = load <4 x i32>, ptr @a
  ret void
}
