; Adapted from Miri's tests/fail/both_borrows/aliasing_mut2.rs.
; Both arguments carry only noalias. The indirect call has no call-site
; attributes. The explicit read through one argument makes the later write
; through its sibling UB.

define void @read_write(ptr noalias %x, ptr noalias %y) {
  %v = load i32, ptr %x
  store i32 2, ptr %y
  ret void
}

define void @main() {
  %a = alloca i32
  store i32 0, ptr %a
  %fn = select i1 true, ptr @read_write, ptr null
  call void %fn(ptr %a, ptr %a)
  ret void
}
