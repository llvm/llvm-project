@a = global [4 x i32] [i32 0, i32 1, i32 2, i32 3], align 16

define void @main() {
  %load_all = call <4 x i32> @llvm.vp.load(ptr @a, <4 x i1> splat (i1 true), i32 4)
  %load_evl = call <4 x i32> @llvm.vp.load(ptr @a, <4 x i1> splat (i1 true), i32 2)
  %load_mask = call <4 x i32> @llvm.vp.load(ptr @a, <4 x i1> <i1 true, i1 false, i1 true, i1 true>, i32 3)
  %load_none = call <4 x i32> @llvm.vp.load(ptr poison, <4 x i1> splat (i1 true), i32 0)

  ; Lanes at or past %evl are disabled even if their mask lane is poison, as
  ; for a mask computed from the result of an earlier vp.load.
  %load_poison_tail = call <4 x i32> @llvm.vp.load(ptr @a, <4 x i1> <i1 true, i1 true, i1 poison, i1 poison>, i32 2)

  ; Only enabled lanes need to be in bounds. %tail isn't aligned to the ABI
  ; alignment of <4 x i32>, so it needs an explicit align.
  %tail = getelementptr i32, ptr @a, i64 2
  %load_tail = call <4 x i32> @llvm.vp.load(ptr align 4 %tail, <4 x i1> splat (i1 true), i32 2)

  ; Without an align attribute the pointer must have the ABI alignment of
  ; <4 x i32>, but only if a lane is enabled.
  %load_none_misaligned = call <4 x i32> @llvm.vp.load(ptr %tail, <4 x i1> splat (i1 true), i32 0)

  %load_scalable = call <vscale x 2 x i32> @llvm.vp.load(ptr @a, <vscale x 2 x i1> splat (i1 true), i32 3)
  ret void
}
