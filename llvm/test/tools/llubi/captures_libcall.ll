; RUN: llubi --verbose < %s 2>&1 | FileCheck %s
; Test that capture attributes are applied to calls that do not create an
; interpreter frame, such as intrinsic and declaration calls.

declare ptr @memcpy(ptr, ptr captures(none), i64)

define void @main() {
  %p = alloca i32
  store i32 0, ptr %p
  ; Make sure the returned pointer still have full provenance.
  %q = call ptr @memcpy(ptr %p, ptr %p, i64 0)
  %v = load i32, ptr %q
  store i32 1, ptr %q
  ret void
}
; CHECK: Entering function: main
