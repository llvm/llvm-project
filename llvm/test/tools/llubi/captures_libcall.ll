; CHECK-NEXT:   store i32 0, ptr %p, align 4
; CHECK-NEXT:   %q = call ptr @memcpy(ptr %p, ptr %p, i64 0) => ptr 0x8 [p]
; CHECK-NEXT:   %v = load i32, ptr %q, align 4 => i32 0
; CHECK-NEXT:   store i32 1, ptr %q, align 4
; CHECK-NEXT:   ret void
; CHECK-NEXT: Exiting function: main
