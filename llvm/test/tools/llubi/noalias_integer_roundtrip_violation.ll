; The first store is local to p even though it uses an integer round-trip.
; A later store through a foreign pointer must still violate noalias.
define void @roundtrip_bad(ptr noalias %p, ptr %raw) {
  %bits = ptrtoint ptr %p to i64
  %roundtrip = inttoptr i64 %bits to ptr
  store i32 1, ptr %roundtrip
  store i32 2, ptr %raw
  ret void
}

define void @main() {
  %a = alloca i32
  call void @roundtrip_bad(ptr %a, ptr %a)
  ret void
}
