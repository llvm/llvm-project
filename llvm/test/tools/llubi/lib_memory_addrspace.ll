; NOTE: Assertions have been autogenerated by utils/update_llubi_test_checks.py UTC_ARGS: --version 6
; RUN: llubi --verbose < %s 2>&1 | FileCheck %s

target datalayout = "e-p:8:8-p1:64:64"

declare ptr addrspace(1) @malloc(i8)
declare ptr addrspace(1) @calloc(i8, i8)
declare void @free(ptr addrspace(1))

define void @main() {
  %p = call ptr addrspace(1) @malloc(i8 8)
  %i = ptrtoaddr ptr addrspace(1) %p to i64
  %q = call ptr addrspace(1) @calloc(i8 4, i8 2)
  call void @free(ptr addrspace(1) %p)
  call void @free(ptr addrspace(1) %q)
  call void @free(ptr addrspace(1) null)
  ret void
}
; CHECK: Entering function: main
