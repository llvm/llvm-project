; CHECK-NEXT:   %i = ptrtoaddr ptr addrspace(1) %p to i64 => i64 16
; CHECK-NEXT:   %q = call ptr addrspace(1) @calloc(i8 4, i8 2) => ptr 0x20 [q]
; CHECK-NEXT:   call void @free(ptr addrspace(1) %p)
; CHECK-NEXT:   call void @free(ptr addrspace(1) %q)
; CHECK-NEXT:   call void @free(ptr addrspace(1) null)
; CHECK-NEXT:   ret void
