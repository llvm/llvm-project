; Inputs/messagetable.bin was generated with the following command, using
; binutils windmc:
;   $ x86_64-w64-mingw32-windmc -A t.mc && mv MSG00001.bin messagetable.bin
; The contents of t.mc follow, with CRLF line endings:
;   MessageId=1
;   Language=English
;   %1
;   .

; RUN: rm -rf %t
; RUN: mkdir %t
; RUN: cd %t
; RUN: cp %p/Inputs/messagetable.bin .
; RUN: llvm-rc -no-preprocess /FO %t/tag-messagetable.res -- %p/Inputs/tag-messagetable.rc
; RUN: llvm-readobj %t/tag-messagetable.res | FileCheck %s

