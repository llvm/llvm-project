# REQUIRES: zlib

# RUN: llvm-offload-binary -o %t --compress --compression-format=zlib --compression-level=9 --image=file=%s,arch=abc,triple=x-y-z
# RUN: llvm-offload-binary %t --image=file=%t.out,arch=abc,triple=x-y-z
# RUN: diff %s %t.out
# RUN: llvm-offload-binary -o %t.default --compress --compression-format=zlib --compression-level=-1 --image=file=%s,arch=abc,triple=x-y-z
# RUN: llvm-offload-binary %t.default --image=file=%t.default.out,arch=abc,triple=x-y-z
# RUN: diff %s %t.default.out
# RUN: not llvm-offload-binary -o %t.bad --compress --compression-format=zlib --compression-level=12 --image=file=%s,arch=abc,triple=x-y-z 2>&1 | FileCheck %s
# RUN: not llvm-offload-binary -o %t.low --compress --compression-format=zlib --compression-level=-2 --image=file=%s,arch=abc,triple=x-y-z 2>&1 | FileCheck %s --check-prefix=LOW

# CHECK: invalid zlib compression level 12; expected a value in [-1, 9]
# LOW: invalid zlib compression level -2; expected a value in [-1, 9]
