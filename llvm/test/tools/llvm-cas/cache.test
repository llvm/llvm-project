RUN: rm -rf %t %t.cas
RUN: mkdir %t

RUN: llvm-cas make-blob --cas %t.cas \
RUN:   --data /dev/null > %t/empty.casid
RUN: echo "abc" | \
RUN:   llvm-cas make-blob --cas %t.cas \
RUN:   --data - >%t/abc.casid

RUN: llvm-cas put-cache-key --cas %t/cas @%t/abc.casid @%t/empty.casid
RUN: llvm-cas get-cache-result --cas %t/cas @%t/abc.casid > %t/empty2.casid
RUN: diff %t/empty.casid %t/empty2.casid

RUN: not llvm-cas get-cache-result --cas %t/cas @%t/empty.casid
