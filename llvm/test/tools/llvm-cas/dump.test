RUN: rm -rf %t
RUN: mkdir %t

RUN: llvm-cas make-blob --cas %t/cas \
RUN:   --data - </dev/null

RUN: llvm-cas make-blob --cas %t/cas \
RUN:   --data %s

RUN: llvm-cas dump --cas %t/cas | FileCheck %s

// check the dump format.
CHECK:      index:
CHECK-NEXT: hash-num-bits=
CHECK-NEXT: root addr=
// it should has at least one index
CHECK-NEXT: - index=

// two records
CHECK:      record
CHECK-NEXT: - addr=
CHECK-NEXT: - addr=

// both should be small enough to be in data pool
CHECK:      pool:
CHECK-NEXT: - addr=
CHECK-NEXT: - addr=
