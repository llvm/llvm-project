RUN: rm -rf %t %t.cas
RUN: mkdir %t

RUN: llvm-cas make-blob --cas %t.cas \
RUN:   --data %S/Inputs/oneline >%t/oneline.casid
RUN: llvm-cas make-blob --cas %t.cas \
RUN:   --data %S/Inputs/oneline-nonewline >%t/oneline-nonewline.casid

RUN: llvm-cas put-cache-key --cas %t.cas @%t/oneline.casid @%t/oneline-nonewline.casid
RUN: llvm-cas get-cache-result --cas %t.cas @%t/oneline.casid > %t/result.casid
RUN: diff %t/oneline-nonewline.casid %t/result.casid

RUN: not llvm-cas get-cache-result --cas %t.cas @%t/oneline-nonewline.casid 2>&1 | FileCheck %s
CHECK: result not found
