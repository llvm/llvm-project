# Checks that validation is skipped once the data has been validated since boot,
# which requires the boot time to be known.
REQUIRES: cas-boot-time, plugins
# HWASan does not tag the globals of a dlopen'ed library with glibc, see
# https://github.com/llvm/llvm-project/issues/57206.
UNSUPPORTED: hwasan

RUN: rm -rf %t
RUN: mkdir %t

DEFINE: %{cas_plugin} = %llvmshlibdir/CASPluginTest%pluginext

RUN: echo "abc" | llvm-cas make-blob --cas %t/cas \
RUN:   --fcas-plugin-path %{cas_plugin} --data - > %t/abc.casid
RUN: llvm-cas make-node --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --data /dev/null @%t/abc.casid > %t/node.casid
RUN: llvm-cas put-cache-key --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   @%t/abc.casid @%t/node.casid

RUN: llvm-cas validate --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   | FileCheck %s --check-prefix=VALID
RUN: llvm-cas validate --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --check-hash | FileCheck %s --check-prefix=VALID

# Validate once per boot unless forced. The output of the validation process
# is forwarded.
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --check-hash | FileCheck %s --check-prefix=VALID
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --check-hash | FileCheck %s --check-prefix=SKIPPED
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --force | FileCheck %s --check-prefix=VALID
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --in-process | FileCheck %s --check-prefix=SKIPPED
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --in-process --force \
RUN:   | FileCheck %s --check-prefix=VALID

# Nothing to recover from.
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --force --allow-recovery \
RUN:   | FileCheck %s --check-prefix=VALID

# Plugin options are passed through.
RUN: not llvm-cas validate-if-needed --cas %t/cas \
RUN:   --fcas-plugin-path %{cas_plugin} --fcas-plugin-option bogus=1 2>&1 \
RUN:   | FileCheck %s --check-prefix=BAD-OPTION

RUN: rm %t/cas/v1.1/data.v1
RUN: not llvm-cas validate --cas %t/cas --fcas-plugin-path %{cas_plugin}
RUN: not llvm-cas validate-if-needed --cas %t/cas \
RUN:   --fcas-plugin-path %{cas_plugin} --force 2>&1 \
RUN:   | FileCheck %s --check-prefix=INVALID
RUN: not llvm-cas validate-if-needed --cas %t/cas \
RUN:   --fcas-plugin-path %{cas_plugin} --in-process --force 2>&1 \
RUN:   | FileCheck %s --check-prefix=INVALID
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   --force --allow-recovery \
RUN:   | FileCheck %s --check-prefix=RECOVERED
RUN: ls %t/cas | FileCheck %s --check-prefix=CORRUPT-DIR

# Recovery also counts as validation for this boot.
RUN: llvm-cas validate-if-needed --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   | FileCheck %s --check-prefix=SKIPPED

# The invalid data was discarded.
RUN: llvm-cas validate --cas %t/cas --fcas-plugin-path %{cas_plugin} \
RUN:   | FileCheck %s --check-prefix=VALID
RUN: not llvm-cas get-cache-result --cas %t/cas \
RUN:   --fcas-plugin-path %{cas_plugin} @%t/abc.casid \
RUN:   | FileCheck %s --check-prefix=NOT-FOUND

VALID: validated successfully
SKIPPED: validation skipped
BAD-OPTION: llvm-cas: validate-if-needed: unknown option: bogus
INVALID: llvm-cas: validate-if-needed:
RECOVERED: recovered from invalid data
CORRUPT-DIR: corrupt.0.v1.1
NOT-FOUND: result not found
