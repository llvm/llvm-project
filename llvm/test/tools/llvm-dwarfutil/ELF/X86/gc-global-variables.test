## Live variables in allocated non-executable sections must survive GC.

# RUN: yaml2obj %s -o %t
# RUN: llvm-dwarfdump --debug-info %t | FileCheck %s --check-prefix=INPUT
# RUN: llvm-dwarfutil %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=GC
# RUN: llvm-dwarfutil --linker=parallel %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=GC
# RUN: llvm-dwarfutil --tombstone=bfd %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=GC
# RUN: llvm-dwarfutil --tombstone=exec %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=GC
# RUN: llvm-dwarfdump --verify %t.out | FileCheck %s --check-prefix=VERIFY
# RUN: llvm-dwarfutil --no-garbage-collection %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=INPUT

# VERIFY: No errors.

# INPUT: DW_AT_name ("data")
# INPUT: DW_AT_name ("bss")
# INPUT: DW_AT_name ("rodata")
# INPUT: DW_AT_name ("dead")
# INPUT: DW_AT_name ("nonalloc")

# GC: DW_TAG_compile_unit
# GC: DW_TAG_variable
# GC: DW_AT_name ("data")
# GC: DW_AT_location (DW_OP_addr 0x2000)
# GC: DW_TAG_variable
# GC: DW_AT_name ("bss")
# GC: DW_AT_location (DW_OP_addr 0x3000)
# GC: DW_TAG_variable
# GC: DW_AT_name ("rodata")
# GC: DW_AT_location (DW_OP_addr 0x4000)
# GC-NOT: DW_TAG_variable
# GC: DW_TAG_subprogram
# GC: DW_AT_name ("main")
# GC-NOT: DW_TAG_variable
# GC-NOT: DW_TAG_subprogram

--- !ELF
FileHeader:
  Class: ELFCLASS64
  Data: ELFDATA2LSB
  Type: ET_EXEC
  Machine: EM_X86_64
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x1000
    Size: 0x10
  - Name: .data
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    Address: 0x2000
    Size: 4
  - Name: .bss
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    Address: 0x3000
    Size: 4
  - Name: .rodata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    Address: 0x4000
    Size: 4
  - Name: .nonalloc
    Type: SHT_PROGBITS
    Address: 0x5000
    Size: 4
DWARF:
  debug_abbrev:
    - Table:
        - Tag: DW_TAG_compile_unit
          Children: DW_CHILDREN_yes
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_low_pc
              Form: DW_FORM_addr
            - Attribute: DW_AT_high_pc
              Form: DW_FORM_data4
            - Attribute: DW_AT_addr_base
              Form: DW_FORM_sec_offset
        - Tag: DW_TAG_variable
          Children: DW_CHILDREN_no
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_location
              Form: DW_FORM_exprloc
        - Tag: DW_TAG_subprogram
          Children: DW_CHILDREN_no
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_low_pc
              Form: DW_FORM_addr
            - Attribute: DW_AT_high_pc
              Form: DW_FORM_data4
  debug_info:
    - Version: 5
      UnitType: DW_UT_compile
      Entries:
        - AbbrCode: 1
          Values:
            - CStr: globals.c
            - Value: 0x1000
            - Value: 0x10
            - Value: 8
        - AbbrCode: 2
          Values:
            - CStr: data
            - BlockData: [ 0x3, 0x0, 0x20, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
        - AbbrCode: 2
          Values:
            - CStr: bss
            - BlockData: [ 0xa1, 0x0 ]
        - AbbrCode: 2
          Values:
            - CStr: rodata
            - BlockData: [ 0x3, 0x0, 0x40, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
        - AbbrCode: 2
          Values:
            - CStr: dead
            - BlockData: [ 0xa1, 0x1 ]
        - AbbrCode: 2
          Values:
            - CStr: nonalloc
            - BlockData: [ 0x3, 0x0, 0x50, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0 ]
        - AbbrCode: 3
          Values:
            - CStr: main
            - Value: 0x1000
            - Value: 0x10
        ## A function address in .data must still be rejected.
        - AbbrCode: 3
          Values:
            - CStr: not_code
            - Value: 0x2000
            - Value: 4
        - AbbrCode: 0
  debug_addr:
    - Version: 5
      AddressSize: 8
      Entries:
        - Address: 0x3000
        - Address: 0
