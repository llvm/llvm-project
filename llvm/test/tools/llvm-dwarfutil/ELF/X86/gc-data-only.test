## A file with no CU code ranges can still contain live variables. Both direct
## and indexed locations must survive, while tombstoned variables are removed.

# RUN: yaml2obj %s -o %t
# RUN: llvm-dwarfutil %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s
# RUN: llvm-dwarfdump --verify %t.out | FileCheck %s --check-prefix=VERIFY
# RUN: llvm-dwarfutil --linker=parallel %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s
# RUN: llvm-dwarfutil --tombstone=bfd %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s
# RUN: llvm-dwarfutil --tombstone=exec %t %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s
# RUN: yaml2obj %s -DDEAD=0xffffffffffffffff -o %t.maxpc
# RUN: llvm-dwarfutil --tombstone=maxpc %t.maxpc %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s
# RUN: llvm-dwarfutil --linker=parallel --tombstone=maxpc %t.maxpc %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s

## Even with no live variables, per-DIE GC must still discard dead locations.
# RUN: yaml2obj %s -DDIRECT=0 -DINDEXED=0 -o %t.dead
# RUN: llvm-dwarfutil %t.dead %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=DEAD
# RUN: llvm-dwarfutil --linker=parallel %t.dead %t.out
# RUN: llvm-dwarfdump --debug-info %t.out | FileCheck %s --check-prefix=DEAD

# CHECK: DW_TAG_compile_unit
# CHECK: DW_TAG_variable
# CHECK: DW_AT_name ("data")
# CHECK: DW_AT_location (DW_OP_addr 0x2000)
# CHECK: DW_TAG_variable
# CHECK: DW_AT_name ("bss")
# CHECK: DW_AT_location (DW_OP_addr 0x3000)
# CHECK-NOT: DW_TAG_variable
# VERIFY: No errors.
# DEAD: .debug_info contents:
# DEAD-NOT: DW_TAG_variable

--- !ELF
FileHeader:
  Class: ELFCLASS64
  Data: ELFDATA2LSB
  Type: ET_DYN
  Machine: EM_X86_64
Sections:
  - Name: .data
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    Address: 0x2000
    Size: 4
  - Name: .bss
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    Address: 0x3000
    Size: 4
DWARF:
  debug_abbrev:
    - Table:
        - Tag: DW_TAG_compile_unit
          Children: DW_CHILDREN_yes
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_addr_base
              Form: DW_FORM_sec_offset
        - Tag: DW_TAG_variable
          Children: DW_CHILDREN_no
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_location
              Form: DW_FORM_exprloc
  debug_info:
    - Version: 5
      UnitType: DW_UT_compile
      Entries:
        - AbbrCode: 1
          Values:
            - CStr: data.c
            - Value: 8
        - AbbrCode: 2
          Values:
            - CStr: data
            - BlockData: [ 0x03, 0, '[[DIRECT=0x20]]', 0, 0, 0, 0, 0, 0 ]
        - AbbrCode: 2
          Values:
            - CStr: bss
            - BlockData: [ 0xa1, 0 ]
        - AbbrCode: 2
          Values:
            - CStr: dead
            - BlockData: [ 0xa1, 1 ]
        - AbbrCode: 0
  debug_addr:
    - Version: 5
      AddressSize: 8
      Entries:
        - Address: '[[INDEXED=0x3000]]'
        - Address: '[[DEAD=0]]'
