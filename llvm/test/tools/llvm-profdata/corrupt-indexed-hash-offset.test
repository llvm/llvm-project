## Test that an indexed profile with a corrupted hash table offset is rejected
## with a clean error instead of crashing the reader.

# printf does not produce the right bytes on Windows, and z/OS mangles output.
# UNSUPPORTED: system-windows, system-zos

# Indexed profile magic: \xff "lprofi" \x81
# RUN: printf '\377lprofi\201' > %t.profdata
# Version 4: profile summary is stored after the header.
# RUN: printf '\4\0\0\0\0\0\0\0' >> %t.profdata
# Unused field.
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# HashType = MD5.
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# HashOffset corrupted to 0x10000000000008f0, pointing far outside the buffer.
# RUN: printf '\360\10\0\0\0\0\0\20' >> %t.profdata
# A valid minimal summary: 6 summary fields, 0 cutoff entries.
# RUN: printf '\6\0\0\0\0\0\0\0' >> %t.profdata
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# The 6 summary fields, all zero.
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata
# RUN: printf '\0\0\0\0\0\0\0\0' >> %t.profdata

# RUN: not llvm-profdata show %t.profdata 2>&1 | FileCheck %s
# CHECK: malformed instrumentation profile data: corrupt hash table offset
