## Reject corrupt summary counts and truncated ordinary/CS summaries, while
## accepting additional summary fields for forward compatibility.
# RUN: split-file %s %t
# RUN: %python %t/generate.py %t
# RUN: not llvm-profdata show %t/fields-max.profdata 2>&1 | FileCheck %s --check-prefix=CORRUPT
# RUN: not llvm-profdata show %t/entries-max.profdata 2>&1 | FileCheck %s --check-prefix=CORRUPT
# RUN: not llvm-profdata show %t/fields-short.profdata 2>&1 | FileCheck %s --check-prefix=CORRUPT
# RUN: not llvm-profdata show %t/fields-missing.profdata 2>&1 | FileCheck %s --check-prefix=CORRUPT
# RUN: not llvm-profdata show %t/entries-missing.profdata 2>&1 | FileCheck %s --check-prefix=CORRUPT
# RUN: not llvm-profdata show %t/header-empty.profdata 2>&1 | FileCheck %s --check-prefix=TRUNCATED
# RUN: not llvm-profdata show %t/header-short.profdata 2>&1 | FileCheck %s --check-prefix=TRUNCATED
# RUN: not llvm-profdata show %t/cs-header-short.profdata 2>&1 | FileCheck %s --check-prefix=TRUNCATED
# RUN: not llvm-profdata show %t/cs-fields-max.profdata 2>&1 | FileCheck %s --check-prefix=CORRUPT
# RUN: llvm-profdata show %t/valid.profdata
# RUN: llvm-profdata show %t/extra-fields.profdata
# RUN: llvm-profdata show %t/valid-cs.profdata
# CORRUPT: malformed instrumentation profile data: corrupt profile summary
# TRUNCATED: truncated profile data: truncated profile summary

#--- generate.py
import pathlib
import struct
import sys

out = pathlib.Path(sys.argv[1])
def words(*values):
    return struct.pack("<" + "Q" * len(values), *values)

def write(name, summary, version=4):
    offset = 40 + len(summary)
    header = b"\xfflprofi\x81" + words(version, 0, 0, offset)
    # A valid empty hash table: one bucket, no entries, and a zero bucket offset.
    (out / (name + ".profdata")).write_bytes(header + summary + words(1, 0, 0))

valid = words(6, 0, *([0] * 6))
write("fields-max", words(2**64 - 1, 0))
write("entries-max", words(6, 2**64 - 1))
write("fields-short", words(5, 0, *([0] * 6)))
write("fields-missing", words(100, 0))
write("entries-missing", words(6, 100, *([0] * 6)))
write("valid", valid)
write("extra-fields", words(7, 0, *([0] * 7)))
write("valid-cs", valid + valid, 4 | (1 << 57))
write("cs-fields-max", valid + words(2**64 - 1, 0), 4 | (1 << 57))
# Do not append a hash table to these files: it could mask summary truncation.
for name, summary, version in [
    ("header-empty", b"", 4),
    ("header-short", words(6) + b"\0" * 7, 4),
    ("cs-header-short", valid + words(6) + b"\0" * 7, 4 | (1 << 57)),
]:
    header = b"\xfflprofi\x81" + words(version, 0, 0, 0)
    (out / (name + ".profdata")).write_bytes(header + summary)
