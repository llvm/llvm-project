; These fixtures were written as v105 composite ExtBinary profiles from
; sample-composite-empty-lbr.proftext, then edited once to encode the named
; malformed block shape. They remain binary because no writer API can produce
; these invalid payloads.

; Verify that composite payload readers cannot cross declared block boundaries.
; RUN: not llvm-profdata merge --sample \
; RUN:   %S/Inputs/composite-payload-undersized.profdata -o %t.undersized \
; RUN:   2>&1 | FileCheck %s --check-prefix=TRUNCATED
; RUN: not llvm-profdata merge --sample \
; RUN:   %S/Inputs/composite-payload-oversized.profdata -o %t.oversized \
; RUN:   2>&1 | FileCheck %s --check-prefix=UNCONSUMED

; Verify that duplicate type IDs are rejected instead of decoding and merging
; the same logical payload twice.
; RUN: not llvm-profdata merge --sample \
; RUN:   %S/Inputs/composite-duplicate-type.profdata -o %t.duplicate \
; RUN:   2>&1 | FileCheck %s --check-prefix=DUPLICATE

; Verify that an unknown block cannot declare a payload beyond its section and
; that inspection still reports the invalid declared size.
; RUN: not llvm-profdata merge --sample \
; RUN:   %S/Inputs/composite-unknown-oob.profdata -o %t.unknown-oob \
; RUN:   2>&1 | FileCheck %s --check-prefix=DECLARED-SIZE
; RUN: not llvm-profdata show --sample --show-composite-info-only \
; RUN:   %S/Inputs/composite-unknown-oob.profdata 2>&1 \
; RUN:   | FileCheck %s --check-prefix=INSPECT

; TRUNCATED: error: {{.*}}Truncated profile data
; UNCONSUMED: Profile type ID 0 did not consume its complete payload;
; UNCONSUMED-SAME: unread bytes: 1
; DUPLICATE: Duplicate profile type ID: 0
; DECLARED-SIZE: Profile type ID 127 declares payload size 18446744073709551615
; INSPECT: Type: 127 (unknown), Payload size: 18446744073709551615
