; Verify composite inspection for known nested LBR, unknown, and empty blocks,
; and verify that requesting it for a legacy profile produces a warning.
; RUN: llvm-profdata merge --sample --extbinary-composite-prof --sample-profile-format-version=105 --extbinary %S/Inputs/sample-flatten-profile.proftext -o %t.composite
; RUN: llvm-profdata show --sample --show-composite-info-only %t.composite | FileCheck %s --check-prefix=KNOWN

; KNOWN: Function: baz
; KNOWN-NEXT:   Profile blocks: 1
; KNOWN-NEXT:   Type: 0 (LBR), Payload size: {{[1-9][0-9]*}}
; KNOWN: Nested function: foo
; KNOWN-NEXT:   Profile blocks: 1
; KNOWN-NEXT:   Type: 0 (LBR), Payload size: {{[1-9][0-9]*}}

; Verify that the two structure-only display modes cannot be requested together.
; RUN: not llvm-profdata show --sample --show-sec-info-only --show-composite-info-only %t.composite 2>&1 | FileCheck %s --check-prefix=BOTH

; BOTH: error: -show-sec-info-only and -show-composite-info-only cannot be used together

; The unknown fixture was written from sample-composite-empty-lbr.proftext,
; then the first function's LBR block type was changed to 127.
; RUN: llvm-profdata show --sample --show-composite-info-only \
; RUN:   %S/Inputs/composite-unknown-top.profdata \
; RUN:   | FileCheck %s --check-prefix=UNKNOWN
; RUN: llvm-profdata merge --sample --text \
; RUN:   %S/Inputs/composite-unknown-top.profdata -o - \
; RUN:   | FileCheck %s --check-prefix=UNKNOWN-PROFILE

; UNKNOWN: Function: top
; UNKNOWN-NEXT:   Profile blocks: 1
; UNKNOWN-NEXT:   Type: 127 (unknown), Payload size: {{[1-9][0-9]*}}
; UNKNOWN-NEXT: Function: caller
; UNKNOWN-NEXT:   Profile blocks: 1
; UNKNOWN-NEXT:   Type: 0 (LBR), Payload size: {{[1-9][0-9]*}}
; UNKNOWN-NEXT: Nested function: callee
; UNKNOWN-NEXT:   Profile blocks: 1
; UNKNOWN-NEXT:   Type: 0 (LBR), Payload size: {{[1-9][0-9]*}}

; UNKNOWN-PROFILE: caller:21:3
; UNKNOWN-PROFILE-NEXT:  1: callee:11
; UNKNOWN-PROFILE-NEXT: top:0:0

; The empty fixture was written from the same profile, then its composite
; payload was removed and the section size was set to zero.
; RUN: llvm-profdata show --sample --show-composite-info-only \
; RUN:   %S/Inputs/composite-empty-section.profdata 2>&1 | count 0

; RUN: llvm-profdata merge --sample --extbinary %S/Inputs/sample-flatten-profile.proftext -o %t.legacy
; RUN: llvm-profdata show --sample --show-composite-info-only %t.legacy 2>&1 | FileCheck %s --check-prefix=LEGACY

; LEGACY: warning: no composite profile section; nothing to show
