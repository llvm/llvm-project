# REQUIRES: aarch64-registered-target

# RUN: split-file %s %t
# RUN: yaml2obj %t/binary.yaml -o %t/binary
# RUN: llvm-dwarfdump --verify %t/binary

## A and B have distinct live ranges and share the non-code DWARF range [0, 2).
## A is listed first, so it owns the range-start lookup at address zero. Only B
## is sampled. Expanding B's ranges must not expand their starts again and
## follow the non-code range into A's unrelated live code.
# RUN: llvm-profgen --binary=%t/binary --unsymbolized-profile=%t/basic.raw \
# RUN:   --use-offset=0 --format=text --profile-summary-cold-count=0 \
# RUN:   --output=%t/basic.prof
# RUN: FileCheck %s --match-full-lines --check-prefix=BASIC \
# RUN:   --implicit-check-not='A:' --input-file=%t/basic.prof

## LBR already expands its original sampled range only once.
# RUN: llvm-profgen --binary=%t/binary --unsymbolized-profile=%t/lbr.raw \
# RUN:   --use-offset=0 --format=text --profile-summary-cold-count=0 \
# RUN:   --output=%t/lbr.prof
# RUN: cmp %t/basic.prof %t/lbr.prof

## Keep B's positive sample and its unsampled location at zero. A must still
## receive zero samples when filling all functions is explicitly requested.
# RUN: llvm-profgen --binary=%t/binary --unsymbolized-profile=%t/basic.raw \
# RUN:   --use-offset=0 --format=text --profile-summary-cold-count=0 \
# RUN:   --fill-zero-for-all-funcs --output=%t/all.prof
# RUN: FileCheck %s --match-full-lines --check-prefix=ALL --input-file=%t/all.prof

# BASIC:      B:28:0
# BASIC-NEXT:  0: 7
# BASIC-NEXT:  1: 0
# BASIC-NOT:  {{.}}

# ALL:      B:28:0
# ALL-NEXT:  0: 7
# ALL-NEXT:  1: 0
# ALL-NEXT: A:0:0
# ALL-NEXT:  0: 0
# ALL-NEXT:  1: 0
# ALL-NOT:  {{.}}

#--- basic.raw
# llvm-profgen-content: basic-event
1
1008:7
#--- lbr.raw
1
1008-1008:7
0
#--- binary.yaml
--- !ELF
FileHeader:
  Class: ELFCLASS64
  Data: ELFDATA2LSB
  Type: ET_DYN
  Machine: EM_AARCH64
  Entry: 0x1000
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x1000
    Offset: 0x1000
    AddressAlign: 4
    Content: '1F2003D5C0035FD61F2003D5C0035FD6' # A: nop; ret. B: nop; ret.
ProgramHeaders:
  - Type: PT_LOAD
    Flags: [ PF_R, PF_X ]
    Offset: 0
    VAddr: 0
    FileSize: 0x1010
    MemSize: 0x1010
Symbols:
  - Name: A
    Type: STT_FUNC
    Section: .text
    Binding: STB_GLOBAL
    Value: 0x1000
    Size: 8
  - Name: B
    Type: STT_FUNC
    Section: .text
    Binding: STB_GLOBAL
    Value: 0x1008
    Size: 8
DWARF:
  debug_abbrev:
    - Table:
        - Code: 1
          Tag: DW_TAG_compile_unit
          Children: DW_CHILDREN_yes
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_stmt_list
              Form: DW_FORM_sec_offset
            - Attribute: DW_AT_low_pc
              Form: DW_FORM_addr
            - Attribute: DW_AT_high_pc
              Form: DW_FORM_data4
        - Code: 2
          Tag: DW_TAG_subprogram
          Children: DW_CHILDREN_no
          Attributes:
            - Attribute: DW_AT_name
              Form: DW_FORM_string
            - Attribute: DW_AT_ranges
              Form: DW_FORM_sec_offset
            - Attribute: DW_AT_decl_file
              Form: DW_FORM_data1
            - Attribute: DW_AT_decl_line
              Form: DW_FORM_data1
  debug_info:
    - Version: 4
      AddrSize: 8
      Entries:
        - AbbrCode: 1
          Values:
            - CStr: zero-fill.c
            - Value: 0
            - Value: 0
            - Value: 0x1010
        - AbbrCode: 2
          Values:
            - CStr: A
            - Value: 0
            - Value: 1
            - Value: 1
        - AbbrCode: 2
          Values:
            - CStr: B
            - Value: 0x30
            - Value: 1
            - Value: 3
        - AbbrCode: 0
  debug_ranges:
    - AddrSize: 8
      Entries:
        - LowOffset: 0
          HighOffset: 2
        - LowOffset: 0x1000
          HighOffset: 0x1008
    - AddrSize: 8
      Entries:
        - LowOffset: 0
          HighOffset: 2
        - LowOffset: 0x1008
          HighOffset: 0x1010
  debug_line:
    - Version: 4
      MinInstLength: 1
      MaxOpsPerInst: 1
      DefaultIsStmt: 1
      LineBase: 251
      LineRange: 14
      Files:
        - Name: zero-fill.c
          DirIdx: 0
          ModTime: 0
          Length: 0
      Opcodes:
        - Opcode: DW_LNS_extended_op
          SubOpcode: DW_LNE_set_address
          Data: 0x1000
        - Opcode: DW_LNS_copy
        - Opcode: DW_LNS_advance_pc
          Data: 4
        - Opcode: DW_LNS_advance_line
          SData: 1
        - Opcode: DW_LNS_copy
        - Opcode: DW_LNS_advance_pc
          Data: 4
        - Opcode: DW_LNS_advance_line
          SData: 1
        - Opcode: DW_LNS_copy
        - Opcode: DW_LNS_advance_pc
          Data: 4
        - Opcode: DW_LNS_advance_line
          SData: 1
        - Opcode: DW_LNS_copy
        - Opcode: DW_LNS_advance_pc
          Data: 4
        - Opcode: DW_LNS_extended_op
          SubOpcode: DW_LNE_end_sequence
