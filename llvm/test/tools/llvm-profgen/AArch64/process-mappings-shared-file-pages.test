PERF_RECORD_MMAP2 100/100: [0x4402000(0x1000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000001: 4402100 0x4402100/0x4402100/P/-/-/0

#--- older-continuation.perfscript
PERF_RECORD_MMAP2 100/100: [0x4403000(0x1000) @ 0x3000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4403100 0x4403100/0x4403100/P/-/-/0

#--- masked-underflow.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_AARCH64
  Entry:   0x800
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x800
    Offset:  0x3800
    Content: C0035FD6
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x3800
    VAddr:    0x800
    FileSize: 0x4
    MemSize:  0x4
    Align:    0x1000
    FirstSec: .text
    LastSec:  .text
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x1000
    VAddr:    0xffffffffffffe000
    FileSize: 0x1004
    MemSize:  0x1004
    Align:    0x1000
Symbols:
  - Name:    first
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value:   0x800
    Size:    0x4

#--- continuation.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_AARCH64
  Entry:   0x401100
Sections:
  - Name:         .text.first
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x401100
    Offset:       0x1100
    AddressAlign: 0x4
    Content:      C0035FD6
  - Name:         .text.first.tail
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x402100
    Offset:       0x2100
    AddressAlign: 0x4
    Content:      C0035FD6
  - Name:         .text.second
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      [[SECOND_ADDRESS=0x502800]]
    Offset:       0x2800
    AddressAlign: 0x4
    Content:      C0035FD6
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x1100
    VAddr:    0x401100
    FileSize: 0x1004
    MemSize:  0x1004
    Align:    0x1000
    FirstSec: .text.first
    LastSec:  .text.first.tail
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x2800
    VAddr:    [[SECOND_ADDRESS=0x502800]]
    FileSize: 0x4
    MemSize:  0x4
    Align:    0x1000
    FirstSec: .text.second
    LastSec:  .text.second
Symbols:
  - Name:    first
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text.first
    Value:   0x401100
    Size:    0x4
  - Name:    first_tail
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text.first.tail
    Value:   0x402100
    Size:    0x4
  - Name:    second
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text.second
    Value:   [[SECOND_ADDRESS=0x502800]]
    Size:    0x4

#--- aliases.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_AARCH64
  Entry:   0x401100
Sections:
  - Name:         .text.first
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x401100
    Offset:       0x1100
    AddressAlign: 0x4
    Content:      C0035FD6
  - Name:         .text.first.tail
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      [[TAIL_ADDRESS=0x402100]]
    Offset:       [[TAIL_OFFSET=0x2100]]
    AddressAlign: 0x4
    Content:      C0035FD6
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x1100
    VAddr:    0x401100
    FileSize: [[FIRST_SIZE=0x1004]]
    MemSize:  [[FIRST_SIZE=0x1004]]
    Align:    0x1000
    FirstSec: .text.first
    LastSec:  .text.first.tail
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   [[SECOND_OFFSET=0x1100]]
    VAddr:    [[SECOND_ADDRESS=0x501100]]
    FileSize: [[SECOND_SIZE=0x1004]]
    MemSize:  [[SECOND_SIZE=0x1004]]
    Align:    0x1000
Symbols:
  - Name:    first
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text.first
    Value:   0x401100
    Size:    0x4
  - Name:    first_tail
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text.first.tail
    Value:   [[TAIL_ADDRESS=0x402100]]
    Size:    0x4
