# REQUIRES: aarch64-registered-target

# RUN: split-file %s %t

## Two executable segment starts share a mapped file page but imply different
## relocation biases. Retain both disjoint executable portions.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/shared-starts.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/shared-starts.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=SHARED --input-file=%t/shared-starts.raw
# RUN: llvm-profgen --binary=%t/segments.exe --perfscript=%t/lbr.perfscript \
# RUN:   --skip-symbolization --use-offset=0 --output=%t/lbr.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=LBR --input-file=%t/lbr.raw

## Memory-only bytes must not extend the file-offset join into the second
## segment, whose different bias would make the overlap ambiguous.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DFIRST_MEM_SIZE=0x1000 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/shared-starts.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/file-backed.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=SHARED --input-file=%t/file-backed.raw

## Multiple starts are not themselves ambiguous: the same file/virtual bias
## maps both functions correctly, including in a single full-image mmap.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DSECOND_ADDRESS=0x401800 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/same-page.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/same-page.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=SAME-PAGE --input-file=%t/same-page.raw
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DSECOND_OFFSET=0x3100 \
# RUN:   -DSECOND_ADDRESS=0x403100 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/full-image.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/full-image.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=FULL-IMAGE --input-file=%t/full-image.raw

## The file/virtual bias can wrap while the canonical mmap address is valid:
## 0x1100 - 0x5100 == 0x1800 - 0x5800 == 0xffffffffffffc000.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DRO_ADDRESS=0 -DFIRST_OFFSET=0x5100 -DFIRST_ADDRESS=0x1100 \
# RUN:   -DSECOND_OFFSET=0x5800 -DSECOND_ADDRESS=0x1800 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/wrapped-bias.perfscript --skip-symbolization \
# RUN:   --output=%t/wrapped-bias.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=WRAPPED --input-file=%t/wrapped-bias.raw

## Padding before the executable bytes needs no canonical address.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DRO_ADDRESS=0 -DFIRST_ADDRESS=0x100 \
# RUN:   -DSECOND_ADDRESS=0x800 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/prefix-underflow.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/prefix.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=PREFIX --input-file=%t/prefix.raw

## A continuation must still have a representable canonical address.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DFIRST_ADDRESS=0xfffffffffffff100 \
# RUN:   -DFIRST_SIZE=0x2000 -DFIRST_MEM_SIZE=0x2000 -DSECOND_OFFSET=0x5800 \
# RUN:   -DSECOND_ADDRESS=0xfffffffffffff800 -o %t/segments.exe
# RUN: not llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/older-continuation.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/rejected.raw 2>&1 | FileCheck %s --check-prefix=INVALID-ADDRESS

## Segment starts and continuations may share a mmap without sharing its origin.
# RUN: yaml2obj %t/masked-underflow.yaml -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/masked-underflow.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/masked.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=MASKED --input-file=%t/masked.raw

## A preceding segment that ends at the mmap start is not a continuation.
## A later segment that starts at the mmap end is likewise not a candidate.
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DFIRST_SIZE=0xf00 -DFIRST_MEM_SIZE=0xf00 \
# RUN:   -DSECOND_OFFSET=0x2800 -DSECOND_ADDRESS=0x502800 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/ended-predecessor.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/ended.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=ENDED --input-file=%t/ended.raw
# RUN: yaml2obj %S/Inputs/process-mappings-shared-file-pages.yaml -DSECOND_OFFSET=0x2000 \
# RUN:   -DSECOND_ADDRESS=0x502000 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/first-only.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/after-end.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=FIRST --input-file=%t/after-end.raw

## The first segment continues onto file page 0x2000, where the second starts.
## Both disjoint portions remain usable with different relocation biases.
# RUN: yaml2obj %t/continuation.yaml -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/continued.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/disjoint-continued.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=DISJOINT-CONTINUED --input-file=%t/disjoint-continued.raw
# RUN: yaml2obj %t/continuation.yaml -DSECOND_ADDRESS=0x402800 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/same-continuation.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/continued.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=CONTINUED --input-file=%t/continued.raw

## Equal file offsets do not imply equal biases, at the segment start or in
## a continuation. Identical offsets with identical biases remain accepted.
# RUN: yaml2obj %t/aliases.yaml -o %t/segments.exe
# RUN: not llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/first-only.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/rejected.raw 2>&1 | FileCheck %s --check-prefix=AMBIGUOUS
# RUN: not llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/tail-only.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/rejected.raw 2>&1 | FileCheck %s --check-prefix=AMBIGUOUS
# RUN: yaml2obj %t/aliases.yaml -DSECOND_ADDRESS=0x401100 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/start-and-tail.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/aliases.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=ALIASES --input-file=%t/aliases.raw

## Do not mistake a nearer but expired segment for a continuation. Both
## headers begin before the mmap; only the first reaches file offset 0x3000.
# RUN: yaml2obj %t/aliases.yaml -DFIRST_SIZE=0x2004 -DTAIL_OFFSET=0x3100 \
# RUN:   -DTAIL_ADDRESS=0x403100 -DSECOND_OFFSET=0x2800 \
# RUN:   -DSECOND_ADDRESS=0x502800 -DSECOND_SIZE=0x4 -o %t/segments.exe
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/older-continuation.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/older.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=OLDER --input-file=%t/older.raw

## Two different predecessor offsets can both still cover the mmap start.
# RUN: yaml2obj %t/aliases.yaml -DFIRST_SIZE=0x2004 -DTAIL_OFFSET=0x3100 \
# RUN:   -DTAIL_ADDRESS=0x403100 -DSECOND_OFFSET=0x2100 \
# RUN:   -DSECOND_ADDRESS=0x502100 -DSECOND_SIZE=0x1004 -o %t/segments.exe
# RUN: not llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/older-continuation.perfscript --skip-symbolization \
# RUN:   --use-offset=0 --output=%t/rejected.raw 2>&1 | FileCheck %s --check-prefix=AMBIGUOUS

# AMBIGUOUS: error: Ambiguous perf script mmap load bias
# INVALID-ADDRESS: error: Invalid perf script mmap address

# LBR-NOT:  {{.}}
# LBR:      0
# LBR-NEXT: 1
# LBR-NEXT: 401100->401100:1
# LBR-NOT:  {{.}}

# SHARED-NOT:  {{.}}
# SHARED:      0
# SHARED-NEXT: 2
# SHARED-NEXT: 401100->401100:1
# SHARED-NEXT: 501800->501800:1
# SHARED-NOT:  {{.}}
# SAME-PAGE-NOT:  {{.}}
# SAME-PAGE:      0
# SAME-PAGE-NEXT: 2
# SAME-PAGE-NEXT: 401100->401100:1
# SAME-PAGE-NEXT: 401800->401800:1
# SAME-PAGE-NOT:  {{.}}
# FULL-IMAGE-NOT:  {{.}}
# FULL-IMAGE:      0
# FULL-IMAGE-NEXT: 2
# FULL-IMAGE-NEXT: 401100->401100:1
# FULL-IMAGE-NEXT: 403100->403100:1
# FULL-IMAGE-NOT:  {{.}}
# WRAPPED-NOT:  {{.}}
# WRAPPED:      0
# WRAPPED-NEXT: 2
# WRAPPED-NEXT: 5100->5100:1
# WRAPPED-NEXT: 5800->5800:1
# WRAPPED-NOT:  {{.}}
# PREFIX-NOT:  {{.}}
# PREFIX:      0
# PREFIX-NEXT: 1
# PREFIX-NEXT: 100->100:1
# PREFIX-NOT:  {{.}}
# MASKED-NOT:  {{.}}
# MASKED:      0
# MASKED-NEXT: 1
# MASKED-NEXT: 800->800:1
# MASKED-NOT:  {{.}}
# ENDED-NOT:  {{.}}
# ENDED:      0
# ENDED-NEXT: 1
# ENDED-NEXT: 502800->502800:1
# ENDED-NOT:  {{.}}
# FIRST-NOT:  {{.}}
# FIRST:      0
# FIRST-NEXT: 1
# FIRST-NEXT: 401100->401100:1
# FIRST-NOT:  {{.}}
# DISJOINT-CONTINUED-NOT:  {{.}}
# DISJOINT-CONTINUED:      0
# DISJOINT-CONTINUED-NEXT: 2
# DISJOINT-CONTINUED-NEXT: 402100->402100:1
# DISJOINT-CONTINUED-NEXT: 502800->502800:1
# DISJOINT-CONTINUED-NOT:  {{.}}
# CONTINUED-NOT:  {{.}}
# CONTINUED:      0
# CONTINUED-NEXT: 2
# CONTINUED-NEXT: 402100->402100:1
# CONTINUED-NEXT: 402800->402800:1
# CONTINUED-NOT:  {{.}}
# ALIASES-NOT:  {{.}}
# ALIASES:      0
# ALIASES-NEXT: 2
# ALIASES-NEXT: 401100->401100:1
# ALIASES-NEXT: 402100->402100:1
# ALIASES-NOT:  {{.}}
# OLDER-NOT:  {{.}}
# OLDER:      0
# OLDER-NEXT: 1
# OLDER-NEXT: 403100->403100:1
# OLDER-NOT:  {{.}}

#--- shared-starts.perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0x1000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4401100 0x4401100/0x4401100/P/-/-/0
PERF_RECORD_MMAP2 100/100: [0x4501000(0x1000) @ 0x1000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000001: 4501800 0x4501800/0x4501800/P/-/-/0

#--- same-page.perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0x1000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4401100 0x4401100/0x4401100/P/-/-/0
100 1.000001: 4401800 0x4401800/0x4401800/P/-/-/0

#--- lbr.perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0x1000 00:1d 1 1]: r-xp /tmp/segments.exe
4401100 0x4401100/0x4401100/P/-/-/0

#--- full-image.perfscript
PERF_RECORD_MMAP2 100/100: [0x4400000(0x4000) @ 0 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4401100 0x4401100/0x4401100/P/-/-/0
100 1.000001: 4403100 0x4403100/0x4403100/P/-/-/0

#--- wrapped-bias.perfscript
PERF_RECORD_MMAP2 100/100: [0x500000(0x2000) @ 0x4000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 501100 0x501100/0x501100/P/-/-/0
100 1.000001: 501800 0x501800/0x501800/P/-/-/0

#--- ended-predecessor.perfscript
PERF_RECORD_MMAP2 100/100: [0x4502000(0x1000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4502800 0x4502800/0x4502800/P/-/-/0

#--- prefix-underflow.perfscript
PERF_RECORD_MMAP2 100/100: [0x500000(0x2000) @ 0 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 501100 0x501100/0x501100/P/-/-/0

#--- masked-underflow.perfscript
PERF_RECORD_MMAP2 100/100: [0x500000(0x2000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 501800 0x501800/0x501800/P/-/-/0

#--- first-only.perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0x1000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4401100 0x4401100/0x4401100/P/-/-/0

#--- continued.perfscript
PERF_RECORD_MMAP2 100/100: [0x4402000(0x1000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4402100 0x4402100/0x4402100/P/-/-/0
PERF_RECORD_MMAP2 100/100: [0x4502000(0x1000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000001: 4502800 0x4502800/0x4502800/P/-/-/0

#--- same-continuation.perfscript
PERF_RECORD_MMAP2 100/100: [0x4402000(0x1000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4402100 0x4402100/0x4402100/P/-/-/0
100 1.000001: 4402800 0x4402800/0x4402800/P/-/-/0

#--- tail-only.perfscript
PERF_RECORD_MMAP2 100/100: [0x4402000(0x1000) @ 0x2000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4402100 0x4402100/0x4402100/P/-/-/0

#--- start-and-tail.perfscript
