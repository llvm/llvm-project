# REQUIRES: aarch64-registered-target

# RUN: split-file %s %t
# RUN: yaml2obj %S/Inputs/process-mappings-segment-order.yaml -o %t/segments.exe
# RUN: llvm-readobj --program-headers %t/segments.exe | FileCheck %s --check-prefix=HEADERS
# RUN: llvm-objdump -d %t/segments.exe | FileCheck %s --check-prefix=INSTRUCTIONS

## Executable headers follow virtual-address order, while their file offsets
## are reversed. Samples exercise an exact segment start (0x5000), a page-aligned
## prefix (0x1000 before the segment at 0x1120), and a mid-segment map (0x6000).
## Every runtime address uses the same relocation of 0x4000000.
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/absolute.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=ABSOLUTE --input-file=%t/absolute.raw

## Default offsets retain the base from the first executable header:
## 0x401000 - 0x5000 = 0x3fc000.
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/perfscript --skip-symbolization --output=%t/default.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=DEFAULT --input-file=%t/default.raw

## The first loadable header supplies a distinct base of 0x400000.
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/perfscript --skip-symbolization \
# RUN:   --use-first-loadable-segment-as-base --output=%t/loadable.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=LOADABLE --input-file=%t/loadable.raw

## Mapping file offset zero as executable replaces the first page, whose code
## came from file offset 0x5000. The second page, another PID and a child forked
## before replacement retain their mappings. A later child inherits the
## replacement, and a subsequent mapping of 0x5000 restores the first page.
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/remap.perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/remap.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=REMAP --input-file=%t/remap.raw
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe --pid=100 \
# RUN:   --perfscript=%t/remap.perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/remap-pid.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=REMAP-PID --input-file=%t/remap-pid.raw
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe --pid=400 \
# RUN:   --perfscript=%t/remap.perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/remap-child.raw
# RUN: FileCheck %s --match-full-lines --check-prefix=REMAP-CHILD --input-file=%t/remap-child.raw

## Mapping executable file bytes read-only also replaces the first page.
## The second page, other PID and earlier child retain their translations.
# RUN: sed 's/@ 0 00:1d 1 1]: r-xp/@ 0x5000 00:1d 1 1]: r--p/' %t/remap.perfscript > %t/readonly.perfscript
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/readonly.perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/readonly.raw
# RUN: cmp %t/remap.raw %t/readonly.raw
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe --pid=100 \
# RUN:   --perfscript=%t/readonly.perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/readonly-pid.raw
# RUN: cmp %t/remap-pid.raw %t/readonly-pid.raw
# RUN: llvm-profgen --per-process-mappings --binary=%t/segments.exe --pid=400 \
# RUN:   --perfscript=%t/readonly.perfscript --skip-symbolization --use-offset=0 \
# RUN:   --output=%t/readonly-child.raw
# RUN: cmp %t/remap-child.raw %t/readonly-child.raw

## An mmap outside executable ELF segments cannot establish usable target
## ownership, including when its process forks.
# RUN: not llvm-profgen --per-process-mappings --binary=%t/segments.exe \
# RUN:   --perfscript=%t/unresolved.perfscript --skip-symbolization \
# RUN:   --output=%t/unused 2>&1 | FileCheck %s --check-prefix=NO-MAPPING
# RUN: not llvm-profgen --per-process-mappings --binary=%t/segments.exe --pid=200 \
# RUN:   --perfscript=%t/unresolved.perfscript --skip-symbolization \
# RUN:   --output=%t/unused 2>&1 | FileCheck %s --check-prefix=NO-MAPPING

# HEADERS:      Offset: 0x0
# HEADERS-NEXT: VirtualAddress: 0x400000
# HEADERS:      Offset: 0x5000
# HEADERS-NEXT: VirtualAddress: 0x401000
# HEADERS:      FileSize: 4100
# HEADERS-NEXT: MemSize: 4100
# HEADERS:      Offset: 0x1120
# HEADERS-NEXT: VirtualAddress: 0x501120

# INSTRUCTIONS: 501120: d65f03c0{{.*}}ret
# INSTRUCTIONS: 401000: d65f03c0{{.*}}ret
# INSTRUCTIONS: 402000: d65f03c0{{.*}}ret

# ABSOLUTE-NOT:  {{.}}
# ABSOLUTE:      0
# ABSOLUTE-NEXT: 3
# ABSOLUTE-NEXT: 401000->401000:1
# ABSOLUTE-NEXT: 402000->402000:1
# ABSOLUTE-NEXT: 501120->501120:1
# ABSOLUTE-NOT:  {{.}}

# DEFAULT-NOT:  {{.}}
# DEFAULT:      0
# DEFAULT-NEXT: 3
# DEFAULT-NEXT: 5000->5000:1
# DEFAULT-NEXT: 6000->6000:1
# DEFAULT-NEXT: 105120->105120:1
# DEFAULT-NOT:  {{.}}

# LOADABLE-NOT:  {{.}}
# LOADABLE:      0
# LOADABLE-NEXT: 3
# LOADABLE-NEXT: 1000->1000:1
# LOADABLE-NEXT: 2000->2000:1
# LOADABLE-NEXT: 101120->101120:1
# LOADABLE-NOT:  {{.}}

# REMAP-NOT:  {{.}}
# REMAP:      0
# REMAP-NEXT: 2
# REMAP-NEXT: 401000->401000:4
# REMAP-NEXT: 402000->402000:3
# REMAP-NOT:  {{.}}

# REMAP-PID-NOT:  {{.}}
# REMAP-PID:      0
# REMAP-PID-NEXT: 2
# REMAP-PID-NEXT: 401000->401000:2
# REMAP-PID-NEXT: 402000->402000:2
# REMAP-PID-NOT:  {{.}}

# REMAP-CHILD-NOT:  {{.}}
# REMAP-CHILD:      0
# REMAP-CHILD-NEXT: 1
# REMAP-CHILD-NEXT: 402000->402000:1
# REMAP-CHILD-NOT:  {{.}}

# NO-MAPPING: Invalid perf script input: no usable mmap

#--- perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0x5000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: 4401000 0x4401000/0x4401000/P/-/-/0
PERF_RECORD_MMAP2 100/100: [0x4501000(0x1000) @ 0x1000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000001: 4501120 0x4501120/0x4501120/P/-/-/0
PERF_RECORD_MMAP2 100/100: [0x4402000(0x1000) @ 0x6000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000002: 4402000 0x4402000/0x4402000/P/-/-/0

#--- remap.perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x2000) @ 0x5000 00:1d 1 1]: r-xp /tmp/segments.exe
PERF_RECORD_MMAP2 200/200: [0x4401000(0x2000) @ 0x5000 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000000: PERF_RECORD_FORK(300:300):(100:100)
100 1.000001: 4401000 0x4401000/0x4401000/P/-/-/0
100 1.000002: 4402000 0x4402000/0x4402000/P/-/-/0
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/segments.exe
100 1.000003: 4401000 0x4401000/0x4401000/P/-/-/0
100 1.000004: 4402000 0x4402000/0x4402000/P/-/-/0
200 1.000005: 4401000 0x4401000/0x4401000/P/-/-/0
300 1.000006: 4401000 0x4401000/0x4401000/P/-/-/0
100 2.000000: PERF_RECORD_FORK(400:400):(100:100)
400 2.000001: 4401000 0x4401000/0x4401000/P/-/-/0
400 2.000002: 4402000 0x4402000/0x4402000/P/-/-/0
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0x5000 00:1d 1 1]: r-xp /tmp/segments.exe
100 2.000003: 4401000 0x4401000/0x4401000/P/-/-/0

#--- unresolved.perfscript
PERF_RECORD_MMAP2 100/100: [0x4401000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/segments.exe
100 0.999999: 4401000 0x4401000/0x4401000/P/-/-/0
100 1.000000: PERF_RECORD_FORK(200:200):(100:100)
200 1.000001: 4401000 0x4401000/0x4401000/P/-/-/0
