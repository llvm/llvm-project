# REQUIRES: aarch64-registered-target
# DEFINE: %{raw} = llvm-profgen --skip-symbolization --binary=%t/main
# DEFINE: %{check} = FileCheck %s --match-full-lines

# RUN: split-file %s %t
# RUN: yaml2obj %t/binary.yaml -o %t/main
# RUN: %{raw} -ps %t/lbr -o %t/lbr.raw 2>%t/lbr.err
# RUN: cat %t/lbr.raw %t/lbr.err | %{check} --check-prefixes=RANGES,WARN,COMPARE
# RUN: llvm-profgen --binary=%t/main -ps %t/lbr --format=text -o %t/lbr.text
# RUN: %{check} --check-prefix=LBR-TEXT --input-file=%t/lbr.text
# RUN: yaml2obj -DZERO=C0035FD6 -DLAST=1F2003D5 %t/binary.yaml -o %t/ret
# RUN: llvm-profgen --skip-symbolization --binary=%t/ret -ps %t/ends -o %t/ret.profile
# RUN: %{check} --check-prefix=ZERO --input-file=%t/ret.profile
# RUN: %{raw} -ps %t/ends -o %t/end.profile 2>&1 | %{check} --check-prefix=ENDS
# RUN: llvm-objcopy --strip-debug %t/main %t/stripped
# RUN: llvm-profgen --skip-symbolization --binary=%t/stripped -ps %t/ends -o %t/uncovered 2>%t/uncovered.err
# RUN: cat %t/uncovered %t/uncovered.err | %{check} --check-prefix=UNCOVERED
# RUN: %{raw} -ps %t/hybrid -o %t/cs
# RUN: %{check} --check-prefix=CS --input-file=%t/cs \
# RUN:   --implicit-check-not='{{(1000|1018|102[48]|1044|1200|200[08]|2010)-[0-9a-f]+:}}'
# RUN: llvm-profgen --binary=%t/main -ps %t/hybrid --format=text \
# RUN:   --profile-summary-cold-count=0 --csspgo-preinliner=0 --gen-cs-nested-profile=0 -o %t/text
# RUN: %{check} --check-prefix=TEXT --input-file=%t/text
# RUN: %{raw} -ps %t/hybrid --ignore-stack-samples -o %t/ignored
# RUN: %{check} --check-prefix=IGNORE --implicit-check-not='[' --input-file=%t/ignored
# RUN: %{raw} -ps %t/single -o %t/single.profile 2>%t/single.err
# RUN: cat %t/single.profile %t/single.err | %{check} --check-prefix=SINGLE
# RUN: llvm-profgen --binary=%t/main --show-disassembly-only -o %t/unused 2>%t/disasm.err
# RUN: %{check} --check-prefix=DISASM --allow-empty --input-file=%t/disasm.err

## Static ranges include their ending instruction; identical leaves add weights.
# RANGES: 29
# RANGES: 0-4:1
# RANGES-NEXT: 100-100:5
# RANGES: 108-108:1
# RANGES-NEXT: 110-110:3
# RANGES-NEXT: 110-11c:3
# RANGES-NEXT: 118-118:1
# RANGES-COUNT-3: [[S:1[234]]]0-[[S]]0:1
# RANGES-NEXT: 150-150:2
# RANGES-COUNT-2: [[S:1[67]]]0-[[S]]0:1
# RANGES: 174-174:1
# RANGES: 180-180:1
# RANGES: 184-184:1
# RANGES: 190-194:1
# RANGES: 198-198:1
# RANGES: 34
# RANGES-COUNT-10: 1->{{1[0-9]0:[123]}}
# RANGES-COUNT-10: [[B:1[0-9]]]c->[[B]]0:{{[123]}}
# LBR-TEXT: low:12:2
# LBR-TEXT-NEXT: 0: 2 low:1
## The recorded range [0x1000, 0x1000] ends before the BRK at 0x1004.
# WARN: warning: 4.76%(1/21) of samples are from ranges that do not belong to any functions.
# WARN-NEXT: warning: 19.05%(4/21) of samples are from ranges that do cross function boundaries.
# COMPARE: LBR ranges shorter than the inferred range: 1
# ZERO: 0-0:1
# ZERO: 2000-2010:3
# ENDS: LBR ranges shorter than the inferred range: 3
# UNCOVERED: 2000-2000:3
# UNCOVERED-NOT: LBR ranges shorter than the inferred range
## Leaf ranges use the sampled caller context, as ordinary dynamic ranges do.
# CS-LABEL: []
# CS: 2000-2010:1
# CS-LABEL: [A:0 @ low]
# CS-NEXT: 2
# CS-NEXT: 1030-1030:1
# CS-NEXT: 1200-1210:1
# CS-LABEL: [A:1 @ low]
# CS: 1018-101c:1
# CS-NEXT: 1024-102c:1
# CS-NEXT: 1028-102c:1
# CS-LABEL: [A:1 @ low:16 @ low]
# CS-NEXT: 1
# CS-NEXT: 1000-1004:1
# CS-LABEL: [A:1 @ low:5 @ high]
# CS: 2000-2010:1
# CS-LABEL: [low]
# CS: 1010-1010:3
# CS-NEXT: 1044-1048:3
# CS-LABEL: [low:14 @ high]
# CS: 2000-2010:1
# CS-NEXT: 2008-2010:1
# CS-LABEL: [low:2 @ A:2 @ high]
# CS: 2000-2010:1
# CS-LABEL: [low:3 @ high]
# CS: 2010-2010:3
# TEXT: [low:14 @ high]:8:0
# TEXT: [A:1 @ low]:7:1
# TEXT: 9: 1
# TEXT-NEXT: 10: 2
# TEXT-NEXT: 11: 2
# TEXT: [low:2 @ A:2 @ high]:5:1
# TEXT: [high]:0:2
# IGNORE: 1044-1048:3
# SINGLE: 1000-1004:1
# SINGLE-NOT: LBR ranges shorter than the inferred range
# DISASM-NOT: LBR ranges shorter than the inferred range

#--- lbr
100 0x10c/0x100/P/-/-/0 0x9000/0x100/P/-/-/0
3
