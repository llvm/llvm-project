#--- binary.yaml
--- !ELF
FileHeader: { Class: ELFCLASS64, Data: ELFDATA2LSB, Type: ET_DYN, Machine: EM_AARCH64 }
Sections:
  ## The symbol starts at uncovered 0xfc; check coverage per instruction.
  ## CBZ also has CBZ/BRK; FFFFFFFF after UDF is a code gap; ISB continues in the next section.
  - { Name: .text.matrix, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0xfc, Offset: 0xfc, Content: "1F2003D5000000B4000000B4000020D4C0035FD6010000D41F2003D51F2003D5C0035FD6000000141F2003D51F2003D5C0035FD6C0035FD61F2003D5\
        1F2003D5C0035FD6010000941F2003D51F2003D5C0035FD60004E0D41F2003D51F2003D5C0035FD6E003FFD61F2003D51F2003D5C0035FD6\
        000000001F2003D5FFFFFFFFC0035FD6000040D41F2003D51F2003D5C0035FD6DF3F03D5" }
  - { Name: .text.matrix2, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x194, Offset: 0x194, Content: "000000B41F2003D5C0035FD6" }
  ## Place code at virtual address zero without overwriting the ELF headers.
  - { Name: .text.zero, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x0, Offset: 0x800, Content: "[[ZERO=1F2003D5]]C0035FD6" }
  ## low calls A, high, an interior label, its cold range, PLT, itself and unknown.
  - { Name: .text.low, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x1000, Offset: 0x1000, Content: "1F2003D5000020D43E000094010400940D000014FB0300941F2003D502000094020000141F2003D51F2003D5C0035FD6740000941F2003D5\
        F20700941F2003D5F0FFFF971F2003D5AE000094C0035FD6" }
  - { Name: .text.A, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x1100, Offset: 0x1100, Content: "CCFFFF97BFFFFF97BE0300941F2003D5C0035FD6" }
  - { Name: .text.cold, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x1200, Offset: 0x1200, Content: "1F2003D51F2003D51F2003D51F2003D5C0035FD6" }
  - { Name: .text.unknown, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x1300, Offset: 0x1300, Content: "1F2003D51F2003D53E0300941F2003D5C0035FD6" }
  - { Name: .text.high, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x2000, Offset: 0x2000, Content: "1F2003D51F2003D51F2003D51F2003D5[[LAST=C0035FD6]]" }
  - { Name: .plt, Type: SHT_PROGBITS, Flags: [ SHF_ALLOC, SHF_EXECINSTR ],
      Address: 0x3000, Offset: 0x3000, Content: "00021FD6" }
  ## Reverse section order to exercise address ordering.
  - Type: SectionHeaderTable
    Sections: [{ Name: .plt }, { Name: .text.high }, { Name: .text.unknown }, { Name: .text.cold },
        { Name: .text.A }, { Name: .text.low }, { Name: .text.matrix2 }, { Name: .text.matrix },
        { Name: .text.zero }, { Name: .debug_line }, { Name: .debug_abbrev }, { Name: .debug_info },
        { Name: .debug_ranges }, { Name: .symtab }, { Name: .strtab }, { Name: .shstrtab }]
ProgramHeaders:
  - { Type: PT_LOAD, Flags: [ PF_X, PF_R ], Offset: 0, VAddr: 0, FileSize: 0x3004, MemSize: 0x4000 }
## yaml2obj removes " (entry2)" from emitted symbol names.
Symbols:
  - { Name: zero, Type: STT_FUNC, Section: .text.zero, Value: 0x0, Size: 0x8 }
  - { Name: cases, Type: STT_FUNC, Section: .text.matrix, Value: 0xfc, Size: 0x98 }
  - { Name: matrix_label, Type: STT_NOTYPE, Section: .text.matrix2, Value: 0x194, Size: 0x4 }
  - { Name: cases (entry2), Type: STT_FUNC, Section: .text.matrix2, Value: 0x198, Size: 0x4 }
  - { Name: other, Type: STT_FUNC, Section: .text.matrix2, Value: 0x19c, Size: 0x4 }
  - { Name: low, Type: STT_FUNC, Section: .text.low, Value: 0x1000, Size: 0x50 }
  - { Name: low (entry2), Type: STT_FUNC, Section: .text.low, Value: 0x1030, Size: 0x20 }
  - { Name: A, Type: STT_FUNC, Section: .text.A, Value: 0x1100, Size: 0x14 }
  - { Name: cold_label, Type: STT_NOTYPE, Section: .text.cold, Value: 0x1200, Size: 0x14 }
  - { Name: unknown, Type: STT_FUNC, Section: .text.unknown, Value: 0x1300, Size: 0x14 }
  - { Name: high, Type: STT_FUNC, Section: .text.high, Value: 0x2000, Size: 0x14 }
DWARF:
  debug_abbrev:
    - Table:
        - { Code: 1, Tag: DW_TAG_compile_unit, Children: DW_CHILDREN_yes, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_stmt_list, Form: DW_FORM_sec_offset },
            { Attribute: DW_AT_low_pc, Form: DW_FORM_addr }, { Attribute: DW_AT_high_pc, Form: DW_FORM_data8 }] }
        - { Code: 2, Tag: DW_TAG_subprogram, Children: DW_CHILDREN_no, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_low_pc, Form: DW_FORM_addr },
            { Attribute: DW_AT_high_pc, Form: DW_FORM_data8 }, { Attribute: DW_AT_decl_line, Form: DW_FORM_data1 }] }
        - { Code: 3, Tag: DW_TAG_subprogram, Children: DW_CHILDREN_no, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_low_pc, Form: DW_FORM_addr },
            { Attribute: DW_AT_ranges, Form: DW_FORM_sec_offset }, { Attribute: DW_AT_decl_line, Form: DW_FORM_data1 }] }
  debug_info:
    - Version: 4
      Entries:
        - { AbbrCode: 1, Values: [{ CStr: ranges.c }, { Value: 0 }, { Value: 0 }, { Value: 0x2014 }] }
        - { AbbrCode: 2, Values: [{ CStr: zero }, { Value: 0x0 }, { Value: 0x8 }, { Value: 1 }] }
        - { AbbrCode: 3, Values: [{ CStr: cases }, { Value: 0x0 }, { Value: 0x40 }, { Value: 1 }] }
        - { AbbrCode: 2, Values: [{ CStr: other }, { Value: 0x19c }, { Value: 0x4 }, { Value: 1 }] }
        - { AbbrCode: 3, Values: [{ CStr: low }, { Value: 0x0 }, { Value: 0x0 }, { Value: 10 }] }
        - { AbbrCode: 2, Values: [{ CStr: A }, { Value: 0x1100 }, { Value: 0x14 }, { Value: 30 }] }
        - { AbbrCode: 2, Values: [{ CStr: high }, { Value: 0x2000 }, { Value: 0x14 }, { Value: 20 }] }
        - AbbrCode: 0
  ## 184 is uncovered; ranges join at 194, but 198 is a function entry.
  debug_ranges:
    - Entries: [{ LowOffset: 0x1000, HighOffset: 0x1030 }, { LowOffset: 0x1030, HighOffset: 0x1050 },
        { LowOffset: 0x1200, HighOffset: 0x1214 }]
    - Entries: [{ LowOffset: 0x100, HighOffset: 0x184 }, { LowOffset: 0x188, HighOffset: 0x194 },
        { LowOffset: 0x194, HighOffset: 0x198 }, { LowOffset: 0x198, HighOffset: 0x19c }]
  debug_line:
    - Version: 4
      MinInstLength: 1
      MaxOpsPerInst: 1
      DefaultIsStmt: 1
      LineBase: 251
      LineRange: 14
      Files: [{ Name: ranges.c, DirIdx: 0, ModTime: 0, Length: 0 }]
      ## 0x4b advances four bytes and one source line, then emits a row.
      Opcodes: [
        { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_set_address, Data: 0x1000 },
        { Opcode: DW_LNS_advance_line, SData: 9 }, { Opcode: DW_LNS_copy },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: DW_LNS_advance_pc, Data: 4 }, { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_end_sequence },
        { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_set_address, Data: 0x1100 },
        { Opcode: DW_LNS_advance_line, SData: 29 }, { Opcode: DW_LNS_copy },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: DW_LNS_advance_pc, Data: 4 }, { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_end_sequence },
        { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_set_address, Data: 0x1200 },
        { Opcode: DW_LNS_advance_line, SData: 9 }, { Opcode: DW_LNS_copy },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: DW_LNS_advance_pc, Data: 4 }, { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_end_sequence },
        { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_set_address, Data: 0x2000 },
        { Opcode: DW_LNS_advance_line, SData: 19 }, { Opcode: DW_LNS_copy },
        { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b }, { Opcode: 0x4b },
        { Opcode: DW_LNS_advance_pc, Data: 4 }, { Opcode: DW_LNS_extended_op, SubOpcode: DW_LNE_end_sequence }
        ]
