## Static ranges include their ending instruction; identical leaves add weights.
# OFF-NOT: LBR range comparison
# RANGES: 28
# RANGES: 0-4:1
# RANGES-NEXT: 100-100:5
# RANGES: 108-108:1
# RANGES-NEXT: 110-110:3
# RANGES-NEXT: 110-11c:3
# RANGES-COUNT-3: [[S:1[234]]]0-[[S]]0:1
# RANGES-NEXT: 150-150:2
# RANGES-COUNT-2: [[S:1[67]]]0-[[S]]0:1
# RANGES: 174-174:1
# RANGES: 180-180:1
# RANGES: 184-184:1
# RANGES: 190-194:1
# RANGES: 198-198:1
# RANGES: 33
# RANGES-COUNT-10: 1->{{1[0-9]0:[123]}}
# RANGES-COUNT-10: [[B:1[0-9]]]c->[[B]]0:{{[123]}}
# LBR-TEXT: low:12:2
# LBR-TEXT-NEXT: 0: 2 low:1
## Checking preserves counters and warnings for histories crossing static ends.
# WARN: warning: 4.76%(1/21) of samples are from ranges that do not belong to any functions.
# WARN-NEXT: warning: 19.05%(4/21) of samples are from ranges that do cross function boundaries.
# OFF-NOT: LBR range comparison
# COMPARE: LBR range comparison (weighted ranges): total=21{{$}}
# COMPARE-NEXT: longer-dynamic: 15{{$}}
# COMPARE-NEXT: not-comparable: 2{{$}}
# COMPARE-NEXT: same: 1{{$}}
# COMPARE-NEXT: shorter-dynamic: 1{{$}}
# COMPARE-NEXT: longer-fallthrough-dynamic: 1{{$}}
# COMPARE-NEXT: no-function-coverage: 1{{$}}
# COMPARE-NEXT: longer-dynamic crossed call: 1{{$}}
# COMPARE-NEXT: longer-dynamic crossed return: 2{{$}}
# COMPARE-NEXT: longer-dynamic crossed branch: 1{{$}}
# COMPARE-NEXT: longer-dynamic crossed trap: 5{{$}}
# COMPARE-NEXT: longer-dynamic crossed SVC: 3{{$}}
# COMPARE-NEXT: longer-dynamic crossed code gap: 1{{$}}
# COMPARE-NEXT: longer-dynamic crossed function boundary: 2{{$}}
# COMPARE-NEXT: [100,10c] category=longer-dynamic static-end=108 (trap){{$}}
# COMPARE-NEXT: [108,100] category=not-comparable no comparable static range{{$}}
# COMPARE-NEXT: [110,11c] category=longer-dynamic static-end=110 (SVC){{$}}
# COMPARE-NEXT: [120,12c] category=longer-dynamic static-end=120 (branch){{$}}
# COMPARE-NEXT: [130,13c] category=longer-dynamic static-end=130 (return){{$}}
# COMPARE-NEXT: [140,14c] category=longer-dynamic static-end=140 (call){{$}}
# COMPARE-NEXT: [150,15c] category=longer-dynamic static-end=150 (trap){{$}}
# COMPARE-NEXT: [160,16c] category=longer-dynamic static-end=160 (return){{$}}
# COMPARE-NOT: {{^}}  [
# ZERO: 0-0:1
# ENDS: [190,19c] category=longer-dynamic static-end=194 (function boundary){{$}}
# ENDS-NEXT: [2000,200c] category=shorter-dynamic static-end=2010 (return){{$}}
# RET-ENDS: [0,4] category=longer-dynamic static-end=0 (return){{$}}
# RET-ENDS: [2000,200c] category=shorter-dynamic static-end=2010 (end of known code){{$}}
# UNCOVERED: 2000-2000:1{{$}}
# UNCOVERED: LBR range comparison (weighted ranges): total=3{{$}}
# UNCOVERED-NEXT: no-function-coverage: 3{{$}}
## Leaf ranges use the sampled caller context, as ordinary dynamic ranges do.
# CS-LABEL: []
# CS: 2000-2010:1
# CS-LABEL: [A:0 @ low]
# CS-NEXT: 2
# CS-NEXT: 1030-1030:1
# CS-NEXT: 1200-1210:1
# CS-LABEL: [A:1 @ low]
# CS: 1018-101c:1
# CS-NEXT: 1024-102c:1
# CS-NEXT: 1028-102c:1
# CS-LABEL: [A:1 @ low:16 @ low]
# CS-NEXT: 1
# CS-NEXT: 1000-1004:1
# CS-LABEL: [A:1 @ low:5 @ high]
# CS: 2000-2010:1
# CS-LABEL: [low]
# CS: 1010-1010:3
# CS-NEXT: 1044-1048:3
# CS-LABEL: [low:14 @ high]
# CS: 2000-2010:1
# CS-NEXT: 2008-2010:1
# CS-LABEL: [low:2 @ A:2 @ high]
# CS: 2000-2010:1
# CS-LABEL: [low:3 @ high]
# CS: 2010-2010:3
# CS-CHECK: longer-dynamic crossed trap: 1{{$}}
# TEXT: [low:14 @ high]:8:0
# TEXT: [A:1 @ low]:7:1
# TEXT: 9: 1
# TEXT-NEXT: 10: 2
# TEXT-NEXT: 11: 2
# TEXT: [low:2 @ A:2 @ high]:5:1
# TEXT: [high]:0:2
# IGNORE: 1044-1048:3
# EMPTY: LBR range comparison (weighted ranges): total=0{{$}}
# EMPTY-NOT: {{^}}  {{[a-z-]+}}:
# MODE: --infer-lbr-leaf-range and --check-lbr-ranges require --perfscript or --perfdata input
# DISASM: --infer-lbr-leaf-range and --check-lbr-ranges cannot be used with --show-disassembly-only

#--- lbr
100 0x10c/0x100/P/-/-/0 0x9000/0x100/P/-/-/0
