#--- unordered.yaml
## Two described functions whose sections are listed in decreasing address
## order, which leaves the collected instruction addresses unordered. The file
## offsets still increase, as an object file requires.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_AARCH64
  Entry:   0x1000
Sections:
  - Name:         .text.high
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x2000
    Offset:       0x1000
    AddressAlign: 0x4
    ## nop
    ## b 0x2000
    Content:      1F2003D5FFFFFF17
  - Name:         .text.low
    Type:         SHT_PROGBITS
