; RUN:   --skip-symbolization --output=%t/observed-mmap.raw
; RUN: FileCheck %s --match-full-lines --check-prefix=FLAT -D#COUNT=1 --input-file=%t/observed-mmap.raw
; RUN: env EXPECTED_PIDS=200 PATH=%t/perfdir llvm-profgen --per-process-mappings --pid=200 \
; RUN:   --binary=%S/Inputs/noinline-cs-noprobe.perfbin --perfdata=%t/observed-zero.perfscript \
