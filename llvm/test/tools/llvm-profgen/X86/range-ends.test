        090909090C3660F01CD9090909090909090909090C30F01DE909090909090909090909090C30FA290909090909090909090909090C390E80\
        0000000909090909090909090C390E8000000000F0B90909090909090C390E800000000E8F5FFFFFF90909090C3CC9090909090909090909\
        090909090C30F0590909090909090909090909090C3C6F800909090909090909090909090C3" }
ProgramHeaders:
  - { Type: PT_LOAD, Flags: [ PF_X, PF_R ], VAddr: 0, Offset: 0, FileSize: 0x1170, MemSize: 0x1170 }
Symbols:
  - { Name: ranges, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0, Size: 294 }
  - { Name: tail, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 294, Size: 74 }
DWARF:
  debug_abbrev:
    - Table:
        - { Code: 1, Tag: DW_TAG_compile_unit, Children: DW_CHILDREN_yes, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_low_pc, Form: DW_FORM_addr },
            { Attribute: DW_AT_high_pc, Form: DW_FORM_data8 }] }
        - { Code: 2, Tag: DW_TAG_subprogram, Children: DW_CHILDREN_no, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_low_pc, Form: DW_FORM_addr },
            { Attribute: DW_AT_high_pc, Form: DW_FORM_data8 }] }
