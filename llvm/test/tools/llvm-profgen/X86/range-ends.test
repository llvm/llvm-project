Symbols:
  - { Name: ranges, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0, Size: 294 }
  - { Name: tail, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 294, Size: 74 }
DWARF:
  debug_abbrev:
    - Table:
        - { Code: 1, Tag: DW_TAG_compile_unit, Children: DW_CHILDREN_yes, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_low_pc, Form: DW_FORM_addr },
            { Attribute: DW_AT_high_pc, Form: DW_FORM_data8 }] }
        - { Code: 2, Tag: DW_TAG_subprogram, Children: DW_CHILDREN_no, Attributes: [
            { Attribute: DW_AT_name, Form: DW_FORM_string }, { Attribute: DW_AT_low_pc, Form: DW_FORM_addr },
            { Attribute: DW_AT_high_pc, Form: DW_FORM_data8 }] }
