# REQUIRES: x86-registered-target
# DEFINE: %{raw} = llvm-profgen --skip-symbolization
# DEFINE: %{check} = FileCheck %s --match-full-lines

# RUN: split-file %s %t
# RUN: yaml2obj %t/binary.yaml -o %t/main
# RUN: %{raw} --binary=%t/main -ps %t/lbr -o %t/ranges 2>%t/errors
# RUN: cat %t/ranges %t/errors | %{check} --check-prefixes=RANGES,COMPARE
# RUN: yaml2obj -DCLASS=ELFCLASS32 -DMACHINE=EM_386 -DPREFIX=CE -DBEFORE_RET=6200 %t/binary.yaml -o %t/into32
# RUN: %{raw} --binary=%t/into32 -ps %t/into -o %t/into.profile 2>%t/into.err
# RUN: cat %t/into.profile %t/into.err | %{check} --check-prefix=INTO
# RUN: yaml2obj -DPREFIX=90 %t/binary.yaml -o %t/zero.elf
# RUN: %{raw} --binary=%t/zero.elf -ps %t/zero -o %t/zero.profile 2>%t/zero.err
# RUN: cat %t/zero.profile %t/zero.err | %{check} --check-prefix=ZERO
# RUN: %{raw} --binary=%t/main -ps %t/external -o %t/external.out 2>&1 | %{check} --check-prefix=EXTERNAL --allow-empty
# RUN: %{raw} --binary=%t/main -ps %t/external-leaf -o %t/external-leaf.profile
# RUN: %{raw} --binary=%t/main -ps %t/external-hybrid -o %t/external-hybrid.profile
# RUN: cat %t/external-leaf.profile %t/external-hybrid.profile | FileCheck %s --check-prefix=NO-LEAF --allow-empty
# RUN: %{raw} --binary=%S/Inputs/noinline-cs-noprobe.perfbin -ps %S/Inputs/cs-interrupt.perfscript \
# RUN:   -o %t/interrupt 2>&1 | %{check} --check-prefix=INTERRUPT
# RUN: cat %S/Inputs/inline-cs-noprobe.perfscript %t/leaves > %t/inline.samples
# RUN: %{raw} --binary=%S/Inputs/inline-cs-noprobe.perfbin -ps %t/inline.samples -o %t/inline
# RUN: %{check} --check-prefix=INLINE --input-file=%t/inline
# RUN: %{raw} --binary=%S/Inputs/inline-cs-pseudoprobe.perfbin -ps %S/Inputs/inline-cs-pseudoprobe.perfscript -o \
# RUN:   %t/probes
# RUN: %{check} --check-prefix=PROBES --input-file=%t/probes
# RUN: %{raw} --binary=%S/Inputs/noinline-cs-pseudoprobe.perfbin -ps %t/callers -o %t/callers.raw
# RUN: %{check} --check-prefix=CALLERS --implicit-check-not='{{[0-9a-f]+-[0-9a-f]+:}}' --input-file=%t/callers.raw
# RUN: llvm-profgen --binary=%S/Inputs/noinline-cs-pseudoprobe.perfbin -ps %t/callers \
# RUN:   --format=text --profile-summary-cold-count=0 --csspgo-preinliner=0 --gen-cs-nested-profile=0 -o \
# RUN:   %t/callers.text
# RUN: %{check} --check-prefix=CALLERS-TEXT --implicit-check-not='[bar]' --input-file=%t/callers.text

## CPUID falls through to RET. Calls to the next instruction end inference.
# RANGES: 40
# RANGES-COUNT-30: [[S:[1-9a-f]]]0-[[S]]{{0|f}}:1
# RANGES-NEXT: 100-10f:2
# RANGES-NEXT: 110-111:1
# RANGES-NEXT: 120-121:1
# RANGES-NEXT: 130-131:1
# RANGES-COUNT-6: [[S:1[456]]]0-[[S]]{{0|f}}:1
# RANGES-NEXT: 44
# RANGES-COUNT-22: 1->{{[0-9a-f]+}}:1
# RANGES-COUNT-22: [[B:[0-9a-f]+]]f->[[B]]0:1
# COMPARE-NOT: LBR ranges shorter than the inferred range
## INTO and BOUND stop inference before the RET.
# INTO: 0-0:1
# INTO: 6-6:1
# INTO-NOT: LBR ranges shorter than the inferred range
## A recorded end at address zero still contributes to the profile.
# ZERO: 0-0:4294967297
# ZERO-NEXT: 6-8:4294967297
# ZERO: warning: No samples in perf script!
# ZERO-NEXT: LBR ranges shorter than the inferred range: 4294967297
# EXTERNAL-NOT: LBR ranges shorter than the inferred range
# NO-LEAF-NOT: {{[0-9a-f]+-[0-9a-f]+:}}
## The interrupt trace has one recorded range shorter than its static range.
# INTERRUPT: LBR ranges shorter than the inferred range: 1
## Starts before, within and after bar must split at inline context boundaries.
# INLINE-LABEL: [main:1 @ foo]
# INLINE-NEXT: 7
# INLINE: 67e-69b:2
# INLINE: 69d-6ad:1
# INLINE-NEXT: 6a5-6ad:1
# INLINE-NEXT: 6bd-6c8:19
# INLINE-NEXT: 6c2-6c8:1
# INLINE-NEXT: 8
# INLINE: 6c8->67e:15
# INLINE-COUNT-6: 6c8->{{69d|6a5|6af|6b5|6bd|6c2}}:1
# INLINE-LABEL: [main:1 @ foo:3.1 @ bar]
# INLINE-NEXT: 2
# INLINE-NEXT: 6af-6bb:17
# INLINE-NEXT: 6b5-6bb:1
# PROBES-LABEL: []
# PROBES-NEXT: 3
# PROBES: 80e-82b:2
# PROBES: 858->80e:15
## Probe leaves from a call, external entry and external resumption use the sampled caller chain.
# CALLERS: [0x7f4 @ 0x7bf]
# CALLERS-NEXT: 2
# CALLERS-NEXT: 760-77f:8
# CALLERS-NEXT: 76a-77f:7
# CALLERS-NEXT: 0
# CALLERS-TEXT: [main:2 @ foo:8 @ bar]:16:8
# CALLERS-TEXT-NEXT: 1: 8
# CALLERS-TEXT-NEXT: 4: 8

