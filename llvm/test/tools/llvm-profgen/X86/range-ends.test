## CPUID reaches RET; calls to the next instruction end inference but allow dynamic fall-through.
# RANGES: 40
# RANGES-COUNT-30: [[S:[1-9a-f]]]0-[[S]]{{0|f}}:1
# RANGES-NEXT: 100-10f:2
# RANGES-NEXT: 110-111:1
# RANGES-NEXT: 120-121:1
# RANGES-NEXT: 130-131:1
# RANGES-COUNT-6: [[S:1[456]]]0-[[S]]{{0|f}}:1
# RANGES-NEXT: 44
# RANGES-COUNT-22: 1->{{[0-9a-f]+}}:1
# RANGES-COUNT-22: [[B:[0-9a-f]+]]f->[[B]]0:1
# COMPARE: LBR range comparison (weighted ranges): total=22{{$}}
# COMPARE-NEXT: longer-dynamic: 17{{$}}
# COMPARE-NEXT: longer-fallthrough-dynamic: 4{{$}}
# COMPARE-NEXT: same: 1{{$}}
# COMPARE-NEXT: longer-dynamic crossed call: 1{{$}}
# COMPARE-NEXT: longer-dynamic crossed return: 3{{$}}
# COMPARE-NEXT: longer-dynamic crossed branch: 2{{$}}
# COMPARE-NEXT: longer-dynamic crossed trap: 7{{$}}
# COMPARE-NEXT: longer-dynamic crossed VM entry: 3{{$}}
# COMPARE-NEXT: longer-dynamic crossed function boundary: 1{{$}}
# COMPARE-NEXT: [30,3f] category=longer-dynamic static-end=30 (return){{$}}
# COMPARE-NEXT: [40,4f] category=longer-dynamic static-end=40 (trap){{$}}
# COMPARE-NEXT: [50,5f] category=longer-dynamic static-end=50 (VM entry){{$}}
# COMPARE-NEXT: [60,6f] category=longer-dynamic static-end=60 (VM entry){{$}}
# COMPARE-NEXT: [70,7f] category=longer-dynamic static-end=70 (VM entry){{$}}
# COMPARE-NEXT: [80,8f] category=longer-dynamic static-end=80 (return){{$}}
# COMPARE-NEXT: [90,9f] category=longer-dynamic static-end=90 (branch){{$}}
# COMPARE-NEXT: [a0,af] category=longer-dynamic static-end=a0 (trap){{$}}
# COMPARE-NOT: {{^}}  [
## INTO ends inference; unused 64-bit blocks may fail decoding in this mode.
# INTO: 0-0:1
# INTO-CHECK: LBR range comparison (weighted ranges): total=1{{$}}
# INTO-CHECK-NEXT: longer-fallthrough-dynamic: 1{{$}}
# INTO-CHECK-NOT: {{^}}  [
## Check zero endpoints at full weight without changing other warnings.
# ZERO-OFF: warning: No samples in perf script!
# ZERO: 0-0:4294967297
# ZERO-CHECK: warning: No samples in perf script!
# ZERO-CHECK: LBR range comparison (weighted ranges): total=4294967297{{$}}
# ZERO-CHECK-NEXT: same: 4294967297{{$}}
## Omit external endpoints from examples, even though marker 1 is also code.
# EXTERNAL: LBR range comparison (weighted ranges): total=3{{$}}
# EXTERNAL-NEXT: not-comparable: 2{{$}}
# EXTERNAL-NEXT: longer-fallthrough-dynamic: 1{{$}}
# EXTERNAL-NOT: {{^}}  [
# INTERRUPT: LBR range comparison (weighted ranges): total=28{{$}}
# INTERRUPT-NEXT: same: 16{{$}}
# INTERRUPT-NEXT: longer-fallthrough-dynamic: 9{{$}}
# INTERRUPT-NEXT: not-comparable: 2{{$}}
# INTERRUPT-NEXT: shorter-dynamic: 1{{$}}
# INTERRUPT-NEXT: [4005b0,4005c3] category=shorter-dynamic static-end=4005c8 (conditional transfer){{$}}
## Starts before, within and after bar must split at inline context boundaries.
# INLINE-LABEL: [main:1 @ foo]
# INLINE-NEXT: 7
# INLINE: 67e-69b:2
# INLINE: 69d-6ad:1
# INLINE-NEXT: 6a5-6ad:1
# INLINE-NEXT: 6bd-6c8:19
# INLINE-NEXT: 6c2-6c8:1
# INLINE-NEXT: 8
# INLINE: 6c8->67e:15
# INLINE-COUNT-6: 6c8->{{69d|6a5|6af|6b5|6bd|6c2}}:1
# INLINE-LABEL: [main:1 @ foo:3.1 @ bar]
# INLINE-NEXT: 2
# INLINE-NEXT: 6af-6bb:17
# INLINE-NEXT: 6b5-6bb:1
# PROBES-LABEL: []
# PROBES-NEXT: 3
# PROBES: 80e-82b:2
# PROBES: 858->80e:15
## Probe leaves from a call, external entry and external resumption use the sampled caller chain.
# CALLERS: [0x7f4 @ 0x7bf]
# CALLERS-NEXT: 2
# CALLERS-NEXT: 760-77f:8
# CALLERS-NEXT: 76a-77f:7
# CALLERS-NEXT: 0
# CALLERS-TEXT: [main:2 @ foo:8 @ bar]:16:8
# CALLERS-TEXT-NEXT: 1: 8
# CALLERS-TEXT-NEXT: 4: 8

