; REQUIRES: x86-registered-target
; UNSUPPORTED: system-windows

; RUN: split-file %s %t

; Exec establishes a complete thread inventory before mmap. A task name
; contains owner-like text; the final PID/TID suffix identifies the worker
; that keeps PID 100's mapping alive after its leader exits. Fork, unrelated
; exec, target exec and reloading must use their actual task owners.
; RUN: llvm-profgen --per-process-mappings --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/lifetime.perfscript --skip-symbolization --output=%t/all.raw
; RUN: FileCheck %s --match-full-lines --check-prefix=FLAT -D#COUNT=5 --input-file=%t/all.raw
; RUN: llvm-profgen --per-process-mappings --pid=100 --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/lifetime.perfscript --skip-symbolization --output=%t/100.raw
; RUN: FileCheck %s --match-full-lines --check-prefix=FLAT -D#COUNT=3 --input-file=%t/100.raw
; RUN: llvm-profgen --per-process-mappings --pid=200 --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/lifetime.perfscript --skip-symbolization --output=%t/200.raw
; RUN: FileCheck %s --match-full-lines --check-prefix=FLAT -D#COUNT=2 --input-file=%t/200.raw

; A task record leaves the following compact callchain header and frames intact.
; RUN: llvm-profgen --per-process-mappings --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/compact.perfscript --skip-symbolization --output=%t/compact.raw
; RUN: FileCheck %s --match-full-lines --check-prefix=CS --input-file=%t/compact.raw

; A complete task record at EOF works with and without a final newline.
; RUN: llvm-profgen --per-process-mappings --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/eof.perfscript --skip-symbolization --output=%t/eof.raw
; RUN: FileCheck %s --match-full-lines --check-prefix=FLAT -D#COUNT=1 --input-file=%t/eof.raw
; RUN: %python -c "from pathlib import Path; p=Path(r'%t/eof.perfscript'); Path(r'%t/no-newline.perfscript').write_bytes(p.read_bytes().rstrip(b'\n'))"
; RUN: llvm-profgen --per-process-mappings --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/no-newline.perfscript --skip-symbolization --output=%t/no-newline.raw
; RUN: cmp %t/eof.raw %t/no-newline.raw

; Task records require an owner PID/TID pair.
; RUN: not llvm-profgen --per-process-mappings --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/truncated.perfscript --skip-symbolization --output=%t/bad.raw 2>&1 | FileCheck %s --check-prefix=INVALID

; Branch diagnostics report physical line numbers once, including after task
; records, even when content checking examines the same branch.
; RUN: llvm-profgen --per-process-mappings --binary=%S/Inputs/noinline-cs-noprobe.perfbin \
; RUN:   --perfscript=%t/warning.perfscript --skip-symbolization --output=%t/warning.raw 2>&1 | FileCheck %s --check-prefix=WARNING --implicit-check-not="Invalid address in LBR record"

; FLAT-NOT:  {{.}}
; FLAT:      1
; FLAT-NEXT: 5b0-5c8:[[#COUNT]]
; FLAT-NEXT: 2
; FLAT-NEXT: 5c8->5dc:[[#COUNT]]
; FLAT-NEXT: 62f->5b0:[[#COUNT]]
; FLAT-NOT:  {{.}}

; CS-NOT:  {{.}}
; CS:      [main:1 @ foo]
; CS-NEXT:   0
; CS-NEXT:   1
; CS-NEXT:   62f->5b0:1
; CS-NEXT: [main:1 @ foo:3 @ bar]
; CS-NEXT:   1
; CS-NEXT:   5b0-5c8:1
; CS-NEXT:   1
; CS-NEXT:   5c8->5dc:1
; CS-NOT:  {{.}}

; INVALID: Invalid perf script task event
; WARNING: Invalid address in LBR record at line 7

;--- lifetime.perfscript
    100 0.999999: PERF_RECORD_COMM exec: start:100/100
    100 1.000000: PERF_RECORD_MMAP2 100/100: [0x500000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/noinline-cs-noprobe.perfbin
    999 1.000001: PERF_RECORD_COMM: abcd:1/1 :2/2 z:100/101
    100 1.000002: PERF_RECORD_EXIT(100:100):(1:1)
    100 1.000003: 5005dc 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0
    100 1.000004: PERF_RECORD_FORK(200:200):(100:101)
    200 1.000005: 5005dc 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0
    900 1.000006: PERF_RECORD_COMM exec: x:100/100 y:900/900
    100 1.000007: 5005dc 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0
    100 1.000008: PERF_RECORD_COMM exec: x:900/900 z:100/100
    100 1.000009: 5005dc 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0
    200 1.000010: 5005dc 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0
    100 1.000011: PERF_RECORD_MMAP2 100/100: [0x600000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/noinline-cs-noprobe.perfbin
    100 1.000012: 6005dc 0x6005c8/0x6005dc/P/-/-/0 0x60062f/0x6005b0/P/-/-/0

;--- compact.perfscript
      1 1.000000: PERF_RECORD_MMAP2 1/1: [0x500000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/noinline-cs-noprobe.perfbin
      1 2.000000: PERF_RECORD_COMM: x:1/1
1 3.000000:
5005dc
500634
500684
 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0

;--- eof.perfscript
    100 1.000000: PERF_RECORD_MMAP2 100/100: [0x500000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/noinline-cs-noprobe.perfbin
    100 2.000000: 5005dc 0x5005c8/0x5005dc/P/-/-/0 0x50062f/0x5005b0/P/-/-/0
      1 3.000000: PERF_RECORD_COMM: x:1/1

;--- truncated.perfscript
    100 1.000000: PERF_RECORD_COMM: truncated

;--- warning.perfscript
      1 1.000000: PERF_RECORD_MMAP2 1/1: [0x500000(0x1000) @ 0 00:1d 1 1]: r-xp /tmp/noinline-cs-noprobe.perfbin
      1 2.000000: PERF_RECORD_COMM: x:1/1
1 3.000000:
5005dc
500634
500684
 0xinvalid/0x5005dc/P/-/-/0
