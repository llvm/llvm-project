#--- lstr-dup.yaml
## yaml2obj rejects a repeated symbol name, so the static table is raw.
## Both locals are named .L.str (st_name 1) and cover different bytes.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_X86_64
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x401000
    AddressAlign: 0x10
    Content:      "90"
  - Name:         .rodata
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC ]
    Address:      0x402000
    AddressAlign: 0x1
    ## "hot\0" then "cold". Section index 2.
    Content:      "686f7400636f6c64"
  - Name:    .strtab
    Type:    SHT_STRTAB
    ## \0 .L.str \0
    Content: "002E4C2E73747200"
  - Name:    .symtab
    Type:    SHT_SYMTAB
    Link:    .strtab
    Info:    0x3
    EntSize: 24
    ## null, then two STB_LOCAL STT_OBJECT .L.str at 0x402000 and 0x402004.
    Content: "000000000000000000000000000000000000000000000000010000000100020000204000000000000400000000000000010000000100020004204000000000000400000000000000"
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    VAddr:    0x401000
    FirstSec: .text
    LastSec:  .text
  - Type:     PT_LOAD
    Flags:    [ PF_R ]
    VAddr:    0x402000
    FirstSec: .rodata
    LastSec:  .rodata

#--- lstr-dup.perf
0 0x10 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x402000

#--- page-pie.yaml
## Three PT_LOADs share file page 0x1000 but land on different virtual pages,
## matching a packed PIE. perf records each mmap at the page-rounded offset.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_X86_64
Sections:
  - Name:         .rodata
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC ]
    Address:      0x2000
    Offset:       0x1000
    AddressAlign: 0x4
    Content:      "01000000"
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x3100
    Offset:       0x1100
    AddressAlign: 0x10
    Content:      "90"
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x4200
    Offset:       0x1200
    AddressAlign: 0x4
    Content:      "02000000"
  - Name:         .bss
    Type:         SHT_NOBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x4204
    AddressAlign: 0x4
    Size:         4
ProgramHeaders:
  - Type:     PT_INTERP
    Flags:    [ PF_R ]
  - Type:     PT_LOAD
    Flags:    [ PF_R ]
    Align:    [[ALIGN]]
    Offset:   0x1000
    VAddr:    0x2000
    FileSize: 0x10
    MemSize:  0x10
    FirstSec: .rodata
    LastSec:  .rodata
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Align:    [[ALIGN]]
    Offset:   0x1100
    VAddr:    0x3100
    FirstSec: .text
    LastSec:  .text
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    Align:    [[ALIGN]]
    Offset:   0x1200
    VAddr:    0x4200
    FileSize: 4
    MemSize:  8
    FirstSec: .data
    LastSec:  .bss
Symbols:
  - Name:    cold_data
    Type:    STT_OBJECT
    Section: .data
    Value:   0x4200
    Size:    4
    Binding: STB_GLOBAL
  - Name:    hot_bss
    Type:    STT_OBJECT
    Section: .bss
    Value:   0x4204
    Size:    4
    Binding: STB_GLOBAL

