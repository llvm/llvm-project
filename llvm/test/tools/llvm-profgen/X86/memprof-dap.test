#--- overlap.yaml
## The second PT_LOAD's p_offset (0x1100) is inside the first's p_memsz window
## [0x1000, 0x2000). hot_bss is past both file sizes, at file offset 0x1200.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_X86_64
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x1000
    Offset:       0x200
    AddressAlign: 0x10
    Content:      "90"
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x4000
    Offset:       0x1100
    AddressAlign: 0x4
    Content:      "0100000002000000"
  - Name:         .bss
    Type:         SHT_NOBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x2200
    AddressAlign: 0x4
    Size:         4
  - Name:         .huge
    Type:         SHT_NOBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0xfffffffffffffff0
    AddressAlign: 0x1
    Size:         1
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x200
    VAddr:    0x1000
    FileSize: 0x1
    MemSize:  0x1
  - Type:     PT_LOAD
    Flags:    [ PF_R ]
    Offset:   0x1000
    VAddr:    0x2000
    FileSize: 0x100
    MemSize:  0x1000
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    Offset:   0x1100
    VAddr:    0x4000
    FileSize: 0x10
    MemSize:  0x10
Symbols:
  - Name:    hot_bss
    Type:    STT_OBJECT
    Section: .bss
    Value:   0x2200
    Size:    4
    Binding: STB_GLOBAL
  - Name:    next_data
    Type:    STT_OBJECT
    Section: .data
    Value:   0x4000
    Size:    4
    Binding: STB_GLOBAL
  - Name:    cold_data
    Type:    STT_OBJECT
    Section: .data
    Value:   0x4004
    Size:    4
    Binding: STB_GLOBAL
  - Name:    wrap_sym
    Type:    STT_OBJECT
    Section: .huge
    Value:   0xfffffffffffffff0
    Size:    32
    Binding: STB_GLOBAL

#--- overlap.perf
## Data mmap only. 0x7f00004100 is file offset 0x1100; 0x7f00004200 is 0x1200.
0 0x7b12 [0x88]: PERF_RECORD_MMAP2 100/100: [0x7f00004000(0x1000) @ 0x1000 08:01 1 0]: rw-p /path/to/overlap.bin
0 0x10 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x1000 period: 1000 addr: 0x7f00004100
0 0x20 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x1000 period: 1000 addr: 0x7f00004200

#--- dso-stale.perf
0 0x7b10 [0x88]: PERF_RECORD_MMAP2 100/100: [0x7f01001000(0x1000) @ 0x1000 08:01 1 0]: r-xp /path/to/dso.so
0 0x7b20 [0x88]: PERF_RECORD_MMAP2 100/100: [0x7f01003000(0x1000) @ 0x2000 08:01 1 0]: rw-p /path/to/dso.so
0 0x10 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x7f01001000 period: 1000 addr: 0x7f01003000
0 0x7c10 [0x88]: PERF_RECORD_MMAP2 100/100: [0x7f01001000(0x1000) @ 0 08:01 2 0]: r--p /path/to/other.so
0 0x20 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x7f01001000 period: 1000 addr: 0x7f01003004

#--- dso.yaml
## Shared library. Preferred VAs match pie.yaml; the runtime base does not.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_X86_64
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x1000
    Offset:       0x1000
    AddressAlign: 0x10
    Content:      "90"
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x3000
    Offset:       0x2000
    AddressAlign: 0x4
    Content:      "01000000020000000300000004000000"
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x1000
    VAddr:    0x1000
    FirstSec: .text
    LastSec:  .text
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    Offset:   0x2000
    VAddr:    0x3000
    FirstSec: .data
    LastSec:  .data
Symbols:
  - Name:    dso_hot
    Type:    STT_OBJECT
    Section: .data
    Value:   0x3000
    Size:    4
    Binding: STB_GLOBAL
  - Name:    dso_cold
    Type:    STT_OBJECT
    Section: .data
    Value:   0x3004
    Size:    4
    Binding: STB_GLOBAL
    Other:   [ STV_HIDDEN ]
  - Name:    dso_exported.llvm.1
    Type:    STT_OBJECT
    Section: .data
    Value:   0x3008
    Size:    4
    Binding: STB_GLOBAL
  - Name:    dso_other
    Type:    STT_OBJECT
    Section: .data
    Value:   0x300c
    Size:    4
    Binding: STB_GLOBAL

#--- main.yaml
## A non-PIE executable with a copy relocation for dso_exported, which it
## defines in its dynamic symbol table. It only references dso_other.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_X86_64
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x401000
    AddressAlign: 0x10
    Content:      "90"
  - Name:         .bss
    Type:         SHT_NOBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x403000
    AddressAlign: 0x4
    Size:         4
DynamicSymbols:
  - Name:    dso_exported
    Type:    STT_OBJECT
    Section: .bss
    Value:   0x403000
    Size:    4
    Binding: STB_GLOBAL
  - Name:    dso_other
    Type:    STT_OBJECT
    Binding: STB_GLOBAL

