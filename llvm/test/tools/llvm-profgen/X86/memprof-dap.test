## Convert a `perf report -D` dump of SAMPLE data addresses into MemProf DAP.
# RUN: rm -rf %t && split-file %s %t
# RUN: not llvm-profgen --binary=%t/does-not-exist --data-access-perftrace=%t/exec.perf \
# RUN:   --memprof-dap -o %t/out.yaml 2>&1 | FileCheck %s --check-prefix=NEEDBIN
# NEEDBIN: Input binary({{.*}}) doesn't exist.
# RUN: yaml2obj %t/exec.yaml -o %t/test.bin
# RUN: not llvm-profgen --binary=%t/test.bin --memprof-dap -o %t/out.yaml 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NEEDDUMP
# NEEDDUMP: --memprof-dap requires --data-access-perftrace
## A stripped binary has no symbol table to find data objects in.
# RUN: llvm-strip %t/test.bin -o %t/stripped.bin
# RUN: not llvm-profgen --binary=%t/stripped.bin --data-access-perftrace=%t/exec.perf \
# RUN:   --memprof-dap -o %t/stripped.out 2>&1 | FileCheck %s --check-prefix=STRIPPED
# STRIPPED: --memprof-dap requires a symbol table, but {{.*}}stripped.bin has none (stripped?)
## A SAMPLE line this parser does not recognize must not become an all-cold profile.
# RUN: not llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/bad-sample.perf --memprof-dap -o %t/bad.out \
# RUN:   2>&1 | FileCheck %s --check-prefix=BADSAMPLE
# BADSAMPLE: No PERF_RECORD_SAMPLE line matches a data-access sample
## No samples must not become an all-cold profile, even with --pid.
# RUN: not llvm-profgen --binary=%t/test.bin --data-access-perftrace=%t/empty.perf \
# RUN:   --memprof-dap --pid=100 -o %t/empty.out 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOSAMPLE
# NOSAMPLE: No PERF_RECORD_SAMPLE line found in data-access trace
## Zero data addresses provide no usable evidence about object hotness.
# RUN: not llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/zero-addr.perf --memprof-dap \
# RUN:   -o %t/zero.profdata 2>&1 | FileCheck %s --check-prefix=ZEROADDR
# RUN: not llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/zero-pid.perf --memprof-dap --pid=100 \
# RUN:   -o %t/zero-pid.profdata 2>&1 | FileCheck %s --check-prefix=ZEROADDR
# ZEROADDR: All {{[0-9]+}} matched data-access samples have a zero data address
## Valid samples with neither a matching address nor a binary mapping may come
## from a different binary and must not mark every object cold.
# RUN: not llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/no-mapping.perf --memprof-dap \
# RUN:   -o %t/no-mapping.profdata 2>&1 | FileCheck %s --check-prefix=NOMAPPING
# NOMAPPING: No data-access sample maps to {{.*}}test.bin
# RUN: llvm-profgen --binary=%t/test.bin --data-access-perftrace=%t/exec.perf \
# RUN:   --memprof-dap -o %t/exec.profdata
# RUN: llvm-profdata show --memory %t/exec.profdata | FileCheck %s --check-prefix=EXEC
## PID 1 mapped this ET_EXEC. PID 2 has no mmap. PID 2's sample is hot_var's
## preferred VA and must be credited, not treated as known-cold.
# RUN: llvm-profgen --binary=%t/test.bin --data-access-perftrace=%t/other-pid.perf \
# RUN:   --memprof-dap -o %t/other-pid.profdata
# RUN: llvm-profdata show --memory %t/other-pid.profdata \
# RUN:   | FileCheck %s --check-prefix=OTHERPID
## An absent PID may use an ET_EXEC preferred VA, but exec or PID reuse makes
## that old preferred address stale.
# RUN: llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/exec-replaced.perf --memprof-dap \
# RUN:   -o %t/exec-replaced.profdata
# RUN: llvm-profdata show --memory %t/exec-replaced.profdata \
# RUN:   | FileCheck %s --check-prefix=DROPPED
# RUN: llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/pid-reused.perf --memprof-dap \
# RUN:   -o %t/pid-reused.profdata
# RUN: llvm-profdata show --memory %t/pid-reused.profdata \
# RUN:   | FileCheck %s --check-prefix=DROPPED
## Every sample is from a PID with no image, and none is a preferred VA, while
## another PID mapped the binary. That is not evidence the objects are cold.
# RUN: not llvm-profgen --binary=%t/test.bin --data-access-perftrace=%t/orphan.perf \
# RUN:   --memprof-dap -o %t/orphan.profdata 2>&1 | FileCheck %s --check-prefix=ORPHAN
# ORPHAN: No data-access sample maps to {{.*}}test.bin

# RUN: yaml2obj %t/pie.yaml -o %t/test.bin
# RUN: llvm-profgen --binary=%t/test.bin --data-access-perftrace=%t/pie.perf \
# RUN:   --memprof-dap --pid=3446532 -o %t/pie.profdata
# RUN: llvm-profdata show --memory %t/pie.profdata | FileCheck %s --check-prefix=PIE
## A mapped image makes an all-cold result meaningful when every sample is in
## heap, stack, or another object. A sample from another PID with no mapping
## is not unresolved and must not suppress known-cold.
# RUN: llvm-profgen --binary=%t/test.bin \
# RUN:   --data-access-perftrace=%t/mapped-cold.perf --memprof-dap \
# RUN:   -o %t/mapped-cold.profdata
# RUN: llvm-profdata show --memory %t/mapped-cold.profdata \
# RUN:   | FileCheck %s --check-prefix=MAPPEDCOLD
#
# RUN: yaml2obj %t/pie-bss.yaml -o %t/pie-bss.bin
# RUN: llvm-profgen --binary=%t/pie-bss.bin --data-access-perftrace=%t/pie-bss.perf \
# RUN:   --memprof-dap -o %t/pie-bss.profdata
# RUN: llvm-profdata show --memory %t/pie-bss.profdata | FileCheck %s --check-prefix=PIEBSS

# RUN: yaml2obj %t/alias.yaml -o %t/alias.bin
# RUN: llvm-profgen --binary=%t/alias.bin --data-access-perftrace=%t/alias.perf \
# RUN:   --memprof-dap -o %t/alias.profdata
# RUN: llvm-profdata show --memory %t/alias.profdata | FileCheck %s --check-prefix=ALIAS

# RUN: yaml2obj %t/lstr.yaml -o %t/lstr.bin
# RUN: llvm-profgen --binary=%t/lstr.bin --data-access-perftrace=%t/lstr.perf \
# RUN:   --memprof-dap -o %t/lstr.profdata
# RUN: llvm-profdata show --memory %t/lstr.profdata | FileCheck %s --check-prefix=LSTR

# RUN: yaml2obj %t/canon.yaml -o %t/canon.bin
# RUN: llvm-profgen --binary=%t/canon.bin --data-access-perftrace=%t/canon.perf \
# RUN:   --memprof-dap -o %t/canon.profdata
# RUN: llvm-profdata show --memory %t/canon.profdata | FileCheck %s --check-prefix=CANON

# RUN: yaml2obj %t/lstr-dup.yaml -o %t/lstr-dup.bin
# RUN: llvm-profgen --binary=%t/lstr-dup.bin --data-access-perftrace=%t/lstr-dup.perf \
# RUN:   --memprof-dap -o %t/lstr-dup.profdata
# RUN: llvm-profdata show --memory %t/lstr-dup.profdata | FileCheck %s --check-prefix=LSTRDUP

# RUN: yaml2obj -DALIGN=0x1000 %t/page-pie.yaml -o %t/page-pie.bin
# RUN: llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/page-pie.perf \
# RUN:   --memprof-dap -o %t/page-pie.profdata
# RUN: llvm-profdata show --memory %t/page-pie.profdata | FileCheck %s --check-prefix=PAGEPIE

## No text mmap. The next PT_LOAD's p_offset sits inside the previous p_memsz.
## File bytes win; the BSS tail past every p_filesz is still credited.
# RUN: yaml2obj %t/overlap.yaml -o %t/overlap.bin
# RUN: llvm-profgen --binary=%t/overlap.bin --data-access-perftrace=%t/overlap.perf \
# RUN:   --memprof-dap -o %t/overlap.profdata
# RUN: llvm-profdata show --memory %t/overlap.profdata | FileCheck %s --check-prefix=OVERLAP

## A forked child has no mmaps of its own and inherits the parent's slide, also
## when only the child is selected. A child that execs another image does not.
# RUN: llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/fork.perf \
# RUN:   --memprof-dap -o %t/fork.profdata
# RUN: llvm-profdata show --memory %t/fork.profdata | FileCheck %s --check-prefix=FORK

## Mappings are per process: a sample is only resolved through its own
## process's mmaps. A new thread keeps the slide; a reused PID starts clean.
# RUN: llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/procs.perf \
# RUN:   --memprof-dap -o %t/procs.profdata
# RUN: llvm-profdata show --memory %t/procs.profdata | FileCheck %s --check-prefix=PROCS

## A --pid that selects no sample is an error, not an all-cold profile.
# RUN: not llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/procs.perf \
# RUN:   --memprof-dap --pid=12345 -o %t/nopid.profdata 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOPID

## Without a text mmap, the file offset comes from the newest mapping that
## covers the address, not from the loader's whole-image reservation.
# RUN: llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/reserve.perf \
# RUN:   --memprof-dap -o %t/reserve.profdata
# RUN: llvm-profdata show --memory %t/reserve.profdata | FileCheck %s --check-prefix=RESERVE
## A sample in this binary's mmap that cannot be placed suppresses known-cold.
# RUN: llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/unresolved.perf \
# RUN:   --memprof-dap -o %t/unresolved.profdata
# RUN: llvm-profdata show --memory %t/unresolved.profdata \
# RUN:   | FileCheck %s --check-prefix=UNRESOLVED

## The kernel prints " (deleted)" after the path of an unlinked image. The
## basename still has to match this binary.
# RUN: llvm-profgen --binary=%t/page-pie.bin --data-access-perftrace=%t/deleted.perf \
# RUN:   --memprof-dap -o %t/deleted.profdata
# RUN: llvm-profdata show --memory %t/deleted.profdata | FileCheck %s --check-prefix=DELETED

## The profiled binary is a DSO. The same dump also maps the main executable.
## Only the DSO's data is credited; a sample in the executable is dropped.
# RUN: yaml2obj %t/dso.yaml -o %t/dso.so
# RUN: llvm-profgen --binary=%t/dso.so --data-access-perftrace=%t/dso.perf \
# RUN:   --memprof-dap -o %t/dso.profdata 2>&1 | FileCheck %s --check-prefix=DSOWARN
# RUN: llvm-profdata show --memory %t/dso.profdata | FileCheck %s --check-prefix=DSO

## The DSO's only spelling is dso_exported.llvm.1. The executable defines
## dso_exported, so the canonical name is not known-cold. dso_other is only
## referenced, not defined, there.
# RUN: yaml2obj %t/main.yaml -o %t/main.bin
# RUN: sed -e 's|MAIN|%/t/main.bin|' %t/copyreloc.perf > %t/copyreloc.real.perf
# RUN: llvm-profgen --binary=%t/dso.so --data-access-perftrace=%t/copyreloc.real.perf \
# RUN:   --memprof-dap -o %t/copyreloc.profdata 2>&1 | FileCheck %s \
# RUN:   --check-prefix=COPYRELWARN --allow-empty
# RUN: llvm-profdata show --memory %t/copyreloc.profdata | FileCheck %s --check-prefix=COPYREL

## Another file mapped over the DSO means it was unloaded; later samples at its
## old addresses are dropped. An anonymous mapping, like BSS, does not unload it.
# RUN: llvm-profgen --binary=%t/dso.so --data-access-perftrace=%t/dso-unload.perf \
# RUN:   --memprof-dap -o %t/dso-unload.profdata
# RUN: llvm-profdata show --memory %t/dso-unload.profdata | FileCheck %s --check-prefix=DSOUNLOAD

## other.so covers only the DSO text page. The data mmap it did not cover must
## not keep crediting samples after the image is gone.
# RUN: llvm-profgen --binary=%t/dso.so --data-access-perftrace=%t/dso-stale.perf \
# RUN:   --memprof-dap -o %t/dso-stale.profdata
# RUN: llvm-profdata show --memory %t/dso-stale.profdata | FileCheck %s --check-prefix=STALE

## Named symbols are credited by ELF name. `.str*` literals use llvm::MD5Hash of
## the contents (including the trailing NUL). Here `.rodata` shares the
## executable PT_LOAD with `.text`. Unsampled data objects are KnownCold.
## Stack / unknown VAs are dropped.
# EXEC:      Num hot symbols and string literals: 3
# EXEC:      Num known cold symbols: 2
# EXEC:      DataAccessProfiles:
# EXEC-NEXT:   SampledRecords:
# EXEC-NEXT:     - Symbol:          hot_var
# EXEC-NEXT:       AccessCount:     4
# EXEC-NEXT:     - Hash:            667000227519429140
# EXEC-NEXT:       AccessCount:     3
# EXEC-NEXT:     - Symbol:          hot_str
# EXEC-NEXT:       AccessCount:     1
# EXEC:        KnownColdSymbols:
# EXEC-DAG:      - cold_var
# EXEC-DAG:      - unknown_var

# OTHERPID:      Num hot symbols and string literals: 1
# OTHERPID:      Num known cold symbols: 3
# OTHERPID:      Num known cold string literals: 1
# OTHERPID:      SampledRecords:
# OTHERPID-NEXT:   - Symbol:          hot_var
# OTHERPID-NEXT:     AccessCount:     1
# OTHERPID:        KnownColdSymbols:
# OTHERPID-DAG:      - cold_var
# OTHERPID-DAG:      - hot_str
# OTHERPID-DAG:      - unknown_var
# OTHERPID:        KnownColdStrHashes: [ 667000227519429140 ]

# DROPPED:      SampledRecords:
# DROPPED-NEXT:   - Symbol:          hot_var
# DROPPED-NEXT:     AccessCount:     1
# DROPPED:        KnownColdSymbols:
# DROPPED-DAG:      - cold_var
# DROPPED-DAG:      - hot_str
# DROPPED-DAG:      - unknown_var

# PIE:       DataAccessProfiles:
# PIE:         SampledRecords:
# PIE-NEXT:      - Symbol:          hot_var
# PIE-NEXT:        AccessCount:     4
# PIE:           KnownColdSymbols:
# PIE-NEXT:        - cold_var
#
# MAPPEDCOLD:      DataAccessProfiles:
# MAPPEDCOLD:      KnownColdSymbols:
# MAPPEDCOLD-DAG:    - cold_var
# MAPPEDCOLD-DAG:    - hot_var
#
## PIE .bss lives past p_filesz. The file-backed mmap does not cover it;
## canonicalization must use PT_LOAD p_memsz.
# PIEBSS:      SampledRecords:
# PIEBSS-NEXT:   - Symbol:          hot_table
# PIEBSS-NEXT:     AccessCount:     3
# PIEBSS:        KnownColdSymbols:
# PIEBSS-NEXT:     - cold_var

## Overlapping aliases: one VA credits every covering symbol. The unnamed
## symbol covering both variables has no profile key and is skipped.
# ALIAS:      SampledRecords:
# ALIAS-DAG:    - Symbol:          hot_alias
# ALIAS-DAG:      AccessCount:     5
# ALIAS-DAG:    - Symbol:          hot_var
# ALIAS-DAG:      AccessCount:     5
# ALIAS:        KnownColdSymbols:
# ALIAS-NEXT:     - cold_var

## Clang-style `.L.str` is hashed like `.str`; unsampled literals are KnownCold hashes.
# LSTR:       SampledRecords:
# LSTR-NEXT:    - Hash:            667000227519429140
# LSTR-NEXT:      AccessCount:     2
# LSTR:         KnownColdStrHashes: [ 4969486738645055141 ]

## `.llvm.` / `.part.` spellings share one canonical key. Counts merge, and an
## unsampled clone is not also known-cold.
# CANON:      SampledRecords:
# CANON-NEXT:   - Symbol:          foo
# CANON-NEXT:     AccessCount:     3
# CANON:        KnownColdSymbols:
# CANON-NEXT:     - bar
# CANON-NOT:    foo
# CANON-NOT:    .llvm.
# CANON-NOT:    .part.

## Two local symbols both named .L.str, different bytes. Sampling one must not
## drop the other's known-cold hash. 4969486738645055141 is "hot\0";
## 11668175513417606517 is "cold".
# LSTRDUP:      Num hot symbols and string literals: 1
# LSTRDUP:      Num known cold symbols: 0
# LSTRDUP:      Num known cold string literals: 1
# LSTRDUP:      SampledRecords:
# LSTRDUP-NEXT:   - Hash:            4969486738645055141
# LSTRDUP-NEXT:     AccessCount:     1
# LSTRDUP:        KnownColdStrHashes: [ 11668175513417606517 ]

## Sub-page p_offset/p_vaddr sharing one file page, mmaps recorded at that page.
## hot_bss is past p_filesz. Each PID has its own slide.
# PAGEPIE:      Num hot symbols and string literals: 1
# PAGEPIE:      Num known cold symbols: 1
# PAGEPIE:      SampledRecords:
# PAGEPIE-NEXT:   - Symbol:          hot_bss
# PAGEPIE-NEXT:     AccessCount:     2
# PAGEPIE:        KnownColdSymbols:
# PAGEPIE-NEXT:     - cold_data

## next_data's file offset is inside the previous segment's p_memsz. hot_bss is
## past every p_filesz. wrap_sym's range does not fit in the address space.
# OVERLAP:      SampledRecords:
# OVERLAP-NEXT:   - Symbol:          hot_bss
# OVERLAP-NEXT:     AccessCount:     1
# OVERLAP-NEXT:   - Symbol:          next_data
# OVERLAP-NEXT:     AccessCount:     1
# OVERLAP-NOT:    wrap_sym
# OVERLAP:        KnownColdSymbols:
# OVERLAP-NEXT:     - cold_data
# OVERLAP-NOT:    wrap_sym

## Only child 101's BSS sample is credited; child 102 ran another image.
# FORK:      SampledRecords:
# FORK-NEXT:   - Symbol:          hot_bss
# FORK-NEXT:     AccessCount:     1
# FORK:        KnownColdSymbols:
# FORK-NEXT:     - cold_data

## PID 200's sample and the one after PID 300 is reused are dropped.
# PROCS:      SampledRecords:
# PROCS-NEXT:   - Symbol:          cold_data
# PROCS-NEXT:     AccessCount:     1
# PROCS-NEXT:   - Symbol:          hot_bss
# PROCS-NEXT:     AccessCount:     1

# NOPID: error: None of the 4 data-access samples in {{.*}}procs.perf has PID 12345 from --pid

## The BSS sample resolves through p_memsz despite being past p_filesz.
# RESERVE:      SampledRecords:
# RESERVE-NEXT:   - Symbol:          hot_bss
# RESERVE-NEXT:     AccessCount:     1
# RESERVE:        KnownColdSymbols:
# RESERVE-NEXT:     - cold_data

# UNRESOLVED:      SampledRecords:
# UNRESOLVED-NEXT:   - Symbol:          cold_data
# UNRESOLVED-NEXT:     AccessCount:     1
# UNRESOLVED-NOT:  KnownColdSymbols:

## " (deleted)" is not part of the binary name.
# DELETED:      SampledRecords:
# DELETED-NEXT:   - Symbol:          hot_bss
# DELETED-NEXT:     AccessCount:     1
# DELETED:        KnownColdSymbols:
# DELETED-NEXT:     - cold_data

## DSO data at its runtime load address. The executable sample is not a symbol.
## The executable in the dump cannot be read, so no unsampled exported variable
## is known-cold; any of them may have been copy-relocated into it.
# DSOWARN: warning: cannot read /path/to/main: {{.*}}
# DSOWARN: warning: no exported variable of dso.so is listed as known-cold
# DSO:      SampledRecords:
# DSO-NEXT:   - Symbol:          dso_hot
# DSO-NEXT:     AccessCount:     2
# DSO:        KnownColdSymbols:
# DSO-NEXT:     - dso_cold
# DSO-NOT:    exe_hot
# DSO-NOT:    dso_exported
# DSO-NOT:    dso_other

# COPYRELWARN-NOT: warning: {{.*}}known-cold
# COPYREL:      SampledRecords:
# COPYREL-NEXT:   - Symbol:          dso_hot
# COPYREL-NEXT:     AccessCount:     1
# COPYREL:        KnownColdSymbols:
# COPYREL-NEXT:     - dso_cold
# COPYREL-NEXT:     - dso_other
# COPYREL-NOT:      dso_exported

## Only the sample before other.so replaced the DSO is credited. No other ELF
## was recorded, so an exported symbol is not known-cold. dso_cold is hidden.
# DSOUNLOAD:      SampledRecords:
# DSOUNLOAD-NEXT:   - Symbol:          dso_hot
# DSOUNLOAD-NEXT:     AccessCount:     1
# DSOUNLOAD:        KnownColdSymbols:
# DSOUNLOAD-NEXT:     - dso_cold
# DSOUNLOAD-NOT:    dso_exported
# DSOUNLOAD-NOT:    dso_other

## The foreign mapping covers the text page only. The later data sample is
## dropped with the rest of the image.
# STALE:      SampledRecords:
# STALE-NEXT:   - Symbol:          dso_hot
# STALE-NEXT:     AccessCount:     1
# STALE:        KnownColdSymbols:
# STALE-NEXT:     - dso_cold
# STALE-NOT:    dso_exported
# STALE-NOT:    dso_other

#--- exec.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_X86_64
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x401000
    AddressAlign: 0x10
    Content:      "9090"
  - Name:         .rodata
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC ]
    Address:      0x401002
    AddressAlign: 0x1
    ## "hot\0" at 0x401002, "abc\0" at 0x401006
    Content:      "686f740061626300"
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x403000
    AddressAlign: 0x4
    Content:      "0100000002000000"
  - Name:         .bss
    Type:         SHT_NOBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x403008
    AddressAlign: 0x4
    Size:         4
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    VAddr:    0x401000
    FirstSec: .text
    LastSec:  .rodata
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    VAddr:    0x403000
    FirstSec: .data
    LastSec:  .bss
Symbols:
  - Name:    _start
    Type:    STT_FUNC
    Section: .text
    Value:   0x401000
    Size:    2
    Binding: STB_GLOBAL
  - Name:    hot_str
    Type:    STT_OBJECT
    Section: .rodata
    Value:   0x401002
    Size:    4
    Binding: STB_GLOBAL
  - Name:    .str.1
    Type:    STT_OBJECT
    Section: .rodata
    Value:   0x401006
    Size:    4
    Binding: STB_LOCAL
  - Name:    hot_var
    Type:    STT_OBJECT
    Section: .data
    Value:   0x403000
    Size:    4
    Binding: STB_GLOBAL
  - Name:    cold_var
    Type:    STT_OBJECT
    Section: .data
    Value:   0x403004
    Size:    4
    Binding: STB_GLOBAL
  - Name:    unknown_var
    Type:    STT_OBJECT
    Section: .bss
    Value:   0x403008
    Size:    4
    Binding: STB_GLOBAL

#--- exec.perf
0 0x0 [0x0]: PERF_RECORD_MMAP2
0 0x10 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x403000
0 0x20 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x403000
## A second load IP to the same data addr still aggregates in DAP.
0 0x21 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401001 period: 1000 addr: 0x403000
0 0x22 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x403000
0 0x30 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x401002
0 0x40 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x401006
0 0x50 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 100/100: 0x401000 period: 1000 addr: 0x401006
