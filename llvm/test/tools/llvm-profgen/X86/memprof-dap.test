#--- pie.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_DYN
  Machine: EM_X86_64
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x1000
    Offset:       0x1000
    AddressAlign: 0x10
    Content:      "90"
  - Name:         .data
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x3000
    Offset:       0x2000
    AddressAlign: 0x4
    Content:      "0100000002000000"
ProgramHeaders:
  - Type:     PT_INTERP
    Flags:    [ PF_R ]
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_X ]
    Offset:   0x1000
    VAddr:    0x1000
    FirstSec: .text
    LastSec:  .text
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W ]
    Offset:   0x2000
    VAddr:    0x3000
    FirstSec: .data
    LastSec:  .data
Symbols:
  - Name:    hot_var
    Type:    STT_OBJECT
    Section: .data
    Value:   0x3000
    Size:    4
    Binding: STB_GLOBAL
  - Name:    cold_var
    Type:    STT_OBJECT
    Section: .data
    Value:   0x3004
    Size:    4
    Binding: STB_GLOBAL

#--- pie.perf
0 0x7b10 [0x88]: PERF_RECORD_MMAP2 3446532/3446532: [0x7f00001000(0x1000) @ 0x1000 08:01 1 0]: r-xp /path/to/test.bin
0 0x7c20 [0x88]: PERF_RECORD_MMAP2 3446532/3446532: [0x7f00003000(0x1000) @ 0x2000 08:01 1 0]: rw-p /path/to/test.bin
## RELRO records the same data page again, smaller and read-only.
0 0x7c21 [0x88]: PERF_RECORD_MMAP2 3446532/3446532: [0x7f00003000(0x100) @ 0x2000 08:01 1 0]: r--p /path/to/test.bin
0 0x10 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 3446532/3446532: 0x7f00001000 period: 1000 addr: 0x7f00003000
0 0x20 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 3446532/3446532: 0x7f00001000 period: 1000 addr: 0x7f00003000
0 0x30 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 3446532/3446532: 0x7f00001000 period: 1000 addr: 0x7f00003000
0 0x40 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 3446532/3446532: 0x7f00001000 period: 1000 addr: 0x7f00003000
## Different PID must be ignored when --pid is set.
0 0x50 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 1/1: 0x7f00001000 period: 1000 addr: 0x7f00003004
## A malformed text mmap must not wrap the slide and turn 0x2010 into the
## preferred data VA 0x3000.
0 0x60 [0x88]: PERF_RECORD_MMAP2 3446532/3446532: [0x10(0x1000) @ 0x1000 08:01 1 0]: r-xp /path/to/test.bin
0 0x70 [0x30]: PERF_RECORD_SAMPLE(IP, 0x4002): 3446532/3446532: 0x10 period: 1000 addr: 0x2010

