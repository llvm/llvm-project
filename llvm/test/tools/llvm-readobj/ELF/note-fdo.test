# LLVM-NEXT:          "foo": "bar",
# LLVM-NEXT:          "key": "value",
# LLVM-NEXT:          "num": 42
# LLVM-NEXT:        }
# LLVM-NEXT:      }
# LLVM-NEXT:      {
