## Test that llvm-readobj/llvm-readelf shows proper relocation type
## names and values for the nanoMIPS target.

# RUN: yaml2obj %s -o %t-nanomips.o
# RUN: llvm-readobj -r --expand-relocs %t-nanomips.o | FileCheck %s

# CHECK: Type: R_NANOMIPS_NONE (0)
# CHECK: Type: R_NANOMIPS_32 (1)
# CHECK: Type: R_NANOMIPS_64 (2)
# CHECK: Type: R_NANOMIPS_NEG (3)
# CHECK: Type: R_NANOMIPS_ASHIFTR_1 (4)
# CHECK: Type: R_NANOMIPS_UNSIGNED_8 (5)
# CHECK: Type: R_NANOMIPS_SIGNED_8 (6)
# CHECK: Type: R_NANOMIPS_UNSIGNED_16 (7)
# CHECK: Type: R_NANOMIPS_SIGNED_16 (8)
# CHECK: Type: R_NANOMIPS_RELATIVE (9)
# CHECK: Type: R_NANOMIPS_GLOBAL (10)
# CHECK: Type: R_NANOMIPS_JUMP_SLOT (11)
# CHECK: Type: R_NANOMIPS_IRELATIVE (12)
# CHECK: Type: R_NANOMIPS_PC25_S1 (13)
# CHECK: Type: R_NANOMIPS_PC21_S1 (14)
# CHECK: Type: R_NANOMIPS_PC14_S1 (15)
# CHECK: Type: R_NANOMIPS_PC11_S1 (16)
# CHECK: Type: R_NANOMIPS_PC10_S1 (17)
# CHECK: Type: R_NANOMIPS_PC7_S1 (18)
# CHECK: Type: R_NANOMIPS_PC4_S1 (19)
# CHECK: Type: R_NANOMIPS_GPREL19_S2 (20)
# CHECK: Type: R_NANOMIPS_GPREL18_S3 (21)
# CHECK: Type: R_NANOMIPS_GPREL18 (22)
# CHECK: Type: R_NANOMIPS_GPREL17_S1 (23)
# CHECK: Type: R_NANOMIPS_GPREL16_S2 (24)
# CHECK: Type: R_NANOMIPS_GPREL7_S2 (25)
# CHECK: Type: R_NANOMIPS_GPREL_HI20 (26)
# CHECK: Type: R_NANOMIPS_PC_HI20 (27)
# CHECK: Type: R_NANOMIPS_HI20 (28)
# CHECK: Type: R_NANOMIPS_LO12 (29)
# CHECK: Type: R_NANOMIPS_GPREL_I32 (30)
# CHECK: Type: R_NANOMIPS_PC_I32 (31)
# CHECK: Type: R_NANOMIPS_I32 (32)
# CHECK: Type: R_NANOMIPS_GOT_DISP (33)
# CHECK: Type: R_NANOMIPS_GOTPC_I32 (34)
# CHECK: Type: R_NANOMIPS_GOTPC_HI20 (35)
# CHECK: Type: R_NANOMIPS_GOT_LO12 (36)
# CHECK: Type: R_NANOMIPS_GOT_CALL (37)
# CHECK: Type: R_NANOMIPS_GOT_PAGE (38)
# CHECK: Type: R_NANOMIPS_GOT_OFST (39)
# CHECK: Type: R_NANOMIPS_LO4_S2 (40)
# CHECK: Type: R_NANOMIPS_RESERVED1 (41)
# CHECK: Type: R_NANOMIPS_GPREL_LO12 (42)
# CHECK: Type: R_NANOMIPS_SCN_DISP (43)
# CHECK: Type: R_NANOMIPS_COPY (44)
# CHECK: Type: R_NANOMIPS_ALIGN (64)
# CHECK: Type: R_NANOMIPS_FILL (65)
# CHECK: Type: R_NANOMIPS_MAX (66)
# CHECK: Type: R_NANOMIPS_INSN32 (67)
# CHECK: Type: R_NANOMIPS_FIXED (68)
# CHECK: Type: R_NANOMIPS_NORELAX (69)
# CHECK: Type: R_NANOMIPS_RELAX (70)
# CHECK: Type: R_NANOMIPS_SAVERESTORE (71)
# CHECK: Type: R_NANOMIPS_INSN16 (72)
# CHECK: Type: R_NANOMIPS_JALR32 (73)
# CHECK: Type: R_NANOMIPS_JALR16 (74)
# CHECK: Type: R_NANOMIPS_JUMPTABLE_LOAD (75)
# CHECK: Type: R_NANOMIPS_FRAME_REG (76)
# CHECK: Type: R_NANOMIPS_NOTRAMP (77)
# CHECK: Type: R_NANOMIPS_TLS_DTPMOD (80)
# CHECK: Type: R_NANOMIPS_TLS_DTPREL (81)
# CHECK: Type: R_NANOMIPS_TLS_TPREL (82)
# CHECK: Type: R_NANOMIPS_TLS_GD (83)
# CHECK: Type: R_NANOMIPS_TLS_GD_I32 (84)
# CHECK: Type: R_NANOMIPS_TLS_LD (85)
# CHECK: Type: R_NANOMIPS_TLS_LD_I32 (86)
# CHECK: Type: R_NANOMIPS_TLS_DTPREL12 (87)
# CHECK: Type: R_NANOMIPS_TLS_DTPREL16 (88)
# CHECK: Type: R_NANOMIPS_TLS_DTPREL_I32 (89)
# CHECK: Type: R_NANOMIPS_TLS_GOTTPREL (90)
# CHECK: Type: R_NANOMIPS_TLS_GOTTPREL_PC_I32 (91)
# CHECK: Type: R_NANOMIPS_TLS_TPREL12 (92)
# CHECK: Type: R_NANOMIPS_TLS_TPREL16 (93)
# CHECK: Type: R_NANOMIPS_TLS_TPREL_I32 (94)
# CHECK: Type: R_NANOMIPS_PC32 (248)

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_NANOMIPS
Sections:
  - Name: .rel.text
    Type: SHT_REL
    Relocations:
      - Type: R_NANOMIPS_NONE
      - Type: R_NANOMIPS_32
      - Type: R_NANOMIPS_64
      - Type: R_NANOMIPS_NEG
      - Type: R_NANOMIPS_ASHIFTR_1
      - Type: R_NANOMIPS_UNSIGNED_8
      - Type: R_NANOMIPS_SIGNED_8
      - Type: R_NANOMIPS_UNSIGNED_16
      - Type: R_NANOMIPS_SIGNED_16
      - Type: R_NANOMIPS_RELATIVE
      - Type: R_NANOMIPS_GLOBAL
      - Type: R_NANOMIPS_JUMP_SLOT
      - Type: R_NANOMIPS_IRELATIVE
      - Type: R_NANOMIPS_PC25_S1
      - Type: R_NANOMIPS_PC21_S1
      - Type: R_NANOMIPS_PC14_S1
      - Type: R_NANOMIPS_PC11_S1
      - Type: R_NANOMIPS_PC10_S1
      - Type: R_NANOMIPS_PC7_S1
      - Type: R_NANOMIPS_PC4_S1
      - Type: R_NANOMIPS_GPREL19_S2
      - Type: R_NANOMIPS_GPREL18_S3
      - Type: R_NANOMIPS_GPREL18
      - Type: R_NANOMIPS_GPREL17_S1
      - Type: R_NANOMIPS_GPREL16_S2
      - Type: R_NANOMIPS_GPREL7_S2
      - Type: R_NANOMIPS_GPREL_HI20
      - Type: R_NANOMIPS_PC_HI20
      - Type: R_NANOMIPS_HI20
      - Type: R_NANOMIPS_LO12
      - Type: R_NANOMIPS_GPREL_I32
      - Type: R_NANOMIPS_PC_I32
      - Type: R_NANOMIPS_I32
      - Type: R_NANOMIPS_GOT_DISP
      - Type: R_NANOMIPS_GOTPC_I32
      - Type: R_NANOMIPS_GOTPC_HI20
      - Type: R_NANOMIPS_GOT_LO12
      - Type: R_NANOMIPS_GOT_CALL
      - Type: R_NANOMIPS_GOT_PAGE
      - Type: R_NANOMIPS_GOT_OFST
      - Type: R_NANOMIPS_LO4_S2
      - Type: R_NANOMIPS_RESERVED1
      - Type: R_NANOMIPS_GPREL_LO12
      - Type: R_NANOMIPS_SCN_DISP
      - Type: R_NANOMIPS_COPY
      - Type: R_NANOMIPS_ALIGN
      - Type: R_NANOMIPS_FILL
      - Type: R_NANOMIPS_MAX
      - Type: R_NANOMIPS_INSN32
      - Type: R_NANOMIPS_FIXED
      - Type: R_NANOMIPS_NORELAX
      - Type: R_NANOMIPS_RELAX
      - Type: R_NANOMIPS_SAVERESTORE
      - Type: R_NANOMIPS_INSN16
      - Type: R_NANOMIPS_JALR32
      - Type: R_NANOMIPS_JALR16
      - Type: R_NANOMIPS_JUMPTABLE_LOAD
      - Type: R_NANOMIPS_FRAME_REG
      - Type: R_NANOMIPS_NOTRAMP
      - Type: R_NANOMIPS_TLS_DTPMOD
      - Type: R_NANOMIPS_TLS_DTPREL
      - Type: R_NANOMIPS_TLS_TPREL
      - Type: R_NANOMIPS_TLS_GD
      - Type: R_NANOMIPS_TLS_GD_I32
      - Type: R_NANOMIPS_TLS_LD
      - Type: R_NANOMIPS_TLS_LD_I32
      - Type: R_NANOMIPS_TLS_DTPREL12
      - Type: R_NANOMIPS_TLS_DTPREL16
      - Type: R_NANOMIPS_TLS_DTPREL_I32
      - Type: R_NANOMIPS_TLS_GOTTPREL
      - Type: R_NANOMIPS_TLS_GOTTPREL_PC_I32
      - Type: R_NANOMIPS_TLS_TPREL12
      - Type: R_NANOMIPS_TLS_TPREL16
      - Type: R_NANOMIPS_TLS_TPREL_I32
      - Type: R_NANOMIPS_PC32
