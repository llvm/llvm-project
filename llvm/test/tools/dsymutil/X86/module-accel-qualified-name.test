# The qualified name hash of a type in a module leaves the module out. LLDB
# qualifies a name with namespaces and types only, and would otherwise not
# find the definition of ns::S.

RUN: rm -rf %t && split-file %s %t
RUN: llc -O0 -mtriple=x86_64-apple-darwin -filetype=obj -o %t/Mod.pcm %t/Mod.ll
RUN: llc -O0 -mtriple=x86_64-apple-darwin -filetype=obj -o %t/1.o %t/1.ll

RUN: dsymutil --linker classic --accelerator=Apple -f -y %t/debug-map.map \
RUN:     -oso-prepend-path %t -o %t/classic.dwarf
RUN: llvm-dwarfdump --verify %t/classic.dwarf
RUN: llvm-dwarfdump --apple-types %t/classic.dwarf | FileCheck %s

RUN: dsymutil --linker parallel --accelerator=Apple -f -y %t/debug-map.map \
RUN:     -oso-prepend-path %t -o %t/parallel.dwarf
RUN: llvm-dwarfdump --verify %t/parallel.dwarf
RUN: llvm-dwarfdump --apple-types %t/parallel.dwarf | FileCheck %s

# The hash of "ns::S".
CHECK:      String: {{.*}} "S"
CHECK-NEXT: Data 0 [
CHECK-NEXT:   Atom[0]:
CHECK-NEXT:   Atom[1]: {{.*}} (DW_TAG_structure_type)
CHECK-NEXT:   Atom[2]:
CHECK-NEXT:   Atom[3]: 0x100595ad

#--- debug-map.map
---
triple:          'x86_64-apple-darwin'
objects:
  - filename: 1.o
    symbols:
      - { sym: _main, objAddr: 0x0, binAddr: 0x10000, size: 0x10 }
...

#--- Mod.ll
target triple = "x86_64-apple-darwin"

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!10, !11}

!0 = distinct !DICompileUnit(language: DW_LANG_C_plus_plus, file: !1,
                            producer: "test", emissionKind: FullDebug,
                            retainedTypes: !2, dwoId: 42)
!1 = !DIFile(filename: "Mod", directory: "")
!2 = !{!3}
!3 = !DICompositeType(tag: DW_TAG_structure_type, name: "S", scope: !4,
                      file: !1, line: 1, size: 32, elements: !6)
!4 = !DINamespace(name: "ns", scope: !5)
!5 = !DIModule(scope: null, name: "Mod")
!6 = !{!7}
!7 = !DIDerivedType(tag: DW_TAG_member, name: "x", scope: !3, file: !1,
                    line: 1, baseType: !8, size: 32)
!8 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
!10 = !{i32 2, !"Dwarf Version", i32 4}
!11 = !{i32 2, !"Debug Info Version", i32 3}

#--- 1.ll
target triple = "x86_64-apple-darwin"

define void @main() !dbg !100 { ret void }

!llvm.dbg.cu = !{!0, !20}
!llvm.module.flags = !{!10, !11}

!0 = distinct !DICompileUnit(language: DW_LANG_C_plus_plus, file: !1,
                            producer: "test", emissionKind: FullDebug)
!1 = !DIFile(filename: "1.cpp", directory: "")
!100 = distinct !DISubprogram(name: "main", scope: !1, file: !1, line: 1,
                              type: !101, unit: !0,
                              spFlags: DISPFlagDefinition)
!101 = !DISubroutineType(types: !102)
!102 = !{null}

; The skeleton unit referencing Mod.pcm. Its dwo id has to match Mod.ll's.
!20 = distinct !DICompileUnit(language: DW_LANG_C_plus_plus, file: !21,
                              producer: "test", emissionKind: FullDebug,
                              splitDebugFilename: "Mod.pcm", dwoId: 42)
!21 = !DIFile(filename: "Mod", directory: "")

!10 = !{i32 2, !"Dwarf Version", i32 4}
!11 = !{i32 2, !"Debug Info Version", i32 3}
