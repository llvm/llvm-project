## A DW_AT_specification cycle must not hang the qualified name hash of the
## Apple accelerator tables.
##
## a.cpp:
##   struct S { int x; };
##   extern "C" void use(S *) {}
##
## The assembly comes from:
##   clang -target arm64-apple-macosx15 -g -gdwarf-4 -O0 -S -fno-ident \
##     -fno-asynchronous-unwind-tables -fdebug-compilation-dir=/anon
## with the DW_AT_decl_file and DW_AT_decl_line of S replaced by a
## DW_AT_specification that refers to S itself.

# RUN: rm -rf %t && split-file %s %t
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/a.s -o %t/a.o

# RUN: dsymutil --linker=classic --accelerator=Apple -oso-prepend-path=%t \
# RUN:   -y %t/debug.map -f -o %t/classic.dwarf
# RUN: llvm-dwarfdump --verify %t/classic.dwarf
# RUN: llvm-dwarfdump --apple-types %t/classic.dwarf | FileCheck %s

# RUN: dsymutil --linker=parallel --accelerator=Apple -oso-prepend-path=%t \
# RUN:   -y %t/debug.map -f -o %t/parallel.dwarf
# RUN: llvm-dwarfdump --verify %t/parallel.dwarf
# RUN: llvm-dwarfdump --apple-types %t/parallel.dwarf | FileCheck %s

## The qualified name hash is that of a top-level "S".
# CHECK:      String: {{.*}} "S"
# CHECK-NEXT: Data 0 [
# CHECK-NEXT:   Atom[0]:
# CHECK-NEXT:   Atom[1]: {{.*}} (DW_TAG_structure_type)
# CHECK-NEXT:   Atom[2]:
# CHECK-NEXT:   Atom[3]: 0x0b87b16c

#--- debug.map
---
triple:          'arm64-apple-darwin'
objects:
  - filename: a.o
    symbols:
      - { sym: _use, objAddr: 0x0, binAddr: 0x10000, size: 0x10 }
...

#--- a.s
	.build_version macos, 15, 0
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_use                            ; -- Begin function use
	.p2align	2
_use:                                   ; @use
Lfunc_begin0:
	.file	1 "/anon" "a.cpp"
	.loc	1 2 0                           ; a.cpp:2:0
	.cfi_startproc
; %bb.0:                                ; %entry
	sub	sp, sp, #16
	.cfi_def_cfa_offset 16
	str	x0, [sp, #8]
Ltmp1:
	.loc	1 2 27 prologue_end epilogue_begin ; a.cpp:2:27
	add	sp, sp, #16
	ret
Ltmp2:
Lfunc_end0:
	.cfi_endproc
                                        ; -- End function
	.section	__DWARF,__debug_abbrev,regular,debug
Lsection_abbrev:
	.byte	1                               ; Abbreviation Code
	.byte	17                              ; DW_TAG_compile_unit
	.byte	1                               ; DW_CHILDREN_yes
	.byte	37                              ; DW_AT_producer
	.byte	14                              ; DW_FORM_strp
	.byte	19                              ; DW_AT_language
	.byte	5                               ; DW_FORM_data2
	.byte	3                               ; DW_AT_name
	.byte	14                              ; DW_FORM_strp
	.ascii	"\202|"                         ; DW_AT_LLVM_sysroot
	.byte	14                              ; DW_FORM_strp
	.byte	16                              ; DW_AT_stmt_list
	.byte	23                              ; DW_FORM_sec_offset
	.byte	27                              ; DW_AT_comp_dir
	.byte	14                              ; DW_FORM_strp
	.byte	17                              ; DW_AT_low_pc
	.byte	1                               ; DW_FORM_addr
	.byte	18                              ; DW_AT_high_pc
	.byte	6                               ; DW_FORM_data4
	.byte	0                               ; EOM(1)
	.byte	0                               ; EOM(2)
	.byte	2                               ; Abbreviation Code
	.byte	46                              ; DW_TAG_subprogram
	.byte	1                               ; DW_CHILDREN_yes
	.byte	17                              ; DW_AT_low_pc
	.byte	1                               ; DW_FORM_addr
	.byte	18                              ; DW_AT_high_pc
	.byte	6                               ; DW_FORM_data4
	.ascii	"\347\177"                      ; DW_AT_APPLE_omit_frame_ptr
	.byte	25                              ; DW_FORM_flag_present
	.byte	64                              ; DW_AT_frame_base
	.byte	24                              ; DW_FORM_exprloc
	.byte	3                               ; DW_AT_name
	.byte	14                              ; DW_FORM_strp
	.byte	58                              ; DW_AT_decl_file
