	.byte	0                               ; EOM(3)
	.section	__DWARF,__debug_info,regular,debug
Lsection_info:
Lcu_begin0:
Lset0 = Ldebug_info_end0-Ldebug_info_start0 ; Length of Unit
	.long	Lset0
Ldebug_info_start0:
	.short	4                               ; DWARF version number
Lset1 = Lsection_abbrev-Lsection_abbrev ; Offset Into Abbrev. Section
	.long	Lset1
	.byte	8                               ; Address Size (in bytes)
	.byte	1                               ; Abbrev [1] 0xb:0x66 DW_TAG_compile_unit
	.long	0                               ; DW_AT_producer
	.short	33                              ; DW_AT_language
	.long	1                               ; DW_AT_name
	.long	7                               ; DW_AT_LLVM_sysroot
Lset2 = Lline_table_start0-Lsection_line ; DW_AT_stmt_list
	.long	Lset2
	.long	9                               ; DW_AT_comp_dir
	.quad	Lfunc_begin0                    ; DW_AT_low_pc
Lset3 = Lfunc_end0-Lfunc_begin0         ; DW_AT_high_pc
	.long	Lset3
	.byte	2                               ; Abbrev [2] 0x2e:0x20 DW_TAG_subprogram
	.quad	Lfunc_begin0                    ; DW_AT_low_pc
Lset4 = Lfunc_end0-Lfunc_begin0         ; DW_AT_high_pc
	.long	Lset4
                                        ; DW_AT_APPLE_omit_frame_ptr
	.byte	1                               ; DW_AT_frame_base
