Ldebug_info_end0:
	.section	__DWARF,__debug_str,regular,debug
Linfo_string:
	.byte	0                               ; string offset=0 ; 
	.asciz	"a.cpp"                         ; string offset=1 ; a.cpp
	.asciz	"/"                             ; string offset=7 ; /
	.asciz	"/anon"                         ; string offset=9 ; /anon
	.asciz	"use"                           ; string offset=15 ; use
	.asciz	"S"                             ; string offset=19 ; S
	.asciz	"x"                             ; string offset=21 ; x
	.asciz	"int"                           ; string offset=23 ; int
