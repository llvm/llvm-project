	.byte	145
	.byte	8
	.byte	1                               ; DW_AT_decl_file
	.byte	2                               ; DW_AT_decl_line
	.long	78                              ; DW_AT_type
	.byte	0                               ; End Of Children Mark
	.byte	4                               ; Abbrev [4] 0x4e:0x5 DW_TAG_pointer_type
	.long	83                              ; DW_AT_type
