## The name of an unnamed type must not grow with its nesting depth. Names
## built from the full contents of the nested types would take memory
## exponential in the depth, here 2^20 copies of the innermost member.
## Two units differ only in the innermost member type and must stay apart.
##
## a.cpp nests 20 unnamed structs, each declaring two members of the next one,
## around "int a;". b.cpp does the same around "float a;":
##   extern struct { ... struct { int a; } x, y; ... } x, y;
##   extern "C" void useA(decltype(x) *p) { (void)p; }
##
## The assembly comes from:
##   clang -target arm64-apple-macosx15 -g -gdwarf-5 -O0 -S -fno-ident \
##     -fno-asynchronous-unwind-tables -fdebug-compilation-dir=/nested

# RUN: rm -rf %t && split-file %s %t
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/a.s -o %t/a.o
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/b.s -o %t/b.o
# RUN: dsymutil --linker=parallel -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/parallel.dwarf
# RUN: llvm-dwarfdump --verify %t/parallel.dwarf
# RUN: llvm-dwarfdump --debug-info %t/parallel.dwarf | FileCheck %s

## All 40 structs are distinct.
# CHECK-COUNT-40: DW_TAG_structure_type
# CHECK-NOT:      DW_TAG_structure_type

#--- debug.map
---
triple:          'arm64-apple-darwin'
objects:
  - filename: a.o
    symbols:
      - { sym: _useA, objAddr: 0x0, binAddr: 0x10000, size: 0x8 }
  - filename: b.o
    symbols:
      - { sym: _useB, objAddr: 0x0, binAddr: 0x10020, size: 0x8 }
...

#--- a.s
	.build_version macos, 15, 0
	.section	__TEXT,__text,regular,pure_instructions
	.globl	_useA                           ; -- Begin function useA
	.p2align	2
_useA:                                  ; @useA
Lfunc_begin0:
	.file	0 "/nested" "a.cpp" md5 0x0859c46964f3ae1a11a402b1ac47fa96
	.loc	0 2 0                           ; a.cpp:2:0
	.cfi_startproc
; %bb.0:                                ; %entry
	sub	sp, sp, #16
	.cfi_def_cfa_offset 16
	str	x0, [sp, #8]
Ltmp1:
	.loc	0 2 49 prologue_end epilogue_begin ; a.cpp:2:49
	add	sp, sp, #16
	ret
Ltmp2:
Lfunc_end0:
	.cfi_endproc
                                        ; -- End function
