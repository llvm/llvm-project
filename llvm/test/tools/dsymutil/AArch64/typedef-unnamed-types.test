## Typedefs with the same name and declaration that refer to unnamed types with
## different contents must stay apart, while equal ones are still merged.
##
## types.h:
##   typedef UNDERLYING_TYPE MyType;
## a.cpp and c.cpp (with useC):
##   #define UNDERLYING_TYPE struct { int x; }
##   #include "types.h"
##   extern "C" void useA(MyType *) {}
## b.cpp:
##   #define UNDERLYING_TYPE struct { float y; }
##   #include "types.h"
##   extern "C" void useB(MyType *) {}
##
## The assembly comes from:
##   clang -target arm64-apple-macosx15 -g -gdwarf-5 -O0 -S -fno-ident \
##     -fno-asynchronous-unwind-tables -fdebug-compilation-dir=/anon

# RUN: rm -rf %t && split-file %s %t
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/a.s -o %t/a.o
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/b.s -o %t/b.o
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/c.s -o %t/c.o

# RUN: dsymutil --linker=classic -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/classic.dwarf
# RUN: llvm-dwarfdump --verify %t/classic.dwarf
# RUN: llvm-dwarfdump --debug-info %t/classic.dwarf | FileCheck %s \
# RUN:   --check-prefix=CLASSIC --implicit-check-not=DW_TAG_typedef \
# RUN:   --implicit-check-not=DW_TAG_structure_type

# RUN: dsymutil --linker=parallel -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/parallel.dwarf
# RUN: llvm-dwarfdump --verify %t/parallel.dwarf
# RUN: llvm-dwarfdump --debug-info %t/parallel.dwarf | FileCheck %s \
# RUN:   --check-prefix=PARALLEL --implicit-check-not=DW_TAG_typedef \
# RUN:   --implicit-check-not=DW_TAG_structure_type

# CLASSIC:      DW_AT_name{{.*}}"a.cpp"
# CLASSIC:      0x[[INT_TYPEDEF:[0-9a-f]+]]: DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[INT_BOX:[0-9a-f]+]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"MyType"
# CLASSIC:      0x[[INT_BOX]]: DW_TAG_structure_type
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"x"

# CLASSIC:      DW_AT_name{{.*}}"b.cpp"
# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[FLOAT_BOX:[0-9a-f]+]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"MyType"
# CLASSIC:      0x[[FLOAT_BOX]]: DW_TAG_structure_type
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"y"

# CLASSIC:      DW_AT_name{{.*}}"c.cpp"
# CLASSIC:      DW_TAG_pointer_type
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[INT_TYPEDEF]] "MyType")

# PARALLEL:      DW_AT_name{{.*}}"__artificial_type_unit"
# PARALLEL:      0x[[FLOAT_PTR:[0-9a-f]+]]: DW_TAG_pointer_type
# PARALLEL-NEXT:   DW_AT_type{{.*}}(0x[[FLOAT_TYPEDEF:[0-9a-f]+]] "MyType")
# PARALLEL:      0x[[INT_PTR:[0-9a-f]+]]: DW_TAG_pointer_type
# PARALLEL-NEXT:   DW_AT_type{{.*}}(0x[[INT_TYPEDEF:[0-9a-f]+]] "MyType")
# PARALLEL:      0x[[FLOAT_BOX:[0-9a-f]+]]: DW_TAG_structure_type
# PARALLEL:        DW_TAG_member
# PARALLEL-NEXT:     DW_AT_name{{.*}}"y"
# PARALLEL:      0x[[INT_BOX:[0-9a-f]+]]: DW_TAG_structure_type
# PARALLEL:        DW_TAG_member
# PARALLEL-NEXT:     DW_AT_name{{.*}}"x"
# PARALLEL:      0x[[FLOAT_TYPEDEF]]: DW_TAG_typedef
# PARALLEL-NEXT:   DW_AT_type{{.*}}(0x[[FLOAT_BOX]] "structure ")
# PARALLEL-NEXT:   DW_AT_name{{.*}}"MyType"
# PARALLEL:      0x[[INT_TYPEDEF]]: DW_TAG_typedef
# PARALLEL-NEXT:   DW_AT_type{{.*}}(0x[[INT_BOX]] "structure ")
# PARALLEL-NEXT:   DW_AT_name{{.*}}"MyType"

# PARALLEL:      DW_AT_name{{.*}}"a.cpp"
# PARALLEL:      DW_TAG_formal_parameter
# PARALLEL-NOT:  DW_TAG
# PARALLEL:        DW_AT_type{{.*}}(0x00000000[[INT_PTR]] "MyType *")
# PARALLEL:      DW_AT_name{{.*}}"b.cpp"
# PARALLEL:      DW_TAG_formal_parameter
# PARALLEL-NOT:  DW_TAG
# PARALLEL:        DW_AT_type{{.*}}(0x00000000[[FLOAT_PTR]] "MyType *")
# PARALLEL:      DW_AT_name{{.*}}"c.cpp"
# PARALLEL:      DW_TAG_formal_parameter
# PARALLEL-NOT:  DW_TAG
# PARALLEL:        DW_AT_type{{.*}}(0x00000000[[INT_PTR]] "MyType *")

#--- debug.map
---
triple:          'arm64-apple-darwin'
objects:
  - filename: a.o
    symbols:
      - { sym: _useA, objAddr: 0x0, binAddr: 0x10000, size: 0x10 }
  - filename: b.o
    symbols:
      - { sym: _useB, objAddr: 0x0, binAddr: 0x10020, size: 0x10 }
  - filename: c.o
    symbols:
      - { sym: _useC, objAddr: 0x0, binAddr: 0x10040, size: 0x10 }
...

