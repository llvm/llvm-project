## Pointers to members of different classes are different types, even when the
## members have the same type.
##
## a.cpp:
##   struct A { int x; };
##   struct B { int y; };
##   int A::*pa = &A::x;
##   int B::*pb = &B::y;
##
## The assembly comes from:
##   clang -target arm64-apple-macosx15 -isysroot / -g -gdwarf-5 -O0 -S \
##     -fno-ident -fno-asynchronous-unwind-tables -fdebug-compilation-dir=/ptm

# RUN: rm -rf %t && split-file %s %t
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/a.s -o %t/a.o

# RUN: dsymutil --linker=classic -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/classic.dwarf
# RUN: llvm-dwarfdump --verify %t/classic.dwarf
# RUN: llvm-dwarfdump --debug-info %t/classic.dwarf | FileCheck %s

# RUN: dsymutil --linker=parallel -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/parallel.dwarf
# RUN: llvm-dwarfdump --verify %t/parallel.dwarf
# RUN: llvm-dwarfdump --debug-info %t/parallel.dwarf | FileCheck %s

# CHECK:      DW_AT_name{{.*}}"pa"
# CHECK-NEXT: DW_AT_type{{.*}}"int A::*"
# CHECK:      DW_AT_name{{.*}}"pb"
# CHECK-NEXT: DW_AT_type{{.*}}"int B::*"

#--- debug.map
---
triple:          'arm64-apple-darwin'
objects:
  - filename: a.o
    symbols:
      - { sym: _pa, objAddr: 0x240, binAddr: 0x10000, size: 0x8 }
      - { sym: _pb, objAddr: 0x248, binAddr: 0x10008, size: 0x8 }
...

#--- a.s
	.build_version macos, 15, 0
	.file	0 "/ptm" "a.cpp" md5 0xa97ccac8194adc2f1680115f112cdb66
	.globl	_pa                             ; @pa
.zerofill __DATA,__common,_pa,8,3
	.globl	_pb                             ; @pb
.zerofill __DATA,__common,_pb,8,3
	.section	__DWARF,__debug_abbrev,regular,debug
Lsection_abbrev:
	.byte	1                               ; Abbreviation Code
