## Unnamed types declared on one line must stay apart, while the same type from
## different units is still merged.
##
## types.h declares two unnamed types per line, of different sizes on the first
## line and of the same size on the others:
##   typedef struct { int a; int b; } Inner; typedef struct { Inner x; int c; } Outer;
##   typedef struct { int i; } IntBox; typedef struct { float f; } FloatBox;
##   typedef enum { Red } Color; typedef enum { Cat } Animal;
## a.cpp:
##   extern "C" void useA(Outer *, IntBox *, Color *) {}
## b.cpp:
##   extern "C" void useB(Outer *, FloatBox *, Animal *) {}
##
## The assembly comes from:
##   clang -target arm64-apple-macosx15 -g -gdwarf-5 -O0 -S -fno-ident \
##     -fno-asynchronous-unwind-tables -fdebug-compilation-dir=/anon

# RUN: rm -rf %t && split-file %s %t
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/a.s -o %t/a.o
# RUN: llvm-mc -triple arm64-apple-darwin -filetype=obj %t/b.s -o %t/b.o

## Each struct and enum must appear exactly once.

# RUN: dsymutil --linker=classic -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/classic.dwarf
# RUN: llvm-dwarfdump --verify %t/classic.dwarf
# RUN: llvm-dwarfdump --debug-info %t/classic.dwarf | FileCheck %s \
# RUN:   --check-prefix=CLASSIC --implicit-check-not=DW_TAG_structure_type \
# RUN:   --implicit-check-not=DW_TAG_enumeration_type

# RUN: dsymutil --linker=parallel -oso-prepend-path=%t -y %t/debug.map -f \
# RUN:   -o %t/parallel.dwarf
# RUN: llvm-dwarfdump --verify %t/parallel.dwarf
# RUN: llvm-dwarfdump --debug-info %t/parallel.dwarf | FileCheck %s \
# RUN:   --check-prefix=PARALLEL --implicit-check-not=DW_TAG_structure_type \
# RUN:   --implicit-check-not=DW_TAG_enumeration_type

# CLASSIC:      DW_AT_name{{.*}}"a.cpp"
# CLASSIC:      0x[[RED:[0-9a-f]+]]: DW_TAG_enumeration_type
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_enumerator
# CLASSIC-NEXT:     DW_AT_name{{.*}}"Red"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        NULL

# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[OUTER:[0-9a-f]+]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"Outer"
# CLASSIC:      0x[[OUTER]]: DW_TAG_structure_type
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"x"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"c"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        NULL

# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[INNER:[0-9a-f]+]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"Inner"
# CLASSIC:      0x[[INNER]]: DW_TAG_structure_type
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"a"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"b"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        NULL

# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[INTBOX:[0-9a-f]+]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"IntBox"
# CLASSIC:      0x[[INTBOX]]: DW_TAG_structure_type
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"i"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        NULL

# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[RED]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"Color"

# CLASSIC:      DW_AT_name{{.*}}"b.cpp"
# CLASSIC:      0x[[CAT:[0-9a-f]+]]: DW_TAG_enumeration_type
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_enumerator
# CLASSIC-NEXT:     DW_AT_name{{.*}}"Cat"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        NULL

# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[FLOATBOX:[0-9a-f]+]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"FloatBox"
# CLASSIC:      0x[[FLOATBOX]]: DW_TAG_structure_type
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        DW_TAG_member
# CLASSIC-NEXT:     DW_AT_name{{.*}}"f"
# CLASSIC-NOT:  DW_TAG
# CLASSIC:        NULL

# CLASSIC:      DW_TAG_typedef
# CLASSIC-NEXT:   DW_AT_type{{.*}}(0x00000000[[CAT]]
# CLASSIC-NEXT:   DW_AT_name{{.*}}"Animal"

## The parallel linker moves all types into the artificial type unit.

# PARALLEL:     DW_AT_name{{.*}}"__artificial_type_unit"
# PARALLEL:     0x[[CAT:[0-9a-f]+]]: DW_TAG_enumeration_type
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_enumerator
# PARALLEL-NEXT:    DW_AT_name{{.*}}"Cat"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       NULL

# PARALLEL:     0x[[RED:[0-9a-f]+]]: DW_TAG_enumeration_type
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_enumerator
# PARALLEL-NEXT:    DW_AT_name{{.*}}"Red"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       NULL

# PARALLEL:     0x[[OUTER:[0-9a-f]+]]: DW_TAG_structure_type
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_member
# PARALLEL-NEXT:    DW_AT_name{{.*}}"x"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_member
# PARALLEL-NEXT:    DW_AT_name{{.*}}"c"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       NULL

# PARALLEL:     0x[[INNER:[0-9a-f]+]]: DW_TAG_structure_type
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_member
# PARALLEL-NEXT:    DW_AT_name{{.*}}"a"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_member
# PARALLEL-NEXT:    DW_AT_name{{.*}}"b"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       NULL

# PARALLEL:     0x[[INTBOX:[0-9a-f]+]]: DW_TAG_structure_type
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_member
# PARALLEL-NEXT:    DW_AT_name{{.*}}"i"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       NULL

# PARALLEL:     0x[[FLOATBOX:[0-9a-f]+]]: DW_TAG_structure_type
# PARALLEL-NOT: DW_TAG
# PARALLEL:       DW_TAG_member
# PARALLEL-NEXT:    DW_AT_name{{.*}}"f"
# PARALLEL-NOT: DW_TAG
# PARALLEL:       NULL

# PARALLEL:     DW_TAG_typedef
# PARALLEL-NEXT:  DW_AT_type{{.*}}(0x[[CAT]]
# PARALLEL-NEXT:  DW_AT_name{{.*}}"Animal"
# PARALLEL:     DW_TAG_typedef
# PARALLEL-NEXT:  DW_AT_type{{.*}}(0x[[RED]]
# PARALLEL-NEXT:  DW_AT_name{{.*}}"Color"
# PARALLEL:     DW_TAG_typedef
# PARALLEL-NEXT:  DW_AT_type{{.*}}(0x[[FLOATBOX]]
# PARALLEL-NEXT:  DW_AT_name{{.*}}"FloatBox"
# PARALLEL:     DW_TAG_typedef
# PARALLEL-NEXT:  DW_AT_type{{.*}}(0x[[INNER]]
# PARALLEL-NEXT:  DW_AT_name{{.*}}"Inner"
# PARALLEL:     DW_TAG_typedef
# PARALLEL-NEXT:  DW_AT_type{{.*}}(0x[[INTBOX]]
# PARALLEL-NEXT:  DW_AT_name{{.*}}"IntBox"
# PARALLEL:     DW_TAG_typedef
# PARALLEL-NEXT:  DW_AT_type{{.*}}(0x[[OUTER]]
# PARALLEL-NEXT:  DW_AT_name{{.*}}"Outer"

#--- debug.map
---
triple:          'arm64-apple-darwin'
objects:
  - filename: a.o
    symbols:
      - { sym: _useA, objAddr: 0x0, binAddr: 0x10000, size: 0x18 }
  - filename: b.o
    symbols:
      - { sym: _useB, objAddr: 0x0, binAddr: 0x10020, size: 0x18 }
...

#--- a.s
