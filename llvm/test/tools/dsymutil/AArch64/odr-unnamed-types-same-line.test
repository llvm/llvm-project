	.cfi_startproc
; %bb.0:                                ; %entry
	sub	sp, sp, #32
	.cfi_def_cfa_offset 32
	str	x0, [sp, #24]
	str	x1, [sp, #16]
	str	x2, [sp, #8]
Ltmp1:
	.loc	0 2 51 prologue_end epilogue_begin ; a.cpp:2:51
	add	sp, sp, #32
	ret
Ltmp2:
Lfunc_end0:
	.cfi_endproc
