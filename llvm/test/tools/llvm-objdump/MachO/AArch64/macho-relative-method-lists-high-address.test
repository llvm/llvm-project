# RUN: split-file %s %t
# RUN: yaml2obj %t/main.yaml -o %t/main
# RUN: llvm-objdump --macho --objc-meta-data %t/main | FileCheck %s
# RUN: llvm-otool -ov %t/main | FileCheck %s

# CHECK:      baseMethods 0x[[#%.9x,]] (struct method_list_t *)
# CHECK-NEXT: entsize 12 (relative)
# CHECK-NEXT: count 1
# CHECK-NEXT: name 0x[[#%x,]] (0x[[#%.9x,]]) method
# CHECK-NEXT: types 0x[[#%x,]] (0x[[#%.9x,]]) i16@0:8
# CHECK-NEXT: imp 0x[[#%x,]] (0x[[#%.9x,]]) -[MyClass method]

#--- main.m
__attribute__((objc_root_class))
@interface MyClass
- (int)method;
@end
@implementation MyClass
- (int)method { return 42; }
@end
void *_objc_empty_cache;
void *_objc_empty_vtable;
int main() { return 0; }

#--- gen
clang -target arm64-apple-macos11.0 -c main.m -o main.o
ld64.lld -arch arm64 -platform_version macos 11.0 11.0 -no_fixup_chains main.o -o main
# Normalize the UUID and remove trailing spaces.
obj2yaml main | sed 's/\(uuid: *\).*/\100000000-0000-0000-0000-000000000000/; s/ *$//'

#--- main.yaml
