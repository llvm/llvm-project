# REQUIRES: aarch64-registered-target

## Check that disassembly names the Objective-C selector and class references
## that instructions load when the references are chained fixups. Each slot then
## holds an encoded rebase or bind rather than the address it resolves to, and
## these three rebases and the bind form a single chain.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: yaml2obj main.yaml -o main
# RUN: llvm-objdump --macho -d --no-show-raw-insn main | FileCheck %s

# CHECK:      _main:
# CHECK-NEXT: adrp x1, {{.*}}
# CHECK-NEXT: ldr x1, [x1] ; Objc selector ref: foo
# CHECK-NEXT: adrp x1, {{.*}}
# CHECK-NEXT: ldr x1, [x1, #0x8] ; Objc selector ref: bar
# CHECK-NEXT: adrp x1, {{.*}}
# CHECK-NEXT: ldr x1, [x1, #0x10] ; Objc selector ref: baz
# CHECK-NEXT: adrp x0, {{.*}}
# CHECK-NEXT: ldr x0, [x0, #0x18] ; Objc class ref: _OBJC_CLASS_$_Foo
# CHECK-NEXT: ret

## The chained binds also name bound class references in --objc-meta-data.
# RUN: llvm-objdump --macho --objc-meta-data main | FileCheck %s --check-prefix=META

# META:      Contents of (__DATA,__objc_classrefs) section
# META-NEXT: 0000000100001018 {{.*}} _OBJC_CLASS_$_Foo

## libObject does not decode every pointer format; one it leaves out is
## DYLD_CHAINED_PTR_ARM64E_USERLAND (9). With such a format llvm-objdump warns
## and reads the pointers as they are. The sed changes the pointer_format, which
## follows the page_size of 0x1000, from 1 to 9.
# RUN: sed 's/0x0, 0x10, 0x1, 0x0, 0x0, 0x10,/0x0, 0x10, 0x9, 0x0, 0x0, 0x10,/' \
# RUN:   main.yaml | yaml2obj -o format9
# RUN: llvm-objdump --macho -d --no-show-raw-insn format9 2>err \
# RUN:   | FileCheck %s --check-prefix=FORMAT9
# RUN: FileCheck %s --check-prefix=WARN --input-file=err
# RUN: llvm-objdump --macho --objc-meta-data format9 2>err \
# RUN:   | FileCheck %s --check-prefix=META9
# RUN: FileCheck %s --check-prefix=WARN --input-file=err

# FORMAT9:      _main:
# FORMAT9:      ret
# META9:        Contents of (__DATA,__objc_classrefs) section
# META9-NEXT:   0000000100001018 0x{{[0-9a-f]+$}}
# WARN: warning: 'format9': segment 2 has unsupported chained fixup pointer_format 9

## gen links the image with Xcode's ld; the YAML below comes from ld-27037.1. To
## regenerate it, run llvm/utils/update_test_body.py on macOS, with obj2yaml on
## PATH.

#--- foo.s
.section __DATA,__objc_data
.globl _OBJC_CLASS_$_Foo
_OBJC_CLASS_$_Foo:
  .quad 0

#--- main.s
.globl _main
.p2align 2
_main:
  adrp x1, L_foo@PAGE
  ldr x1, [x1, L_foo@PAGEOFF]
  adrp x1, L_bar@PAGE
  ldr x1, [x1, L_bar@PAGEOFF]
  adrp x1, L_baz@PAGE
  ldr x1, [x1, L_baz@PAGEOFF]
  adrp x0, L_classref@PAGE
  ldr x0, [x0, L_classref@PAGEOFF]
  ret

.section __TEXT,__objc_methname,cstring_literals
L_foo_name:
  .asciz "foo"
L_bar_name:
  .asciz "bar"
L_baz_name:
  .asciz "baz"

.section __DATA,__objc_selrefs,literal_pointers,no_dead_strip
.p2align 3
L_foo:
  .quad L_foo_name
L_bar:
  .quad L_bar_name
L_baz:
  .quad L_baz_name

.section __DATA,__objc_classrefs,regular,no_dead_strip
.p2align 3
L_classref:
  .quad _OBJC_CLASS_$_Foo

#--- gen
sdk=$(xcrun --sdk macosx --show-sdk-path)
xcrun clang -target arm64e-apple-macos11.0 -c foo.s main.s
xcrun ld -arch arm64e -syslibroot "$sdk" -platform_version macos 11.0 27.0 \
  -lSystem -dylib -install_name @executable_path/libfoo.dylib foo.o \
  -o libfoo.dylib
xcrun ld -arch arm64e -syslibroot "$sdk" -platform_version macos 11.0 27.0 \
  -lSystem -segalign 0x1000 main.o libfoo.dylib -o main
# Zero LC_UUID and drop the trailing spaces that obj2yaml leaves. obj2yaml also
# leaves out the byte order when it is the host's, so pin it.
clean='s/\(uuid: *\).*/\100000000-0000-0000-0000-000000000000/; s/ *$//'
obj2yaml main | sed "$clean" | sed '1a\
IsLittleEndian: true'

#--- main.yaml
--- !mach-o
