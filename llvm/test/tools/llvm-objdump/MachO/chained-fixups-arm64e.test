    filesize:        536
    maxprot:         1
    initprot:        1
    nsects:          0
    flags:           0
  - cmd:             LC_DYLD_CHAINED_FIXUPS
    cmdsize:         16
    dataoff:         8192
    datasize:        120
  - cmd:             LC_DYLD_EXPORTS_TRIE
    cmdsize:         16
    dataoff:         8312
    datasize:        48
  - cmd:             LC_SYMTAB
    cmdsize:         24
    symoff:          8368
    nsyms:           5
    stroff:          8448
    strsize:         48
  - cmd:             LC_DYSYMTAB
    cmdsize:         80
    ilocalsym:       0
    nlocalsym:       2
    iextdefsym:      2
    nextdefsym:      2
    iundefsym:       4
    nundefsym:       1
    tocoff:          0
