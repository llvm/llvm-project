                     0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x18, 0x0, 0x0, 0x0,
                     0x0, 0x10, [[FORMAT]], 0x0, 0x0, 0x10, 0x0, 0x0, 0x0, 0x0,
