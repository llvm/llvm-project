    flags:           0
    Sections:
      - sectname:        __data
        segname:         __DATA
        addr:            0x100001000
        size:            72
        offset:          0x1000
        align:           3
        reloff:          0x0
        nreloc:          0
        flags:           0x0
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         0000000000000000B403000000000880BC03000034120B80000000002A000CC002000000FFFF0FC001000000010008C0B4030000[[TARGET_HI]]000800000000000800084000100000[[TARGET_HI]]900000
  - cmd:             LC_SEGMENT_64
    cmdsize:         72
