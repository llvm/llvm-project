    nlocrel:         0
  - cmd:             LC_LOAD_DYLINKER
    cmdsize:         32
    name:            12
    Content:         '/usr/lib/dyld'
    ZeroPadBytes:    7
  - cmd:             LC_UUID
    cmdsize:         24
    uuid:            00000000-0000-0000-0000-000000000000
  - cmd:             LC_BUILD_VERSION
    cmdsize:         32
    platform:        1
    minos:           [[MINOS]]
    sdk:             1769472
    ntools:          1
    Tools:
      - tool:            3
        version:         1771897088
  - cmd:             LC_SOURCE_VERSION
    cmdsize:         16
    version:         0
  - cmd:             LC_MAIN
    cmdsize:         24
    entryoff:        944
    stacksize:       0
  - cmd:             LC_LOAD_DYLIB
    cmdsize:         56
    dylib:
      name:            24
      timestamp:       2
      current_version: 89063424
      compatibility_version: 65536
    Content:         '/usr/lib/libSystem.B.dylib'
    ZeroPadBytes:    6
  - cmd:             LC_LOAD_DYLIB
    cmdsize:         56
    dylib:
      name:            24
      timestamp:       2
      current_version: 0
      compatibility_version: 0
    Content:         '@executable_path/libfoo.dylib'
    ZeroPadBytes:    3
  - cmd:             LC_FUNCTION_STARTS
    cmdsize:         16
