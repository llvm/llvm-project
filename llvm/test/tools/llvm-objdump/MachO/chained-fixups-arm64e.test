## Check that llvm-objdump and llvm-otool decode the arm64e chained fixup
## formats DYLD_CHAINED_PTR_ARM64E and DYLD_CHAINED_PTR_ARM64E_USERLAND24,
## including the signing schema of authenticated rebases and binds.

# RUN: yaml2obj -DMINOS=0xB0000 -DFORMAT=0x1 -DTARGET_HI=01 %s -o %t.arm64e
# RUN: yaml2obj -DMINOS=0xD0000 -DFORMAT=0xC -DTARGET_HI=00 %s -o %t.userland24

# RUN: llvm-objdump --macho --chained-fixups %t.arm64e | \
# RUN:     FileCheck --check-prefix=FORMAT1 %s
# RUN: llvm-objdump --macho --chained-fixups %t.userland24 | \
# RUN:     FileCheck --check-prefix=FORMAT12 %s

# FORMAT1:  pointer_format = 1 (DYLD_CHAINED_PTR_ARM64E)
# FORMAT12: pointer_format = 12 (DYLD_CHAINED_PTR_ARM64E_USERLAND24)

# RUN: llvm-objdump --macho --dyld-info %t.arm64e | \
# RUN:     FileCheck --check-prefixes=CHECK,ARM64E -DNAME=%t.arm64e %s
# RUN: llvm-otool -dyld_info %t.arm64e | \
# RUN:     FileCheck --check-prefixes=CHECK,ARM64E -DNAME=%t.arm64e %s
# RUN: llvm-objdump --macho --dyld-info %t.userland24 | \
# RUN:     FileCheck --check-prefixes=CHECK,USERLAND24 -DNAME=%t.userland24 %s

## The two images differ only in the encoding of the unauthenticated rebases:
## DYLD_CHAINED_PTR_ARM64E stores their target address, and
## DYLD_CHAINED_PTR_ARM64E_USERLAND24 its offset from the image. The target of
## an authenticated rebase is an offset from the image in both formats. The
## decoded values match the output of dyld_info -fixups. cctools-1040's otool
## prints the same columns, but shows the offset of an authenticated rebase
## (0x3B4) where llvm-objdump shows its address, as for every other rebase.
# CHECK:           [[NAME]]:
# CHECK-NEXT:      dyld information:
# CHECK-NEXT:      segment section address pointer type div addr key addend dylib symbol/vm address
# CHECK-NEXT:      __DATA __data 0x100001008 0x80080000000003B4 rebase 0x0000 false IA 0x1000003B4
# CHECK-NEXT:      __DATA __data 0x100001010 0x800B1234000003BC rebase 0x1234 true IB 0x1000003BC
# CHECK-NEXT:      __DATA __data 0x100001018 0xC00C002A00000000 bind 0x002A false DA 0x0 libfoo _foo
# CHECK-NEXT:      __DATA __data 0x100001020 0xC00FFFFF00000002 bind 0xFFFF true DB 0x10 libfoo _foo
# CHECK-NEXT:      __DATA __data 0x100001028 0xC008000100000001 bind 0x0001 false IA 0xFFFFFFFFFFFFFFFC libfoo _foo
# ARM64E-NEXT:     __DATA __data 0x100001030 0x00080001000003B4 rebase 0x1000003B4
# USERLAND24-NEXT: __DATA __data 0x100001030 0x00080000000003B4 rebase 0x1000003B4
# CHECK-NEXT:      __DATA __data 0x100001038 0x4008000800000000 bind 0x8 libfoo _foo
# ARM64E-NEXT:     __DATA __data 0x100001040 0x0000900100001000 rebase 0x1200000100001000
# USERLAND24-NEXT: __DATA __data 0x100001040 0x0000900000001000 rebase 0x1200000100001000
# CHECK-NOT:       {{.}}

## The YAML below is the obj2yaml output, with LC_UUID zeroed, of an image
## that Xcode 27's ld (ld-27037.1) linked from the following files. MINOS
## selects the deployment target that makes the linker choose each format,
## FORMAT is the pointer_format, and TARGET_HI is bits 32-39 of the two
## unauthenticated rebases at 0x100001030 and 0x100001040, which hold the
## 0x100000000 image base only in DYLD_CHAINED_PTR_ARM64E.
##
## --- foo.s:
##   .globl _foo
##   _foo:
##     ret
##
## --- chained-fixups-arm64e.s:
##   .globl _main
##   .p2align 2
##   _main:
##     ret
##   _local:
##     ret
##
##   .data
##   .p2align 3
##   _target:
##     .quad 0
##     .quad _local@AUTH(ia,0)
##     .quad (_local + 8)@AUTH(ib,0x1234,addr)
##     .quad _foo@AUTH(da,42)
##     .quad (_foo + 16)@AUTH(db,0xffff,addr)
##     .quad (_foo - 4)@AUTH(ia,1)
##     .quad _local
##     .quad _foo + 8
##     .quad _target + 0x1200000000000000
##
## $ clang -target arm64e-apple-macos11.0 -c foo.s
## $ ld -arch arm64e -platform_version macos 11.0 27.0 -lSystem -dylib \
##       -install_name @executable_path/libfoo.dylib foo.o -o libfoo.dylib
## $ clang -target arm64e-apple-macos11.0 -c chained-fixups-arm64e.s
## $ ld -arch arm64e -platform_version macos 11.0 27.0 -lSystem -segalign 0x1000 \
##       chained-fixups-arm64e.o libfoo.dylib -o chained-fixups-arm64e
## $ ld -arch arm64e -platform_version macos 13.0 27.0 -lSystem -segalign 0x1000 \
##       chained-fixups-arm64e.o libfoo.dylib -o chained-fixups-arm64e-userland24
## $ obj2yaml chained-fixups-arm64e

--- !mach-o
FileHeader:
  magic:           0xFEEDFACF
  cputype:         0x100000C
  cpusubtype:      0x81000002
  filetype:        0x2
  ncmds:           18
  sizeofcmds:      872
  flags:           0x200085
  reserved:        0x0
