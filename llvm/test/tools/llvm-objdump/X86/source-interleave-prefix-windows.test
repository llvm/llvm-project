;; Test --prefix option platform specific behavior.
; REQUIRES: system-windows

;; Test removal of trailing separators (both '/' and '\' on Windows systems).
;; The prefix 'myprefix/\' is changed to 'myprefix'.

; RUN: sed -e "s,SRC_COMPDIR,/Inputs,g" %p/Inputs/source-interleave.ll > %t.ll
; RUN: llc -o %t.o -filetype=obj -mtriple=x86_64-pc-linux %t.ll
; RUN: llvm-objdump --prefix 'myprefix/\' --source %t.o 2>&1 | FileCheck %s -DFILE=%t.o -DPREFIX='myprefix' -DSEP=%{fs-sep}

;; The compilation directory '/Inputs' is joined to the file name using the
;; preferred separator, producing a mixed-style path. It is normalized before
;; --prefix is applied, so all separators after the prefix are the host's preferred value.
;; sys::path::append then joins it to the prefix without adding a separator
;; because the path already starts with one.
; CHECK: warning: '[[FILE]]': failed to find source [[PREFIX]][[SEP]]Inputs[[SEP]]source-interleave-x86_64.c

;; Only the path taken from the debug info is normalized. Separators inside the
;; prefix are kept as spelled, even though both '/' and '\' are separators here,
;; so 'my/pre\fix' is not rewritten to 'my\pre\fix'.

; RUN: llvm-objdump --prefix 'my/pre\fix' --source %t.o 2>&1 | \
; RUN:   FileCheck %s -DFILE=%t.o -DPREFIX='my/pre\fix' -DSEP=%{fs-sep}
