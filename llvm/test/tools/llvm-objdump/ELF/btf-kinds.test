# REQUIRES: x86-registered-target
# RUN: yaml2obj %s --docnum=1 -o %t.le
# RUN: yaml2obj %s --docnum=2 -o %t.be
# RUN: llvm-objdump --btf=custom %t.le | FileCheck %s --match-full-lines
# RUN: llvm-objdump --btf=custom %t.be | FileCheck %s --match-full-lines
# RUN: llvm-mc -triple=x86_64 -filetype=obj %S/Inputs/btf-extra.s -o %t.extra
# RUN: llvm-objdump --btf %t.extra | FileCheck %s --check-prefix=EXTRA --match-full-lines
# EXTRA: [1] INT '' size=4 bits_offset=0 nr_bits=32 encoding=(none)
# EXTRA-NEXT: [2] INT '(anon)' size=4 bits_offset=0 nr_bits=32 encoding=CHAR
# EXTRA-NEXT: [3] INT '(anon)' size=4 bits_offset=0 nr_bits=32 encoding=BOOL
# EXTRA-NEXT: [4] INT '(anon)' size=4 bits_offset=0 nr_bits=32 encoding=UNKN
# EXTRA-NEXT: [5] VAR 'a' type_id=1, linkage=static
# EXTRA-NEXT: [6] VAR 'a' type_id=1, linkage=global
# EXTRA-NEXT: [7] VAR 'a' type_id=1, linkage=extern
# EXTRA-NEXT: [8] VAR 'a' type_id=1, linkage=(unknown)
# EXTRA-NEXT: [9] FUNC 'a' type_id=1 linkage=static
# EXTRA-NEXT: [10] FUNC 'a' type_id=1 linkage=global
# EXTRA-NEXT: [11] FUNC 'a' type_id=1 linkage=extern
# EXTRA-NEXT: [12] FUNC 'a' type_id=1 linkage=(unknown)
# EXTRA-NEXT: [13] DATASEC '(anon)' size=8 vlen=3
# EXTRA-NEXT: {{ *}}type_id=0 offset=0 size=0 (UNKNOWN '(anon)')
# EXTRA-NEXT: {{ *}}type_id=1 offset=0 size=4 (INT '')
# EXTRA-NEXT: {{ *}}type_id=5 offset=4 size=4 (VAR 'a')
# EXTRA-NEXT: [14] ENUM '(anon)' encoding=UNSIGNED size=4 vlen=1
# EXTRA-NEXT: {{ *}}'a' val=4294967295
# EXTRA-NEXT: [15] ENUM64 '(anon)' encoding=UNSIGNED size=8 vlen=1
# EXTRA-NEXT: {{ *}}'a' val=18446744073709551615ULL
# EXTRA-NEXT: [16] FUNC_PROTO '(anon)' ret_type_id=0 vlen=1
# EXTRA-NEXT: {{ *}}'(anon)' type_id=0
# EXTRA-NEXT: [17] STRUCT '(anon)' size=8 vlen=2
# EXTRA-NEXT: {{ *}}'a' type_id=1 bits_offset=32
# EXTRA-NEXT: {{ *}}'b' type_id=1 bits_offset=0
# CHECK: [1] INT 'int' size=4 bits_offset=0 nr_bits=32 encoding=SIGNED
# CHECK-NEXT: [2] PTR '(anon)' type_id=1
# CHECK-NEXT: [3] ARRAY '(anon)' type_id=1 index_type_id=1 nr_elems=4
# CHECK-NEXT: [4] STRUCT 'foo' size=4 vlen=1
# CHECK-NEXT: {{ *}}'a' type_id=1 bits_offset=4 bitfield_size=3
# CHECK-NEXT: [5] UNION '(anon)' size=0 vlen=0
# CHECK-NEXT: [6] ENUM 'e' encoding=SIGNED size=4 vlen=1
# CHECK-NEXT: {{ *}}'A' val=-1
# CHECK-NEXT: [7] FWD 'bar' fwd_kind=struct
# CHECK-NEXT: [8] TYPEDEF '(anon)' type_id=1
# CHECK-NEXT: [9] VOLATILE '(anon)' type_id=1
# CHECK-NEXT: [10] CONST '(anon)' type_id=1
# CHECK-NEXT: [11] RESTRICT '(anon)' type_id=1
# CHECK-NEXT: [12] FUNC 'f' type_id=13 linkage=global
# CHECK-NEXT: [13] FUNC_PROTO '(anon)' ret_type_id=1 vlen=1
# CHECK-NEXT: {{ *}}'x' type_id=1
# CHECK-NEXT: [14] VAR 'v' type_id=1, linkage=global
# CHECK-NEXT: [15] DATASEC '.data' size=4 vlen=1
# CHECK-NEXT: {{ *}}type_id=14 offset=0 size=4 (VAR 'v')
# CHECK-NEXT: [16] FLOAT '(anon)' size=4
# CHECK-NEXT: [17] DECL_TAG 'tag' type_id=1 component_idx=-1
# CHECK-NEXT: [18] TYPE_TAG 'tag' type_id=1
# CHECK-NEXT: [19] ENUM64 'e' encoding=SIGNED size=8 vlen=1
# CHECK-NEXT: {{ *}}'A' val=-2LL

--- !ELF
FileHeader: { Class: ELFCLASS64, Data: ELFDATA2LSB, Type: ET_REL, Machine: EM_X86_64 }
Sections:
  - Name: custom
    Type: SHT_PROGBITS
    Content: ""
--- !ELF
FileHeader: { Class: ELFCLASS64, Data: ELFDATA2MSB, Type: ET_REL, Machine: EM_X86_64 }
Sections:
  - Name: custom
    Type: SHT_PROGBITS
    Content: ""
