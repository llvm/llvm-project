  MagicNumber:       0x1DF
Sections:
  - Name:            .text
    Flags:           [ STYP_TEXT ]
    SectionData:     "9421ffc000000000000922400045070310000000000003d8000773737761705f6b0001000000000000"
Symbols:
  - Name:            .sswap_k
    Value:           0
    Section:         .text
    Type:            0x20
    StorageClass:    C_EXT
    AuxEntries:
      - Type:                   AUX_CSECT
        SectionOrLength:        0x29
        SymbolAlignmentAndType: 0x21
        StorageMappingClass:    XMC_PR

