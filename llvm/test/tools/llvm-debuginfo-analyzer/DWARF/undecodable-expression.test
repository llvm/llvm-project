; REQUIRES: x86-registered-target

; Test that an operation which failed to decode does not contribute a location
; entry. Its operand values are undefined, so recording them would turn a
; decode error into a location that looks valid.
;
; The variable's location is a DW_OP_LLVM_user DW_OP_LLVM_NVIDIA_mux, whose
; selector implies operands that are not known here, so decoding stops at it.

; RUN: yaml2obj %p/../../llvm-dwarfutil/ELF/X86/Inputs/undecodable-expression.yaml -o - | \
; RUN: llvm-debuginfo-analyzer --attribute=location \
; RUN:                         --print=symbols \
; RUN:                         - 2>&1 | \
; RUN: FileCheck %s

; CHECK:      {Variable} 'var'
; CHECK-NEXT:   {Location}
; CHECK-NOT:    {Entry}
