MAYBE-UNDEFINED-NEXT: fn1 v test.c:13 4
MAYBE-UNDEFINED-NEXT: fn1 x test.c:3 13
MAYBE-UNDEFINED-NEXT: fn1 y test.c:3 13

RUN: llvm-dwarfdump --show-variable-coverage --variable-coverage-maybe-undefined --variable-coverage-bitcode-file=%S/Inputs/coverage.ll --coverage-baseline %t.o %t-opt.o | FileCheck %s --check-prefix=MAYBE-UNDEFINED-BASELINE

MAYBE-UNDEFINED-BASELINE:      Variable coverage statistics:
MAYBE-UNDEFINED-BASELINE-NEXT: Function InlChain Variable Decl LinesCovered
MAYBE-UNDEFINED-BASELINE-NEXT: f k test.c:35 3 3 1 3 1
