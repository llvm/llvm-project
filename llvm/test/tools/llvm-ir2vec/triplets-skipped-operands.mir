# REQUIRES: x86-registered-target
# RUN: llvm-ir2vec triplets --mode=mir %s -o - | FileCheck %s

# $noreg operands have no vocabulary entry and emit no triplets. The remaining
# operands keep their positions, and MAX_RELATION still covers every operand
# position.

# CHECK-LABEL: MAX_RELATION=6
# CHECK-NEXT: [[COPY:[0-9]+]] [[VirtReg_GR64:[0-9]+]] 1
# CHECK-NEXT: [[COPY]] [[PhyReg:[0-9]+]] 2
# CHECK-NEXT: [[COPY]] [[MOV:[0-9]+]] 0
# CHECK-NEXT: [[MOV]] [[VirtReg_GR32:[0-9]+]] 1
# CHECK-NEXT: [[MOV]] [[VirtReg_GR64]] 2
# CHECK-NEXT: [[MOV]] [[Immediate:[0-9]+]] 3
# CHECK-NEXT: [[MOV]] [[Immediate]] 5
# CHECK-NEXT: [[MOV]] [[RET:[0-9]+]] 0
# CHECK-NEXT: [[RET]] [[Immediate]] 1
# CHECK-NOT: {{.}}

--- |
  target triple = "x86_64-unknown-linux-gnu"

  define i32 @skipped_operands(ptr %p) { ret i32 0 }
...
---
name:            skipped_operands
body:             |
  bb.0:
    liveins: $rdi

    %0:gr64 = COPY $rdi
    %1:gr32 = MOV32rm %0, 1, $noreg, 0, $noreg
    RET 0
...
