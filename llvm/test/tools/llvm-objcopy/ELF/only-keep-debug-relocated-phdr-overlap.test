# XFAIL: *

## Retained section data must not be compacted across a relocated program
## header table. llvm-objcopy writes standalone section contents after the
## program headers, so an overlap would silently replace the table.
##
## FIXME: Remove XFAIL once the relocated program header table is treated as
## an occupied range during --only-keep-debug layout.

# RUN: yaml2obj %s -o %t
# RUN: %python %S/Inputs/relocated-phdr.py relocate %t 0x1000
# RUN: %python %S/Inputs/relocated-phdr.py verify %t
# RUN: llvm-objcopy --only-keep-debug %t %t.dbg
# RUN: %python %S/Inputs/relocated-phdr.py verify %t.dbg

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_X86_64
Sections:
  - Name:         .note
    Type:         SHT_NOTE
    Flags:        [ SHF_ALLOC ]
    Address:      0x100
    Offset:       0x100
    Content:      040000000400000001000000474e550001020304
  - Name:    .debug_info
    Type:    SHT_PROGBITS
    Offset:  0x2000
    Size:    0x1000
ProgramHeaders:
  - Type:     PT_PHDR
    Flags:    [ PF_R ]
    Offset:   0x1000
    VAddr:    0x1000
    FileSize: 0xa8
    MemSize:  0xa8
    Align:    8
  - Type:     PT_LOAD
    Flags:    [ PF_R ]
    Offset:   0
    Align:    0x1000
    FirstSec: .note
    LastSec:  .note
  - Type:     PT_LOAD
    Flags:    [ PF_R ]
    Offset:   0x1000
    VAddr:    0x1000
    FileSize: 0xa8
    MemSize:  0xa8
    Align:    0x1000
