## Check that --only-keep-debug writes the program header table after the ELF
## header when the input has it in a later PT_LOAD, as BOLT does.

# RUN: yaml2obj %s -o %t
# RUN: llvm-readelf -h -l %t | FileCheck %s --check-prefix=INPUT
# RUN: llvm-objcopy --only-keep-debug %t %t.dbg
# RUN: llvm-readelf -h -S -l %t.dbg 2>&1 | FileCheck %s --implicit-check-not=warning:

# INPUT: Start of program headers: 8192 (bytes into file)

# CHECK:      Start of program headers: 64 (bytes into file)
# CHECK:      Number of program headers: 3
# CHECK:      [Nr] Name        Type     Address          Off    Size   ES Flg Lk Inf Al
# CHECK-NEXT: [ 0]
# CHECK-NEXT: [ 1] .text       NOBITS   0000000000001000 001000 000001 00  AX  0   0  0
# CHECK-NEXT: [ 2] .phdrs      NOBITS   0000000000002000 001000 0000a8 00   A  0   0  8
# CHECK-NEXT: [ 3] .debug_info PROGBITS 0000000000000000 001000 000001 00      0   0  0
# CHECK:      Type Offset   VirtAddr           PhysAddr           FileSiz  MemSiz   Flg Align
# CHECK-NEXT: PHDR 0x000040 0x0000000000002000 0x0000000000002000 0x0000a8 0x0000a8 R   0x8
# CHECK-NEXT: LOAD 0x000000 0x0000000000000000 0x0000000000000000 0x001000 0x001001 R E 0x1000
# CHECK-NEXT: LOAD 0x001000 0x0000000000002000 0x0000000000002000 0x000000 0x0000a8 R   0x1000

## .phdrs holds the program header table:
## PT_PHDR, PT_LOAD (.text), PT_LOAD (.phdrs).
--- !ELF
FileHeader:
  Class:      ELFCLASS64
  Data:       ELFDATA2LSB
  Type:       ET_EXEC
  Machine:    EM_X86_64
  EPhOff:     0x2000
  EPhEntSize: 56
  EPhNum:     3
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x1000
    Offset:       0x1000
    Content:      C3
  - Name:         .phdrs
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC ]
    Address:      0x2000
    Offset:       0x2000
    AddressAlign: 0x8
    Content:      
  - Name:         .debug_info
    Type:         SHT_PROGBITS
    Content:      01
