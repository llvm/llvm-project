## Check that the external and local relocations of a kext bundle are kept,
## and that the symbols and sections they refer to are renumbered.

## The input is linked from:
##   .text
##   .globl _f
##   _f:
##     callq _ext_func
##     retq
##   _local_fn:
##     retq
##   .section __TEXT,__unused
##     .quad 0
##   .data
##   .globl _p
##   _p:
##     .quad _ext_data
##   _q:
##     .quad _local_fn
##   _r:
##     .quad _q

# RUN: yaml2obj --docnum=1 %s -o %t

# RUN: llvm-objcopy %t %t.copy
# RUN: llvm-objdump --macho -r %t.copy | FileCheck %s -DDATA=3

## Like cctools' strip, refuse to strip all symbols when external relocations
## refer to some of them.
# RUN: not llvm-strip %t -o /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=STRIPALL -DFILE=%t
# STRIPALL: error: '[[FILE]]': symbols referenced by external relocations cannot be stripped: _ext_data, _ext_func

## Stripping the local symbols keeps the external ones.
# RUN: llvm-strip -x %t -o %t.strip
# RUN: llvm-objdump --macho -r %t.strip | FileCheck %s -DDATA=3
# RUN: llvm-nm -m %t.strip | FileCheck %s --check-prefix=SYMS

## Local relocations come first in __LINKEDIT, and external relocations follow
## the symbol table, which shrinks when stripped.
# RUN: llvm-objdump --macho --private-headers %t.copy | \
# RUN:   FileCheck %s --check-prefix=LAYOUT -DEXTRELOFF=8320
# RUN: llvm-objdump --macho --private-headers %t.strip | \
# RUN:   FileCheck %s --check-prefix=LAYOUT -DEXTRELOFF=8272
# LAYOUT:      cmd LC_SYMTAB
# LAYOUT:      symoff 8208
# LAYOUT:      cmd LC_DYSYMTAB
# LAYOUT:      extreloff [[EXTRELOFF]]
# LAYOUT-NEXT: nextrel 2
# LAYOUT-NEXT: locreloff 8192
# LAYOUT-NEXT: nlocrel 2

# CHECK:      External relocation information 2 entries
# CHECK-NEXT: address  pcrel length extern type    scattered symbolnum/value
# CHECK-NEXT: 00000271 True  long   True   BRANCH  False     _ext_func
# CHECK-NEXT: 00001000 False quad   True   UNSIGND False     _ext_data
# CHECK-NEXT: Local relocation information 2 entries
# CHECK-NEXT: address  pcrel length extern type    scattered symbolnum/value
# CHECK-NEXT: 00001008 False quad   False  UNSIGND False     1 (__TEXT,__text)
# CHECK-NEXT: 00001010 False quad   False  UNSIGND False     [[DATA]] (__DATA,__data)

# SYMS:      (undefined) external _ext_data
# SYMS-NEXT: (undefined) external _ext_func
# SYMS-NEXT: (__TEXT,__text) external _f
# SYMS-NEXT: (__DATA,__data) external _p
# SYMS-EMPTY:

# RUN: llvm-objcopy --remove-section __TEXT,__unused %t %t.removed
# RUN: llvm-objdump --macho -r %t.removed | FileCheck %s -DDATA=2

# RUN: not llvm-objcopy --remove-section __TEXT,__text %t /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=ERROR -DFILE=%t
# ERROR: error: '[[FILE]]': section '__TEXT,__text' cannot be removed because it is referenced by a local relocation

## The second input is linked with -interposable from:
##   .text
##   .globl _f
##   _f:
##     retq
##   .section __TEXT,__unused
##   .globl _g
##   _g:
##     .quad 0
##   .data
##   _p:
##     .quad _g
##     .quad _p
## and its local relocation is changed to use R_ABS, which is kept as is.

# RUN: yaml2obj --docnum=2 %s -o %t2
# RUN: llvm-objcopy %t2 %t2.copy
# RUN: llvm-objdump --macho -r %t2.copy | FileCheck %s --check-prefix=ABS
# ABS:      External relocation information 1 entries
# ABS-NEXT: address  pcrel length extern type    scattered symbolnum/value
# ABS-NEXT: 00001000 False quad   True   UNSIGND False     _g
# ABS-NEXT: Local relocation information 1 entries
# ABS-NEXT: address  pcrel length extern type    scattered symbolnum/value
# ABS-NEXT: 00001008 False quad   False  UNSIGND False     0 R_ABS

# RUN: not llvm-objcopy --remove-section __TEXT,__unused %t2 /dev/null 2>&1 | \
# RUN:   FileCheck %s --check-prefix=EXTERN -DFILE=%t2
# EXTERN: error: '[[FILE]]': symbol '_g' defined in section with index '2' cannot be removed because it is referenced by an external relocation

## The third input has no external relocations, so all of its symbols are
## stripped, while its local relocation is kept. It is linked from:
##   .text
##   .globl _f
##   _f:
##     retq
##   _local_fn:
##     retq
##   .data
##   .globl _p
##   _p:
##     .quad _local_fn

# RUN: yaml2obj --docnum=3 %s -o %t3
# RUN: llvm-strip %t3 -o %t3.strip
# RUN: llvm-nm -m %t3.strip 2>&1 | FileCheck %s --check-prefix=NOSYMS
# RUN: llvm-objdump --macho -r %t3.strip | FileCheck %s --check-prefix=LOCAL
# NOSYMS: no symbols
# LOCAL:      Local relocation information 1 entries
# LOCAL-NEXT: address  pcrel length extern type    scattered symbolnum/value
# LOCAL-NEXT: 00001000 False quad   False  UNSIGND False     1 (__TEXT,__text)

--- !mach-o
IsLittleEndian:  true
FileHeader:
  magic:           0xFEEDFACF
  cputype:         0x1000007
  cpusubtype:      0x3
  filetype:        0xB
  ncmds:           5
  sizeofcmds:      560
  flags:           0x85
  reserved:        0x0
LoadCommands:
  - cmd:             LC_SEGMENT_64
    cmdsize:         232
    segname:         __TEXT
    vmaddr:          0
    vmsize:          4096
    fileoff:         0
    filesize:        4096
    maxprot:         5
    initprot:        5
    nsects:          2
    flags:           0
    Sections:
      - sectname:        __text
        segname:         __TEXT
        addr:            0x270
        size:            7
        offset:          0x270
        align:           0
        reloff:          0x0
        nreloc:          0
        flags:           0x80000400
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         E800000000C3C3
      - sectname:        __unused
        segname:         __TEXT
        addr:            0x277
        size:            8
        offset:          0x277
        align:           0
        reloff:          0x0
        nreloc:          0
        flags:           0x0
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         '0000000000000000'
  - cmd:             LC_SEGMENT_64
    cmdsize:         152
    segname:         __DATA
    vmaddr:          4096
    vmsize:          4096
    fileoff:         4096
    filesize:        4096
    maxprot:         3
    initprot:        3
    nsects:          1
    flags:           0
    Sections:
      - sectname:        __data
        segname:         __DATA
        addr:            0x1000
        size:            24
        offset:          0x1000
        align:           0
        reloff:          0x0
        nreloc:          0
        flags:           0x0
        reserved1:       0x0
        reserved2:       0x0
        reserved3:       0x0
        content:         '000000000000000076020000000000000810000000000000'
  - cmd:             LC_SEGMENT_64
    cmdsize:         72
    segname:         __LINKEDIT
    vmaddr:          8192
    vmsize:          192
    fileoff:         8192
    filesize:        192
    maxprot:         1
    initprot:        1
    nsects:          0
    flags:           0
  - cmd:             LC_SYMTAB
    cmdsize:         24
    symoff:          8208
    nsyms:           7
    stroff:          8336
    strsize:         48
  - cmd:             LC_DYSYMTAB
    cmdsize:         80
    ilocalsym:       0
    nlocalsym:       3
    iextdefsym:      3
    nextdefsym:      2
    iundefsym:       5
    nundefsym:       2
    tocoff:          0
    ntoc:            0
    modtaboff:       0
    nmodtab:         0
    extrefsymoff:    0
    nextrefsyms:     0
    indirectsymoff:  0
    nindirectsyms:   0
    extreloff:       8320
    nextrel:         2
    locreloff:       8192
    nlocrel:         2
__LINKEDIT:      
...
