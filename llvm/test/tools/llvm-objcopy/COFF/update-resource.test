## Test --update-resource, which adds resources to PE images or replaces them.

# RUN: split-file %s %t
# RUN: yaml2obj %t/noresources.yaml -o %t/noresources.exe
# RUN: %python -c "open(r'%t/large.bin', 'wb').write(b'A' * 5000)"

## Add a resource to an image without resources. The resource section is added
## before the discardable .reloc section, which is moved along with the base
## relocation table entry and the base relocation block that refers to it.
# RUN: llvm-objcopy --update-resource=24/1=%t/small.txt %t/noresources.exe %t/added.exe
# RUN: llvm-readobj --file-headers --sections --coff-basereloc --coff-resources %t/added.exe | \
# RUN:   FileCheck %s --check-prefix=ADDED

# ADDED:      SizeOfImage: 16384
# ADDED:      ResourceTableRVA: 0x2000
# ADDED-NEXT: ResourceTableSize: 0x5D
# ADDED:      BaseRelocationTableRVA: 0x3000
# ADDED-NEXT: BaseRelocationTableSize: 0x18
# ADDED:      Name: .text
# ADDED-NEXT: VirtualSize: 0x4
# ADDED-NEXT: VirtualAddress: 0x1000
# ADDED:      Name: .rsrc
# ADDED-NEXT: VirtualSize: 0x5D
# ADDED-NEXT: VirtualAddress: 0x2000
# ADDED-NEXT: RawDataSize: 0x200
# ADDED-NEXT: PointerToRawData: 0x400
# ADDED:      Characteristics [
# ADDED-NEXT:   IMAGE_SCN_CNT_INITIALIZED_DATA
# ADDED-NEXT:   IMAGE_SCN_MEM_READ
# ADDED-NEXT: ]
# ADDED:      Name: .reloc
# ADDED-NEXT: VirtualSize: 0x18
# ADDED-NEXT: VirtualAddress: 0x3000
# ADDED-NEXT: RawDataSize: 0x200
# ADDED-NEXT: PointerToRawData: 0x600
# ADDED:      BaseReloc [
# ADDED-NEXT:   Entry {
# ADDED-NEXT:     Type: DIR64
# ADDED-NEXT:     Address: 0x1000
# ADDED-NEXT:   }
# ADDED-NEXT:   Entry {
# ADDED-NEXT:     Type: ABSOLUTE
# ADDED-NEXT:     Address: 0x1000
# ADDED-NEXT:   }
# ADDED-NEXT:   Entry {
# ADDED-NEXT:     Type: DIR64
# ADDED-NEXT:     Address: 0x3000
# ADDED-NEXT:   }
# ADDED-NEXT:   Entry {
# ADDED-NEXT:     Type: ABSOLUTE
# ADDED-NEXT:     Address: 0x3000
# ADDED-NEXT:   }
# ADDED-NEXT: ]
# ADDED:      Resources [
# ADDED-NEXT:   Total Number of Resources: 1
# ADDED-NEXT:   Base Table Address: 0x400
# ADDED:        Number of String Entries: 0
# ADDED-NEXT:   Number of ID Entries: 1
# ADDED-NEXT:   Type: MANIFEST (ID 24) [
# ADDED-NEXT:     Table Offset: 0x18
# ADDED-NEXT:     Number of String Entries: 0
# ADDED-NEXT:     Number of ID Entries: 1
# ADDED-NEXT:     Name: (ID 1) [
# ADDED-NEXT:       Table Offset: 0x30
# ADDED-NEXT:       Number of String Entries: 0
# ADDED-NEXT:       Number of ID Entries: 1
# ADDED-NEXT:       Language: (ID 0) [
# ADDED-NEXT:         Entry Offset: 0x48
# ADDED-NEXT:         Time/Date Stamp: 1970-01-01 00:00:00 (0x0)
