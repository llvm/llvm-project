# RUN:   FileCheck %s --check-prefix=GROWN
# RUN: llvm-objcopy --dump-resource=24/1=%t/dumped.bin %t/grown.exe %t/copy.exe
# RUN: cmp %t/dumped.bin %t/large.bin

