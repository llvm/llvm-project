# ADDED-NEXT:         Minor Version: 0
# ADDED-NEXT:         Characteristics: 0
# ADDED-NEXT:         Data [
# ADDED-NEXT:           DataRVA: 0x2058
# ADDED-NEXT:           DataSize: 5
# ADDED-NEXT:           Codepage: 0
