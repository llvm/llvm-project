## With a language, only the resource of that language is added or replaced.
# RUN: llvm-objcopy --update-resource=24/1/1033=%t/small.txt --update-resource=24/1/1034=%t/medium.txt \
# RUN:   %t/noresources.exe %t/languages.exe
# RUN: llvm-objcopy --update-resource=24/1/1034=%t/large.bin %t/languages.exe %t/languages2.exe
# RUN: llvm-readobj --coff-resources %t/languages.exe | FileCheck %s --check-prefix=LANGUAGES
# RUN: llvm-readobj --coff-resources %t/languages2.exe | FileCheck %s --check-prefix=LANGUAGES2

# LANGUAGES:      Language: (ID 1033) [
# LANGUAGES:        DataSize: 5
# LANGUAGES:      Language: (ID 1034) [
# LANGUAGES:        DataSize: 15
