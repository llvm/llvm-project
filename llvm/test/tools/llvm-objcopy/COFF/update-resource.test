# LANGUAGES2:     Language: (ID 1034) [
# LANGUAGES2:       DataSize: 5000

## Without a language, the resources of all languages are replaced by a single
## language-neutral one, unless there is only one, whose language is kept.
# RUN: llvm-objcopy --update-resource=24/1=%t/large.bin %t/languages.exe %t/neutral.exe
# RUN: llvm-readobj --coff-resources %t/neutral.exe | FileCheck %s --check-prefix=NEUTRAL
# RUN: llvm-objcopy --update-resource=24/1/1033=%t/small.txt %t/noresources.exe %t/single.exe
# RUN: llvm-objcopy --update-resource=24/1=%t/medium.txt %t/single.exe %t/kept.exe
# RUN: llvm-readobj --coff-resources %t/kept.exe | FileCheck %s --check-prefix=KEPT

# NEUTRAL:      Name: (ID 1) [
# NEUTRAL:        Number of ID Entries: 1
# NEUTRAL-NEXT:   Language: (ID 0) [
# NEUTRAL:          DataSize: 5000
# KEPT:         Name: (ID 1) [
# KEPT:           Number of ID Entries: 1
# KEPT-NEXT:      Language: (ID 1033) [
# KEPT:             DataSize: 15

## The resource section cannot grow beyond its address range if it is followed
## by a section that is not discardable.
# RUN: yaml2obj %t/followed.yaml -o %t/followed.exe
# RUN: llvm-objcopy --update-resource=24/1=%t/medium.txt %t/followed.exe %t/followed2.exe
# RUN: llvm-readobj --sections --coff-resources %t/followed2.exe | FileCheck %s --check-prefix=FOLLOWED
# RUN: not llvm-objcopy --update-resource=24/1=%t/large.bin %t/followed.exe %t/followed3.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=CANNOT-MOVE

# FOLLOWED:      Name: .rsrc
# FOLLOWED-NEXT: VirtualSize: 0x67
# FOLLOWED-NEXT: VirtualAddress: 0x2000
# FOLLOWED:      Name: .data
# FOLLOWED-NEXT: VirtualSize: 0x4
# FOLLOWED-NEXT: VirtualAddress: 0x3000
# FOLLOWED:      Language: (ID 0) [
# FOLLOWED:        DataRVA: 0x2058
# FOLLOWED-NEXT:   DataSize: 15
# CANNOT-MOVE: error: '{{.*}}followed.exe': section '.rsrc' cannot grow past section '.data', which is not discardable and thus cannot be moved

## Data following the resources in their section cannot be preserved since it
## would have to move when the resources grow, so only zero padding is allowed.
# RUN: yaml2obj %t/padded.yaml -o %t/padded.exe
# RUN: llvm-objcopy --update-resource=24/1=%t/medium.txt %t/padded.exe %t/padded2.exe
# RUN: llvm-readobj --sections --coff-resources %t/padded2.exe | FileCheck %s --check-prefix=PADDED
# RUN: yaml2obj %t/trailing.yaml -o %t/trailing.exe
# RUN: not llvm-objcopy --update-resource=24/1=%t/medium.txt %t/trailing.exe %t/trailing2.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=TRAILING

# PADDED:      Name: .rsrc
# PADDED-NEXT: VirtualSize: 0x67
# PADDED:      Language: (ID 0) [
# PADDED:        DataRVA: 0x2058
# PADDED-NEXT:   DataSize: 15
# TRAILING: error: '{{.*}}trailing.exe': section '.rsrc' contains data after its resources that cannot be preserved

## The entries of the debug directory are updated if their payloads are moved.
