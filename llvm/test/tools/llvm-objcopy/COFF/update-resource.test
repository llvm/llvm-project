# ADDED-NEXT:             0000: 41424344 0A |ABCD.|
# ADDED-NEXT:           )
# ADDED-NEXT:         ]
# ADDED-NEXT:       ]
# ADDED-NEXT:     ]
# ADDED-NEXT:   ]
# ADDED-NEXT: ]

## Replace the resource with a larger one that still fits into the address
## range of the resource section, which keeps the other sections in place, and
## add a resource of another type.
# RUN: llvm-objcopy --update-resource=24/1=%t/medium.txt --update-resource=10/100=%t/small.txt \
# RUN:   %t/added.exe %t/replaced.exe
# RUN: llvm-readobj --file-headers --sections --coff-resources %t/replaced.exe | \
# RUN:   FileCheck %s --check-prefix=REPLACED
# RUN: llvm-objcopy --dump-resource=24/1=%t/dumped.txt --dump-resource=10/100=%t/dumped2.txt \
# RUN:   %t/replaced.exe %t/copy.exe
# RUN: cmp %t/dumped.txt %t/medium.txt
# RUN: cmp %t/dumped2.txt %t/small.txt

