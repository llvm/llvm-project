## Resources can only be updated in PE images.
# RUN: yaml2obj %t/object.yaml -o %t/object.o
# RUN: not llvm-objcopy --update-resource=24/1=%t/small.txt %t/object.o %t/object2.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=NOT-PE
# RUN: yaml2obj %t/elf.yaml -o %t/elf.o
# RUN: not llvm-objcopy --update-resource=24/1=%t/small.txt %t/elf.o %t/elf2.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=ELF

# NOT-PE: error: '{{.*}}object.o': resources can only be dumped from or updated in PE images
# ELF: error: option is not supported for ELF

## Invalid option values.
# RUN: not llvm-objcopy --update-resource=24/1 %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=NO-FILE
# RUN: not llvm-objcopy --update-resource=24=%t/small.txt %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BAD-FORMAT
# RUN: not llvm-objcopy --update-resource=24/1/0/0=%t/small.txt %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BAD-FORMAT
# RUN: not llvm-objcopy --update-resource=x/1=%t/small.txt %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BAD-TYPE
# RUN: not llvm-objcopy --update-resource=24/y=%t/small.txt %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BAD-NAME
# RUN: not llvm-objcopy --update-resource=24/1/65536=%t/small.txt %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BAD-LANGUAGE
# RUN: not llvm-objcopy --update-resource=24/1=%t/missing.txt %t/noresources.exe %t/out.exe 2>&1 | \
# RUN:   FileCheck %s --check-prefix=MISSING -DENOENT=%errc_ENOENT

# NO-FILE: error: bad format for --update-resource: missing file name
# BAD-FORMAT: error: bad format for --update-resource: expected <type>/<name>[/<language>]=<file>
# BAD-TYPE: error: bad format for --update-resource: 'x' is not a valid resource type ID
# BAD-NAME: error: bad format for --update-resource: 'y' is not a valid resource name ID
# BAD-LANGUAGE: error: bad format for --update-resource: '65536' is not a valid resource language ID
# MISSING: error: '{{.*}}missing.txt': [[ENOENT]]

#--- small.txt
ABCD
#--- medium.txt
0123456789ABCD
#--- noresources.yaml
--- !COFF
OptionalHeader:
  AddressOfEntryPoint: 4096
  ImageBase:       1073741824
  SectionAlignment: 4096
  FileAlignment:   512
  MajorOperatingSystemVersion: 6
  MinorOperatingSystemVersion: 0
  MajorImageVersion: 0
  MinorImageVersion: 0
  MajorSubsystemVersion: 6
  MinorSubsystemVersion: 0
  Subsystem:       IMAGE_SUBSYSTEM_WINDOWS_CUI
  DLLCharacteristics: [ ]
  SizeOfStackReserve: 1048576
  SizeOfStackCommit: 4096
  SizeOfHeapReserve: 1048576
  SizeOfHeapCommit: 4096
  BaseRelocationTable:
    RelativeVirtualAddress: 8192
    Size:            24
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [ IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  4096
    VirtualSize:     4
    SectionData:     C3C3C3C3
  ## Two base relocation blocks with one DIR64 entry each: one for the .text
  ## section and one for the .reloc section itself.
  - Name:            .reloc
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_DISCARDABLE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  8192
    VirtualSize:     24
    SectionData:     001000000C00000000A00000002000000C00000000A00000
symbols:         []
...
## An image with a resource section holding a single resource of type 24,
## name 1 and language 0 with the data "ABCD" (at RVA 0x2058), followed by a
## section that is not discardable.
#--- followed.yaml
--- !COFF
OptionalHeader:
  AddressOfEntryPoint: 4096
  ImageBase:       1073741824
  SectionAlignment: 4096
  FileAlignment:   512
  MajorOperatingSystemVersion: 6
  MinorOperatingSystemVersion: 0
  MajorImageVersion: 0
  MinorImageVersion: 0
  MajorSubsystemVersion: 6
  MinorSubsystemVersion: 0
  Subsystem:       IMAGE_SUBSYSTEM_WINDOWS_CUI
  DLLCharacteristics: [ ]
  SizeOfStackReserve: 1048576
  SizeOfStackCommit: 4096
  SizeOfHeapReserve: 1048576
  SizeOfHeapCommit: 4096
  ResourceTable:
    RelativeVirtualAddress: 8192
    Size:            92
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [ IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  4096
    VirtualSize:     4
    SectionData:     C3C3C3C3
  - Name:            .rsrc
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  8192
    VirtualSize:     92
    SectionData:     000000000000000000000000000001001800000018000080000000000000000000000000000001000100000030000080000000000000000000000000000001000000000048000000582000000400000000000000000000004142434400000000
  - Name:            .data
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    VirtualAddress:  12288
    VirtualSize:     4
    SectionData:     01020304
symbols:         []
...
