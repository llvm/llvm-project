REQUIRES: curl || system-windows, http-server

RUN: rm -rf %t
RUN: mkdir -p %t/debuginfod-cache

RUN: env DEBUGINFOD_TIMEOUT=1 \
RUN: env DEBUGINFOD_CACHE_PATH=%t/debuginfod-cache \
RUN: env DEBUGINFOD_HEADERS_FILE=%S/Inputs/headers \
RUN:   %python %S/Inputs/partial_response.py llvm-debuginfod-find --debuginfo 0 | FileCheck %s

CHECK: Build ID 00:
CHECK-SAME: Timeout was reached
