# COMMON-LABELS: COMMON-LABEL: @f(
# COMMON-LABELS: COMMON-LABEL: @g(
# SHARED-LABELS: COMMON1-LABEL: @f(
# SHARED-LABELS: COMMON1-LABEL: @g(
# SEPARATE-LABELS-DAG: A-LABEL: @f(
# SEPARATE-LABELS-DAG: A-LABEL: @g(
# SEPARATE-LABELS-DAG: B-LABEL: @f(
# SEPARATE-LABELS-DAG: B-LABEL: @g(

# GREEDY: A-LABEL: @f(
# GREEDY: A-LABEL: @g(
# CONFLICT-WARN: WARNING: For function 'f', the following RUN lines will not generate checks due to conflicting output:
# CONFLICT-WARN: WARNING: For function 'g', the following RUN lines will not generate checks due to conflicting output:
# CONFLICT: define i32 @f()
# CONFLICT: define i32 @g()

#--- input.ll
; CMD: opt -S < %s | FileCheck %s --check-prefixes=COMMON,A
; CMD: opt -S < %s | FileCheck %s --check-prefixes=B,COMMON

define i32 @f() {
  ret i32 1
}

define i32 @g() {
  ret i32 2
}

#--- greedy.txt
; CMD: opt -S < %s | FileCheck %s --check-prefixes=A,B
; CMD: opt -S < %s | FileCheck %s --check-prefixes=A,C
; CMD: opt -S < %s | FileCheck %s --check-prefix=B
; CMD: opt -S < %s | FileCheck %s --check-prefix=C

#--- conflict.txt
; CMD: opt -S < %s | FileCheck %s --check-prefix=COMMON
; CMD: sed 's/ret i32 [12]/ret i32 3/' %s | opt -S | FileCheck %s --check-prefix=COMMON
