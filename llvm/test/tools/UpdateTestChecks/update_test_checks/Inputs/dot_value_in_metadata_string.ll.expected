; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals
; RUN: opt < %s -passes=instsimplify -S | FileCheck %s

define i32 @dot_value_and_metadata_string(ptr %p, i32 %n) {
; CHECK-LABEL: @dot_value_and_metadata_string(
; CHECK-NEXT:    [[DOTSUM:%.*]] = add i32 [[N:%.*]], 1
; CHECK-NEXT:    store i32 [[DOTSUM]], ptr [[P:%.*]], align 4, !alias.scope [[META0:![0-9]+]]
; CHECK-NEXT:    ret i32 [[DOTSUM]]
;
  %.sum = add i32 %n, 1
  store i32 %.sum, ptr %p, align 4, !alias.scope !0
  ret i32 %.sum
}

!0 = !{!1}
!1 = distinct !{!1, !2, !"callee: %.arg"}
!2 = distinct !{!2, !"callee"}
;.
; CHECK: [[META0]] = !{[[META1:![0-9]+]]}
; CHECK: [[META1]] = distinct !{[[META1]], [[META2:![0-9]+]], !"callee: %.arg"}
; CHECK: [[META2]] = distinct !{[[META2]], !"callee"}
;.
