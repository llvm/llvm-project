; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=s390x-ibm-zos | FileCheck %s

define i64 @leaf_func0(i64 %a, i64 %b) {
; CHECK-LABEL: leaf_func0 DS 0H
; CHECK:       * %bb.0:
; CHECK-NEXT:    agr 1,2
; CHECK-NEXT:    lgr 3,1
; CHECK-NEXT:    b 2(7)
  %n = add i64 %a, %b
  ret i64 %n
}
