# REQUIRES: system-darwin

RUN: printf 'Hello\342\202\254\202\261\202\361\202\311\202\277\202\315' > %t

RUN: env LANG=en_US.US-ASCII llvm-strings %t | FileCheck --check-prefixes CHECK-US-ASCII %s
RUN: env LANG=en_US.ISO8859-1 llvm-strings %t | FileCheck --check-prefixes CHECK-ISO8859-1 %s
RUN: env LANG=en_US.UTF-8 llvm-strings %t | FileCheck --check-prefixes CHECK-UTF-8 %s
RUN: env LANG=ja_JP.SJIS llvm-strings %t | FileCheck --check-prefixes CHECK-SJIS %s

CHECK-US-ASCII:Hello
CHECK-ISO8859-1:Hello{{\xe2}}
CHECK-UTF-8:Hello{{\xe2\x82\xac}}
CHECK-SJIS:Hello
CHECK-SJIS:{{\x82\xb1\x82\xf1\x82\xc9\x82\xbf\x82\xcd}}
