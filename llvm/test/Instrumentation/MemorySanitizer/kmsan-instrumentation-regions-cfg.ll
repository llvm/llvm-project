; RUN: opt < %s -msan-kernel=1 -S -passes=msan | FileCheck %s

; Which calls are inside a KMSAN instrumentation region when the markers are
; spread over several basic blocks. Membership is a must-analysis over the
; nesting depth: a call is in a region only if every path from the function
; entry to it has entered a region and not left it.
;
; The calls that are expected to be inside a region go to @in(), the ones that
; are not go to @out(). Only the calls to @in() get the context fetch and the
; parameter shadow.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

declare void @in(i64)
declare void @out(i64)
declare i1 @cond()

; Regions nest: the inner end does not close the outer region. This is what
; WARN_ON() inside a region looks like.
define void @nested(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @nested(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @in(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP1:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW1:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP1]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG2:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW1]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG2]], align 8
; CHECK-NEXT:    call void @in(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    call void @out(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @in(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  call void @in(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  call void @out(i64 %x)
  ret void
}

