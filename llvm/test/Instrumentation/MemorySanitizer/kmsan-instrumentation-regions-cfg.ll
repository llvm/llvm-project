; A block that cannot be reached from the entry is in no region, whatever its
; markers say, and it does not affect the depth of its successors. The block
; is not removed, either.
define void @unreachable_block(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @unreachable_block(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @out(i64 0)
; CHECK-NEXT:    br label %[[JOIN:.*]]
; CHECK:       [[DEAD:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    call void @out(i64 1)
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    call void @out(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void @out(i64 0)
  br label %join

dead:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @out(i64 1)
  br label %join

join:
  call void @out(i64 %x)
  ret void
}

