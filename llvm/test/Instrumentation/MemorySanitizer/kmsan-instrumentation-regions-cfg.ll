; The loop body closes a region that was opened before the loop: the loop
; header is reached with depth 1 from the preheader and with depth 0 over the
; backedge, so the body is not in a region.
define void @loop_closes_region(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @loop_closes_region(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @in(i64 0)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    call void @out(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    call void @out(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @in(i64 0)
  br label %loop

loop:
  call void @out(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  %c = call i1 @cond()
  br i1 %c, label %loop, label %exit

exit:
  call void @out(i64 %x)
  ret void
}

; The loop body opens a region that is never closed: the depth only grows
; along the backedge, so the minimum at the header is the one from the
; preheader and the analysis terminates.
define void @loop_opens_region(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @loop_opens_region(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0]] {
