; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @in(i64 [[X]])
; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP1:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW2:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP1]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG3:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW2]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG3]], align 8
; CHECK-NEXT:    call void @in(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  call void @out(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @in(i64 %x)
  %c = call i1 @cond()
  br i1 %c, label %loop, label %exit

exit:
