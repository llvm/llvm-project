; CHECK-NEXT:    call void @callee()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    [[R:%.*]] = call i64 @callee_ret(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret i64 [[R]]
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee()
  %r = call i64 @callee_ret(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret i64 %r
}

; Indirect calls are calls.
define void @indirect_call(ptr %fn, i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @indirect_call(
; CHECK-SAME: ptr [[FN:%.*]], i64 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void [[FN]](i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void %fn(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

; Loads, stores, allocas, memory intrinsics, other inline asm and calls marked
; !nosanitize are left alone inside a region.
define i64 @not_calls(ptr %p, i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define i64 @not_calls(
; CHECK-SAME: ptr [[P:%.*]], i64 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LOCAL:%.*]] = alloca i64, align 8
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    store i64 [[X]], ptr [[LOCAL]], align 8
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P]], align 8
; CHECK-NEXT:    store i64 [[V]], ptr [[P]], align 8
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[P]], i8 0, i64 8, i1 false)
; CHECK-NEXT:    call void asm sideeffect "nop", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[W:%.*]] = call i64 asm "movq $1, $0", "=r,r,~{dirflag},~{fpsr},~{flags}"(i64 [[X]])
; CHECK-NEXT:    call void @callee_i64(i64 [[X]]), !nosanitize [[META1:![0-9]+]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret i64 [[W]]
;
entry:
  %local = alloca i64
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  store i64 %x, ptr %local
  %v = load i64, ptr %p
  store i64 %v, ptr %p
  call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 8, i1 false)
  call void asm sideeffect "nop", "~{dirflag},~{fpsr},~{flags}"()
  %w = call i64 asm "movq $1, $0", "=r,r,~{dirflag},~{fpsr},~{flags}"(i64 %x)
  call void @callee_i64(i64 %x), !nosanitize !0
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret i64 %w
}

; An argument that is too big for the parameter TLS (800 bytes) is skipped,
; like in a fully instrumented function.
declare void @callee_huge([101 x i64], i64)
define void @huge_arg([101 x i64] %a, i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @huge_arg(
; CHECK-SAME: [101 x i64] [[A:%.*]], i64 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    call void @callee_huge([101 x i64] [[A]], i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee_huge([101 x i64] %a, i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

; Invokes are handled like calls.
define void @invoke_in_region(i64 %x) disable_sanitizer_instrumentation personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: define void @invoke_in_region(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR1]] personality ptr @__gxx_personality_v0 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    invoke void @callee_i64(i64 [[X]])
; CHECK-NEXT:            to label %[[CONT:.*]] unwind label %[[LPAD:.*]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
; CHECK:       [[LPAD]]:
; CHECK-NEXT:    [[LP:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    resume { ptr, i32 } [[LP]]
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  invoke void @callee_i64(i64 %x)
  to label %cont unwind label %lpad

cont:
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void

lpad:
  %lp = landingpad { ptr, i32 }
  cleanup
  resume { ptr, i32 } %lp
}

; The markers are recognized by the token being a part of the asm template, so
; that they can be combined with other annotations, e.g. the nop and the
; .discard.annotate_insn entry that objtool looks for.
define void @marker_substring(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @marker_substring(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "771: nop\0A\09# kmsan.instrumentation.begin\0A\09.pushsection .discard.annotate_insn,\22M\22, @progbits, 8\0A\09.long 771b - ., ${0:c}\0A\09.popsection\0A\09", "i,~{dirflag},~{fpsr},~{flags}"(i32 3)
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "772: nop\0A\09# kmsan.instrumentation.end\0A\09.pushsection .discard.annotate_insn,\22M\22, @progbits, 8\0A\09.long 772b - ., ${0:c}\0A\09.popsection\0A\09", "i,~{dirflag},~{fpsr},~{flags}"(i32 4)
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "771: nop\0A\09# kmsan.instrumentation.begin\0A\09.pushsection .discard.annotate_insn,\22M\22, @progbits, 8\0A\09.long 771b - ., ${0:c}\0A\09.popsection\0A\09", "i,~{dirflag},~{fpsr},~{flags}"(i32 3)
  call void @callee_i64(i64 %x)
  call void asm sideeffect "772: nop\0A\09# kmsan.instrumentation.end\0A\09.pushsection .discard.annotate_insn,\22M\22, @progbits, 8\0A\09.long 772b - ., ${0:c}\0A\09.popsection\0A\09", "i,~{dirflag},~{fpsr},~{flags}"(i32 4)
  call void @callee_i64(i64 %x)
  ret void
}

; Asm that only looks similar does not open a region.
define void @not_a_marker(i64 %x) disable_sanitizer_instrumentation {
