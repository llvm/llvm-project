; RUN: opt < %s -msan-kernel=1 -S -passes=msan | FileCheck %s

; KMSAN instrumentation regions: in a disable_sanitizer_instrumentation
; function (the kernel's noinstr), the calls between the
; "kmsan.instrumentation.begin" and "kmsan.instrumentation.end" inline asm
; markers get clean parameter shadow, the way calls in a
; no_sanitize("kernel-memory") function do. The context state is fetched right
; before each such call. Nothing else in the function is instrumented.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

%struct.pair = type { i64, i64 }

declare void @callee()
declare void @callee_i64(i64)
declare i64 @callee_ret(i64)
declare void @callee_mixed(i32, ptr, i64, %struct.pair)
declare void @callee_byval(ptr byval(%struct.pair), i64)
declare void @callee_varargs(ptr, ...)
declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
declare i32 @__gxx_personality_v0(...)

; A function without the markers is not touched.
define void @no_markers(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @no_markers(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void @callee_i64(i64 %x)
  ret void
}

; Only the call between the markers gets the context fetch and the clean
; shadow for %x. The markers stay.
define void @basic(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @basic(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void @callee_i64(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee_i64(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee_i64(i64 %x)
  ret void
}

; Each call in a region fetches the context state on its own, as the context
; may change between two calls (e.g. on irq_enter_rcu()).
define void @two_calls(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @two_calls(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    [[TMP1:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW1:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP1]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG2:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW1]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG2]], align 8
; CHECK-NEXT:    call void @callee_i64(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee_i64(i64 %x)
  call void @callee_i64(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

