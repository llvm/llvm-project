; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -msan-kernel=1 -msan-eager-checks=1 -S -passes=msan | FileCheck %s

; KMSAN instrumentation regions with eager checks (-fsanitize-memory-param-retval,
; which is what the kernel uses with CONFIG_KMSAN_CHECK_PARAM_RETVAL): a callee
; does not read the parameter shadow of its noundef arguments, so the calls in
; a region only clear the shadow of the remaining ones, and do not fetch the
; context state at all if there are none.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

%struct.pair = type { i64, i64 }

declare void @callee_noundef(i64 noundef, ptr noundef)
declare void @callee_mixed(i64 noundef, i64, i64 noundef, %struct.pair)
declare noundef i64 @callee_ret_noundef(i64 noundef)
declare i64 @callee_ret(i64 noundef)
declare void @callee_varargs(ptr noundef, ...)

; All the arguments are noundef: nothing to do, the call is left as it is.
define void @all_noundef(i64 %x, ptr %p) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @all_noundef(
; CHECK-SAME: i64 [[X:%.*]], ptr [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    call void @callee_noundef(i64 noundef [[X]], ptr noundef [[P]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee_noundef(i64 noundef %x, ptr noundef %p)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

; Only the arguments that are not noundef get their shadow cleared: the ones at
; the offsets 8 (i64) and 24 (struct).
define void @mixed(i64 %x, %struct.pair %s) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @mixed(
; CHECK-SAME: i64 [[X:%.*]], [[STRUCT_PAIR:%.*]] [[S:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 8
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    [[_MSARG1:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 24
; CHECK-NEXT:    store { i64, i64 } zeroinitializer, ptr [[_MSARG1]], align 8
; CHECK-NEXT:    call void @callee_mixed(i64 noundef [[X]], i64 [[X]], i64 noundef [[X]], [[STRUCT_PAIR]] [[S]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void @callee_mixed(i64 noundef %x, i64 %x, i64 noundef %x, %struct.pair %s)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

; The shadow of the return value is of no interest, noundef or not.
define i64 @returns(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define i64 @returns(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[A:%.*]] = call noundef i64 @callee_ret_noundef(i64 noundef [[X]])
; CHECK-NEXT:    [[B:%.*]] = call i64 @callee_ret(i64 noundef [[A]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret i64 [[B]]
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  %a = call noundef i64 @callee_ret_noundef(i64 noundef %x)
  %b = call i64 @callee_ret(i64 noundef %a)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret i64 %b
}

; The shadow of variadic arguments is always passed through the TLS.
define void @varargs(ptr %fmt, i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @varargs(
; CHECK-SAME: ptr [[FMT:%.*]], i64 [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[VA_ARG_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 2
; CHECK-NEXT:    [[VA_ARG_ORIGIN:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 3
; CHECK-NEXT:    [[VA_ARG_OVERFLOW_SIZE:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 4
; CHECK-NEXT:    [[_MSARG_VA_S1:%.*]] = getelementptr i8, ptr [[VA_ARG_SHADOW]], i64 8
; CHECK-NEXT:    [[_MSARG_VA_O2:%.*]] = getelementptr i8, ptr [[VA_ARG_ORIGIN]], i64 8
; CHECK-NEXT:    store i64 0, ptr [[_MSARG_VA_S1]], align 8
; CHECK-NEXT:    store i64 0, ptr [[_MSARG_VA_O2]], align 8
; CHECK-NEXT:    store i64 0, ptr [[VA_ARG_OVERFLOW_SIZE]], align 8
; CHECK-NEXT:    call void (ptr, ...) @callee_varargs(ptr noundef [[FMT]], i64 noundef [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", "~{dirflag},~{fpsr},~{flags}"()
  call void (ptr, ...) @callee_varargs(ptr noundef %fmt, i64 noundef %x)
  call void asm sideeffect "# kmsan.instrumentation.end", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}
