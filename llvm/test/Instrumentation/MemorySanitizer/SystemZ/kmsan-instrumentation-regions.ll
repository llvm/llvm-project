; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -msan-kernel=1 -S -passes=msan | FileCheck %s

; KMSAN instrumentation regions on s390x. Unlike in an instrumented function,
; there is no prologue, and so no stack slot for the KMSAN runtime to return
; shadow pointers through: the calls in a region do not look up any shadow.

target datalayout = "E-m:e-i1:8:16-i8:8:16-i64:64-f128:64-a:8:16-n32:64"
target triple = "s390x-unknown-linux-gnu"

%struct.pair = type { i64, i64 }

declare void @callee(i64)
declare void @callee_byval(ptr byval(%struct.pair))
declare void @callee_varargs(ptr, ...)

define void @basic(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @basic(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void @callee(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", ""()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    call void @callee(i64 [[X]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", ""()
; CHECK-NEXT:    call void @callee(i64 [[X]])
; CHECK-NEXT:    ret void
;
entry:
  call void @callee(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.begin", ""()
  call void @callee(i64 %x)
  call void asm sideeffect "# kmsan.instrumentation.end", ""()
  call void @callee(i64 %x)
  ret void
}

define void @byval_arg(ptr %p) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @byval_arg(
; CHECK-SAME: ptr [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", ""()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[_MSARG]], i8 0, i64 16, i1 false)
; CHECK-NEXT:    call void @callee_byval(ptr byval([[STRUCT_PAIR:%.*]]) [[P]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", ""()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", ""()
  call void @callee_byval(ptr byval(%struct.pair) %p)
  call void asm sideeffect "# kmsan.instrumentation.end", ""()
  ret void
}

define void @varargs_call(ptr %fmt, i64 %x, i32 signext %y) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @varargs_call(
; CHECK-SAME: ptr [[FMT:%.*]], i64 [[X:%.*]], i32 signext [[Y:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.begin", ""()
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @__msan_get_context_state()
; CHECK-NEXT:    [[PARAM_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 0
; CHECK-NEXT:    [[VA_ARG_SHADOW:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 2
; CHECK-NEXT:    [[VA_ARG_ORIGIN:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 3
; CHECK-NEXT:    [[VA_ARG_OVERFLOW_SIZE:%.*]] = getelementptr { [100 x i64], [100 x i64], [100 x i64], [100 x i64], i64, [200 x i32], i32, i32 }, ptr [[TMP0]], i32 0, i32 4
; CHECK-NEXT:    [[_MSARG:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 0
; CHECK-NEXT:    store i64 0, ptr [[_MSARG]], align 8
; CHECK-NEXT:    [[_MSARG1:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 8
; CHECK-NEXT:    store i64 0, ptr [[_MSARG1]], align 8
; CHECK-NEXT:    [[_MSARG2:%.*]] = getelementptr i8, ptr [[PARAM_SHADOW]], i64 16
; CHECK-NEXT:    store i32 0, ptr [[_MSARG2]], align 8
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[VA_ARG_SHADOW]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP1]], 24
; CHECK-NEXT:    [[_MSARG_VA_O:%.*]] = getelementptr i8, ptr [[VA_ARG_ORIGIN]], i64 24
; CHECK-NEXT:    [[_MSARG_VA_S:%.*]] = inttoptr i64 [[TMP2]] to ptr
; CHECK-NEXT:    store i64 0, ptr [[_MSARG_VA_S]], align 8
; CHECK-NEXT:    store i32 0, ptr [[_MSARG_VA_O]], align 4
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i32, ptr [[_MSARG_VA_O]], i32 1
; CHECK-NEXT:    store i32 0, ptr [[TMP3]], align 4
; CHECK-NEXT:    [[TMP4:%.*]] = ptrtoint ptr [[VA_ARG_SHADOW]] to i64
; CHECK-NEXT:    [[TMP5:%.*]] = add i64 [[TMP4]], 32
; CHECK-NEXT:    [[_MSARG_VA_O3:%.*]] = getelementptr i8, ptr [[VA_ARG_ORIGIN]], i64 32
; CHECK-NEXT:    [[_MSARG_VA_S4:%.*]] = inttoptr i64 [[TMP5]] to ptr
; CHECK-NEXT:    store i64 0, ptr [[_MSARG_VA_S4]], align 8
; CHECK-NEXT:    store i32 0, ptr [[_MSARG_VA_O3]], align 4
; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr i32, ptr [[_MSARG_VA_O3]], i32 1
; CHECK-NEXT:    store i32 0, ptr [[TMP6]], align 4
; CHECK-NEXT:    store i64 0, ptr [[VA_ARG_OVERFLOW_SIZE]], align 8
; CHECK-NEXT:    call void (ptr, ...) @callee_varargs(ptr [[FMT]], i64 [[X]], i32 signext [[Y]])
; CHECK-NEXT:    call void asm sideeffect "# kmsan.instrumentation.end", ""()
; CHECK-NEXT:    ret void
;
entry:
  call void asm sideeffect "# kmsan.instrumentation.begin", ""()
  call void (ptr, ...) @callee_varargs(ptr %fmt, i64 %x, i32 signext %y)
  call void asm sideeffect "# kmsan.instrumentation.end", ""()
  ret void
}
