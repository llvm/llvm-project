; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt %s -S -passes=msan 2>&1 | FileCheck %s
;
; Test MemorySanitizer instrumentation of the llvm.modf / llvm.sincos /
; llvm.sincospi intrinsics. The handler should propagate the argument's shadow,
; unchanged, to both elements of the returned struct.

target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define { float, float } @test_modf_f32(float %a) #0 {
; CHECK-LABEL: define { float, float } @test_modf_f32(
; CHECK-SAME: float [[A:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[TMP1:%.*]] = load i32, ptr @__msan_param_tls, align 8
; CHECK-NEXT:    call void @llvm.donothing()
; CHECK-NEXT:    [[TMP2:%.*]] = insertvalue { i32, i32 } poison, i32 [[TMP1]], 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertvalue { i32, i32 } [[TMP2]], i32 [[TMP1]], 1
; CHECK-NEXT:    [[RES:%.*]] = call { float, float } @llvm.modf.f32(float [[A]])
; CHECK-NEXT:    store { i32, i32 } [[TMP3]], ptr @__msan_retval_tls, align 8
; CHECK-NEXT:    ret { float, float } [[RES]]
;
  %res = call { float, float } @llvm.modf.f32(float %a)
  ret { float, float } %res
}

