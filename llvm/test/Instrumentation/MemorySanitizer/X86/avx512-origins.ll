; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -mattr=+avx512f,+avx512vl -passes='msan<track-origins=2>' -S | FileCheck %s
;
; Origin tracking corner cases for AVX512 intrinsics. Shadow propagation is
; tested in avx512*-intrinsics.ll; keep only origin-specific cases here.
;
; PMOV (truncating store): each destination element width (8/16/32 bits),
; stores smaller than an origin slot and larger than a pointer, and an aligned
; destination.

target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

