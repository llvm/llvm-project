; CHECK-NEXT:    [[TMP3:%.*]] = load <4 x i32>, ptr @__msan_param_tls, align 8
; CHECK-NEXT:    call void @llvm.donothing()
; CHECK-NEXT:    [[TMP4:%.*]] = icmp ne <8 x i16> [[TMP1]], zeroinitializer
; CHECK-NEXT:    [[TMP5:%.*]] = sext <8 x i1> [[TMP4]] to <8 x i32>
; CHECK-NEXT:    [[A_FPEXT:%.*]] = fpext <8 x bfloat> [[A]] to <8 x float>
; CHECK-NEXT:    [[TMP6:%.*]] = icmp ne <8 x i16> [[TMP2]], zeroinitializer
