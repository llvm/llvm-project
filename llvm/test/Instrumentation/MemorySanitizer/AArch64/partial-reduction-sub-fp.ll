; CHECK-NEXT:    [[B_FPEXT:%.*]] = fpext <8 x bfloat> [[B]] to <8 x float>
; CHECK-NEXT:    [[B_FPEXT_NEG:%.*]] = fneg <8 x float> [[B_FPEXT]]
