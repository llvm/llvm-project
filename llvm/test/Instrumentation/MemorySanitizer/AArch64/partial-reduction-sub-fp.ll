  %b.fpext = fpext <8 x bfloat> %b to <8 x float>
  %b.fpext.neg = fneg <8 x float> %b.fpext
  %mul = fmul fast <8 x float> %a.fpext, %b.fpext.neg
  %res = call fast <4 x float> @llvm.vector.partial.reduce.fadd(<4 x float> %acc, <8 x float> %mul)
  ret <4 x float> %res
}

