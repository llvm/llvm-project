declare void @callee(i64)

define void @region(i64 %x) disable_sanitizer_instrumentation {
; CHECK-LABEL: define void @region(
; CHECK-SAME: i64 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
