; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt < %s -S -passes=msan                       | FileCheck %s --check-prefixes=CHECK
; RUN: opt < %s -S -passes=msan -msan-track-origins=1 | FileCheck %s --check-prefixes=ORIGIN
;
; addrspacecast must propagate the operand's shadow and origin like the other
; casts (bitcast, ptrtoint, inttoptr) do, rather than checking the operand and
; producing a clean result shadow.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define ptr addrspace(1) @AddrSpaceCast(ptr %x) nounwind uwtable readnone sanitize_memory {
; CHECK-LABEL: define ptr addrspace(1) @AddrSpaceCast(
; CHECK-SAME: ptr [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = load i64, ptr @__msan_param_tls, align 8
; CHECK-NEXT:    call void @llvm.donothing()
; CHECK-NEXT:    [[TMP1:%.*]] = addrspacecast ptr [[X]] to ptr addrspace(1)
; CHECK-NEXT:    store i64 [[TMP0]], ptr @__msan_retval_tls, align 8
; CHECK-NEXT:    ret ptr addrspace(1) [[TMP1]]
;
; ORIGIN-LABEL: define ptr addrspace(1) @AddrSpaceCast(
; ORIGIN-SAME: ptr [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; ORIGIN-NEXT:  [[ENTRY:.*:]]
; ORIGIN-NEXT:    [[TMP0:%.*]] = load i64, ptr @__msan_param_tls, align 8
; ORIGIN-NEXT:    [[TMP1:%.*]] = load i32, ptr @__msan_param_origin_tls, align 4
; ORIGIN-NEXT:    call void @llvm.donothing()
; ORIGIN-NEXT:    [[TMP2:%.*]] = addrspacecast ptr [[X]] to ptr addrspace(1)
; ORIGIN-NEXT:    store i64 [[TMP0]], ptr @__msan_retval_tls, align 8
; ORIGIN-NEXT:    store i32 [[TMP1]], ptr @__msan_retval_origin_tls, align 4
; ORIGIN-NEXT:    ret ptr addrspace(1) [[TMP2]]
;
entry:
  %0 = addrspacecast ptr %x to ptr addrspace(1)
  ret ptr addrspace(1) %0
}

