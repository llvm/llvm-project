; NOSCALE-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT]], [[N]]
; NOSCALE-NEXT:    store i64 [[TMP1]], ptr @__profc_bar, align 8
; NOSCALE-NEXT:    ret void
;
  call void @llvm.instrprof.increment.step(ptr @__profn_bar, i64 0, i32 1, i32 0, i64 %n)
  ret void
}

; With counter promotion the scaled steps are summed in a register and added to
; the counter at the loop exit.
define void @loop(i32 %n) {
; CHECK-LABEL: define void @loop(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; CHECK-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP0]], align 8
; CHECK-NEXT:    br label %[[BODY:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[BODY]] ]
; CHECK-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_loop, align 8
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_SCALE]]
; CHECK-NEXT:    store i64 [[TMP1]], ptr @__profc_loop, align 8
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[BODY]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    br label %[[RETURN:.*]]
; CHECK:       [[RETURN]]:
; CHECK-NEXT:    ret void
;
; ATOMIC-LABEL: define void @loop(
; ATOMIC-SAME: i32 [[N:%.*]]) {
; ATOMIC-NEXT:  [[ENTRY:.*]]:
; ATOMIC-NEXT:    [[TMP0:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; ATOMIC-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP0]], align 8
; ATOMIC-NEXT:    br label %[[BODY:.*]]
; ATOMIC:       [[BODY]]:
; ATOMIC-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[BODY]] ]
; ATOMIC-NEXT:    [[TMP1:%.*]] = atomicrmw add ptr @__profc_loop, i64 [[PGOCOUNT_SCALE]] monotonic, align 8
; ATOMIC-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; ATOMIC-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; ATOMIC-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[BODY]]
; ATOMIC:       [[EXIT]]:
; ATOMIC-NEXT:    br label %[[RETURN:.*]]
; ATOMIC:       [[RETURN]]:
; ATOMIC-NEXT:    ret void
;
; PROMO-LABEL: define void @loop(
; PROMO-SAME: i32 [[N:%.*]]) {
; PROMO-NEXT:  [[ENTRY:.*]]:
; PROMO-NEXT:    [[TMP0:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; PROMO-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP0]], align 8
; PROMO-NEXT:    br label %[[BODY:.*]]
; PROMO:       [[BODY]]:
; PROMO-NEXT:    [[PGOCOUNT1:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[TMP1:%.*]], %[[BODY]] ]
; PROMO-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[BODY]] ]
; PROMO-NEXT:    [[TMP1]] = add i64 [[PGOCOUNT1]], [[PGOCOUNT_SCALE]]
; PROMO-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; PROMO-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; PROMO-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[BODY]]
; PROMO:       [[EXIT]]:
; PROMO-NEXT:    [[PGOCOUNT_PROMOTED:%.*]] = load i64, ptr @__profc_loop, align 8
; PROMO-NEXT:    [[TMP2:%.*]] = add i64 [[PGOCOUNT_PROMOTED]], [[TMP1]]
; PROMO-NEXT:    store i64 [[TMP2]], ptr @__profc_loop, align 8
; PROMO-NEXT:    br label %[[RETURN:.*]]
; PROMO:       [[RETURN]]:
