;
; NOSCALE-LABEL: define void @loop(
; NOSCALE-SAME: i32 [[N:%.*]]) {
; NOSCALE-NEXT:  [[ENTRY:.*]]:
; NOSCALE-NEXT:    br label %[[BODY:.*]]
; NOSCALE:       [[BODY]]:
; NOSCALE-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[BODY]] ]
; NOSCALE-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_loop, align 8
; NOSCALE-NEXT:    [[TMP0:%.*]] = add i64 [[PGOCOUNT]], 1
; NOSCALE-NEXT:    store i64 [[TMP0]], ptr @__profc_loop, align 8
; NOSCALE-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; NOSCALE-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; NOSCALE-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[BODY]]
; NOSCALE:       [[EXIT]]:
; NOSCALE-NEXT:    br label %[[RETURN:.*]]
; NOSCALE:       [[RETURN]]:
; NOSCALE-NEXT:    ret void
;
entry:
  br label %body

body:
  %i = phi i32 [ 0, %entry ], [ %i.next, %body ]
  call void @llvm.instrprof.increment(ptr @__profn_loop, i64 0, i32 1, i32 0)
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %body

exit:
  br label %return

return:
  ret void
}

declare void @llvm.instrprof.increment(ptr, i64, i32, i32)
declare void @llvm.instrprof.increment.step(ptr, i64, i32, i32, i64)
