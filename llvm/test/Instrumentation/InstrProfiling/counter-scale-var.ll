; GLOBAL-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr @global_scale, align 8
; GLOBAL-NEXT:    br label %[[BODY:.*]]
; GLOBAL:       [[BODY]]:
; GLOBAL-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[BODY]] ]
; GLOBAL-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_loop, align 8
; GLOBAL-NEXT:    [[TMP0:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_SCALE]]
; GLOBAL-NEXT:    store i64 [[TMP0]], ptr @__profc_loop, align 8
; GLOBAL-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; GLOBAL-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; GLOBAL-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[BODY]]
; GLOBAL:       [[EXIT]]:
; GLOBAL-NEXT:    br label %[[RETURN:.*]]
