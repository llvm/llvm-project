;
; GLOBAL-LABEL: define void @bar(
; GLOBAL-SAME: i64 [[N:%.*]]) {
; GLOBAL-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr @global_scale, align 8
; GLOBAL-NEXT:    [[PGOCOUNT_STEP:%.*]] = mul i64 [[N]], [[PGOCOUNT_SCALE]]
; GLOBAL-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_bar, align 8
; GLOBAL-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_STEP]]
; GLOBAL-NEXT:    store i64 [[TMP1]], ptr @__profc_bar, align 8
; GLOBAL-NEXT:    ret void
;
