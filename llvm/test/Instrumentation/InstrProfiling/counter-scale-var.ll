; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; Test that -instrprof-counter-scale-var multiplies every counter increment by
; a per-thread scale variable, loaded once per function.

; RUN: opt < %s -S -passes=instrprof -instrprof-counter-scale-var=scale | FileCheck %s
; RUN: opt < %s -S -passes=instrprof -instrprof-counter-scale-var=scale -instrprof-atomic-counter-update-all | FileCheck %s --check-prefix=ATOMIC
; RUN: opt < %s -S -passes=instrprof -instrprof-counter-scale-var=scale -do-counter-promotion=true | FileCheck %s --check-prefix=PROMO
; RUN: opt < %s -S -passes=instrprof -instrprof-counter-scale-var=global_scale | FileCheck %s --check-prefix=GLOBAL
; RUN: opt < %s -S -passes=instrprof | FileCheck %s --check-prefix=NOSCALE

target triple = "arm64-apple-macosx14.0.0"

@__profn_foo = private constant [3 x i8] c"foo"
@__profn_bar = private constant [3 x i8] c"bar"
@__profn_loop = private constant [4 x i8] c"loop"

; A variable the module already declares is used as is; a non-thread_local one
; gives a process-wide scale.
@global_scale = external global i64

; Two increments with the default step of 1: one load of the scale, used
; directly as the step.
define void @foo(i1 %c) {
; CHECK-LABEL: define void @foo(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; CHECK-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP0]], align 8
; CHECK-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_foo, align 8
; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_SCALE]]
; CHECK-NEXT:    store i64 [[TMP1]], ptr @__profc_foo, align 8
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[PGOCOUNT1:%.*]] = load i64, ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[PGOCOUNT1]], [[PGOCOUNT_SCALE]]
; CHECK-NEXT:    store i64 [[TMP2]], ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
; ATOMIC-LABEL: define void @foo(
; ATOMIC-SAME: i1 [[C:%.*]]) {
; ATOMIC-NEXT:  [[ENTRY:.*:]]
; ATOMIC-NEXT:    [[TMP0:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; ATOMIC-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP0]], align 8
; ATOMIC-NEXT:    [[TMP1:%.*]] = atomicrmw add ptr @__profc_foo, i64 [[PGOCOUNT_SCALE]] monotonic, align 8
; ATOMIC-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; ATOMIC:       [[THEN]]:
; ATOMIC-NEXT:    [[TMP2:%.*]] = atomicrmw add ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), i64 [[PGOCOUNT_SCALE]] monotonic, align 8
; ATOMIC-NEXT:    br label %[[EXIT]]
; ATOMIC:       [[EXIT]]:
; ATOMIC-NEXT:    ret void
;
; PROMO-LABEL: define void @foo(
; PROMO-SAME: i1 [[C:%.*]]) {
; PROMO-NEXT:  [[ENTRY:.*:]]
; PROMO-NEXT:    [[TMP0:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; PROMO-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP0]], align 8
; PROMO-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_foo, align 8
; PROMO-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_SCALE]]
; PROMO-NEXT:    store i64 [[TMP1]], ptr @__profc_foo, align 8
; PROMO-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; PROMO:       [[THEN]]:
; PROMO-NEXT:    [[PGOCOUNT1:%.*]] = load i64, ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; PROMO-NEXT:    [[TMP2:%.*]] = add i64 [[PGOCOUNT1]], [[PGOCOUNT_SCALE]]
; PROMO-NEXT:    store i64 [[TMP2]], ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; PROMO-NEXT:    br label %[[EXIT]]
; PROMO:       [[EXIT]]:
; PROMO-NEXT:    ret void
;
; GLOBAL-LABEL: define void @foo(
; GLOBAL-SAME: i1 [[C:%.*]]) {
; GLOBAL-NEXT:  [[ENTRY:.*:]]
; GLOBAL-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr @global_scale, align 8
; GLOBAL-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_foo, align 8
; GLOBAL-NEXT:    [[TMP0:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_SCALE]]
; GLOBAL-NEXT:    store i64 [[TMP0]], ptr @__profc_foo, align 8
; GLOBAL-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; GLOBAL:       [[THEN]]:
; GLOBAL-NEXT:    [[PGOCOUNT1:%.*]] = load i64, ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; GLOBAL-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT1]], [[PGOCOUNT_SCALE]]
; GLOBAL-NEXT:    store i64 [[TMP1]], ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; GLOBAL-NEXT:    br label %[[EXIT]]
; GLOBAL:       [[EXIT]]:
; GLOBAL-NEXT:    ret void
;
; NOSCALE-LABEL: define void @foo(
; NOSCALE-SAME: i1 [[C:%.*]]) {
; NOSCALE-NEXT:  [[ENTRY:.*:]]
; NOSCALE-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_foo, align 8
; NOSCALE-NEXT:    [[TMP0:%.*]] = add i64 [[PGOCOUNT]], 1
; NOSCALE-NEXT:    store i64 [[TMP0]], ptr @__profc_foo, align 8
; NOSCALE-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
; NOSCALE:       [[THEN]]:
; NOSCALE-NEXT:    [[PGOCOUNT1:%.*]] = load i64, ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; NOSCALE-NEXT:    [[TMP1:%.*]] = add i64 [[PGOCOUNT1]], 1
; NOSCALE-NEXT:    store i64 [[TMP1]], ptr getelementptr inbounds (i8, ptr @__profc_foo, i64 8), align 8
; NOSCALE-NEXT:    br label %[[EXIT]]
; NOSCALE:       [[EXIT]]:
; NOSCALE-NEXT:    ret void
;
entry:
  call void @llvm.instrprof.increment(ptr @__profn_foo, i64 0, i32 2, i32 0)
  br i1 %c, label %then, label %exit

then:
  call void @llvm.instrprof.increment(ptr @__profn_foo, i64 0, i32 2, i32 1)
  br label %exit

exit:
  ret void
}

; A non-unit step is multiplied by the scale.
define void @bar(i64 %n) {
; CHECK-LABEL: define void @bar(
; CHECK-SAME: i64 [[N:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; CHECK-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP1]], align 8
; CHECK-NEXT:    [[PGOCOUNT_STEP:%.*]] = mul i64 [[N]], [[PGOCOUNT_SCALE]]
; CHECK-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_bar, align 8
; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_STEP]]
; CHECK-NEXT:    store i64 [[TMP2]], ptr @__profc_bar, align 8
; CHECK-NEXT:    ret void
;
; ATOMIC-LABEL: define void @bar(
; ATOMIC-SAME: i64 [[N:%.*]]) {
; ATOMIC-NEXT:    [[TMP1:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; ATOMIC-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP1]], align 8
; ATOMIC-NEXT:    [[PGOCOUNT_STEP:%.*]] = mul i64 [[N]], [[PGOCOUNT_SCALE]]
; ATOMIC-NEXT:    [[TMP2:%.*]] = atomicrmw add ptr @__profc_bar, i64 [[PGOCOUNT_STEP]] monotonic, align 8
; ATOMIC-NEXT:    ret void
;
; PROMO-LABEL: define void @bar(
; PROMO-SAME: i64 [[N:%.*]]) {
; PROMO-NEXT:    [[TMP1:%.*]] = call ptr @llvm.threadlocal.address.p0(ptr @scale)
; PROMO-NEXT:    [[PGOCOUNT_SCALE:%.*]] = load i64, ptr [[TMP1]], align 8
; PROMO-NEXT:    [[PGOCOUNT_STEP:%.*]] = mul i64 [[N]], [[PGOCOUNT_SCALE]]
; PROMO-NEXT:    [[PGOCOUNT:%.*]] = load i64, ptr @__profc_bar, align 8
; PROMO-NEXT:    [[TMP2:%.*]] = add i64 [[PGOCOUNT]], [[PGOCOUNT_STEP]]
; PROMO-NEXT:    store i64 [[TMP2]], ptr @__profc_bar, align 8
