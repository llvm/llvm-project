entry:
  invoke void @may_throw()
  to label %exit unwind label %catch.dispatch

catch.dispatch:
  %cs = catchswitch within none [label %catch] unwind label %ehcleanup

catch:
  %cp = catchpad within %cs [ptr null, i32 64, ptr null]
  %p = call ptr @"??2@YAPEAX_K@Z"(i64 32) [ "funclet"(token %cp) ], !alloc_token !0
  store ptr %p, ptr @sink
  catchret from %cp to label %exit

ehcleanup:
  %clp = cleanuppad within none []
  %q = call ptr @malloc(i64 64) [ "funclet"(token %clp) ], !alloc_token !0
  store ptr %q, ptr @sink
