; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; Test that operand bundles are preserved when replacing allocation calls, in
; particular "funclet" bundles of calls inside Windows EH funclets. Without
; them, invokes fail verification, and WinEHPrepare replaces calls with
; unreachable.
;
; RUN: opt < %s -passes=inferattrs,alloc-token -S | FileCheck %s

target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc"

@sink = global ptr null

declare i32 @__CxxFrameHandler3(...)
declare void @may_throw()
declare void @dtor()
declare ptr @malloc(i64)
declare ptr @"??2@YAPEAX_K@Z"(i64)

; Invoke inside a catch funclet that unwinds to a nested cleanup.
define void @test_invoke_in_funclet() sanitize_alloc_token personality ptr @__CxxFrameHandler3 {
; CHECK-LABEL: define void @test_invoke_in_funclet(
; CHECK-SAME: ) #[[ATTR2:[0-9]+]] personality ptr @__CxxFrameHandler3 {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    invoke void @may_throw()
; CHECK-NEXT:            to label %[[EXIT:.*]] unwind label %[[CATCH_DISPATCH:.*]]
; CHECK:       [[CATCH_DISPATCH]]:
; CHECK-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[CATCH:.*]]] unwind to caller
; CHECK:       [[CATCH]]:
; CHECK-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr null, i32 64, ptr null]
; CHECK-NEXT:    [[TMP0:%.*]] = invoke ptr @"__alloc_token_??2@YAPEAX_K@Z"(i64 32, i64 2689373973731826898) [ "funclet"(token [[CP]]) ]
; CHECK-NEXT:            to label %[[INVOKE_CONT:.*]] unwind label %[[EHCLEANUP:.*]], !alloc_token [[META0:![0-9]+]]
; CHECK:       [[INVOKE_CONT]]:
; CHECK-NEXT:    store ptr [[TMP0]], ptr @sink, align 8
; CHECK-NEXT:    call void @dtor() [ "funclet"(token [[CP]]) ]
; CHECK-NEXT:    catchret from [[CP]] to label %[[EXIT]]
; CHECK:       [[EHCLEANUP]]:
; CHECK-NEXT:    [[CLP:%.*]] = cleanuppad within [[CP]] []
; CHECK-NEXT:    call void @dtor() [ "funclet"(token [[CLP]]) ]
; CHECK-NEXT:    cleanupret from [[CLP]] unwind to caller
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  invoke void @may_throw()
  to label %exit unwind label %catch.dispatch

catch.dispatch:
  %cs = catchswitch within none [label %catch] unwind to caller

catch:
  %cp = catchpad within %cs [ptr null, i32 64, ptr null]
  %p = invoke ptr @"??2@YAPEAX_K@Z"(i64 32) [ "funclet"(token %cp) ]
  to label %invoke.cont unwind label %ehcleanup, !alloc_token !0

invoke.cont:
  store ptr %p, ptr @sink
  call void @dtor() [ "funclet"(token %cp) ]
  catchret from %cp to label %exit

ehcleanup:
  %clp = cleanuppad within %cp []
  call void @dtor() [ "funclet"(token %clp) ]
  cleanupret from %clp unwind to caller

exit:
  ret void
}

