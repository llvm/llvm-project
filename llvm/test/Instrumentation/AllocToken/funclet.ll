; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    invoke void @may_throw()
; CHECK-NEXT:            to label %[[EXIT:.*]] unwind label %[[CATCH_DISPATCH:.*]]
; CHECK:       [[CATCH_DISPATCH]]:
; CHECK-NEXT:    [[CS:%.*]] = catchswitch within none [label %[[CATCH:.*]]] unwind label %[[EHCLEANUP:.*]]
; CHECK:       [[CATCH]]:
; CHECK-NEXT:    [[CP:%.*]] = catchpad within [[CS]] [ptr null, i32 64, ptr null]
; CHECK-NEXT:    [[TMP0:%.*]] = call ptr @"__alloc_token_??2@YAPEAX_K@Z"(i64 32, i64 2689373973731826898) [ "funclet"(token [[CP]]) ], !alloc_token [[META0]]
; CHECK-NEXT:    store ptr [[TMP0]], ptr @sink, align 8
; CHECK-NEXT:    catchret from [[CP]] to label %[[EXIT]]
; CHECK:       [[EHCLEANUP]]:
; CHECK-NEXT:    [[CLP:%.*]] = cleanuppad within none []
; CHECK-NEXT:    [[Q:%.*]] = call ptr @__alloc_token_malloc(i64 64, i64 2689373973731826898) [ "funclet"(token [[CLP]]) ], !alloc_token [[META0]]
; CHECK-NEXT:    store ptr [[Q]], ptr @sink, align 8
; CHECK-NEXT:    cleanupret from [[CLP]] unwind to caller
