import("//third-party/unittest/unittest.gni")

unittest("ClangIncludeCleanerTests") {
  configs += [ "//llvm/utils/gn/build:clang_code" ]
  deps = [
    "//clang-tools-extra/include-cleaner/lib",
    "//clang/lib/AST",
    "//clang/lib/Basic",
    "//clang/lib/Format",
    "//clang/lib/Frontend",
    "//clang/lib/Lex",
    "//clang/lib/Serialization",
    "//clang/lib/Testing",
    "//clang/lib/Tooling/Inclusions/Stdlib",
    "//llvm/lib/Support",
    "//llvm/lib/Testing/Annotations",
    "//llvm/lib/Testing/Support",
  ]
  include_dirs = [
    "../lib",
    "../include",
  ]
  sources = [
    "AnalysisTest.cpp",
    "FindHeadersTest.cpp",
    "IncludeSpellerTest.cpp",
    "LocateSymbolTest.cpp",
    "RecordTest.cpp",
    "TypesTest.cpp",
    "WalkASTTest.cpp",
  ]
}
