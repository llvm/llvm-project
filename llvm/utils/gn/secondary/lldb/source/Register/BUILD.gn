  deps = [
    "//lldb/source/Utility",
    "//llvm/lib/Support",
    "//llvm/lib/TargetParser",
  ]
  include_dirs = [ "//lldb/source" ]
  sources = [
    "Common/RegisterInfo_arm.cpp",
    "Common/RegisterInfo_arm64.cpp",
    "Common/RegisterInfo_loongarch64.cpp",
    "Common/RegisterInfo_powerpc.cpp",
    "Common/RegisterInfo_ppc64.cpp",
    "Common/RegisterInfo_ppc64le.cpp",
    "Common/RegisterInfo_riscv32.cpp",
    "Common/RegisterInfo_riscv64.cpp",
    "Common/RegisterInfo_s390x.cpp",
    "Common/RegisterInfo_x86.cpp",
    "DumpRegisterInfo.cpp",
    "Layouts/FreeBSD/RegisterLayoutFreeBSD_arm.cpp",
    "Layouts/FreeBSD/RegisterLayoutFreeBSD_arm64.cpp",
    "Layouts/FreeBSD/RegisterLayoutFreeBSD_i386.cpp",
    "Layouts/FreeBSD/RegisterLayoutFreeBSD_powerpc.cpp",
    "Layouts/FreeBSD/RegisterLayoutFreeBSD_x86_64.cpp",
    "Layouts/Linux/RegisterLayoutLinux_arm.cpp",
    "Layouts/Linux/RegisterLayoutLinux_arm64.cpp",
    "Layouts/Linux/RegisterLayoutLinux_i386.cpp",
    "Layouts/Linux/RegisterLayoutLinux_loongarch64.cpp",
    "Layouts/Linux/RegisterLayoutLinux_ppc64le.cpp",
    "Layouts/Linux/RegisterLayoutLinux_riscv64.cpp",
    "Layouts/Linux/RegisterLayoutLinux_s390x.cpp",
    "Layouts/Linux/RegisterLayoutLinux_x86_64.cpp",
    "Layouts/NetBSD/RegisterLayoutNetBSD_i386.cpp",
    "Layouts/NetBSD/RegisterLayoutNetBSD_x86_64.cpp",
    "RegisterContext.cpp",
    "RegisterDefinition.cpp",
    "RegisterDescription.cpp",
    "RegisterLayout.cpp",
    "RegisterType.cpp",
    "RegisterTypeFlags.cpp",
    "RegisterValue.cpp",
  ]
