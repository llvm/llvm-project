import("//llvm/utils/gn/build/write_cmake_config.gni")
import("//llvm/version.gni")

# Python tool. Copies its scripts into the build dir, like scan-build.
group("clang-ssaf-orchestrator-make") {
  deps = [
    ":bin",
    ":lib",
    ":shim",
    ":shims",
    ":version",
  ]
}

copy("bin") {
  sources = [ "bin/clang-ssaf-orchestrator-make" ]
  outputs = [ "$root_build_dir/bin/{{source_file_part}}" ]
}

copy("lib") {
  sources = [
    "lib/clang_ssaf_orchestrator_make/__init__.py",
    "lib/clang_ssaf_orchestrator_make/build_graph.py",
    "lib/clang_ssaf_orchestrator_make/config.py",
    "lib/clang_ssaf_orchestrator_make/config_orchestrator.py",
    "lib/clang_ssaf_orchestrator_make/config_shims.py",
    "lib/clang_ssaf_orchestrator_make/failure_logs.py",
    "lib/clang_ssaf_orchestrator_make/interposition.py",
    "lib/clang_ssaf_orchestrator_make/logging_diagnostics.py",
    "lib/clang_ssaf_orchestrator_make/options.py",
    "lib/clang_ssaf_orchestrator_make/orchestrator.py",
    "lib/clang_ssaf_orchestrator_make/ssaf_artifact_repository.py",
    "lib/clang_ssaf_orchestrator_make/utils.py",
  ]
  outputs = [
    "$root_build_dir/lib/clang_ssaf_orchestrator_make/{{source_file_part}}",
  ]
}

write_cmake_config("version") {
  input = "lib/clang_ssaf_orchestrator_make/version.py.in"
  output = "$root_build_dir/lib/clang_ssaf_orchestrator_make/version.py"
  values = [ "CLANG_VERSION=$llvm_version" ]
}

copy("shims") {
  sources = [
    "lib/clang_ssaf_orchestrator_make/shims/__init__.py",
    "lib/clang_ssaf_orchestrator_make/shims/ar.py",
    "lib/clang_ssaf_orchestrator_make/shims/clang.py",
    "lib/clang_ssaf_orchestrator_make/shims/commands.py",
    "lib/clang_ssaf_orchestrator_make/shims/driver_jobs.py",
    "lib/clang_ssaf_orchestrator_make/shims/ld.py",
    "lib/clang_ssaf_orchestrator_make/shims/run.py",
    "lib/clang_ssaf_orchestrator_make/shims/shim.py",
  ]
  outputs = [ "$root_build_dir/lib/clang_ssaf_orchestrator_make/shims/{{source_file_part}}" ]
}

copy("shim") {
  sources = [ "shims/shim" ]
  outputs =
      [ "$root_build_dir/libexec/ssaf-orchestrator-shims/{{source_file_part}}" ]
}
