import("//llvm/utils/TableGen/tablegen.gni")

tablegen("Opts") {
  visibility = [ ":obj2yaml" ]
  args = [ "-gen-opt-parser-defs" ]
}

executable("obj2yaml") {
  deps = [
    ":Opts",
    "//llvm/lib/DebugInfo/CodeView",
    "//llvm/lib/DebugInfo/DWARF",
    "//llvm/lib/Object",
    "//llvm/lib/ObjectYAML",
    "//llvm/lib/Option",
    "//llvm/lib/Support",
  ]
  sources = [
    "archive2yaml.cpp",
    "coff2yaml.cpp",
    "dwarf2yaml.cpp",
    "dxcontainer2yaml.cpp",
    "elf2yaml.cpp",
    "goff2yaml.cpp",
    "macho2yaml.cpp",
    "minidump2yaml.cpp",
    "obj2yaml.cpp",
    "offload2yaml.cpp",
    "wasm2yaml.cpp",
    "xcoff2yaml.cpp",
  ]
}
