import("//llvm/utils/TableGen/tablegen.gni")

tablegen("TargetLibraryInfo") {
  args = [ "-gen-target-library-info" ]
}

# Corresponds to mlgo_lower_models() in llvm/lib/Analysis/CMakeLists.txt.
# The GN build doesn't support lowering .mlir models (LLVM_MLGO_MODELS),
# it only registers the built-in pre-lowered test model.
copy("inliner_Model1") {
  sources = [ "//llvm/lib/Analysis/models/inline-oz-test-model.inc" ]
  outputs = [ "$target_gen_dir/inliner_Model1.h" ]
}

action("InlinerModels_def") {
  script = "//llvm/utils/gn/build/write_file.py"
  outputs = [ "$target_gen_dir/InlinerModels.def" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    string_join("\n",
                [
                  "/* Auto-generated by GN */",
                  "#ifndef MLGO_MODEL",
                  "#  define MLGO_MODEL(CLASS_NAME, CLI_FLAG)",
                  "#endif",
                  "",
                  "MLGO_MODEL(inliner_Model1, \"_test_inc\")",
                  "",
                  "#undef MLGO_MODEL",
                  "",
                ]),
  ]
}

action("InlinerModels_h") {
  script = "//llvm/utils/gn/build/write_file.py"
  outputs = [ "$target_gen_dir/InlinerModels.h" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    string_join("\n",
                [
                  "/* Auto-generated by GN */",
                  "namespace llvm {",
                  "namespace inliner_Model1_ns {",
                  "#include \"llvm/Analysis/inliner_Model1.h\"",
                  "} // namespace inliner_Model1_ns",
                  "using inliner_Model1 = inliner_Model1_ns::Model;",
                  "} // namespace llvm",
                  "",
                ]),
  ]
}

group("InlinerModels") {
  deps = [
    ":InlinerModels_def",
    ":InlinerModels_h",
    ":inliner_Model1",
  ]
}
