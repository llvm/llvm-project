import("//llvm/utils/TableGen/tablegen.gni")

tablegen("GenVT") {
  args = [ "-gen-vt" ]
  td_file = "//llvm/include/llvm/CodeGen/ValueTypes.td"
  tblgen_target = "//llvm/utils/TableGen:llvm-min-tblgen"
}

# Corresponds to mlgo_lower_models() in llvm/lib/CodeGen/CMakeLists.txt.
# The GN build doesn't support lowering .mlir models (LLVM_MLGO_MODELS),
# it only registers the built-in pre-lowered test model.
copy("regalloc_Model1") {
  sources = [ "//llvm/lib/Analysis/models/regalloc-eviction-test-model.inc" ]
  outputs = [ "$target_gen_dir/regalloc_Model1.h" ]
}

action("RegAllocEvictModels_def") {
  script = "//llvm/utils/gn/build/write_file.py"
  outputs = [ "$target_gen_dir/RegAllocEvictModels.def" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    string_join("\n",
                [
                  "/* Auto-generated by GN */",
                  "#ifndef MLGO_MODEL",
                  "#  define MLGO_MODEL(CLASS_NAME, CLI_FLAG)",
                  "#endif",
                  "",
                  "MLGO_MODEL(regalloc_Model1, \"_test_inc\")",
                  "",
                  "#undef MLGO_MODEL",
                  "",
                ]),
  ]
}

action("RegAllocEvictModels_h") {
  script = "//llvm/utils/gn/build/write_file.py"
  outputs = [ "$target_gen_dir/RegAllocEvictModels.h" ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    string_join("\n",
                [
                  "/* Auto-generated by GN */",
                  "namespace llvm {",
                  "namespace regalloc_Model1_ns {",
                  "#include \"llvm/CodeGen/regalloc_Model1.h\"",
                  "} // namespace regalloc_Model1_ns",
                  "using regalloc_Model1 = regalloc_Model1_ns::Model;",
                  "} // namespace llvm",
                  "",
                ]),
  ]
}

group("RegAllocEvictModels") {
  deps = [
    ":RegAllocEvictModels_def",
    ":RegAllocEvictModels_h",
    ":regalloc_Model1",
  ]
}
