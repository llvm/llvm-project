//===----------------------------------------------------------------------===//
//
// This file is used as the registry of passes that are part of the LoongArch
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("loongarch-asm-printer-begin", LoongArchAsmPrinterBeginPass())
MODULE_PASS("loongarch-asm-printer-end", LoongArchAsmPrinterEndPass())
#undef MODULE_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("loongarch-asm-printer", LoongArchAsmPrinterPass())
MACHINE_FUNCTION_PASS("loongarch-dead-register-definitions",
                      LoongArchDeadRegisterDefinitionsPass())
MACHINE_FUNCTION_PASS("loongarch-expand-atomic-pseudo",
                      LoongArchExpandAtomicPseudoPass())
MACHINE_FUNCTION_PASS("loongarch-expand-pseudo", LoongArchExpandPseudoPass())
MACHINE_FUNCTION_PASS("loongarch-isel",
                      LoongArchISelDAGToDAGPass(*this, getOptLevel()))
MACHINE_FUNCTION_PASS("loongarch-late-branch-opt",
                      LoongArchLateBranchOptPass())
MACHINE_FUNCTION_PASS("loongarch-memory-barrier-opt",
                      LoongArchMemoryBarrierOptPass())
MACHINE_FUNCTION_PASS("loongarch-merge-base-offset",
                      LoongArchMergeBaseOffsetPass())
MACHINE_FUNCTION_PASS("loongarch-opt-w-instrs", LoongArchOptWInstrsPass())
MACHINE_FUNCTION_PASS("loongarch-pre-ra-expand-pseudo",
                      LoongArchPreRAExpandPseudoPass())
#undef MACHINE_FUNCTION_PASS
