//===----------------------------------------------------------------------===//
//
// This file is used as the registry of passes that are part of the Mips
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("mips-16-hard-float", Mips16HardFloatPass(*this))
MODULE_PASS("mips-os16", MipsOs16Pass())
#undef MODULE_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("mips-16-isel", Mips16ISelDAGPass(*this, getOptLevel()))
MACHINE_FUNCTION_PASS("mips-optimize-pic-call", MipsOptimizePICCallPass())
MACHINE_FUNCTION_PASS("mips-se-isel", MipsSEISelDAGPass(*this, getOptLevel()))
#undef MACHINE_FUNCTION_PASS
