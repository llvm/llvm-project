//
// This file is used as the registry of passes that are part of the AVR
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("sparc-asm-printer-begin", SparcAsmPrinterBeginPass())
MODULE_PASS("sparc-asm-printer-end", SparcAsmPrinterEndPass())
#undef MODULE_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("sparc-asm-printer", SparcAsmPrinterPass())
MACHINE_FUNCTION_PASS("sparc-delay-slot-filler", SparcDelaySlotFillerPass())
MACHINE_FUNCTION_PASS("sparc-detect-round-change", SparcDetectRoundChangePass())
MACHINE_FUNCTION_PASS("sparc-errata-workaround", SparcErrataWorkaroundPass())
MACHINE_FUNCTION_PASS("sparc-fix-all-fdivsqrt", SparcFixAllFDIVSQRTPass())
MACHINE_FUNCTION_PASS("sparc-insert-nop-load", SparcInsertNOPLoadPass())
MACHINE_FUNCTION_PASS("sparc-isel", SparcDAGToDAGISelPass(*this, getOptLevel()))
#undef MACHINE_FUNCTION_PASS
