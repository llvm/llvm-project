//
// This file is used as the registry of passes that are part of the AVR
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef FUNCTION_PASS
#define FUNCTION_PASS(NAME, CREATE_PASS)
#endif
FUNCTION_PASS("avr-shift-expand", AVRShiftExpandPass())
#undef FUNCTION_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("avr-expand-pseudo", AVRExpandPseudoPass())
MACHINE_FUNCTION_PASS("avr-frame-analyzer", AVRFrameAnalyzerPass())
MACHINE_FUNCTION_PASS("avr-isel", AVRISelDAGToDAGPass(*this, getOptLevel()))
#undef MACHINE_FUNCTION_PASS
