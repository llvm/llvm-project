//===----------------------------------------------------------------------===//
//
// This file is used as the registry of passes that are part of the
// DirectX backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_ANALYSIS
#define MODULE_ANALYSIS(NAME, CREATE_PASS)
#endif
MODULE_ANALYSIS("dx-shader-flags", dxil::ShaderFlagsAnalysis())
MODULE_ANALYSIS("dxil-root-signature-analysis", dxil::RootSignatureAnalysis())
MODULE_ANALYSIS("dxil-signature-analysis", dxil::SignatureAnalysis())
#undef MODULE_ANALYSIS

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("dxil-cbuffer-access", DXILCBufferAccessPass())
MODULE_PASS("dxil-container-globals", DXILContainerGlobalsPass())
MODULE_PASS("dxil-container-pdb", DXILContainerPDBPass())
MODULE_PASS("dxil-finalize-linkage", DXILFinalizeLinkagePass())
MODULE_PASS("dxil-data-scalarization", DXILDataScalarizationPass())
MODULE_PASS("dxil-flatten-arrays", DXILFlattenArraysPass())
MODULE_PASS("dxil-debug-info", DXILDebugInfoPass())
MODULE_PASS("dxil-intrinsic-expansion", DXILIntrinsicExpansionPass())
MODULE_PASS("dxil-mem-intrinsics", DXILMemIntrinsicsPass())
MODULE_PASS("dxil-op-lower", DXILOpLoweringPass())
MODULE_PASS("dxil-prepare-module", DXILPrepareModulePass())
MODULE_PASS("dxil-pretty-printer", DXILPrettyPrinterPass(dbgs()))
MODULE_PASS("dxil-translate-metadata", DXILTranslateMetadataPass())
MODULE_PASS("dxil-resource-implicit-binding", DXILResourceImplicitBindingPass())
MODULE_PASS("dxil-post-optimization-validation", DXILPostOptimizationValidationPass())
MODULE_PASS("dxil-writer", DXILWriterPass())
// TODO: rename to print<foo> after NPM switch
MODULE_PASS("print-dx-shader-flags", dxil::ShaderFlagsAnalysisPrinterPass(dbgs()))
MODULE_PASS("print<dxil-root-signature>", dxil::RootSignatureAnalysisPrinterPass(dbgs()))
MODULE_PASS("print<dxil-signature>", dxil::SignatureAnalysisPrinterPass(dbgs()))
#undef MODULE_PASS

#ifndef FUNCTION_PASS
#define FUNCTION_PASS(NAME, CREATE_PASS)
#endif
FUNCTION_PASS("dxil-forward-handle-accesses", DXILForwardHandleAccessesPass())
FUNCTION_PASS("dxil-remove-unused-resources", DXILRemoveUnusedResourcesPass())
FUNCTION_PASS("dxil-resource-access", DXILResourceAccessPass())
FUNCTION_PASS("dxil-legalize", DXILLegalizePass())
#undef FUNCTION_PASS
