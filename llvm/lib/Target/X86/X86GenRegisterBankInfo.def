/// \file
/// This file defines all the static objects used by X86RegisterBankInfo.
/// \todo This should be generated by TableGen.
//===----------------------------------------------------------------------===//

#ifdef GET_TARGET_REGBANK_INFO_IMPL
#define INSTR_3OP(INFO) INFO, INFO, INFO,
#define BREAKDOWN(INDEX, NUM) {&X86::PartMappings[INDEX], NUM}
// ValueMappings.
RegisterBankInfo::ValueMapping X86GenRegisterBankInfo::ValMappings[]{
    /* BreakDown, NumBreakDowns */
    // 3-operands instructions (all binary operations should end up with one of
    // those mapping).
    INSTR_3OP(BREAKDOWN(X86::PMI_GPR8, 1))    // 0: GPR_8
    INSTR_3OP(BREAKDOWN(X86::PMI_GPR16, 1))   // 3: GPR_16
    INSTR_3OP(BREAKDOWN(X86::PMI_GPR32, 1))   // 6: GPR_32
    INSTR_3OP(BREAKDOWN(X86::PMI_GPR64, 1))   // 9: GPR_64
    INSTR_3OP(BREAKDOWN(X86::PMI_VECR32, 1))  // 12: Fp32
    INSTR_3OP(BREAKDOWN(X86::PMI_VECR64, 1))  // 15: Fp64
    INSTR_3OP(BREAKDOWN(X86::PMI_VECR128, 1)) // 18: Vec128
    INSTR_3OP(BREAKDOWN(X86::PMI_VECR256, 1)) // 21: Vec256
    INSTR_3OP(BREAKDOWN(X86::PMI_VECR512, 1)) // 24: Vec512
    INSTR_3OP(BREAKDOWN(X86::PMI_PSR32, 1))   // 25: Rfp32
    INSTR_3OP(BREAKDOWN(X86::PMI_PSR64, 1))   // 26: Rfp64
    INSTR_3OP(BREAKDOWN(X86::PMI_PSR80, 1))   // 27: Rfp80
};
#undef INSTR_3OP
#undef BREAKDOWN
#endif // GET_TARGET_REGBANK_INFO_IMPL

#ifdef GET_TARGET_REGBANK_INFO_CLASS
enum ValueMappingIdx {
  VMI_None = -1,
  VMI_3OpsGpr8Idx = X86::PMI_GPR8 * 3,
  VMI_3OpsGpr16Idx = X86::PMI_GPR16 * 3,
  VMI_3OpsGpr32Idx = X86::PMI_GPR32 * 3,
  VMI_3OpsGpr64Idx = X86::PMI_GPR64 * 3,
  VMI_3OpsFp32Idx = X86::PMI_VECR32 * 3,
  VMI_3OpsFp64Idx = X86::PMI_VECR64 * 3,
  VMI_3OpsVec128Idx = X86::PMI_VECR128 * 3,
  VMI_3OpsVec256Idx = X86::PMI_VECR256 * 3,
  VMI_3OpsVec512Idx = X86::PMI_VECR512 * 3,
  VMI_3OpsPs32Idx = X86::PMI_PSR32 * 3,
  VMI_3OpsPs64Idx = X86::PMI_PSR64 * 3,
  VMI_3OpsPs80Idx = X86::PMI_PSR80 * 3,
};
#undef GET_TARGET_REGBANK_INFO_CLASS
#endif // GET_TARGET_REGBANK_INFO_CLASS

#ifdef GET_TARGET_REGBANK_INFO_IMPL
#undef GET_TARGET_REGBANK_INFO_IMPL
const RegisterBankInfo::ValueMapping *
X86GenRegisterBankInfo::getValueMapping(X86::PartialMappingIdx Idx,
                                        unsigned NumOperands) {

  // We can use VMI_3Ops Mapping for all the cases.
  if (NumOperands <= 3 && (Idx >= X86::PMI_GPR8 && Idx <= X86::PMI_PSR80))
    return &ValMappings[(unsigned)Idx * 3];

  llvm_unreachable("Unsupported X86::PartialMappingIdx.");
}

#endif // GET_TARGET_REGBANK_INFO_IMPL

