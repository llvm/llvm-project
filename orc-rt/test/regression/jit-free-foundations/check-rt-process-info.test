# RUN: orc-rt-process-info-check --print-triple --print-page-size \
# RUN:     --print-cpu-features \
# RUN:   | FileCheck %s -DARCH=%host-arch -DOS=%host-os \
# RUN:     -DVERSION=%macos-product-version  -DPAGESIZE=%host-page-size

# CHECK:      [[ARCH]]-{{.*}}-[[OS]][[VERSION]]
# CHECK-NEXT: [[PAGESIZE]]
# CHECK-NEXT: {{^\+[a-z0-9_.]+(,\+[a-z0-9_.]+)*$}}
