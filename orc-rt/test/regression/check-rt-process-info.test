# RUN: orc-rt-process-info-check --print-triple --print-page-size --print-cpu-features \
# RUN:   | FileCheck %s -DARCH=%host-arch -DOS=%host-os -DVERSION=%macos-product-version  -DVERSION=%host-page-size

# CHECK:      [[ARCH]]-{{.*}}-[[OS]][[VERSION]]
# CHECK-NEXT: [[host-page-size]]
# CHECK-NEXT: {{^\+[a-z0-9_.]+(,\+[a-z0-9_.]+)*$}}
