# RUN: orc-rt-process-info-check --print-triple --print-page-size --print-cpu-features \
# RUN:   | FileCheck %s -DARCH=%host-arch -DOS=%host-os -DVERSION=%macos-product-version

# CHECK:      [[ARCH]]-{{.*}}-[[OS]][[VERSION]]
