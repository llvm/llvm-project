# Check that JIT'd code can call a hidden function defined in another object.
#
# Stresses: fixups for calls to functions defined in another object. Hidden
# functions must be defined in the same linkage unit, so the compiler may call
# them directly rather than through a PLT, where the object format has one.

RUN: rm -rf %t && split-file %s %t
RUN: %{cc} -O0 -c -o %t/def.O0.o %t/def.c
RUN: %{cc} -O0 -c -o %t/main.O0.o %t/main.c
RUN: %{obj-jit} -show-jit-result %t/main.O0.o %t/def.O0.o | FileCheck %s
RUN: %{cc} -O2 -c -o %t/def.O2.o %t/def.c
RUN: %{cc} -O2 -c -o %t/main.O2.o %t/main.c
RUN: %{obj-jit} -show-jit-result %t/main.O2.o %t/def.O2.o | FileCheck %s

CHECK: JIT result: 0

#--- def.c
__attribute__((visibility("hidden"))) int addOne(int X) { return X + 1; }

#--- main.c
__attribute__((visibility("hidden"))) int addOne(int X);

int main(void) {
  if (addOne(41) != 42)
    return 1;
  return 0;
}
