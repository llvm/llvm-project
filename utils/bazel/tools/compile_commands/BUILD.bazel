load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")

# Refresh compilation database for all LLVM targets
refresh_compile_commands(
    name = "compile_commands",
    output_dir = "../..",
    targets = [
        "@llvm-project//...",
    ],
)

alias(
    name = "refresh_all",
    actual = ":compile_commands",
)
