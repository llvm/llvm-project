load("//llvm:lit_test.bzl", "lit_test")

licenses(["notice"])

[
    lit_test(
        name = "%s.test" % src,
        srcs = [src],
        data = glob(["**/Inputs/**"]) + [
            "lit.local.cfg",
            "//lld/test:lit_data",
        ] + (["ignore4217.yaml"] if src == "ignore-many.test" else []),
    )
    for src in glob(
        [
            "**/*.ll",
            "**/*.s",
            "**/*.test",
            "**/*.yaml",
        ],
        exclude = ["**/Inputs/**"],
    )
]
