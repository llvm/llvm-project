load("//llvm:lit_test.bzl", "lit_test")

licenses(["notice"])

[
    lit_test(
        name = "%s.test" % src,
        srcs = [src],
        data = ["//lldb/test/Shell:lit_data"],
    )
    for src in glob(["*.test"])
]
