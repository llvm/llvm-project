        "NativePDB/dedupe-exported-public-symbols.cpp",
        "NativePDB/dynamic-types.cpp",
        "NativePDB/enums-layout.test",
        "NativePDB/find-functions.cpp",
        "NativePDB/func-symbols.test",
        "NativePDB/function-level-linking.test",
        "NativePDB/function-nested-block.test",
        "NativePDB/global-ctor-dtor.cpp",
        "NativePDB/icf.cpp",
        "NativePDB/invalid-field-list-reference.yaml",
        "NativePDB/invalid-inlinee-not-in-ipi.yaml",
        "NativePDB/invalid-type-refs.yaml",
