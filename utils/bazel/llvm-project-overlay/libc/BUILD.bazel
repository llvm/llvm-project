    libc_generated_header(
        name = info.target_name,
        hdr = info.staging_path,
        other_srcs = info.other_srcs,
        proxy = info.proxy,
        yaml_template = info.yaml_template,
    )
    for info in LLVM_LIBC_HEADERS
