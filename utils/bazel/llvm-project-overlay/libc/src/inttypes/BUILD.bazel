load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

libc_function(
    name = "strtoimax",
    srcs = ["strtoimax.cpp"],
    hdrs = ["strtoimax.h"],
    deps = [
        "//libc:__support_common",
        "//libc:__support_libc_errno",
        "//libc:__support_str_to_integer",
        "//libc:errno",
        "//libc:hdr_stdint_proxy",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "strtoumax",
    srcs = ["strtoumax.cpp"],
    hdrs = ["strtoumax.h"],
    deps = [
        "//libc:__support_common",
        "//libc:__support_libc_errno",
        "//libc:__support_str_to_integer",
        "//libc:errno",
        "//libc:hdr_stdint_proxy",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "imaxabs",
    srcs = ["imaxabs.cpp"],
    hdrs = ["imaxabs.h"],
    deps = [
        "//libc:__support_common",
        "//libc:__support_integer_operations",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "imaxdiv",
    srcs = ["imaxdiv.cpp"],
    hdrs = ["imaxdiv.h"],
    deps = [
        "//libc:__support_common",
        "//libc:__support_integer_operations",
        "//libc/src/__support/macros:config",
    ],
)
