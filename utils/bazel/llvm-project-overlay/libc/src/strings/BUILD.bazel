load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "index",
    srcs = ["index.cpp"],
    hdrs = ["index.h"],
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
        "//libc/src/string:utils",
    ],
)

