load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "_r_debug",
    srcs = ["_r_debug.cpp"],
    hdrs = ["_r_debug.h"],
    deps = [
        "//libc:types_struct_r_debug",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)
