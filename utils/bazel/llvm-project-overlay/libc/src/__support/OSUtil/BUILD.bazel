load("//libc:libc_build_rules.bzl", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "syscall",
    hdrs = ["syscall.h"],
    textual_hdrs = select({
        "@platforms//os:linux": [
            "linux/syscall.h",
            "linux/aarch64/syscall.h",
            "linux/x86_64/syscall.h",
            "linux/riscv/syscall.h",
        ],
        "@platforms//os:macos": [
            "darwin/syscall.h",
            "darwin/aarch64/syscall.h",
        ],
        "@platforms//os:windows": [],
    }),
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:optimization",
        "//libc/src/__support/macros:sanitizer",
        "//libc/src/__support/macros/properties:architectures",
    ],
)

libc_support_library(
    name = "linux_auxv",
    hdrs = ["linux/auxv.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_sys_auxv_macros",
        "//libc:hdr_sys_mman_macros",
        "//libc/src/__support:common",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:mmap",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:munmap",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:open",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:prctl",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:read",
        "//libc/src/__support/threads:callonce",
    ],
)

libc_support_library(
    name = "linux_sysinfo",
    hdrs = ["linux/sysinfo.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc:hdr_errno_macros",
        "//libc/src/__support:common",
        "//libc/src/__support:ctype_utils",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:array",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:open",
