libc_support_library(
    name = "linux_sigmask",
    hdrs = ["linux/sigmask.h"],
    full_build_only = True,
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc:hdr_errno_macros",
