        "//libc/src/__support/OSUtil/linux/syscall_wrappers:sched_getaffinity",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "vdso",
    srcs = ["linux/vdso.cpp"],
    hdrs = [
        "linux/vdso.h",
        "linux/vdso_sym.h",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
