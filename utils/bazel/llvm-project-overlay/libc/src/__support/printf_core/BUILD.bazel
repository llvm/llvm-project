load("//libc:libc_build_rules.bzl", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "printf_config",
    hdrs = ["printf_config.h"],
    deps = [
        "//libc/src/__support/macros/properties:types",
    ],
)

libc_support_library(
    name = "printf_core_structs",
    hdrs = ["core_structs.h"],
    deps = [
        ":printf_config",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros/properties:types",
    ],
)

libc_support_library(
    name = "printf_parser",
    hdrs = ["parser.h"],
    deps = [
        ":printf_config",
        ":printf_core_structs",
        "//libc:__support_arg_list",
        "//libc:__support_common",
        "//libc:__support_ctype_utils",
        "//libc:__support_libc_errno",
        "//libc:__support_str_to_integer",
        "//libc:llvm_libc_macros_stdfix_macros",
        "//libc:types_wint_t",
        "//libc/src/__support/CPP:algorithm",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/CPP:limits",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/fixed_point",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros/properties:types",
    ],
)

libc_support_library(
    name = "printf_writer",
    hdrs = ["writer.h"],
    textual_hdrs = ["overflow_modes.def"],
    deps = [
        ":printf_core_structs",
        "//libc:string_memory_utils",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:optimization",
    ],
)

libc_support_library(
    name = "printf_converter",
    hdrs = [
        "char_converter.h",
        "converter.h",
        "converter_atlas.h",
        "converter_utils.h",
        "float_dec_converter.h",
        "float_hex_converter.h",
        "float_inf_nan_converter.h",
        "int_converter.h",
        "ptr_converter.h",
        "strerror_converter.h",
        "string_converter.h",
        "write_int_converter.h",
    ],
    deps = [
        ":printf_config",
        ":printf_core_structs",
        ":printf_writer",
        "//libc:__support_big_int",
        "//libc:__support_common",
        "//libc:__support_ctype_utils",
        "//libc:__support_float_to_string",
        "//libc:__support_integer_to_string",
        "//libc:__support_libc_assert",
        "//libc:__support_uint128",
        "//libc:__support_wchar_mbstate",
        "//libc:__support_wchar_string_converter",
        "//libc:__support_wchar_wcrtomb",
        "//libc:__support_wctype_utils",
        "//libc:hdr_limits_macros",
        "//libc:hdr_wchar_macros",
        "//libc:string_utils",
        "//libc:types_char32_t",
        "//libc:types_char8_t",
        "//libc:types_size_t",
        "//libc:types_wchar_t",
        "//libc:types_wint_t",
        "//libc/src/__support/CPP:limits",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:fenv_impl",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:rounding_mode",
        "//libc/src/__support/StringUtil",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "printf_error_mapper",
    hdrs = [
        "error_mapper.h",
    ] + select({
        "@platforms//os:linux": [
            "linux/error_mapper.h",
        ],
        "//conditions:default": ["generic/error_mapper.h"],
    }),
    deps = [
        ":printf_core_structs",
        "//libc:__support_error_or",
        "//libc:hdr_errno_macros",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/macros/properties:architectures",
    ],
)

libc_support_library(
    name = "printf_main",
    hdrs = ["printf_main.h"],
    deps = [
        ":printf_converter",
        ":printf_core_structs",
        ":printf_error_mapper",
        ":printf_parser",
        ":printf_writer",
        "//libc:__support_arg_list",
        "//libc:__support_error_or",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "vfprintf_internal",
    hdrs = ["vfprintf_internal.h"],
    deps = [
        ":printf_core_structs",
        ":printf_main",
        ":printf_writer",
        "//libc:__support_arg_list",
        "//libc:__support_error_or",
        "//libc:types_FILE",
        "//libc/src/__support/File:file",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "vasprintf_internal",
    hdrs = ["vasprintf_internal.h"],
    deps = [
        ":printf_core_structs",
        ":printf_main",
        ":printf_writer",
        "//libc:__support_arg_list",
        "//libc:__support_error_or",
        "//libc:func_free",
        "//libc:func_malloc",
        "//libc:func_realloc",
        "//libc:types_FILE",
        "//libc/src/__support/macros:attributes",
    ],
)
