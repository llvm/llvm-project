load("//libc:libc_build_rules.bzl", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "file_io_result",
    hdrs = ["file_io_result.h"],
    deps = [
        "//libc/src/__support/macros:config",
    ],
)

libc_support_library(
    name = "file",
    srcs = [
        "file.cpp",
    ],
    hdrs = [
        "file.h",
        "file_mode.h",
    ],
    deps = [
        ":file_io_result",
        "//libc:func_aligned_alloc",
        "//libc:func_free",
        "//libc:func_malloc",
        "//libc:func_realloc",
        "//libc:hdr_errno_macros",
        "//libc:hdr_stdint_proxy",
        "//libc:hdr_stdio_macros",
        "//libc:hdr_wchar_macros",
        "//libc:llvm_libc_types_off_t",
        "//libc:string_memory_utils",
        "//libc:types_char32_t",
        "//libc:types_char8_t",
        "//libc:types_off_t",
        "//libc:types_wchar_t",
        "//libc:types_wint_t",
        "//libc/src/__support:alloc_checker",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros/properties:architectures",
        "//libc/src/__support/threads:mutex",
        "//libc/src/__support/wchar:character_converter",
        "//libc/src/__support/wchar:mbstate",
        "//libc/src/__support/wchar:wcrtomb",
    ],
)

libc_support_library(
    name = "platform_file",
    srcs = [
        "linux/file.cpp",
    ],
    hdrs = [
        "linux/file.h",
        "linux/file_flags.h",
    ],
    deps = [
        ":file",
        "//libc:func_free",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fcntl_macros",
        "//libc:hdr_stdint_proxy",
        "//libc:hdr_stdio_macros",
        "//libc:hdr_sys_stat_macros",
        "//libc:types_mode_t",
        "//libc:types_off_t",
        "//libc/src/__support:alloc_checker",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support/CPP:new",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:close",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:dup3",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:fcntl",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:lseek",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:open",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:read",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:write",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros:config",
    ],
)
