load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "poll",
    srcs = ["linux/poll.cpp"],
    hdrs = ["poll.h"],
    deps = [
        "//libc/hdr/types:nfds_t",
        "//libc/hdr/types:struct_pollfd",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:poll",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)
