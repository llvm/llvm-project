load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "htonl",
    srcs = ["htonl.cpp"],
    hdrs = ["htonl.h"],
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "htons",
    srcs = ["htons.cpp"],
    hdrs = ["htons.h"],
    deps = [
        "//libc/hdr:stdint_proxy",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
    ],
)

libc_function(
    name = "inet_addr",
    srcs = ["inet_addr.cpp"],
    hdrs = ["inet_addr.h"],
    deps = [
        "//libc/hdr:netinet_in_macros",
        "//libc/hdr/types:in_addr_t",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros:null_check",
        "//libc/src/__support/net:address",
    ],
)

