load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "semctl",
    srcs = ["linux/semctl.cpp"],
    hdrs = ["semctl.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:sys_ipc_macros",
        "//libc/hdr:sys_sem_macros",
        "//libc/hdr/types:struct_semid_ds",
        "//libc/hdr/types:struct_seminfo",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:semctl",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "semget",
    srcs = ["linux/semget.cpp"],
    hdrs = ["semget.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr/types:key_t",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:semget",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "semop",
    srcs = ["linux/semop.cpp"],
    hdrs = ["semop.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:struct_sembuf",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:semop",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)
