load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "mkdir",
    srcs = ["linux/mkdir.cpp"],
    hdrs = ["mkdir.h"],
    deps = [
        "//libc:hdr_fcntl_macros",
        "//libc:types_mode_t",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:mkdir",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)

libc_function(
    name = "mkdirat",
    srcs = ["linux/mkdirat.cpp"],
    hdrs = ["mkdirat.h"],
    deps = [
        "//libc:types_mode_t",
        "//libc/src/__support:common",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil:syscall",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:mkdirat",
        "//libc/src/__support/macros:config",
        "//libc/src/errno",
    ],
)
