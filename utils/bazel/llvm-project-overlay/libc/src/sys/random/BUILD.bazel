load("//libc:libc_build_rules.bzl", "libc_function")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_function(
    name = "getrandom",
    srcs = ["linux/getrandom.cpp"],
    hdrs = ["getrandom.h"],
    deps = [
        "//libc:types_size_t",
        "//libc:types_ssize_t",
        "//libc/src/__support:common",
        "//libc/src/__support:error_or",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support/OSUtil/linux/syscall_wrappers:getrandom",
        "//libc/src/__support/macros:config",
    ],
)
