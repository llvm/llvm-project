load("//libc:libc_build_rules.bzl", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_support_library(
    name = "__stack_chk_fail",
    srcs = ["generic/__stack_chk_fail.cpp"],
    hdrs = ["__stack_chk_fail.h"],
    deps = [
        "//libc:hdr_stdint_proxy",
        "//libc/src/__support/OSUtil:io",
        "//libc/src/stdlib:abort_utils",
    ],
)
