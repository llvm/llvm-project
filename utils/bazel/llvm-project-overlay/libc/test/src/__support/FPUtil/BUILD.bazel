# Tests for LLVM libc __support functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "fpbits_test",
    srcs = ["fpbits_test.cpp"],
    deps = [
        "//libc:__support_big_int",
        "//libc:__support_integer_literals",
        "//libc:__support_sign",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:fpbits_str",
        "//libc/src/__support/macros/properties:types",
    ],
)

libc_test(
    name = "except_value_utils_test",
    srcs = ["except_value_utils_test.cpp"],
    deps = [
        "//libc:__support_sign",
        "//libc:hdr_errno_macros",
        "//libc:hdr_fenv_macros",
        "//libc:hdr_math_macros",
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:except_value_utils",
        "//libc/src/__support/FPUtil:fenv_impl",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/macros:attributes",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)

libc_test(
    name = "fp_bitwise_test",
    srcs = ["fp_bitwise_test.cpp"],
    deps = [
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:fp_bitwise",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)

libc_test(
    name = "bfloat16_test",
    srcs = ["bfloat16_test.cpp"],
    overlay_build_only = True,  # Depends on mpfr
    deps = [
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/test/UnitTest:fp_test_helpers",
        "//libc/utils/MPFRWrapper:mp_common",
        "//libc/utils/MPFRWrapper:mpfr_wrapper",
    ],
)

libc_test(
    name = "dyadic_float_test",
    srcs = ["dyadic_float_test.cpp"],
    copts = ["-frounding-math"],
    overlay_build_only = True,  # Depends on mpfr
    deps = [
        "//libc:__support_big_int",
        "//libc:__support_uint128",
        "//libc/src/__support/FPUtil:dyadic_float",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:fp_test_helpers",
        "//libc/utils/MPFRWrapper:mpfr_wrapper",
    ],
)

libc_test(
    name = "rounding_mode_test",
    srcs = ["rounding_mode_test.cpp"],
    overlay_build_only = True,  # Depends on mpfr
    deps = [
        "//libc:__support_uint128",
        "//libc:hdr_fenv_macros",
        "//libc/src/__support/FPUtil:rounding_mode",
        "//libc/utils/MPFRWrapper:mpfr_wrapper",
    ],
)

libc_test(
    name = "comparison_operations_test",
    srcs = ["comparison_operations_test.cpp"],
    deps = [
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:comparison_operations",
        "//libc/src/__support/FPUtil:rounding_mode",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)

libc_test(
    name = "is_integer_test",
    srcs = ["is_integer_test.cpp"],
    deps = [
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:float128",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:is_integer",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)
