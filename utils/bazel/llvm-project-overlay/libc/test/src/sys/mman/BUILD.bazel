# Tests for LLVM libc mman.h functions.

load("//libc/test:libc_test_rules.bzl", "libc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test(
    name = "madvise_test",
    srcs = ["linux/madvise_test.cpp"],
    deps = [
        "//libc:hdr_sys_mman_macros",
