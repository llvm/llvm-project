# Tests for LLVM libc socket.h functions.

load("//libc/test:libc_test_rules.bzl", "libc_test", "libc_test_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

libc_test_library(
    name = "socket_test_support",
    hdrs = ["linux/socket_test_support.h"],
    deps = [
        "//libc/hdr:fcntl_macros",
        "//libc/hdr:sys_socket_macros",
        "//libc/hdr/types:size_t",
        "//libc/hdr/types:socklen_t",
        "//libc/hdr/types:struct_sockaddr_un",
        "//libc/src/__support:common",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/fcntl:open",
        "//libc/src/string:strncpy",
        "//libc/src/string:strnlen",
        "//libc/src/unistd:chdir",
        "//libc/src/unistd:close",
        "//libc/src/unistd:fchdir",
        "//libc/test/UnitTest:LibcUnitTest",
    ],
)

libc_test(
    name = "bind_test",
    srcs = ["linux/bind_test.cpp"],
    deps = [
