# LLVM libc unittest library.

load("//libc/test:libc_test_rules.bzl", "libc_test_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

libc_test_library(
    name = "test_logger",
    srcs = ["TestLogger.cpp"],
    hdrs = ["TestLogger.h"],
    deps = [
        "//libc:__support_big_int",
        "//libc:__support_osutil_io",
        "//libc:__support_uint128",
        "//libc:func_aligned_alloc",
        "//libc:func_free",
        "//libc:func_malloc",
        "//libc:func_realloc",
        "//libc:hdr_stdint_proxy",
        "//libc/src/__support/CPP:string",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros/properties:types",
    ],
)

libc_test_library(
    name = "LibcUnitTest",
    srcs = [
        "BazelFilePath.cpp",
        "ExecuteFunctionUnix.cpp",
        "LibcDeathTestExecutors.cpp",
        "LibcTest.cpp",
        "LibcTestMain.cpp",
    ],
    hdrs = [
        "CharLiteralUtils.h",
        "ErrnoCheckingTest.h",
        "ErrnoSetterMatcher.h",
        "ExecuteFunction.h",
        "LibcTest.h",
        "Test.h",
    ],
    deps = [
        ":string_utils",
        ":test_logger",
        "//libc:__support_c_string",
        "//libc:__support_integer_to_string",
        "//libc:__support_libc_assert",
        "//libc:__support_libc_errno",
        "//libc:__support_stringutil_StringUtil",
        "//libc:__support_uint128",
        "//libc:__support_wchar_string_converter",
        "//libc:clock",
        "//libc:errno",
        "//libc:func_aligned_alloc",
        "//libc:func_free",
        "//libc:func_malloc",
        "//libc:func_realloc",
        "//libc:hdr_stdint_proxy",
        "//libc:llvm_libc_macros_stdfix_macros",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/CPP:bitset",
        "//libc/src/__support/CPP:functional",
        "//libc/src/__support/CPP:limits",
        "//libc/src/__support/CPP:nullptr_t",
        "//libc/src/__support/CPP:scope",
        "//libc/src/__support/CPP:span",
        "//libc/src/__support/CPP:string",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:fpbits_str",
        "//libc/src/__support/FPUtil:rounding_mode",
        "//libc/src/__support/fixed_point",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/macros/properties:architectures",
        "//libc/src/__support/macros/properties:compiler",
        "//libc/src/__support/macros/properties:types",
    ] + select({
        "//libc:full_build": [
            "//libc:close",
            "//libc:exit",
            "//libc:fflush",
            "//libc:fork",
            "//libc:getenv",
            "//libc:kill",
            "//libc:llvm_libc_macros_poll_macros",
            "//libc:llvm_libc_macros_signal_macros",
            "//libc:llvm_libc_macros_sys_wait_macros",
            "//libc:llvm_libc_types_pid_t",
            "//libc:llvm_libc_types_struct_pollfd",
            "//libc:pipe",
            "//libc:poll",
            "//libc:signal",
            "//libc:stderr",
            "//libc:stdout",
            "//libc:strsignal",
            "//libc:waitpid",
        ],
        "//conditions:default": [],
    }) + select({
        "//libc:full_build_linux": [
            "//libc:prctl",
        ],
        "//conditions:default": [],
    }),
    # Force linking in this library's `main()` to surface
    # a duplicate symbol error if a test defines its own main.
    alwayslink = True,
)

libc_test_library(
    name = "HermeticTestUtils",
    srcs = ["HermeticTestUtils.cpp"],
    # Only intended to be used with full-build tests.
    target_compatible_with = select({
        "//libc:full_build": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libc:__support_common",
        "//libc:__support_libc_errno",
        "//libc:atexit",
        "//libc:bcmp",
        "//libc:bzero",
        "//libc:hdr_errno_macros",
        "//libc:hdr_stdint_proxy",
        "//libc:memcmp",
        "//libc:memcpy",
        "//libc:memmove",
        "//libc:memset",
        "//libc/src/__support/macros:config",
    ],
)

libc_test_library(
