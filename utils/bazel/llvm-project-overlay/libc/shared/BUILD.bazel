load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libc:libc_build_rules.bzl", "libc_common_copts", "libc_header_library", "libc_support_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

# Expose the libc/shared/* RPC headers so flang-rt's io-api-server.cpp can
# include `<shared/rpc.h>` and `<shared/rpc_dispatch.h>` from a host build
# without depending on the rest of the libc target graph.
exports_files([
    "rpc.h",
    "rpc_dispatch.h",
    "rpc_util.h",
])

libc_support_library(
    name = "libc_common",
    hdrs = ["libc_common.h"],
)

libc_header_library(
    name = "libcxx_headers",
    hdrs = [
        "fp_bits.h",
        "libc_common.h",
        "str_to_float.h",
        "str_to_integer.h",
    ],
    deps = [
        "//libc/src/__support:common",
        "//libc/src/__support:str_to_float",
        "//libc/src/__support:str_to_integer",
        "//libc/src/__support/FPUtil:fp_bits",
    ],
)

# This target is only used by APFloat.cpp in the Support library.
