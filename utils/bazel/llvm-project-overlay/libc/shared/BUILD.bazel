libc_support_library(
    name = "math_static_rounding_expf",
    hdrs = ["math/static_rounding/expf.h"],
    deps = [
        ":libc_common",
        "//libc/src/__support:common",
        "//libc/src/__support/macros:config",
        "//libc/src/__support/math:expf_integer_eval",
    ],
