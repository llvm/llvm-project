        "math_check_exceptions.h",
        "static_rounding_math.h",
    ] + glob(["math/**/*.h"]),
    copts = libc_common_copts(),
    includes = [".."],
    deps = [
        "//libc/hdr:errno_macros",
        "//libc/hdr:fenv_macros",
        "//libc/hdr:float_macros",
        "//libc/hdr:stdint_proxy",
        "//libc/include:llvm_libc_macros_float16_macros",
        "//libc/include:llvm_libc_types_float128",
        "//libc/src/__support:big_int",
        "//libc/src/__support:common",
        "//libc/src/__support:frac128",
        "//libc/src/__support:frac256",
        "//libc/src/__support:frac64",
        "//libc/src/__support:integer_literals",
        "//libc/src/__support:libc_errno",
        "//libc/src/__support:math_extras",
        "//libc/src/__support:number_pair",
        "//libc/src/__support:sign",
        "//libc/src/__support:str_to_float",
        "//libc/src/__support:uint128",
        "//libc/src/__support/CPP:algorithm",
        "//libc/src/__support/CPP:array",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/CPP:limits",
        "//libc/src/__support/CPP:optional",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:basic_operations",
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:cast",
        "//libc/src/__support/FPUtil:division_and_remainder_operations",
        "//libc/src/__support/FPUtil:double_double",
        "//libc/src/__support/FPUtil:dyadic_float",
        "//libc/src/__support/FPUtil:except_value_utils",
        "//libc/src/__support/FPUtil:fenv_impl",
        "//libc/src/__support/FPUtil:float128",
        "//libc/src/__support/FPUtil:float80",
        "//libc/src/__support/FPUtil:fma",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:fp_bitwise",
        "//libc/src/__support/FPUtil:generic_fmod",
        "//libc/src/__support/FPUtil:hypot",
        "//libc/src/__support/FPUtil:is_integer",
