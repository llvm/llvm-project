[
    libc_generated_header(
        name = info.target_name,
        hdr = info.staging_path,
        other_srcs = info.other_srcs,
        proxy = info.proxy,
        yaml_template = info.yaml_template,
    )
    for info in LLVM_LIBC_HEADERS
]

# Static headers that need to be in staging/include
STATIC_HEADERS = glob(
    ["llvm-libc-types/**/*.h"],
) + glob(
    ["llvm-libc-macros/**/*.h"],
    exclude = [
        "llvm-libc-macros/_LIBC_MODULAR_FORMAT_PRINTF.h",
        "llvm-libc-macros/_LIBC_MODULAR_FORMAT_PRINTF-disable.h",
    ],
) + ["__llvm-libc-common.h"]

[
    copy_file(
        name = "copy_staging/" + f,
        src = f,
        out = "staging/include/" + f,
    )
    for f in STATIC_HEADERS
]

copy_file(
    name = "copy_modular_format_header",
    src = select({
        "//libc:modular_format_enable": "llvm-libc-macros/_LIBC_MODULAR_FORMAT_PRINTF.h",
        "//conditions:default": "llvm-libc-macros/_LIBC_MODULAR_FORMAT_PRINTF-disable.h",
    }),
    out = "staging/include/llvm-libc-macros/_LIBC_MODULAR_FORMAT_PRINTF.h",
)

STATIC_AND_CONDITIONAL_HEADERS = STATIC_HEADERS + ["llvm-libc-macros/_LIBC_MODULAR_FORMAT_PRINTF.h"]

cc_library(
    name = "public_headers",
    hdrs = [header.target_name for header in LLVM_LIBC_HEADERS],
    includes = ["staging/include"],
    textual_hdrs = ["staging/include/" + f for f in STATIC_AND_CONDITIONAL_HEADERS],
)

# Textual versions of the static headers. These are taken from the source tree
# and are separate from the generated headers above. They are used for
# testing purposes.
cc_library(
    name = "public_headers_deps",
    textual_hdrs = STATIC_AND_CONDITIONAL_HEADERS,
)

