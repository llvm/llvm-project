# A wrapper library over MPFR for use with LLVM libc math unittests.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libc/test:libc_test_rules.bzl", "libc_test_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

cc_library(
    name = "mpfr_impl",
    hdrs = ["mpfr_inc.h"],
    target_compatible_with = select({
        "//libc:mpfr_disable": ["@platforms//:incompatible"],
        # In full build mode, the MPFR library should be built
        # using our own facilities, which is currently not possible.
        "//libc:full_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = select(
        {
            "//conditions:default": [],
            "//libc:mpfr_external": ["@mpfr"],
            "//libc:mpfr_system": ["//libc:libmpfr_system"],
        },
    ),
)

libc_test_library(
    name = "mp_common",
    srcs = ["MPCommon.cpp"],
    hdrs = ["MPCommon.h"],
    # Disable layering check when using mpfr_system.
    features = select(
        {
            "//conditions:default": [],
            "//libc:mpfr_system": ["-layering_check"],
        },
    ),
    deps = [
        ":mpfr_impl",
        "//libc:__support_common",
        "//libc:__support_macros_config",
        "//libc:hdr_stdint_proxy",
        "//libc/src/__support/CPP:string",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:cast",
        "//libc/src/__support/FPUtil:comparison_operations",
        "//libc/src/__support/FPUtil:float80",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)

libc_test_library(
    name = "mpfr_wrapper",
    srcs = ["MPFRUtils.cpp"],
    hdrs = ["MPFRUtils.h"],
    # Disable layering check when using mpfr_system.
    features = select(
        {
            "//conditions:default": [],
            "//libc:mpfr_system": ["-layering_check"],
        },
    ),
    deps = [
        ":mp_common",
        ":mpfr_impl",
        "//libc:__support_common",
        "//libc:__support_macros_config",
        "//libc:hdr_math_macros",
        "//libc:hdr_stdint_proxy",
        "//libc/src/__support/CPP:array",
        "//libc/src/__support/CPP:bit",
        "//libc/src/__support/CPP:bitset",
        "//libc/src/__support/CPP:string",
        "//libc/src/__support/CPP:string_view",
        "//libc/src/__support/CPP:stringstream",
        "//libc/src/__support/CPP:type_traits",
        "//libc/src/__support/FPUtil:bfloat16",
        "//libc/src/__support/FPUtil:cast",
        "//libc/src/__support/FPUtil:fp_bits",
        "//libc/src/__support/FPUtil:fpbits_str",
        "//libc/src/__support/macros/properties:types",
        "//libc/test/UnitTest:LibcUnitTest",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)
