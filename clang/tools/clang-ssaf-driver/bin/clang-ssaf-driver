import os.path
import sys

this_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(this_dir), "lib"))

from clang_ssaf_driver import driver

if __name__ == "__main__":
    sys.exit(driver.main(sys.argv[1:]))
