// Malformed attribute encodings fail with a diagnostic instead of asserting.
// Each case emits a valid blob, flips one byte with patch-blob.py (which
// asserts the expected old byte, so layout drift fails loudly instead of
// silently testing the wrong corruption), and checks the verifier error.
// To re-derive an offset after a format bump, emit two valid blobs that
// differ only in that parameter and diff them.

// RUN: split-file %s %t
// RUN: cir-opt %t/optinfo.cir --emit-bytecode -o %t/optinfo.cirbc
// RUN: %python %S/patch-blob.py %t/optinfo.cirbc 56 0x05 0x09
// RUN: not cir-opt %t/optinfo.cirbc 2>&1 | FileCheck %s --check-prefix=OPTINFO
// RUN: cir-opt %t/constarray.cir --emit-bytecode -o %t/constarray.cirbc
// RUN: %python %S/patch-blob.py %t/constarray.cirbc 74 0x0d 0x05
// RUN: not cir-opt %t/constarray.cirbc 2>&1 | FileCheck %s --check-prefix=CONSTARRAY
// RUN: cir-opt %t/constrecord.cir --emit-bytecode -o %t/constrecord.cirbc
// RUN: %python %S/patch-blob.py %t/constrecord.cirbc 75 0x01 0x03
// RUN: not cir-opt %t/constrecord.cirbc 2>&1 | FileCheck %s --check-prefix=CONSTRECORD
// RUN: cir-opt %t/method.cir --emit-bytecode -o %t/method.cirbc
// RUN: %python %S/patch-blob.py %t/method.cirbc 111 0x01 0x0f
// RUN: not cir-opt %t/method.cirbc 2>&1 | FileCheck %s --check-prefix=METHOD

// Level 4 (valid range is 0-3).
// OPTINFO: error: optimization level must be between 0 and 3 inclusive
// OPTINFO-NOT: Assertion

// One element plus trailing_zeros 1 in a 4-long array.
// CONSTARRAY: error: constant array size should match type size
// CONSTARRAY-NOT: Assertion

// A const_record whose type points at !s32i instead of the struct.
// CONSTRECORD: error: expected !cir.struct or !cir.union type
// CONSTRECORD-NOT: Assertion

// A method with both a symbol and a vtable offset.
// METHOD: error: at most one of symbol and vtable_offset can be present in #cir.method
// METHOD-NOT: Assertion

//--- optinfo.cir
module attributes { cir.opt_info = #cir.opt_info<level = 2, size = 1> } {}

//--- constarray.cir
!s32i = !cir.int<s, 32>
module {
  cir.global external @caz = #cir.const_array<[#cir.int<7> : !s32i], trailing_zeros> : !cir.array<!s32i x 4>
}

//--- constrecord.cir
!s32i = !cir.int<s, 32>
!rec = !cir.struct<"S" {data !s32i, data !s32i}>
module {
  cir.global external @cr = #cir.const_record<{#cir.int<3> : !s32i, #cir.int<4> : !s32i}> : !rec
}

//--- method.cir
!s32i = !cir.int<s, 32>
!rec_Other = !cir.struct<"Other" {data !s32i, data !s32i}>
!method_Other = !cir.method<!cir.func<(!s32i)> in !rec_Other>
module {
  cir.global external @m1 = #cir.method<@f> : !method_Other
  cir.global external @m2 = #cir.method<vtable_offset = 8> : !method_Other
}
