// RUN: rm -rf %t && split-file %s %t

// RUN: cir-offload-merge -combine \
// RUN:   -input=%t/host.cir \
// RUN:   -input=%t/device-sm80.cir \
// RUN:   -output=%t/combined.cir
// RUN: FileCheck %s --check-prefix=COMBINE --input-file=%t/combined.cir
// RUN: cir-opt %t/combined.cir --verify-roundtrip -o /dev/null

// COMBINE:      module attributes {cir.offload.container} {
// COMBINE-NEXT:   module @host attributes {{{.*}}cir.offload.kind = #cir.offload<host>, cir.triple = "x86_64-unknown-linux-gnu"} {
// COMBINE-NEXT:     cir.func{{.*}} @host_fn
// COMBINE:        module @device_0 attributes {{{.*}}cir.offload.kind = #cir.offload<device>, cir.triple = "nvptx64-nvidia-cuda"} {
// COMBINE-NEXT:     cir.func{{.*}} @device_fn

// The host module goes first whatever the input order; device modules keep
// their relative order.
// RUN: cir-offload-merge -combine \
// RUN:   -input=%t/device-sm90.cir \
// RUN:   -input=%t/host.cir \
// RUN:   -input=%t/device-sm80.cir \
// RUN:   -output=%t/reordered.cir
// RUN: FileCheck %s --check-prefix=REORDER --input-file=%t/reordered.cir

// REORDER:      module attributes {cir.offload.container} {
// REORDER-NEXT:   module @host
// REORDER:        module @device_0 attributes {{{.*}}cir.offload.kind = #cir.offload<device>, cir.triple = "nvptx64-nvidia-cuda"} {
// REORDER-NEXT:   }
// REORDER-NEXT:   module @device_1 attributes {{{.*}}cir.offload.kind = #cir.offload<device>, cir.triple = "nvptx64-nvidia-cuda"} {
// REORDER-NEXT:     cir.func{{.*}} @device_fn

// RUN: cir-offload-merge -combine \
// RUN:   -input=%t/host-hip.cir \
// RUN:   -input=%t/device-gfx90a.cir \
// RUN:   -output=%t/hip.cir
// RUN: FileCheck %s --check-prefix=HIP --input-file=%t/hip.cir

// HIP:      module @host attributes {{{.*}}cir.offload.kind = #cir.offload<host>
// HIP:      module @device_0 attributes {{{.*}}cir.offload.kind = #cir.offload<device>

// RUN: not cir-offload-merge -input=%t/host.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-NO-MODE
// ERR-NO-MODE: error: expected -combine

// RUN: not cir-offload-merge -combine -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-NO-INPUT
// ERR-NO-INPUT: error: missing required -input

// RUN: not cir-offload-merge -combine -input=%t/host.cir 2>&1 | FileCheck %s --check-prefix=ERR-NO-OUTPUT
// ERR-NO-OUTPUT: error: missing required -output

// RUN: not cir-offload-merge -combine -input=%t/host.cir -input=%t/device-sm80.cir -output=%t/a.cir -output=%t/b.cir 2>&1 | FileCheck %s --check-prefix=ERR-MULTI-OUTPUT
// ERR-MULTI-OUTPUT: error: combine mode expects exactly one output

// RUN: not cir-offload-merge -combine -input=%t/device-sm80.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-HOSTS
// RUN: not cir-offload-merge -combine -input=%t/host.cir -input=%t/host-hip.cir -input=%t/device-sm80.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-HOSTS
// ERR-HOSTS: error: expected exactly one host module

// RUN: not cir-offload-merge -combine -input=%t/host.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-NO-DEVICE
// ERR-NO-DEVICE: error: expected at least one device module

// RUN: not cir-offload-merge -combine -input=%t/host.cir -input=%t/no-lowering-options.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-NO-OPTS
// ERR-NO-OPTS: error: '{{.*}}no-lowering-options.cir' has no 'cir.lowering_options' attribute

// RUN: not cir-offload-merge -combine -input=%t/host.cir -input=%t/not-offload.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-NOT-OFFLOAD
// ERR-NOT-OFFLOAD: error: '{{.*}}not-offload.cir' is not a CUDA or HIP compilation

// RUN: not cir-offload-merge -combine -input=%t/invalid.cir -input=%t/device-sm80.cir -output=%t/out.cir 2>&1 | FileCheck %s --check-prefix=ERR-PARSE
// ERR-PARSE: error: failed to parse input file

//--- host.cir
module attributes {cir.lowering_options = #cir.lowering_options<exceptions = false, threadsafe_statics = true, cuda = true, cuda_is_device = false, hip = false, hlsl = false, gpu_rdc = false, openmp = false, openmp_is_target_device = false, clang_abi_compat = 17, long_double_size = 0, enable_noundef_attrs = false, no_trapping_math = true, ssp_buffer_size = 8>, cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @host_fn() {
    cir.return
  }
}

//--- device-sm80.cir
module attributes {cir.lowering_options = #cir.lowering_options<exceptions = false, threadsafe_statics = true, cuda = true, cuda_is_device = true, hip = false, hlsl = false, gpu_rdc = false, openmp = false, openmp_is_target_device = false, clang_abi_compat = 17, long_double_size = 0, enable_noundef_attrs = false, no_trapping_math = true, ssp_buffer_size = 8>, cir.triple = "nvptx64-nvidia-cuda"} {
  cir.func @device_fn() {
    cir.return
  }
}

//--- device-sm90.cir
module attributes {cir.lowering_options = #cir.lowering_options<exceptions = false, threadsafe_statics = true, cuda = true, cuda_is_device = true, hip = false, hlsl = false, gpu_rdc = false, openmp = false, openmp_is_target_device = false, clang_abi_compat = 17, long_double_size = 0, enable_noundef_attrs = false, no_trapping_math = true, ssp_buffer_size = 8>, cir.triple = "nvptx64-nvidia-cuda"} {
}

//--- host-hip.cir
module attributes {cir.lowering_options = #cir.lowering_options<exceptions = false, threadsafe_statics = true, cuda = true, cuda_is_device = false, hip = true, hlsl = false, gpu_rdc = false, openmp = false, openmp_is_target_device = false, clang_abi_compat = 17, long_double_size = 0, enable_noundef_attrs = false, no_trapping_math = true, ssp_buffer_size = 8>} {
