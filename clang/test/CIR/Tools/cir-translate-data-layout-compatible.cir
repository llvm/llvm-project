// REQUIRES: x86-registered-target
// RUN: cir-translate --cir-to-llvmir --target x86_64-unknown-linux-gnu --disable-cc-lowering %s -o %t.ll
// RUN: FileCheck %s -input-file %t.ll
// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -emit-obj -x ir %t.ll -o /dev/null

// The data layout cir-translate derives from the triple comes out spelled the
// way the target spells it, which is the only one clang accepts.

module {
  cir.func @foo() {
    cir.return
  }
}

// CHECK: target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
