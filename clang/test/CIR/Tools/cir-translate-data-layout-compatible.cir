// REQUIRES: x86-registered-target
// RUN: split-file %s %t
// RUN: cir-translate --cir-to-llvmir --target x86_64-unknown-linux-gnu --disable-cc-lowering %t/no-spec.cir -o %t/no-spec.ll
// RUN: FileCheck %s --check-prefix=CANON -input-file %t/no-spec.ll
// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -emit-obj -x ir %t/no-spec.ll -o /dev/null
// RUN: cir-translate --cir-to-llvmir --disable-cc-lowering %t/same-spec.cir -o %t/same-spec.ll
// RUN: FileCheck %s --check-prefix=CANON -input-file %t/same-spec.ll
// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -emit-obj -x ir %t/same-spec.ll -o /dev/null
// RUN: cir-translate --cir-to-llvmir --disable-cc-lowering %t/other-spec.cir -o - \
// RUN:   | FileCheck %s --check-prefix=OTHER

// The data layout cir-translate derives from the triple comes out spelled the
// way the target spells it, which is the only one clang accepts.

// A module carrying the target's layout as a dl_spec, here with its entries in
// a different order than CIRGen writes them, is canonicalized the same way.
// CIR's own entries (!cir.ptr, _BitInt) do not affect the comparison.

// A module whose layout differs from the target's (here S64) keeps the layout
// it carries, in MLIR's spelling.

// CANON: target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
// OTHER: target datalayout = "e-m:e-n8:16:32:64-S64-p270:32:32:32:32-p271:32:32:32:32-p272:64:64:64:64-i64:64-i128:128-f80:128-p0:64:64:64:64-i1:8-i8:8-i16:16-i32:32-f16:16-f64:64-f128:128"

//--- no-spec.cir
module {
  cir.func @foo() {
    cir.return
  }
}

//--- same-spec.cir
module attributes {cir.triple = "x86_64-unknown-linux-gnu", dlti.dl_spec = #dlti.dl_spec<!cir.ptr<!cir.void> = #cir.ptr_spec<size = 64, abi = 64, preferred = 64, index = 64>, "dlti.stack_alignment" = 128 : i64, "dlti.legal_int_widths" = array<i32: 8, 16, 32, 64>, "dlti.mangling_mode" = "e", "dlti.endianness" = "little", f128 = dense<128> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i1 = dense<8> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, f80 = dense<128> : vector<2xi64>, i128 = dense<128> : vector<2xi64>, i64 = dense<64> : vector<2xi64>, !llvm.ptr<272> = dense<64> : vector<4xi64>, !llvm.ptr<271> = dense<32> : vector<4xi64>, !llvm.ptr<270> = dense<32> : vector<4xi64>, !cir.int<u, 1, bitint> = #cir.bitint_spec<max_align = 64>>} {
  cir.func @foo() {
    cir.return
  }
}

//--- other-spec.cir
module attributes {cir.triple = "x86_64-unknown-linux-gnu", dlti.dl_spec = #dlti.dl_spec<!llvm.ptr<270> = dense<32> : vector<4xi64>, !llvm.ptr<271> = dense<32> : vector<4xi64>, !llvm.ptr<272> = dense<64> : vector<4xi64>, i64 = dense<64> : vector<2xi64>, i128 = dense<128> : vector<2xi64>, f80 = dense<128> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, "dlti.endianness" = "little", "dlti.mangling_mode" = "e", "dlti.legal_int_widths" = array<i32: 8, 16, 32, 64>, "dlti.stack_alignment" = 64 : i64>} {
  cir.func @foo() {
    cir.return
  }
}
