// RUN: cir-opt %s --cir-lowering-prepare | FileCheck %s --check-prefix=DEFAULT
// RUN: sed 's/no_trapping_math = true/no_trapping_math = false/' %s \
// RUN:   | cir-opt --cir-lowering-prepare | FileCheck %s --check-prefix=STRICTFP
// RUN: sed 's/ssp_buffer_size = 8/ssp_buffer_size = 8, rounding_math = true/' %s \
// RUN:   | cir-opt --cir-lowering-prepare | FileCheck %s --check-prefix=STRICTFP

// LoweringPrepare marks the initialization functions it creates strictfp when
// #cir.lowering_options says that the TU-wide default FP environment is
// constrained: FP exceptions are not ignored or the rounding mode is dynamic.

!s32i = !cir.int<s, 32>

module attributes {
  cir.triple = "x86_64-unknown-linux-gnu",
  cir.lowering_options = #cir.lowering_options<
    exceptions = false, threadsafe_statics = true, cuda = false,
    cuda_is_device = false, hip = false, hlsl = false, sycl_is_device = false,
    gpu_rdc = false, openmp = false,
    openmp_is_target_device = false, clang_abi_compat = 16, long_double_size = 0,
    enable_noundef_attrs = true, no_trapping_math = true,
    ssp_buffer_size = 8>
} {
  cir.func private @_Z3extv() -> !s32i

  cir.global external @g = #cir.int<0> : !s32i ctor {
    %0 = cir.get_global @g : !cir.ptr<!s32i>
    %1 = cir.call @_Z3extv() : () -> !s32i
    cir.store align(4) %1, %0 : !s32i, !cir.ptr<!s32i>
  } align(4)
}

// DEFAULT: cir.func internal private @__cxx_global_var_init()
// DEFAULT-NOT: strictfp
// DEFAULT: cir.func internal private @_GLOBAL__sub_I__null_()
// DEFAULT-NOT: strictfp

// STRICTFP: cir.func internal private @__cxx_global_var_init() {{.*}}attributes {strictfp}
// STRICTFP: cir.func internal private @_GLOBAL__sub_I__null_() {{.*}}attributes {strictfp}
