// RUN: cir-opt %s -cir-goto-elimination -o - | FileCheck %s
// RUN: cir-opt %s -cir-goto-elimination -cir-goto-elimination -o - \
// RUN:   | FileCheck %s

!s32i = !cir.int<s, 32>
!void = !cir.void

cir.func private @g()

// A goto to a label in the same region becomes a branch, and the label goes.
// CHECK-LABEL: cir.func @same_region(
// CHECK:         cir.br ^[[L:bb[0-9]+]]
// CHECK:       ^[[L]]:
// CHECK-NOT:     cir.label
// CHECK:         cir.return
cir.func @same_region() {
  cir.goto "out"
^bb1:
  cir.call @g() : () -> ()
  cir.br ^bb2
^bb2:
  cir.label "out"
  cir.return
}

// A backward goto in the same region becomes a back edge.
// CHECK-LABEL: cir.func @backward(
// CHECK:       ^[[LOOP:bb[0-9]+]]:
// CHECK-NOT:     cir.label
// CHECK:         cir.call @g()
// CHECK-NEXT:    cir.br ^[[LOOP]]
cir.func @backward() {
  cir.br ^bb1
^bb1:
  cir.label "again"
  cir.call @g() : () -> ()
  cir.goto "again"
}

// A goto out of an if inside a scope stores the label's id, leaves each
// region through its yield, and is routed after each op by a dispatch on the
// slot. The same-region goto to the label becomes a branch.
// CHECK-LABEL: cir.func @out_of_if_in_scope(
// CHECK:         %[[SLOT:.*]] = cir.alloca "__goto_dest_slot"
// CHECK:         cir.store %{{.*}}, %[[SLOT]]
// CHECK:         cir.scope {
// CHECK:           cir.if %{{.*}} {
// CHECK-NEXT:        %[[ID:.*]] = cir.const #cir.int<1> : !s32i
// CHECK-NEXT:        cir.store %[[ID]], %[[SLOT]]
// CHECK-NEXT:        cir.br ^[[EXIT:bb[0-9]+]]
// CHECK-NEXT:      ^[[EXIT]]:
// CHECK-NEXT:        cir.yield
// CHECK-NEXT:      }
// CHECK-NEXT:      cir.br ^[[D1:bb[0-9]+]]
// CHECK:         ^[[D1]]:
// CHECK-NEXT:      %[[V1:.*]] = cir.load %[[SLOT]]
// CHECK-NEXT:      cir.switch.flat %[[V1]] : !s32i, ^{{bb[0-9]+}} [
// CHECK-NEXT:        1: ^{{bb[0-9]+}}
// CHECK:           cir.yield
// CHECK:         }
// CHECK:         %[[V2:.*]] = cir.load %[[SLOT]]
// CHECK-NEXT:    cir.switch.flat %[[V2]] : !s32i, ^[[CONT:bb[0-9]+]] [
// CHECK-NEXT:      1: ^[[TO_OUT:bb[0-9]+]]
// CHECK:       ^[[TO_OUT]]:
// CHECK:         cir.store %{{.*}}, %[[SLOT]]
// CHECK-NEXT:    cir.br ^[[OUT:bb[0-9]+]]
// CHECK:       ^[[CONT]]:
// CHECK-NEXT:    cir.br ^[[OUT]]
// CHECK:       ^[[OUT]]:
// CHECK-NOT:     cir.label
// CHECK:         cir.return
cir.func @out_of_if_in_scope(%arg0: !cir.bool) {
  cir.scope {
    cir.if %arg0 {
      cir.goto "out"
    }
    cir.yield
  }
  cir.goto "out"
^bb1:
  cir.label "out"
  cir.return
}

// A goto out of a loop body leaves it with cir.break.
// CHECK-LABEL: cir.func @out_of_loop(
// CHECK:         cir.while {
// CHECK:         } do {
// CHECK:           cir.store %{{.*}}, %[[SLOT:.*]] :
// CHECK-NEXT:      cir.break
// CHECK:         }
// CHECK:         cir.switch.flat
cir.func @out_of_loop(%arg0: !cir.bool) {
  cir.while {
    cir.condition(%arg0)
  } do {
    cir.goto "out"
  }
  cir.br ^bb1
^bb1:
  cir.label "out"
  cir.return
}

// A goto out of a cleanup scope body yields in place, so the cleanup runs.
// CHECK-LABEL: cir.func @out_of_cleanup(
// CHECK:         cir.cleanup.scope {
// CHECK:           cir.store %{{.*}}, %{{.*}} :
// CHECK-NEXT:      cir.yield
// CHECK:         } cleanup normal {
// CHECK-NEXT:      cir.call @g()
// CHECK:         cir.switch.flat
cir.func @out_of_cleanup(%arg0: !cir.bool) {
  cir.cleanup.scope {
    cir.goto "out"
  } cleanup normal {
    cir.call @g() : () -> ()
    cir.yield
  }
  cir.br ^bb1
^bb1:
  cir.label "out"
  cir.return
}

// The exit of a region that ends with code before its yield is a new block
// holding only the yield, so the goto skips that code.
// CHECK-LABEL: cir.func @exit_block_skips_code(
// CHECK:         cir.scope {
// CHECK:           cir.br ^[[EXIT:bb[0-9]+]]
// CHECK:           cir.call @g()
// CHECK-NEXT:      cir.br ^[[EXIT]]
// CHECK-NEXT:    ^[[EXIT]]:
// CHECK-NEXT:      cir.yield
cir.func @exit_block_skips_code(%arg0: !cir.bool) {
  cir.scope {
    cir.goto "out"
  ^bb1:
    cir.call @g() : () -> ()
    cir.yield
  }
  cir.br ^bb1
^bb1:
  cir.label "out"
  cir.return
}

// A goto out of a loop's condition region is not handled yet: it stays, with
// its label.
// CHECK-LABEL: cir.func @from_loop_cond(
// CHECK:         cir.goto "out"
// CHECK:         cir.label "out"
cir.func @from_loop_cond(%arg0: !cir.bool) {
  cir.while {
    cir.goto "out"
  } do {
    cir.yield
  }
  cir.br ^bb1
^bb1:
  cir.label "out"
  cir.return
}

// A goto into the then branch of an if passes true to a block right before
// the if instead of evaluating the condition, and the branch dispatches on
// the slot at its start.
// CHECK-LABEL: cir.func @into_then(
// CHECK:         cir.brcond %arg0 ^[[GOTO:bb[0-9]+]], ^[[NORMAL:bb[0-9]+]]
// CHECK:       ^[[GOTO]]:
// CHECK:         cir.store %{{.*}}, %[[SLOT:.*]] :
// CHECK-NEXT:    %[[TRUE:.*]] = cir.const #true
// CHECK-NEXT:    cir.br ^[[PRE:bb[0-9]+]](%[[TRUE]] : !cir.bool)
// CHECK:       ^[[NORMAL]]:
// CHECK:         %[[C:.*]] = cir.call @cond()
// CHECK:         cir.br ^[[PRE]](%[[C]] : !cir.bool)
// CHECK:       ^[[PRE]](%[[ARG:.*]]: !cir.bool):
// CHECK-NEXT:    cir.if %[[ARG]] {
// CHECK-NEXT:      %[[ID:.*]] = cir.load %[[SLOT]]
// CHECK-NEXT:      cir.switch.flat %[[ID]] : !s32i, ^[[REST:bb[0-9]+]] [
// CHECK-NEXT:        1: ^[[TO_L:bb[0-9]+]]
// CHECK:         ^[[TO_L]]:
// CHECK:           cir.br ^[[L:bb[0-9]+]]
// CHECK:         ^[[L]]:
// CHECK-NOT:       cir.label
// CHECK:           cir.call @g()
cir.func private @cond() -> !cir.bool
cir.func @into_then(%arg0: !cir.bool) {
  cir.brcond %arg0 ^bb1, ^bb2
^bb1:
  cir.goto "l"
^bb2:
  %0 = cir.call @cond() : () -> !cir.bool
  cir.if %0 {
    cir.call @g() : () -> ()
    cir.br ^bb1
  ^bb1:
    cir.label "l"
    cir.call @g() : () -> ()
    cir.yield
  }
  cir.return
}

// A goto into a while loop's body skips the condition: the condition region
// branches to its final cir.condition with true for the goto.
// CHECK-LABEL: cir.func @into_while(
// CHECK:         cir.while {
// CHECK-NEXT:      %[[ID:.*]] = cir.load
// CHECK-NEXT:      cir.switch.flat %[[ID]] : !s32i, ^[[EVAL:bb[0-9]+]] [
// CHECK-NEXT:        1: ^[[ENTER:bb[0-9]+]]
// CHECK:         ^[[ENTER]]:
// CHECK-NEXT:      %[[TRUE:.*]] = cir.const #true
// CHECK-NEXT:      cir.br ^[[COND:bb[0-9]+]](%[[TRUE]] : !cir.bool)
// CHECK:         ^[[EVAL]]:
// CHECK:           %[[C:.*]] = cir.call @cond()
// CHECK-NEXT:      cir.br ^[[COND]](%[[C]] : !cir.bool)
// CHECK:         ^[[COND]](%[[ARG:.*]]: !cir.bool):
// CHECK-NEXT:      cir.condition(%[[ARG]])
// CHECK:         } do {
// CHECK-NEXT:      cir.load
// CHECK-NEXT:      cir.switch.flat
cir.func @into_while(%arg0: !cir.bool) {
  cir.brcond %arg0 ^bb1, ^bb2
^bb1:
  cir.goto "l"
^bb2:
  cir.while {
    %0 = cir.call @cond() : () -> !cir.bool
    cir.condition(%0)
  } do {
    cir.br ^bb1
  ^bb1:
    cir.label "l"
    cir.call @g() : () -> ()
    cir.yield
  }
  cir.return
}

// A goto from one case to another leaves the switch and re-enters it with
// the target case's value.
// CHECK-LABEL: cir.func @case_to_case(
// CHECK:         ^[[PRE:bb[0-9]+]](%[[V:.*]]: !s32i):
// CHECK-NEXT:    cir.switch(%[[V]] : !s32i) {
// CHECK:           cir.case(equal, [#cir.int<0> : !s32i]) {
// CHECK:             cir.break
// CHECK:           cir.case(equal, [#cir.int<1> : !s32i]) {
// CHECK-NEXT:        cir.load
// CHECK-NEXT:        cir.switch.flat
// CHECK:         %[[ONE:.*]] = cir.const #cir.int<1> : !s32i
// CHECK-NEXT:    cir.br ^[[PRE]](%[[ONE]] : !s32i)
cir.func @case_to_case(%arg0: !s32i) {
  cir.switch(%arg0 : !s32i) {
    cir.case(equal, [#cir.int<0> : !s32i]) {
      cir.goto "l"
    }
    cir.case(equal, [#cir.int<1> : !s32i]) {
      cir.br ^bb1
    ^bb1:
      cir.label "l"
      cir.call @g() : () -> ()
      cir.break
    }
    cir.yield
  }
  cir.return
}

// Code before a switch's first case is reached only through its labels, so
// it moves out of the switch, off the normal path. Its break leaves through a
// label after the switch, and the goto becomes a branch.
// CHECK-LABEL: cir.func @into_switch_body(
// CHECK:         cir.brcond %arg1 ^[[GOTO:bb[0-9]+]], ^[[NORMAL:bb[0-9]+]]
// CHECK:       ^[[GOTO]]:
// CHECK-NEXT:    cir.br ^[[CODE:bb[0-9]+]]
// CHECK:       ^[[NORMAL]]:
// CHECK-NEXT:    cir.br ^[[SWITCH:bb[0-9]+]]
// CHECK:       ^[[CODE]]:
// CHECK-NEXT:    cir.call @g()
// CHECK-NEXT:    cir.br ^[[EXIT:bb[0-9]+]]
// CHECK:       ^[[SWITCH]]:
// CHECK-NEXT:    cir.switch(%arg0 : !s32i) {
// CHECK-NEXT:      cir.yield
// CHECK-NEXT:    }
// CHECK-NEXT:    cir.br ^[[EXIT]]
// CHECK:       ^[[EXIT]]:
// CHECK-NEXT:    cir.return
// CHECK-NOT:     cir.goto
// CHECK-NOT:     cir.label
cir.func @into_switch_body(%arg0: !s32i, %arg1: !cir.bool) {
  cir.brcond %arg1 ^bb1, ^bb2
^bb1:
  cir.goto "l"
^bb2:
  cir.switch(%arg0 : !s32i) {
    cir.br ^bb1
  ^bb1:
    cir.label "l"
    cir.call @g() : () -> ()
    cir.break
  }
  cir.return
}

// A break in a loop inside hoisted pre-case code still leaves only the loop.
// CHECK-LABEL: cir.func @pre_case_loop_break(
// CHECK:         cir.call @g()
// CHECK:         cir.while {
// CHECK:         } do {
// CHECK-NEXT:      cir.break
// CHECK-NEXT:    }
// CHECK-NOT:     cir.goto
cir.func @pre_case_loop_break(%arg0: !s32i, %arg1: !cir.bool) {
  cir.brcond %arg1 ^bb1, ^bb2
^bb1:
  cir.goto "l"
^bb2:
  cir.switch(%arg0 : !s32i) {
    cir.br ^bb1
  ^bb1:
    cir.label "l"
    cir.call @g() : () -> ()
    cir.while {
      cir.condition(%arg1)
    } do {
      cir.break
    }
    cir.break
  }
  cir.return
}

// A case nested below its switch becomes a label where it was, its body a
// scope, and a direct case in a block at the end of the switch, which nothing
// falls into, jumps there: out of the switch and back in through case 0.
// CHECK-LABEL: cir.func @nested_case(
// CHECK:       ^[[PRE:bb[0-9]+]](%[[V:.*]]: !s32i):
// CHECK-NEXT:    cir.switch(%[[V]] : !s32i) {
// CHECK-NEXT:      cir.case(equal, [#cir.int<0> : !s32i]) {
// CHECK:             cir.scope {
// CHECK:               cir.scope {
// CHECK-NEXT:            cir.call @g()
// CHECK:         ^{{bb[0-9]+}}:  // no predecessors
// CHECK-NEXT:      cir.case(equal, [#cir.int<1> : !s32i]) {
// CHECK-NEXT:        %[[ID:.*]] = cir.const #cir.int<1> : !s32i
// CHECK-NEXT:        cir.store %[[ID]]
// CHECK-NEXT:        cir.break
// CHECK:         %[[ZERO:.*]] = cir.const #cir.int<0> : !s32i
// CHECK-NEXT:    cir.br ^[[PRE]](%[[ZERO]] : !s32i)
// CHECK-NOT:     cir.goto
// CHECK-NOT:     cir.label
cir.func @nested_case(%arg0: !s32i) {
  cir.switch(%arg0 : !s32i) {
    cir.case(equal, [#cir.int<0> : !s32i]) {
      cir.scope {
        cir.case(equal, [#cir.int<1> : !s32i]) {
          cir.call @g() : () -> ()
          cir.yield
        }
        cir.yield
      }
      cir.break
    }
    cir.yield
  }
  cir.return
}

// A label whose address is taken stays, even with no goto.
// CHECK-LABEL: cir.func @address_taken(
// CHECK:         cir.label "taken" address_taken
cir.func @address_taken() -> !cir.ptr<!void> {
  %0 = cir.block_address <@address_taken, "taken"> : !cir.ptr<!void>
  cir.br ^bb1
^bb1:
  cir.label "taken" address_taken
  cir.return %0 : !cir.ptr<!void>
}

// A label whose address is taken only in a global initializer stays.
cir.global external @table = #cir.const_array<[#cir.block_addr_info<@from_global, "entry"> : !cir.ptr<!void>]> : !cir.array<!cir.ptr<!void> x 1>
// CHECK-LABEL: cir.func @from_global(
// CHECK:         cir.label "entry" address_taken
cir.func @from_global() {
  cir.br ^bb1
^bb1:
  cir.label "entry" address_taken
  cir.return
}

// No value enters an empty GNU case range, so a goto into one stays.
// CHECK-LABEL: cir.func @into_empty_range(
// CHECK-NOT:     goto_dest_slot
// CHECK:         cir.goto "l"
// CHECK:         cir.label "l"
cir.func @into_empty_range(%arg0: !s32i, %arg1: !cir.bool) {
  cir.if %arg1 {
    cir.goto "l"
  }
  cir.switch(%arg0 : !s32i) {
    cir.case(range, [#cir.int<5> : !s32i, #cir.int<3> : !s32i]) {
      cir.br ^bb1
    ^bb1:
      cir.label "l"
      cir.call @g() : () -> ()
      cir.break
    }
    cir.yield
  }
  cir.return
}

// The function's slot can't be shared with an OpenMP region, which may run
// on several threads or be isolated from the function, so a goto inside one
// stays unless it targets its own region.
// CHECK-LABEL: cir.func @in_omp_parallel(
// CHECK-NOT:     goto_dest_slot
// CHECK:         cir.goto "l"
// CHECK:         cir.label "l"
cir.func @in_omp_parallel(%arg0: !cir.bool) {
  omp.parallel {
    cir.scope {
      cir.if %arg0 {
        cir.goto "l"
      }
      cir.call @g() : () -> ()
      cir.br ^bb1
    ^bb1:
      cir.label "l"
      cir.yield
    }
    omp.terminator
  }
  cir.return
}
