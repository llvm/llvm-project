// RUN: cir-opt %s --cir-lowering-prepare -o %t.once.cir
// RUN: cir-opt %t.once.cir --cir-lowering-prepare -o %t.twice.cir
// RUN: diff %t.once.cir %t.twice.cir
// RUN: FileCheck %s --input-file=%t.once.cir --implicit-check-not=tls_refs

// LoweringPrepare consumes 'tls_refs' when it builds the TLS wrapper and init
// alias, so running it again on its own output builds nothing a second time.

!s32i = !cir.int<s, 32>
module attributes {cir.default_tls_model = #cir.tls_model<tls_dyn>, cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.global external tls_model = tls_dyn tls_refs = <"_ZTW2tl", "_ZTH2tl"> @tl = #cir.int<0> : !s32i ctor {
    %0 = cir.get_global thread_local @tl : !cir.ptr<!s32i>
    %1 = cir.call @_Z3dynv() : () -> !s32i
    cir.store align(4) %1, %0 : !s32i, !cir.ptr<!s32i>
  } align(4)
  cir.global "private" external tls_model = tls_dyn tls_refs = <"_ZTW3ext", "_ZTH3ext"> @ext : !s32i align(4)
  cir.func private @_Z3dynv() -> !s32i
  cir.func @_Z3usev() -> !s32i {
    %0 = cir.get_global thread_local @tl : !cir.ptr<!s32i>
    %1 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    %2 = cir.get_global thread_local @ext : !cir.ptr<!s32i>
    %3 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    %4 = cir.add nsw %1, %3 : !s32i
    cir.return %4 : !s32i
  }
}

// CHECK: cir.func comdat linkonce_odr private hidden @_ZTW3ext()
// CHECK: cir.func extern_weak private @_ZTH3ext()
// CHECK: cir.func comdat weak_odr private hidden @_ZTW2tl()
// CHECK: cir.func @_ZTH2tl() alias(@__tls_init)
// CHECK: cir.func internal private @__tls_init()
// CHECK: cir.global external tls_model = tls_dyn @tl = #cir.int<0> : !s32i align(4)
// CHECK: cir.global "private" external tls_model = tls_dyn @ext : !s32i align(4)
// CHECK: cir.func @_Z3usev()
// CHECK:   cir.call @_ZTW2tl()
// CHECK:   cir.call @_ZTW3ext()
