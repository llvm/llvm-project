// RUN: cir-opt %s -cir-cxxabi-lowering -verify-diagnostics -split-input-file
// RUN: cir-opt %s -cir-cxxabi-lowering -split-input-file 2>/dev/null | FileCheck %s

// Check that missing cir.triple module attribute does not cause asserts or
// compiler crashes in -cir-cxxabi-lowering, and is diagnosed properly. The pass
// should warn and skip instead of failing. so every module is still printed.
//
// Malformed cir.triple and cir.opt_info attributes are rejected by the CIR
// dialect verifier; see IR/invalid-triple.cir and IR/invalid-opt-info.cir.


// Missing cir.triple.

// expected-warning @below {{cannot create a CIR lower module, skipping the CXXABILowering pass}}
module {
  // CHECK-LABEL: cir.func @missing_triple(
  cir.func @missing_triple() {
    cir.return
  }
}

// -----

// expected-warning @below {{cannot create a CIR lower module, skipping the CXXABILowering pass}}
module attributes {cir.opt_info = #cir.opt_info<level = 0, size = 1>} {
  // CHECK-LABEL: cir.func @missing_triple(
  cir.func @missing_triple() {
    cir.return
  }
}

// -----

// Valid cir.triple without cir.opt_info.

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // CHECK-LABEL: cir.func @valid_triple(
  cir.func @valid_triple() {
    cir.return
  }
}

// -----

// Valid cir.triple with a valid cir.opt_info.

module attributes {
  cir.triple = "x86_64-unknown-linux-gnu",
  cir.opt_info = #cir.opt_info<level = 2, size = 1>
} {
  // CHECK-LABEL: cir.func @valid_opt_info(
  cir.func @valid_opt_info() {
    cir.return
  }
}
