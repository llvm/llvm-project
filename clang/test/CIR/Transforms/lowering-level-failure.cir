// RUN: not cir-opt %s --cir-call-conv-lowering=target=x86_64 -mlir-print-ir-after-failure 2>&1 | FileCheck %s

// A lowering pass that fails leaves the module at the level it started from.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

// CHECK: error: 'cir.call' op extra arguments to a callee without a prototype not yet implemented in CallConvLowering
// CHECK: IR Dump After CallConvLowering Failed
// CHECK: cir.lowering_level = #cir.lowering_level<prepared>
module attributes {
  cir.lowering_level = #cir.lowering_level<prepared>,
  cir.triple = "x86_64-unknown-linux-gnu",
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i8, dense<8>: vector<2xi64>>,
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>>
} {
  cir.func no_proto private @kandr(!cir.ptr<!s8i>) -> !s32i

  cir.func @extra_args_no_proto(%arg0: !cir.ptr<!s8i>, %arg1: !s32i) {
    %0 = cir.call @kandr(%arg0, %arg1) : (!cir.ptr<!s8i>, !s32i) -> !s32i
    cir.return
  }
}
