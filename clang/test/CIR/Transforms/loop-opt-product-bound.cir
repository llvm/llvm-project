      cir.condition(%5)
    } body {
      %3 = cir.const #cir.int<1> : !s32i
      cir.store align(4) %3, %1 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %4 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
        %5 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %6 = cir.mul nsw %4, %5 : !s32i
        %7 = cir.const #cir.int<1024> : !s32i
