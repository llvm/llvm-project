// RUN: cir-opt %s -cir-cxxabi-lowering -o %t.cir
// RUN: FileCheck --input-file=%t.cir %s

!u8i = !cir.int<u, 8>
!s32i = !cir.int<s, 32>
!rec_S = !cir.struct<"S" {data !s32i}>
!rec_Other = !cir.struct<"Other" {pad !u8i}>
!rec_Dmp = !cir.struct<"Dmp" {data !cir.data_member<!s32i in !rec_Other>}>
// CHECK: !rec_Dmp = !cir.struct<"Dmp" {data !s64i}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Same-type no-op casts stay illegal so the driver folds them away,
  // on plain ...
  cir.func @cast_plain(%p: !cir.ptr<!s32i>) -> !cir.ptr<!s32i> {
    %c = cir.cast bitcast %p : !cir.ptr<!s32i> -> !cir.ptr<!s32i>
    cir.return %c : !cir.ptr<!s32i>
  }
  // CHECK-LABEL: cir.func @cast_plain
  // CHECK-NEXT: cir.return %{{.*}} : !cir.ptr<!s32i>

  // ... and record pointers.
  cir.func @cast_record(%p: !cir.ptr<!rec_S>) -> !cir.ptr<!rec_S> {
    %c = cir.cast bitcast %p : !cir.ptr<!rec_S> -> !cir.ptr<!rec_S>
    cir.return %c : !cir.ptr<!rec_S>
  }
  // CHECK-LABEL: cir.func @cast_record
  // CHECK-NEXT: cir.return %{{.*}} : !cir.ptr<!rec_S>

  // Same for the address_space casts TargetLowering leaves behind.
  cir.func @cast_addrspace(%p: !cir.ptr<!s32i>) -> !cir.ptr<!s32i> {
    %c = cir.cast address_space %p : !cir.ptr<!s32i> -> !cir.ptr<!s32i>
    cir.return %c : !cir.ptr<!s32i>
  }
  // CHECK-LABEL: cir.func @cast_addrspace
  // CHECK-NEXT: cir.return %{{.*}} : !cir.ptr<!s32i>

  // Records that reach member pointers are still rewritten.
  cir.func @dmp_rewritten() {
    %r = cir.const #cir.zero : !rec_Dmp
    cir.return
  }
  // CHECK-LABEL: cir.func @dmp_rewritten
  // CHECK-NEXT: %{{.*}} = cir.const #cir.zero : !rec_Dmp
  // CHECK-NEXT: cir.return
}
