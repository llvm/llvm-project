    cir.return
  }

  // CHECK-LABEL: cir.func @step_break_terminator
  // CHECK-NOT: cir.loopopt.test
  cir.func @step_break_terminator() {
    %0 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "j" align(4) init : !cir.ptr<!s32i>
