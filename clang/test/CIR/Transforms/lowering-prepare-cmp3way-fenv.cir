// RUN: cir-opt %s --cir-lowering-prepare -o - | FileCheck %s \
// RUN:   -DSTRICT="fenv<dynamic_rounding_mode = unknown, except_mode = unknown, strict_except = true>"

// LoweringPrepare expands a three-way comparison into comparisons and selects.
// A floating-point one expands into quiet `cir.fcmp`s, which take its `fenv`
// attribute if it has one. An integer one expands into `cir.cmp`.

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

#partial = #cir.cmp3way_info<partial, lt = -1, eq = 0, gt = 1, unordered = -127>
#strong = #cir.cmp3way_info<strong, lt = -1, eq = 0, gt = 1>
#weak = #cir.cmp3way_info<weak, lt = -1, eq = 0, gt = 1>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {

// CHECK-LABEL: cir.func @partial_constrained(
// CHECK-SAME:      %[[A:.*]]: !cir.double, %[[B:.*]]: !cir.double)
// CHECK:         %[[EQ:.*]] = cir.fcmp oeq %[[A]], %[[B]] : !cir.double [[STRICT]]
// CHECK:         %[[SEL_EQ:.*]] = cir.select if %[[EQ]] then %{{.*}} else %{{.*}} :
// CHECK:         %[[GT:.*]] = cir.fcmp ogt %[[A]], %[[B]] : !cir.double [[STRICT]]
// CHECK:         %[[SEL_GT:.*]] = cir.select if %[[GT]] then %{{.*}} else %[[SEL_EQ]] :
// CHECK:         %[[LT:.*]] = cir.fcmp olt %[[A]], %[[B]] : !cir.double [[STRICT]]
// CHECK:         %[[RES:.*]] = cir.select if %[[LT]] then %{{.*}} else %[[SEL_GT]] :
// CHECK:         cir.return %[[RES]]
cir.func @partial_constrained(%a: !cir.double, %b: !cir.double) -> !s8i {
  %0 = cir.cmp3way #partial %a, %b : !cir.double -> !s8i fenv<dynamic_rounding_mode = unknown, except_mode = unknown, strict_except = true>
  cir.return %0 : !s8i
}

// An empty attribute constrains the operation with the default environment.

// CHECK-LABEL: cir.func @partial_constrained_default(
// CHECK:         cir.fcmp oeq %{{.*}}, %{{.*}} : !cir.float fenv<>
// CHECK:         cir.fcmp ogt %{{.*}}, %{{.*}} : !cir.float fenv<>
// CHECK:         cir.fcmp olt %{{.*}}, %{{.*}} : !cir.float fenv<>
cir.func @partial_constrained_default(%a: !cir.float, %b: !cir.float) -> !s8i {
  %0 = cir.cmp3way #partial %a, %b : !cir.float -> !s8i fenv<>
  cir.return %0 : !s8i
}

// The operation does not tie the ordering kind to the operand type, so a total
// ordering of floating-point values is expanded the same way.

// CHECK-LABEL: cir.func @total_constrained(
// CHECK:         %[[LT:.*]] = cir.fcmp olt %{{.*}}, %{{.*}} : !cir.double [[STRICT]]
// CHECK:         %[[SEL_LT:.*]] = cir.select if %[[LT]] then %{{.*}} else %{{.*}} :
// CHECK:         %[[EQ:.*]] = cir.fcmp oeq %{{.*}}, %{{.*}} : !cir.double [[STRICT]]
// CHECK:         cir.select if %[[EQ]] then %{{.*}} else %[[SEL_LT]] :
cir.func @total_constrained(%a: !cir.double, %b: !cir.double) -> !s8i {
  %0 = cir.cmp3way #weak %a, %b : !cir.double -> !s8i fenv<dynamic_rounding_mode = unknown, except_mode = unknown, strict_except = true>
  cir.return %0 : !s8i
}

// CHECK-LABEL: cir.func @partial_unconstrained(
// CHECK:         cir.fcmp oeq %{{.*}}, %{{.*}} : !cir.double{{$}}
// CHECK:         cir.fcmp ogt %{{.*}}, %{{.*}} : !cir.double{{$}}
// CHECK:         cir.fcmp olt %{{.*}}, %{{.*}} : !cir.double{{$}}
cir.func @partial_unconstrained(%a: !cir.double, %b: !cir.double) -> !s8i {
  %0 = cir.cmp3way #partial %a, %b : !cir.double -> !s8i
  cir.return %0 : !s8i
}

// CHECK-LABEL: cir.func @strong_integer(
// CHECK:         cir.cmp lt %{{.*}}, %{{.*}} : !s32i{{$}}
// CHECK:         cir.cmp eq %{{.*}}, %{{.*}} : !s32i{{$}}
cir.func @strong_integer(%a: !s32i, %b: !s32i) -> !s8i {
  %0 = cir.cmp3way #strong %a, %b : !s32i -> !s8i
  cir.return %0 : !s8i
}

}
