  // CHECK-NOT:    cir.load
  // CHECK:        cir.br ^bb1
  // CHECK:      ^bb1:
  // CHECK:        cir.call @takes_big_non_byval(%[[PTR]]) :

  cir.func private @takes_big_non_byval(%arg0: !rec_Big)
      attributes { test_classify = #non_byval_arg }

}

