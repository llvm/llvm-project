!s64i = !cir.int<s, 64>
!rec_Big = !cir.struct<"Big" {data !s64i, data !s64i, data !s64i, data !s64i}>
!rec_Two = !cir.struct<"Two" {data !s64i, data !s64i}>

#expand_then_non_byval = {
  return = { kind = "direct" },
  args   = [ { kind = "expand" },
             { kind = "indirect", indirect_align = 8, byval = false } ]
