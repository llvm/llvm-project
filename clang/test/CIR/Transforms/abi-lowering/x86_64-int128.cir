// RUN: cir-opt %s -cir-call-conv-lowering=target=x86_64 | FileCheck %s
// RUN: cir-opt %s -cir-call-conv-lowering=target=x86_64 -cir-to-llvm -o - 2>/dev/null \
// RUN:   | mlir-translate -mlir-to-llvmir --allow-unregistered-dialect \
// RUN:   | FileCheck %s --check-prefix=LLVM

!s128i = !cir.int<s, 128>
!u128i = !cir.int<u, 128>
!rec_S1 = !cir.struct<"S1" {!s128i}>

module attributes {
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i8, dense<8>: vector<2xi64>>,
    #dlti.dl_entry<i128, dense<128>: vector<2xi64>>>
} {

  // A signed __int128 is Direct: it passes in a pair of integer registers, so
  // the signature and call sites are unchanged.
  cir.func @ret_i128(%arg0: !s128i) -> !s128i {
    cir.return %arg0 : !s128i
  }

  // CHECK: cir.func{{.*}} @ret_i128(%arg0: !s128i) -> !s128i
  // CHECK-NEXT: cir.return %arg0 : !s128i

  // An unsigned __int128 is Direct as well.
  cir.func @ret_u128(%arg0: !u128i) -> !u128i {
    cir.return %arg0 : !u128i
  }

  // CHECK: cir.func{{.*}} @ret_u128(%arg0: !u128i) -> !u128i

  // The call site passes the value through unchanged.
  cir.func @call_i128(%arg0: !s128i) -> !s128i {
    %0 = cir.call @ret_i128(%arg0) : (!s128i) -> !s128i
    cir.return %0 : !s128i
  }

  // CHECK: cir.call @ret_i128(%arg0) : (!s128i) -> !s128i

  // A struct holding a single __int128 is exactly two eightbytes and can pass
  // in registers, so it is Direct and coerced to i128 rather than passed by
  // value; the rewriter bitcasts the coerced i128 through the record type.
  cir.func @coerce_s1(%arg0: !rec_S1) -> !rec_S1 {
    %0 = cir.alloca "a" align(16) : !cir.ptr<!rec_S1>
    cir.store %arg0, %0 : !rec_S1, !cir.ptr<!rec_S1>
    %1 = cir.load %0 : !cir.ptr<!rec_S1>, !rec_S1
    cir.return %1 : !rec_S1
  }

  // CHECK: cir.func{{.*}} @coerce_s1(%arg0: !s128i) -> !s128i
  // CHECK: cir.cast bitcast %{{.*}} : !cir.ptr<!s128i> -> !cir.ptr<!rec_S1>
}

// LLVM: define i128 @ret_i128(i128 %{{.+}})
// LLVM: define i128 @ret_u128(i128 %{{.+}})
// LLVM: define i128 @coerce_s1(i128 %{{.+}})
