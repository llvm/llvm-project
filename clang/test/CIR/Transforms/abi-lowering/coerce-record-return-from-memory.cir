// RUN: cir-opt %s -cir-call-conv-lowering="classification-attr=test_classify" \
// RUN:   | FileCheck %s

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u24i = !cir.int<u, 24>
!b33i = !cir.int<s, 33, bitint>
!rec_Pair64 = !cir.struct<"Pair64" {data !s64i, data !s64i}>
!rec_TwoI64 = !cir.struct<"TwoI64" {data !s64i, data !s64i}>
!rec_Pair32 = !cir.struct<"Pair32" {data !s32i, data !s32i}>
!rec_Vec3 = !cir.struct<"Vec3" {data !s32i, data !s32i, data !s32i}>
!rec_Three = !cir.struct<"Three" {data !s8i, data !s8i, data !s8i}>

#ret_twoi64 = {
  return = { kind = "direct", coerced_type = !rec_TwoI64 },
  args   = [ ]
}

#ret_s64 = {
  return = { kind = "direct", coerced_type = !s64i },
  args   = [ ]
}

#ret_s64_one_arg = {
  return = { kind = "direct", coerced_type = !s64i },
  args   = [ { kind = "direct" } ]
}

#ret_twoi64_one_arg = {
  return = { kind = "direct", coerced_type = !rec_TwoI64 },
  args   = [ { kind = "direct" } ]
}

#ret_u24 = {
  return = { kind = "direct", coerced_type = !u24i },
  args   = [ ]
}

module attributes {
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>>
} {

  // The alloca is big enough for the coerced type, so it is read in place.
  cir.func @returns_pair64() -> !rec_Pair64
      attributes { test_classify = #ret_twoi64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
    %1 = cir.const #cir.zero : !rec_Pair64
    cir.store %1, %0 : !rec_Pair64, !cir.ptr<!rec_Pair64>
    %2 = cir.load %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %2 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_pair64() -> !rec_TwoI64
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VAL:.*]] = cir.const #cir.zero : !rec_Pair64
  // CHECK-NEXT:    cir.store %[[VAL]], %[[RETVAL]] : !rec_Pair64, !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

  // The read keeps the alloca's alignment when the coerced type wants more.
  cir.func @returns_pair32() -> !rec_Pair32
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!rec_Pair32>
    %1 = cir.const #cir.zero : !rec_Pair32
    cir.store %1, %0 : !rec_Pair32, !cir.ptr<!rec_Pair32>
    %2 = cir.load %0 : !cir.ptr<!rec_Pair32>, !rec_Pair32
    cir.return %2 : !rec_Pair32
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_pair32() -> !s64i
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(4) : !cir.ptr<!rec_Pair32>
  // CHECK-NEXT:    %[[VAL:.*]] = cir.const #cir.zero : !rec_Pair32
  // CHECK-NEXT:    cir.store %[[VAL]], %[[RETVAL]] : !rec_Pair32, !cir.ptr<!rec_Pair32>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair32> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(4) %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // An over-aligned alloca passes its alignment on to the read.
  cir.func @returns_pair64_align16() -> !rec_Pair64
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(16) : !cir.ptr<!rec_Pair64>
    %1 = cir.load %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %1 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_pair64_align16() -> !s64i
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(16) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(16) %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // The alloca is written after the load, so the read goes at the load.
  cir.func @returns_before_overwrite() -> !rec_Pair64
      attributes { test_classify = #ret_twoi64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
    %1 = cir.const #cir.zero : !rec_Pair64
    cir.store %1, %0 : !rec_Pair64, !cir.ptr<!rec_Pair64>
    %2 = cir.load %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    %3 = cir.const #cir.const_record<{#cir.int<1> : !s64i, #cir.int<2> : !s64i}> : !rec_Pair64
    cir.store %3, %0 : !rec_Pair64, !cir.ptr<!rec_Pair64>
    cir.return %2 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_before_overwrite() -> !rec_TwoI64
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[ZERO:.*]] = cir.const #cir.zero : !rec_Pair64
  // CHECK-NEXT:    cir.store %[[ZERO]], %[[RETVAL]] : !rec_Pair64, !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    %[[NEW:.*]] = cir.const #cir.const_record<{#cir.int<1> : !s64i, #cir.int<2> : !s64i}> : !rec_Pair64
  // CHECK-NEXT:    cir.store %[[NEW]], %[[RETVAL]] : !rec_Pair64, !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

  // The record load has another user, so it stays.
  cir.func @returns_and_stores(%arg0: !cir.ptr<!rec_Pair64>) -> !rec_Pair64
      attributes { test_classify = #ret_s64_one_arg } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
    %1 = cir.load %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.store %1, %arg0 : !rec_Pair64, !cir.ptr<!rec_Pair64>
    cir.return %1 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_and_stores(%arg0: !cir.ptr<!rec_Pair64>) -> !s64i
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    %[[REC:.*]] = cir.load %[[RETVAL]] : !cir.ptr<!rec_Pair64>, !rec_Pair64
  // CHECK-NEXT:    cir.store %[[REC]], %arg0 : !rec_Pair64, !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // Each return gets its own read at the shared load, which then goes away.
  cir.func @returns_twice(%arg0: !cir.bool) -> !rec_Pair64
      attributes { test_classify = #ret_s64_one_arg } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
    %1 = cir.load %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.brcond %arg0 ^bb1, ^bb2
  ^bb1:
    cir.return %1 : !rec_Pair64
  ^bb2:
    cir.return %1 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_twice(%arg0: !cir.bool) -> !s64i
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW1:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED1:.*]] = cir.load align(8) %[[VIEW1]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    %[[VIEW2:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED2:.*]] = cir.load align(8) %[[VIEW2]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.brcond %arg0 ^bb1, ^bb2
  // CHECK:       ^bb1:
  // CHECK-NEXT:    cir.return %[[COERCED1]] : !s64i
  // CHECK:       ^bb2:
  // CHECK-NEXT:    cir.return %[[COERCED2]] : !s64i

  // A load that reaches its alloca through a bitcast is still read in place.
  cir.func @returns_through_bitcast() -> !rec_Pair64
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "buf" align(8) : !cir.ptr<!cir.array<!s64i x 2>>
    %1 = cir.cast bitcast %0 : !cir.ptr<!cir.array<!s64i x 2>> -> !cir.ptr<!rec_Pair64>
    %2 = cir.load %1 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %2 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_through_bitcast() -> !s64i
  // CHECK-NEXT:    %[[BUF:.*]] = cir.alloca "buf" align(8) : !cir.ptr<!cir.array<!s64i x 2>>
  // CHECK-NEXT:    %[[REC_PTR:.*]] = cir.cast bitcast %[[BUF]] : !cir.ptr<!cir.array<!s64i x 2>> -> !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[REC_PTR]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // The view stays in the alloca's address space.
  cir.func @returns_from_addrspace() -> !rec_Pair64
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64, target_address_space(5)>
    %1 = cir.load %0 : !cir.ptr<!rec_Pair64, target_address_space(5)>, !rec_Pair64
    cir.return %1 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_from_addrspace() -> !s64i
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64, target_address_space(5)>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[RETVAL]] : !cir.ptr<!rec_Pair64, target_address_space(5)> -> !cir.ptr<!s64i, target_address_space(5)>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!s64i, target_address_space(5)>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // Through an address space cast the load is still read in place.
  cir.func @returns_through_addrspace_cast() -> !rec_Pair64
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64, target_address_space(5)>
    %1 = cir.cast address_space %0 : !cir.ptr<!rec_Pair64, target_address_space(5)> -> !cir.ptr<!rec_Pair64>
    %2 = cir.load %1 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %2 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_through_addrspace_cast() -> !s64i
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64, target_address_space(5)>
  // CHECK-NEXT:    %[[GENERIC:.*]] = cir.cast address_space %[[RETVAL]] : !cir.ptr<!rec_Pair64, target_address_space(5)> -> !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[GENERIC]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // A 16-byte read does not fit the 12-byte record, so its bytes are copied.
  cir.func @returns_vec3() -> !rec_Vec3
      attributes { test_classify = #ret_twoi64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Vec3>
    %1 = cir.load %0 : !cir.ptr<!rec_Vec3>, !rec_Vec3
    cir.return %1 : !rec_Vec3
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_vec3() -> !rec_TwoI64
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[SLOT_REC:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_TwoI64> -> !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    cir.copy %[[RETVAL]] align(8) to %[[SLOT_REC]] align(8) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[SLOT]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

  // The alloca is written after the load, so the copy goes at the load.
  cir.func @returns_vec3_before_overwrite() -> !rec_Vec3
      attributes { test_classify = #ret_twoi64 } {
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!rec_Vec3>
    %1 = cir.load %0 : !cir.ptr<!rec_Vec3>, !rec_Vec3
    %2 = cir.const #cir.zero : !rec_Vec3
    cir.store %2, %0 : !rec_Vec3, !cir.ptr<!rec_Vec3>
    cir.return %1 : !rec_Vec3
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_vec3_before_overwrite() -> !rec_TwoI64
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(4) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[SLOT_REC:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_TwoI64> -> !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    cir.copy %[[RETVAL]] align(4) to %[[SLOT_REC]] align(8) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[SLOT]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    %[[ZERO:.*]] = cir.const #cir.zero : !rec_Vec3
  // CHECK-NEXT:    cir.store %[[ZERO]], %[[RETVAL]] : !rec_Vec3, !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

  // The coercion slot is raised to the alignment of the storage copied from.
  cir.func @returns_vec3_overaligned() -> !rec_Vec3
      attributes { test_classify = #ret_twoi64 } {
    %0 = cir.alloca "__retval" align(32) : !cir.ptr<!rec_Vec3>
    %1 = cir.load %0 : !cir.ptr<!rec_Vec3>, !rec_Vec3
    cir.return %1 : !rec_Vec3
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_vec3_overaligned() -> !rec_TwoI64
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(32) : !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(32) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[SLOT_REC:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_TwoI64> -> !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    cir.copy %[[RETVAL]] align(32) to %[[SLOT_REC]] align(32) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(32) %[[SLOT]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

  // The bytes are copied from the alloca's address space into a default one.
  cir.func @returns_vec3_from_addrspace() -> !rec_Vec3
      attributes { test_classify = #ret_twoi64 } {
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!rec_Vec3, target_address_space(5)>
    %1 = cir.load %0 : !cir.ptr<!rec_Vec3, target_address_space(5)>, !rec_Vec3
    cir.return %1 : !rec_Vec3
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_vec3_from_addrspace() -> !rec_TwoI64
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(4) : !cir.ptr<!rec_Vec3, target_address_space(5)>
  // CHECK-NEXT:    %[[SLOT_REC:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_TwoI64> -> !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    cir.copy %[[RETVAL]] align(4) to %[[SLOT_REC]] align(8) : !cir.ptr<!rec_Vec3, target_address_space(5)>, !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[SLOT]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

  // A u24's 4-byte alloc size exceeds the 3-byte record, so it is copied.
  cir.func @returns_three() -> !rec_Three
      attributes { test_classify = #ret_u24 } {
    %0 = cir.alloca "__retval" align(1) : !cir.ptr<!rec_Three>
    %1 = cir.load %0 : !cir.ptr<!rec_Three>, !rec_Three
    cir.return %1 : !rec_Three
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_three() -> !cir.int<u, 24>
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(4) : !cir.ptr<!rec_Three>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(1) : !cir.ptr<!rec_Three>
  // CHECK-NEXT:    cir.copy %[[RETVAL]] align(1) to %[[SLOT]] align(4) : !cir.ptr<!rec_Three>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_Three> -> !cir.ptr<!cir.int<u, 24>>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(4) %[[VIEW]] : !cir.ptr<!cir.int<u, 24>>, !cir.int<u, 24>
  // CHECK-NEXT:    cir.return %[[COERCED]] : !cir.int<u, 24>

  // A _BitInt is not a record, so its value is stored into the slot.
  cir.func @returns_bitint() -> !b33i
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!b33i>
    %1 = cir.load %0 : !cir.ptr<!b33i>, !b33i
    cir.return %1 : !b33i
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_bitint() -> !s64i
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!cir.int<s, 33, bitint>>
  // CHECK-NEXT:    %[[VAL:.*]] = cir.load %[[RETVAL]] : !cir.ptr<!cir.int<s, 33, bitint>>, !cir.int<s, 33, bitint>
  // CHECK-NEXT:    %[[SLOT_VAL:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!s64i> -> !cir.ptr<!cir.int<s, 33, bitint>>
  // CHECK-NEXT:    cir.store %[[VAL]], %[[SLOT_VAL]] : !cir.int<s, 33, bitint>, !cir.ptr<!cir.int<s, 33, bitint>>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load %[[SLOT]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // A volatile load happens as written, so its value is stored into the slot.
  cir.func @returns_volatile() -> !rec_Pair64
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
    %1 = cir.load volatile %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %1 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_volatile() -> !s64i
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[REC:.*]] = cir.load volatile %[[RETVAL]] : !cir.ptr<!rec_Pair64>, !rec_Pair64
  // CHECK-NEXT:    cir.store %[[REC]], %[[SLOT]] : !rec_Pair64, !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // An atomic load has to happen as written too.
  cir.func @returns_atomic() -> !rec_Pair64
      attributes { test_classify = #ret_s64 } {
    %0 = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
    %1 = cir.load atomic(seq_cst) %0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %1 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_atomic() -> !s64i
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[RETVAL:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[REC:.*]] = cir.load atomic(seq_cst) %[[RETVAL]] : !cir.ptr<!rec_Pair64>, !rec_Pair64
  // CHECK-NEXT:    cir.store %[[REC]], %[[SLOT]] : !rec_Pair64, !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // A record read through a non-alloca pointer has its bytes copied.
  cir.func @returns_from_pointer(%arg0: !cir.ptr<!rec_Pair64>) -> !rec_Pair64
      attributes { test_classify = #ret_s64_one_arg } {
    %0 = cir.load %arg0 : !cir.ptr<!rec_Pair64>, !rec_Pair64
    cir.return %0 : !rec_Pair64
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_from_pointer(%arg0: !cir.ptr<!rec_Pair64>) -> !s64i
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    cir.copy %arg0 align(8) to %[[SLOT]] align(8) : !cir.ptr<!rec_Pair64>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_Pair64> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    cir.return %[[COERCED]] : !s64i

  // Without an alloca, the slot takes the alignment the record load carries.
  cir.func @returns_vec3_from_aligned_pointer(%arg0: !cir.ptr<!rec_Vec3>) -> !rec_Vec3
      attributes { test_classify = #ret_twoi64_one_arg } {
    %0 = cir.load align(32) %arg0 : !cir.ptr<!rec_Vec3>, !rec_Vec3
    cir.return %0 : !rec_Vec3
  }

  // CHECK-LABEL: cir.func{{.*}} @returns_vec3_from_aligned_pointer(%arg0: !cir.ptr<!rec_Vec3>) -> !rec_TwoI64
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(32) : !cir.ptr<!rec_TwoI64>
  // CHECK-NEXT:    %[[SLOT_REC:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_TwoI64> -> !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    cir.copy %arg0 align(32) to %[[SLOT_REC]] align(32) : !cir.ptr<!rec_Vec3>
  // CHECK-NEXT:    %[[COERCED:.*]] = cir.load align(32) %[[SLOT]] : !cir.ptr<!rec_TwoI64>, !rec_TwoI64
  // CHECK-NEXT:    cir.return %[[COERCED]] : !rec_TwoI64

}
