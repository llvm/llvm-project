// RUN: not cir-opt %s -cir-call-conv-lowering=target=x86_64 2>&1 | FileCheck %s

!s8i = !cir.int<s, 8>
!s16i = !cir.int<s, 16>
!s32i = !cir.int<s, 32>
!u8i = !cir.int<u, 8>
!rec_UEmptyLarge = !cir.union<"UEmptyLarge" {}, padding = {!cir.array<!u8i x 32>}>
!rec_ZeroLenArr = !cir.struct<"ZeroLenArr" packed {data !s8i, empty !cir.array<!s32i x 0>}>
!rec_E = !cir.struct<"E" {pad !u8i}>
!rec_UBitIntUnit =
    !cir.union<"UBitIntUnit" {bitfield !cir.bitfield<!cir.array<!u8i x 9>,
                                                     [#cir.bitfield_decl<!cir.int<s, 72, bitint>, 70>]>},
               padding = {!cir.array<!u8i x 7>}>
!rec_SVec = !cir.struct<"SVec" {data !cir.vector<4 x !cir.float>}>
!rec_SX87 = !cir.struct<"SX87" {data !cir.vector<1 x !cir.long_double<!cir.f80>>}>
!rec_UX87Bytes =
    !cir.union<"UX87Bytes" {data !cir.vector<1 x !cir.long_double<!cir.f80>>,
                            data !cir.array<!u8i x 16>}>
!rec_UX87InRec =
    !cir.union<"UX87InRec" {data !rec_SX87, data !cir.array<!u8i x 16>}>
!rec_UX87InArr =
    !cir.union<"UX87InArr" {data !cir.array<!cir.vector<1 x !cir.long_double<!cir.f80>> x 1>,
                            data !cir.array<!u8i x 16>}>
!rec_SUX87 = !cir.struct<"SUX87" {data !rec_UX87Bytes}>
!rec_UX87Twice =
    !cir.union<"UX87Twice" {data !cir.vector<1 x !cir.long_double<!cir.f80>>,
                            data !cir.vector<1 x !cir.long_double<!cir.f80>>}>
!rec_UX87Scalar =
    !cir.union<"UX87Scalar" {data !cir.long_double<!cir.f80>,
                             data !cir.array<!u8i x 11>}>
!rec_SLongDouble = !cir.struct<"SLongDouble" {data !cir.long_double<!cir.f80>}>
!rec_UX87Nested =
    !cir.union<"UX87Nested" {data !rec_SLongDouble, data !cir.array<!u8i x 4>}>
!rec_UEmptyX87 =
    !cir.union<"UEmptyX87" {data !s32i,
                            empty !cir.array<!cir.long_double<!cir.f80> x 0>},
               padding = {!cir.array<!u8i x 16>}>
!rec_UX87Displaced =
    !cir.union<"UX87Displaced" {data !rec_UEmptyX87,
                                data !cir.long_double<!cir.f80>}>
!rec_UX87Complex =
    !cir.union<"UX87Complex" {data !cir.complex<!cir.long_double<!cir.f80>>,
                              data !cir.array<!u8i x 32>}>
!rec_UVec384 =
    !cir.union<"UVec384" {data !cir.vector<4 x !cir.float>, data !cir.array<!s8i x 33>},
               padding = {!cir.array<!u8i x 32>}>
!rec_UVec3x384 =
    !cir.union<"UVec3x384" {data !cir.vector<3 x !cir.float>, data !cir.array<!s8i x 33>},
               padding = {!cir.array<!u8i x 36>}>
!rec_UVecInArr =
    !cir.union<"UVecInArr" {data !cir.array<!cir.vector<4 x !cir.float> x 2>,
                            data !cir.array<!s8i x 33>},
               padding = {!cir.array<!u8i x 16>}>
!rec_UVecInRec =
    !cir.union<"UVecInRec" {data !rec_SVec, data !cir.array<!s8i x 33>},
               padding = {!cir.array<!u8i x 32>}>
!rec_UQuad384 =
    !cir.union<"UQuad384" {data !cir.f128, data !cir.array<!s8i x 33>},
               padding = {!cir.array<!u8i x 32>}>
!rec_ULongDouble384 =
    !cir.union<"ULongDouble384" {data !cir.long_double<!cir.f128>,
                                 data !cir.array<!s8i x 33>},
               padding = {!cir.array<!u8i x 32>}>
!rec_UQuadPacked =
    !cir.union<"UQuadPacked" packed {data !cir.f128, data !cir.array<!s8i x 17>},
               padding = {!u8i}>
!rec_S1 = !cir.struct<"S1" {data !s16i, data !s16i, data !s16i}>
!rec_AtomicWrapper = !cir.struct<{data !rec_S1, pad !cir.array<!s8i x 2>}>
!rec_HoldsAllPad = !cir.struct<"HoldsAllPad" {data !s32i, empty !rec_E}>
!rec_Incomplete = !cir.struct<"Incomplete" incomplete>

module attributes {
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>,
    #dlti.dl_entry<f32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<f64, dense<64>: vector<2xi64>>>
} {





  // A member-less union past two eightbytes still classifies Indirect in
  // classic CodeGen, but no source spells a union with no member at all, so
  // this bridge refuses the shape rather than guessing at it.  Below the
  // threshold the same shape is accepted and classifies Ignore, matching
  // classic; see x86_64-union.cir take_empty.
  cir.func @take_empty_large_union(%arg0: !rec_UEmptyLarge) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UEmptyLarge"

  // A zero-sized member is dropped before classification, so its offset never
  // reaches the rule sending a record with a member off its own alignment to
  // memory.  Only packing can put one at such an offset.
  cir.func @take_zero_len_arr(%arg0: !rec_ZeroLenArr) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.struct<"ZeroLenArr" packed



  // Past one eightbyte the declared extent settles nothing: the coercion
  // follows this 9-byte unit and would give i8 for the second eightbyte,
  // where classic sizes it from the record and gives i64.
  cir.func @take_bitint_unit_union(%arg0: !rec_UBitIntUnit) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UBitIntUnit"







  // 48 bytes with a vector member, a size no SSEUP coerce can be named from.
  cir.func @take_vec384_union(%arg0: !rec_UVec384) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UVec384"

  // A three-float vector is 96 bits in CIR but classifies at 128, so it
  // reaches SSEUP too.
  cir.func @take_vec3_384_union(%arg0: !rec_UVec3x384) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UVec3x384"

  // The same vector, an array away.
  cir.func @take_vec_in_arr_union(%arg0: !rec_UVecInArr) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UVecInArr"

  // The same vector, a record away.
  cir.func @take_vec_in_rec_union(%arg0: !rec_UVecInRec) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UVecInRec"

  // An IEEE-quad float reaches SSEUP as well.
  cir.func @take_quad384_union(%arg0: !rec_UQuad384) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UQuad384"

  // A long double carrying quad semantics is the same float.
  cir.func @take_long_double384_union(%arg0: !rec_ULongDouble384) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"ULongDouble384"

  // Packed, so 17 bytes, another size no coerce can be named from.  Its
  // 17-byte member spans the union, so only refusing the size catches it.
  cir.func @take_quad_packed_union(%arg0: !rec_UQuadPacked) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UQuadPacked"

  // A bit-field carries the type its declaration named, so a record whose
  // padding a coercion would have to read through is classified rather than
  // refused; see x86_64-bitfield.cir.

  // The all-pad reject also has to hold when the record is reached as a member,
  // which is the shape a C++ empty class produces.
  cir.func @take_holds_all_pad(%arg0: !rec_HoldsAllPad) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.struct<"HoldsAllPad" {data

  // A scalable vector has no size the eightbyte rules can read.
  cir.func @take_scalable(%arg0: !cir.vector<[4] x !cir.float>) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.vector<[4] x !cir.float>

  // A _BitInt element narrower than a byte has no memory representation in
  // CIR's lowering to LLVM, so this is rejected here rather than failing
  // there.
  cir.func @take_sub_byte_element(%arg0: !cir.vector<16 x !cir.int<s, 2, bitint>>) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.vector<16 x !cir.int<s, 2, bitint>>

  // A union is moved as a value of its storage type, so a member holding data
  // past the 10 bytes an x87 double extended value stores would lose it.  A
  // member reaching byte 11 is refused next to one, and so is a double
  // extended value held any other way, in a record, a _Complex, a vector or an
  // array, even next to one of the same type.  A record holding such a union
  // is refused with it.
  cir.func @take_union_x87_scalar(%arg0: !rec_UX87Scalar) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87Scalar"

  cir.func @take_union_x87_nested(%arg0: !rec_UX87Nested) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87Nested"

  // A member that ties the double extended member on alignment and size,
  // listed first, becomes the storage type in its place, so the union is
  // refused even though that member's data ends within the 10 bytes.
  cir.func @take_union_x87_displaced(%arg0: !rec_UX87Displaced) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87Displaced"

  cir.func @take_union_x87_complex(%arg0: !rec_UX87Complex) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87Complex"

  cir.func @take_union_x87_twice(%arg0: !rec_UX87Twice) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87Twice"

  cir.func @take_union_x87_bytes(%arg0: !rec_UX87Bytes) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87Bytes"

  cir.func @take_union_x87_in_rec(%arg0: !rec_UX87InRec) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87InRec"

  cir.func @take_union_x87_in_arr(%arg0: !rec_UX87InArr) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.union<"UX87InArr"

  cir.func @take_struct_union_x87(%arg0: !rec_SUX87) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.struct<"SUX87"

  // A definition (unlike a declaration) is refused: no incomplete-by-value
  // definition can arise from valid C++, so this stays a hard reject rather
  // than the declaration-only skip in x86_64-incomplete-record-declaration.cir.
  cir.func @take_incomplete_defined(%arg0: !rec_Incomplete) {
    cir.return
  }

  // CHECK: not yet implemented for type '!cir.struct<"Incomplete" incomplete>'
}
