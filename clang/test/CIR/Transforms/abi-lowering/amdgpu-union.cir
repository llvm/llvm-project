  // CHECK-NEXT:   cir.call @two(%[[A_ARG0]], %[[A_ARG1]], %[[ONE]], %[[B_ARG0]], %[[B_ARG1]]) : (!cir.double, !cir.array<!u8i x 8>, !s32i, !cir.double, !cir.array<!u8i x 8>) -> ()
