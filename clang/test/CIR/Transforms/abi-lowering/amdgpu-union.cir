  // CHECK-NEXT:   %[[A_COERCE:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<![[FLAT]], target_address_space(5)>
  // CHECK-NEXT:   %[[A_F0:.*]] = cir.get_member %[[A_COERCE]][0] {name = ""} : !cir.ptr<![[FLAT]], target_address_space(5)> -> !cir.ptr<!cir.double, target_address_space(5)>
  // CHECK-NEXT:   cir.store %[[A_STORAGE]], %[[A_F0]] : !cir.double, !cir.ptr<!cir.double, target_address_space(5)>
  // CHECK-NEXT:   %[[A_F1:.*]] = cir.get_member %[[A_COERCE]][1] {name = ""} : !cir.ptr<![[FLAT]], target_address_space(5)> -> !cir.ptr<!cir.array<!u8i x 8>, target_address_space(5)>
  // CHECK-NEXT:   cir.store %[[A_PAD]], %[[A_F1]] : !cir.array<!u8i x 8>, !cir.ptr<!cir.array<!u8i x 8>, target_address_space(5)>
  // CHECK-NEXT:   %[[A_UNION:.*]] = cir.cast bitcast %[[A_COERCE]] : !cir.ptr<![[FLAT]], target_address_space(5)> -> !cir.ptr<!rec_u_pad_t, target_address_space(5)>
  // CHECK-NEXT:   %[[A:.*]] = cir.alloca "a" align(8) init : !cir.ptr<!rec_u_pad_t, target_address_space(5)>
  // CHECK-NEXT:   %[[B:.*]] = cir.alloca "b" align(8) init : !cir.ptr<!rec_u_pad_t, target_address_space(5)>
  // CHECK-NEXT:   cir.copy %[[A_UNION]] align(8) to %[[A]] align(8) : !cir.ptr<!rec_u_pad_t, target_address_space(5)>
  // CHECK-NEXT:   cir.copy %[[B_UNION]] align(8) to %[[B]] align(8) : !cir.ptr<!rec_u_pad_t, target_address_space(5)>
  // CHECK-NEXT:   %[[A_FLAT:.*]] = cir.cast bitcast %[[A]] : !cir.ptr<!rec_u_pad_t, target_address_space(5)> -> !cir.ptr<![[FLAT]], target_address_space(5)>
  // CHECK-NEXT:   %[[A_P0:.*]] = cir.get_member %[[A_FLAT]][0] {name = ""} : !cir.ptr<![[FLAT]], target_address_space(5)> -> !cir.ptr<!cir.double, target_address_space(5)>
  // CHECK-NEXT:   %[[A_ARG0:.*]] = cir.load align(8) %[[A_P0]] : !cir.ptr<!cir.double, target_address_space(5)>, !cir.double
  // CHECK-NEXT:   %[[A_P1:.*]] = cir.get_member %[[A_FLAT]][1] {name = ""} : !cir.ptr<![[FLAT]], target_address_space(5)> -> !cir.ptr<!cir.array<!u8i x 8>, target_address_space(5)>
  // CHECK-NEXT:   %[[A_ARG1:.*]] = cir.load align(8) %[[A_P1]] : !cir.ptr<!cir.array<!u8i x 8>, target_address_space(5)>, !cir.array<!u8i x 8>
  // CHECK-NEXT:   %[[ONE:.*]] = cir.const #cir.int<1> : !s32i
  // CHECK-NEXT:   %[[B_FLAT:.*]] = cir.cast bitcast %[[B]] : !cir.ptr<!rec_u_pad_t, target_address_space(5)> -> !cir.ptr<![[FLAT]], target_address_space(5)>
