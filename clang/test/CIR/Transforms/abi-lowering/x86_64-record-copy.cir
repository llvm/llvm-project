  // CHECK-LABEL: cir.func @sret_nodom_tpmem(%arg0: !cir.ptr<!cir.ptr<!rec_TPMem>>)
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(8) : !cir.ptr<!rec_TPMem>
  // CHECK-NEXT:    cir.call @make_tpmem(%[[SRET]]) : (!cir.ptr<!rec_TPMem> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.sret = !rec_TPMem, llvm.writable}) -> ()
  // CHECK-NEXT:    %[[DEST:.*]] = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_TPMem>>, !cir.ptr<!rec_TPMem>
  // CHECK-NEXT:    cir.copy %[[SRET]] align(8) to %[[DEST]] align(8) skip_tail_padding : !cir.ptr<!rec_TPMem>
  // CHECK-NEXT:    cir.return

  // A record with a layout gap but no pad member has no tail padding, so the
  // copy through a pointer takes the whole record.
  cir.func @sf_store_ptr(%arg0: !cir.ptr<!rec_SF>) {
    %0 = cir.call @make_sf() : () -> !rec_SF
    cir.store %0, %arg0 : !rec_SF, !cir.ptr<!rec_SF>
    cir.return
  }

  // CHECK-LABEL: cir.func @sf_store_ptr(%arg0: !cir.ptr<!rec_SF>)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<![[SFPAIR]]>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_sf() : () -> ![[SFPAIR]]
  // CHECK-NEXT:    cir.store %[[RES]], %[[SLOT]] : ![[SFPAIR]], !cir.ptr<![[SFPAIR]]>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!rec_SF>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %arg0 align(8) : !cir.ptr<!rec_SF>
  // CHECK-NEXT:    cir.return

  cir.func @tp_param_store_ptr(%arg0: !rec_TP, %arg1: !cir.ptr<!rec_TP>) {
    cir.store %arg0, %arg1 : !rec_TP, !cir.ptr<!rec_TP>
    cir.return
  }

  // CHECK-LABEL: cir.func @tp_param_store_ptr(%arg0: !u64i, %arg1: !cir.ptr<!rec_TP>)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_TP>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %arg1 align(4) skip_tail_padding : !cir.ptr<!rec_TP>
  // CHECK-NEXT:    cir.return

  // The copy that replaces a byval parameter's only store keeps the store's
  // alignment.
  cir.func @byval_tpmem_ptr(%arg0: !rec_TPMem, %arg1: !cir.ptr<!rec_TPMem>) {
    cir.store align(1) %arg0, %arg1 : !rec_TPMem, !cir.ptr<!rec_TPMem>
    cir.return
