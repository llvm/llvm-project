  // CHECK-NEXT:    %[[BYVAL:.*]] = cir.alloca "byval" align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.copy %[[ADDR2]] align(16) to %[[BYVAL]] align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.call @take_x87mem(%[[BYVAL]])
  // CHECK-NEXT:    cir.return

  // The producer is rewritten before the consumer, so the consumer reads the
