  // CHECK-NEXT:    %[[HI:.*]] = cir.load %[[HIP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_x87(%[[LO]], %[[HI]]) : (!u64i, !u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @vaarg_h(%arg0: !s32i, ...) {
    %0 = cir.alloca "ap" align(16) : !cir.ptr<!cir.array<!rec___va_list_tag x 1>>
    %1 = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
    %2 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!rec___va_list_tag x 1>> -> !cir.ptr<!rec___va_list_tag>
    %3 = cir.va_arg %2 : (!cir.ptr<!rec___va_list_tag>) -> !rec_H
