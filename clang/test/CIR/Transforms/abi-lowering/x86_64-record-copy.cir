  // A memory-class fetch reads the overflow area.  The second one feeds a
  // byval slot, filled by a copy.
  cir.func @vaarg_x87mem(%arg0: !s32i, ...) {
    %0 = cir.alloca "ap" align(16) : !cir.ptr<!cir.array<!rec___va_list_tag x 1>>
    %1 = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87Mem>
