  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>>
} {
  cir.func private @make_h() -> !rec_H

  // A call result consumed by anything but a store, call, return or member
  // read would be loaded from its slot as a value.
  cir.func @result_yield_h(%arg0: !cir.bool, %arg1: !cir.ptr<!rec_H>) {
    %0 = cir.call @make_h() : () -> !rec_H
    %1 = cir.ternary(%arg0, true {
      // expected-error @below {{use of a record argument or result other than by a store, call, return or member read not yet implemented in CallConvLowering}}
      cir.yield %0 : !rec_H
    }, false {
      %2 = cir.load %arg1 : !cir.ptr<!rec_H>, !rec_H
      cir.yield %2 : !rec_H
    }) : (!cir.bool) -> !rec_H
    cir.store %1, %arg1 : !rec_H, !cir.ptr<!rec_H>
    cir.return
  }
