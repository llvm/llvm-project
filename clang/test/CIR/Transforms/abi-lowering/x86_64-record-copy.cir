  // A result whose destination is loaded after the call is copied out of a
  // return slot of its own.
  cir.func @sret_nodom_x87mem(%arg0: !cir.ptr<!cir.ptr<!rec_UX87Mem>>) {
    %0 = cir.call @make_x87mem() : () -> !rec_UX87Mem
    %1 = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_UX87Mem>>, !cir.ptr<!rec_UX87Mem>
    cir.store %0, %1 : !rec_UX87Mem, !cir.ptr<!rec_UX87Mem>
    cir.return
  }

  // CHECK-LABEL: cir.func @sret_nodom_x87mem(%arg0: !cir.ptr<!cir.ptr<!rec_UX87Mem>>)
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.call @make_x87mem(%[[SRET]]) : (!cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.dead_on_unwind, llvm.sret = !rec_UX87Mem, llvm.writable}) -> ()
  // CHECK-NEXT:    %[[DEST:.*]] = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_UX87Mem>>, !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.copy %[[SRET]] align(16) to %[[DEST]] align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.return

  cir.func @sret_nodom_hmem(%arg0: !cir.ptr<!cir.ptr<!rec_HMem>>) {
    %0 = cir.call @make_hmem() : () -> !rec_HMem
    %1 = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_HMem>>, !cir.ptr<!rec_HMem>
    cir.store %0, %1 : !rec_HMem, !cir.ptr<!rec_HMem>
    cir.return
  }

  // CHECK-LABEL: cir.func @sret_nodom_hmem(%arg0: !cir.ptr<!cir.ptr<!rec_HMem>>)
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.call @make_hmem(%[[SRET]]) : (!cir.ptr<!rec_HMem> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.sret = !rec_HMem, llvm.writable}) -> ()
  // CHECK-NEXT:    %[[DEST:.*]] = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_HMem>>, !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.copy %[[SRET]] align(8) to %[[DEST]] align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.return

  cir.func @sret_nodom_smem(%arg0: !cir.ptr<!cir.ptr<!rec_SMem>>) {
    %0 = cir.call @make_smem() : () -> !rec_SMem
    %1 = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_SMem>>, !cir.ptr<!rec_SMem>
    cir.store %0, %1 : !rec_SMem, !cir.ptr<!rec_SMem>
    cir.return
