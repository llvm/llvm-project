  // CHECK-LABEL: cir.func @param_forward_late_h(%arg0: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[AVIEW:.*]] = cir.cast bitcast %[[VIEW]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[V:.*]] = cir.load align(8) %[[AVIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_late_h(%[[V]]) : (!u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @result_feed_late_x87() {
    %0 = cir.call @make_x87() : () -> !rec_UX87
    cir.call @take_late_x87(%0) : (!rec_UX87) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @result_feed_late_x87()
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_x87() : () -> ![[PAIR]]
  // CHECK-NEXT:    cir.store %[[RES]], %[[SLOT]] : ![[PAIR]], !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<![[PAIR]]> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[AVIEW:.*]] = cir.cast bitcast %[[VIEW]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[AVIEW]][0] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[LO:.*]] = cir.load align(16) %[[LOP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[AVIEW]][1] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[HI:.*]] = cir.load align(8) %[[HIP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_late_x87(%[[LO]], %[[HI]]) : (!u64i, !u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @result_feed_late_h() {
    %0 = cir.call @make_h() : () -> !rec_H
    cir.call @take_late_h(%0) : (!rec_H) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @result_feed_late_h()
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_h() : () -> !u64i
  // CHECK-NEXT:    cir.store %[[RES]], %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[AVIEW:.*]] = cir.cast bitcast %[[VIEW]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[V:.*]] = cir.load align(8) %[[AVIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_late_h(%[[V]]) : (!u64i) -> ()
  // CHECK-NEXT:    cir.return

  // The sret slot is handed on as the byval argument.
  cir.func @byval_result_late_x87mem() {
    %0 = cir.call @make_x87mem() : () -> !rec_UX87Mem
    cir.call @take_late_x87mem(%0) : (!rec_UX87Mem) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @byval_result_late_x87mem()
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.call @make_x87mem(%[[SRET]])
  // CHECK-NEXT:    cir.call @take_late_x87mem(%[[SRET]]) : (!cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.byval = !rec_UX87Mem, llvm.noundef}) -> ()
  // CHECK-NEXT:    cir.return

  // The definition is rewritten before the producer, so the return stores
  // the result into a slot and the producer's rewrite turns that store into
  // a copy.
  cir.func @result_return_late_x87() -> !rec_UX87 {
    %0 = cir.call @make_late_x87() : () -> !rec_UX87
    cir.return %0 : !rec_UX87
  }

  cir.func @result_return_late_h() -> !rec_H {
    %0 = cir.call @make_late_h() : () -> !rec_H
    cir.return %0 : !rec_H
  }

  cir.func private @take_late_x87(!rec_UX87)
  cir.func private @take_late_h(!rec_H)
  cir.func private @take_late_x87mem(!rec_UX87Mem)
  cir.func private @make_late_x87() -> !rec_UX87
  cir.func private @make_late_h() -> !rec_H

  // CHECK-LABEL: cir.func @result_return_late_x87()
  // CHECK-SAME:    -> ![[PAIR]]
  // CHECK-NEXT:    %[[RSLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_late_x87() : () -> ![[PAIR]]
  // CHECK-NEXT:    cir.store %[[RES]], %[[RSLOT]] : ![[PAIR]], !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[RSLOT]] : !cir.ptr<![[PAIR]]> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[RVIEW]] align(16) to %[[SLOT]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load %[[VIEW]] : !cir.ptr<![[PAIR]]>, ![[PAIR]]
  // CHECK-NEXT:    cir.return %[[RET]] : ![[PAIR]]

  // CHECK-LABEL: cir.func @result_return_late_h() -> !u64i
  // CHECK-NEXT:    %[[RSLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_late_h() : () -> !u64i
  // CHECK-NEXT:    cir.store %[[RES]], %[[RSLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[RSLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    cir.copy %[[RVIEW]] align(8) to %[[SLOT]] align(4) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load %[[VIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.return %[[RET]] : !u64i

  // CHECK: cir.func private @take_late_x87(!u64i, !u64i)
  // CHECK: cir.func private @take_late_h(!u64i)
  // CHECK: cir.func private @take_late_x87mem(!cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.byval = !rec_UX87Mem, llvm.noundef})
  // CHECK: cir.func private @make_late_x87() -> ![[PAIR]]
  // CHECK: cir.func private @make_late_h() -> !u64i

  // A constant carries no bytes beyond its own value, so it is still stored
  // into the argument slot by value.
  cir.func @const_feed_x87() {
    %0 = cir.const #cir.zero : !rec_UX87
    cir.call @take_x87(%0) : (!rec_UX87) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @const_feed_x87()
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[C:.*]] = cir.const #cir.zero : !rec_UX87
  // CHECK-NEXT:    cir.store %[[C]], %[[SLOT]] : !rec_UX87, !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK:         cir.call @take_x87(%{{.*}}, %{{.*}}) : (!u64i, !u64i) -> ()
  // MOVE:          cir.store %{{.*}}, %{{.*}} : !rec_UX87, !cir.ptr<!rec_UX87>

  cir.func @const_feed_h() {
    %0 = cir.const #cir.zero : !rec_H
    cir.call @take_h(%0) : (!rec_H) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @const_feed_h()
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[C:.*]] = cir.const #cir.zero : !rec_H
  // CHECK-NEXT:    cir.store %[[C]], %[[SLOT]] : !rec_H, !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[V:.*]] = cir.load %[[VIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_h(%[[V]]) : (!u64i) -> ()
  // MOVE-LABEL:    cir.func @const_feed_h()
  // MOVE:          cir.store %{{.*}}, %{{.*}} : !rec_H, !cir.ptr<!rec_H>

  cir.func @const_feed_hmem() {
    %0 = cir.const #cir.zero : !rec_HMem
    cir.call @take_hmem(%0) : (!rec_HMem) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @const_feed_hmem()
  // CHECK-NEXT:    %[[C:.*]] = cir.const #cir.zero : !rec_HMem
  // CHECK-NEXT:    %[[BYVAL:.*]] = cir.alloca "byval" align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.store %[[C]], %[[BYVAL]] : !rec_HMem, !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.call @take_hmem(%[[BYVAL]])
  // MOVE-LABEL:    cir.func @const_feed_hmem()
  // MOVE:          cir.store %{{.*}}, %{{.*}} : !rec_HMem, !cir.ptr<!rec_HMem>

  // A member read reads the record back out of the result slot.
  cir.func @result_extract_s() -> !s32i {
    %0 = cir.call @make_s() : () -> !rec_S
    %1 = cir.extract_member %0[1] : !rec_S -> !s32i
    cir.return %1 : !s32i
  }

  // CHECK-LABEL: cir.func @result_extract_s() -> !s32i
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_s() : () -> !u64i
  // CHECK-NEXT:    cir.store %[[RES]], %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_S>
  // CHECK-NEXT:    %[[REC:.*]] = cir.load align(8) %[[VIEW]] : !cir.ptr<!rec_S>, !rec_S
  // CHECK-NEXT:    %[[FIELD:.*]] = cir.extract_member %[[REC]][1] : !rec_S -> !s32i
  // CHECK-NEXT:    cir.return %[[FIELD]] : !s32i
  // MOVE-LABEL:    cir.func @result_extract_s()
  // MOVE:          cir.load align(8) %{{.*}} : !cir.ptr<!rec_S>, !rec_S
}

