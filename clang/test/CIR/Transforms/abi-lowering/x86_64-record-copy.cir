  // CHECK-NEXT:    %[[LO:.*]] = cir.load align(16) %[[LOP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[AVIEW]][1] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[HI:.*]] = cir.load align(8) %[[HIP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_late_x87(%[[LO]], %[[HI]]) : (!u64i, !u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @param_forward_late_h(%arg0: !rec_H) {
    cir.call @take_late_h(%arg0) : (!rec_H) -> ()
    cir.return
