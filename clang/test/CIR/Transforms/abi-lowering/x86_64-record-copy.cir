  // CHECK-LABEL: cir.func @sret_nodom_smem(%arg0: !cir.ptr<!cir.ptr<!rec_SMem>>)
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(8) : !cir.ptr<!rec_SMem>
  // CHECK-NEXT:    cir.call @make_smem(%[[SRET]]) : (!cir.ptr<!rec_SMem> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.sret = !rec_SMem, llvm.writable}) -> ()
  // CHECK-NEXT:    %[[DEST:.*]] = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_SMem>>, !cir.ptr<!rec_SMem>
  // CHECK-NEXT:    cir.copy %[[SRET]] align(8) to %[[DEST]] align(8) : !cir.ptr<!rec_SMem>
  // CHECK-NEXT:    cir.return

  // A local is a complete object, so the copy into it takes the whole record.
  cir.func @tp_store_local() {
    %0 = cir.alloca "t" align(4) : !cir.ptr<!rec_TP>
    %1 = cir.call @make_tp() : () -> !rec_TP
    cir.store %1, %0 : !rec_TP, !cir.ptr<!rec_TP>
    cir.return
  }

  // CHECK-LABEL: cir.func @tp_store_local()
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[T:.*]] = cir.alloca "t" align(4) : !cir.ptr<!rec_TP>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_tp() : () -> !u64i
  // CHECK-NEXT:    cir.store %[[RES]], %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_TP>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %[[T]] align(4) : !cir.ptr<!rec_TP>
  // CHECK-NEXT:    cir.return

  // Any other destination may be a subobject whose tail padding holds
  // another object, so the copy stops at the data size.
  cir.func @tp_store_ptr(%arg0: !cir.ptr<!rec_TP>) {
    %0 = cir.call @make_tp() : () -> !rec_TP
    cir.store %0, %arg0 : !rec_TP, !cir.ptr<!rec_TP>
    cir.return
  }

  // CHECK-LABEL: cir.func @tp_store_ptr(%arg0: !cir.ptr<!rec_TP>)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RES:.*]] = cir.call @make_tp() : () -> !u64i
  // CHECK-NEXT:    cir.store %[[RES]], %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_TP>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %arg0 align(4) skip_tail_padding : !cir.ptr<!rec_TP>
  // CHECK-NEXT:    cir.return

  cir.func @sret_nodom_tpmem(%arg0: !cir.ptr<!cir.ptr<!rec_TPMem>>) {
    %0 = cir.call @make_tpmem() : () -> !rec_TPMem
    %1 = cir.load %arg0 : !cir.ptr<!cir.ptr<!rec_TPMem>>, !cir.ptr<!rec_TPMem>
    cir.store %0, %1 : !rec_TPMem, !cir.ptr<!rec_TPMem>
    cir.return
