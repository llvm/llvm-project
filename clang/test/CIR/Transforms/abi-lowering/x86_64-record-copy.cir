// RUN: cir-opt %s -split-input-file -verify-diagnostics -cir-call-conv-lowering=target=x86_64 | FileCheck %s
// RUN: cir-opt %s -split-input-file -verify-diagnostics -cir-call-conv-lowering=target=x86_64 \
// RUN:   | FileCheck %s --check-prefix=MOVE
// RUN: cir-opt %s -split-input-file -verify-diagnostics -cir-call-conv-lowering=target=x86_64 -cir-to-llvm -o - \
// RUN:   | cir-translate -mlir-to-llvmir --allow-unregistered-dialect \
// RUN:   | FileCheck %s --check-prefix=LLVM

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
!u8i = !cir.int<u, 8>
!u32i = !cir.int<u, 32>
!void = !cir.void
!rec_UX87 = !cir.union<"UX87" {data !cir.long_double<!cir.f80>, data !cir.array<!u8i x 16>}>
!rec_UX87Mem = !cir.union<"UX87Mem" {data !cir.complex<!cir.long_double<!cir.f80>>, data !cir.array<!u8i x 32>}>
!rec_HS = !cir.struct<"HS" {data !s8i, data !s32i}>
!rec_H = !cir.union<"H" {data !rec_HS, data !cir.array<!s32i x 2>}>
!rec_HBS = !cir.struct<"HBS" {data !s8i, data !s64i, data !s64i, data !s64i}>
!rec_HMem = !cir.union<"HMem" {data !rec_HBS, data !cir.array<!s32i x 8>}>
!rec_S = !cir.struct<"S" {data !s32i, data !s32i}>
!rec_SF = !cir.struct<"SF" {data !s64i, data !s32i}>
!rec_S12 = !cir.struct<"S12" {data !s32i, data !s32i, data !s32i}>
!rec_S16 = !cir.struct<"S16" {data !s32i, data !s32i, data !s32i, data !s32i}>
!rec_U3 = !cir.union<"U3" {data !cir.array<!s8i x 3>}>
!rec_SMem = !cir.struct<"SMem" {data !s64i, data !s64i, data !s64i}>
!rec_TP = !cir.struct<"TP" {data !s32i, data !s8i, pad !cir.array<!u8i x 3>}>
!rec_TPMem = !cir.struct<"TPMem" {data !s64i, data !s64i, data !s64i, data !s8i, pad !cir.array<!u8i x 7>}>
!rec___va_list_tag = !cir.struct<"__va_list_tag" {data !u32i, data !u32i, data !cir.ptr<!void>, data !cir.ptr<!void>}>

// CHECK-DAG: ![[PAIR:rec_anon_struct[0-9]*]] = !cir.struct<{data !u64i, data !u64i}>
// CHECK-DAG: ![[SFPAIR:rec_anon_struct[0-9]*]] = !cir.struct<{data !s64i, data !s32i}>
// CHECK-DAG: ![[S12PAIR:rec_anon_struct[0-9]*]] = !cir.struct<{data !u64i, data !s32i}>

// Up to the constants at the end of the first module, no named record is
// loaded or stored as a value.
// MOVE-NOT: cir.load {{.*}}, !rec_{{[A-Z]}}
// MOVE-NOT: cir.store {{.*}} : !rec_{{[A-Z]}}
// MOVE-LABEL: cir.func @const_feed_x87(

// LLVM-DAG: %union.UX87 = type { x86_fp80 }
// LLVM-DAG: %union.H = type { %struct.HS }

module attributes {
  cir.triple = "x86_64-unknown-linux-gnu",
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i8, dense<8>: vector<2xi64>>,
    #dlti.dl_entry<i16, dense<16>: vector<2xi64>>,
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>,
    #dlti.dl_entry<f32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<f64, dense<64>: vector<2xi64>>>
} {

  // Each callee is rewritten with its call sites in declaration order, so
  // these call sites are rewritten before any definition below.
  cir.func private @take_x87(!rec_UX87)
  cir.func private @make_x87() -> !rec_UX87
  cir.func private @take_h(!rec_H)
  cir.func private @make_h() -> !rec_H
  cir.func private @take_s(!rec_S)
  cir.func private @make_s() -> !rec_S
  cir.func private @take_sf(!rec_SF)
  cir.func private @make_sf() -> !rec_SF
  cir.func private @take_s12(!rec_S12)
  cir.func private @take_s16(!rec_S16)
  cir.func private @take_u3(!rec_U3)
  cir.func private @take_x87mem(!rec_UX87Mem)
  cir.func private @make_x87mem() -> !rec_UX87Mem
  cir.func private @take_hmem(!rec_HMem)
  cir.func private @make_hmem() -> !rec_HMem
  cir.func private @take_smem(!rec_SMem)
  cir.func private @make_smem() -> !rec_SMem
  cir.func private @make_tp() -> !rec_TP
  cir.func private @make_tpmem() -> !rec_TPMem

  // CHECK: cir.func private @take_x87(!u64i, !u64i)
  // CHECK: cir.func private @make_x87() -> ![[PAIR]]
  // CHECK: cir.func private @take_h(!u64i)
  // CHECK: cir.func private @make_h() -> !u64i
  // CHECK: cir.func private @take_s(!u64i)
  // CHECK: cir.func private @make_s() -> !u64i
  // CHECK: cir.func private @take_sf(!s64i, !s32i)
  // CHECK: cir.func private @make_sf() -> ![[SFPAIR]]
  // CHECK: cir.func private @take_s12(!u64i, !s32i)
  // CHECK: cir.func private @take_s16(!u64i, !u64i)
  // CHECK: cir.func private @take_u3(!cir.int<u, 24>)
  // CHECK: cir.func private @take_x87mem(!cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.byval = !rec_UX87Mem, llvm.noundef})
  // CHECK: cir.func private @make_x87mem(!cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.dead_on_unwind, llvm.sret = !rec_UX87Mem, llvm.writable})
  // CHECK: cir.func private @take_hmem(!cir.ptr<!rec_HMem> {llvm.align = 8 : i64, llvm.byval = !rec_HMem, llvm.noundef})
  // CHECK: cir.func private @make_hmem(!cir.ptr<!rec_HMem> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.sret = !rec_HMem, llvm.writable})
  // CHECK: cir.func private @take_smem(!cir.ptr<!rec_SMem> {llvm.align = 8 : i64, llvm.byval = !rec_SMem, llvm.noundef})
  // CHECK: cir.func private @make_smem(!cir.ptr<!rec_SMem> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.sret = !rec_SMem, llvm.writable})
  // CHECK: cir.func private @make_tp() -> !u64i
  // CHECK: cir.func private @make_tpmem(!cir.ptr<!rec_TPMem> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.sret = !rec_TPMem, llvm.writable})

  // A spilled parameter is copied out of its coercion slot.
  cir.func @param_spill_x87(%arg0: !rec_UX87) {
    %0 = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
    cir.store %arg0, %0 : !rec_UX87, !cir.ptr<!rec_UX87>
    cir.return
  }

  // CHECK-LABEL: cir.func @param_spill_x87(%arg0: !u64i, %arg1: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[SLOT]][0] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[LOP]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[SLOT]][1] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg1, %[[HIP]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<![[PAIR]]> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[SPILL:.*]] = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(16) to %[[SPILL]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.return

  cir.func @param_spill_h(%arg0: !rec_H) {
    %0 = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
    cir.store %arg0, %0 : !rec_H, !cir.ptr<!rec_H>
    cir.return
  }

  // CHECK-LABEL: cir.func @param_spill_h(%arg0: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[SPILL:.*]] = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %[[SPILL]] align(4) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    cir.return

  cir.func @param_spill_s(%arg0: !rec_S) {
    %0 = cir.alloca "s" align(4) : !cir.ptr<!rec_S>
    cir.store %arg0, %0 : !rec_S, !cir.ptr<!rec_S>
    cir.return
  }

  // CHECK-LABEL: cir.func @param_spill_s(%arg0: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_S>
  // CHECK-NEXT:    %[[SPILL:.*]] = cir.alloca "s" align(4) : !cir.ptr<!rec_S>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %[[SPILL]] align(4) : !cir.ptr<!rec_S>
  // CHECK-NEXT:    cir.return

  cir.func @param_spill_sf(%arg0: !rec_SF) {
    %0 = cir.alloca "s" align(8) : !cir.ptr<!rec_SF>
    cir.store %arg0, %0 : !rec_SF, !cir.ptr<!rec_SF>
    cir.return
  }

  // CHECK-LABEL: cir.func @param_spill_sf(%arg0: !s64i, %arg1: !s32i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<![[SFPAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[SLOT]][0] {name = ""} : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    cir.store %arg0, %[[LOP]] : !s64i, !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[SLOT]][1] {name = ""} : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!s32i>
  // CHECK-NEXT:    cir.store %arg1, %[[HIP]] : !s32i, !cir.ptr<!s32i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!rec_SF>
  // CHECK-NEXT:    %[[SPILL:.*]] = cir.alloca "s" align(8) : !cir.ptr<!rec_SF>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %[[SPILL]] align(8) : !cir.ptr<!rec_SF>
  // CHECK-NEXT:    cir.return

  // An unused parameter still fills its slot and nothing reads it.
  cir.func @param_unused_x87(%arg0: !rec_UX87) {
    cir.return
  }

  // CHECK-LABEL: cir.func @param_unused_x87(%arg0: !u64i, %arg1: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[SLOT]][0] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[LOP]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[SLOT]][1] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg1, %[[HIP]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.cast bitcast %[[SLOT]] : !cir.ptr<![[PAIR]]> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.return

  cir.func @param_unused_h(%arg0: !rec_H) {
    cir.return
  }

  // CHECK-LABEL: cir.func @param_unused_h(%arg0: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    cir.return

  cir.func @param_unused_s(%arg0: !rec_S) {
    cir.return
  }

  // CHECK-LABEL: cir.func @param_unused_s(%arg0: !u64i)
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_S>
  // CHECK-NEXT:    cir.return

  // The call is rewritten first and stores the parameter into an argument
  // slot.  The parameter's rewrite turns that store into a copy.
  cir.func @param_forward_x87(%arg0: !rec_UX87) {
    cir.call @take_x87(%arg0) : (!rec_UX87) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @param_forward_x87(%arg0: !u64i, %arg1: !u64i)
  // CHECK:         %[[VIEW:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[ARG:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(16) to %[[ARG]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[ARGVIEW:.*]] = cir.cast bitcast %[[ARG]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[ARGVIEW]][0] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[LO:.*]] = cir.load %[[LOP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[ARGVIEW]][1] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[HI:.*]] = cir.load %[[HIP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_x87(%[[LO]], %[[HI]]) : (!u64i, !u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @param_forward_h(%arg0: !rec_H) {
    cir.call @take_h(%arg0) : (!rec_H) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @param_forward_h(%arg0: !u64i)
  // CHECK:         %[[VIEW:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[ARG:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %[[ARG]] align(4) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[ARGVIEW:.*]] = cir.cast bitcast %[[ARG]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[V:.*]] = cir.load %[[ARGVIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_h(%[[V]]) : (!u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @param_forward_sf(%arg0: !rec_SF) {
    cir.call @take_sf(%arg0) : (!rec_SF) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @param_forward_sf(%arg0: !s64i, %arg1: !s32i)
  // CHECK:         %[[VIEW:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!rec_SF>
  // CHECK-NEXT:    %[[ARG:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!rec_SF>
  // CHECK-NEXT:    cir.copy %[[VIEW]] align(8) to %[[ARG]] align(8) : !cir.ptr<!rec_SF>
  // CHECK-NEXT:    %[[ARGVIEW:.*]] = cir.cast bitcast %[[ARG]] : !cir.ptr<!rec_SF> -> !cir.ptr<![[SFPAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[ARGVIEW]][0] {name = ""} : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!s64i>
  // CHECK-NEXT:    %[[LO:.*]] = cir.load %[[LOP]] : !cir.ptr<!s64i>, !s64i
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[ARGVIEW]][1] {name = ""} : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!s32i>
  // CHECK-NEXT:    %[[HI:.*]] = cir.load %[[HIP]] : !cir.ptr<!s32i>, !s32i
  // CHECK-NEXT:    cir.call @take_sf(%[[LO]], %[[HI]]) : (!s64i, !s32i) -> ()
  // CHECK-NEXT:    cir.return

  // A returned parameter is read in place out of its own coercion slot.
  cir.func @param_return_x87(%arg0: !rec_UX87) -> !rec_UX87 {
    cir.return %arg0 : !rec_UX87
  }

  // CHECK-LABEL: cir.func @param_return_x87(%arg0: !u64i, %arg1: !u64i)
  // CHECK-SAME:    -> ![[PAIR]]
  // CHECK:         %[[VIEW:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[VIEW]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load align(16) %[[RVIEW]] : !cir.ptr<![[PAIR]]>, ![[PAIR]]
  // CHECK-NEXT:    cir.return %[[RET]] : ![[PAIR]]

  cir.func @param_return_h(%arg0: !rec_H) -> !rec_H {
    cir.return %arg0 : !rec_H
  }

  // CHECK-LABEL: cir.func @param_return_h(%arg0: !u64i) -> !u64i
  // CHECK-NEXT:    %[[SLOT:.*]] = cir.alloca "coerce" align(8) : !cir.ptr<!u64i>
  // CHECK-NEXT:    cir.store %arg0, %[[SLOT]] : !u64i, !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[SLOT]] : !cir.ptr<!u64i> -> !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[VIEW]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load align(8) %[[RVIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.return %[[RET]] : !u64i

  cir.func @param_return_sf(%arg0: !rec_SF) -> !rec_SF {
    cir.return %arg0 : !rec_SF
  }

  // CHECK-LABEL: cir.func @param_return_sf(%arg0: !s64i, %arg1: !s32i)
  // CHECK-SAME:    -> ![[SFPAIR]]
  // CHECK:         %[[VIEW:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<![[SFPAIR]]> -> !cir.ptr<!rec_SF>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[VIEW]] : !cir.ptr<!rec_SF> -> !cir.ptr<![[SFPAIR]]>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load align(8) %[[RVIEW]] : !cir.ptr<![[SFPAIR]]>, ![[SFPAIR]]
  // CHECK-NEXT:    cir.return %[[RET]] : ![[SFPAIR]]

  cir.func @ret_local_x87() -> !rec_UX87 {
    %0 = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
    %1 = cir.load %0 : !cir.ptr<!rec_UX87>, !rec_UX87
    cir.return %1 : !rec_UX87
  }

  // CHECK-LABEL: cir.func @ret_local_x87()
  // CHECK-SAME:    -> ![[PAIR]]
  // CHECK-NEXT:    %[[U:.*]] = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[U]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load align(16) %[[RVIEW]] : !cir.ptr<![[PAIR]]>, ![[PAIR]]
  // CHECK-NEXT:    cir.return %[[RET]] : ![[PAIR]]

  cir.func @ret_local_h() -> !rec_H {
    %0 = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
    %1 = cir.load %0 : !cir.ptr<!rec_H>, !rec_H
    cir.return %1 : !rec_H
  }

  // CHECK-LABEL: cir.func @ret_local_h() -> !u64i
  // CHECK-NEXT:    %[[H:.*]] = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
  // CHECK-NEXT:    %[[RVIEW:.*]] = cir.cast bitcast %[[H]] : !cir.ptr<!rec_H> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[RET:.*]] = cir.load align(4) %[[RVIEW]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.return %[[RET]] : !u64i

  // An argument loaded from an alloca is read in place.
  cir.func @call_inplace_x87() {
    %0 = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
    %1 = cir.load %0 : !cir.ptr<!rec_UX87>, !rec_UX87
    cir.call @take_x87(%1) : (!rec_UX87) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @call_inplace_x87()
  // CHECK-NEXT:    %[[U:.*]] = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[VIEW:.*]] = cir.cast bitcast %[[U]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[VIEW]][0] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[LO:.*]] = cir.load align(16) %[[LOP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    %[[HIP:.*]] = cir.get_member %[[VIEW]][1] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
  // CHECK-NEXT:    %[[HI:.*]] = cir.load align(8) %[[HIP]] : !cir.ptr<!u64i>, !u64i
  // CHECK-NEXT:    cir.call @take_x87(%[[LO]], %[[HI]]) : (!u64i, !u64i) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @call_inplace_h() {
    %0 = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
    %1 = cir.load %0 : !cir.ptr<!rec_H>, !rec_H
    cir.call @take_h(%1) : (!rec_H) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @call_inplace_h()
  // CHECK-NEXT:    %[[H:.*]] = cir.alloca "h" align(4) : !cir.ptr<!rec_H>
