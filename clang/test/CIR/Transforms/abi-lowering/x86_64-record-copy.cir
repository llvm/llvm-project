  // CHECK-LABEL: cir.func @byval_tpmem_ptr(%arg0: !cir.ptr<!rec_TPMem> {llvm.align = 8 : i64, llvm.byval = !rec_TPMem, llvm.noundef}, %arg1: !cir.ptr<!rec_TPMem>)
  // CHECK-NEXT:    cir.copy %arg0 align(8) to %arg1 align(1) skip_tail_padding : !cir.ptr<!rec_TPMem>
  // CHECK-NEXT:    cir.return

  // A byval parameter stored twice has no single spill, so each store is a
  // copy from the incoming pointer.
  cir.func @byval_twice_x87mem(%arg0: !rec_UX87Mem, %arg1: !cir.ptr<!rec_UX87Mem>) {
    %0 = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87Mem>
    cir.store %arg0, %0 : !rec_UX87Mem, !cir.ptr<!rec_UX87Mem>
    cir.store %arg0, %arg1 : !rec_UX87Mem, !cir.ptr<!rec_UX87Mem>
    cir.return
  }

  // CHECK-LABEL: cir.func @byval_twice_x87mem(%arg0: !cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.byval = !rec_UX87Mem, llvm.noundef}, %arg1: !cir.ptr<!rec_UX87Mem>)
  // CHECK-NEXT:    %[[U:.*]] = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.copy %arg0 align(16) to %[[U]] align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.copy %arg0 align(16) to %arg1 align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.return

  // A byval parameter handed straight on is copied into the callee's slot.
  cir.func @byval_forward_hmem(%arg0: !rec_HMem) {
    cir.call @take_hmem(%arg0) : (!rec_HMem) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @byval_forward_hmem(%arg0: !cir.ptr<!rec_HMem> {llvm.align = 8 : i64, llvm.byval = !rec_HMem, llvm.noundef})
  // CHECK-NEXT:    %[[BYVAL:.*]] = cir.alloca "byval" align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.copy %arg0 align(8) to %[[BYVAL]] align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.call @take_hmem(%[[BYVAL]]) : (!cir.ptr<!rec_HMem> {llvm.align = 8 : i64, llvm.byval = !rec_HMem, llvm.noundef}) -> ()
  // CHECK-NEXT:    cir.return

  // The consumer is rewritten first and stores the sret result into its
  // byval slot.  The producer's rewrite turns that store into a copy.
  cir.func @byval_result_x87mem() {
    %0 = cir.call @make_x87mem() : () -> !rec_UX87Mem
    cir.call @take_x87mem(%0) : (!rec_UX87Mem) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @byval_result_x87mem()
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.call @make_x87mem(%[[SRET]])
  // CHECK-NEXT:    %[[BYVAL:.*]] = cir.alloca "byval" align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.copy %[[SRET]] align(16) to %[[BYVAL]] align(16) : !cir.ptr<!rec_UX87Mem>
  // CHECK-NEXT:    cir.call @take_x87mem(%[[BYVAL]]) : (!cir.ptr<!rec_UX87Mem> {llvm.align = 16 : i64, llvm.byval = !rec_UX87Mem, llvm.noundef}) -> ()
  // CHECK-NEXT:    cir.return

  cir.func @byval_result_hmem() {
    %0 = cir.call @make_hmem() : () -> !rec_HMem
    cir.call @take_hmem(%0) : (!rec_HMem) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @byval_result_hmem()
  // CHECK-NEXT:    %[[SRET:.*]] = cir.alloca "sret" align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.call @make_hmem(%[[SRET]])
  // CHECK-NEXT:    %[[BYVAL:.*]] = cir.alloca "byval" align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.copy %[[SRET]] align(8) to %[[BYVAL]] align(8) : !cir.ptr<!rec_HMem>
  // CHECK-NEXT:    cir.call @take_hmem(%[[BYVAL]]) : (!cir.ptr<!rec_HMem> {llvm.align = 8 : i64, llvm.byval = !rec_HMem, llvm.noundef}) -> ()
  // CHECK-NEXT:    cir.return

  // A register-class fetch copies out of the register save area through a
  // temp, and the fetched value is copied into the local.  The second fetch
  // feeds a call rewritten before it, whose argument slot store becomes a
  // copy.
  cir.func @vaarg_x87(%arg0: !s32i, ...) {
    %0 = cir.alloca "ap" align(16) : !cir.ptr<!cir.array<!rec___va_list_tag x 1>>
    %1 = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
    %2 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!rec___va_list_tag x 1>> -> !cir.ptr<!rec___va_list_tag>
    %3 = cir.va_arg %2 : (!cir.ptr<!rec___va_list_tag>) -> !rec_UX87
    cir.store align(16) %3, %1 : !rec_UX87, !cir.ptr<!rec_UX87>
    %4 = cir.va_arg %2 : (!cir.ptr<!rec___va_list_tag>) -> !rec_UX87
    cir.call @take_x87(%4) : (!rec_UX87) -> ()
    cir.return
  }

  // CHECK-LABEL: cir.func @vaarg_x87(%arg0: !s32i, ...)
  // CHECK-NEXT:    %[[ASLOT:.*]] = cir.alloca "coerce" align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.alloca "ap"
  // CHECK-NEXT:    %[[U:.*]] = cir.alloca "u" align(16) : !cir.ptr<!rec_UX87>
  // CHECK:         %[[TEMP:.*]] = cir.alloca "vaarg.reg" align(16) : !cir.ptr<!rec_UX87>
  // CHECK:         %[[REG:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!u8i> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[REG]] align(8) to %[[TEMP]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK:         %[[ADDR:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!u8i> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[ADDR]] align(16) to %[[U]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK:         %[[TEMP2:.*]] = cir.alloca "vaarg.reg" align(16) : !cir.ptr<!rec_UX87>
  // CHECK:         %[[REG2:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!u8i> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[REG2]] align(8) to %[[TEMP2]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK:         %[[ADDR2:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!u8i> -> !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    cir.copy %[[ADDR2]] align(16) to %[[ASLOT]] align(16) : !cir.ptr<!rec_UX87>
  // CHECK-NEXT:    %[[AVIEW:.*]] = cir.cast bitcast %[[ASLOT]] : !cir.ptr<!rec_UX87> -> !cir.ptr<![[PAIR]]>
  // CHECK-NEXT:    %[[LOP:.*]] = cir.get_member %[[AVIEW]][0] {name = ""} : !cir.ptr<![[PAIR]]> -> !cir.ptr<!u64i>
