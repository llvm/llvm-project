// RUN: cir-opt %s -cir-call-conv-lowering=target=x86_64 | FileCheck %s

!u8i = !cir.int<u, 8>
!u32i = !cir.int<u, 32>
!u64i = !cir.int<u, 64>

// A unit whose declarations stop at its own end.
!rec_UnitOnly = !cir.struct<"UnitOnly" {bitfield !u32i, pad !cir.array<!u8i x 12>}>

// The same shape, with the declared extent carried past the unit.
!rec_Extent = !cir.struct<"Extent" {bitfield !u32i,
                                 bitfield !cir.array<!cir.array<!u8i x 8> x 0>,
                                 pad !cir.array<!u8i x 12>}>

// Over two eightbytes, so memory whatever the declared extent says.
!rec_BigExtent = !cir.struct<"BigExtent" {data !u64i, data !u64i, bitfield !u8i,
                                       bitfield !cir.array<!cir.array<!u8i x 4> x 0>,
                                       pad !cir.array<!u8i x 7>}>

// A union whose storage is narrower than the declaration it holds.
!rec_UnionExtent = !cir.union<"UnionExtent" {bitfield !u8i,
                                          bitfield !cir.array<!cir.array<!u8i x 4> x 0>},
                             padding = {!cir.array<!u8i x 3>}>

module attributes {
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>,
    #dlti.dl_entry<f32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<f64, dense<64>: vector<2xi64>>,
    #dlti.dl_entry<"dlti.endianness", "little">
  >,
  cir.triple = "x86_64-unknown-linux-gnu"
} {
  // With nothing declared past the unit, the bytes after it are padding and
  // the coercion is the unit's own width.
  cir.func @take_unit_only(%arg0: !rec_UnitOnly) {
    cir.return
  }

  // CHECK: cir.func{{.*}} @take_unit_only(%arg0: !u32i)

  // The declared extent makes those same bytes user data, which widens the
  // coercion to the eightbyte holding them.
  cir.func @take_extent(%arg0: !rec_Extent) {
    cir.return
  }

  // CHECK: cir.func{{.*}} @take_extent(%arg0: !u64i)

  cir.func @return_extent(%arg0: !rec_Extent) -> !rec_Extent {
    %0 = cir.alloca "a" align(16) : !cir.ptr<!rec_Extent>
    cir.store %arg0, %0 : !rec_Extent, !cir.ptr<!rec_Extent>
    %1 = cir.load %0 : !cir.ptr<!rec_Extent>, !rec_Extent
    cir.return %1 : !rec_Extent
  }

  // CHECK: cir.func{{.*}} @return_extent(%arg0: !u64i) -> !u64i

  cir.func @take_big_extent(%arg0: !rec_BigExtent) {
    cir.return
  }

  // CHECK: cir.func{{.*}} @take_big_extent(%arg0: !cir.ptr<!rec_BigExtent> {llvm.align = 8 : i64, llvm.byval = !rec_BigExtent, llvm.noalias, llvm.noundef})

  cir.func @return_big_extent(%arg0: !rec_BigExtent) -> !rec_BigExtent {
    %0 = cir.alloca "a" align(8) : !cir.ptr<!rec_BigExtent>
    cir.store %arg0, %0 : !rec_BigExtent, !cir.ptr<!rec_BigExtent>
    %1 = cir.load %0 : !cir.ptr<!rec_BigExtent>, !rec_BigExtent
    cir.return %1 : !rec_BigExtent
  }

  // CHECK: cir.func{{.*}} @return_big_extent(%arg0: !cir.ptr<!rec_BigExtent> {llvm.align = 8 : i64, llvm.dead_on_unwind, llvm.noalias, llvm.sret = !rec_BigExtent, llvm.writable}, %arg1: !cir.ptr<!rec_BigExtent> {llvm.align = 8 : i64, llvm.byval = !rec_BigExtent, llvm.noalias, llvm.noundef})

  cir.func @take_union_extent(%arg0: !rec_UnionExtent) {
    cir.return
  }

  // CHECK: cir.func{{.*}} @take_union_extent(%arg0: !u32i)
}
