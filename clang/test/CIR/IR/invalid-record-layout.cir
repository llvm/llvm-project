// RUN: cir-opt %s -verify-diagnostics -split-input-file

module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that record_align must be a non-zero power of two}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 0>}
} {
}

// -----

module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that record_align must be a non-zero power of two}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 3>}
} {
}

// -----

module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that zero_width_bitfield offsets and widths must be parallel}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 4,
                           zero_width_bitfield_offsets = [0, 32],
                           zero_width_bitfield_widths = [32]>}
} {
}

// -----

module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that zero_width_bitfield offsets and widths must be parallel}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 4,
                           zero_width_bitfield_offsets = [0]>}
} {
}

// -----

// A width reaches the classifier as an integer type, whose size is read in
// bytes, so a sub-byte width has no type to carry it.
module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that a zero_width_bitfield width must be a positive multiple of 8}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 4,
                           zero_width_bitfield_offsets = [0],
                           zero_width_bitfield_widths = [4]>}
} {
}

// -----

module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that a zero_width_bitfield width must be a positive multiple of 8}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 4,
                           zero_width_bitfield_offsets = [0],
                           zero_width_bitfield_widths = [0]>}
} {
}

// -----

module attributes {
  cir.record_layouts = {
    // expected-error @below {{failed to verify that a zero_width_bitfield offset must not be negative}}
    S = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                           has_trivial_dtor = true, record_align = 4,
                           zero_width_bitfield_offsets = [-8],
                           zero_width_bitfield_widths = [32]>}
} {
}
