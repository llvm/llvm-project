// -----

cir.func coroutine @final_suspend_multiple_awaits(%arg0 : !cir.bool) {
  cir.coroutine initialSuspend : { // expected-error {{must have one or zero 'final' cir.await in 'final_suspend'}}
    cir.await(init, ready : {
      cir.condition(%arg0)
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.yield
    },)
    cir.yield
  }, body : {
    cir.yield
  }, finalSuspend : {
    cir.await(final, ready : {
      cir.condition(%arg0)
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.yield
    },)
    cir.await(final, ready : {
      cir.condition(%arg0)
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.yield
    },)
    cir.yield
  }, destroy : {
    cir.yield
  }, exit : {
    cir.return
  }
  cir.trap
}

// -----

cir.func coroutine @final_suspend_invalid_await(%arg0 : !cir.bool) {
  cir.coroutine initialSuspend : { // expected-error {{'final_suspend' must not contain any cir.await other than the 'final' one}}
    cir.await(init, ready : {
      cir.condition(%arg0)
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.yield
    },)
    cir.yield
  }, body : {
    cir.yield
  }, finalSuspend : {
    cir.await(user, ready : {
      cir.condition(%arg0)
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.yield
    },)
    cir.yield
  }, destroy : {
    cir.yield
  }, exit : {
    cir.return
  }
  cir.trap
}
