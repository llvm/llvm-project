// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!void = !cir.void
#false = #cir.bool<false> : !cir.bool
!s32i = !cir.int<s, 32>

module {
  cir.func @test_coro_id() {
    %0 = cir.const #cir.int<32> : !s32i
    %1 = cir.const #cir.ptr<null> : !cir.ptr<!void>
    %2 = cir.coro.intrinsic.id(%0, %1, %1, %1) : (!s32i, !cir.ptr<!void>, !cir.ptr<!void>, !cir.ptr<!void>) -> token
    // CHECK: cir.coro.intrinsic.id(%0, %1, %1, %1) : (!s32i, !cir.ptr<!void>, !cir.ptr<!void>, !cir.ptr<!void>) -> token
    cir.return
  }
}
