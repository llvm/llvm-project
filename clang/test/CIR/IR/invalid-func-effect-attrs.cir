// RUN: cir-opt %s -verify-diagnostics -split-input-file

// expected-error @below {{custom op 'cir.func' attribute 'memory_effects' must be a #llvm.memory_effects attribute}}
cir.func private @wrong_memory_effects_kind() attributes {memory_effects = 42 : i32}

// -----

// expected-error @below {{custom op 'cir.func' attribute 'memory_effects' must be a #llvm.memory_effects attribute}}
cir.func @wrong_memory_effects_kind_with_body() attributes {memory_effects = "readwrite"} {
  cir.return
}

// -----

// expected-error @below {{custom op 'cir.func' attribute 'nounwind' must be a unit attribute}}
cir.func private @wrong_nounwind_kind() attributes {nounwind = 42 : i32}

// -----

// expected-error @below {{custom op 'cir.func' attribute 'willreturn' must be a unit attribute}}
cir.func private @wrong_willreturn_kind() attributes {willreturn = "yes"}
