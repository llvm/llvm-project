// RUN: cir-opt %s -verify-diagnostics -split-input-file

module {
  cir.func @l0() {
    cir.return
  }

  cir.func @l1() alias(@l0) { // expected-error {{function alias shall not have a body}}
    cir.return
  }
}

// -----

module {
  cir.func @l0() func_info<> { // expected-error {{expected attribute value}}
    cir.return
  }
}

// -----

module {
  // expected-error@below {{expected a function info attribute, got 32 : i32}}
  cir.func @l0() func_info<32 : i32> {
    cir.return
  }
}

// -----

module {
  cir.func @l0() -> i32 // expected-error {{expected all types in the function signature to be CIR types}}
}

// -----

module {
  cir.func @l0(i32) // expected-error {{expected all types in the function signature to be CIR types}}
}

// -----

module {
  cir.func comdat align(2) @f() { // expected-error {{custom op 'cir.func' expected valid '@'-identifier for symbol name}}
    cir.return
}

// -----

module {
  cir.func comdat alignment(-1) @f() { // expected-error {{custom op 'cir.func' function alignment must be a positive integer}}
    cir.return
}

// -----

module {
  cir.func comdat alignment(0) @f() { // expected-error {{custom op 'cir.func' function alignment must be a positive integer}}
    cir.return
}
// -----

module {
  cir.func comdat alignment 0 @f() { // expected-error {{expected '('}}
    cir.return
}

// -----

module {
  cir.func comdat preferred_alignment(-1) @f() { // expected-error {{custom op 'cir.func' function alignment must be a positive integer}}
    cir.return
}

// -----

module {
  cir.func comdat preferred_alignment(0) @f() { // expected-error {{custom op 'cir.func' function alignment must be a positive integer}}
    cir.return
}
// -----

module {
  cir.func comdat preferred_alignment 0 @f() { // expected-error {{expected '('}}
    cir.return
}
