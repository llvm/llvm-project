// RUN: cir-opt %s --verify-roundtrip | FileCheck %s
// RUN: cir-opt %s -cir-to-llvm -o - | FileCheck %s --check-prefix=MLIR
// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering -o - | FileCheck %s --check-prefix=LLVM

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.global "private" constant cir_private dso_local unnamed_addr @".str" = #cir.const_array<"hi" : !cir.array<!s8i x 2>, trailing_zeros> : !cir.array<!s8i x 3> align(1)
  // CHECK: cir.global "private" constant cir_private dso_local unnamed_addr @".str"
  // MLIR: llvm.mlir.global private unnamed_addr constant @".str"
  // LLVM: @.str = private unnamed_addr constant [3 x i8] c"hi\00"

  cir.global "private" constant cir_private unnamed_addr target_address_space(1) @as_str = #cir.const_array<"as" : !cir.array<!s8i x 2>, trailing_zeros> : !cir.array<!s8i x 3>
  // CHECK: cir.global "private" constant cir_private unnamed_addr target_address_space(1) @as_str
  // MLIR: llvm.mlir.global private unnamed_addr constant @as_str{{.*}}addr_space = 1
  // LLVM: @as_str = private unnamed_addr addrspace(1) constant [3 x i8] c"as\00"

  cir.global "private" constant external unnamed_addr @ext_decl : !cir.array<!s32i x 2>
  // CHECK: cir.global "private" constant external unnamed_addr @ext_decl : !cir.array<!s32i x 2>
  // MLIR: llvm.mlir.global external unnamed_addr constant @ext_decl()
  // LLVM: @ext_decl = external unnamed_addr constant [2 x i32]

  cir.global external @named = #cir.int<0> : !s32i
  // CHECK: cir.global external @named = #cir.int<0> : !s32i
  // MLIR: llvm.mlir.global external @named(0 : i32)
  // LLVM: @named = global i32 0
}
