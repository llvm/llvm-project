// RUN: cir-opt %s -verify-diagnostics -split-input-file
cir.func coroutine @bad_task() { // expected-error {{coroutine body must use at least one cir.await op}}
  cir.return
}

// -----

cir.func coroutine @missing_condition() {
  cir.scope {
    cir.await(user, ready : { // expected-error {{ready region must end with cir.condition}}
      cir.yield
    }, suspend : {
      cir.yield
    }, resume : {
      cir.yield
    },)
  }
  cir.coro.body {
  }
  cir.return
}

// -----

!void = !cir.void
!s8i = !cir.int<s, 8>

cir.func coroutine @flattened_with_await(%arg0: !cir.ptr<!void>, %arg1: !cir.bool) { // expected-error {{flattened coroutine function cannot use cir.await op}}
  %save = cir.coro.intrinsic.save(%arg0) : (!cir.ptr<!void>) -> token
  %false = cir.const #cir.bool<false> : !cir.bool
  %susp = cir.coro.intrinsic.suspend(%save, %false) : (token, !cir.bool) -> !s8i
  cir.await(user, ready : {
    cir.condition(%arg1)
  }, suspend : {
    cir.yield
  }, resume : {
    cir.yield
  },)
  cir.return
}
