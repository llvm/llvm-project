// RUN: cir-opt %s -verify-diagnostics -split-input-file
cir.func coroutine @bad_task() { // expected-error {{coroutine body must use at least one cir.await op}}
  cir.return
}

// -----

cir.func coroutine @missing_condition() {
  cir.coro.ret_point {
    cir.await(user, ready : { // expected-error {{ready region must end with cir.condition}}
      cir.yield
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.yield
    },)
    cir.coro.body {
    }
    cir.yield
  }, ret : {
      cir.return
  }
  cir.trap
}

cir.func coroutine @missing_suspend(%arg0 : !cir.bool) {
  cir.coro.ret_point {
    cir.coro.body {
      cir.await(user, ready : { // expected-error {{suspend region must end with cir.coro.suspend_point}}
        cir.condition(%arg0)
      }, suspend : {
        cir.yield
      }, resume : {
        cir.yield
      },)
      cir.yield
    }
    cir.yield
  }, ret : {
      cir.return
  }
  cir.trap
}
