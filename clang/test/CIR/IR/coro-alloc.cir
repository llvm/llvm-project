// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!void = !cir.void
#false = #cir.bool<false> : !cir.bool
!s32i = !cir.int<s, 32>

module {
  cir.func @test_coro_alloc() {
    %0 = cir.token.none
    %1 = cir.coro.intrinsic.alloc(%0) : (token) -> !cir.bool
    // CHECK: cir.coro.intrinsic.alloc(%0) : (token) -> !cir.bool
    cir.return
  }
}
