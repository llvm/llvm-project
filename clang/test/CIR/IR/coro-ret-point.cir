// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

cir.func coroutine @coro_ret_point(%arg0 : !cir.bool) {
  cir.coro.ret_point {
    cir.coro.body {
      cir.await(user, ready : {
        cir.condition(%arg0)
      }, suspend : {
        cir.coro.suspend_point
      }, resume : {
        cir.yield
      },)
      cir.yield
    }
    cir.yield
  }, ret : {
      cir.return
  }
  cir.trap
}

// CHECK: cir.coro.ret_point {
// CHECK: }, ret : {
