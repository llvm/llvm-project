// RUN: cir-opt %s -verify-diagnostics -split-input-file

// Non-string cir.triple.

// expected-error @below {{'builtin.module' op expects 'cir.triple' to be a string}}
module attributes {cir.triple = 42 : i32} {}

// -----

// Empty cir.triple.

// expected-error @below {{'builtin.module' op unknown triple '' in 'cir.triple' attribute}}
module attributes {cir.triple = ""} {}

// -----

// Malformed cir.triple.

// expected-error @below {{'builtin.module' op unknown triple 'garbage' in 'cir.triple' attribute}}
module attributes {cir.triple = "garbage"} {}

// -----

// Well-formed cir.triple with an unknown target.

// expected-error @below {{'builtin.module' op unknown triple 'foobar-unknown-unknown' in 'cir.triple' attribute}}
module attributes {cir.triple = "foobar-unknown-unknown"} {}

// -----

// cir.triple attached to something other than a module.

module {
  // expected-error @below {{'cir.func' op expects 'cir.triple' attribute to be attached to 'builtin.module'}}
  cir.func @not_module_attr() attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
    cir.return
  }
}
