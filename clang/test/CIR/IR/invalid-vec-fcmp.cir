// RUN: cir-opt %s -verify-diagnostics

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_fcmp_on_int(%a: !cir.vector<4 x !s32i>,
                            %b: !cir.vector<4 x !s32i>) {
    // expected-error@+1 {{requires floating-point vector operands}}
    %0 = cir.vec.fcmp(oeq, %a, %b) : !cir.vector<4 x !s32i>,
                                    !cir.vector<4 x !s32i>
    cir.return
  }
}
