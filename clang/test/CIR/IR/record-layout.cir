// RUN: cir-opt %s | FileCheck %s

module attributes {
  cir.record_layouts = {
    Same = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                              has_trivial_dtor = true, record_align = 4,
                              unadjusted_align = 4>,
    Raised = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                                has_trivial_dtor = true, record_align = 16,
                                unadjusted_align = 4>,
    TU = #cir.record_layout<arg_passing_kind = can_pass_in_regs,
                            has_trivial_dtor = true, record_align = 4,
                            transparent_union = true>
  }
} {}

// An unadjusted alignment equal to record_align is omitted, including when
// the input spelled it out. A transparent union can omit it too.
// CHECK-DAG: Raised = #cir.record_layout<arg_passing_kind = can_pass_in_regs, has_trivial_dtor = true, record_align = 16, unadjusted_align = 4>
// CHECK-DAG: Same = #cir.record_layout<arg_passing_kind = can_pass_in_regs, has_trivial_dtor = true, record_align = 4>
// CHECK-DAG: TU = #cir.record_layout<arg_passing_kind = can_pass_in_regs, has_trivial_dtor = true, record_align = 4, transparent_union = true>
