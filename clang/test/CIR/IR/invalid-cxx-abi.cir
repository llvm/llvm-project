// RUN: cir-opt %s -verify-diagnostics --cir-cxxabi-lowering -split-input-file

// expected-error@+1 {{unknown C++ ABI 'bla'}}
module attributes {cir.cxx_abi = "bla"} {
}

// -----

// expected-error@+1 {{'builtin.module' op expects 'cir.cxx_abi' to be a string}}
module attributes {cir.cxx_abi = 1 : i32} {
}

// -----

module {
  // expected-error@+1 {{'cir.func' op expects 'cir.cxx_abi' attribute to be attached to 'builtin.module'}}
  cir.func @f() attributes {cir.cxx_abi = "itanium"} {
    cir.return
  }
}

// -----

// expected-error@+1 {{C++ ABI 'microsoft' is not supported on target 'x86_64-unknown-linux-gnu'}}
module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.cxx_abi = "microsoft"} {
}

// -----

// expected-error@+1 {{createItaniumCXXABI: C++ ABI kind NYI in CIR}}
module attributes {cir.triple = "aarch64-unknown-fuchsia", cir.cxx_abi = "fuchsia"} {
}
