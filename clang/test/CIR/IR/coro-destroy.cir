// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!void = !cir.void
#false = #cir.bool<false> : !cir.bool
!s32i = !cir.int<s, 32>

module {
  cir.func @test_coro_destroy() {
    %0 = cir.const #cir.ptr<null> : !cir.ptr<!void>
    cir.coro.intrinsic.destroy(%0) : (!cir.ptr<!void>) -> ()
    // CHECK: cir.coro.intrinsic.destroy(%0) : (!cir.ptr<!void>)
    cir.return
  }
}
