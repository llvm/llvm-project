// RUN: cir-opt %s -verify-diagnostics -split-input-file

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module {

// expected-error @below {{type of the real part does not match the complex type}}
cir.global external @ci2 = #cir.const_complex<#cir.int<1> : !s64i, #cir.int<2> : !s32i> : !cir.complex<!s32i>

}

// -----

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module {

// expected-error @below {{type of the imaginary part does not match the complex type}}
cir.global external @ci2 = #cir.const_complex<#cir.int<1> : !s32i, #cir.int<2> : !s64i> : !cir.complex<!s32i>

}

// -----

module {
  cir.func @complex_real_invalid_result_type() -> !cir.double {
    %0 = cir.alloca "c" align(8) : !cir.ptr<!cir.complex<!cir.double>>
    %2 = cir.load align(8) %0 : !cir.ptr<!cir.complex<!cir.double>>, !cir.complex<!cir.double>
    // expected-error @below {{result type does not match operand type}}
    %3 = cir.complex.real %2 : !cir.complex<!cir.double> -> !cir.float
    cir.return
  }
}

// -----

module {
  cir.func @complex_imag_invalid_result_type() -> !cir.double {
    %0 = cir.alloca "c" align(8) : !cir.ptr<!cir.complex<!cir.double>>
    %2 = cir.load align(8) %0 : !cir.ptr<!cir.complex<!cir.double>>, !cir.complex<!cir.double>
    // expected-error @below {{result type does not match operand type}}
    %3 = cir.complex.imag %2 : !cir.complex<!cir.double> -> !cir.float
    cir.return
  }
}


// -----

module {
  cir.func @complex_real_ptr_invalid_result_type() -> !cir.double {
    %0 = cir.alloca "c" align(8) : !cir.ptr<!cir.complex<!cir.double>>
    // expected-error @below {{result type does not match operand type}}
    %1 = cir.complex.real_ptr %0 : !cir.ptr<!cir.complex<!cir.double>> -> !cir.ptr<!cir.float>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @complex_add_fenv_with_int_element_type() {
    %0 = cir.alloca "a" align(4) : !cir.ptr<!cir.complex<!s32i>>
    %1 = cir.alloca "b" align(4) : !cir.ptr<!cir.complex<!s32i>>
    %2 = cir.alloca "c" align(4) init : !cir.ptr<!cir.complex<!s32i>>
    %3 = cir.load align(4) %0 : !cir.ptr<!cir.complex<!s32i>>, !cir.complex<!s32i>
    %4 = cir.load align(4) %1 : !cir.ptr<!cir.complex<!s32i>>, !cir.complex<!s32i>
    // expected-error @below {{'cir.complex.add' op 'fenv' is only valid for floating-point element type}}
    %5 = cir.complex.add %3, %4 : !cir.complex<!s32i> {fenv = #cir.fenv<dynamic_rounding_mode = tonearest, except_mode = unknown, strict_except = true>}
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @complex_sub_fenv_with_int_element_type() {
    %0 = cir.alloca "a" align(4) : !cir.ptr<!cir.complex<!s32i>>
    %1 = cir.alloca "b" align(4) : !cir.ptr<!cir.complex<!s32i>>
    %2 = cir.alloca "c" align(4) init : !cir.ptr<!cir.complex<!s32i>>
    %3 = cir.load align(4) %0 : !cir.ptr<!cir.complex<!s32i>>, !cir.complex<!s32i>
    %4 = cir.load align(4) %1 : !cir.ptr<!cir.complex<!s32i>>, !cir.complex<!s32i>
    // expected-error @below {{'cir.complex.sub' op 'fenv' is only valid for floating-point element type}}
    %5 = cir.complex.sub %3, %4 : !cir.complex<!s32i> {fenv = #cir.fenv<dynamic_rounding_mode = tonearest, except_mode = unknown, strict_except = true>}
    cir.return
  }
}
