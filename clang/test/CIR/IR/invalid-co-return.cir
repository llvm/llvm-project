// RUN: cir-opt %s -verify-diagnostics -split-input-file

cir.func @must_be_inside_coroutine() {
  cir.co_return // expected-error {{expects ancestor op 'cir.coroutine'}}
}

// -----

cir.func coroutine @must_be_in_body(%arg0 : !cir.bool) {
  cir.coroutine initialSuspend : {
    cir.await(init, ready : {
      cir.condition(%arg0)
    }, suspend : {
      cir.coro.suspend_point
    }, resume : {
      cir.co_return // expected-error {{must be inside the cir.coroutine body region}}
    },)
    cir.yield
  }, body : {
    cir.yield
  }, finalSuspend : {
    cir.yield
  }, destroy : {
    cir.yield
  }, exit : {
    cir.return
  }
  cir.trap
}
