// RUN: cir-opt %s --verify-roundtrip | FileCheck %s
// RUN: cir-opt %s -mlir-print-op-generic | FileCheck %s --check-prefix=GENERIC

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>

module {
  // CHECK-LABEL: cir.func @add
  cir.func @add(%a: !s32i, %b: !s32i) {
    // CHECK: cir.add %{{.*}}, %{{.*}} : !s32i
    %0 = cir.add %a, %b : !s32i
    // CHECK: cir.add nsw %{{.*}}, %{{.*}} : !s32i
    %1 = cir.add nsw %a, %b : !s32i
    // CHECK: cir.add nuw %{{.*}}, %{{.*}} : !s32i
    %2 = cir.add nuw %a, %b : !s32i
    // CHECK: cir.add nuw|nsw %{{.*}}, %{{.*}} : !s32i
    %3 = cir.add nuw|nsw %a, %b : !s32i
    // CHECK: cir.add nuw|nsw %{{.*}}, %{{.*}} : !s32i
    %4 = cir.add nsw|nuw %a, %b : !s32i
    cir.return
  }

  // CHECK-LABEL: cir.func @sub
  cir.func @sub(%a: !u32i, %b: !u32i) {
    // CHECK: cir.sub nuw %{{.*}}, %{{.*}} : !u32i
    %0 = cir.sub nuw %a, %b : !u32i
    // CHECK: cir.sub nuw|nsw %{{.*}}, %{{.*}} : !u32i
    %1 = cir.sub nsw|nuw %a, %b : !u32i
    cir.return
  }

  // CHECK-LABEL: cir.func @mul
  cir.func @mul(%a: !s32i, %b: !s32i) {
    // CHECK: cir.mul %{{.*}}, %{{.*}} : !s32i
    %0 = cir.mul %a, %b : !s32i
    // CHECK: cir.mul nsw %{{.*}}, %{{.*}} : !s32i
    %1 = cir.mul nsw %a, %b : !s32i
    // CHECK: cir.mul nuw|nsw %{{.*}}, %{{.*}} : !s32i
    %2 = cir.mul nuw|nsw %a, %b : !s32i
    cir.return
  }

  // CHECK-LABEL: cir.func @sat
  cir.func @sat(%a: !s32i, %b: !s32i, %va: !cir.vector<4 x !u32i>,
                %vb: !cir.vector<4 x !u32i>) {
    // CHECK: cir.add.sat %{{.*}}, %{{.*}} : !s32i
    %0 = cir.add.sat %a, %b : !s32i
    // CHECK: cir.sub.sat %{{.*}}, %{{.*}} : !s32i
    %1 = cir.sub.sat %a, %b : !s32i
    // CHECK: cir.add.sat %{{.*}}, %{{.*}} : !cir.vector<4 x !u32i>
    %2 = cir.add.sat %va, %vb : !cir.vector<4 x !u32i>
    cir.return
  }
}

// The flags are stored as a single bit-enum property.
// GENERIC-LABEL: sym_name = "add"
// GENERIC: "cir.add"(%{{.*}}, %{{.*}}) <{overflow_flags = 0 : i32}>
// GENERIC: "cir.add"(%{{.*}}, %{{.*}}) <{overflow_flags = 1 : i32}>
// GENERIC: "cir.add"(%{{.*}}, %{{.*}}) <{overflow_flags = 2 : i32}>
// GENERIC: "cir.add"(%{{.*}}, %{{.*}}) <{overflow_flags = 3 : i32}>
// GENERIC: "cir.add"(%{{.*}}, %{{.*}}) <{overflow_flags = 3 : i32}>
