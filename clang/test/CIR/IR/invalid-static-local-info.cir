// RUN: cir-opt %s -verify-diagnostics -split-input-file

// 'dynamic_init_guard' and 'dynamic_init_info' are only meaningful together:
// the guard drives lowering, which reads the info. The GlobalOp verifier
// rejects either without the other, guarding the static-local lowering path
// against hand-written or serialized .cir that would otherwise crash lowering
// with a missing info attribute or carry a dangling info nothing reads.

!s32i = !cir.int<s, 32>

module {
  // expected-error@+1 {{'dynamic_init_guard' and 'dynamic_init_info' must be present together}}
  cir.global "private" internal dynamic_init_guard<"_ZGVZ1fvE1x"> @_ZZ1fvE1x : !s32i
}

// -----

!s32i = !cir.int<s, 32>

module {
  // expected-error@+1 {{'dynamic_init_guard' and 'dynamic_init_info' must be present together}}
  cir.global "private" internal @_ZZ1fvE1x : !s32i
    dynamic_init_info<local = true, tls = none, is_inline = false, tsk = undeclared>
}
