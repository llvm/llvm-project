// -----

!s8i = !cir.int<s, 8>
!u8i = !cir.int<u, 8>
!rec_Tmp = !cir.struct<"Tmp" {pad !u8i}>

module {
  cir.func private @_ZN3TmpD1Ev(!cir.ptr<!rec_Tmp>)
  cir.global "private" internal @_ZGRZ1fvE1r_ = #cir.zero : !rec_Tmp
  cir.global "private" internal dynamic_init_guard<"_ZGVZ1fvE1r"> @_ZZ1fvE1r = #cir.zero : !rec_Tmp
    dynamic_init_info<local = true, tls = none, is_inline = false, tsk = undeclared>

  cir.func @f() {
    cir.local_init static_local @_ZZ1fvE1r dtor {
      // expected-error @below {{must be in the ctor region of a cir.global or cir.local_init}}
      cir.register_exit_dtor @_ZGRZ1fvE1r_ {
        %0 = cir.get_global @_ZGRZ1fvE1r_ : !cir.ptr<!rec_Tmp>
        cir.call @_ZN3TmpD1Ev(%0) : (!cir.ptr<!rec_Tmp>) -> ()
      }
      cir.yield
    }
    cir.return
  }
}

// -----

!u8i = !cir.int<u, 8>
!rec_Tmp = !cir.struct<"Tmp" {pad !u8i}>

module {
  cir.func private @_ZN3TmpD1Ev(!cir.ptr<!rec_Tmp>)
  cir.global "private" internal @_ZGR1r_ = #cir.zero : !rec_Tmp
  cir.global "private" internal @_ZGR1r0_ = #cir.zero : !rec_Tmp

  cir.global external @r = #cir.zero : !rec_Tmp ctor {
    cir.register_exit_dtor @_ZGR1r_ {
      // expected-error @below {{must be in the ctor region of a cir.global or cir.local_init}}
      cir.register_exit_dtor @_ZGR1r0_ {
        %0 = cir.get_global @_ZGR1r0_ : !cir.ptr<!rec_Tmp>
        cir.call @_ZN3TmpD1Ev(%0) : (!cir.ptr<!rec_Tmp>) -> ()
      }
      %0 = cir.get_global @_ZGR1r_ : !cir.ptr<!rec_Tmp>
      cir.call @_ZN3TmpD1Ev(%0) : (!cir.ptr<!rec_Tmp>) -> ()
    }
  }
}

// -----

!u8i = !cir.int<u, 8>
!rec_Tmp = !cir.struct<"Tmp" {pad !u8i}>

module {
  cir.func private @_ZN3TmpD1Ev(!cir.ptr<!rec_Tmp>)
  cir.global "private" internal @_ZGR1r_ = #cir.zero : !rec_Tmp

  cir.global external @r = #cir.zero : !rec_Tmp ctor {
    // expected-error @below {{body must not yield a value}}
    cir.register_exit_dtor @_ZGR1r_ {
      %0 = cir.get_global @_ZGR1r_ : !cir.ptr<!rec_Tmp>
      cir.call @_ZN3TmpD1Ev(%0) : (!cir.ptr<!rec_Tmp>) -> ()
      cir.yield %0 : !cir.ptr<!rec_Tmp>
    }
  }
}
