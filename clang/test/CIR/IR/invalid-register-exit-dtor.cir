  cir.global external @other = #cir.zero : !rec_Tmp dtor {
    %0 = cir.get_global @other : !cir.ptr<!rec_Tmp>
    cir.call @_ZN3TmpD1Ev(%0) : (!cir.ptr<!rec_Tmp>) -> ()
  }

  cir.global external @r = #cir.zero : !rec_Tmp ctor {
    // expected-error @below {{object must not have ctor or dtor regions}}
    cir.register_exit_dtor @other {
      %0 = cir.get_global @other : !cir.ptr<!rec_Tmp>
      cir.call @_ZN3TmpD1Ev(%0) : (!cir.ptr<!rec_Tmp>) -> ()
