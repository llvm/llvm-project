// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!u64i = !cir.int<u, 64>
!u32i = !cir.int<u, 32>

module {
  cir.func @test_coro_align() -> !u64i {
    // CHECK: %0 = cir.coro.intrinsic.align() : () -> !u64i
    %0 = cir.coro.intrinsic.align() : () -> !u64i
    cir.return %0 : !u64i
  }

  cir.func @test_coro_align_32() -> !u32i {
    // CHECK: %0 = cir.coro.intrinsic.align() : () -> !u32i
    %0 = cir.coro.intrinsic.align() : () -> !u32i
    cir.return %0 : !u32i
  }
}
