// RUN: cir-opt %s -verify-diagnostics -split-input-file

!s32i = !cir.int<s, 32>

module  {

// expected-error @below {{failed to verify 'element_type'}}
cir.global external @vec_b = #cir.zero : !cir.vector<4 x !cir.array<!s32i x 10>>

}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @scalable_vector_constant() {
    // expected-error @below {{scalable vector constants are not supported}}
    %0 = cir.const #cir.const_vector<[#cir.int<1> : !s32i, #cir.int<2> : !s32i]> : !cir.vector<[2] x !s32i, sve_data>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @scalable_vector_create() {
    %0 = cir.const #cir.int<1> : !s32i
    %1 = cir.const #cir.int<2> : !s32i
    // expected-error @below {{scalable vectors are not supported}}
    %2 = cir.vec.create(%0, %1 : !s32i, !s32i) : !cir.vector<[2] x !s32i, sve_data>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @scalable_vector_shuffle(%arg0: !cir.vector<[2] x !s32i, sve_data>,
                                    %arg1: !cir.vector<[2] x !s32i, sve_data>) {
    // expected-error @below {{scalable vectors are not supported}}
    %0 = cir.vec.shuffle(%arg0, %arg1 : !cir.vector<[2] x !s32i, sve_data>) [#cir.int<0> : !s32i, #cir.int<1> : !s32i] : !cir.vector<[2] x !s32i, sve_data>
    cir.return
  }
}

// -----

cir.func @invalid_scalable_vec_syntax() {
  // expected-error@+2 {{missing closing `]` for scalable dim size}}
  // expected-error @below {{expected ']'}}
  %3 = cir.alloca !cir.vector<[1 x] !s32i>, !cir.ptr<!cir.vector<[1] x !s32i, sve_data>> {alignment = 4 : i64}
  cir.return

}

// -----

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module  {
  cir.func @vector_shuffle_invalid_element_type() {
    %1 = cir.const #cir.int<1> : !s32i
    %2 = cir.const #cir.int<2> : !s32i
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.const #cir.int<4> : !s32i
    %vec_1 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    %vec_2 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    // expected-error @below {{element types of '!cir.vector<4 x !cir.int<s, 32>>' and '!cir.vector<4 x !cir.int<s, 64>>' don't match}}
    %new_vec = cir.vec.shuffle(%vec_1, %vec_2 : !cir.vector<4 x !s32i>) [#cir.int<7> : !s64i, #cir.int<5> : !s64i, #cir.int<3> : !s64i, #cir.int<1> : !s64i] : !cir.vector<4 x !s64i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module  {
  cir.func @vector_shuffle_different_number_of_elements() {
    %1 = cir.const #cir.int<1> : !s32i
    %2 = cir.const #cir.int<2> : !s32i
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.const #cir.int<4> : !s32i
    %vec_1 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    %vec_2 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    // expected-error @below {{the number of elements in [#cir.int<7> : !cir.int<s, 64>, #cir.int<5> : !cir.int<s, 64>, #cir.int<3> : !cir.int<s, 64>] and '!cir.vector<4 x !cir.int<s, 64>>' don't match}}
    %new_vec = cir.vec.shuffle(%vec_1, %vec_2 : !cir.vector<4 x !s32i>) [#cir.int<7> : !s64i, #cir.int<5> : !s64i, #cir.int<3> : !s64i] : !cir.vector<4 x !s64i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module  {
  cir.func @vector_create_different_size() {
    %1 = cir.const #cir.int<1> : !s32i
    %2 = cir.const #cir.int<2> : !s32i
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.const #cir.int<4> : !s32i

    // expected-error @below {{operand count of 4 doesn't match vector type '!cir.vector<8 x !cir.int<s, 32>>' element count of 8}}
    %5 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<8 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module  {
  cir.func @vector_create_different_type_size() {
    %1 = cir.const #cir.int<1> : !s32i
    %2 = cir.const #cir.int<2> : !s32i
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.const #cir.int<4> : !s64i

    // expected-error @below {{operand type '!cir.int<s, 64>' doesn't match vector element type '!cir.int<s, 32>'}}
    %5 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s64i) : !cir.vector<4 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module  {
  cir.func @vector_shift_invalid_result_type() {
    %1 = cir.const #cir.int<1> : !s32i
    %2 = cir.const #cir.int<2> : !s32i
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.const #cir.int<4> : !s32i
    %5 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    %6 = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    // expected-error @below {{the type of the result must be a vector if it is vector shift}}
    %7 = cir.shift(left, %5 : !cir.vector<4 x !s32i>, %6 : !cir.vector<4 x !s32i>) -> !s32i
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module  {
  cir.func @vector_shuffle_dynamic_different_number_of_elements() {
    %1 = cir.const #cir.int<1> : !s32i
    %2 = cir.const #cir.int<2> : !s32i
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.const #cir.int<4> : !s32i
    %vec = cir.vec.create(%1, %2, %3, %4 : !s32i, !s32i, !s32i, !s32i) : !cir.vector<4 x !s32i>
    %indices = cir.vec.create(%1, %2 : !s32i, !s32i) : !cir.vector<2 x !s32i>

    // expected-error @below {{the number of elements in '!cir.vector<4 x !cir.int<s, 32>>' and '!cir.vector<2 x !cir.int<s, 32>>' don't match}}
    %new_vec = cir.vec.shuffle.dynamic %vec : !cir.vector<4 x !s32i>, %indices : !cir.vector<2 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>

module  {
  cir.func @vector_shuffle_invalid_index_value() -> !cir.vector<4 x !s32i> {
    %vec_1 = cir.const #cir.const_vector<[#cir.int<1> : !s32i, #cir.int<3> : !s32i, #cir.int<5> : !s32i, #cir.int<7> : !s32i]> : !cir.vector<4 x !s32i>
    %vec_2 = cir.const #cir.const_vector<[#cir.int<2> : !s32i, #cir.int<4> : !s32i, #cir.int<6> : !s32i, #cir.int<8> : !s32i]> : !cir.vector<4 x !s32i>

    // expected-error @below {{index for __builtin_shufflevector must be less than the total number of vector elements}}
    %new_vec = cir.vec.shuffle(%vec_1, %vec_2 : !cir.vector<4 x !s32i>) [#cir.int<9> : !s64i, #cir.int<4> : !s64i,
      #cir.int<1> : !s64i, #cir.int<5> : !s64i] : !cir.vector<4 x !s32i>
    cir.return %new_vec : !cir.vector<4 x !s32i>
  }
}

// -----

!s32i = !cir.int<s, 32>

module  {

// expected-error @below {{the number of vector elements must be non-zero}}
cir.global external @vec_a = #cir.zero : !cir.vector<0 x !s32i>

}

// -----

!s32i = !cir.int<s, 32>

// expected-error @below {{a scalable vector must have a vector kind}}
cir.func private @scalable_generic(!cir.vector<[4] x !s32i>)

// -----

!s32i = !cir.int<s, 32>

// expected-error @below {{expected 'sve_data' or 'sve_predicate'}}
cir.func private @kind_generic(!cir.vector<4 x !s32i, generic>)

// -----

!s32i = !cir.int<s, 32>

// expected-error @below {{expected 'sve_data' or 'sve_predicate'}}
cir.func private @kind_unknown(!cir.vector<4 x !s32i, neon>)

// -----

// expected-error @below {{an SVE data vector must have 8-, 16-, 32-, or 64-bit integer elements or mfp8, f16, bf16, float, or double elements}}
cir.func private @sve_data_bitint(!cir.vector<[4] x !cir.int<s, 32, bitint>, sve_data>)

// -----

// expected-error @below {{an SVE data vector must have 8-, 16-, 32-, or 64-bit integer elements or mfp8, f16, bf16, float, or double elements}}
cir.func private @sve_data_s24(!cir.vector<[4] x !cir.int<s, 24>, sve_data>)

// -----

// expected-error @below {{an SVE data vector must have 8-, 16-, 32-, or 64-bit integer elements or mfp8, f16, bf16, float, or double elements}}
cir.func private @sve_data_u1(!cir.vector<[16] x !cir.int<u, 1>, sve_data>)

// -----

// expected-error @below {{an SVE data vector must have 8-, 16-, 32-, or 64-bit integer elements or mfp8, f16, bf16, float, or double elements}}
cir.func private @sve_data_bool(!cir.vector<16 x !cir.bool, sve_data>)

// -----

// expected-error @below {{an SVE data vector must have 8-, 16-, 32-, or 64-bit integer elements or mfp8, f16, bf16, float, or double elements}}
cir.func private @sve_data_f80(!cir.vector<[1] x !cir.long_double<!cir.f80>, sve_data>)

// -----

// expected-error @below {{a NEON mfp8 vector must have 8 or 16 elements}}
cir.func private @neon_mfp8_4(!cir.vector<4 x !cir.mfp8>)

// -----

// expected-error @below {{a NEON mfp8 vector must have 8 or 16 elements}}
cir.func private @neon_mfp8_32(!cir.vector<32 x !cir.mfp8>)

// -----

// expected-error @below {{an SVE mfp8 vector must have [16] elements, or a power-of-two number of elements from 16 to 256}}
cir.func private @sve_mfp8_scalable_8(!cir.vector<[8] x !cir.mfp8, sve_data>)

// -----

// expected-error @below {{an SVE mfp8 vector must have [16] elements, or a power-of-two number of elements from 16 to 256}}
cir.func private @sve_mfp8_fixed_8(!cir.vector<8 x !cir.mfp8, sve_data>)

// -----

// expected-error @below {{an SVE mfp8 vector must have [16] elements, or a power-of-two number of elements from 16 to 256}}
cir.func private @sve_mfp8_fixed_48(!cir.vector<48 x !cir.mfp8, sve_data>)

// -----

// expected-error @below {{an SVE mfp8 vector must have [16] elements, or a power-of-two number of elements from 16 to 256}}
cir.func private @sve_mfp8_fixed_512(!cir.vector<512 x !cir.mfp8, sve_data>)

// -----

// expected-error @below {{an SVE predicate vector must have '!cir.int<u, 1>' elements}}
cir.func private @sve_pred_u8(!cir.vector<[16] x !cir.int<u, 8>, sve_predicate>)

// -----

// expected-error @below {{an SVE predicate vector must have '!cir.int<u, 1>' elements}}
cir.func private @sve_pred_bool(!cir.vector<[16] x !cir.bool, sve_predicate>)

// -----

// expected-error @below {{an SVE predicate vector must have '!cir.int<u, 8>' elements}}
cir.func private @sve_fixed_pred_u1(!cir.vector<64 x !cir.int<u, 1>, sve_predicate>)

// -----

// expected-error @below {{an SVE predicate vector must have '!cir.int<u, 8>' elements}}
cir.func private @sve_fixed_pred_s8(!cir.vector<8 x !cir.int<s, 8>, sve_predicate>)

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @ldexp_vector_length_mismatch(%a: !cir.vector<4 x !cir.float>, %e: !cir.vector<8 x !s32i>) {
    // expected-error @below {{exponent must have the same number of elements as the value}}
    %0 = cir.ldexp %a, %e : !cir.vector<4 x !cir.float>, !cir.vector<8 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @ldexp_vector_scalar_mismatch(%a: !cir.vector<4 x !cir.float>, %e: !s32i) {
    // expected-error @below {{exponent must have the same number of elements as the value}}
    %0 = cir.ldexp %a, %e : !cir.vector<4 x !cir.float>, !s32i
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_cmp_one(%a: !cir.vector<4 x !s32i>, %b: !cir.vector<4 x !s32i>) {
    // expected-error @below {{'cir.vec.cmp' op attribute 'kind' failed to satisfy constraint: compare operation kind whose value is none of {one, uno}}}
    %0 = cir.vec.cmp(one, %a, %b) : !cir.vector<4 x !s32i>, !cir.vector<4 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_cmp_uno(%a: !cir.vector<4 x !s32i>, %b: !cir.vector<4 x !s32i>) {
    // expected-error @below {{'cir.vec.cmp' op attribute 'kind' failed to satisfy constraint: compare operation kind whose value is none of {one, uno}}}
    %0 = cir.vec.cmp(uno, %a, %b) : !cir.vector<4 x !s32i>, !cir.vector<4 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_cmp_float_result(%a: !cir.vector<4 x !s32i>, %b: !cir.vector<4 x !s32i>) {
    // expected-error @below {{'cir.vec.cmp' op result #0 must be vector of any of boolean type, integer type, but got '!cir.vector<4 x !cir.float>'}}
    %0 = cir.vec.cmp(lt, %a, %b) : !cir.vector<4 x !s32i>, !cir.vector<4 x !cir.float>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_cmp_result_length_mismatch(%a: !cir.vector<4 x !s32i>, %b: !cir.vector<4 x !s32i>) {
    // expected-error @below {{'cir.vec.cmp' op failed to verify that all of {lhs, result} have same element count}}
    %0 = cir.vec.cmp(lt, %a, %b) : !cir.vector<4 x !s32i>, !cir.vector<2 x !s32i>
    cir.return
  }
}

// -----

module {
  cir.func @vec_fcmp_float_result(%a: !cir.vector<4 x !cir.float>, %b: !cir.vector<4 x !cir.float>) {
    // expected-error @below {{'cir.vec.fcmp' op result #0 must be vector of any of boolean type, integer type, but got '!cir.vector<4 x !cir.float>'}}
    %0 = cir.vec.fcmp(olt, %a, %b) : !cir.vector<4 x !cir.float>, !cir.vector<4 x !cir.float>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_fcmp_result_length_mismatch(%a: !cir.vector<4 x !cir.float>, %b: !cir.vector<4 x !cir.float>) {
    // expected-error @below {{'cir.vec.fcmp' op failed to verify that all of {lhs, result} have same element count}}
    %0 = cir.vec.fcmp(olt, %a, %b) : !cir.vector<4 x !cir.float>, !cir.vector<8 x !s32i>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module {
  cir.func @vec_fcmp_scalable_result(%a: !cir.vector<4 x !cir.float>, %b: !cir.vector<4 x !cir.float>) {
    // expected-error @below {{'cir.vec.fcmp' op failed to verify that all of {lhs, result} have same element count}}
    %0 = cir.vec.fcmp(true, %a, %b) : !cir.vector<4 x !cir.float>, !cir.vector<[4] x !s32i, sve_data>
    cir.return
  }
}
