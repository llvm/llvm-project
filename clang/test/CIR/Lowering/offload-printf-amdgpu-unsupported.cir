// RUN: cir-opt %s --cir-to-llvm -verify-diagnostics

// Hostcall printf passes each argument as a 64-bit word, so it has no encoding
// for a vector.

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.triple = "amdgpu-amd-amdhsa",
                   cir.amdgpu_printf_kind = "hostcall"} {
  cir.func @p(%fmt: !cir.ptr<!s8i>, %v: !cir.vector<4 x !s32i>) -> !s32i {
    // expected-error @below {{unsupported argument type '!cir.vector<4 x !cir.int<s, 32>>' for AMDGPU printf}}
    // expected-error @below {{failed to legalize operation 'cir.offload.printf'}}
    %0 = cir.offload.printf(%fmt, %v) : (!cir.ptr<!s8i>, !cir.vector<4 x !s32i>) -> !s32i
    cir.return %0 : !s32i
  }
}
