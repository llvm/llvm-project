// RUN: cir-opt %s -cir-to-llvm | FileCheck %s

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @target() attributes {uniform_work_group_size} {
    cir.return
  }
  cir.func @alias() alias(@target) attributes {uniform_work_group_size}
}

// CHECK-LABEL: llvm.mlir.alias external @alias
// CHECK-NOT: uniform_work_group_size
