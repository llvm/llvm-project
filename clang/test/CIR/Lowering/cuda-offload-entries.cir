// RUN: cir-translate %s -cir-to-llvmir --disable-cc-lowering --split-input-file \
// RUN:   -verify-diagnostics -o - | FileCheck %s

!s32i = !cir.int<s, 32>
module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.cu.offload_entries = [
    #cir.cu.offload_entry<kind = 4, addr = @_Z1kv, name = "_Z1kv", size = 0, flags = 0, data = 0>,
    #cir.cu.offload_entry<kind = 4, addr = @mv.managed, name = "mv", size = 4, flags = 1, data = 4, aux_addr = @mv>]} {
  cir.global external @mv.managed = #cir.int<1> : !s32i align(4)
  cir.global external @mv = #cir.ptr<null> : !cir.ptr<!s32i>
  cir.global constant external @_Z1kv = #cir.global_view<@_Z16__device_stub__kv> : !cir.ptr<!cir.func<()>> align(8)
  cir.func @_Z16__device_stub__kv() {
    cir.return
  }
}

// CHECK: @.offloading.entry_name = internal unnamed_addr constant [6 x i8] c"_Z1kv\00", section ".llvm.rodata.offloading", align 1
// CHECK: @.offloading.entry._Z1kv = weak constant %struct.__tgt_offload_entry { i64 0, i16 1, i16 4, i32 0, ptr @_Z1kv, ptr @.offloading.entry_name, i64 0, i64 0, ptr null }, section "llvm_offload_entries", align 8
// CHECK: @.offloading.entry_name.1 = internal unnamed_addr constant [3 x i8] c"mv\00", section ".llvm.rodata.offloading", align 1
// CHECK: @.offloading.entry.mv = weak constant %struct.__tgt_offload_entry { i64 0, i16 1, i16 4, i32 1, ptr @mv.managed, ptr @.offloading.entry_name.1, i64 4, i64 4, ptr @mv }, section "llvm_offload_entries", align 8

// -----

// expected-error @below {{offloading entry refers to undefined symbol @missing}}
module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.cu.offload_entries = [
    #cir.cu.offload_entry<kind = 4, addr = @missing, name = "missing", size = 0, flags = 0, data = 0>]} {
}

// -----

!s32i = !cir.int<s, 32>
// expected-error @below {{offloading entry refers to undefined symbol @missing}}
module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.cu.offload_entries = [
    #cir.cu.offload_entry<kind = 4, addr = @mv.managed, name = "mv", size = 4, flags = 1, data = 4, aux_addr = @missing>]} {
  cir.global external @mv.managed = #cir.int<1> : !s32i align(4)
}
