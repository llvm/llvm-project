// RUN: cir-opt %s -cir-to-llvm -o - | FileCheck %s

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
!s64i = !cir.int<s, 64>

module {
  // CHECK-LABEL: llvm.func @fadd_variants
  cir.func @fadd_variants(%a: !cir.float, %b: !cir.float) {
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest strict : f32
    %0 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = tonearest, except_mode = unknown, strict_except = true>

    // CHECK: llvm.fadd %{{.*}}, %{{.*}} : f32
    %1 = cir.fadd %a, %b : !cir.float

    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest ignore : f32
    %2 = cir.fadd %a, %b : !cir.float fenv<>
    cir.return
  }

  // CHECK-LABEL: llvm.func @rounding_modes
  cir.func @rounding_modes(%a: !cir.float, %b: !cir.float) {
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest ignore : f32
    %0 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = tonearest>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} downward ignore : f32
    %1 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = downward>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} upward ignore : f32
    %2 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = upward>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} towardzero ignore : f32
    %3 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = upwardzero>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearestaway ignore : f32
    %4 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = tonearestaway>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} dynamic ignore : f32
    %5 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = unknown>
    cir.return
  }

  // CHECK-LABEL: llvm.func @exception_behaviors
  cir.func @exception_behaviors(%a: !cir.float, %b: !cir.float) {
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest strict : f32
    %0 = cir.fadd %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest maytrap : f32
    %1 = cir.fadd %a, %b : !cir.float fenv<strict_except = false>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest ignore : f32
    %2 = cir.fadd %a, %b : !cir.float fenv<except_mode = masked, strict_except = false>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest ignore : f32
    %3 = cir.fadd %a, %b : !cir.float fenv<dynamic_rounding_mode = tonearest>
    cir.return
  }

  // CHECK-LABEL: llvm.func @all_binops
  cir.func @all_binops(%a: !cir.double, %b: !cir.double) {
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest strict : f64
    %0 = cir.fadd %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fsub %{{.*}}, %{{.*}} tonearest strict : f64
    %1 = cir.fsub %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fmul %{{.*}}, %{{.*}} tonearest strict : f64
    %2 = cir.fmul %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fdiv %{{.*}}, %{{.*}} tonearest strict : f64
    %3 = cir.fdiv %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.frem %{{.*}}, %{{.*}} tonearest strict : f64
    %4 = cir.frem %a, %b : !cir.double fenv<strict_except = true>
    cir.return
  }

  // CHECK-LABEL: llvm.func @vector_binop
  cir.func @vector_binop(%a: !cir.vector<4 x !cir.float>,
                         %b: !cir.vector<4 x !cir.float>) {
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest strict : vector<4xf32>
    %0 = cir.fadd %a, %b : !cir.vector<4 x !cir.float> fenv<strict_except = true>
    cir.return
  }

  // CHECK-LABEL: llvm.func @unary_fp_builtins
  cir.func @unary_fp_builtins(%a: !cir.double) {
    // CHECK: llvm.intr.experimental.constrained.cos %{{.*}} tonearest strict : f64
    %0 = cir.cos %a : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.sqrt %{{.*}} tonearest strict : f64
    %1 = cir.sqrt %a : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.ceil %{{.*}} strict : f64
    %2 = cir.ceil %a : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.fabs(%{{.*}}) : (f64) -> f64
    %3 = cir.fabs %a : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.cos(%{{.*}}) : (f64) -> f64
    %4 = cir.cos %a : !cir.double
    cir.return
  }

  // CHECK-LABEL: llvm.func @binary_fp_builtins
  cir.func @binary_fp_builtins(%a: !cir.double, %b: !cir.double) {
    // CHECK: llvm.intr.experimental.constrained.pow %{{.*}}, %{{.*}} tonearest strict : f64
    %0 = cir.pow %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.atan2 %{{.*}}, %{{.*}} tonearest strict : f64
    %1 = cir.atan2 %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.frem %{{.*}}, %{{.*}} tonearest strict : f64
    %2 = cir.fmod %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.maximum %{{.*}}, %{{.*}} strict : f64
    %3 = cir.fmaximum %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.minimum %{{.*}}, %{{.*}} strict : f64
    %4 = cir.fminimum %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.copysign(%{{.*}}, %{{.*}}) : (f64, f64) -> f64
    %5 = cir.copysign %a, %b : !cir.double fenv<strict_except = true>
    cir.return
  }

  // CHECK-LABEL: llvm.func @ldexp_variants
  cir.func @ldexp_variants(%a: !cir.double, %e: !s32i) {
    // CHECK: llvm.intr.ldexp(%{{.*}}, %{{.*}}) : (f64, i32) -> f64
    %0 = cir.ldexp %a, %e : !cir.double, !s32i
    // CHECK: llvm.intr.experimental.constrained.ldexp %{{.*}}, %{{.*}} upward strict : (f64, i32) -> f64
    %1 = cir.ldexp %a, %e : !cir.double, !s32i fenv<dynamic_rounding_mode = upward, except_mode = unknown, strict_except = true>
    cir.return
  }

  // CHECK-LABEL: llvm.func @ldexp_vector_variants
  cir.func @ldexp_vector_variants(%a: !cir.vector<4 x !cir.float>, %e: !cir.vector<4 x !s32i>) {
    // CHECK: llvm.intr.ldexp(%{{.*}}, %{{.*}}) : (vector<4xf32>, vector<4xi32>) -> vector<4xf32>
    %0 = cir.ldexp %a, %e : !cir.vector<4 x !cir.float>, !cir.vector<4 x !s32i>
    // CHECK: llvm.intr.experimental.constrained.ldexp %{{.*}}, %{{.*}} upward strict : (vector<4xf32>, vector<4xi32>) -> vector<4xf32>
    %1 = cir.ldexp %a, %e : !cir.vector<4 x !cir.float>, !cir.vector<4 x !s32i> fenv<dynamic_rounding_mode = upward, except_mode = unknown, strict_except = true>
    cir.return
  }

  // CHECK-LABEL: llvm.func @ternary_fp_builtins
  cir.func @ternary_fp_builtins(%a: !cir.double, %b: !cir.double,
                                %c: !cir.double) {
    // CHECK: llvm.intr.experimental.constrained.fma %{{.*}}, %{{.*}}, %{{.*}} tonearest strict : f64
    %0 = cir.fma %a, %b, %c : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.fma(%{{.*}}, %{{.*}}, %{{.*}}) : (f64, f64, f64) -> f64
    %1 = cir.fma %a, %b, %c : !cir.double
    // CHECK: llvm.intr.experimental.constrained.fmuladd %{{.*}}, %{{.*}}, %{{.*}} tonearest strict : f64
    %2 = cir.fmuladd %a, %b, %c : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.fmuladd(%{{.*}}, %{{.*}}, %{{.*}}) : (f64, f64, f64) -> f64
    %3 = cir.fmuladd %a, %b, %c : !cir.double
    cir.return
  }

  // CHECK-LABEL: llvm.func @ternary_fp_vec_builtins
  cir.func @ternary_fp_vec_builtins(%a: !cir.vector<4 x !cir.float>,
                                    %b: !cir.vector<4 x !cir.float>,
                                    %c: !cir.vector<4 x !cir.float>) {
    // CHECK: llvm.intr.experimental.constrained.fma %{{.*}}, %{{.*}}, %{{.*}} tonearest strict : vector<4xf32>
    %0 = cir.fma %a, %b, %c : !cir.vector<4 x !cir.float> fenv<strict_except = true>
    // CHECK: llvm.intr.fma(%{{.*}}, %{{.*}}, %{{.*}}) : (vector<4xf32>, vector<4xf32>, vector<4xf32>) -> vector<4xf32>
    %1 = cir.fma %a, %b, %c : !cir.vector<4 x !cir.float>
    // CHECK: llvm.intr.experimental.constrained.fmuladd %{{.*}}, %{{.*}}, %{{.*}} tonearest strict : vector<4xf32>
    %2 = cir.fmuladd %a, %b, %c : !cir.vector<4 x !cir.float> fenv<strict_except = true>
    // CHECK: llvm.intr.fmuladd(%{{.*}}, %{{.*}}, %{{.*}}) : (vector<4xf32>, vector<4xf32>, vector<4xf32>) -> vector<4xf32>
    %3 = cir.fmuladd %a, %b, %c : !cir.vector<4 x !cir.float>
    cir.return
  }

  // CHECK-LABEL: llvm.func @minmax_num
  cir.func @minmax_num(%a: !cir.double, %b: !cir.double) {
    // CHECK: llvm.intr.experimental.constrained.maxnum %{{.*}}, %{{.*}} strict fastmath<nsz> : f64
    %0 = cir.fmaxnum %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.minnum %{{.*}}, %{{.*}} strict fastmath<nsz> : f64
    %1 = cir.fminnum %a, %b : !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.maxnum(%{{.*}}, %{{.*}}) fastmath<nsz> : (f64, f64) -> f64
    %2 = cir.fmaxnum %a, %b : !cir.double
    // CHECK: llvm.intr.minnum(%{{.*}}, %{{.*}}) fastmath<nsz> : (f64, f64) -> f64
    %3 = cir.fminnum %a, %b : !cir.double
    cir.return
  }

  // CHECK-LABEL: llvm.func @fp_casts
  cir.func @fp_casts(%a: !cir.float, %b: !cir.double, %i: !s32i, %u: !u32i) {
    // CHECK: llvm.intr.experimental.constrained.fptrunc %{{.*}} tonearest strict : f64 to f32
    %0 = cir.cast floating %b : !cir.double -> !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fpext %{{.*}} strict : f32 to f64
    %1 = cir.cast floating %a : !cir.float -> !cir.double fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.sitofp %{{.*}} tonearest strict : i32 to f32
    %2 = cir.cast int_to_float %i : !s32i -> !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fptosi %{{.*}} strict : f32 to i32
    %3 = cir.cast float_to_int %a : !cir.float -> !s32i fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.uitofp %{{.*}} downward maytrap : i32 to f32
    %6 = cir.cast int_to_float %u : !u32i -> !cir.float fenv<dynamic_rounding_mode = downward, strict_except = false>
    // CHECK: llvm.intr.experimental.constrained.fptoui %{{.*}} strict : f32 to i32
    %7 = cir.cast float_to_int %a : !cir.float -> !u32i fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fptrunc %{{.*}} upward strict : f64 to f32
    %8 = cir.cast floating %b : !cir.double -> !cir.float fenv<dynamic_rounding_mode = upward, strict_except = true>
    // Without fenv the plain LLVM cast ops are used.
    // CHECK: llvm.fptrunc %{{.*}} : f64 to f32
    %4 = cir.cast floating %b : !cir.double -> !cir.float
    // CHECK: llvm.fpext %{{.*}} : f32 to f64
    %5 = cir.cast floating %a : !cir.float -> !cir.double
    cir.return
  }

  // CHECK-LABEL: llvm.func @fp_cmp
  cir.func @fp_cmp(%a: !cir.float, %b: !cir.float) {
    // CHECK: llvm.intr.experimental.constrained.fcmps olt %{{.*}}, %{{.*}} strict : f32
    %0 = cir.cmp lt %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmps ole %{{.*}}, %{{.*}} strict : f32
    %1 = cir.cmp le %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmps ogt %{{.*}}, %{{.*}} strict : f32
    %2 = cir.cmp gt %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmps oge %{{.*}}, %{{.*}} strict : f32
    %3 = cir.cmp ge %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmp oeq %{{.*}}, %{{.*}} strict : f32
    %4 = cir.cmp eq %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmp une %{{.*}}, %{{.*}} strict : f32
    %5 = cir.cmp ne %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmp one %{{.*}}, %{{.*}} strict : f32
    %6 = cir.cmp one %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.fcmp uno %{{.*}}, %{{.*}} strict : f32
    %7 = cir.cmp uno %a, %b : !cir.float fenv<strict_except = true>
    // CHECK: llvm.fcmp "olt" %{{.*}}, %{{.*}} : f32
    %8 = cir.cmp lt %a, %b : !cir.float
    cir.return
  }

  // CHECK-LABEL: llvm.func @fp_vec_cmp
  cir.func @fp_vec_cmp(%a: !cir.vector<4 x !cir.float>,
                       %b: !cir.vector<4 x !cir.float>) {
    // CHECK: %[[CMP:.*]] = llvm.intr.experimental.constrained.fcmps ogt %{{.*}}, %{{.*}} strict : vector<4xf32>
    // CHECK: llvm.sext %[[CMP]] : vector<4xi1> to vector<4xi32>
    %0 = cir.vec.fcmp(ogt, %a, %b) : !cir.vector<4 x !cir.float>, !cir.vector<4 x !s32i>
         signaling fenv<strict_except = true>
    // CHECK: %[[CMP_EQ:.*]] = llvm.intr.experimental.constrained.fcmp oeq %{{.*}}, %{{.*}} strict : vector<4xf32>
    // CHECK: llvm.sext %[[CMP_EQ]] : vector<4xi1> to vector<4xi32>
    %1 = cir.vec.fcmp(oeq, %a, %b) : !cir.vector<4 x !cir.float>, !cir.vector<4 x !s32i>
         fenv<strict_except = true>
    // CHECK: llvm.fcmp "olt" %{{.*}}, %{{.*}} : vector<4xf32>
    // CHECK: llvm.sext %{{.*}} : vector<4xi1> to vector<4xi32>
    %2 = cir.vec.fcmp(olt, %a, %b) : !cir.vector<4 x !cir.float>, !cir.vector<4 x !s32i> signaling
    cir.return
  }

  // CHECK-LABEL: llvm.func @unary_fp_to_int_builtins
  cir.func @unary_fp_to_int_builtins(%a: !cir.double) {
    // CHECK: llvm.intr.experimental.constrained.lround %{{.*}} strict : f64 to i64
    %0 = cir.lround %a : !cir.double -> !s64i fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.llround %{{.*}} strict : f64 to i64
    %1 = cir.llround %a : !cir.double -> !s64i fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.lrint %{{.*}} tonearest strict : f64 to i64
    %2 = cir.lrint %a : !cir.double -> !s64i fenv<strict_except = true>
    // CHECK: llvm.intr.experimental.constrained.llrint %{{.*}} tonearest strict : f64 to i64
    %3 = cir.llrint %a : !cir.double -> !s64i fenv<strict_except = true>
    // CHECK: llvm.intr.lround(%{{.*}}) : (f64) -> i64
    %4 = cir.lround %a : !cir.double -> !s64i
    cir.return
  }

  // CHECK-LABEL: llvm.func @fastmath_flags
  cir.func @fastmath_flags(%a: !cir.float, %b: !cir.float) {
    // CHECK: llvm.fmul %{{.*}}, %{{.*}} fastmath<contract> : f32
    %0 = cir.fmul %a, %b : !cir.float <fastmath_flags = [contract]>
    // CHECK: llvm.intr.experimental.constrained.fadd %{{.*}}, %{{.*}} tonearest ignore fastmath<contract> : f32
    %1 = cir.fadd %0, %b : !cir.float fenv<> <fastmath_flags = [contract]>
    cir.return
  }
}
