// RUN: cir-translate %s -cir-to-llvmir --target amdgpu9.0a-amd-amdhsa --disable-cc-lowering --split-input-file -o - \
// RUN:   | FileCheck %s --check-prefixes=HOSTCALL,BUFFERED

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "hostcall"} {
  cir.func @hostcall(%fmt: !cir.ptr<!s8i>, %v: !s32i) -> !s32i {
    %0 = cir.offload.printf(%fmt, %v) : (!cir.ptr<!s8i>, !s32i) -> !s32i
    cir.return %0 : !s32i
  }
}

// The format is not a constant, so its length is computed at runtime.
// HOSTCALL-LABEL: define{{.*}} i32 @hostcall(ptr %0, i32 %1)
// HOSTCALL: [[DESC:%.*]] = call i64 @__ockl_printf_begin(i64 0)
// HOSTCALL: [[ISNULL:%.*]] = icmp eq ptr %0, null
// HOSTCALL: br i1 [[ISNULL]], label %[[JOIN:.*]], label %[[WHILE:.*]]
// HOSTCALL: [[WHILE]]:
// HOSTCALL: [[CUR:%.*]] = phi ptr [ [[NEXT:%.*]], %[[WHILE]] ], [ %0, %{{.*}} ]
// HOSTCALL: [[NEXT]] = getelementptr i8, ptr [[CUR]], i64 1
// HOSTCALL: [[CH:%.*]] = load i8, ptr [[CUR]], align 1
// HOSTCALL: [[ISNUL:%.*]] = icmp eq i8 [[CH]], 0
// HOSTCALL: br i1 [[ISNUL]], label %[[DONE:.*]], label %[[WHILE]]
// HOSTCALL: [[DONE]]:
// HOSTCALL: [[END:%.*]] = ptrtoaddr ptr [[CUR]] to i64
// HOSTCALL: [[BEGIN:%.*]] = ptrtoaddr ptr %0 to i64
// HOSTCALL: [[DIFF:%.*]] = sub i64 [[END]], [[BEGIN]]
// HOSTCALL: [[LEN:%.*]] = add i64 [[DIFF]], 1
// HOSTCALL: br label %[[JOIN]]
// HOSTCALL: [[JOIN]]:
// HOSTCALL: [[SIZE:%.*]] = phi i64 [ [[LEN]], %[[DONE]] ], [ 0, %{{.*}} ]
// HOSTCALL: [[DESC1:%.*]] = call i64 @__ockl_printf_append_string_n(i64 [[DESC]], ptr %0, i64 [[SIZE]], i32 0)
// HOSTCALL: [[ARG:%.*]] = zext i32 %1 to i64
// HOSTCALL: [[DESC2:%.*]] = call i64 @__ockl_printf_append_args(i64 [[DESC1]], i32 1, i64 [[ARG]], i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i32 1)
// HOSTCALL: [[RES:%.*]] = trunc i64 [[DESC2]] to i32
// HOSTCALL: ret i32 [[RES]]
// HOSTCALL-NOT: !llvm.printf.fmts

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "hostcall"} {
  cir.func @hostcall_constant_as(%fmt: !cir.ptr<!s8i, target_address_space(4)>) -> !s32i {
    %0 = cir.offload.printf(%fmt) : (!cir.ptr<!s8i, target_address_space(4)>) -> !s32i
    cir.return %0 : !s32i
  }
}

// The length of a string outside the generic address space is computed in its
// own address space, but the string is passed to the device library as a
// generic pointer, so the declaration matches the device library.
// HOSTCALL: declare i64 @__ockl_printf_append_string_n(i64, ptr, i64, i32)
// HOSTCALL-LABEL: define{{.*}} i32 @hostcall_constant_as(ptr addrspace(4) %0)
// HOSTCALL: icmp eq ptr addrspace(4) %0, null
// HOSTCALL: load i8, ptr addrspace(4) %{{.*}}, align 1
// HOSTCALL: [[STR:%.*]] = addrspacecast ptr addrspace(4) %0 to ptr
// HOSTCALL: call i64 @__ockl_printf_append_string_n(i64 %{{.*}}, ptr [[STR]], i64 %{{.*}}, i32 1)

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"%d %s\0A" : !cir.array<!s8i x 6>, trailing_zeros> : !cir.array<!s8i x 7>
  cir.func @buffered(%v: !s32i, %str: !cir.ptr<!s8i>) -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 7>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 7>> -> !cir.ptr<!s8i>
    %2 = cir.offload.printf(%1, %v, %str) : (!cir.ptr<!s8i>, !s32i, !cir.ptr<!s8i>) -> !s32i
    cir.return %2 : !s32i
  }
}

// The format is a constant and only its hash (the low 64 bits of its MD5,
// which also keys the !llvm.printf.fmts entry) is stored. The %s argument is not
// a constant, so it is copied after its length is computed at runtime.
// BUFFERED-LABEL: define{{.*}} i32 @buffered(i32 %0, ptr %1)
// BUFFERED: icmp eq ptr %1, null
// BUFFERED: getelementptr i8, ptr %{{.*}}, i64 1
// BUFFERED: [[LEN:%.*]] = phi i64
// BUFFERED: [[ADD:%.*]] = add i64 [[LEN]], 7
// BUFFERED: [[ALIGNED:%.*]] = and i64 [[ADD]], 4294967288
// BUFFERED: [[SUM:%.*]] = add i64 [[ALIGNED]], 20
// BUFFERED: [[SIZE:%.*]] = trunc i64 [[SUM]] to i32
// BUFFERED: [[BUF:%.*]] = call ptr addrspace(1) @__printf_alloc(i32 [[SIZE]])
// BUFFERED: [[OK:%.*]] = icmp ne ptr addrspace(1) [[BUF]], null
// BUFFERED: br i1 [[OK]], label %[[PUSH:.*]], label %[[CONT:.*]]
// BUFFERED: [[PUSH]]:
// BUFFERED: [[SHL:%.*]] = shl i32 [[SIZE]], 2
// BUFFERED: [[CTRL:%.*]] = or i32 [[SHL]], 2
// BUFFERED: store i32 [[CTRL]], ptr addrspace(1) [[BUF]], align 4
// BUFFERED: [[P1:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[BUF]], i32 4
// BUFFERED: store i64 -3179066091271850508, ptr addrspace(1) [[P1]], align 8
// BUFFERED: [[P2:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[P1]], i32 8
// BUFFERED: [[ARG:%.*]] = zext i32 %0 to i64
// BUFFERED: store i64 [[ARG]], ptr addrspace(1) [[P2]], align 8
// BUFFERED: [[P3:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[P2]], i32 8
// BUFFERED: call void @llvm.memcpy.p1.p0.i64(ptr addrspace(1) align 1 [[P3]], ptr align 1 %1, i64 [[LEN]], i1 false)
// BUFFERED: br label %[[CONT]]
// BUFFERED: [[CONT]]:
// BUFFERED: [[FAIL:%.*]] = xor i1 [[OK]], true
// BUFFERED: [[RES:%.*]] = sext i1 [[FAIL]] to i32
// BUFFERED: ret i32 [[RES]]
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:d3e1b03bc04075f4,%d %s\0A"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"%p %d\0A" : !cir.array<!s8i x 6>, trailing_zeros> : !cir.array<!s8i x 7>
  cir.func @buffered_small_arg(%p: !cir.ptr<!s32i, target_address_space(3)>, %v: !s32i) -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 7>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 7>> -> !cir.ptr<!s8i>
    %2 = cir.offload.printf(%1, %p, %v) : (!cir.ptr<!s8i>, !cir.ptr<!s32i, target_address_space(3)>, !s32i) -> !s32i
    cir.return %2 : !s32i
  }
}

// An argument stored in fewer than 8 bytes, here a 32-bit pointer, still takes
// an 8-byte slot, so the next argument starts 8 bytes after it.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_small_arg(ptr addrspace(3) %0, i32 %1)
// BUFFERED: [[BUF:%.*]] = call ptr addrspace(1) @__printf_alloc(i32 28)
// BUFFERED: [[P1:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[BUF]], i32 4
// BUFFERED: [[P2:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[P1]], i32 8
// BUFFERED: store ptr addrspace(3) %0, ptr addrspace(1) [[P2]], align 4
// BUFFERED: [[P3:%.*]] = getelementptr inbounds i8, ptr addrspace(1) [[P2]], i32 8
// BUFFERED: [[ARG:%.*]] = zext i32 %1 to i64
// BUFFERED: store i64 [[ARG]], ptr addrspace(1) [[P3]], align 8

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>
!u8i = !cir.int<u, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"0123456789ABCDEFGHIJKLMNOPQRSTUV" : !cir.array<!s8i x 32>, trailing_zeros> : !cir.array<!s8i x 33>
  cir.func @buffered_unsigned_stride() -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 33>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!s8i>
    %2 = cir.const #cir.int<200> : !u8i
    %3 = cir.ptr_stride %1, %2 : (!cir.ptr<!s8i>, !u8i) -> !cir.ptr<!s8i>
    %4 = cir.const #cir.int<-195> : !s32i
    %5 = cir.ptr_stride %3, %4 : (!cir.ptr<!s8i>, !s32i) -> !cir.ptr<!s8i>
    %6 = cir.offload.printf(%5) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %6 : !s32i
  }
}

// An unsigned narrow index stays unsigned: 200 + (-195) = 5.
// Read as signed, the first stride would be -56 and the offset
// out of range, so nothing would fold.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_unsigned_stride()
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 12)
// BUFFERED: store i64 -3575341472883867058, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:ce61d5df9609024e,56789ABCDEFGHIJKLMNOPQRSTUV"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.func @buffered_late_global(%v: !s32i, %str: !cir.ptr<!s8i>) -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 7>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 7>> -> !cir.ptr<!s8i>
    %2 = cir.offload.printf(%1, %v, %str) : (!cir.ptr<!s8i>, !s32i, !cir.ptr<!s8i>) -> !s32i
    cir.return %2 : !s32i
  }
  cir.global "private" constant cir_private @".str" = #cir.const_array<"%d %s\0A" : !cir.array<!s8i x 6>, trailing_zeros> : !cir.array<!s8i x 7>
}

// The global is defined after the function.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_late_global(i32 %0, ptr %1)
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:d3e1b03bc04075f4,%d %s\0A"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"0123456789ABCDEFGHIJKLMNOPQRSTUV" : !cir.array<!s8i x 32>, trailing_zeros> : !cir.array<!s8i x 33>
  cir.func @buffered_negative_stride() -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 33>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!s8i>
    %2 = cir.const #cir.int<64> : !s32i
    %3 = cir.ptr_stride %1, %2 : (!cir.ptr<!s8i>, !s32i) -> !cir.ptr<!s8i>
    %4 = cir.const #cir.int<-56> : !s8i
    %5 = cir.ptr_stride %3, %4 : (!cir.ptr<!s8i>, !s8i) -> !cir.ptr<!s8i>
    %6 = cir.offload.printf(%5) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %6 : !s32i
  }
}

// A negative signed stride subtracts: the folded format is the string at
// byte 64 - 56 = 8.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_negative_stride()
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 12)
// BUFFERED: store i64 6552682480851187470, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:5aefcdffad0f770e,89ABCDEFGHIJKLMNOPQRSTUV"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"0123456789ABCDEFGHIJKLMNOPQRSTUV" : !cir.array<!s8i x 32>, trailing_zeros> : !cir.array<!s8i x 33>
  cir.func @buffered_get_element() -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 33>>
    %idx = cir.const #cir.int<11> : !s32i
    %1 = cir.get_element %0[%idx : !s32i] : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!s8i>
    %2 = cir.offload.printf(%1) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %2 : !s32i
  }
}

// A nonzero get_element index folds like the equivalent stride.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_get_element()
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 12)
// BUFFERED: store i64 9208594728922682447, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:7fcb801de1f8944f,BCDEFGHIJKLMNOPQRSTUV"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>
!s16i = !cir.int<s, 16>
!u16i = !cir.int<u, 16>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"0123456789ABCDEFGHIJKLMNOPQRSTUV" : !cir.array<!s8i x 32>, trailing_zeros> : !cir.array<!s8i x 33>
  cir.func @buffered_zext_sext() -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 33>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!s8i>
    %2 = cir.const #cir.int<-56> : !s8i
    %3 = cir.cast integral %2 : !s8i -> !s16i
    %4 = cir.cast integral %3 : !s16i -> !u16i
    %5 = cir.ptr_stride %1, %4 : (!cir.ptr<!s8i>, !u16i) -> !cir.ptr<!s8i>
    %6 = cir.const #cir.int<-65463> : !s32i
    %7 = cir.ptr_stride %5, %6 : (!cir.ptr<!s8i>, !s32i) -> !cir.ptr<!s8i>
    %8 = cir.offload.printf(%7) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %8 : !s32i
  }
}

// A zext of a sext keeps the sign extended bits: -56 widens to 65480,
// and 65480 - 65463 = 17.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_zext_sext()
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 12)
// BUFFERED: store i64 -8663088140963090983, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:87c6873c1bfeedd9,HIJKLMNOPQRSTUV"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"0123456789ABCDEFGHIJKLMNOPQRSTUV" : !cir.array<!s8i x 32>, trailing_zeros> : !cir.array<!s8i x 33>
  cir.func @buffered_stride_i32() -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 33>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!s8i>
    %2 = cir.cast bitcast %1 : !cir.ptr<!s8i> -> !cir.ptr<!s32i>
    %3 = cir.const #cir.int<3> : !s32i
    %4 = cir.ptr_stride %2, %3 : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
    %5 = cir.cast bitcast %4 : !cir.ptr<!s32i> -> !cir.ptr<!s8i>
    %6 = cir.offload.printf(%5) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %6 : !s32i
  }
}

// A stride scales by the element size: 3 elements of 4 bytes land at byte 12.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_stride_i32()
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 12)
// BUFFERED: store i64 7009764703486015180, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:6147afdbc65af6cc,CDEFGHIJKLMNOPQRSTUV"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<"0123456789ABCDEFGHIJKLMNOPQRSTUV" : !cir.array<!s8i x 32>, trailing_zeros> : !cir.array<!s8i x 33>
  cir.func @buffered_void_stride() -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 33>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!s8i>
    %2 = cir.cast bitcast %1 : !cir.ptr<!s8i> -> !cir.ptr<!cir.void>
    %3 = cir.const #cir.int<4> : !s32i
    %4 = cir.ptr_stride %2, %3 : (!cir.ptr<!cir.void>, !s32i) -> !cir.ptr<!cir.void>
    %5 = cir.cast bitcast %4 : !cir.ptr<!cir.void> -> !cir.ptr<!s8i>
    %6 = cir.offload.printf(%5) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %6 : !s32i
  }
}

// A stride over void steps by bytes, the way lowering treats void
// elements, so the folded format is the string at byte 4.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_void_stride()
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 12)
// BUFFERED: store i64 -3566044351531173967, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:ce82dd8e55b237b1,456789ABCDEFGHIJKLMNOPQRSTUV"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<[#cir.int<37> : !s8i, #cir.int<100> : !s8i], trailing_zeros> : !cir.array<!s8i x 3>
  cir.func @buffered_int_array(%v: !s32i) -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 3>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 3>> -> !cir.ptr<!s8i>
    %2 = cir.offload.printf(%1, %v) : (!cir.ptr<!s8i>, !s32i) -> !s32i
    cir.return %2 : !s32i
  }
}

// A format global spelled as integer elements folds the same way as
// the string spelling.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_int_array(i32 %0)
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 20)
// BUFFERED: store i64 -2582314622382785113, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:dc29c6885a93bda7,%d"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<[#cir.int<37> : !s8i, #cir.int<100> : !s8i], trailing_zeros> : !cir.array<!s8i x 3>
  cir.func @buffered_unreachable(%v: !s32i) -> !s32i {
    %z = cir.const #cir.int<0> : !s32i
    cir.return %z : !s32i
  ^bb1:
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 3>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 3>> -> !cir.ptr<!s8i>
    %2 = cir.offload.printf(%1, %v) : (!cir.ptr<!s8i>, !s32i) -> !s32i
    cir.return %2 : !s32i
  }
}

// A printf in a block no branch reaches still folds: the format is
// resolved before conversion, which visits unreachable blocks too.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_unreachable(i32 %0)
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 20)
// BUFFERED: store i64 -2582314622382785113, ptr addrspace(1) %{{.*}}, align 8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:dc29c6885a93bda7,%d"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".fmt" = #cir.const_array<"%d %s\0A" : !cir.array<!s8i x 6>, trailing_zeros> : !cir.array<!s8i x 7>
  cir.global "private" constant cir_private @".empty" = #cir.const_array<[#cir.int<0> : !s8i], trailing_zeros> : !cir.array<!s8i x 1>
  cir.func @buffered_empty_arg(%v: !s32i) -> !s32i {
    %0 = cir.get_global @".fmt" : !cir.ptr<!cir.array<!s8i x 7>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 7>> -> !cir.ptr<!s8i>
    %2 = cir.get_global @".empty" : !cir.ptr<!cir.array<!s8i x 1>>
    %3 = cir.cast array_to_ptrdecay %2 : !cir.ptr<!cir.array<!s8i x 1>> -> !cir.ptr<!s8i>
    %4 = cir.offload.printf(%1, %v, %3) : (!cir.ptr<!s8i>, !s32i, !cir.ptr<!s8i>) -> !s32i
    cir.return %4 : !s32i
  }
}

// An empty constant %s argument takes the constant path: 8 aligned
// bytes for the empty string, with no runtime length computation.
// BUFFERED-LABEL: define{{.*}} i32 @buffered_empty_arg(i32 %0)
// BUFFERED: call ptr addrspace(1) @__printf_alloc(i32 28)
// BUFFERED-NOT: load i8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:d3e1b03bc04075f4,%d %s\0A"}

// -----

!s32i = !cir.int<s, 32>
!s8i = !cir.int<s, 8>

module attributes {cir.amdgpu_printf_kind = "buffered"} {
  cir.global "private" constant cir_private @".str" = #cir.const_array<[#cir.int<37> : !s8i, #cir.int<100> : !s8i], trailing_zeros> : !cir.array<!s8i x 3>
  cir.func @buffered_stale_attr(%v: !s32i) -> !s32i {
    %0 = cir.get_global @".str" : !cir.ptr<!cir.array<!s8i x 3>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s8i x 3>> -> !cir.ptr<!s8i>
    %2 = "cir.offload.printf"(%1, %v) {cir.printf.const_strings = ["WRONG", unit]} : (!cir.ptr<!s8i>, !s32i) -> !s32i
    cir.return %2 : !s32i
  }
}

