// BUFFERED-LABEL: define{{.*}} i32 @buffered_narrowing_cast()
// BUFFERED: load i8
// BUFFERED: !llvm.printf.fmts = !{[[FMT:![0-9]+]]}
// BUFFERED: [[FMT]] = !{!"0:0:ffffffff,\22Non const format string\22"}

