    %1 = cir.cast bitcast %0 : !cir.ptr<!cir.array<!s8i x 33>> -> !cir.ptr<!cir.array<!s32i x 8>>
    %idx = cir.const #cir.int<3> : !s32i
    %2 = cir.get_element %1[%idx : !s32i] : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
    %3 = cir.cast bitcast %2 : !cir.ptr<!s32i> -> !cir.ptr<!s8i>
    %4 = cir.offload.printf(%3) : (!cir.ptr<!s8i>) -> !s32i
    cir.return %4 : !s32i
  }
}

