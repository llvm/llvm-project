// RUN: cir-opt %s --split-input-file --cir-to-llvm -verify-diagnostics

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
  // expected-error @below {{failed to legalize operation 'cir.func'}}
  cir.func @language_address_space(%arg0: !cir.ptr<!s32i, lang_address_space(offload_global)>) {
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
  // expected-error @below {{failed to legalize operation 'cir.func'}}
  cir.func private @language_address_space_return() -> !cir.ptr<!s32i, lang_address_space(offload_global)>
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  // expected-error @below {{cannot lower a global with a language address space}}
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external lang_address_space(offload_global) @global = #cir.int<1> : !s32i
}

// -----

!s64i = !cir.int<s, 64>
!langptr = !cir.ptr<!cir.void, lang_address_space(offload_global)>
!rec_U = !cir.union<"U" {data !s64i, data !langptr}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // The union's integer storage converts, but its active initializer does not.
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external @union_active_initializer_language_address_space = #cir.const_record<{#cir.ptr<null> : !langptr}> : !rec_U
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  // Unlike direct cir.func lowering, a global view can request FuncType
  // conversion before its referenced function is lowered.
  cir.global external @function_pointer = #cir.global_view<@global_view_callee> : !cir.ptr<!cir.void>

  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
  // expected-error @below {{failed to legalize operation 'cir.func'}}
  cir.func private @global_view_callee() -> !cir.ptr<!s32i, lang_address_space(offload_global)>
}

// -----

!s32i = !cir.int<s, 32>
!langptr = !cir.ptr<!s32i, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Keep the view before its target so the initializer is lowered first.
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external @view = #cir.global_view<@target, [0 : i32]> : !cir.ptr<!cir.void>

  cir.global external @target = #cir.zero : !array
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>
!ptrarray = !cir.array<!ptr x 1>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external @view = #cir.const_array<[#cir.global_view<@target, [0 : i32]> : !ptr]> : !ptrarray

  cir.global external @target = #cir.zero : !array
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>
!record = !cir.struct<{data !ptr}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external @view = #cir.const_record<{#cir.global_view<@target, [0 : i32]> : !ptr}> : !record

  cir.global external @target = #cir.zero : !array
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>
!record = !cir.struct<{data !ptr}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external @view = #cir.typeinfo<{#cir.global_view<@target, [0 : i32]> : !ptr}> : !record

  cir.global external @target = #cir.zero : !array
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>
!ptrarray = !cir.array<!ptr x 1>
!vtable = !cir.struct<{data !ptrarray}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
  // expected-error @below {{failed to legalize operation 'cir.global'}}
  cir.global external @view = #cir.vtable<{#cir.const_array<[#cir.global_view<@target, [0 : i32]> : !ptr]> : !ptrarray}> : !vtable

  cir.global external @target = #cir.zero : !array
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  // Keep the function before the global so get_global is lowered first.
  cir.func @get_global_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.get_global'}}
    %0 = cir.get_global @global : !cir.ptr<!s32i, lang_address_space(offload_global)>
    %1 = cir.load %0 : !cir.ptr<!s32i, lang_address_space(offload_global)>, !s32i
    cir.return
  }

  cir.global external lang_address_space(offload_global) @global = #cir.int<1> : !s32i
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  cir.func @alloca_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_private)>'}}
    // expected-error @below {{failed to legalize operation 'cir.alloca'}}
    %0 = cir.alloca "x" align(4) : !cir.ptr<!s32i, lang_address_space(offload_private)>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!langptr = !cir.ptr<!s32i, lang_address_space(offload_global)>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  // The argument lowers to an opaque pointer, but the load needs the inner type.
  cir.func @load_language_address_space(%ptr: !cir.ptr<!langptr>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.load'}}
    %0 = cir.load %ptr : !cir.ptr<!langptr>, !langptr
    cir.return
  }
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_local)>

module attributes {cir.triple = "amdgpu-amd-amdhsa", llvm.data_layout = "e-p:64:64-p3:32:32"} {
  // The copy needs the local pointer's layout, not the outer opaque pointer's.
  // The default pointer layout would incorrectly copy 8 bytes with alignment 8.
  cir.func @copy_language_address_space(%src: !cir.ptr<!langptr>, %dst: !cir.ptr<!langptr>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_local)>'}}
    // expected-error @below {{failed to legalize operation 'cir.copy'}}
    cir.copy %src to %dst : !cir.ptr<!langptr>
    cir.return
  }
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_local)>
!record = !cir.struct<{data !langptr}>

module attributes {cir.triple = "amdgpu-amd-amdhsa", llvm.data_layout = "e-p:64:64-p3:32:32"} {
  // Validate the copied layout through aggregate members as well.
  cir.func @copy_record_language_address_space(%src: !cir.ptr<!record>, %dst: !cir.ptr<!record>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.struct<{data !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_local)>}>'}}
    // expected-error @below {{failed to legalize operation 'cir.copy'}}
    cir.copy %src to %dst : !cir.ptr<!record>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  cir.func @null_constant_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.ptr<null> : !cir.ptr<!s32i, lang_address_space(offload_global)>
    cir.return
  }
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  cir.func @constant_global_view_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.global_view<@target, [0 : i32]> : !ptr
    cir.return
  }

  cir.global external @target = #cir.zero : !array
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  cir.func @constant_array_global_view_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.const_array<[#cir.global_view<@target, [0 : i32]> : !ptr]> : !cir.array<!ptr x 1>
    cir.return
  }

  cir.global external @target = #cir.zero : !array
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 1>
!ptr = !cir.ptr<!cir.void>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Lower the view before its target, including through enclosing attributes.
  cir.func @constant_record_global_view_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 1>' for symbol @target}}
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.const_record<{#cir.global_view<@target, [0 : i32]> : !ptr}> : !cir.struct<{data !ptr}>
    cir.return
  }

  cir.global external @target = #cir.zero : !array
}

// -----

!s64i = !cir.int<s, 64>
!langptr = !cir.ptr<!cir.void, lang_address_space(offload_global)>
!rec_U = !cir.union<"U" {data !s64i, data !langptr}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @constant_union_active_initializer_language_address_space() {
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.const_record<{#cir.ptr<null> : !langptr}> : !rec_U
    cir.return
  }
}

// -----

!s64i = !cir.int<s, 64>
!langptr = !cir.ptr<!cir.void, lang_address_space(offload_global)>
!rec_U = !cir.union<"U" {data !s64i, data !langptr}>
!rec_Outer = !cir.union<"Outer" {data !s64i, data !rec_U}>
!rec_S = !cir.struct<"S" {data !rec_Outer}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Propagate adjustment failure through both the enclosing union and struct.
  cir.func @constant_nested_union_initializer_language_address_space() {
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.const_record<{#cir.const_record<{#cir.const_record<{#cir.ptr<null> : !langptr}> : !rec_U}> : !rec_Outer}> : !rec_S
    cir.return
  }
}

// -----

!s64i = !cir.int<s, 64>
!langptr = !cir.ptr<!cir.void, lang_address_space(offload_global)>
!rec_U = !cir.union<"U" {data !s64i, data !langptr}>
!array = !cir.array<!rec_U x 1>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @constant_union_array_initializer_language_address_space() {
    // expected-error @below {{failed to legalize operation 'cir.const'}}
    %0 = cir.const #cir.const_array<[#cir.const_record<{#cir.ptr<null> : !langptr}> : !rec_U]> : !array
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  cir.func @int_to_ptr_language_address_space(%arg0: !s32i) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.cast'}}
    %0 = cir.cast int_to_ptr %arg0 : !s32i -> !cir.ptr<!s32i, lang_address_space(offload_global)>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "spirv64-unknown-unknown"} {
  cir.func @address_space_cast_language_address_space(%arg0: !cir.ptr<!s32i>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.cast'}}
    %0 = cir.cast address_space %arg0 : !cir.ptr<!s32i> -> !cir.ptr<!s32i, lang_address_space(offload_global)>
    cir.return
  }
}

// -----

// These operations need the pointee layout to build a GEP.
!s32i = !cir.int<s, 32>
!langptr = !cir.ptr<!s32i, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 4>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @array_decay_language_address_space(%ptr: !cir.ptr<!array>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.cast'}}
    %0 = cir.cast array_to_ptrdecay %ptr : !cir.ptr<!array> -> !cir.ptr<!langptr>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!langptr = !cir.ptr<!s32i, lang_address_space(offload_global)>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @ptr_stride_language_address_space(%ptr: !cir.ptr<!langptr>, %idx: !s32i) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.ptr_stride'}}
    %0 = cir.ptr_stride %ptr, %idx : (!cir.ptr<!langptr>, !s32i) -> !cir.ptr<!langptr>
    cir.return
  }
}

// -----

!s64i = !cir.int<s, 64>
!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_local)>

module attributes {cir.triple = "amdgpu-amd-amdhsa", llvm.data_layout = "e-p:64:64-p3:32:32"} {
  // Pointer differences must not divide by the default 8-byte pointer size.
  cir.func @ptr_diff_language_address_space(%lhs: !cir.ptr<!langptr>, %rhs: !cir.ptr<!langptr>) -> !s64i {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_local)>'}}
    // expected-error @below {{failed to legalize operation 'cir.ptr_diff'}}
    %diff = cir.ptr_diff %lhs, %rhs : !cir.ptr<!langptr> -> !s64i
    cir.return %diff : !s64i
  }
}

// -----

!s32i = !cir.int<s, 32>
!langptr = !cir.ptr<!s32i, lang_address_space(offload_global)>
!array = !cir.array<!langptr x 4>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @get_element_language_address_space(%ptr: !cir.ptr<!array>, %idx: !s32i) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.array<!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)> x 4>'}}
    // expected-error @below {{failed to legalize operation 'cir.get_element'}}
    %0 = cir.get_element %ptr[%idx : !s32i] : !cir.ptr<!array> -> !cir.ptr<!langptr>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!langptr = !cir.ptr<!s32i, lang_address_space(offload_global)>
!record = !cir.struct<{data !langptr}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @get_member_language_address_space(%ptr: !cir.ptr<!record>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.struct<{data !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>}>'}}
    // expected-error @below {{failed to legalize operation 'cir.get_member'}}
    %0 = cir.get_member %ptr[0] {name = "p"} : !cir.ptr<!record> -> !cir.ptr<!langptr>
    cir.return
  }
}

// -----

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @complex_real_ptr_language_address_space(%ptr: !cir.ptr<!cir.complex<!cir.double>>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.double, lang_address_space(offload_private)>'}}
    // expected-error @below {{failed to legalize operation 'cir.complex.real_ptr'}}
    %real = cir.complex.real_ptr %ptr : !cir.ptr<!cir.complex<!cir.double>> -> !cir.ptr<!cir.double, lang_address_space(offload_private)>
