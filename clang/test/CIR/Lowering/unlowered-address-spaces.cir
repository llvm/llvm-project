// -----

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @complex_imag_ptr_language_address_space(%ptr: !cir.ptr<!cir.complex<!cir.double>>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.double, lang_address_space(offload_private)>'}}
    // expected-error @below {{failed to legalize operation 'cir.complex.imag_ptr'}}
    %imag = cir.complex.imag_ptr %ptr : !cir.ptr<!cir.complex<!cir.double>> -> !cir.ptr<!cir.double, lang_address_space(offload_private)>
