// -----

!u8i = !cir.int<u, 8>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @stacksave_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<u, 8>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.stacksave'}}
    %0 = cir.stacksave : !cir.ptr<!u8i, lang_address_space(offload_global)>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func @inline_asm_language_address_space() {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.asm'}}
    %0 = cir.asm(x86_att,
      out = [],
      in = [],
      in_out = [],
      {"" "=r"}) -> !cir.ptr<!s32i, lang_address_space(offload_global)>
    cir.return
  }
}

// -----

!langptr = !cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  // Memory operands require an LLVM elementtype attribute for the pointee.
  cir.func @inline_asm_memory_language_address_space(%ptr: !cir.ptr<!langptr>) {
    // expected-error @below {{ClangIR lowering NYI: cannot convert '!cir.ptr<!cir.int<s, 32>, lang_address_space(offload_global)>'}}
    // expected-error @below {{failed to legalize operation 'cir.asm'}}
    cir.asm(x86_att, out = [], in = [%ptr : !cir.ptr<!langptr> (maybe_memory)],
      in_out = [], {"" "*m"}) side_effects
    cir.return
  }
}
