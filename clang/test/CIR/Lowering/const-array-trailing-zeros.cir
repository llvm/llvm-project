// RUN: cir-opt %s -cir-to-llvm -o - | FileCheck %s

!s32i = !cir.int<s, 32>
!rec_S = !cir.struct<"S" {data !cir.array<!s32i x 10>}>
!rec_P = !cir.struct<"P" {data !cir.ptr<!s32i>, data !cir.array<!s32i x 16>}>
!rec_PLarge = !cir.struct<"PLarge" {data !cir.ptr<!s32i>, data !cir.array<!s32i x 108>}>
!rec_PRows = !cir.struct<"PRows" {data !cir.ptr<!s32i>, data !cir.array<!cir.array<!s32i x 10> x 3>}>
!rec_PRowsLarge = !cir.struct<"PRowsLarge" {data !cir.ptr<!s32i>, data !cir.array<!cir.array<!s32i x 10> x 100>}>

// A global initializer ending in many zeros lowers to a packed struct with a
// zero-initialized tail, but a cir.const keeps its array type.
module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.global external @g = #cir.const_array<[#cir.int<1> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>
  // CHECK: llvm.mlir.global external @g([1 : i32, #llvm.zero]) {{.*}} : !llvm.struct<packed (i32, array<9 x i32>)>

  // The offset address cannot be a constant attribute, so @p is built with
  // insertvalue. The grouped explicit elements still lower as one dense
  // constant, not element by element.
  cir.global external @arr = #cir.zero : !cir.array<!s32i x 2>
  cir.global external @p = #cir.const_record<{#cir.global_view<@arr, [1 : i32]> : !cir.ptr<!s32i>, #cir.const_array<[#cir.int<1> : !s32i, #cir.int<2> : !s32i, #cir.int<3> : !s32i, #cir.int<4> : !s32i, #cir.int<5> : !s32i, #cir.int<6> : !s32i, #cir.int<7> : !s32i, #cir.int<8> : !s32i], trailing_zeros> : !cir.array<!s32i x 16>}> : !rec_P
  // CHECK-LABEL: llvm.mlir.global external @p()
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.array<8 x i32>
  // CHECK: %[[ZERO:.*]] = llvm.mlir.zero : !llvm.struct<packed (array<8 x i32>, array<8 x i32>)>
  // CHECK: %[[PREFIX:.*]] = llvm.mlir.constant(dense<[1, 2, 3, 4, 5, 6, 7, 8]> : tensor<8xi32>) : !llvm.array<8 x i32>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.array<8 x i32>
  // CHECK: llvm.insertvalue %[[PREFIX]], %[[ZERO]][0] : !llvm.struct<packed (array<8 x i32>, array<8 x i32>)>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.array<8 x i32>
  // CHECK: llvm.return

  // The same with many explicit elements and only 8 trailing zeros.
  cir.global external @p_large = #cir.const_record<{#cir.global_view<@arr, [1 : i32]> : !cir.ptr<!s32i>, #cir.const_array<[#cir.int<1> : !s32i, #cir.int<2> : !s32i, #cir.int<3> : !s32i, #cir.int<4> : !s32i, #cir.int<5> : !s32i, #cir.int<6> : !s32i, #cir.int<7> : !s32i, #cir.int<8> : !s32i, #cir.int<9> : !s32i, #cir.int<10> : !s32i, #cir.int<11> : !s32i, #cir.int<12> : !s32i, #cir.int<13> : !s32i, #cir.int<14> : !s32i, #cir.int<15> : !s32i, #cir.int<16> : !s32i, #cir.int<17> : !s32i, #cir.int<18> : !s32i, #cir.int<19> : !s32i, #cir.int<20> : !s32i, #cir.int<21> : !s32i, #cir.int<22> : !s32i, #cir.int<23> : !s32i, #cir.int<24> : !s32i, #cir.int<25> : !s32i, #cir.int<26> : !s32i, #cir.int<27> : !s32i, #cir.int<28> : !s32i, #cir.int<29> : !s32i, #cir.int<30> : !s32i, #cir.int<31> : !s32i, #cir.int<32> : !s32i, #cir.int<33> : !s32i, #cir.int<34> : !s32i, #cir.int<35> : !s32i, #cir.int<36> : !s32i, #cir.int<37> : !s32i, #cir.int<38> : !s32i, #cir.int<39> : !s32i, #cir.int<40> : !s32i, #cir.int<41> : !s32i, #cir.int<42> : !s32i, #cir.int<43> : !s32i, #cir.int<44> : !s32i, #cir.int<45> : !s32i, #cir.int<46> : !s32i, #cir.int<47> : !s32i, #cir.int<48> : !s32i, #cir.int<49> : !s32i, #cir.int<50> : !s32i, #cir.int<51> : !s32i, #cir.int<52> : !s32i, #cir.int<53> : !s32i, #cir.int<54> : !s32i, #cir.int<55> : !s32i, #cir.int<56> : !s32i, #cir.int<57> : !s32i, #cir.int<58> : !s32i, #cir.int<59> : !s32i, #cir.int<60> : !s32i, #cir.int<61> : !s32i, #cir.int<62> : !s32i, #cir.int<63> : !s32i, #cir.int<64> : !s32i, #cir.int<65> : !s32i, #cir.int<66> : !s32i, #cir.int<67> : !s32i, #cir.int<68> : !s32i, #cir.int<69> : !s32i, #cir.int<70> : !s32i, #cir.int<71> : !s32i, #cir.int<72> : !s32i, #cir.int<73> : !s32i, #cir.int<74> : !s32i, #cir.int<75> : !s32i, #cir.int<76> : !s32i, #cir.int<77> : !s32i, #cir.int<78> : !s32i, #cir.int<79> : !s32i, #cir.int<80> : !s32i, #cir.int<81> : !s32i, #cir.int<82> : !s32i, #cir.int<83> : !s32i, #cir.int<84> : !s32i, #cir.int<85> : !s32i, #cir.int<86> : !s32i, #cir.int<87> : !s32i, #cir.int<88> : !s32i, #cir.int<89> : !s32i, #cir.int<90> : !s32i, #cir.int<91> : !s32i, #cir.int<92> : !s32i, #cir.int<93> : !s32i, #cir.int<94> : !s32i, #cir.int<95> : !s32i, #cir.int<96> : !s32i, #cir.int<97> : !s32i, #cir.int<98> : !s32i, #cir.int<99> : !s32i, #cir.int<100> : !s32i], trailing_zeros> : !cir.array<!s32i x 108>}> : !rec_PLarge
  // CHECK-LABEL: llvm.mlir.global external @p_large()
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.array<100 x i32>
  // CHECK: %[[ZERO:.*]] = llvm.mlir.zero : !llvm.struct<packed (array<100 x i32>, array<8 x i32>)>
  // CHECK: %[[PREFIX:.*]] = llvm.mlir.constant(dense<[1, 2, 3, {{.*}}, 99, 100]> : tensor<100xi32>) : !llvm.array<100 x i32>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.array<100 x i32>
  // CHECK: llvm.insertvalue %[[PREFIX]], %[[ZERO]][0] : !llvm.struct<packed (array<100 x i32>, array<8 x i32>)>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.array<100 x i32>
  // CHECK: llvm.return

  // Rows that each split make the enclosing array an array of packed structs.
  // That array is still one constant, not one insertvalue per row.
  cir.global external @p_rows = #cir.const_record<{#cir.global_view<@arr, [1 : i32]> : !cir.ptr<!s32i>, #cir.const_array<[#cir.const_array<[#cir.int<1> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<2> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<3> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>]> : !cir.array<!cir.array<!s32i x 10> x 3>}> : !rec_PRows
  // CHECK-LABEL: llvm.mlir.global external @p_rows()
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.{{(array<3 x )?}}struct<packed (i32, array<9 x i32>)>
  // CHECK: %[[ROWS:.*]] = llvm.mlir.constant({{\[\[}}1 : i32, #llvm.zero], [2 : i32, #llvm.zero], [3 : i32, #llvm.zero]]) : !llvm.array<3 x struct<packed (i32, array<9 x i32>)>>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.{{(array<3 x )?}}struct<packed (i32, array<9 x i32>)>
  // CHECK: llvm.insertvalue %[[ROWS]], %{{.*}}[1] : !llvm.struct<(ptr, array<3 x struct<packed (i32, array<9 x i32>)>>)>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.{{(array<3 x )?}}struct<packed (i32, array<9 x i32>)>
  // CHECK: llvm.return

  cir.global external @p_rows_large = #cir.const_record<{#cir.global_view<@arr, [1 : i32]> : !cir.ptr<!s32i>, #cir.const_array<[#cir.const_array<[#cir.int<1> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<2> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<3> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<4> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<5> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<6> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<7> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<8> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<9> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<10> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<11> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<12> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<13> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<14> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<15> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<16> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<17> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<18> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<19> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<20> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<21> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<22> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<23> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<24> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<25> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<26> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<27> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<28> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<29> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<30> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<31> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<32> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<33> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<34> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<35> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<36> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<37> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<38> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<39> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<40> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<41> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<42> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<43> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<44> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<45> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<46> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<47> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<48> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<49> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<50> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<51> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<52> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<53> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<54> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<55> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<56> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<57> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<58> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<59> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<60> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<61> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<62> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<63> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<64> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<65> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<66> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<67> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<68> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<69> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<70> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<71> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<72> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<73> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<74> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<75> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<76> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<77> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<78> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<79> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<80> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<81> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<82> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<83> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<84> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<85> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<86> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<87> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<88> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<89> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<90> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<91> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<92> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<93> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<94> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<95> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<96> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<97> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<98> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<99> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>, #cir.const_array<[#cir.int<100> : !s32i], trailing_zeros> : !cir.array<!s32i x 10>]> : !cir.array<!cir.array<!s32i x 10> x 100>}> : !rec_PRowsLarge
  // CHECK-LABEL: llvm.mlir.global external @p_rows_large()
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.{{(array<100 x )?}}struct<packed (i32, array<9 x i32>)>
  // CHECK: %[[ROWS:.*]] = llvm.mlir.constant({{\[\[}}1 : i32, #llvm.zero], [2 : i32, #llvm.zero], {{.*}}, [100 : i32, #llvm.zero]]) : !llvm.array<100 x struct<packed (i32, array<9 x i32>)>>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.{{(array<100 x )?}}struct<packed (i32, array<9 x i32>)>
  // CHECK: llvm.insertvalue %[[ROWS]], %{{.*}}[1] : !llvm.struct<(ptr, array<100 x struct<packed (i32, array<9 x i32>)>>)>
  // CHECK-NOT: llvm.insertvalue {{.*}} : !llvm.{{(array<100 x )?}}struct<packed (i32, array<9 x i32>)>
  // CHECK: llvm.return

  // Without the address, the initializer is a single attribute, and the
  // grouped explicit elements are one dense attribute in it.
