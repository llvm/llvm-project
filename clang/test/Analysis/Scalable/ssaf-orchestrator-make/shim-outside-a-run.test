
# REQUIRES: ssaf-orchestrator-make-build
# RUN: rm -rf %t && mkdir -p %t
# RUN: ln -s %ssaf-orchestrator-make-shims/shim %t/ld

# A link left behind by an interrupted run still knows which tool it stands
# in for, and refuses to stand in for it.
# RUN: not env -u SSAF_CONFIG %t/ld -o %t/prg 2>&1 | FileCheck %s
# CHECK: error: missing configuration file
# CHECK-NEXT: SSAF_CONFIG is not set

# Reached under a name no link carries -- its own, say -- it says so rather
# than guessing.
# RUN: not env -u SSAF_CONFIG %ssaf-orchestrator-make-shims/shim 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOT-A-LINK
# NOT-A-LINK: error: no shim stands in for shim
# NOT-A-LINK-NEXT: reached through the links an orchestrator run creates
