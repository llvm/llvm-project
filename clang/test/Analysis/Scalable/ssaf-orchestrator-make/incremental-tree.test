# RUN: ls %t/out/build-graph%t/build/other.buildstep.json
# RUN: not ls %t/out/build-graph%t/build/prg.buildstep.json
# RUN: not ls %t/out/ssaf-artifacts%t/build/a.o.summary.json

#--- Makefile
CXX = clang++
all: build/prg
other: build/other
build/%.o: src/%.cpp
	$(CXX) -c -o $@ $<
build/prg: build/a.o build/b.o
	$(CXX) -o $@ build/a.o build/b.o
build/other: build/c.o
	$(CXX) -o $@ build/c.o

#--- src/a.cpp
int total(int *p, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += p[i];
  return t;
}

#--- src/b.cpp
int total(int *p, int n);
int main() {
  int values[2] = {1, 2};
  return total(values, 2);
}

#--- src/c.cpp
int main() { return 0; }
