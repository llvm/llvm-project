
# REQUIRES: ssaf-orchestrator-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build
# RUN: chmod +x %t/bin/c++ %t/fake-clang %t/fake-linker

# RUN: cd %t
# RUN: env BINARY_CXX=%ssaf-orchestrator-make-clang \
# RUN:     PATH="%t/bin:%ssaf-orchestrator-make-env-path" \
# RUN:     %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%t/fake-clang \
# RUN:     --ssaf-linker=%t/fake-linker \
# RUN:     --ssaf-extra-clang-arg=-DFROM_EXTRA \
# RUN:     -o %t/out -- make

# RUN: FileCheck %s --check-prefix=BINARY --input-file=%t/bin/binary.log \
# RUN:   --implicit-check-not=--ssaf- --implicit-check-not=FROM_EXTRA
# BINARY: -Wall -c -o build/a.o src/a.cpp
# BINARY-NEXT: SSAF_CONFIG=unset

# RUN: FileCheck %s --check-prefix=SSAF --input-file=%t/ssaf.log
# SSAF: -cc1
# SSAF-SAME: -triple
# SSAF-SAME: -x c++
# SSAF-SAME: --ssaf-extract-summaries=PointerFlow
# SSAF-SAME: --ssaf-compilation-unit-id={{[^ ]*}}/build/a.o
# SSAF-SAME: --ssaf-tu-summary-file={{[^ ]*}}/out/ssaf-artifacts{{[^ ]*}}/build/a.o.summary.json
# SSAF-SAME: -DFROM_EXTRA

# RUN: FileCheck %s --check-prefix=SAME-JOB --input-file=%t/ssaf.log
# SAME-JOB: -emit-obj
# SAME-JOB-SAME: -o build/a.o

# RUN: FileCheck %s --check-prefix=LINK --input-file=%t/link.log
# LINK: {{[^ ]*}}/out/ssaf-artifacts{{[^ ]*}}/build/a.o.summary.json -o {{[^ ]*}}/out/ssaf-artifacts{{[^ ]*}}/build/prg.summary.json

#--- Makefile
CXX = c++
all: build/prg
build/a.o: src/a.cpp
	$(CXX) -Wall -c -o $@ $<
build/prg: build/a.o
	$(CXX) -o $@ build/a.o

#--- src/a.cpp
int main() { return 0; }

#--- bin/c++
#!/bin/sh
dir=$(cd "$(dirname "$0")" && pwd)
for arg in "$@"; do
  if [ "$arg" = "-###" ]; then exec "$BINARY_CXX" "$@"; fi
done
echo "$@" >> "$dir/binary.log"
echo "SSAF_CONFIG=${SSAF_CONFIG:-unset}" >> "$dir/binary.log"
exec "$BINARY_CXX" "$@"

#--- fake-clang
#!/bin/sh
dir=$(cd "$(dirname "$0")" && pwd)
echo "$@" >> "$dir/ssaf.log"
for arg in "$@"; do
  case "$arg" in
    --ssaf-tu-summary-file=*)
      file="${arg#*=}"
      mkdir -p "$(dirname "$file")"
      echo '{}' > "$file"
      ;;
  esac
done
exit 0

#--- fake-linker
#!/bin/sh
dir=$(cd "$(dirname "$0")" && pwd)
echo "$@" >> "$dir/link.log"
prev=""
for arg in "$@"; do
  if [ "$prev" = "-o" ]; then
    mkdir -p "$(dirname "$arg")"
    name=$(basename "$arg" .json)
    printf '{"type": "LUSummary", "lu_namespace": [{"kind": "LinkUnit", ' > "$arg"
    printf '"name": "%s"}]}\n' "$name" >> "$arg"
  fi
  prev="$arg"
done
exit 0
