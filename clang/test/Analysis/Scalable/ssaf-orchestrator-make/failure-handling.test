#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp
	$(CXX) -c -o $@ $<
build/prg: build/a.o build/b.o
	$(CXX) -o $@ build/a.o build/b.o

#--- src/a.cpp
int b();
int main() { return b(); }

#--- src/b.cpp
int b() { return 0; }

#--- failing-clang
#!/bin/sh
for arg in "$@"; do
  case "$arg" in
    --ssaf-tu-summary-file=*)
      file="${arg#*=}"
      mkdir -p "$(dirname "$file")"
      echo '{}' > "$file"
      ;;
  esac
done
echo "stub refuses to extract" >&2
exit 1

#--- one-failing-clang
#!/bin/sh
"$BINARY_CLANG" "$@" || exit $?
for arg in "$@"; do
  case "$arg" in
    *a.o.summary.json) echo "stub refuses to extract" >&2; exit 1 ;;
  esac
done
exit 0
