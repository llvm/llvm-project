# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT

# STDOUT: summaries: 3
# STDOUT: link-unit: {{[^ ]*}}/build/prg

# RUN: ls %t/out/ssaf-artifacts%t/build/main.o.summary.json %t/out/ssaf-artifacts%t/sub/build/s.o.summary.json
# RUN: cat %t/out/ssaf-artifacts%t/sub/build/s.o.summary.json \
# RUN:   | FileCheck %s --check-prefix=SUB-CU
# SUB-CU: "name": "{{[^ ]*}}/sub/build/s.o"

# RUN: cat %t/out/build-graph%t/build/prg.buildstep.json \
# RUN:   | FileCheck %s --check-prefix=UNIT
# UNIT-DAG: {{[^ ]*}}/build/main.o
# UNIT-DAG: {{[^ ]*}}/sub/build/s.o

# The default output directory is relative, and a sub-make runs the shims from
# a different directory than the one it was resolved against.
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -- make \
# RUN:   | FileCheck %s --check-prefix=DEFAULT-OUT
# DEFAULT-OUT: output-dir: {{.*}}/ssaf-output
# RUN: ls %t/ssaf-output/ssaf-artifacts%t/build/main.o.summary.json \
# RUN:      %t/ssaf-output/ssaf-artifacts%t/sub/build/s.o.summary.json

#--- Makefile
CXX = clang++
all: build/prg
build/main.o: src/main.cpp
	$(CXX) -c -o $@ $<
sub/build/s.o:
	$(MAKE) -C sub
build/prg: build/main.o sub/build/s.o
	$(CXX) -o $@ build/main.o sub/build/s.o

#--- src/main.cpp
int sub(int *p);
int main() {
  int values[1] = {1};
  return sub(values);
}

#--- sub/Makefile
CXX = clang++
all: build/s.o
build/s.o: src/s.cpp
	$(CXX) -c -o $@ $<

#--- sub/src/s.cpp
int sub(int *p) { return p[0]; }
