
# REQUIRES: ssaf-orchestrator-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build

# RUN: cd %t
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=KEPT
# KEPT: summaries: 2
# KEPT: link-unit: {{[^ ]*}}/build/prg

# RUN: ls %t/build/a.o %t/build/prg
# RUN: cat %t/out/ssaf-artifacts%t/build/a.o.summary.json | FileCheck %s --check-prefix=CU
# CU: "name": "{{[^ ]*}}/build/a.o"

# Under -v every step says what it ran, on stderr so the result lines stay
# machine-readable.
# RUN: %clang-ssaf-orchestrator-make -v \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out2 -- make 2>&1 >/dev/null \
# RUN:   | FileCheck %s --check-prefix=NOTES
# NOTES-DAG: note: make -B
# NOTES-DAG: note: binary: {{.*}}clang++
# NOTES-DAG: note: ssaf: {{.*}}--ssaf-shim-skip-binary-tool-invocation

#--- Makefile
CXX = clang++ -DFROM_MAKEFILE=1
all: build/prg
build/a.o: src/a.cpp
	$(CXX) -c -o $@ $<
build/prg: build/a.o
	$(CXX) -o $@ build/a.o

#--- src/a.cpp
#ifndef FROM_MAKEFILE
#error "the Makefile's own CXX flags were lost"
#endif
int main() { return 0; }
