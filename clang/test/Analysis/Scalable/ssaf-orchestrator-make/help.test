
# RUN: %clang-ssaf-orchestrator-make --help | FileCheck %s

# CHECK: usage: clang-ssaf-orchestrator-make [options] [--] <build command>
# CHECK: --version
# CHECK: --output-dir
# CHECK: --extract-summaries
# CHECK: --ssaf-clang
# CHECK: --analysis

# RUN: %clang-ssaf-orchestrator-make --help | FileCheck %s --check-prefix=SSAF
# SSAF: --ssaf-linker
# SSAF: --ssaf-analyzer
# SSAF: --ssaf-extra-clang-arg
# SSAF: --keep-going
# SSAF: --verbose

# RUN: %clang-ssaf-orchestrator-make --version | FileCheck %s --check-prefix=VERSION
# VERSION: clang-ssaf-orchestrator-make {{[0-9]+\.[0-9]+\.[0-9]+}}

# The tool imports its own package, whatever else of that name PYTHONPATH holds,
# so it and its shims are always the same code.
# RUN: rm -rf %t && mkdir -p %t/clang_ssaf_orchestrator_make
# RUN: echo 'raise SystemExit("a decoy was imported")' \
# RUN:   > %t/clang_ssaf_orchestrator_make/__init__.py
# RUN: env PYTHONPATH=%t %clang-ssaf-orchestrator-make --version \
# RUN:   | FileCheck %s --check-prefix=VERSION
