# RUN: cd %t
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow,UnsafeBufferUsage \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT

# STDOUT: summaries: 3
# STDOUT: link-unit: {{[^ ]*}}/build/prg

# RUN: ls %t/build/a.o %t/build/b.o %t/build/prg

# RUN: cat %t/out/ssaf-artifacts%t/build/a.o.summary.json \
# RUN:   | FileCheck %s --check-prefix=CU-A
# CU-A: "name": "{{[^ ]*}}/build/a.o"
# RUN: cat %t/out/ssaf-artifacts%t/build/b.o.summary.json \
# RUN:   | FileCheck %s --check-prefix=CU-B
# CU-B: "name": "{{[^ ]*}}/build/b.o"

# RUN: cat %t/out/ssaf-artifacts%t/build/a.o.summary.json | FileCheck %s --check-prefix=KIND
# KIND: "type": "TUSummary"

# RUN: cat %t/out/ssaf-artifacts%t/build/prg.summary.json \
# RUN:   | FileCheck %s --check-prefix=LU
# LU: "kind": "LinkUnit"
# LU: "type": "LUSummary"

# The SSAF step replays the build's own job, so it writes the build's outputs
# a second time -- including the depfile -MMD asked for, and in the directory
# the job named rather than the one the SSAF step ran in.
# RUN: rm %t/build/a.d
# RUN: cd %t
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out2 -- make
# RUN: ls %t/build/a.d
# RUN: ls %t && not ls %t/a.d

#--- Makefile
CXX = clang++
CXXFLAGS = -MMD -MP
all: build/prg
build/%.o: src/%.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<
build/prg: build/a.o build/b.o
	$(CXX) -o $@ build/a.o build/b.o

#--- src/a.cpp
int sum(int *p, int n) {
  int total = 0;
  for (int i = 0; i < n; ++i)
    total += p[i];
  return total;
}

#--- src/b.cpp
int sum(int *p, int n);
int main() {
  int values[4] = {1, 2, 3, 4};
  return sum(values, 4);
}
