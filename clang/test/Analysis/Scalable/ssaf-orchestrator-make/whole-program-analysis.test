
# REQUIRES: ssaf-orchestrator-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build
# RUN: chmod +x %t/failing-analyzer

# RUN: cd %t
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow,UnsafeBufferUsage \
# RUN:     --analysis=UnsafeBufferReachableAnalysisResult \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT

# STDOUT: summaries: 3
# STDOUT: link-unit: {{[^ ]*}}/build/prg
# STDOUT: link-unit-summary: {{[^ ]*}}/out/ssaf-artifacts{{[^ ]*}}/build/prg.summary.json
# STDOUT: analysis-result: {{[^ ]*}}/out/wpa.json
# STDOUT: output-dir: {{[^ ]*}}/out

# RUN: FileCheck %s --check-prefix=WPA --input-file=%t/out/wpa.json
# WPA: "type": "WPASuite"

# A failing analysis fails the run, which says how the analyzer exited.
# RUN: not %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --analysis=UnsafeBufferReachableAnalysisResult \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     --ssaf-analyzer=%t/failing-analyzer \
# RUN:     -o %t/out2 -- make 2>&1 \
# RUN:   | FileCheck %s --check-prefix=FAILED
# FAILED: error: whole-program analysis failed (exit 3)

#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp
	$(CXX) -c -o $@ $<
build/prg: build/main.o build/parse.o
	$(CXX) -o $@ build/main.o build/parse.o

#--- src/parse.cpp
int total(int *data, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += data[i];
  return t;
}

#--- src/main.cpp
int total(int *data, int n);
int main() {
  int values[4] = {1, 2, 3, 4};
  return total(values, 4);
}

#--- failing-analyzer
#!/bin/sh
exit 3
