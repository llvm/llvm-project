#--- Makefile.in
CXX = @CXX@
all: build/prg
build/a.o: src/a.cpp
	$(CXX) -c -o $@ $<
build/prg: build/a.o
	$(CXX) -o $@ build/a.o

#--- src/a.cpp
int main() { return 0; }
