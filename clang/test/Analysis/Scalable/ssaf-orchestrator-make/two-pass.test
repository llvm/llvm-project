
# REQUIRES: ssaf-orchestrator-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build

# RUN: cd %t
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow,UnsafeBufferUsage \
# RUN:     --analysis=UnsafeBufferReachableAnalysisResult \
# RUN:     --transformation=cpp-bounded-buffers \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT

# STDOUT: summaries: 3
# STDOUT: link-unit: {{[^ ]*}}/build/prg
# STDOUT: analysis-result: {{[^ ]*}}/out/wpa.json
# STDOUT: source-edits: {{[^ ]*}}/out/ssaf-artifacts{{[^ ]*}}/build/prg.edits.yaml
# STDOUT-NOT: edit-conflicts

# RUN: ls %t/out/ssaf-artifacts%t/build/main.o.summary.json %t/out/ssaf-artifacts%t/build/parse.o.summary.json
# RUN: ls %t/out/ssaf-artifacts%t/build/main.o.edits.yaml \
# RUN:      %t/out/ssaf-artifacts%t/build/parse.o.edits.yaml
# RUN: ls %t/out/ssaf-artifacts%t/build/main.o.report.sarif \
# RUN:      %t/out/ssaf-artifacts%t/build/parse.o.report.sarif

# RUN: cat %t/out/ssaf-artifacts%t/build/prg.edits.yaml | FileCheck %s --check-prefix=EDITS
# EDITS: Replacements:
# EDITS-DAG: FilePath: {{.*}}src/main.cpp
# EDITS-DAG: FilePath: {{.*}}src/parse.cpp
# EDITS-DAG: ReplacementText: {{.*}}bounded_ptr<int>

# Both configuration files are written, one per pass.
# RUN: FileCheck %s --check-prefix=PASS1 \
# RUN:   --input-file=%t/out/config-analysis.json
# PASS1: "pass_kind": "analysis"
# RUN: FileCheck %s --check-prefix=PASS2 \
# RUN:   --input-file=%t/out/config-transformation.json
# PASS2-DAG: "pass_kind": "transformation"
# PASS2-DAG: "link_unit_id":

# The second pass carries the link unit name the first pass recovered.
# RUN: FileCheck %s --check-prefix=LUID \
# RUN:   --input-file=%t/out/config-transformation.json
# LUID: "link_unit_id": "{{.+}}"
#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp
	$(CXX) -c -o $@ $<
build/prg: build/main.o build/parse.o
	$(CXX) -o $@ build/main.o build/parse.o

#--- src/parse.cpp
int total(int *data, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += data[i];
  return t;
}

#--- src/main.cpp
int total(int *data, int n);
int main() {
  int values[4] = {1, 2, 3, 4};
  return total(values, 4);
}
