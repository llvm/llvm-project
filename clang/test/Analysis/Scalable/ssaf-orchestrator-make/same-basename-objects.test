
# REQUIRES: ssaf-orchestrator-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build/first %t/build/second

# RUN: cd %t
# RUN: %clang-ssaf-orchestrator-make \
# RUN:     --extract-summaries=PointerFlow \
# RUN:     --ssaf-clang=%ssaf-orchestrator-make-clang \
# RUN:     -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT

# STDOUT: summaries: 4
# RUN: ls %t/out/ssaf-artifacts%t/build/first/parser.o.summary.json %t/out/ssaf-artifacts%t/build/second/parser.o.summary.json

# RUN: cat %t/out/ssaf-artifacts%t/build/first/parser.o.summary.json | FileCheck %s --check-prefix=FIRST
# FIRST: "name": "{{[^ ]*}}/build/first/parser.o"
# RUN: cat %t/out/ssaf-artifacts%t/build/second/parser.o.summary.json | FileCheck %s --check-prefix=SECOND
# SECOND: "name": "{{[^ ]*}}/build/second/parser.o"

# RUN: cat %t/out/build-graph%t/build/prg.buildstep.json \
# RUN:   | FileCheck %s --check-prefix=UNIT
# UNIT-DAG: {{[^ ]*}}/build/first/parser.o
# UNIT-DAG: {{[^ ]*}}/build/second/parser.o

#--- Makefile
CXX = clang++
OBJS = build/main.o build/first/parser.o build/second/parser.o
all: build/prg
build/main.o: src/main.cpp
	$(CXX) -c -o $@ $<
build/first/parser.o: src/first/parser.cpp
	$(CXX) -c -o $@ $<
build/second/parser.o: src/second/parser.cpp
	$(CXX) -c -o $@ $<
build/prg: $(OBJS)
	$(CXX) -o $@ $(OBJS)

#--- src/first/parser.cpp
int first_total(int *p, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += p[i];
  return t;
}

#--- src/second/parser.cpp
int second_total(int *p, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += p[i] * 2;
  return t;
}

#--- src/main.cpp
int first_total(int *p, int n);
int second_total(int *p, int n);
int main() {
  int values[2] = {1, 2};
  return first_total(values, 2) + second_total(values, 2);
}
