// Two reports that both carry a finding in a shared header, under different
// rule and artifact indices, merge into one run.

// RUN: rm -rf %t && mkdir -p %t
// RUN: clang-ssaf-merge-transformation-report %S/Inputs/tu-a.sarif \
// RUN:   %S/Inputs/tu-b.sarif -o %t/merged.sarif
// RUN: FileCheck %s --input-file=%t/merged.sarif

// '-' writes the report to stdout.
// RUN: clang-ssaf-merge-transformation-report %S/Inputs/tu-a.sarif \
// RUN:   %S/Inputs/tu-b.sarif -o - > %t/stdout.sarif
// RUN: diff %t/merged.sarif %t/stdout.sarif

// The artifacts of both runs, once each and numbered in URI order.
// CHECK:      "artifacts": [
// CHECK:        "index": 0,
// CHECK-NEXT:   "uri": "file:///src/a.cpp"
// CHECK:        "index": 1,
// CHECK-NEXT:   "uri": "file:///src/b.cpp"
// CHECK:        "index": 2,
// CHECK-NEXT:   "uri": "file:///src/shared.h"

// The results in location order, each pointing into the merged rules and
// artifacts. The header's finding is kept once.
// CHECK:      "results": [
// CHECK:        "index": 0,
// CHECK-NEXT:   "uri": "file:///src/a.cpp"
// CHECK:        "ruleId": "cpp-bounded-buffers-skipped",
// CHECK-NEXT:   "ruleIndex": 1
// CHECK:        "index": 1,
// CHECK-NEXT:   "uri": "file:///src/b.cpp"
// CHECK:        "ruleId": "cpp-bounded-buffers-other",
// CHECK-NEXT:   "ruleIndex": 0
// CHECK:        "index": 2,
// CHECK-NEXT:   "uri": "file:///src/shared.h"
// CHECK:        "text": "multi-level pointer indirection is not yet rewritten"
// CHECK:        "ruleId": "cpp-bounded-buffers-skipped",
// CHECK-NEXT:   "ruleIndex": 1
// CHECK-NOT:    "text": "multi-level pointer indirection is not yet rewritten"

// The rules of both runs, once each and in id order, under the driver of the
// first input.
// CHECK:      "tool": {
// CHECK:        "fullName": "clang ScalableStaticAnalysisFramework source transformation (cpp-bounded-buffers)",
// CHECK:        "name": "clang-ssaf",
// CHECK:        "rules": [
// CHECK:          "id": "cpp-bounded-buffers-other",
// CHECK:          "id": "cpp-bounded-buffers-skipped",
// CHECK-NOT:      "id":
// CHECK:        "version": "24.0.0git"
// CHECK:      "version": "2.1.0"
