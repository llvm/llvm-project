# REQUIRES: ssaf-driver-make-build, clang-apply-replacements
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build

# clang-apply-replacements writes what the patch shows; the run checks it.
# RUN: cd %t
# RUN: %clang-ssaf-driver --transformation=cpp-bounded-buffers --apply \
# RUN:     --ssaf-clang=%ssaf-driver-clang -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT
# STDOUT: patch: {{[^ ]*}}/out/cpp-bounded-buffers.patch
# RUN: FileCheck %s --check-prefix=PARSE --input-file=%t/src/parse.cpp
# PARSE: int total(bounded_ptr<int> data, int n) {
# RUN: FileCheck %s --check-prefix=MAIN --input-file=%t/src/main.cpp
# MAIN: int total(bounded_ptr<int> data, int n);
# MAIN: bounded_array<int, 4> values = {1, 2, 3, 4};

#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp
	$(CXX) -c -o $@ $<
build/prg: build/main.o build/parse.o
	$(CXX) -o $@ build/main.o build/parse.o

#--- src/parse.cpp
int total(int *data, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += data[i];
  return t;
}

#--- src/main.cpp
int total(int *data, int n);
int main() {
  int values[4] = {1, 2, 3, 4};
  return total(values, 4);
}
