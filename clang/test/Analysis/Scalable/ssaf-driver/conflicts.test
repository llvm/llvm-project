# REQUIRES: ssaf-driver-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build

# The two translation units see different declarations of g in the header,
# so their edits to it conflict and neither is applied. The conflict is
# reported with both candidates, and the rest of the edits are still made.
# RUN: cd %t
# RUN: %clang-ssaf-driver --transformation=cpp-bounded-buffers \
# RUN:     --ssaf-clang=%ssaf-driver-clang -o %t/out -- make \
# RUN:     2> %t/stderr.txt > /dev/null

# RUN: FileCheck %s --check-prefix=STDERR --input-file=%t/stderr.txt
# STDERR:      src/shared.h:3:1: error: 2 overlapping replacement(s) at file://{{.*}}/src/shared.h byte 20 were dropped; resolve manually. [clang-reforge-replacement-conflict]
# STDERR-DAG:  src/shared.h:3:1: note: candidate edit: "bounded_ptr<long> "
# STDERR-DAG:  src/shared.h:5:1: note: candidate edit: "bounded_ptr<int> "
# STDERR:      1 clang-reforge-replacement-conflict reported

# RUN: FileCheck %s --check-prefix=SARIF \
# RUN:   --input-file=%t/out/cpp-bounded-buffers.sarif
# SARIF: "name": "clang-ssaf",
# SARIF: "byteOffset": 20
# SARIF: "ruleId": "clang-reforge-replacement-conflict"
# SARIF: "name": "clang-ssaf-src-edit-merge",

# RUN: FileCheck %s --check-prefix=PATCH \
# RUN:   --input-file=%t/out/cpp-bounded-buffers.patch
# PATCH:     +++ b/src/a.cpp
# PATCH:     +bounded_ptr<int> g;
# PATCH-NOT: shared.h

#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp src/shared.h
	$(CXX) -c -o $@ $<
build/prg: build/a.o build/b.o
	$(CXX) -o $@ build/a.o build/b.o

#--- src/shared.h
extern
#if USE_LONG
long
#else
int
#endif
*g;

#--- src/a.cpp
#include "shared.h"
int *g;
long b();
int main() { return g[5] + (int)b(); }

#--- src/b.cpp
#define USE_LONG 1
#include "shared.h"
long b() { return g[7]; }
