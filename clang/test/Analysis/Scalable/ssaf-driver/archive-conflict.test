# REQUIRES: ssaf-driver-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build

# The two halves of the archive disagree on the header, so the archive's merge
# drops both of their edits to it. main.cpp asks for one of them again, and
# the link's own merge keeps it; the driver leaves it out, because it
# overlaps a reported conflict.
# RUN: cd %t
# RUN: %clang-ssaf-driver --transformation=cpp-bounded-buffers \
# RUN:     --ssaf-clang=%ssaf-driver-clang -o %t/out -- make \
# RUN:     2> %t/stderr.txt > /dev/null
# RUN: FileCheck %s --check-prefix=STDERR --input-file=%t/stderr.txt
# STDERR: src/shared.h:3:1: error: 2 overlapping replacement(s) at {{.*}} were dropped; resolve manually. [clang-reforge-replacement-conflict]
# STDERR: clang-ssaf-driver: warning: left out 1 edit(s) to src/shared.h that overlap a reported conflict

# RUN: FileCheck %s --check-prefix=PATCH \
# RUN:   --input-file=%t/out/cpp-bounded-buffers.patch
# PATCH:     +++ b/src/a.cpp
# PATCH:     +bounded_ptr<int> g;
# PATCH-NOT: shared.h

#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp src/shared.h
	$(CXX) -c -o $@ $<
build/libparts.a: build/a.o build/b.o
	ar rcs $@ build/a.o build/b.o
build/prg: build/main.o build/libparts.a
	$(CXX) -o $@ build/main.o build/libparts.a

#--- src/shared.h
extern
#if USE_LONG
long
#else
int
#endif
*g;

#--- src/a.cpp
#include "shared.h"
int *g;
int a() { return g[5]; }

#--- src/b.cpp
#define USE_LONG 1
#include "shared.h"
long b() { return g[7]; }

#--- src/main.cpp
#include "shared.h"
int a();
long b();
int main() { return a() + (int)b(); }
