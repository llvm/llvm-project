# REQUIRES: ssaf-driver-make-build
# RUN: rm -rf %t && split-file %s %t
# RUN: mkdir -p %t/build
# RUN: chmod +x %t/lazy-tool %t/recording-tool
# RUN: cd %t

# A tool that leaves the sources as they were fails the run, because the
# patch would not show what --apply did.
# RUN: not %clang-ssaf-driver --transformation=cpp-bounded-buffers --apply \
# RUN:     --clang-apply-replacements=%t/lazy-tool \
# RUN:     --ssaf-clang=%ssaf-driver-clang -o %t/out -- make 2>&1 > /dev/null \
# RUN:   | FileCheck %s --check-prefix=LAZY
# LAZY:      clang-ssaf-driver: error: clang-apply-replacements did not write what the patch shows:
# LAZY-NEXT:   src/main.cpp
# LAZY-NEXT:   src/parse.cpp

# The tool is given a directory holding the edits the patch shows, named by
# absolute path, and nothing else.
# RUN: %clang-ssaf-driver --transformation=cpp-bounded-buffers --apply \
# RUN:     --clang-apply-replacements=%t/recording-tool \
# RUN:     --ssaf-clang=%ssaf-driver-clang -o %t/out -- make \
# RUN:   | FileCheck %s --check-prefix=STDOUT
# STDOUT: patch: {{[^ ]*}}/out/cpp-bounded-buffers.patch
# STDOUT: report: {{[^ ]*}}/out/cpp-bounded-buffers.sarif
# RUN: FileCheck %s --check-prefix=ARGS -DOUT=%t/out --input-file=%t/tool.args
# ARGS: [[OUT]]/apply
# RUN: FileCheck %s --check-prefix=LISTING --match-full-lines \
# RUN:   --input-file=%t/tool.listing
# LISTING:     source-edits.yaml
# LISTING-NOT: {{.}}
# RUN: FileCheck %s --check-prefix=EDITS --input-file=%t/tool.yaml
# EDITS:     FilePath:        "{{/.*}}/src/main.cpp"
# EDITS:     FilePath:        "{{/.*}}/src/parse.cpp"
# EDITS:     ReplacementText: "bounded_ptr<int> "

# RUN: FileCheck %s --check-prefix=APPLIED --input-file=%t/src/parse.cpp
# APPLIED: int total(bounded_ptr<int> data, int n) {

#--- Makefile
CXX = clang++
all: build/prg
build/%.o: src/%.cpp
	$(CXX) -c -o $@ $<
build/prg: build/main.o build/parse.o
	$(CXX) -o $@ build/main.o build/parse.o

#--- src/parse.cpp
int total(int *data, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += data[i];
  return t;
}

#--- src/main.cpp
int total(int *data, int n);
int main() {
  int values[4] = {1, 2, 3, 4};
  return total(values, 4);
}

#--- expected/src/parse.cpp
int total(bounded_ptr<int> data, int n) {
  int t = 0;
  for (int i = 0; i < n; ++i)
    t += data[i];
  return t;
}

#--- expected/src/main.cpp
int total(bounded_ptr<int> data, int n);
int main() {
  bounded_array<int, 4> values = {1, 2, 3, 4};
  return total(values, 4);
}

#--- recording-tool
#!/bin/sh
here=$(dirname "$0")
echo "$@" > "$here/tool.args"
ls "$1" > "$here/tool.listing"
cp "$1/source-edits.yaml" "$here/tool.yaml"
cp "$here/expected/src/main.cpp" "$here/expected/src/parse.cpp" "$here/src/"

#--- lazy-tool
#!/bin/sh
