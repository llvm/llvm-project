
# RUN: %clang-ssaf-driver --help | FileCheck %s

# CHECK: usage: clang-ssaf-driver [options] --transformation=<name> [--] <build command>
# CHECK: --version
# CHECK: --transformation <name>
# CHECK: --output-dir
# CHECK: --apply
# CHECK: --clang-apply-replacements
# CHECK: --ssaf-clang
# CHECK: --ssaf-linker
# CHECK: --ssaf-analyzer
# CHECK: --ssaf-src-edit-merge
# CHECK: --ssaf-merge-transformation-report
# CHECK: --ssaf-merge-conflict-report
# CHECK: --ssaf-extra-clang-arg
# CHECK: --keep-going
# CHECK: --verbose

# RUN: %clang-ssaf-driver --version | FileCheck %s --check-prefix=VERSION
# VERSION: clang-ssaf-driver {{[0-9]+\.[0-9]+\.[0-9]+}}

# The tool imports its own package, whatever else of that name PYTHONPATH holds.
# RUN: rm -rf %t && mkdir -p %t/clang_ssaf_driver
# RUN: echo 'raise SystemExit("a decoy was imported")' \
# RUN:   > %t/clang_ssaf_driver/__init__.py
# RUN: env PYTHONPATH=%t %clang-ssaf-driver --version \
# RUN:   | FileCheck %s --check-prefix=VERSION
