# REQUIRES: ssaf-driver-make-build
# RUN: rm -rf %t && split-file %s %t

# A failing build fails the run with the orchestrator's status, and leaves
# neither a patch nor a report.
# RUN: cd %t
# RUN: not %clang-ssaf-driver --transformation=cpp-bounded-buffers \
# RUN:     --ssaf-clang=%ssaf-driver-clang -o %t/out -- make 2>&1 \
# RUN:   | FileCheck %s
# CHECK: clang-ssaf-orchestrator-make: error: build failed (exit 2)
# CHECK: clang-ssaf-driver: error: clang-ssaf-orchestrator-make failed (exit 2)
# RUN: not ls %t/out/cpp-bounded-buffers.patch
# RUN: not ls %t/out/cpp-bounded-buffers.sarif

#--- Makefile
all:
	false
