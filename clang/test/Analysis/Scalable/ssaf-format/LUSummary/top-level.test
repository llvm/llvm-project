// Top-level LUSummary structure tests: BuildNamespace 'lu_namespace'
// field parsing and missing top-level fields (lu_namespace, id_table,
// linkage_table, data).

// REQUIRES: plugins

// ============================================================================
// buildNamespaceFromJSON() errors (lu_namespace field) -- LU-SPECIFIC
// ============================================================================

// RUN: not clang-ssaf-format --type lu %S/Inputs/lu-namespace-not-array.json 2>&1 \
// RUN:   | FileCheck %s --match-full-lines --check-prefix=LU-NAMESPACE-NOT-ARRAY
// RUN: not clang-ssaf-format --type lu --encoding %S/Inputs/lu-namespace-not-array.json 2>&1 \
// RUN:   | FileCheck %s --match-full-lines --check-prefix=LU-NAMESPACE-NOT-ARRAY
// LU-NAMESPACE-NOT-ARRAY:      clang-ssaf-format: error: reading LUSummary from file '{{.*}}lu-namespace-not-array.json'
// LU-NAMESPACE-NOT-ARRAY-NEXT: failed to read BuildNamespace from field 'lu_namespace': expected JSON array

// RUN: not clang-ssaf-format --type lu %S/Inputs/lu-namespace-element-not-string.json 2>&1 \
// RUN:   | FileCheck %s --match-full-lines --check-prefix=LU-NAMESPACE-ELEMENT-NOT-STRING
// RUN: not clang-ssaf-format --type lu --encoding %S/Inputs/lu-namespace-element-not-string.json 2>&1 \
// RUN:   | FileCheck %s --match-full-lines --check-prefix=LU-NAMESPACE-ELEMENT-NOT-STRING
// LU-NAMESPACE-ELEMENT-NOT-STRING:      clang-ssaf-format: error: reading LUSummary from file '{{.*}}lu-namespace-element-not-string.json'
// LU-NAMESPACE-ELEMENT-NOT-STRING-NEXT: reading BuildNamespace from field 'lu_namespace'
// LU-NAMESPACE-ELEMENT-NOT-STRING-NEXT: failed to read BuildNamespace name from index '0': expected JSON string

// ============================================================================
// readLUSummary() / readLUSummaryEncoding() errors
