{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/cos02/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "artifacts": [
        {
          "length": 120,
          "location": {
            "index": 1,
            "uri": "file:///src/a.cpp"
          },
          "mimeType": "text/plain",
          "roles": [
            "resultFile"
          ]
        },
        {
          "length": 60,
          "location": {
            "index": 0,
            "uri": "file:///src/shared.h"
          },
          "mimeType": "text/plain",
          "roles": [
            "resultFile"
          ]
        }
      ],
      "columnKind": "unicodeCodePoints",
      "results": [
        {
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "index": 0
                },
                "region": {
                  "endColumn": 12,
                  "endLine": 3,
                  "startColumn": 8,
                  "startLine": 3
                }
              }
            }
          ],
          "message": {
            "text": "multi-level pointer indirection is not yet rewritten"
          },
          "ruleId": "cpp-bounded-buffers-skipped",
          "ruleIndex": 0
        },
        {
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "index": 1,
                  "uri": "file:///src/a.cpp"
                },
                "region": {
                  "endColumn": 7,
                  "endLine": 7,
                  "startColumn": 3,
                  "startLine": 7
                }
              }
            }
          ],
          "message": {
            "text": "declarator spelled through a macro is not yet rewritten"
          },
          "relatedLocations": [
            {
              "id": 1,
              "message": {
                "text": "the macro"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "index": 0
                },
                "region": {
                  "endColumn": 5,
                  "endLine": 2,
                  "startColumn": 1,
                  "startLine": 2
                }
              }
            }
          ],
          "ruleId": "cpp-bounded-buffers-skipped",
          "ruleIndex": 0
        }
      ],
      "tool": {
        "driver": {
          "fullName": "clang ScalableStaticAnalysisFramework source transformation (cpp-bounded-buffers)",
          "informationUri": "https://clang.llvm.org/docs/UsersManual.html",
          "language": "en-US",
          "name": "clang-ssaf",
          "rules": [
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1
              },
              "fullDescription": {
                "text": ""
              },
              "id": "cpp-bounded-buffers-skipped",
              "name": ""
            }
          ],
          "version": "24.0.0git"
        }
