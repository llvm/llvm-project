// clang lists a run's artifacts in URI order but numbers them in the order
// they were first referred to, and its results refer to them by that number.
// A location that names its artifact only by number, in a result or in a
// related location, is placed by the artifact's own index.

// RUN: rm -rf %t && mkdir -p %t
// RUN: clang-ssaf-report-merge %S/Inputs/tu-clang-order.sarif \
// RUN:   %S/Inputs/tu-b.sarif -o %t/merged.sarif
// RUN: FileCheck %s --input-file=%t/merged.sarif
// RUN: grep 'multi-level pointer indirection' %t/merged.sarif | count 1

// CHECK:      "results": [
// CHECK:        "index": 0,
// CHECK-NEXT:   "uri": "file:///src/a.cpp"
// CHECK:        "text": "declarator spelled through a macro is not yet rewritten"
// CHECK:      "relatedLocations": [
// CHECK:        "index": 2,
// CHECK-NEXT:   "uri": "file:///src/shared.h"
// CHECK:        "index": 1,
// CHECK-NEXT:   "uri": "file:///src/b.cpp"
// CHECK:        "index": 2,
// CHECK-NEXT:   "uri": "file:///src/shared.h"
// CHECK:        "text": "multi-level pointer indirection is not yet rewritten"
