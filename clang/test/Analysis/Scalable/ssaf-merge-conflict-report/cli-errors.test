// Tests for clang-ssaf-merge-conflict-report errors.

// RUN: rm -rf %t
// RUN: mkdir -p %t

// ============================================================================
// CLI error: no arguments
// ============================================================================

// RUN: not clang-ssaf-merge-conflict-report 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NO-ARGS
// NO-ARGS: clang-ssaf-merge-conflict-report{{(\.exe)?}}: Not enough positional command line arguments specified!

// ============================================================================
// CLI error: missing -o
// ============================================================================

// RUN: not clang-ssaf-merge-conflict-report %S/Inputs/conflicts-a.sarif 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NO-OUTPUT
// NO-OUTPUT: clang-ssaf-merge-conflict-report{{(\.exe)?}}: for the -o option: must be specified at least once!

// ============================================================================
// Error: nonexistent input
// ============================================================================

// RUN: not clang-ssaf-merge-conflict-report %t/missing.sarif \
// RUN:   -o %t/out.sarif 2>&1 \
// RUN:   | FileCheck %s --check-prefix=MISSING -DPATH=%t/missing.sarif
// MISSING: clang-ssaf-merge-conflict-report: error: failed to read '[[PATH]]': {{.*}}

// ============================================================================
// Error: input is not JSON
// ============================================================================

// RUN: echo 'not json' > %t/not-json.sarif
// RUN: not clang-ssaf-merge-conflict-report %t/not-json.sarif \
// RUN:   -o %t/out.sarif 2>&1 \
// RUN:   | FileCheck %s --check-prefix=NOT-JSON -DPATH=%t/not-json.sarif
// NOT-JSON: clang-ssaf-merge-conflict-report: error: failed to parse '[[PATH]]': {{.*}}

// ============================================================================
// Error: input does not have exactly one run
// ============================================================================

// RUN: not clang-ssaf-merge-conflict-report %S/Inputs/two-runs.sarif \
// RUN:   -o %t/out.sarif 2>&1 \
// RUN:   | FileCheck %s --check-prefix=TWO-RUNS
// TWO-RUNS: clang-ssaf-merge-conflict-report: error: '{{.*}}two-runs.sarif' is not a SARIF log with exactly one run

// ============================================================================
// Error: inputs written by different tools
// ============================================================================

// RUN: not clang-ssaf-merge-conflict-report %S/Inputs/conflicts-a.sarif \
// RUN:   %S/Inputs/other-tool.sarif -o %t/out.sarif 2>&1 \
// RUN:   | FileCheck %s --check-prefix=OTHER
// OTHER: clang-ssaf-merge-conflict-report: error: '{{.*}}other-tool.sarif' was written by 'clang-ssaf', not by 'clang-ssaf-src-edit-merge'

// ============================================================================
// Error: the output cannot be written
// ============================================================================

// RUN: not clang-ssaf-merge-conflict-report %S/Inputs/conflicts-a.sarif \
// RUN:   -o %t/no-such-dir/out.sarif 2>&1 \
// RUN:   | FileCheck %s --check-prefix=CANNOT-WRITE -DPATH=%t/no-such-dir/out.sarif
// CANNOT-WRITE: clang-ssaf-merge-conflict-report: error: failed to write '[[PATH]]': {{.*}}

// No error leaves an output behind.
// RUN: not ls %t/out.sarif
