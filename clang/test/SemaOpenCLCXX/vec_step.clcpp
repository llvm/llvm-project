// RUN: %clang_cc1 %s -verify -fsyntax-only -triple spir

typedef float float4 __attribute__((ext_vector_type(4)));

void test(float4 &ref, float4 val) {
  int a = vec_step(float4);
  int b = vec_step(val);
  int c = vec_step(ref);
  int d = vec_step(float4 &); // expected-error {{'vec_step' requires built-in scalar or vector type}}
  int e = vec_step(const float4 &); // expected-error {{'vec_step' requires built-in scalar or vector type}}
}
