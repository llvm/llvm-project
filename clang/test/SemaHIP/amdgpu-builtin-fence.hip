#define __device__ __attribute__((device))

template <int MemoryOrder>
__device__ void test_dependent_order() {
  __builtin_amdgcn_fence(MemoryOrder, "agent");
}

extern constexpr char AgentScope[] = "agent";

template <const char *Scope>
__device__ void test_dependent_scope() {
  __builtin_amdgcn_fence(__ATOMIC_SEQ_CST, Scope);
}

template __device__ void test_dependent_order<__ATOMIC_SEQ_CST>();
template __device__ void test_dependent_scope<AgentScope>();
