// NOTE: Assertions have been autogenerated by utils/update_cc_test_checks.py
// RUN: %clang_cc1 -cl-std=CL2.0 -O0 -triple amdgcn-unknown-unknown -target-cpu gfx1250 -emit-llvm -o - %s | FileCheck %s
// REQUIRES: amdgpu-registered-target

typedef int __attribute__((ext_vector_type(2))) int2;
typedef int __attribute__((ext_vector_type(4))) int4;
typedef int __attribute__((ext_vector_type(8))) int8;
typedef float __attribute__((ext_vector_type(2))) float2;
typedef float __attribute__((ext_vector_type(4))) float4;

// === sched_vgpr tests ===

// CHECK-LABEL: @test_sched_vgpr_i32
// CHECK: call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %{{.*}}, i32 42, i32 0)
void test_sched_vgpr_i32(global int *out, int x) {
  *out = __builtin_amdgcn_sched_vgpr(x, 42, false);
}

// CHECK-LABEL: @test_sched_vgpr_f32_strict
// CHECK: call float @llvm.amdgcn.sched.vgpr.f32(float %{{.*}}, i32 100, i32 1)
void test_sched_vgpr_f32_strict(global float *out, float x) {
  *out = __builtin_amdgcn_sched_vgpr(x, 100, true);
}

// CHECK-LABEL: @test_sched_vgpr_i64
// CHECK: call i64 @llvm.amdgcn.sched.vgpr.i64(i64 %{{.*}}, i32 200, i32 0)
void test_sched_vgpr_i64(global long *out, long x) {
  *out = __builtin_amdgcn_sched_vgpr(x, 200, false);
}

// CHECK-LABEL: @test_sched_vgpr_v2i32
// CHECK: call <2 x i32> @llvm.amdgcn.sched.vgpr.v2i32(<2 x i32> %{{.*}}, i32 50, i32 1)
void test_sched_vgpr_v2i32(global int2 *out, int2 x) {
  *out = __builtin_amdgcn_sched_vgpr(x, 50, true);
}

// CHECK-LABEL: @test_sched_vgpr_v4i32
// CHECK: call <4 x i32> @llvm.amdgcn.sched.vgpr.v4i32(<4 x i32> %{{.*}}, i32 512, i32 1)
void test_sched_vgpr_v4i32(global int4 *out, int4 x) {
  *out = __builtin_amdgcn_sched_vgpr(x, 512, true);
}

// CHECK-LABEL: @test_sched_vgpr_default_strict
// CHECK: call i32 @llvm.amdgcn.sched.vgpr.i32(i32 %{{.*}}, i32 42, i32 1)
void test_sched_vgpr_default_strict(global int *out, int x) {
  // 2 args: strict=true by default
  *out = __builtin_amdgcn_sched_vgpr(x, 42);
}

