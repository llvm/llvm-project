// NOTE: Assertions have been autogenerated by utils/update_cc_test_checks.py UTC_ARGS: --version 6
// RUN: %clang_cc1 -triple amdgpu9.50-amd-amdhsa -cl-std=CL2.0 -O2 -emit-llvm -o - %s | FileCheck %s
// REQUIRES: amdgpu-registered-target

// The void hint must survive optimization in the conditional load arm.
// CHECK-LABEL: define dso_local amdgpu_kernel void @hinted_kernel(
// CHECK-SAME: ptr addrspace(1) nofree noundef readonly align 4 captures(none) [[DATA:%.*]], ptr addrspace(1) nofree noundef writeonly align 4 captures(none) [[OUT:%.*]], i32 noundef [[CONDITION:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] !kernel_arg_addr_space [[META8:![0-9]+]] !kernel_arg_access_qual [[META9:![0-9]+]] !kernel_arg_type [[META10:![0-9]+]] !kernel_arg_base_type [[META10]] !kernel_arg_type_qual [[META11:![0-9]+]] {
// CHECK-NEXT:  [[ENTRY:.*]]:
// CHECK-NEXT:    [[TMP0:%.*]] = tail call i32 @llvm.amdgcn.workitem.id.x()
// CHECK-NEXT:    [[IDXPROM_I:%.*]] = zext nneg i32 [[TMP0]] to i64
// CHECK-NEXT:    [[ARRAYIDX_I:%.*]] = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) [[DATA]], i64 [[IDXPROM_I]]
// CHECK-NEXT:    [[TMP1:%.*]] = load i32, ptr addrspace(1) [[ARRAYIDX_I]], align 4, !tbaa [[INT_TBAA12:![0-9]+]], !amdgpu.noclobber [[META13:![0-9]+]]
// CHECK-NEXT:    [[TOBOOL_NOT_I:%.*]] = icmp eq i32 [[CONDITION]], 0
// CHECK-NEXT:    br i1 [[TOBOOL_NOT_I]], label %[[__CLANG_OCL_KERN_IMP_HINTED_KERNEL_EXIT:.*]], label %[[IF_THEN_I:.*]]
// CHECK:       [[IF_THEN_I]]:
// CHECK-NEXT:    [[ARRAYIDX2_I:%.*]] = getelementptr inbounds nuw i8, ptr addrspace(1) [[ARRAYIDX_I]], i64 256
// CHECK-NEXT:    [[TMP2:%.*]] = load i32, ptr addrspace(1) [[ARRAYIDX2_I]], align 4, !tbaa [[INT_TBAA12]], !amdgpu.noclobber [[META13]]
// CHECK-NEXT:    tail call void @llvm.amdgcn.pad.waitcnt(i32 0, i32 1)
// CHECK-NEXT:    br label %[[__CLANG_OCL_KERN_IMP_HINTED_KERNEL_EXIT]]
// CHECK:       [[__CLANG_OCL_KERN_IMP_HINTED_KERNEL_EXIT]]:
// CHECK-NEXT:    [[V_0_I:%.*]] = phi i32 [ [[TMP2]], %[[IF_THEN_I]] ], [ 0, %[[ENTRY]] ]
// CHECK-NEXT:    [[ARRAYIDX4_I:%.*]] = getelementptr inbounds nuw [4 x i8], ptr addrspace(1) [[OUT]], i64 [[IDXPROM_I]]
// CHECK-NEXT:    store i32 [[TMP1]], ptr addrspace(1) [[ARRAYIDX4_I]], align 4, !tbaa [[INT_TBAA12]]
// CHECK-NEXT:    [[ARRAYIDX7_I:%.*]] = getelementptr inbounds nuw i8, ptr addrspace(1) [[ARRAYIDX4_I]], i64 256
// CHECK-NEXT:    store i32 [[V_0_I]], ptr addrspace(1) [[ARRAYIDX7_I]], align 4, !tbaa [[INT_TBAA12]]
// CHECK-NEXT:    ret void
//
kernel void hinted_kernel(global int *data, global int *out,
                          int condition) {
  unsigned index = __builtin_amdgcn_workitem_id_x();
  int a = data[index];
  int v = 0;
  if (condition) {
    v = data[index + 64];
    __builtin_amdgcn_pad_waitcnt(0, 1);
  }
  out[index] = a;
  out[index + 64] = v;
}
//.
// CHECK: [[META5:![0-9]+]] = !{!"int", [[META6:![0-9]+]], i64 0}
// CHECK: [[META6]] = !{!"omnipotent char", [[META7:![0-9]+]], i64 0}
// CHECK: [[META7]] = !{!"Simple C/C++ TBAA"}
// CHECK: [[META8]] = !{i32 1, i32 1, i32 0}
// CHECK: [[META9]] = !{!"none", !"none", !"none"}
// CHECK: [[META10]] = !{!"int*", !"int*", !"int"}
// CHECK: [[META11]] = !{!"", !"", !""}
// CHECK: [[INT_TBAA12]] = !{[[META5]], [[META5]], i64 0}
// CHECK: [[META13]] = !{}
//.
