- Name: normalizedAlias
  Where:
    Parameters:
    - int
  SwiftName: normalizedAlias(_:)
- Name: normalizedDeepAlias
  Where:
    Parameters:
    - int
  SwiftName: normalizedDeepAlias(_:)
- Name: normalizedDeepAliasSource
