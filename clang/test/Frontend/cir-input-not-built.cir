// Test that ClangIR input is rejected cleanly, instead of being parsed as C,
// when clang is not built with CIR support. The CIR actions are not available,
// so the classic code generation actions are used and they lack CIR support.

// This test should only run when CIR support is NOT enabled
// UNSUPPORTED: cir-support

// RUN: not %clang_cc1 -triple x86_64-unknown-linux-gnu -emit-obj %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --implicit-check-not=error:
// RUN: not %clang_cc1 -triple x86_64-unknown-linux-gnu -emit-llvm -x cir %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s --implicit-check-not=error:

// CHECK: fatal error: cannot apply AST actions to ClangIR file '{{.*}}cir-input-not-built.cir'

!s32i = !cir.int<s, 32>
module {
  cir.func @f(%arg0: !s32i) -> !s32i {
    cir.return %arg0 : !s32i
  }
}
