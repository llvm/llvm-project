// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fclangir -emit-llvm -disable-O0-optnone -o - %s | opt -passes=mem2reg -S | FileCheck %s --check-prefixes=C,LLVM

// C-LABEL: @f(
// LLVM-SAME: i32 noundef [[TMP0:%.*]])
// LLVM:    [[TMP1:%.*]] = add nsw i32 [[TMP0]], 1
