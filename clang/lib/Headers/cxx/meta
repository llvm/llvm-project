 /*
 * This meta header is vendored in Clang in order to
 * account for compatibility with libstdc++, especially
 * when we use clang and link libstdc++ as the standard library.
 * The meta header in libstdc++ only provides declarations
 * of the metafunctions, and clang decided to pursue
 * having builtins instead. 
 *
 * Right now, in clang driver, it will insert the paths
 * for standard library first before the clang's own headers.
 * So if we put the meta header in the same place as the existing
 * C headers, it will not work because clang will continue to search
 * for the path of the standard library's meta header first.
 * To address this issue, a new directory will be created in clang just
 * for the meta header. Whether any new clang's C++ header will be in
 * this directory as well will be a topic for discussion, no conrete plan
 * has been made on this yet.
 *
 * In coordination with libc++, the clang team will discuss with the libc++ team
 * to ensure the include_next approach will work as expected for each side.
 */

#ifndef __CLANG_META
#define __CLANG_META

#if !defined(__clang__)
#error "this <meta> header is part of Clang and can only be used when compiling with Clang"
#elif !defined(__cplusplus)
#error "<meta> is only available in C++ mode"
#elif !defined(__CLANG_CXX_REFLECTION__)
#error "<meta> is only available when -freflection is enabled"
#else


namespace std {
namespace meta {

using info = decltype(^^int);

/// \return \c true if \p __r represents an entity whose underlying entity is a type; \c false otherwise.
consteval bool is_type(info __r) {
    return __builtin_meta_is_type(__r);
}

} // namespace meta
} // namespace std

#endif

#endif // __CLANG_META
