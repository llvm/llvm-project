{
  "version": 1,
  "symbol_prefix_regex": "^__llvm_libc[0-9A-Za-z_]*::",
  "regex_aliases": {
    "soft_double_helpers": "__aeabi_(dadd|dsub|drsub|dmul|ddiv|dneg|dcmp[a-z]+|cdcmp[a-z]+|cdrcmp[a-z]+|f2d|d2f|i2d|ui2d|l2d|ul2d|d2iz|d2uiz|d2lz|d2ulz)|__(add|sub|mul|div|neg)df3|__extendsfdf2|__truncdfsf2|__float(un)?(si|di|ti)df|__fix(uns)?df(si|di|ti)|__(eq|ne|lt|le|gt|ge|un|cmp)df2"
  },
  "rules": [
    {
      "id": "skip-accurate-no-multiprecision",
      "comment": "With LIBC_MATH_SKIP_ACCURATE_PASS, functions must not contain the multi-precision helpers used by the accurate pass. The exceptions are correctly rounded basic operations (fused multiply-add and narrowing arithmetic) that use DyadicFloat as their main algorithm rather than as an accurate pass. f128 and long double variants inherently need wide arithmetic.",
      "when_flags": ["LIBC_MATH_SKIP_ACCURATE_PASS"],
      "exclude_variants": ["f128", "long_double"],
      "exceptions": ["bf16fma", "bf16mul", "daddl", "ddivl", "dfmal", "dmull", "dsqrtl", "dsubl", "f16fma", "f16mul", "ffma", "fma", "fmul"],
      "forbid_defined_regex": ["DyadicFloat<(128|192|256)u?l?>", "BigInt<", "_f128\\(", "_f256\\(", "accurate"]
    },
    {
      "id": "small-tables-max-object",
      "comment": "With LIBC_MATH_SMALL_TABLES, no named data object may exceed 512 bytes. The exceptions are ceilings for the current tables; lower or remove them as tables shrink.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "max_named_data_object_bytes": 512,
      "max_named_data_object_exceptions": {
        "atan": {"bytes": 1040, "note": "atan_internal::ATAN_I; a smaller table is pending"},
        "atan2": {"bytes": 1040, "note": "atan_internal::ATAN_I; a smaller table is pending"},
        "atan2f128": 1560,
        "atan2f16": 1224,
        "atan2l": 1560,
        "cbrtbf16": 896,
        "cbrtf": 896,
        "cos": 2048,
        "erff": 2048,
        "exp": {"bytes": 1536, "note": "EXP2_MID1/EXP2_MID2; smaller tables are pending"},
        "exp10": {"bytes": 1536, "note": "EXP2_MID1/EXP2_MID2; smaller tables are pending"},
        "expm1": 1536,
        "expm1f": 1560,
        "lgammaf": 2048,
        "log": 2048,
        "log10": 2048,
        "log10f": {"bytes": 1024, "note": "128-entry log tables; smaller tables are pending"},
        "log1p": 2064,
        "log2": {"bytes": 2048, "note": "log2_internal::LOG_R1; smaller tables are pending"},
        "log2f": {"bytes": 1024, "note": "128-entry log tables; smaller tables are pending"},
        "logf": {"bytes": 1024, "note": "128-entry log tables; smaller tables are pending"},
        "pow": {"bytes": 2048, "note": "pow_internal::LOG2_R_DD; smaller tables are pending"},
        "sin": 2048,
        "sincos": 2048,
        "tan": 2048
      }
    },
    {
      "id": "no-writable-data",
      "comment": "Math functions must not have writable data. The only exceptions are the static volatile variables that the functions in fputil::generic (FPUtil/rounding_mode.h) use to probe the rounding mode, which are not used with LIBC_MATH_ASSUME_ROUND_NEAREST_ONLY (see no-writable-data-round-nearest).",
      "max_writable_data_bytes": 0,
      "allow_writable_sections": ["^\\.data\\._ZZN[0-9]+__llvm_libc[0-9A-Za-z_]*6fputil7generic[0-9]+(quick_get_round|fenv_is_round_(up|down|to_nearest|to_zero))EvE1x$"]
    },
    {
      "id": "no-writable-data-round-nearest",
      "when_flags": ["LIBC_MATH_ASSUME_ROUND_NEAREST_ONLY"],
      "max_writable_data_bytes": 0
    },
    {
      "id": "float-comp-no-soft-double",
      "comment": "With LIBC_MATH_INTERMEDIATE_COMP_IN_FLOAT, these single precision functions must not call double precision soft-float helpers on targets without a hardware double precision FPU.",
      "when_flags": ["LIBC_MATH_INTERMEDIATE_COMP_IN_FLOAT"],
      "when_macros": ["__arm__ || __riscv", "!__ARM_FP&0x8", "!__riscv_flen&64"],
      "functions": ["logf", "log2f", "log10f", "expf", "exp2f", "exp10f", "atanf", "powf"],
      "forbid_undefined": ["@soft_double_helpers"],
      "known_exceptions": {
        "logf": {"symbols": ["@soft_double_helpers"], "note": "a float-only implementation is pending"},
        "log2f": {"symbols": ["@soft_double_helpers"], "note": "a float-only implementation is pending"},
        "log10f": {"symbols": ["@soft_double_helpers"], "note": "a float-only implementation is pending"}
      }
    },
    {
      "id": "small-tables-log-float",
      "comment": "With LIBC_MATH_SMALL_TABLES, logf, log2f and log10f must not use the 128-entry log tables.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["logf", "log2f", "log10f"],
      "forbid_defined": ["common_constants_internal::(R|RD|CD|LOG_R|LOG2_R)", "log10f_internal::LOG10_R"],
      "known_exceptions": {
        "logf": {"symbols": ["common_constants_internal::(R|RD|LOG_R)"], "note": "a small-table implementation is pending"},
        "log2f": {"symbols": ["common_constants_internal::(R|RD|LOG2_R)"], "note": "a small-table implementation is pending"},
        "log10f": {"symbols": ["common_constants_internal::R", "log10f_internal::LOG10_R"], "note": "a small-table implementation is pending"}
      }
    },
    {
      "id": "small-tables-powf",
      "comment": "With LIBC_MATH_SMALL_TABLES, powf must use the 16-entry log2 tables instead of the 32- and 128-entry ones.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["powf"],
      "forbid_defined": ["powf_internal::(LOG2_R_TD|R_32_D|LOG2_R_32)", "common_constants_internal::(R|RD|CD|LOG2_R)", "ExpBase::EXP_2_MID", "EXP2_MID1|EXP2_MID2"],
      "require_defined": ["LOG2_R_FF_16"]
    },
    {
      "id": "small-tables-pow",
      "comment": "With LIBC_MATH_SMALL_TABLES, pow must not use the 256-entry tables of its accurate pass or the 128-entry double-double tables.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["pow"],
      "forbid_defined": ["pow_internal::(LOG2_RD_FRAC256|EXP2_MID_FRAC256|LOG2_POLY_256|EXP2_POLY_256|LOG2_R_DD)", "double_eval::(EXP2_MID_FRAC128|EXP2_POLY_128)", "EXP2_MID1|EXP2_MID2"],
      "known_exceptions": {
        "pow": {"symbols": ["pow_internal::LOG2_R_DD", "EXP2_MID1"], "note": "smaller tables are pending"}
      }
    },
    {
      "id": "small-tables-log",
      "comment": "With LIBC_MATH_SMALL_TABLES, log, log2 and log10 must not use the tables of their accurate pass.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["log", "log2", "log10"],
      "forbid_defined": ["(log|log2|log10)_internal::(LOG|LOG2|LOG10)_TABLE", "common_constants_internal::(S2|S3|S4)", "log2_internal::LOG_R1"],
      "known_exceptions": {
        "log2": {"symbols": ["log2_internal::LOG_R1"], "note": "smaller tables are pending"}
      }
    },
    {
      "id": "small-tables-exp",
      "comment": "With LIBC_MATH_SMALL_TABLES, exp, exp2 and exp10 must not use the 64+64-entry EXP2_MID1/EXP2_MID2 tables or the 128-entry tables of the accurate pass.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["exp", "exp2", "exp10"],
      "forbid_defined": ["EXP2_MID1|EXP2_MID2", "double_eval::(EXP2_MID_FRAC128|EXP2_POLY_128)"],
      "known_exceptions": {
        "exp": {"symbols": ["EXP2_MID1|EXP2_MID2"], "note": "smaller tables are pending"},
        "exp10": {"symbols": ["EXP2_MID1|EXP2_MID2"], "note": "smaller tables are pending"}
      }
    },
    {
      "id": "small-tables-exp-float",
      "comment": "With LIBC_MATH_SMALL_TABLES, expf, exp2f and exp10f must not use the EXP_M1/EXP_M2 or ExpBase tables.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["expf", "exp2f", "exp10f"],
      "forbid_defined": ["EXP_M1|EXP_M2", "ExpBase::EXP_2_MID"]
    },
    {
      "id": "small-tables-atan",
      "comment": "With LIBC_MATH_SMALL_TABLES, atan and atan2 must not use the 65-entry ATAN_I table.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["atan", "atan2"],
      "forbid_defined": ["atan_internal::ATAN_I"],
      "known_exceptions": {
        "atan": {"symbols": ["atan_internal::ATAN_I"], "note": "a smaller table is pending"},
        "atan2": {"symbols": ["atan_internal::ATAN_I"], "note": "a smaller table is pending"}
      }
    },
    {
      "id": "small-tables-atan-float",
      "comment": "With LIBC_MATH_SMALL_TABLES, atanf and atan2f must not use the polynomial table of the accurate implementation.",
      "when_flags": ["LIBC_MATH_SMALL_TABLES"],
      "functions": ["atanf", "atan2f"],
      "forbid_defined": ["atan_internal::ATAN_COEFFS"]
    },
    {
      "id": "small-tables-float-trig",
      "comment": "With LIBC_MATH_SKIP_ACCURATE_PASS and LIBC_MATH_SMALL_TABLES on targets with single precision FMA, sinf and cosf use the float evaluation with its 16-entry table instead of the 64-entry SIN_K_PI_OVER_32 table (see LIBC_TARGET_CPU_HAS_FMA_FLOAT).",
      "when_flags": ["LIBC_MATH_SKIP_ACCURATE_PASS", "LIBC_MATH_SMALL_TABLES"],
      "when_macros": ["__ARM_FEATURE_FMA || __FMA__ || __riscv_flen", "__ARM_FEATURE_FMA || __AVX2__ || __riscv_flen"],
      "functions": ["sinf", "cosf"],
      "forbid_defined": ["sincosf_utils_internal::SIN_K_PI_OVER_32"],
      "require_defined": ["sincosf_float_eval::SIN_K_PI_OVER_8"]
    }
  ]
}
