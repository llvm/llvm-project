import lit.formats

config.name = "inter"
config.test_format = lit.formats.ShTest(False)
config.suffixes = [".mlir"]
config.test_source_root = "@CMAKE_CURRENT_SOURCE_DIR@"
config.test_exec_root = "@CMAKE_CURRENT_BINARY_DIR@"

config.substitutions.append(
    ("inter-opt", "@CMAKE_BINARY_DIR@/tools/inter-opt/inter-opt"))
config.substitutions.append(
    ("inter-translate", "@CMAKE_BINARY_DIR@/tools/inter-translate/inter-translate"))
config.substitutions.append(
    ("FileCheck", "@LLVM_TOOLS_BINARY_DIR@/FileCheck"))
config.substitutions.append(
    ("inter-ged-dump", "@CMAKE_CURRENT_BINARY_DIR@/inter-ged-dump"))
