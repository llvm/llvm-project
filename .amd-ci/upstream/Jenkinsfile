        string(
            name: 'CPU2026_BENCHMARK_LIST',
            defaultValue: '706.stockfish_r, 707.ntest_r, 708.sqlite_r, 709.cactus_r, 710.omnetpp_r, 714.cpython_r, 721.gcc_r, 722.palm_r, 723.llvm_r, 727.cppcheck_r, 729.abc_r, 731.astcenc_r, 734.vpr_r, 735.gem5_r, 736.ocio_r, 737.gmsh_r, 748.flightdm_r, 749.fotonik3d_r, 750.sealcrypto_r, 753.ns3_r, 765.roms_r, 766.femflow_r, 767.nest_r, 772.marian_r, 777.zstd_r, 782.lbm_r',
            description: 'Comma-separated list of CPU2026 benchmarks.'
        ),
        string(
            name: 'CPU2026_EXTRA_RUNCPU_ARGS',
            defaultValue: '--define march=native --define flto',
            description: '''Extra args appended to CPU2026 runcpu via <code>--extra_runcpu_args</code>.<br>
Default matches the AOCC-LLVM21 baseline (<code>--define march=native --define flto</code>).'''
        ),

        // ---------- Configuration files (shared CPU2017 & CPU2026) ----------
        separator(name: 'sep_cfg_files', sectionHeader: 'Configuration Files',
                  sectionHeaderStyle: specSepStyle),
        text(
            name: 'CFG_FILES',
            defaultValue: 'cpu2017_amd_linux_znver5_llvm_rate_bestmined.cfg, cpu2017_amd_linux_znver5_llvm_speed_bestmined.cfg, cpu2026_amd_linux_znver5_llvm_rate_bestmined.cfg, cpu2026_amd_linux_znver5_llvm_speed_bestmined.cfg',
            description: 'Comma-separated list of cfg file names (cpu2017_*.cfg and/or cpu2026_*.cfg).'
        ),
        booleanParam(
            name: 'USE_SPEC_CONFIGS_REPO',
            defaultValue: true,
            description: '''Clone the <code>spec-configs</code> git repo into this build, stage it as
<code>SPEC_perf_cfgs/</code>, archive that directory tree, and forward Jenkins'
on-the-fly directory-zip URL
(<code>artifact/SPEC_perf_cfgs/*zip*/SPEC_perf_cfgs.zip</code>) as
<code>SPECCPU_CFGDIR</code> to downstream SPEC jobs. When <b>true</b> (default),
<code>SPECCPU_CFGDIR</code> above is ignored. When <b>false</b>, the clone is
skipped and <code>SPECCPU_CFGDIR</code> is forwarded verbatim.'''
        ),
        string(
            name: 'SPEC_CONFIGS_REPO_URL',
            defaultValue: defaultSpecConfigsRepoUrl,
            description: 'Git URL of the <code>spec-configs</code> repo (used when <code>USE_SPEC_CONFIGS_REPO=true</code>).'
        ),
        string(
            name: 'SPEC_CONFIGS_BRANCH',
            defaultValue: defaultSpecConfigsBranch,
            description: 'Branch / ref of <code>spec-configs</code> to check out.'
        ),
        booleanParam(
            name: 'SANITIZE_SPEC_CFGS_FOR_LLVM21',
            defaultValue: true,
            description: '''Strip pre-LLVM21 clang flags from every <code>*.cfg</code> in the cloned
<code>spec-configs/</code> tree before it is archived as <code>SPEC_perf_cfgs.zip</code>.
A <code>.cfg.orig</code> backup is kept beside each modified file and the diffs are
logged. Disable only when targeting a pre-LLVM21 compiler.'''
