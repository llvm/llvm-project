import groovy.transform.Field
import hudson.model.Result

// Load aocc-devops shared library for PipelineUtils.
String devopsLibPin = 'a8e58b3'
Object devopsLib = library(
    changelog: false,
    identifier: 'aoccDevopsUtils@' + devopsLibPin,
    retriever: modernSCM(
        scm: [
            $class: 'GitSCMSource',
            remote: 'git@github.amd.com:cpu-compilers/aocc-devops.git',
            credentialsId: 'Jenkins-AOCC-nonER-SSH'
        ],
        libraryPath: 'groovy_lib'
    )
)
@Field Object putils
putils = devopsLib.com.aocc.pipeline.PipelineUtils.new(this)

/* groovylint-disable-next-line CompileStatic */
String actualTarget = env.CHANGE_TARGET ?: env.BRANCH_NAME
String upstreamBranch = 'upstream-main', stagingBranch = 'amd-staging'
String releaseBranchPrefix = 'aocc_'

Boolean targetIsRelBranch = actualTarget.startsWith(releaseBranchPrefix)

// Code smell: should be enabled for staging once the underlying llvm code catches up:
Boolean dualFlangBuild = actualTarget != upstreamBranch && actualTarget != stagingBranch

/**
 * Coerce Result enums to String, seems to
 * be required by CatchErrorStep.setStageResult()
 */
String abortedResultStr = Result.ABORTED, failureResultStr = Result.FAILURE
String notBuiltResultStr = Result.NOT_BUILT, successResultStr = Result.SUCCESS

Boolean isAmdBranch = (env.BRANCH_NAME == stagingBranch || env.BRANCH_NAME.startsWith(releaseBranchPrefix))

if (
    !(actualTarget in [stagingBranch, upstreamBranch]) &&
        !targetIsRelBranch
) {
    echo 'Pipeline skipped for base branch ' + actualTarget
    return this
}

String actualHead = env.CHANGE_BRANCH ?: env.BRANCH_NAME
Boolean isPrBranch = env.CHANGE_BRANCH != null

if (
    !isPrBranch &&
        !(actualTarget in [stagingBranch, upstreamBranch]) &&
        !targetIsRelBranch
) {
    echo 'Pipeline skipped for non-PR branch ' + actualHead + ' of base ' + actualTarget
    return this
}

String manualCause = 'hudson.model.Cause$UserIdCause'
if (
    isPrBranch &&
        pullRequest.draft &&
        !currentBuild.getBuildCauses(manualCause)
) {
    String cause = currentBuild.getBuildCauses().shortDescription // groovylint-disable-line UnnecessaryGetter
    echo 'Draft PR aborted for cause ' + cause
    echo 'Pipeline only runs for draft PRs if manually triggered.'
    currentBuild.result = abortedResultStr
    return this
}

// Code smell: buildTypes are also defined in CommitCheck
String buildTypePresub = 'PRESUB' // groovylint-disable-line UnusedVariable
String buildTypeRelease = 'RELEASE' // groovylint-disable-line UnusedVariable
String buildTypeStaging = 'STAGING' // groovylint-disable-line UnusedVariable
// buildType is processed during branch creation:
String buildType = (isPrBranch ? buildTypePresub : buildTypeRelease)

if (!isPrBranch && !isAmdBranch) {
    if (actualTarget == upstreamBranch && actualHead == upstreamBranch) {
        buildType = buildTypeStaging
    } else {
        // Treat it as 'presub'.
        buildType = buildTypePresub
    }
}

Boolean postsub = (
    !isPrBranch &&
        (
        (actualTarget == upstreamBranch && actualHead == upstreamBranch) ||
            (actualTarget == stagingBranch && actualHead == stagingBranch) ||
            (targetIsRelBranch &&
             actualHead.startsWith(releaseBranchPrefix))
    )
)

if (
    postsub && !(env.BRANCH_NAME in [stagingBranch, upstreamBranch]) &&
        !(env.BRANCH_NAME.startsWith(releaseBranchPrefix))
) {
    echo 'Pipeline postsub not supported for branch ' + env.BRANCH_NAME
    return this
}

Boolean disableStaging = false, disableRelease = true
// Timer (cron) trigger removed (see the note above the properties block), so a
// timer-triggered run is no longer possible and the former '!timerTrigger'
// guard has been dropped from this condition.
if (
    ((disableStaging &&
      actualTarget == stagingBranch) ||
     (disableRelease &&
      targetIsRelBranch)) &&
        !currentBuild.getBuildCauses(manualCause)
) {
    String cause = currentBuild.getBuildCauses().shortDescription // groovylint-disable-line UnnecessaryGetter
    echo 'Pipeline for base ' + actualTarget + ' not built for cause ' + cause
    echo 'Pipeline only runs if manually triggered.'
    currentBuild.result = notBuiltResultStr
    return this
}

Boolean runDownstream = (
    actualTarget == upstreamBranch ||
        (actualTarget == stagingBranch && isPrBranch) ||
        targetIsRelBranch
)

String space = ' ', andChain = '&&', underScore = '_', slash = '/', dash = '-'
String gitCommitEnv = 'GIT_COMMIT', bashCmd = 'bash'
String skipStr = 'Skipping build.'

List propsList = []
if (isPrBranch) { // Sic; don't want postsub on upstream-main to go through this block.
    propsList.add(
        disableConcurrentBuilds(abortPrevious: true)
    )
    propsList.add(
        buildDiscarder(
            logRotator(
                daysToKeepStr: '7',
                numToKeepStr: '10'
            )
        )
    )
}
// Timer (cron) trigger disabled: this job now runs on push/merge events only.
// Previously postsub added a daily cron ('TZ=Asia/Kolkata\nH 0 * * *') which
// caused a second daily run alongside the push-to-upstream-main build (the
// upstream-main branch already receives a daily merge from the llvm_sync job).
//
// Restore the timerTrigger detection, the '!timerTrigger' guard,
//  and the merge-status override that were removed alongside this block.

// ===========================================================================
// Parallel SPEC Build CI parameters
// Mirrors gcc/.amd-ci/upstream/Jenkinsfile parameter set, adapted for LLVM/AOCC.
// ===========================================================================
String specSepStyle = 'background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);' +
    'color:white;padding:15px;border-radius:8px;font-size:18px;font-weight:bold;' +
    'margin:20px 0 10px 0;box-shadow:0 4px 6px rgba(0,0,0,0.1);'

String defaultJemallocUrl = 'https://atlartifactory.amd.com:8443/artifactory/SW-AOCC-REL-LOCAL/jemalloc/5.3.0/jemalloc-5.3.0-build-1.tar.xz'
String defaultLibmUrl = 'https://atlartifactory.amd.com:8443/artifactory/SW-AOCC-REL-LOCAL/libm/5.2.rc3/libm-5.2.rc3.tar'
String defaultAmdallocUrl = 'https://atlartifactory.amd.com:8443/artifactory/SW-AOCC-REL-LOCAL/amdalloc/1.0.4/amdalloc-1.0.4.tar'
String defaultSsmallocUrl = 'https://atlartifactory.amd.com:8443/artifactory/SW-AOCC-REL-LOCAL/ssmalloc/1.0.16/ssmalloc-1.0.16.tar'
// SPEC cfgs git repo (mirrors gcc/.amd-ci/upstream/Jenkinsfile). Cloned into
// the workspace, staged as SPEC_perf_cfgs/, and archived as a directory
// tree; the Jenkins on-the-fly '*zip*/SPEC_perf_cfgs.zip' URL is forwarded
// downstream as SPECCPU_CFGDIR when USE_SPEC_CONFIGS_REPO=true.
String defaultSpecConfigsRepoUrl = 'https://github.amd.com/cpu-compilers/spec-configs.git'
String defaultSpecConfigsBranch = 'main'

propsList.add(
    parameters([
