               description: 'mlce <code>--tune</code> (e.g. <code>base</code>, <code>peak</code>).'),
        booleanParam(name: 'SPEC_QUIET', defaultValue: true,
                     description: 'mlce <code>--quiet</code>: suppress runcpu progress chatter.'),
        booleanParam(name: 'SPEC_SKIP_SUDO', defaultValue: true,
                     description: 'mlce <code>--skip_sudo</code>: skip system-tuning sudo steps on runners.'),
        booleanParam(name: 'SPEC_ADD_TO_DATABASE', defaultValue: true,
                     description: 'mlce <code>--add_to_database</code>: publish results to the perf database.'),
        booleanParam(name: 'SPEC_OOB', defaultValue: true,
                     description: 'mlce <code>--oob</code>: out-of-box (generic-cfg) run mode.'),
        booleanParam(name: 'SPEC_REBUILD', defaultValue: true,
                     description: 'mlce <code>--rebuild</code>: force a  rebuild of SPEC binaries.'),
        booleanParam(name: 'SPEC_USE_JEMALLOC', defaultValue: true,
