            description: 'Comma-separated list of CPU2017 benchmarks. For dev iterations consider a subset such as 505.mcf_r.'
        ),
        string(
            name: 'CPU2017_EXTRA_RUNCPU_ARGS',
            defaultValue: '--define march=native --define flto',
            description: '''Extra args appended to runcpu via <code>--extra_runcpu_args</code>.<br>
Default matches the AOCC-LLVM21 baseline (<code>--define march=native --define flto</code>).'''
        ),

        // ---------- SPEC CPU2026 ----------
        separator(name: 'sep_cpu2026', sectionHeader: 'SPEC CPU2026',
                  sectionHeaderStyle: specSepStyle),
        booleanParam(
            name: 'ENABLE_CPU2026',
            defaultValue: true,
            description: 'Enable CPU2026 SPEC testing stages.'
