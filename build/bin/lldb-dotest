#!/usr/bin/python3.10
import os
import subprocess
import sys

dotest_path = '/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/lldb/test/API/dotest.py'
dotest_common_args_str = '-u;CXXFLAGS;-u;CFLAGS'
dotest_user_args_str = ''
triple = 'x86_64-unknown-linux-gnu'
executable = '/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/./bin/lldb'
compiler = '/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/./bin/clang'
dsymutil = '/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/./bin/dsymutil'
make = '/usr/bin/gmake'
lldb_build_dir = '/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/lldb-test-build'
lldb_build_intel_pt = "0"
lldb_build_mock_accelerator = "0"
lldb_framework_dir = ""
lldb_libs_dir = "/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/./lib"
llvm_tools_dir = "/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/./bin"
lldb_obj_root = "/home/saif/Desktop/Si-Vision/Si-Vision-internship/LLDB_SorceCode/llvm-project/build/tools/lldb"
lldb_launcher = ""
has_libcxx = 0
libcxx_libs_dir = ""
libcxx_include_dir = ""
libcxx_include_target_dir = ""
cmake_build_type = "Release"
lldb_enable_arm64e_debugserver = 0

if __name__ == '__main__':
    wrapper_args = sys.argv[1:]
    dotest_args = []
    # split on an empty string will produce [''] and if you
    # add that to the command, it will be treated as a directory...
    if dotest_common_args_str:
        dotest_args.extend(dotest_common_args_str.split(';'))
    if dotest_user_args_str:
        dotest_args.extend(dotest_user_args_str.split(';'))
    # Build dotest.py command.
    cmd = [sys.executable, dotest_path]
    cmd.extend(['--triple', triple])
    cmd.extend(dotest_args)
    cmd.extend(['--build-dir', lldb_build_dir])
    cmd.extend(['--executable', executable])
    cmd.extend(['--compiler', compiler])
    cmd.extend(['--dsymutil', dsymutil])
    cmd.extend(['--make', make])
    cmd.extend(['--lldb-libs-dir', lldb_libs_dir])
    cmd.extend(['--llvm-tools-dir', llvm_tools_dir])
    if has_libcxx:
        cmd.extend(['--libcxx-include-dir', libcxx_include_dir])
        if libcxx_include_target_dir:
            cmd.extend(['--libcxx-include-target-dir', libcxx_include_target_dir])
        cmd.extend(['--libcxx-library-dir', libcxx_libs_dir])
    if lldb_framework_dir:
        cmd.extend(['--framework', lldb_framework_dir])
    if lldb_build_intel_pt == "1":
        cmd.extend(['--enable-plugin', 'intel-pt'])
    if lldb_build_mock_accelerator == "1":
        cmd.extend(['--enable-plugin', 'mock-accelerator'])
    if lldb_enable_arm64e_debugserver:
        cmd.extend(['--arm64e-debugserver'])
    cmd.extend(['--lldb-obj-root', lldb_obj_root])
    cmd.extend(['--cmake-build-type', cmake_build_type])
    cmd.extend(wrapper_args)
    if lldb_launcher:
        cmd = [lldb_launcher] + cmd
    # Invoke dotest.py and return exit code.
    print(' '.join(cmd))
    sys.exit(subprocess.call(cmd))
