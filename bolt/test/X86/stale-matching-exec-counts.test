## Missing YAML exec fields must not make hot unmatched blocks invisible in
## stale-match statistics. Counts used by profile inference are unchanged.
# RUN: split-file %s %t
# RUN: yaml2obj %p/Inputs/blarge.yaml -o %t.exe
# RUN: llvm-bolt %t.exe -o %t.out -data %t/profile.yaml \
# RUN:   --infer-stale-profile --profile-ignore-hash=1 --profile-use-dfs=0 \
# RUN:   --print-cfg --print-only=usqrt 2>&1 | FileCheck %s

## Blocks 1 and 3 each have weight 320, although neither stores exec.
## Entry block 0 keeps its stored weight 20 despite zero recorded edge counts.
## Unmatched block 99 has a self-edge of 100 and must contribute 100, not zero
## or 200. Successor 4 is absent from the profile and is not another block in
## the denominator. Total weight = 20 + 320 + 320 + 100 = 760.
# CHECK: Binary Function "usqrt" after building cfg {
# CHECK: Exec Count  : 20
# CHECK: Sample Count: 740
# CHECK: count: 20)
# CHECK: count: 320)
# CHECK: count: 300), {{.*}}count: 20)
# CHECK: inference found an exact match for 50.00% of basic blocks (2 out of 4 stale) responsible for 84.21% samples (640 out of 760 stale)
# CHECK: inference found a call match for 0.00% of basic blocks (0 out of 4 stale) responsible for 0.00% samples (0 out of 760 stale)
# CHECK: inference found a loose match for 25.00% of basic blocks (1 out of 4 stale) responsible for 2.63% samples (20 out of 760 stale)

#--- profile.yaml
---
header:
  profile-version: 1
  binary-name: test.exe
  profile-flags: [ lbr ]
  dfs-order: false
  hash-func: xxh3
functions:
  - name: usqrt
    fid: 7
    hash: 0x0000000000000000
    exec: 20
    nblocks: 100
    blocks:
      - bid: 0
        insns: 4
        hash: 0x1111111111111111
        exec: 20
        succ: [ { bid: 1, cnt: 0 } ]
      - bid: 1
        insns: 9
        hash: 0xd70d7a64320e0010
        succ: [ { bid: 3, cnt: 320 }, { bid: 2, cnt: 0 } ]
      - bid: 3
        insns: 2
        hash: 0x5c06705524800039
        succ: [ { bid: 1, cnt: 300 }, { bid: 4, cnt: 20 } ]
      - bid: 99
        insns: 1
        hash: 0xFFFFFFFFFFFFFFFF
        succ: [ { bid: 99, cnt: 100 } ]
...

