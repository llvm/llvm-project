# RUN: rm -rf %t
# RUN: split-file %s %t
# RUN: sed -e "s|DIRECTORY|%/t|g" -e "s|CLANG|%clang|g" \
# RUN:   %t/compile_commands.json.in > %t/compile_commands.json
# RUN: sed -e "s|DIRECTORY|%/t|g" %t/requests.jsonrpc.in \
# RUN:   > %t/requests.jsonrpc
# RUN: clangd -background-index -lit-test < %t/requests.jsonrpc \
# RUN:   | FileCheck %t/requests.jsonrpc
# RUN: clangd -lit-test < %t/requests-no-document-changes.jsonrpc \
# RUN:   | FileCheck --check-prefix=NODOC %t/requests-no-document-changes.jsonrpc

#--- compile_commands.json.in
[
  {
    "directory": "DIRECTORY",
    "command": "CLANG -I DIRECTORY -c DIRECTORY/main.cpp",
    "file": "DIRECTORY/main.cpp"
  },
  {
    "directory": "DIRECTORY",
    "command": "CLANG -I DIRECTORY -c DIRECTORY/open.cpp",
    "file": "DIRECTORY/open.cpp"
  },
  {
    "directory": "DIRECTORY",
    "command": "CLANG -I DIRECTORY -c DIRECTORY/directory.cpp",
    "file": "DIRECTORY/directory.cpp"
  }
]

#--- old.h
inline int answer() { return 42; }

#--- main.cpp
#include "missing.h" // error-ok
#include "old.h"
int main() { return answer(); }

#--- open.cpp
int open_file() { return 0; }

#--- old/header.h
inline int directory_answer() { return 7; }

#--- directory.cpp
#include "old/header.h"
int directory_file() { return directory_answer(); }

#--- requests.jsonrpc.in
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"processId":123,"rootUri":"file://DIRECTORY","capabilities":{"workspace":{"workspaceEdit":{"documentChanges":true},"fileOperations":{"willRename":true,"didRename":true}}},"trace":"off"}}
# CHECK:      "fileOperations": {
# CHECK:        "didRename": {
# CHECK:        "willRename": {
---
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://DIRECTORY/open.cpp","languageId":"cpp","version":1,"text":"#include \"old.h\"\nint open_file() { return answer(); }\n"}}}
---
{"jsonrpc":"2.0","id":1,"method":"workspace/willRenameFiles","params":{"files":[{"oldUri":"file://DIRECTORY/old.h","newUri":"file://DIRECTORY/new.h"}]}}
# CHECK:      "id": 1,
# CHECK-NEXT: "jsonrpc": "2.0",
# CHECK-NEXT: "result": {
# CHECK-NEXT:   "documentChanges": [
# CHECK:            "newText": "\"new.h\"",
# CHECK:            "uri": "file://DIRECTORY/main.cpp",
# CHECK-NEXT:       "version": null
# CHECK:            "newText": "\"new.h\"",
# CHECK:            "uri": "file://DIRECTORY/open.cpp",
# CHECK-NEXT:       "version": 1
---
{"jsonrpc":"2.0","id":2,"method":"workspace/willRenameFiles","params":{"files":[{"oldUri":"file://DIRECTORY/old","newUri":"file://DIRECTORY/renamed"}]}}
# CHECK:      "id": 2,
# CHECK-NEXT: "jsonrpc": "2.0",
# CHECK-NEXT: "result": {
# CHECK-NEXT:   "documentChanges": [
# CHECK:          "newText": "\"renamed/header.h\"",
# CHECK:          "uri": "file://DIRECTORY/directory.cpp",
# CHECK:          "version": null
---
{"jsonrpc":"2.0","id":3,"method":"shutdown"}
---
{"jsonrpc":"2.0","method":"exit"}

#--- requests-no-document-changes.jsonrpc
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"processId":123,"rootUri":"file:///clangd-test","capabilities":{"workspace":{"fileOperations":{"willRename":true}}},"trace":"off"}}
# NODOC:      "id": 0,
# NODOC-NOT:  "fileOperations"
# NODOC:      "id": 1,
---
{"jsonrpc":"2.0","id":1,"method":"shutdown"}
---
{"jsonrpc":"2.0","method":"exit"}
