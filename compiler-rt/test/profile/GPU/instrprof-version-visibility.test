# NOTE: Do not autogenerate. Check the runtime version definition and its device export.
# REQUIRES: system-linux, amdgpu, lld-available
# RUN: %clang -ffreestanding -DCOMPILER_RT_PROFILE_BAREMETAL=1 -DCOMPILER_RT_HAS_ATOMICS=1 -S -emit-llvm %S/../../../lib/profile/InstrProfilingVersionVar.c -o - | FileCheck %s --check-prefix=CPU
# RUN: %clang --target=amdgpu9.50-amd-amdhsa -nogpulib -ffreestanding -DCOMPILER_RT_PROFILE_BAREMETAL=1 -DCOMPILER_RT_HAS_ATOMICS=1 -S -emit-llvm %S/../../../lib/profile/InstrProfilingVersionVar.c -o %t.ll
# RUN: FileCheck %s --check-prefix=GPU --input-file=%t.ll
# RUN: %clang --target=amdgpu9.50-amd-amdhsa -nogpulib -ffreestanding -DCOMPILER_RT_PROFILE_BAREMETAL=1 -DCOMPILER_RT_HAS_ATOMICS=1 -S -emit-llvm %S/../../../lib/profile/InstrProfiling.c -o - | FileCheck %s --check-prefix=DECL
# RUN: %clang --target=amdgpu9.50-amd-amdhsa -nogpulib -flto -nostdlib -shared %t.ll -o %t.so
# RUN: llvm-readelf --dyn-syms %t.so | FileCheck %s --check-prefix=ELF

# CPU: @__llvm_profile_raw_version = weak hidden global i64
# GPU: @__llvm_profile_raw_version = weak protected addrspace(1) global i64
# ELF: OBJECT WEAK PROTECTED {{[0-9]+}} __llvm_profile_raw_version

# DECL: @__llvm_profile_raw_version = external protected addrspace(1) global i64
