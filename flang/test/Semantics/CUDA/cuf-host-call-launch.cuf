! RUN: %python %S/../test_errors.py %s %flang_fc1
! Check direct HOST calls and HOST-side kernel launch expressions.

module host_direct_audit
contains
  attributes(device) integer function d()
    d = 1
  end function
  subroutine caller(i)
    integer :: i
    !ERROR: 'd', a procedure with the DEVICE attribute, may not be called from host code
    i = d()
  end subroutine
end module

module host_launch_audit
contains
  attributes(global) subroutine kernel()
  end subroutine
  attributes(device) integer function d()
    d = 1
  end function
  subroutine caller()
    !ERROR: 'd', a procedure with the DEVICE attribute, may not be called from host code
    call kernel<<<d(),1>>>()
  end subroutine
end module
