! Unprefixed generics in the intrinsic CUBLAS modules model the legacy BLAS
! interface.  Compatible external interfaces may not override those generics.
! CUBLAS-prefixed API generics do not receive this compatibility treatment.

!--- cublas.cuf
module cublas
  implicit none
  interface
    subroutine saxpy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine scopy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine saxpycu(n, x)
      integer, value :: n
      real, device :: x(*)
    end subroutine
    subroutine cublasaxpy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine cublasaxpycu(n, x)
      integer, value :: n
      real, device :: x(*)
    end subroutine
    integer function isamax(n, x)
      integer :: n
      real :: x(*)
    end function
    integer function isamaxcu(n, x)
      integer, value :: n
      real, device :: x(*)
    end function
  end interface
  interface saxpy
    procedure :: saxpy, saxpycu
  end interface
  ! This host-only generic must not receive compatibility treatment.
  interface scopy
    procedure :: scopy
  end interface
  interface cublasaxpy
    procedure :: cublasaxpy, cublasaxpycu
  end interface
  interface isamax
    procedure :: isamax, isamaxcu
  end interface
end module

!--- cublas_v2.cuf
module cublas_v2
  implicit none
  interface
    subroutine saxpy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine scopy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine saxpycu(n, x)
      integer, value :: n
      real, device :: x(*)
    end subroutine
    subroutine cublasaxpy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine cublasaxpycu(n, x)
      integer, value :: n
      real, device :: x(*)
    end subroutine
    integer function isamax(n, x)
      integer :: n
      real :: x(*)
    end function
    integer function isamaxcu(n, x)
      integer, value :: n
      real, device :: x(*)
    end function
  end interface
  interface saxpy
    procedure :: saxpy, saxpycu
  end interface
  ! This host-only generic must not receive compatibility treatment.
  interface scopy
    procedure :: scopy
  end interface
  interface cublasaxpy
    procedure :: cublasaxpy, cublasaxpycu
  end interface
  interface isamax
    procedure :: isamax, isamaxcu
  end interface
end module

!--- blas.f90
module blas
  implicit none
  interface
    integer function isamax(n, x)
      integer :: n
      real :: x(*)
    end function
    subroutine saxpy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine scopy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
    subroutine cublasaxpy(n, x)
      integer :: n
      real :: x(*)
    end subroutine
  end interface
end module

!--- external-first.cuf
module external_first
  use blas, only: saxpy
  use, intrinsic :: cublas, only: saxpy
contains
  subroutine test_cuda_specific()
    real, device :: x(1)
    call saxpy(1, x)
  end subroutine
end module

!--- cublas-first.cuf
module cublas_first
  use, intrinsic :: cublas, only: saxpy
  use blas, only: saxpy
contains
  subroutine test_cuda_specific()
    real, device :: x(1)
    call saxpy(1, x)
  end subroutine
end module

!--- cublas-prefixed.cuf
module cublas_prefixed
  use blas, only: cublasaxpy
  use, intrinsic :: cublas, only: cublasaxpy
  procedure(cublasaxpy), pointer :: p
end module

!--- v2-external-first.cuf
module v2_external_first
  use blas, only: saxpy
  use, intrinsic :: cublas_v2, only: saxpy
contains
  subroutine test_cuda_specific()
    real, device :: x(1)
    call saxpy(1, x)
  end subroutine
end module

!--- v2-cublas-first.cuf
module v2_cublas_first
  use, intrinsic :: cublas_v2, only: saxpy
  use blas, only: saxpy
contains
  subroutine test_cuda_specific()
    real, device :: x(1)
    call saxpy(1, x)
  end subroutine
end module

!--- v2-cublas-prefixed.cuf
module v2_cublas_prefixed
  use blas, only: cublasaxpy
  use, intrinsic :: cublas_v2, only: cublasaxpy
  procedure(cublasaxpy), pointer :: p
end module

!--- function-external-first.cuf
module function_external_first
  use blas, only: isamax
  use, intrinsic :: cublas, only: isamax
contains
  subroutine test_cuda_function()
    integer :: k
    real, device :: x(4)
    k = isamax(4, x)
  end subroutine
end module

!--- function-cublas-first.cuf
module function_cublas_first
  use, intrinsic :: cublas, only: isamax
  use blas, only: isamax
contains
  subroutine test_cuda_function()
    integer :: k
    real, device :: x(4)
    k = isamax(4, x)
  end subroutine
end module

!--- v2-function-external-first.cuf
module v2_function_external_first
  use blas, only: isamax
  use, intrinsic :: cublas_v2, only: isamax
contains
  subroutine test_cuda_function()
    integer :: k
    real, device :: x(4)
    k = isamax(4, x)
  end subroutine
end module

!--- v2-function-cublas-first.cuf
module v2_function_cublas_first
  use, intrinsic :: cublas_v2, only: isamax
  use blas, only: isamax
contains
  subroutine test_cuda_function()
    integer :: k
    real, device :: x(4)
    k = isamax(4, x)
  end subroutine
end module

!--- no-cuda-external-first.cuf
module no_cuda_external_first
  use blas, only: scopy
  use, intrinsic :: cublas, only: scopy
contains
  subroutine test_host_only_generic()
    real :: x(4)
    call scopy(4, x)
  end subroutine
end module

!--- no-cuda-cublas-first.cuf
module no_cuda_cublas_first
  use, intrinsic :: cublas, only: scopy
  use blas, only: scopy
contains
  subroutine test_host_only_generic()
    real :: x(4)
    call scopy(4, x)
  end subroutine
end module

!--- v2-no-cuda-external-first.cuf
module v2_no_cuda_external_first
  use blas, only: scopy
  use, intrinsic :: cublas_v2, only: scopy
contains
  subroutine test_host_only_generic()
    real :: x(4)
