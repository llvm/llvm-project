    call scopy(4, x)
  end subroutine
end module

! The ONLY lists below are disjoint even though both used modules define both
! names, so no intrinsic-module preference rule should be needed.

!--- blas-first-disjoint-only.cuf
module blas_first_disjoint_only
  use blas, only: saxpy
  use, intrinsic :: cublas, only: cublasaxpy
  procedure(saxpy), pointer :: p
contains
  subroutine test_cuda_specific()
    real, device :: x(1)
    call cublasaxpy(1, x)
  end subroutine
end module

!--- cublas-first-disjoint-only.cuf
module cublas_first_disjoint_only
  use, intrinsic :: cublas, only: cublasaxpy
  use blas, only: saxpy
  procedure(saxpy), pointer :: p
contains
  subroutine test_cuda_specific()
    real, device :: x(1)
    call cublasaxpy(1, x)
  end subroutine
end module

! UNPREFIXED: warning: USE association selects intrinsic 'cublas' generic 'saxpy' over an equivalent external interface [-Wprefer-intrinsic-module-use-association]
! V2-UNPREFIXED: warning: USE association selects intrinsic 'cublas_v2' generic 'saxpy' over an equivalent external interface [-Wprefer-intrinsic-module-use-association]
! CUBLAS-PREFIXED: error: 'cublasaxpy' must be an abstract interface or a procedure with an explicit interface
! DISJOINT-ONLY-NOT: {{warning:|error:}}
! FUNCTION: warning: USE association selects intrinsic 'cublas' generic 'isamax' over an equivalent external interface [-Wprefer-intrinsic-module-use-association]
! V2-FUNCTION: warning: USE association selects intrinsic 'cublas_v2' generic 'isamax' over an equivalent external interface [-Wprefer-intrinsic-module-use-association]
! NO-CUDA-NOT: warning: USE association selects intrinsic
! NO-CUDA: error: Reference to 'scopy' is ambiguous
! NO-CUDA-NOT: warning: USE association selects intrinsic

! Device calls must bind to the CUDA specifics of the selected intrinsic generic.
! HLFIR-SUBROUTINE-LABEL: func.func @_QM{{.*}}Ptest_cuda_specific()
! HLFIR-SUBROUTINE-NOT: fir.call @_QPsaxpy(
! HLFIR-SUBROUTINE: fir.call @_QPsaxpycu(
! HLFIR-SUBROUTINE-NOT: fir.call @_QPsaxpy(
! HLFIR-SUBROUTINE: return
! HLFIR-FUNCTION-LABEL: func.func @_QM{{.*}}Ptest_cuda_function()
! HLFIR-FUNCTION-NOT: fir.call @_QPisamax(
! HLFIR-FUNCTION: %[[RESULT:.*]] = fir.call @_QPisamaxcu({{.*}}) {{.*}} -> i32
! HLFIR-FUNCTION-NOT: fir.call @_QPisamax(
! HLFIR-FUNCTION: hlfir.assign %[[RESULT]] to
! HLFIR-FUNCTION-NOT: fir.call @_QPisamax(
! HLFIR-FUNCTION: return
