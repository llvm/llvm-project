  end subroutine
  subroutine sb(n)
    integer, device :: n
  end subroutine
  ! CHECK-LABEL: func.func @_QMcase2Puser(
  subroutine user(v)
    type(t) :: v
    integer, managed :: mg
    ! CHECK: fir.call @_QMcase2Psa(
    call v%g(mg)
  end subroutine
end module

