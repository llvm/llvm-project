! RUN: bbc -emit-hlfir -fcuda %s -o - | FileCheck %s

! A POINTER or ALLOCATABLE dummy argument may associate or allocate a device
! global passed as the actual argument. The device copy of the descriptor must
! be synchronized after the call.

module m
  real, device, pointer, dimension(:) :: dev_ptr
  real, device, allocatable, dimension(:) :: dev_alloc
contains
  subroutine assoc(p, t)
    real, device, pointer, dimension(:) :: p
    real, device, target, dimension(:) :: t
    p => t
  end subroutine
  subroutine look(p)
    real, device, pointer, dimension(:), intent(in) :: p
  end subroutine
  subroutine alloc(a)
    real, device, allocatable, dimension(:), intent(out) :: a
    allocate(a(10))
  end subroutine
  subroutine look_alloc(a)
    real, device, allocatable, dimension(:), intent(in) :: a
  end subroutine
  integer function fassoc(p, t)
    real, device, pointer, dimension(:) :: p
    real, device, target, dimension(:) :: t
    p => t
    fassoc = size(t)
  end function
end module

subroutine use_assoc(t)
  use m
  real, device, target, dimension(:) :: t
  call assoc(dev_ptr, t)
end subroutine

program test
  use m
  real, device, target, dimension(4) :: a_dev
  real, device, pointer, dimension(:) :: local_ptr
  integer :: n
  call assoc(dev_ptr, a_dev)
  call look(dev_ptr)
  call alloc(dev_alloc)
  call look_alloc(dev_alloc)
  call assoc(local_ptr, a_dev)
  n = fassoc(dev_ptr, a_dev)
end program

! CHECK-LABEL: func.func @_QPuse_assoc(
! CHECK: fir.call @_QMmPassoc
! CHECK-NEXT: cuf.sync_descriptor @_QMmEdev_ptr

! CHECK-LABEL: func.func @_QQmain()
! CHECK: fir.call @_QMmPassoc
! CHECK-NEXT: cuf.sync_descriptor @_QMmEdev_ptr
! CHECK: fir.call @_QMmPlook
! CHECK-NOT: cuf.sync_descriptor
! CHECK: fir.call @_QMmPalloc
! CHECK-NEXT: cuf.sync_descriptor @_QMmEdev_alloc
! CHECK: fir.call @_QMmPlook_alloc
! CHECK-NOT: cuf.sync_descriptor
! CHECK: fir.call @_QMmPassoc
! CHECK-NOT: cuf.sync_descriptor
! CHECK: fir.call @_QMmPfassoc
! CHECK-NEXT: cuf.sync_descriptor @_QMmEdev_ptr
! CHECK: return
