! RUN: bbc -emit-hlfir -fcuda %s -o - | FileCheck %s
! RUN: bbc -emit-hlfir -fcuda %s -o - | fir-opt --cuf-convert-late | FileCheck %s --check-prefix=LATE

! Check if finalization works with a return statement

subroutine sub1
  integer, device :: a(10)
  return
end

! CHECK: func.func @_QPsub1()
! CHECK: %[[DECL:.*]]:2 = hlfir.declare
! CHECK: %[[SUB1_ACTIVE:.*]] = cuf.device_is_active : i1
! CHECK-NEXT: fir.if %[[SUB1_ACTIVE]] {
! CHECK: cuf.free %[[DECL]]#0 : !fir.ref<!fir.array<10xi32>>{{.*}}
! CHECK-NEXT: }
! CHECK: return
! CHECK: }

! LATE: func.func @_QPsub1()
! LATE: %[[DECL:.*]]:2 = hlfir.declare
! LATE: %[[SUB1_ACTIVE:.*]] = fir.call @_FortranACUFDeviceIsActive() : () -> i1
! LATE-NEXT: fir.if %[[SUB1_ACTIVE]] {
! LATE: cuf.free %[[DECL]]#0 : !fir.ref<!fir.array<10xi32>>{{.*}}
! LATE-NEXT: }
! LATE: return
! LATE: }

subroutine sub2
  integer, device, allocatable :: a(:)
  return
end

! CHECK-LABEL: func.func @_QPsub2()
! CHECK: %[[SUB2_ACTIVE:.*]] = cuf.device_is_active : i1
! CHECK-NEXT: fir.if %[[SUB2_ACTIVE]] {
! CHECK: fir.if
! CHECK: cuf.deallocate
! CHECK: cuf.free{{.*}}
! CHECK-NEXT: }

! LATE-LABEL: func.func @_QPsub2()
! LATE: %[[SUB2_ACTIVE:.*]] = fir.call @_FortranACUFDeviceIsActive() : () -> i1
! LATE-NEXT: fir.if %[[SUB2_ACTIVE]] {
! LATE: fir.if
! LATE: cuf.deallocate
! LATE: cuf.free{{.*}}
! LATE-NEXT: }

program main
  integer, allocatable, device :: a(:)
  integer, device, pointer :: p(:)
  return
end

! The descriptor of a device pointer lives in managed memory and is freed at
! scope exit, under the same device-active guard as the other cleanup.

! CHECK-LABEL: func.func @_QQmain() attributes {fir.bindc_name = "MAIN"}
! CHECK: cuf.alloc !fir.box<!fir.heap<!fir.array<?xi32>>> {bindc_name = "a", data_attr = #cuf.cuda<device>, uniq_name = "_QFEa"} -> !fir.ref<!fir.box<!fir.heap<!fir.array<?xi32>>>>
! CHECK: %[[PTR:.*]]:2 = hlfir.declare %{{.*}} {data_attr = #cuf.cuda<device>, fortran_attrs = #fir.var_attrs<pointer>, uniq_name = "_QFEp"}
! CHECK: %[[ACTIVE:.*]] = cuf.device_is_active : i1
! CHECK-NEXT: fir.if %[[ACTIVE]] {
! CHECK-NEXT: fir.call @_QPcudadevicesynchronize()
! CHECK-NEXT: cuf.free %[[PTR]]#0 : !fir.ref<!fir.box<!fir.ptr<!fir.array<?xi32>>>>{{.*}}
! CHECK: cuf.deallocate
! CHECK: cuf.free{{.*}}
! CHECK-NEXT: }
! CHECK-NEXT: return

! LATE-LABEL: func.func @_QQmain() attributes {fir.bindc_name = "MAIN"}
! LATE: %[[PTR:.*]]:2 = hlfir.declare %{{.*}} {data_attr = #cuf.cuda<device>, fortran_attrs = #fir.var_attrs<pointer>, uniq_name = "_QFEp"}
! LATE: %[[ACTIVE:.*]] = fir.call @_FortranACUFDeviceIsActive() : () -> i1
! LATE-NEXT: fir.if %[[ACTIVE]] {
! LATE-NEXT: fir.call @_QPcudadevicesynchronize()
! LATE-NEXT: cuf.free %[[PTR]]#0 : !fir.ref<!fir.box<!fir.ptr<!fir.array<?xi32>>>>{{.*}}
! LATE: cuf.deallocate
! LATE: cuf.free{{.*}}
! LATE-NEXT: }
! LATE-NOT: cuf.device_is_active
