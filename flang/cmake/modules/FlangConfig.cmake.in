# This file allows users to call find_package(Flang) and pick up our targets.

@FLANG_CONFIG_CODE@

set(LLVM_VERSION @LLVM_VERSION_MAJOR@.@LLVM_VERSION_MINOR@.@LLVM_VERSION_PATCH@)
find_package(LLVM ${LLVM_VERSION} EXACT REQUIRED CONFIG
             HINTS "@FLANG_CONFIG_LLVM_CMAKE_DIR@")

# Clang and MLIR built only as Flang's dependencies are exported with Flang.
if(@FLANG_CONFIG_FIND_CLANG@)
  find_package(Clang REQUIRED CONFIG
               HINTS "@FLANG_CONFIG_CLANG_CMAKE_DIR@")
endif()
if(@FLANG_CONFIG_FIND_MLIR@)
  find_package(MLIR REQUIRED CONFIG
               HINTS "@FLANG_CONFIG_MLIR_CMAKE_DIR@")
endif()

set(FLANG_EXPORTED_TARGETS "@FLANG_EXPORTS@")
set(FLANG_CMAKE_DIR "@FLANG_CONFIG_CMAKE_DIR@")
set(FLANG_INCLUDE_DIRS "@FLANG_CONFIG_INCLUDE_DIRS@")

# Provide all our library targets to users.
@FLANG_CONFIG_INCLUDE_EXPORTS@
