{"jsonrpc":"2.0","id":2,"method":"textDocument/definition","params":{
  "textDocument":{"uri":"test:///foo.mlir"},
  "position":{"line":3,"character":37}
}}
//      CHECK:  "id": 2
// CHECK-NEXT:  "jsonrpc": "2.0",
// CHECK-NEXT:  "result": [
