  "textDocument":{"uri":"test:///locations.mlir"},
  "position":{"line":4,"character":20}
}}
//      CHECK:  "id": 7
// CHECK-NEXT:  "jsonrpc": "2.0",
// CHECK-NEXT:  "result": []
// -----
{"jsonrpc":"2.0","id":8,"method":"textDocument/definition","params":{
  "textDocument":{"uri":"test:///locations.mlir"},
  "position":{"line":5,"character":20}
}}
