// RUN: not mlir-tblgen -gen-attrdef-decls -attrdefs-partition=Memory -I %S/../../include -DERROR1 %s 2>&1 | FileCheck --check-prefix=ERROR1 %s
// RUN: not mlir-tblgen -gen-typedef-defs -typedefs-partition=Memroy -I %S/../../include %s 2>&1 | FileCheck --check-prefix=ERROR2 %s
// RUN: not mlir-tblgen -gen-attrdef-defs -attrdefs-partition=Memory -I %S/../../include -DERROR3 %s 2>&1 | FileCheck --check-prefix=ERROR3 %s

include "mlir/IR/AttrTypeBase.td"

def MemoryPartition : Partition<"Memory">;

def Test_Dialect : Dialect {
  let name = "test";
}

def AddressAttr : AttrDef<Test_Dialect, "Address"> {
  let mnemonic = "address";
  let partition = MemoryPartition;
}

def PointerType : TypeDef<Test_Dialect, "Pointer"> {
  let mnemonic = "ptr";
  let partition = MemoryPartition;
}

#ifdef ERROR1
// ERROR1: error: attribute 'NoPartitionAttr' is in no partition, but its attributes are generated by partition with -attrdefs-partition
def NoPartitionAttr : AttrDef<Test_Dialect, "NoPartition"> {
  let mnemonic = "no_partition";
}
#endif

#ifdef ERROR3
def SnakeCasePartition : Partition<"control_flow">;
def CamelCasePartition : Partition<"ControlFlow">;
def BranchAttr : AttrDef<Test_Dialect, "Branch"> {
  let mnemonic = "br";
  let partition = SnakeCasePartition;
}
// ERROR3: error: attribute partitions 'control_flow' and 'ControlFlow' have the same name 'ControlFlow' in generated functions
def CondBranchAttr : AttrDef<Test_Dialect, "CondBranch"> {
  let mnemonic = "cond_br";
  let partition = CamelCasePartition;
}
#endif

// ERROR2: error: no type is in the specified type partition 'Memroy'
