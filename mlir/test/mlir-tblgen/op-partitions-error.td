// RUN: not mlir-tblgen -gen-op-decls -op-partition=Memory -I %S/../../include -DERROR1 %s 2>&1 | FileCheck --check-prefix=ERROR1 %s
// RUN: not mlir-tblgen -gen-op-defs -op-partition=Memory -I %S/../../include -DERROR2 %s 2>&1 | FileCheck --check-prefix=ERROR2 %s
// RUN: not mlir-tblgen -gen-op-defs -op-partition=Memroy -I %S/../../include %s 2>&1 | FileCheck --check-prefix=ERROR3 %s
// RUN: not mlir-tblgen -gen-op-doc -op-partition=Memroy -I %S/../../include %s 2>&1 | FileCheck --check-prefix=ERROR3 %s
// RUN: not mlir-tblgen -gen-op-defs -op-partition=Memory -op-shard-count=2 -I %S/../../include %s 2>&1 | FileCheck --check-prefix=ERROR4 %s
// RUN: not mlir-tblgen -gen-op-decls -I %S/../../include -DERROR5 %s 2>&1 | FileCheck --check-prefix=ERROR5 %s

include "mlir/IR/OpBase.td"

def MemoryPartition : Partition<"Memory">;

#ifdef ERROR5
// ERROR5: error: assertion failed: partition name 'my-partition' is not a C++ identifier
def InvalidPartition : Partition<"my-partition">;
#endif

def Test_Dialect : Dialect {
  let name = "test";
}

def LoadOp : Op<Test_Dialect, "load"> {
  let partition = MemoryPartition;
}

#ifdef ERROR1
// ERROR1: error: op 'NoPartitionOp' is in no partition, but its ops are generated by partition with -op-partition
def NoPartitionOp : Op<Test_Dialect, "no_partition">;
#endif

#ifdef ERROR2
def SnakeCasePartition : Partition<"control_flow">;
def CamelCasePartition : Partition<"ControlFlow">;
def BranchOp : Op<Test_Dialect, "br"> {
  let partition = SnakeCasePartition;
}
// ERROR2: error: op partitions 'control_flow' and 'ControlFlow' have the same name 'ControlFlow' in generated functions
def CondBranchOp : Op<Test_Dialect, "cond_br"> {
  let partition = CamelCasePartition;
}
#endif

// ERROR3: error: no op is in the specified op partition 'Memroy'

// ERROR4: error: -op-partition cannot be combined with -op-shard-count
