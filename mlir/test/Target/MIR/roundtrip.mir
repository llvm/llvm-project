# RUN: mlir-translate --import-mir %s | mlir-translate --export-mir | FileCheck %s

# Full round trip: .mir -> mir dialect -> .mir. The regenerated machine
# function must reproduce the generic opcodes, LLT types, and ABI-boundary
# physical-register copies of the input.

--- |
  define void @add(i64 %a, i64 %b) { ret void }
...
---
name:            add
body:             |
  bb.0:
    liveins: $x0, $x1
    %0:_(s64) = COPY $x0
    %1:_(s64) = COPY $x1
    %2:_(s64) = G_ADD %0, %1
    %3:_(s64) = G_MUL %2, %0
    $x0 = COPY %3
...

# CHECK-LABEL: name:{{.*}}add
# CHECK: liveins: $x0, $x1
# CHECK: %0:_(s64) = COPY $x0
# CHECK: %1:_(s64) = COPY $x1
# CHECK: %2:_(s64) = G_ADD %0, %1
# CHECK: %3:_(s64) = G_MUL %2, %0
# CHECK: $x0 = COPY %3
