// NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --tool mlir-translate --check-globals none --filter "getelementptr|load ptr|load i64|call void @opaque" --include-generated-funcs --version 6
// RUN: mlir-translate -mlir-to-llvmir %s | FileCheck %s --enable-var-scope=false

// Flang uses this translation path. Only the newly created capture structure
// is noalias/nofreeobj; the captured addresses may alias and name heap objects.
llvm.func @opaque()
llvm.func @consume(i64, i64)
llvm.func @capture_lifetime(%first: !llvm.ptr, %second: !llvm.ptr) {
  omp.parallel {
    llvm.call @opaque() : () -> ()
    %a = llvm.load %first : !llvm.ptr -> i64
    %b = llvm.load %second : !llvm.ptr -> i64
    llvm.call @consume(%a, %b) : (i64, i64) -> ()
    omp.terminator
  }
  llvm.return
}

// No third parameter exists when the region has no captures.
llvm.func @no_captures() {
  omp.parallel {
    llvm.call @opaque() : () -> ()
    omp.terminator
  }
  llvm.return
}
// CHECK-LABEL: define void @capture_lifetime(
// CHECK-SAME: ptr [[TMP0:%.*]], ptr [[TMP1:%.*]]) {
// CHECK:    [[GEP_:%.*]] = getelementptr { ptr, ptr }, ptr [[STRUCTARG:%.*]], i32 0, i32 0
// CHECK:    [[GEP_2:%.*]] = getelementptr { ptr, ptr }, ptr [[STRUCTARG]], i32 0, i32 1
//
//
// CHECK-LABEL: define internal void @capture_lifetime..omp_par(
// CHECK-SAME: ptr noalias [[TID_ADDR:%.*]], ptr noalias [[ZERO_ADDR:%.*]], ptr noalias nofreeobj [[TMP0:%.*]]) #[[ATTR0:[0-9]+]] {
// CHECK:    [[GEP_:%.*]] = getelementptr { ptr, ptr }, ptr [[TMP0]], i32 0, i32 0
// CHECK:    [[LOADGEP_:%.*]] = load ptr, ptr [[GEP_]], align 8, !align [[META1:![0-9]+]]
// CHECK:    [[GEP_1:%.*]] = getelementptr { ptr, ptr }, ptr [[TMP0]], i32 0, i32 1
// CHECK:    [[LOADGEP_2:%.*]] = load ptr, ptr [[GEP_1]], align 8, !align [[META1]]
// CHECK:    call void @opaque()
// CHECK:    [[TMP2:%.*]] = load i64, ptr [[LOADGEP_]], align 4
// CHECK:    [[TMP3:%.*]] = load i64, ptr [[LOADGEP_2]], align 4
//
